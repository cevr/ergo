// clock-gui is a stopwatch and a level meter in a MyGo window, the LIVE
// receipt's program (stdlib.md, UI 24). The time and the level are
// readouts: a task publishes them sixty times a second and the window
// paints them again with no pass, while the laps go through the machine
// and the view as any state does.
//
//	clock-gui                   open the window
//	clock-gui -headless N       publish N readings through a window with
//	                            no screen and print what it shows
//
// controls/clock-gui is the same screen in Go on MyGo's own widgets: what
// the readouts are measured against.

import actor
import go ergo.local/prototype/hosts/mygo/screen
import ergo.local/prototype/hosts/mygo/desktop
import io
import os
import strconv
import task
import time
import ui
import ui/layout

// Rate is the readings a second.
let Rate = 60

func main() fails os.Exit needs Ambient | go.Foreign {
	let args = with context { os.Process: os.NewHost() } { os.Process.Args() }
	let clock = ui.NewReadout(stamp(0))
	let meter = ui.NewReadout(level(0))
	let view = func(f mut ui.Frame[int], laps int) { screenOf(f, laps, clock, meter) }
	if len(args) > 1 && args[0] == "-headless" {
		let n = strconv.Atoi(args[1]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "clock-gui: -headless takes a count, not \(args[1])"}
		}
		try headless(view, clock, meter, n)
		return
	}
	with context { Scheduler: NewLiveScheduler() } {
		let w = screen.Open("Clock", 320, 200) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "clock-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(laps(), 8, func(o int) {})
		let ticker = task.Go() {
			let mut i = 0
			for {
				Scheduler.Sleep(time.Times(1ms, 1000/Rate))
				i = i + 1
				ui.Publish(clock, stamp(i))
				ui.Publish(meter, level(i))
			}
			true
		}
		desktop.Run(w, a, view) catch {
		case ui.Closed:
		case actor.Stopped:
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "clock-gui: \(b.Why)"}
		case go.Error as e:
			return os.Exit{Code: 1, Message: "clock-gui: \(e.Text)"}
		}
	}
}

// headless publishes n readings of each readout through a window with no
// screen, taking each wake as the window does, and prints what it shows
// and how many passes ran.
func headless(view own func(f mut ui.Frame[int], laps int), clock ui.Readout, meter ui.Readout, n int) fails os.Exit needs Ambient | go.Foreign {
	let out = io.NewHost()
	with context { Scheduler: time.NewManual(0) } {
		let w = screen.Headless(320, 200) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "clock-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(laps(), 8, func(o int) {})
		let mut d = desktop.New(w, a, view, 64) catch {
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "clock-gui: \(b.Why)"}
		}
		out.Println(lapAt(&d))
		publishAll(&d, clock, meter, n) catch {
		case actor.Stopped:
			return os.Exit{Code: 1, Message: "clock-gui: the window closed"}
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "clock-gui: \(b.Why)"}
		}
		// What the window shows after the readings alone, before a pass
		// could draw the readouts again.
		let shown = drew(&d)
		// A lap runs a pass, which lays the meter out again.
		desktop.Play(&d, []ui.Act{ui.TapOn{Label: "lap"}}) catch {
		case ui.NoNode, ui.Ambiguous, ui.Mismatch, ui.Closed, actor.Stopped:
			return os.Exit{Code: 1, Message: "clock-gui: no lap button"}
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "clock-gui: \(b.Why)"}
		}
		out.Println(lapAt(&d))
		out.Println("\(ui.Reading(clock)) \(ui.Reading(meter)) laps \(desktop.StateOf(&d)) painted \(desktop.Painted(&d))")
		out.Println(shown)
	}
}

// drew is the texts the window's last paint drew, kept draws too, as
// "drew" and each text after a "|": what the window shows, where the line
// before it prints what the program read.
func drew[S, E, D, F](d mut desktop.Driver[S, E, D, F]) string {
	let mut line = "drew"
	for at in desktop.Inks(d) {
		line = line + "|" + at.Label
	}
	line
}

// publishAll publishes n readings of each readout, the window taking
// each wake as it comes.
func publishAll[E comparable, S, D, F](d mut desktop.Driver[S, E, D, F], clock ui.Readout, meter ui.Readout, n int) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	for i in 1..n+1 {
		ui.Publish(clock, stamp(i))
		ui.Publish(meter, level(i))
		try desktop.Pump(d)
	}
}

// lapAt is where the lap button is: the meter beside it lays out by its
// reserve, so no reading moves it.
func lapAt[S, E, D, F](d mut desktop.Driver[S, E, D, F]) string {
	match desktop.BoxOf(d, "lap") {
	case Some[layout.Box] as b:
		"lap at \(b.Value.X) \(b.Value.Y)"
	case None:
		"no lap button"
	}
}

// screenOf is the window: the time, the level, the laps and the button
// that counts one.
func screenOf(f mut ui.Frame[int], laps int, clock ui.Readout, meter ui.Readout) {
	let mut page = ui.Plain()
	page.Gap = 8
	page.Padding = ui.All(16)
	ui.Column(f, page) {
		ui.Text(f, "time")
		ui.ReadoutText(f, clock, "00:00.00")
		ui.Text(f, "level")
		let mut row = ui.Plain()
		row.Gap = 8
		ui.Row(f, row) {
			ui.ReadoutText(f, meter, "100%")
			ui.Text(f, "laps \(laps)")
			ui.Pressable(f, "lap", 1) {
				ui.Text(f, "Lap")
			}
		}
	}
}

// laps is the program's state: the laps counted.
func laps() Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: lapStep, After: noTimer, Work: noWork, Exit: func(at int) Option[func()] { None }}
}

func lapStep(s int, e int) Decision[int, int] { Enter[int]{Next: s + e} }

func noTimer(s int) Option[Timeout[int]] { None }

func noWork(s int) Option[func(send func(e int))] { None }

// stamp is reading i's time, minutes, seconds and hundredths.
func stamp(i int) string {
	let cs = i * 100 / Rate
	"\(two(cs / 6000 % 100)):\(two(cs / 100 % 60)).\(two(cs % 100))"
}

// level is reading i's level: a saw from 0 to 100 percent.
func level(i int) string { "\(i % 101)%" }

func two(n int) string { if n < 10 { "0\(n)" } else { "\(n)" } }
