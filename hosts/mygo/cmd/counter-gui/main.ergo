// counter-gui is examples/counter-gui in a MyGo window: the example's model
// and view (a required Ergo module, hosts/mygo/go.mod) on the desktop
// driver. It is the only place that chooses: the window and the live
// clock, or, with -headless, a window with no screen that plays a script
// from standard input and prints what the example's own binary prints.
//
//	counter-gui                 open the window
//	counter-gui -headless -script f [-tree] [-png p]  play the JSON act list in f (ui.ParseActs);
//				-tree prints the screen after it, a JSON line a node (ui.TreeLine),
//				and -png writes its picture to p
//	counter-gui -headless < s   play the script s through the window's input
//	counter-gui -headless -drive ADDR
//	                            play the lines one connection to ADDR sends
//	ERGO_DRIVE=ADDR counter-gui open the window and play, first, the lines
//	                            one connection to ADDR sends (on a phone: the
//	                            property debug.ergo.drive, screen.DriveAddr)

import actor
import ergo.local/prototype/examples/countergui/counter
import ergo.local/prototype/examples/countergui/script
import ergo.local/prototype/examples/countergui/view
import ergo.local/prototype/hosts/mygo/desktop
import fs
import go ergo.local/prototype/hosts/mygo/screen
import io
import net
import os
import time
import ui

func main() fails os.Exit needs Ambient | go.Foreign {
	let args = with context { os.Process: os.NewHost() } { os.Process.Args() }
	let drive = screen.DriveAddr()
	if len(args) > 0 && args[0] == "-headless" {
		try headless(args)
		return
	}
	with context { Scheduler: NewLiveScheduler() } {
		let w = screen.Open("Counter", 360, 220) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "counter-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(counter.Counter{}, 8, func(c counter.Count) {})
		if drive != "" {
			let l = try listen(drive)
			desktop.Drive(w, a, view.View, l, parse, counter.Summary) catch {
			case ui.Closed:
			case actor.Stopped:
			case ui.BadPatch as b:
				return os.Exit{Code: 1, Message: "counter-gui: \(b.Why)"}
			case go.Error as e:
				return os.Exit{Code: 1, Message: "counter-gui: \(e.Text)"}
			}
			return
		}
		desktop.Run(w, a, view.View) catch {
		case ui.Closed:
		case actor.Stopped:
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "counter-gui: \(b.Why)"}
		case go.Error as e:
			return os.Exit{Code: 1, Message: "counter-gui: \(e.Text)"}
		}
	}
}

// listen listens on addr for the script a test drives the window with
// (desktop.Drive, desktop.Answer).
func listen(addr string) net.Listener fails os.Exit needs Ambient {
	net.Listen(net.NewHost(), addr) catch {
	case net.ListenFailed as f:
		return os.Exit{Code: 1, Message: "counter-gui: cannot listen on \(f.Addr): \(f.Reason)"}
	}
}

// parse is the steps of one script line; a line that is no step has none.
func parse(line string) []ui.Act {
	script.Parse(line) catch {
	case script.BadLine:
		return []ui.Act{}
	}
}

// answer plays the script lines one connection to addr sends through a
// window with no screen, and answers each with the count after each step
// (desktop.Answer). It prints the address it listens on first.
func answer(addr string) fails os.Exit needs Ambient | go.Foreign {
	let l = try listen(addr)
	io.NewHost().Println("listening \(l.Addr())")
	let c = l.Accept() catch {
	case net.Failed as f:
		return os.Exit{Code: 1, Message: "counter-gui: \(f.Reason)"}
	}
	with context { Scheduler: time.NewManual(0) } {
		let w = screen.Headless(360, 220) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "counter-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(counter.Counter{}, 8, func(_ counter.Count) {})
		let mut d = desktop.New(w, a, view.View, 64) catch {
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "counter-gui: \(b.Why)"}
		}
		desktop.Answer(&d, c, parse, counter.Summary) catch {
		case ui.Closed, actor.Stopped:
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "counter-gui: \(b.Why)"}
		}
	}
	c.Close()
	l.Close()
}

// headless plays the script on standard input through a window with no
// screen, a press and a release at each node's place, and prints the count
// after each step.
func headless(args []string) fails os.Exit needs Ambient | go.Foreign {
	let mut tree = false
	let mut file = ""
	let mut picture = ""
	for i, a in args {
		if a == "-tree" {
			tree = true
		} else if a == "-script" && i+1 < len(args) {
			file = args[i+1]
		} else if a == "-png" && i+1 < len(args) {
			picture = args[i+1]
		} else if a == "-drive" && i+1 < len(args) {
			try answer(args[i+1])
			return
		}
	}
	if file != "" {
		let json = fs.NewHost().ReadFile(file) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return os.Exit{Code: 1, Message: "counter-gui: cannot read \(file)"}
		}
		let acts = ui.ParseActs(json) catch {
		case ui.BadScript as b:
			return os.Exit{Code: 2, Message: "counter-gui: \(file): \(b.Why)"}
		}
		try play(acts, tree, picture)
		return
	}
	let text = io.NewStdin().ReadAll() catch {
	case io.ReadFailed:
		return os.Exit{Code: 1, Message: "counter-gui: cannot read the script"}
	}
	let steps = script.Parse(text) catch {
	case script.BadLine as b:
		return os.Exit{Code: 2, Message: "counter-gui: line \(b.Line) is no step: \(b.Text)"}
	}
	try play(steps, false, "")
}

// play plays acts through a window with no screen and prints the state
// after each, then, with tree, the screen as JSON lines, and, with a
// picture path, the screen as a PNG there.
func play(acts []ui.Act, tree bool, picture string) fails os.Exit needs Ambient | go.Foreign {
	let out = io.NewHost()
	with context { Scheduler: time.NewManual(0) } {
		let w = screen.Headless(360, 220) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "counter-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(counter.Counter{}, 8, func(c counter.Count) {})
		let mut d = desktop.New(w, a, view.View, 64) catch {
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "counter-gui: \(b.Why)"}
		}
		for i, act in acts {
			desktop.Play(&d, []ui.Act{act}) catch {
			case ui.NoNode as n:
				out.Println("\(i + 1): no node \(n.Label)")
				continue
			case ui.Mismatch as m:
				out.Println("\(i + 1): want \(m.Want), got \(m.Got)")
			case ui.Ambiguous as x:
				out.Println("\(i + 1): \(x.Count) nodes at \(x.At)")
				continue
			case ui.Closed, actor.Stopped:
				return os.Exit{Code: 1, Message: "counter-gui: the window closed"}
			case ui.BadPatch as b:
				return os.Exit{Code: 1, Message: "counter-gui: \(b.Why)"}
			}
			out.Println("\(i + 1): \(counter.Summary(desktop.StateOf(&d)))")
		}
		if tree {
			for l in desktop.TreeLines(&d) {
				out.Println(l)
			}
		}
		if picture != "" {
			w.WritePNG(picture) catch {
			case go.Error as e:
				return os.Exit{Code: 1, Message: "counter-gui: \(e.Text)"}
			}
		}
	}
}
