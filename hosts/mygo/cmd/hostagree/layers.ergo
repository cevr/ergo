// layers (UG4): a menu (a popover layer under the "menu" button, over
// two buttons of the flow), a dialog (a modal layer over a scrim) with a
// tooltip on its button, a pin beside a row of a list that scrolls (UG4b), so both hosts agree on what a press inside a
// layer, outside it, on a scrim and Escape send, and the window places
// each layer against its anchor in the window and hit-tests the top
// layer first.

import ergo.local/prototype/hosts/mygo/desktop
import ui
import ui/layout

// layersApp is the open layers and the last signal.
type layersApp { menu bool, dialog bool, tip bool, pin bool, last int }

func layersStep(s layersApp, e int) Decision[layersApp, int] {
	let mut n = s
	n.last = e
	if e == 1 {
		n.menu = !s.menu
	} else if e == 2 {
		n.menu = false
	} else if e == 3 {
		n.dialog = true
		n.tip = true
	} else if e == 4 {
		n.dialog = false
		n.tip = false
	} else if e == 5 {
		n.pin = !s.pin
	}
	Enter[layersApp]{Next: n}
}

func layersMachine() Machine[layersApp, int, int] {
	Machine[layersApp, int, int]{Initial: layersApp{menu: false, dialog: false, tip: false, pin: true, last: 0}, Step: layersStep, After: none[layersApp, int], Work: idle[layersApp, int], Exit: func(s layersApp) Option[func()] { None }}
}

// layerLook is a layer's panel: white, a border, rounded.
func layerLook(f mut ui.Frame[int]) ui.Style {
	let mut l = ui.Bare()
	l.Fill = ui.Rgb(0xffffff)
	l.Border = ui.Border{Width: 1, Color: ui.Rgb(0x8c959f)}
	l.Corners = ui.Round(6)
	let mut s = ui.Plain()
	s.Padding = ui.All(6)
	s.Gap = 4
	s.Look = ui.LookFor(f, ui.Steady(l))
	s
}

func layersView(f mut ui.Frame[int], s layersApp) {
	let mut col = ui.Plain()
	col.Gap = 8
	col.Padding = ui.All(12)
	ui.Column(f, col) {
		ui.Text(f, "last \(s.last)")
		ui.Zone(f, ui.ByInt(1), ui.Plain()) {
			ui.Pressable(f, "menu", 1) {
				ui.Text(f, "Menu")
			}
		}
		ui.Pressable(f, "under0", 10) {
			ui.Text(f, "Under 0")
		}
		ui.Pressable(f, "under1", 11) {
			ui.Text(f, "Under 1")
		}
		let mut gap = ui.Plain()
		gap.Height = ui.Fixed{Value: 140}
		ui.Box(f, gap) {}
		ui.Zone(f, ui.ByInt(2), ui.Plain()) {
			ui.Pressable(f, "dialog", 3) {
				ui.Text(f, "Dialog")
			}
		}
		let mut line = ui.Plain()
		line.Gap = 8
		ui.Row(f, line) {
			ui.Pressable(f, "plain", 12) {
				ui.Text(f, "Plain")
			}
			ui.Pressable(f, "pin", 5) {
				ui.Text(f, "Pin")
			}
		}
		// A list whose row 5 anchors the pin (UG4b): the pin follows the
		// row as the list scrolls.
		ui.Rows(f, "rows", 30, ui.Length(32.0), func(i int) ui.Key { ui.ByInt(i) }, func(i int) {
			ui.Zone(f, ui.ByInt(100+i), ui.Plain()) {
				ui.Text(f, "row \(i)")
			}
		})
	}
	if s.pin {
		ui.Layer(f, ui.Layered[int]{Z: ui.PopoverZ, Anchor: Some{Value: ui.ByInt(105)}, Place: ui.Place{Side: ui.SideRight, Align: ui.AlignStart, Gap: 4}, Scrim: false, Dismiss: None}, layerLook(f)) {
			ui.Text(f, "pinned to row 5")
		}
	}
	if s.menu {
		ui.Layer(f, ui.Layered[int]{Z: ui.PopoverZ, Anchor: Some{Value: ui.ByInt(1)}, Place: ui.Place{Side: ui.SideBottom, Align: ui.AlignStart, Gap: 4}, Scrim: false, Dismiss: Some{Value: 2}}, layerLook(f)) {
			ui.Pressable(f, "item0", 20) {
				ui.Text(f, "Item zero")
			}
			ui.Pressable(f, "item1", 21) {
				ui.Text(f, "Item one")
			}
			ui.Pressable(f, "item2", 2) {
				ui.Text(f, "Close")
			}
		}
	}
	if s.dialog {
		ui.Layer(f, ui.Layered[int]{Z: ui.ModalZ, Anchor: None, Place: ui.Place{Side: ui.SideBottom, Align: ui.AlignCenter, Gap: 0}, Scrim: true, Dismiss: Some{Value: 4}}, layerLook(f)) {
			ui.Text(f, "A dialog")
			ui.Zone(f, ui.ByInt(3), ui.Plain()) {
				ui.Pressable(f, "ok", 4) {
					ui.Text(f, "OK")
				}
			}
			ui.Pressable(f, "inside", 22) {
				ui.Text(f, "Inside")
			}
			if s.tip {
				ui.Layer(f, ui.Layered[int]{Z: ui.TooltipZ, Anchor: Some{Value: ui.ByInt(3)}, Place: ui.Place{Side: ui.SideTop, Align: ui.AlignCenter, Gap: 2}, Scrim: false, Dismiss: None}, layerLook(f)) {
					ui.Text(f, "Closes it")
				}
			}
		}
	}
}

// layersPlacedWrong is why a layer of the window is not where
// ui.PlaceLayer puts it against its anchor's box in the window, None when
// each is.
func layersPlacedWrong[E comparable, S, D, F](d mut desktop.Driver[S, E, D, F]) Option[string] {
	for l in desktop.LayerBoxes(d) {
		let view = ui.Rect{X: ui.Length(float64(l.View.X)), Y: ui.Length(float64(l.View.Y)), W: ui.Length(float64(l.View.W)), H: ui.Length(float64(l.View.H))}
		let anchor = match l.Anchor {
		case Some[layout.Box] as a:
			Some{Value: ui.Rect{X: ui.Length(float64(a.Value.X)), Y: ui.Length(float64(a.Value.Y)), W: ui.Length(float64(a.Value.W)), H: ui.Length(float64(a.Value.H))}}
		case None:
			None
		}
		let want = ui.PlaceLayer(anchor, ui.Length(float64(l.Box.W)), ui.Length(float64(l.Box.H)), view, l.Place)
		if float64(want.X) != float64(l.Box.X) || float64(want.Y) != float64(l.Box.Y) {
			return Some{Value: "a layer is at \(l.Box.X),\(l.Box.Y); placed against its anchor it is at \(float64(want.X)),\(float64(want.Y))"}
		}
	}
	None
}
