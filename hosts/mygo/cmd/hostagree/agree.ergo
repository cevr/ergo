import actor
import go ergo.local/prototype/hosts/mygo/screen
import ergo.local/prototype/hosts/mygo/desktop
import math
import strconv
import strings
import time
import ui
import ui/layout
import utf8

// result is how a step ended on one host: done, or the label it found no
// node for, or how it failed.
type result = Done{} | Missing{Label string} | Broke{Why string}

// agree plays steps on both hosts and prints whether they agree after
// each.
func agree[E comparable, S](m Machine[S, E, int], view own func(f mut ui.Frame[E], s S), same func(a S, b S) bool, steps []string) needs Console | Scheduler | go.Foreign {
	let w = screen.Headless(480, 640) catch {
	case go.Error as e:
		Console.Println("differ 0: no window: \(e.Text)")
		return
	}
	let ta = actor.StartMachine(m, 1, func(o int) {})
	let da = actor.StartMachine(m, 1, func(o int) {})
	let mut h = ui.NewTestHost(ta, view, time.NewManual(0), 16) catch {
	case ui.BadPatch as b:
		Console.Println("differ 0: test host: \(b.Why)")
		return
	}
	let mut d = desktop.New(w, da, view, 16) catch {
	case ui.BadPatch as b:
		Console.Println("differ 0: driver: \(b.Why)")
		return
	}
	desktop.Check(&d)
	match compare(&h, &d, w, same) {
	case Some[string] as why:
		Console.Println("differ 0: \(why.Value)")
	case None:
		Console.Println("ok 0")
	}
	for i, line in steps {
		let n = i + 1
		if line == "work" {
			Console.Println("work \(desktop.LaidOut(&d))")
			continue
		}
		if line == "drawn" {
			Console.Println("drawn \(desktop.Drawn(&d))")
			continue
		}
		let (a, b) = run(&h, &d, w, line, same)
		if a != b {
			Console.Println("differ \(n): \(line): test host \(said(a)), desktop \(said(b))")
			continue
		}
		match compare(&h, &d, w, same) {
		case Some[string] as why:
			Console.Println("differ \(n): \(line): \(why.Value)")
		case None:
			Console.Println("ok \(n)")
		}
	}
	Console.Println("end")
}

func said(r result) string {
	match r {
	case Done:
		"done"
	case Missing as m:
		"no node \(m.Label)"
	case Broke as b:
		"failed \(b.Why)"
	}
}

// compare is why the hosts differ now, None when they agree: the tree,
// the app state, each probe's pixel in the window's frame, the window's
// accessibility tree (access.ergo), and each look's state (states.ergo). First
// TestHost takes the viewport the window reported for each list (follow).
func compare[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut desktop.Driver[S, E, D, F], w go.Ref[screen.Window], same func(a S, b S) bool) Option[string] needs go.Foreign {
	follow(h, d, desktop.Screen(d))
	match desktop.Differs(d) {
	case Some[string] as why:
		return Some{Value: "the kept layout differs from the reference: \(why.Value)"}
	case None:
	}
	if !ui.SameShapes(ui.Screen(h), desktop.Screen(d)) {
		return Some{Value: "trees differ:\n\(ui.Screenshot(h))desktop:\n\(shot(desktop.Screen(d), ""))"}
	}
	if !same(ui.StateOf(h), desktop.StateOf(d)) {
		return Some{Value: "states differ"}
	}
	match placed(d, desktop.Screen(d)) {
	case Some[string] as why:
		return why
	case None:
	}
	match fits(d, w, desktop.Screen(d)) {
	case Some[string] as why:
		return why
	case None:
	}
	match layersPlacedWrong(d) {
	case Some[string] as why:
		return why
	case None:
	}
	// The window was told the keyboard the focused field asks for (MB5).
	let (told, asks) = desktop.Keyboard(d)
	if told != asks {
		return Some{Value: "the window was told the \(told) keyboard, the field asks for \(asks)"}
	}
	// The root lies inside the insets (MB4): at their top left corner and
	// no further than their right and bottom edges.
	match desktop.RootBox(d) {
	case (Some[layout.Box] as b, room):
		let rx = float64(room.X)
		let ry = float64(room.Y)
		if float64(b.Value.X) != rx || float64(b.Value.Y) != ry || float64(b.Value.X+b.Value.W) > rx+float64(room.W)+0.01 || float64(b.Value.Y+b.Value.H) > ry+float64(room.H)+0.01 {
			return Some{Value: "the root is at \(bx(Some{Value: b.Value})), outside the insets' \(rx),\(ry) \(float64(room.W))x\(float64(room.H))"}
		}
	case _:
	}
	let _ = w.Render()
	if w.Slanted() != desktop.Slants(d) {
		return Some{Value: "the window slanted \(w.Slanted()) runs, the driver drew \(desktop.Slants(d)) italic"}
	}
	for p in desktop.Probes(d) {
		let got = w.Pixel(p.X, p.Y)
		if got != p.Color {
			return Some{Value: "pixel of \(p.Label) at \(p.X),\(p.Y) is \(strconv.FormatInt(int64(got), 16)), want \(strconv.FormatInt(int64(p.Color), 16))"}
		}
	}
	match trackedWrong(h, d, desktop.Screen(d)) {
	case Some[string] as why:
		return why
	case None:
	}
	match accessDiffers(d, w) {
	case Some[string] as why:
		return why
	case None:
	}
	match inksDiffer(h, d) {
	case Some[string] as why:
		return why
	case None:
	}
	lookStatesDiffer(h, d)
}

// trackedWrong is why a Pressable on an x track is painted elsewhere than
// TestHost's track value puts it (TRACKS): its look's probe, which sits
// where the window painted the body, is at the middle of its laid box
// moved by the value; None when every one is there.
func trackedWrong[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut desktop.Driver[S, E, D, F], shapes []ui.Shape[E]) Option[string] needs go.Foreign {
	for s in shapes {
		match s.Node {
		case ui.TrackNode as x:
			match x.Prop {
			case ui.TrackX:
				for k in s.Kids {
					match k.Node {
					case ui.PressableNode[E] as p:
						let v = match ui.TrackedValue(h, x.Key) {
						case Some[float64] as t:
							t.Value
						case None:
							return Some{Value: "TestHost runs no track for \(p.Label)"}
						}
						match desktop.LaidOf(d, p.Label) {
						case Some[layout.Box] as lb:
							let want = int(lb.Value.X + float32(v) + lb.Value.W/2)
							let mut seen = false
							for pr in desktop.Probes(d) {
								if pr.Label == p.Label {
									seen = true
									if pr.X != want {
										return Some{Value: "\(p.Label) on a track at \(v) is painted at x \(pr.X), want \(want)"}
									}
								}
							}
							if !seen {
								return Some{Value: "\(p.Label) on a track has no look probe"}
							}
						case None:
							return Some{Value: "\(p.Label) on a track has no box"}
						}
					case _:
					}
				}
			case _:
			}
		case _:
		}
		match trackedWrong[E, S, D, F](h, d, s.Kids) {
		case Some[string] as why:
			return why
		case None:
		}
	}
	None
}

// shielded is whether a layer's scrim covers the list labelled label in
// shapes: a scrim layer is open and the list is in none.
func shielded[E](shapes []ui.Shape[E], label string) bool {
	scrimIn[E](shapes) && !underScrim[E](shapes, label, false)
}

// underScrim is whether the list labelled label is in a layer with a
// scrim (covered: shapes are in one).
func underScrim[E](shapes []ui.Shape[E], label string, covered bool) bool {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			if x.Label == label {
				return covered
			}
		case _:
		}
		if found[E](s.Kids, label) {
			return underScrim[E](s.Kids, label, covered || isScrim(s.Node))
		}
	}
	false
}

// scrimIn is whether a layer with a scrim is anywhere in shapes.
func scrimIn[E](shapes []ui.Shape[E]) bool {
	for s in shapes {
		if isScrim(s.Node) || scrimIn[E](s.Kids) {
			return true
		}
	}
	false
}

// isScrim is whether n is a layer with a scrim.
func isScrim[E](n ui.Node[E]) bool {
	match n {
	case ui.LayerNode[E] as l:
		l.Scrim
	case _:
		false
	}
}

// found is whether the list labelled label is in shapes.
func found[E](shapes []ui.Shape[E], label string) bool {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			if x.Label == label {
				return true
			}
		case _:
		}
		if found[E](s.Kids, label) {
			return true
		}
	}
	false
}

// maxOffset is how far the list labelled label scrolls in a viewport
// height high: its content less the height, at least 0.
func maxOffset[E](shapes []ui.Shape[E], label string, height float64) float64 {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			if x.Label == label {
				let most = float64(x.Count)*float64(x.RowHeight) - height
				return if most > 0 { most } else { 0 }
			}
		case _:
		}
		let m = maxOffset[E](s.Kids, label, height)
		if m >= 0 {
			return m
		}
	}
	-1
}

func bx(o Option[layout.Box]) string {
	match o {
	case Some[layout.Box] as b:
		"\(b.Value.X),\(b.Value.Y) \(b.Value.W)x\(b.Value.H)"
	case None:
		"none"
	}
}

// shot is the desktop's tree as text, one node a line by its kind and
// label: what a differing step prints beside TestHost's screenshot.
func shot[E](shapes []ui.Shape[E], indent string) string {
	let mut out = ""
	for s in shapes {
		let what = match s.Node {
		case ui.RowsNode as x:
			"rows \"\(x.Label)\" \(x.Count) from \(x.First)"
		case ui.PressableNode[E] as x:
			"button \"\(x.Label)\""
		case ui.TextNode as x:
			"text \"\(x.Value)\""
		case ui.CanvasNode as x:
			"canvas \"\(x.Label)\" \(len(x.Paint)) ops"
		case _:
			"node"
		}
		out = out + indent + what + "\n" + shot[E](s.Kids, indent+"  ")
	}
	out
}

// placed is why a list is not where it shows, None when each is: the
// viewport the window reported is the list's box height and an offset
// inside its content, and each row it wrote (a button, by label) shows at
// the list's top plus its index's rows, less the offset.
func placed[E comparable, S, D, F](d mut desktop.Driver[S, E, D, F], shapes []ui.Shape[E]) Option[string] {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			// A list a scrim covers is reported once the scrim goes: its
			// viewport may lag its box till then.
			if shielded(desktop.Screen(d), x.Label) {
				continue
			}
			let (v, lb) = match (desktop.Viewport(d, x.Label), desktop.BoxOf(d, x.Label)) {
			case (Some[ui.Viewport] as v, Some[layout.Box] as b):
				(v.Value, b.Value)
			case _:
				return Some{Value: "list \(x.Label) has no viewport or box"}
			}
			let rh = float64(x.RowHeight)
			let off = float64(v.Offset)
			let most = float64(x.Count)*rh - float64(lb.H)
			if float64(v.Height) != float64(lb.H) || off < 0 || (off > 0 && off > most) {
				return Some{Value: "list \(x.Label): viewport \(off)+\(float64(v.Height)) in a box \(lb.H) high over \(x.Count) rows"}
			}
			if off != float64(x.Offset) && !(float64(x.Offset) > most && off == most) {
				return Some{Value: "list \(x.Label) shows at offset \(off); its pass wrote \(float64(x.Offset))"}
			}
			for i, k in s.Kids {
				match k.Node {
				case ui.PressableNode[E] as p:
					match desktop.BoxOf(d, p.Label) {
					case Some[layout.Box] as b:
						let want = float64(lb.Y) + float64(x.First+i)*rh - off
						if float64(b.Value.Y) != want || float64(b.Value.H) != rh || b.Value.X != lb.X || b.Value.W != lb.W {
							return Some{Value: "\(p.Label) shows at \(bx(Some{Value: b.Value})); want y \(want), \(rh) high, as wide as the list at \(bx(Some{Value: lb}))"}
						}
					case None:
						return Some{Value: "\(p.Label) has no box"}
					}
				case _:
				}
			}
		case _:
			match placed[E, S, D, F](d, s.Kids) {
			case Some[string] as why:
				return why
			case None:
			}
		}
	}
	None
}

// fits is why a text's box does not hold it, None when each does: the
// box the driver laid a text out in (by its value, the first node of that
// label) is at least as wide as its widest word, as the window's text
// engine measures it at the driver's size, 16 DIPs.
func fits[E comparable, S, D, F](d mut desktop.Driver[S, E, D, F], w go.Ref[screen.Window], shapes []ui.Shape[E]) Option[string] needs go.Foreign {
	for s in shapes {
		match s.Node {
		case ui.TextNode as x:
			let mut widest = 0.0
			for word in strings.Fields(x.Value) {
				let n = w.TextWidth(word, 16)
				if n > widest {
					widest = n
				}
			}
			match desktop.BoxOf(d, x.Value) {
			case Some[layout.Box] as b:
				if float64(b.Value.W)+0.01 < widest {
					return Some{Value: "text \"\(x.Value)\" is laid out \(b.Value.W) wide; its widest word is \(widest)"}
				}
			case None:
			}
		case _:
		}
		match fits[E, S, D, F](d, w, s.Kids) {
		case Some[string] as why:
			return why
		case None:
		}
	}
	None
}

// follow scrolls each list of TestHost to the viewport the window
// reported for it: a window decides a list's height and where a person
// scrolled it, and TestHost, which has no window, takes it as a host's
// report (ui.ScrollTo). Then both write the same rows.
func follow[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut desktop.Driver[S, E, D, F], shapes []ui.Shape[E]) needs go.Foreign {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			match (desktop.Viewport(d, x.Label), ui.Find(h, x.Label)) {
			case (Some[ui.Viewport] as v, Some[ui.Id[E]] as id):
				ui.ScrollTo(h, id.Value, v.Value.Offset, v.Value.Height) catch {
				case actor.Stopped, ui.BadPatch:
				}
			case _:
			}
		case _:
			follow[E, S, D, F](h, d, s.Kids)
		}
	}
}

// run does one step on each host.
func run[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut desktop.Driver[S, E, D, F], w go.Ref[screen.Window], line string, same func(a S, b S) bool) (result, result) needs go.Foreign {
	let (verb, rest) = match strings.Cut(line, " ") {
	case Some[strings.Halves] as c:
		(c.Value.Before, c.Value.After)
	case None:
		(line, "")
	}
	match verb {
	case "tap":
		both(h, d, ui.TapOn{Label: rest})
	case "type":
		match strings.Cut(rest, "\t") {
		case Some[strings.Halves] as c:
			both(h, d, ui.TypeInto{Label: c.Value.Before, Text: c.Value.After})
		case None:
			(Broke{Why: "type needs a tab"}, Broke{Why: "type needs a tab"})
		}
	case "key":
		let act = ui.KeyIn{Press: ui.KeyPress{Name: rest, Mods: ui.Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}
		// A character typed with a field focused goes into the field on the
		// desktop; TestHost, which has no focus, types it there too.
		match (desktop.FocusId(d), desktop.FocusNode(d)) {
		case (Some[ui.Id[E]] as id, Some[ui.Node[E]] as n):
			match n.Value {
			case ui.InputNode as x:
				if utf8.RuneCount(rest) == 1 && rest != " " {
					let b = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
						try desktop.Play(d, []ui.Act{act})
					})
					let a = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
						try ui.TypeText(h, id.Value, x.Value+rest)
					})
					return (a, b)
				}
			case _:
			}
		case _:
		}
		both(h, d, act)
	case "point":
		let f = strings.Fields(rest)
		if len(f) != 4 {
			return (Broke{Why: "point LABEL PHASE X Y"}, Broke{Why: "point LABEL PHASE X Y"})
		}
		let x = float64(atoi(f[2]))
		let y = float64(atoi(f[3]))
		let phase = match f[1] {
		case "down":
			ui.Down
		case "up":
			ui.Up
		case "move":
			ui.Moved
		case _:
			ui.Wheel{DX: 0, DY: y}
		}
		both(h, d, ui.PointOn{Label: f[0], Pointer: ui.PointerEvent{Pointer: ui.MousePointer, Phase: phase, X: x, Y: y, Zone: None}})
	case "scroll":
		let f = strings.Fields(rest)
		if len(f) != 2 {
			return (Broke{Why: "scroll LABEL N"}, Broke{Why: "scroll LABEL N"})
		}
		let to = float64(atoi(f[1]))
		// Under a scrim the wheel scrolls nothing: the list stays (UG4).
		let mut stays Option[float64] = None
		match desktop.Viewport(d, f[0]) {
		case Some[ui.Viewport] as v:
			if shielded(desktop.Screen(d), f[0]) {
				stays = Some{Value: float64(v.Value.Offset)}
			}
		case None:
		}
		let mut b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
			try desktop.Play(d, []ui.Act{ui.ScrollOn{Label: f[0], Offset: ui.Length(to), Height: 0}})
		})
		// The list is where the step scrolled it: at the offset, or as far
		// as its content goes.
		match (b, desktop.Viewport(d, f[0])) {
		case (Done, Some[ui.Viewport] as v):
			let most = maxOffset(desktop.Screen(d), f[0], float64(v.Value.Height))
			let want = match stays {
			case Some[float64] as s:
				s.Value
			case None:
				if to < most { to } else { most }
			}
			if float64(v.Value.Offset) != want {
				b = Broke{Why: "scrolled to \(float64(v.Value.Offset)), want \(want)"}
			}
		case _:
		}
		let a = match ui.Find(h, f[0]) {
		case Some[ui.Id[E]]:
			Done
		case None:
			Missing{Label: f[0]}
		}
		(a, b)
	case "finger":
		// A finger (MB4): "finger scroll LABEL N" drags the list by N,
		// within its content; "finger tap LABEL" taps it; "finger near
		// LABEL" taps 10 DIP past its right edge, within the reach margin.
		let f = strings.Fields(rest)
		if len(f) < 2 {
			return (Broke{Why: "finger scroll|tap|near LABEL"}, Broke{Why: "finger scroll|tap|near LABEL"})
		}
		if f[0] == "scroll" && len(f) == 3 {
			let mut b result = Done
			match desktop.Viewport(d, f[1]) {
			case Some[ui.Viewport] as v:
				let most = maxOffset(desktop.Screen(d), f[1], float64(v.Value.Height))
				let at = float64(v.Value.Offset)
				let to = float64(atoi(f[2]))
				let want = if to < 0 { 0.0 } else if to > most { most } else { to }
				b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
					try desktop.FingerScroll(d, f[1], float32(want-at))
				})
				match (b, desktop.Viewport(d, f[1])) {
				case (Done, Some[ui.Viewport] as v2):
					if math.Abs(float64(v2.Value.Offset)-want) > 0.01 {
						b = Broke{Why: "a finger scrolled to \(float64(v2.Value.Offset)), want \(want)"}
					}
				case _:
				}
			case None:
				b = Missing{Label: f[1]}
			}
			let a = match ui.Find(h, f[1]) {
			case Some[ui.Id[E]]:
				Done
			case None:
				Missing{Label: f[1]}
			}
			return (a, b)
		}
		let beyond = if f[0] == "near" { float32(10) } else { float32(0) }
		// The test host taps with the finger too: a finger does not hover.
		let a = match ui.Find(h, f[1]) {
		case Some[ui.Id[E]] as id:
			played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
				try ui.TapWith(h, id.Value, desktop.TheFinger)
			})
		case None:
			Missing{Label: f[1]}
		}
		let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
			try desktop.FingerTap(d, f[1], beyond)
		})
		(a, b)
	case "insets":
		// The system covers the window's edges (MB4): the window lays the
		// root out inside them; TestHost has no window.
		let f = strings.Fields(rest)
		if len(f) != 4 {
			return (Broke{Why: "insets T R B L"}, Broke{Why: "insets T R B L"})
		}
		let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
			try desktop.SetInsets(d, ui.Insets{Top: ui.Length(float64(atoi(f[0]))), Right: ui.Length(float64(atoi(f[1]))), Bottom: ui.Length(float64(atoi(f[2]))), Left: ui.Length(float64(atoi(f[3])))})
		})
		(Done, b)
	case "compose":
		// An input method composes TEXT over all of the field's text and
		// commits it (MB5): the program's state stays as it was while the
		// composition is open, then the field's value is TEXT.
		match strings.Cut(rest, "\t") {
		case Some[strings.Halves] as c:
			let was = desktop.StateOf(d)
			let mut b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
				try desktop.ComposeOn(d, c.Value.Before, c.Value.After)
			})
			if !same(was, desktop.StateOf(d)) {
				b = Broke{Why: "the state changed while the composition was open"}
			}
			match b {
			case Done:
				b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
					try desktop.CommitComposition(d)
				})
			case _:
			}
			(played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
				try ui.Play(h, []ui.Act{ui.TypeInto{Label: c.Value.Before, Text: c.Value.After}})
			}), b)
		case None:
			(Broke{Why: "compose needs a tab"}, Broke{Why: "compose needs a tab"})
		}
	case "settle":
		both(h, d, ui.SettleAll)
	case "away":
		// The pointer leaves every node (UG3).
		let a = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
			try ui.PointNowhere(h)
		})
		let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
			try desktop.PointAway(d)
		})
		(a, b)
	case "focus":
		focusPress(h, d, w, atoi(rest))
	case _:
		(Broke{Why: "no step \(verb)"}, Broke{Why: "no step \(verb)"})
	}
}

func atoi(s string) int {
	strconv.Atoi(s) catch {
	case strconv.Malformed, strconv.OutOfRange:
		0
	}
}

// both plays one act on each host.
func both[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut desktop.Driver[S, E, D, F], act ui.Act) (result, result) needs go.Foreign {
	let a = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
		try ui.Play(h, []ui.Act{act})
	})
	let b = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
		try desktop.Play(d, []ui.Act{act})
	})
	(a, b)
}

func played(f func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign) result needs go.Foreign {
	f() catch {
	case ui.NoNode as n:
		return Missing{Label: n.Label}
	case ui.Ambiguous as amb:
		return Broke{Why: "\(amb.Count) nodes at \(amb.At)"}
	case ui.Mismatch as m:
		return Broke{Why: "want \(m.Want), got \(m.Got)"}
	case actor.Stopped:
		return Broke{Why: "stopped"}
	case ui.BadPatch as b:
		return Broke{Why: b.Why}
	case ui.Closed:
		return Broke{Why: "closed"}
	}
	Done
}

// focusPress clears the desktop's focus with a click on the empty corner
// of the window, moves it with Tab k times and presses the focused node
// with Enter (types "z" into a field); TestHost presses (or types into)
// the node the desktop focused. The focus order is the tree's: after k
// Tabs the focus is on the (k-1 mod n)-th of the n focusable nodes.
func focusPress[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut desktop.Driver[S, E, D, F], w go.Ref[screen.Window], k int) (result, result) needs go.Foreign {
	// Both hosts click where no node is, then reach the node by keys.
	let a0 = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch needs go.Foreign {
		try ui.ClickNowhere(h)
	})
	w.Press(470, 630)
	w.Release(470, 630)
	for _ in 0..k {
		w.PressKey("Tab", false)
	}
	let b = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
		try desktop.Drain(d)
	})
	let order = desktop.Focusables(d)
	let mut want Option[ui.Id[E]] = None
	if k > 0 && len(order) > 0 {
		want = Some{Value: order[(k-1)%len(order)]}
	}
	if desktop.FocusId(d) != want {
		return (Done, Broke{Why: "after \(k) Tabs the focus is not on the node it reaches in tree order (of \(len(order)))"})
	}
	match desktop.FocusId(d) {
	case Some[ui.Id[E]] as id:
		match desktop.FocusNode(d) {
		case Some[ui.Node[E]] as n:
			match n.Value {
			case ui.InputNode as x:
				w.Type("z")
				let b2 = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					try desktop.Drain(d)
				})
				let a = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					// The window typed with the pointer where no node is.
					try ui.TypeText(h, id.Value, x.Value+"z")
					try ui.PointNowhere(h)
				})
				return (a, b2)
			case _:
				w.PressKey("Enter", false)
				let b2 = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					try desktop.Drain(d)
				})
				let a = played(func() fails ui.NoNode | ui.Ambiguous | ui.Mismatch | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					try ui.Activate(h, id.Value)
				})
				return (a, b2)
			}
		case None:
		}
	case None:
	}
	(a0, b)
}
