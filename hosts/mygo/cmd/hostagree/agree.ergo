import actor
import go ergo.local/prototype/hosts/mygo/screen
import ergo.local/prototype/hosts/mygo/desktop
import strconv
import strings
import time
import ui
import ui/layout
import utf8

// result is how a step ended on one host: done, or the label it found no
// node for, or how it failed.
type result = Done{} | Missing{Label string} | Broke{Why string}

// agree plays steps on both hosts and prints whether they agree after
// each.
func agree[E comparable, S](m Machine[S, E, int], view escaping func(f *ui.Frame[E], s S), same func(a S, b S) bool, steps []string) needs Console | Scheduler | go.Foreign {
	let w = screen.Headless(480, 640) catch {
	case go.Error as e:
		Console.Println("differ 0: no window: \(e.Text)")
		return
	}
	let ta = actor.StartMachine(m, 1, func(o int) {})
	let da = actor.StartMachine(m, 1, func(o int) {})
	let mut h = ui.NewTestHost(ta, view, time.NewManual(0), 16) catch {
	case ui.BadPatch as b:
		Console.Println("differ 0: test host: \(b.Why)")
		return
	}
	let mut d = desktop.New(w, da, view, 16) catch {
	case ui.BadPatch as b:
		Console.Println("differ 0: driver: \(b.Why)")
		return
	}
	match compare(&h, &d, w, same) {
	case Some[string] as why:
		Console.Println("differ 0: \(why.Value)")
	case None:
		Console.Println("ok 0")
	}
	for i, line in steps {
		let n = i + 1
		let (a, b) = run(&h, &d, w, line)
		if a != b {
			Console.Println("differ \(n): \(line): test host \(said(a)), desktop \(said(b))")
			continue
		}
		match compare(&h, &d, w, same) {
		case Some[string] as why:
			Console.Println("differ \(n): \(line): \(why.Value)")
		case None:
			Console.Println("ok \(n)")
		}
	}
	Console.Println("end")
}

func said(r result) string {
	match r {
	case Done:
		"done"
	case Missing as m:
		"no node \(m.Label)"
	case Broke as b:
		"failed \(b.Why)"
	}
}

// compare is why the hosts differ now, None when they agree: the tree,
// the app state, and each probe's pixel in the window's frame. First
// TestHost takes the viewport the window reported for each list (follow).
func compare[E comparable, S, D, F](h *ui.TestHost[S, E, D, F], d *desktop.Driver[S, E, D, F], w go.Ref[screen.Window], same func(a S, b S) bool) Option[string] needs go.Foreign {
	follow(h, d, desktop.Screen(d))
	if !ui.SameShapes(ui.Screen(h), desktop.Screen(d)) {
		return Some{Value: "trees differ:\n\(ui.Screenshot(h))desktop:\n\(shot(desktop.Screen(d), ""))"}
	}
	if !same(ui.StateOf(h), desktop.StateOf(d)) {
		return Some{Value: "states differ"}
	}
	match placed(d, desktop.Screen(d)) {
	case Some[string] as why:
		return why
	case None:
	}
	let _ = w.Render()
	for p in desktop.Probes(d) {
		let got = w.Pixel(p.X, p.Y)
		if got != p.Color {
			return Some{Value: "pixel of \(p.Label) at \(p.X),\(p.Y) is \(strconv.FormatInt(int64(got), 16)), want \(strconv.FormatInt(int64(p.Color), 16))"}
		}
	}
	None
}

// maxOffset is how far the list labelled label scrolls in a viewport
// height high: its content less the height, at least 0.
func maxOffset[E](shapes []ui.Shape[E], label string, height float64) float64 {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			if x.Label == label {
				let most = float64(x.Count)*float64(x.RowHeight) - height
				return if most > 0 { most } else { 0 }
			}
		case _:
		}
		let m = maxOffset[E](s.Kids, label, height)
		if m >= 0 {
			return m
		}
	}
	-1
}

func bx(o Option[layout.Box]) string {
	match o {
	case Some[layout.Box] as b:
		"\(b.Value.X),\(b.Value.Y) \(b.Value.W)x\(b.Value.H)"
	case None:
		"none"
	}
}

// shot is the desktop's tree as text, one node a line by its kind and
// label: what a differing step prints beside TestHost's screenshot.
func shot[E](shapes []ui.Shape[E], indent string) string {
	let mut out = ""
	for s in shapes {
		let what = match s.Node {
		case ui.RowsNode as x:
			"rows \"\(x.Label)\" \(x.Count) from \(x.First)"
		case ui.PressableNode[E] as x:
			"button \"\(x.Label)\""
		case ui.TextNode as x:
			"text \"\(x.Value)\""
		case ui.CanvasNode as x:
			"canvas \"\(x.Label)\" \(len(x.Paint)) ops"
		case _:
			"node"
		}
		out = out + indent + what + "\n" + shot[E](s.Kids, indent+"  ")
	}
	out
}

// placed is why a list is not where it shows, None when each is: the
// viewport the window reported is the list's box height and an offset
// inside its content, and each row it wrote (a button, by label) shows at
// the list's top plus its index's rows, less the offset.
func placed[E comparable, S, D, F](d *desktop.Driver[S, E, D, F], shapes []ui.Shape[E]) Option[string] {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			let (v, lb) = match (desktop.Viewport(d, x.Label), desktop.BoxOf(d, x.Label)) {
			case (Some[ui.Viewport] as v, Some[layout.Box] as b):
				(v.Value, b.Value)
			case _:
				return Some{Value: "list \(x.Label) has no viewport or box"}
			}
			let rh = float64(x.RowHeight)
			let off = float64(v.Offset)
			let most = float64(x.Count)*rh - float64(lb.H)
			if float64(v.Height) != float64(lb.H) || off < 0 || (off > 0 && off > most) {
				return Some{Value: "list \(x.Label): viewport \(off)+\(float64(v.Height)) in a box \(lb.H) high over \(x.Count) rows"}
			}
			for i, k in s.Kids {
				match k.Node {
				case ui.PressableNode[E] as p:
					match desktop.BoxOf(d, p.Label) {
					case Some[layout.Box] as b:
						let want = float64(lb.Y) + float64(x.First+i)*rh - off
						if float64(b.Value.Y) != want || float64(b.Value.H) != rh || b.Value.X != lb.X || b.Value.W != lb.W {
							return Some{Value: "\(p.Label) shows at \(bx(Some{Value: b.Value})); want y \(want), \(rh) high, as wide as the list at \(bx(Some{Value: lb}))"}
						}
					case None:
						return Some{Value: "\(p.Label) has no box"}
					}
				case _:
				}
			}
		case _:
			match placed[E, S, D, F](d, s.Kids) {
			case Some[string] as why:
				return why
			case None:
			}
		}
	}
	None
}

// follow scrolls each list of TestHost to the viewport the window
// reported for it: a window decides a list's height and where a person
// scrolled it, and TestHost, which has no window, takes it as a host's
// report (ui.ScrollTo). Then both write the same rows.
func follow[E comparable, S, D, F](h *ui.TestHost[S, E, D, F], d *desktop.Driver[S, E, D, F], shapes []ui.Shape[E]) needs go.Foreign {
	for s in shapes {
		match s.Node {
		case ui.RowsNode as x:
			match (desktop.Viewport(d, x.Label), ui.Find(h, x.Label)) {
			case (Some[ui.Viewport] as v, Some[ui.Id[E]] as id):
				ui.ScrollTo(h, id.Value, v.Value.Offset, v.Value.Height) catch {
				case actor.Stopped, ui.BadPatch:
				}
			case _:
			}
		case _:
			follow[E, S, D, F](h, d, s.Kids)
		}
	}
}

// run does one step on each host.
func run[E comparable, S, D, F](h *ui.TestHost[S, E, D, F], d *desktop.Driver[S, E, D, F], w go.Ref[screen.Window], line string) (result, result) needs go.Foreign {
	let (verb, rest) = match strings.Cut(line, " ") {
	case Some[strings.Halves] as c:
		(c.Value.Before, c.Value.After)
	case None:
		(line, "")
	}
	match verb {
	case "tap":
		both(h, d, ui.TapOn{Label: rest})
	case "type":
		match strings.Cut(rest, "\t") {
		case Some[strings.Halves] as c:
			both(h, d, ui.TypeInto{Label: c.Value.Before, Text: c.Value.After})
		case None:
			(Broke{Why: "type needs a tab"}, Broke{Why: "type needs a tab"})
		}
	case "key":
		let act = ui.KeyIn{Press: ui.KeyPress{Name: rest, Mods: ui.Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}
		// A character typed with a field focused goes into the field on the
		// desktop; TestHost, which has no focus, types it there too.
		match (desktop.FocusId(d), desktop.FocusNode(d)) {
		case (Some[ui.Id[E]] as id, Some[ui.Node[E]] as n):
			match n.Value {
			case ui.InputNode as x:
				if utf8.RuneCount(rest) == 1 && rest != " " {
					let b = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
						try desktop.Play(d, []ui.Act{act})
					})
					let a = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
						try ui.TypeText(h, id.Value, x.Value+rest)
					})
					return (a, b)
				}
			case _:
			}
		case _:
		}
		both(h, d, act)
	case "point":
		let f = strings.Fields(rest)
		if len(f) != 4 {
			return (Broke{Why: "point LABEL PHASE X Y"}, Broke{Why: "point LABEL PHASE X Y"})
		}
		let x = float64(atoi(f[2]))
		let y = float64(atoi(f[3]))
		let phase = match f[1] {
		case "down":
			ui.Down
		case "up":
			ui.Up
		case "move":
			ui.Moved
		case _:
			ui.Wheel{DX: 0, DY: y}
		}
		both(h, d, ui.PointOn{Label: f[0], Pointer: ui.PointerEvent{Phase: phase, X: x, Y: y}})
	case "scroll":
		let f = strings.Fields(rest)
		if len(f) != 2 {
			return (Broke{Why: "scroll LABEL N"}, Broke{Why: "scroll LABEL N"})
		}
		let to = float64(atoi(f[1]))
		let mut b = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
			try desktop.Play(d, []ui.Act{ui.ScrollOn{Label: f[0], Offset: ui.Length(to), Height: 0}})
		})
		// The list is where the step scrolled it: at the offset, or as far
		// as its content goes.
		match (b, desktop.Viewport(d, f[0])) {
		case (Done, Some[ui.Viewport] as v):
			let most = maxOffset(desktop.Screen(d), f[0], float64(v.Value.Height))
			let want = if to < most { to } else { most }
			if float64(v.Value.Offset) != want {
				b = Broke{Why: "scrolled to \(float64(v.Value.Offset)), want \(want)"}
			}
		case _:
		}
		let a = match ui.Find(h, f[0]) {
		case Some[ui.Id[E]]:
			Done
		case None:
			Missing{Label: f[0]}
		}
		(a, b)
	case "settle":
		both(h, d, ui.SettleAll)
	case "focus":
		focusPress(h, d, w, atoi(rest))
	case _:
		(Broke{Why: "no step \(verb)"}, Broke{Why: "no step \(verb)"})
	}
}

func atoi(s string) int {
	strconv.Atoi(s) catch {
	case strconv.Malformed, strconv.OutOfRange:
		0
	}
}

// both plays one act on each host.
func both[E comparable, S, D, F](h *ui.TestHost[S, E, D, F], d *desktop.Driver[S, E, D, F], act ui.Act) (result, result) needs go.Foreign {
	let a = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
		try ui.Play(h, []ui.Act{act})
	})
	let b = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
		try desktop.Play(d, []ui.Act{act})
	})
	(a, b)
}

func played(f func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign) result needs go.Foreign {
	f() catch {
	case ui.NoNode as n:
		return Missing{Label: n.Label}
	case actor.Stopped:
		return Broke{Why: "stopped"}
	case ui.BadPatch as b:
		return Broke{Why: b.Why}
	case ui.Closed:
		return Broke{Why: "closed"}
	}
	Done
}

// focusPress clears the desktop's focus with a click on the empty corner
// of the window, moves it with Tab k times and presses the focused node
// with Enter (types "z" into a field); TestHost presses (or types into)
// the node the desktop focused. The focus order is the tree's: after k
// Tabs the focus is on the (k-1 mod n)-th of the n focusable nodes.
func focusPress[E comparable, S, D, F](h *ui.TestHost[S, E, D, F], d *desktop.Driver[S, E, D, F], w go.Ref[screen.Window], k int) (result, result) needs go.Foreign {
	w.Press(470, 630)
	w.Release(470, 630)
	for _ in 0..k {
		w.PressKey("Tab", false)
	}
	let b = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
		try desktop.Drain(d)
	})
	let order = desktop.Focusables(d)
	let mut want Option[ui.Id[E]] = None
	if k > 0 && len(order) > 0 {
		want = Some{Value: order[(k-1)%len(order)]}
	}
	if desktop.FocusId(d) != want {
		return (Done, Broke{Why: "after \(k) Tabs the focus is not on the node it reaches in tree order (of \(len(order)))"})
	}
	match desktop.FocusId(d) {
	case Some[ui.Id[E]] as id:
		match desktop.FocusNode(d) {
		case Some[ui.Node[E]] as n:
			match n.Value {
			case ui.InputNode as x:
				w.Type("z")
				let b2 = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					try desktop.Drain(d)
				})
				let a = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					try ui.TypeText(h, id.Value, x.Value+"z")
				})
				return (a, b2)
			case _:
				w.PressKey("Enter", false)
				let b2 = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					try desktop.Drain(d)
				})
				let a = played(func() fails ui.NoNode | actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
					try ui.Tap(h, id.Value)
				})
				return (a, b2)
			}
		case None:
		}
	case None:
	}
	(Done, b)
}
