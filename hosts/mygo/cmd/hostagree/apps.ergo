// The small apps of the agreement: a counter with keys, a keyed list with
// deletes, a form of fields and checks, a load whose key changes, and a
// pointer pad.

import ui

func none[S, E](s S) Option[Timeout[E]] { None }

func idle[S, E](s S) Option[func(send func(e E))] { None }

// counter: a signal adds to the count; 0 resets it.
func counterStep(s int, e int) Decision[int, int] {
	if e == 0 {
		return Enter[int]{Next: 0}
	}
	Enter[int]{Next: s + e}
}

func counterMachine() Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: counterStep, After: none[int, int], Work: idle[int, int], Exit: func(s int) Option[func()] { None }}
}

func counterView(f mut ui.Frame[int], s int) {
	let mut col = ui.Plain()
	col.Gap = 8
	col.Padding = ui.All(16)
	ui.Column(f, col) {
		ui.Text(f, "count \(s)")
		let mut row = ui.Plain()
		row.Gap = 8
		ui.Row(f, row) {
			ui.Pressable(f, "dec", -1) {
				ui.Text(f, "−")
			}
			ui.Pressable(f, "inc", 1) {
				ui.Text(f, "+")
			}
			ui.Pressable(f, "reset", 0) {
				ui.Text(f, "Reset")
			}
		}
		ui.OnKey(f, func(k ui.KeyPress) Option[int] {
			match k.Name {
			case "+":
				Some{Value: 1}
			case "-":
				Some{Value: -1}
			case "x":
				Some{Value: 0}
			case _:
				None
			}
		})
	}
}

// shelf: rows by key; signal 0 adds one, k removes row k.
type shelf { rows []int, next int }

func shelfStep(s shelf, e int) Decision[shelf, int] {
	if e == 0 {
		return Enter[shelf]{Next: shelf{rows: s.rows.Append(s.next), next: s.next + 1}}
	}
	let mut rows = []int{}
	for k in s.rows {
		if k != e {
			rows = rows.Append(k)
		}
	}
	Enter[shelf]{Next: shelf{rows: rows, next: s.next}}
}

func sameShelf(a shelf, b shelf) bool {
	if a.next != b.next || len(a.rows) != len(b.rows) {
		return false
	}
	for i, k in a.rows {
		if b.rows[i] != k {
			return false
		}
	}
	true
}

func shelfMachine() Machine[shelf, int, int] {
	Machine[shelf, int, int]{Initial: shelf{rows: []int{}, next: 1}, Step: shelfStep, After: none[shelf, int], Work: idle[shelf, int], Exit: func(s shelf) Option[func()] { None }}
}

// shelfView: every row's delete button is labelled "del", so a script's
// "del" takes the first row on the screen; the list scrolls.
func shelfView(f mut ui.Frame[int], s shelf) {
	ui.Column(f, ui.Plain()) {
		ui.Text(f, "\(len(s.rows)) rows")
		ui.Pressable(f, "add", 0) {
			ui.Text(f, "Add")
		}
		let mut list = ui.Plain()
		list.Height = ui.Fixed{Value: 300}
		ui.Scroll(f, list) {
			ui.Each(f, s.rows, func(k int) ui.Key { ui.ByInt(k) }) func(k int) {
				let mut row = ui.Plain()
				row.Gap = 8
				row.Align = ui.AlignCenter
				ui.Row(f, row) {
					ui.Text(f, "row \(k)")
					ui.Pressable(f, "del", k) {
						ui.Text(f, "×")
					}
				}
			}
		}
	}
}

// form: a name field, a done check, a send button, and the view's own
// note field and bold toggle (cells of the frame, not of the app).
type form { name string, done bool, sent int }

type formEvent = Named{Text string} | Flipped{} | Sent{}

func formStep(s form, e formEvent) Decision[form, int] {
	match e {
	case Named as n:
		Enter[form]{Next: form{name: n.Text, done: s.done, sent: s.sent}}
	case Flipped:
		Enter[form]{Next: form{name: s.name, done: !s.done, sent: s.sent}}
	case Sent:
		Enter[form]{Next: form{name: s.name, done: s.done, sent: s.sent + 1}}
	}
}

func formMachine() Machine[form, formEvent, int] {
	Machine[form, formEvent, int]{Initial: form{name: "", done: false, sent: 0}, Step: formStep, After: none[form, formEvent], Work: idle[form, formEvent], Exit: func(s form) Option[func()] { None }}
}

func formView(f mut ui.Frame[formEvent], s form) {
	let mut col = ui.Plain()
	col.Gap = 6
	col.Padding = ui.All(12)
	ui.Column(f, col) {
		ui.Input(f, s.name, "name", func(t string) formEvent { Named{Text: t} })
		ui.Check(f, "done", s.done, Flipped)
		let bold = ui.NewFlag(f, false)
		ui.Toggle(f, bold, "bold")
		let note = ui.NewDraft(f, "")
		// A phone shows the note's field an email keyboard and a Send key
		// (MB5).
		ui.HintedField(f, ui.FieldLabel{Text: "", Description: "", Invalid: false}, ui.Hints{Keyboard: ui.EmailKeys, Return: ui.ReturnSend, Capitalize: ui.CapNone, Autocorrect: false}, note, "note")
		ui.Pressable(f, "send", Sent) {
			ui.Text(f, "Send \(s.sent)")
		}
		ui.Text(f, if bold.On { "HELLO \(s.name)" } else { "hello \(s.name)" })
		ui.Text(f, "note: \(note.Value)")
	}
}

// load: "next" moves the key; the view loads the key's value, which comes
// back as a negative signal.
type chosen { key int, ready int }

func chosenStep(s chosen, e int) Decision[chosen, int] {
	if e >= 0 {
		return Enter[chosen]{Next: chosen{key: s.key + 1, ready: -1}}
	}
	Enter[chosen]{Next: chosen{key: s.key, ready: -1 - e}}
}

func loadMachine() Machine[chosen, int, int] {
	Machine[chosen, int, int]{Initial: chosen{key: 0, ready: -1}, Step: chosenStep, After: none[chosen, int], Work: idle[chosen, int], Exit: func(s chosen) Option[func()] { None }}
}

func loadView(f mut ui.Frame[int], s chosen) {
	ui.Column(f, ui.Plain()) {
		ui.Pressable(f, "next", 1) {
			ui.Text(f, "Next")
		}
		let key = s.key
		ui.Load(f, ui.ByInt(key), func() int { -1 - (key*10 + 7) })
		ui.Text(f, "key \(s.key) ready \(s.ready)")
	}
}

// pad: an Area whose pointer events become signals, over a Pressable
// (the window's hit test takes the one painted last).
type pad { last int, n int }

func padStep(s pad, e int) Decision[pad, int] { Enter[pad]{Next: pad{last: e, n: s.n + 1}} }

func padMachine() Machine[pad, int, int] {
	Machine[pad, int, int]{Initial: pad{last: 0, n: 0}, Step: padStep, After: none[pad, int], Work: idle[pad, int], Exit: func(s pad) Option[func()] { None }}
}

func padView(f mut ui.Frame[int], s pad) {
	ui.Text(f, "last \(s.last) of \(s.n)")
	let mut area = ui.Plain()
	area.Width = ui.Fixed{Value: 200}
	area.Height = ui.Fixed{Value: 120}
	ui.Area(f, "pad", area, func(p ui.PointerEvent) Option[int] {
		match p.Phase {
		case ui.Down:
			Some{Value: 1000 + int(p.X) + 100*(s.n%3)}
		case ui.Up:
			Some{Value: 2000 + int(p.Y)}
		case ui.Wheel as w:
			Some{Value: 3000 + int(w.DY)}
		case ui.Drag:
			Some{Value: 4000 + int(p.X)}
		case ui.Moved, ui.PointerEnter, ui.PointerLeave:
			None
		}
	}) {
		ui.Text(f, "pad")
		ui.Pressable(f, "clear", 5000) {
			ui.Text(f, "Clear")
		}
	}
}

// list: a virtual list (ui.Rows) of n rows, a button each; "more" adds
// 25 rows (-1), "less" takes 25 (-2), "note" shows or hides a line above
// the list (-3), a row's button names its row. The list has no height of
// its own, so it takes the window below it, which the note moves.
type rowsApp { n int, last int, note bool, cur int }

func rowsStep(s rowsApp, e int) Decision[rowsApp, int] {
	if e == -1 {
		return Enter[rowsApp]{Next: rowsApp{n: s.n + 25, last: s.last, note: s.note, cur: s.cur}}
	}
	if e == -2 {
		return Enter[rowsApp]{Next: rowsApp{n: if s.n > 25 { s.n - 25 } else { 0 }, last: s.last, note: s.note, cur: s.cur}}
	}
	if e == -3 {
		return Enter[rowsApp]{Next: rowsApp{n: s.n, last: s.last, note: !s.note, cur: s.cur}}
	}
	if e == -4 {
		return Enter[rowsApp]{Next: rowsApp{n: s.n, last: s.last, note: s.note, cur: s.cur + 17}}
	}
	if e == -5 {
		return Enter[rowsApp]{Next: rowsApp{n: s.n, last: s.last, note: s.note, cur: if s.cur > 17 { s.cur - 17 } else { 0 }}}
	}
	Enter[rowsApp]{Next: rowsApp{n: s.n, last: e, note: s.note, cur: s.cur}}
}

func rowsMachine() Machine[rowsApp, int, int] {
	Machine[rowsApp, int, int]{Initial: rowsApp{n: 60, last: -1, note: false, cur: 0}, Step: rowsStep, After: none[rowsApp, int], Work: idle[rowsApp, int], Exit: func(s rowsApp) Option[func()] { None }}
}

func rowsView(f mut ui.Frame[int], s rowsApp) {
	ui.Column(f, ui.Plain()) {
		ui.Text(f, "\(s.n) rows, last \(s.last)")
		ui.Row(f, ui.Plain()) {
			ui.Pressable(f, "more", -1) {
				ui.Text(f, "More")
			}
			ui.Pressable(f, "less", -2) {
				ui.Text(f, "Less")
			}
			ui.Pressable(f, "note", -3) {
				ui.Text(f, "Note")
			}
			ui.Pressable(f, "down", -4) {
				ui.Text(f, "Down")
			}
			ui.Pressable(f, "up", -5) {
				ui.Text(f, "Up")
			}
		}
		if s.note {
			ui.Text(f, "a note above the list")
		}
		ui.RowsKeeping(f, "list", s.n, ui.Length(32.0), s.cur, func(i int) ui.Key { ui.ByInt(i) }, func(i int) {
			ui.Pressable(f, "row \(i)", i) {
				ui.Text(f, "row \(i)")
			}
		})
	}
}

// sketch: a canvas in an Area; a press puts a mark where it went down. The
// paint is a filled background, a stroke from the corner to the mark, a
// filled circle, and last the mark, a diamond moved there by a transform
// (the probe's fill).
type sketch { x int, y int, n int }

func sketchStep(s sketch, e int) Decision[sketch, int] {
	Enter[sketch]{Next: sketch{x: e % 1000, y: e / 1000, n: s.n + 1}}
}

func sketchMachine() Machine[sketch, int, int] {
	Machine[sketch, int, int]{Initial: sketch{x: 100, y: 75, n: 0}, Step: sketchStep, After: none[sketch, int], Work: idle[sketch, int], Exit: func(s sketch) Option[func()] { None }}
}

func sketchView(f mut ui.Frame[int], s sketch) {
	ui.Text(f, "mark \(s.x),\(s.y) of \(s.n)")
	ui.Area(f, "sketch", ui.Plain(), func(p ui.PointerEvent) Option[int] {
		match p.Phase {
		case ui.Down:
			Some{Value: int(p.X) + 1000*int(p.Y)}
		case _:
			None
		}
	}) {
		ui.Canvas(f, "ink", 200, 150) func(p mut ui.Paint) {
			ui.Fill(p, ui.RectPath(0, 0, 200, 150), ui.Color{R: 240, G: 240, B: 240, A: 255})
			let mx = float64(s.x)
			let my = float64(s.y)
			ui.Stroke(p, ui.Path{Segs: []ui.Seg{ui.MoveTo{X: 0, Y: 0}, ui.LineTo{X: mx, Y: my}}}, ui.Color{R: 30, G: 90, B: 200, A: 255}, 3)
			let r = float64(10 + s.n%3*5)
			let k = 0.5523 * r
			let cx = 200 - mx
			let cy = 150 - my
			ui.Fill(p, ui.Path{Segs: []ui.Seg{
				ui.MoveTo{X: cx + r, Y: cy},
				ui.CubicTo{C1X: cx + r, C1Y: cy + k, C2X: cx + k, C2Y: cy + r, X: cx, Y: cy + r},
				ui.CubicTo{C1X: cx - k, C1Y: cy + r, C2X: cx - r, C2Y: cy + k, X: cx - r, Y: cy},
				ui.CubicTo{C1X: cx - r, C1Y: cy - k, C2X: cx - k, C2Y: cy - r, X: cx, Y: cy - r},
				ui.CubicTo{C1X: cx + k, C1Y: cy - r, C2X: cx + r, C2Y: cy - k, X: cx + r, Y: cy},
				ui.ClosePath,
			}}, ui.Color{R: 40, G: 160, B: 90, A: 255})
			ui.Transformed(p, ui.Translate(mx, my)) {
				ui.Fill(p, ui.Path{Segs: []ui.Seg{ui.MoveTo{X: 0, Y: -12}, ui.LineTo{X: 12, Y: 0}, ui.LineTo{X: 0, Y: 12}, ui.LineTo{X: -12, Y: 0}, ui.ClosePath}}, ui.Color{R: 200, G: 40, B: 40, A: 255})
			}
		}
	}
}

// looks (UG1): boxes and buttons with looks of their own, a theme that a
// tap changes, a shadow in one theme and a dimmed group a tap turns on, so
// the window paints each look from the tree's table (fills, a border,
// an underlined text in the theme's ink,
// corners, a shadow, opacity) where both hosts hold the same Looks.
type looksApp { theme int, dim bool }

// inkedReading is the looks app's readout, drawn in the theme's ink.
let inkedReading = ui.NewReadout("reading")

func looksStep(s looksApp, e int) Decision[looksApp, int] {
	if e == 0 {
		return Enter[looksApp]{Next: looksApp{theme: (s.theme + 1) % 3, dim: s.dim}}
	}
	Enter[looksApp]{Next: looksApp{theme: s.theme, dim: !s.dim}}
}

func looksMachine() Machine[looksApp, int, int] {
	Machine[looksApp, int, int]{Initial: looksApp{theme: 0, dim: false}, Step: looksStep, After: none[looksApp, int], Work: idle[looksApp, int], Exit: func(s looksApp) Option[func()] { None }}
}

// looked is a Style of the look l.
func looked(f mut ui.Frame[int], l ui.Look, pad ui.Length) ui.Style {
	let mut s = ui.Plain()
	s.Padding = ui.All(pad)
	s.Look = ui.LookFor(f, ui.Steady(l))
	s
}

func looksView(f mut ui.Frame[int], s looksApp) {
	let cards = []uint32{0xdde7f5, 0xf5e6d8, 0xe2f2e2}
	let accents = []uint32{0x3366cc, 0xcc6633, 0x339944}
	let mut col = ui.Plain()
	col.Gap = 12
	col.Padding = ui.All(16)
	ui.Column(f, col) {
		ui.Text(f, "theme \(s.theme)")
		// A Text and a Readout in the theme's ink, underlined (bold in
		// theme 1, italic in theme 2): the window's underline is a probe
		// of the ink's colour, and its count of slanted runs is checked.
		let inked = ui.Inked(ui.Ink{Color: ui.Rgb(accents[s.theme]), Bold: s.theme == 1, Italic: s.theme == 2, Underline: true})
		ui.TextStyled(f, "inked", looked(f, inked, 0))
		ui.ReadoutStyled(f, inkedReading, "reading", looked(f, inked, 0))
		ui.Pressable(f, "next", 0) {
			ui.Text(f, "Next")
		}
		let mut card = ui.Bare()
		card.Fill = ui.Rgb(cards[s.theme])
		card.Corners = ui.Round(12)
		ui.Box(f, looked(f, card, 12)) {
			let mut a = ui.Bare()
			a.Fill = ui.Rgb(accents[s.theme])
			a.Corners = ui.Round(10)
			ui.PressableStyled(f, "a", 0, looked(f, a, 0)) {
				ui.Text(f, "A")
			}
		}
		let mut framed = ui.Bare()
		framed.Fill = ui.Rgb(0xfafafa)
		framed.Border = ui.Border{Width: 2, Color: ui.Rgb(accents[s.theme])}
		framed.Corners = ui.Corners{TopLeft: 4, TopRight: 4, BottomRight: 12, BottomLeft: 12}
		ui.Box(f, looked(f, framed, 8)) {
			ui.Text(f, "framed")
		}
		let mut b = ui.Bare()
		b.Fill = ui.Rgb(0xffffff)
		b.Corners = ui.Round(8)
		if s.theme == 2 {
			b.Shadows[0] = ui.Shadow{X: 0, Y: 2, Blur: 6, Spread: 0, Color: ui.Color{R: 0, G: 0, B: 0, A: 64}, Inset: false}
		}
		ui.PressableStyled(f, "b", 0, looked(f, b, 0)) {
			ui.Text(f, "B")
		}
		// A Pressable on a track at rest 24 DIP right of its place (TRACKS).
		let mut tr = ui.Bare()
		tr.Fill = ui.Rgb(0x884488)
		tr.Corners = ui.Round(4)
		ui.Track(f, ui.ByInt(7), ui.TrackX, 24.0, ui.TrackSpring{Stiffness: 170.0, Damping: 26.0}) {
			ui.PressableStyled(f, "t", 0, looked(f, tr, 6)) {
				ui.Text(f, "T")
			}
		}
		let mut group = ui.Bare()
		group.Opacity = if s.dim { 0.5 } else { 1.0 }
		ui.Box(f, looked(f, group, 0)) {
			ui.Pressable(f, "c", 1) {
				ui.Text(f, "C")
			}
		}
	}
}

// roles (UG2): a Semantic node of every role, keyed, whose states,
// level, range, current item, popup and relations (to the next nodes'
// keys, and to a key no node has) change with each tap of "next", some
// of them under a disabled Fieldset, so the window's accessibility tree
// carries what ui reads of each.
func rolesStep(s int, e int) Decision[int, int] {
	Enter[int]{Next: s + 1}
}

func rolesMachine() Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: rolesStep, After: none[int, int], Work: idle[int, int], Exit: func(s int) Option[func()] { None }}
}

func allRoles() []ui.Role {
	[]ui.Role{ui.Button, ui.Checkbox, ui.Switch, ui.TextBox, ui.Static, ui.Group, ui.Region, ui.Image, ui.List, ui.Status, ui.Generic, ui.Tab, ui.TabList, ui.TabPanel, ui.Dialog, ui.Menu, ui.MenuItem, ui.Tree, ui.TreeItem, ui.Heading, ui.Alert, ui.Link, ui.Table, ui.TableRow, ui.TableCell, ui.RadioGroup, ui.Radio, ui.ListBox, ui.ListOption, ui.Slider, ui.SpinButton, ui.SearchBox, ui.MenuItemCheckbox, ui.ComboBox, ui.Grid, ui.GridCell, ui.ColumnHeader, ui.RowHeader, ui.Navigation, ui.ListItem, ui.Separator, ui.Tooltip}
}

// roleDecl is node i's Access on screen t.
func roleDecl(r ui.Role, i int, t int, n int) ui.Access {
	let mut a = ui.Named(r, "s\(i)")
	let v = i + t
	a.Key = ui.ByInt(i)
	a.Checked = if v%3 == 0 { Some{Value: true} } else { None }
	a.Mixed = v%7 == 1
	a.Selected = if v%2 == 0 { Some{Value: true} } else { Some{Value: false} }
	a.Expanded = if v%4 == 1 { Some{Value: true} } else { None }
	a.Busy = v%5 == 2
	a.Invalid = v%6 == 3
	a.MultiSelectable = v%5 == 4
	a.Level = if v%3 == 1 { Some{Value: v%4 + 1} } else { None }
	if v%4 == 2 {
		a.Range = Some{Value: ui.Range{Now: float64(v % 10), Min: 0, Max: 10}}
	}
	if v%5 == 0 {
		a.Current = Some{Value: "page"}
	}
	a.HasPopup = v%6 == 0
	if v%4 == 3 {
		a.Description = "d\(v % 3)"
	}
	let mut rels = []ui.Rel{ui.Controls{To: ui.ByInt((i + 1 + t) % n)}}
	if v%2 == 1 {
		rels = rels.Append(ui.DescribedBy{To: ui.ByInt((i + 2) % n)})
	}
	if v%3 == 2 {
		rels = rels.Append(ui.Controls{To: ui.ByInt(n + 5)})
	}
	if v%5 == 3 {
		rels = rels.Append(ui.OpensPopup{Role: ui.ListBox})
	}
	a.Rels = rels
	a
}

func rolesView(f mut ui.Frame[int], t int) {
	let roles = allRoles()
	let n = len(roles)
	let mut col = ui.Plain()
	col.Gap = 2
	ui.Column(f, col) {
		ui.Pressable(f, "next", 0) {
			ui.Text(f, "Next \(t)")
		}
		for row in 0..(n+5)/6 {
			let mut line = ui.Plain()
			line.Gap = 4
			ui.Row(f, line) {
				for j in 0..6 {
					let i = row*6 + j
					if i < n {
						if (i+t)%9 == 4 {
							ui.Fieldset(f, true, "off") {
								ui.Semantic(f, roleDecl(roles[i], i, t, n), None, ui.Plain()) {
									ui.Text(f, "r\(i)")
								}
							}
						} else {
							ui.Semantic(f, roleDecl(roles[i], i, t, n), if i%3 == 0 { Some{Value: 0} } else { None }, ui.Plain()) {
								ui.Text(f, "r\(i)")
							}
						}
					}
				}
			}
		}
	}
}

// states (UG3): Pressables whose look differs in each state (rest, hover,
// focus, pressed, disabled), a roving group, a disabled one, a focus scope
// a tap opens and "close" or Escape closes, and a focus request "ask"
// moves, so both hosts paint each node's look of the state std decides
// from the pointer, the keys and the passes.
type statesApp { open bool, asked int }

func statesStep(s statesApp, e int) Decision[statesApp, int] {
	if e == 0 {
		return Enter[statesApp]{Next: statesApp{open: false, asked: s.asked}}
	}
	if e == 1 {
		return Enter[statesApp]{Next: statesApp{open: true, asked: s.asked}}
	}
	if e == 2 {
		return Enter[statesApp]{Next: statesApp{open: s.open, asked: s.asked + 1}}
	}
	Enter[statesApp]{Next: s}
}

func statesMachine() Machine[statesApp, int, int] {
	Machine[statesApp, int, int]{Initial: statesApp{open: false, asked: 0}, Step: statesStep, After: none[statesApp, int], Work: idle[statesApp, int], Exit: func(s statesApp) Option[func()] { None }}
}

// stateLook is a filled, rounded look of the colour c.
func stateLook(c uint32) ui.Look {
	let mut l = ui.Bare()
	l.Fill = ui.Rgb(c)
	l.Corners = ui.Round(6)
	l
}

// tinted is a Pressable's style whose fill is k's colour in each state.
func tinted(f mut ui.Frame[int], k int) ui.Style {
	let c = uint32(k * 0x0a)
	let mut st = ui.PressStyle()
	st.Look = ui.LookFor(f, ui.Looks{Rest: stateLook(0xd0e0f0 + c), Hover: stateLook(0xf0d080 + c), Focus: stateLook(0x80d0a0 + c), Active: stateLook(0xc06060 + c), Disabled: stateLook(0xa0a0a0 + c)})
	st
}

// statePress is a tinted Pressable label, sending on.
func statePress(f mut ui.Frame[int], label string, on int, k int) {
	ui.PressableStyled(f, label, on, tinted(f, k)) {
		ui.Text(f, label)
	}
}

func statesView(f mut ui.Frame[int], s statesApp) {
	ui.OnKey(f, func(k ui.KeyPress) Option[int] {
		if k.Name == "Escape" { Some{Value: 0} } else { None }
	})
	ui.Focus(f, ui.ByInt(s.asked%3))
	let mut col = ui.Plain()
	col.Gap = 8
	col.Padding = ui.All(12)
	ui.Column(f, col) {
		let mut line = ui.Plain()
		line.Gap = 8
		ui.Row(f, line) {
			statePress(f, "open", 1, 0)
			statePress(f, "ask", 2, 1)
			for i in 0..3 {
				let mut a = ui.Named(ui.Group, "z\(i)")
				a.Key = ui.ByInt(i)
				ui.Semantic(f, a, None, ui.Plain()) {
					statePress(f, "p\(i)", 3, i+2)
				}
			}
		}
		ui.Roving(f) {
			ui.Row(f, line) {
				for i in 0..3 {
					statePress(f, "r\(i)", 3, i+5)
				}
			}
		}
		ui.Fieldset(f, true, "") {
			statePress(f, "off", 3, 8)
		}
		if s.open {
			ui.FocusScope(f) {
				ui.Row(f, line) {
					statePress(f, "in0", 3, 9)
					statePress(f, "in1", 3, 10)
					statePress(f, "close", 0, 11)
				}
			}
		}
	}
}
