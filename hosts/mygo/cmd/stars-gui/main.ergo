// stars-gui is examples/stars-gui in a MyGo window (corpus wave GP1c): the
// example's table, app and view (a required Ergo module, hosts/mygo/go.mod)
// on the desktop driver. It is the only place that chooses: the window
// and the live clock, or, with -headless, a window with no screen that
// plays a script from standard input and prints what the example's own
// `stars-gui scene` prints.
//
//	stars-gui [-rows H] CATALOG            open the window on CATALOG
//	stars-gui -headless [-rows H] CATALOG  play the script on standard input
//
// Headless, -check holds the driver's kept layout to the tree built anew at
// every paint (desktop.Check) and prints a line where they differ, and
// -reference lays out the rebuilt tree only (desktop.Reference), which is
// what a receipt compares the kept one with.
//
// A headless script is the example's: each line is input the window gets
// where a person gives it. A key goes to the table, so the window's focus
// is dropped first, as a person clicks the table before the arrows; a
// typed text clicks the field and types; sort, edit, filter, mark and
// extend click their buttons. After each line the list scrolls to the
// table's window with the wheel, as the scene's host does.

import actor
import ergo.local/prototype/examples/starsgui/catalog
import ergo.local/prototype/examples/starsgui/files
import ergo.local/prototype/examples/starsgui/script
import window ergo.local/prototype/examples/starsgui/screen
import ergo.local/prototype/hosts/mygo/desktop
import go ergo.local/prototype/hosts/mygo/screen
import fs
import io
import machines
import option
import os
import strconv
import strings
import sync
import time
import ui
import ui/layout

let Usage = "usage: stars-gui [-headless [-check | -reference]] [-rows H] CATALOG"

// Width and Height are the window's size in DIPs: wide enough for every
// button, and tall enough for a list of 12 rows below them.
let Width = 1000.0

let Height = 720.0

// opts is what the arguments chose.
type opts { headless bool, layout Layout, rows int, catalogue string }

// Layout is how the driver lays out: its kept tree, the kept tree checked
// against the rebuilt one, or the rebuilt one.
type Layout = Kept{} | Checked{} | Rebuilt{}

func parse(args []string) opts fails os.Exit {
	let mut o = opts{headless: false, layout: Kept, rows: 10, catalogue: ""}
	let mut i = 0
	for i < args.Len() {
		let a = args[i]
		if a == "-headless" {
			o.headless = true
		} else if a == "-check" {
			o.layout = Checked
		} else if a == "-reference" {
			o.layout = Rebuilt
		} else if a == "-rows" && i+1 < args.Len() {
			i = i + 1
			o.rows = strconv.Atoi(args[i]) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return os.Exit{Code: 2, Message: Usage}
			}
		} else if o.catalogue == "" && !strings.HasPrefix(a, "-") {
			o.catalogue = a
		} else {
			return os.Exit{Code: 2, Message: Usage}
		}
		i = i + 1
	}
	let laidOut = match o.layout {
	case Kept:
		true
	case Checked, Rebuilt:
		o.headless
	}
	if o.catalogue == "" || o.rows < 1 || !laidOut {
		return os.Exit{Code: 2, Message: Usage}
	}
	o
}

func main() fails os.Exit needs os.Ambient | go.Foreign {
	let o = try parse(with context { os.Process: os.NewHost() } { os.Process.Args() })
	let rows = try load(o.catalogue)
	if o.headless {
		try headless(rows, o.rows, o.layout)
		return
	}
	with context { time.Scheduler: time.NewLiveScheduler() } {
		let w = screen.Open("Stars", Width, Height) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "stars-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(machines.Start(window.App{}, window.Opening{Rows: rows, Height: o.rows}), 8, func(r catalog.Refused) {})
		desktop.Run(w, a, window.View) catch {
		case ui.Closed:
		case actor.Stopped:
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "stars-gui: \(b.Why)"}
		case go.Error as e:
			return os.Exit{Code: 1, Message: "stars-gui: \(e.Text)"}
		}
	}
}

// load reads and parses the catalogue named name from the host's files.
func load(name string) []catalog.Star fails os.Exit needs os.Ambient {
	let text = with context { catalog.Shelf: files.New(fs.NewHost()) } {
		catalog.Shelf.Text(name) catch {
		case catalog.Unreadable as u:
			return os.Exit{Code: 1, Message: "stars-gui: \(u.Name): \(u.Reason)"}
		}
	}
	catalog.Parse(text) catch {
	case catalog.Malformed as m:
		return os.Exit{Code: 1, Message: "stars-gui: \(name): " + catalog.Describe(m)}
	}
}

// headless plays the script on standard input through a window with no
// screen, height rows a table window, and prints what the scene prints.
func headless(rows []catalog.Star, height int, how Layout) fails os.Exit needs os.Ambient | go.Foreign {
	let text = io.NewStdin().ReadAll() catch {
	case io.ReadFailed:
		return os.Exit{Code: 1, Message: "stars-gui: cannot read the script"}
	}
	let out = io.NewHost()
	with context { time.Scheduler: time.NewManual(0) } {
		let w = screen.Headless(Width, Height) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "stars-gui: \(e.Text)"}
		}
		let refused = sync.NewRef[[]catalog.Refused]([]catalog.Refused{})
		let a = actor.StartMachine(machines.Start(window.App{}, window.Opening{Rows: rows, Height: height}), 8, func(r catalog.Refused) {
			refused.Update(func(old []catalog.Refused) []catalog.Refused { old.Append(r) })
		})
		let mut d = desktop.New(w, a, window.View, 64) catch {
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "stars-gui: \(b.Why)"}
		}
		match how {
		case Kept:
		case Checked:
			desktop.Check(&d)
		case Rebuilt:
			desktop.Reference(&d)
		}
		try follow(&d)
		for line in strings.Split(text, "\n") {
			let l = strings.TrimSuffix(line, "\r")
			if l == "" || strings.HasPrefix(l, "#") {
				continue
			}
			let c = script.Parse(l) catch {
			case script.BadLine as b:
				out.Println("? " + catalog.Quote(b.Text) + ": want " + b.Want)
				continue
			}
			match c {
			case script.Show:
				let g = catalog.GridOf(desktop.StateOf(&d))
				for t in script.Shown(desktop.Screen(&d), script.Window{Top: g.Top, Height: g.Height}) {
					out.Println(t)
				}
			case script.Send as m:
				send(&d, w, m.Signal) catch {
				case ui.NoNode as x:
					out.Println("? no node " + x.Label)
				case ui.Ambiguous as x:
					out.Println("? \(x.Count) nodes at " + x.At)
				case ui.Mismatch as x:
					out.Println("? want " + x.Want + ", got " + x.Got)
				case ui.Closed, actor.Stopped:
					return os.Exit{Code: 1, Message: "stars-gui: the app stopped"}
				case ui.BadPatch as b:
					return os.Exit{Code: 1, Message: "stars-gui: the view's patch did not apply: " + b.Why}
				}
				try follow(&d)
				for r in refused.Get() {
					out.Println(script.Refusal(r))
				}
				refused.Set([]catalog.Refused{})
			}
		}
		match desktop.Differs(&d) {
		case Some[string] as why:
			out.Println("? the kept layout differs from the rebuilt one: " + why.Value)
		case None:
		}
		a.Stop()
	}
}

// send gives the window the input of a table signal.
func send[D, F](d mut desktop.Driver[catalog.State, window.Signal, D, F], w go.Ref[screen.Window], sig catalog.Signal) fails ui.NoNode | ui.Ambiguous | ui.Mismatch | ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	match sig {
	case catalog.Type as t:
		// The field reports its whole text: the window types the letters
		// into it after a click, so it holds what it held and the letters.
		try desktop.Play(d, []ui.Act{ui.TapOn{Label: "text"}})
		w.Type(t.Text)
		try desktop.Drain(d)
	case _:
		for act in script.Acts(sig, "") {
			match act {
			case ui.KeyIn:
				try unfocus(d, w)
			case _:
			}
			try desktop.Play(d, []ui.Act{act})
		}
	}
}

// unfocus clicks the list, which takes no focus, so a key goes to the
// table and not to a focused button or field.
func unfocus[D, F](d mut desktop.Driver[catalog.State, window.Signal, D, F], w go.Ref[screen.Window]) fails ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	if desktop.FocusId(d) == option.None {
		return
	}
	match desktop.BoxOf(d, "stars") {
	case Some[layout.Box] as b:
		let x = float64(b.Value.X + b.Value.W/2)
		let y = float64(b.Value.Y + b.Value.H/2)
		w.Press(x, y)
		w.Release(x, y)
		try desktop.Drain(d)
	case None:
	}
}

// follow scrolls the list to the table's window, with the wheel.
func follow[D, F](d mut desktop.Driver[catalog.State, window.Signal, D, F]) fails os.Exit needs go.Foreign {
	let g = catalog.GridOf(desktop.StateOf(d))
	let rh = window.RowHeight
	desktop.Play(d, []ui.Act{ui.ScrollOn{Label: "stars", Offset: rh * ui.Length(float64(g.Top)), Height: rh * ui.Length(float64(g.Height))}}) catch {
	case ui.NoNode, ui.Ambiguous, ui.Mismatch, ui.Closed, actor.Stopped:
		return os.Exit{Code: 1, Message: "stars-gui: the window has no list to scroll"}
	case ui.BadPatch as b:
		return os.Exit{Code: 1, Message: "stars-gui: the view's patch did not apply: " + b.Why}
	}
}
