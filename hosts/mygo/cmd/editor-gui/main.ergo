// editor-gui is examples/editor-gui in a MyGo window (corpus wave GP2d):
// the example's editor, app and view (a required Ergo module,
// hosts/mygo/go.mod) on the desktop driver. It is the only place that
// chooses: the host's files for the document, a clipboard in memory, and
// the window and the live clock, or, with -headless, a window with no
// screen that plays a script from standard input and prints what the
// example's own `editor-gui scene` prints.
//
//	editor-gui FILE                         open the window on FILE
//	editor-gui -headless [-check] FILE      play the script on standard input
//
// A headless script is the example's (script.Parse): each line is input
// the window gets where a person gives it. A key goes to the editor, so
// the window's focus is dropped first, as a person clicks beside the
// toolbar before the keys; a shortcut is the key with Ctrl; type commits
// its text to the text input after a click on it; the buttons are
// clicked; click ROW COL presses the page where the scene presses it.
// After each line the window settles the save or clipboard task the view
// asked for. -check holds the driver's kept layout to the tree built anew
// at every paint (desktop.Check). shot, the scene's screenshot of
// ui.TestHost, is not a desktop command.

import actor
import ergo.local/prototype/examples/editorgui/edit
import ergo.local/prototype/examples/editorgui/files
import ergo.local/prototype/examples/editorgui/script
import window ergo.local/prototype/examples/editorgui/screen
import ergo.local/prototype/hosts/mygo/desktop
import go ergo.local/prototype/hosts/mygo/screen
import fs
import io
import machines
import os
import strings
import sync
import time
import ui
import ui/layout

let Usage = "usage: editor-gui [-headless [-check]] FILE"

// Width and Height are the window's size in DIPs: wide enough for the
// toolbar and the replacement field, and tall enough for the text lines
// and the page.
let Width = 1100.0

let Height = 720.0

// opts is what the arguments chose.
type opts { headless bool, check bool, file string }

func parse(args []string) opts fails os.Exit {
	let mut o = opts{headless: false, check: false, file: ""}
	for a in args {
		if a == "-headless" {
			o.headless = true
		} else if a == "-check" {
			o.check = true
		} else if o.file == "" && !strings.HasPrefix(a, "-") {
			o.file = a
		} else {
			return os.Exit{Code: 2, Message: Usage}
		}
	}
	if o.file == "" || (o.check && !o.headless) {
		return os.Exit{Code: 2, Message: Usage}
	}
	o
}

func main() fails os.Exit needs Ambient | go.Foreign {
	let o = try parse(with context { os.Process: os.NewHost() } { os.Process.Args() })
	let store = files.New(fs.NewHost())
	let clip = ui.NewMemoryClipboard()
	let text = with context { edit.Store: store } {
		edit.OpenDoc(o.file) catch {
		case edit.Unreadable as u:
			return os.Exit{Code: 1, Message: "editor-gui: \(u.Name): \(u.Reason)"}
		case edit.NotText as n:
			return os.Exit{Code: 1, Message: "editor-gui: " + edit.DescribeNotText(o.file, n)}
		}
	}
	if o.headless {
		try headless(text, o.file, store, clip, o.check)
		return
	}
	with context { Scheduler: NewLiveScheduler() } {
		let w = screen.Open("Editor", Width, Height) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "editor-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(machines.Start(window.App{}, window.Opening{Text: text, Name: o.file}), 8, func(n window.Note) {})
		desktop.Run(w, a, window.Viewer(store, clip)) catch {
		case ui.Closed:
		case actor.Stopped:
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "editor-gui: \(b.Why)"}
		case go.Error as e:
			return os.Exit{Code: 1, Message: "editor-gui: \(e.Text)"}
		}
	}
}

// headless plays the script on standard input through a window with no
// screen and prints what the scene prints.
func headless(text string, name string, store edit.Store, clip ui.Clipboard, check bool) fails os.Exit needs Ambient | go.Foreign {
	let input = io.NewStdin().ReadAll() catch {
	case io.ReadFailed:
		return os.Exit{Code: 1, Message: "editor-gui: cannot read the script"}
	}
	let out = io.NewHost()
	with context { Scheduler: time.NewManual(0) } {
		let w = screen.Headless(Width, Height) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "editor-gui: \(e.Text)"}
		}
		let notes = sync.NewRef[[]window.Note]([]window.Note{})
		let a = actor.StartMachine(machines.Start(window.App{}, window.Opening{Text: text, Name: name}), 8, func(n window.Note) {
			notes.Update(func(old []window.Note) []window.Note { old.Append(n) })
		})
		let mut d = desktop.New(w, a, window.Viewer(store, clip), 8) catch {
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "editor-gui: \(b.Why)"}
		}
		if check {
			desktop.Check(&d)
		}
		for line in strings.Split(input, "\n") {
			let l = strings.TrimSuffix(line, "\r")
			if l == "" || strings.HasPrefix(l, "#") {
				continue
			}
			let c = script.Parse(l) catch {
			case script.BadLine as b:
				out.Println("? \"" + b.Text + "\": want " + b.Want)
				continue
			}
			let acts = match c {
			case script.Show:
				for t in script.Texts(desktop.Screen(&d)) {
					out.Println(t)
				}
				continue
			case script.Send as m:
				script.Acts(m.Signal)
			case script.Paste:
				[]ui.Act{ui.KeyIn{Press: ui.KeyPress{Name: "v", Mods: ui.Mods{Shift: false, Ctrl: true, Alt: false, Meta: false}}}}
			case script.Click as k:
				[]ui.Act{script.PressAt(desktop.StateOf(&d).Ed, k.Row, k.Col)}
			}
			play(&d, w, acts.Append(ui.SettleAll)) catch {
			case ui.NoNode as x:
				out.Println("? no node " + x.Label)
			case ui.Mismatch as miss:
				out.Println("? want " + miss.Want + ", got " + miss.Got)
			case ui.Ambiguous as amb:
				out.Println("? \(amb.Count) nodes at " + amb.At)
			case ui.Closed, actor.Stopped:
				return os.Exit{Code: 1, Message: "editor-gui: the app stopped"}
			case ui.BadPatch as b:
				return os.Exit{Code: 1, Message: "editor-gui: the view's patch did not apply: " + b.Why}
			}
			for n in notes.Get() {
				out.Println(window.NoteLine(n))
			}
			notes.Set([]window.Note{})
		}
		match desktop.Differs(&d) {
		case Some[string] as why:
			out.Println("? the kept layout differs from the rebuilt one: " + why.Value)
		case None:
		}
		a.Stop()
	}
}

// play gives the window each step of acts, a key after the focus is
// dropped.
func play[D, F](d mut desktop.Driver[window.Window, window.Signal, D, F], w go.Ref[screen.Window], acts []ui.Act) fails ui.NoNode | ui.Ambiguous | ui.Mismatch | ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	for act in acts {
		match act {
		case ui.KeyIn:
			try unfocus(d, w)
		case _:
		}
		try desktop.Play(d, []ui.Act{act})
	}
}

// unfocus clicks the window right of the text input, where no node takes
// a press, so a key goes to the editor and not to a focused button or
// field.
func unfocus[D, F](d mut desktop.Driver[window.Window, window.Signal, D, F], w go.Ref[screen.Window]) fails ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	if desktop.FocusId(d) == None {
		return
	}
	match desktop.BoxOf(d, "type") {
	case Some[layout.Box] as b:
		let x = Width - 2
		let y = float64(b.Value.Y + b.Value.H/2)
		w.Press(x, y)
		w.Release(x, y)
		try desktop.Drain(d)
	case None:
	}
}
