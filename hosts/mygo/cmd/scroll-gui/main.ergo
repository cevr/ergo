// scroll-gui is a list of 10,000 rows in a MyGo window, the SCROLL-COST
// receipt's program (stdlib.md, UI 11): a wheel scroll that shows the
// rows the list already wrote runs no pass; one that brings in a row
// runs the view.
//
//	scroll-gui                  open the window
//	scroll-gui -headless N      wheel N steps of 7 dips down a window with
//	                            no screen and print the rows it shows
//
// controls/scroll-gui is the same list in Go on MyGo's own List: what the
// list is measured against.

import actor
import ergo.local/prototype/hosts/mygo/desktop
import go ergo.local/prototype/hosts/mygo/screen
import io
import machines
import option
import os
import strconv
import sync
import time
import ui

// Count is the list's rows; Height is a row's.
let Count = 10000
let Height = 24.0

// views counts the view's runs: the passes.
let views = sync.NewRef(0)

func main() fails os.Exit needs os.Ambient | go.Foreign {
	let args = with context { os.Process: os.NewHost() } { os.Process.Args() }
	if args.Len() > 1 && args[0] == "-headless" {
		let n = strconv.Atoi(args[1]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "scroll-gui: -headless takes a count, not \(args[1])"}
		}
		try headless(n)
		return
	}
	with context { time.Scheduler: time.NewLiveScheduler() } {
		let w = screen.Open("Rows", 320, 480) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "scroll-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(still(), 8, func(o int) {})
		desktop.Run(w, a, view) catch {
		case ui.Closed:
		case actor.Stopped:
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "scroll-gui: \(b.Why)"}
		case go.Error as e:
			return os.Exit{Code: 1, Message: "scroll-gui: \(e.Text)"}
		}
	}
}

// headless wheels n steps of 7 dips down the list in a window with no
// screen, and prints the first row shown and the passes run (views).
func headless(n int) fails os.Exit needs os.Ambient | go.Foreign {
	let out = io.NewHost()
	with context { time.Scheduler: time.NewManual(0) } {
		let w = screen.Headless(320, 480) catch {
		case go.Error as e:
			return os.Exit{Code: 1, Message: "scroll-gui: \(e.Text)"}
		}
		let a = actor.StartMachine(still(), 8, func(o int) {})
		let mut d = desktop.New(w, a, view, 64) catch {
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "scroll-gui: \(b.Why)"}
		}
		for i in 1..n+1 {
			desktop.Play(&d, []ui.Act{ui.ScrollOn{Label: "rows", Offset: ui.Length(float64(7 * i)), Height: 0}}) catch {
			case ui.NoNode, ui.Ambiguous, ui.Mismatch, ui.Closed, actor.Stopped:
				return os.Exit{Code: 1, Message: "scroll-gui: no list"}
			case ui.BadPatch as b:
				return os.Exit{Code: 1, Message: "scroll-gui: \(b.Why)"}
			}
		}
		match desktop.Viewport(&d, "rows") {
		case option.Some[ui.Viewport] as v:
			out.Println("offset \(v.Value.Offset) views \(views.Get())")
		case option.None:
			out.Println("no viewport")
		}
	}
}

// view is the screen: a title and the list.
func view(f mut ui.Frame[int], s int) {
	views.Set(views.Get() + 1)
	ui.Column(f, ui.Plain()) {
		ui.Text(f, "rows")
		ui.Rows(f, "rows", Count, ui.Length(Height), func(i int) ui.Key { ui.ByInt(i) }) func(i int) {
			ui.Text(f, "row \(i)")
		}
	}
}

// still is the program's state: nothing changes it.
func still() machines.Machine[int, int, int] {
	machines.Machine[int, int, int]{Initial: 0, Step: stay, After: noTimer, Work: noWork, Exit: func(at int) option.Option[func()] { option.None }}
}

func stay(s int, e int) machines.Decision[int, int] { machines.Enter[int]{Next: s} }

func noTimer(s int) option.Option[machines.Timeout[int]] { option.None }

func noWork(s int) option.Option[func(send func(e int))] { option.None }
