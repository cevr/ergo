// Fingers (MB4): the window feeds a finger's touch, moves and lift to std
// ui's touch machine (ui.TouchStep) for the Scroll or list under it, and
// shows the offset it gives; a finger hits the control the reach margin
// gives (ui.Reach); the root lays out inside the insets (ui.Insets). A
// finger on an Area is the Area's pointer, as the mouse is.

import go ergo.local/prototype/hosts/mygo/screen
import actor
import ui
import ui/layout

// fingered is a finger on the window, or the fling or return it left: the
// machine, the Scroll or list it scrolls (None: none under the touch),
// and the control it may press (None: none within reach).
type fingered[E] { touch ui.Touch, scrolls Option[ui.Id[E]], target Option[ui.Id[E]] }

// TheFinger is the one finger this pin's surface tells apart (it names no
// pointer id yet).
let TheFinger = ui.Pointer{Id: 0, Kind: ui.Finger}

// SetInsets lays the root out inside insets from now on, and repaints.
func SetInsets[E comparable, S, D, F](d mut Driver[S, E, D, F], insets ui.Insets) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	d.insets = insets
	paint(d)
	try report(d)
}

// RootBox is where the root lies in the window, and the part of the
// window the insets leave.
func RootBox[S, E, D, F](d mut Driver[S, E, D, F]) (Option[layout.Box], ui.Rect) {
	(d.boxes.Get(d.root), ui.InsetRect(ui.Rect{X: 0, Y: 0, W: ui.Length(float64(d.width)), H: ui.Length(float64(d.height))}, d.insets))
}

// fingerMoving is whether a fling or a return is under way.
func fingerMoving[S, E, D, F](d mut Driver[S, E, D, F]) bool {
	match d.finger {
	case Some[fingered[E]] as f:
		ui.TouchMoving(f.Value.touch)
	case None:
		false
	}
}

// reachAt is the spot a finger at x, y hits: the top one under it, else
// the nearest pressable one within the reach margin (ui.Reach).
func reachAt[S, E, D, F](d mut Driver[S, E, D, F], x float32, y float32) Option[spot[E]] {
	let mut ts = []ui.Reachable{}
	let mut ss = []spot[E]{}
	for s in d.spots {
		match s.node {
		case ui.ScrollNode, ui.RowsNode:
		case _:
			let v = visible(s)
			ts = ts.Append(ui.Reachable{Box: ui.Rect{X: ui.Length(float64(v.X)), Y: ui.Length(float64(v.Y)), W: ui.Length(float64(v.W)), H: ui.Length(float64(v.H))}, Enabled: pressable(s.node)})
			ss = ss.Append(s)
		}
	}
	match ui.Reach(ts, float64(x), float64(y), ui.ReachMargin) {
	case Some[int] as i:
		Some{Value: ss[i.Value]}
	case None:
		None
	}
}

// visible is the part of s's box its clip leaves.
func visible[E](s spot[E]) layout.Box {
	let x0 = if s.box.X > s.clip.X { s.box.X } else { s.clip.X }
	let y0 = if s.box.Y > s.clip.Y { s.box.Y } else { s.clip.Y }
	let x1 = fmin(s.box.X+s.box.W, s.clip.X+s.clip.W)
	let y1 = fmin(s.box.Y+s.box.H, s.clip.Y+s.clip.H)
	layout.Box{X: x0, Y: y0, W: fmax(x1-x0, 0), H: fmax(y1-y0, 0)}
}

// scrollsAt is the innermost Scroll or list under x, y.
func scrollsAt[S, E, D, F](d mut Driver[S, E, D, F], x float32, y float32) Option[spot[E]] {
	let mut out Option[spot[E]] = None
	for s in d.spots {
		match s.node {
		case ui.ScrollNode, ui.RowsNode:
			if inside(s, x, y) {
				out = Some{Value: s}
			}
		case _:
		}
	}
	out
}

// fingerPointed sends a finger's pointer event to a spot.
func fingerPointed[E comparable, S, D, F](d mut Driver[S, E, D, F], s spot[E], phase ui.Phase, x float32, y float32) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	try step(d, ui.Point[E]{Id: s.id, Pointer: ui.PointerEvent{Pointer: TheFinger, Phase: phase, X: float64(x - s.box.X), Y: float64(y - s.box.Y), Zone: None}, Over: None})
}

// touched takes a finger's input (input.Finger): Down, Move or Up.
func touched[E comparable, S, D, F](d mut Driver[S, E, D, F], input screen.Input) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	let x = float32(input.X)
	let y = float32(input.Y)
	let at = duration(input.At)
	if input.Kind == screen.Down {
		d.pressed = None
		// A finger on an Area is its pointer: the Area holds it.
		match hitAt(d, x, y) {
		case Some[spot[E]] as s:
			match s.Value.node {
			case ui.AreaNode:
				d.finger = None
				d.pressed = Some{Value: s.Value.id}
				try fingerPointed(d, s.Value, ui.Down, x, y)
				paint(d)
				return
			case _:
			}
		case None:
		}
		let target = reachAt(d, x, y)
		let under = scrollsAt(d, x, y)
		let mut t = match under {
		case Some[spot[E]] as s:
			ui.NewTouch(0, float64(fmax(contentHeight(d, s.Value.id)-s.Value.box.H, 0)))
		case None:
			ui.NewTouch(0, 0)
		}
		match under {
		case Some[spot[E]] as s:
			t.Y = float64(scrolledBy(d, s.Value.id))
		case None:
		}
		let (n, _) = ui.TouchStep(t, ui.FingerDown{Id: TheFinger.Id, X: input.X, Y: input.Y, At: at}, d.look)
		d.finger = Some{Value: fingered[E]{touch: n, scrolls: match under {
		case Some[spot[E]] as s:
			Some{Value: s.Value.id}
		case None:
			None
		}, target: match target {
		case Some[spot[E]] as s:
			Some{Value: s.Value.id}
		case None:
			None
		}}}
		match target {
		case Some[spot[E]] as s:
			try fingerPointed(d, s.Value, ui.Down, x, y)
		case None:
		}
		return
	}
	match holder(d) {
	case Some[spot[E]] as s:
		if input.Kind == screen.Up {
			d.pressed = None
			try fingerPointed(d, s.Value, ui.Up, x, y)
		} else {
			try fingerPointed(d, s.Value, ui.Moved, x, y)
		}
		return
	case None:
	}
	match d.finger {
	case Some[fingered[E]] as f:
		let ev = if input.Kind == screen.Up { ui.FingerUp{Id: TheFinger.Id, X: input.X, Y: input.Y, At: at} } else { ui.FingerMove{Id: TheFinger.Id, X: input.X, Y: input.Y, At: at} }
		let (n, sig) = ui.TouchStep(f.Value.touch, ev, d.look)
		try fingerTo(d, fingered[E]{touch: n, scrolls: f.Value.scrolls, target: f.Value.target})
		// A finger still pressed when it lifts lets go here; one that
		// dragged let go when it began to (fingerTo).
		let pressed = match f.Value.touch.Phase {
		case ui.TouchPressed:
			true
		case _:
			false
		}
		if input.Kind == screen.Up && pressed {
			match f.Value.target {
			case Some[ui.Id[E]] as id:
				match spotOf(d, id.Value) {
				case Some[spot[E]] as sp:
					// The finger lets go of the node it went down on (a
					// drag let go of it already, fingerTo).
					try fingerPointed(d, sp.Value, ui.Up, x, y)
					let tapped = match sig {
					case Some[ui.TouchSignal] as s:
						match s.Value {
						case ui.Tapped:
							true
						case _:
							false
						}
					case None:
						false
					}
					if tapped && pressable(sp.Value.node) {
						if focusable(sp.Value.node) && ui.SessionFocus(&d.session) != (Some{Value: id.Value}) {
							ui.FocusSession(&d.session, Some{Value: id.Value})
						}
						try step(d, ui.Press[E]{Id: id.Value})
					}
					paint(d)
				case None:
				}
			case None:
			}
		}
	case None:
	}
}

// fingerTo keeps f and shows the offset its machine gives; a finger
// lifted with nothing moving is gone, and a fling or a return asks the
// window for frames until it rests.
func fingerTo[E comparable, S, D, F](d mut Driver[S, E, D, F], g fingered[E]) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	// A touch that turned into a drag, a fling or a return is no press:
	// the finger lets go of the node it went down on, so it is not left
	// active, and its lift taps nothing (MB4 x UG3).
	let dragged = match g.touch.Phase {
	case ui.TouchDragging, ui.TouchFlinging, ui.TouchSettling:
		true
	case _:
		false
	}
	let mut f = g
	if dragged {
		match g.target {
		case Some[ui.Id[E]] as id:
			try step(d, ui.Point[E]{Id: id.Value, Pointer: ui.PointerEvent{Pointer: TheFinger, Phase: ui.Up, X: 0, Y: 0, Zone: None}, Over: None})
			f = fingered[E]{touch: g.touch, scrolls: g.scrolls, target: None}
		case None:
		}
	}
	let rested = match f.touch.Phase {
	case ui.TouchIdle:
		true
	case _:
		false
	}
	d.finger = if rested { None } else { Some{Value: f} }
	d.w.Frames(d.frames || fingerMoving(d))
	match f.scrolls {
	case Some[ui.Id[E]] as id:
		let v = float32(f.touch.Y)
		if v != scrolledBy(d, id.Value) {
			d.scrolled[id.Value] = v
			// The damage paint draws the moved list or Scroll anew.
			d.soiled[id.Value] = true
			paint(d)
			try report(d)
		}
	case None:
	}
}

// touchFrame moves a fling or a return to the frame's time.
func touchFrame[E comparable, S, D, F](d mut Driver[S, E, D, F], at duration) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	match d.finger {
	case Some[fingered[E]] as f:
		if ui.TouchMoving(f.Value.touch) {
			let (n, _) = ui.TouchStep(f.Value.touch, ui.TouchFrame{At: at}, d.look)
			try fingerTo(d, fingered[E]{touch: n, scrolls: f.Value.scrolls, target: None})
		}
	case None:
	}
}

// fingerStep moves the window's clock by ms and plays a finger's input
// there, then takes what it caused.
func fingerStep[E comparable, S, D, F](d mut Driver[S, E, D, F], ms int, kind int, x float32, y float32) fails ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	d.fingerAt = d.fingerAt + int64(ms)*int64(1000000)
	d.w.SetClock(d.fingerAt)
	if kind == screen.Down {
		d.w.Touch(float64(x), float64(y))
	} else if kind == screen.Move {
		d.w.TouchMove(float64(x), float64(y))
	} else {
		d.w.Lift(float64(x), float64(y))
	}
	try Drain(d)
}

// FingerScroll drags a finger on the list or Scroll labelled label so
// its content moves by dy (positive: as a wheel's down), from its centre:
// past the slop, then by dy in four moves 10 ms apart, then held still
// for 200 ms before it lifts, so it does not fling.
func FingerScroll[E comparable, S, D, F](d mut Driver[S, E, D, F], label string, dy float32) fails ui.NoNode | ui.Ambiguous | ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	let id = try found(d, label)
	match spotOf(d, id) {
	case Some[spot[E]] as s:
		let x = s.Value.box.X + s.Value.box.W/2
		let y = s.Value.box.Y + s.Value.box.H/2
		let from = y - float32(d.look.Slop) - 1
		try fingerStep(d, 1000, screen.Down, x, y)
		try fingerStep(d, 10, screen.Move, x, from)
		for k in 1..5 {
			try fingerStep(d, 10, screen.Move, x, from-dy*float32(k)/4)
		}
		try fingerStep(d, 200, screen.Move, x, from-dy)
		try fingerStep(d, 0, screen.Up, x, from-dy)
	case None:
		return ui.NoNode{Label: label}
	}
}

// FingerTap taps a finger on the node labelled label: at its centre, or
// past its right edge by beyond DIP when beyond is more than 0 (within
// the reach margin, a finger still hits it).
func FingerTap[E comparable, S, D, F](d mut Driver[S, E, D, F], label string, beyond float32) fails ui.NoNode | ui.Ambiguous | ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	let id = try found(d, label)
	try reveal(d, id)
	match spotOf(d, id) {
	case Some[spot[E]] as s:
		let v = visible(s.Value)
		let x = if beyond > 0 { v.X + v.W + beyond } else { v.X + v.W/2 }
		let y = v.Y + v.H/2
		try fingerStep(d, 1000, screen.Down, x, y)
		try fingerStep(d, 50, screen.Up, x, y)
	case None:
		return ui.NoNode{Label: label}
	}
}
