// Layers (ui.Layer, UG4): a layer is out of the window's flow. build lays
// it out as an absolute child of the window's box at its own size; place
// moves it to ui.PlaceLayer's box against the box of the node its anchor
// key names (ui.AnchorIn); paint paints the layers after the flow, in
// ui.StackOrder, each over its scrim, so the top layer is painted last
// and hit first. A press on a scrim goes to the root: outside every
// layer, so the frame sends the top layer's dismiss signal.

import arena
import option
import ui
import ui/layout

// scrimColor is a scrim's fill: black at 35%.
let scrimColor = uint32(0x00000059)

// cover is a box a layer or its scrim painted over the looks and spots
// painted before it: the first looks of d.looked and the first spots of
// d.spots.
type cover { box layout.Box, looks int, spots int }

// coveredLook is whether a layer painted over pixel x, y after the i-th
// look of the paint, so the look's colour does not show there.
func coveredLook[S, E, D, F](d mut Driver[S, E, D, F], i int, x int, y int) bool {
	for c in d.covers {
		if c.looks > i && probeShows(c.box, x, y) {
			return true
		}
	}
	false
}

// coveredSpot is coveredLook for the i-th spot of the paint.
func coveredSpot[S, E, D, F](d mut Driver[S, E, D, F], i int, x int, y int) bool {
	for c in d.covers {
		if c.spots > i && probeShows(c.box, x, y) {
			return true
		}
	}
	false
}

// isLayer is whether n is a layer.
func isLayer[E](n ui.Node[E]) bool {
	match n {
	case ui.LayerNode[E]:
		true
	case _:
		false
	}
}

// layerNode is the node id when it is a layer.
func layerNode[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) option.Option[ui.LayerNode[E]] {
	match d.nodes.Get(id) {
	case option.Some[held[E]] as h:
		match h.Value.node {
		case ui.LayerNode[E] as l:
			option.Some{Value: l}
		case _:
			option.None
		}
	case option.None:
		option.None
	}
}

// layersFrom is the layers at or under id, in tree order, onto out.
func layersFrom[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], out []ui.Id[E]) []ui.Id[E] {
	let mut all = out
	match layerNode(d, id) {
	case option.Some[ui.LayerNode[E]]:
		all = all.Append(id)
	case option.None:
	}
	for k in kidsOf(d, id) {
		all = layersFrom[S, E, D, F](d, k, all)
	}
	all
}

// stacked is the window's layers, the bottom first (ui.StackOrder).
func stacked[S, E, D, F](d mut Driver[S, E, D, F]) []ui.Id[E] {
	let ls = layersFrom(d, d.root, []ui.Id[E]{})
	let mut zs = []ui.Z{}
	for l in ls {
		match layerNode(d, l) {
		case option.Some[ui.LayerNode[E]] as x:
			zs = zs.Append(x.Value.Z)
		case option.None:
		}
	}
	let mut out = []ui.Id[E]{}
	for i in ui.StackOrder(zs) {
		out = out.Append(ls[i])
	}
	out
}

// insetBox is the part of the window the insets leave (MB4).
func insetBox[S, E, D, F](d mut Driver[S, E, D, F]) layout.Box {
	let r = ui.InsetRect(ui.Rect{X: 0, Y: 0, W: ui.Length(float64(d.width)), H: ui.Length(float64(d.height))}, d.insets)
	layout.Box{X: float32(float64(r.X)), Y: float32(float64(r.Y)), W: float32(float64(r.W)), H: float32(float64(r.H))}
}

// liftOf is how far the Scrolls and lists between at and id (at's own
// offset counted, id's not) lift id: the sum of their offsets, 0 when id
// is not under at.
func liftOf[S, E, D, F](d mut Driver[S, E, D, F], at ui.Id[E], id ui.Id[E]) float32 {
	match upFrom(d, at, id) {
	case option.Some[float32] as l:
		l.Value
	case option.None:
		0
	}
}

// upFrom is the lift of id under at (at's own offset counted), None when
// id is not under at.
func upFrom[S, E, D, F](d mut Driver[S, E, D, F], at ui.Id[E], id ui.Id[E]) option.Option[float32] {
	let own = match d.nodes.Get(at) {
	case option.Some[held[E]] as h:
		match h.Value.node {
		case ui.ScrollNode, ui.RowsNode:
			scrolledBy(d, at)
		case _:
			float32(0)
		}
	case option.None:
		float32(0)
	}
	for k in kidsOf(d, at) {
		if k == id {
			return option.Some{Value: own}
		}
		match upFrom[S, E, D, F](d, k, id) {
		case option.Some[float32] as l:
			return option.Some{Value: own + l.Value}
		case option.None:
		}
	}
	option.None
}

// rectOf is a laid box as a ui Rect.
func rectOf(b layout.Box) ui.Rect {
	ui.Rect{X: ui.Length(float64(b.X)), Y: ui.Length(float64(b.Y)), W: ui.Length(float64(b.W)), H: ui.Length(float64(b.H))}
}

// placeLayers moves each layer, laid out at its own size, to its place
// against its anchor's box in the window. It is whether it moved any.
func placeLayers[S, E, D, F](d mut Driver[S, E, D, F], t mut layout.Tree, ids Map[ui.Id[E], layout.Id]) bool {
	let mut moved = false
	let view = ui.InsetRect(ui.Rect{X: 0, Y: 0, W: ui.Length(float64(d.width)), H: ui.Length(float64(d.height))}, d.insets)
	for l in stacked(d) {
		match (layerNode(d, l), ids.Get(l)) {
		case (option.Some[ui.LayerNode[E]] as x, option.Some[layout.Id] as li):
			let b = boxOf(t, li.Value)
			let mut anchor option.Option[ui.Rect] = option.None
			match x.Value.Anchor {
			case option.Some[ui.Key] as k:
				match ui.AnchorIn(&d.mirror, k.Value) {
				case option.Some[ui.Id[E]] as a:
					match ids.Get(a.Value) {
					case option.Some[layout.Id] as ai:
						// Where the anchor shows: lifted by the offsets of the
						// Scrolls and lists it is in, as draw lifts it.
						let laid = boxOf(t, ai.Value)
						anchor = option.Some{Value: rectOf(layout.Box{X: laid.X, Y: laid.Y - liftOf(d, d.root, a.Value), W: laid.W, H: laid.H})}
					case option.None:
					}
				case option.None:
				}
			case option.None:
			}
			let p = ui.PlaceLayer(anchor, ui.Length(float64(b.W)), ui.Length(float64(b.H)), view, x.Value.Place)
			let at = layout.Absolute{Left: float32(float64(p.X)), Top: float32(float64(p.Y))}
			let was = layout.StyleOf(t, li.Value) catch {
			case arena.Stale:
				layout.Default()
			}
			let same = match was.Position {
			case layout.Absolute as w:
				w.Left == at.Left && w.Top == at.Top
			case layout.Flow:
				false
			}
			if !same {
				let mut s = was
				s.Position = at
				// The layer keeps the size it was laid out at.
				s.Width = layout.Px{Value: b.W}
				s.Height = layout.Px{Value: b.H}
				layout.SetStyle(t, li.Value, s) catch {
				case arena.Stale:
				}
				moved = true
			}
		case _:
		}
	}
	moved
}

// paintLayers paints the layers over the flow, the bottom first, each
// over its scrim; a scrim is a spot of the root's, so a press on it is a
// press outside every layer.
func paintLayers[S, E, D, F](d mut Driver[S, E, D, F], line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	let full = layout.Box{X: 0, Y: 0, W: d.width, H: d.height}
	for l in stacked(d) {
		match layerNode(d, l) {
		case option.Some[ui.LayerNode[E]] as x:
			if x.Value.Scrim {
				d.covers = d.covers.Append(cover{box: full, looks: d.looked.Len(), spots: d.spots.Len()})
				fill(d, full, 0, scrimColor)
				d.under = option.None
				d.spots = d.spots.Append(spot[E]{id: d.root, node: x.Value, box: full, clip: full})
			}
			match d.lids.Get(l) {
			case option.Some[layout.Id] as li:
				d.covers = d.covers.Append(cover{box: boxOf(&d.tree, li.Value), looks: d.looked.Len(), spots: d.spots.Len()})
			case option.None:
			}
			draw(d, l, 0, 0, full, line, soiled, again)
		case option.None:
		}
	}
}

// LayerAt is a layer as the last paint placed it: its box, its anchor's
// box (None: no anchor, or none the window holds), its Place and the
// window's box.
type LayerAt { Box layout.Box, Anchor option.Option[layout.Box], Place ui.Place, View layout.Box }

// LayerBoxes is the window's layers as the last paint placed them, the
// bottom first.
func LayerBoxes[S, E, D, F](d mut Driver[S, E, D, F]) []LayerAt {
	let mut out = []LayerAt{}
	for l in stacked(d) {
		match (layerNode(d, l), d.boxes.Get(l)) {
		case (option.Some[ui.LayerNode[E]] as x, option.Some[layout.Box] as b):
			let mut anchor option.Option[layout.Box] = option.None
			match x.Value.Anchor {
			case option.Some[ui.Key] as k:
				match ui.AnchorIn(&d.mirror, k.Value) {
				case option.Some[ui.Id[E]] as a:
					anchor = d.boxes.Get(a.Value)
				case option.None:
				}
			case option.None:
			}
			out = out.Append(LayerAt{Box: b.Value, Anchor: anchor, Place: x.Value.Place, View: insetBox(d)})
		case _:
		}
	}
	out
}
