// Package desktop runs a ui view over an actor in a MyGo window. Ergo
// owns the tree, the layout (std ui/layout), the look of every node, the
// paint order, hit testing and the keyboard focus; the window (Go package
// screen, over MyGo's drawing layer) gives the input and draws the paint
// list with MyGo's text engine and renderer. No MyGo widget is used.
//
// A Driver steps the same ui.Session that ui.Run and ui.TestHost step, so
// for the same events it shows the same tree as TestHost; the difference
// is that its events come from the window, in pixels, and it finds the
// node under the pointer itself. Run drives one in a desktop window;
// a test drives one on a headless window (screen.Headless) with Play.
//
// The Driver is not a ui.Host provider: its operations call Go, so their
// row holds go.Foreign, which an operation type's method cannot hold
// (README Gap 17); ui.Run's loop is written here once more over the
// window.

import actor
import arena
import go ergo.local/prototype/hosts/mygo/screen
import option
import queue
import task
import ui
import ui/layout

// Driver is one view over one actor in one window.
type Driver[S, E, D, F] {
	w         go.Ref[screen.Window],
	actor     actor.Actor[S, E, D, F],
	session   ui.Session[S, E, D, F],
	mirror    ui.Mirror[E],
	nodes     Map[ui.Id[E], held[E]],
	root      ui.Id[E],
	posted    queue.Queue[ui.Event[E]],
	metrics   Metrics,
	spots     []spot[E],
	canvases  []spot[E],
	viewports Map[ui.Id[E], ui.Viewport],
	pressed   option.Option[ui.Id[E]],
	scrolled  Map[ui.Id[E], float32],
	names     Map[ui.Id[E], int],
	named     int,
	extents   Map[ui.Id[E], float32],
	boxes     Map[ui.Id[E], layout.Box],
	width     float32,
	height    float32,
	frames    bool,
	painted   int,
	// The kept layout (keep.ergo): the tree, the window's box, each
	// node's box, the children each parent's box was last given, each
	// node's parent, the lists, and the style each list given room at
	// the last paint had of its own.
	tree    layout.Tree,
	top     layout.Id,
	lids    Map[ui.Id[E], layout.Id],
	lkids   Map[ui.Id[E], []ui.Id[E]],
	lparent Map[ui.Id[E], ui.Id[E]],
	lists   Map[ui.Id[E], bool],
	roomed  Map[ui.Id[E], layout.Style],
	// rebuild lays out a tree built anew at every paint (Reference);
	// check builds it beside the kept one (Check), differ is the first
	// box where they differed; work is what the last paint's layouts
	// computed (LaidOut).
	rebuild bool,
	check   bool,
	differ  option.Option[string],
	work    int,
	history ui.MemoryHistory,
	// The damage paint (paint.ergo): the nodes a pass, a scroll or the
	// focus changed since the last paint, what each node's last draw was
	// given and gave, each node's key in the window's list, the spots of
	// the last paint, the focus it showed, and how many nodes it drew
	// anew (Drawn).
	soiled   Map[ui.Id[E], bool],
	drew     Map[ui.Id[E], drawn],
	keys     Map[ui.Id[E], int],
	keyed    int,
	lastSpot []spot[E],
	lastCanv []spot[E],
	lastSem  []ui.Id[E],
	// lastLook, lastUnder and lastInks are the last paint's looks,
	// underlines and inks, which a kept draw takes again as its spots.
	lastLook  []lookProbe,
	lastUnder []Probe,
	lastInks  []InkAt,
	shownFoc  option.Option[ui.Id[E]],
	shownHov  option.Option[ui.Id[E]],
	shownAct  option.Option[ui.Id[E]],
	drawn     int,
	// looked is the looks the last paint painted, under the colour
	// under the node painting now (None: unknown), shadowed whether it
	// painted a shadow (look.ergo).
	looked []lookProbe,
	// underlines is where the last paint drew an opaque underline
	// (inkedLines), as probes.
	underlines []Probe,
	// slants is the italic runs the last paint asked the window to
	// slant (inkedRun); the window counts what it slanted (Slanted).
	slants int,
	// inks is the ink each Text and Readout of the last paint was drawn
	// in, by its text (Inks).
	inks     []InkAt,
	under    option.Option[uint32],
	shadowed bool,
	// covers is what the last paint's layers painted over what came
	// before them (layer.ergo): no probe reads a pixel one covers.
	covers []cover,
	// semantics is the Semantic nodes the last paint put in the
	// accessibility tree (semantics.ergo).
	semantics []ui.Id[E],
	// finger is the finger on the window, or the fling or return it left
	// (touch.ergo, MB4); look is the touch constants; insets what the
	// system covers, which the root lays out inside.
	finger option.Option[fingered[E]],
	look   ui.TouchLook,
	insets ui.Insets,
	// fingerAt is the window clock a finger script last set (FingerScroll).
	fingerAt int64,
	// edited is the number of the last Edited input taken (text.ergo, MB5).
	edited int,
	// tracks is each TrackNode's motion, which the window runs on its
	// frames with no pass (track.ergo); trackShown the value each track
	// had at its last draw, so the damage paint draws anew a track that
	// moved since (spread).
	tracks     Map[ui.Id[E], ui.TrackState],
	trackShown Map[ui.Id[E], float64],
	// trackAt is the window time a paint runs its tracks at, one for the
	// whole paint (the full and the damage paints under Check alike).
	trackAt int64,
}

// held is a node of the window's tree and its children, in order.
type held[E] { node ui.Node[E], kids []ui.Id[E] }

// spot is a node that takes input, where it shows: its box and the part
// of the window its scrolled ancestors leave visible, in paint order.
type spot[E] { id ui.Id[E], node ui.Node[E], box layout.Box, clip layout.Box }

// New shows view of a's state in w. room is how many fetch results may
// wait for the driver to take them.
func New[E comparable, S, D, F](w go.Ref[screen.Window], a actor.Actor[S, E, D, F], view own func(f mut ui.Frame[E], s S), room int) Driver[S, E, D, F] fails ui.BadPatch needs go.Foreign {
	let posted = queue.New[ui.Event[E]](room)
	try start(w, a, view, posted, func(ev ui.Event[E]) {
		posted.Push(ev) catch {
		case queue.Closed:
		}
	})
}

// start shows view of a's state in w; post gets each fetch's result, and
// Pump and Settle take them from posted.
func start[E comparable, S, D, F](w go.Ref[screen.Window], a actor.Actor[S, E, D, F], view own func(f mut ui.Frame[E], s S), posted queue.Queue[ui.Event[E]], post own func(ev ui.Event[E])) Driver[S, E, D, F] fails ui.BadPatch needs go.Foreign {
	let (s, first) = ui.Start(a, view, post)
	let mut session = s
	let root = ui.SessionRoot(&session)
	let (width, height) = w.Size()
	let mut tree = layout.New()
	let top = layout.Add(&tree, plainStyle())
	let mut d = Driver[S, E, D, F]{
		w:          w,
		actor:      a,
		session:    session,
		mirror:     ui.NewMirror[E](root),
		nodes:      Map[ui.Id[E], held[E]]{},
		root:       root,
		posted:     posted,
		metrics:    NewMetrics(),
		spots:      []spot[E]{},
		canvases:   []spot[E]{},
		viewports:  Map[ui.Id[E], ui.Viewport]{},
		pressed:    option.None,
		scrolled:   Map[ui.Id[E], float32]{},
		names:      Map[ui.Id[E], int]{},
		named:      0,
		extents:    Map[ui.Id[E], float32]{},
		boxes:      Map[ui.Id[E], layout.Box]{},
		width:      float32(width),
		height:     float32(height),
		frames:     false,
		painted:    0,
		tree:       tree,
		top:        top,
		lids:       Map[ui.Id[E], layout.Id]{},
		lkids:      Map[ui.Id[E], []ui.Id[E]]{},
		lparent:    Map[ui.Id[E], ui.Id[E]]{},
		lists:      Map[ui.Id[E], bool]{},
		roomed:     Map[ui.Id[E], layout.Style]{},
		rebuild:    false,
		check:      false,
		differ:     option.None,
		work:       0,
		history:    ui.NewMemoryHistory(ui.URL{Path: "/", Query: "", Fragment: ""}),
		soiled:     Map[ui.Id[E], bool]{},
		drew:       Map[ui.Id[E], drawn]{},
		keys:       Map[ui.Id[E], int]{},
		keyed:      0,
		lastSpot:   []spot[E]{},
		lastCanv:   []spot[E]{},
		lastSem:    []ui.Id[E]{},
		shownFoc:   option.None,
		shownHov:   option.None,
		shownAct:   option.None,
		drawn:      0,
		looked:     []lookProbe{},
		under:      option.None,
		shadowed:   false,
		underlines: []Probe{},
		slants:     0,
		inks:       []InkAt{},
		lastLook:   []lookProbe{},
		lastUnder:  []Probe{},
		lastInks:   []InkAt{},
		covers:     []cover{},
		semantics:  []ui.Id[E]{},
		finger:     option.None,
		look:       ui.AndroidTouch(),
		insets:     ui.NoInsets,
		fingerAt:   int64(0),
		edited:     0,
		tracks:     Map[ui.Id[E], ui.TrackState]{},
		trackShown: Map[ui.Id[E], float64]{},
		trackAt:    int64(0),
	}
	learn(&d.metrics, w, "", textSize)
	d.nodes[root] = held[E]{node: ui.BoxNode{Style: ui.Plain()}, kids: []ui.Id[E]{}}
	try show(&d, first)
	d
}

// show applies one pass's ops, then lays out and paints the window.
func show[E comparable, S, D, F](d mut Driver[S, E, D, F], ops []ui.Op[E]) fails ui.BadPatch needs go.Foreign {
	try ui.Apply(&d.mirror, ops)
	for op in ops {
		match op {
		case ui.Insert[E] as x:
			d.nodes[x.Id] = held[E]{node: x.Node, kids: []ui.Id[E]{}}
			place(d, x.Id, x.Parent, x.Before)
			d.soiled[x.Parent] = true
			scrollTo(d, x.Id, x.Node)
			runTrack(d, x.Id, x.Node)
		case ui.Move[E] as x:
			unplace(d, x.Parent, x.Id)
			place(d, x.Id, x.Parent, x.Before)
			d.soiled[x.Parent] = true
		case ui.Remove[E] as x:
			match d.lparent.Get(x.Id) {
			case option.Some[ui.Id[E]] as p:
				d.soiled[p.Value] = true
			case option.None:
			}
			drop(d, x.Id)
		case ui.Set[E] as x:
			d.soiled[x.Id] = true
			scrollTo(d, x.Id, x.Node)
			match d.nodes.Get(x.Id) {
			case option.Some[held[E]] as h:
				d.nodes[x.Id] = held[E]{node: x.Node, kids: h.Value.kids}
			case option.None:
			}
			runTrack(d, x.Id, x.Node)
		case ui.Define:
		}
	}
	if !d.rebuild {
		keep(d, ops)
	}
	let animates = ui.SessionAnimates(&d.session) || tracksMoving(d)
	if animates != d.frames {
		d.frames = animates
		d.w.Frames(animates || fingerMoving(d))
	}
	paint(d)
	// A stopped actor takes no viewport; the next step it is sent fails
	// actor.Stopped where the caller handles it.
	report(d) catch {
	case actor.Stopped:
	case ui.BadPatch as b:
		return b
	}
}

// scrollTo scrolls the list id to the offset its pass wrote (RowsNode's
// Offset) when that is not the window's: a RowsKeeping list brought its
// row into view. The paint keeps it inside the content, and report tells
// the session where it went.
func scrollTo[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], node ui.Node[E]) {
	match node {
	case ui.RowsNode as x:
		let off = fmax(float32(float64(x.Offset)), 0)
		if off != scrolledBy(d, id) {
			d.scrolled[id] = off
			d.soiled[id] = true
		}
	case _:
	}
}

// report tells the session the viewport of each list the window shows
// (its scroll offset and its height) when it changed: the next pass
// writes the rows it shows, and that pass's show reports again until no
// list's viewport moves.
func report[E comparable, S, D, F](d mut Driver[S, E, D, F]) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	for s in d.spots {
		match s.node {
		case ui.RowsNode:
			// A list a scrim covers takes no report (the frame drops it,
			// UG4): it is reported once the scrim goes.
			if ui.SessionShielded(&d.session, s.id) {
				continue
			}
			let v = ui.Viewport{Offset: ui.Length(float64(scrolledBy(d, s.id))), Height: ui.Length(float64(s.box.H))}
			if d.viewports.Get(s.id) != (option.Some{Value: v}) {
				d.viewports[s.id] = v
				try step(d, ui.Scrolled[E]{Id: s.id, Offset: v.Offset, Height: v.Height})
				return
			}
		case _:
		}
	}
}

// Viewport is the viewport the window last reported for the list
// labelled label, None before it showed one.
func Viewport[S, E, D, F](d mut Driver[S, E, D, F], label string) option.Option[ui.Viewport] {
	match Find(d, label) {
	case option.Some[ui.Id[E]] as id:
		d.viewports.Get(id.Value)
	case option.None:
		option.None
	}
}

// place puts id among parent's children, in front of before or last.
func place[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], parent ui.Id[E], before option.Option[ui.Id[E]]) {
	match d.nodes.Get(parent) {
	case option.Some[held[E]] as p:
		let mut kids = []ui.Id[E]{}
		let mut done = false
		for k in p.Value.kids {
			if !done && before == (option.Some{Value: k}) {
				kids = kids.Append(id)
				done = true
			}
			if k != id {
				kids = kids.Append(k)
			}
		}
		if !done {
			kids = kids.Append(id)
		}
		d.nodes[parent] = held[E]{node: p.Value.node, kids: kids}
	case option.None:
	}
}

// unplace takes id out of parent's children.
func unplace[S, E, D, F](d mut Driver[S, E, D, F], parent ui.Id[E], id ui.Id[E]) {
	match d.nodes.Get(parent) {
	case option.Some[held[E]] as p:
		let mut kids = []ui.Id[E]{}
		for k in p.Value.kids {
			if k != id {
				kids = kids.Append(k)
			}
		}
		d.nodes[parent] = held[E]{node: p.Value.node, kids: kids}
	case option.None:
	}
}

// drop forgets id and its subtree, and takes it out of its parent.
func drop[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) {
	if !d.rebuild {
		// A layer's box hangs from the window's, not from its parent's
		// (UG4), so the layers under id go out on their own.
		for l in layersFrom(d, id, []ui.Id[E]{}).Append(id) {
			match d.lids.Get(l) {
			case option.Some[layout.Id] as b:
				layout.Remove(&d.tree, b.Value) catch {
				case arena.Stale:
				}
			case option.None:
			}
		}
	}
	for p, h in d.nodes {
		for k in h.kids {
			if k == id {
				unplace(d, p, id)
			}
		}
	}
	forget(d, id)
}

func forget[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) {
	match d.nodes.Get(id) {
	case option.Some[held[E]] as h:
		for k in h.Value.kids {
			forget[S, E, D, F](d, k)
		}
	case option.None:
	}
	d.nodes = d.nodes.Delete(id)
	d.tracks = d.tracks.Delete(id)
	d.trackShown = d.trackShown.Delete(id)
	d.scrolled = d.scrolled.Delete(id)
	d.viewports = d.viewports.Delete(id)
	d.names = d.names.Delete(id)
	d.lids = d.lids.Delete(id)
	d.lkids = d.lkids.Delete(id)
	d.lparent = d.lparent.Delete(id)
	d.lists = d.lists.Delete(id)
	d.roomed = d.roomed.Delete(id)
	d.boxes = d.boxes.Delete(id)
	d.extents = d.extents.Delete(id)
	d.drew = d.drew.Delete(id)
	d.keys = d.keys.Delete(id)
	d.soiled = d.soiled.Delete(id)
	if d.pressed == (option.Some{Value: id}) {
		d.pressed = option.None
	}
}

// kidsOf is id's children in the window's tree.
func kidsOf[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) []ui.Id[E] {
	match d.nodes.Get(id) {
	case option.Some[held[E]] as h:
		h.Value.kids
	case option.None:
		[]ui.Id[E]{}
	}
}

// Feed takes one input of the window. A press and a release on the same
// node press it; the node a press went down on takes the pointer's moves
// and its release (an Area's pointer is captured), and a move or a
// release with no press goes to the node under it; Tab moves the focus, Enter and space press the focused
// node; typing goes to the focused Input; other keys go to the view's
// OnKey. It fails ui.Closed when the window closed.
func Feed[E comparable, S, D, F](d mut Driver[S, E, D, F], input screen.Input) fails ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	let mods = ui.Mods{Shift: input.Shift, Ctrl: input.Ctrl, Alt: input.Alt, Meta: input.Meta}
	let x = float32(input.X)
	let y = float32(input.Y)
	if input.Kind == screen.Closed {
		return ui.Closed
	} else if input.Finger && (input.Kind == screen.Down || input.Kind == screen.Move || input.Kind == screen.Up) {
		// A finger scrolls through std ui's touch machine (MB4).
		try touched(d, input)
	} else if input.Kind == screen.Down {
		let hit = hitAt(d, x, y)
		d.pressed = option.None
		let back = match hit {
		case option.Some[spot[E]] as s:
			s.Value.id == d.root
		case option.None:
			true
		}
		if back {
			// A Down over no node or over a scrim is a click on the
			// window's background, as ui.ClickNowhere is: the pointer
			// leaves every node, the focus every node, and the Down goes
			// to the root, outside every layer, so the top layer with a
			// dismiss signal sends it (UG4); its Up goes to the root too.
			try nowhere(d)
			d.pressed = option.Some{Value: d.root}
			if ui.SessionFocus(&d.session) != option.None {
				ui.FocusSession(&d.session, option.None)
			}
			try step(d, ui.Point[E]{Id: d.root, Pointer: ui.PointerEvent{Pointer: ui.MousePointer, Phase: ui.Down, X: 0, Y: 0, Zone: option.None}, Over: option.None})
			paint(d)
			return
		}
		match hit {
		case option.Some[spot[E]] as s:
			d.pressed = option.Some{Value: s.Value.id}
			if focusable(s.Value.node) && ui.SessionFocus(&d.session) != (option.Some{Value: s.Value.id}) {
				ui.FocusSession(&d.session, option.Some{Value: s.Value.id})
				paint(d)
			}
			try pointed(d, s.Value, ui.Down, x, y)
			paint(d)
		case option.None:
		}
	} else if input.Kind == screen.Up {
		match d.pressed {
		case option.Some[ui.Id[E]] as p:
			d.pressed = option.None
			if p.Value == d.root {
				try step(d, ui.Point[E]{Id: d.root, Pointer: ui.PointerEvent{Pointer: ui.MousePointer, Phase: ui.Up, X: 0, Y: 0, Zone: option.None}, Over: option.None})
				paint(d)
				return
			}
			match spotOf(d, p.Value) {
			case option.Some[spot[E]] as s:
				try pointed(d, s.Value, ui.Up, x, y)
				if pressable(s.Value.node) && inside(s.Value, x, y) {
					try step(d, ui.Press[E]{Id: p.Value})
				}
				paint(d)
			case option.None:
			}
		case option.None:
			match hitAt(d, x, y) {
			case option.Some[spot[E]] as s:
				try pointed(d, s.Value, ui.Up, x, y)
			case option.None:
			}
		}
	} else if input.Kind == screen.Move {
		// The frame decides the hover from where each move goes (UG3): to
		// the node under the pointer, or to the root over none. A changed
		// hover repaints, with no pass.
		let was = ui.SessionHovered(&d.session)
		// A pressed pointer's moves go to the node it went down on, over
		// any other node or none; a free pointer's to the node under it.
		let held = match d.pressed {
		case option.Some[ui.Id[E]] as p:
			spotOf(d, p.Value)
		case option.None:
			option.None
		}
		match held {
		case option.Some[spot[E]] as s:
			try pointed(d, s.Value, ui.Moved, x, y)
		case option.None:
			match hitAt(d, x, y) {
			case option.Some[spot[E]] as s:
				try pointed(d, s.Value, ui.Moved, x, y)
			case option.None:
				try nowhere(d)
			}
		}
		if ui.SessionHovered(&d.session) != was {
			paint(d)
		}
	} else if input.Kind == screen.Scroll {
		try scroll(d, x, y, float32(input.DX), float32(input.DY))
	} else if input.Kind == screen.Key {
		try key(d, ui.KeyPress{Name: input.Key, Mods: mods})
	} else if input.Kind == screen.Text {
		try typed(d, input.Text, mods)
	} else if input.Kind == screen.Edited {
		try takeEdited(d, input.Edit, input.Text)
	} else if input.Kind == screen.Resize {
		d.width = float32(input.Width)
		d.height = float32(input.Height)
		paint(d)
		try report(d)
	} else if input.Kind == screen.Frame {
		try touchFrame(d, duration(input.At))
		try step(d, ui.Tick{At: duration(input.At)})
		trackFrame(d)
	}
}

// step steps the session with ev and shows its patch.
func step[E comparable, S, D, F](d mut Driver[S, E, D, F], ev ui.Event[E]) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	let was = markOf(d)
	let ops = try ui.Step(&d.session, ev)
	if ops.Len() > 0 {
		try show(d, ops)
	} else if markOf(d) != was {
		paint(d)
	}
	match ev {
	case ui.Published as p:
		reread(d, p.Readout)
	case _:
	}
}

// reread paints the window again when a node reads readout id, which
// the damage paint draws anew (soiled): a readout's box is its
// reserve's, which its reading never changes.
func reread[S, E, D, F](d mut Driver[S, E, D, F], id int) needs go.Foreign {
	let mut any = false
	for n, h in d.nodes {
		match h.node {
		case ui.ReadoutNode as x:
			if x.Readout == id {
				any = true
				d.soiled[n] = true
			}
		case _:
		}
	}
	if any {
		paint(d)
	}
}

// lookMark is what a step can change in the looks with no op (UG3): the
// focus, whether its look shows, and the hover.
type lookMark[E] { focus option.Option[ui.Id[E]], shown bool, hover option.Option[ui.Id[E]] }

// markOf is d's lookMark now.
func markOf[S, E, D, F](d mut Driver[S, E, D, F]) lookMark[E] {
	let focus = ui.SessionFocus(&d.session)
	let shown = match focus {
	case option.Some[ui.Id[E]] as id:
		ui.SessionLookState(&d.session, id.Value) == ui.FocusVisible
	case option.None:
		false
	}
	lookMark[E]{focus: focus, shown: shown, hover: ui.SessionHovered(&d.session)}
}

// pointed sends a pointer event to a spot, at a place in its box: an
// Area makes its signal, and any spot is where the pointer is, which the
// frame's hover and pressed states follow (UG3).
func pointed[E comparable, S, D, F](d mut Driver[S, E, D, F], s spot[E], phase ui.Phase, x float32, y float32) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	try step(d, ui.Point[E]{Id: s.id, Pointer: ui.PointerEvent{Pointer: ui.MousePointer, Phase: phase, X: float64(x - s.box.X), Y: float64(y - s.box.Y), Zone: option.None}, Over: option.None})
}

// nowhere tells the frame the pointer is over no node (a move to the
// root, UG3).
func nowhere[E comparable, S, D, F](d mut Driver[S, E, D, F]) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	if ui.SessionHovered(&d.session) != option.None {
		try step(d, ui.Point[E]{Id: ui.SessionRoot(&d.session), Pointer: ui.PointerEvent{Pointer: ui.MousePointer, Phase: ui.Moved, X: 0, Y: 0, Zone: option.None}, Over: option.None})
	}
}

// PointAway moves the window's pointer to its bottom right corner, over
// no node, as a pointer leaving the window does.
func PointAway[E comparable, S, D, F](d mut Driver[S, E, D, F]) fails actor.Stopped | ui.BadPatch | ui.Closed needs go.Foreign {
	d.w.Hover(float64(d.width-1), float64(d.height-1))
	try Drain(d)
}

// scroll moves the innermost Scroll under x, y by dy, within its content,
// and sends the wheel to an Area under it.
func scroll[E comparable, S, D, F](d mut Driver[S, E, D, F], x float32, y float32, dx float32, dy float32) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	let mut target option.Option[spot[E]] = option.None
	let mut area option.Option[spot[E]] = option.None
	for s in d.spots {
		if s.id == d.root {
			// A scrim, over every spot before it: the wheel over it
			// scrolls nothing under it, as the frame takes no event of a
			// node it covers (UG4).
			target = option.None
			area = option.None
			continue
		}
		if inside(s, x, y) {
			match s.node {
			case ui.ScrollNode, ui.RowsNode:
				target = option.Some{Value: s}
			case ui.AreaNode:
				area = option.Some{Value: s}
			case _:
			}
		}
	}
	match area {
	case option.Some[spot[E]] as a:
		try pointed(d, a.Value, ui.Wheel{DX: float64(dx), DY: float64(dy)}, x, y)
	case option.None:
	}
	match target {
	case option.Some[spot[E]] as s:
		let at = scrolledBy(d, s.Value.id)
		let most = fmax(contentHeight(d, s.Value.id)-s.Value.box.H, 0)
		let next = fmin(fmax(at+dy, 0), most)
		if next != at {
			d.scrolled[s.Value.id] = next
			d.soiled[s.Value.id] = true
			paint(d)
			try report(d)
		}
	case option.None:
	}
}

func fmin(a float32, b float32) float32 { if a < b { a } else { b } }

// key handles a key press: Enter and space press the focused Pressable,
// Check, Toggle or sending Semantic, a key that edits the focused Input
// (ui.KeyEdit) is an Edit of it, and the rest go to the session, where Tab
// and Shift+Tab move the focus when no key function takes them (UC-TAB).
func key[E comparable, S, D, F](d mut Driver[S, E, D, F], k ui.KeyPress) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	if k.Name == "Tab" {
		try step(d, ui.KeyDown{Press: k})
		paint(d)
		return
	}
	match focused(d) {
	case option.Some[spot[E]] as s:
		match s.Value.node {
		case ui.InputNode as x:
			// A key that edits the field or moves its caret is an Edit
			// (ui.KeyEdit, OpenTUI gap 2); one that changes nothing is
			// taken all the same, as a field takes Backspace at its start.
			let was = ui.EditingOf(x)
			match ui.KeyEdit(was, k, x.Lines) {
			case option.Some[ui.Editing] as e:
				if e.Value != was {
					try step(d, ui.Edit[E]{Id: s.Value.id, Text: e.Value.Text, Caret: e.Value.Caret, Anchor: e.Value.Anchor})
				}
				return
			case option.None:
			}
		case _:
			if pressable(s.Value.node) && (k.Name == "Enter" || k.Name == " ") {
				try step(d, ui.Press[E]{Id: s.Value.id})
				return
			}
		}
	case option.None:
	}
	// A roving group's arrows move the focus with no pass (UG3).
	let was = ui.SessionFocus(&d.session)
	try step(d, ui.KeyDown{Press: k})
	if ui.SessionFocus(&d.session) != was {
		paint(d)
	}
}

// typed types text into the focused Input, else gives each rune to OnKey
// as a key of that name.
func typed[E comparable, S, D, F](d mut Driver[S, E, D, F], text string, mods ui.Mods) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	match focused(d) {
	case option.Some[spot[E]] as s:
		match s.Value.node {
		case ui.InputNode as x:
			// The text goes in at the caret, over the selection.
			let e = ui.InsertText(ui.EditingOf(x), text)
			try step(d, ui.Edit[E]{Id: s.Value.id, Text: e.Text, Caret: e.Caret, Anchor: e.Anchor})
			return
		case _:
		}
	case option.None:
	}
	for r in runesOf(text) {
		try key(d, ui.KeyPress{Name: r, Mods: mods})
	}
}

// focused is the spot of the focused node.
func focused[S, E, D, F](d mut Driver[S, E, D, F]) option.Option[spot[E]] {
	match ui.SessionFocus(&d.session) {
	case option.Some[ui.Id[E]] as f:
		spotOf(d, f.Value)
	case option.None:
		option.None
	}
}

// spotOf is id's spot, when it takes input.
func spotOf[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) option.Option[spot[E]] {
	for s in d.spots {
		if s.id == id {
			return option.Some{Value: s}
		}
	}
	option.None
}

// holder is the Area spot that holds the pointer: the one pressed, if it
// is an Area and still shown.
func holder[S, E, D, F](d mut Driver[S, E, D, F]) option.Option[spot[E]] {
	match d.pressed {
	case option.Some[ui.Id[E]] as p:
		match spotOf(d, p.Value) {
		case option.Some[spot[E]] as s:
			match s.Value.node {
			case ui.AreaNode:
				return option.Some{Value: s.Value}
			case _:
			}
		case option.None:
		}
	case option.None:
	}
	option.None
}

// hitAt is the spot on top at x, y: the last painted whose visible box
// holds the point, Scrolls left out.
func hitAt[S, E, D, F](d mut Driver[S, E, D, F], x float32, y float32) option.Option[spot[E]] {
	let mut hit option.Option[spot[E]] = option.None
	for s in d.spots {
		match s.node {
		case ui.ScrollNode, ui.RowsNode:
		case _:
			if inside(s, x, y) {
				hit = option.Some{Value: s}
			}
		}
	}
	hit
}

// inside is whether x, y is in s's visible box.
func inside[E](s spot[E], x float32, y float32) bool {
	let b = s.box
	let c = s.clip
	x >= b.X && y >= b.Y && x < b.X+b.W && y < b.Y+b.H && x >= c.X && y >= c.Y && x < c.X+c.W && y < c.Y+c.H
}

// pressable is whether a press of the node sends its signal: a focusable
// node other than an Input.
func pressable[E](n ui.Node[E]) bool {
	match n {
	case ui.InputNode:
		false
	case _:
		ui.Focusable(n)
	}
}

// focusable is whether the node takes the keyboard focus (ui.Focusable,
// the rule Tab follows).
func focusable[E](n ui.Node[E]) bool { ui.Focusable(n) }

// scrolledBy is how far id's Scroll is scrolled.
func scrolledBy[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) float32 {
	match d.scrolled.Get(id) {
	case option.Some[float32] as v:
		v.Value
	case option.None:
		0
	}
}

// Pump takes every fetch result posted so far, without waiting.
func Pump[E comparable, S, D, F](d mut Driver[S, E, D, F]) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	for {
		match d.posted.Poll() {
		case option.Some[ui.Event[E]] as ev:
			try step(d, ev.Value)
		case option.None:
			return
		}
	}
}

// Settle waits until no fetch is in flight and every posted result is
// taken, as ui.Settle does.
func Settle[E comparable, S, D, F](d mut Driver[S, E, D, F]) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	for ui.InFlight(&d.session) > 0 || d.posted.Len() > 0 {
		let ev = d.posted.Pop() catch {
		case queue.Closed:
			return
		}
		try step(d, ev)
	}
}

// Screen is what the window shows, as the patches built it.
func Screen[S, E, D, F](d mut Driver[S, E, D, F]) []ui.Shape[E] { ui.ShownShapesIn(&d.session, ui.MirrorShape(&d.mirror)) }

// StateOf is the actor's state.
func StateOf[S, E, D, F](d mut Driver[S, E, D, F]) S { d.actor.State() }

// Reference makes d lay out a tree built anew from its nodes at every
// paint, as the driver did before it kept one: the reference the kept
// tree is held to. It repaints at once.
func Reference[S, E, D, F](d mut Driver[S, E, D, F]) needs go.Foreign {
	d.rebuild = true
	paint(d)
}

// Check makes d build the reference tree beside the kept one at every
// paint and compare every node's box, and draw every node beside the
// damage paint and compare the two lists and their spots (Differs).
func Check[S, E, D, F](d mut Driver[S, E, D, F]) needs go.Foreign {
	d.check = true
	paint(d)
}

// Differs is the first box where the kept tree and the reference differed
// at a paint since Check, None while they agree.
func Differs[S, E, D, F](d mut Driver[S, E, D, F]) option.Option[string] { d.differ }

// LaidOut is how many boxes the last paint's layouts computed
// (layout.Work): the boxes whose style or children changed since the
// paint before and those around them, not the tree, unless it rebuilds.
func LaidOut[S, E, D, F](d mut Driver[S, E, D, F]) int {
	if d.rebuild {
		return d.lids.Len()
	}
	d.work
}

// Painted is how many paint lists the driver has given the window.
func Painted[S, E, D, F](d mut Driver[S, E, D, F]) int { d.painted }

// Drawn is how many nodes the last paint drew anew: the nodes a pass, a
// scroll or the focus changed, those around them whose boxes moved, and
// their ancestors; every node takes its last draw again otherwise. It is
// every node under Reference, which draws the whole tree each paint.
func Drawn[S, E, D, F](d mut Driver[S, E, D, F]) int { d.drawn }

// FocusId is the focused node, None for none.
func FocusId[S, E, D, F](d mut Driver[S, E, D, F]) option.Option[ui.Id[E]] { ui.SessionFocus(&d.session) }

// FocusNode is what the focused node shows, None for none.
func FocusNode[S, E, D, F](d mut Driver[S, E, D, F]) option.Option[ui.Node[E]] {
	match focused(d) {
	case option.Some[spot[E]] as s:
		option.Some{Value: s.Value.node}
	case option.None:
		option.None
	}
}

// Probe is a place where a node's fill shows, and the fill's color
// (0xRRGGBBAA): a look's fill below its top edge and the colour under it
// outside its top-left corner (lookProbes), a checked Check's box, a
// Toggle's track, a canvas's last opaque fill (canvasProbe), an
// opaque underline under a Text's run (inkedLines).
type Probe { Label string, X int, Y int, Color uint32 }

// InkAt is the ink a Text or a Readout was drawn in, by the text it
// shows (a Readout's reading).
type InkAt { Label string, Ink ui.Ink }

// Inks are the inks the last paint drew each Text and Readout in.
func Inks[S, E, D, F](d mut Driver[S, E, D, F]) []InkAt { d.inks }

// Slants is how many italic runs the last paint asked the window to draw
// slanted; the window's Slanted is how many it did.
func Slants[S, E, D, F](d mut Driver[S, E, D, F]) int { d.slants }

// Probes are the probes of the nodes on screen whose probe point no clip
// cuts, in paint order.
func Probes[S, E, D, F](d mut Driver[S, E, D, F]) []Probe {
	let mut out = lookProbes(d)
	for u in d.underlines {
		out = out.Append(u)
	}
	for i, s in d.spots {
		let b = s.box
		let mut x = b.X + b.W/2
		let mut y = b.Y + 3
		let mut color = accent
		let mut label = ""
		match s.node {
		case ui.CheckNode[E] as c:
			if !c.Checked {
				continue
			}
			label = c.Label
			x = b.X + mark/2
			y = b.Y + b.H/2
			color = accent
		case ui.ToggleNode as t:
			label = t.Label
			x = if t.On { b.X + 4 } else { b.X + switchW - 6 }
			y = b.Y + b.H/2
			color = if t.On { accent } else { track }
		case _:
			continue
		}
		let cx = float32(int(x))
		let cy = float32(int(y))
		let c = s.clip
		if cx >= c.X && cy >= c.Y && cx < c.X+c.W && cy < c.Y+c.H && !coveredSpot(d, i, int(x), int(y)) {
			out = out.Append(Probe{Label: label, X: int(x), Y: int(y), Color: color})
		}
	}
	for s in d.canvases {
		match s.node {
		case ui.CanvasNode as cv:
			match canvasProbe(cv.Paint, s.box) {
			case option.Some[shown] as p:
				let px = int(p.Value.at.X)
				let py = int(p.Value.at.Y)
				let cx = float32(px)
				let cy = float32(py)
				let c = cut(s.clip, s.box)
				if cx >= c.X && cy >= c.Y && cx < c.X+c.W && cy < c.Y+c.H {
					out = out.Append(Probe{Label: cv.Label, X: px, Y: py, Color: p.Value.color})
				}
			case option.None:
			}
		case _:
		}
	}
	out
}

// Focus is the label of the focused node, None for none.
func Focus[S, E, D, F](d mut Driver[S, E, D, F]) option.Option[string] {
	match focused(d) {
	case option.Some[spot[E]] as s:
		labelOf(s.Value.node)
	case option.None:
		option.None
	}
}

// Run shows view of a's state in a desktop window w until it closes, as
// ui.Run does on a ui.Host. It runs MyGo's loop on the calling thread,
// which must be the main thread: call it from main, whose task runs on
// it. The view and the window's events run on a task of their own; a
// fetch's result reaches that task through the window, which it wakes.
func Run[E comparable, S, D, F](w go.Ref[screen.Window], a actor.Actor[S, E, D, F], view own func(f mut ui.Frame[E], s S)) fails ui.Closed | actor.Stopped | ui.BadPatch | go.Error needs go.Foreign {
	let fetched = queue.New[ui.Event[E]](64)
	let posted = queue.New[ui.Event[E]](64)
	let forward = task.Go() {
		forwardAll(w, fetched, posted)
		0
	}
	let loop = task.Go() {
		let mut d = try start(w, a, view, posted, func(ev ui.Event[E]) {
			fetched.Push(ev) catch {
			case queue.Closed:
			}
		})
		try serve(&d)
		w.Quit()
		0
	}
	try w.Run()
	w.Closing()
	let _ = try loop.Wait()
	fetched.End()
	let _ = forward.Wait()
}

// forwardAll moves each fetch result to posted and wakes the window's
// Next, until fetched ends.
func forwardAll[E](w go.Ref[screen.Window], fetched queue.Queue[ui.Event[E]], posted queue.Queue[ui.Event[E]]) needs go.Foreign {
	for ev in fetched.Values() {
		posted.Push(ev) catch {
		case queue.Closed:
			return
		}
		w.Wake()
	}
}

// serve feeds the window's input to d until the window closes.
func serve[E comparable, S, D, F](d mut Driver[S, E, D, F]) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	for {
		let next = d.w.Next() catch {
		case go.Error:
			return
		}
		Feed(d, next) catch {
		case ui.Closed:
			return
		case actor.Stopped as e:
			return e
		case ui.BadPatch as e:
			return e
		}
		try Pump(d)
	}
}

// layout's Box helpers.
func boxOf(t mut layout.Tree, id layout.Id) layout.Box {
	layout.BoxOf(t, id) catch {
	case arena.Stale:
		layout.Box{X: 0, Y: 0, W: 0, H: 0}
	}
}
