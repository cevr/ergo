// Drive and Answer: a window played from a socket, a line of script at a
// time, so a test on another machine (a phone's, through `adb forward`)
// plays the example's script and reads what it prints, as -headless does
// on the desktop.

import actor
import go ergo.local/prototype/hosts/mygo/screen
import net
import queue
import strings
import task
import ui

// Answer plays the script lines c sends, each as Play plays a step, and
// answers each line on c: a line "N: <summary of the state>" per step it
// holds, N counted over the whole script, as the example's -headless
// prints it (a label not on the screen: "N: no node L"; one on several
// nodes: "N: K nodes at A"; a failed expectation: "N: want W, got G",
// then the state), and then an empty line, which ends the answer. A line
// with no step (blank, a comment, or one parse refuses) answers only the
// empty line. It first sends "ready", and returns when c ends.
func Answer[E comparable, S, D, F](d mut Driver[S, E, D, F], c net.Conn, parse own func(line string) []ui.Act, summary own func(s S) string) fails ui.Closed | actor.Stopped | ui.BadPatch needs go.Foreign {
	send(c, "ready\n")
	let mut n = 0
	let mut held = ""
	for {
		let part = c.Read() catch {
		case net.Failed:
			return
		}
		if part == "" {
			return
		}
		held = held + part
		for strings.Contains(held, "\n") {
			let (line, rest) = match strings.Cut(held, "\n") {
			case Some[strings.Halves] as h:
				(h.Value.Before, h.Value.After)
			case None:
				(held, "")
			}
			held = rest
			let mut out = ""
			for act in parse(line) {
				n = n + 1
				Play(d, []ui.Act{act}) catch {
				case ui.NoNode as x:
					out = out + "\(n): no node \(x.Label)\n"
					continue
				case ui.Mismatch as m:
					out = out + "\(n): want \(m.Want), got \(m.Got)\n"
				case ui.Ambiguous as x:
					out = out + "\(n): \(x.Count) nodes at \(x.At)\n"
					continue
				case ui.Closed as e:
					return e
				case actor.Stopped as e:
					return e
				case ui.BadPatch as e:
					return e
				}
				out = out + "\(n): \(summary(StateOf(d)))\n"
			}
			send(c, out+"\n")
		}
	}
}

// answerOne answers the first connection l accepts, if it accepts one. A
// closed window ends the answers, not the driver.
func answerOne[E comparable, S, D, F](d mut Driver[S, E, D, F], l net.Listener, parse own func(line string) []ui.Act, summary own func(s S) string) fails actor.Stopped | ui.BadPatch needs go.Foreign {
	let c = l.Accept() catch {
	case net.Failed:
		return
	}
	Answer(d, c, parse, summary) catch {
	case ui.Closed:
	case actor.Stopped as e:
		c.Close()
		return e
	case ui.BadPatch as e:
		c.Close()
		return e
	}
	c.Close()
}

// send writes data on c; a peer that went away ends the answers at its
// next read.
func send(c net.Conn, data string) {
	c.Write(data) catch {
	case net.Failed:
	}
}

// Drive runs w as Run does, but first answers the one connection l
// accepts (Answer): the window shows each step as it is played. When the
// connection ends, w goes on as Run's window, on its own input.
func Drive[E comparable, S, D, F](w go.Ref[screen.Window], a actor.Actor[S, E, D, F], view own func(f mut ui.Frame[E], s S), l own net.Listener, parse own func(line string) []ui.Act, summary own func(s S) string) fails ui.Closed | actor.Stopped | ui.BadPatch | go.Error needs go.Foreign {
	let fetched = queue.New[ui.Event[E]](64)
	let posted = queue.New[ui.Event[E]](64)
	let forward = task.Go() {
		forwardAll(w, fetched, posted)
		0
	}
	let loop = task.Go() {
		let mut d = try start(w, a, view, posted, func(ev ui.Event[E]) {
			fetched.Push(ev) catch {
			case queue.Closed:
			}
		})
		try answerOne(&d, l, parse, summary)
		try serve(&d)
		w.Quit()
		0
	}
	try w.Run()
	w.Closing()
	let _ = try loop.Wait()
	l.Close()
	fetched.End()
	let _ = forward.Wait()
}
