// The look of every node, the layout of the window's tree and its paint
// list. Each paint lays out the kept tree (keep.ergo), which the passes
// changed where their ops changed the window's tree, or, as the
// reference, a tree built anew from the nodes; then it paints the tree in
// tree order, so a later sibling paints over an earlier one and is hit
// first.

import arena
import go ergo.local/prototype/hosts/mygo/screen
import option
import ui
import strings
import ui/layout

// textSize is the font size of every text, in DIPs.
let textSize = float32(16)

// The colors, 0xRRGGBBAA.
let ink = uint32(0x1f2328ff)

let faint = uint32(0x6e7781ff)

let accent = uint32(0x0969daff)

let rule = uint32(0x8c959fff)

// danger is the border of an invalid Input.
let danger = uint32(0xcf222eff)

let track = uint32(0xc6ccd3ff)

let paper = uint32(0xffffffff)

// selection is the fill behind the selected text of a focused Input.
let selection = uint32(0xb6e3ffff)

// mark is the size of a Check's box; switchW and switchH a Toggle's track.
let mark = float32(18)

let switchW = float32(34)

let switchH = float32(20)

// fieldW is an Input's width.
let fieldW = float32(240)

// edges is a ui Edges as the kernel's top, right, bottom, left.
func edges(e ui.Edges) [4]float32 { [4]float32{dips(e.Top), dips(e.Right), dips(e.Bottom), dips(e.Left)} }

// dips is a ui Length as the kernel's float32.
func dips(n ui.Length) float32 { float32(float64(n)) }

func length(s ui.Size) layout.Length {
	match s {
	case ui.Auto:
		layout.Auto
	case ui.Fixed as f:
		layout.Px{Value: dips(f.Value)}
	}
}

func items(a ui.Align) layout.Align {
	match a {
	case ui.AlignStart:
		layout.Start
	case ui.AlignCenter:
		layout.Center
	case ui.AlignEnd:
		layout.End
	case ui.AlignStretch:
		layout.Stretch
	}
}

func justify(j ui.Justify) layout.Justify {
	match j {
	case ui.JustifyStart:
		layout.Start
	case ui.JustifyCenter:
		layout.Center
	case ui.JustifyEnd:
		layout.End
	case ui.JustifyBetween:
		layout.SpaceBetween
	}
}

// boxStyle is a container's layout of a ui Style, in direction dir.
func boxStyle(s ui.Style, dir layout.Direction) layout.Style {
	let mut out = layout.Default()
	out.Direction = dir
	out.Width = length(s.Width)
	out.Height = length(s.Height)
	out.Grow = float32(s.Grow)
	out.Shrink = float32(s.Shrink)
	out.Padding = edges(s.Padding)
	out.Margin = edges(s.Margin)
	out.Gap = dips(s.Gap)
	out.Items = items(s.Align)
	out.Justify = justify(s.Justify)
	out
}

// plainStyle is a node with no Style of its own.
func plainStyle() layout.Style { boxStyle(ui.Plain(), layout.Column) }

func noPadding(p [4]float32) bool { p[0] == 0 && p[1] == 0 && p[2] == 0 && p[3] == 0 }

// styleOf is how a node lays out: its Style, and the room its look needs.
func styleOf[E](n ui.Node[E], line float32) layout.Style {
	match n {
	case ui.BoxNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.ZoneNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.SemanticNode[E] as x:
		boxStyle(x.Style, layout.Column)
	case ui.LiveNode, ui.TransitionNode:
		plainStyle()
	case ui.RowNode as x:
		boxStyle(x.Style, layout.Row)
	case ui.ColumnNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.ScrollNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.AreaNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.LayerNode[E] as x:
		boxStyle(x.Style, layout.Column)
	case ui.TrackNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.FieldsetNode:
		// A Fieldset shows nothing of its own: it stacks its children.
		plainStyle()
	case ui.RowsNode:
		// A list fills the room it is given, and its parent's width; its
		// rows are out of the flow (build places each), so it asks for no
		// room of its own. paint gives a
		// list no taller than 0 the window's room below its top.
		let mut s = plainStyle()
		s.Grow = 1
		s.Self = option.Some{Value: layout.Stretch}
		s
	case ui.CanvasNode as x:
		let mut s = plainStyle()
		s.Width = layout.Px{Value: dips(x.Width)}
		s.Height = layout.Px{Value: dips(x.Height)}
		s.Shrink = 0
		s
	case ui.TextNode as x:
		let mut s = boxStyle(x.Style, layout.Column)
		s.Content = layout.Text{Value: x.Value, Size: textSize}
		s
	case ui.ReadoutNode as x:
		// A readout lays out by its reserve, whatever it reads, so a new
		// reading moves nothing.
		let mut s = boxStyle(x.Style, layout.Column)
		s.Content = layout.Text{Value: x.Reserve, Size: textSize}
		s
	case ui.PressableNode[E] as x:
		let mut s = boxStyle(x.Style, layout.Row)
		if noPadding(s.Padding) {
			s.Padding = [4]float32{6, 12, 6, 12}
		}
		s.Items = layout.Center
		s.Justify = layout.Center
		s
	case ui.CheckNode[E] as x:
		let mut s = plainStyle()
		s.Padding = [4]float32{0, 0, 0, mark + 8}
		s.Content = layout.Text{Value: x.Label, Size: textSize}
		s
	case ui.ToggleNode as x:
		let mut s = plainStyle()
		s.Padding = [4]float32{0, 0, 0, switchW + 10}
		s.Content = layout.Text{Value: x.Label, Size: textSize}
		s
	case ui.InputNode as x:
		// The field is Lines lines high (OpenTUI gap 2); a label above the
		// field and a description under it take a line each.
		let mut s = plainStyle()
		s.Width = layout.Px{Value: fieldW}
		s.Height = layout.Px{Value: float32(x.Lines)*line + 12 + labelRoom(x, line) + describeRoom(x, line)}
		s.Padding = [4]float32{6, 8, 6, 8}
		s
	}
}

// textOf is the text a node shows, which the window measures.
func textOf[E](n ui.Node[E]) string {
	match n {
	case ui.TextNode as x:
		x.Value
	case ui.ReadoutNode as x:
		x.Reserve
	case ui.CheckNode[E] as x:
		x.Label
	case ui.ToggleNode as x:
		x.Label
	case ui.InputNode as x:
		x.Value + "\n" + x.Placeholder + "\n" + x.Label + "\n" + x.Description
	case _:
		""
	}
}

// labelOf is the label a script names a node by, as ui.Find matches it:
// a Pressable's, a Check's, a Toggle's, an Area's, a Canvas's or a
// list's label, a Text's value, an Input's placeholder.
func labelOf[E](n ui.Node[E]) option.Option[string] {
	match n {
	case ui.PressableNode[E] as x:
		option.Some{Value: x.Label}
	case ui.CanvasNode as x:
		option.Some{Value: x.Label}
	case ui.RowsNode as x:
		option.Some{Value: x.Label}
	case ui.CheckNode[E] as x:
		option.Some{Value: x.Label}
	case ui.ToggleNode as x:
		option.Some{Value: x.Label}
	case ui.AreaNode as x:
		option.Some{Value: x.Label}
	case ui.TextNode as x:
		option.Some{Value: x.Value}
	case ui.InputNode as x:
		option.Some{Value: fieldName(x)}
	case _:
		option.None
	}
}

// fieldText draws an Input's value, a line of it per line, under the
// selection the model holds (OpenTUI gap 2) when the field has the focus:
// a fill behind each line's selected part.
func fieldText[S, E, D, F](d mut Driver[S, E, D, F], x ui.InputNode, inner layout.Box, line float32, focus bool) needs go.Foreign {
	let (lo, hi) = ui.Selected(ui.EditingOf(x))
	let mut start = 0
	let mut row = 0
	for l in strings.Split(x.Value, "\n") {
		let y = inner.Y + float32(row)*line
		let end = start + l.Len()
		if focus && lo != hi && lo <= end && hi >= start {
			let a = if lo > start { lo - start } else { 0 }
			let z = if hi < end { hi - start } else { l.Len() }
			let ax = width(d.metrics, l[0:a], textSize)
			let zx = width(d.metrics, l[0:z], textSize)
			fill(d, layout.Box{X: inner.X + ax, Y: y, W: fmax(zx-ax, 2), H: line}, 0, selection)
		}
		d.w.Text(float64(inner.X), float64(y), l, float64(textSize), ink)
		start = end + 1
		row = row + 1
	}
}

// caretAt is where the caret at byte caret of value stands in its field:
// across its line and down by the lines before it.
func caretAt[S, E, D, F](d mut Driver[S, E, D, F], value string, caret int, line float32) (float32, float32) {
	let mut start = 0
	let mut row = 0
	for l in strings.Split(value, "\n") {
		let end = start + l.Len()
		if caret <= end {
			return (width(d.metrics, l[0:caret-start], textSize), float32(row) * line)
		}
		start = end + 1
		row = row + 1
	}
	(0, float32(row) * line)
}

// fieldName is an Input's accessible name: its label, or its placeholder
// when it has none, as ui's locator reads it.
func fieldName(x ui.InputNode) string {
	if x.Label != "" {
		return x.Label
	}
	x.Placeholder
}

// labelRoom is the height an Input's label takes above its field.
func labelRoom(x ui.InputNode, line float32) float32 {
	if x.Label == "" {
		return 0
	}
	line + 4
}

// describeRoom is the height an Input's description takes under its field.
func describeRoom(x ui.InputNode, line float32) float32 {
	if x.Description == "" {
		return 0
	}
	line + 4
}

// paint lays the window's tree out at the window's size and gives the
// window its paint list.
func paint[S, E, D, F](d mut Driver[S, E, D, F]) needs go.Foreign {
	d.trackAt = d.w.Now()
	if d.rebuild {
		learn(&d.metrics, d.w, "", textSize)
		for _, h in d.nodes {
			learn(&d.metrics, d.w, textOf(h.node), textSize)
		}
	}
	let line = lineHeight(d.metrics, textSize)
	if d.rebuild {
		let (t, top, ids) = rebuilt(d, line)
		d.tree = t
		d.top = top
		d.lids = ids
	} else {
		layOutKept(d, line)
		if d.check {
			checkKept(d, line)
		}
	}
	d.w.Begin()
	d.lastSpot = d.spots
	d.lastCanv = d.canvases
	d.lastSem = d.semantics
	d.lastLook = d.looked
	d.lastUnder = d.underlines
	d.lastInks = d.inks
	if d.rebuild {
		// The reference: every node drawn, nothing kept from the last
		// paint.
		drawAll(d, line, Map[ui.Id[E], bool]{}, false)
	} else {
		let soiled = spread(d)
		if d.check {
			// The full paint first, as the reference the damage paint
			// is held to (Differs).
			drawAll(d, line, soiled, false)
			let full = d.spots
			let canvases = d.canvases
			d.w.Hold()
			drawAll(d, line, soiled, true)
			let why = d.w.Differs()
			if d.differ == option.None {
				if why != "" {
					d.differ = option.Some{Value: "the damage paint differs from the full one: \(why) (paint \(d.painted))"}
				} else if !sameSpots(full, d.spots) || !sameSpots(canvases, d.canvases) {
					d.differ = option.Some{Value: "the damage paint's spots differ from the full one's (paint \(d.painted))"}
				}
			}
		} else {
			drawAll(d, line, soiled, true)
		}
	}
	d.soiled = Map[ui.Id[E], bool]{}
	d.shownFoc = ui.SessionFocus(&d.session)
	d.shownHov = ui.SessionHovered(&d.session)
	d.shownAct = d.pressed
	d.w.Present()
	d.painted = d.painted + 1
}

// drawAll draws the window's nodes into the list Begin started, counting
// the nodes drawn anew (Drawn). With again, a node none of soiled
// contains whose box, offset and clip are those of its last draw takes
// that draw again (the damage paint); without, every node is drawn.
func drawAll[S, E, D, F](d mut Driver[S, E, D, F], line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	d.spots = []spot[E]{}
	d.canvases = []spot[E]{}
	d.drawn = 0
	d.looked = []lookProbe{}
	d.underlines = []Probe{}
	d.slants = 0
	d.inks = []InkAt{}
	d.covers = []cover{}
	d.semantics = []ui.Id[E]{}
	d.under = option.Some{Value: paper}
	d.shadowed = false
	let full = layout.Box{X: 0, Y: 0, W: d.width, H: d.height}
	drawKids(d, d.root, 0, 0, full, line, soiled, again)
	paintLayers(d, line, soiled, again)
}

// spread is the nodes whose draw changed since the last paint and all
// their ancestors: each node a pass set, a parent whose children changed,
// a Scroll that moved, and the nodes that took and lost the focus.
func spread[S, E, D, F](d mut Driver[S, E, D, F]) Map[ui.Id[E], bool] needs go.Foreign {
	let mut out = Map[ui.Id[E], bool]{}
	let mut seeds = []ui.Id[E]{}
	for id, _ in d.soiled {
		seeds = seeds.Append(id)
	}
	// A track whose value moved since its last draw moves or fades its
	// body with no op (TRACKS).
	for id, _ in d.tracks {
		match d.nodes.Get(id) {
		case option.Some[held[E]] as h:
			match h.Value.node {
			case ui.TrackNode as x:
				if d.trackShown.Get(id) != (option.Some{Value: trackedNow(d, id, x.Target)}) {
					seeds = seeds.Append(id)
				}
			case _:
			}
		case option.None:
		}
	}
	// The focus, the hover and the pressed node, now and at the last paint:
	// their looks (and their ancestors', LookStateIn) change with no op (UG3).
	for f in []option.Option[ui.Id[E]]{ui.SessionFocus(&d.session), d.shownFoc, ui.SessionHovered(&d.session), d.shownHov, d.pressed, d.shownAct} {
		match f {
		case option.Some[ui.Id[E]] as id:
			seeds = seeds.Append(id.Value)
		case option.None:
		}
	}
	for s in seeds {
		let mut at option.Option[ui.Id[E]] = option.Some{Value: s}
		for {
			match at {
			case option.Some[ui.Id[E]] as id:
				if out.Get(id.Value) != option.None {
					break
				}
				out[id.Value] = true
				at = d.lparent.Get(id.Value)
			case option.None:
				break
			}
		}
	}
	out
}

// sameSpots is whether two paints left the same spots: the same nodes in
// the same order, at the same boxes and clips.
func sameSpots[E](a []spot[E], b []spot[E]) bool {
	if a.Len() != b.Len() {
		return false
	}
	for i in 0..a.Len() {
		if a[i].id != b[i].id || a[i].box != b[i].box || a[i].clip != b[i].clip {
			return false
		}
	}
	true
}

// drawn is what a node's last draw was given (its box, the offsets its
// tracks moved and its Scrolls lifted it by, its clip and the line height) and the spots and
// canvases it added, as ranges of the paint's lists.
type drawn { box layout.Box, dx float32, dy float32, clip layout.Box, line float32, opacity float64, under option.Option[uint32], shadow bool, s0 int, s1 int, c0 int, c1 int, m0 int, m1 int, l0 int, l1 int, u0 int, u1 int, i0 int, i1 int, slants int }

// keyOf is id's key in the window's list (Mark, Again).
func keyOf[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) int {
	match d.keys.Get(id) {
	case option.Some[int] as k:
		k.Value
	case option.None:
		d.keyed = d.keyed + 1
		d.keys[id] = d.keyed
		d.keyed
	}
}

// rootStyle is the window's box: the window's size, the root laid out
// inside the insets (MB4).
func rootStyle[S, E, D, F](d mut Driver[S, E, D, F]) layout.Style {
	let mut rs = plainStyle()
	rs.Width = layout.Px{Value: d.width}
	rs.Height = layout.Px{Value: d.height}
	rs.Padding = [4]float32{float32(float64(d.insets.Top)), float32(float64(d.insets.Right)), float32(float64(d.insets.Bottom)), float32(float64(d.insets.Left))}
	rs
}

// placeAll moves each layer, laid out at its own size, to its place and
// lays the tree out again (UG4); a layer anchored in a layer that moved
// goes again, so this ends after at most one round per layer. It is the
// layout work it took.
func placeAll[S, E, D, F](d mut Driver[S, E, D, F], t mut layout.Tree, top layout.Id, ids Map[ui.Id[E], layout.Id]) int needs layout.Measure {
	let mut work = 0
	for _ in 0..stacked(d).Len()+1 {
		if !placeLayers(d, t, ids) {
			break
		}
		layout.Layout(t, top, d.width, d.height) catch {
		case arena.Stale:
		}
		work = work + layout.Work(*t)
	}
	work
}

// rebuilt is the reference layout: a tree built anew from the window's
// nodes, laid out at the window's size, each list that laid out no taller
// than 0 given the window's room below its top and the tree laid out
// again, then each layer placed; with its window's box and each node's
// box.
func rebuilt[S, E, D, F](d mut Driver[S, E, D, F], line float32) (layout.Tree, layout.Id, Map[ui.Id[E], layout.Id]) {
	let mut t = layout.New()
	let top = layout.Add(&t, rootStyle(d))
	let mut ids = Map[ui.Id[E], layout.Id]{}
	build(d, &t, d.root, top, top, &ids, line)
	with context { layout.Measure: d.metrics } {
		layout.Layout(&t, top, d.width, d.height) catch {
		case arena.Stale:
		}
		let mut changed = false
		for k, h in d.nodes {
			match (ids.Get(k), h.node) {
			case (option.Some[layout.Id] as l, ui.RowsNode as x):
				if giveRoom(&t, l.Value, d.height, dips(x.RowHeight)) != option.None {
					changed = true
				}
			case _:
			}
		}
		if changed {
			layout.Layout(&t, top, d.width, d.height) catch {
			case arena.Stale:
			}
		}
		let _ = placeAll(d, &t, top, ids)
	}
	(t, top, ids)
}

// checkKept builds the reference tree beside the kept one and keeps the
// first box where they differ (Differs), once.
func checkKept[S, E, D, F](d mut Driver[S, E, D, F], line float32) {
	if d.differ != option.None {
		return
	}
	let (t, _, ids) = rebuilt(d, line)
	let mut ref = t
	if ids.Len() != d.lids.Len() {
		d.differ = option.Some{Value: "the kept tree has \(d.lids.Len()) boxes, the reference \(ids.Len()) (paint \(d.painted))"}
		return
	}
	for k, l in ids {
		let want = boxOf(&ref, l)
		match d.lids.Get(k) {
		case option.Some[layout.Id] as kl:
			let got = boxOf(&d.tree, kl.Value)
			if got != want {
				let what = match d.nodes.Get(k) {
				case option.Some[held[E]] as h:
					match labelOf(h.Value.node) {
					case option.Some[string] as s:
						s.Value
					case option.None:
						"a box"
					}
				case option.None:
					"a box"
				}
				d.differ = option.Some{Value: "\(what): kept \(got.X),\(got.Y) \(got.W)x\(got.H), reference \(want.X),\(want.Y) \(want.W)x\(want.H) (paint \(d.painted))"}
				return
			}
		case option.None:
			d.differ = option.Some{Value: "a node has no kept box (paint \(d.painted))"}
			return
		}
	}
}

// build adds id's children under into, in order, and their subtrees, in
// the styles styleIn gives them, and names each one's box in ids. A layer
// goes under the window's box (top) instead, out of the flow (UG4).
func build[S, E, D, F](d mut Driver[S, E, D, F], t mut layout.Tree, id ui.Id[E], into layout.Id, top layout.Id, ids mut Map[ui.Id[E], layout.Id], line float32) {
	let list = listOf(d, id)
	for i, k in kidsOf(d, id) {
		match d.nodes.Get(k) {
		case option.Some[held[E]] as h:
			let n = layout.Add(t, styleIn(list, i, h.Value.node, line))
			layout.Append(t, if isLayer(h.Value.node) { top } else { into }, n) catch {
			case arena.Stale:
			}
			(*ids)[k] = n
			build[S, E, D, F](d, t, k, n, top, ids, line)
		case option.None:
		}
	}
}

// draw paints id, lifted by dy (its Scrolls' offsets), within clip. With
// again, a node none of soiled names (no pass, scroll or focus changed it
// or a node below it) given the box, offset, clip and line height of its
// last draw takes that draw again from the window's last list, with the
// spots, looks, underlines, inks and italic runs it added then: its subtree lays out as it did, so it paints as it
// did. Any other node is drawn anew and counted (Drawn).
func draw[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], dx float32, dy float32, clip layout.Box, line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	let laid = match d.lids.Get(id) {
	case option.Some[layout.Id] as l:
		boxOf(&d.tree, l.Value)
	case option.None:
		return
	}
	let b = layout.Box{X: laid.X - dx, Y: laid.Y - dy, W: laid.W, H: laid.H}
	let key = keyOf(d, id)
	if again && soiled.Get(id) == option.None {
		match d.drew.Get(id) {
		case option.Some[drawn] as p:
			let was = p.Value
			if was.box == b && was.dx == dx && was.dy == dy && was.clip == clip && was.line == line && was.opacity == d.w.Opacity() && was.under == d.under && d.w.Again(key) {
				if was.shadow {
					d.shadowed = true
				}
				let s0 = d.spots.Len()
				let c0 = d.canvases.Len()
				let m0 = d.semantics.Len()
				for i in was.m0..was.m1 {
					d.semantics = d.semantics.Append(d.lastSem[i])
				}
				for i in was.s0..was.s1 {
					d.spots = d.spots.Append(d.lastSpot[i])
				}
				for i in was.c0..was.c1 {
					d.canvases = d.canvases.Append(d.lastCanv[i])
				}
				let l0 = d.looked.Len()
				let u0 = d.underlines.Len()
				let i0 = d.inks.Len()
				for i in was.l0..was.l1 {
					d.looked = d.looked.Append(d.lastLook[i])
				}
				for i in was.u0..was.u1 {
					d.underlines = d.underlines.Append(d.lastUnder[i])
				}
				for i in was.i0..was.i1 {
					d.inks = d.inks.Append(d.lastInks[i])
				}
				d.slants = d.slants + was.slants
				d.drew[id] = drawn{..was, s0: s0, s1: d.spots.Len(), c0: c0, c1: d.canvases.Len(), m0: m0, m1: d.semantics.Len(), l0: l0, l1: d.looked.Len(), u0: u0, u1: d.underlines.Len(), i0: i0, i1: d.inks.Len()}
				return
			}
		case option.None:
		}
	}
	let s0 = d.spots.Len()
	let c0 = d.canvases.Len()
	let m0 = d.semantics.Len()
	let l0 = d.looked.Len()
	let u0 = d.underlines.Len()
	let i0 = d.inks.Len()
	let k0 = d.slants
	// A look's opacity and the colour under it reach the whole subtree
	// (look.ergo), so a kept draw is taken again only under the same
	// ones, and says whether it painted a shadow.
	let opacity = d.w.Opacity()
	let under = d.under
	let shadowed = d.shadowed
	d.shadowed = false
	d.w.Mark(key)
	drawNode(d, id, laid, b, dx, dy, clip, line, soiled, again)
	d.w.Seal(key)
	let shadow = d.shadowed
	d.shadowed = shadowed || shadow
	d.drawn = d.drawn + 1
	if again {
		d.drew[id] = drawn{box: b, dx: dx, dy: dy, clip: clip, line: line, opacity: opacity, under: under, shadow: shadow, s0: s0, s1: d.spots.Len(), c0: c0, c1: d.canvases.Len(), m0: m0, m1: d.semantics.Len(), l0: l0, l1: d.looked.Len(), u0: u0, u1: d.underlines.Len(), i0: i0, i1: d.inks.Len(), slants: d.slants - k0}
	}
}

// drawNode paints id itself at b and draws its children.
func drawNode[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], laid layout.Box, b layout.Box, dx float32, dy float32, clip layout.Box, line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	let n = match d.nodes.Get(id) {
	case option.Some[held[E]] as h:
		h.Value.node
	case option.None:
		return
	}
	d.boxes[id] = b
	let focus = ui.SessionFocus(&d.session) == (option.Some{Value: id})
	let s = spot[E]{id: id, node: n, box: b, clip: clip}
	let look = paintLook(d, id, n, b, clip, line, focus)
	match n {
	case ui.BoxNode, ui.RowNode, ui.ColumnNode, ui.FieldsetNode, ui.ZoneNode, ui.LiveNode, ui.TransitionNode, ui.LayerNode:
		drawKids(d, id, dx, dy, clip, line, soiled, again)
	case ui.SemanticNode[E]:
		// A Semantic a press sends from (a radio, an option, a link) takes
		// the pointer and the focus, and shows the focus ring (UC-TAB).
		if focusable(n) {
			d.spots = d.spots.Append(s)
			if focus {
				ring(d, b, 6)
			}
		}
		semantic(d, id, n, b, focus)
		drawKids(d, id, dx, dy, clip, line, soiled, again)
	case ui.TrackNode as x:
		// The host runs the track (TRACKS): its body moves by the value the
		// track has now, or fades by it. spread draws a track anew when its
		// value moved since its last draw (trackShown).
		let tv = trackedNow(d, id, x.Target)
		d.trackShown[id] = tv
		let v = float32(tv)
		match x.Prop {
		case ui.TrackX:
			drawKids(d, id, dx-v, dy, clip, line, soiled, again)
		case ui.TrackY:
			drawKids(d, id, dx, dy-v, clip, line, soiled, again)
		case ui.TrackOpacity:
			let o = d.w.Opacity()
			d.w.SetOpacity(o * float64(v))
			drawKids(d, id, dx, dy, clip, line, soiled, again)
			d.w.SetOpacity(o)
		}
	case ui.ScrollNode:
		d.spots = d.spots.Append(s)
		let mut reach = float32(0)
		for k in kidsOf(d, id) {
			match d.lids.Get(k) {
			case option.Some[layout.Id] as l:
				let kb = boxOf(&d.tree, l.Value)
				reach = fmax(reach, kb.Y+kb.H-laid.Y)
			case option.None:
			}
		}
		d.extents[id] = reach
		let inner = cut(clip, b)
		d.w.Clip(float64(inner.X), float64(inner.Y), float64(inner.W), float64(inner.H))
		drawKids(d, id, dx, dy+scrolledBy(d, id), inner, line, soiled, again)
		d.w.Unclip()
	case ui.RowsNode as x:
		// A list scrolls its rows as a Scroll does, over Count rows of
		// content; a scroll past the end (the list grew shorter) comes back.
		d.spots = d.spots.Append(s)
		let content = float32(x.Count) * dips(x.RowHeight)
		d.extents[id] = content
		let most = fmax(content-b.H, 0)
		if scrolledBy(d, id) > most {
			d.scrolled[id] = most
		}
		access(d, id, screen.RoleGroup, x.Label, "", b, false, false)
		let inner = cut(clip, b)
		d.w.Clip(float64(inner.X), float64(inner.Y), float64(inner.W), float64(inner.H))
		drawKids(d, id, dx, dy+scrolledBy(d, id), inner, line, soiled, again)
		d.w.Unclip()
	case ui.CanvasNode as x:
		d.canvases = d.canvases.Append(s)
		paintCanvas(d, x.Paint, b, clip)
	case ui.AreaNode as x:
		d.spots = d.spots.Append(s)
		access(d, id, screen.RoleGroup, x.Label, "", b, false, false)
		drawKids(d, id, dx, dy, clip, line, soiled, again)
	case ui.TextNode as x:
		access(d, id, screen.RoleText, x.Value, "", b, false, false)
		let st = styleOf(n, line)
		let k = lookOf(d, id, n).Ink
		d.inks = d.inks.Append(InkAt{Label: x.Value, Ink: k})
		inkedLines(d, x.Value, b.X+st.Padding[3], b.Y+st.Padding[0], b.W-st.Padding[1]-st.Padding[3], k, clip)
	case ui.ReadoutNode as x:
		// What the readout reads now, on one line, clipped to the
		// reserve's box.
		let reading = match ui.ReadingIn(&d.session, x.Readout) {
		case option.Some[string] as r:
			r.Value
		case option.None:
			x.Reserve
		}
		access(d, id, screen.RoleText, reading, "", b, false, false)
		let st = styleOf(n, line)
		let inner = cut(clip, b)
		d.w.Clip(float64(inner.X), float64(inner.Y), float64(inner.W), float64(inner.H))
		let k = lookOf(d, id, n).Ink
		d.inks = d.inks.Append(InkAt{Label: reading, Ink: k})
		inkedRun(d, reading, b.X+st.Padding[3], b.Y+st.Padding[0], k, inner)
		d.w.Unclip()
	case ui.PressableNode[E] as x:
		d.spots = d.spots.Append(s)
		if focus {
			ring(d, b, float32(float64(lookOf(d, id, n).Corners.TopLeft)))
		}
		access(d, id, screen.RoleButton, x.Label, "", b, false, focus)
		drawKids(d, id, dx, dy, clip, line, soiled, again)
	case ui.CheckNode[E] as x:
		d.spots = d.spots.Append(s)
		let at = layout.Box{X: b.X, Y: b.Y + (b.H-mark)/2, W: mark, H: mark}
		if x.Checked {
			fill(d, at, 3, accent)
		} else {
			fill(d, at, 3, paper)
			d.w.Border(float64(at.X), float64(at.Y), float64(at.W), float64(at.H), 3, 1.5, rule)
		}
		if focus {
			ring(d, at, 3)
		}
		access(d, id, screen.RoleCheck, x.Label, "", b, x.Checked, focus)
		lines(d, x.Label, b.X+mark+8, b.Y, b.W-mark-8, ink)
	case ui.ToggleNode as x:
		d.spots = d.spots.Append(s)
		let at = layout.Box{X: b.X, Y: b.Y + (b.H-switchH)/2, W: switchW, H: switchH}
		fill(d, at, switchH/2, if x.On { accent } else { track })
		let knob = switchH - 4
		let kx = if x.On { at.X + switchW - knob - 2 } else { at.X + 2 }
		fill(d, layout.Box{X: kx, Y: at.Y + 2, W: knob, H: knob}, knob/2, paper)
		if focus {
			ring(d, at, switchH/2)
		}
		access(d, id, screen.RoleSwitch, x.Label, "", b, x.On, focus)
		lines(d, x.Label, b.X+switchW+10, b.Y, b.W-switchW-10, ink)
	case ui.InputNode as x:
		d.spots = d.spots.Append(s)
		let top = labelRoom(x, line)
		if x.Label != "" {
			d.w.Text(float64(b.X), float64(b.Y), x.Label, float64(textSize), ink)
		}
		if x.Description != "" {
			d.w.Text(float64(b.X), float64(b.Y+b.H-line), x.Description, float64(textSize), if x.Invalid { danger } else { faint })
		}
		let fb = layout.Box{X: b.X, Y: b.Y + top, W: b.W, H: b.H - top - describeRoom(x, line)}
		fill(d, fb, 4, paper)
		if focus {
			d.w.Border(float64(fb.X), float64(fb.Y), float64(fb.W), float64(fb.H), 4, 2, if x.Invalid { danger } else { accent })
		} else {
			d.w.Border(float64(fb.X), float64(fb.Y), float64(fb.W), float64(fb.H), 4, if x.Invalid { 2 } else { 1 }, if x.Invalid { danger } else { rule })
		}
		let inner = layout.Box{X: fb.X + 8, Y: fb.Y + 6, W: fb.W - 16, H: fb.H - 12}
		d.w.Clip(float64(inner.X), float64(inner.Y), float64(inner.W), float64(inner.H))
		if x.Value == "" {
			d.w.Text(float64(inner.X), float64(inner.Y), x.Placeholder, float64(textSize), faint)
		} else {
			fieldText(d, x, inner, line, focus)
		}
		d.w.Unclip()
		access(d, id, screen.RoleField, fieldName(x), x.Value, b, false, focus)
		if focus {
			// The caret the model holds (OpenTUI gap 2), on its line.
			let (cx, cy) = caretAt(d, x.Value, x.Caret, line)
			let caret = fmin(cx, inner.W)
			d.w.Editing(x.Value, ui.KeyboardName(x.Hints.Keyboard), d.edited, float64(inner.X+caret), float64(inner.Y+cy), 1, float64(line))
			fill(d, layout.Box{X: inner.X + caret, Y: inner.Y + cy, W: 1, H: line}, 0, ink)
		}
	}
	unpaint(d, look)
}

// drawKids paints id's children in order, but its layers, which
// paintLayers paints over the flow (UG4).
func drawKids[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], dx float32, dy float32, clip layout.Box, line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	for k in kidsOf(d, id) {
		match layerNode(d, k) {
		case option.Some[ui.LayerNode[E]]:
		case option.None:
			draw(d, k, dx, dy, clip, line, soiled, again)
		}
	}
}

// lines paints text broken as Metrics breaks it at width, from x, y.
func lines[S, E, D, F](d mut Driver[S, E, D, F], text string, x float32, y float32, wide float32, color uint32) needs go.Foreign {
	let step = lineHeight(d.metrics, textSize)
	for i, l in Lines(d.metrics, text, textSize, wide) {
		d.w.Text(float64(x), float64(y+float32(i)*step), l, float64(textSize), color)
	}
}

// inkedLines draws a Text's lines in its look's ink (OpenTUI gap 1), one
// inkedRun a line.
func inkedLines[S, E, D, F](d mut Driver[S, E, D, F], text string, x float32, y float32, wide float32, k ui.Ink, clip layout.Box) needs go.Foreign {
	let step = lineHeight(d.metrics, textSize)
	for i, l in Lines(d.metrics, text, textSize, wide) {
		inkedRun(d, l, x, y+float32(i)*step, k, clip)
	}
}

// inkedRun draws one line of text in ink k: in its colour, or the
// window's ink when transparent; bold as the run drawn twice, a dip apart
// (the window has one face); italic as that face sheared (TextSlanted,
// a synthetic oblique), counted in slants so a test reads that the window
// slanted each italic run; underlined as a fill of a dip under the run,
// on a whole pixel row. An opaque underline inside clip is a probe
// (Probes), so a test reads the ink's colour off the window.
func inkedRun[S, E, D, F](d mut Driver[S, E, D, F], l string, x float32, at float32, k ui.Ink, clip layout.Box) needs go.Foreign {
	let color = if k.Color.A != 0 { rgba(k.Color) } else { ink }
	let opaque = (k.Color.A == 0 || k.Color.A == 255) && d.w.Opacity() == 1.0
	let step = lineHeight(d.metrics, textSize)
	let passes = if k.Bold { 2 } else { 1 }
	for p in 0..passes {
		let px = float64(x + float32(p))
		if k.Italic {
			d.w.TextSlanted(px, float64(at), l, float64(textSize), color)
		} else {
			d.w.Text(px, float64(at), l, float64(textSize), color)
		}
	}
	if k.Italic {
		d.slants = d.slants + passes
	}
	if k.Underline {
		let under = layout.Box{X: fceil(x), Y: fceil(at + step - 3), W: float32(int(float32(d.w.TextWidth(l, float64(textSize))))), H: 1}
		fill(d, under, 0, color)
		let px = int(under.X) + 1
		let py = int(under.Y)
		if opaque && under.W >= 3 && probeShows(clip, px, py) {
			// The probe's colour is the look's, read apart from what was
			// drawn, as lookProbes reads a fill's.
			d.underlines = d.underlines.Append(Probe{Label: l + " underline", X: px, Y: py, Color: inkColor(k)})
		}
	}
}

// inkColor is the colour a look's ink draws in: its own, or the window's
// ink when transparent.
func inkColor(k ui.Ink) uint32 {
	if k.Color.A != 0 {
		return rgba(k.Color)
	}
	ink
}

func fill[S, E, D, F](d mut Driver[S, E, D, F], b layout.Box, radius float32, color uint32) needs go.Foreign {
	d.w.Fill(float64(b.X), float64(b.Y), float64(b.W), float64(b.H), float64(radius), color)
}

// ring is the focus ring around b.
func ring[S, E, D, F](d mut Driver[S, E, D, F], b layout.Box, radius float32) needs go.Foreign {
	d.w.Border(float64(b.X-3), float64(b.Y-3), float64(b.W+6), float64(b.H+6), float64(radius+3), 2, accent)
}

// cut is the part of b inside clip.
func cut(clip layout.Box, b layout.Box) layout.Box {
	let x = fmax(clip.X, b.X)
	let y = fmax(clip.Y, b.Y)
	let r = fmin(clip.X+clip.W, b.X+b.W)
	let bottom = fmin(clip.Y+clip.H, b.Y+b.H)
	layout.Box{X: x, Y: y, W: fmax(r-x, 0), H: fmax(bottom-y, 0)}
}

// access adds a node of the window's accessibility tree, named by an
// id that stays the node's while it shows.
func access[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], role int, label string, value string, b layout.Box, checked bool, focus bool) needs go.Foreign {
	d.w.Access(nameOf(d, id), -1, role, label, value, float64(b.X), float64(b.Y), float64(b.W), float64(b.H), checked, focus)
}

// nameOf is id's node's id in the accessibility tree, given the first
// time it is asked for.
func nameOf[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) int {
	match d.names.Get(id) {
	case option.Some[int] as n:
		n.Value
	case option.None:
		let n = nextName(d)
		d.names[id] = n
		n
	}
}

// nextName is a name no node has had.
func nextName[S, E, D, F](d mut Driver[S, E, D, F]) int {
	d.named = d.named + 1
	d.named
}

// contentHeight is how far the children of a Scroll reach below its top.
func contentHeight[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) float32 {
	match d.extents.Get(id) {
	case option.Some[float32] as h:
		h.Value
	case option.None:
		0
	}
}
