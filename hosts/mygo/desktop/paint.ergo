// The look of every node, the layout of the window's tree and its paint
// list. Each paint lays out the kept tree (keep.ergo), which the passes
// changed where their ops changed the window's tree, or, as the
// reference, a tree built anew from the nodes; then it paints the tree in
// tree order, so a later sibling paints over an earlier one and is hit
// first.

import arena
import go ergo.local/prototype/hosts/mygo/screen
import ui
import ui/layout

// textSize is the font size of every text, in DIPs.
let textSize = float32(16)

// The colors, 0xRRGGBBAA.
let ink = uint32(0x1f2328ff)

let faint = uint32(0x6e7781ff)

let accent = uint32(0x0969daff)

let rule = uint32(0x8c959fff)

// danger is the border of an invalid Input.
let danger = uint32(0xcf222eff)

let track = uint32(0xc6ccd3ff)

let paper = uint32(0xffffffff)

// mark is the size of a Check's box; switchW and switchH a Toggle's track.
let mark = float32(18)

let switchW = float32(34)

let switchH = float32(20)

// fieldW is an Input's width.
let fieldW = float32(240)

// edges is a ui Edges as the kernel's top, right, bottom, left.
func edges(e ui.Edges) [4]float32 { [4]float32{dips(e.Top), dips(e.Right), dips(e.Bottom), dips(e.Left)} }

// dips is a ui Length as the kernel's float32.
func dips(n ui.Length) float32 { float32(float64(n)) }

func length(s ui.Size) layout.Length {
	match s {
	case ui.Auto:
		layout.Auto
	case ui.Fixed as f:
		layout.Px{Value: dips(f.Value)}
	}
}

func items(a ui.Align) layout.Align {
	match a {
	case ui.AlignStart:
		layout.Start
	case ui.AlignCenter:
		layout.Center
	case ui.AlignEnd:
		layout.End
	case ui.AlignStretch:
		layout.Stretch
	}
}

func justify(j ui.Justify) layout.Justify {
	match j {
	case ui.JustifyStart:
		layout.Start
	case ui.JustifyCenter:
		layout.Center
	case ui.JustifyEnd:
		layout.End
	case ui.JustifyBetween:
		layout.SpaceBetween
	}
}

// boxStyle is a container's layout of a ui Style, in direction dir.
func boxStyle(s ui.Style, dir layout.Direction) layout.Style {
	let mut out = layout.Default()
	out.Direction = dir
	out.Width = length(s.Width)
	out.Height = length(s.Height)
	out.Grow = float32(s.Grow)
	out.Shrink = float32(s.Shrink)
	out.Padding = edges(s.Padding)
	out.Margin = edges(s.Margin)
	out.Gap = dips(s.Gap)
	out.Items = items(s.Align)
	out.Justify = justify(s.Justify)
	out
}

// plainStyle is a node with no Style of its own.
func plainStyle() layout.Style { boxStyle(ui.Plain(), layout.Column) }

func noPadding(p [4]float32) bool { p[0] == 0 && p[1] == 0 && p[2] == 0 && p[3] == 0 }

// styleOf is how a node lays out: its Style, and the room its look needs.
func styleOf[E](n ui.Node[E], line float32) layout.Style {
	match n {
	case ui.BoxNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.ZoneNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.SemanticNode[E] as x:
		boxStyle(x.Style, layout.Column)
	case ui.LiveNode, ui.TransitionNode:
		plainStyle()
	case ui.RowNode as x:
		boxStyle(x.Style, layout.Row)
	case ui.ColumnNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.ScrollNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.AreaNode as x:
		boxStyle(x.Style, layout.Column)
	case ui.FieldsetNode:
		// A Fieldset shows nothing of its own: it stacks its children.
		plainStyle()
	case ui.RowsNode:
		// A list fills the room it is given, and its parent's width; its
		// rows are out of the flow (build places each), so it asks for no
		// room of its own. paint gives a
		// list no taller than 0 the window's room below its top.
		let mut s = plainStyle()
		s.Grow = 1
		s.Self = Some{Value: layout.Stretch}
		s
	case ui.CanvasNode as x:
		let mut s = plainStyle()
		s.Width = layout.Px{Value: dips(x.Width)}
		s.Height = layout.Px{Value: dips(x.Height)}
		s.Shrink = 0
		s
	case ui.TextNode as x:
		let mut s = boxStyle(x.Style, layout.Column)
		s.Content = layout.Text{Value: x.Value, Size: textSize}
		s
	case ui.PressableNode[E] as x:
		let mut s = boxStyle(x.Style, layout.Row)
		if noPadding(s.Padding) {
			s.Padding = [4]float32{6, 12, 6, 12}
		}
		s.Items = layout.Center
		s.Justify = layout.Center
		s
	case ui.CheckNode[E] as x:
		let mut s = plainStyle()
		s.Padding = [4]float32{0, 0, 0, mark + 8}
		s.Content = layout.Text{Value: x.Label, Size: textSize}
		s
	case ui.ToggleNode as x:
		let mut s = plainStyle()
		s.Padding = [4]float32{0, 0, 0, switchW + 10}
		s.Content = layout.Text{Value: x.Label, Size: textSize}
		s
	case ui.InputNode as x:
		// A label above the field and a description under it take a line
		// each.
		let mut s = plainStyle()
		s.Width = layout.Px{Value: fieldW}
		s.Height = layout.Px{Value: line + 12 + labelRoom(x, line) + describeRoom(x, line)}
		s.Padding = [4]float32{6, 8, 6, 8}
		s
	}
}

// textOf is the text a node shows, which the window measures.
func textOf[E](n ui.Node[E]) string {
	match n {
	case ui.TextNode as x:
		x.Value
	case ui.CheckNode[E] as x:
		x.Label
	case ui.ToggleNode as x:
		x.Label
	case ui.InputNode as x:
		x.Value + "\n" + x.Placeholder + "\n" + x.Label + "\n" + x.Description
	case _:
		""
	}
}

// labelOf is the label a script names a node by, as ui.Find matches it:
// a Pressable's, a Check's, a Toggle's, an Area's, a Canvas's or a
// list's label, a Text's value, an Input's placeholder.
func labelOf[E](n ui.Node[E]) Option[string] {
	match n {
	case ui.PressableNode[E] as x:
		Some{Value: x.Label}
	case ui.CanvasNode as x:
		Some{Value: x.Label}
	case ui.RowsNode as x:
		Some{Value: x.Label}
	case ui.CheckNode[E] as x:
		Some{Value: x.Label}
	case ui.ToggleNode as x:
		Some{Value: x.Label}
	case ui.AreaNode as x:
		Some{Value: x.Label}
	case ui.TextNode as x:
		Some{Value: x.Value}
	case ui.InputNode as x:
		Some{Value: fieldName(x)}
	case _:
		None
	}
}

// fieldName is an Input's accessible name: its label, or its placeholder
// when it has none, as ui's locator reads it.
func fieldName(x ui.InputNode) string {
	if x.Label != "" {
		return x.Label
	}
	x.Placeholder
}

// labelRoom is the height an Input's label takes above its field.
func labelRoom(x ui.InputNode, line float32) float32 {
	if x.Label == "" {
		return 0
	}
	line + 4
}

// describeRoom is the height an Input's description takes under its field.
func describeRoom(x ui.InputNode, line float32) float32 {
	if x.Description == "" {
		return 0
	}
	line + 4
}

// paint lays the window's tree out at the window's size and gives the
// window its paint list.
func paint[S, E, D, F](d mut Driver[S, E, D, F]) needs go.Foreign {
	if d.rebuild {
		learn(&d.metrics, d.w, "", textSize)
		for _, h in d.nodes {
			learn(&d.metrics, d.w, textOf(h.node), textSize)
		}
	}
	let line = lineHeight(d.metrics, textSize)
	if d.rebuild {
		let (t, top, ids) = rebuilt(d, line)
		d.tree = t
		d.top = top
		d.lids = ids
	} else {
		layOutKept(d)
		if d.check {
			checkKept(d, line)
		}
	}
	d.w.Begin()
	d.lastSpot = d.spots
	d.lastCanv = d.canvases
	d.lastSem = d.semantics
	if d.rebuild {
		// The reference: every node drawn, nothing kept from the last
		// paint.
		drawAll(d, line, Map[ui.Id[E], bool]{}, false)
	} else {
		let soiled = spread(d)
		if d.check {
			// The full paint first, as the reference the damage paint
			// is held to (Differs).
			drawAll(d, line, soiled, false)
			let full = d.spots
			let canvases = d.canvases
			d.w.Hold()
			drawAll(d, line, soiled, true)
			let why = d.w.Differs()
			if d.differ == None {
				if why != "" {
					d.differ = Some{Value: "the damage paint differs from the full one: \(why) (paint \(d.painted))"}
				} else if !sameSpots(full, d.spots) || !sameSpots(canvases, d.canvases) {
					d.differ = Some{Value: "the damage paint's spots differ from the full one's (paint \(d.painted))"}
				}
			}
		} else {
			drawAll(d, line, soiled, true)
		}
	}
	d.soiled = Map[ui.Id[E], bool]{}
	d.shownFoc = ui.SessionFocus(&d.session)
	d.shownHov = ui.SessionHovered(&d.session)
	d.shownAct = d.pressed
	d.w.Present()
	d.painted = d.painted + 1
}

// drawAll draws the window's nodes into the list Begin started, counting
// the nodes drawn anew (Drawn). With again, a node none of soiled
// contains whose box, offset and clip are those of its last draw takes
// that draw again (the damage paint); without, every node is drawn.
func drawAll[S, E, D, F](d mut Driver[S, E, D, F], line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	d.spots = []spot[E]{}
	d.canvases = []spot[E]{}
	d.drawn = 0
	d.looked = []lookProbe{}
	d.semantics = []ui.Id[E]{}
	d.under = Some{Value: paper}
	d.shadowed = false
	let full = layout.Box{X: 0, Y: 0, W: d.width, H: d.height}
	for k in kidsOf(d, d.root) {
		draw(d, k, 0, full, line, soiled, again)
	}
}

// spread is the nodes whose draw changed since the last paint and all
// their ancestors: each node a pass set, a parent whose children changed,
// a Scroll that moved, and the nodes that took and lost the focus.
func spread[S, E, D, F](d mut Driver[S, E, D, F]) Map[ui.Id[E], bool] {
	let mut out = Map[ui.Id[E], bool]{}
	let mut seeds = []ui.Id[E]{}
	for id, _ in d.soiled {
		seeds = seeds.Append(id)
	}
	// The focus, the hover and the pressed node, now and at the last paint:
	// their looks (and their ancestors', LookStateIn) change with no op (UG3).
	for f in []Option[ui.Id[E]]{ui.SessionFocus(&d.session), d.shownFoc, ui.SessionHovered(&d.session), d.shownHov, d.pressed, d.shownAct} {
		match f {
		case Some[ui.Id[E]] as id:
			seeds = seeds.Append(id.Value)
		case None:
		}
	}
	for s in seeds {
		let mut at Option[ui.Id[E]] = Some{Value: s}
		for {
			match at {
			case Some[ui.Id[E]] as id:
				if out.Get(id.Value) != None {
					break
				}
				out[id.Value] = true
				at = d.lparent.Get(id.Value)
			case None:
				break
			}
		}
	}
	out
}

// sameSpots is whether two paints left the same spots: the same nodes in
// the same order, at the same boxes and clips.
func sameSpots[E](a []spot[E], b []spot[E]) bool {
	if len(a) != len(b) {
		return false
	}
	for i in 0..len(a) {
		if a[i].id != b[i].id || a[i].box != b[i].box || a[i].clip != b[i].clip {
			return false
		}
	}
	true
}

// drawn is what a node's last draw was given (its box, the offset its
// Scrolls lifted it by, its clip and the line height) and the spots and
// canvases it added, as ranges of the paint's lists.
type drawn { box layout.Box, dy float32, clip layout.Box, line float32, opacity float64, under Option[uint32], shadow bool, s0 int, s1 int, c0 int, c1 int, m0 int, m1 int }

// keyOf is id's key in the window's list (Mark, Again).
func keyOf[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) int {
	match d.keys.Get(id) {
	case Some[int] as k:
		k.Value
	case None:
		d.keyed = d.keyed + 1
		d.keys[id] = d.keyed
		d.keyed
	}
}

// rebuilt is the reference layout: a tree built anew from the window's
// nodes, laid out at the window's size, each list that laid out no taller
// than 0 given the window's room below its top and the tree laid out
// again; with its window's box and each node's box.
func rebuilt[S, E, D, F](d mut Driver[S, E, D, F], line float32) (layout.Tree, layout.Id, Map[ui.Id[E], layout.Id]) {
	let mut t = layout.New()
	let mut rs = plainStyle()
	rs.Width = layout.Px{Value: d.width}
	rs.Height = layout.Px{Value: d.height}
	let top = layout.Add(&t, rs)
	let mut ids = Map[ui.Id[E], layout.Id]{}
	build(d, &t, d.root, top, &ids, line)
	with context { layout.Measure: d.metrics } {
		layout.Layout(&t, top, d.width, d.height) catch {
		case arena.Stale:
		}
		let mut changed = false
		for k, h in d.nodes {
			match (ids.Get(k), h.node) {
			case (Some[layout.Id] as l, ui.RowsNode as x):
				if giveRoom(&t, l.Value, d.height, dips(x.RowHeight)) != None {
					changed = true
				}
			case _:
			}
		}
		if changed {
			layout.Layout(&t, top, d.width, d.height) catch {
			case arena.Stale:
			}
		}
	}
	(t, top, ids)
}

// checkKept builds the reference tree beside the kept one and keeps the
// first box where they differ (Differs), once.
func checkKept[S, E, D, F](d mut Driver[S, E, D, F], line float32) {
	if d.differ != None {
		return
	}
	let (t, _, ids) = rebuilt(d, line)
	let mut ref = t
	if len(ids) != len(d.lids) {
		d.differ = Some{Value: "the kept tree has \(len(d.lids)) boxes, the reference \(len(ids)) (paint \(d.painted))"}
		return
	}
	for k, l in ids {
		let want = boxOf(&ref, l)
		match d.lids.Get(k) {
		case Some[layout.Id] as kl:
			let got = boxOf(&d.tree, kl.Value)
			if got != want {
				let what = match d.nodes.Get(k) {
				case Some[held[E]] as h:
					match labelOf(h.Value.node) {
					case Some[string] as s:
						s.Value
					case None:
						"a box"
					}
				case None:
					"a box"
				}
				d.differ = Some{Value: "\(what): kept \(got.X),\(got.Y) \(got.W)x\(got.H), reference \(want.X),\(want.Y) \(want.W)x\(want.H) (paint \(d.painted))"}
				return
			}
		case None:
			d.differ = Some{Value: "a node has no kept box (paint \(d.painted))"}
			return
		}
	}
}

// build adds id's children under into, in order, and their subtrees, in
// the styles styleIn gives them, and names each one's box in ids.
func build[S, E, D, F](d mut Driver[S, E, D, F], t mut layout.Tree, id ui.Id[E], into layout.Id, ids mut Map[ui.Id[E], layout.Id], line float32) {
	let list = listOf(d, id)
	for i, k in kidsOf(d, id) {
		match d.nodes.Get(k) {
		case Some[held[E]] as h:
			let n = layout.Add(t, styleIn(list, i, h.Value.node, line))
			layout.Append(t, into, n) catch {
			case arena.Stale:
			}
			(*ids)[k] = n
			build[S, E, D, F](d, t, k, n, ids, line)
		case None:
		}
	}
}

// draw paints id, lifted by dy (its Scrolls' offsets), within clip. With
// again, a node none of soiled names (no pass, scroll or focus changed it
// or a node below it) given the box, offset, clip and line height of its
// last draw takes that draw again from the window's last list, with the
// spots it added then: its subtree lays out as it did, so it paints as it
// did. Any other node is drawn anew and counted (Drawn).
func draw[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], dy float32, clip layout.Box, line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	let laid = match d.lids.Get(id) {
	case Some[layout.Id] as l:
		boxOf(&d.tree, l.Value)
	case None:
		return
	}
	let b = layout.Box{X: laid.X, Y: laid.Y - dy, W: laid.W, H: laid.H}
	let key = keyOf(d, id)
	if again && soiled.Get(id) == None {
		match d.drew.Get(id) {
		case Some[drawn] as p:
			let was = p.Value
			if was.box == b && was.dy == dy && was.clip == clip && was.line == line && was.opacity == d.w.Opacity() && was.under == d.under && d.w.Again(key) {
				if was.shadow {
					d.shadowed = true
				}
				let s0 = len(d.spots)
				let c0 = len(d.canvases)
				let m0 = len(d.semantics)
				for i in was.m0..was.m1 {
					d.semantics = d.semantics.Append(d.lastSem[i])
				}
				for i in was.s0..was.s1 {
					d.spots = d.spots.Append(d.lastSpot[i])
				}
				for i in was.c0..was.c1 {
					d.canvases = d.canvases.Append(d.lastCanv[i])
				}
				d.drew[id] = drawn{..was, s0: s0, s1: len(d.spots), c0: c0, c1: len(d.canvases), m0: m0, m1: len(d.semantics)}
				return
			}
		case None:
		}
	}
	let s0 = len(d.spots)
	let c0 = len(d.canvases)
	let m0 = len(d.semantics)
	// A look's opacity and the colour under it reach the whole subtree
	// (look.ergo), so a kept draw is taken again only under the same
	// ones, and says whether it painted a shadow.
	let opacity = d.w.Opacity()
	let under = d.under
	let shadowed = d.shadowed
	d.shadowed = false
	d.w.Mark(key)
	drawNode(d, id, laid, b, dy, clip, line, soiled, again)
	d.w.Seal(key)
	let shadow = d.shadowed
	d.shadowed = shadowed || shadow
	d.drawn = d.drawn + 1
	if again {
		d.drew[id] = drawn{box: b, dy: dy, clip: clip, line: line, opacity: opacity, under: under, shadow: shadow, s0: s0, s1: len(d.spots), c0: c0, c1: len(d.canvases), m0: m0, m1: len(d.semantics)}
	}
}

// drawNode paints id itself at b and draws its children.
func drawNode[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], laid layout.Box, b layout.Box, dy float32, clip layout.Box, line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	let n = match d.nodes.Get(id) {
	case Some[held[E]] as h:
		h.Value.node
	case None:
		return
	}
	d.boxes[id] = b
	let focus = ui.SessionFocus(&d.session) == (Some{Value: id})
	let s = spot[E]{id: id, node: n, box: b, clip: clip}
	let look = paintLook(d, id, n, b, clip, line, focus)
	match n {
	case ui.BoxNode, ui.RowNode, ui.ColumnNode, ui.FieldsetNode, ui.ZoneNode, ui.LiveNode, ui.TransitionNode:
		drawKids(d, id, dy, clip, line, soiled, again)
	case ui.SemanticNode[E]:
		// A Semantic a press sends from (a radio, an option, a link) takes
		// the pointer and the focus, and shows the focus ring (UC-TAB).
		if focusable(n) {
			d.spots = d.spots.Append(s)
			if focus {
				ring(d, b, 6)
			}
		}
		semantic(d, id, n, b, focus)
		drawKids(d, id, dy, clip, line, soiled, again)
	case ui.ScrollNode:
		d.spots = d.spots.Append(s)
		let mut reach = float32(0)
		for k in kidsOf(d, id) {
			match d.lids.Get(k) {
			case Some[layout.Id] as l:
				let kb = boxOf(&d.tree, l.Value)
				reach = fmax(reach, kb.Y+kb.H-laid.Y)
			case None:
			}
		}
		d.extents[id] = reach
		let inner = cut(clip, b)
		d.w.Clip(float64(inner.X), float64(inner.Y), float64(inner.W), float64(inner.H))
		drawKids(d, id, dy+scrolledBy(d, id), inner, line, soiled, again)
		d.w.Unclip()
	case ui.RowsNode as x:
		// A list scrolls its rows as a Scroll does, over Count rows of
		// content; a scroll past the end (the list grew shorter) comes back.
		d.spots = d.spots.Append(s)
		let content = float32(x.Count) * dips(x.RowHeight)
		d.extents[id] = content
		let most = fmax(content-b.H, 0)
		if scrolledBy(d, id) > most {
			d.scrolled[id] = most
		}
		access(d, id, screen.RoleGroup, x.Label, "", b, false, false)
		let inner = cut(clip, b)
		d.w.Clip(float64(inner.X), float64(inner.Y), float64(inner.W), float64(inner.H))
		drawKids(d, id, dy+scrolledBy(d, id), inner, line, soiled, again)
		d.w.Unclip()
	case ui.CanvasNode as x:
		d.canvases = d.canvases.Append(s)
		paintCanvas(d, x.Paint, b, clip)
	case ui.AreaNode as x:
		d.spots = d.spots.Append(s)
		access(d, id, screen.RoleGroup, x.Label, "", b, false, false)
		drawKids(d, id, dy, clip, line, soiled, again)
	case ui.TextNode as x:
		access(d, id, screen.RoleText, x.Value, "", b, false, false)
		let st = styleOf(n, line)
		lines(d, x.Value, b.X+st.Padding[3], b.Y+st.Padding[0], b.W-st.Padding[1]-st.Padding[3], ink)
	case ui.PressableNode[E] as x:
		d.spots = d.spots.Append(s)
		if focus {
			ring(d, b, float32(float64(lookOf(d, id, n).Corners.TopLeft)))
		}
		access(d, id, screen.RoleButton, x.Label, "", b, false, focus)
		drawKids(d, id, dy, clip, line, soiled, again)
	case ui.CheckNode[E] as x:
		d.spots = d.spots.Append(s)
		let at = layout.Box{X: b.X, Y: b.Y + (b.H-mark)/2, W: mark, H: mark}
		if x.Checked {
			fill(d, at, 3, accent)
		} else {
			fill(d, at, 3, paper)
			d.w.Border(float64(at.X), float64(at.Y), float64(at.W), float64(at.H), 3, 1.5, rule)
		}
		if focus {
			ring(d, at, 3)
		}
		access(d, id, screen.RoleCheck, x.Label, "", b, x.Checked, focus)
		lines(d, x.Label, b.X+mark+8, b.Y, b.W-mark-8, ink)
	case ui.ToggleNode as x:
		d.spots = d.spots.Append(s)
		let at = layout.Box{X: b.X, Y: b.Y + (b.H-switchH)/2, W: switchW, H: switchH}
		fill(d, at, switchH/2, if x.On { accent } else { track })
		let knob = switchH - 4
		let kx = if x.On { at.X + switchW - knob - 2 } else { at.X + 2 }
		fill(d, layout.Box{X: kx, Y: at.Y + 2, W: knob, H: knob}, knob/2, paper)
		if focus {
			ring(d, at, switchH/2)
		}
		access(d, id, screen.RoleSwitch, x.Label, "", b, x.On, focus)
		lines(d, x.Label, b.X+switchW+10, b.Y, b.W-switchW-10, ink)
	case ui.InputNode as x:
		d.spots = d.spots.Append(s)
		let top = labelRoom(x, line)
		if x.Label != "" {
			d.w.Text(float64(b.X), float64(b.Y), x.Label, float64(textSize), ink)
		}
		if x.Description != "" {
			d.w.Text(float64(b.X), float64(b.Y+b.H-line), x.Description, float64(textSize), if x.Invalid { danger } else { faint })
		}
		let fb = layout.Box{X: b.X, Y: b.Y + top, W: b.W, H: b.H - top - describeRoom(x, line)}
		fill(d, fb, 4, paper)
		if focus {
			d.w.Border(float64(fb.X), float64(fb.Y), float64(fb.W), float64(fb.H), 4, 2, if x.Invalid { danger } else { accent })
		} else {
			d.w.Border(float64(fb.X), float64(fb.Y), float64(fb.W), float64(fb.H), 4, if x.Invalid { 2 } else { 1 }, if x.Invalid { danger } else { rule })
		}
		let inner = layout.Box{X: fb.X + 8, Y: fb.Y + 6, W: fb.W - 16, H: fb.H - 12}
		d.w.Clip(float64(inner.X), float64(inner.Y), float64(inner.W), float64(inner.H))
		if x.Value == "" {
			d.w.Text(float64(inner.X), float64(inner.Y), x.Placeholder, float64(textSize), faint)
		} else {
			d.w.Text(float64(inner.X), float64(inner.Y), x.Value, float64(textSize), ink)
		}
		d.w.Unclip()
		access(d, id, screen.RoleField, fieldName(x), x.Value, b, false, focus)
		if focus {
			let caret = fmin(width(d.metrics, x.Value, textSize), inner.W)
			d.w.Editing(x.Value, float64(inner.X+caret), float64(inner.Y), 1, float64(line))
			fill(d, layout.Box{X: inner.X + caret, Y: inner.Y, W: 1, H: line}, 0, ink)
		}
	}
	unpaint(d, look)
}

// drawKids paints id's children in order.
func drawKids[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], dy float32, clip layout.Box, line float32, soiled Map[ui.Id[E], bool], again bool) needs go.Foreign {
	for k in kidsOf(d, id) {
		draw(d, k, dy, clip, line, soiled, again)
	}
}

// lines paints text broken as Metrics breaks it at width, from x, y.
func lines[S, E, D, F](d mut Driver[S, E, D, F], text string, x float32, y float32, wide float32, color uint32) needs go.Foreign {
	let step = lineHeight(d.metrics, textSize)
	for i, l in Lines(d.metrics, text, textSize, wide) {
		d.w.Text(float64(x), float64(y+float32(i)*step), l, float64(textSize), color)
	}
}

func fill[S, E, D, F](d mut Driver[S, E, D, F], b layout.Box, radius float32, color uint32) needs go.Foreign {
	d.w.Fill(float64(b.X), float64(b.Y), float64(b.W), float64(b.H), float64(radius), color)
}

// ring is the focus ring around b.
func ring[S, E, D, F](d mut Driver[S, E, D, F], b layout.Box, radius float32) needs go.Foreign {
	d.w.Border(float64(b.X-3), float64(b.Y-3), float64(b.W+6), float64(b.H+6), float64(radius+3), 2, accent)
}

// cut is the part of b inside clip.
func cut(clip layout.Box, b layout.Box) layout.Box {
	let x = fmax(clip.X, b.X)
	let y = fmax(clip.Y, b.Y)
	let r = fmin(clip.X+clip.W, b.X+b.W)
	let bottom = fmin(clip.Y+clip.H, b.Y+b.H)
	layout.Box{X: x, Y: y, W: fmax(r-x, 0), H: fmax(bottom-y, 0)}
}

// access adds a node of the window's accessibility tree, named by an
// id that stays the node's while it shows.
func access[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E], role int, label string, value string, b layout.Box, checked bool, focus bool) needs go.Foreign {
	d.w.Access(nameOf(d, id), -1, role, label, value, float64(b.X), float64(b.Y), float64(b.W), float64(b.H), checked, focus)
}

// nameOf is id's node's id in the accessibility tree, given the first
// time it is asked for.
func nameOf[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) int {
	match d.names.Get(id) {
	case Some[int] as n:
		n.Value
	case None:
		let n = nextName(d)
		d.names[id] = n
		n
	}
}

// nextName is a name no node has had.
func nextName[S, E, D, F](d mut Driver[S, E, D, F]) int {
	d.named = d.named + 1
	d.named
}

// contentHeight is how far the children of a Scroll reach below its top.
func contentHeight[S, E, D, F](d mut Driver[S, E, D, F], id ui.Id[E]) float32 {
	match d.extents.Get(id) {
	case Some[float32] as h:
		h.Value
	case None:
		0
	}
}
