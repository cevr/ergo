// A scene script (ui.Act) played through a headless screen: each step is
// the terminal bytes a person's mouse or keyboard sends, fed to the
// screen's input parser, at the cell where the scene shows the node it
// names, so a script that ui.Play runs on ui.TestHost runs here through
// OpenTUI's parser, layout and hit test, and the driver's focus.

import actor
import go ergo.local/prototype/hosts/opentui/screen
import ui
import utf8

// Drain feeds the screen's queued input to d.
func Drain[E comparable, S, D, F](d *Driver[S, E, D, F]) fails ui.Closed | actor.Stopped | ui.BadPatch | ScreenFailed needs go.Foreign {
	for {
		let next = d.s.Take()
		if next.Kind == screen.None {
			return
		}
		try Feed(d, next)
	}
}

// Send feeds the terminal bytes b to the screen, then d.
func Send[E comparable, S, D, F](d *Driver[S, E, D, F], b string) fails ui.Closed | actor.Stopped | ui.BadPatch | ScreenFailed needs go.Foreign {
	d.s.Feed(b)
	if b == "\x1b" {
		// A lone Escape is a key once the parser's pause is over.
		d.s.Settle()
	}
	try Drain(d)
}

// Find is the first node of the tree, in tree order, whose label is
// label (labelOf).
func Find[S, E, D, F](d *Driver[S, E, D, F], label string) Option[ui.Id[E]] { findIn(d, d.root, label) }

func findIn[S, E, D, F](d *Driver[S, E, D, F], id ui.Id[E], label string) Option[ui.Id[E]] {
	for k in kidsOf(d, id) {
		if labelOf(nodeOf(d, k)) == (Some{Value: label}) {
			return Some{Value: k}
		}
		match findIn[S, E, D, F](d, k, label) {
		case Some[ui.Id[E]] as found:
			return found
		case None:
		}
	}
	None
}

// labelOf is the label a script names a node by, as ui.Find matches it:
// a Pressable's, a Check's, a Toggle's, an Area's, a Canvas's or a
// list's label, a Text's value, an Input's placeholder.
func labelOf[E](n ui.Node[E]) Option[string] {
	match n {
	case ui.PressableNode[E] as x:
		Some{Value: x.Label}
	case ui.CanvasNode as x:
		Some{Value: x.Label}
	case ui.RowsNode as x:
		Some{Value: x.Label}
	case ui.CheckNode[E] as x:
		Some{Value: x.Label}
	case ui.ToggleNode as x:
		Some{Value: x.Label}
	case ui.AreaNode as x:
		Some{Value: x.Label}
	case ui.TextNode as x:
		Some{Value: x.Value}
	case ui.InputNode as x:
		Some{Value: x.Placeholder}
	case _:
		None
	}
}

// Box is the cell box where id shows, after the last frame.
func Box[S, E, D, F](d *Driver[S, E, D, F], id ui.Id[E]) screen.Rect needs go.Foreign { d.s.BoxOf(numOf(d, id)) }

// Click is the bytes of a left button press and release at column x, row
// y (SGR mouse form, 1-based on the wire).
func Click(x int, y int) string { "\x1b[<0;\(x + 1);\(y + 1)M\x1b[<0;\(x + 1);\(y + 1)m" }

// tapOn taps id at the first cell of its box, after the Scrolls around it
// scrolled it into view, as a person scrolls to a row below the fold;
// NoNode names it by label when it shows in no cell.
func tapOn[E comparable, S, D, F](d *Driver[S, E, D, F], id ui.Id[E], label string) fails ui.NoNode | ui.Closed | actor.Stopped | ui.BadPatch | ScreenFailed needs go.Foreign {
	try reveal(d.s, numOf(d, id))
	try present(d.s)
	if !d.s.Shown(numOf(d, id)) {
		return ui.NoNode{Label: label}
	}
	let b = Box(d, id)
	try Send(d, Click(b.X, b.Y))
}

// typeInto taps the field id, deletes its text with Backspace and types
// text.
func typeInto[E comparable, S, D, F](d *Driver[S, E, D, F], id ui.Id[E], label string, text string) fails ui.NoNode | ui.Closed | actor.Stopped | ui.BadPatch | ScreenFailed needs go.Foreign {
	try tapOn(d, id, label)
	let old = match nodeOf(d, id) {
	case ui.InputNode as f:
		f.Value
	case _:
		""
	}
	for _ in 0..utf8.RuneCount(old) {
		try Send(d, "\x7f")
	}
	if text != "" {
		try Send(d, text)
	}
}

// Play runs a script through the screen, in order, feeding the bytes each
// step makes before the next. TapOn clicks the node's first cell;
// TypeInto clicks the field, deletes its text with Backspace and types
// the text; KeyIn sends the key's bytes; SettleAll settles; ClickOn and
// FillIn act as TapOn and TypeInto on the first node the locator finds,
// ExpectOn checks its matcher there, and NavigateTo and GoBack move the
// history and send URLChanged, as ui.TestHost does. AdvanceBy does
// nothing. PointOn and ScrollOn come with areas and lists (OT4); until
// then they find no node.
func Play[E comparable, S, D, F](d *Driver[S, E, D, F], script []ui.Act) fails ui.NoNode | ui.Mismatch | ui.Closed | actor.Stopped | ui.BadPatch | ScreenFailed needs go.Foreign {
	for act in script {
		match act {
		case ui.TapOn as x:
			match Find(d, x.Label) {
			case Some[ui.Id[E]] as id:
				try tapOn(d, id.Value, x.Label)
			case None:
				return ui.NoNode{Label: x.Label}
			}
		case ui.TypeInto as x:
			match Find(d, x.Label) {
			case Some[ui.Id[E]] as id:
				try typeInto(d, id.Value, x.Label, x.Text)
			case None:
				return ui.NoNode{Label: x.Label}
			}
		case ui.KeyIn as x:
			try Send(d, Bytes(x.Press))
		case ui.PointOn as x:
			return ui.NoNode{Label: x.Label}
		case ui.ScrollOn as x:
			return ui.NoNode{Label: x.Label}
		case ui.SettleAll:
			try Settle(d)
		case ui.AdvanceBy:
		case ui.ClickOn as x:
			try tapOn(d, try located(d, x.At), "a located node")
		case ui.FillIn as x:
			try typeInto(d, try located(d, x.At), "a located node", x.Text)
		case ui.ExpectOn as x:
			try ui.ExpectIn(&d.mirror, x.At, x.Is)
		case ui.NavigateTo as x:
			let u = ui.ParseURL(x.Href)
			ui.Push(d.history, u)
			try step(d, ui.URLChanged{URL: u})
		case ui.GoBack:
			if ui.Back(d.history) {
				try step(d, ui.URLChanged{URL: ui.Current(d.history)})
			}
		}
	}
}

// located is the first node of the tree loc finds.
func located[E comparable, S, D, F](d *Driver[S, E, D, F], loc ui.Locator) ui.Id[E] fails ui.NoNode {
	let ids = ui.LocateIn(&d.mirror, loc)
	if len(ids) == 0 {
		return ui.NoNode{Label: "a locator"}
	}
	ids[0]
}
