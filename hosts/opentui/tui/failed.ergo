// The driver's failure algebra. Go's open error stops at the few calls
// below (docs/spec/interop.md, Two levels 3), so every exported row is
// closed:
//
//   - ScreenFailed: the screen (the OpenTUI library or the terminal)
//     refused a call. It names the call and the node, keeps the library's
//     status, and keeps the Go error itself in Cause, so go.Is and go.As
//     reach its chain (screen.ErrClosed, an ot.Status, an os.PathError).
//   - ui.BadPatch: the view wrote a patch the driver cannot apply.
//   - actor.Stopped: the app's actor stopped.
//   - ui.Closed: the input ended (Feed, Send, Drain, Play).
//   - ui.NoNode, ui.Ambiguous, ui.Mismatch: a scripted step found no
//     node, several nodes, or another value (Play).
//   - term.NotTerminal: standard input is no terminal (RunTerminal).
//
// The screen is quit on every exit of Headless and RunTerminal. When
// the body failed, its failure is the one told; when it ended well,
// Quit's own failure is.

import go ergo.local/prototype/hosts/opentui/screen
import scope

// Call is the screen call that failed.
type Call = Open{} | Setup{} | Create{} | Move{} | SetText{} | SetStyle{} | Destroy{} | Commit{} | Paint{} | Layout{} | Write{} | Reveal{} | ScrollTo{} | Edit{} | Notify{} | Resize{} | Input{} | Quit{} | Closed{}

// ScreenFailed is a screen call that failed: Call, the scene node it was
// about (0 for none), the library's status when the library refused it
// (None when the failure is Go's own: a write to the terminal, a closed
// screen), the screen's message, and the Go error.
type ScreenFailed { Call Call, Node int, Status Option[int], Why string, Cause go.Error }

// failed is the ScreenFailed of a screen call's error. Every error the
// screen returns is a screen.Failure (TestScreenErrorsAreFailures).
func failed(e go.Error) ScreenFailed needs go.Foreign {
	match go.As[go.Ref[screen.Failure]](e) {
	case Some[go.Ref[screen.Failure]] as f:
		let st = f.Value.Status()
		ScreenFailed{Call: callOf(f.Value.Call), Node: f.Value.Node, Status: if st == 0 { None } else { Some{Value: st} }, Why: e.Text, Cause: e}
	case None:
		Unreachable("screen returned an error that is no screen.Failure: \(e.Text)")
	}
}

// callOf is the Call of a screen.Failure's call number.
func callOf(n int) Call {
	if n == screen.CallOpen {
		return Open
	}
	if n == screen.CallSetup {
		return Setup
	}
	if n == screen.CallCreate {
		return Create
	}
	if n == screen.CallMove {
		return Move
	}
	if n == screen.CallSetText {
		return SetText
	}
	if n == screen.CallSetStyle {
		return SetStyle
	}
	if n == screen.CallDestroy {
		return Destroy
	}
	if n == screen.CallCommit {
		return Commit
	}
	if n == screen.CallPaint {
		return Paint
	}
	if n == screen.CallLayout {
		return Layout
	}
	if n == screen.CallWrite {
		return Write
	}
	if n == screen.CallReveal {
		return Reveal
	}
	if n == screen.CallScrollTo {
		return ScrollTo
	}
	if n == screen.CallEdit {
		return Edit
	}
	if n == screen.CallNotify {
		return Notify
	}
	if n == screen.CallResize {
		return Resize
	}
	if n == screen.CallInput {
		return Input
	}
	if n == screen.CallQuit {
		return Quit
	}
	if n == screen.CallClosed {
		return Closed
	}
	Unreachable("screen.Failure names no call \(n)")
}

// CallName is the name of a Call, as screen's doc names it.
func CallName(c Call) string {
	match c {
	case Open:
		"open"
	case Setup:
		"setup"
	case Create:
		"create"
	case Move:
		"move"
	case SetText:
		"set-text"
	case SetStyle:
		"set-style"
	case Destroy:
		"destroy"
	case Commit:
		"commit"
	case Paint:
		"paint"
	case Layout:
		"layout"
	case Write:
		"write"
	case Reveal:
		"reveal"
	case ScrollTo:
		"scroll-to"
	case Edit:
		"edit"
	case Notify:
		"notify"
	case Resize:
		"resize"
	case Input:
		"input"
	case Quit:
		"quit"
	case Closed:
		"closed"
	}
}

// Headless runs body on a headless screen of cols by rows cells and
// quits the screen however body ends. Body's failure wins over Quit's;
// after a body that ended well, Quit's failure is the result.
func Headless[T, E, R](cols int, rows int, body func(s go.Ref[screen.Screen]) T fails E needs R) T fails E | ScreenFailed needs R | go.Foreign {
	let s = screen.Headless(cols, rows) catch {
	case go.Error as e:
		return failed(e)
	}
	try quitting(s) {
		try body(s)
	}
}

// quitting runs body and quits s however body ends: body's failure wins
// over Quit's; after a body that ended well, Quit's failure is the
// result. A second Quit does nothing, so the exit's Quit after the one
// that told its failure does nothing.
func quitting[T, E, R](s go.Ref[screen.Screen], body func() T fails E needs R) T fails E | ScreenFailed needs R | go.Foreign {
	scope.OnExit() {
		s.Quit() catch {
		// ergo-lint-disable-next-line silent-catch -- body failed, and its failure is the one told; Quit frees what it can
		case go.Error:
		}
	}
	let out = try body()
	s.Quit() catch {
	case go.Error as e:
		return failed(e)
	}
	out
}

// open is screen.Open: the process's terminal as a live screen.
func open() go.Ref[screen.Screen] fails ScreenFailed needs go.Foreign {
	screen.Open() catch {
	case go.Error as e:
		return failed(e)
	}
}

// present lays out, paints and writes the next frame.
func present(s go.Ref[screen.Screen]) fails ScreenFailed needs go.Foreign {
	s.Present() catch {
	case go.Error as e:
		return failed(e)
	}
}

// reveal scrolls node n into view in each Scroller that holds it.
func reveal(s go.Ref[screen.Screen], n int) fails ScreenFailed needs go.Foreign {
	s.Reveal(n) catch {
	case go.Error as e:
		return failed(e)
	}
}

// scrollTo scrolls the Scroll or list n to row y (by: by y rows).
func scrollTo(s go.Ref[screen.Screen], n int, y int, by bool) fails ScreenFailed needs go.Foreign {
	s.ScrollTo(n, y, by) catch {
	case go.Error as e:
		return failed(e)
	}
}

// edit applies one edit to the field n and is its text after it.
func edit(s go.Ref[screen.Screen], n int, op int, col int, text string) string fails ScreenFailed needs go.Foreign {
	s.Edit(n, op, col, text) catch {
	case go.Error as e:
		return failed(e)
	}
}

// next waits for the screen's next input.
func next(s go.Ref[screen.Screen]) screen.Input fails ScreenFailed needs go.Foreign {
	s.Next() catch {
	case go.Error as e:
		return failed(e)
	}
}

// notify says text on the terminal's notification channel.
func notify(s go.Ref[screen.Screen], text string) fails ScreenFailed needs go.Foreign {
	s.Notify(text) catch {
	case go.Error as e:
		return failed(e)
	}
}
