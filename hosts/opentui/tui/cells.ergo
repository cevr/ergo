// The unit rule: a ui.Length is device-independent pixels, and the host's
// Cell turns it into cells: x / W columns, y / H rows, passed to the scene
// as fractions (Yoga rounds each box's edges to whole cells). A
// terminal-first program passes Cell{W: 1, H: 1} and writes lengths in
// cells.

import ui

// Cell is how many DIPs one terminal cell is, across (W) and down (H).
type Cell { W float64, H float64 }

// DefaultCell is the cell of a desktop program's lengths: 8 by 16 DIPs.
func DefaultCell() Cell { Cell{W: 8, H: 16} }

// Cells is the length n in cells of unit DIPs (a W or an H; a unit of 0
// or less is taken as 1).
func Cells(n ui.Length, unit float64) float64 {
	let u = if unit > 0 { unit } else { 1.0 }
	float64(n) / u
}

// CellsAreMonotone: a longer length is never fewer cells, and a whole
// multiple of the cell is exactly that many cells.
law CellsAreMonotone(a int, b int, k int, unit int) {
	let u = float64((unit%32+32)%32 + 1)
	let x = ui.Length(float64(a%100000) / 4)
	let y = ui.Length(float64(b%100000) / 4)
	let n = (k%1000 + 1000) % 1000
	let monotone = if float64(x) <= float64(y) { Cells(x, u) <= Cells(y, u) } else { Cells(x, u) >= Cells(y, u) }
	monotone && Cells(ui.Length(float64(n)*u), u) == float64(n)
}
