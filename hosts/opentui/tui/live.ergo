// A live region on the terminal (gap 7): a ui.LiveNode shows its text as
// a TEXT node, and the driver says each text a step's pass newly shows in
// it on the terminal's notification channel (screen.Notify: OSC 9, or the
// terminal's own, where the terminal takes notifications). The rule is
// ui.TestHost's (ui.Announced): an Insert or a Set of a LiveNode with a
// text that is not empty says it once; the first pass, the view as it
// starts, says nothing, as a page's live region does not speak what it
// loads with.

import go ergo.local/prototype/hosts/opentui/screen
import ui

// speak says the text of each live region ops write, after the screen
// shows them.
func speak[S, E, D, F](d mut Driver[S, E, D, F], ops []ui.Op[E]) fails ScreenFailed needs go.Foreign {
	for op in ops {
		match op {
		case ui.Insert[E] as x:
			try sayLive(d.s, x.Node)
		case ui.Set[E] as x:
			try sayLive(d.s, x.Node)
		case _:
		}
	}
}

// sayLive says n's text when n is a live region with one.
func sayLive[E](s go.Ref[screen.Screen], n ui.Node[E]) fails ScreenFailed needs go.Foreign {
	match n {
	case ui.LiveNode as l:
		if l.Text != "" {
			try notify(s, l.Text)
		}
	case _:
	}
}

// Said is each text the driver said on the terminal, in order (a
// headless screen keeps them), for a test to hold to ui.Announced.
func Said[S, E, D, F](d mut Driver[S, E, D, F]) []string needs go.Foreign { d.s.Said() }
