// fieldplay plays terminal bytes into a screen with one field on the
// terminal driver, headless, and prints what the field shows after each
// step. TestFieldFollowsTheLineEditor writes its input and holds its
// output to a reference line editor.
//
// Standard input: one step a line, "send B" with B the step's bytes in
// standard base64. The field's placeholder is "type here"; F1 to F8 (keys
// the field passes on) make the program set the field to Replacements[k-1]
// (a Set from the program).
//
// Output, a line a step, tab-separated: the program's text (quoted), the
// screen's row the field is on (quoted), the cursor's cell and whether it
// shows ("x y true"), and the field's box ("x y w h"). A step that fails
// prints "fail N: why".

import actor
import base64
import ergo.local/prototype/hosts/opentui/tui
import go ergo.local/prototype/hosts/opentui/screen
import io
import machines
import option
import os
import strconv
import strings
import time
import ui

// Replacements are the texts F1 to F8 set the field to: empty, ASCII,
// words with runs of spaces and punctuation, wide runes, a precomposed
// and a combining é.
let Replacements = []string{"", "a", "hello world", "日本 語", "é e\u0301 x", "foo-bar  baz", "  lead", "end  "}

type field { text string }

type fieldEvent = Typed{Text string} | Replace{K int}

func fieldStep(s field, e fieldEvent) machines.Decision[field, int] {
	match e {
	case Typed as t:
		machines.Enter[field]{Next: field{text: t.Text}}
	case Replace as r:
		machines.Enter[field]{Next: field{text: Replacements[r.K]}}
	}
}

func none(s field) option.Option[machines.Timeout[fieldEvent]] { option.None }

func idle(s field) option.Option[func(send func(e fieldEvent))] { option.None }

func fieldMachine() machines.Machine[field, fieldEvent, int] {
	machines.Machine[field, fieldEvent, int]{Initial: field{text: ""}, Step: fieldStep, After: none, Work: idle, Exit: func(s field) option.Option[func()] { option.None }}
}

func fieldView(f mut ui.Frame[fieldEvent], s field) {
	ui.Column(f, ui.Plain()) {
		ui.Input(f, s.text, "type here", func(t string) fieldEvent { Typed{Text: t} })
		ui.OnKey(f, func(k ui.KeyPress) option.Option[fieldEvent] {
			for i in 0..Replacements.Len() {
				if k.Name == "F\(i + 1)" {
					return option.Some{Value: Replace{K: i}}
				}
			}
			option.None
		})
	}
}

func main() needs io.Console | os.Ambient | go.Foreign {
	with context { io.Stdin: io.NewStdin(), time.Scheduler: time.NewManual(0) } {
		let text = io.Stdin.ReadAll() catch {
		case io.ReadFailed:
			io.Console.Println("fail 0: no input")
			return
		}
		tui.Headless(40, 5, func(s go.Ref[screen.Screen]) needs io.Console | time.Scheduler | go.Foreign {
			let a = actor.StartMachine(fieldMachine(), 1, func(o int) {})
			let mut d = tui.New(s, a, fieldView, 4) catch {
			case ui.BadPatch as b:
				io.Console.Println("fail 0: \(b.Why)")
				return
			case tui.ScreenFailed as e:
				io.Console.Println("fail 0: \(e.Why)")
				return
			}
			for i, line in strings.Split(strings.TrimSpace(text), "\n") {
				let bytes = base64.Decode(base64.StdEncoding, strings.TrimPrefix(line, "send ")) catch {
				case base64.Malformed:
					io.Console.Println("fail \(i + 1): no base64")
					continue
				}
				tui.Send(&d, bytes) catch {
				case ui.Closed:
					io.Console.Println("fail \(i + 1): closed")
					continue
				case actor.Stopped:
					io.Console.Println("fail \(i + 1): stopped")
					continue
				case ui.BadPatch as b:
					io.Console.Println("fail \(i + 1): \(b.Why)")
					continue
				case tui.ScreenFailed as e:
					io.Console.Println("fail \(i + 1): \(e.Why)")
					continue
				}
				let b = match tui.Number(&d, "type here") {
				case option.Some[int] as n:
					s.BoxOf(n.Value)
				case option.None:
					screen.Rect{X: -1, Y: -1, Width: 0, Height: 0}
				}
				let rows = s.Rows()
				let row = if b.Y >= 0 && b.Y < rows.Len() { rows[b.Y] } else { "" }
				let c = s.Cursor()
				io.Console.Println("\(strconv.Quote(tui.StateOf(&d).text))\t\(strconv.Quote(row))\t\(c.X) \(c.Y) \(c.Shown)\t\(b.X) \(b.Y) \(b.Width) \(b.Height)")
			}
		}) catch {
		case tui.ScreenFailed as e:
			io.Console.Println("fail 0: \(e.Why)")
		}
	}
}
