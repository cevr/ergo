import actor
import go ergo.local/prototype/hosts/opentui/screen
import ergo.local/prototype/hosts/opentui/tui
import io
import machines
import option
import strconv
import slices
import strings
import time
import ui
import utf8

// result is how a step ended on one host: done, or the label it found no
// node for, or how it failed; Failed is the terminal's screen failing,
// which ends the run (TestTuiFailuresAgree).
type result = Done{} | Missing{Label string} | Broke{Why string} | Failed{Failure tui.ScreenFailed}

// failLine is the line hostagree prints for a screen failure: the call,
// the node, the library's status ("-" for none) and the message.
func failLine(e tui.ScreenFailed) string {
	let st = match e.Status {
	case option.Some[int] as s:
		"\(s.Value)"
	case option.None:
		"-"
	}
	"failed \(tui.CallName(e.Call)) \(e.Node) \(st) \(e.Why)"
}

// agree plays steps on both hosts and prints whether they agree after
// each. The screen is 60 by 40 cells (480 by 640 DIPs, the window of
// hosts/mygo's hostagree). A screen failure ends the run; the screen is
// quit however it ends (tui.Headless).
func agree[E comparable, S](m machines.Machine[S, E, int], view own func(f mut ui.Frame[E], s S), same func(a S, b S) bool, steps []string) fails tui.ScreenFailed needs io.Console | time.Scheduler | go.Foreign {
	try tui.Headless(60, 40, func(s go.Ref[screen.Screen]) fails tui.ScreenFailed needs io.Console | time.Scheduler | go.Foreign {
		try agreeOn(s, m, view, same, steps)
	})
}

// agreeOn is agree on the screen s.
func agreeOn[E comparable, S](s go.Ref[screen.Screen], m machines.Machine[S, E, int], view own func(f mut ui.Frame[E], s S), same func(a S, b S) bool, steps []string) fails tui.ScreenFailed needs io.Console | time.Scheduler | go.Foreign {
	let ta = actor.StartMachine(m, 1, func(o int) {})
	let da = actor.StartMachine(m, 1, func(o int) {})
	let mut h = ui.NewTestHost(ta, view, time.NewManual(0), 16) catch {
	case ui.BadPatch as b:
		io.Console.Println("differ 0: test host: \(b.Why)")
		return
	}
	let mut d = tui.New(s, da, view, 16) catch {
	case ui.BadPatch as b:
		io.Console.Println("differ 0: driver: \(b.Why)")
		return
	case tui.ScreenFailed as e:
		return e
	}
	match compare(&h, &d, s, same) {
	case option.Some[string] as why:
		io.Console.Println("differ 0: \(why.Value)")
	case option.None:
		io.Console.Println("ok 0")
	}
	for i, line in steps {
		let n = i + 1
		if line == "screen" {
			// For a person replaying a seed: the screen's rows.
			for r in s.Rows() {
				io.Console.Println("| \(r)")
			}
			continue
		}
		// For the plain Scrolls' edge scroll, which TestHost does not
		// model (TestPlainScrollEdges): their offsets on the terminal.
		if line == "scrolls" {
			let mut at = "scrolls"
			for o in tui.ScrollsAt(&d) {
				at = at + " \(o)"
			}
			io.Console.Println(at)
			continue
		}
		// "cost STEP" plays STEP and prints the library calls it made.
		let costed = strings.HasPrefix(line, "cost ")
		let before = s.Calls()
		let wrote = s.Bytes()
		let (a, b) = run(&h, &d, s, strings.TrimPrefix(line, "cost "))
		if costed {
			io.Console.Println("cost \(s.Calls() - before) bytes \(s.Bytes() - wrote)")
		}
		match b {
		case Failed as f:
			return f.Failure
		case _:
		}
		if a != b {
			io.Console.Println("differ \(n): \(line): test host \(said(a)), terminal \(said(b))")
			continue
		}
		match compare(&h, &d, s, same) {
		case option.Some[string] as why:
			io.Console.Println("differ \(n): \(line): \(why.Value)")
		case option.None:
			io.Console.Println("ok \(n)")
		}
	}
	io.Console.Println("end")
}

func said(r result) string {
	match r {
	case Done:
		"done"
	case Missing as m:
		"no node \(m.Label)"
	case Broke as b:
		"failed \(b.Why)"
	case Failed as f:
		failLine(f.Failure)
	}
}

// compare is why the hosts differ now, None when they agree: the tree,
// the app state, whether an Area holds the pointer, each list's rows in
// their places, and each text's place on the screen. First TestHost takes
// the viewport the terminal reported for each list (follow).
func compare[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut tui.Driver[S, E, D, F], s go.Ref[screen.Screen], same func(a S, b S) bool) option.Option[string] needs go.Foreign {
	match looked(ui.Screen(h)) {
	case option.Some[string] as why:
		return why
	case option.None:
	}
	match degraded(ui.Screen(h)) {
	case option.Some[string] as why:
		return why
	case option.None:
	}
	follow(h, d, tui.Screen(d))
	// A Readout shows as the Text of its reading on both (ui.ShownIn).
	if !ui.SameShapes(ui.Screen(h), tui.Shown(d)) {
		return option.Some{Value: "trees differ:\n\(ui.Screenshot(h))terminal:\n\(shot(tui.Shown(d), ""))"}
	}
	if !same(ui.StateOf(h), tui.StateOf(d)) {
		return option.Some{Value: "states differ"}
	}
	if h.Frames() != d.Frames() || ui.WantsFrames(h) != tui.WantsFrames(d) {
		return option.Some{Value: "TestHost stepped \(h.Frames()) frames (wanting more: \(ui.WantsFrames(h))), the terminal \(d.Frames()) (\(tui.WantsFrames(d)))"}
	}
	if s.Count() != tui.SceneNodes(d) {
		return option.Some{Value: "the scene holds \(s.Count()) nodes, the driver \(tui.SceneNodes(d))"}
	}
	let held = ui.Captured(h) != option.None
	if held != (tui.Captured(d) != option.None) {
		return option.Some{Value: "an Area holds the pointer on TestHost: \(held); on the terminal: \(!held)"}
	}
	match inked(d, s, tui.Screen(d)) {
	case option.Some[string] as why:
		return why
	case option.None:
	}
	match kept(d, tui.Screen(d)) {
	case option.Some[string] as why:
		return why
	case option.None:
	}
	let rows = s.Rows()
	match placed(d, s, tui.Screen(d), rows) {
	case option.Some[string] as why:
		return why
	case option.None:
	}
	match read(d, rows) {
	case option.Some[string] as why:
		return why
	case option.None:
	}
	shown(d, s, tui.Screen(d), rows)
}

// read is why a Readout's row does not show its reading, None when each
// does (OT-READOUT): the box is the reserve's width, one row, and the
// screen's row there holds the reading cut or padded to that width
// (readout.ergo: a reading never moves its siblings; a wider one is
// clipped to the box).
func read[E comparable, S, D, F](d mut tui.Driver[S, E, D, F], rows []string) option.Option[string] needs go.Foreign {
	for r in tui.Readouts(d) {
		let w = utf8.RuneCount(r.Reserve)
		let b = r.Box
		if b.Width != w {
			return option.Some{Value: "the readout of reserve \"\(r.Reserve)\" is \(b.Width) cells wide, not its reserve's \(w)"}
		}
		let mut want = []string{}
		for c in runes(r.Reading) {
			if want.Len() < w {
				want = want.Append(c)
			}
		}
		for want.Len() < w {
			want = want.Append(" ")
		}
		let row = if b.Y >= 0 && b.Y < rows.Len() { runes(rows[b.Y]) } else { []string{} }
		if b.X < 0 || b.X+w > row.Len() || strings.Join(slices.Slice(row, b.X, b.X+w), "") != strings.Join(want, "") {
			return option.Some{Value: "the readout reading \"\(r.Reading)\" (reserve \"\(r.Reserve)\") at \(b.X),\(b.Y) shows row \"\(if b.Y >= 0 && b.Y < rows.Len() { rows[b.Y] } else { "" })\""}
		}
	}
	option.None
}

// runes is the text of each rune of s.
func runes(s string) []string {
	let mut out = []string{}
	let mut at = 0
	for at < s.Len() {
		let r = utf8.DecodeRuneInString(strings.Slice(s, at, s.Len()))
		out = out.Append(strings.Slice(s, at, at+r.Size))
		at = at + r.Size
	}
	out
}

// kept is why a list does not show the offset its pass chose, None when
// each does: a list's node carries the offset the pass used (RowsKeeping
// moves it to bring a row into view), and the viewport the terminal
// reported after the step has that offset, or the list's last offset when
// the pass's is past it (the scene keeps a scroll inside the content).
func kept[E comparable, S, D, F](d mut tui.Driver[S, E, D, F], shapes []ui.Shape[E]) option.Option[string] {
	for sh in shapes {
		match sh.Node {
		case ui.RowsNode as x:
			match tui.Viewport(d, x.Label) {
			case option.Some[ui.Viewport] as v:
				let (off, want) = (float64(v.Value.Offset), float64(x.Offset))
				let most = maxOffset(shapes, x.Label, float64(v.Value.Height))
				if off != want && !(want > most && off == most) {
					return option.Some{Value: "list \(x.Label): the pass chose offset \(want), the terminal shows \(off)"}
				}
			case option.None:
			}
		case _:
			match kept[E, S, D, F](d, sh.Kids) {
			case option.Some[string] as why:
				return option.Some{Value: why.Value}
			case option.None:
			}
		}
	}
	option.None
}

// looked names a node of TestHost's tree that has a look of its own
// (Style.Look other than its kind's default), which this host does not
// show yet (gap OT-LOOKS: the driver takes Define and reads no
// Style.Look); None when no node has one.
func looked[E](shapes []ui.Shape[E]) option.Option[string] {
	for sh in shapes {
		match ui.StyleOf(sh.Node) {
		case option.Some[ui.Style] as st:
			if st.Value.Look != ui.DefaultLooks(sh.Node) {
				return option.Some{Value: "gap OT-LOOKS: a node has a look of its own (Style.Look), which the terminal does not show"}
			}
		case option.None:
		}
		match looked[E](sh.Kids) {
		case option.Some[string] as why:
			return option.Some{Value: why.Value}
		case option.None:
		}
	}
	option.None
}

// degraded names a node of TestHost's tree of a kind the terminal shows
// degraded (OT-TOTAL: tui's matches name each kind and say what the
// terminal does instead), so a script that reaches one fails loudly as
// the gap it is; None when none is in the tree. Every kind is named, so a
// new ui node kind is a check error here as in tui.
func degraded[E](shapes []ui.Shape[E]) option.Option[string] {
	for sh in shapes {
		let why option.Option[string] = match sh.Node {
		case ui.TransitionNode:
			option.Some{Value: "gap OT-TOTAL: a Transition, whose motion the terminal does not run (its body shows at rest)"}
		case ui.LayerNode[E]:
			option.Some{Value: "gap OT-TOTAL: a Layer, which the terminal lays in flow (no Z, anchor, placement or scrim)"}
		case ui.TrackNode:
			option.Some{Value: "gap OT-TRACKS: a Track, whose motion the terminal does not run (no offset, no fade)"}
		case ui.CanvasNode as x:
			if hasImage(x.Paint) {
				option.Some{Value: "gap OT-IMAGE: a canvas image, which the terminal does not paint"}
			} else {
				option.None
			}
		case ui.BoxNode, ui.RowNode, ui.ColumnNode, ui.ScrollNode, ui.TextNode, ui.PressableNode[E], ui.CheckNode[E], ui.InputNode, ui.ToggleNode, ui.AreaNode, ui.RowsNode, ui.FieldsetNode, ui.ZoneNode, ui.LiveNode, ui.SemanticNode[E], ui.ReadoutNode:
			// Shown as TestHost shows them: a Semantic that sends is focused
			// and pressed (OT-SEMANTIC), a Readout shows its reading in its
			// reserve's box (OT-READOUT, held by read).
			option.None
		}
		match why {
		case option.Some[string] as w:
			return w
		case option.None:
		}
		match degraded[E](sh.Kids) {
		case option.Some[string] as w:
			return w
		case option.None:
		}
	}
	option.None
}

// hasImage is whether a canvas's paint draws an image.
func hasImage(ops []ui.PaintOp) bool {
	for op in ops {
		match op {
		case ui.ImageOp:
			return true
		case ui.FillOp, ui.StrokeOp, ui.PushTransform, ui.PushClip, ui.PopPaint:
		}
	}
	false
}

// cellH is the DIPs of a cell's height (the driver's default Cell).
let cellH = 16.0

// placed is why a list is not where it shows, None when each is: the
// viewport the terminal reported is the list's box height and an offset
// inside its content, and each row it wrote (a button, by label) is at
// the list's top plus its index's rows, less the offset, one row high, at
// the list's left edge, and its label is on the screen's row there when
// that row is in the list's box.
func placed[E comparable, S, D, F](d mut tui.Driver[S, E, D, F], s go.Ref[screen.Screen], shapes []ui.Shape[E], rows []string) option.Option[string] needs go.Foreign {
	for sh in shapes {
		match sh.Node {
		case ui.RowsNode as x:
			let (v, lb) = match (tui.Viewport(d, x.Label), tui.Number(d, x.Label)) {
			case (option.Some[ui.Viewport] as v, option.Some[int] as n):
				(v.Value, s.BoxOf(n.Value))
			case _:
				return option.Some{Value: "list \(x.Label) has no viewport or node"}
			}
			let rh = float64(x.RowHeight) / cellH
			let off = float64(v.Offset) / cellH
			let most = float64(x.Count)*rh - float64(lb.Height)
			if float64(v.Height) != float64(lb.Height)*cellH || off < 0 || (off > 0 && off > most) {
				return option.Some{Value: "list \(x.Label): viewport \(off)+\(float64(v.Height) / cellH) rows in a box \(lb.Height) high over \(x.Count) rows"}
			}
			for i, k in sh.Kids {
				match k.Node {
				case ui.PressableNode[E] as p:
					match tui.Number(d, p.Label) {
					case option.Some[int] as n:
						let b = s.BoxOf(n.Value)
						let want = float64(lb.Y) + float64(x.First+i)*rh - off
						// As wide as the list, less the bar's column.
						if float64(b.Y) != want || float64(b.Height) != rh || b.X != lb.X || b.Width < lb.Width-1 || b.Width > lb.Width {
							return option.Some{Value: "\(p.Label) shows at \(b.X),\(b.Y) \(b.Width)x\(b.Height); want row \(want), \(rh) high, at the list's left edge \(lb.X) (the list at \(lb.X),\(lb.Y) \(lb.Width)x\(lb.Height), offset \(off))"}
						}
						if b.Y >= lb.Y && b.Y < lb.Y+lb.Height && b.Y < rows.Len() && !strings.Contains(rows[b.Y], p.Label) {
							return option.Some{Value: "\(p.Label) is not on the screen's row \(b.Y): \"\(rows[b.Y])\""}
						}
					case option.None:
						return option.Some{Value: "\(p.Label) has no node"}
					}
				case _:
				}
			}
		case _:
			match placed[E, S, D, F](d, s, sh.Kids, rows) {
			case option.Some[string] as why:
				return why
			case option.None:
			}
		}
	}
	option.None
}

// follow scrolls each list of TestHost to the viewport the terminal
// reported for it: the terminal decides a list's height and where a
// person scrolled it, and TestHost, which has no screen, takes it as a
// host's report (ui.ScrollTo). Then both write the same rows.
func follow[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut tui.Driver[S, E, D, F], shapes []ui.Shape[E]) {
	for sh in shapes {
		match sh.Node {
		case ui.RowsNode as x:
			match (tui.Viewport(d, x.Label), ui.Find(h, x.Label)) {
			case (option.Some[ui.Viewport] as v, option.Some[ui.Id[E]] as id):
				ui.ScrollTo(h, id.Value, v.Value.Offset, v.Value.Height) catch {
				// ergo-lint-disable-next-line silent-catch -- a TestHost that cannot take the viewport differs from the terminal in the trees compare reads next
				case actor.Stopped, ui.BadPatch:
				}
			case _:
			}
		case _:
			follow[E, S, D, F](h, d, sh.Kids)
		}
	}
}

// maxOffset is how far the list labelled label scrolls in a viewport
// height high (DIPs): its content less the height, at least 0; -1 for no
// such list.
func maxOffset[E](shapes []ui.Shape[E], label string, height float64) float64 {
	for sh in shapes {
		match sh.Node {
		case ui.RowsNode as x:
			if x.Label == label {
				let most = float64(x.Count)*float64(x.RowHeight) - height
				return if most > 0 { most } else { 0 }
			}
		case _:
		}
		let m = maxOffset[E](sh.Kids, label, height)
		if m >= 0 {
			return m
		}
	}
	-1
}

// shot is the driver's tree as text, one node a line by its kind and
// label: what a differing step prints beside TestHost's screenshot.
func shot[E](shapes []ui.Shape[E], indent string) string {
	let mut out = ""
	for sh in shapes {
		let what = match sh.Node {
		case ui.RowsNode as x:
			"rows \"\(x.Label)\" \(x.Count) from \(x.First)"
		case ui.PressableNode[E] as x:
			"button \"\(x.Label)\""
		case ui.TextNode as x:
			"text \"\(x.Value)\""
		case ui.InputNode as x:
			"field \"\(x.Placeholder)\" = \"\(x.Value)\""
		case _:
			"node"
		}
		out = out + indent + what + "\n" + shot[E](sh.Kids, indent+"  ")
	}
	out
}

// shown is why a text is not where the scene says it is, None when each
// is: every word of a text (the first node of that value, outside a
// Scroll or a list, whose rows can scroll away) is on the screen's rows
// that its box covers.
func shown[E comparable, S, D, F](d mut tui.Driver[S, E, D, F], s go.Ref[screen.Screen], shapes []ui.Shape[E], rows []string) option.Option[string] needs go.Foreign {
	for sh in shapes {
		match sh.Node {
		case ui.ScrollNode, ui.RowsNode:
			continue
		case ui.TextNode as x:
			match tui.Number(d, x.Value) {
			case option.Some[int] as n:
				let b = s.BoxOf(n.Value)
				let mut lines = ""
				for y in b.Y..(b.Y + b.Height) {
					if y >= 0 && y < rows.Len() {
						lines = lines + rows[y] + "\n"
					}
				}
				for word in strings.Fields(x.Value) {
					if !strings.Contains(lines, word) {
						return option.Some{Value: "text \"\(x.Value)\" is not on rows \(b.Y) to \(b.Y + b.Height - 1) of its box \(b.X),\(b.Y) \(b.Width)x\(b.Height):\n\(lines)"}
					}
				}
			case option.None:
			}
		case _:
		}
		match shown[E, S, D, F](d, s, sh.Kids, rows) {
		case option.Some[string] as why:
			return why
		case option.None:
		}
	}
	option.None
}

// run does one step on each host.
func run[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut tui.Driver[S, E, D, F], s go.Ref[screen.Screen], line string) (result, result) needs go.Foreign {
	let (verb, rest) = match strings.Cut(line, " ") {
	case option.Some[strings.Halves] as c:
		(c.Value.Before, c.Value.After)
	case option.None:
		(line, "")
	}
	match verb {
	case "tap":
		both(h, d, ui.TapOn{Label: rest})
	case "type":
		match strings.Cut(rest, "\t") {
		case option.Some[strings.Halves] as c:
			both(h, d, ui.TypeInto{Label: c.Value.Before, Text: c.Value.After})
		case option.None:
			(Broke{Why: "type needs a tab"}, Broke{Why: "type needs a tab"})
		}
	case "key":
		let act = ui.KeyIn{Press: ui.KeyPress{Name: rest, Mods: ui.Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}
		// A character typed with a field focused goes into the field on the
		// terminal, at its caret (here moved to the end with Ctrl+E first:
		// TestFieldFollowsTheLineEditor holds the caret); TestHost, which
		// has no focus, appends it there too.
		match (tui.FocusId(d), tui.FocusNode(d)) {
		case (option.Some[ui.Id[E]] as id, option.Some[ui.Node[E]] as n):
			match n.Value {
			case ui.InputNode as x:
				if utf8.RuneCount(rest) == 1 && rest != " " {
					let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
						try tui.Send(d, "\x05")
						try tui.Play(d, []ui.Act{act})
					})
					let a = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
						try ui.TypeText(h, twin(h, n.Value, id.Value), x.Value+rest)
					})
					return (a, b)
				}
			case _:
			}
		case _:
		}
		both(h, d, act)
	case "point":
		let f = strings.Fields(rest)
		if f.Len() != 4 {
			return (Broke{Why: "point LABEL PHASE X Y"}, Broke{Why: "point LABEL PHASE X Y"})
		}
		let x = float64(atoi(f[2]))
		let y = float64(atoi(f[3]))
		let phase = match f[1] {
		case "down":
			ui.Down
		case "up":
			ui.Up
		case "move":
			ui.Moved
		case _:
			ui.Wheel{DX: 0, DY: y}
		}
		let p = ui.PointerEvent{Pointer: ui.MousePointer, Phase: phase, X: x, Y: y, Zone: option.None}
		let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
			try tui.Play(d, []ui.Act{ui.PointOn{Label: f[0], Pointer: p}})
		})
		let a = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
			match zoneAt(h, d, f[0], x, y) {
			case option.Some[zoned[E]] as z:
				try ui.PointOver(h, z.Value.area, z.Value.zone, z.Value.box, p)
			case option.None:
				try ui.Play(h, []ui.Act{ui.PointOn{Label: f[0], Pointer: p}})
			}
		})
		(a, b)
	case "leave":
		// The pointer moves where no node takes input (OT-PHASES): on
		// TestHost a move nowhere, on the terminal a move with no button
		// to the screen's last cell, which no app here draws on.
		let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
			try tui.Send(d, tui.Mouse(35, 59, 39, true))
		})
		let a = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
			try ui.PointNowhere(h)
		})
		(a, b)
	case "scroll":
		let f = strings.Fields(rest)
		if f.Len() != 2 {
			return (Broke{Why: "scroll LABEL N"}, Broke{Why: "scroll LABEL N"})
		}
		let to = float64(atoi(f[1]))
		let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
			try tui.Play(d, []ui.Act{ui.ScrollOn{Label: f[0], Offset: ui.Length(to), Height: 0}})
		})
		(found(h, f[0]), landed(d, f[0], b, to))
	case "wheel":
		// K turns of the wheel at the list's centre (down for K > 0): the
		// list moves WheelRows rows a turn, as far as its content goes.
		let f = strings.Fields(rest)
		if f.Len() != 2 {
			return (Broke{Why: "wheel LABEL K"}, Broke{Why: "wheel LABEL K"})
		}
		let k = atoi(f[1])
		let (old, box) = match (tui.Viewport(d, f[0]), tui.Number(d, f[0])) {
		case (option.Some[ui.Viewport] as v, option.Some[int] as n):
			(float64(v.Value.Offset), s.BoxOf(n.Value))
		case _:
			return (found(h, f[0]), Missing{Label: f[0]})
		}
		let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
			for _ in 0..(if k < 0 { -k } else { k }) {
				try tui.Send(d, tui.Mouse(if k < 0 { 64 } else { 65 }, box.X+box.Width/2, box.Y+box.Height/2, true))
			}
		})
		let to = old + float64(k*tui.WheelRows)*cellH
		(found(h, f[0]), landed(d, f[0], b, if to < 0 { 0 } else { to }))
	case "settle":
		both(h, d, ui.SettleAll)
	case "click":
		// A radio by its role and name: a Semantic has no label to tap.
		both(h, d, ui.ClickOn{At: ui.WithRole{Role: ui.Radio, Name: rest}})
	case "publish":
		// A new reading of the reading app's readout, from outside any
		// pass ("-" for the empty text); each host takes its Published.
		ui.Publish(dial, if rest == "-" { "" } else { rest })
		both(h, d, ui.SettleAll)
	case "frames":
		let (a, b) = both(h, d, ui.AdvanceBy{By: duration(int64(atoi(rest)) * int64(16ms))})
		match b {
		case Failed:
			return (a, b)
		case _:
		}
		match edged(d, ui.Screen(h)) {
		case option.Some[string] as why:
			(a, Broke{Why: why.Value})
		case option.None:
			(a, b)
		}
	case "focus":
		focusPress(h, d, s, atoi(rest))
	case _:
		(Broke{Why: "no step \(verb)"}, Broke{Why: "no step \(verb)"})
	}
}

// zoned is a Zone under a pointer on TestHost: the Area, the Zone, and
// the Zone's box in the Area's box (DIPs).
type zoned[E] { area ui.Id[E], zone ui.Id[E], box ui.Rect }

// zoneAt is TestHost's hit test of a pointer at x, y (DIPs) in the Area
// labelled label: the pad's Zone (key 7) when the pointer is in the box
// the terminal laid it out in, None otherwise. The terminal finds the
// Zone by its own hit test, through the scene; here it is the box.
func zoneAt[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut tui.Driver[S, E, D, F], label string, x float64, y float64) option.Option[zoned[E]] needs go.Foreign {
	let (area, zone, mine) = match (ui.Find(h, label), ui.Locate(h, ui.WithZone{Key: ui.ByInt(7)}), tui.Find(d, label), tui.Locate(d, ui.WithZone{Key: ui.ByInt(7)})) {
	case (option.Some[ui.Id[E]] as a, zs, option.Some[ui.Id[E]] as da, dz):
		if zs.Len() == 0 || dz.Len() == 0 {
			return option.None
		}
		(a.Value, zs[0], (tui.Box(d, da.Value), tui.Box(d, dz[0])))
	case _:
		return option.None
	}
	let (ab, zb) = mine
	let r = ui.Rect{X: ui.Length(float64(zb.X-ab.X) * 8), Y: ui.Length(float64(zb.Y-ab.Y) * cellH), W: ui.Length(float64(zb.Width) * 8), H: ui.Length(float64(zb.Height) * cellH)}
	if x >= float64(r.X) && x < float64(r.X+r.W) && y >= float64(r.Y) && y < float64(r.Y+r.H) {
		return option.Some{Value: zoned[E]{area: area, zone: zone, box: r}}
	}
	option.None
}

// found is whether TestHost holds a node labelled label.
func found[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], label string) result {
	match ui.Find(h, label) {
	case option.Some[ui.Id[E]]:
		Done
	case option.None:
		Missing{Label: label}
	}
}

// landed is b, unless the list labelled label is not where a step that
// scrolled it to offset to left it: at to, or as far as its content goes.
func landed[E comparable, S, D, F](d mut tui.Driver[S, E, D, F], label string, b result, to float64) result {
	match (b, tui.Viewport(d, label)) {
	case (Done, option.Some[ui.Viewport] as v):
		let most = maxOffset(tui.Screen(d), label, float64(v.Value.Height))
		let want = if to < most { to } else { most }
		if float64(v.Value.Offset) != want {
			return Broke{Why: "scrolled to \(float64(v.Value.Offset)), want \(want)"}
		}
		b
	case _:
		b
	}
}

func atoi(s string) int {
	strconv.Atoi(s) catch {
	// ergo-lint-disable-next-line silent-catch -- a count that is no number is no Tab
	case strconv.Malformed, strconv.OutOfRange:
		0
	}
}

// both plays one act on each host.
func both[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut tui.Driver[S, E, D, F], act ui.Act) (result, result) needs go.Foreign {
	let a = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
		try ui.Play(h, []ui.Act{act})
	})
	let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
		try tui.Play(d, []ui.Act{act})
	})
	(a, b)
}

func played(f func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign) result needs go.Foreign {
	f() catch {
	case ui.NoNode as n:
		return Missing{Label: n.Label}
	case ui.Mismatch as m:
		return Broke{Why: "want \(m.Want), got \(m.Got)"}
	case ui.Ambiguous as x:
		return Broke{Why: "\(x.Count) nodes are \(x.At)"}
	case actor.Stopped:
		return Broke{Why: "stopped"}
	case ui.BadPatch as b:
		return Broke{Why: b.Why}
	case ui.Closed:
		return Broke{Why: "closed"}
	case tui.ScreenFailed as e:
		return Failed{Failure: e}
	}
	Done
}

// focusOrder is the label of each node Tab visits in shapes, in tree
// order: a Pressable, a Check, a Toggle or an Input, none under a
// disabled Fieldset.
func focusOrder[E](shapes []ui.Shape[E], into []option.Option[string]) []option.Option[string] {
	let mut out = into
	for sh in shapes {
		match sh.Node {
		case ui.FieldsetNode as x:
			if x.Disabled {
				continue
			}
		case ui.PressableNode[E], ui.CheckNode[E], ui.ToggleNode, ui.InputNode:
			out = out.Append(labelOfNode(sh.Node))
		case ui.SemanticNode[E]:
			// ui.Focusable: a Semantic that sends and is not disabled.
			if ui.Focusable(sh.Node) {
				out = out.Append(labelOfNode(sh.Node))
			}
		case ui.BoxNode, ui.RowNode, ui.ColumnNode, ui.ScrollNode, ui.TextNode, ui.AreaNode, ui.CanvasNode, ui.RowsNode, ui.ZoneNode, ui.LiveNode, ui.TransitionNode, ui.ReadoutNode, ui.LayerNode[E], ui.TrackNode:
		}
		out = focusOrder[E](sh.Kids, out)
	}
	out
}

// twin is TestHost's node of the terminal's node n (id on the terminal):
// the first with n's label. An Id is the host's (an arena's place), so a
// row a list wrote in other passes on the two hosts has another Id.
func twin[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], n ui.Node[E], id ui.Id[E]) ui.Id[E] {
	match n {
	case ui.SemanticNode[E] as x:
		// A Semantic has no label: its role and name find it.
		let ids = ui.Locate(h, ui.WithRole{Role: x.Access.Role, Name: x.Access.Name})
		if ids.Len() > 0 {
			return ids[0]
		}
		return id
	case _:
	}
	match labelOfNode(n) {
	case option.Some[string] as l:
		match ui.Find(h, l.Value) {
		case option.Some[ui.Id[E]] as t:
			t.Value
		case option.None:
			id
		}
	case option.None:
		id
	}
}

// labelOfNode is the label of a node that takes the focus.
func labelOfNode[E](n ui.Node[E]) option.Option[string] {
	match n {
	case ui.PressableNode[E] as x:
		option.Some{Value: x.Label}
	case ui.CheckNode[E] as x:
		option.Some{Value: x.Label}
	case ui.ToggleNode as x:
		option.Some{Value: x.Label}
	case ui.InputNode as x:
		option.Some{Value: x.Placeholder}
	case ui.SemanticNode[E] as x:
		// its accessible name, which twin finds it by
		option.Some{Value: x.Access.Name}
	case ui.BoxNode, ui.RowNode, ui.ColumnNode, ui.ScrollNode, ui.TextNode, ui.AreaNode, ui.CanvasNode, ui.RowsNode, ui.FieldsetNode, ui.ZoneNode, ui.LiveNode, ui.TransitionNode, ui.ReadoutNode, ui.LayerNode[E], ui.TrackNode:
		option.None
	}
}

func named(l option.Option[string]) string {
	match l {
	case option.Some[string] as s:
		"\"\(s.Value)\""
	case option.None:
		"none"
	}
}

// focusPress clears the focus with a click on the screen's last cell
// (empty in every app), moves it with Tab k times and presses the focused
// node with Enter (types "z" into a field); TestHost presses (or types
// into) the node the terminal focused. The focus order is the tree's:
// after k Tabs the focus is on the (k-1 mod n)-th of the n focusable
// nodes.
func focusPress[E comparable, S, D, F](h mut ui.TestHost[S, E, D, F], d mut tui.Driver[S, E, D, F], s go.Ref[screen.Screen], k int) (result, result) needs go.Foreign {
	let (cx, cy) = (s.Cols() - 1, s.Lines() - 1)
	// The click is a pointer event on both hosts (OT-PHASES): where no node
	// takes the mouse it is TestHost's click nowhere (the hover leaves every
	// Area); on an Area that fills the screen (drag) it is that Area's Down
	// and Up at the same place.
	let hit = tui.TargetAt(d, cx, cy)
	let mut keys = tui.Click(cx, cy)
	for _ in 0..k {
		keys = keys + "\t"
	}
	let b = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
		try tui.Send(d, keys)
	})
	match b {
	case Failed:
		return (Done, b)
	case _:
	}
	let clicked = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
		match hit {
		case option.Some[(ui.Id[E], ui.Node[E])] as t:
			let (id, n) = t.Value
			let box = tui.Box(d, id)
			// An Area is found by its label (twin finds focusable nodes).
			let at = match n {
			case ui.AreaNode as a:
				match ui.Find(h, a.Label) {
				case option.Some[ui.Id[E]] as f:
					f.Value
				case option.None:
					return ui.NoNode{Label: a.Label}
				}
			case _:
				twin(h, n, id)
			}
			let x = float64(cx-box.X) * 8
			let y = float64(cy-box.Y) * cellH
			try ui.PointAt(h, at, ui.PointerEvent{Pointer: ui.MousePointer, Phase: ui.Down, X: x, Y: y, Zone: option.None})
			try ui.PointAt(h, at, ui.PointerEvent{Pointer: ui.MousePointer, Phase: ui.Up, X: x, Y: y, Zone: option.None})
		case option.None:
			try ui.ClickNowhere(h)
		}
	})
	match clicked {
	case Done:
	case _:
		return (clicked, b)
	}
	// The order is TestHost's tree's, not the driver's.
	let order = focusOrder(ui.Screen(h), []option.Option[string]{})
	let mut want option.Option[string] = option.None
	if k > 0 && order.Len() > 0 {
		want = order[(k-1)%order.Len()]
	}
	let got = match tui.FocusNode(d) {
	case option.Some[ui.Node[E]] as n:
		labelOfNode(n.Value)
	case option.None:
		option.None
	}
	if (k > 0 && order.Len() > 0 && got != want) || ((k == 0 || order.Len() == 0) && tui.FocusId(d) != option.None) {
		return (Done, Broke{Why: "after \(k) Tabs the focus is on \(named(got)), not on \(named(want)), the node it reaches in tree order (of \(order.Len()))"})
	}
	match (tui.FocusId(d), tui.FocusNode(d)) {
	case (option.Some[ui.Id[E]] as id, option.Some[ui.Node[E]] as n):
		match n.Value {
		case ui.InputNode as x:
			let b2 = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
				try tui.Send(d, "z")
			})
			let a = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
				try ui.TypeText(h, twin(h, n.Value, id.Value), x.Value+"z")
			})
			return (a, b2)
		case _:
			let b2 = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
				try tui.Send(d, "\r")
			})
			let a = played(func() fails ui.NoNode | ui.Ambiguous | actor.Stopped | ui.BadPatch | ui.Closed | ui.Mismatch | tui.ScreenFailed needs go.Foreign {
				// Enter presses the focused node with no pointer, so the
				// hover stays where it was: TestHost's press that leaves the
				// hover is a finger's (TapWith, MB4), not the mouse's Tap.
				try ui.TapWith(h, twin(h, n.Value, id.Value), ui.Pointer{Id: 1, Kind: ui.Finger})
			})
			return (a, b2)
		}
	case _:
	}
	(Done, b)
}
