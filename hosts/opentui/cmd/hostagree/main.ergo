// hostagree runs one app's scene script on ui.TestHost and, through a
// headless OpenTUI screen, on the terminal driver, and prints after each
// step whether they agree: the same tree and the same app state, and each
// text's words in the screen's cells on the rows of its box.
// TestTuiHostAgreesWithTestHost writes the scripts.
//
// Standard input: the app's name on the first line (counter, shelf, form,
// load, lock, pad, list, sketch, spin, drag or pane), then one step a line:
//
//	tap LABEL         a mouse press and release on the node labelled LABEL
//	type LABEL TEXT   set the field's text (TAB between LABEL and TEXT)
//	key NAME          a key: the view's OnKey takes it ("+", "-", "x"), or,
//	                  a character with a field focused, the field does
//	point LABEL PHASE X Y  a pointer (down, up, move, wheel) on an Area, at
//	                  X, Y DIPs in its box (a wheel of DY Y)
//	scroll LABEL N    scroll the list LABEL to offset N (DIPs; TestHost
//	                  takes the viewport the terminal reports)
//	wheel LABEL K     K turns of the wheel at the list's centre (K < 0 up)
//	focus K           Tab K times, then press the focused node with Enter
//	                  (a field gets "z" typed); TestHost presses the same node
//	settle            settle the loads
//	frames N          move the time N frames of 16ms (Ticks while the view animates)
//	cost STEP         STEP, then "cost N bytes M": the library calls it made
//	                  and the bytes it wrote
//
// Output: "ok N" or "differ N: …" per step, then "end".
//
// A first line "fail AT STATUS" makes the screen's AT-th check fail with
// the library status STATUS (screen.FailAt): the run stops at the
// failure with a line "failed …". After the app, every such run prints
// the checks the screen passed ("check CALL NODE", in order) and "live
// N", the screens not quit (TestTuiFailuresAgree).

import go ergo.local/prototype/hosts/opentui/screen
import io
import slices
import strings
import time

func main() needs Console | Ambient | go.Foreign {
	with context { io.Stdin: io.NewStdin(), Scheduler: time.NewManual(0) } {
		let text = io.Stdin.ReadAll() catch {
		case io.ReadFailed:
			Console.Println("differ 0: no input")
			return
		}
		let mut lines = strings.Split(strings.TrimSpace(text), "\n")
		let faulted = strings.HasPrefix(lines[0], "fail ")
		if faulted {
			let f = strings.Fields(lines[0])
			screen.FailAt(atoi(f[1]), atoi(f[2]))
			lines = slices.Slice(lines, 1, len(lines))
		}
		let steps = slices.Slice(lines, 1, len(lines))
		play(lines[0], steps)
		if faulted {
			for c in screen.Checks() {
				Console.Println("check \(c.Call) \(c.Node)")
			}
			Console.Println("live \(screen.Live())")
		}
	}
}

// play runs the app named app on steps.
func play(app string, steps []string) needs Console | Scheduler | go.Foreign {
		match strings.TrimSpace(app) {
		case "counter":
			agree(counterMachine(), counterView, func(a int, b int) bool { a == b }, steps)
		case "shelf":
			agree(shelfMachine(), shelfView, sameShelf, steps)
		case "form":
			agree(formMachine(), formView, func(a form, b form) bool { a == b }, steps)
		case "load":
			agree(loadMachine(), loadView, func(a chosen, b chosen) bool { a == b }, steps)
		case "lock":
			agree(lockMachine(), lockView, func(a lock, b lock) bool { a == b }, steps)
		case "pad":
			agree(padMachine(), padView, func(a pad, b pad) bool { a == b }, steps)
		case "list":
			agree(rowsMachine(), rowsView, func(a rowsApp, b rowsApp) bool { a == b }, steps)
		case "sketch":
			agree(sketchMachine(), sketchView, func(a sketch, b sketch) bool { a == b }, steps)
		case "pane":
			agree(paneMachine(), paneView, func(a pane, b pane) bool { a == b }, steps)
		case "drag":
			agree(dragMachine(), dragView, func(a drag, b drag) bool { a == b }, steps)
		case "spin":
			agree(spinMachine(), spinView, func(a spin, b spin) bool { a == b }, steps)
		case "choice":
			agree(choiceMachine(), choiceView, func(a choice, b choice) bool { a == b }, steps)
		case "reading":
			agree(readingMachine(), readingView, func(a reading, b reading) bool { a == b }, steps)
	case _:
		Console.Println("differ 0: no app \(app)")
	}
}
