// The spin app: frames. "go" starts a spin of 12 frames; each frame's
// Tick counts one, and the view shows the count in fours, so three frames
// in four change nothing on the screen. When the count reaches 12 the view
// stops animating, and the screen settles.

import machines
import option
import ui

type spin { n int, on bool }

// The signals: -1 is "go", a count is a frame's.
func spinStep(s spin, e int) machines.Decision[spin, int] {
	if e == -1 {
		return machines.Enter[spin]{Next: spin{n: 0, on: true}}
	}
	machines.Enter[spin]{Next: spin{n: s.n + 1, on: s.n+1 < 12}}
}

func spinMachine() machines.Machine[spin, int, int] {
	machines.Machine[spin, int, int]{Initial: spin{n: 0, on: false}, Step: spinStep, After: none[spin, int], Work: idle[spin, int], Exit: func(s spin) option.Option[func()] { option.None }}
}

func spinView(f mut ui.Frame[int], s spin) {
	if s.on {
		ui.Animate(f, func(at duration) int { 0 })
	}
	ui.Text(f, "spin \(s.n / 4)")
	ui.Pressable(f, "go", -1) {
		ui.Text(f, "Go")
	}
}
