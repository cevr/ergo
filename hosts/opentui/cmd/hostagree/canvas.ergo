// The canvas app, as hosts/mygo's hostagree has it, and the check that a
// canvas's last opaque fill colors the cell at its centre.

import go ergo.local/prototype/hosts/opentui/screen
import ergo.local/prototype/hosts/opentui/tui
import ui

// sketch: a canvas in an Area; a press puts a mark where it went down,
// kept 24 DIPs inside the canvas. The paint is a filled background, a
// stroke from the corner to the mark, a filled circle, and last the mark:
// two squares wound the same way that overlap at its centre (a hole there
// under the even-odd rule), moved there by a transform.
type sketch { x int, y int, n int }

func sketchStep(s sketch, e int) Decision[sketch, int] {
	let x = e % 1000
	let y = e / 1000
	Enter[sketch]{Next: sketch{x: if x < 24 { 24 } else if x > 176 { 176 } else { x }, y: if y < 24 { 24 } else if y > 126 { 126 } else { y }, n: s.n + 1}}
}

func sketchMachine() Machine[sketch, int, int] {
	Machine[sketch, int, int]{Initial: sketch{x: 100, y: 75, n: 0}, Step: sketchStep, After: none[sketch, int], Work: idle[sketch, int], Exit: func(s sketch) Option[func()] { None }}
}

func sketchView(f mut ui.Frame[int], s sketch) {
	ui.Text(f, "mark \(s.x),\(s.y) of \(s.n)")
	ui.Area(f, "sketch", ui.Plain(), func(p ui.PointerEvent) Option[int] {
		match p.Phase {
		case ui.Down:
			Some{Value: int(p.X) + 1000*int(p.Y)}
		case _:
			None
		}
	}) {
		ui.Canvas(f, "ink", 200, 150) func(p mut ui.Paint) {
			ui.Fill(p, ui.RectPath(0, 0, 200, 150), ui.Color{R: 240, G: 240, B: 240, A: 255})
			let mx = float64(s.x)
			let my = float64(s.y)
			ui.Stroke(p, ui.Path{Segs: []ui.Seg{ui.MoveTo{X: 0, Y: 0}, ui.LineTo{X: mx, Y: my}}}, ui.Color{R: 30, G: 90, B: 200, A: 255}, 3)
			let r = float64(10 + s.n%3*5)
			let k = 0.5523 * r
			let cx = 200 - mx
			let cy = 150 - my
			ui.Fill(p, ui.Path{Segs: []ui.Seg{
				ui.MoveTo{X: cx + r, Y: cy},
				ui.CubicTo{C1X: cx + r, C1Y: cy + k, C2X: cx + k, C2Y: cy + r, X: cx, Y: cy + r},
				ui.CubicTo{C1X: cx - k, C1Y: cy + r, C2X: cx - r, C2Y: cy + k, X: cx - r, Y: cy},
				ui.CubicTo{C1X: cx - r, C1Y: cy - k, C2X: cx - k, C2Y: cy - r, X: cx, Y: cy - r},
				ui.CubicTo{C1X: cx + k, C1Y: cy - r, C2X: cx + r, C2Y: cy - k, X: cx + r, Y: cy},
				ui.ClosePath,
			}}, ui.Color{R: 40, G: 160, B: 90, A: 255})
			ui.Transformed(p, ui.Translate(mx, my)) {
				ui.Fill(p, ui.Path{Segs: []ui.Seg{
					ui.MoveTo{X: -20, Y: -16}, ui.LineTo{X: 12, Y: -16}, ui.LineTo{X: 12, Y: 16}, ui.LineTo{X: -20, Y: 16}, ui.ClosePath,
					ui.MoveTo{X: -12, Y: -16}, ui.LineTo{X: 20, Y: -16}, ui.LineTo{X: 20, Y: 16}, ui.LineTo{X: -12, Y: 16}, ui.ClosePath,
				}}, ui.Color{R: 200, G: 40, B: 40, A: 255})
			}
		}
	}
}

// probe is where a canvas's last op shows its color, in DIPs from the
// canvas's corner: when the last op that is not a PopPaint is an opaque
// fill of straight lines, the centre of the box around its points.
type probe { x float64, y float64, color ui.Color }

func probeOf(ops []ui.PaintOp) Option[probe] {
	let mut m = ui.Identity()
	let mut stack = []ui.Affine{}
	let mut last Option[probe] = None
	for op in ops {
		match op {
		case ui.FillOp as x:
			last = None
			if x.Color.A == 255 && len(x.Path.Segs) > 0 {
				let mut lo = (0.0, 0.0)
				let mut hi = (0.0, 0.0)
				let mut first = true
				for s in x.Path.Segs {
					let (px, py) = match s {
					case ui.MoveTo as p:
						(p.X, p.Y)
					case ui.LineTo as p:
						(p.X, p.Y)
					case _:
						continue
					}
					let (ax, ay) = (m.A*px + m.C*py + m.E, m.B*px + m.D*py + m.F)
					if first {
						lo = (ax, ay)
						hi = (ax, ay)
						first = false
					}
					let (lx, ly) = lo
					let (hx, hy) = hi
					lo = (if ax < lx { ax } else { lx }, if ay < ly { ay } else { ly })
					hi = (if ax > hx { ax } else { hx }, if ay > hy { ay } else { hy })
				}
				let (lx, ly) = lo
				let (hx, hy) = hi
				last = Some{Value: probe{x: (lx + hx) / 2, y: (ly + hy) / 2, color: x.Color}}
			}
		case ui.StrokeOp, ui.PushClip:
			last = None
		case ui.PushTransform as x:
			stack = stack.Append(m)
			m = ui.Affine{A: m.A*x.M.A + m.C*x.M.B, B: m.B*x.M.A + m.D*x.M.B, C: m.A*x.M.C + m.C*x.M.D, D: m.B*x.M.C + m.D*x.M.D, E: m.A*x.M.E + m.C*x.M.F + m.E, F: m.B*x.M.E + m.D*x.M.F + m.F}
		case ui.PopPaint:
			if len(stack) > 0 {
				m = stack[len(stack)-1]
				stack = stack[:len(stack)-1]
			}
		}
	}
	last
}

// inked is why a canvas does not show its last fill, None when each does:
// the cell under the probe of each canvas the terminal holds shows the
// fill's color (a full block's foreground, or a space's background).
func inked[E comparable, S, D, F](d mut tui.Driver[S, E, D, F], s go.Ref[screen.Screen], shapes []ui.Shape[E]) Option[string] needs go.Foreign {
	for sh in shapes {
		match sh.Node {
		case ui.CanvasNode as x:
			match (probeOf(x.Paint), tui.Number(d, x.Label)) {
			case (Some[probe] as p, Some[int] as n):
				let b = s.BoxOf(n.Value)
				let cx = b.X + int(p.Value.x/8)
				let cy = b.Y + int(p.Value.y/cellH)
				let c = s.Cell(cx, cy)
				let want = uint32(p.Value.color.R)<<24 | uint32(p.Value.color.G)<<16 | uint32(p.Value.color.B)<<8 | uint32(p.Value.color.A)
				let got = if c.Text == "█" { c.Fg } else { c.Bg }
				if got != want || (c.Text != "█" && c.Text != " " && c.Text != "") {
					return Some{Value: "canvas \(x.Label): cell \(cx),\(cy) shows \(c.Text) fg \(c.Fg) bg \(c.Bg), want the color \(want)"}
				}
			case _:
			}
		case _:
			match inked[E, S, D, F](d, s, sh.Kids) {
			case Some[string] as why:
				return Some{Value: why.Value}
			case None:
			}
		}
	}
	None
}
