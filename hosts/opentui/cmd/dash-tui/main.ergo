// dash-tui is examples/dash-gui in a terminal: the example's dashboard app
// and view (a required Ergo module, hosts/opentui/go.mod) on the OpenTUI
// driver. It is the only place that chooses: the seeded synthetic sensors,
// and the terminal and the live clock, or, with -headless, a screen with
// no terminal that plays a scene script from standard input and prints
// what the example's own `dash-gui scene` prints.
//
//	dash-tui [-seed S]                       run in the terminal (Ctrl+C quits)
//	dash-tui -headless [-seed S] [-frames N] play the script
//
// The view animates, so the driver steps a frame each period while it
// does, and each frame the app takes a Next. Headless, the frames are the
// script's: `frames N` moves the driver's time N frames of a 120th of a
// second (each one a Tick), with the notes each frame makes after it;
// `tap LABEL` clicks the button; `show` prints the screen's text nodes.
// -frames N moves N frames before the script. shot, the scene's
// screenshot of ui.TestHost, is not a terminal command.

import actor
import ergo.local/prototype/examples/dashgui/feed
import dash ergo.local/prototype/examples/dashgui/screen
import ergo.local/prototype/examples/dashgui/script
import ergo.local/prototype/examples/dashgui/synth
import ergo.local/prototype/hosts/opentui/tui
import go ergo.local/prototype/hosts/opentui/screen
import io
import machines
import os
import queue
import strconv
import strings
import sync
import term
import time
import ui

let Usage = "usage: dash-tui [-headless [-frames N]] [-seed S]"

// Cols and Lines are the headless screen: dash-gui's window of 900 by
// 1400 DIPs at 8 by 16 DIPs a cell (the twelve panels in a column).
let Cols = 113

let Lines = 88

// opts is what the arguments chose.
type opts { headless bool, seed int, frames int }

func parse(args []string) opts fails os.Exit {
	let mut o = opts{headless: false, seed: 1, frames: 0}
	let mut i = 0
	for i < args.Len() {
		let a = args[i]
		if a == "-headless" {
			o.headless = true
		} else if (a == "-seed" || a == "-frames") && i+1 < args.Len() {
			i = i + 1
			let n = strconv.Atoi(args[i]) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return os.Exit{Code: 2, Message: Usage}
			}
			if a == "-seed" {
				o.seed = n
			} else if n < 0 {
				return os.Exit{Code: 2, Message: Usage}
			} else {
				o.frames = n
			}
		} else {
			return os.Exit{Code: 2, Message: Usage}
		}
		i = i + 1
	}
	if o.frames > 0 && !o.headless {
		return os.Exit{Code: 2, Message: Usage}
	}
	o
}

func main() fails os.Exit needs os.Ambient | go.Foreign {
	let o = try parse(with context { os.Process: os.NewHost() } { os.Process.Args() })
	if o.headless {
		try headless(o)
		return
	}
	with context { time.Scheduler: time.NewLiveScheduler(), term.Terminal: term.NewHost(), feed.Sensors: synth.Bank{Seed: o.seed} } {
		let a = actor.StartMachine(machines.Start(dash.App{}, feed.NewBoard()), 8, func(n []feed.Notice) {})
		tui.RunTerminal(a, dash.View, tui.DefaultOptions()) catch {
		// ergo-lint-disable-next-line silent-catch -- the app stopped: the program ends as the example's own binary does
		case actor.Stopped:
		case term.NotTerminal:
			return os.Exit{Code: 1, Message: "dash-tui: standard input is not a terminal (try -headless)"}
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "dash-tui: \(b.Why)"}
		case tui.ScreenFailed as e:
			return os.Exit{Code: 1, Message: "dash-tui: \(e.Why)"}
		}
	}
}

// headless plays the scene script on standard input through a screen with
// no terminal and prints what the scene prints.
func headless(o opts) fails os.Exit needs os.Ambient | go.Foreign {
	let input = io.NewStdin().ReadAll() catch {
	case io.ReadFailed:
		return os.Exit{Code: 1, Message: "dash-tui: cannot read the script"}
	}
	let out = io.NewHost()
	with context { time.Scheduler: time.NewManual(0), feed.Sensors: synth.Bank{Seed: o.seed} } {
		tui.Headless(Cols, Lines, func(s go.Ref[screen.Screen]) fails os.Exit needs time.Scheduler | feed.Sensors | go.Foreign {
			let notes = sync.NewRef[[]feed.Notice]([]feed.Notice{})
			let a = actor.StartMachine(machines.Start(dash.App{}, feed.NewBoard()), 8, func(ns []feed.Notice) {
				notes.Update(func(old []feed.Notice) []feed.Notice {
					let mut all = old
					for n in ns {
						all = all.Append(n)
					}
					all
				})
			})
			let mut d = tui.New(s, a, dash.View, 8) catch {
			case ui.BadPatch as b:
				return os.Exit{Code: 1, Message: "dash-tui: \(b.Why)"}
			case tui.ScreenFailed as e:
				return os.Exit{Code: 1, Message: "dash-tui: \(e.Why)"}
			}
			tui.FrameEvery(&d, script.Period)
			try run(&d, o.frames, notes, out)
			for line in strings.Split(input, "\n") {
				let l = strings.TrimSuffix(line, "\r")
				if l == "" || strings.HasPrefix(l, "#") || l == "shot" {
					continue
				}
				let words = strings.Split(l, " ")
				match words[0] {
				case "frames":
					let n = strconv.Atoi(if words.Len() == 2 { words[1] } else { "" }) catch {
					case strconv.Malformed, strconv.OutOfRange:
						out.Println("? \"" + l + "\": want frames N")
						continue
					}
					if n < 0 {
						out.Println("? \"" + l + "\": want frames N")
						continue
					}
					try run(&d, n, notes, out)
				case "tap":
					tui.Play(&d, []ui.Act{ui.TapOn{Label: strings.TrimPrefix(l, "tap ")}}) catch {
					case ui.NoNode as x:
						out.Println("? no node " + x.Label)
					case ui.Ambiguous as amb:
						out.Println("? " + amb.At + " finds \(amb.Count) nodes")
					case ui.Mismatch as miss:
						out.Println("? want " + miss.Want + ", got " + miss.Got)
					case ui.Closed, actor.Stopped:
						return os.Exit{Code: 1, Message: "dash-tui: the app stopped"}
					case ui.BadPatch as b:
						return os.Exit{Code: 1, Message: "dash-tui: the view's patch did not apply: " + b.Why}
					case tui.ScreenFailed as e:
						return os.Exit{Code: 1, Message: "dash-tui: \(e.Why)"}
					}
				case "show":
					for t in script.Texts(tui.Screen(&d)) {
						out.Println(t)
					}
				case _:
					out.Println("? \"" + l + "\": want frames, tap, show or shot")
				}
			}
			// The board's queues are made fresh each frame and never ended, so
			// the app's step cannot fail with queue.Closed.
			a.Stop() catch {
			case queue.Closed:
			}
		}) catch {
		case os.Exit as x:
			return x
		case tui.ScreenFailed as e:
			return os.Exit{Code: 1, Message: "dash-tui: \(e.Why)"}
		}
	}
}

// run moves the driver's time n frames, a Tick each, and prints the notes
// each frame makes after it.
func run[D, F](d mut tui.Driver[dash.Dash, dash.Signal, D, F], n int, notes sync.Ref[[]feed.Notice], out io.Host) fails os.Exit needs go.Foreign {
	for _ in 0..n {
		tui.Advance(d, script.Period) catch {
		case actor.Stopped:
			return os.Exit{Code: 1, Message: "dash-tui: the app stopped"}
		case ui.BadPatch as b:
			return os.Exit{Code: 1, Message: "dash-tui: the view's patch did not apply: " + b.Why}
		case tui.ScreenFailed as e:
			return os.Exit{Code: 1, Message: "dash-tui: \(e.Why)"}
		}
		for x in notes.Get() {
			out.Println(script.Note(x))
		}
		notes.Set([]feed.Notice{})
	}
}
