// The package apply is the design model of how the code Api applies a
// plan to the files of a workspace (SEMTOOLS plan, unit ST5; design.md
// "Compiler-backed MCP and semantic editing"). Checked by
// `ergo test <this folder>`: a breadth-first search of every state in the
// scope below.
//
// The world: two source files, one applier, one outside writer (an editor
// or another agent that does not use the Api). A file's content is Old
// (what the plan was made from), New (what the plan writes) or Out (an
// outside write). Each step is one atomic act:
//
//	applier Act:   in order: read both files and refuse when one is not
//	               Old; write the journal (intent); write one temporary
//	               file per source file, holding New; then for each file
//	               EXCHANGE the temporary file and the source path (one
//	               system call: renameat2 RENAME_EXCHANGE) and VERIFY that
//	               what came out is Old; when both came out Old, write the
//	               commit record; then remove the temporary files and the
//	               journal. A verify that finds anything else starts the
//	               restore.
//	restore:       while the journal says intent, for the first file that
//	               has a temporary file: it holds New: remove it. It holds
//	               Old: when the path holds New, exchange (a decision and
//	               then the exchange: two acts), otherwise remove it. It
//	               holds Out: exchange, so the outside write is at its
//	               path again. No temporary file left: remove the journal.
//	               The rule reads only what is on disk, so a restore that
//	               stops half way starts again from the top.
//	Crash:         the applier dies between two acts and forgets what it
//	               had decided.
//	Recover:       the next start reads the journal: none: nothing was
//	               applied. Intent: restore. Committed: remove the
//	               temporary files and the journal; the plan is applied.
//	outside Write: at any time, once per file, a file's path gets Out.
//
// The invariants, checked when the applier has ended or recovered:
//
//   - NoLostEdit: a file that got an outside write holds it.
//   - AllOrNothing: the files with no outside write are all New when the
//     outcome is applied, and all Old when it is refused.
//   - Clean: no temporary file and no journal is left.
//
// Mutants, each a machine whose law Breaks must hold:
//   - CheckThenRename: the applier keeps a copy of what it read and
//     renames New over the path (no exchange), so an outside write between
//     the read and the rename is overwritten.
//   - NoJournal: no intent record, so a crash between two exchanges
//     leaves one file New and one Old with nothing to restore from.
//   - BlindRestore: the restore renames the Old temporary file over the
//     path without reading the path, so an outside write that came after
//     the exchange is overwritten.
//   - CommitEarly: the commit record is written with the intent, so a
//     crash before the last exchange is recovered as applied.
//
// Witnesses, each a machine whose law Exists must hold: a plan is applied;
// a verify finds an outside write and the applier restores; a crash after
// an exchange is recovered to Old; a crash after the commit record is
// recovered to New.
//
// Scope: two files, one applier whose restore may crash and start again
// any number of times, at most one outside write per file. "proved" means
// proved in this scope. Outside it: two outside writes to one file inside
// one apply (the restore rule cannot tell which of two unknown contents
// is the later one), and a writer that keeps a file open across the apply
// and writes later through the old descriptor.

type File = F0{} | F1{}

type Signal = Act{} | Crash{} | Recover{} | Write{F File}

type World {
	Path    []int,
	Temp    []int,
	Jrn     int,
	Pc      int,
	Pend    int,
	Wrote   []int,
	Outcome int,
	Crashed bool,
	Rolled  bool,
	Swapped bool,
}

type State = Live{W World} | Broken{Why string} | Applied{} | RolledBack{} | RecoveredBack{} | RecoveredForward{}

func initial() State {
	return Live{W: World{Path: []int{0, 0}, Temp: []int{-1, -1}, Jrn: 0, Pc: 0, Pend: -1,
		Wrote: []int{0, 0}, Outcome: 0, Crashed: false, Rolled: false, Swapped: false}}
}

func file(f File) int {
	match f {
	case F0:
		return 0
	case F1:
		return 1
	}
}

func exchange(w World, i int) World {
	let mut out = w
	let t = out.Path[i]
	out.Path[i] = out.Temp[i]
	out.Temp[i] = t
	return out
}

func ended(w World) bool {
	return w.Pc == 20 || w.Pc == 21
}

func settled(w World) string {
	if !ended(w) {
		return ""
	}
	for i in []int{0, 1} {
		if w.Wrote[i] == 1 && w.Path[i] != 2 {
			return "NoLostEdit"
		}
	}
	for i in []int{0, 1} {
		if w.Wrote[i] == 0 && w.Outcome == 1 && w.Path[i] != 1 {
			return "AllOrNothing"
		}
		if w.Wrote[i] == 0 && w.Outcome == 2 && w.Path[i] != 0 {
			return "AllOrNothing"
		}
	}
	if w.Temp[0] != -1 || w.Temp[1] != -1 || w.Jrn != 0 {
		return "Clean"
	}
	return ""
}

func restore(w World, mutant int) World {
	let mut out = w
	if out.Jrn == 0 {
		out.Outcome = 2
		out.Pc = 21
		return out
	}
	if out.Jrn == 2 {
		out.Temp[0] = -1
		out.Temp[1] = -1
		out.Jrn = 0
		out.Outcome = 1
		out.Pc = 20
		return out
	}
	if out.Pend != -1 {
		let i = out.Pend
		out = exchange(out, i)
		out.Pend = -1
		return out
	}
	for i in []int{0, 1} {
		let t = out.Temp[i]
		if t == -1 {
			continue
		}
		if t == 1 {
			out.Temp[i] = -1
		} else if t == 0 {
			if mutant == 3 {
				out.Path[i] = 0
				out.Temp[i] = -1
			} else if out.Path[i] == 1 {
				out.Pend = i
			} else {
				out.Temp[i] = -1
			}
		} else {
			out = exchange(out, i)
		}
		return out
	}
	out.Jrn = 0
	out.Outcome = 2
	out.Pc = 21
	return out
}

func put(w World, i int, mutant int) World {
	if mutant == 1 {
		let mut out = w
		out.Path[i] = 1
		out.Temp[i] = 0
		return out
	}
	return exchange(w, i)
}

func step(s State, event Signal, mutant int, witness int) Decision[State, string] {
	match s {
	case Live as l:
		let mut w = l.W
		match event {
		case Write as wr:
			let i = file(wr.F)
			if w.Wrote[i] == 1 {
				return Ignore
			}
			w.Wrote[i] = 1
			w.Path[i] = 2
		case Crash:
			if w.Pc > 10 {
				return Ignore
			}
			w.Pc = 30
			w.Pend = -1
			w.Crashed = true
		case Recover:
			if w.Pc != 30 {
				return Ignore
			}
			w.Pc = 10
		case Act:
			if w.Pc == 0 {
				if w.Path[0] != 0 || w.Path[1] != 0 {
					w.Outcome = 2
					w.Pc = 21
				} else {
					w.Pc = 1
				}
			} else if w.Pc == 1 {
				if mutant != 2 {
					w.Jrn = 1
				}
				if mutant == 4 {
					w.Jrn = 2
				}
				w.Pc = 2
			} else if w.Pc == 2 {
				w.Temp[0] = 1
				w.Pc = 3
			} else if w.Pc == 3 {
				w.Temp[1] = 1
				w.Pc = 4
			} else if w.Pc == 4 {
				w = put(w, 0, mutant)
				w.Swapped = true
				w.Pc = 5
			} else if w.Pc == 5 {
				if w.Temp[0] == 0 {
					w.Pc = 6
				} else {
					w.Rolled = true
					w.Pc = 10
				}
			} else if w.Pc == 6 {
				w = put(w, 1, mutant)
				w.Pc = 7
			} else if w.Pc == 7 {
				if w.Temp[1] == 0 {
					w.Pc = 8
				} else {
					w.Rolled = true
					w.Pc = 10
				}
			} else if w.Pc == 8 {
				w.Jrn = 2
				w.Pc = 9
			} else if w.Pc == 9 {
				w.Temp[0] = -1
				w.Temp[1] = -1
				w.Jrn = 0
				w.Outcome = 1
				w.Pc = 20
			} else if w.Pc == 10 {
				w = restore(w, mutant)
			} else {
				return Ignore
			}
		}
		let why = settled(w)
		if why != "" {
			return Enter{Broken{Why: why}}
		}
		if witness == 1 && w.Pc == 20 && !w.Crashed && w.Wrote[0] == 0 && w.Wrote[1] == 0 {
			return Enter{Applied}
		}
		if witness == 2 && w.Pc == 21 && w.Rolled && !w.Crashed {
			return Enter{RolledBack}
		}
		if witness == 3 && w.Pc == 21 && w.Crashed && w.Swapped {
			return Enter{RecoveredBack}
		}
		if witness == 4 && w.Pc == 20 && w.Crashed {
			return Enter{RecoveredForward}
		}
		return Enter{Live{W: w}}
	case _:
		return Ignore
	}
}

func design(s State, sig Signal) Decision[State, string]          { return step(s, sig, 0, 0) }
func checkThenRename(s State, sig Signal) Decision[State, string] { return step(s, sig, 1, 0) }
func noJournal(s State, sig Signal) Decision[State, string]       { return step(s, sig, 2, 0) }
func blindRestore(s State, sig Signal) Decision[State, string]    { return step(s, sig, 3, 0) }
func commitEarly(s State, sig Signal) Decision[State, string]     { return step(s, sig, 4, 0) }
func applied(s State, sig Signal) Decision[State, string]         { return step(s, sig, 0, 1) }
func rolledBack(s State, sig Signal) Decision[State, string]      { return step(s, sig, 0, 2) }
func recoveredBack(s State, sig Signal) Decision[State, string]   { return step(s, sig, 0, 3) }
func recoveredFwd(s State, sig Signal) Decision[State, string]    { return step(s, sig, 0, 4) }

type Design machine[State, Signal] { initial: initial(), step: design, law Safe never reaches Broken }
type CheckThenRename machine[State, Signal] { initial: initial(), step: checkThenRename, law Breaks reaches Broken }
type NoJournal machine[State, Signal] { initial: initial(), step: noJournal, law Breaks reaches Broken }
type BlindRestore machine[State, Signal] { initial: initial(), step: blindRestore, law Breaks reaches Broken }
type CommitEarly machine[State, Signal] { initial: initial(), step: commitEarly, law Breaks reaches Broken }
type AppliedWitness machine[State, Signal] { initial: initial(), step: applied, law Exists reaches Applied }
type RolledBackWitness machine[State, Signal] { initial: initial(), step: rolledBack, law Exists reaches RolledBack }
type RecoveredBackWitness machine[State, Signal] { initial: initial(), step: recoveredBack, law Exists reaches RecoveredBack }
type RecoveredForwardWitness machine[State, Signal] { initial: initial(), step: recoveredFwd, law Exists reaches RecoveredForward }
