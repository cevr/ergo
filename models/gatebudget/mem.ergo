// mem.ergo models memory admission (WS4c), which replaces the interim
// load gate. A take names its width in cores and is charged a reservation
// in memory; it fits when the widths held plus its own are at most MB
// cores and the reservations held plus its own are at most MM, a number
// the host's owner sets (budget.conf `memory`), not the machine's total.
//
// The reservation of a command is learnt: it starts at MDefault (an
// unknown command is never reserved 0) and, after each run, becomes the
// largest peak seen. A run is capped at its reservation (the command's
// MemoryMax): a run whose real peak is over it is killed, alone, which
// frees its cores and memory like any end, and its real peak raises the
// next reservation.
//
// The world: MB = 3 cores, MM = 4 units of memory, MDefault = 2.
//   - Q: a lane runner of width 1, real peaks 2, 2.
//   - G: a heavy lane runner of width 2, real peaks 3, 1, 3 (a light run
//     between two heavy ones, as a cached build between two cold ones).
//   - K: a crit runner of width 1, real peaks 1, 1.
// There is no load gate: the order, head of line and the lane share are
// cores.ergo's, with the gate deleted.
//
// The invariants (laws of MemBudget, each `always`):
//   - WithinMemory: the reservations held never sum past MM.
//   - WithinCores: the widths held never sum past MB.
//   - MemNextNotIdle: the next waiter never waits while it fits in both;
//     with no gate there is no exception.
//   - MemInOrder: as cores.ergo's InOrder.
//   - KilledOnce: a command is killed for its reservation at most once:
//     after a kill its reservation covers the peak that killed it.
//
// Mutants, each a machine whose law Breaks must hold:
//   - ByCores: admission ignores memory (WithinMemory).
//   - LastPeak: the reservation is the last run's peak, not the largest:
//     G's light run shrinks it, and G's next heavy run is killed again
//     (KilledOnce).
//
// Witnesses (laws of MemBudget, `sometimes`): a waiter waits on memory
// with cores free; a run is killed for its reservation and hands its
// cores on; G waits after its reservation was raised.

type MRn = MQ{} | MG{} | MK{}

type MemAct = MJoin{R MRn} | MEnd{R MRn}

let MB = 3
let MM = 4
let MDefault = 2
let MShare = 1

let MemDesign = 0
let ByCoresMutant = 1
let LastPeakMutant = 2

// Mems is a world of this model: per runner (Q, G, K) its step, its
// finished runs, its ticket, its reservation and its kills; Passed: a take
// broke the order. The other flags are the witnesses'.
type Mems {
	Pc         []int,
	Done       []int,
	Ticket     []int,
	NextTicket int,
	Res        []int,
	Kills      []int,
	Passed     bool,
	MemWaits   bool,
	KillHands  bool,
	RaisedWait bool,
}

func memWorld() Mems {
	Mems{Pc: []int{0, 0, 0}, Done: []int{0, 0, 0}, Ticket: []int{-1, -1, -1}, NextTicket: 0,
		Res: []int{MDefault, MDefault, MDefault}, Kills: []int{0, 0, 0},
		Passed: false, MemWaits: false, KillHands: false, RaisedWait: false}
}

func mrn(r MRn) int {
	match r {
	case MQ:
		return 0
	case MG:
		return 1
	case MK:
		return 2
	}
}

func all3() []int { []int{0, 1, 2} }

func mWidth(r int) int {
	if r == 1 {
		return 2
	}
	return 1
}

func mCrit(r int) bool { r == 2 }

// peaks is runner r's real peak on each of its runs.
func peaks(r int) []int {
	if r == 0 {
		return []int{2, 2}
	}
	if r == 1 {
		return []int{3, 1, 3}
	}
	return []int{1, 1}
}

func mCores(c Mems) int {
	let mut n = 0
	for r in all3() {
		if c.Pc[r] == Holding {
			n = n + mWidth(r)
		}
	}
	return n
}

func mMem(c Mems) int {
	let mut n = 0
	for r in all3() {
		if c.Pc[r] == Holding {
			n = n + c.Res[r]
		}
	}
	return n
}

func mLaneUsed(c Mems) int {
	let mut n = 0
	for r in all3() {
		if c.Pc[r] == Holding && !mCrit(r) {
			n = n + mWidth(r)
		}
	}
	return n
}

func coresFit(c Mems, r int) bool { mCores(c) + mWidth(r) <= MB }

func memFit(c Mems, r int) bool { mMem(c) + c.Res[r] <= MM }

// mFits reports admission: by cores and memory; by cores alone under
// ByCores.
func mFits(m int, c Mems, r int) bool {
	if m == ByCoresMutant {
		return coresFit(c, r)
	}
	return coresFit(c, r) && memFit(c, r)
}

func mOldest(c Mems, critClass bool) int {
	let mut best = -1
	for r in all3() {
		if mCrit(r) == critClass && c.Pc[r] == Waiting && (best == -1 || c.Ticket[r] < c.Ticket[best]) {
			best = r
		}
	}
	return best
}

// mNext is the waiter the hand-on serves next, -1 for none: cores.ergo's
// rule with no gate.
func mNext(c Mems) int {
	let lane = mOldest(c, false)
	let first = mOldest(c, true)
	if lane != -1 && mLaneUsed(c) < MShare {
		return lane
	}
	if first != -1 {
		return first
	}
	return lane
}

func mBreaksOrder(c Mems, r int) bool {
	for o in all3() {
		if o != r && c.Pc[o] == Waiting {
			let older = c.Pc[r] != Waiting || c.Ticket[o] < c.Ticket[r]
			if mCrit(o) == mCrit(r) && older {
				return true
			}
			if mCrit(o) && !mCrit(r) && mLaneUsed(c) >= MShare {
				return true
			}
		}
	}
	return false
}

func mHandOn(m int, c0 Mems) Mems {
	let mut c = c0
	for _ in all3() {
		let to = mNext(c)
		if to == -1 || !mFits(m, c, to) {
			return c
		}
		if mBreaksOrder(c, to) {
			c.Passed = true
		}
		c.Pc[to] = Holding
		c.Ticket[to] = -1
	}
	return c
}

func memNext(m int, c0 Mems, a MemAct) Option[Mems] {
	let mut c = c0
	match a {
	case MJoin as x:
		let r = mrn(x.R)
		if c.Pc[r] != Idle || c.Done[r] == len(peaks(r)) {
			return None
		}
		c.Pc[r] = Waiting
		c.Ticket[r] = c.NextTicket
		c.NextTicket = c.NextTicket + 1
		c = mHandOn(m, c)
	case MEnd as x:
		// A run ends: normally, or killed at its reservation when its real
		// peak is over it. Either way its cores and memory are handed on in
		// the same step, and its peak is recorded.
		let r = mrn(x.R)
		if c.Pc[r] != Holding {
			return None
		}
		let peak = peaks(r)[c.Done[r]]
		let killed = peak > c.Res[r]
		if killed {
			c.Kills[r] = c.Kills[r] + 1
		}
		if m == LastPeakMutant {
			c.Res[r] = peak
		} else if peak > c.Res[r] {
			c.Res[r] = peak
		}
		c.Pc[r] = Idle
		c.Done[r] = c.Done[r] + 1
		let freed = mCores(c)
		c = mHandOn(m, c)
		if killed && mCores(c) > freed {
			c.KillHands = true
		}
	}
	for r in all3() {
		if c.Pc[r] == Waiting && coresFit(c, r) && !memFit(c, r) {
			c.MemWaits = true
			if r == 1 && c.Res[1] > MDefault {
				c.RaisedWait = true
			}
		}
	}
	return Some[Mems]{Value: c}
}

func memWith(m int, c Mems, a MemAct) Decision[Mems, string] {
	match memNext(m, c, a) {
	case None:
		Ignore
	case Some[Mems] as n:
		Enter[Mems]{Next: n.Value}
	}
}

func memDesign(c Mems, a MemAct) Decision[Mems, string] { memWith(MemDesign, c, a) }
func byCores(c Mems, a MemAct) Decision[Mems, string]   { memWith(ByCoresMutant, c, a) }
func lastPeak(c Mems, a MemAct) Decision[Mems, string]  { memWith(LastPeakMutant, c, a) }

func withinMemory(c Mems) bool { mMem(c) <= MM }
func withinCores(c Mems) bool  { mCores(c) <= MB }

func memNextNotIdle(c Mems) bool {
	let r = mNext(c)
	if r == -1 {
		return true
	}
	return !(coresFit(c, r) && memFit(c, r))
}

func memInOrder(c Mems) bool { !c.Passed }

func killedOnce(c Mems) bool {
	for r in all3() {
		if c.Kills[r] > 1 {
			return false
		}
	}
	return true
}

func overMemory(c Mems) bool  { !withinMemory(c) }
func killedTwice(c Mems) bool { !killedOnce(c) }
func memWaits(c Mems) bool    { c.MemWaits }
func killHands(c Mems) bool   { c.KillHands }
func raisedWait(c Mems) bool  { c.RaisedWait }

type MemBudget machine[Mems, MemAct] {
	initial: memWorld(),
	step:    memDesign,

	law WithinMemory always withinMemory,
	law WithinCores always withinCores,
	law MemNextNotIdle always memNextNotIdle,
	law MemInOrder always memInOrder,
	law KilledOnce always killedOnce,

	law WaitsOnMemory sometimes memWaits,
	law KillHandsOn sometimes killHands,
	law RaisedReservationWaits sometimes raisedWait,
}

type ByCores machine[Mems, MemAct] {
	initial: memWorld(),
	step:    byCores,

	law Breaks sometimes overMemory,
}

type LastPeak machine[Mems, MemAct] {
	initial: memWorld(),
	step:    lastPeak,

	law Breaks sometimes killedTwice,
}
