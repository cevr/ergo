// mem.ergo models memory admission (WS4c), which replaces the interim
// load gate. A take names its width in cores and is charged a reservation
// in memory; it fits when the widths held plus its own are at most MB
// cores and the reservations held plus its own are at most MM, a number
// the host's owner sets (budget.conf `memory`), not the machine's total.
//
// Reservations are learnt, and a kill is destructive, so the cap reports
// before it kills (orchestrator, 2026-11-20: "a run that dies twice before
// it works costs more than the queue we just fixed"):
//   - A command with no recorded peak (unknown) is charged MDefault and is
//     not capped on its own: it runs to its real peak, which is recorded.
//   - A command with a recorded peak is charged it (the largest seen) and
//     capped at it or MDefault, the larger: a run past its own recorded
//     peak is killed alone, but never at or below MDefault, since a short
//     run's low peak (a chain that failed fast and exited 0) says nothing
//     of what the full run needs (2026-11-20, a compile killed at 1.4G).
//   - Every budget command runs in one slice capped at MM, so the real use
//     of all of them never passes the budget: when an unknown run's growth
//     would pass it, the kernel kills a run in the slice (here the run that
//     grew). That is the only kill of an unknown command.
//
// The world: MB = 3 cores, MM = 4 units of memory, MDefault = 2.
//   - Q: a lane runner of width 1, real peaks 2, 3 (it grows past its own
//     recorded peak, and is killed for it).
//   - G: a heavy lane runner of width 2, real peaks 3, 1, 3 (a light run
//     between two heavy ones, as a cached build between two cold ones).
//   - K: a crit runner of width 1, real peaks 1, 2 (a short run, then a
//     full one that needs MDefault).
// A holder first reaches its real peak (Grow), then ends (End). There is
// no load gate: the order, head of line and the lane share are
// cores.ergo's.
//
// The invariants (laws of MemBudget, each `always`):
//   - WithinMemory: the reservations held never sum past MM.
//   - RealWithinMemory: the real use of the holders never sums past MM.
//   - WithinCores: the widths held never sum past MB.
//   - MemNextNotIdle: the next waiter never waits while it fits in both.
//   - MemInOrder: as cores.ergo's InOrder.
//   - UnknownNotCapped: no command is killed by its own cap before it has
//     a recorded peak.
//   - KilledPastOwnPeak: a command is killed by its own cap only when its
//     run passes the largest peak it ever reached.
//   - NotKilledBelowDefault: no command is killed by its own cap at a real
//     use of MDefault or less.
//
// Mutants, each a machine whose law Breaks must hold:
//   - ByCores: admission ignores memory (WithinMemory).
//   - CapUnknown: an unknown command is capped at MDefault, so G's first
//     run is killed (UnknownNotCapped); c012b9af5 did this, and killed a
//     20G command twice before it fitted.
//   - LastPeak: the recorded peak is the last run's, not the largest: G's
//     light run shrinks it, and G's next heavy run is killed within a peak
//     it already reached (KilledPastOwnPeak).
//   - CapAtPeak: a known command is capped at its recorded peak alone, so
//     K's full run is killed at MDefault after its short run recorded 1
//     (NotKilledBelowDefault); 28a172227 did this.
//
// Witnesses (laws of MemBudget, `sometimes`): a waiter waits on memory
// with cores free; a run is killed past its own peak (Q); the slice kills
// an unknown run that would pass the budget; G waits after its
// reservation was raised.

type MRn = MQ{} | MG{} | MK{}

type MemAct = MJoin{R MRn} | MGrow{R MRn} | MEnd{R MRn}

let MB = 3
let MM = 4
let MDefault = 2
let MShare = 1

let MemDesign = 0
let ByCoresMutant = 1
let LastPeakMutant = 2
let CapUnknownMutant = 3
let CapAtPeakMutant = 4

// Mems is a world of this model: per runner (Q, G, K) its step, its
// finished runs, its ticket, the reservation it holds, its real use once
// grown, its recorded peak (0: unknown) and the largest peak it ever
// reached; Passed: a take broke the order. The other flags are the
// invariants' and the witnesses'.
type Mems {
	Pc          []int,
	Done        []int,
	Ticket      []int,
	NextTicket  int,
	Held        []int,
	Use         []int,
	Peak        []int,
	MaxSeen     []int,
	Passed      bool,
	UnknownKill bool,
	EarlyKill   bool,
	LowKill     bool,
	MemWaits    bool,
	OwnKill     bool,
	SliceKill   bool,
	RaisedWait  bool,
}

func memWorld() Mems {
	Mems{Pc: []int{0, 0, 0}, Done: []int{0, 0, 0}, Ticket: []int{-1, -1, -1}, NextTicket: 0,
		Held: []int{0, 0, 0}, Use: []int{0, 0, 0}, Peak: []int{0, 0, 0}, MaxSeen: []int{0, 0, 0},
		Passed: false, UnknownKill: false, EarlyKill: false, LowKill: false, MemWaits: false, OwnKill: false, SliceKill: false, RaisedWait: false}
}

func mrn(r MRn) int {
	match r {
	case MQ:
		return 0
	case MG:
		return 1
	case MK:
		return 2
	}
}

func all3() []int { []int{0, 1, 2} }

func mWidth(r int) int {
	if r == 1 {
		return 2
	}
	return 1
}

func mCrit(r int) bool { r == 2 }

// peaks is runner r's real peak on each of its runs.
func peaks(r int) []int {
	if r == 0 {
		return []int{2, 3}
	}
	if r == 1 {
		return []int{3, 1, 3}
	}
	return []int{1, 2}
}

// resOf is the reservation r is charged: its recorded peak, MDefault when
// it has none.
func resOf(c Mems, r int) int {
	if c.Peak[r] == 0 {
		return MDefault
	}
	return c.Peak[r]
}

// capOf is the cap of a holder r with a recorded peak: its reservation or
// MDefault, the larger; its reservation alone under CapAtPeak.
func capOf(m int, c Mems, r int) int {
	if m == CapAtPeakMutant || c.Held[r] > MDefault {
		return c.Held[r]
	}
	return MDefault
}

func mCores(c Mems) int {
	let mut n = 0
	for r in all3() {
		if c.Pc[r] == Holding {
			n = n + mWidth(r)
		}
	}
	return n
}

func mMem(c Mems) int {
	let mut n = 0
	for r in all3() {
		if c.Pc[r] == Holding {
			n = n + c.Held[r]
		}
	}
	return n
}

func mReal(c Mems) int {
	let mut n = 0
	for r in all3() {
		if c.Pc[r] == Holding {
			n = n + c.Use[r]
		}
	}
	return n
}

func mLaneUsed(c Mems) int {
	let mut n = 0
	for r in all3() {
		if c.Pc[r] == Holding && !mCrit(r) {
			n = n + mWidth(r)
		}
	}
	return n
}

func coresFit(c Mems, r int) bool { mCores(c) + mWidth(r) <= MB }

func memFit(c Mems, r int) bool { mMem(c) + resOf(c, r) <= MM }

// mFits reports admission: by cores and memory; by cores alone under
// ByCores.
func mFits(m int, c Mems, r int) bool {
	if m == ByCoresMutant {
		return coresFit(c, r)
	}
	return coresFit(c, r) && memFit(c, r)
}

func mOldest(c Mems, critClass bool) int {
	let mut best = -1
	for r in all3() {
		if mCrit(r) == critClass && c.Pc[r] == Waiting && (best == -1 || c.Ticket[r] < c.Ticket[best]) {
			best = r
		}
	}
	return best
}

// mNext is the waiter the hand-on serves next, -1 for none: cores.ergo's
// rule.
func mNext(c Mems) int {
	let lane = mOldest(c, false)
	let first = mOldest(c, true)
	if lane != -1 && mLaneUsed(c) < MShare {
		return lane
	}
	if first != -1 {
		return first
	}
	return lane
}

func mBreaksOrder(c Mems, r int) bool {
	for o in all3() {
		if o != r && c.Pc[o] == Waiting {
			let older = c.Pc[r] != Waiting || c.Ticket[o] < c.Ticket[r]
			if mCrit(o) == mCrit(r) && older {
				return true
			}
			if mCrit(o) && !mCrit(r) && mLaneUsed(c) >= MShare {
				return true
			}
		}
	}
	return false
}

func mHandOn(m int, c0 Mems) Mems {
	let mut c = c0
	for _ in all3() {
		let to = mNext(c)
		if to == -1 || !mFits(m, c, to) {
			return c
		}
		if mBreaksOrder(c, to) {
			c.Passed = true
		}
		c.Pc[to] = Holding
		c.Ticket[to] = -1
		c.Held[to] = resOf(c, to)
		c.Use[to] = 0
	}
	return c
}

// finish ends r's run at its real peak (killed or not): the peak is
// recorded, the largest under the design, the last under LastPeak, and the
// cores and memory are handed on in the same step.
func finish(m int, c0 Mems, r int, real int) Mems {
	let mut c = c0
	if m == LastPeakMutant || real > c.Peak[r] {
		c.Peak[r] = real
	}
	if real > c.MaxSeen[r] {
		c.MaxSeen[r] = real
	}
	c.Pc[r] = Idle
	c.Held[r] = 0
	c.Use[r] = 0
	c.Done[r] = c.Done[r] + 1
	return mHandOn(m, c)
}

func memNext(m int, c0 Mems, a MemAct) Option[Mems] {
	let mut c = c0
	match a {
	case MJoin as x:
		let r = mrn(x.R)
		if c.Pc[r] != Idle || c.Done[r] == len(peaks(r)) {
			return None
		}
		c.Pc[r] = Waiting
		c.Ticket[r] = c.NextTicket
		c.NextTicket = c.NextTicket + 1
		c = mHandOn(m, c)
	case MGrow as x:
		// A holder reaches its real peak. Known, it is capped at its
		// reservation, and killed past it; unknown, it is not capped on its
		// own, and the slice kills it only when the real use of all would
		// pass the budget.
		let r = mrn(x.R)
		if c.Pc[r] != Holding || c.Use[r] != 0 {
			return None
		}
		let real = peaks(r)[c.Done[r]]
		let capped = c.Peak[r] > 0 || m == CapUnknownMutant
		if capped && real > capOf(m, c, r) {
			if real <= MDefault {
				c.LowKill = true
			}
			if c.Peak[r] == 0 {
				c.UnknownKill = true
			}
			if real <= c.MaxSeen[r] {
				c.EarlyKill = true
			}
			c.OwnKill = true
			c = finish(m, c, r, real)
		} else if mReal(c) + real > MM {
			c.SliceKill = true
			c = finish(m, c, r, real)
		} else {
			c.Use[r] = real
		}
	case MEnd as x:
		let r = mrn(x.R)
		if c.Pc[r] != Holding || c.Use[r] == 0 {
			return None
		}
		c = finish(m, c, r, c.Use[r])
	}
	for r in all3() {
		if c.Pc[r] == Waiting && coresFit(c, r) && !memFit(c, r) {
			c.MemWaits = true
			if r == 1 && c.Peak[1] > MDefault {
				c.RaisedWait = true
			}
		}
	}
	return Some[Mems]{Value: c}
}

func memWith(m int, c Mems, a MemAct) Decision[Mems, string] {
	match memNext(m, c, a) {
	case None:
		Ignore
	case Some[Mems] as n:
		Enter[Mems]{Next: n.Value}
	}
}

func memDesign(c Mems, a MemAct) Decision[Mems, string]  { memWith(MemDesign, c, a) }
func byCores(c Mems, a MemAct) Decision[Mems, string]    { memWith(ByCoresMutant, c, a) }
func lastPeak(c Mems, a MemAct) Decision[Mems, string]   { memWith(LastPeakMutant, c, a) }
func capUnknown(c Mems, a MemAct) Decision[Mems, string] { memWith(CapUnknownMutant, c, a) }
func capAtPeak(c Mems, a MemAct) Decision[Mems, string]  { memWith(CapAtPeakMutant, c, a) }

func withinMemory(c Mems) bool     { mMem(c) <= MM }
func realWithinMemory(c Mems) bool { mReal(c) <= MM }
func withinCores(c Mems) bool      { mCores(c) <= MB }

func memNextNotIdle(c Mems) bool {
	let r = mNext(c)
	if r == -1 {
		return true
	}
	return !(coresFit(c, r) && memFit(c, r))
}

func memInOrder(c Mems) bool       { !c.Passed }
func unknownNotCapped(c Mems) bool { !c.UnknownKill }
func killedPastOwnPeak(c Mems) bool { !c.EarlyKill }
func notKilledBelowDefault(c Mems) bool { !c.LowKill }

func overMemory(c Mems) bool    { !withinMemory(c) }
func unknownKilled(c Mems) bool { c.UnknownKill }
func killedEarly(c Mems) bool   { c.EarlyKill }
func killedLow(c Mems) bool     { c.LowKill }
func memWaits(c Mems) bool      { c.MemWaits }
func ownKill(c Mems) bool       { c.OwnKill }
func sliceKill(c Mems) bool     { c.SliceKill }
func raisedWait(c Mems) bool    { c.RaisedWait }

type MemBudget machine[Mems, MemAct] {
	initial: memWorld(),
	step:    memDesign,

	law WithinMemory always withinMemory,
	law RealWithinMemory always realWithinMemory,
	law WithinCores always withinCores,
	law MemNextNotIdle always memNextNotIdle,
	law MemInOrder always memInOrder,
	law UnknownNotCapped always unknownNotCapped,
	law KilledPastOwnPeak always killedPastOwnPeak,
	law NotKilledBelowDefault always notKilledBelowDefault,

	law WaitsOnMemory sometimes memWaits,
	law KilledPastItsPeak sometimes ownKill,
	law SliceKillsUnknown sometimes sliceKill,
	law RaisedReservationWaits sometimes raisedWait,
}

type ByCores machine[Mems, MemAct] {
	initial: memWorld(),
	step:    byCores,

	law Breaks sometimes overMemory,
}

type CapUnknown machine[Mems, MemAct] {
	initial: memWorld(),
	step:    capUnknown,

	law Breaks sometimes unknownKilled,
}

type LastPeak machine[Mems, MemAct] {
	initial: memWorld(),
	step:    lastPeak,

	law Breaks sometimes killedEarly,
}

type CapAtPeak machine[Mems, MemAct] {
	initial: memWorld(),
	step:    capAtPeak,

	law Breaks sometimes killedLow,
}
