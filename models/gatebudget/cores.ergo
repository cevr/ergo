// cores.ergo models the budget in cores: priority classes, a lane share
// and wide takes. It replaces the count-based classes model (WS4 r1),
// after the r1 review: a take names its width (its GOMAXPROCS), and the
// widths held never sum past the host's budget B, a number the host's
// owner sets in the budget's file, not the machine's cores, since the
// host is shared. WS4c deleted the interim load gate (and its mutants
// GateAll, PollAfterLoad and GatedHead, the last the live bug of
// 2026-11-20); memory admission (mem.ergo) replaces it.
//
// The world: B = 3 cores. Five runners, each with a width and a class:
// A and N are lane runners of width 1, H is a heavy run of width 2 (as
// heavy.sh, one at a time), all of the lane class; C is a crit runner of
// width 1, and N2 a lane runner of width 1. A, N and C run up to twice, H
// and N2 once.
//
// The design:
//   - Admission is by cores: a take fits when the widths held plus its
//     own are at most B.
//   - One queue order, with a bounded backfill (BUDGET-BACKFILL). A join
//     and a release hand the free cores on in the same step, to the next
//     waiter by the rule below while it fits. When it does not fit, the
//     oldest later waiter that fits takes past it (a pass), at most
//     MaxPass times for one head; then the head stops the hand-on (head
//     of line) until it fits. There is no clock: the bound counts takes.
//   - The next waiter: the oldest lane waiter while the lane class holds
//     fewer than Share cores, else the oldest crit waiter, else the
//     oldest lane waiter.
//
// The invariants (laws of Cores, each `always`):
//   - WithinBudget: the widths held never sum past B.
//   - NextNotIdle: the next waiter never waits while it fits.
//   - InOrder: no runner takes while an older waiter of its own class
//     waits, and no lane runner takes while a crit waiter waits, unless
//     the lane class is under its share, except by a pass.
//   - NoIdleBehindBlockedHead: while the head does not fit and has been
//     passed fewer than MaxPass times, no waiter that fits waits.
//   - HeadWithinBound: no head is passed more than MaxPass times.
//
// Mutants, each a machine whose law Breaks must hold:
//   - ByCount: admission counts holders (at most 3), not cores
//     (WithinBudget).
//   - QuitIdle: a release hands nothing on; waiters find the cores at
//     their next poll, as light.sh's sleep (NextNotIdle).
//   - Backfill: passes with no bound, so H is passed again and again
//     (HeadWithinBound).
//   - NoBackfill: the hand-on stops at a head that does not fit, and N2
//     waits behind H with a core free (NoIdleBehindBlockedHead); this was
//     the code until BUDGET-BACKFILL.
//
// Witnesses (laws of Cores, each `sometimes`): H holds while a narrow
// runner waits; a narrow runner waits behind H while a core is free (the
// head of line); H takes after waiting; crit takes while a lane runner
// waits (the lane class at its share); the budget is full with H and a
// narrow runner.

type Rn = A{} | N{} | H{} | C{} | N2{}

type CoreAct = Join{R Rn} | Quit{R Rn}

let B = 3
let Share = 1

let CoreDesign = 0
let ByCountMutant = 1
let QuitIdleMutant = 2
let BackfillMutant = 4
let NoBackfillMutant = 5

// MaxPass is how many later waiters may take past one blocked head
// (budget.conf `backfill`).
let MaxPass = 1

// Cores is a world of this model: per runner (A, N, H, C) its step (Idle,
// Waiting, Holding), its finished runs and its ticket; Passed: a take
// broke InOrder. The other flags are the witnesses'.
type Cores {
	Pc         []int,
	Done       []int,
	Ticket     []int,
	NextTicket int,
	Passes     []int,
	Backfilled bool,
	Passed     bool,
	WideHolds  bool,
	HeadBlocks bool,
	WideWaited bool,
	CritPassed bool,
	Full       bool,
}

func coreWorld() Cores {
	Cores{Pc: []int{0, 0, 0, 0, 0}, Done: []int{0, 0, 0, 0, 0}, Ticket: []int{-1, -1, -1, -1, -1}, NextTicket: 0,
		Passes: []int{0, 0, 0, 0, 0}, Backfilled: false, Passed: false, WideHolds: false, HeadBlocks: false, WideWaited: false, CritPassed: false, Full: false}
}

func rn(r Rn) int {
	match r {
	case A:
		return 0
	case N:
		return 1
	case H:
		return 2
	case C:
		return 3
	case N2:
		return 4
	}
}

func all4() []int { []int{0, 1, 2, 3, 4} }

func width(r int) int {
	if r == 2 {
		return 2
	}
	return 1
}

func runsOf(r int) int {
	if r == 2 || r == 4 {
		return 1
	}
	return 2
}

func isCrit(r int) bool { r == 3 }

func used(c Cores) int {
	let mut n = 0
	for r in all4() {
		if c.Pc[r] == Holding {
			n = n + width(r)
		}
	}
	return n
}

func holding(c Cores) int {
	let mut n = 0
	for r in all4() {
		if c.Pc[r] == Holding {
			n = n + 1
		}
	}
	return n
}

func laneUsed(c Cores) int {
	let mut n = 0
	for r in all4() {
		if c.Pc[r] == Holding && !isCrit(r) {
			n = n + width(r)
		}
	}
	return n
}

// fits reports admission: by cores, or by count under ByCount.
func fits(m int, c Cores, r int) bool {
	if m == ByCountMutant {
		return holding(c) < 3
	}
	return used(c) + width(r) <= B
}

func oldestIn(c Cores, critClass bool) int {
	let mut best = -1
	for r in all4() {
		if isCrit(r) == critClass && c.Pc[r] == Waiting && (best == -1 || c.Ticket[r] < c.Ticket[best]) {
			best = r
		}
	}
	return best
}

// nextWaiter is the waiter the hand-on serves next, -1 for none.
func nextWaiter(c Cores) int {
	let lane = oldestIn(c, false)
	let first = oldestIn(c, true)
	if lane != -1 && laneUsed(c) < Share {
		return lane
	}
	if first != -1 {
		return first
	}
	return lane
}

// breaksOrder reports a take by r that passes an older waiter of its own
// class, or a lane take while crit waits and the lane class has its share.
func breaksOrder(c Cores, r int) bool {
	for o in all4() {
		if o != r && c.Pc[o] == Waiting {
			let older = c.Pc[r] != Waiting || c.Ticket[o] < c.Ticket[r]
			if isCrit(o) == isCrit(r) && older {
				return true
			}
			if isCrit(o) && !isCrit(r) && laneUsed(c) >= Share {
				return true
			}
		}
	}
	return false
}

func admit(c0 Cores, r int, pass bool) Cores {
	let mut c = c0
	if breaksOrder(c, r) && !pass {
		c.Passed = true
	}
	if c.Pc[r] == Waiting && r == 2 {
		c.WideWaited = true
	}
	if isCrit(r) && (c.Pc[0] == Waiting || c.Pc[1] == Waiting || c.Pc[2] == Waiting) {
		c.CritPassed = true
	}
	c.Pc[r] = Holding
	c.Ticket[r] = -1
	return c
}

// oldestFitting is the oldest waiter other than h that fits, -1 for none.
func oldestFitting(m int, c Cores, h int) int {
	let mut best = -1
	for r in all4() {
		if r != h && c.Pc[r] == Waiting && fits(m, c, r) && (best == -1 || c.Ticket[r] < c.Ticket[best]) {
			best = r
		}
	}
	return best
}

// handOn serves the next waiter while it fits. When it does not, the
// oldest later waiter that fits takes past it (a pass), at most MaxPass
// times for one head: then the hand-on stops at the head, as with no
// backfill. Under NoBackfill there is no pass (the code before
// BUDGET-BACKFILL); under Backfill the passes have no bound.
func handOn(m int, c0 Cores) Cores {
	let mut c = c0
	for _ in all4() {
		let to = nextWaiter(c)
		if to == -1 {
			return c
		}
		if fits(m, c, to) {
			c = admit(c, to, false)
			c.Passes[to] = 0
		} else {
			if m == NoBackfillMutant || (m != BackfillMutant && c.Passes[to] >= MaxPass) {
				return c
			}
			let by = oldestFitting(m, c, to)
			if by == -1 {
				return c
			}
			c = admit(c, by, true)
			c.Passes[by] = 0
			c.Passes[to] = c.Passes[to] + 1
			c.Backfilled = true
		}
	}
	return c
}

func coreNext(m int, c0 Cores, a CoreAct) Option[Cores] {
	let mut c = c0
	match a {
	case Join as x:
		let r = rn(x.R)
		if c.Pc[r] != Idle || c.Done[r] == runsOf(r) {
			return None
		}
		// A newcomer joins the queue and the hand-on runs: it takes at once
		// exactly when it is the next waiter and fits.
		c.Pc[r] = Waiting
		c.Ticket[r] = c.NextTicket
		c.NextTicket = c.NextTicket + 1
		c = handOn(m, c)
	case Quit as x:
		let r = rn(x.R)
		if c.Pc[r] != Holding {
			return None
		}
		c.Pc[r] = Idle
		c.Done[r] = c.Done[r] + 1
		// A release hands the cores on in the same step; under QuitIdle it
		// hands nothing on, and the next waiter waits with cores free.
		if m != QuitIdleMutant {
			c = handOn(m, c)
		}
	}
	if c.Pc[2] == Holding && (c.Pc[0] == Waiting || c.Pc[1] == Waiting || c.Pc[3] == Waiting) {
		c.WideHolds = true
	}
	if c.Pc[2] == Waiting && used(c) < B && (c.Pc[0] == Waiting || c.Pc[1] == Waiting) {
		c.HeadBlocks = true
	}
	if used(c) == B && c.Pc[2] == Holding {
		c.Full = true
	}
	return Some[Cores]{Value: c}
}

func coreWith(m int, c Cores, a CoreAct) Decision[Cores, string] {
	match coreNext(m, c, a) {
	case None:
		Ignore
	case Some[Cores] as n:
		Enter[Cores]{Next: n.Value}
	}
}

func coreDesign(c Cores, a CoreAct) Decision[Cores, string] { coreWith(CoreDesign, c, a) }
func byCount(c Cores, a CoreAct) Decision[Cores, string]    { coreWith(ByCountMutant, c, a) }
func quitIdle(c Cores, a CoreAct) Decision[Cores, string]   { coreWith(QuitIdleMutant, c, a) }
func backfill(c Cores, a CoreAct) Decision[Cores, string]   { coreWith(BackfillMutant, c, a) }
func noBackfill(c Cores, a CoreAct) Decision[Cores, string] { coreWith(NoBackfillMutant, c, a) }

func withinBudget(c Cores) bool { used(c) <= B }

// nextNotIdle: the next waiter does not wait while it fits.
func nextNotIdle(c Cores) bool {
	let r = nextWaiter(c)
	if r == -1 {
		return true
	}
	return used(c) + width(r) > B
}

func inOrder2(c Cores) bool { !c.Passed }

// noIdleBehindBlockedHead: while the next waiter does not fit and has been
// passed fewer than MaxPass times, no other waiter waits that fits (the
// 2026-11-20 queue: 22 runs of width 4 waited behind a width-16 head that
// could not fit, with 12 cores free).
func noIdleBehindBlockedHead(c Cores) bool {
	let h = nextWaiter(c)
	if h == -1 || used(c) + width(h) <= B || c.Passes[h] >= MaxPass {
		return true
	}
	for r in all4() {
		if r != h && c.Pc[r] == Waiting && used(c) + width(r) <= B {
			return false
		}
	}
	return true
}

// headWithinBound: no waiter is passed more than MaxPass times.
func headWithinBound(c Cores) bool {
	for r in all4() {
		if c.Passes[r] > MaxPass {
			return false
		}
	}
	return true
}

func idleBehindHead(c Cores) bool { !noIdleBehindBlockedHead(c) }
func pastBound(c Cores) bool      { !headWithinBound(c) }

func overBudget(c Cores) bool { !withinBudget(c) }
func nextIdle(c Cores) bool   { !nextNotIdle(c) }
func passed2(c Cores) bool    { !inOrder2(c) }
func wideHolds(c Cores) bool  { c.WideHolds }
func headBlocks(c Cores) bool { c.HeadBlocks }
func wideWaited(c Cores) bool { c.WideWaited }
func critPassed(c Cores) bool { c.CritPassed }
func full(c Cores) bool       { c.Full }
func backfilled(c Cores) bool { c.Backfilled }

type CoreBudget machine[Cores, CoreAct] {
	initial: coreWorld(),
	step:    coreDesign,

	law WithinBudget always withinBudget,
	law NextNotIdle always nextNotIdle,
	law InOrder always inOrder2,
	law NoIdleBehindBlockedHead always noIdleBehindBlockedHead,
	law HeadWithinBound always headWithinBound,

	law WideHolds sometimes wideHolds,
	law HeadOfLine sometimes headBlocks,
	law WideTakesAfterWaiting sometimes wideWaited,
	law CritPassesLane sometimes critPassed,
	law FullWithWide sometimes full,
	law PassesBlockedHead sometimes backfilled,
}

type ByCount machine[Cores, CoreAct] {
	initial: coreWorld(),
	step:    byCount,

	law Breaks sometimes overBudget,
}

type QuitIdle machine[Cores, CoreAct] {
	initial: coreWorld(),
	step:    quitIdle,

	law Breaks sometimes nextIdle,
}

type Backfill machine[Cores, CoreAct] {
	initial: coreWorld(),
	step:    backfill,

	law Breaks sometimes pastBound,
}

type NoBackfill machine[Cores, CoreAct] {
	initial: coreWorld(),
	step:    noBackfill,

	law Breaks sometimes idleBehindHead,
}
