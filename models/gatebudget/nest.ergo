// nest.ergo models a holder whose child needs cores too: `ergo test`
// under the budget holds a take and spawns `go`, and a gate's task spawns
// tools (MONOREPO §7.3 risk 7, budget deadlock). It must hold before
// `ergo test` itself runs under the budget.
//
// The world: B = 2 cores, two parents P0 and P1 of width 1. A holding
// parent spawns one child of width 1 and waits for it before it gives its
// cores back.
//
// The design: a child runs inside its parent's grant. The parent lends
// it the cores it holds (the child's width is at most the parent's; the
// runner passes the grant down, as a jobserver's tokens or an inherited
// GOMAXPROCS share), so a child never queues for the host's budget.
//
// The invariant (law of Nest, `always`):
//   - NoHolderWaitsOnQueue: no parent waits for a child that waits in the
//     host's queue.
//
// The mutant, a machine whose law Breaks must hold:
//   - ChildQueues: a child takes from the host's budget like any runner.
//     Both parents hold both cores, both children queue, and no step can
//     move: the budget deadlock.
//
// Witnesses (laws of Nest, each `sometimes`): a child runs in its parent's
// grant; both parents finish.

type Parent = P0{} | P1{}

type NestAct = Begin{P Parent} | Spawn{P Parent} | ChildEnd{P Parent} | Finish{P Parent}

let NestB = 2

let NestDesign = 0
let ChildQueuesMutant = 1

// Nested: per parent its step (0 idle, 1 waiting, 2 holding, 3 waiting
// on its child, 4 done) and its child's (0 none, 1 queued, 2 running in
// the parent's grant, 3 running on its own cores, 4 done).
type Nested {
	Pc       []int,
	Kid      []int,
	Lent     bool,
	BothDone bool,
}

func nestWorld() Nested { Nested{Pc: []int{0, 0}, Kid: []int{0, 0}, Lent: false, BothDone: false} }

func parent(p Parent) int {
	match p {
	case P0:
		return 0
	case P1:
		return 1
	}
}

func both() []int { []int{0, 1} }

// nestUsed is the cores taken from the host: a holding parent's, and a
// child's own (ChildQueues only).
func nestUsed(n Nested) int {
	let mut u = 0
	for p in both() {
		if n.Pc[p] == 2 || n.Pc[p] == 3 {
			u = u + 1
		}
		if n.Kid[p] == 3 {
			u = u + 1
		}
	}
	return u
}

// serveKids gives free cores to queued children (ChildQueues only).
func serveKids(n0 Nested) Nested {
	let mut n = n0
	for p in both() {
		if n.Kid[p] == 1 && nestUsed(n) < NestB {
			n.Kid[p] = 3
		}
	}
	return n
}

func serveParents(n0 Nested) Nested {
	let mut n = n0
	for p in both() {
		if n.Pc[p] == 1 && nestUsed(n) < NestB {
			n.Pc[p] = 2
		}
	}
	return n
}

func nestNext(m int, n0 Nested, a NestAct) Option[Nested] {
	let mut n = n0
	match a {
	case Begin as x:
		let p = parent(x.P)
		if n.Pc[p] != 0 {
			return None
		}
		n.Pc[p] = 1
		n = serveParents(n)
	case Spawn as x:
		let p = parent(x.P)
		if n.Pc[p] != 2 || n.Kid[p] != 0 {
			return None
		}
		n.Pc[p] = 3
		if m == ChildQueuesMutant {
			n.Kid[p] = 1
			n = serveKids(n)
		} else {
			n.Kid[p] = 2
			n.Lent = true
		}
	case ChildEnd as x:
		let p = parent(x.P)
		if n.Kid[p] != 2 && n.Kid[p] != 3 {
			return None
		}
		n.Kid[p] = 4
		n = serveKids(n)
		n = serveParents(n)
	case Finish as x:
		let p = parent(x.P)
		if n.Pc[p] != 3 || n.Kid[p] != 4 {
			return None
		}
		n.Pc[p] = 4
		n = serveKids(n)
		n = serveParents(n)
	}
	if n.Pc[0] == 4 && n.Pc[1] == 4 {
		n.BothDone = true
	}
	return Some[Nested]{Value: n}
}

func nestWith(m int, n Nested, a NestAct) Decision[Nested, string] {
	match nestNext(m, n, a) {
	case None:
		Ignore
	case Some[Nested] as x:
		Enter[Nested]{Next: x.Value}
	}
}

func nestDesign(n Nested, a NestAct) Decision[Nested, string]  { nestWith(NestDesign, n, a) }
func childQueues(n Nested, a NestAct) Decision[Nested, string] { nestWith(ChildQueuesMutant, n, a) }

func noHolderWaitsOnQueue(n Nested) bool {
	for p in both() {
		if n.Pc[p] == 3 && n.Kid[p] == 1 {
			return false
		}
	}
	return true
}

// stuck is the deadlock: both parents wait on queued children.
func stuck(n Nested) bool { n.Pc[0] == 3 && n.Kid[0] == 1 && n.Pc[1] == 3 && n.Kid[1] == 1 }

func lent(n Nested) bool     { n.Lent }
func bothDone(n Nested) bool { n.BothDone }

type Nest machine[Nested, NestAct] {
	initial: nestWorld(),
	step:    nestDesign,

	law NoHolderWaitsOnQueue always noHolderWaitsOnQueue,

	law ChildInGrant sometimes lent,
	law BothFinish sometimes bothDone,
}

type ChildQueues machine[Nested, NestAct] {
	initial: nestWorld(),
	step:    childQueues,

	law Breaks sometimes stuck,
}
