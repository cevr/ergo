// The package registry is the design model of the workspace registry of the
// general workspace tool (SEMWS plan r2, §2.11): how create, leaf removal
// and purge stay consistent when two callers race and when a process dies
// in the middle. It is the model for anomalyco/rift#56. Checked by
// `ergo test <this folder>`: a breadth-first search of every state in the
// scope below.
//
// The world: one path P that holds a workspace X. X has an id: 1 at the
// start; a third party can replace it by a new workspace with id 2 at the
// same path. One possible child Y, a copy of the workspace at P.
//
// The registry holds a row for each workspace: none, Creating (a
// reservation: the copy is not made yet), Active, Removing (an intent: the
// move to the trash is not confirmed yet), Trashed. The disk holds a folder
// for each: none, at its path, or in the trash.
//
// Three callers:
//
//   - A made X with id 1 and removes it: removeLeaf(P, expect 1).
//       lock; finish any intent a dead process left; read the row at P;
//       the id is not the expected one: answer AlreadyRemoved when the
//       expected id is in the trash or was purged (the registry keeps a
//       tombstone), else IdMismatch; the workspace has a
//       child row: answer HasDescendants; write the intent Removing; move
//       the folder to the trash; write Trashed; unlock.
//   - B copies from P: create(P).
//       lock; read the row at P; not Active: answer SourceMissing; write
//       the reservation Creating(Y, parent); unlock; copy (no lock is held
//       while the files are copied); lock; write Active; unlock.
//   - A third party: Replace (remove X with id 1 when it is a leaf and make
//     a new workspace with id 2 at P, in one locked step) and Purge (delete
//     the folders in the trash and keep their rows as tombstones; delete a
//     reservation whose maker is dead).
//
// A and B can each die once, at any step. A dead process holds no lock
// (the lock is a kernel file lock). A starts again from the top after it
// died: that is the caller's retry.
//
// The invariants (law Safe):
//
//   - RemovedOnlyExpected: A moves to the trash only the workspace with the
//     id it expects, and never a workspace another caller made.
//   - LeafOnly: no workspace is in the trash, or on its way there, while it
//     has a child row.
//   - when no process is in the middle of a step sequence:
//     NoOrphan (every workspace folder has a row), ActiveHasFolder (an
//     Active row has its folder at its path), TrashedInTrash (a Trashed row
//     has its folder in the trash).
//
// Mutants, each a machine whose law Breaks must hold:
//   - NoLock: no lock across read, check and act (Rift today).
//   - NoExpect: remove by path, with no expected id (Rift today).
//   - SubtreeRemove: remove takes the children with it (Rift today).
//   - NoIntent: move the folder first, write the registry after, with no
//     intent row; a death between the two (Rift today).
//   - CopyFirst: copy first, write the row after, with no reservation; a
//     death between the two (Rift today).
//
// Witnesses, each a machine whose law Exists must hold: the remove wins and
// the create answers SourceMissing; the create wins and the remove answers
// HasDescendants; A dies after the move and its retry answers
// AlreadyRemoved; after Replace and Purge, A answers AlreadyRemoved and
// the new workspace at P is not touched; B dies
// with a reservation, Purge collects it, and A's remove then succeeds.
//
// Scope: one path, two ids, one child, one death per caller. "proved" means
// proved in this scope.

type Who = A{} | B{}

type Signal = Act{W Who} | Die{W Who} | Replace{} | Purge{}

// Row: 0 none, 1 Active, 2 Removing, 3 Trashed, 4 Purged (a tombstone:
// the id is remembered, the folder is deleted). Dir: 0 none, 1 at the
// path, 2 in the trash. YRow: 0 none, 1 Creating, 2 Active, 3 Trashed.
// ARes: 0 none, 1 Trashed, 2 AlreadyRemoved, 3 IdMismatch,
// 4 HasDescendants (3 is in the tool for an id the registry never saw; this
// scope has no such id). BRes: 0 none, 1 Created, 2 SourceMissing.
type World {
	Lock    int,
	Gen     int,
	Row     []int,
	Dir     []int,
	YRow    int,
	YParent int,
	YDir    int,
	Apc     int,
	ARes    int,
	ATarget int,
	ADied   bool,
	Bpc     int,
	BRes    int,
	BSrc    int,
	BDied   bool,
	Swept   bool,
	Bad     string,
}

type State = Live{W World} | Broken{Why string} | RemoveWon{} | CreateWon{} | RetryAnswered{} | Spared{} | Collected{}

func initial() State {
	return Live{W: World{Lock: 0, Gen: 1, Row: []int{1, 0}, Dir: []int{1, 0}, YRow: 0, YParent: 0, YDir: 0,
		Apc: 0, ARes: 0, ATarget: 0, ADied: false, Bpc: 0, BRes: 0, BSrc: 0, BDied: false, Swept: false, Bad: ""}}
}

func idle(pc int) bool {
	return pc == 0 || pc == 9
}

func safe(w World) string {
	if w.Bad != "" {
		return w.Bad
	}
	for t in []int{0, 1} {
		if (w.Row[t] == 2 || w.Row[t] == 3) && (w.YRow == 1 || w.YRow == 2) && w.YParent == t + 1 {
			return "LeafOnly"
		}
	}
	if w.Lock == 0 && idle(w.Apc) && idle(w.Bpc) {
		if w.YDir == 1 && w.YRow == 0 {
			return "NoOrphan"
		}
		if w.YRow == 2 && w.YDir != 1 {
			return "ActiveHasFolder"
		}
		for t in []int{0, 1} {
			if w.Dir[t] != 0 && (w.Row[t] == 0 || w.Row[t] == 4) {
				return "NoOrphan"
			}
			if w.Row[t] == 1 && w.Dir[t] != 1 {
				return "ActiveHasFolder"
			}
			if w.Row[t] == 3 && w.Dir[t] != 2 {
				return "TrashedInTrash"
			}
		}
	}
	return ""
}

// recover finishes an intent that a dead process left. Every mutation runs
// it first, under the lock.
func recover(w World) World {
	let mut r = w
	for t in []int{0, 1} {
		if r.Row[t] == 2 {
			r.Dir[t] = 2
			r.Row[t] = 3
		}
	}
	return r
}

func step(s State, event Signal, mutant int, witness int) Decision[State, string] {
	match s {
	case Live as l:
		let mut w = l.W
		match event {
		case Act as a:
			match a.W {
			case A:
				if w.Apc == 0 {
					if mutant != 1 {
						if w.Lock != 0 {
							return Ignore
						}
						w.Lock = 1
					}
					w.Apc = 1
				} else if w.Apc == 1 {
					if mutant != 4 {
						w = recover(w)
					}
					let g = w.Gen
					let mut target = 1
					let mut done = false
					if mutant == 2 && w.Row[g - 1] == 1 {
						// remove by path: whatever is at P now
						target = g
					} else if w.Row[g - 1] != 1 || g != 1 {
						if w.Row[0] == 3 || w.Row[0] == 4 {
							w.ARes = 2
						} else {
							w.ARes = 3
						}
						done = true
					}
					if !done && w.YRow != 0 && w.YRow != 3 && w.YParent == target && mutant != 3 {
						w.ARes = 4
						done = true
					}
					if done {
						if w.Lock == 1 {
							w.Lock = 0
						}
						w.Apc = 9
					} else {
						w.ATarget = target
						w.Apc = 2
					}
				} else if w.Apc == 2 {
					if mutant != 4 {
						w.Row[w.ATarget - 1] = 2
					}
					w.Apc = 3
				} else if w.Apc == 3 {
					w.Dir[w.ATarget - 1] = 2
					if mutant == 3 && w.YRow == 2 && w.YParent == w.ATarget {
						w.YDir = 2
					}
					w.Apc = 4
				} else if w.Apc == 4 {
					w.Row[w.ATarget - 1] = 3
					if w.ATarget != 1 {
						w.Bad = "RemovedOnlyExpected"
					}
					if mutant == 3 && w.YRow == 2 && w.YParent == w.ATarget {
						w.YRow = 3
						w.Bad = "RemovedOnlyExpected"
					}
					w.ARes = 1
					if w.Lock == 1 {
						w.Lock = 0
					}
					w.Apc = 9
				} else {
					return Ignore
				}
			case B:
				if w.Bpc == 0 {
					if mutant != 1 {
						if w.Lock != 0 {
							return Ignore
						}
						w.Lock = 2
					}
					w.Bpc = 1
				} else if w.Bpc == 1 {
					if mutant != 4 {
						w = recover(w)
					}
					let g = w.Gen
					if w.Row[g - 1] != 1 {
						w.BRes = 2
						w.Bpc = 9
					} else {
						w.BSrc = g
						if mutant != 5 {
							w.YRow = 1
							w.YParent = g
						}
						w.Bpc = 2
					}
					if w.Lock == 2 {
						w.Lock = 0
					}
				} else if w.Bpc == 2 {
					// the copy: no lock is held
					if w.Dir[w.BSrc - 1] != 1 {
						// the source folder is gone: give the reservation back
						if mutant != 1 && w.Lock != 0 {
							return Ignore
						}
						if w.YRow == 1 {
							w.YRow = 0
							w.YParent = 0
						}
						w.BRes = 2
						w.Bpc = 9
					} else {
						w.YDir = 1
						w.Bpc = 3
					}
				} else if w.Bpc == 3 {
					if mutant != 1 && w.Lock != 0 {
						return Ignore
					}
					if mutant == 5 && w.Row[w.BSrc - 1] != 1 {
						// the parent row is gone: undo the copy
						w.YDir = 0
						w.BRes = 2
					} else {
						w.YRow = 2
						w.YParent = w.BSrc
						w.BRes = 1
					}
					w.Bpc = 9
				} else {
					return Ignore
				}
			}
		case Die as d:
			match d.W {
			case A:
				if w.ADied || w.Apc < 1 || w.Apc > 4 {
					return Ignore
				}
				w.ADied = true
				if w.Lock == 1 {
					w.Lock = 0
				}
				w.Apc = 0
			case B:
				if w.BDied || w.Bpc < 1 || w.Bpc > 3 {
					return Ignore
				}
				w.BDied = true
				if w.Lock == 2 {
					w.Lock = 0
				}
				w.Bpc = 9
			}
		case Replace:
			if w.Lock != 0 || w.Gen != 1 || w.Row[0] != 1 || w.YRow != 0 {
				return Ignore
			}
			w.Row[0] = 3
			w.Dir[0] = 2
			w.Row[1] = 1
			w.Dir[1] = 1
			w.Gen = 2
		case Purge:
			if w.Lock != 0 {
				return Ignore
			}
			let mut changed = false
			if mutant != 4 {
				w = recover(w)
			}
			for t in []int{0, 1} {
				if w.Row[t] == 3 && w.Dir[t] == 2 {
					// the folder is deleted; the row stays as a tombstone
					w.Row[t] = 4
					w.Dir[t] = 0
					changed = true
				}
			}
			if w.YRow == 1 && w.BDied && w.Bpc == 9 {
				w.YRow = 0
				w.YParent = 0
				w.YDir = 0
				w.Swept = true
				changed = true
			}
			if !changed {
				return Ignore
			}
		}
		let why = safe(w)
		if why != "" {
			return Enter{Broken{Why: why}}
		}
		if witness == 1 && w.ARes == 1 && w.BRes == 2 {
			return Enter{RemoveWon}
		}
		if witness == 2 && w.BRes == 1 && w.ARes == 4 {
			return Enter{CreateWon}
		}
		if witness == 3 && w.ADied && w.ARes == 2 && w.Gen == 1 {
			return Enter{RetryAnswered}
		}
		if witness == 4 && w.ARes == 2 && w.Gen == 2 && w.Row[0] == 4 && w.Row[1] == 1 && w.Dir[1] == 1 {
			return Enter{Spared}
		}
		if witness == 5 && w.Swept && w.ARes == 1 {
			return Enter{Collected}
		}
		return Enter{Live{W: w}}
	case _:
		return Ignore
	}
}

func design(s State, sig Signal) Decision[State, string]        { return step(s, sig, 0, 0) }
func noLock(s State, sig Signal) Decision[State, string]        { return step(s, sig, 1, 0) }
func noExpect(s State, sig Signal) Decision[State, string]      { return step(s, sig, 2, 0) }
func subtreeRemove(s State, sig Signal) Decision[State, string] { return step(s, sig, 3, 0) }
func noIntent(s State, sig Signal) Decision[State, string]      { return step(s, sig, 4, 0) }
func copyFirst(s State, sig Signal) Decision[State, string]     { return step(s, sig, 5, 0) }
func removeWon(s State, sig Signal) Decision[State, string]     { return step(s, sig, 0, 1) }
func createWon(s State, sig Signal) Decision[State, string]     { return step(s, sig, 0, 2) }
func retryAnswered(s State, sig Signal) Decision[State, string] { return step(s, sig, 0, 3) }
func spared(s State, sig Signal) Decision[State, string]        { return step(s, sig, 0, 4) }
func collected(s State, sig Signal) Decision[State, string]     { return step(s, sig, 0, 5) }

type Design machine[State, Signal] { initial: initial(), step: design, law Safe never reaches Broken }
type NoLock machine[State, Signal] { initial: initial(), step: noLock, law Breaks reaches Broken }
type NoExpect machine[State, Signal] { initial: initial(), step: noExpect, law Breaks reaches Broken }
type SubtreeRemove machine[State, Signal] { initial: initial(), step: subtreeRemove, law Breaks reaches Broken }
type NoIntent machine[State, Signal] { initial: initial(), step: noIntent, law Breaks reaches Broken }
type CopyFirst machine[State, Signal] { initial: initial(), step: copyFirst, law Breaks reaches Broken }
type RemoveWonWitness machine[State, Signal] { initial: initial(), step: removeWon, law Exists reaches RemoveWon }
type CreateWonWitness machine[State, Signal] { initial: initial(), step: createWon, law Exists reaches CreateWon }
type RetryAnsweredWitness machine[State, Signal] { initial: initial(), step: retryAnswered, law Exists reaches RetryAnswered }
type SparedWitness machine[State, Signal] { initial: initial(), step: spared, law Exists reaches Spared }
type CollectedWitness machine[State, Signal] { initial: initial(), step: collected, law Exists reaches Collected }
