}
func stepWorkBeforeCommit(s St, a Act) Decision[St, string] {
	stepWith(mutant(WorkBeforeCommitMutant, "WorkOnlyInItsEntry"), s, a)
}
func stepPublishFirst(s St, a Act) Decision[St, string] {
	stepWith(mutant(PublishFirstMutant, "ObserversAfterWork"), s, a)
}
func stepNotifyTwice(s St, a Act) Decision[St, string] {
	stepWith(mutant(NotifyTwiceMutant, "ChangesInOrderOnce"), s, a)
}
func stepSkipBeforeStop(s St, a Act) Decision[St, string] {
	stepWith(mutant(SkipBeforeStopMutant, "NothingAfterEnd"), s, a)
}
func stepStaleSnapshot(s St, a Act) Decision[St, string] {
	stepWith(mutant(StaleSnapshotMutant, "WaitForMatchesReplay"), s, a)
}
func stepDrainDrops(s St, a Act) Decision[St, string] {
	stepWith(mutant(DrainDropsMutant, "DrainStepsQueued"), s, a)
}
func stepOutputLate(s St, a Act) Decision[St, string] {
	stepWith(mutant(OutputLateMutant, "OutputBeforeShown"), s, a)
}

