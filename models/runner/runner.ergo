// The witnesses (Quint's no… values for design2). Each is the design's
// step, with the witness counters, that enters Seen when the witness
// holds for an action: on the state it reaches, or, for the observer
// witnesses, on the action.
let StaleTickWitness = 1
let StaleResultWitness = 2
let InterruptedWorkWitness = 3
let DefectEndWitness = 4
let EndAfterAsksWitness = 5
let FullInboxWitness = 6
let TwoSendersQueuedWitness = 7
let LongObserverWitness = 8
let LateWaitWitness = 9
let StopOvertakesWitness = 10
let DrainEndWitness = 11
let EmitSeenWitness = 12

func witnessed(k int, c Cfg, w World, a Act, v World) bool {
	if k == StaleTickWitness {
		return v.Runner == Busy && v.Cur.Kind == Tick && v.Cur.Epoch != 0
	}
	if k == StaleResultWitness {
		return v.Runner == Busy && v.Cur.Kind == Result && v.Cur.Epoch != 0
	}
	if k == InterruptedWorkWitness {
		return v.Work == Stopping
	}
	if k == DefectEndWitness {
		return v.Runner == Busy && v.Cur.Kind == Defect
	}
	if k == EndAfterAsksWitness {
		return v.Runner == Ended && sendersDone(c, v) && v.Asked >= 2
	}
	if k == FullInboxWitness {
		return len(v.Inbox) == Cap
	}
	if k == TwoSendersQueuedWitness {
		return len(v.Inbox) == Cap && v.Inbox[0].Sender != v.Inbox[1].Sender && v.Inbox[0].Sender >= 0 && v.Inbox[1].Sender >= 0
	}
	if k == StopOvertakesWitness {
		if v.Runner != Ended || v.EndBy != ByStop {
			return false
		}
		for o in v.Obs {
			if o.Sub && !o.Done && len(o.Buf) > 0 {
				return true
			}
		}
		return false
	}
	if k == DrainEndWitness {
		return v.EndBy == ByDrain && v.Admitted >= 2
	}
	match a {
	case ObserverEnds as e:
		// An observer read three states to the end.
		k == LongObserverWitness && w.Obs[obIx(e.O)].Count >= 3
	case Subscribe:
		// A wait begins after two commits.
		k == LateWaitWitness && w.Shown >= 2
	case Observe as e:
		// An observer reads a state an Emit wrote.
		k == EmitSeenWitness && w.Emits[w.Obs[obIx(e.O)].Buf[0]]
	case _:
		false
	}
}

func stepWitness(k int, s St, a Act) Decision[St, string] {
	let c = Cfg{M: NoMutant, Senders: 2, Ghost: k, Only: ""}
	match s {
	case Live as l:
		match next(c, l.W, a) {
		case None:
			Ignore
		case Some[World] as n:
			if witnessed(k, c, l.W, a, n.Value) {
				Enter[St]{Next: Seen{What: "witness"}}
			} else {
				Enter[St]{Next: Live{W: canon(c, n.Value)}}
			}
		}
	case _:
		stepWith(c, s, a)
	}
}

func stepStaleTick(s St, a Act) Decision[St, string]        { stepWitness(StaleTickWitness, s, a) }
func stepStaleResult(s St, a Act) Decision[St, string]      { stepWitness(StaleResultWitness, s, a) }
func stepInterruptedWork(s St, a Act) Decision[St, string]  { stepWitness(InterruptedWorkWitness, s, a) }
func stepDefectEnd(s St, a Act) Decision[St, string]        { stepWitness(DefectEndWitness, s, a) }
func stepEndAfterAsks(s St, a Act) Decision[St, string]     { stepWitness(EndAfterAsksWitness, s, a) }
func stepFullInbox(s St, a Act) Decision[St, string]        { stepWitness(FullInboxWitness, s, a) }
func stepTwoSendersQueued(s St, a Act) Decision[St, string] { stepWitness(TwoSendersQueuedWitness, s, a) }
func stepLongObserver(s St, a Act) Decision[St, string]     { stepWitness(LongObserverWitness, s, a) }
func stepLateWait(s St, a Act) Decision[St, string]         { stepWitness(LateWaitWitness, s, a) }
func stepStopOvertakes(s St, a Act) Decision[St, string]    { stepWitness(StopOvertakesWitness, s, a) }
func stepDrainEnd(s St, a Act) Decision[St, string]         { stepWitness(DrainEndWitness, s, a) }
func stepEmitSeen(s St, a Act) Decision[St, string]         { stepWitness(EmitSeenWitness, s, a) }

type StaleTick machine[St, Act] {
	initial: first(),
	step:    stepStaleTick,

	law Reached reaches Seen,
}

