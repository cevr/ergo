/bin/
# Run receipts and scratch files are never source.
tmp/
# ergo build and ergo run write dist/ under the working directory, wherever
# that is (cmd/ergo outputPath); no dist/ at any depth is source.
dist/
# scripts/bootstrap writes its stages under .bootstrap/ by default.
.bootstrap/
__pycache__/
# The site's token generator installs its pinned highlighter here.
/site/tokens/node_modules/
