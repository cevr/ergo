+++ b/src/cmd/compile/internal/ergoir/ergoir_f7.go
@@ -0,0 +1,50 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ergoir
+
+import (
+	"strconv"
+	"strings"
+
+	"cmd/compile/internal/types2"
+)
+
+// arrayType resolves the spelling [N]T of an array type (FLIP F7): ok is
+// false for any other spelling, and the type is nil when T is no type.
+func (c *ergoChecker) arrayType(p ergoPos, s string) (types2.Type, bool) {
+	rest, ok := strings.CutPrefix(s, "[")
+	if !ok {
+		return nil, false
+	}
+	i := strings.IndexByte(rest, ']')
+	if i <= 0 {
+		return nil, false
+	}
+	n, err := strconv.ParseInt(rest[:i], 10, 64)
+	if err != nil || n < 0 {
+		return nil, false
+	}
+	e := c.typ(p, rest[i+1:])
+	if e == nil {
+		return nil, true
+	}
+	return types2.NewArray(e, n), true
+}
+
+// ergoIndexElem is the element type of an "index" of a value of type t
+// (FLIP F7): a slice's or an array's element, or a byte of a string; nil
+// for any other type.
+func ergoIndexElem(t types2.Type) types2.Type {
+	switch u := types2.CoreType(t).(type) {
+	case *types2.Slice:
+		return u.Elem()
+	case *types2.Array:
+		return u.Elem()
+	}
+	if ergoIsString(t) {
+		return types2.Typ[types2.Byte]
+	}
+	return nil
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_f7b.go b/src/cmd/compile/internal/ergoir/ergoir_f7b.go
new file mode 100644
index 0000000..4937be9
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_f7b.go
@@ -0,0 +1,52 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: F7 lane B's statements. See ergoir.go.
+//
+// "mapget" is Go's comma-ok read of a map, v, ok := m[k] (Local v, Val
+// ok, X the map, Y the key): the index expression's type is the tuple
+// (V, bool), as types2 records a comma-ok form (recordCommaOkTypes), so
+// the unified writer writes an N:1 assignment, which the reader types as
+// OAS2MAPR.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// f7bStmt decodes s when it is one of lane B's forms.
+func (c *ergoChecker) f7bStmt(s *ergoStmt) (syntax.Stmt, bool) {
+	if s.K != "mapget" {
+		return nil, false
+	}
+	pos := c.pos(s.Pos)
+	if s.Val == nil || s.X == nil || s.Y == nil {
+		c.errorf(s.Pos, "ergoir: mapget without its ok local, map or key")
+		return nil, true
+	}
+	v, ok := c.local(s.Pos, s.Local), c.local(s.Pos, *s.Val)
+	m, mt := c.expr(s.X)
+	k, kt := c.expr(s.Y)
+	if v == nil || ok == nil || m == nil || k == nil {
+		return nil, true
+	}
+	mp, isMap := types2.CoreType(mt).(*types2.Map)
+	if !isMap {
+		c.errorf(s.Pos, "ergoir: mapget of %v", mt)
+		return nil, true
+	}
+	if !c.assignable(s.Pos, "mapget key", kt, mp.Key()) || !c.assignable(s.Pos, "mapget value", mp.Elem(), v.Type()) || !c.assignable(s.Pos, "mapget ok", types2.Typ[types2.Bool], ok.Type()) {
+		return nil, true
+	}
+	ix := &syntax.IndexExpr{X: m, Index: k}
+	ix.SetPos(pos)
+	ergoValue(ix, types2.NewTuple(types2.NewParam(pos, nil, "", mp.Elem()), types2.NewParam(pos, nil, "", types2.Typ[types2.Bool])), nil)
+	lhs := &syntax.ListExpr{ElemList: []syntax.Expr{c.name(s.Pos, v, true), c.name(s.Pos, ok, true)}}
+	lhs.SetPos(pos)
+	a := &syntax.AssignStmt{Op: syntax.Def, Lhs: lhs, Rhs: ix}
+	a.SetPos(pos)
+	return a, true
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_f7f.go b/src/cmd/compile/internal/ergoir/ergoir_f7f.go
new file mode 100644
index 0000000..482f09f
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_f7f.go
@@ -0,0 +1,113 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: deferred calls (FLIP F7, owned values). See ergoir.go.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoNewZero is *new(T), the zero value of the type parameter T as Go
+// source spells it. A nil the writer encodes as T's zero (exprZero) would
+// reach the reader as ir.NewZero of T's shape, which for a struct or an
+// array is a composite literal that misses typecheck (a fallible generic
+// body's failure: arena's Free on lru's node).
+func ergoNewZero(pos syntax.Pos, tp *types2.TypeParam, info *types2.Info) syntax.Expr {
+	tn := syntax.NewName(pos, tp.Obj().Name())
+	info.Uses[tn] = tp.Obj()
+	ttv := syntax.TypeAndValue{Type: tp}
+	ttv.SetIsType()
+	tn.SetTypeInfo(ttv)
+	ptr := types2.NewPointer(tp)
+	fn := syntax.NewName(pos, "new")
+	info.Uses[fn] = types2.Universe.Lookup("new")
+	ftv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil,
+		types2.NewTuple(types2.NewParam(pos, nil, "", tp)),
+		types2.NewTuple(types2.NewParam(pos, nil, "", ptr)), false)}
+	ftv.SetIsBuiltin()
+	fn.SetTypeInfo(ftv)
+	call := &syntax.CallExpr{Fun: fn, ArgList: []syntax.Expr{tn}}
+	call.SetPos(pos)
+	ergoValue(call, ptr, nil)
+	x := &syntax.Operation{Op: syntax.Mul, X: call}
+	x.SetPos(pos)
+	ergoValue(x, tp, nil)
+	return x
+}
+
+// deferStmt is defer X, X a call of a function of the package with no
+// result: a frame's release (the Ergo lowering's static frame, whose
+// deferred function releases the values the frame still owns and reads
+// the frame's panic with recover). Go runs it on every exit of the
+// function, a panic's included.
+//
+// X may also be an "mcall" with no result: a frame scope's End, deferred
+// directly so that its recover sees the frame's panic (runtime/v1
+// Scope.End).
+func (c *ergoChecker) deferStmt(s *ergoStmt, pos syntax.Pos) syntax.Stmt {
+	if s.X == nil || s.X.K != "call" && s.X.K != "mcall" {
+		c.errorf(s.Pos, "ergoir: a deferred statement is a call of a function of the package or a method")
+		return nil
+	}
+	if len(c.loops) > 0 {
+		// Go defers a call in a loop once per iteration; the lowering
+		// defers a frame's release once, at the frame's start.
+		c.errorf(s.Pos, "ergoir: defer inside a loop")
+		return nil
+	}
+	x, t := c.expr(s.X)
+	if x == nil {
+		return nil
+	}
+	if t != nil {
+		// A call with no result has no type (call).
+		c.errorf(s.Pos, "ergoir: a deferred call has a result of type %v", t)
+		return nil
+	}
+	call, ok := x.(*syntax.CallExpr)
+	if !ok {
+		c.errorf(s.Pos, "ergoir: a deferred statement is a call")
+		return nil
+	}
+	st := &syntax.CallStmt{Tok: syntax.Defer, Call: call}
+	st.SetPos(pos)
+	return st
+}
+
+// recoverExpr is "recover": Go's builtin recover(), of type any. Only a
+// function a frame defers directly reads its frame's panic with it (a
+// static frame's release, FLIP F7 RELEASE-IR).
+func (c *ergoChecker) recoverExpr(x *ergoExpr) (syntax.Expr, types2.Type) {
+	pos := c.pos(x.Pos)
+	any := types2.Universe.Lookup("any").Type()
+	fun := syntax.NewName(pos, "recover")
+	c.info.Uses[fun] = types2.Universe.Lookup("recover")
+	tv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil, nil,
+		types2.NewTuple(types2.NewParam(pos, nil, "", any)), false)}
+	tv.SetIsBuiltin()
+	fun.SetTypeInfo(tv)
+	call := &syntax.CallExpr{Fun: fun}
+	call.SetPos(pos)
+	ergoValue(call, any, nil)
+	return call, any
+}
+
+// resultExpr is "result" I: the function's named result I, which a
+// frame's deferred End settles (End(&err): the frame's named error
+// result, a Go function's only way to set its result after return).
+func (c *ergoChecker) resultExpr(x *ergoExpr) (syntax.Expr, types2.Type) {
+	if x.I < 0 || x.I >= c.sig.Results().Len() {
+		c.errorf(x.Pos, "ergoir: result %d out of range", x.I)
+		return nil, nil
+	}
+	v := c.sig.Results().At(x.I)
+	if v.Name() == "" || v.Name() == "_" {
+		c.errorf(x.Pos, "ergoir: result %d has no name", x.I)
+		return nil, nil
+	}
+	return c.name(x.Pos, v, false), v.Type()
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_fail.go b/src/cmd/compile/internal/ergoir/ergoir_fail.go
new file mode 100644
index 0000000..9f94f09
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_fail.go
@@ -0,0 +1,308 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: the failure ABI. See ergoir.go.
+//
+// A fallible Ergo function returns (T, error), or error when it has no
+// value. "ret" is its success return (the error slot is nil); "fail"
+// leaves with the zero value and an error; "def2" binds a fallible call's
+// value and error; "tswitch" is a catch's type switch on an error, and
+// "assert" reads the case's type out of it; "panic" (ergoir_stmt.go) is a
+// total catch's default.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoCase is one clause of a "tswitch": its types, or none for the
+// default clause.
+type ergoCase struct {
+	Pos   ergoPos     `json:"pos"`
+	Types []string    `json:"types"`
+	Body  []*ergoStmt `json:"body,omitempty"`
+	// Vals are a "switch" case's constants (ergoir_union.go); Def marks
+	// the default clause in its source place.
+	Vals []*ergoExpr `json:"vals,omitempty"`
+	Def  bool        `json:"def,omitempty"`
+}
+
+// ergoFallible reports a signature of the failure ABI: its last result is
+// the universe's error, after at most one value.
+func ergoFallible(sig *types2.Signature) bool {
+	n := sig.Results().Len()
+	return (n == 1 || n == 2) && types2.Identical(sig.Results().At(n-1).Type(), ergoError())
+}
+
+func ergoError() types2.Type { return types2.Universe.Lookup("error").Type() }
+
+// ergoSigOK admits a signature: at most one result, or the failure ABI.
+func ergoSigOK(sig *types2.Signature) bool {
+	return sig.Results().Len() <= 1 || sig.Results().Len() == 2 && ergoFallible(sig)
+}
+
+// nilOf is the zero value of t, spelled as the untyped nil the writer
+// encodes as a typed zero (exprZero).
+func (c *ergoChecker) nilOf(p ergoPos, t types2.Type) syntax.Expr {
+	switch t.Underlying().(type) {
+	case *types2.Struct, *types2.Array:
+		// The reader's zero of a struct or an array (ir.NewZero) is a
+		// composite literal that was never typechecked, which later
+		// passes reject; spell T{} instead.
+		l := &syntax.CompositeLit{}
+		l.SetPos(c.pos(p))
+		tv := syntax.TypeAndValue{Type: t}
+		tv.SetIsValue()
+		l.SetTypeInfo(tv)
+		return l
+	}
+	if tp, ok := t.(*types2.TypeParam); ok {
+		return ergoNewZero(c.pos(p), tp, c.info) // ergoir_f7f.go
+	}
+	n := syntax.NewName(c.pos(p), "nil")
+	c.info.Uses[n] = types2.Universe.Lookup("nil")
+	tv := syntax.TypeAndValue{Type: t}
+	tv.SetIsValue()
+	tv.SetIsNil()
+	n.SetTypeInfo(tv)
+	return n
+}
+
+// typeNameExpr is the type spelled s used as an expression (a case or an
+// assertion): a name of the universe or of the package, or a qualified
+// name (typeExpr).
+func (c *ergoChecker) typeNameExpr(p ergoPos, s string) (syntax.Expr, types2.Type) {
+	t := c.typ(p, s)
+	if t == nil {
+		return nil, nil
+	}
+	x := c.typeExpr(p, t)
+	if x == nil {
+		return nil, nil
+	}
+	return x, t
+}
+
+// ret is a return under the signature: a fallible function's success
+// value gets a nil error; a value of the whole result list (a call's
+// tuple, or a unit function's error) passes as it is.
+func (c *ergoChecker) ret(s *ergoStmt) syntax.Stmt {
+	r := &syntax.ReturnStmt{}
+	r.SetPos(c.pos(s.Pos))
+	res := c.sig.Results()
+	fallible := ergoFallible(c.sig)
+	if s.X == nil {
+		switch {
+		case res.Len() == 0:
+		case fallible && res.Len() == 1:
+			r.Results = c.nilOf(s.Pos, ergoError())
+		default:
+			c.errorf(s.Pos, "ergoir: return without its result")
+		}
+		return r
+	}
+	x, t := c.expr(s.X)
+	if x == nil {
+		return nil
+	}
+	if fallible {
+		switch {
+		case res.Len() == 2 && types2.Identical(t, res):
+			r.Results = x // return f(…): a fallible call's tuple
+		case res.Len() == 1 && types2.Identical(t, ergoError()):
+			r.Results = x // a unit function returns a fallible call's error
+		case res.Len() == 2 && c.assignable(s.Pos, "return", t, res.At(0).Type()):
+			l := &syntax.ListExpr{ElemList: []syntax.Expr{x, c.nilOf(s.Pos, ergoError())}}
+			l.SetPos(c.pos(s.Pos))
+			r.Results = l
+		default:
+			if res.Len() == 1 {
+				c.errorf(s.Pos, "ergoir: return of %v from a function with no value", t)
+			}
+			return nil
+		}
+		return r
+	}
+	if res.Len() != 1 || !c.assignable(s.Pos, "return", t, res.At(0).Type()) {
+		return nil
+	}
+	r.Results = x
+	return r
+}
+
+// failStmt decodes the failure ABI's statements; ok is false for a kind
+// it does not know.
+func (c *ergoChecker) failStmt(s *ergoStmt) (st syntax.Stmt, ok bool) {
+	pos := c.pos(s.Pos)
+	switch s.K {
+	case "fail":
+		if !ergoFallible(c.sig) {
+			c.errorf(s.Pos, "ergoir: fail in a function that cannot fail")
+			return nil, true
+		}
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil, true
+		}
+		if !ergoIsErrorValue(t) {
+			c.errorf(s.Pos, "ergoir: fail: %v is not an error", t)
+			return nil, true
+		}
+		r := &syntax.ReturnStmt{}
+		r.SetPos(pos)
+		if res := c.sig.Results(); res.Len() == 2 {
+			l := &syntax.ListExpr{ElemList: []syntax.Expr{c.nilOf(s.Pos, res.At(0).Type()), x}}
+			l.SetPos(pos)
+			r.Results = l
+		} else {
+			r.Results = x
+		}
+		return r, true
+	case "def2":
+		if s.Val == nil {
+			c.errorf(s.Pos, "ergoir: def2 without its error local")
+			return nil, true
+		}
+		v, e := c.local(s.Pos, s.Local), c.local(s.Pos, *s.Val)
+		if s.X == nil || (s.X.K != "call" && s.X.K != "mcall" && s.X.K != "pcall" && s.X.K != "vcall") {
+			c.errorf(s.Pos, "ergoir: def2 of a value that is not a call")
+			return nil, true
+		}
+		x, t := c.expr(s.X)
+		if v == nil || e == nil || x == nil {
+			return nil, true
+		}
+		tup, isTuple := t.(*types2.Tuple)
+		if !isTuple || tup.Len() != 2 || !types2.Identical(tup.At(0).Type(), v.Type()) || !types2.Identical(tup.At(1).Type(), ergoError()) || !types2.Identical(e.Type(), ergoError()) {
+			c.errorf(s.Pos, "ergoir: def2: %v does not bind %v and error", t, v.Type())
+			return nil, true
+		}
+		lhs := &syntax.ListExpr{ElemList: []syntax.Expr{c.name(s.Pos, v, true), c.name(s.Pos, e, true)}}
+		lhs.SetPos(pos)
+		a := &syntax.AssignStmt{Op: syntax.Def, Lhs: lhs, Rhs: x}
+		a.SetPos(pos)
+		return a, true
+	case "tswitch":
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil, true
+		}
+		iface, isIface := types2.CoreType(t).(*types2.Interface)
+		if !isIface {
+			c.errorf(s.Pos, "ergoir: type switch on %v, not an interface", t)
+			return nil, true
+		}
+		guard := &syntax.TypeSwitchGuard{X: x}
+		guard.SetPos(pos)
+		sw := &syntax.SwitchStmt{Tag: guard, Rbrace: c.pos(s.End)}
+		sw.SetPos(pos)
+		seen := map[types2.Type]bool{}
+		hasDef := false
+		for _, k := range s.Cases {
+			if k != nil && k.Def {
+				// The default clause in its source place (ergoir_union.go).
+				cl := c.defClause(k, hasDef || s.Else != nil)
+				if cl == nil {
+					return nil, true
+				}
+				hasDef = true
+				sw.Body = append(sw.Body, cl)
+				continue
+			}
+			if k == nil || len(k.Types) == 0 {
+				c.errorf(s.Pos, "ergoir: a type switch case without a type")
+				return nil, true
+			}
+			cl := &syntax.CaseClause{Body: c.stmts(k.Body)}
+			cl.SetPos(c.pos(k.Pos))
+			var types []syntax.Expr
+			for _, ts := range k.Types {
+				te, tt := c.typeNameExpr(k.Pos, ts)
+				if te == nil {
+					return nil, true
+				}
+				// Go's rule, as an assertion's: a concrete case implements
+				// the error interface; an interface case (a union) is any.
+				if !types2.IsInterface(tt) && !types2.Implements(tt, iface) || seen[tt] {
+					c.errorf(k.Pos, "ergoir: case %v of a switch on %v", tt, t)
+					return nil, true
+				}
+				seen[tt] = true
+				types = append(types, te)
+			}
+			if len(types) == 1 {
+				cl.Cases = types[0]
+			} else {
+				l := &syntax.ListExpr{ElemList: types}
+				l.SetPos(c.pos(k.Pos))
+				cl.Cases = l
+			}
+			sw.Body = append(sw.Body, cl)
+		}
+		if !hasDef {
+			def := &syntax.CaseClause{Body: c.stmts(s.Else)}
+			def.SetPos(c.pos(s.ElsePos))
+			sw.Body = append(sw.Body, def)
+		}
+		return sw, true
+	}
+	return nil, false
+}
+
+// failExpr decodes the failure ABI's expressions; ok is false for a kind
+// it does not know.
+func (c *ergoChecker) failExpr(x *ergoExpr) (e syntax.Expr, t types2.Type, ok bool) {
+	pos := c.pos(x.Pos)
+	switch x.K {
+	case "nil":
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil, true
+		}
+		if !types2.IsInterface(t) {
+			c.errorf(x.Pos, "ergoir: nil of %v", t)
+			return nil, nil, true
+		}
+		return c.nilOf(x.Pos, t), t, true
+	case "zero":
+		// The zero value of any type: a catch's result before its arms.
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil, true
+		}
+		return c.nilOf(x.Pos, t), t, true
+	case "assert":
+		v, vt := c.expr(x.X)
+		if v == nil {
+			return nil, nil, true
+		}
+		te, tt := c.typeNameExpr(x.Pos, x.T)
+		if te == nil {
+			return nil, nil, true
+		}
+		iface, isIface := types2.CoreType(vt).(*types2.Interface)
+		// Go's rule: a concrete type implements the operand's interface;
+		// an interface (a row's error into its union, IRG3b; a union of
+		// another package, IRG4) is checked at run time, as Go's x.(I).
+		if !isIface || !types2.IsInterface(tt) && !types2.Implements(tt, iface) {
+			c.errorf(x.Pos, "ergoir: assertion of %v to %v", vt, tt)
+			return nil, nil, true
+		}
+		a := &syntax.AssertExpr{X: v, Type: te}
+		a.SetPos(pos)
+		ergoValue(a, tt, nil)
+		return a, tt, true
+	}
+	return nil, nil, false
+}
+
+// ergoIsErrorValue reports a type that implements error.
+func ergoIsErrorValue(t types2.Type) bool {
+	if _, isTuple := t.(*types2.Tuple); isTuple || t == nil {
+		return false
+	}
+	return types2.Implements(t, ergoError().Underlying().(*types2.Interface))
+}
