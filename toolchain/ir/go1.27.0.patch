+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ergoir
+
+import "flag"
+
+// ergoFlag holds the -ergoir flag. It is registered on the command line
+// flag set from this file, so Go's own base.CmdFlags is not edited
+// (PATCH-MIN M1): base.ParseFlags parses flag.CommandLine, and cmd/go keys
+// its build cache on the -gcflags that carry it.
+var ergoFlag struct{ IR string }
+
+// Flag is ergoFlag for noder's hooks (noder/ergoir_hook.go).
+var Flag = &ergoFlag
+
+func init() {
+	flag.StringVar(&ergoFlag.IR, "ergoir", "", "experimental: read typed function bodies from Ergo IR `file`")
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_hook.go b/src/cmd/compile/internal/ergoir/ergoir_hook.go
new file mode 100644
index 0000000..fb4a106
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_hook.go
@@ -0,0 +1,54 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package ergoir reads Ergo IR (-ergoir): typed function bodies that
+// replace the Go source's, attached as typed syntax after types2 checked
+// the package and before the unified writer encodes it (PATCH-MIN M4: our
+// code in our own package; noder calls it from one line of unified.go).
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+	"cmd/internal/src"
+)
+
+// Stub is the reader's one entry (noder's ergoStub): with -ergoir it
+// attaches the IR bodies. Their Go text is ergo's to print
+// (lower.IRGoText).
+func Stub(makeXPos func(syntax.Pos) src.XPos, pkg *types2.Package, info *types2.Info, files []*syntax.File) {
+	if ergoFlag.IR == "" {
+		return
+	}
+	noders := make([]*noder, len(files))
+	for i, f := range files {
+		noders[i] = &noder{file: f}
+	}
+	ergoAttach(posMap{makeXPos}, pkg, info, noders)
+}
+
+// noder is the part of noder's noder the reader reads: a file's syntax.
+type noder struct{ file *syntax.File }
+
+// posMap is the part of noder's posMap the reader calls.
+type posMap struct{ xpos func(syntax.Pos) src.XPos }
+
+func (m *posMap) makeXPos(p syntax.Pos) src.XPos { return m.xpos(p) }
+
+// lastNonEmptyStmt and isPtrTo are copies of noder's (writer.go).
+
+func lastNonEmptyStmt(stmts []syntax.Stmt) syntax.Stmt {
+	for i := len(stmts) - 1; i >= 0; i-- {
+		stmt := stmts[i]
+		if _, ok := stmt.(*syntax.EmptyStmt); !ok {
+			return stmt
+		}
+	}
+	return nil
+}
+
+func isPtrTo(from, to types2.Type) bool {
+	ptr, ok := types2.Unalias(from).(*types2.Pointer)
+	return ok && types2.Identical(ptr.Elem(), to)
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_label.go b/src/cmd/compile/internal/ergoir/ergoir_label.go
new file mode 100644
index 0000000..5727829
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_label.go
@@ -0,0 +1,115 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ergoir
+
+// Ergo IR labels (IRG3b): a loop that a break inside a switch leaves
+// carries a label, and the break names it, since Go's unlabeled break
+// leaves the innermost switch; a match tree's shared arm is a labeled
+// block that its leaves reach by goto, as the Ergo emitter writes it
+// (matchtree.go).
+//
+//	{"k": "while"|"range", "label": "loop1", ...}  loop1: for ... { ... }
+//	{"k": "break"|"continue", "label": "loop1"}   break loop1
+//	{"k": "block", "label": "arm1", "body": [...]} arm1: { ... }
+//	{"k": "block", "body": [...]}                 { ... }
+//	{"k": "goto", "label": "arm1"}                goto arm1
+//
+// A label is a Go identifier, declared once per function; a break or
+// continue names a loop around it; a goto names a block of the function
+// (checked when the function's body is done, ergoLabelsDone).
+
+import (
+	"go/token"
+
+	"cmd/compile/internal/syntax"
+)
+
+// labeled is st, labeled with s.Label when it has one.
+func (c *ergoChecker) labeled(s *ergoStmt, st syntax.Stmt) syntax.Stmt {
+	if s.Label == "" || st == nil {
+		return st
+	}
+	if !c.declareLabel(s) {
+		return nil
+	}
+	l := &syntax.LabeledStmt{Label: syntax.NewName(c.pos(s.Pos), s.Label), Stmt: st}
+	l.SetPos(c.pos(s.Pos))
+	return l
+}
+
+func (c *ergoChecker) declareLabel(s *ergoStmt) bool {
+	if !token.IsIdentifier(s.Label) || s.Label == "_" {
+		c.errorf(s.Pos, "ergoir: label %q", s.Label)
+		return false
+	}
+	if c.labels == nil {
+		c.labels = map[string]bool{}
+	}
+	if c.labels[s.Label] {
+		c.errorf(s.Pos, "ergoir: label %s declared twice", s.Label)
+		return false
+	}
+	c.labels[s.Label] = true
+	return true
+}
+
+// labelStmt decodes a block or a goto, and a labeled break or continue.
+func (c *ergoChecker) labelStmt(s *ergoStmt) (syntax.Stmt, bool) {
+	pos := c.pos(s.Pos)
+	switch s.K {
+	case "block":
+		return c.labeled(s, c.block(s.Pos, s.End, s.Body)), true
+	case "goto":
+		if !token.IsIdentifier(s.Label) {
+			c.errorf(s.Pos, "ergoir: goto %q", s.Label)
+			return nil, true
+		}
+		c.gotos = append(c.gotos, s)
+		st := &syntax.BranchStmt{Tok: syntax.Goto, Label: syntax.NewName(pos, s.Label)}
+		st.SetPos(pos)
+		return st, true
+	}
+	return nil, false
+}
+
+// branch is a break or continue of the loop labeled s.Label, or of the
+// innermost loop.
+func (c *ergoChecker) branch(s *ergoStmt) syntax.Stmt {
+	pos := c.pos(s.Pos)
+	if len(c.loops) == 0 {
+		c.errorf(s.Pos, "ergoir: %s outside a loop", s.K)
+		return nil
+	}
+	st := &syntax.BranchStmt{Tok: syntax.Break, Target: c.loops[len(c.loops)-1]}
+	if s.K == "continue" {
+		st.Tok = syntax.Continue
+	}
+	if s.Label != "" {
+		target := -1
+		for i, l := range c.loopLabels {
+			if l == s.Label {
+				target = i
+			}
+		}
+		if target < 0 {
+			c.errorf(s.Pos, "ergoir: %s %s names no loop around it", s.K, s.Label)
+			return nil
+		}
+		st.Target, st.Label = c.loops[target], syntax.NewName(pos, s.Label)
+	}
+	st.SetPos(pos)
+	return st
+}
+
+// ergoLabelsDone checks that every goto of the function names one of its
+// blocks, and forgets the function's labels.
+func (c *ergoChecker) ergoLabelsDone() {
+	for _, g := range c.gotos {
+		if !c.labels[g.Label] {
+			c.errorf(g.Pos, "ergoir: goto %s names no block", g.Label)
+		}
+	}
+	c.labels, c.gotos = nil, nil
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_mapstore.go b/src/cmd/compile/internal/ergoir/ergoir_mapstore.go
new file mode 100644
index 0000000..7f5ed0d
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_mapstore.go
@@ -0,0 +1,50 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// storeTo is the target of a "store": a Map's entry ("mapAt", FLIP F7
+// LY-PLACE), or any other expression (c.expr), which the store then
+// requires to be a place (ergoPlace). A "mapAt" is a store's target only:
+// Go cannot take an entry's address, and no other IR reads it.
+func (c *ergoChecker) storeTo(x *ergoExpr) (syntax.Expr, types2.Type) {
+	if x.K != "mapAt" {
+		return c.expr(x)
+	}
+	m, mt := c.expr(x.X)
+	k, kt := c.expr(x.Y)
+	if m == nil || k == nil {
+		return nil, nil
+	}
+	u, ok := types2.CoreType(mt).(*types2.Map)
+	if !ok {
+		c.errorf(x.Pos, "ergoir: mapAt of %v, not a map", mt)
+		return nil, nil
+	}
+	if !c.assignable(x.Pos, "mapAt key", kt, u.Key()) {
+		return nil, nil
+	}
+	e := &syntax.IndexExpr{X: m, Index: k}
+	e.SetPos(c.pos(x.Pos))
+	tv := syntax.TypeAndValue{Type: u.Elem()}
+	tv.SetIsValue()
+	tv.SetAssignable() // a map index: assignable, never addressable
+	e.SetTypeInfo(tv)
+	return e, u.Elem()
+}
+
+// ergoMapEntry reports whether x is a Map's entry that storeTo built.
+func ergoMapEntry(x syntax.Expr) bool {
+	e, ok := x.(*syntax.IndexExpr)
+	if !ok {
+		return false
+	}
+	_, isMap := types2.CoreType(e.X.GetTypeInfo().Type).(*types2.Map)
+	return isMap && e.GetTypeInfo().Assignable()
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_opc.go b/src/cmd/compile/internal/ergoir/ergoir_opc.go
new file mode 100644
index 0000000..b8fba2f
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_opc.go
@@ -0,0 +1,32 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoBareRange is the clause of a range with neither a key nor a value
+// bound (a std body's `for _ in xs`): `for range x`, with no left-hand
+// side, as hand-written Go spells it.
+func ergoBareRange(x syntax.Expr) *syntax.RangeClause {
+	return &syntax.RangeClause{X: x}
+}
+
+// ergoIsDefect reports a panic value of a pointer to a struct: the defect
+// the prelude's Unreachable raises (runtime/v1 UnreachableAt), which a
+// hand-written Go program panics with as it is.
+func ergoIsDefect(t types2.Type) bool {
+	if t == nil {
+		return false
+	}
+	p, ok := t.Underlying().(*types2.Pointer)
+	if !ok {
+		return false
+	}
+	_, ok = p.Elem().Underlying().(*types2.Struct)
+	return ok
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_placeholder.go b/src/cmd/compile/internal/ergoir/ergoir_placeholder.go
new file mode 100644
index 0000000..c4434f6
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_placeholder.go
@@ -0,0 +1,55 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: the placeholder body of a generic declaration. See
+// ergoir.go.
+//
+// types2 refuses a generic function without a body, so the lowering gives
+// a generic declaration whose body the IR holds the body
+//
+//	{ panic("ergoir: no IR body") }
+//
+// on its signature's line, and ergoAttach replaces exactly that body. A
+// declaration that keeps it after the IR is attached is an error, never a
+// panic at run time. No hook in Go's own files is needed (PATCH-MIN M3).
+
+package ergoir
+
+import (
+	"strconv"
+
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoPlaceholder reports a body that is exactly the placeholder: one call
+// of the universe's panic with the placeholder's string.
+func ergoPlaceholder(info *types2.Info, body *syntax.BlockStmt) bool {
+	if body == nil || len(body.List) != 1 {
+		return false
+	}
+	st, ok := body.List[0].(*syntax.ExprStmt)
+	if !ok {
+		return false
+	}
+	call, ok := st.X.(*syntax.CallExpr)
+	if !ok || len(call.ArgList) != 1 || call.HasDots {
+		return false
+	}
+	fun, ok := call.Fun.(*syntax.Name)
+	if !ok || fun.Value != "panic" {
+		return false
+	}
+	if info != nil {
+		if _, builtin := info.Uses[fun].(*types2.Builtin); !builtin {
+			return false
+		}
+	}
+	lit, ok := call.ArgList[0].(*syntax.BasicLit)
+	if !ok || lit.Kind != syntax.StringLit {
+		return false
+	}
+	s, err := strconv.Unquote(lit.Value)
+	return err == nil && s == "ergoir: no IR body"
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_slice.go b/src/cmd/compile/internal/ergoir/ergoir_slice.go
new file mode 100644
index 0000000..e699f98
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_slice.go
@@ -0,0 +1,66 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: slice expressions (FLIP F7, kind "slice"). See ergoir.go.
+//
+// x[lo:hi] and x[lo:hi:max] of a slice, and x[lo:hi] of a string (or a
+// named type over one): X is the operand, Args the indices, two or three,
+// a missing low or high index null. Go's own slice expression, so gc
+// lowers it to OSLICE or OSLICESTR and checks its bounds at the
+// expression's position. An array place (ergoPlace) is an operand too,
+// and the result is a slice of its element (OSLICEARR); Go slices an
+// addressable array only, so an array value that is no place is refused.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// slice checks the slice expression x.
+func (c *ergoChecker) slice(x *ergoExpr) (syntax.Expr, types2.Type) {
+	xs, xt := c.expr(x.X)
+	if xs == nil {
+		return nil, nil
+	}
+	n := len(x.Args)
+	if n != 2 && n != 3 || n == 3 && (x.Args[1] == nil || x.Args[2] == nil) {
+		c.errorf(x.Pos, "ergoir: slice with %d indices", n)
+		return nil, nil
+	}
+	rt := xt
+	switch ct := types2.CoreType(xt).(type) {
+	case *types2.Slice:
+	case *types2.Array:
+		if !ergoPlace(xs) {
+			c.errorf(x.Pos, "ergoir: slice of an array that is no place")
+			return nil, nil
+		}
+		rt = types2.NewSlice(ct.Elem())
+	default:
+		if !ergoIsString(xt) || n == 3 {
+			c.errorf(x.Pos, "ergoir: slice of %v", xt)
+			return nil, nil
+		}
+	}
+	e := &syntax.SliceExpr{X: xs, Full: n == 3}
+	for i, a := range x.Args {
+		if a == nil {
+			continue
+		}
+		v, vt := c.expr(a)
+		if v == nil {
+			return nil, nil
+		}
+		if !ergoIsInteger(vt) { // any integer type, as an index (red #31)
+			c.errorf(a.Pos, "ergoir: slice index of type %v", vt)
+			return nil, nil
+		}
+		e.Index[i] = v
+	}
+	e.SetPos(c.pos(x.Pos))
+	ergoValue(e, rt, nil)
+	return e, rt
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_stmt.go b/src/cmd/compile/internal/ergoir/ergoir_stmt.go
new file mode 100644
index 0000000..83a7e64
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_stmt.go
@@ -0,0 +1,373 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: statements and blocks. See ergoir.go.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoTerminates is the Go spec's terminating statement for the IR's
+// statement forms: a return, a call of panic, a goto, an if whose both
+// branches terminate, a block whose last statement terminates, a labeled
+// statement that terminates and that no break leaves, a for without a
+// condition that no break leaves, a switch with a default whose clauses
+// all terminate and that no break leaves (the builder's irTerminates,
+// ir_end.go, is the same list).
+func ergoTerminates(s syntax.Stmt) bool {
+	switch s := s.(type) {
+	case *syntax.ReturnStmt:
+		return true
+	case *syntax.BlockStmt:
+		last := lastNonEmptyStmt(s.List)
+		return last != nil && ergoTerminates(last)
+	case *syntax.IfStmt:
+		return s.Else != nil && ergoTerminates(s.Then) && ergoTerminates(s.Else)
+	case *syntax.BranchStmt:
+		return s.Tok == syntax.Goto
+	case *syntax.LabeledStmt:
+		// A block the IR labels (ergoir_label.go); a break naming it
+		// leaves it.
+		return ergoTerminates(s.Stmt) && !ergoBreaks(s.Stmt, s.Label.Value)
+	case *syntax.ForStmt:
+		return s.Cond == nil && s.Init == nil && s.Post == nil && !ergoBreaks(s.Body, "")
+	case *syntax.SwitchStmt:
+		def := false
+		for _, c := range s.Body {
+			def = def || c.Cases == nil
+			last := lastNonEmptyStmt(c.Body)
+			if last == nil || !ergoTerminates(last) {
+				return false
+			}
+			for _, b := range c.Body {
+				if ergoBreaks(b, "") {
+					return false
+				}
+			}
+		}
+		return def
+	case *syntax.ExprStmt:
+		call, ok := s.X.(*syntax.CallExpr)
+		if !ok {
+			return false
+		}
+		name, ok := call.Fun.(*syntax.Name)
+		return ok && name.Value == "panic"
+	}
+	return false
+}
+
+// ergoBreaks reports a break in s that leaves the statement s is in: one
+// naming label, or with label "" an unlabeled one outside any for or
+// switch nested in s.
+func ergoBreaks(s syntax.Stmt, label string) bool {
+	found := false
+	syntax.Inspect(s, func(n syntax.Node) bool {
+		switch n := n.(type) {
+		case *syntax.BranchStmt:
+			if n.Tok == syntax.Break && (label == "" && n.Label == nil || n.Label != nil && n.Label.Value == label) {
+				found = true
+			}
+		case *syntax.ForStmt, *syntax.SwitchStmt:
+			return label != ""
+		case syntax.Expr:
+			return false
+		}
+		return !found
+	})
+	return found
+}
+
+func (c *ergoChecker) stmts(list []*ergoStmt) []syntax.Stmt {
+	var out []syntax.Stmt
+	for _, s := range list {
+		if st := c.stmt(s); st != nil {
+			out = append(out, st)
+		}
+	}
+	return out
+}
+
+func (c *ergoChecker) block(p, end ergoPos, list []*ergoStmt) *syntax.BlockStmt {
+	b := &syntax.BlockStmt{List: c.stmts(list), Rbrace: c.pos(end)}
+	b.SetPos(c.pos(p))
+	return b
+}
+
+// loopBlock is a loop's body, where break and continue name loop.
+// label is the loop's label, or "" (ergoir_label.go).
+func (c *ergoChecker) loopBlock(loop *syntax.ForStmt, label string, p, end ergoPos, list []*ergoStmt) *syntax.BlockStmt {
+	c.loops, c.loopLabels = append(c.loops, loop), append(c.loopLabels, label)
+	defer func() { c.loops, c.loopLabels = c.loops[:len(c.loops)-1], c.loopLabels[:len(c.loopLabels)-1] }()
+	return c.block(p, end, list)
+}
+
+func (c *ergoChecker) stmt(s *ergoStmt) syntax.Stmt {
+	if s == nil {
+		c.errorf(ergoPos{-1}, "ergoir: missing statement")
+		return nil
+	}
+	pos := c.pos(s.Pos)
+	switch s.K {
+	case "defer":
+		return c.deferStmt(s, pos) // ergoir_f7f.go
+	case "def", "set":
+		v := c.local(s.Pos, s.Local)
+		x, t := c.expr(s.X)
+		if v == nil || x == nil {
+			return nil
+		}
+		a := &syntax.AssignStmt{Lhs: c.name(s.Pos, v, s.K == "def"), Rhs: x}
+		switch {
+		case s.Op != "":
+			// x op= y: the operator's rule, its result x's type.
+			op, ok := ergoBinOps[s.Op]
+			if !ok || s.K != "set" || op == syntax.AndAnd || op == syntax.OrOr {
+				c.errorf(s.Pos, "ergoir: assignment operator %q", s.Op)
+				return nil
+			}
+			if rt := c.binType(s.Pos, op, s.Op, v.Type(), t); rt == nil || !c.assignable(s.Pos, s.Op+"=", rt, v.Type()) {
+				return nil
+			}
+			a.Op = op
+		case !c.assignable(s.Pos, s.K, t, v.Type()):
+			return nil
+		case s.K == "def":
+			a.Op = syntax.Def
+		}
+		a.SetPos(pos)
+		return a
+	case "store":
+		// p = y, p op= y: p a place (ergoPlace), a field of a record a
+		// local points at (IRG6: a with publishes its providers into the
+		// environment's copy), a field of a local record, a slice's
+		// element, *q, and any chain of them (FLIP F2).
+		if s.X == nil {
+			c.errorf(s.Pos, "ergoir: store to nothing")
+			return nil
+		}
+		lhs, lt := c.storeTo(s.X) // ergoir_mapstore.go: a Map's entry (LY-PLACE), else expr
+		rhs, rt := c.expr(s.Y)
+		if lhs == nil || rhs == nil {
+			return nil
+		}
+		if !ergoPlace(lhs) && !ergoMapEntry(lhs) {
+			c.errorf(s.Pos, "ergoir: store to a non-place")
+			return nil
+		}
+		a := &syntax.AssignStmt{Lhs: lhs, Rhs: rhs}
+		if s.Op != "" {
+			op, ok := ergoBinOps[s.Op]
+			if !ok || op == syntax.AndAnd || op == syntax.OrOr {
+				c.errorf(s.Pos, "ergoir: assignment operator %q", s.Op)
+				return nil
+			}
+			if t := c.binType(s.Pos, op, s.Op, lt, rt); t == nil || !c.assignable(s.Pos, s.Op+"=", t, lt) {
+				return nil
+			}
+			a.Op = op
+		} else if !c.assignable(s.Pos, "store", rt, lt) {
+			return nil
+		}
+		a.SetPos(pos)
+		return a
+	case "var":
+		// var x T: the local's zero value.
+		v := c.local(s.Pos, s.Local)
+		if v == nil {
+			return nil
+		}
+		d := &syntax.VarDecl{NameList: []*syntax.Name{c.name(s.Pos, v, true)}}
+		d.SetPos(pos)
+		st := &syntax.DeclStmt{DeclList: []syntax.Decl{d}}
+		st.SetPos(pos)
+		return st
+	case "discard":
+		// _ = x: x evaluated, its value dropped.
+		x, t := c.expr(s.X)
+		if x == nil || t == nil {
+			c.errorf(s.Pos, "ergoir: discard of no value")
+			return nil
+		}
+		a := &syntax.AssignStmt{Lhs: syntax.NewName(pos, "_"), Rhs: x}
+		a.SetPos(pos)
+		return a
+	case "ret":
+		return c.ret(s) // under the failure ABI (ergoir_fail.go)
+	case "if":
+		cond := c.cond(s.X)
+		if cond == nil {
+			return nil
+		}
+		// Scope positions must increase (DWARF scopes): the then block is
+		// Pos..End, the else block ElsePos..ElseEnd, after it.
+		st := &syntax.IfStmt{Cond: cond, Then: c.block(s.Pos, s.End, s.Then)}
+		st.SetPos(pos)
+		if s.Else != nil {
+			st.Else = c.block(s.ElsePos, s.ElseEnd, s.Else)
+		}
+		return st
+	case "while":
+		// for cond { body }, or for { body } with no condition.
+		st := &syntax.ForStmt{}
+		st.SetPos(pos)
+		if s.X != nil {
+			if st.Cond = c.cond(s.X); st.Cond == nil {
+				return nil
+			}
+		}
+		st.Body = c.loopBlock(st, s.Label, s.Pos, s.End, s.Body)
+		return c.labeled(s, st) // ergoir_label.go
+	case "count":
+		// for i := X; i < Y; i++ { body }: a for-in over an integer Range
+		// (IRG4b), i the loop's integer local; Y is read each iteration.
+		v := c.local(s.Pos, s.Local)
+		lo, lt := c.expr(s.X)
+		if v == nil || lo == nil || s.Y == nil {
+			return nil
+		}
+		if !ergoIsInteger(v.Type()) || !c.assignable(s.Pos, "count", lt, v.Type()) {
+			c.errorf(s.Pos, "ergoir: count of %v", v.Type())
+			return nil
+		}
+		init := &syntax.AssignStmt{Op: syntax.Def, Lhs: c.name(s.Pos, v, true), Rhs: lo}
+		init.SetPos(pos)
+		cond := c.cond(&ergoExpr{K: "bin", Pos: s.Pos, Op: "<", X: &ergoExpr{K: "local", Pos: s.Pos, I: s.Local}, Y: s.Y})
+		if cond == nil {
+			return nil
+		}
+		post := &syntax.AssignStmt{Op: syntax.Add, Lhs: c.name(s.Pos, v, false)}
+		post.SetPos(pos)
+		st := &syntax.ForStmt{Init: init, Cond: cond, Post: post}
+		st.SetPos(pos)
+		st.Body = c.loopBlock(st, s.Label, s.Pos, s.End, s.Body)
+		return c.labeled(s, st) // ergoir_label.go
+	case "break", "continue":
+		return c.branch(s) // ergoir_label.go
+	case "panic":
+		// panic(x), x a string: a path a checked program never takes; or
+		// x an error: a failure in a frame that cannot fail, or a total
+		// catch's default (ergoir_fail.go); or x a pointer to a struct: a
+		// defect value, the prelude's Unreachable (ergoir_opc.go).
+		x, t := c.expr(s.X)
+		if x == nil || !ergoIsString(t) && !ergoIsErrorValue(t) && !ergoIsDefect(t) {
+			c.errorf(s.Pos, "ergoir: panic of %v", t)
+			return nil
+		}
+		obj := types2.Universe.Lookup("panic")
+		fun := syntax.NewName(pos, "panic")
+		c.info.Uses[fun] = obj
+		any := types2.Universe.Lookup("any").Type()
+		tv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil,
+			types2.NewTuple(types2.NewParam(pos, nil, "", any)), nil, false)}
+		tv.SetIsBuiltin()
+		fun.SetTypeInfo(tv)
+		call := &syntax.CallExpr{Fun: fun, ArgList: []syntax.Expr{x}}
+		call.SetPos(pos)
+		void := syntax.TypeAndValue{}
+		void.SetIsVoid()
+		call.SetTypeInfo(void)
+		st := &syntax.ExprStmt{X: call}
+		st.SetPos(pos)
+		return st
+	case "range":
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil
+		}
+		key, elem := ergoRangeTypes(t) // ergoir_call.go
+		if key == nil {
+			c.errorf(s.Pos, "ergoir: range over unsupported type %v", t)
+			return nil
+		}
+		if elem == nil && s.Val != nil {
+			c.errorf(s.Pos, "ergoir: range over %v has only one binding", t)
+			return nil
+		}
+		lhs := &syntax.ListExpr{}
+		lhs.SetPos(pos)
+		for i, want := range []types2.Type{key, elem} {
+			idx := s.Key
+			if i == 1 {
+				idx = s.Val
+			}
+			if want == nil {
+				continue // a range over a func or integer has one variable
+			}
+			if idx == nil {
+				lhs.ElemList = append(lhs.ElemList, syntax.NewName(pos, "_"))
+				continue
+			}
+			v := c.local(s.Pos, *idx)
+			if v == nil || !c.assignable(s.Pos, "range", want, v.Type()) {
+				return nil
+			}
+			lhs.ElemList = append(lhs.ElemList, c.name(s.Pos, v, true))
+		}
+		if _, isFunc := types2.CoreType(t).(*types2.Signature); isFunc {
+			c.rangeFunc = true // ergoir_closure.go
+		}
+		rc := &syntax.RangeClause{Lhs: lhs, Def: true, X: x}
+		if elem == nil {
+			rc.Lhs = lhs.ElemList[0]
+		}
+		if s.Key == nil && s.Val == nil {
+			// for range x, as the text view prints it (ergoir_opc.go).
+			rc = ergoBareRange(x)
+		}
+		rc.SetPos(pos)
+		st := &syntax.ForStmt{Init: rc}
+		st.SetPos(pos)
+		st.Body = c.loopBlock(st, s.Label, s.Pos, s.End, s.Body)
+		return c.labeled(s, st) // ergoir_label.go
+	case "expr":
+		if s.X == nil || (s.X.K != "call" && s.X.K != "mcall" && s.X.K != "pcall" && s.X.K != "vcall" && s.X.K != "builtin") {
+			c.errorf(s.Pos, "ergoir: an expression statement is a call")
+			return nil
+		}
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil
+		}
+		if _, isTuple := t.(*types2.Tuple); isTuple {
+			c.errorf(s.Pos, "ergoir: a fallible call's error is dropped")
+			return nil
+		}
+		st := &syntax.ExprStmt{X: x}
+		st.SetPos(pos)
+		return st
+	}
+	if st, ok := c.f7bStmt(s); ok { // ergoir_f7b.go
+		return st
+	}
+	if st, ok := c.failStmt(s); ok { // ergoir_fail.go
+		return st
+	}
+	if st, ok := c.unionStmt(s); ok { // ergoir_union.go
+		return st
+	}
+	if st, ok := c.labelStmt(s); ok { // ergoir_label.go
+		return st
+	}
+	if st, ok := c.tupleStmt(s); ok { // ergoir_tuple.go
+		return st
+	}
+	c.errorf(s.Pos, "ergoir: unknown statement %q", s.K)
+	return nil
+}
+
+func (c *ergoChecker) cond(x *ergoExpr) syntax.Expr {
+	e, t := c.expr(x)
+	if e == nil {
+		return nil
+	}
+	if !ergoIsBool(t) {
+		c.errorf(x.Pos, "ergoir: condition of type %v", t)
+		return nil
+	}
+	return e
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_tuple.go b/src/cmd/compile/internal/ergoir/ergoir_tuple.go
new file mode 100644
index 0000000..4d8201c
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_tuple.go
@@ -0,0 +1,117 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: tuples and multi-result calls (FLIP F4b). See ergoir.go.
+//
+// An Ergo tuple is an unnamed struct, spelled as Go spells it,
+// "struct{F0 T0; F1 T1}": "lit" builds one and "field" reads one, as for
+// a named record. "tdef" binds the results of a call with several
+// results (of a function of a package or of this one, a Go method or a
+// function value) to locals, in order: l0, l1, … := f(…); a local of -1
+// is Go's blank.
+
+package ergoir
+
+import (
+	"strings"
+
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// structType is the unnamed struct s spells, "struct{F0 T0; F1 T1}", or
+// nil (an error).
+func (c *ergoChecker) structType(p ergoPos, s string) types2.Type {
+	body := strings.TrimSuffix(strings.TrimPrefix(s, "struct{"), "}")
+	if len(body) != len(s)-len("struct{}") {
+		c.errorf(p, "ergoir: struct type %q", s)
+		return nil
+	}
+	var fields []*types2.Var
+	seen := map[string]bool{}
+	depth, start := 0, 0
+	for i := 0; i <= len(body); i++ {
+		if i < len(body) {
+			switch body[i] {
+			case '(', '[', '{':
+				depth++
+				continue
+			case ')', ']', '}':
+				depth--
+				continue
+			case ';':
+				if depth != 0 {
+					continue
+				}
+			default:
+				continue
+			}
+		}
+		part := strings.TrimSpace(body[start:i])
+		start = i + 1
+		name, typ, ok := strings.Cut(part, " ")
+		if !ok || name == "" || name[0] < 'A' || name[0] > 'Z' || seen[name] {
+			c.errorf(p, "ergoir: struct type %q", s)
+			return nil
+		}
+		seen[name] = true
+		ft := c.typ(p, strings.TrimSpace(typ))
+		if ft == nil {
+			return nil
+		}
+		fields = append(fields, types2.NewField(c.pos(p), c.pkg, name, ft, false))
+	}
+	return types2.NewStruct(fields, nil)
+}
+
+// ergoTdefCall are the call kinds a tdef binds.
+var ergoTdefCall = map[string]bool{"pcall": true, "call": true, "mcall": true, "vcall": true}
+
+// tupleStmt decodes a "tdef"; ok is false for any other kind.
+func (c *ergoChecker) tupleStmt(s *ergoStmt) (st syntax.Stmt, ok bool) {
+	if s.K != "tdef" {
+		return nil, false
+	}
+	if s.X == nil || !ergoTdefCall[s.X.K] || len(s.Ls) < 2 {
+		c.errorf(s.Pos, "ergoir: tdef of a value that is not a call")
+		return nil, true
+	}
+	c.tdef = s.X
+	x, t := c.expr(s.X)
+	c.tdef = nil
+	if x == nil {
+		return nil, true
+	}
+	tup, isTuple := t.(*types2.Tuple)
+	if !isTuple || tup.Len() != len(s.Ls) {
+		c.errorf(s.Pos, "ergoir: tdef: %v does not bind %d locals", t, len(s.Ls))
+		return nil, true
+	}
+	pos := c.pos(s.Pos)
+	lhs := &syntax.ListExpr{}
+	lhs.SetPos(pos)
+	def := false
+	for i, l := range s.Ls {
+		if l == -1 {
+			lhs.ElemList = append(lhs.ElemList, syntax.NewName(pos, "_"))
+			continue
+		}
+		v := c.local(s.Pos, l)
+		if v == nil {
+			return nil, true
+		}
+		if !types2.Identical(tup.At(i).Type(), v.Type()) {
+			c.errorf(s.Pos, "ergoir: tdef: result %d is %v, not %v", i, tup.At(i).Type(), v.Type())
+			return nil, true
+		}
+		lhs.ElemList = append(lhs.ElemList, c.name(s.Pos, v, true))
+		def = true
+	}
+	a := &syntax.AssignStmt{Lhs: lhs, Rhs: x}
+	if def {
+		a.Op = syntax.Def
+	}
+	a.SetPos(pos)
+	return a, true
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_types.go b/src/cmd/compile/internal/ergoir/ergoir_types.go
new file mode 100644
index 0000000..ad3ea0e
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_types.go
@@ -0,0 +1,402 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: types, locals, names and constants. See ergoir.go.
+
+package ergoir
+
+import (
+	"go/constant"
+	"go/token"
+	"internal/buildcfg"
+	"strconv"
+	"strings"
+
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// typ resolves a type spelling: NAME (a type parameter of the function,
+// then package scope or universe),
+// PATH.NAME (an exported type of the imported package PATH), []T, *T,
+// map[K]V, a generic type's instance NAME[T1, T2] and a function
+// literal's type (ergoir_closure.go).
+func (c *ergoChecker) typ(p ergoPos, s string) types2.Type {
+	if t, ok := c.literalType(p, s); ok { // ergoir_closure.go
+		return t
+	}
+	switch {
+	case strings.HasPrefix(s, "[]"):
+		if e := c.typ(p, s[2:]); e != nil {
+			return types2.NewSlice(e)
+		}
+		return nil
+	case strings.HasPrefix(s, "*"):
+		if e := c.typ(p, s[1:]); e != nil {
+			return types2.NewPointer(e)
+		}
+		return nil
+	}
+	if t, ok := c.arrayType(p, s); ok { // ergoir_f7.go
+		return t
+	}
+	if rest, ok := strings.CutPrefix(s, "map["); ok {
+		// map[K]V: K ends at the bracket that closes map's.
+		depth := 1
+		for i := 0; i < len(rest); i++ {
+			switch rest[i] {
+			case '[':
+				depth++
+			case ']':
+				depth--
+			}
+			if depth == 0 {
+				k, v := c.typ(p, rest[:i]), c.typ(p, rest[i+1:])
+				if k == nil || v == nil {
+					return nil
+				}
+				if !types2.Comparable(k) {
+					c.errorf(p, "ergoir: map key %v is not comparable", k)
+					return nil
+				}
+				return types2.NewMap(k, v)
+			}
+		}
+		c.errorf(p, "ergoir: %q is not a type", s)
+		return nil
+	}
+	if i := strings.IndexByte(s, '['); i > 0 && strings.HasSuffix(s, "]") {
+		return c.instance(p, s[:i], s[i+1:len(s)-1])
+	}
+	var obj types2.Object
+	if i := strings.LastIndex(s, "."); i >= 0 {
+		if pkg := c.imported(p, s[:i]); pkg != nil {
+			obj = pkg.Scope().Lookup(s[i+1:])
+			if obj != nil && !obj.Exported() {
+				obj = nil
+			}
+		}
+	} else {
+		for _, tp := range c.tparams {
+			if tp.Obj().Name() == s {
+				return tp
+			}
+		}
+		obj = c.pkg.Scope().Lookup(s)
+		if obj == nil {
+			obj = types2.Universe.Lookup(s)
+		}
+	}
+	tn, ok := obj.(*types2.TypeName)
+	if !ok {
+		c.errorf(p, "ergoir: %q is not a type", s)
+		return nil
+	}
+	return tn.Type()
+}
+
+// instance is the generic type name instantiated with the type arguments
+// args, written as Go writes them (comma and space between top-level
+// arguments): Option[int], Pair[[]string, Option[int]]. Instantiate
+// checks the arguments against the type parameters' constraints.
+func (c *ergoChecker) instance(p ergoPos, name, args string) types2.Type {
+	gen := c.typ(p, name)
+	if gen == nil {
+		return nil
+	}
+	named, ok := gen.(*types2.Named)
+	if !ok || named.TypeParams().Len() == 0 {
+		c.errorf(p, "ergoir: %s is not a generic type", name)
+		return nil
+	}
+	targs := c.typeList(p, args)
+	if targs == nil {
+		return nil
+	}
+	t, err := types2.Instantiate(c.context(), named.Origin(), targs, true)
+	if err != nil {
+		c.errorf(p, "ergoir: %s[%s]: %v", name, args, err)
+		return nil
+	}
+	return t
+}
+
+// typeList resolves a list of type spellings, comma and space between
+// top-level ones; nil when one is not a type (an error).
+func (c *ergoChecker) typeList(p ergoPos, args string) []types2.Type {
+	var out []types2.Type
+	depth, start := 0, 0
+	for i := 0; i <= len(args); i++ {
+		if i < len(args) {
+			switch args[i] {
+			case '[', '(', '{':
+				// A function type argument's lists hold commas too
+				// (FLIP F7 LY: Option[func(*Env, E) (struct{}, error)]).
+				depth++
+				continue
+			case ']', ')', '}':
+				depth--
+				continue
+			case ',':
+				if depth > 0 {
+					continue
+				}
+			default:
+				continue
+			}
+		}
+		t := c.typ(p, strings.TrimSpace(args[start:i]))
+		if t == nil {
+			return nil
+		}
+		out = append(out, t)
+		start = i + 1
+	}
+	return out
+}
+
+// funcInstance is the signature of the generic function fun's instance
+// with the type arguments args, recorded in Instances at fun; nil (an
+// error) when args do not instantiate sig.
+func (c *ergoChecker) funcInstance(p ergoPos, fun *syntax.Name, sig *types2.Signature, args string) *types2.Signature {
+	if sig.TypeParams().Len() == 0 || args == "" {
+		c.errorf(p, "ergoir: type arguments [%s] for %v", args, sig)
+		return nil
+	}
+	targs := c.typeList(p, args)
+	if targs == nil {
+		return nil
+	}
+	t, err := types2.Instantiate(c.context(), sig, targs, true)
+	if err != nil {
+		c.errorf(p, "ergoir: %s[%s]: %v", fun.Value, args, err)
+		return nil
+	}
+	inst := t.(*types2.Signature)
+	c.info.Instances[fun] = types2.Instance{TypeArgs: ergoTypeList(targs), Type: inst}
+	return inst
+}
+
+// ergoTypeList is targs as a *types2.TypeList, which types2 makes only
+// for an instance: the type arguments of a throwaway generic type's
+// instance (types2 exports no TypeList constructor; the writer reads an
+// instance's arguments from the list).
+func ergoTypeList(targs []types2.Type) *types2.TypeList {
+	var nopos syntax.Pos
+	any := types2.Universe.Lookup("any").Type()
+	tparams := make([]*types2.TypeParam, len(targs))
+	for i := range targs {
+		tparams[i] = types2.NewTypeParam(types2.NewTypeName(nopos, nil, "T", nil), any)
+	}
+	gen := types2.NewNamed(types2.NewTypeName(nopos, nil, "ergoTypeList", nil), types2.NewStruct(nil, nil), nil)
+	gen.SetTypeParams(tparams)
+	t, err := types2.Instantiate(nil, gen, targs, false)
+	if err != nil {
+		base.Fatalf("ergoir: type list: %v", err)
+	}
+	return t.(*types2.Named).TypeArgs()
+}
+
+func (c *ergoChecker) context() *types2.Context {
+	if c.ctxt == nil {
+		c.ctxt = types2.NewContext()
+	}
+	return c.ctxt
+}
+
+// imported is the package of import path the package imports, or nil
+// (an error).
+func (c *ergoChecker) imported(p ergoPos, path string) *types2.Package {
+	for _, pkg := range c.pkg.Imports() {
+		if pkg.Path() == path {
+			return pkg
+		}
+	}
+	c.errorf(p, "ergoir: the package does not import %q", path)
+	return nil
+}
+
+// typeExpr is a type expression of t, for a conversion's function: a name
+// of the universe or of the package, or a qualified name.
+func (c *ergoChecker) typeExpr(p ergoPos, t types2.Type) syntax.Expr {
+	pos := c.pos(p)
+	var obj *types2.TypeName
+	switch t := t.(type) {
+	case *types2.Basic:
+		obj, _ = types2.Universe.Lookup(t.Name()).(*types2.TypeName)
+	case *types2.Named:
+		obj = t.Obj()
+	case *types2.TypeParam:
+		obj = t.Obj() // a Slot row's parameter (F error), asserted to (OPC-ADAPT2)
+	case *types2.Alias:
+		if t.TypeArgs().Len() == 0 {
+			obj = t.Obj() // a shared type's alias (ergo_ergoshared)
+		}
+	}
+	if obj == nil {
+		c.errorf(p, "ergoir: conversion to %v", t)
+		return nil
+	}
+	tv := syntax.TypeAndValue{Type: t}
+	tv.SetIsType()
+	name := syntax.NewName(pos, obj.Name())
+	c.info.Uses[name] = obj
+	name.SetTypeInfo(tv)
+	if obj.Pkg() == nil || obj.Pkg() == c.pkg {
+		return name
+	}
+	return c.qualified(p, obj.Pkg(), name, tv)
+}
+
+// qualified is pkg.sel, sel the name of an object of the imported pkg,
+// with its type record tv.
+func (c *ergoChecker) qualified(p ergoPos, pkg *types2.Package, sel *syntax.Name, tv syntax.TypeAndValue) syntax.Expr {
+	pos := c.pos(p)
+	q := syntax.NewName(pos, pkg.Name())
+	c.info.Uses[q] = types2.NewPkgName(pos, c.pkg, pkg.Name(), pkg)
+	se := &syntax.SelectorExpr{X: q, Sel: sel}
+	se.SetPos(pos)
+	se.SetTypeInfo(tv)
+	return se
+}
+
+func (c *ergoChecker) local(p ergoPos, i int) *types2.Var {
+	if i < 0 || i >= len(c.locals) {
+		c.errorf(p, "ergoir: local %d out of range", i)
+		return nil
+	}
+	return c.locals[i]
+}
+
+// name is a use (def false) or the definition of v.
+func (c *ergoChecker) name(p ergoPos, v *types2.Var, def bool) *syntax.Name {
+	n := syntax.NewName(c.pos(p), v.Name())
+	if def {
+		c.info.Defs[n] = v
+		if c.defined != nil {
+			c.defined[v] = true // ergoReadBeforeDef
+		}
+		return n
+	}
+	c.info.Uses[n] = v
+	tv := syntax.TypeAndValue{Type: v.Type()}
+	tv.SetIsValue()
+	tv.SetAddressable()
+	tv.SetAssignable()
+	n.SetTypeInfo(tv)
+	return n
+}
+
+func (c *ergoChecker) assignable(p ergoPos, what string, src, dst types2.Type) bool {
+	if src == nil || dst == nil || !types2.Identical(src, dst) {
+		c.errorf(p, "ergoir: %s: %v is not %v", what, src, dst)
+		return false
+	}
+	return true
+}
+
+func ergoBasicInfo(t types2.Type) types2.BasicInfo {
+	if b, ok := types2.CoreType(t).(*types2.Basic); ok {
+		return b.Info()
+	}
+	return 0
+}
+
+func ergoIsBool(t types2.Type) bool     { return ergoBasicInfo(t)&types2.IsBoolean != 0 }
+func ergoIsInteger(t types2.Type) bool  { return ergoBasicInfo(t)&types2.IsInteger != 0 }
+func ergoIsUnsigned(t types2.Type) bool { return ergoBasicInfo(t)&types2.IsUnsigned != 0 }
+func ergoIsFloat(t types2.Type) bool    { return ergoBasicInfo(t)&types2.IsFloat != 0 }
+func ergoIsNumeric(t types2.Type) bool  { return ergoIsInteger(t) || ergoIsFloat(t) }
+func ergoIsString(t types2.Type) bool   { return ergoBasicInfo(t)&types2.IsString != 0 }
+
+// ergoConstant is the constant of type t that the IR spells v, or nil when
+// v does not spell one or t cannot hold it: an integer in decimal (an
+// optional minus sign), a float as strconv.FormatFloat writes it, true or
+// false, any string.
+func ergoConstant(t types2.Type, v string) constant.Value {
+	switch {
+	case ergoIsInteger(t):
+		digits, neg := strings.CutPrefix(v, "-")
+		if digits == "" || strings.TrimLeft(digits, "0123456789") != "" {
+			return nil
+		}
+		x := constant.MakeFromLiteral(digits, token.INT, 0)
+		if neg {
+			x = constant.UnaryOp(token.SUB, x, 0)
+		}
+		bits := uint(8 * types2.SizesFor("gc", buildcfg.GOARCH).Sizeof(t))
+		lo, hi := constant.MakeInt64(0), constant.Shift(constant.MakeInt64(1), token.SHL, bits)
+		if !ergoIsUnsigned(t) {
+			hi = constant.Shift(constant.MakeInt64(1), token.SHL, bits-1)
+			lo = constant.UnaryOp(token.SUB, hi, 0)
+		}
+		if constant.Compare(x, token.LSS, lo) || constant.Compare(x, token.GEQ, hi) {
+			return nil
+		}
+		return x
+	case ergoIsFloat(t):
+		bits := 64
+		if types2.SizesFor("gc", buildcfg.GOARCH).Sizeof(t) == 4 {
+			bits = 32
+		}
+		f, err := strconv.ParseFloat(v, bits)
+		if err != nil || strconv.FormatFloat(f, 'g', -1, bits) != v {
+			return nil
+		}
+		return constant.MakeFloat64(f)
+	case ergoIsBool(t):
+		if v != "true" && v != "false" {
+			return nil
+		}
+		return constant.MakeBool(v == "true")
+	case ergoIsString(t):
+		return constant.MakeString(v)
+	}
+	return nil
+}
+
+// value records t (and v, a constant) as x's type.
+// ergoPlace reports whether x is a place, as Go's addressability has it,
+// and marks it and every place inside it addressable and assignable: a
+// variable, *p, a slice's element, a field through a pointer, a field of
+// a place (FLIP F2: a store's target and &p).
+func ergoPlace(x syntax.Expr) bool {
+	ok := false
+	switch e := x.(type) {
+	case *syntax.Name:
+		return e.GetTypeInfo().Addressable()
+	case *syntax.ParenExpr:
+		ok = ergoPlace(e.X)
+	case *syntax.Operation:
+		ok = e.Op == syntax.Mul && e.Y == nil
+	case *syntax.IndexExpr:
+		// A slice's element, an element of an array place or of the
+		// array a pointer points at (FLIP F7 arrays x F2 places).
+		switch t := types2.CoreType(e.X.GetTypeInfo().Type).(type) {
+		case *types2.Slice:
+			ok = true
+		case *types2.Array:
+			ok = ergoPlace(e.X)
+		case *types2.Pointer:
+			_, ok = types2.CoreType(t.Elem()).(*types2.Array)
+		}
+	case *syntax.SelectorExpr:
+		_, ok = types2.CoreType(e.X.GetTypeInfo().Type).(*types2.Pointer)
+		ok = ok || ergoPlace(e.X)
+	}
+	if ok {
+		tv := x.GetTypeInfo()
+		tv.SetAddressable()
+		tv.SetAssignable()
+		x.SetTypeInfo(tv)
+	}
+	return ok
+}
+
+func ergoValue(x syntax.Expr, t types2.Type, v constant.Value) {
+	tv := syntax.TypeAndValue{Type: t, Value: v}
+	tv.SetIsValue()
+	x.SetTypeInfo(tv)
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_union.go b/src/cmd/compile/internal/ergoir/ergoir_union.go
new file mode 100644
index 0000000..c486108
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_union.go
@@ -0,0 +1,144 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: unions and match. See ergoir.go.
+//
+// An Ergo union is a sealed Go interface or a flat struct of a tag and
+// slots; the Ergo lowering decides which, and the IR spells it. "toiface"
+// converts a variant to the sealed interface, as Go assigns it; "switch"
+// is an expression switch over constants (a flat union's tag, or a
+// match on a literal subject); a type switch is "tswitch"
+// (ergoir_fail.go). A case marked Def is the default clause in its
+// source place.
+
+package ergoir
+
+import (
+	"go/constant"
+	"go/token"
+
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// defClause is the default clause k; dup reports an earlier default.
+func (c *ergoChecker) defClause(k *ergoCase, dup bool) *syntax.CaseClause {
+	if dup || len(k.Types) > 0 || len(k.Vals) > 0 {
+		c.errorf(k.Pos, "ergoir: a second default clause, or a default with cases")
+		return nil
+	}
+	cl := &syntax.CaseClause{Body: c.stmts(k.Body)}
+	cl.SetPos(c.pos(k.Pos))
+	return cl
+}
+
+// unionStmt decodes the statements of unions and match; ok is false for a
+// kind it does not know.
+func (c *ergoChecker) unionStmt(s *ergoStmt) (st syntax.Stmt, ok bool) {
+	pos := c.pos(s.Pos)
+	switch s.K {
+	case "switch":
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil, true
+		}
+		if ergoBasicInfo(t) == 0 {
+			c.errorf(s.Pos, "ergoir: switch on %v, not a basic type", t)
+			return nil, true
+		}
+		sw := &syntax.SwitchStmt{Tag: x, Rbrace: c.pos(s.End)}
+		sw.SetPos(pos)
+		var seen []constant.Value
+		hasDef := false
+		for _, k := range s.Cases {
+			if k == nil {
+				c.errorf(s.Pos, "ergoir: a missing case")
+				return nil, true
+			}
+			if k.Def {
+				cl := c.defClause(k, hasDef || s.Else != nil)
+				if cl == nil {
+					return nil, true
+				}
+				hasDef = true
+				sw.Body = append(sw.Body, cl)
+				continue
+			}
+			if len(k.Vals) == 0 || len(k.Types) > 0 {
+				c.errorf(k.Pos, "ergoir: a switch case without its constants")
+				return nil, true
+			}
+			var vals []syntax.Expr
+			for _, v := range k.Vals {
+				if v == nil || v.K != "const" {
+					c.errorf(k.Pos, "ergoir: a switch case that is not a constant")
+					return nil, true
+				}
+				e, et := c.expr(v)
+				if e == nil || !c.assignable(v.Pos, "case", et, t) {
+					return nil, true
+				}
+				cv := ergoConstant(et, v.V)
+				for _, o := range seen {
+					if constant.Compare(o, token.EQL, cv) {
+						c.errorf(v.Pos, "ergoir: duplicate case %s", v.V)
+						return nil, true
+					}
+				}
+				seen = append(seen, cv)
+				vals = append(vals, e)
+			}
+			cl := &syntax.CaseClause{Body: c.stmts(k.Body)}
+			cl.SetPos(c.pos(k.Pos))
+			if len(vals) == 1 {
+				cl.Cases = vals[0]
+			} else {
+				l := &syntax.ListExpr{ElemList: vals}
+				l.SetPos(c.pos(k.Pos))
+				cl.Cases = l
+			}
+			sw.Body = append(sw.Body, cl)
+		}
+		if s.Else != nil {
+			def := &syntax.CaseClause{Body: c.stmts(s.Else)}
+			def.SetPos(c.pos(s.ElsePos))
+			sw.Body = append(sw.Body, def)
+		}
+		return sw, true
+	}
+	return nil, false
+}
+
+// unionExpr decodes the expressions of unions; ok is false for a kind it
+// does not know.
+func (c *ergoChecker) unionExpr(x *ergoExpr) (e syntax.Expr, t types2.Type, ok bool) {
+	pos := c.pos(x.Pos)
+	switch x.K {
+	case "toiface":
+		// T(x): a variant x to the sealed interface T it implements, or
+		// an interface value x to an interface T its method set
+		// implements (an Ergo operation type lent as the prelude's
+		// Reader or Writer, IFACE-CONV): Go's conversion, which the
+		// compiler lowers to an itab lookup.
+		t := c.typ(x.Pos, x.T)
+		v, vt := c.expr(x.X)
+		if t == nil || v == nil {
+			return nil, nil, true
+		}
+		iface, isIface := t.Underlying().(*types2.Interface)
+		if !isIface || vt == nil || !types2.Implements(vt, iface) {
+			c.errorf(x.Pos, "ergoir: conversion of %v to %v", vt, t)
+			return nil, nil, true
+		}
+		fun := c.typeExpr(x.Pos, t)
+		if fun == nil {
+			return nil, nil, true
+		}
+		call := &syntax.CallExpr{Fun: fun, ArgList: []syntax.Expr{v}}
+		call.SetPos(pos)
+		ergoValue(call, t, nil)
+		return call, t, true
+	}
+	return nil, nil, false
+}
