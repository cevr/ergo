--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergopkg_flags.go
@@ -0,0 +1,11 @@
+package ergoir
+
+import "flag"
+
+// PkgFlag enables the checked-package EIR v1 ingress (-ergopkg).
+// Registered on flag.CommandLine here so base/flag.go needs no hook hunk.
+var PkgFlag bool
+
+func init() {
+	flag.CommandLine.BoolVar(&PkgFlag, "ergopkg", false, "compile a checked EIR v1 package without Go parsing or types2")
+}
diff --git a/src/cmd/compile/internal/ergoir/ergopkg_test.go b/src/cmd/compile/internal/ergoir/ergopkg_test.go
new file mode 100644
index 0000000..56267a7
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergopkg_test.go
@@ -0,0 +1,191 @@
+package ergoir
+
+import (
+	"encoding/binary"
+	"strings"
+	"testing"
+)
+
+func buildTestSpecimen(seed uint32) []byte {
+	names := []string{
+		"Apply", "Generic", "a/dep", "amd64", "d.Gen", "dep", "go1.27.4",
+		"init.0", "init.1", "linux", "main.ergo", "plain", "tiny", "z/tiny",
+	}
+	ends := make([]uint32, len(names))
+	var off uint32
+	for i, n := range names {
+		off += uint32(len(n))
+		ends[i] = off
+	}
+	colPack := func(width int, rows [][]uint32) []uint32 {
+		out := make([]uint32, 0, width*len(rows))
+		for c := 0; c < width; c++ {
+			for _, row := range rows {
+				out = append(out, row[c])
+			}
+		}
+		return out
+	}
+	ty := colPack(4, [][]uint32{
+		{HTBasic, HBasicInt, 0, 0},
+		{HTBasic, HBasicAny, 0, 0},
+		{HTSignature, 0, 0, 0},
+		{HTSignature, 0, 0, 1},
+		{HTParameter, 5, 1, 1},
+		{HTSignature, 1, 2, 2},
+		{HTGeneric, 6, 4, 1},
+		{HTSignature, 1, 5, 2},
+	})
+	sy := colPack(5, [][]uint32{
+		{0, 1, HSFunc, 4, 1},
+		{0, 5, HSDictionary, 8, 1},
+		{0, 8, HSFunc, 3, 2},
+		{0, 9, HSFunc, 3, 2},
+		{1, 2, HSFunc, 7, 0},
+	})
+	bs := colPack(5, [][]uint32{
+		{1, 0, 2, 0, 3},
+		{3, 2, 0, 3, 1},
+		{4, 2, 0, 4, 1},
+	})
+	os := colPack(4, [][]uint32{
+		{HOConst, 1, 7, 3},
+		{HOCallInstance, 1, 10, 4},
+		{HOReturn, 1, 14, 1},
+		{HOReturn, 2, 15, 0},
+		{HOReturn, 2, 15, 0},
+	})
+	cols := [][]uint32{
+		{14, 13, 10, 4, 7, 12},
+		ends,
+		{3, 6, 1, 0x04030201, 0x08070605},
+		{11, 100, 0, 2, 0x12345678, 0, 0, 0, 0, 0, 0, 0},
+		{0, 30},
+		colPack(3, [][]uint32{{1, 2, 4}, {1, 40, 43}}),
+		ty,
+		sy,
+		bs,
+		{1, 1},
+		os,
+		{5, 8, 2, 15, 1},
+		{},
+		{4, 3},
+		{1, 2, 5, 5, 5, 1, 1, 1, seed, 0, 1, 1, 2, 1, 2, 1},
+	}
+	text := strings.Join(names, "")
+	var out []byte
+	out = append(out, EIRMagic...)
+	out = binary.LittleEndian.AppendUint32(out, EIRVersion)
+	for i := 0; i < EIRSections-1; i++ {
+		out = binary.LittleEndian.AppendUint32(out, uint32(len(cols[i])/eirWidths[i]))
+	}
+	out = binary.LittleEndian.AppendUint32(out, uint32(len(text)))
+	for _, col := range cols {
+		for _, v := range col {
+			out = binary.LittleEndian.AppendUint32(out, v)
+		}
+	}
+	out = append(out, text...)
+	return out
+}
+
+func editSpecimenWord(wire []byte, section, row, col int, val uint32) []byte {
+	p, err := DecodeEIR(wire)
+	if err != nil {
+		panic(err)
+	}
+	cp := append([]byte(nil), wire...)
+	at := p.dir[section].start + (p.rows(section)*col+row)*4
+	binary.LittleEndian.PutUint32(cp[at:at+4], val)
+	return cp
+}
+
+func TestDecodeEIRSpecimenAndPositions(t *testing.T) {
+	wire := buildTestSpecimen(17)
+	p, err := DecodeEIR(wire)
+	if err != nil {
+		t.Fatalf("DecodeEIR failed: %v", err)
+	}
+	if p.Target.Path != "z/tiny" || p.PkgName != "tiny" || p.Target.Profile != "plain" {
+		t.Fatalf("unexpected target/pkg: %+v %q", p.Target, p.PkgName)
+	}
+	if len(p.Inits) != 2 || p.Inits[0] != 4 || p.Inits[1] != 3 {
+		t.Fatalf("expected non-symbol init order [4, 3], got %v", p.Inits)
+	}
+	f0, l0, c0 := p.SpanPos(1)
+	if f0 != 0 || l0 != 1 || c0 != 3 {
+		t.Fatalf("span 1 pos = (%d,%d,%d), want (0,1,3)", f0, l0, c0)
+	}
+	f1, l1, c1 := p.SpanPos(2)
+	if f1 != 0 || l1 != 2 || c1 != 11 {
+		t.Fatalf("span 2 pos = (%d,%d,%d), want (0,2,11)", f1, l1, c1)
+	}
+}
+
+func TestDecodeEIRFailClosed(t *testing.T) {
+	wire := buildTestSpecimen(17)
+
+	// Unknown version
+	badVer := append([]byte(nil), wire...)
+	binary.LittleEndian.PutUint32(badVer[8:12], 99)
+	if _, err := DecodeEIR(badVer); err == nil {
+		t.Fatal("accepted unknown schema version 99")
+	}
+
+	// Bad span end > file size
+	badSpan := editSpecimenWord(wire, HSpans, 0, 2, 101)
+	if _, err := DecodeEIR(badSpan); err == nil {
+		t.Fatal("accepted span past file size")
+	}
+
+	// Missing dictionary on instance
+	badDict := editSpecimenWord(wire, HInstances, 0, 2, 0)
+	if _, err := DecodeEIR(badDict); err == nil {
+		t.Fatal("accepted instance without dictionary")
+	}
+
+	// Bad slot type in call
+	badSlot := editSpecimenWord(wire, HSlots, 0, 0, 2)
+	if _, err := DecodeEIR(badSlot); err == nil {
+		t.Fatal("accepted mismatched slot type")
+	}
+
+	// Duplicate/incomplete init order
+	badInit := editSpecimenWord(wire, HInit, 0, 0, 3)
+	if _, err := DecodeEIR(badInit); err == nil {
+		t.Fatal("accepted duplicate init entry")
+	}
+
+	// Truncated file
+	if _, err := DecodeEIR(wire[:len(wire)-1]); err == nil {
+		t.Fatal("accepted truncated image")
+	}
+}
+
+func TestAdmitEIRChecksFingerprintAndProfile(t *testing.T) {
+	p, err := DecodeEIR(buildTestSpecimen(17))
+	if err != nil {
+		t.Fatal(err)
+	}
+	obs := []EIRImport{{
+		Path:        "a/dep",
+		Name:        "dep",
+		HasInit:     true,
+		Fingerprint: [8]byte{1, 2, 3, 4, 5, 6, 7, 8},
+	}}
+	if err := AdmitEIR(p, p.Target, obs); err != nil {
+		t.Fatalf("valid admission rejected: %v", err)
+	}
+
+	stale := obs
+	stale[0].Fingerprint[7] ^= 1
+	if err := AdmitEIR(p, p.Target, stale); err == nil {
+		t.Fatal("accepted stale import fingerprint")
+	}
+
+	wrongProfile := p.Target
+	wrongProfile.Profile = "race"
+	if err := AdmitEIR(p, wrongProfile, obs); err == nil {
+		t.Fatal("accepted mismatched flag profile")
+	}
+}
diff --git a/src/cmd/compile/internal/noder/ergo_package.go b/src/cmd/compile/internal/noder/ergo_package.go
new file mode 100644
index 0000000..21f987c
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergo_package.go
@@ -0,0 +1,220 @@
+package noder
+
+import (
+	"flag"
+	"fmt"
+	"internal/buildcfg"
+	"internal/pkgbits"
+	"os"
+	"strings"
+
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/ergoir"
+	"cmd/compile/internal/inline"
+	"cmd/compile/internal/ir"
+	"cmd/compile/internal/pgoir"
+	"cmd/compile/internal/typecheck"
+	"cmd/compile/internal/types"
+	"cmd/internal/obj"
+)
+
+// ergoLoadPackage is the single guarded ingress for -ergopkg.
+// When -ergopkg is off, it returns false immediately so stock Go compilation
+// runs without any behavioral or output difference.
+func ergoLoadPackage(filenames []string) bool {
+	if !ergoir.PkgFlag {
+		return false
+	}
+
+	if err := loadErgoPackage(filenames); err != nil {
+		base.Errorf("%v", err)
+		base.ErrorExit()
+	}
+	return true
+}
+
+func loadErgoPackage(filenames []string) error {
+	if ergoir.Flag.IR != "" {
+		return fmt.Errorf("ergopkg: -ergopkg cannot be combined with -ergoir")
+	}
+	if len(filenames) != 1 {
+		return fmt.Errorf("ergopkg: expected exactly one checked EIR package file, got %d", len(filenames))
+	}
+	if strings.HasSuffix(filenames[0], ".go") {
+		return fmt.Errorf("ergopkg: -ergopkg cannot be combined with .go source file %q", filenames[0])
+	}
+
+	var sawP, sawO, sawCov bool
+	flag.CommandLine.Visit(func(f *flag.Flag) {
+		switch f.Name {
+		case "p":
+			sawP = true
+		case "o":
+			sawO = true
+		case "coveragecfg":
+			sawCov = true
+		}
+	})
+	if !sawP || base.Ctxt.Pkgpath == "" || base.Ctxt.Pkgpath == obj.UnlinkablePkg {
+		return fmt.Errorf("ergopkg: explicit -p package path is required")
+	}
+	if !sawO || base.Flag.LowerO == "" {
+		return fmt.Errorf("ergopkg: explicit -o output path is required")
+	}
+
+	wire, err := os.ReadFile(filenames[0])
+	if err != nil {
+		return fmt.Errorf("ergopkg: reading %q: %w", filenames[0], err)
+	}
+	eir, err := ergoir.DecodeEIR(wire)
+	if err != nil {
+		return err
+	}
+
+	profile := ergoActiveProfile(sawCov)
+	pin := buildcfg.Version
+	if fields := strings.Fields(pin); len(fields) > 0 {
+		pin = fields[0]
+	}
+	wantTarget := ergoir.EIRTarget{
+		Path:    base.Ctxt.Pkgpath,
+		GOOS:    buildcfg.GOOS,
+		GOARCH:  buildcfg.GOARCH,
+		Pin:     pin,
+		Profile: profile,
+	}
+
+	type openedImport struct {
+		resolved string
+		data     string
+		pr       pkgbits.PkgDecoder
+	}
+	opened := make([]openedImport, len(eir.Imports))
+	observed := make([]ergoir.EIRImport, len(eir.Imports))
+
+	for i, imp := range eir.Imports {
+		resolved, err := resolveImportPath(imp.Path)
+		if err != nil {
+			return fmt.Errorf("ergopkg: import %q: %w", imp.Path, err)
+		}
+		if resolved == "unsafe" {
+			return fmt.Errorf("ergopkg: import %q is not a Go archive import", imp.Path)
+		}
+		f, err := openPackage(resolved)
+		if err != nil {
+			return fmt.Errorf("ergopkg: opening import %q: %w", imp.Path, err)
+		}
+		data, err := readExportData(f)
+		f.Close()
+		if err != nil {
+			return fmt.Errorf("ergopkg: reading export data of %q: %w", imp.Path, err)
+		}
+		pr := pkgbits.NewPkgDecoder(resolved, data)
+		obsName, obsHasInit := inspectImportedArchive(&pr)
+		opened[i] = openedImport{resolved: resolved, data: data, pr: pr}
+		observed[i] = ergoir.EIRImport{
+			Path:        imp.Path,
+			Name:        obsName,
+			HasInit:     obsHasInit,
+			Fingerprint: pr.Fingerprint(),
+		}
+	}
+
+	if err := ergoir.AdmitEIR(eir, wantTarget, observed); err != nil {
+		return err
+	}
+
+	// Build unified stub before mutating compiler state so unsupported EIR
+	// constructs fail closed before producing any output.
+	stubData, err := writeErgoPkgStub(eir)
+	if err != nil {
+		return err
+	}
+
+	target := typecheck.Target
+	types.LocalPkg.Name = eir.PkgName
+
+	for _, imp := range opened {
+		pkg1 := types.NewPkg(imp.resolved, "")
+		if !pkg1.Direct {
+			pkg1.Direct = true
+			target.Imports = append(target.Imports, pkg1)
+			readPackage(newPkgReader(imp.pr), pkg1, false)
+			if err := addFingerprint(imp.resolved, imp.data); err != nil {
+				return fmt.Errorf("ergopkg: fingerprint for %q: %w", imp.resolved, err)
+			}
+		}
+	}
+
+	inline.InlineCall = unifiedInlineCall
+	typecheck.HaveInlineBody = unifiedHaveInlineBody
+	pgoir.LookupFunc = LookupFunc
+	pgoir.PostLookupCleanup = PostLookupCleanup
+
+	localPkgReader = newPkgReader(pkgbits.NewPkgDecoder(types.LocalPkg.Path, stubData))
+	readPackage(localPkgReader, types.LocalPkg, true)
+
+	r := localPkgReader.newReader(pkgbits.SectionMeta, pkgbits.PrivateRootIdx, pkgbits.SyncPrivate)
+	r.pkgInit(types.LocalPkg, target)
+
+	readBodies(target, false, nil)
+
+	for _, fn := range target.Funcs {
+		if fn.Typecheck() == 0 {
+			base.FatalfAt(fn.Pos(), "missed typecheck: %v", fn)
+		}
+		if len(fn.Body) != 0 {
+			if stmt := fn.Body[0]; stmt.Typecheck() == 0 {
+				base.FatalfAt(stmt.Pos(), "missed typecheck: %v", stmt)
+			}
+		}
+	}
+	for _, fn := range target.Funcs {
+		if !base.Flag.CompilingRuntime && types.RuntimeSymName(fn.Sym()) != "" {
+			fn.Pragma |= ir.Norace
+		}
+	}
+
+	base.ExitIfErrors()
+	return nil
+}
+
+func ergoActiveProfile(sawCov bool) string {
+	var flags []string
+	if base.Flag.Race {
+		flags = append(flags, "race")
+	}
+	if base.Flag.MSan {
+		flags = append(flags, "msan")
+	}
+	if base.Flag.ASan {
+		flags = append(flags, "asan")
+	}
+	if base.Flag.Dynlink != nil && *base.Flag.Dynlink {
+		flags = append(flags, "dynlink")
+	}
+	if base.Flag.Shared != nil && *base.Flag.Shared {
+		flags = append(flags, "shared")
+	}
+	if sawCov {
+		flags = append(flags, "cover")
+	}
+	if len(flags) == 0 {
+		return "plain"
+	}
+	return strings.Join(flags, "+")
+}
+
+func inspectImportedArchive(pr *pkgbits.PkgDecoder) (pkgName string, hasInit bool) {
+	pub := pr.NewDecoder(pkgbits.SectionMeta, pkgbits.PublicRootIdx, pkgbits.SyncPublic)
+	pub.Sync(pkgbits.SyncPkg)
+	pkgIdx := pub.Reloc(pkgbits.SectionPkg)
+
+	pdec := pr.NewDecoder(pkgbits.SectionPkg, pkgIdx, pkgbits.SyncPkgDef)
+	_ = pdec.String() // path
+	pkgName = pdec.String()
+
+	priv := pr.NewDecoder(pkgbits.SectionMeta, pkgbits.PrivateRootIdx, pkgbits.SyncPrivate)
+	hasInit = priv.Bool()
+	return pkgName, hasInit
+}
diff --git a/src/cmd/compile/internal/noder/ergoir_hook.go b/src/cmd/compile/internal/noder/ergoir_hook.go
