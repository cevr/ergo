diff --git a/src/cmd/compile/internal/noder/ergoir.go b/src/cmd/compile/internal/noder/ergoir.go
new file mode 100644
index 0000000..e4467da
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergoir.go
@@ -0,0 +1,227 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Experimental (Ergo IR1 spike): typed function bodies from Ergo IR.
+//
+// With -ergoir=FILE, every function FILE names must be declared in the Go
+// source without a body. ergoAttach decodes each IR body, checks every node
+// against the package's types2 objects, and builds the typed syntax body
+// (with the type records types2 would have made) that the unified writer
+// then encodes like any other. Go never parses or type-checks an IR body,
+// and a node that does not check is a compile error at its own position.
+//
+// The decoder is one file per construct family: ergoir.go (format, entry,
+// functions), ergoir_types.go, ergoir_stmt.go, ergoir_expr.go and
+// ergoir_call.go.
+
+package noder
+
+import (
+	"encoding/json"
+	"os"
+
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoFile is the IR file: the source files positions refer to, and the
+// bodies.
+type ergoFile struct {
+	V     int        `json:"v"`
+	Files []string   `json:"files"`
+	Funcs []ergoFunc `json:"funcs"`
+}
+
+// ergoFunc is one body: Name is F, or T.M for a method of T. Locals
+// declares the body's own variables; index i < number of receiver and
+// parameters names those, the rest names Locals in order.
+type ergoFunc struct {
+	Name   string      `json:"name"`
+	Pos    ergoPos     `json:"pos"`
+	End    ergoPos     `json:"end"`
+	Locals []ergoLocal `json:"locals"`
+	Body   []*ergoStmt `json:"body"`
+}
+
+type ergoLocal struct {
+	Name string  `json:"name"`
+	Type string  `json:"type"`
+	Pos  ergoPos `json:"pos"`
+}
+
+// ergoPos is file index, line, column.
+type ergoPos [3]int
+
+type ergoStmt struct {
+	K     string      `json:"k"` // def set ret if range while expr
+	Pos   ergoPos     `json:"pos"`
+	Local int         `json:"local,omitempty"`
+	Key   *int        `json:"key,omitempty"`
+	Val   *int        `json:"val,omitempty"`
+	X     *ergoExpr   `json:"x,omitempty"`
+	Then  []*ergoStmt `json:"then,omitempty"`
+	Else  []*ergoStmt `json:"else,omitempty"`
+	Body  []*ergoStmt `json:"body,omitempty"`
+	End   ergoPos     `json:"end"`
+	// ElsePos and ElseEnd bound an if's else block.
+	ElsePos ergoPos `json:"epos"`
+	ElseEnd ergoPos `json:"eend"`
+	// Cases are a "tswitch"'s clauses (ergoir_fail.go); Else is its
+	// default clause, at ElsePos.
+	Cases []*ergoCase `json:"cases,omitempty"`
+}
+
+type ergoExpr struct {
+	K     string      `json:"k"` // local const bin un call mcall field index lit len
+	Pos   ergoPos     `json:"pos"`
+	I     int         `json:"i,omitempty"`
+	T     string      `json:"t,omitempty"`
+	V     string      `json:"v,omitempty"`
+	Op    string      `json:"op,omitempty"`
+	X     *ergoExpr   `json:"x,omitempty"`
+	Y     *ergoExpr   `json:"y,omitempty"`
+	Name  string      `json:"name,omitempty"`
+	Args  []*ergoExpr `json:"args,omitempty"`
+	Elems []*ergoExpr `json:"elems,omitempty"`
+	Keys  []string    `json:"keys,omitempty"` // a record literal's field names
+}
+
+var ergoBinOps = map[string]syntax.Operator{
+	"+": syntax.Add, "-": syntax.Sub, "*": syntax.Mul, "/": syntax.Div, "%": syntax.Rem,
+	"==": syntax.Eql, "!=": syntax.Neq, "<": syntax.Lss, "<=": syntax.Leq, ">": syntax.Gtr, ">=": syntax.Geq,
+	"&&": syntax.AndAnd, "||": syntax.OrOr,
+}
+
+type ergoChecker struct {
+	m      *posMap
+	pkg    *types2.Package
+	info   *types2.Info
+	bases  []*syntax.PosBase
+	sig    *types2.Signature
+	locals []*types2.Var
+	nerr   int
+}
+
+// ergoAttach gives every function the IR file names its checked body.
+func ergoAttach(m posMap, pkg *types2.Package, info *types2.Info, noders []*noder) {
+	data, err := os.ReadFile(base.Flag.ErgoIR)
+	if err != nil {
+		base.Fatalf("ergoir: %v", err)
+	}
+	var f ergoFile
+	if err := json.Unmarshal(data, &f); err != nil {
+		base.Fatalf("ergoir: %s: %v", base.Flag.ErgoIR, err)
+	}
+	if f.V != 1 {
+		base.Fatalf("ergoir: %s: version %d, want 1", base.Flag.ErgoIR, f.V)
+	}
+	c := &ergoChecker{m: &m, pkg: pkg, info: info}
+	for _, name := range f.Files {
+		c.bases = append(c.bases, syntax.NewFileBase(name))
+	}
+	decls := map[string]*syntax.FuncDecl{}
+	for _, p := range noders {
+		for _, d := range p.file.DeclList {
+			fd, ok := d.(*syntax.FuncDecl)
+			if !ok {
+				continue
+			}
+			obj, ok := info.Defs[fd.Name].(*types2.Func)
+			if !ok {
+				continue
+			}
+			decls[ergoKey(obj)] = fd
+		}
+	}
+	for i := range f.Funcs {
+		fn := &f.Funcs[i]
+		fd := decls[fn.Name]
+		switch {
+		case fd == nil:
+			c.errorf(fn.Pos, "ergoir: %s is not declared in the Go source", fn.Name)
+			continue
+		case fd.Body != nil:
+			c.errorf(fn.Pos, "ergoir: %s has a Go body as well as an IR body", fn.Name)
+			continue
+		}
+		c.function(fd, fn)
+		delete(decls, fn.Name) // a second IR body for the same name finds it gone
+	}
+	base.ExitIfErrors()
+}
+
+// ergoKey is F or T.M.
+func ergoKey(obj *types2.Func) string {
+	sig := obj.Type().(*types2.Signature)
+	if sig.Recv() == nil {
+		return obj.Name()
+	}
+	t := sig.Recv().Type()
+	if p, ok := t.(*types2.Pointer); ok {
+		t = p.Elem()
+	}
+	if n, ok := types2.Unalias(t).(*types2.Named); ok {
+		return n.Obj().Name() + "." + obj.Name()
+	}
+	return "?." + obj.Name()
+}
+
+func (c *ergoChecker) pos(p ergoPos) syntax.Pos {
+	if p[0] < 0 || p[0] >= len(c.bases) {
+		return syntax.Pos{}
+	}
+	return syntax.MakePos(c.bases[p[0]], uint(p[1]), uint(p[2]))
+}
+
+func (c *ergoChecker) errorf(p ergoPos, format string, args ...any) {
+	c.nerr++
+	pos := c.pos(p)
+	if !pos.IsKnown() {
+		base.Errorf(format, args...)
+		return
+	}
+	base.ErrorfAt(c.m.makeXPos(pos), 0, format, args...)
+}
+
+func (c *ergoChecker) function(fd *syntax.FuncDecl, fn *ergoFunc) {
+	obj := c.info.Defs[fd.Name].(*types2.Func)
+	c.sig = obj.Type().(*types2.Signature)
+	c.locals = nil
+	if r := c.sig.Recv(); r != nil {
+		c.locals = append(c.locals, r)
+	}
+	for i := 0; i < c.sig.Params().Len(); i++ {
+		c.locals = append(c.locals, c.sig.Params().At(i))
+	}
+	if !ergoSigOK(c.sig) || c.sig.Variadic() || c.sig.TypeParams().Len() > 0 || c.sig.RecvTypeParams().Len() > 0 {
+		c.errorf(fn.Pos, "ergoir: %s: only plain signatures with at most one result take an IR body", fn.Name)
+		return
+	}
+	for _, l := range fn.Locals {
+		t := c.typ(l.Pos, l.Type)
+		if t == nil {
+			return
+		}
+		c.locals = append(c.locals, types2.NewVar(c.pos(l.Pos), c.pkg, l.Name, t))
+	}
+	before := c.nerr
+	body := &syntax.BlockStmt{List: c.stmts(fn.Body), Rbrace: c.pos(fn.End)}
+	body.SetPos(c.pos(fn.Pos))
+	if c.nerr != before {
+		return
+	}
+	if c.sig.Results().Len() == 1 && ergoFallible(c.sig) {
+		// A fallible body with no value ends in its success (ergoir_fail.go).
+		if last := lastNonEmptyStmt(body.List); last == nil || !ergoTerminates(last) {
+			body.List = append(body.List, c.ret(&ergoStmt{K: "ret", Pos: fn.End}))
+		}
+	} else if c.sig.Results().Len() >= 1 {
+		if last := lastNonEmptyStmt(body.List); last == nil || !ergoTerminates(last) {
+			c.errorf(fn.End, "ergoir: %s: missing return", fn.Name)
+			return
+		}
+	}
+	fd.Body = body
+}
diff --git a/src/cmd/compile/internal/noder/ergoir_call.go b/src/cmd/compile/internal/noder/ergoir_call.go
new file mode 100644
index 0000000..73aec3e
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergoir_call.go
@@ -0,0 +1,43 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: calls. See ergoir.go.
+
+package noder
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// call checks the arguments of a call of fun, whose signature is sig.
+func (c *ergoChecker) call(x *ergoExpr, fun syntax.Expr, sig *types2.Signature) (syntax.Expr, types2.Type) {
+	if sig.Variadic() || sig.Params().Len() != len(x.Args) || !ergoSigOK(sig) {
+		c.errorf(x.Pos, "ergoir: call of %s with %d arguments", x.Name, len(x.Args))
+		return nil, nil
+	}
+	call := &syntax.CallExpr{Fun: fun}
+	call.SetPos(c.pos(x.Pos))
+	for i, a := range x.Args {
+		e, t := c.expr(a)
+		if e == nil || !c.assignable(a.Pos, "argument", t, sig.Params().At(i).Type()) {
+			return nil, nil
+		}
+		call.ArgList = append(call.ArgList, e)
+	}
+	if sig.Results().Len() == 0 {
+		tv := syntax.TypeAndValue{}
+		tv.SetIsVoid()
+		call.SetTypeInfo(tv)
+		return call, nil
+	}
+	var t types2.Type = sig.Results()
+	if sig.Results().Len() == 1 {
+		t = sig.Results().At(0).Type()
+	}
+	// A fallible call's type is its (value, error) tuple, which only a
+	// def2 or a return of the whole result list takes (ergoir_fail.go).
+	ergoValue(call, t, nil)
+	return call, t
+}
diff --git a/src/cmd/compile/internal/noder/ergoir_expr.go b/src/cmd/compile/internal/noder/ergoir_expr.go
new file mode 100644
index 0000000..50bd0fe
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergoir_expr.go
@@ -0,0 +1,270 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: expressions, literals and constants. See ergoir.go.
+
+package noder
+
+import (
+	"go/constant"
+	"strconv"
+
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// expr checks x and returns its typed syntax and its type (nil: a call
+// with no result).
+func (c *ergoChecker) expr(x *ergoExpr) (syntax.Expr, types2.Type) {
+	if x == nil {
+		c.errorf(ergoPos{-1}, "ergoir: missing expression")
+		return nil, nil
+	}
+	pos := c.pos(x.Pos)
+	switch x.K {
+	case "local":
+		v := c.local(x.Pos, x.I)
+		if v == nil {
+			return nil, nil
+		}
+		return c.name(x.Pos, v, false), v.Type()
+	case "const":
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil
+		}
+		var v constant.Value
+		switch {
+		case ergoIsInteger(t):
+			n, err := strconv.ParseInt(x.V, 10, 64)
+			if err != nil {
+				c.errorf(x.Pos, "ergoir: integer constant %q", x.V)
+				return nil, nil
+			}
+			v = constant.MakeInt64(n)
+		case ergoIsBool(t):
+			v = constant.MakeBool(x.V == "true")
+		case ergoIsString(t):
+			v = constant.MakeString(x.V)
+		default:
+			c.errorf(x.Pos, "ergoir: constant of type %v", t)
+			return nil, nil
+		}
+		lit := &syntax.BasicLit{Value: x.V}
+		lit.SetPos(pos)
+		ergoValue(lit, t, v)
+		return lit, t
+	case "bin":
+		op, ok := ergoBinOps[x.Op]
+		if !ok {
+			c.errorf(x.Pos, "ergoir: operator %q", x.Op)
+			return nil, nil
+		}
+		l, lt := c.expr(x.X)
+		r, rt := c.expr(x.Y)
+		if l == nil || r == nil || !c.assignable(x.Pos, x.Op, rt, lt) {
+			return nil, nil
+		}
+		var t types2.Type
+		switch op {
+		case syntax.Add:
+			if !ergoIsInteger(lt) && !ergoIsString(lt) {
+				c.errorf(x.Pos, "ergoir: + on %v", lt)
+				return nil, nil
+			}
+			t = lt
+		case syntax.Sub, syntax.Mul, syntax.Div, syntax.Rem:
+			if !ergoIsInteger(lt) {
+				c.errorf(x.Pos, "ergoir: %s on %v", x.Op, lt)
+				return nil, nil
+			}
+			t = lt
+		case syntax.Eql, syntax.Neq:
+			if !types2.Comparable(lt) {
+				c.errorf(x.Pos, "ergoir: %s on %v", x.Op, lt)
+				return nil, nil
+			}
+			t = types2.Typ[types2.Bool]
+		case syntax.Lss, syntax.Leq, syntax.Gtr, syntax.Geq:
+			if !ergoIsInteger(lt) && !ergoIsString(lt) {
+				c.errorf(x.Pos, "ergoir: %s on %v", x.Op, lt)
+				return nil, nil
+			}
+			t = types2.Typ[types2.Bool]
+		case syntax.AndAnd, syntax.OrOr:
+			if !ergoIsBool(lt) {
+				c.errorf(x.Pos, "ergoir: %s on %v", x.Op, lt)
+				return nil, nil
+			}
+			t = lt
+		}
+		e := &syntax.Operation{Op: op, X: l, Y: r}
+		e.SetPos(pos)
+		ergoValue(e, t, nil)
+		return e, t
+	case "un":
+		e0, t := c.expr(x.X)
+		if e0 == nil {
+			return nil, nil
+		}
+		var op syntax.Operator
+		switch {
+		case x.Op == "!" && ergoIsBool(t):
+			op = syntax.Not
+		case x.Op == "-" && ergoIsInteger(t):
+			op = syntax.Sub
+		default:
+			c.errorf(x.Pos, "ergoir: unary %s on %v", x.Op, t)
+			return nil, nil
+		}
+		e := &syntax.Operation{Op: op, X: e0}
+		e.SetPos(pos)
+		ergoValue(e, t, nil)
+		return e, t
+	case "call":
+		fn, ok := c.pkg.Scope().Lookup(x.Name).(*types2.Func)
+		if !ok {
+			c.errorf(x.Pos, "ergoir: %s is not a function of the package", x.Name)
+			return nil, nil
+		}
+		sig := fn.Type().(*types2.Signature)
+		if sig.TypeParams().Len() > 0 {
+			c.errorf(x.Pos, "ergoir: %s is generic", x.Name)
+			return nil, nil
+		}
+		fun := syntax.NewName(pos, x.Name)
+		c.info.Uses[fun] = fn
+		ergoValue(fun, sig, nil)
+		return c.call(x, fun, sig)
+	case "mcall":
+		recv, rt := c.expr(x.X)
+		if recv == nil {
+			return nil, nil
+		}
+		sel, ok := types2.LookupSelection(rt, false, c.pkg, x.Name)
+		if !ok || sel.Kind() != types2.MethodVal {
+			c.errorf(x.Pos, "ergoir: %v has no method %s", rt, x.Name)
+			return nil, nil
+		}
+		// No implicit &x and no embedded path: a pointer method is called
+		// on a pointer only.
+		mrecv := sel.Obj().(*types2.Func).Type().(*types2.Signature).Recv().Type()
+		if isPtrTo(mrecv, rt) || len(sel.Index()) != 1 {
+			c.errorf(x.Pos, "ergoir: %s needs an implicit address or an embedded path", x.Name)
+			return nil, nil
+		}
+		se := &syntax.SelectorExpr{X: recv, Sel: syntax.NewName(pos, x.Name)}
+		se.SetPos(pos)
+		c.info.Selections[se] = &sel
+		c.info.Uses[se.Sel] = sel.Obj()
+		sig := sel.Type().(*types2.Signature)
+		ergoValue(se, sig, nil)
+		return c.call(x, se, sig)
+	case "field":
+		recv, rt := c.expr(x.X)
+		if recv == nil {
+			return nil, nil
+		}
+		sel, ok := types2.LookupSelection(rt, false, c.pkg, x.Name)
+		if !ok || sel.Kind() != types2.FieldVal || len(sel.Index()) != 1 {
+			c.errorf(x.Pos, "ergoir: %v has no direct field %s", rt, x.Name)
+			return nil, nil
+		}
+		se := &syntax.SelectorExpr{X: recv, Sel: syntax.NewName(pos, x.Name)}
+		se.SetPos(pos)
+		c.info.Selections[se] = &sel
+		c.info.Uses[se.Sel] = sel.Obj()
+		ergoValue(se, sel.Type(), nil)
+		return se, sel.Type()
+	case "index":
+		xs, xt := c.expr(x.X)
+		i, it := c.expr(x.Y)
+		if xs == nil || i == nil {
+			return nil, nil
+		}
+		sl, ok := types2.CoreType(xt).(*types2.Slice)
+		if !ok || !types2.Identical(it, types2.Typ[types2.Int]) {
+			c.errorf(x.Pos, "ergoir: index of %v by %v", xt, it)
+			return nil, nil
+		}
+		e := &syntax.IndexExpr{X: xs, Index: i}
+		e.SetPos(pos)
+		ergoValue(e, sl.Elem(), nil)
+		return e, sl.Elem()
+	case "len":
+		xs, xt := c.expr(x.X)
+		if xs == nil {
+			return nil, nil
+		}
+		if _, ok := types2.CoreType(xt).(*types2.Slice); !ok && !ergoIsString(xt) {
+			c.errorf(x.Pos, "ergoir: len of %v", xt)
+			return nil, nil
+		}
+		b := types2.Universe.Lookup("len")
+		fun := syntax.NewName(pos, "len")
+		c.info.Uses[fun] = b
+		tv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil,
+			types2.NewTuple(types2.NewParam(pos, nil, "", xt)),
+			types2.NewTuple(types2.NewParam(pos, nil, "", types2.Typ[types2.Int])), false)}
+		tv.SetIsBuiltin()
+		fun.SetTypeInfo(tv)
+		call := &syntax.CallExpr{Fun: fun, ArgList: []syntax.Expr{xs}}
+		call.SetPos(pos)
+		ergoValue(call, types2.Typ[types2.Int], nil)
+		return call, types2.Typ[types2.Int]
+	case "lit":
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil
+		}
+		lit := &syntax.CompositeLit{}
+		lit.SetPos(pos)
+		switch u := types2.CoreType(t).(type) {
+		case *types2.Struct:
+			// Keyed, in the IR's (source) order, every field once.
+			if len(x.Keys) != len(x.Elems) || len(x.Elems) != u.NumFields() {
+				c.errorf(x.Pos, "ergoir: %v literal with %d of %d fields", t, len(x.Elems), u.NumFields())
+				return nil, nil
+			}
+			seen := map[string]bool{}
+			for i, ex := range x.Elems {
+				sel, ok := types2.LookupSelection(t, false, c.pkg, x.Keys[i])
+				if !ok || sel.Kind() != types2.FieldVal || len(sel.Index()) != 1 || seen[x.Keys[i]] {
+					c.errorf(ex.Pos, "ergoir: %v has no field %s, or it is given twice", t, x.Keys[i])
+					return nil, nil
+				}
+				seen[x.Keys[i]] = true
+				e, et := c.expr(ex)
+				if e == nil || !c.assignable(ex.Pos, "field", et, sel.Type()) {
+					return nil, nil
+				}
+				key := syntax.NewName(c.pos(ex.Pos), x.Keys[i])
+				c.info.Uses[key] = sel.Obj()
+				kv := &syntax.KeyValueExpr{Key: key, Value: e}
+				kv.SetPos(c.pos(ex.Pos))
+				lit.ElemList = append(lit.ElemList, kv)
+			}
+			lit.NKeys = len(x.Keys)
+		case *types2.Slice:
+			for _, ex := range x.Elems {
+				e, et := c.expr(ex)
+				if e == nil || !c.assignable(ex.Pos, "element", et, u.Elem()) {
+					return nil, nil
+				}
+				lit.ElemList = append(lit.ElemList, e)
+			}
+		default:
+			c.errorf(x.Pos, "ergoir: literal of %v", t)
+			return nil, nil
+		}
+		lit.Rbrace = pos
+		ergoValue(lit, t, nil)
+		return lit, t
+	}
+	if e, t, ok := c.failExpr(x); ok { // ergoir_fail.go
+		return e, t
+	}
+	c.errorf(x.Pos, "ergoir: unknown expression %q", x.K)
+	return nil, nil
+}
diff --git a/src/cmd/compile/internal/noder/ergoir_fail.go b/src/cmd/compile/internal/noder/ergoir_fail.go
new file mode 100644
index 0000000..d1a6c7c
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergoir_fail.go
@@ -0,0 +1,310 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: the failure ABI. See ergoir.go.
+//
+// A fallible Ergo function returns (T, error), or error when it has no
+// value. "ret" is its success return (the error slot is nil); "fail"
+// leaves with the zero value and an error; "def2" binds a fallible call's
+// value and error; "tswitch" is a catch's type switch on an error, and
+// "assert" reads the case's type out of it; "panic" is a total catch's
+// default.
+
+package noder
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoCase is one clause of a "tswitch": its types, or none for the
+// default clause.
+type ergoCase struct {
+	Pos   ergoPos     `json:"pos"`
+	Types []string    `json:"types"`
+	Body  []*ergoStmt `json:"body,omitempty"`
+}
+
+// ergoFallible reports a signature of the failure ABI: its last result is
+// the universe's error, after at most one value.
+func ergoFallible(sig *types2.Signature) bool {
+	n := sig.Results().Len()
+	return (n == 1 || n == 2) && types2.Identical(sig.Results().At(n-1).Type(), ergoError())
+}
+
+func ergoError() types2.Type { return types2.Universe.Lookup("error").Type() }
+
+// ergoSigOK admits a signature: at most one result, or the failure ABI.
+func ergoSigOK(sig *types2.Signature) bool {
+	return sig.Results().Len() <= 1 || sig.Results().Len() == 2 && ergoFallible(sig)
+}
+
+// nilOf is the zero value of t, spelled as the untyped nil the writer
+// encodes as a typed zero (exprZero).
+func (c *ergoChecker) nilOf(p ergoPos, t types2.Type) syntax.Expr {
+	switch t.Underlying().(type) {
+	case *types2.Struct, *types2.Array:
+		// The reader's zero of a struct or an array (ir.NewZero) is a
+		// composite literal that was never typechecked, which later
+		// passes reject; spell T{} instead.
+		l := &syntax.CompositeLit{}
+		l.SetPos(c.pos(p))
+		tv := syntax.TypeAndValue{Type: t}
+		tv.SetIsValue()
+		l.SetTypeInfo(tv)
+		return l
+	}
+	n := syntax.NewName(c.pos(p), "nil")
+	c.info.Uses[n] = types2.Universe.Lookup("nil")
+	tv := syntax.TypeAndValue{Type: t}
+	tv.SetIsValue()
+	tv.SetIsNil()
+	n.SetTypeInfo(tv)
+	return n
+}
+
+// typeExpr is a type name used as an expression (a case or an assertion).
+func (c *ergoChecker) typeExpr(p ergoPos, s string) (syntax.Expr, types2.Type) {
+	t := c.typ(p, s)
+	if t == nil {
+		return nil, nil
+	}
+	n := syntax.NewName(c.pos(p), s)
+	if obj := c.pkg.Scope().Lookup(s); obj != nil {
+		c.info.Uses[n] = obj
+	} else {
+		c.info.Uses[n] = types2.Universe.Lookup(s)
+	}
+	tv := syntax.TypeAndValue{Type: t}
+	tv.SetIsType()
+	n.SetTypeInfo(tv)
+	return n, t
+}
+
+// ret is a return under the signature: a fallible function's success
+// value gets a nil error; a value of the whole result list (a call's
+// tuple, or a unit function's error) passes as it is.
+func (c *ergoChecker) ret(s *ergoStmt) syntax.Stmt {
+	r := &syntax.ReturnStmt{}
+	r.SetPos(c.pos(s.Pos))
+	res := c.sig.Results()
+	fallible := ergoFallible(c.sig)
+	if s.X == nil {
+		switch {
+		case res.Len() == 0:
+		case fallible && res.Len() == 1:
+			r.Results = c.nilOf(s.Pos, ergoError())
+		default:
+			c.errorf(s.Pos, "ergoir: return without its result")
+		}
+		return r
+	}
+	x, t := c.expr(s.X)
+	if x == nil {
+		return nil
+	}
+	if fallible {
+		switch {
+		case res.Len() == 2 && types2.Identical(t, res):
+			r.Results = x // return f(…): a fallible call's tuple
+		case res.Len() == 1 && types2.Identical(t, ergoError()):
+			r.Results = x // a unit function returns a fallible call's error
+		case res.Len() == 2 && c.assignable(s.Pos, "return", t, res.At(0).Type()):
+			l := &syntax.ListExpr{ElemList: []syntax.Expr{x, c.nilOf(s.Pos, ergoError())}}
+			l.SetPos(c.pos(s.Pos))
+			r.Results = l
+		default:
+			if res.Len() == 1 {
+				c.errorf(s.Pos, "ergoir: return of %v from a function with no value", t)
+			}
+			return nil
+		}
+		return r
+	}
+	if res.Len() != 1 || !c.assignable(s.Pos, "return", t, res.At(0).Type()) {
+		return nil
+	}
+	r.Results = x
+	return r
+}
+
+// failStmt decodes the failure ABI's statements; ok is false for a kind
+// it does not know.
+func (c *ergoChecker) failStmt(s *ergoStmt) (st syntax.Stmt, ok bool) {
+	pos := c.pos(s.Pos)
+	switch s.K {
+	case "fail":
+		if !ergoFallible(c.sig) {
+			c.errorf(s.Pos, "ergoir: fail in a function that cannot fail")
+			return nil, true
+		}
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil, true
+		}
+		if !ergoIsErrorValue(t) {
+			c.errorf(s.Pos, "ergoir: fail: %v is not an error", t)
+			return nil, true
+		}
+		r := &syntax.ReturnStmt{}
+		r.SetPos(pos)
+		if res := c.sig.Results(); res.Len() == 2 {
+			l := &syntax.ListExpr{ElemList: []syntax.Expr{c.nilOf(s.Pos, res.At(0).Type()), x}}
+			l.SetPos(pos)
+			r.Results = l
+		} else {
+			r.Results = x
+		}
+		return r, true
+	case "panic":
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil, true
+		}
+		if !ergoIsErrorValue(t) {
+			c.errorf(s.Pos, "ergoir: panic: %v is not an error", t)
+			return nil, true
+		}
+		any := types2.Universe.Lookup("any").Type()
+		fun := syntax.NewName(pos, "panic")
+		c.info.Uses[fun] = types2.Universe.Lookup("panic")
+		tv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil,
+			types2.NewTuple(types2.NewParam(pos, nil, "", any)), nil, false)}
+		tv.SetIsBuiltin()
+		fun.SetTypeInfo(tv)
+		call := &syntax.CallExpr{Fun: fun, ArgList: []syntax.Expr{x}}
+		call.SetPos(pos)
+		void := syntax.TypeAndValue{}
+		void.SetIsVoid()
+		call.SetTypeInfo(void)
+		es := &syntax.ExprStmt{X: call}
+		es.SetPos(pos)
+		return es, true
+	case "def2":
+		if s.Val == nil {
+			c.errorf(s.Pos, "ergoir: def2 without its error local")
+			return nil, true
+		}
+		v, e := c.local(s.Pos, s.Local), c.local(s.Pos, *s.Val)
+		if s.X == nil || (s.X.K != "call" && s.X.K != "mcall") {
+			c.errorf(s.Pos, "ergoir: def2 of a value that is not a call")
+			return nil, true
+		}
+		x, t := c.expr(s.X)
+		if v == nil || e == nil || x == nil {
+			return nil, true
+		}
+		tup, isTuple := t.(*types2.Tuple)
+		if !isTuple || tup.Len() != 2 || !types2.Identical(tup.At(0).Type(), v.Type()) || !types2.Identical(tup.At(1).Type(), ergoError()) || !types2.Identical(e.Type(), ergoError()) {
+			c.errorf(s.Pos, "ergoir: def2: %v does not bind %v and error", t, v.Type())
+			return nil, true
+		}
+		lhs := &syntax.ListExpr{ElemList: []syntax.Expr{c.name(s.Pos, v, true), c.name(s.Pos, e, true)}}
+		lhs.SetPos(pos)
+		a := &syntax.AssignStmt{Op: syntax.Def, Lhs: lhs, Rhs: x}
+		a.SetPos(pos)
+		return a, true
+	case "tswitch":
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil, true
+		}
+		iface, isIface := types2.CoreType(t).(*types2.Interface)
+		if !isIface {
+			c.errorf(s.Pos, "ergoir: type switch on %v, not an interface", t)
+			return nil, true
+		}
+		guard := &syntax.TypeSwitchGuard{X: x}
+		guard.SetPos(pos)
+		sw := &syntax.SwitchStmt{Tag: guard, Rbrace: c.pos(s.End)}
+		sw.SetPos(pos)
+		seen := map[types2.Type]bool{}
+		for _, k := range s.Cases {
+			if k == nil || len(k.Types) == 0 {
+				c.errorf(s.Pos, "ergoir: a type switch case without a type")
+				return nil, true
+			}
+			cl := &syntax.CaseClause{Body: c.stmts(k.Body)}
+			cl.SetPos(c.pos(k.Pos))
+			var types []syntax.Expr
+			for _, ts := range k.Types {
+				te, tt := c.typeExpr(k.Pos, ts)
+				if te == nil {
+					return nil, true
+				}
+				if types2.IsInterface(tt) || !types2.Implements(tt, iface) || seen[tt] {
+					c.errorf(k.Pos, "ergoir: case %v of a switch on %v", tt, t)
+					return nil, true
+				}
+				seen[tt] = true
+				types = append(types, te)
+			}
+			if len(types) == 1 {
+				cl.Cases = types[0]
+			} else {
+				l := &syntax.ListExpr{ElemList: types}
+				l.SetPos(c.pos(k.Pos))
+				cl.Cases = l
+			}
+			sw.Body = append(sw.Body, cl)
+		}
+		def := &syntax.CaseClause{Body: c.stmts(s.Else)}
+		def.SetPos(c.pos(s.ElsePos))
+		sw.Body = append(sw.Body, def)
+		return sw, true
+	}
+	return nil, false
+}
+
+// failExpr decodes the failure ABI's expressions; ok is false for a kind
+// it does not know.
+func (c *ergoChecker) failExpr(x *ergoExpr) (e syntax.Expr, t types2.Type, ok bool) {
+	pos := c.pos(x.Pos)
+	switch x.K {
+	case "nil":
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil, true
+		}
+		if !types2.IsInterface(t) {
+			c.errorf(x.Pos, "ergoir: nil of %v", t)
+			return nil, nil, true
+		}
+		return c.nilOf(x.Pos, t), t, true
+	case "zero":
+		// The zero value of any type: a catch's result before its arms.
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil, true
+		}
+		return c.nilOf(x.Pos, t), t, true
+	case "assert":
+		v, vt := c.expr(x.X)
+		if v == nil {
+			return nil, nil, true
+		}
+		te, tt := c.typeExpr(x.Pos, x.T)
+		if te == nil {
+			return nil, nil, true
+		}
+		iface, isIface := types2.CoreType(vt).(*types2.Interface)
+		if !isIface || types2.IsInterface(tt) || !types2.Implements(tt, iface) {
+			c.errorf(x.Pos, "ergoir: assertion of %v to %v", vt, tt)
+			return nil, nil, true
+		}
+		a := &syntax.AssertExpr{X: v, Type: te}
+		a.SetPos(pos)
+		ergoValue(a, tt, nil)
+		return a, tt, true
+	}
+	return nil, nil, false
+}
+
+// ergoIsErrorValue reports a type that implements error.
+func ergoIsErrorValue(t types2.Type) bool {
+	if _, isTuple := t.(*types2.Tuple); isTuple || t == nil {
+		return false
+	}
+	return types2.Implements(t, ergoError().Underlying().(*types2.Interface))
+}
diff --git a/src/cmd/compile/internal/noder/ergoir_stmt.go b/src/cmd/compile/internal/noder/ergoir_stmt.go
new file mode 100644
index 0000000..284c893
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergoir_stmt.go
@@ -0,0 +1,153 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: statements and blocks. See ergoir.go.
+
+package noder
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoTerminates is the Go spec's terminating statement for the IR's
+// statement forms: a return, or an if whose both branches terminate.
+func ergoTerminates(s syntax.Stmt) bool {
+	switch s := s.(type) {
+	case *syntax.ReturnStmt:
+		return true
+	case *syntax.BlockStmt:
+		last := lastNonEmptyStmt(s.List)
+		return last != nil && ergoTerminates(last)
+	case *syntax.IfStmt:
+		return s.Else != nil && ergoTerminates(s.Then) && ergoTerminates(s.Else)
+	}
+	return false
+}
+
+func (c *ergoChecker) stmts(list []*ergoStmt) []syntax.Stmt {
+	var out []syntax.Stmt
+	for _, s := range list {
+		if st := c.stmt(s); st != nil {
+			out = append(out, st)
+		}
+	}
+	return out
+}
+
+func (c *ergoChecker) block(p, end ergoPos, list []*ergoStmt) *syntax.BlockStmt {
+	b := &syntax.BlockStmt{List: c.stmts(list), Rbrace: c.pos(end)}
+	b.SetPos(c.pos(p))
+	return b
+}
+
+func (c *ergoChecker) stmt(s *ergoStmt) syntax.Stmt {
+	if s == nil {
+		c.errorf(ergoPos{-1}, "ergoir: missing statement")
+		return nil
+	}
+	pos := c.pos(s.Pos)
+	switch s.K {
+	case "def", "set":
+		v := c.local(s.Pos, s.Local)
+		x, t := c.expr(s.X)
+		if v == nil || x == nil || !c.assignable(s.Pos, s.K, t, v.Type()) {
+			return nil
+		}
+		a := &syntax.AssignStmt{Lhs: c.name(s.Pos, v, s.K == "def"), Rhs: x}
+		if s.K == "def" {
+			a.Op = syntax.Def
+		}
+		a.SetPos(pos)
+		return a
+	case "ret":
+		return c.ret(s) // under the failure ABI (ergoir_fail.go)
+	case "if":
+		cond := c.cond(s.X)
+		if cond == nil {
+			return nil
+		}
+		// Scope positions must increase (DWARF scopes): the then block is
+		// Pos..End, the else block ElsePos..ElseEnd, after it.
+		st := &syntax.IfStmt{Cond: cond, Then: c.block(s.Pos, s.End, s.Then)}
+		st.SetPos(pos)
+		if s.Else != nil {
+			st.Else = c.block(s.ElsePos, s.ElseEnd, s.Else)
+		}
+		return st
+	case "while":
+		cond := c.cond(s.X)
+		if cond == nil {
+			return nil
+		}
+		st := &syntax.ForStmt{Cond: cond, Body: c.block(s.Pos, s.End, s.Body)}
+		st.SetPos(pos)
+		return st
+	case "range":
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil
+		}
+		sl, ok := types2.CoreType(t).(*types2.Slice)
+		if !ok {
+			c.errorf(s.Pos, "ergoir: range over %v, not a slice", t)
+			return nil
+		}
+		lhs := &syntax.ListExpr{}
+		lhs.SetPos(pos)
+		for i, want := range []types2.Type{types2.Typ[types2.Int], sl.Elem()} {
+			idx := s.Key
+			if i == 1 {
+				idx = s.Val
+			}
+			if idx == nil {
+				lhs.ElemList = append(lhs.ElemList, syntax.NewName(pos, "_"))
+				continue
+			}
+			v := c.local(s.Pos, *idx)
+			if v == nil || !c.assignable(s.Pos, "range", want, v.Type()) {
+				return nil
+			}
+			lhs.ElemList = append(lhs.ElemList, c.name(s.Pos, v, true))
+		}
+		rc := &syntax.RangeClause{Lhs: lhs, Def: true, X: x}
+		rc.SetPos(pos)
+		st := &syntax.ForStmt{Init: rc, Body: c.block(s.Pos, s.End, s.Body)}
+		st.SetPos(pos)
+		return st
+	case "expr":
+		if s.X == nil || (s.X.K != "call" && s.X.K != "mcall") {
+			c.errorf(s.Pos, "ergoir: an expression statement is a call")
+			return nil
+		}
+		x, t := c.expr(s.X)
+		if x == nil {
+			return nil
+		}
+		if _, isTuple := t.(*types2.Tuple); isTuple {
+			c.errorf(s.Pos, "ergoir: a fallible call's error is dropped")
+			return nil
+		}
+		st := &syntax.ExprStmt{X: x}
+		st.SetPos(pos)
+		return st
+	}
+	if st, ok := c.failStmt(s); ok { // ergoir_fail.go
+		return st
+	}
+	c.errorf(s.Pos, "ergoir: unknown statement %q", s.K)
+	return nil
+}
+
+func (c *ergoChecker) cond(x *ergoExpr) syntax.Expr {
+	e, t := c.expr(x)
+	if e == nil {
+		return nil
+	}
+	if !ergoIsBool(t) {
+		c.errorf(x.Pos, "ergoir: condition of type %v", t)
+		return nil
+	}
+	return e
+}
diff --git a/src/cmd/compile/internal/noder/ergoir_text.go b/src/cmd/compile/internal/noder/ergoir_text.go
new file mode 100644
index 0000000..28af996
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergoir_text.go
@@ -0,0 +1,513 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: the Go text of the IR bodies. See ergoir.go.
+//
+// With -ergoirtext=DIR, every Go file of the package that holds an IR body
+// is written to DIR (same base name) with each IR body printed as Go text
+// after its declaration: the typed syntax trees ergoAttach built, which the
+// unified writer then encodes, so the text is a view of what was compiled,
+// never an input. Each expression is printed from its type record: a
+// constant with its type, a zero value of its type, a composite literal
+// of its type. ergoir_text_shape.go writes the structure of the same trees
+// (-ergoirshape), which a build of the printed text must reproduce.
+
+package noder
+
+import (
+	"fmt"
+	"go/constant"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoBodiless is every function declared without a body.
+func ergoBodiless(noders []*noder) map[*syntax.FuncDecl]bool {
+	out := map[*syntax.FuncDecl]bool{}
+	for _, p := range noders {
+		for _, d := range p.file.DeclList {
+			if fd, ok := d.(*syntax.FuncDecl); ok && fd.Body == nil {
+				out[fd] = true
+			}
+		}
+	}
+	return out
+}
+
+// ergoTextOut writes the text (-ergoirtext) and the structure
+// (-ergoirshape) of the bodies ergoAttach gave the functions of bodiless.
+func ergoTextOut(pkg *types2.Package, info *types2.Info, noders []*noder, bodiless map[*syntax.FuncDecl]bool) {
+	attached := map[*syntax.FuncDecl]bool{}
+	for fd := range bodiless {
+		if fd.Body != nil {
+			attached[fd] = true
+		}
+	}
+	if base.Flag.ErgoIRShape != "" {
+		ergoShapeOut(info, noders, attached)
+	}
+	if base.Flag.ErgoIRText == "" {
+		return
+	}
+	if err := os.MkdirAll(base.Flag.ErgoIRText, 0o755); err != nil {
+		base.Fatalf("ergoir: %v", err)
+	}
+	for _, p := range noders {
+		var decls []*syntax.FuncDecl
+		for _, d := range p.file.DeclList {
+			if fd, ok := d.(*syntax.FuncDecl); ok && attached[fd] {
+				decls = append(decls, fd)
+			}
+		}
+		if len(decls) == 0 {
+			continue
+		}
+		name := p.file.Pos().FileBase().Filename()
+		src, err := os.ReadFile(name)
+		if err != nil {
+			base.Fatalf("ergoir: %v", err)
+		}
+		text, err := ergoFileText(pkg, info, p.file, string(src), decls)
+		if err != nil {
+			base.Fatalf("ergoir: %s: %v", name, err)
+		}
+		if err := os.WriteFile(filepath.Join(base.Flag.ErgoIRText, filepath.Base(name)), []byte(text), 0o644); err != nil {
+			base.Fatalf("ergoir: %v", err)
+		}
+	}
+}
+
+// ergoFileText is src with each of decls' bodies printed after its
+// signature, which ends its line.
+func ergoFileText(pkg *types2.Package, info *types2.Info, file *syntax.File, src string, decls []*syntax.FuncDecl) (string, error) {
+	p := &ergoPrinter{pkg: pkg, info: info, imports: map[string]string{}}
+	for _, d := range file.DeclList {
+		if id, ok := d.(*syntax.ImportDecl); ok && id.LocalPkgName != nil && id.Path != nil {
+			if path, err := strconv.Unquote(id.Path.Value); err == nil {
+				p.imports[path] = id.LocalPkgName.Value
+			}
+		}
+	}
+	lines := strings.Split(src, "\n")
+	bodies := map[int]string{} // line index -> the body to append
+	for _, fd := range decls {
+		end := syntax.EndPos(fd.Type)
+		if end.FileBase() != file.Pos().FileBase() || end.Line() == 0 || int(end.Line()) > len(lines) {
+			return "", fmt.Errorf("%s: the signature's end %v is not in the file", fd.Name.Value, end)
+		}
+		p.b.Reset()
+		p.function(fd)
+		p.block(fd.Body.List, 1)
+		// The lines after the body keep their positions.
+		p.b.WriteString(fmt.Sprintf("}\n//line %s:%d", end.RelFilename(), end.RelLine()+1))
+		bodies[int(end.Line())-1] = p.b.String()
+	}
+	var out strings.Builder
+	for i, l := range lines {
+		body, ok := bodies[i]
+		if !ok {
+			out.WriteString(l)
+		} else {
+			comment := ""
+			if j := strings.Index(l, "//"); j >= 0 {
+				l, comment = strings.TrimRight(l[:j], " \t"), " "+l[j:]
+			}
+			out.WriteString(l + " {" + comment + "\n" + body)
+		}
+		if i < len(lines)-1 {
+			out.WriteByte('\n')
+		}
+	}
+	return out.String(), nil
+}
+
+// ergoPrinter prints typed syntax as Go text.
+type ergoPrinter struct {
+	pkg     *types2.Package
+	info    *types2.Info
+	imports map[string]string // package path -> its local name in the file
+	b       strings.Builder
+	at      string // the position directive of the next line
+	// names are the printed names of the function's parameters and
+	// locals; taken are the names in use, those and every name of another
+	// object the body refers to.
+	names map[types2.Object]string
+	taken map[string]bool
+}
+
+// function starts fd: each IR local is its own variable, so it gets a
+// name of its own in the text, which no other local and no other object
+// the body names has; a Go := of a name in scope would reuse a variable.
+func (p *ergoPrinter) function(fd *syntax.FuncDecl) {
+	p.names, p.taken = map[types2.Object]string{}, map[string]bool{}
+	sig := p.info.Defs[fd.Name].Type().(*types2.Signature)
+	vars := []*types2.Var{sig.Recv()}
+	for i := 0; i < sig.Params().Len(); i++ {
+		vars = append(vars, sig.Params().At(i))
+	}
+	for i := 0; i < sig.Results().Len(); i++ {
+		vars = append(vars, sig.Results().At(i))
+	}
+	for _, v := range vars {
+		if v != nil && v.Name() != "" && v.Name() != "_" {
+			p.names[v], p.taken[v.Name()] = v.Name(), true
+		}
+	}
+	syntax.Inspect(fd.Body, func(n syntax.Node) bool {
+		if name, ok := n.(*syntax.Name); ok {
+			if obj := p.info.Uses[name]; obj != nil && !p.isLocal(obj) {
+				p.taken[name.Value] = true
+			}
+		}
+		return true
+	})
+}
+
+// isLocal reports a variable of the function: not a field and not of the
+// package scope.
+func (p *ergoPrinter) isLocal(obj types2.Object) bool {
+	v, ok := obj.(*types2.Var)
+	return ok && !v.IsField() && (v.Pkg() == nil || v.Pkg().Scope().Lookup(v.Name()) != obj)
+}
+
+// name is n as printed: a local by its own name.
+func (p *ergoPrinter) name(n *syntax.Name) string {
+	obj := p.info.Defs[n]
+	if obj == nil {
+		obj = p.info.Uses[n]
+	}
+	if obj == nil || n.Value == "_" || !p.isLocal(obj) {
+		return n.Value
+	}
+	if s, ok := p.names[obj]; ok {
+		return s
+	}
+	s := n.Value
+	for i := 1; p.taken[s]; i++ {
+		s = fmt.Sprintf("%s_%d", n.Value, i)
+	}
+	p.names[obj], p.taken[s] = s, true
+	return s
+}
+
+func (p *ergoPrinter) line(depth int, s string) {
+	p.b.WriteString(strings.Repeat("\t", depth))
+	p.b.WriteString(p.at)
+	p.at = ""
+	p.b.WriteString(s)
+	p.b.WriteByte('\n')
+}
+
+func (p *ergoPrinter) block(list []syntax.Stmt, depth int) {
+	for _, s := range list {
+		p.stmt(s, depth)
+	}
+}
+
+func (p *ergoPrinter) stmt(s syntax.Stmt, depth int) {
+	// The statement's line starts at its .ergo position.
+	if pos := s.Pos(); pos.IsKnown() {
+		p.at = fmt.Sprintf("/*line %s:%d:%d*/", pos.RelFilename(), pos.RelLine(), pos.RelCol())
+	}
+	switch s := s.(type) {
+	case *syntax.EmptyStmt:
+	case *syntax.BlockStmt:
+		p.line(depth, "{")
+		p.block(s.List, depth+1)
+		p.line(depth, "}")
+	case *syntax.IfStmt:
+		p.ifStmt(s, depth, "")
+	case *syntax.ForStmt:
+		head := "for "
+		switch {
+		case s.Init == nil && s.Cond == nil && s.Post == nil:
+		case s.Init != nil && s.Cond == nil && s.Post == nil:
+			if rc, ok := s.Init.(*syntax.RangeClause); ok {
+				head += p.rangeClause(rc) + " "
+				break
+			}
+			head += p.simple(s.Init) + "; ; "
+		case s.Init == nil && s.Post == nil:
+			head += p.header(s.Cond) + " "
+		default:
+			head += p.simple(s.Init) + "; " + p.header(s.Cond) + "; " + p.simple(s.Post) + " "
+		}
+		p.line(depth, head+"{")
+		p.block(s.Body.List, depth+1)
+		p.line(depth, "}")
+	case *syntax.SwitchStmt:
+		head := "switch "
+		if s.Init != nil {
+			head += p.simple(s.Init) + "; "
+		}
+		if s.Tag != nil {
+			head += p.header(s.Tag) + " "
+		}
+		p.line(depth, head+"{")
+		for _, c := range s.Body {
+			if c.Cases == nil {
+				p.line(depth, "default:")
+			} else {
+				p.line(depth, "case "+p.expr(c.Cases)+":")
+			}
+			p.block(c.Body, depth+1)
+		}
+		p.line(depth, "}")
+	case *syntax.ReturnStmt:
+		if s.Results == nil {
+			p.line(depth, "return")
+		} else {
+			p.line(depth, "return "+p.expr(s.Results))
+		}
+	case *syntax.BranchStmt:
+		t := s.Tok.String()
+		if s.Label != nil {
+			t += " " + s.Label.Value
+		}
+		p.line(depth, t)
+	case *syntax.ExprStmt, *syntax.AssignStmt:
+		p.line(depth, p.simple(s.(syntax.SimpleStmt)))
+	default:
+		p.line(depth, fmt.Sprintf("ergoirNoText() /* %T */", s))
+	}
+}
+
+func (p *ergoPrinter) ifStmt(s *syntax.IfStmt, depth int, prefix string) {
+	head := "if "
+	if s.Init != nil {
+		head += p.simple(s.Init) + "; "
+	}
+	p.line(depth, prefix+head+p.header(s.Cond)+" {")
+	p.block(s.Then.List, depth+1)
+	switch e := s.Else.(type) {
+	case nil:
+		p.line(depth, "}")
+	case *syntax.IfStmt:
+		p.ifStmt(e, depth, "} else ")
+	case *syntax.BlockStmt:
+		p.line(depth, "} else {")
+		p.block(e.List, depth+1)
+		p.line(depth, "}")
+	default:
+		p.line(depth, fmt.Sprintf("} else { ergoirNoText() /* %T */ }", e))
+	}
+}
+
+// simple is a statement that fits a header: an assignment or an
+// expression.
+func (p *ergoPrinter) simple(s syntax.SimpleStmt) string {
+	switch s := s.(type) {
+	case *syntax.ExprStmt:
+		return p.expr(s.X)
+	case *syntax.AssignStmt:
+		lhs := p.expr(s.Lhs)
+		switch {
+		case s.Rhs == nil:
+			return lhs + s.Op.String() + s.Op.String()
+		case s.Op == syntax.Def:
+			return lhs + " := " + p.expr(s.Rhs)
+		case s.Op == 0:
+			return lhs + " = " + p.expr(s.Rhs)
+		}
+		return lhs + " " + s.Op.String() + "= " + p.expr(s.Rhs)
+	}
+	return fmt.Sprintf("ergoirNoText() /* %T */", s)
+}
+
+func (p *ergoPrinter) rangeClause(rc *syntax.RangeClause) string {
+	x := p.header(rc.X)
+	if rc.Lhs == nil || ergoAllBlank(rc.Lhs) {
+		return "range " + x
+	}
+	op := " = "
+	if rc.Def {
+		op = " := "
+	}
+	return p.expr(rc.Lhs) + op + "range " + x
+}
+
+// ergoAllBlank reports a left-hand side of blank names only.
+func ergoAllBlank(x syntax.Expr) bool {
+	l, ok := x.(*syntax.ListExpr)
+	if !ok {
+		n, ok := x.(*syntax.Name)
+		return ok && n.Value == "_"
+	}
+	for _, e := range l.ElemList {
+		if !ergoAllBlank(e) {
+			return false
+		}
+	}
+	return true
+}
+
+// header is an expression in a statement header, where a composite
+// literal needs parentheses.
+func (p *ergoPrinter) header(x syntax.Expr) string {
+	s := p.expr(x)
+	if strings.Contains(s, "{") {
+		return "(" + s + ")"
+	}
+	return s
+}
+
+func (p *ergoPrinter) expr(x syntax.Expr) string {
+	tv := x.GetTypeInfo()
+	if tv.Value != nil && !tv.IsType() {
+		return p.constant(tv.Type, tv.Value)
+	}
+	switch x := x.(type) {
+	case *syntax.Name:
+		switch {
+		case tv.IsNil():
+			return p.zero(tv.Type)
+		case tv.IsType() && tv.Type != nil:
+			return p.typ(tv.Type)
+		}
+		return p.name(x)
+	case *syntax.ParenExpr:
+		return "(" + p.expr(x.X) + ")"
+	case *syntax.Operation:
+		if x.Y == nil {
+			return "(" + x.Op.String() + p.expr(x.X) + ")"
+		}
+		return "(" + p.expr(x.X) + " " + x.Op.String() + " " + p.expr(x.Y) + ")"
+	case *syntax.CallExpr:
+		args := make([]string, len(x.ArgList))
+		for i, a := range x.ArgList {
+			args[i] = p.expr(a)
+		}
+		dots := ""
+		if x.HasDots {
+			dots = "..."
+		}
+		return p.expr(x.Fun) + "(" + strings.Join(args, ", ") + dots + ")"
+	case *syntax.SelectorExpr:
+		return p.expr(x.X) + "." + x.Sel.Value
+	case *syntax.IndexExpr:
+		return p.expr(x.X) + "[" + p.expr(x.Index) + "]"
+	case *syntax.SliceExpr:
+		s := p.expr(x.X) + "["
+		for i, e := range x.Index {
+			if i > 0 {
+				s += ":"
+			}
+			if e != nil {
+				s += p.expr(e)
+			}
+		}
+		return s + "]"
+	case *syntax.AssertExpr:
+		return p.expr(x.X) + ".(" + p.expr(x.Type) + ")"
+	case *syntax.TypeSwitchGuard:
+		s := p.expr(x.X) + ".(type)"
+		if x.Lhs != nil {
+			s = p.name(x.Lhs) + " := " + s
+		}
+		return s
+	case *syntax.CompositeLit:
+		if tv.Type == nil {
+			break
+		}
+		elems := make([]string, len(x.ElemList))
+		for i, e := range x.ElemList {
+			elems[i] = p.expr(e)
+		}
+		return p.typeOperand(tv.Type) + "{" + strings.Join(elems, ", ") + "}"
+	case *syntax.KeyValueExpr:
+		return p.expr(x.Key) + ": " + p.expr(x.Value)
+	case *syntax.ListExpr:
+		elems := make([]string, len(x.ElemList))
+		for i, e := range x.ElemList {
+			elems[i] = p.expr(e)
+		}
+		return strings.Join(elems, ", ")
+	}
+	return fmt.Sprintf("ergoirNoText() /* %T */", x)
+}
+
+func (p *ergoPrinter) qualifier(pkg *types2.Package) string {
+	if pkg == p.pkg {
+		return ""
+	}
+	if n, ok := p.imports[pkg.Path()]; ok {
+		return n
+	}
+	return pkg.Name()
+}
+
+func (p *ergoPrinter) typ(t types2.Type) string {
+	return types2.TypeString(t, p.qualifier)
+}
+
+// typeOperand is t spelled to be called or followed by a literal: a
+// (qualified) name as it is, any other type in parentheses.
+func (p *ergoPrinter) typeOperand(t types2.Type) string {
+	s := p.typ(t)
+	if _, named := types2.Unalias(t).(*types2.Named); named {
+		return s
+	}
+	if _, basic := t.(*types2.Basic); basic {
+		return s
+	}
+	if strings.HasPrefix(s, "[]") && !strings.Contains(s, "func") && !strings.Contains(s, "chan") {
+		return s
+	}
+	return "(" + s + ")"
+}
+
+// constant is v as a constant of type t: a bare literal when t is the
+// literal's default type, else a conversion.
+func (p *ergoPrinter) constant(t types2.Type, v constant.Value) string {
+	var lit string
+	def := types2.Typ[types2.Invalid]
+	switch v.Kind() {
+	case constant.Bool:
+		lit, def = v.ExactString(), types2.Typ[types2.Bool]
+	case constant.String:
+		lit, def = strconv.Quote(constant.StringVal(v)), types2.Typ[types2.String]
+	case constant.Int:
+		lit, def = v.ExactString(), types2.Typ[types2.Int]
+	case constant.Float:
+		f, _ := constant.Float64Val(v)
+		lit, def = strconv.FormatFloat(f, 'g', -1, 64), types2.Typ[types2.Float64]
+		if !strings.ContainsAny(lit, ".eEn") {
+			lit += ".0"
+		}
+	default:
+		lit = v.ExactString()
+	}
+	if b, ok := t.(*types2.Basic); t == nil || ok && (b == def || b.Info()&types2.IsUntyped != 0) {
+		if strings.HasPrefix(lit, "-") {
+			return "(" + lit + ")"
+		}
+		return lit
+	}
+	return p.typeOperand(t) + "(" + lit + ")"
+}
+
+// zero is the zero value of t, which the IR spells as a nil the writer
+// encodes as t's zero.
+func (p *ergoPrinter) zero(t types2.Type) string {
+	switch u := t.Underlying().(type) {
+	case *types2.Basic:
+		switch {
+		case u.Info()&types2.IsBoolean != 0:
+			return p.constant(t, constant.MakeBool(false))
+		case u.Info()&types2.IsString != 0:
+			return p.constant(t, constant.MakeString(""))
+		case u.Info()&types2.IsNumeric != 0:
+			return p.constant(t, constant.MakeInt64(0))
+		}
+	case *types2.Struct, *types2.Array:
+		return p.typeOperand(t) + "{}"
+	}
+	return p.typeOperand(t) + "(nil)"
+}
diff --git a/src/cmd/compile/internal/noder/ergoir_text_shape.go b/src/cmd/compile/internal/noder/ergoir_text_shape.go
new file mode 100644
index 0000000..1010bb7
--- /dev/null
+++ b/src/cmd/compile/internal/noder/ergoir_text_shape.go
@@ -0,0 +1,339 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: the structure of function bodies. See ergoir_text.go.
+//
+// With -ergoirshape=FILE, the compiler writes one block per function body
+// of the package (with -ergoir: per IR body) to FILE: every statement and
+// expression in order, each with what the writer encodes of it (its kind,
+// operator, the object a name denotes, a constant's value, the recorded
+// type), and nothing it does not (positions, parentheses, spelling). A
+// build of the -ergoirtext output must write the same blocks for the IR
+// functions as the IR build did: the printed text then compiles to what
+// was compiled. This walk shares no code with the printer.
+
+package noder
+
+import (
+	"fmt"
+	"go/constant"
+	"os"
+	"strings"
+
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoShapeOut writes the shape of every function body of the package,
+// or of only's functions when only is not nil.
+func ergoShapeOut(info *types2.Info, noders []*noder, only map[*syntax.FuncDecl]bool) {
+	var b strings.Builder
+	for _, p := range noders {
+		for _, d := range p.file.DeclList {
+			fd, ok := d.(*syntax.FuncDecl)
+			if !ok || fd.Body == nil || only != nil && !only[fd] {
+				continue
+			}
+			obj, ok := info.Defs[fd.Name].(*types2.Func)
+			if !ok {
+				continue
+			}
+			s := &ergoShaper{info: info, ids: map[types2.Object]string{}, b: &b}
+			sig := obj.Type().(*types2.Signature)
+			if r := sig.Recv(); r != nil {
+				s.ids[r] = "recv"
+			}
+			for i := 0; i < sig.Params().Len(); i++ {
+				s.ids[sig.Params().At(i)] = fmt.Sprintf("p%d", i)
+			}
+			for i := 0; i < sig.Results().Len(); i++ {
+				s.ids[sig.Results().At(i)] = fmt.Sprintf("r%d", i)
+			}
+			fmt.Fprintf(&b, "func %s\n", ergoKey(obj))
+			s.stmts(fd.Body.List, 1)
+			b.WriteString("end\n")
+		}
+	}
+	if err := os.WriteFile(base.Flag.ErgoIRShape, []byte(b.String()), 0o644); err != nil {
+		base.Fatalf("ergoir: %v", err)
+	}
+}
+
+type ergoShaper struct {
+	info   *types2.Info
+	ids    map[types2.Object]string
+	locals int
+	b      *strings.Builder
+}
+
+func (s *ergoShaper) out(depth int, format string, args ...any) {
+	s.b.WriteString(strings.Repeat(" ", depth))
+	fmt.Fprintf(s.b, format, args...)
+	s.b.WriteByte('\n')
+}
+
+func ergoShapeType(t types2.Type) string {
+	if t == nil {
+		return "void"
+	}
+	if tup, ok := t.(*types2.Tuple); ok && tup.Len() == 0 {
+		return "void"
+	}
+	// The IR records a comparison as bool where types2 records untyped
+	// bool; the writer encodes both as bool.
+	return types2.TypeString(types2.Default(t), nil)
+}
+
+// object is what a name denotes: a parameter, a local (numbered in order
+// of definition), a package-level or a universe object.
+func (s *ergoShaper) object(n *syntax.Name) string {
+	if n.Value == "_" {
+		return "_"
+	}
+	obj, def := s.info.Defs[n], true
+	if obj == nil {
+		obj, def = s.info.Uses[n], false
+	}
+	if obj == nil {
+		return "unresolved " + n.Value
+	}
+	if id, ok := s.ids[obj]; ok {
+		return id
+	}
+	switch {
+	case obj.Parent() == types2.Universe:
+		return "universe." + obj.Name()
+	case obj.Pkg() != nil && obj.Pkg().Scope().Lookup(obj.Name()) == obj:
+		return "package." + obj.Name()
+	case def:
+		id := fmt.Sprintf("local%d", s.locals)
+		s.locals++
+		s.ids[obj] = id
+		return id
+	}
+	return "out of scope " + n.Value
+}
+
+func (s *ergoShaper) stmts(list []syntax.Stmt, depth int) {
+	for _, st := range list {
+		s.stmt(st, depth)
+	}
+}
+
+func (s *ergoShaper) stmt(st syntax.Stmt, depth int) {
+	switch st := st.(type) {
+	case nil:
+		s.out(depth, "none")
+	case *syntax.EmptyStmt:
+	case *syntax.BlockStmt:
+		s.out(depth, "block")
+		s.stmts(st.List, depth+1)
+	case *syntax.ExprStmt:
+		s.out(depth, "expr")
+		s.expr(st.X, depth+1)
+	case *syntax.AssignStmt:
+		s.out(depth, "assign op %d", st.Op)
+		s.lhs(st.Lhs, depth+1)
+		if st.Rhs != nil {
+			s.expr(st.Rhs, depth+1)
+		}
+	case *syntax.ReturnStmt:
+		s.out(depth, "return")
+		if st.Results != nil {
+			s.expr(st.Results, depth+1)
+		}
+	case *syntax.IfStmt:
+		s.out(depth, "if")
+		if st.Init != nil {
+			s.stmt(st.Init, depth+1)
+		}
+		s.expr(st.Cond, depth+1)
+		s.stmt(st.Then, depth+1)
+		if st.Else != nil {
+			s.out(depth, "else")
+			s.stmt(st.Else, depth+1)
+		}
+	case *syntax.ForStmt:
+		s.out(depth, "for")
+		if rc, ok := st.Init.(*syntax.RangeClause); ok {
+			s.out(depth+1, "range def %t", rc.Def)
+			if rc.Lhs != nil && !ergoAllBlank(rc.Lhs) {
+				s.lhs(rc.Lhs, depth+2)
+			}
+			s.expr(rc.X, depth+2)
+		} else if st.Init != nil {
+			s.stmt(st.Init, depth+1)
+		}
+		if st.Cond != nil {
+			s.out(depth+1, "cond")
+			s.expr(st.Cond, depth+2)
+		}
+		if st.Post != nil {
+			s.out(depth+1, "post")
+			s.stmt(st.Post, depth+2)
+		}
+		s.stmt(st.Body, depth+1)
+	case *syntax.SwitchStmt:
+		s.out(depth, "switch")
+		if st.Init != nil {
+			s.stmt(st.Init, depth+1)
+		}
+		if st.Tag != nil {
+			s.expr(st.Tag, depth+1)
+		}
+		for _, c := range st.Body {
+			if c.Cases == nil {
+				s.out(depth+1, "default")
+			} else {
+				s.out(depth+1, "case")
+				s.expr(c.Cases, depth+2)
+			}
+			s.out(depth+1, "body")
+			s.stmts(c.Body, depth+2)
+		}
+	case *syntax.BranchStmt:
+		s.out(depth, "branch %v", st.Tok)
+	default:
+		s.out(depth, "statement %T", st)
+	}
+}
+
+// lhs is the left-hand side of an assignment or a range: names defined or
+// assigned, or other expressions.
+func (s *ergoShaper) lhs(x syntax.Expr, depth int) {
+	switch x := x.(type) {
+	case *syntax.ListExpr:
+		for _, e := range x.ElemList {
+			s.lhs(e, depth)
+		}
+	case *syntax.Name:
+		s.out(depth, "name %s", s.object(x))
+	default:
+		s.expr(x, depth)
+	}
+}
+
+func (s *ergoShaper) expr(x syntax.Expr, depth int) {
+	if p, ok := x.(*syntax.ParenExpr); ok {
+		s.expr(p.X, depth)
+		return
+	}
+	tv := x.GetTypeInfo()
+	switch {
+	case tv.IsType():
+		s.out(depth, "type %s", ergoShapeType(tv.Type))
+		return
+	case tv.Value != nil:
+		s.out(depth, "constant %s %s", ergoShapeType(tv.Type), tv.Value.ExactString())
+		return
+	case tv.IsNil():
+		s.zero(tv.Type, depth)
+		return
+	case tv.IsBuiltin():
+		s.out(depth, "builtin %s", syntax.String(x))
+		return
+	}
+	if call, ok := x.(*syntax.CallExpr); ok && len(call.ArgList) == 1 && call.Fun.GetTypeInfo().IsType() && call.ArgList[0].GetTypeInfo().IsNil() {
+		s.zero(tv.Type, depth) // T(nil)
+		return
+	}
+	typ := ergoShapeType(tv.Type)
+	switch x := x.(type) {
+	case *syntax.Name:
+		s.out(depth, "name %s %s", s.object(x), typ)
+	case *syntax.Operation:
+		s.out(depth, "operation %v %s", x.Op, typ)
+		s.expr(x.X, depth+1)
+		if x.Y != nil {
+			s.expr(x.Y, depth+1)
+		}
+	case *syntax.CallExpr:
+		s.out(depth, "call dots %t %s", x.HasDots, typ)
+		s.expr(x.Fun, depth+1)
+		for _, a := range x.ArgList {
+			s.expr(a, depth+1)
+		}
+	case *syntax.SelectorExpr:
+		s.out(depth, "selector %s %s", x.Sel.Value, typ)
+		s.expr(x.X, depth+1)
+	case *syntax.IndexExpr:
+		s.out(depth, "index %s", typ)
+		s.expr(x.X, depth+1)
+		s.expr(x.Index, depth+1)
+	case *syntax.SliceExpr:
+		s.out(depth, "slice %s", typ)
+		s.expr(x.X, depth+1)
+		for _, e := range x.Index {
+			if e == nil {
+				s.out(depth+1, "none")
+			} else {
+				s.expr(e, depth+1)
+			}
+		}
+	case *syntax.AssertExpr:
+		s.out(depth, "assert %s", typ)
+		s.expr(x.X, depth+1)
+		s.expr(x.Type, depth+1)
+	case *syntax.TypeSwitchGuard:
+		lhs := ""
+		if x.Lhs != nil {
+			lhs = s.object(x.Lhs)
+		}
+		s.out(depth, "type switch %s", lhs)
+		s.expr(x.X, depth+1)
+	case *syntax.CompositeLit:
+		s.out(depth, "composite %d %s", len(x.ElemList), typ)
+		for _, e := range x.ElemList {
+			s.expr(e, depth+1)
+		}
+	case *syntax.KeyValueExpr:
+		key := "?"
+		if n, ok := x.Key.(*syntax.Name); ok {
+			key = n.Value
+		}
+		s.out(depth, "key %s", key)
+		s.expr(x.Value, depth+1)
+	case *syntax.ListExpr:
+		s.out(depth, "list %d", len(x.ElemList))
+		for _, e := range x.ElemList {
+			s.expr(e, depth+1)
+		}
+	default:
+		s.out(depth, "expression %T %s", x, typ)
+	}
+}
+
+// zero is t's zero value, which the IR spells as a typed nil and Go text
+// as a constant, T{} or T(nil).
+func (s *ergoShaper) zero(t types2.Type, depth int) {
+	if t == nil {
+		s.out(depth, "zero void")
+		return
+	}
+	if u, ok := t.Underlying().(*types2.Basic); ok {
+		var v constant.Value
+		switch {
+		case u.Info()&types2.IsBoolean != 0:
+			v = constant.MakeBool(false)
+		case u.Info()&types2.IsString != 0:
+			v = constant.MakeString("")
+		case u.Info()&types2.IsNumeric != 0:
+			v = constant.MakeInt64(0)
+		}
+		if v != nil {
+			s.out(depth, "constant %s %s", ergoShapeType(t), v.ExactString())
+			return
+		}
+	}
+	if _, ok := t.Underlying().(*types2.Struct); ok {
+		s.out(depth, "composite 0 %s", ergoShapeType(t))
+		return
+	}
+	if _, ok := t.Underlying().(*types2.Array); ok {
+		s.out(depth, "composite 0 %s", ergoShapeType(t))
+		return
+	}
+	s.out(depth, "zero %s", ergoShapeType(t))
+}
