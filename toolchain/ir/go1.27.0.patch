diff --git a/src/cmd/compile/internal/ergoir/ergoir.go b/src/cmd/compile/internal/ergoir/ergoir.go
new file mode 100644
index 0000000..6f08056
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir.go
@@ -0,0 +1,319 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Experimental (Ergo IR1 spike): typed function bodies from Ergo IR.
+//
+// With -ergoir=FILE, every function FILE names must be declared in the Go
+// source without a body. ergoAttach decodes each IR body, checks every node
+// against the package's types2 objects, and builds the typed syntax body
+// (with the type records types2 would have made) that the unified writer
+// then encodes like any other. Go never parses or type-checks an IR body,
+// and a node that does not check is a compile error at its own position.
+//
+// The decoder is one file per construct family: ergoir.go (format, entry,
+// functions), ergoir_types.go, ergoir_stmt.go, ergoir_expr.go and
+// ergoir_call.go.
+
+package ergoir
+
+import (
+	"encoding/json"
+	"internal/types/errors"
+	"os"
+
+	"cmd/compile/internal/base"
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoFile is the IR file: the source files positions refer to, and the
+// bodies.
+type ergoFile struct {
+	V     int        `json:"v"`
+	Files []string   `json:"files"`
+	Funcs []ergoFunc `json:"funcs"`
+}
+
+// ergoFunc is one body: Name is F, or T.M for a method of T. Locals
+// declares the body's own variables; index i < number of receiver and
+// parameters names those, the rest names Locals in order.
+type ergoFunc struct {
+	Name   string      `json:"name"`
+	Pos    ergoPos     `json:"pos"`
+	End    ergoPos     `json:"end"`
+	Locals []ergoLocal `json:"locals"`
+	Body   []*ergoStmt `json:"body"`
+	// Results binds the signature's results, which the Go declaration
+	// names, as locals after the parameters (IR2-RESULTS): a frame's
+	// deferred end reads the named error result, as the emitter's
+	// `defer fs.End(&err)` does.
+	Results bool `json:"results,omitempty"`
+}
+
+type ergoLocal struct {
+	Name string  `json:"name"`
+	Type string  `json:"type"`
+	Pos  ergoPos `json:"pos"`
+}
+
+// ergoPos is file index, line, column.
+type ergoPos [3]int
+
+type ergoStmt struct {
+	K     string      `json:"k"` // def set ret if range while expr var discard break continue panic
+	Pos   ergoPos     `json:"pos"`
+	Local int         `json:"local,omitempty"`
+	Key   *int        `json:"key,omitempty"`
+	Val   *int        `json:"val,omitempty"`
+	X     *ergoExpr   `json:"x,omitempty"`
+	Then  []*ergoStmt `json:"then,omitempty"`
+	Else  []*ergoStmt `json:"else,omitempty"`
+	Body  []*ergoStmt `json:"body,omitempty"`
+	End   ergoPos     `json:"end"`
+	// ElsePos and ElseEnd bound an if's else block.
+	ElsePos ergoPos `json:"epos"`
+	ElseEnd ergoPos `json:"eend"`
+	// Op is an op-assignment's operator (set: x op= X).
+	Op string `json:"op,omitempty"`
+	// Cases are a "tswitch"'s clauses (ergoir_fail.go); Else is its
+	// default clause, at ElsePos.
+	Cases []*ergoCase `json:"cases,omitempty"`
+	// Label is a loop's or a block's label, or the label a break,
+	// continue or goto names (ergoir_label.go).
+	Label string `json:"label,omitempty"`
+	// Y is a store's value (store: X = Y, X a field; IRG6), or a "count"
+	// loop's bound (ergoir_stmt.go).
+	Y *ergoExpr `json:"y,omitempty"`
+	// Ls are a "tdef"'s locals, one per result, -1 for Go's blank
+	// (ergoir_tuple.go).
+	Ls []int `json:"ls,omitempty"`
+}
+
+type ergoExpr struct {
+	K     string      `json:"k"` // local const bin un call mcall field index lit len pcall conv global
+	Pos   ergoPos     `json:"pos"`
+	I     int         `json:"i,omitempty"`
+	T     string      `json:"t,omitempty"`
+	V     string      `json:"v,omitempty"`
+	Op    string      `json:"op,omitempty"`
+	X     *ergoExpr   `json:"x,omitempty"`
+	Y     *ergoExpr   `json:"y,omitempty"`
+	Name  string      `json:"name,omitempty"`
+	Args  []*ergoExpr `json:"args,omitempty"`
+	Elems []*ergoExpr `json:"elems,omitempty"`
+	Keys  []string    `json:"keys,omitempty"` // a record literal's field names
+	// Params, Body and End are a function literal's (func; IRG6): its
+	// parameters' locals, its statements and its closing brace.
+	Params []int       `json:"params,omitempty"`
+	Body   []*ergoStmt `json:"body,omitempty"`
+	End    ergoPos     `json:"end"`
+}
+
+var ergoBinOps = map[string]syntax.Operator{
+	"+": syntax.Add, "-": syntax.Sub, "*": syntax.Mul, "/": syntax.Div, "%": syntax.Rem,
+	"==": syntax.Eql, "!=": syntax.Neq, "<": syntax.Lss, "<=": syntax.Leq, ">": syntax.Gtr, ">=": syntax.Geq,
+	"&&": syntax.AndAnd, "||": syntax.OrOr,
+	"&": syntax.And, "|": syntax.Or, "^": syntax.Xor, "&^": syntax.AndNot, "<<": syntax.Shl, ">>": syntax.Shr,
+}
+
+type ergoChecker struct {
+	m      *posMap
+	pkg    *types2.Package
+	info   *types2.Info
+	bases  []*syntax.PosBase
+	sig    *types2.Signature
+	locals []*types2.Var
+	// defined are the locals a body defines (name with def, a function
+	// literal's parameter or result); reads the first read of each body
+	// local, by index: a body local read and never defined is the IR
+	// builder's bug, reported as such (ergoReadBeforeDef), not left to
+	// gc's writer.
+	defined map[*types2.Var]bool
+	reads   map[int]ergoPos
+	nerr    int
+	loops   []*syntax.ForStmt // the loops around the statement being decoded
+	// loopLabels are the loops' labels ("" for none); labels the
+	// function's declared labels; gotos its gotos (ergoir_label.go).
+	loopLabels []string
+	labels     map[string]bool
+	gotos      []*ergoStmt
+	ctxt       *types2.Context // shares the instances of generic types (ergoir_types.go)
+	// tparams are the type parameters of the function being decoded, its
+	// receiver's then its own (F1): a type spelling names them first.
+	tparams []*types2.TypeParam
+	// rangeFunc reports a range over a func in the body being decoded,
+	// outside its function literals: rangefunc.Rewrite names a literal's
+	// results then (ergoir_closure.go).
+	rangeFunc bool
+	// tdef is the call a "tdef" binds, whose several results call
+	// admits (ergoir_tuple.go).
+	tdef *ergoExpr
+}
+
+// ergoAttach gives every function the IR file names its checked body.
+func ergoAttach(m posMap, pkg *types2.Package, info *types2.Info, noders []*noder) {
+	data, err := os.ReadFile(ergoFlag.IR)
+	if err != nil {
+		base.Fatalf("ergoir: %v", err)
+	}
+	var f ergoFile
+	if err := json.Unmarshal(data, &f); err != nil {
+		base.Fatalf("ergoir: %s: %v", ergoFlag.IR, err)
+	}
+	if f.V != 1 {
+		base.Fatalf("ergoir: %s: version %d, want 1", ergoFlag.IR, f.V)
+	}
+	c := &ergoChecker{m: &m, pkg: pkg, info: info}
+	for _, name := range f.Files {
+		c.bases = append(c.bases, syntax.NewFileBase(name))
+	}
+	decls := map[string]*syntax.FuncDecl{}
+	for _, p := range noders {
+		for _, d := range p.file.DeclList {
+			fd, ok := d.(*syntax.FuncDecl)
+			if !ok {
+				continue
+			}
+			obj, ok := info.Defs[fd.Name].(*types2.Func)
+			if !ok {
+				continue
+			}
+			decls[ergoKey(obj)] = fd
+		}
+	}
+	for i := range f.Funcs {
+		fn := &f.Funcs[i]
+		fd := decls[fn.Name]
+		switch {
+		case fd == nil:
+			c.errorf(fn.Pos, "ergoir: %s is not declared in the Go source", fn.Name)
+			continue
+		case ergoPlaceholder(info, fd.Body):
+			fd.Body = nil // a generic declaration's (ergoir_placeholder.go)
+		case fd.Body != nil:
+			c.errorf(fn.Pos, "ergoir: %s has a Go body as well as an IR body", fn.Name)
+			continue
+		}
+		c.function(fd, fn)
+		delete(decls, fn.Name) // a second IR body for the same name finds it gone
+	}
+	// A placeholder the IR gave no body is an error, never a panic at run
+	// time (ergoir_placeholder.go).
+	for _, p := range noders {
+		for _, d := range p.file.DeclList {
+			if fd, ok := d.(*syntax.FuncDecl); ok && ergoPlaceholder(info, fd.Body) {
+				base.ErrorfAt(m.makeXPos(fd.Pos()), errors.BadDecl, "ergoir: %s has the placeholder body and no IR body", fd.Name.Value)
+			}
+		}
+	}
+	base.ExitIfErrors()
+}
+
+// ergoKey is F or T.M.
+func ergoKey(obj *types2.Func) string {
+	sig := obj.Type().(*types2.Signature)
+	if sig.Recv() == nil {
+		return obj.Name()
+	}
+	t := sig.Recv().Type()
+	if p, ok := t.(*types2.Pointer); ok {
+		t = p.Elem()
+	}
+	if n, ok := types2.Unalias(t).(*types2.Named); ok {
+		return n.Obj().Name() + "." + obj.Name()
+	}
+	return "?." + obj.Name()
+}
+
+func (c *ergoChecker) pos(p ergoPos) syntax.Pos {
+	if p[0] < 0 || p[0] >= len(c.bases) {
+		return syntax.Pos{}
+	}
+	return syntax.MakePos(c.bases[p[0]], uint(p[1]), uint(p[2]))
+}
+
+func (c *ergoChecker) errorf(p ergoPos, format string, args ...any) {
+	c.nerr++
+	pos := c.pos(p)
+	if !pos.IsKnown() {
+		base.Errorf(format, args...)
+		return
+	}
+	base.ErrorfAt(c.m.makeXPos(pos), 0, format, args...)
+}
+
+// ergoReadBeforeDef reports each body local (index first and up) that the
+// body reads and never defines: gc's writer would otherwise assert on the
+// undeclared name with a dump that names no IR local.
+func (c *ergoChecker) ergoReadBeforeDef(fn string, first int) {
+	for i := first; i < len(c.locals); i++ {
+		p, read := c.reads[i]
+		if read && !c.defined[c.locals[i]] {
+			c.errorf(p, "ergoir: local %d (%s) read before any def in %s", i, c.locals[i].Name(), fn)
+		}
+	}
+}
+
+func (c *ergoChecker) function(fd *syntax.FuncDecl, fn *ergoFunc) {
+	obj := c.info.Defs[fd.Name].(*types2.Func)
+	c.sig = obj.Type().(*types2.Signature)
+	c.locals, c.labels, c.gotos = nil, nil, nil
+	if r := c.sig.Recv(); r != nil {
+		c.locals = append(c.locals, r)
+	}
+	for i := 0; i < c.sig.Params().Len(); i++ {
+		c.locals = append(c.locals, c.sig.Params().At(i))
+	}
+	if fn.Results {
+		for i := 0; i < c.sig.Results().Len(); i++ {
+			r := c.sig.Results().At(i)
+			if r.Name() == "" || r.Name() == "_" {
+				c.errorf(fn.Pos, "ergoir: %s: a result bound as a local needs a name in the Go declaration", fn.Name)
+				return
+			}
+			c.locals = append(c.locals, r)
+		}
+	}
+	if !ergoSigOK(c.sig) || c.sig.Variadic() {
+		c.errorf(fn.Pos, "ergoir: %s: only plain signatures with at most one result take an IR body", fn.Name)
+		return
+	}
+	// A generic function's body names its type parameters (F1): the
+	// receiver's, then its own, as the Go declaration lists them.
+	c.tparams = nil
+	for _, l := range []*types2.TypeParamList{c.sig.RecvTypeParams(), c.sig.TypeParams()} {
+		for i := 0; i < l.Len(); i++ {
+			c.tparams = append(c.tparams, l.At(i))
+		}
+	}
+	for _, l := range fn.Locals {
+		t := c.typ(l.Pos, l.Type)
+		if t == nil {
+			return
+		}
+		c.locals = append(c.locals, types2.NewVar(c.pos(l.Pos), c.pkg, l.Name, t))
+	}
+	before := c.nerr
+	first := len(c.locals) - len(fn.Locals)
+	c.defined, c.reads = map[*types2.Var]bool{}, map[int]ergoPos{}
+	body := &syntax.BlockStmt{List: c.stmts(fn.Body), Rbrace: c.pos(fn.End)}
+	body.SetPos(c.pos(fn.Pos))
+	c.ergoLabelsDone() // ergoir_label.go
+	c.ergoReadBeforeDef(fn.Name, first)
+	if c.nerr != before {
+		return
+	}
+	if c.sig.Results().Len() == 1 && ergoFallible(c.sig) {
+		// A fallible body with no value ends in its success (ergoir_fail.go).
+		if last := lastNonEmptyStmt(body.List); last == nil || !ergoTerminates(last) {
+			body.List = append(body.List, c.ret(&ergoStmt{K: "ret", Pos: fn.End}))
+		}
+	} else if c.sig.Results().Len() >= 1 {
+		if last := lastNonEmptyStmt(body.List); last == nil || !ergoTerminates(last) {
+			c.errorf(fn.End, "ergoir: %s: missing return", fn.Name)
+			return
+		}
+	}
+	fd.Body = body
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_builtin.go b/src/cmd/compile/internal/ergoir/ergoir_builtin.go
new file mode 100644
index 0000000..9dbb397
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_builtin.go
@@ -0,0 +1,174 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: calls of Go's builtins. See ergoir.go.
+
+package ergoir
+
+import (
+	"go/constant"
+
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// builtinExpr checks the IR kind "builtin", a call of Go's builtin
+// x.Name, and writes it as Go's own call of the builtin, with the
+// signature types2 records for it (types2/builtins.go): the reader then
+// gives Go's ODELETE, OCOPY, OCLEAR, OMIN, OMAX, OCAP and OMAKESLICE, as
+// Go source does. append here is append(xs, ys...) of a slice or of a
+// string's bytes; append of one element is the kind "append". make is a
+// slice's, its type in x.T and its sizes in x.Args. A call with no
+// result (delete, clear) is void, and only an expression statement takes
+// it.
+func (c *ergoChecker) builtinExpr(x *ergoExpr) (syntax.Expr, types2.Type) {
+	pos := c.pos(x.Pos)
+	var args []syntax.Expr
+	var ts []types2.Type
+	for _, a := range x.Args {
+		e, t := c.expr(a)
+		if e == nil {
+			return nil, nil
+		}
+		if t == nil {
+			c.errorf(a.Pos, "ergoir: %s of a call with no result", x.Name)
+			return nil, nil
+		}
+		args, ts = append(args, e), append(ts, t)
+	}
+	arity := map[string]int{"append": 2, "cap": 1, "clear": 1, "copy": 2, "delete": 2}
+	if n, ok := arity[x.Name]; ok && len(args) != n || !ok && len(args) == 0 {
+		c.errorf(x.Pos, "ergoir: %s of %d operands", x.Name, len(args))
+		return nil, nil
+	}
+	var res types2.Type
+	params := ts
+	variadic, dots := false, false
+	switch x.Name {
+	case "append":
+		// append(xs, ys...) of a slice of xs's element type (APPEND-SPREAD),
+		// with the signature types2 records, (S, []E), or of a string's
+		// bytes, (S, string).
+		sl, ok := types2.CoreType(ts[0]).(*types2.Slice)
+		ys, spread := types2.CoreType(ts[1]).(*types2.Slice)
+		switch {
+		case ok && spread && types2.Identical(sl.Elem(), ys.Elem()):
+			params = []types2.Type{ts[0], types2.NewSlice(sl.Elem())}
+		case ok && types2.Identical(sl.Elem(), types2.Typ[types2.Byte]) && ergoIsString(ts[1]):
+		default:
+			c.errorf(x.Pos, "ergoir: append of %v to %v", ts[1], ts[0])
+			return nil, nil
+		}
+		res, variadic, dots = ts[0], true, true
+	case "make":
+		// make([]T, n) and make([]T, n, c) (IR-MAKE), checked as types2
+		// checks a slice's make: x.T the slice type, the sizes of any
+		// integer type, a constant one not negative and a constant n not
+		// above a constant c. Go's escape analysis keeps a small make of a
+		// constant size on the stack, as it keeps hand Go's.
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil
+		}
+		if _, ok := types2.CoreType(t).(*types2.Slice); !ok || len(args) > 2 {
+			c.errorf(x.Pos, "ergoir: make of %v with %d sizes", t, len(args))
+			return nil, nil
+		}
+		var sizes []int64
+		for i, a := range x.Args {
+			if !ergoIsInteger(ts[i]) {
+				c.errorf(a.Pos, "ergoir: make size of type %v", ts[i])
+				return nil, nil
+			}
+			if v := args[i].GetTypeInfo().Value; v != nil {
+				n, exact := constant.Int64Val(constant.ToInt(v))
+				if !exact || n < 0 {
+					c.errorf(a.Pos, "ergoir: make size %v", v)
+					return nil, nil
+				}
+				sizes = append(sizes, n)
+			}
+		}
+		if len(sizes) == 2 && sizes[0] > sizes[1] {
+			c.errorf(x.Pos, "ergoir: make length %d above capacity %d", sizes[0], sizes[1])
+			return nil, nil
+		}
+		tn := syntax.NewName(pos, types2.TypeString(t, nil))
+		ttv := syntax.TypeAndValue{Type: t}
+		ttv.SetIsType()
+		tn.SetTypeInfo(ttv)
+		args = append([]syntax.Expr{tn}, args...)
+		params = append([]types2.Type{t}, ts...)
+		res = t
+	case "cap":
+		if _, ok := types2.CoreType(ts[0]).(*types2.Slice); !ok {
+			c.errorf(x.Pos, "ergoir: cap of %v", ts[0])
+			return nil, nil
+		}
+		res = types2.Typ[types2.Int]
+	case "clear":
+		switch types2.CoreType(ts[0]).(type) {
+		case *types2.Slice, *types2.Map:
+		default:
+			c.errorf(x.Pos, "ergoir: clear of %v", ts[0])
+			return nil, nil
+		}
+	case "copy":
+		dst, ok := types2.CoreType(ts[0]).(*types2.Slice)
+		src, ok2 := types2.CoreType(ts[1]).(*types2.Slice)
+		if !ok || !ok2 || !types2.Identical(dst.Elem(), src.Elem()) {
+			c.errorf(x.Pos, "ergoir: copy of %v to %v", ts[1], ts[0])
+			return nil, nil
+		}
+		res = types2.Typ[types2.Int]
+	case "delete":
+		m, ok := types2.CoreType(ts[0]).(*types2.Map)
+		if !ok || !c.assignable(x.Args[1].Pos, "delete key", ts[1], m.Key()) {
+			if !ok {
+				c.errorf(x.Pos, "ergoir: delete from %v", ts[0])
+			}
+			return nil, nil
+		}
+		params = []types2.Type{ts[0], m.Key()}
+	case "min", "max":
+		b, ok := types2.CoreType(ts[0]).(*types2.Basic)
+		if !ok || b.Info()&types2.IsOrdered == 0 {
+			c.errorf(x.Pos, "ergoir: %s of %v", x.Name, ts[0])
+			return nil, nil
+		}
+		for i, t := range ts[1:] {
+			if !types2.Identical(t, ts[0]) {
+				c.errorf(x.Args[i+1].Pos, "ergoir: %s of %v and %v", x.Name, ts[0], t)
+				return nil, nil
+			}
+		}
+		res = ts[0]
+	default:
+		c.errorf(x.Pos, "ergoir: the builtin %q", x.Name)
+		return nil, nil
+	}
+	var in []*types2.Var
+	for _, t := range params {
+		in = append(in, types2.NewParam(pos, nil, "", t))
+	}
+	var out *types2.Tuple
+	if res != nil {
+		out = types2.NewTuple(types2.NewParam(pos, nil, "", res))
+	}
+	fun := syntax.NewName(pos, x.Name)
+	c.info.Uses[fun] = types2.Universe.Lookup(x.Name)
+	tv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil, types2.NewTuple(in...), out, variadic)}
+	tv.SetIsBuiltin()
+	fun.SetTypeInfo(tv)
+	call := &syntax.CallExpr{Fun: fun, ArgList: args, HasDots: dots}
+	call.SetPos(pos)
+	if res == nil {
+		void := syntax.TypeAndValue{}
+		void.SetIsVoid()
+		call.SetTypeInfo(void)
+		return call, nil
+	}
+	ergoValue(call, res, nil)
+	return call, res
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_call.go b/src/cmd/compile/internal/ergoir/ergoir_call.go
new file mode 100644
index 0000000..64dc1e4
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_call.go
@@ -0,0 +1,80 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: calls. See ergoir.go.
+
+package ergoir
+
+import (
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// ergoRangeTypes is the key and the element type of Go's range over a
+// value of type t: a slice's index and element, a map's key and value, a
+// string's byte offset and rune; one integer of the bound's type for
+// an integer range; nil and nil for an unsupported type.
+func ergoRangeTypes(t types2.Type) (key, elem types2.Type) {
+	if ergoIsInteger(t) {
+		return t, nil
+	}
+	switch u := types2.CoreType(t).(type) {
+	case *types2.Slice:
+		return types2.Typ[types2.Int], u.Elem()
+	case *types2.Array:
+		return types2.Typ[types2.Int], u.Elem() // FLIP F7: Go's range over an array
+	case *types2.Map:
+		return u.Key(), u.Elem()
+	case *types2.Signature:
+		// for v := range seq, seq a func(yield func(T) bool) (an Ergo Seq
+		// loop): one variable; Stub's rangefunc.Rewrite rewrites the loop.
+		if u.Params().Len() == 1 && u.Results().Len() == 0 {
+			if y, ok := types2.CoreType(u.Params().At(0).Type()).(*types2.Signature); ok && y.Params().Len() == 1 {
+				return y.Params().At(0).Type(), nil
+			}
+		}
+	}
+	if ergoIsString(t) {
+		return types2.Typ[types2.Int], types2.Universe.Lookup("rune").Type()
+	}
+	return nil, nil
+}
+
+// call checks the arguments of a call of fun, whose signature is sig.
+func (c *ergoChecker) call(x *ergoExpr, fun syntax.Expr, sig *types2.Signature) (syntax.Expr, types2.Type) {
+	// A function may return several values, which only a tdef binds
+	// (ergoir_tuple.go): a package call, or the call a tdef holds.
+	// A variadic Go function takes its last argument spread, f(xs...),
+	// when the IR's Op says "..." (FLIP F7 FORK-GOLIB): types2's last
+	// parameter is then the slice.
+	dots := x.Op == "..." && sig.Variadic()
+	if sig.Variadic() != dots || sig.Params().Len() != len(x.Args) || !ergoSigOK(sig) && x.K != "pcall" && x != c.tdef {
+		c.errorf(x.Pos, "ergoir: call of %s with %d arguments", x.Name, len(x.Args))
+		return nil, nil
+	}
+	call := &syntax.CallExpr{Fun: fun, HasDots: dots}
+	call.SetPos(c.pos(x.Pos))
+	for i, a := range x.Args {
+		e, t := c.expr(a)
+		if e == nil || !c.assignable(a.Pos, "argument", t, sig.Params().At(i).Type()) {
+			return nil, nil
+		}
+		call.ArgList = append(call.ArgList, e)
+	}
+	if sig.Results().Len() == 0 {
+		tv := syntax.TypeAndValue{}
+		tv.SetIsVoid()
+		call.SetTypeInfo(tv)
+		return call, nil
+	}
+	var t types2.Type = sig.Results()
+	if sig.Results().Len() == 1 {
+		t = sig.Results().At(0).Type()
+	}
+	// A fallible call's type is its (value, error) tuple, which only a
+	// def2 or a return of the whole result list takes (ergoir_fail.go); a
+	// package call's several results, which only a tdef takes.
+	ergoValue(call, t, nil)
+	return call, t
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_closure.go b/src/cmd/compile/internal/ergoir/ergoir_closure.go
new file mode 100644
index 0000000..4c49b33
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_closure.go
@@ -0,0 +1,246 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: function values (IRG6). See ergoir.go.
+//
+// A function value's type is spelled as Go spells it, "func(A, B) (R,
+// error)", and the empty struct a function with no value returns as
+// "struct{}". "func" is a function literal: its parameters are locals of
+// the enclosing body's table, and its body is a function of its own (its
+// returns, its labels, its loops). "vcall" calls a value of a function
+// type.
+
+package ergoir
+
+import (
+	"fmt"
+	"go/token"
+	"strings"
+
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// literalType is the type s spells when it is a function type or the
+// empty struct; ok is false for any other spelling.
+func (c *ergoChecker) literalType(p ergoPos, s string) (t types2.Type, ok bool) {
+	switch {
+	case s == "struct{}":
+		return types2.NewStruct(nil, nil), true
+	case strings.HasPrefix(s, "struct{"):
+		return c.structType(p, s), true // ergoir_tuple.go
+	case !strings.HasPrefix(s, "func("):
+		return nil, false
+	}
+	params, rest, ok := ergoSplitList(s[len("func"):])
+	if !ok {
+		c.errorf(p, "ergoir: function type %q", s)
+		return nil, true
+	}
+	var results []string
+	switch rest = strings.TrimSpace(rest); {
+	case rest == "":
+	case strings.HasPrefix(rest, "("):
+		var tail string
+		results, tail, ok = ergoSplitList(rest)
+		if !ok || strings.TrimSpace(tail) != "" {
+			c.errorf(p, "ergoir: function type %q", s)
+			return nil, true
+		}
+	default:
+		results = []string{rest}
+	}
+	tuple := func(list []string, named bool) (*types2.Tuple, bool) {
+		var vars []*types2.Var
+		for _, e := range list {
+			name := ""
+			if named {
+				name, e = ergoResultName(e)
+			}
+			et := c.typ(p, e)
+			if et == nil {
+				return nil, false
+			}
+			vars = append(vars, types2.NewParam(c.pos(p), c.pkg, name, et))
+		}
+		return types2.NewTuple(vars...), true
+	}
+	pt, ok1 := tuple(params, false)
+	rt, ok2 := tuple(results, true)
+	if !ok1 || !ok2 {
+		return nil, true
+	}
+	return types2.NewSignatureType(nil, nil, nil, pt, rt, false), true
+}
+
+// ergoResultName splits a result's spelling "name T" (a frame literal's
+// "(_ R, err error)", whose deferred End sets err: the "result" form a
+// function has) into its name and type; a spelling with no name is all
+// type.
+func ergoResultName(s string) (name, t string) {
+	s = strings.TrimSpace(s)
+	first, rest, ok := strings.Cut(s, " ")
+	if !ok || !token.IsIdentifier(first) && first != "_" {
+		return "", s
+	}
+	return first, strings.TrimSpace(rest)
+}
+
+// ergoSplitList splits "(A, B) rest" at the commas outside any bracket:
+// the list's elements and what follows its closing parenthesis.
+func ergoSplitList(s string) (list []string, rest string, ok bool) {
+	if !strings.HasPrefix(s, "(") {
+		return nil, "", false
+	}
+	depth, start := 0, 1
+	for i := 0; i < len(s); i++ {
+		switch s[i] {
+		case '(', '[', '{':
+			depth++
+		case ')', ']', '}':
+			depth--
+			if depth == 0 {
+				if part := strings.TrimSpace(s[start:i]); part != "" {
+					list = append(list, part)
+				}
+				return list, s[i+1:], true
+			}
+		case ',':
+			if depth == 1 {
+				list = append(list, strings.TrimSpace(s[start:i]))
+				start = i + 1
+			}
+		}
+	}
+	return nil, "", false
+}
+
+// closureExpr decodes a function literal and a call of a function value;
+// ok is false for any other kind.
+func (c *ergoChecker) closureExpr(x *ergoExpr) (e syntax.Expr, t types2.Type, ok bool) {
+	switch x.K {
+	case "vcall":
+		fun, ft := c.expr(x.X)
+		if fun == nil {
+			return nil, nil, true
+		}
+		sig, isSig := types2.CoreType(ft).(*types2.Signature)
+		if !isSig || sig.TypeParams().Len() > 0 {
+			c.errorf(x.Pos, "ergoir: call of a value of %v", ft)
+			return nil, nil, true
+		}
+		e, t = c.call(x, fun, sig)
+		return e, t, true
+	case "func":
+		e, t = c.funcLit(x)
+		return e, t, true
+	}
+	return nil, nil, false
+}
+
+// funcLit is func(params) results { body }: its parameters are the locals
+// x.Params names, which become the literal's parameters, and its body is
+// decoded as a function's, against the literal's signature.
+func (c *ergoChecker) funcLit(x *ergoExpr) (syntax.Expr, types2.Type) {
+	pos := c.pos(x.Pos)
+	t := c.typ(x.Pos, x.T)
+	if t == nil {
+		return nil, nil
+	}
+	sig0, ok := t.(*types2.Signature)
+	if !ok || sig0.Params().Len() != len(x.Params) || !ergoSigOK(sig0) {
+		c.errorf(x.Pos, "ergoir: function literal of %v with %d parameters", t, len(x.Params))
+		return nil, nil
+	}
+	ft := &syntax.FuncType{}
+	ft.SetPos(pos)
+	field := func(name *syntax.Name, t types2.Type) *syntax.Field {
+		// The type's syntax is only a typed name: the writer encodes the
+		// literal from its signature, and the text prints its types.
+		ts := syntax.NewName(pos, types2.TypeString(t, nil))
+		tv := syntax.TypeAndValue{Type: t}
+		tv.SetIsType()
+		ts.SetTypeInfo(tv)
+		f := &syntax.Field{Name: name, Type: ts}
+		f.SetPos(pos)
+		return f
+	}
+	var params []*types2.Var
+	for i, li := range x.Params {
+		v := c.local(x.Pos, li)
+		if v == nil {
+			return nil, nil
+		}
+		if !types2.Identical(v.Type(), sig0.Params().At(i).Type()) {
+			c.errorf(x.Pos, "ergoir: function literal parameter %s of %v, not %v", v.Name(), v.Type(), sig0.Params().At(i).Type())
+			return nil, nil
+		}
+		pv := types2.NewParam(v.Pos(), c.pkg, v.Name(), v.Type())
+		c.locals[li] = pv
+		params = append(params, pv)
+		name := syntax.NewName(pos, pv.Name())
+		c.info.Defs[name] = pv
+		c.defined[pv] = true // ergoReadBeforeDef
+		ft.ParamList = append(ft.ParamList, field(name, pv.Type()))
+	}
+	sig := types2.NewSignatureType(nil, nil, nil, types2.NewTuple(params...), sig0.Results(), false)
+	// The body is a function of its own: its returns are the literal's,
+	// and no loop or label of the enclosing body is in its scope.
+	sigS, loopsS, loopLabelsS, labelsS, gotosS, rangeFuncS := c.sig, c.loops, c.loopLabels, c.labels, c.gotos, c.rangeFunc
+	c.sig, c.loops, c.loopLabels, c.labels, c.gotos, c.rangeFunc = sig, nil, nil, nil, nil, false
+	defer func() { c.rangeFunc = rangeFuncS }()
+	before := c.nerr
+	body := &syntax.BlockStmt{List: c.stmts(x.Body), Rbrace: c.pos(x.End)}
+	body.SetPos(pos)
+	c.ergoLabelsDone()
+	if c.nerr == before && sig.Results().Len() > 0 {
+		if last := lastNonEmptyStmt(body.List); last == nil || !ergoTerminates(last) {
+			c.errorf(x.End, "ergoir: function literal: missing return")
+		}
+	}
+	failed := c.nerr != before
+	c.sig, c.loops, c.loopLabels, c.labels, c.gotos = sigS, loopsS, loopLabelsS, labelsS, gotosS
+	if failed {
+		return nil, nil
+	}
+	// The literal's results, named in one place for both uses:
+	//   - a result its type names (a frame literal's "(_ R, err error)",
+	//     G6) is declared, so "result" I names it in the body (resultExpr)
+	//     as in a function's;
+	//   - a return in a range over a func becomes, in rangefunc.Rewrite,
+	//     an assignment to the literal's results, which it names through
+	//     the signature's scope (types2.Signature.RenameResult) when they
+	//     have no name or the name _. A decoded signature has no scope, so
+	//     such a result is named here as RenameResult would: #rv1, #rv2, …
+	//     (REGEX-ICE).
+	// Other literals keep their results as their type spells them.
+	var results []*types2.Var
+	renamed := false
+	for i := 0; i < sig0.Results().Len(); i++ {
+		r := sig0.Results().At(i)
+		fresh := c.rangeFunc && (r.Name() == "" || r.Name() == "_")
+		if fresh {
+			r = types2.NewParam(pos, c.pkg, fmt.Sprintf("#rv%d", i+1), r.Type())
+			renamed = true
+		}
+		var name *syntax.Name
+		if r.Name() != "" {
+			name = syntax.NewName(pos, r.Name())
+			if fresh {
+				ergoValue(name, r.Type(), nil) // as RenameResult types its name
+			}
+			c.info.Defs[name] = r
+			c.defined[r] = true // ergoReadBeforeDef
+		}
+		results = append(results, r)
+		ft.ResultList = append(ft.ResultList, field(name, r.Type()))
+	}
+	if renamed {
+		sig = types2.NewSignatureType(nil, nil, nil, sig.Params(), types2.NewTuple(results...), false)
+	}
+	lit := &syntax.FuncLit{Type: ft, Body: body}
+	lit.SetPos(pos)
+	ergoValue(lit, sig, nil)
+	return lit, sig
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_expr.go b/src/cmd/compile/internal/ergoir/ergoir_expr.go
new file mode 100644
index 0000000..c454b6e
--- /dev/null
+++ b/src/cmd/compile/internal/ergoir/ergoir_expr.go
@@ -0,0 +1,593 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Ergo IR decoder: expressions, literals and constants. See ergoir.go.
+
+package ergoir
+
+import (
+	"go/constant"
+	"go/token"
+	"strconv"
+	"strings"
+	"sync"
+
+	"cmd/compile/internal/syntax"
+	"cmd/compile/internal/types2"
+)
+
+// expr checks x and returns its typed syntax and its type (nil: a call
+// with no result).
+func (c *ergoChecker) expr(x *ergoExpr) (syntax.Expr, types2.Type) {
+	if x == nil {
+		c.errorf(ergoPos{-1}, "ergoir: missing expression")
+		return nil, nil
+	}
+	pos := c.pos(x.Pos)
+	switch x.K {
+	case "result":
+		return c.resultExpr(x) // ergoir_f7f.go
+	case "recover":
+		return c.recoverExpr(x) // ergoir_f7f.go
+	case "builtin":
+		return c.builtinExpr(x) // ergoir_builtin.go
+	case "local":
+		v := c.local(x.Pos, x.I)
+		if v == nil {
+			return nil, nil
+		}
+		if _, seen := c.reads[x.I]; !seen && c.reads != nil {
+			c.reads[x.I] = x.Pos // ergoReadBeforeDef
+		}
+		return c.name(x.Pos, v, false), v.Type()
+	case "const":
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil
+		}
+		val := x.V
+		if x.Op == "quoted" {
+			// A string constant that is not UTF-8, which the JSON file
+			// cannot carry: its Go quoted form (CW-IR, CBOR's bytes).
+			s, err := strconv.Unquote(x.V)
+			if err != nil || !ergoIsString(t) {
+				c.errorf(x.Pos, "ergoir: quoted constant %s of type %v", x.V, t)
+				return nil, nil
+			}
+			val = s
+		}
+		v := ergoConstant(t, val)
+		if v == nil {
+			c.errorf(x.Pos, "ergoir: constant %q of type %v", x.V, t)
+			return nil, nil
+		}
+		if digits, neg := strings.CutPrefix(x.V, "-"); neg && t == types2.Typ[types2.Float64] {
+			// -1e-12: Go has no negative literal, so the same constant in
+			// Go is the negation of an untyped literal, exact until it is
+			// converted (types2 keeps -1/10^12 on the negation, the rounded
+			// float64 only where it is converted). Keep Go's exact value:
+			// the compiled float64 is the same, and the text view's
+			// (-1e-12) compiles to this tree (IRFIX-FLOAT). Only float64,
+			// the literal's default type: a constant of any other type is
+			// spelled as a conversion, whose value Go rounds.
+			if exact := constant.MakeFromLiteral(digits, token.FLOAT, 0); exact.Kind() != constant.Unknown {
+				v = constant.UnaryOp(token.SUB, exact, 0)
+			}
+		}
+		lit := &syntax.BasicLit{Value: x.V}
+		lit.SetPos(pos)
+		ergoValue(lit, t, v)
+		return lit, t
+	case "bin":
+		op, ok := ergoBinOps[x.Op]
+		if !ok {
+			c.errorf(x.Pos, "ergoir: operator %q", x.Op)
+			return nil, nil
+		}
+		l, lt := c.expr(x.X)
+		r, rt := c.expr(x.Y)
+		if l == nil || r == nil {
+			return nil, nil
+		}
+		t := c.binType(x.Pos, op, x.Op, lt, rt)
+		if t == nil {
+			return nil, nil
+		}
+		e := &syntax.Operation{Op: op, X: l, Y: r}
+		e.SetPos(pos)
+		ergoValue(e, t, nil)
+		return e, t
+	case "un":
+		e0, t := c.expr(x.X)
+		if e0 == nil {
+			return nil, nil
+		}
+		var op syntax.Operator
+		switch {
+		case x.Op == "!" && ergoIsBool(t):
+			op = syntax.Not
+		case x.Op == "-" && ergoIsNumeric(t):
+			op = syntax.Sub
+		case x.Op == "+" && ergoIsNumeric(t):
+			op = syntax.Add
+		case x.Op == "^" && ergoIsInteger(t):
+			op = syntax.Xor
+		default:
+			c.errorf(x.Pos, "ergoir: unary %s on %v", x.Op, t)
+			return nil, nil
+		}
+		if b, ok := e0.(*syntax.Operation); ok && b.Y != nil || op == syntax.Not {
+			// A binary operand, and every operand of a !, stands in
+			// parentheses: the writer's staticBool reads Not(x) as x's own
+			// value. Go reaches it with neither a constant x (types2 folds
+			// !c) nor an AndAnd (its parser keeps the parentheses); the
+			// decoder folds nothing, so !false read false and inverted an
+			// assert, and !(p && false) would drop its branch (#42).
+			p := &syntax.ParenExpr{X: e0}
+			p.SetPos(e0.Pos())
+			ergoValue(p, t, nil)
+			e0 = p
+		}
+		e := &syntax.Operation{Op: op, X: e0}
+		e.SetPos(pos)
+		ergoValue(e, t, nil)
+		return e, t
+	case "deref":
+		// *p: the value a pointer points at (IRG6: a with copies the
+		// environment, env2 := *env).
+		e0, t := c.expr(x.X)
+		if e0 == nil {
+			return nil, nil
+		}
+		pt, ok := types2.CoreType(t).(*types2.Pointer)
+		if !ok {
+			c.errorf(x.Pos, "ergoir: deref of %v", t)
+			return nil, nil
+		}
+		e := &syntax.Operation{Op: syntax.Mul, X: e0}
+		e.SetPos(pos)
+		ergoValue(e, pt.Elem(), nil)
+		return e, pt.Elem()
+	case "addr":
+		// &x of a local (IRG6: the copy a with's block runs against), or
+		// &T{…} of a literal (an operations conversion's adapter), or &p
+		// of a place: a field of an addressable record or through a
+		// pointer, a slice's element, *p (FLIP F2).
+		if x.X == nil {
+			c.errorf(x.Pos, "ergoir: address of nothing")
+			return nil, nil
+		}
+		e0, t := c.expr(x.X)
+		if e0 == nil {
+			return nil, nil
+		}
+		if x.X.K != "lit" && !ergoPlace(e0) {
+			c.errorf(x.Pos, "ergoir: address of a non-place")
+			return nil, nil
+		}
+		pt := types2.NewPointer(t)
+		e := &syntax.Operation{Op: syntax.And, X: e0}
+		e.SetPos(pos)
+		ergoValue(e, pt, nil)
+		return e, pt
+	case "call":
+		fn, ok := c.pkg.Scope().Lookup(x.Name).(*types2.Func)
+		if !ok {
+			c.errorf(x.Pos, "ergoir: %s is not a function of the package", x.Name)
+			return nil, nil
+		}
+		sig := fn.Type().(*types2.Signature)
+		fun := syntax.NewName(pos, x.Name)
+		c.info.Uses[fun] = fn
+		if sig.TypeParams().Len() > 0 || x.T != "" {
+			// A generic function's instance: T lists its type arguments
+			// (Go's spelling), recorded as Go records an inferred one.
+			sig = c.funcInstance(x.Pos, fun, sig, x.T)
+			if sig == nil {
+				return nil, nil
+			}
+		}
+		ergoValue(fun, sig, nil)
+		return c.call(x, fun, sig)
+	case "mcall":
+		recv, rt := c.expr(x.X)
+		if recv == nil {
+			return nil, nil
+		}
+		sel, ok := types2.LookupSelection(rt, false, c.pkg, x.Name)
+		if !ok || sel.Kind() != types2.MethodVal {
+			c.errorf(x.Pos, "ergoir: %v has no method %s", rt, x.Name)
+			return nil, nil
+		}
+		// No implicit &x and no embedded path: a pointer method is called
+		// on a pointer only.
+		mrecv := sel.Obj().(*types2.Func).Type().(*types2.Signature).Recv().Type()
+		if isPtrTo(mrecv, rt) || len(sel.Index()) != 1 {
+			c.errorf(x.Pos, "ergoir: %s needs an implicit address or an embedded path", x.Name)
+			return nil, nil
+		}
+		se := &syntax.SelectorExpr{X: recv, Sel: syntax.NewName(pos, x.Name)}
+		se.SetPos(pos)
+		c.info.Selections[se] = &sel
+		c.info.Uses[se.Sel] = sel.Obj()
+		sig := sel.Type().(*types2.Signature)
+		ergoValue(se, sig, nil)
+		return c.call(x, se, sig)
+	case "pcall":
+		// PATH.NAME(args): an exported function of an imported package.
+		pkg := c.imported(x.Pos, x.T)
+		if pkg == nil {
+			return nil, nil
+		}
+		fn, ok := pkg.Scope().Lookup(x.Name).(*types2.Func)
+		if !ok || !fn.Exported() {
+			c.errorf(x.Pos, "ergoir: %s is not a function of %q", x.Name, x.T)
+			return nil, nil
+		}
+		sig := fn.Type().(*types2.Signature)
+		sel := syntax.NewName(pos, x.Name)
+		c.info.Uses[sel] = fn
+		if sig.TypeParams().Len() > 0 || x.V != "" {
+			// A generic function's instance: V lists its type arguments.
+			sig = c.funcInstance(x.Pos, sel, sig, x.V)
+			if sig == nil {
+				return nil, nil
+			}
+		}
+		tv := syntax.TypeAndValue{Type: sig}
+		tv.SetIsValue()
+		sel.SetTypeInfo(tv)
+		return c.call(x, c.qualified(x.Pos, pkg, sel, tv), sig)
+	case "conv":
+		// T(x) between basic types: numeric to numeric, string to
+		// string, bool to bool.
+		// Or between a function type and a type defined over it
+		// (Seq[T] of a function literal; ergoFuncConv).
+		t := c.typ(x.Pos, x.T)
+		e0, et := c.expr(x.X)
+		if t == nil || e0 == nil {
+			return nil, nil
+		}
+		if !(ergoIsNumeric(t) && ergoIsNumeric(et) || ergoIsString(t) && ergoIsString(et) || ergoIsBool(t) && ergoIsBool(et) || ergoFuncConv(t, et)) {
+			c.errorf(x.Pos, "ergoir: conversion of %v to %v", et, t)
+			return nil, nil
+		}
+		fun := c.typeExpr(x.Pos, t)
+		if fun == nil {
+			return nil, nil
+		}
+		call := &syntax.CallExpr{Fun: fun, ArgList: []syntax.Expr{e0}}
+		call.SetPos(pos)
+		ergoValue(call, t, ergoConstConv(e0.GetTypeInfo().Value, et, t))
+		return call, t
+	case "global":
+		v, ok := c.pkg.Scope().Lookup(x.Name).(*types2.Var)
+		if !ok {
+			c.errorf(x.Pos, "ergoir: %s is not a variable of the package", x.Name)
+			return nil, nil
+		}
+		return c.name(x.Pos, v, false), v.Type()
+	case "field":
+		recv, rt := c.expr(x.X)
+		if recv == nil {
+			return nil, nil
+		}
+		sel, ok := types2.LookupSelection(rt, false, c.pkg, x.Name)
+		if !ok || sel.Kind() != types2.FieldVal || len(sel.Index()) != 1 {
+			c.errorf(x.Pos, "ergoir: %v has no direct field %s", rt, x.Name)
+			return nil, nil
+		}
+		se := &syntax.SelectorExpr{X: recv, Sel: syntax.NewName(pos, x.Name)}
+		se.SetPos(pos)
+		c.info.Selections[se] = &sel
+		c.info.Uses[se.Sel] = sel.Obj()
+		ergoValue(se, sel.Type(), nil)
+		return se, sel.Type()
+	case "index":
+		xs, xt := c.expr(x.X)
+		i, it := c.expr(x.Y)
+		if xs == nil || i == nil {
+			return nil, nil
+		}
+		if m, ok := types2.CoreType(xt).(*types2.Map); ok {
+			// A Map's value by its key, read only (CW-IR: a codec
+			// writer reads each entry by a key of WireKeys).
+			if !types2.Identical(it, m.Key()) {
+				c.errorf(x.Pos, "ergoir: index of %v by %v", xt, it)
+				return nil, nil
+			}
+			e := &syntax.IndexExpr{X: xs, Index: i}
+			e.SetPos(pos)
+			ergoValue(e, m.Elem(), nil)
+			return e, m.Elem()
+		}
+		// Go indexes by a value of any integer type (red #31: a string
+		// by a byte).
+		elem := ergoIndexElem(xt) // ergoir_f7.go
+		if elem == nil || !ergoIsInteger(it) {
+			c.errorf(x.Pos, "ergoir: index of %v by %v", xt, it)
+			return nil, nil
+		}
+		e := &syntax.IndexExpr{X: xs, Index: i}
+		e.SetPos(pos)
+		ergoValue(e, elem, nil)
+		return e, elem
+	case "len":
+		xs, xt := c.expr(x.X)
+		if xs == nil {
+			return nil, nil
+		}
+		switch types2.CoreType(xt).(type) {
+		case *types2.Slice, *types2.Map:
+		default:
+			if ergoIsString(xt) {
+				break
+			}
+			c.errorf(x.Pos, "ergoir: len of %v", xt)
+			return nil, nil
+		}
+		b := types2.Universe.Lookup("len")
+		fun := syntax.NewName(pos, "len")
+		c.info.Uses[fun] = b
+		tv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil,
+			types2.NewTuple(types2.NewParam(pos, nil, "", xt)),
+			types2.NewTuple(types2.NewParam(pos, nil, "", types2.Typ[types2.Int])), false)}
+		tv.SetIsBuiltin()
+		fun.SetTypeInfo(tv)
+		call := &syntax.CallExpr{Fun: fun, ArgList: []syntax.Expr{xs}}
+		call.SetPos(pos)
+		ergoValue(call, types2.Typ[types2.Int], nil)
+		return call, types2.Typ[types2.Int]
+	case "append":
+		// append(xs, v): Go's builtin append of one element, as types2
+		// records it (builtins.go _Append: func(S, ...E) S, variadic).
+		if len(x.Args) != 2 {
+			c.errorf(x.Pos, "ergoir: append of %d operands", len(x.Args))
+			return nil, nil
+		}
+		xs, xt := c.expr(x.Args[0])
+		v, vt := c.expr(x.Args[1])
+		if xs == nil || v == nil {
+			return nil, nil
+		}
+		sl, ok := types2.CoreType(xt).(*types2.Slice)
+		if !ok {
+			c.errorf(x.Pos, "ergoir: append to %v, not a slice", xt)
+			return nil, nil
+		}
+		if !c.assignable(x.Pos, "append", vt, sl.Elem()) {
+			return nil, nil
+		}
+		b := types2.Universe.Lookup("append")
+		fun := syntax.NewName(pos, "append")
+		c.info.Uses[fun] = b
+		tv := syntax.TypeAndValue{Type: types2.NewSignatureType(nil, nil, nil,
+			types2.NewTuple(types2.NewParam(pos, nil, "", xt), types2.NewParam(pos, nil, "", types2.NewSlice(sl.Elem()))),
+			types2.NewTuple(types2.NewParam(pos, nil, "", xt)), true)}
+		tv.SetIsBuiltin()
+		fun.SetTypeInfo(tv)
+		call := &syntax.CallExpr{Fun: fun, ArgList: []syntax.Expr{xs, v}}
+		call.SetPos(pos)
+		ergoValue(call, xt, nil)
+		return call, xt
+	case "slice":
+		return c.slice(x) // ergoir_slice.go
+	case "lit":
+		t := c.typ(x.Pos, x.T)
+		if t == nil {
+			return nil, nil
+		}
+		lit := &syntax.CompositeLit{}
+		lit.SetPos(pos)
+		switch u := types2.CoreType(t).(type) {
+		case *types2.Struct:
+			// Keyed, in the IR's (source) order, every field once.
+			if len(x.Keys) != len(x.Elems) || len(x.Elems) != u.NumFields() {
+				c.errorf(x.Pos, "ergoir: %v literal with %d of %d fields", t, len(x.Elems), u.NumFields())
+				return nil, nil
+			}
+			seen := map[string]bool{}
+			for i, ex := range x.Elems {
+				sel, ok := types2.LookupSelection(t, false, c.pkg, x.Keys[i])
+				if !ok || sel.Kind() != types2.FieldVal || len(sel.Index()) != 1 || seen[x.Keys[i]] {
+					c.errorf(ex.Pos, "ergoir: %v has no field %s, or it is given twice", t, x.Keys[i])
+					return nil, nil
+				}
+				seen[x.Keys[i]] = true
+				e, et := c.expr(ex)
+				if e == nil || !c.assignable(ex.Pos, "field", et, sel.Type()) {
+					return nil, nil
+				}
+				key := syntax.NewName(c.pos(ex.Pos), x.Keys[i])
+				c.info.Uses[key] = sel.Obj()
+				kv := &syntax.KeyValueExpr{Key: key, Value: e}
+				kv.SetPos(c.pos(ex.Pos))
+				lit.ElemList = append(lit.ElemList, kv)
+			}
+			lit.NKeys = len(x.Keys)
+		case *types2.Slice:
+			for _, ex := range x.Elems {
+				e, et := c.expr(ex)
+				if e == nil || !c.assignable(ex.Pos, "element", et, u.Elem()) {
+					return nil, nil
+				}
+				lit.ElemList = append(lit.ElemList, e)
+			}
+		case *types2.Array:
+			// Every element in order (Ergo's Arrays 2; the empty literal is a "zero").
+			if int64(len(x.Elems)) != u.Len() {
+				c.errorf(x.Pos, "ergoir: %v literal with %d of %d elements", t, len(x.Elems), u.Len())
+				return nil, nil
+			}
+			for _, ex := range x.Elems {
+				e, et := c.expr(ex)
+				if e == nil || !c.assignable(ex.Pos, "element", et, u.Elem()) {
+					return nil, nil
+				}
+				lit.ElemList = append(lit.ElemList, e)
+			}
+		case *types2.Map:
+			// Each entry's key, then its value (IRG4b).
+			if len(x.Keys) != 0 || len(x.Elems)%2 != 0 {
+				c.errorf(x.Pos, "ergoir: map literal with %d elements", len(x.Elems))
+				return nil, nil
+			}
+			for i := 0; i < len(x.Elems); i += 2 {
+				k, kt := c.expr(x.Elems[i])
+				v, vt := c.expr(x.Elems[i+1])
+				if k == nil || v == nil || !c.assignable(x.Elems[i].Pos, "key", kt, u.Key()) || !c.assignable(x.Elems[i+1].Pos, "value", vt, u.Elem()) {
+					return nil, nil
+				}
+				kv := &syntax.KeyValueExpr{Key: k, Value: v}
+				kv.SetPos(c.pos(x.Elems[i].Pos))
+				lit.ElemList = append(lit.ElemList, kv)
+			}
+			lit.NKeys = len(lit.ElemList)
+		default:
+			c.errorf(x.Pos, "ergoir: literal of %v", t)
+			return nil, nil
+		}
+		lit.Rbrace = pos
+		ergoValue(lit, t, nil)
+		return lit, t
+	}
+	if e, t, ok := c.failExpr(x); ok { // ergoir_fail.go
+		return e, t
+	}
+	if e, t, ok := c.unionExpr(x); ok { // ergoir_union.go
+		return e, t
+	}
+	if e, t, ok := c.closureExpr(x); ok { // ergoir_closure.go
+		return e, t
+	}
+	c.errorf(x.Pos, "ergoir: unknown expression %q", x.K)
+	return nil, nil
+}
+
+// binType is the type of lt op rt (spelled name), or nil (an error): Go's
+// rules for the basic types. Both operands have one type, except a
+// shift's count, which is any integer.
+func (c *ergoChecker) binType(p ergoPos, op syntax.Operator, name string, lt, rt types2.Type) types2.Type {
+	bad := func() types2.Type {
+		c.errorf(p, "ergoir: %s on %v and %v", name, lt, rt)
+		return nil
+	}
+	if op == syntax.Shl || op == syntax.Shr {
+		if !ergoIsInteger(lt) || !ergoIsInteger(rt) {
+			return bad()
+		}
+		return lt
+	}
+	if !c.assignable(p, name, rt, lt) {
+		return nil
+	}
+	switch op {
+	case syntax.Add:
+		if !ergoIsNumeric(lt) && !ergoIsString(lt) {
+			return bad()
+		}
+		return lt
+	case syntax.Sub, syntax.Mul, syntax.Div:
+		if !ergoIsNumeric(lt) {
+			return bad()
+		}
+		return lt
+	case syntax.Rem, syntax.And, syntax.Or, syntax.Xor, syntax.AndNot:
+		if !ergoIsInteger(lt) {
+			return bad()
+		}
+		return lt
+	case syntax.Eql, syntax.Neq:
+		if !types2.Comparable(lt) {
+			return bad()
+		}
+		return types2.Typ[types2.Bool]
+	case syntax.Lss, syntax.Leq, syntax.Gtr, syntax.Geq:
+		if !ergoOrdered(lt) {
+			return bad()
+		}
+		return types2.Typ[types2.Bool]
+	case syntax.AndAnd, syntax.OrOr:
+		if !ergoIsBool(lt) {
+			return bad()
+		}
+		return lt
+	}
+	return bad()
+}
+
+// ergoOrdered reports whether Go's < applies to t: a basic number or
+// string, or a type parameter whose type set holds only those (an Ergo
+// ordered parameter, GP-ORDER). types2 judges the type parameter: it
+// satisfies cmp.Ordered's type set, so a constraint with no type terms
+// is not ordered.
+func ergoOrdered(t types2.Type) bool {
+	if _, ok := t.(*types2.TypeParam); !ok {
+		return ergoIsNumeric(t) || ergoIsString(t)
+	}
+	return types2.Satisfies(t, ergoOrderedSet())
+}
+
+// ergoOrderedSet is cmp.Ordered: ~int | … | ~float64 | ~string.
+var ergoOrderedSet = sync.OnceValue(func() *types2.Interface {
+	var terms []*types2.Term
+	for _, k := range []types2.BasicKind{types2.Int, types2.Int8, types2.Int16, types2.Int32, types2.Int64, types2.Uint, types2.Uint8, types2.Uint16, types2.Uint32, types2.Uint64, types2.Uintptr, types2.Float32, types2.Float64, types2.String} {
+		terms = append(terms, types2.NewTerm(true, types2.Typ[k]))
+	}
+	it := types2.NewInterfaceType(nil, []types2.Type{types2.NewUnion(terms)})
+	// Its type set is computed here, once (types2 has no Complete): computed
+	// lazily, two decoder goroutines would both write the one shared value.
+	it.IsMethodSet()
+	return it
+})
+
+// ergoFuncConv reports a conversion between a function type and a type
+// defined over it (Seq[T] of a function literal): identical signatures,
+// which Go converts as identical underlying types (GP-DEFINED).
+func ergoFuncConv(t, from types2.Type) bool {
+	ts, ok := types2.CoreType(t).(*types2.Signature)
+	if !ok {
+		return false
+	}
+	fs, ok := types2.CoreType(from).(*types2.Signature)
+	return ok && types2.Identical(ts, fs)
+}
+
+// ergoConstConv is T(v) of a constant v of type from, a constant of type
+// to, as Go's checker folds a constant conversion: the conversion's tree
+// is then the literal the text's T(v) compiles to, not a conversion of
+// one. nil (no fold) when v is not a constant, or the kinds differ in a
+// way the fold would round: an integer to any integer type that holds
+// it, a float to a float of its size, a string or a bool to its kind.
+//
+// A constant the target cannot hold is never folded. Ergo's checker
+// refuses it in source, where gc refuses int8(300): "the constant N
+// overflows T", and for a float that is not whole, "the constant X
+// truncates to an integer" (check/operators.go, conversion; rows in
+// check's TestLiteralRules). A named target takes such a constant only
+// through its base, so the base's conversion is the one refused. A read
+// of a package let is a value, not a constant (TestConstLetsStayValues),
+// so int8(Big + 100) wraps at run time as Ergo means; left unfolded here,
+// it does the same.
+func ergoConstConv(v constant.Value, from, to types2.Type) constant.Value {
+	switch {
+	case v == nil:
+		return nil
+	case ergoIsInteger(from) && ergoIsInteger(to) && v.Kind() == constant.Int:
+		return ergoConstant(to, v.ExactString())
+	case ergoIsFloat(from) && ergoIsFloat(to):
+		if ergoFloat32(from) == ergoFloat32(to) {
+			return v
+		}
+	case ergoIsString(from) && ergoIsString(to) && v.Kind() == constant.String,
+		ergoIsBool(from) && ergoIsBool(to) && v.Kind() == constant.Bool:
+		return v
+	}
+	return nil
+}
+
+func ergoFloat32(t types2.Type) bool {
+	b, _ := types2.CoreType(t).(*types2.Basic)
+	return b != nil && b.Kind() == types2.Float32
+}
diff --git a/src/cmd/compile/internal/ergoir/ergoir_f7.go b/src/cmd/compile/internal/ergoir/ergoir_f7.go
