{
  "name": "@cevr/work",
  "version": "0.1.0",
  "description": "Copy-on-write workspaces of any Git repository: a full clone (installed packages and build output included) in one call, with a name, an id, a branch and a lifecycle. Replaces Rift.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cevr/ergo.git",
    "directory": "tools/npm/work"
  },
  "bin": {
    "work": "bin/work"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "bin/work",
    "install.js",
    "README.md"
  ],
  "optionalDependencies": {
    "@cevr/work-linux-x64": "0.1.0",
    "@cevr/work-linux-arm64": "0.1.0",
    "@cevr/work-darwin-arm64": "0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
