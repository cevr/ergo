// ReachChecked sends code.Reader's Reach over send and validates its Outcome.
func ReachChecked(client CheckedClient, q code.ReachQuery) code.ReachPage fails code.NoSymbol | code.Ambiguous | rpc.Transport {
	match try client.send(ReachRequest{Q: q}) {
