		case _:
			Unreachable("codeapi: MachineOf was answered with a failure outside its row")
		}
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Describe code.Summary, Symbols code.SymbolPage, Symbol code.Decl, References code.SitePage, Calls code.CallPage, Api code.ApiView, Reach code.ReachPage, MachineOf code.MachineView }

func inRow(op Op, f Failure) bool {
	match op {
	case SymbolOp:
		match f {
		case NoSymbol, Ambiguous:
			true
		case _:
			false
		}
	case ReferencesOp:
		match f {
		case NoSymbol, Ambiguous:
			true
		case _:
			false
		}
	case CallsOp:
		match f {
		case NoSymbol, Ambiguous, NotCallable:
			true
		case _:
			false
		}
	case ApiOp:
		match f {
		case NoPackage:
			true
		case _:
			false
		}
	case ReachOp:
		match f {
		case NoSymbol, Ambiguous:
			true
		case _:
			false
		}
	case MachineOfOp:
		match f {
		case NoSymbol, Ambiguous, NotMachine:
			true
		case _:
			false
		}
	case DescribeOp, SymbolsOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case DescribeRequest:
		Done{Reply: DescribeReply{Value: g.Values.Describe}}
	case SymbolsRequest:
		Done{Reply: SymbolsReply{Value: g.Values.Symbols}}
	case SymbolRequest:
		Done{Reply: SymbolReply{Value: g.Values.Symbol}}
	case ReferencesRequest:
		Done{Reply: ReferencesReply{Value: g.Values.References}}
	case CallsRequest:
		Done{Reply: CallsReply{Value: g.Values.Calls}}
	case ApiRequest:
		Done{Reply: ApiReply{Value: g.Values.Api}}
	case ReachRequest:
		Done{Reply: ReachReply{Value: g.Values.Reach}}
	case MachineOfRequest:
		Done{Reply: MachineOfReply{Value: g.Values.MachineOf}}
	}
}

func scripted(want Outcome, sent sync.Ref[[]Request]) Client {
	NewClient(func(q Request) Outcome {
		sent.Update(func(rs []Request) []Request { rs.Append(q) })
		want
	})
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { code.Reader: scripted(want, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a Client whose send is Call answers each call as the
// provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(want, sent)
	let outer = NewClient(func(q Request) Outcome {
		with context { code.Reader: inner } { Call(q) }
	})
	let got = with context { code.Reader: outer } { Call(r) }
	got == want && sent.Get() == []Request{r}
}
