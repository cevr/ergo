import code
import json
import rpc
import scope
import sync

// Request is one call of code.Reader: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = DescribeRequest{} | SymbolsRequest{Q code.SymbolQuery} | SymbolRequest{A string} | ReferencesRequest{Q code.RefQuery} | CallsRequest{Q code.CallQuery} | ApiRequest{Q code.ApiQuery} | ReachRequest{Q code.ReachQuery} | MachineOfRequest{A string}

// Op is an operation of code.Reader: what a policy matches on.
type Op = DescribeOp{} | SymbolsOp{} | SymbolOp{} | ReferencesOp{} | CallsOp{} | ApiOp{} | ReachOp{} | MachineOfOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = DescribeReply{Value code.Summary} | SymbolsReply{Value code.SymbolPage} | SymbolReply{Value code.Decl} | ReferencesReply{Value code.SitePage} | CallsReply{Value code.CallPage} | ApiReply{Value code.ApiView} | ReachReply{Value code.ReachPage} | MachineOfReply{Value code.MachineView}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = NoSymbol{E code.NoSymbol} | Ambiguous{E code.Ambiguous} | NotCallable{E code.NotCallable} | NoPackage{E code.NoPackage} | NotMachine{E code.NotMachine}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case DescribeRequest:
		DescribeOp
	case SymbolsRequest:
		SymbolsOp
	case SymbolRequest:
		SymbolOp
	case ReferencesRequest:
		ReferencesOp
	case CallsRequest:
		CallsOp
	case ApiRequest:
		ApiOp
	case ReachRequest:
		ReachOp
	case MachineOfRequest:
		MachineOfOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case DescribeOp:
		"describe"
	case SymbolsOp:
		"symbols"
	case SymbolOp:
		"symbol"
	case ReferencesOp:
		"references"
	case CallsOp:
		"calls"
	case ApiOp:
		"api"
	case ReachOp:
		"reach"
	case MachineOfOp:
		"machine-of"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case DescribeOp:
		"Describe is the revision and the extent of the tables."
	case SymbolsOp:
		"Symbols is a page of the declarations q asks for."
	case SymbolOp:
		"Symbol is the declaration at the address a."
	case ReferencesOp:
		"References is a page of the sites of the declaration at q.Of."
	case CallsOp:
		"Calls is a page of the calls out of the declaration at q.Of, or into it, to a depth."
	case ApiOp:
		"Api is the contracts of a package's exported functions."
	case ReachOp:
		"Reach is a page of the functions whose row holds a capability, each with a chain of calls that brings it, and where withs discharge it."
	case MachineOfOp:
		"MachineOf is the graph of the machine declaration at a, and the pairs a run of it can step."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case DescribeOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case SymbolsOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"match\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"kind\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"package\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"offset\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"limit\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"name\",\"match\",\"kind\",\"package\",\"offset\",\"limit\"]}")
	case SymbolOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"]}")
	case ReferencesOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"of\":{\"type\":\"string\"},\"kinds\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"offset\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"limit\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"of\",\"kinds\",\"offset\",\"limit\"]}")
	case CallsOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"of\":{\"type\":\"string\"},\"direction\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"depth\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"offset\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"limit\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"of\",\"direction\",\"depth\",\"offset\",\"limit\"]}")
	case ApiOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"package\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"package\"]}")
	case ReachOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"of\":{\"type\":\"string\"},\"offset\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"limit\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"of\",\"offset\",\"limit\"]}")
	case MachineOfOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"]}")
	}
}

// Call answers r on the bound code.Reader: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs code.Reader {
	match r {
	case DescribeRequest:
		let v = code.Reader.Describe()
		Done{Reply: DescribeReply{Value: v}}
	case SymbolsRequest as x:
		let v = code.Reader.Symbols(x.Q)
		Done{Reply: SymbolsReply{Value: v}}
	case SymbolRequest as x:
		let v = code.Reader.Symbol(x.A) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		}
		Done{Reply: SymbolReply{Value: v}}
	case ReferencesRequest as x:
		let v = code.Reader.References(x.Q) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		}
		Done{Reply: ReferencesReply{Value: v}}
	case CallsRequest as x:
		let v = code.Reader.Calls(x.Q) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		case code.NotCallable as e:
			return Rejected{Failure: NotCallable{E: e}}
		}
		Done{Reply: CallsReply{Value: v}}
	case ApiRequest as x:
		let v = code.Reader.Api(x.Q) catch {
		case code.NoPackage as e:
			return Rejected{Failure: NoPackage{E: e}}
		}
		Done{Reply: ApiReply{Value: v}}
	case ReachRequest as x:
		let v = code.Reader.Reach(x.Q) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		}
		Done{Reply: ReachReply{Value: v}}
	case MachineOfRequest as x:
		let v = code.Reader.MachineOf(x.A) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		case code.NotMachine as e:
			return Rejected{Failure: NotMachine{E: e}}
		}
		Done{Reply: MachineOfReply{Value: v}}
	}
}

// Client provides code.Reader by invoking typed per-operation handlers directly:
// a direct call returns its exact value or declared failure row with no Outcome boxing.
type Client { opDescribe func() code.Summary, opSymbols func(code.SymbolQuery) code.SymbolPage, opSymbol func(string) code.Decl fails code.NoSymbol | code.Ambiguous, opReferences func(code.RefQuery) code.SitePage fails code.NoSymbol | code.Ambiguous, opCalls func(code.CallQuery) code.CallPage fails code.NoSymbol | code.Ambiguous | code.NotCallable, opApi func(code.ApiQuery) code.ApiView fails code.NoPackage, opReach func(code.ReachQuery) code.ReachPage fails code.NoSymbol | code.Ambiguous, opMachineOf func(string) code.MachineView fails code.NoSymbol | code.Ambiguous | code.NotMachine } implements code.Reader

// NewClient is the code.Reader that invokes inner directly per operation.
func NewClient(inner code.Reader) Client {
	Client{
		opDescribe:   func() code.Summary { inner.Describe() },
		opSymbols:    func(q code.SymbolQuery) code.SymbolPage { inner.Symbols(q) },
		opSymbol:     func(a string) code.Decl fails code.NoSymbol | code.Ambiguous { try inner.Symbol(a) },
		opReferences: func(q code.RefQuery) code.SitePage fails code.NoSymbol | code.Ambiguous { try inner.References(q) },
		opCalls:      func(q code.CallQuery) code.CallPage fails code.NoSymbol | code.Ambiguous | code.NotCallable { try inner.Calls(q) },
		opApi:        func(q code.ApiQuery) code.ApiView fails code.NoPackage { try inner.Api(q) },
		opReach:      func(q code.ReachQuery) code.ReachPage fails code.NoSymbol | code.Ambiguous { try inner.Reach(q) },
		opMachineOf:  func(a string) code.MachineView fails code.NoSymbol | code.Ambiguous | code.NotMachine { try inner.MachineOf(a) },
	}
}

// ClientInForce is the code.Reader that invokes the provider currently in force.
func ClientInForce() Client needs code.Reader {
	let held = scope.InForce[code.Reader]()
	Client{
		opDescribe:   func() code.Summary { with held { code.Reader.Describe() } },
		opSymbols:    func(q code.SymbolQuery) code.SymbolPage { with held { code.Reader.Symbols(q) } },
		opSymbol:     func(a string) code.Decl fails code.NoSymbol | code.Ambiguous { with held { try code.Reader.Symbol(a) } },
		opReferences: func(q code.RefQuery) code.SitePage fails code.NoSymbol | code.Ambiguous { with held { try code.Reader.References(q) } },
		opCalls:      func(q code.CallQuery) code.CallPage fails code.NoSymbol | code.Ambiguous | code.NotCallable { with held { try code.Reader.Calls(q) } },
		opApi:        func(q code.ApiQuery) code.ApiView fails code.NoPackage { with held { try code.Reader.Api(q) } },
		opReach:      func(q code.ReachQuery) code.ReachPage fails code.NoSymbol | code.Ambiguous { with held { try code.Reader.Reach(q) } },
		opMachineOf:  func(a string) code.MachineView fails code.NoSymbol | code.Ambiguous | code.NotMachine { with held { try code.Reader.MachineOf(a) } },
	}
}

// Describe invokes code.Reader's Describe directly.
func Describe(client Client) code.Summary {
	client.opDescribe()
}

// Symbols invokes code.Reader's Symbols directly.
func Symbols(client Client, q code.SymbolQuery) code.SymbolPage {
	client.opSymbols(q)
}

// Symbol invokes code.Reader's Symbol directly.
func Symbol(client Client, a string) code.Decl fails code.NoSymbol | code.Ambiguous {
	try client.opSymbol(a)
}

// References invokes code.Reader's References directly.
func References(client Client, q code.RefQuery) code.SitePage fails code.NoSymbol | code.Ambiguous {
	try client.opReferences(q)
}

// Calls invokes code.Reader's Calls directly.
func Calls(client Client, q code.CallQuery) code.CallPage fails code.NoSymbol | code.Ambiguous | code.NotCallable {
	try client.opCalls(q)
}

// Api invokes code.Reader's Api directly.
func Api(client Client, q code.ApiQuery) code.ApiView fails code.NoPackage {
	try client.opApi(q)
}

// Reach invokes code.Reader's Reach directly.
func Reach(client Client, q code.ReachQuery) code.ReachPage fails code.NoSymbol | code.Ambiguous {
	try client.opReach(q)
}

// MachineOf invokes code.Reader's MachineOf directly.
func MachineOf(client Client, a string) code.MachineView fails code.NoSymbol | code.Ambiguous | code.NotMachine {
	try client.opMachineOf(a)
}

// CheckedClient carries erased code.Reader requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// DescribeChecked sends code.Reader's Describe over send and validates its Outcome.
func DescribeChecked(client CheckedClient) code.Summary fails rpc.Transport {
	match try client.send(DescribeRequest) {
	case Done as done:
		match done.Reply {
		case DescribeReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "codeapi: Describe was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "codeapi: Describe was answered with a failure outside its row"}
	}
}

// SymbolsChecked sends code.Reader's Symbols over send and validates its Outcome.
func SymbolsChecked(client CheckedClient, q code.SymbolQuery) code.SymbolPage fails rpc.Transport {
	match try client.send(SymbolsRequest{Q: q}) {
	case Done as done:
		match done.Reply {
		case SymbolsReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "codeapi: Symbols was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "codeapi: Symbols was answered with a failure outside its row"}
	}
}

// SymbolChecked sends code.Reader's Symbol over send and validates its Outcome.
func SymbolChecked(client CheckedClient, a string) code.Decl fails code.NoSymbol | code.Ambiguous | rpc.Transport {
	match try client.send(SymbolRequest{A: a}) {
	case Done as done:
		match done.Reply {
		case SymbolReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "codeapi: Symbol was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NoSymbol as failure:
			return failure.E
		case Ambiguous as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "codeapi: Symbol was answered with a failure outside its row"}
		}
	}
}

// ReferencesChecked sends code.Reader's References over send and validates its Outcome.
func ReferencesChecked(client CheckedClient, q code.RefQuery) code.SitePage fails code.NoSymbol | code.Ambiguous | rpc.Transport {
	match try client.send(ReferencesRequest{Q: q}) {
	case Done as done:
		match done.Reply {
		case ReferencesReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "codeapi: References was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NoSymbol as failure:
			return failure.E
		case Ambiguous as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "codeapi: References was answered with a failure outside its row"}
		}
	}
}

// CallsChecked sends code.Reader's Calls over send and validates its Outcome.
func CallsChecked(client CheckedClient, q code.CallQuery) code.CallPage fails code.NoSymbol | code.Ambiguous | code.NotCallable | rpc.Transport {
	match try client.send(CallsRequest{Q: q}) {
	case Done as done:
		match done.Reply {
		case CallsReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "codeapi: Calls was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NoSymbol as failure:
			return failure.E
		case Ambiguous as failure:
			return failure.E
		case NotCallable as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "codeapi: Calls was answered with a failure outside its row"}
		}
	}
}

// ApiChecked sends code.Reader's Api over send and validates its Outcome.
func ApiChecked(client CheckedClient, q code.ApiQuery) code.ApiView fails code.NoPackage | rpc.Transport {
	match try client.send(ApiRequest{Q: q}) {
	case Done as done:
		match done.Reply {
		case ApiReply as reply:
