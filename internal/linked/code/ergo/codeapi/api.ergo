// MachineOfChecked sends code.Reader's MachineOf over send and validates its Outcome.
func MachineOfChecked(client CheckedClient, a string) code.MachineView fails code.NoSymbol | code.Ambiguous | code.NotMachine | rpc.Transport {
	match try client.send(MachineOfRequest{A: a}) {
	case Done as done:
		match done.Reply {
		case MachineOfReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "codeapi: MachineOf was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NoSymbol as failure:
			return failure.E
		case Ambiguous as failure:
			return failure.E
		case NotMachine as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "codeapi: MachineOf was answered with a failure outside its row"}
		}
