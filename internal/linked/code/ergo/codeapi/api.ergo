}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Describe code.Summary, Symbols code.SymbolPage, Symbol code.Decl, References code.SitePage, Calls code.CallPage, Api code.ApiView, Reach code.ReachPage, MachineOf code.MachineView }

func inRow(op Op, f Failure) bool {
	match op {
	case SymbolOp:
		match f {
		case NoSymbol, Ambiguous:
			true
		case _:
			false
		}
	case ReferencesOp:
		match f {
		case NoSymbol, Ambiguous:
			true
		case _:
			false
		}
	case CallsOp:
		match f {
		case NoSymbol, Ambiguous, NotCallable:
			true
		case _:
			false
		}
	case ApiOp:
		match f {
		case NoPackage:
			true
		case _:
			false
		}
	case ReachOp:
		match f {
		case NoSymbol, Ambiguous:
			true
		case _:
			false
		}
	case MachineOfOp:
		match f {
		case NoSymbol, Ambiguous, NotMachine:
			true
		case _:
			false
		}
	case DescribeOp, SymbolsOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case DescribeRequest:
		Done{Reply: DescribeReply{Value: g.Values.Describe}}
	case SymbolsRequest:
		Done{Reply: SymbolsReply{Value: g.Values.Symbols}}
	case SymbolRequest:
		Done{Reply: SymbolReply{Value: g.Values.Symbol}}
	case ReferencesRequest:
		Done{Reply: ReferencesReply{Value: g.Values.References}}
	case CallsRequest:
		Done{Reply: CallsReply{Value: g.Values.Calls}}
	case ApiRequest:
		Done{Reply: ApiReply{Value: g.Values.Api}}
	case ReachRequest:
		Done{Reply: ReachReply{Value: g.Values.Reach}}
	case MachineOfRequest:
		Done{Reply: MachineOfReply{Value: g.Values.MachineOf}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opDescribe: func() code.Summary {
			sent.Update(func(rs []Request) []Request { rs.Append(DescribeRequest) })
			g.Values.Describe
		},
		opSymbols: func(q code.SymbolQuery) code.SymbolPage {
			sent.Update(func(rs []Request) []Request { rs.Append(SymbolsRequest{Q: q}) })
			g.Values.Symbols
		},
		opSymbol: func(a string) code.Decl fails code.NoSymbol | code.Ambiguous {
			sent.Update(func(rs []Request) []Request { rs.Append(SymbolRequest{A: a}) })
			if g.Failing {
				match g.Failure {
				case NoSymbol as err:
					return err.E
				case Ambiguous as err:
					return err.E
				case _:
				}
			}
			g.Values.Symbol
		},
		opReferences: func(q code.RefQuery) code.SitePage fails code.NoSymbol | code.Ambiguous {
			sent.Update(func(rs []Request) []Request { rs.Append(ReferencesRequest{Q: q}) })
			if g.Failing {
				match g.Failure {
				case NoSymbol as err:
					return err.E
				case Ambiguous as err:
					return err.E
				case _:
				}
			}
			g.Values.References
		},
		opCalls: func(q code.CallQuery) code.CallPage fails code.NoSymbol | code.Ambiguous | code.NotCallable {
			sent.Update(func(rs []Request) []Request { rs.Append(CallsRequest{Q: q}) })
			if g.Failing {
				match g.Failure {
				case NoSymbol as err:
					return err.E
				case Ambiguous as err:
					return err.E
				case NotCallable as err:
					return err.E
				case _:
				}
			}
			g.Values.Calls
		},
		opApi: func(q code.ApiQuery) code.ApiView fails code.NoPackage {
			sent.Update(func(rs []Request) []Request { rs.Append(ApiRequest{Q: q}) })
			if g.Failing {
				match g.Failure {
				case NoPackage as err:
					return err.E
				case _:
				}
			}
			g.Values.Api
		},
		opReach: func(q code.ReachQuery) code.ReachPage fails code.NoSymbol | code.Ambiguous {
			sent.Update(func(rs []Request) []Request { rs.Append(ReachRequest{Q: q}) })
			if g.Failing {
				match g.Failure {
				case NoSymbol as err:
					return err.E
				case Ambiguous as err:
					return err.E
				case _:
				}
			}
			g.Values.Reach
		},
		opMachineOf: func(a string) code.MachineView fails code.NoSymbol | code.Ambiguous | code.NotMachine {
			sent.Update(func(rs []Request) []Request { rs.Append(MachineOfRequest{A: a}) })
			if g.Failing {
				match g.Failure {
				case NoSymbol as err:
					return err.E
				case Ambiguous as err:
					return err.E
				case NotMachine as err:
					return err.E
				case _:
				}
			}
			g.Values.MachineOf
		},
	}
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case DescribeRequest:
		let v = DescribeChecked(client) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: DescribeReply{Value: v}}
	case SymbolsRequest as x:
		let v = SymbolsChecked(client, x.Q) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: SymbolsReply{Value: v}}
	case SymbolRequest as x:
		let v = SymbolChecked(client, x.A) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: SymbolReply{Value: v}}
	case ReferencesRequest as x:
		let v = ReferencesChecked(client, x.Q) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: ReferencesReply{Value: v}}
	case CallsRequest as x:
		let v = CallsChecked(client, x.Q) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		case code.NotCallable as e:
			return Rejected{Failure: NotCallable{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: CallsReply{Value: v}}
	case ApiRequest as x:
		let v = ApiChecked(client, x.Q) catch {
		case code.NoPackage as e:
			return Rejected{Failure: NoPackage{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: ApiReply{Value: v}}
	case ReachRequest as x:
		let v = ReachChecked(client, x.Q) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: ReachReply{Value: v}}
	case MachineOfRequest as x:
		let v = MachineOfChecked(client, x.A) catch {
		case code.NoSymbol as e:
			return Rejected{Failure: NoSymbol{E: e}}
		case code.Ambiguous as e:
			return Rejected{Failure: Ambiguous{E: e}}
		case code.NotMachine as e:
			return Rejected{Failure: NotMachine{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: MachineOfReply{Value: v}}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { code.Reader: scripted(g, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(g, sent)
	let outer = NewClient(inner)
	let got = with context { code.Reader: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted(g, sentChecked)
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { code.Reader: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
