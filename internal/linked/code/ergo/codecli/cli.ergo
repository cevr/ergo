	let f0 = flag.RequiredString("q-json", "q (code.CallQuery, as JSON)")
	let usage = codeapi.Doc(codeapi.CallsOp)
	flag.Command[Request]{Name: "calls", Usage: usage, Set: flag.Set{Name: "calls", Usage: usage, Flags: []flag.Flag{f0}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		let j1 = json.Decode(json.Codec[code.CallQuery]{MaxBytes: 1048576, MaxDepth: 64}, f0.Get(v)) catch {
