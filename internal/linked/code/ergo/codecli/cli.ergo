func commandMachineOf() flag.Command[Request] {
	let a0 = flag.Arg("a", "a (string)")
	let usage = codeapi.Doc(codeapi.MachineOfOp)
	flag.Command[Request]{Name: "machine-of", Usage: usage, Set: flag.Set{Name: "machine-of", Usage: usage, Flags: []flag.Flag{}, Args: []flag.ArgSpec{a0}}, Build: func(v flag.Values) Request fails flag.Failure {
		let t1 = argText(a0, v)
		codeapi.MachineOfRequest{A: t1}
	}, Commands: []flag.Command[Request]{}}
}

func argText(a flag.ArgSpec, v flag.Values) string {
	match a.Get(v) {
	case Some[string] as s:
		s.Value
	case None:
		""
	}
}

// Parse reads args as a command line of code.Reader: a command and its
// flags and arguments. It builds only the command args[0] names; the
// list of every command is built only for help or an unknown command.
func Parse(args []string) Request fails flag.Failure {
	let first = if len(args) > 0 { args[0] } else { "" }
	match first {
	case "describe":
		let c = commandDescribe()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code describe"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "symbols":
		let c = commandSymbols()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code symbols"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "symbol":
		let c = commandSymbol()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code symbol"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "references":
		let c = commandReferences()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code references"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "calls":
		let c = commandCalls()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code calls"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "api":
		let c = commandApi()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code api"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "reach":
		let c = commandReach()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code reach"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "machine-of":
		let c = commandMachineOf()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "code machine-of"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case _:
		try flag.ParseCommand("code", "code.Reader on a command line", Commands(), args)
	}
}

// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case codeapi.DescribeRequest:
		[]string{"describe"}
	case codeapi.SymbolsRequest as x:
		let mut out = []string{"symbols"}
		out = out.Append("-q-json=" + json.Encode(json.Codec[code.SymbolQuery]{MaxBytes: 0, MaxDepth: 0}, x.Q))
		out
	case codeapi.SymbolRequest as x:
		let mut out = []string{"symbol"}
		out = out.Append("--")
		out = out.Append("\(x.A)")
		out
	case codeapi.ReferencesRequest as x:
		let mut out = []string{"references"}
		out = out.Append("-q-json=" + json.Encode(json.Codec[code.RefQuery]{MaxBytes: 0, MaxDepth: 0}, x.Q))
		out
	case codeapi.CallsRequest as x:
		let mut out = []string{"calls"}
		out = out.Append("-q-json=" + json.Encode(json.Codec[code.CallQuery]{MaxBytes: 0, MaxDepth: 0}, x.Q))
		out
	case codeapi.ApiRequest as x:
		let mut out = []string{"api"}
		out = out.Append("-q-json=" + json.Encode(json.Codec[code.ApiQuery]{MaxBytes: 0, MaxDepth: 0}, x.Q))
		out
	case codeapi.ReachRequest as x:
		let mut out = []string{"reach"}
		out = out.Append("-q-json=" + json.Encode(json.Codec[code.ReachQuery]{MaxBytes: 0, MaxDepth: 0}, x.Q))
		out
	case codeapi.MachineOfRequest as x:
		let mut out = []string{"machine-of"}
		out = out.Append("--")
		out = out.Append("\(x.A)")
		out
	}
}

// RoundTrips reports whether Parse reads what Print writes of r as r.
func RoundTrips(r Request) bool {
	let back = Parse(Print(r)) catch {
	case flag.Failure:
		return false
	}
	back == r
}

// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// Policy is what a binary decides of its command line: Code, the exit
// status of a typed failure (default 1); Text, the text of a value
// without --json (default None: a basic value as its text, else its
// JSON; --json never calls it); Confirm, the question a call asks before
// it runs (default None: none; --yes answers it).
type Policy { Code func(f codeapi.Failure) int, Text func(r codeapi.Reply) Option[string], Confirm func(r Request) Option[string] }

// Defaults is the Policy of a binary that decides nothing.
func Defaults() Policy {
	Policy{Code: func(f codeapi.Failure) int { 1 }, Text: func(r codeapi.Reply) Option[string] { None }, Confirm: func(r Request) Option[string] { None }}
}

func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else {
		Output{Out: line(plain), Err: "", Code: 0}
	}
}

func line(s string) string {
	if s == "" {
		return ""
	}
	s + "\n"
}

func failed(asJSON bool, tagged string, status int) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: status}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: status}
	}
}

// Show is what Run prints of the outcome o under the policy p: the value
// (p's Text when it has one and there is no --json; else its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed) with p's Code.
func Show(o codeapi.Outcome, asJSON bool, p Policy) Output {
	match o {
	case codeapi.Done as done:
		if !asJSON {
			match p.Text(done.Reply) {
			case Some[string] as s:
				return Output{Out: line(s.Value), Err: "", Code: 0}
			case None:
			}
		}
		match done.Reply {
		case codeapi.DescribeReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case codeapi.SymbolsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case codeapi.SymbolReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case codeapi.ReferencesReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case codeapi.CallsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case codeapi.ApiReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case codeapi.ReachReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case codeapi.MachineOfReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		}
	case codeapi.Rejected as rejected:
		let status = p.Code(rejected.Failure)
		match rejected.Failure {
		case codeapi.NoSymbol as failure:
			failed(asJSON, rpc.Tagged("NoSymbol", rpc.Encode(failure.E)), status)
		case codeapi.Ambiguous as failure:
			failed(asJSON, rpc.Tagged("Ambiguous", rpc.Encode(failure.E)), status)
		case codeapi.NotCallable as failure:
			failed(asJSON, rpc.Tagged("NotCallable", rpc.Encode(failure.E)), status)
		case codeapi.NoPackage as failure:
			failed(asJSON, rpc.Tagged("NoPackage", rpc.Encode(failure.E)), status)
		case codeapi.NotMachine as failure:
			failed(asJSON, rpc.Tagged("NotMachine", rpc.Encode(failure.E)), status)
		}
	}
}

// Read is the outcome of r that the Output of Run with --json and its
// default status policy says: its value's JSON on standard output with
// status 0, or an admitted failure's tagged JSON with status 1. Invalid
// or missing replies fail Transport, outside the operation's own row.
func Read(r Request, out Output) codeapi.Outcome fails rpc.Transport {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case codeapi.DescribeRequest:
			let v = try rpc.Decode[code.Summary]("value", text)
			codeapi.Done{Reply: codeapi.DescribeReply{Value: v}}
		case codeapi.SymbolsRequest:
			let v = try rpc.Decode[code.SymbolPage]("value", text)
			codeapi.Done{Reply: codeapi.SymbolsReply{Value: v}}
		case codeapi.SymbolRequest:
			let v = try rpc.Decode[code.Decl]("value", text)
			codeapi.Done{Reply: codeapi.SymbolReply{Value: v}}
		case codeapi.ReferencesRequest:
			let v = try rpc.Decode[code.SitePage]("value", text)
			codeapi.Done{Reply: codeapi.ReferencesReply{Value: v}}
		case codeapi.CallsRequest:
			let v = try rpc.Decode[code.CallPage]("value", text)
			codeapi.Done{Reply: codeapi.CallsReply{Value: v}}
		case codeapi.ApiRequest:
			let v = try rpc.Decode[code.ApiView]("value", text)
			codeapi.Done{Reply: codeapi.ApiReply{Value: v}}
		case codeapi.ReachRequest:
			let v = try rpc.Decode[code.ReachPage]("value", text)
			codeapi.Done{Reply: codeapi.ReachReply{Value: v}}
		case codeapi.MachineOfRequest:
			let v = try rpc.Decode[code.MachineView]("value", text)
			codeapi.Done{Reply: codeapi.MachineOfReply{Value: v}}
		}
	} else if out.Code == 1 {
		match r {
		case codeapi.DescribeRequest:
			return rpc.Transport{Reason: "the command line answered Describe with an undeclared failure: " + text}
		case codeapi.SymbolsRequest:
			return rpc.Transport{Reason: "the command line answered Symbols with an undeclared failure: " + text}
		case codeapi.SymbolRequest:
			match rpc.TagOf(text) {
			case "NoSymbol":
				let e = try rpc.Decode[code.NoSymbol]("failure", text)
				codeapi.Rejected{Failure: codeapi.NoSymbol{E: e}}
			case "Ambiguous":
				let e = try rpc.Decode[code.Ambiguous]("failure", text)
				codeapi.Rejected{Failure: codeapi.Ambiguous{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered Symbol with an undeclared failure: " + text}
			}
		case codeapi.ReferencesRequest:
			match rpc.TagOf(text) {
			case "NoSymbol":
				let e = try rpc.Decode[code.NoSymbol]("failure", text)
				codeapi.Rejected{Failure: codeapi.NoSymbol{E: e}}
			case "Ambiguous":
				let e = try rpc.Decode[code.Ambiguous]("failure", text)
				codeapi.Rejected{Failure: codeapi.Ambiguous{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered References with an undeclared failure: " + text}
			}
		case codeapi.CallsRequest:
			match rpc.TagOf(text) {
			case "NoSymbol":
				let e = try rpc.Decode[code.NoSymbol]("failure", text)
				codeapi.Rejected{Failure: codeapi.NoSymbol{E: e}}
			case "Ambiguous":
				let e = try rpc.Decode[code.Ambiguous]("failure", text)
				codeapi.Rejected{Failure: codeapi.Ambiguous{E: e}}
			case "NotCallable":
				let e = try rpc.Decode[code.NotCallable]("failure", text)
				codeapi.Rejected{Failure: codeapi.NotCallable{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered Calls with an undeclared failure: " + text}
			}
		case codeapi.ApiRequest:
			match rpc.TagOf(text) {
			case "NoPackage":
				let e = try rpc.Decode[code.NoPackage]("failure", text)
				codeapi.Rejected{Failure: codeapi.NoPackage{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered Api with an undeclared failure: " + text}
			}
		case codeapi.ReachRequest:
			match rpc.TagOf(text) {
			case "NoSymbol":
				let e = try rpc.Decode[code.NoSymbol]("failure", text)
				codeapi.Rejected{Failure: codeapi.NoSymbol{E: e}}
			case "Ambiguous":
				let e = try rpc.Decode[code.Ambiguous]("failure", text)
				codeapi.Rejected{Failure: codeapi.Ambiguous{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered Reach with an undeclared failure: " + text}
			}
		case codeapi.MachineOfRequest:
			match rpc.TagOf(text) {
			case "NoSymbol":
				let e = try rpc.Decode[code.NoSymbol]("failure", text)
				codeapi.Rejected{Failure: codeapi.NoSymbol{E: e}}
			case "Ambiguous":
				let e = try rpc.Decode[code.Ambiguous]("failure", text)
				codeapi.Rejected{Failure: codeapi.Ambiguous{E: e}}
			case "NotMachine":
				let e = try rpc.Decode[code.NotMachine]("failure", text)
				codeapi.Rejected{Failure: codeapi.NotMachine{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered MachineOf with an undeclared failure: " + text}
			}
		}
	} else {
		return rpc.Transport{Reason: "the command line answered status \(out.Code): " + out.Err}
	}
}

type front = asked{R Request, JSON bool, Yes bool} | ended{O Output}

func frontOf(args []string) front {
	let mut asJSON = false
	let mut yes = false
	let mut globals = true
	let mut rest = []string{}
	for a in args {
		if globals && (a == "--json" || a == "-json") {
			asJSON = true
		} else if globals && (a == "--yes" || a == "-yes") {
			yes = true
		} else {
			globals = false
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return ended{O: Output{Out: h.Text, Err: "", Code: 0}}
	case err:
		return ended{O: Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}}
	}
	asked{R: r, JSON: asJSON, Yes: yes}
}

func needsYes(question string) Output {
	Output{Out: "", Err: question + " (no terminal to ask on: pass --yes to answer yes)\n", Code: 2}
}

func declined(question string) Output {
	Output{Out: "", Err: question + ": not confirmed\n", Code: 1}
}

func runOver[R](args []string, p Policy, answer func(r Request) codeapi.Outcome needs R) Output needs R {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				return needsYes(q.Value)
			case None:
			}
		}
		Show(answer(a.R), a.JSON, p)
	}
}

// Run reads args as [--json] [--yes] COMMAND ARGS..., answers the call
// through the hub's Call on the code.Reader the caller binds, and is what to
// print under the policy p: the value, a typed failure with p's Code, the
// help (status 0) or a usage error (status 2). It asks nothing: a call p
// asks a question of needs --yes (status 2 without it).
func Run(args []string, p Policy) Output needs code.Reader {
	runOver(args, p, codeapi.Call)
}

// RunOnTerminal is Run that asks p's question on the terminal (std
// prompt) when there is no --yes: a yes runs the call, a no or a cancel
// ends with status 1, and standard input that is not a terminal ends with
// status 2, as Run does.
func RunOnTerminal(args []string, p Policy) Output needs code.Reader | term.Terminal | io.Stderr {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				let yes = prompt.Confirm(q.Value, false) catch {
				case prompt.NotInteractive:
					return needsYes(q.Value)
				case prompt.Cancelled:
					return declined(q.Value)
				case io.ReadFailed:
					return Output{Out: "", Err: q.Value + ": the answer could not be read\n", Code: 2}
				}
				if !yes {
					return declined(q.Value)
				}
			case None:
			}
		}
		Show(codeapi.Call(a.R), a.JSON, p)
	}
}

// Completion is the script that completes code's commands in shell.
func Completion(shell api.Shell) string {
	api.Completion("code", shell, []api.Entry{api.Entry{Name: codeapi.Name(codeapi.DescribeOp), Doc: codeapi.Doc(codeapi.DescribeOp)}, api.Entry{Name: codeapi.Name(codeapi.SymbolsOp), Doc: codeapi.Doc(codeapi.SymbolsOp)}, api.Entry{Name: codeapi.Name(codeapi.SymbolOp), Doc: codeapi.Doc(codeapi.SymbolOp)}, api.Entry{Name: codeapi.Name(codeapi.ReferencesOp), Doc: codeapi.Doc(codeapi.ReferencesOp)}, api.Entry{Name: codeapi.Name(codeapi.CallsOp), Doc: codeapi.Doc(codeapi.CallsOp)}, api.Entry{Name: codeapi.Name(codeapi.ApiOp), Doc: codeapi.Doc(codeapi.ApiOp)}, api.Entry{Name: codeapi.Name(codeapi.ReachOp), Doc: codeapi.Doc(codeapi.ReachOp)}, api.Entry{Name: codeapi.Name(codeapi.MachineOfOp), Doc: codeapi.Doc(codeapi.MachineOfOp)}})
}

// Wire is the command line as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, codeapi.Outcome, rpc.Transport]

// Carry prints c with --json, runs it against answer using the default
// status policy, and reads back the reply. Delivery can fail separately
// from answer's outcome.
func Carry(w Wire, c Request, answer own func(c Request) codeapi.Outcome) codeapi.Outcome fails rpc.Transport {
	let mut args = []string{"--json"}
	for a in Print(c) {
		args = args.Append(a)
	}
	try Read(c, runOver(args, Defaults(), answer))
}

// Agrees: the command line carries every call and every outcome the
// call can have unchanged.
law Agrees(r Request, g codeapi.Given) { api.Agrees[Request, codeapi.Outcome, rpc.Transport](Wire, r, codeapi.OutcomeOf(r, g)) }

// CodeIsThePolicy: a call's status is 0 for a value and the policy's
// Code for a typed failure.
law CodeIsThePolicy(r Request, g codeapi.Given, k int) {
	let status = 1 + ((k%125)+125)%125
	let d = Defaults()
	let p = Policy{..d, Code: func(f codeapi.Failure) int { status }}
	let o = codeapi.OutcomeOf(r, g)
	let out = runOver(Print(r), p, func(c Request) codeapi.Outcome { o })
	match o {
	case codeapi.Done:
		out.Code == 0
	case codeapi.Rejected:
		out.Code == status
	}
}

// TextIsThePolicy: without --json a value prints as the policy's Text;
// with --json every outcome prints as the wire's JSON, whatever Text says.
law TextIsThePolicy(r Request, g codeapi.Given, t string) {
	let d = Defaults()
	let p = Policy{..d, Text: func(reply codeapi.Reply) Option[string] { Some[string]{Value: t} }}
	let o = codeapi.OutcomeOf(r, g)
	let same = Show(o, true, p) == Show(o, true, d)
	match o {
	case codeapi.Done:
		same && Show(o, false, p).Out == line(t)
	case codeapi.Rejected:
		same && Show(o, false, p) == Show(o, false, d)
	}
}
