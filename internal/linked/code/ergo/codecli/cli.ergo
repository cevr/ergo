import api
import code
import flag
import io
import json
import prompt
import rpc
import slices
import strings
import term
import codetool/codeapi

// Request is one call of code.Reader: the hub's Request.
type Request = codeapi.Request

// Output is what Run prints: std api's Output (Out to standard output,
// Err to standard error, and the exit status).
type Output = api.Output

// Commands are the commands of code.Reader, one per operation, in its order.
func Commands() []flag.Command[Request] {
	[]flag.Command[Request]{commandDescribe(), commandSymbols(), commandSymbol(), commandReferences(), commandCalls(), commandApi(), commandReach(), commandMachineOf()}
}

func commandDescribe() flag.Command[Request] {
	let usage = codeapi.Doc(codeapi.DescribeOp)
	flag.Command[Request]{Name: "describe", Usage: usage, Set: flag.Set{Name: "describe", Usage: usage, Flags: []flag.Flag{}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		codeapi.DescribeRequest
	}, Commands: []flag.Command[Request]{}}
}

func commandSymbols() flag.Command[Request] {
	let f0 = flag.RequiredString("q-json", "q (code.SymbolQuery, as JSON)")
	let usage = codeapi.Doc(codeapi.SymbolsOp)
	flag.Command[Request]{Name: "symbols", Usage: usage, Set: flag.Set{Name: "symbols", Usage: usage, Flags: []flag.Flag{f0}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		let j1 = json.Decode(json.Codec[code.SymbolQuery]{MaxBytes: 1048576, MaxDepth: 64}, f0.Get(v)) catch {
		case _:
			return flag.Invalid{Name: "q-json", Text: f0.Get(v), Reason: "not the JSON of a code.SymbolQuery"}
		}
		codeapi.SymbolsRequest{Q: j1}
	}, Commands: []flag.Command[Request]{}}
}

func commandSymbol() flag.Command[Request] {
	let a0 = flag.Arg("a", "a (string)")
	let usage = codeapi.Doc(codeapi.SymbolOp)
	flag.Command[Request]{Name: "symbol", Usage: usage, Set: flag.Set{Name: "symbol", Usage: usage, Flags: []flag.Flag{}, Args: []flag.ArgSpec{a0}}, Build: func(v flag.Values) Request fails flag.Failure {
		let t1 = argText(a0, v)
		codeapi.SymbolRequest{A: t1}
	}, Commands: []flag.Command[Request]{}}
}

func commandReferences() flag.Command[Request] {
	let f0 = flag.RequiredString("q-json", "q (code.RefQuery, as JSON)")
	let usage = codeapi.Doc(codeapi.ReferencesOp)
	flag.Command[Request]{Name: "references", Usage: usage, Set: flag.Set{Name: "references", Usage: usage, Flags: []flag.Flag{f0}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		let j1 = json.Decode(json.Codec[code.RefQuery]{MaxBytes: 1048576, MaxDepth: 64}, f0.Get(v)) catch {
		case _:
			return flag.Invalid{Name: "q-json", Text: f0.Get(v), Reason: "not the JSON of a code.RefQuery"}
		}
		codeapi.ReferencesRequest{Q: j1}
	}, Commands: []flag.Command[Request]{}}
}

