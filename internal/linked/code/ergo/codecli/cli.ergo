func commandReach() flag.Command[Request] {
	let f0 = flag.RequiredString("q-json", "q (code.ReachQuery, as JSON)")
	let usage = codeapi.Doc(codeapi.ReachOp)
	flag.Command[Request]{Name: "reach", Usage: usage, Set: flag.Set{Name: "reach", Usage: usage, Flags: []flag.Flag{f0}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		let j1 = json.Decode(json.Codec[code.ReachQuery]{MaxBytes: 1048576, MaxDepth: 64}, f0.Get(v)) catch {
