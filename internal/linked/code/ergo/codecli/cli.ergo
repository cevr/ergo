	let usage = codeapi.Doc(codeapi.ApiOp)
	flag.Command[Request]{Name: "api", Usage: usage, Set: flag.Set{Name: "api", Usage: usage, Flags: []flag.Flag{f0}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		let j1 = json.Decode(json.Codec[code.ApiQuery]{MaxBytes: 1048576, MaxDepth: 64}, f0.Get(v)) catch {
