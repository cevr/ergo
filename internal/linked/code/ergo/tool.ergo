// Package codetool is `ergo code`: the command line of std code's Reader,
// generated by `ergo gen cli` (package codecli), over an Index of the
// workspace's fact tables; and `ergo inspect api` and `ergo inspect
// machine`, views of Reader.Api and Reader.MachineOf. The ergo binary links its lowered Go
// (internal/linked/code; docs/tooling.md, Linked Ergo packages): it checks
// the workspace, writes the tables as JSON, and calls Run.

import code
import codetool/codecli
import json
import strconv

// Run is the output of `ergo code` with the arguments args over the tables
// whose JSON text is tables: its exit status, its standard output and its
// standard error, in that order.
func Run(args []string, tables string) []string {
	let t = tablesOf(tables) catch {
	case BadTables as b:
		return b.Out
	}
	with context { code.Reader: code.IndexOf(t) } {
		let out = codecli.Run(args, codecli.Defaults())
		[]string{strconv.Itoa(out.Code), out.Out, out.Err}
	}
}

// tablesOf is the tables whose JSON text is text, or the output of the
// failure to read them.
func tablesOf(text string) code.Tables fails BadTables {
	json.Decode(json.Codec[code.Tables]{MaxBytes: 1 << 40, MaxDepth: 16}, text) catch {
	case json.Malformed as m:
		return BadTables{Out: []string{"1", "", "ergo: the tables are not JSON at \(m.Offset): \(m.Reason)\n"}}
	case _:
		return BadTables{Out: []string{"1", "", "ergo: the tables do not decode as code.Tables\n"}}
	}
}

// BadTables is tables that do not decode, with the output that says so.
type BadTables { Out []string }

// rootApi is the contracts of the root package of tables.
func rootApi(t code.Tables) []code.Contract {
	with context { code.Reader: code.IndexOf(t) } {
		let v = code.Reader.Api(code.ApiQuery{Package: None}) catch {
		case code.NoPackage:
			return []code.Contract{}
		}
		v.Functions
	}
}

// Api is `ergo inspect api` over the tables whose JSON text is tables:
// the root package's contracts as text (ApiText), or as JSON with asJSON;
// its exit status, standard output and standard error.
func Api(tables string, asJSON bool) []string {
	let t = tablesOf(tables) catch {
	case BadTables as b:
		return b.Out
	}
	let fs = rootApi(t)
	[]string{"0", if asJSON { json.Encode(json.Codec[[]code.Contract]{MaxBytes: 1 << 40, MaxDepth: 16}, fs) } else { code.ApiText(fs) }, ""}
}

// ApiDiff is `ergo inspect api --diff`: the changed contracts from the
// root package of old to that of new, as text (ApiDiffText) or as JSON.
func ApiDiff(old string, new string, asJSON bool) []string {
	let a = tablesOf(old) catch {
	case BadTables as b:
		return b.Out
	}
	let b = tablesOf(new) catch {
	case BadTables as x:
		return x.Out
	}
	let changes = code.ApiDiff(rootApi(a), rootApi(b))
	[]string{"0", if asJSON { json.Encode(json.Codec[[]code.ApiChange]{MaxBytes: 1 << 40, MaxDepth: 16}, changes) } else { code.ApiDiffText(changes) }, ""}
}

// Machines is `ergo inspect machine` over the tables whose JSON text is
// tables: the view of each machine of the root package, in source order,
// as text (MachineText; "no machine" for none), or as JSON with asJSON.
func Machines(tables string, asJSON bool) []string {
	let t = tablesOf(tables) catch {
	case BadTables as b:
		return b.Out
	}
	let x = code.IndexOf(t)
	let mut views = []code.MachineView{}
	for p in t.Packages {
		if p.Path != t.Root {
			continue
		}
		for m in p.Machines {
			let v = with context { code.Reader: x } {
				code.Reader.MachineOf(m.Handle) catch {
				case _:
					return []string{"1", "", "ergo: machine \(m.Handle) is not in the tables\n"}
				}
			}
			views = views.Append(v)
		}
	}
	if asJSON {
		return []string{"0", json.Encode(json.Codec[[]code.MachineView]{MaxBytes: 1 << 40, MaxDepth: 16}, views), ""}
	}
	let mut b = ""
	for v in views {
		b = b + code.MachineText(v)
	}
	[]string{"0", if len(views) == 0 { "no machine\n" } else { b }, ""}
}
