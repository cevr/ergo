import task

type Problem {}

func step(ok bool) fails Problem {
	if !ok {
		return Problem
	}
}

func wait() {
	let t = task.Go() {}
	t.Wait()
}

func tryWait(ok bool) fails Problem {
	let t = task.Go() { try step(ok) }
	try t.Wait()
}

func tailWait(ok bool) fails Problem {
	let t = task.Go() { try step(ok) }
	return t.Wait()
}

func main() needs Console {
	wait()
	let mut tryOK = true
	tryWait(true) catch {
	case Problem:
		tryOK = false
	}
	let mut tryRejects = false
	tryWait(false) catch {
	case Problem:
		tryRejects = true
	}
	let mut tailRejects = false
	tailWait(false) catch {
	case Problem:
		tailRejects = true
	}
	Console.Println("try success: \(tryOK); try rejected: \(tryRejects); tail rejected: \(tailRejects)")
}
