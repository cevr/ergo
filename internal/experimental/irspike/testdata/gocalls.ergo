// IR-GOCALLS: Go calls that kept their source body take IR bodies, and
// each prints what the source body prints (IR-ONLY; PORT E-SQL, OT):
//   - show: a variadic Go function over go.Any (fmt.Sprint's `a ...any`),
//     each value converted to Go's any;
//   - pattern and host: a fallible Go call with a go.Ref result
//     (regexp.Compile, url.Parse), checked against Go's nil;
//   - stored: go.New, a Go method with a go.Any parameter and one with two
//     results (sync.Map's Store and Load), go.As on a go.Any;
//   - split: a fallible Go call with two results (net.SplitHostPort);
//   - zone: a Go method with two results and no error (time.Time.Zone);
//   - classify: go.Is and go.As on a go.Error, go.Zero.

import go fmt
import go regexp
import go sync
import go time
import go errors
import go io/fs
import go net
import go net/url

func show(n int) string needs go.Foreign {
	fmt.Sprint([]go.Any{"n=", n, " ", true, " ", 2.5})
}

func pattern(s string) bool fails go.Error needs go.Foreign {
	let re = try regexp.Compile("a+b")
	re.MatchString(s)
}

func host(raw string) string fails go.Error needs go.Foreign {
	let u = try url.Parse(raw)
	"\(u.Hostname()):\(u.Port())"
}

func stored() int needs go.Foreign {
	let m = go.New[sync.Map]()
	m.Store("k", 7)
	let (v, ok) = m.Load("k")
	if !ok {
		return -1
	}
	match go.As[int](v) {
	case Some{Value: n}:
		n
	case None:
		0
	}
}

func split(hp string) string fails go.Error needs go.Foreign {
	let (h, p) = try net.SplitHostPort(hp)
	"\(h)|\(p)"
}

func zone() string needs go.Foreign {
	let (name, off) = time.Unix(0, 0).UTC().Zone()
	"\(name) \(off)"
}

func classify(text string) int needs go.Foreign {
	errors.New(text) catch {
	case go.Error as e:
		let z = go.Zero[fs.PathError]()
		let _ = go.New(z)
		if !go.Is(e, e) {
			return -1
		}
		match go.As[go.Ref[fs.PathError]](e) {
		case Some{Value: _}:
			return 2
		case None:
			return 1
		}
	}
	0
}

func main() needs Console | go.Foreign {
	Console.Println(show(3))
	let p = pattern("xaab") catch {
	case _:
		false
	}
	Console.Println("pattern \(p)")
	let h = host("http://example.com:8080/x") catch {
	case _:
		"bad"
	}
	Console.Println("host \(h)")
	Console.Println("stored \(stored())")
	let s = split("a.b:9") catch {
	case _:
		"bad"
	}
	let t = split("nocolon") catch {
	case _:
		"failed"
	}
	Console.Println("split \(s) \(t)")
	Console.Println("zone \(zone())")
	Console.Println("classify \(classify("x"))")
}
