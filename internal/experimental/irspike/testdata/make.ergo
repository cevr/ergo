// The program of TestIRMake (IR-MAKE): sized's and presized's IR bodies
// return an empty slice literal, which the test rewrites to Go's
// make([]int, n) and make([]int, 0, n), the forms the decoder takes since
// IR-MAKE (a presize with a constant size stays on Go's stack).

extern go cap func capOf[T](xs []T) int

func sized(n int) []int {
	[]int{}
}

func presized(n int) []int {
	[]int{}
}

func main() needs Console {
	let a = sized(3)
	let b = presized(5)
	Console.Println("\(len(a)) \(capOf(a)) \(len(b)) \(capOf(b))")
}
