// IR-GOCALLS-4: a Go call bound with a go.Ref result that Go returns as
// nil with no error is a defect naming the Go target and the site
// (v1.GoNilDefect), on both paths. http.ProxyFromEnvironment returns nil
// and no error for a request that takes no proxy (localhost), though its
// binding says go.Ref. Without the IR's check (mutant
// irgc-nil-check-dropped) the IR path reads through Go's nil pointer and
// panics with another message.

import go net/http
import go strings

func proxy() int fails go.Error needs go.Foreign {
	let body = match strings.NewReader("") {
	case Some{Value: b}:
		b
	case None:
		return -2
	}
	let r = try http.NewRequest("GET", "http://localhost/", body)
	let u = try http.ProxyFromEnvironment(r)
	len(u.Host)
}

func main() needs Console | go.Foreign {
	Console.Println("start")
	let n = proxy() catch {
	case _:
		-1
	}
	Console.Println("proxy \(n)")
}
