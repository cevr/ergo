// The smallest repro of examples/regex's internal compiler error
// (REGEX-ICE): a return inside a Seq loop in a function literal.
// rangefunc.Rewrite turns that return into an assignment to the
// literal's results, naming them through its signature's scope, which a
// decoded literal's signature did not have (a nil-scope panic in gc).

func upTo(n int) Seq[int] {
	Seq[int](func(yield func(v int) bool) {
		for i in 0..n {
			if !yield(i) {
				return
			}
		}
	})
}

func over(xs Seq[int], k int) Seq[int] {
	Seq[int](func(yield func(v int) bool) {
		for x in xs {
			if x > k && !yield(x) {
				return
			}
		}
	})
}

func total(n int) int {
	let mut t = 0
	for v in over(upTo(n), 2) {
		if v > 6 {
			break
		}
		t = t + v
	}
	t
}

func main() needs Console {
	Console.Println("total \(total(9))")
}
