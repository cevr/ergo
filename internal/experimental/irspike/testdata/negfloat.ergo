// The smallest repro of a negative float64 constant whose Go text is not
// what was compiled (wf10 IRFIX-FLOAT, raytrace's Intersect): the decoder
// compiled -1e-12 as the rounded float64, while Go reads the text's
// (-1e-12) as the negation of an untyped literal and keeps -1/10^12.

func near(x float64) bool {
	x > -1e-12 && x < 1e-12
}
