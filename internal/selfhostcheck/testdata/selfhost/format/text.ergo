import strings

// maxOf is the larger of a and b: Ergo has no predeclared max (gaps.md).
func maxOf(a int, b int) int { if a > b { a } else { b } }

// minOf is the smaller of a and b.
func minOf(a int, b int) int { if a < b { a } else { b } }

// hasAt reports whether s holds text at byte offset i.
func hasAt(s string, i int, text string) bool {
	i >= 0 && i <= len(s) && len(text) <= len(s)-i && strings.Slice(s, i, i+len(text)) == text
}

// indexNewline is the offset of the first line break in s, or -1.
func indexNewline(s string) int {
	for i in 0..len(s) {
		if s[i] == '\n' {
			return i
		}
	}
	-1
}

// trimRightOf drops the bytes of cutset from the end of s, as Go's
// strings.TrimRight does for an ASCII cutset.
func trimRightOf(s string, cutset string) string {
	let mut n = len(s)
	for n > 0 && byteIn(s[n-1], cutset) {
		n -= 1
	}
	strings.Slice(s, 0, n)
}

func byteIn(c byte, set string) bool {
	for i in 0..len(set) {
		if set[i] == c {
			return true
		}
	}
	false
}

// isWordByte reports a byte that may continue a name or a number.
func isWordByte(c byte) bool {
	c == '_' || c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= 0x80
}

// merges reports the byte pairs that would lex as one token, or start a
// comment, if written without a blank between them.
func merges(a byte, b byte) bool {
	match a {
	case '-':
		b == '-' || b == '='
	case '+':
		b == '+' || b == '='
	case '&':
		b == '&' || b == '^' || b == '='
	case '|':
		b == '|' || b == '='
	case '<':
		b == '-' || b == '<' || b == '='
	case '>':
		b == '>' || b == '='
	case '=', '!', ':', '%', '^':
		b == '='
	case '.':
		b == '.'
	case '/':
		b == '/' || b == '*' || b == '='
	case '*':
		b == '=' || b == '/'
	case _:
		false
	}
}
