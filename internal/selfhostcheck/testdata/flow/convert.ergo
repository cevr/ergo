// A resource converted to an operation type with Close moves into the
// interface value (R23), and a with that names a resource provider lends
// it for its block, so the block cannot close it; an element of a package
// let has no owner to lend.

type Res { id int } implements Closer, Closes, Store

type Closes { ..Closer }

type Store { Get() int }

func Close(r Res) {}

func Get(r Res) int { r.id }

func open(n int) Res { Res{id: n} }

func lend(r Res) {}

func lendCloser(c Closes) {}

func converted() {
	let a = open(1)
	lendCloser(a)
	lend(a) //want: flow
}

let sharedList = []Res{Res{id: 0}}

func elementProvider() {
	with context { Store: sharedList[0] } { //want: flow
		let _ = Store.Get()
	}
}

func closedWhileLent() {
	let a = open(1)
	with context { Store: a } {
		a.Close() //want: flow
		let _ = Store.Get()
	}
}

func main() {}
