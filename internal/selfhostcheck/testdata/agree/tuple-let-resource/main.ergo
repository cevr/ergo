// A resource bound by a multi-name let and held only for its release at
// scope end is not unused (rows.go reportUnused: holdsResource; resources
// R42), from a call or from a catch (S3-UNUSED-TUPLE-RESOURCE, found by
// lane MX2).
type Res {} implements Closer

func Close(r Res) {}

type Bad {}

func open() (Res, int) { (Res, 1) }

func openOr(k int) (Res, int) fails Bad {
	if k < 0 {
		return Bad
	}
	(Res, k)
}

func main() needs Console {
	let r, n = open()
	let q, m = openOr(n) catch {
	case Bad:
		return
	}
	Console.Println("\(n) \(m)")
}
