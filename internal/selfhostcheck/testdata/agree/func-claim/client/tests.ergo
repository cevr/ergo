import functionclaims/foreign

test ConcreteClaimsUseTheirProviders {
	let (mapped, size, score, trimmed) = Check([]string{"abc", "d"}, func(x int) int { x + 7 }, foreign.Value{Score: 21})
	assert len(mapped) == 2
	assert mapped[0] == 3
	assert mapped[1] == 1
	assert size == 7
	assert score == 21
	assert trimmed == "centered"
	let (count, nonempty) = Measure([]int{4, 5, 6})
	assert count == 3
	assert nonempty
	assert Mutate() == 8
}
