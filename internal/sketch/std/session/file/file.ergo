// Package file is a session.Store kept in a file of the host, so its
// sessions outlive the process (docs/spec/stdlib.md, session). The file is
// a log of the changes, one line each, appended before any caller sees
// the outcome: Open replays them with session.Apply, a pure function of
// the policy, the state and the change, so the replay reaches the state
// the store had. A change the store refused (a Conflict, a Revoke that
// found nothing) is not kept.
//
// The lines are tab-separated fields: `est DIGEST "subject" REV SEC NSEC`,
// `rot OLD NEW SEC NSEC`, `rev DIGEST` and `all "subject" REV`, a digest
// in hex and a subject quoted by strconv.Quote. The log holds digests,
// never tokens. A crash inside an append can leave a part of the last
// line: Open drops it and writes the log back without it. A whole line
// that is not a change is a broken log, and Open fails naming it.
//
// One task at a time changes the store: each change takes the store's
// lock (a queue.Queue of one slot), applies it, and appends its line. A
// failed append leaves the state ahead of the log, so the store refuses
// every later call with Failed until it is opened again. One process
// opens the file at a time. The log is not compacted yet: it grows with
// every session begun and renewed.
//
// Effect: yielded/auth's StatefulSessionPersistence over a managed table.
// Go control: a sessions table, or an append-only log replayed at start.

import fs
import fstest
import queue
import session
import session/memory
import strconv
import strings
import sync
import time

// Store is the file store of policy p. Open makes one.
type Store {
	path   string,
	files  fs.Files,
	writes fs.Writes,
	policy session.Policy,
	state  sync.Ref[session.State],
	broken sync.Ref[bool],
	lock   queue.Queue[int],
} implements session.Store

// Open is the store of the log at path, read with files and written with
// writes, under policy p: an empty store when there is no file there yet.
// It fails when the log cannot be read, when a whole line of it is not a
// change, and when it cannot drop a cut last line.
func Open(files fs.Files, writes fs.Writes, path string, p session.Policy) Store fails session.Failed {
	let text = files.ReadFile(path) catch {
	case fs.NotFound:
		""
	case fs.Denied:
		return session.Failed{Reason: "\(path): permission denied"}
	case fs.Failed as f:
		return session.Failed{Reason: "\(path): \(f.Reason)"}
	}
	let mut s = session.Empty()
	let mut n = 0
	let mut whole = 0
	for raw in strings.Lines(text) {
		if !strings.HasSuffix(raw, "\n") {
			break
		}
		n = n + 1
		let op = try opOf(path, n, strings.TrimSuffix(raw, "\n"))
		let (_, next, _) = session.Apply(p, s, op)
		s = next
		whole = whole + len(raw)
	}
	if whole < len(text) {
		writes.WriteFile(path, strings.Slice(text, 0, whole)) catch {
		case fs.NotFound:
			return session.Failed{Reason: "\(path): no such directory"}
		case fs.Denied:
			return session.Failed{Reason: "\(path): permission denied"}
		case fs.Failed as f:
			return session.Failed{Reason: "\(path): \(f.Reason)"}
		}
	}
	Store{path: path, files: files, writes: writes, policy: p, state: sync.NewRef(s), broken: sync.NewRef(false), lock: queue.New[int](1)}
}

// apply runs op under the lock: it applies op to the state, and appends
// op's line when the state changed.
func apply(s Store, op session.Op) session.Outcome fails session.Failed {
	s.lock.Push(0) catch {
	case queue.Closed:
		Unreachable("the lock is never closed")
	}
	let o = step(s, op) catch {
	case session.Failed as f:
		unlock(s)
		return f
	}
	unlock(s)
	o
}

// unlock lets the next change run.
func unlock(s Store) {
	let _ = s.lock.Pop() catch {
	case queue.Closed:
		Unreachable("the lock is never closed")
	}
}

// step is apply's work, under the lock.
func step(s Store, op session.Op) session.Outcome fails session.Failed {
	if s.broken.Get() {
		return session.Failed{Reason: "\(s.path): a write failed; open the store again"}
	}
	let p = s.policy
	let (o, changed) = sync.Modify(s.state, func(st session.State) ((session.Outcome, bool), session.State) {
		let (o, next, changed) = session.Apply(p, st, op)
		((o, changed), next)
	})
	if changed {
		s.writes.AppendFile(s.path, lineOf(op)) catch {
		case fs.NotFound:
			s.broken.Set(true)
			return session.Failed{Reason: "\(s.path): no such directory"}
		case fs.Denied:
			s.broken.Set(true)
			return session.Failed{Reason: "\(s.path): permission denied"}
		case fs.Failed as f:
			s.broken.Set(true)
			return session.Failed{Reason: "\(s.path): \(f.Reason)"}
		}
	}
	o
}

// Establish keeps a new session under d.
func Establish(s Store, d session.Digest, subject string, revision int, now time.Time) fails session.Conflict | session.Failed {
	match try apply(s, session.EstablishOp{Digest: d, Subject: subject, Revision: revision, Now: now}) {
	case session.Refused:
		return session.Conflict
	case _:
	}
}

// Verify is the verdict on the session under d at now.
func Verify(s Store, d session.Digest, now time.Time) session.Verdict fails session.Failed {
	if s.broken.Get() {
		return session.Failed{Reason: "\(s.path): a write failed; open the store again"}
	}
	let p = s.policy
	sync.Modify(s.state, func(st session.State) (session.Verdict, session.State) { (session.VerifyIn(p, st, d, now), st) })
}

// Rotate moves the live session under old to new.
func Rotate(s Store, old session.Digest, new session.Digest, now time.Time) session.Record fails session.Conflict | session.Failed {
	match try apply(s, session.RotateOp{Old: old, New: new, Now: now}) {
	case session.Moved as m:
		m.Record
	case _:
		session.Conflict
	}
}

// Revoke ends the session under d.
func Revoke(s Store, d session.Digest) bool fails session.Failed {
	match try apply(s, session.RevokeOp{Digest: d}) {
	case session.Ended as e:
		e.Held
	case _:
		false
	}
}

// RevokeAll ends the sessions of subject below revision.
func RevokeAll(s Store, subject string, revision int) fails session.Failed {
	let _ = try apply(s, session.RevokeAllOp{Subject: subject, Revision: revision})
}

// script is one step of a FileIsMemory script: wait Wait milliseconds,
// then establish, verify, rotate or revoke the Pick-th digest handed out,
// revoke every session of the subject below a revision, or open the file
// store again.
type script = establish{Subject int, Revision int, Wait int} | verify{Pick int, Wait int} | rotate{Pick int, Wait int} | revoke{Pick int} | revokeAll{Subject int, Revision int} | reopen{}

// FileIsMemory: a file store answers a generated script of establishes,
// verifies, rotations, revokes and reopens as a memory store of the same
// policy does, answer by answer; and so does the store a reopen gives
// after a crash cut its last append (torn, a part of a line with no line
// feed). Its times carry no monotonic reading, as none read from a log
// does.
law FileIsMemory(steps []script, torn string) {
	let p = session.NewPolicy(10ms, 30ms, 100ms) catch {
	case session.BadPolicy:
		return false
	}
	let disk = fstest.NewMemory()
	let want = memory.New(p)
	let mut got = try Open(disk, disk, "sessions.log", p)
	let mut now = time.Unix(0, 0)
	let mut n = 0
	let mut digests = []session.Digest{session.DigestOf(session.TokenOf("none"))}
	for st in steps {
		match st {
		case establish as e:
			now = later(now, ((e.Wait%20)+20)%20)
			n = n + 1
			let d = session.DigestOf(session.TokenOf("t\(n)"))
			let subject = "s\t\"\(((e.Subject%3)+3)%3)"
			let rev = ((e.Revision%3)+3)%3
			if try established(want, d, subject, rev, now) != try established(got, d, subject, rev, now) {
				return false
			}
			digests = digests.Append(d)
		case verify as v:
			now = later(now, ((v.Wait%20)+20)%20)
			let d = digests[((v.Pick%len(digests))+len(digests))%len(digests)]
			if try want.Verify(d, now) != try got.Verify(d, now) {
				return false
			}
		case rotate as r:
			now = later(now, ((r.Wait%20)+20)%20)
			n = n + 1
			let d = digests[((r.Pick%len(digests))+len(digests))%len(digests)]
			let next = session.DigestOf(session.TokenOf("t\(n)"))
			if try rotated(want, d, next, now) != try rotated(got, d, next, now) {
				return false
			}
			digests = digests.Append(next)
		case revoke as r:
			let d = digests[((r.Pick%len(digests))+len(digests))%len(digests)]
			if try want.Revoke(d) != try got.Revoke(d) {
				return false
			}
		case revokeAll as a:
			let subject = "s\t\"\(((a.Subject%3)+3)%3)"
			let rev = ((a.Revision%4)+4)%4
			try want.RevokeAll(subject, rev)
			try got.RevokeAll(subject, rev)
		case reopen:
			got = try Open(disk, disk, "sessions.log", p)
		}
	}
	try disk.AppendFile("sessions.log", "est\t" + strings.ReplaceAll(torn, "\n", ""))
	let back = try Open(disk, disk, "sessions.log", p)
	for d in digests {
		if try want.Verify(d, now) != try back.Verify(d, now) {
			return false
		}
	}
	true
}

// later is t plus ms milliseconds, with no monotonic reading, as a time
// read back from the log is: == of two records compares it.
func later(t time.Time, ms int) time.Time { time.Unix(time.UnixSeconds(t), time.Nanosecond(t) + int64(ms)*1000000) }

// established is whether s kept the session, or found it a Conflict.
func established(s session.Store, d session.Digest, subject string, revision int, now time.Time) bool fails session.Failed {
	try s.Establish(d, subject, revision, now) catch {
	case session.Conflict:
		return false
	}
	true
}

// rotated is the record a rotation gave, or None at a Conflict.
func rotated(s session.Store, old session.Digest, new session.Digest, now time.Time) Option[session.Record] fails session.Failed {
	let r = try s.Rotate(old, new, now) catch {
	case session.Conflict:
		return None
	}
	Some[session.Record]{Value: r}
}

// OpenRefusesABrokenLine: a whole line that is not a change, after good
// ones, makes Open fail.
law OpenRefusesABrokenLine(key string, line string) {
	let p = session.NewPolicy(10ms, 30ms, 100ms) catch {
	case session.BadPolicy:
		return false
	}
	let disk = fstest.NewMemory()
	let s = try Open(disk, disk, "sessions.log", p)
	try s.Establish(session.DigestOf(session.TokenOf(key)), "a", 0, time.Unix(0, 0)) catch {
	case session.Conflict:
		return false
	}
	try disk.AppendFile("sessions.log", "x" + strings.ReplaceAll(line, "\n", "") + "\n")
	let _ = Open(disk, disk, "sessions.log", p) catch {
	case session.Failed:
		return true
	}
	false
}

// LogHoldsNoToken: the log of a store that began a session holds the
// token's digest and never the token.
law LogHoldsNoToken(key string) {
	let p = session.NewPolicy(10ms, 30ms, 100ms) catch {
	case session.BadPolicy:
		return false
	}
	let token = "token:" + key
	let d = session.DigestOf(session.TokenOf(token))
	let disk = fstest.NewMemory()
	let s = try Open(disk, disk, "sessions.log", p)
	try s.Establish(d, "a", 0, time.Unix(0, 0)) catch {
	case session.Conflict:
		return false
	}
	let log = try disk.ReadFile("sessions.log")
	!strings.Contains(log, token) && strings.Contains(log, session.DigestText(d))
}

// timeText is the two fields of t.
func timeText(t time.Time) string { "\(time.UnixSeconds(t))\t\(time.Nanosecond(t))" }

// lineOf is the log line of op, with its line feed.
func lineOf(op session.Op) string {
	match op {
	case session.EstablishOp as e:
		"est\t" + session.DigestText(e.Digest) + "\t" + strconv.Quote(e.Subject) + "\t\(e.Revision)\t" + timeText(e.Now) + "\n"
	case session.RotateOp as r:
		"rot\t" + session.DigestText(r.Old) + "\t" + session.DigestText(r.New) + "\t" + timeText(r.Now) + "\n"
	case session.RevokeOp as v:
		"rev\t" + session.DigestText(v.Digest) + "\n"
	case session.RevokeAllOp as a:
		"all\t" + strconv.Quote(a.Subject) + "\t\(a.Revision)\n"
	}
}

// opOf is the change of line, the n-th of the log at path.
func opOf(path string, n int, line string) session.Op fails session.Failed {
	let f = strings.Split(line, "\t")
	let bad = session.Failed{Reason: "\(path):\(n): not a change"}
	match (f[0], len(f)) {
	case ("est", 6):
		session.EstablishOp{Digest: try digestOf(f[1], bad), Subject: try unquote(f[2], bad), Revision: try intOf(f[3], bad), Now: try timeOf(f[4], f[5], bad)}
	case ("rot", 5):
		session.RotateOp{Old: try digestOf(f[1], bad), New: try digestOf(f[2], bad), Now: try timeOf(f[3], f[4], bad)}
	case ("rev", 2):
		session.RevokeOp{Digest: try digestOf(f[1], bad)}
	case ("all", 3):
		session.RevokeAllOp{Subject: try unquote(f[1], bad), Revision: try intOf(f[2], bad)}
	case (_, _):
		bad
	}
}

// digestOf is the digest of a field, or bad.
func digestOf(field string, bad session.Failed) session.Digest fails session.Failed {
	session.ParseDigest(field) catch {
	case session.BadDigest:
		return bad
	}
}

// intOf is the number of a field, or bad.
func intOf(field string, bad session.Failed) int fails session.Failed {
	strconv.Atoi(field) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return bad
	}
}

// timeOf is the time of two fields, or bad.
func timeOf(sec string, nsec string, bad session.Failed) time.Time fails session.Failed {
	time.Unix(int64(try intOf(sec, bad)), int64(try intOf(nsec, bad)))
}

// unquote is the text of a quoted field, or bad.
func unquote(field string, bad session.Failed) string fails session.Failed {
	strconv.Unquote(field) catch {
	case strconv.Malformed:
		return bad
	}
}
