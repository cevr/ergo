import core
import gen
import machines
import option
import sync

// PathScope selects whether path planning runs to a finite command depth or
// across a closed acyclic reachable graph.
type PathScope = ToDepth{Depth int} | All{}

// PathBounds sets hard saturating preflight limits checked before extending storage.
type PathBounds {
	MaxStates int,
	MaxEdges  int,
	MaxPaths  int,
	MaxSteps  int,
	MaxWork   int,
	MaxBytes  int,
}

// PathStop reports why path planning completed or refused to admit replay.
type PathStop =
	| PathComplete{}
	| EmptyStarts{}
	| BadBounds{Reason string}
	| CycleRequiresDepth{}
	| PathOverStates{}
	| PathOverEdges{}
	| PathOverPaths{}
	| PathOverSteps{}
	| PathOverWork{}
	| PathOverBytes{}
	| PathUnkeyable{Reason string}

// PathStats records model graph sizes, unresolved frontier states, planned path
// and step totals, longest planned depth, saturating work, retained bytes, and
// planning expansion counters (distinct from checkpoint reconstructions).
type PathStats {
	States          int,
	Edges           int,
	Disabled        int,
	Frontier        int,
	Paths           int,
	Steps           int,
	MaxDepth        int,
	Work            int,
	Bytes           int,
	Expansions      int,
	StepAttempts    int,
	Reconstructions int,
}

// PathCase is one concrete planned replay case: its explicit start index, the
// dense concrete edge IDs along the path, and the corresponding signal indices.
type PathCase {
	Start   int,
	Edges   []int,
	Signals []int,
}

// PathGraph holds the dense concrete state-and-edge adjacency built for path
// planning together with shortest BFS parent pointers.
type PathGraph[O] {
	Roots       []int,
	Signals     []int,
	OutStart    []int,
	Edges       []ConcreteEdge[O],
	parentState []int32,
	parentEdge  []int32,
	rootStart   []int32,
	depthOf     []int32,
}

// PathPlan is the checked preflight plan produced by PlanPaths. Only a plan
// whose Stop is PathComplete admits a replay cursor via OpenPaths.
type PathPlan[O] {
	Stop       PathStop,
	Scope      PathScope,
	Stats      PathStats,
	Graph      PathGraph[O],
	exactCount []int,
	admitted   bool,
}

// PathCursor streams planned PathCases in increasing length order with a
// bounded spine rather than materializing a breadth layer of whole paths.
type PathCursor {
	admitted    bool,
	done        bool,
	targetLen   int,
	curStart    int,
	initialized bool,
	spineStates []int,
	spineEdges  []int,
	spineNext   []int,
}

func satMul(a int, b int) int {
	if a <= 0 || b <= 0 {
		return 0
	}
	if a >= maxIntVal/b {
		return maxIntVal
	}
	a * b
}

func validatePathBounds(scope PathScope, bounds PathBounds) option.Option[string] {
	if bounds.MaxStates < 0 || bounds.MaxEdges < 0 || bounds.MaxPaths < 0 || bounds.MaxSteps < 0 || bounds.MaxWork < 0 || bounds.MaxBytes < 0 {
		return option.Some[string]{Value: "path bounds must be non-negative"}
	}
	match scope {
	case ToDepth as d:
		if d.Depth < 0 {
			return option.Some[string]{Value: "ToDepth depth must be non-negative"}
		}
	case All:
	}
	option.None
}

func emptyPathGraph[O]() PathGraph[O] {
	PathGraph[O]{
		Roots:       []int{},
		Signals:     []int{},
		OutStart:    []int{},
		Edges:       []ConcreteEdge[O]{},
		parentState: []int32{},
		parentEdge:  []int32{},
		rootStart:   []int32{},
		depthOf:     []int32{},
	}
}

func stoppedPlan[O](stop PathStop, scope PathScope, st PathStats, graph PathGraph[O]) PathPlan[O] {
	PathPlan[O]{
		Stop:       stop,
		Scope:      scope,
		Stats:      st,
		Graph:      graph,
		exactCount: []int{},
		admitted:   false,
	}
}

func buildPathGraph[S wire, E wire, O](g ConcreteGraph[S, E, O], maxDepth int, bounds PathBounds) (PathGraph[O], PathStats, PathStop) needs wired[S] | wired[E] {
	let mut st = PathStats{
		States:          0,
		Edges:           0,
		Disabled:        0,
		Frontier:        0,
		Paths:           0,
		Steps:           0,
		MaxDepth:        0,
		Work:            0,
		Bytes:           0,
		Expansions:      0,
		StepAttempts:    0,
		Reconstructions: 0,
	}
	let mut roots = []int{}
	let mut sigIndex = []int{}
	let mut outStart = []int{}
	let mut edges = []ConcreteEdge[O]{}
	let mut parentState = []int32{}
	let mut parentEdge = []int32{}
	let mut rootStart = []int32{}
	let mut depthOf = []int32{}
	let mut sig = []int32{}

	if g.Starts.Len() == 0 {
		return (emptyPathGraph[O](), st, EmptyStarts)
	}

	let mut eventTable = NewKeyTable()
	for e in 0..g.Signals.Len() {
		let ck = CanonicalKeyOf(g.Signals[e]) catch {
		case Keyless as k:
			return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathUnkeyable{Reason: k.Reason})
		}
		st.Work = satAdd(st.Work, satAdd(1, ck.Words))
		if st.Work > bounds.MaxWork {
			return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
		}
		let nextBytes = satAdd(KeyTableBytes(eventTable), ck.Bytes.Len())
		let (_, fresh, probes) = InternWithHash(&eventTable, ck.Bytes, ck.Hash)
		st.Work = satAdd(st.Work, probes)
		st.Bytes = KeyTableBytes(eventTable)
		if fresh {
			if nextBytes > bounds.MaxBytes {
				return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverBytes)
			}
			sigIndex = sigIndex.Append(e)
		}
		if st.Work > bounds.MaxWork {
			return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
		}
	}

	let mut stateTable = NewKeyTable()
	let mut ids = []int{}
	let mut kept = []option.Option[S]{}
	let mut held = 0

	for i in 0..g.Starts.Len() {
		let s = g.Starts[i]
		let ck = CanonicalKeyOf(s) catch {
		case Keyless as k:
			return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathUnkeyable{Reason: k.Reason})
		}
		st.Work = satAdd(st.Work, satAdd(1, ck.Words))
		if st.Work > bounds.MaxWork {
			return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
		}
		let (id, fresh, probes) = InternWithHash(&stateTable, ck.Bytes, ck.Hash)
		st.Work = satAdd(st.Work, probes)
		st.Bytes = satAdd(KeyTableBytes(eventTable), KeyTableBytes(stateTable))
		if st.Work > bounds.MaxWork {
			return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
		}
		if fresh {
			if st.Bytes > bounds.MaxBytes {
				return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverBytes)
			}
			if parentState.Len() >= bounds.MaxStates {
				return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverStates)
			}
			parentState = parentState.Append(int32(-1))
			parentEdge = parentEdge.Append(int32(-1))
			rootStart = rootStart.Append(int32(i))
			depthOf = depthOf.Append(int32(0))
			sig = sig.Append(int32(i))
			st.States = st.States + 1
			let (k2, h2) = pushKept(kept, held, s, ck.Words)
			kept = k2
			held = h2
			ids = ids.Append(id)
		}
		roots = roots.Append(id)
	}

	let mut curDepth = 0
	for ids.Len() > 0 && (maxDepth < 0 || curDepth < maxDepth) {
		let mut next = []int{}
		let mut nextKept = []option.Option[S]{}
		let mut nextHeld = 0
		for f in 0..ids.Len() {
			let srcID = ids[f]
			outStart = outStart.Append(edges.Len())
			st.Expansions = st.Expansions + 1
			let (s, rebuildSteps) = concreteFrontierState(g, parentState, sig, kept[f], srcID)
			if rebuildSteps > 0 {
				st.Reconstructions = satAdd(st.Reconstructions, rebuildSteps)
				st.Work = satAdd(st.Work, rebuildSteps)
				if st.Work > bounds.MaxWork {
					return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
				}
			}
			for evID in 0..sigIndex.Len() {
				let eIdx = sigIndex[evID]
				st.StepAttempts = satAdd(st.StepAttempts, 1)
				st.Work = satAdd(st.Work, 1)
				if st.Work > bounds.MaxWork {
					return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
				}
				match g.Step(s, g.Signals[eIdx]) {
				case Disabled[O]:
					st.Disabled = st.Disabled + 1
				case Terminal[O] as term:
					if edges.Len() >= bounds.MaxEdges {
						return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverEdges)
					}
					edges = edges.Append(ConcreteEdge[O]{Source: srcID, Signal: eIdx, EventID: evID, Target: Ended, Obs: term.Obs})
					st.Edges = st.Edges + 1
				case Continue[S, O] as cont:
					let t = cont.Next
					let ck = CanonicalKeyOf(t) catch {
					case Keyless as k:
						return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathUnkeyable{Reason: k.Reason})
					}
					st.Work = satAdd(st.Work, ck.Words)
					if st.Work > bounds.MaxWork {
						return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
					}
					let (dstID, fresh, probes) = InternWithHash(&stateTable, ck.Bytes, ck.Hash)
					st.Work = satAdd(st.Work, probes)
					st.Bytes = satAdd(KeyTableBytes(eventTable), KeyTableBytes(stateTable))
					if st.Work > bounds.MaxWork {
						return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverWork)
					}
					if fresh {
						if st.Bytes > bounds.MaxBytes {
							return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverBytes)
						}
						if parentState.Len() >= bounds.MaxStates {
							return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverStates)
						}
					}
					if edges.Len() >= bounds.MaxEdges {
						return (PathGraph[O]{Roots: roots, Signals: sigIndex, OutStart: outStart, Edges: edges, parentState: parentState, parentEdge: parentEdge, rootStart: rootStart, depthOf: depthOf}, st, PathOverEdges)
					}
					let edgeID = edges.Len()
					edges = edges.Append(ConcreteEdge[O]{Source: srcID, Signal: eIdx, EventID: evID, Target: ToState{State: dstID}, Obs: cont.Obs})
					st.Edges = st.Edges + 1
					if fresh {
						parentState = parentState.Append(int32(srcID))
						parentEdge = parentEdge.Append(int32(edgeID))
						rootStart = rootStart.Append(int32(-1))
						depthOf = depthOf.Append(int32(curDepth + 1))
						sig = sig.Append(int32(eIdx))
						st.States = st.States + 1
						let (k2, h2) = pushKept(nextKept, nextHeld, t, ck.Words)
						nextKept = k2
						nextHeld = h2
						next = next.Append(dstID)
					}
				}
			}
		}
		ids = next
		kept = nextKept
		held = nextHeld
		curDepth = curDepth + 1
	}

	if ids.Len() > 0 {
		if sigIndex.Len() > 0 {
			st.Frontier = ids.Len()
		}
		for _ in 0..ids.Len() {
			outStart = outStart.Append(edges.Len())
		}
	}
	outStart = outStart.Append(edges.Len())

	(PathGraph[O]{
		Roots:       roots,
		Signals:     sigIndex,
		OutStart:    outStart,
		Edges:       edges,
		parentState: parentState,
		parentEdge:  parentEdge,
		rootStart:   rootStart,
		depthOf:     depthOf,
	}, st, PathComplete)
}

func checkAcyclicDepth[O](g PathGraph[O], numStates int, bounds PathBounds, st mut PathStats) (int, PathStop) {
	let mut indeg = []int{}
	for _ in 0..numStates {
		indeg = indeg.Append(0)
	}
	for e in g.Edges {
		st.Work = satAdd(st.Work, 1)
		if st.Work > bounds.MaxWork {
			return (0, PathOverWork)
		}
		match e.Target {
		case ToState as ts:
			indeg[ts.State] = indeg[ts.State] + 1
		case Ended:
		}
	}
	let mut topo = []int{}
	for u in 0..numStates {
		st.Work = satAdd(st.Work, 1)
		if st.Work > bounds.MaxWork {
			return (0, PathOverWork)
		}
		if indeg[u] == 0 {
			topo = topo.Append(u)
		}
	}
	let mut head = 0
	for head < topo.Len() {
		let u = topo[head]
		head = head + 1
		let lo = g.OutStart[u]
		let hi = g.OutStart[u+1]
		for eIdx in lo..hi {
			st.Work = satAdd(st.Work, 1)
			if st.Work > bounds.MaxWork {
				return (0, PathOverWork)
			}
			match g.Edges[eIdx].Target {
			case ToState as ts:
				indeg[ts.State] = indeg[ts.State] - 1
				if indeg[ts.State] == 0 {
					topo = topo.Append(ts.State)
				}
			case Ended:
			}
		}
	}
	if topo.Len() < numStates {
		return (0, CycleRequiresDepth)
	}
	let mut height = []int{}
	for _ in 0..numStates {
		height = height.Append(0)
	}
	let mut idx = topo.Len() - 1
	for idx >= 0 {
		let u = topo[idx]
		let lo = g.OutStart[u]
		let hi = g.OutStart[u+1]
		let mut best = 0
		for eIdx in lo..hi {
			st.Work = satAdd(st.Work, 1)
			if st.Work > bounds.MaxWork {
				return (0, PathOverWork)
			}
			let cand = match g.Edges[eIdx].Target {
			case Ended:
				1
			case ToState as ts:
				satAdd(1, height[ts.State])
			}
			if cand > best {
				best = cand
			}
		}
		height[u] = best
		idx = idx - 1
	}
	let mut maxD = 0
	for r in g.Roots {
		if height[r] > maxD {
			maxD = height[r]
		}
	}
	(maxD, PathComplete)
}

func planCount[O](plan PathPlan[O], length int, state int) int {
	plan.exactCount[length*plan.Stats.States+state]
}

// ShortestPrefix returns a shortest BFS discovery PathCase to stateID in g.
func ShortestPrefix[O](g PathGraph[O], stateID int) PathCase {
	let mut rev = []int{}
	let mut cur = stateID
	for g.parentState[cur] >= 0 {
		rev = rev.Append(int(g.parentEdge[cur]))
		cur = int(g.parentState[cur])
	}
	let start = int(g.rootStart[cur])
	let mut edges = []int{}
	let mut sigs = []int{}
	let mut i = rev.Len() - 1
	for i >= 0 {
		let eIdx = rev[i]
		edges = edges.Append(eIdx)
		sigs = sigs.Append(g.Edges[eIdx].Signal)
		i = i - 1
	}
	PathCase{Start: start, Edges: edges, Signals: sigs}
}

// PlanPaths performs bounded exact preflight planning over g under scope and
// bounds. A plan that hits any hard cap or encounters a cycle under All returns
// a structured stop reason and admits no replay cursor.
func PlanPaths[S wire, E wire, O](g ConcreteGraph[S, E, O], scope PathScope, bounds PathBounds) PathPlan[O] needs wired[S] | wired[E] {
	let emptySt = PathStats{
		States:          0,
		Edges:           0,
		Disabled:        0,
		Frontier:        0,
		Paths:           0,
		Steps:           0,
		MaxDepth:        0,
		Work:            0,
		Bytes:           0,
		Expansions:      0,
		StepAttempts:    0,
		Reconstructions: 0,
	}
	match validatePathBounds(scope, bounds) {
	case option.Some as err:
		return stoppedPlan[O](BadBounds{Reason: err.Value}, scope, emptySt, emptyPathGraph[O]())
	case option.None:
	}

	let buildDepth = match scope {
	case ToDepth as d:
		d.Depth
	case All:
		-1
	}
	let (graph, st0, graphStop) = buildPathGraph(g, buildDepth, bounds)
	let mut st = st0
	match graphStop {
	case PathComplete:
	case _:
		return stoppedPlan[O](graphStop, scope, st, graph)
	}

	let maxD = match scope {
	case ToDepth as d:
		d.Depth
	case All:
		let (acyclicMax, cycStop) = checkAcyclicDepth(graph, st.States, bounds, &st)
		match cycStop {
		case PathComplete:
			acyclicMax
		case _:
			return stoppedPlan[O](cycStop, scope, st, graph)
		}
	}

	let numStates = st.States
	let layerBytes = satMul(numStates, 8)
	let mut exactCount = []int{}

	let nextBytes0 = satAdd(st.Bytes, layerBytes)
	if nextBytes0 > bounds.MaxBytes {
		return stoppedPlan[O](PathOverBytes, scope, st, graph)
	}
	st.Work = satAdd(st.Work, numStates)
	if st.Work > bounds.MaxWork {
		return stoppedPlan[O](PathOverWork, scope, st, graph)
	}
	let paths0 = graph.Roots.Len()
	if paths0 > bounds.MaxPaths {
		return stoppedPlan[O](PathOverPaths, scope, st, graph)
	}
	for _ in 0..numStates {
		exactCount = exactCount.Append(1)
	}
	st.Bytes = nextBytes0
	st.Paths = paths0
	st.Steps = 0
	st.MaxDepth = 0

	let mut length = 1
	for length <= maxD {
		let nextBytes = satAdd(st.Bytes, layerBytes)
		if nextBytes > bounds.MaxBytes {
			return stoppedPlan[O](PathOverBytes, scope, st, graph)
		}
		let prevOff = (length - 1) * numStates
		let mut layer = []int{}
		for u in 0..numStates {
			st.Work = satAdd(st.Work, 1)
			if st.Work > bounds.MaxWork {
				return stoppedPlan[O](PathOverWork, scope, st, graph)
			}
			let lo = graph.OutStart[u]
			let hi = graph.OutStart[u+1]
			let mut sum = 0
			for eIdx in lo..hi {
				st.Work = satAdd(st.Work, 1)
				if st.Work > bounds.MaxWork {
					return stoppedPlan[O](PathOverWork, scope, st, graph)
				}
				match graph.Edges[eIdx].Target {
				case Ended:
					if length == 1 {
						sum = satAdd(sum, 1)
					}
				case ToState as ts:
					sum = satAdd(sum, exactCount[prevOff+ts.State])
				}
			}
			layer = layer.Append(sum)
		}
		let mut pathsAtL = 0
		for r in graph.Roots {
			pathsAtL = satAdd(pathsAtL, layer[r])
		}
		if pathsAtL == 0 {
			break
		}
		let nextPaths = satAdd(st.Paths, pathsAtL)
		if nextPaths > bounds.MaxPaths {
			return stoppedPlan[O](PathOverPaths, scope, st, graph)
		}
		let nextSteps = satAdd(st.Steps, satMul(pathsAtL, length))
		if nextSteps > bounds.MaxSteps {
			return stoppedPlan[O](PathOverSteps, scope, st, graph)
		}
		for v in layer {
			exactCount = exactCount.Append(v)
		}
		st.Bytes = nextBytes
		st.Paths = nextPaths
		st.Steps = nextSteps
		st.MaxDepth = length
		length = length + 1
	}

	PathPlan[O]{
		Stop:       PathComplete,
		Scope:      scope,
		Stats:      st,
		Graph:      graph,
		exactCount: exactCount,
		admitted:   true,
	}
}

// PlanMachinePaths adapts m and signals to a ConcreteGraph and plans paths
// under scope and bounds.
func PlanMachinePaths[S wire, E wire, O](m machines.Machine[S, E, O], signals []E, scope PathScope, bounds PathBounds) PathPlan[MachineObs[O]] needs wired[S] | wired[E] {
	PlanPaths(ConcreteOfMachine(m, signals), scope, bounds)
}

// OpenPaths returns a streaming length-ordered cursor for an admitted PathPlan,
// or None when planning did not complete within bounds.
func OpenPaths[O](plan PathPlan[O]) option.Option[PathCursor] {
	if !plan.admitted {
		return option.None
	}
	option.Some[PathCursor]{Value: PathCursor{
		admitted:    true,
		done:        false,
		targetLen:   0,
		curStart:    0,
		initialized: false,
		spineStates: []int{},
		spineEdges:  []int{},
		spineNext:   []int{},
	}}
}

func materializePathCase[O](plan PathPlan[O], start int, prefix []int, lastEdge int) PathCase {
	let mut edges = []int{}
	let mut sigs = []int{}
	for e in prefix {
		edges = edges.Append(e)
		sigs = sigs.Append(plan.Graph.Edges[e].Signal)
	}
	edges = edges.Append(lastEdge)
	sigs = sigs.Append(plan.Graph.Edges[lastEdge].Signal)
	PathCase{Start: start, Edges: edges, Signals: sigs}
}

// CursorSpineDepth returns the number of states currently retained on c's
// streaming DFS spine (bounded by MaxDepth + 1, never proportional to path count).
func CursorSpineDepth(c PathCursor) int {
	c.spineStates.Len()
}

// NextPath advances c and returns the next planned PathCase in increasing
// length and stable start/edge order, or None when exhausted.
func NextPath[O](plan PathPlan[O], c mut PathCursor) option.Option[PathCase] {
	if !c.admitted || c.done {
		return option.None
	}
	if c.targetLen == 0 {
		if c.curStart < plan.Graph.Roots.Len() {
			let start = c.curStart
			c.curStart = c.curStart + 1
			return option.Some[PathCase]{Value: PathCase{Start: start, Edges: []int{}, Signals: []int{}}}
		}
		c.targetLen = 1
		c.curStart = 0
		c.initialized = false
		if c.targetLen > plan.Stats.MaxDepth {
			c.done = true
			return option.None
		}
	}
	for c.targetLen <= plan.Stats.MaxDepth {
		for c.curStart < plan.Graph.Roots.Len() {
			let rootState = plan.Graph.Roots[c.curStart]
			if !c.initialized {
				if planCount(plan, c.targetLen, rootState) == 0 {
					c.curStart = c.curStart + 1
					continue
				}
				c.spineStates = []int{rootState}
				c.spineEdges = []int{}
				c.spineNext = []int{plan.Graph.OutStart[rootState]}
				c.initialized = true
			}
			for c.spineNext.Len() > 0 {
				let depth = c.spineEdges.Len()
				let u = c.spineStates[depth]
				let endEdge = plan.Graph.OutStart[u+1]
				let eIdx = c.spineNext[depth]
				if eIdx >= endEdge {
					c.spineNext = c.spineNext[0:depth]
					c.spineStates = c.spineStates[0:depth]
					if depth > 0 {
						c.spineEdges = c.spineEdges[0 : depth-1]
					}
					continue
				}
				c.spineNext[depth] = eIdx + 1
				let rem = c.targetLen - depth
				let edge = plan.Graph.Edges[eIdx]
				if rem == 1 {
					return option.Some[PathCase]{Value: materializePathCase(plan, c.curStart, c.spineEdges, eIdx)}
				}
				match edge.Target {
				case Ended:
				case ToState as ts:
					if planCount(plan, rem-1, ts.State) > 0 {
						c.spineEdges = c.spineEdges.Append(eIdx)
						c.spineStates = c.spineStates.Append(ts.State)
						c.spineNext = c.spineNext.Append(plan.Graph.OutStart[ts.State])
					}
				}
			}
			c.curStart = c.curStart + 1
			c.initialized = false
		}
		c.targetLen = c.targetLen + 1
		c.curStart = 0
		c.initialized = false
	}
	c.done = true
	option.None
}

type pwState { Tag uint8, Val int }

type pwEvent = pwLeft{} | pwRight{} | pwJoin{} | pwLoop{} | pwRead{} | pwDone{Code int}

type pwRefCase { Start int, Signals []int }

func pwCollectCases[O](plan PathPlan[O]) ([]PathCase, bool) {
	match OpenPaths(plan) {
	case option.None:
		([]PathCase{}, false)
	case option.Some as opened:
		let mut c = opened.Value
		let mut out = []PathCase{}
		for {
			match NextPath(plan, &c) {
			case option.None:
				break
			case option.Some as item:
				out = out.Append(item.Value)
			}
		}
		(out, true)
	}
}

func pwRefDedupSignals(sigs []pwEvent) []int {
	let mut seen = []pwEvent{}
	let mut idx = []int{}
	for i in 0..sigs.Len() {
		let mut dup = false
		for s in seen {
			if s == sigs[i] {
				dup = true
			}
		}
		if !dup {
			seen = seen.Append(sigs[i])
			idx = idx.Append(i)
		}
	}
	idx
}

func pwRefEnumAtLen(g ConcreteGraph[pwState, pwEvent, int], sigIdx []int, s pwState, start int, rem int, prefix []int, acc []pwRefCase) []pwRefCase {
	if rem == 0 {
		let mut cp = []int{}
		for x in prefix {
			cp = cp.Append(x)
		}
		return acc.Append(pwRefCase{Start: start, Signals: cp})
	}
	let mut out = acc
	for eIdx in sigIdx {
		match g.Step(s, g.Signals[eIdx]) {
		case Disabled[int]:
		case Terminal[int]:
			if rem == 1 {
				let mut cp = []int{}
				for x in prefix {
					cp = cp.Append(x)
				}
				cp = cp.Append(eIdx)
				out = out.Append(pwRefCase{Start: start, Signals: cp})
			}
		case Continue[pwState, int] as cont:
			let nextPrefix = prefix.Append(eIdx)
			out = pwRefEnumAtLen(g, sigIdx, cont.Next, start, rem-1, nextPrefix, out)
		}
	}
	out
}

func pwRefEnumAll(g ConcreteGraph[pwState, pwEvent, int], maxDepth int) []pwRefCase {
	let sigIdx = pwRefDedupSignals(g.Signals)
	let mut out = []pwRefCase{}
	for targetLen in 0..maxDepth+1 {
		for start in 0..g.Starts.Len() {
			out = pwRefEnumAtLen(g, sigIdx, g.Starts[start], start, targetLen, []int{}, out)
		}
	}
	out
}

func pwCasesEqual(got []PathCase, want []pwRefCase) bool {
	if got.Len() != want.Len() {
		return false
	}
	for i in 0..got.Len() {
		if got[i].Start != want[i].Start || got[i].Signals != want[i].Signals || got[i].Edges.Len() != got[i].Signals.Len() {
			return false
		}
	}
	true
}

func pwJoinGraph(bias int) ConcreteGraph[pwState, pwEvent, int] {
	let starts = []pwState{
		pwState{Tag: uint8(0), Val: bias},
		pwState{Tag: uint8(1), Val: bias},
	}
	let sigs = []pwEvent{
		pwLeft,
		pwRight,
		pwJoin,
		pwLoop,
		pwRead,
		pwDone{Code: bias + 1},
		pwLeft,
	}
	ConcreteGraph[pwState, pwEvent, int]{
		Starts:  starts,
		Signals: sigs,
		Step:    func(s pwState, e pwEvent) EdgeOutcome[pwState, int] {
			match s.Tag {
			case 0:
				match e {
				case pwLeft:
					Continue[pwState, int]{Next: pwState{Tag: uint8(1), Val: s.Val}, Obs: 1}
				case pwRight:
					Continue[pwState, int]{Next: pwState{Tag: uint8(2), Val: s.Val}, Obs: 2}
				case pwLoop:
					Continue[pwState, int]{Next: s, Obs: 4}
				case _:
					Disabled[int]{Obs: 0}
				}
			case 1:
				match e {
				case pwJoin:
					Continue[pwState, int]{Next: pwState{Tag: uint8(3), Val: s.Val}, Obs: 3}
				case pwDone as d:
					Terminal[int]{Obs: d.Code}
				case _:
					Disabled[int]{Obs: 0}
				}
			case 2:
				match e {
				case pwJoin:
					Continue[pwState, int]{Next: pwState{Tag: uint8(3), Val: s.Val}, Obs: 3}
				case _:
					Disabled[int]{Obs: 0}
				}
			case _:
				match e {
				case pwRead:
					Continue[pwState, int]{Next: s, Obs: 5}
				case pwDone as d:
					Terminal[int]{Obs: d.Code + 10}
				case _:
					Disabled[int]{Obs: 0}
				}
			}
		},
	}
}

func pwGrowingGraph(base int) ConcreteGraph[pwState, pwEvent, int] {
	ConcreteGraph[pwState, pwEvent, int]{
		Starts:  []pwState{pwState{Tag: uint8(0), Val: base}},
		Signals: []pwEvent{pwLeft, pwDone{Code: base}},
		Step:    func(s pwState, e pwEvent) EdgeOutcome[pwState, int] {
			match e {
			case pwLeft:
				Continue[pwState, int]{Next: pwState{Tag: uint8(0), Val: s.Val + 1}, Obs: s.Val + 1}
			case pwDone as d:
				Terminal[int]{Obs: d.Code + s.Val}
			case _:
				Disabled[int]{Obs: 0}
			}
		},
	}
}

func pwAcyclicGraph(base int) ConcreteGraph[pwState, pwEvent, int] {
	ConcreteGraph[pwState, pwEvent, int]{
		Starts: []pwState{
			pwState{Tag: uint8(0), Val: base},
			pwState{Tag: uint8(0), Val: base},
		},
		Signals: []pwEvent{pwLeft, pwRight, pwDone{Code: 9}},
		Step:    func(s pwState, e pwEvent) EdgeOutcome[pwState, int] {
			if s.Tag == uint8(0) {
				match e {
				case pwLeft:
					Continue[pwState, int]{Next: pwState{Tag: uint8(1), Val: s.Val}, Obs: 1}
				case pwRight:
					Continue[pwState, int]{Next: pwState{Tag: uint8(2), Val: s.Val}, Obs: 2}
				case _:
					Disabled[int]{Obs: 0}
				}
			} else if s.Tag == uint8(1) {
				match e {
				case pwDone as d:
					Terminal[int]{Obs: d.Code}
				case _:
					Disabled[int]{Obs: 0}
				}
			} else {
				Disabled[int]{Obs: 0}
			}
		},
	}
}

// WalksAgreeWithReference checks that PlanPaths and its streaming cursor agree
// with an independent recursive walk enumerator across a two-root join, a
// repeated self-loop, a terminal Done edge, a growing context, an acyclic All
// scope, zero depth, empty alphabet/starts, and inclusive cap boundaries.
law WalksAgreeWithReference() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let bias = gen.Named("bias", showInt, func() int needs gen.Draws { gen.IntIn(0, 2) })
		let growBase = gen.Named("growBase", showInt, func() int needs gen.Draws { gen.IntIn(0, 4) })
		let gDepth = gen.Named("gDepth", showInt, func() int needs gen.Draws { gen.IntIn(1, 3) })
		let acycBase = gen.Named("acycBase", showInt, func() int needs gen.Draws { gen.IntIn(0, 3) })
		let big = PathBounds{MaxStates: 64, MaxEdges: 256, MaxPaths: 2048, MaxSteps: 8192, MaxWork: 200000, MaxBytes: 1048576}
		let jg = pwJoinGraph(bias)

		for d in 0..4 {
			let plan = PlanPaths(jg, ToDepth{Depth: d}, big)
			let okComplete = match plan.Stop {
			case PathComplete:
				true
			case _:
				false
			}
			if !okComplete {
				return false
			}
			let (got, opened) = pwCollectCases(plan)
			if !opened {
				return false
			}
			let want = pwRefEnumAll(jg, d)
			if !pwCasesEqual(got, want) {
				return false
			}
			let mut wantSteps = 0
			for w in want {
				wantSteps = wantSteps + w.Signals.Len()
			}
			if plan.Stats.Paths != want.Len() || plan.Stats.Steps != wantSteps || plan.Stats.Work <= 0 {
				return false
			}
			if d == 3 {
				let exact = PathBounds{
					MaxStates: plan.Stats.States,
					MaxEdges:  plan.Stats.Edges,
					MaxPaths:  plan.Stats.Paths,
					MaxSteps:  plan.Stats.Steps,
					MaxWork:   plan.Stats.Work,
					MaxBytes:  plan.Stats.Bytes,
				}
				let atCap = PlanPaths(jg, ToDepth{Depth: d}, exact)
				match atCap.Stop {
				case PathComplete:
				case _:
					return false
				}
				let overPaths = PlanPaths(jg, ToDepth{Depth: d}, PathBounds{
					MaxStates: exact.MaxStates,
					MaxEdges:  exact.MaxEdges,
					MaxPaths:  exact.MaxPaths - 1,
					MaxSteps:  exact.MaxSteps,
					MaxWork:   exact.MaxWork,
					MaxBytes:  exact.MaxBytes,
				})
				match overPaths.Stop {
				case PathOverPaths:
				case _:
					return false
				}
				match OpenPaths(overPaths) {
				case option.None:
				case option.Some:
					return false
				}
				let overSteps = PlanPaths(jg, ToDepth{Depth: d}, PathBounds{
					MaxStates: exact.MaxStates,
					MaxEdges:  exact.MaxEdges,
					MaxPaths:  exact.MaxPaths,
					MaxSteps:  exact.MaxSteps - 1,
					MaxWork:   exact.MaxWork,
					MaxBytes:  exact.MaxBytes,
				})
				match overSteps.Stop {
				case PathOverSteps:
				case _:
					return false
				}
				match OpenPaths(overSteps) {
				case option.None:
				case option.Some:
					return false
				}
			}
		}

		let cycAll = PlanPaths(jg, All, big)
		match cycAll.Stop {
		case CycleRequiresDepth:
		case _:
			return false
		}
		match OpenPaths(cycAll) {
		case option.None:
		case option.Some:
			return false
		}

		let gg = pwGrowingGraph(growBase)
		let growPlan = PlanPaths(gg, ToDepth{Depth: gDepth}, big)
		match growPlan.Stop {
		case PathComplete:
		case _:
			return false
		}
		let (growGot, growOpened) = pwCollectCases(growPlan)
		let growWant = pwRefEnumAll(gg, gDepth)
		if !growOpened || !pwCasesEqual(growGot, growWant) || growPlan.Stats.Frontier <= 0 {
			return false
		}
		let growAll = PlanPaths(gg, All, PathBounds{MaxStates: 6, MaxEdges: 64, MaxPaths: 256, MaxSteps: 1024, MaxWork: 200000, MaxBytes: 1048576})
		match growAll.Stop {
		case PathOverStates:
		case _:
			return false
		}
		match OpenPaths(growAll) {
		case option.None:
		case option.Some:
			return false
		}

		let ag = pwAcyclicGraph(acycBase)
		let allPlan = PlanPaths(ag, All, big)
		match allPlan.Stop {
		case PathComplete:
		case _:
			return false
		}
		let (allGot, allOpened) = pwCollectCases(allPlan)
		let allWant = pwRefEnumAll(ag, 4)
		if !allOpened || !pwCasesEqual(allGot, allWant) || allPlan.Stats.Frontier != 0 {
			return false
		}

		let emptyAlpha = ConcreteGraph[pwState, pwEvent, int]{
			Starts:  ag.Starts,
			Signals: []pwEvent{},
			Step:    ag.Step,
		}
		let eaPlan = PlanPaths(emptyAlpha, All, big)
		match eaPlan.Stop {
		case PathComplete:
		case _:
			return false
		}
		let (eaGot, eaOpened) = pwCollectCases(eaPlan)
		if !eaOpened || eaGot.Len() != 2 || eaPlan.Stats.Steps != 0 || eaGot[0].Start != 0 || eaGot[1].Start != 1 || eaGot[0].Edges.Len() != 0 || eaGot[1].Edges.Len() != 0 {
			return false
		}

		let noStarts = ConcreteGraph[pwState, pwEvent, int]{
			Starts:  []pwState{},
			Signals: ag.Signals,
			Step:    ag.Step,
		}
		let nsPlan = PlanPaths(noStarts, ToDepth{Depth: 1}, big)
		match nsPlan.Stop {
		case EmptyStarts:
		case _:
			return false
		}
		match OpenPaths(nsPlan) {
		case option.None:
		case option.Some:
			return false
		}

		let negDepth = PlanPaths(ag, ToDepth{Depth: -1}, big)
		match negDepth.Stop {
		case BadBounds:
		case _:
			return false
		}
		match OpenPaths(negDepth) {
		case option.None:
		case option.Some:
			return false
		}

		true
	})) == ""
	true
}

type joinState { Layer int, Slot int }

type joinCmd =
	| JoinBranch{Idx int}
	| JoinMerge{}
	| JoinTailA{}
	| JoinTailB{}

type joinOpenErr {}

type joinDriveErr {}

type joinSess {
	state  sync.Ref[joinState],
	closes sync.Ref[int],
} implements PathSession[joinCmd, Observed[joinState, int, core.Never], joinDriveErr]

func Read(s joinSess) Observed[joinState, int, core.Never] fails joinDriveErr {
	InitialRead[joinState]{State: s.state.Get()}
}

func Apply(s joinSess, cmd joinCmd) Observed[joinState, int, core.Never] fails joinDriveErr {
	let cur = s.state.Get()
	let (next, out) = match cmd {
	case JoinBranch as b:
		(joinState{Layer: 1, Slot: b.Idx}, 10 + b.Idx)
	case JoinMerge:
		(joinState{Layer: 2, Slot: 0}, 20)
	case JoinTailA:
		(joinState{Layer: cur.Layer + 1, Slot: 0}, 30 + cur.Layer)
	case JoinTailB:
		(joinState{Layer: cur.Layer + 1, Slot: 0}, 40 + cur.Layer)
	}
	s.state.Set(next)
	StepResult[joinState, int, core.Never]{Step: StepObs[joinState, int, core.Never]{
		Kind:     DisEmit,
		State:    option.Some[joinState]{Value: next},
		Outputs:  []int{out},
		Error:    option.None,
		Terminal: false,
	}}
}

func Close(s joinSess) {
	s.closes.Set(s.closes.Get() + 1)
}

func joinFamilyModel(branches int, tailCalls sync.Ref[int], totalCalls sync.Ref[int]) PathModel[joinState, joinCmd, joinState, int, core.Never] {
	let signals = []joinCmd{
		JoinBranch{Idx: 0},
		JoinBranch{Idx: 1},
		JoinBranch{Idx: 2},
		JoinBranch{Idx: 3},
		JoinMerge,
		JoinTailA,
		JoinTailB,
	}
	PathModel[joinState, joinCmd, joinState, int, core.Never]{
		Graph: ConcreteGraph[joinState, joinCmd, StepObs[joinState, int, core.Never]]{
			Starts:  []joinState{joinState{Layer: 0, Slot: 0}},
			Signals: signals,
			Step:    func(s joinState, cmd joinCmd) EdgeOutcome[joinState, StepObs[joinState, int, core.Never]] {
				totalCalls.Set(totalCalls.Get() + 1)
				if s.Layer >= 2 {
					tailCalls.Set(tailCalls.Get() + 1)
				}
				if s.Layer == 0 {
					match cmd {
					case JoinBranch as b:
						if b.Idx < branches {
							let next = joinState{Layer: 1, Slot: b.Idx}
							Continue[joinState, StepObs[joinState, int, core.Never]]{
								Next: next,
								Obs:  StepObs[joinState, int, core.Never]{Kind: DisEmit, State: option.Some[joinState]{Value: next}, Outputs: []int{10 + b.Idx}, Error: option.None, Terminal: false},
							}
						} else {
							Disabled[StepObs[joinState, int, core.Never]]{Obs: StepObs[joinState, int, core.Never]{Kind: DisIgnore, State: option.None, Outputs: []int{}, Error: option.None, Terminal: false}}
						}
					case _:
						Disabled[StepObs[joinState, int, core.Never]]{Obs: StepObs[joinState, int, core.Never]{Kind: DisIgnore, State: option.None, Outputs: []int{}, Error: option.None, Terminal: false}}
					}
				} else if s.Layer == 1 {
					match cmd {
					case JoinMerge:
						let next = joinState{Layer: 2, Slot: 0}
						Continue[joinState, StepObs[joinState, int, core.Never]]{
							Next: next,
							Obs:  StepObs[joinState, int, core.Never]{Kind: DisEmit, State: option.Some[joinState]{Value: next}, Outputs: []int{20}, Error: option.None, Terminal: false},
						}
					case _:
						Disabled[StepObs[joinState, int, core.Never]]{Obs: StepObs[joinState, int, core.Never]{Kind: DisIgnore, State: option.None, Outputs: []int{}, Error: option.None, Terminal: false}}
					}
				} else if s.Layer < 5 {
					match cmd {
					case JoinTailA:
						let next = joinState{Layer: s.Layer + 1, Slot: 0}
						Continue[joinState, StepObs[joinState, int, core.Never]]{
							Next: next,
							Obs:  StepObs[joinState, int, core.Never]{Kind: DisEmit, State: option.Some[joinState]{Value: next}, Outputs: []int{30 + s.Layer}, Error: option.None, Terminal: false},
						}
					case JoinTailB:
						let next = joinState{Layer: s.Layer + 1, Slot: 0}
						Continue[joinState, StepObs[joinState, int, core.Never]]{
							Next: next,
							Obs:  StepObs[joinState, int, core.Never]{Kind: DisEmit, State: option.Some[joinState]{Value: next}, Outputs: []int{40 + s.Layer}, Error: option.None, Terminal: false},
						}
					case _:
						Disabled[StepObs[joinState, int, core.Never]]{Obs: StepObs[joinState, int, core.Never]{Kind: DisIgnore, State: option.None, Outputs: []int{}, Error: option.None, Terminal: false}}
					}
				} else {
					Disabled[StepObs[joinState, int, core.Never]]{Obs: StepObs[joinState, int, core.Never]{Kind: DisIgnore, State: option.None, Outputs: []int{}, Error: option.None, Terminal: false}}
				}
			},
		},
		InitialObs:     func(s joinState) joinState { s },
		ProjectionName: option.None,
	}
}

// PlanningReuseDoesNotRestepJoins verifies on a family of converging join
// graphs that increasing history multiplicity increases logical replay paths
// and steps while unique model-edge expansion of the shared tail stays constant
// (one expansion per exact state), cursor spine depth stays bounded, and
// planning performs zero live session opens.
law PlanningReuseDoesNotRestepJoins() {
	let bounds = PathBounds{MaxStates: 64, MaxEdges: 256, MaxPaths: 512, MaxSteps: 4096, MaxWork: 200000, MaxBytes: 1048576}
	let mut baseTailCalls = -1
	let mut prevPaths = 0
	let mut prevSteps = 0

	for k in 1..5 {
		let tailCalls = sync.NewRef(0)
		let totalCalls = sync.NewRef(0)
		let opens = sync.NewRef(0)
		let closes = sync.NewRef(0)
		let model = joinFamilyModel(k, tailCalls, totalCalls)
		let plan = PlanPaths(model.Graph, ToDepth{Depth: 5}, bounds)
		match plan.Stop {
		case PathComplete:
		case _:
			return false
		}
		if opens.Get() != 0 {
			return false
		}
		let expandedUnique = plan.Stats.States - plan.Stats.Frontier
		let sigCount = plan.Graph.Signals.Len()
		if plan.Stats.Expansions != expandedUnique {
			return false
		}
		if plan.Stats.StepAttempts != expandedUnique*sigCount {
			return false
		}
		if totalCalls.Get()-plan.Stats.Reconstructions != plan.Stats.StepAttempts {
			return false
		}
		if baseTailCalls < 0 {
			baseTailCalls = tailCalls.Get()
		} else if tailCalls.Get() != baseTailCalls {
			return false
		}
		if plan.Stats.Paths <= prevPaths || plan.Stats.Steps <= prevSteps {
			return false
		}
		prevPaths = plan.Stats.Paths
		prevSteps = plan.Stats.Steps

		let openedCur = OpenPaths(plan)
		let mut peakSpine = 0
		let mut streamedPaths = 0
		let mut streamedSteps = 0
		match openedCur {
		case option.None:
			return false
		case option.Some as c0:
			let mut cur = c0.Value
			for {
				match NextPath(plan, &cur) {
				case option.None:
					break
				case option.Some as pc:
					let depth = CursorSpineDepth(cur)
					if depth > peakSpine {
						peakSpine = depth
					}
					streamedPaths = streamedPaths + 1
					streamedSteps = streamedSteps + pc.Value.Signals.Len()
				}
			}
		}
		if streamedPaths != plan.Stats.Paths || streamedSteps != plan.Stats.Steps {
			return false
		}
		if peakSpine > plan.Stats.MaxDepth+1 {
			return false
		}

		let stepBeforeReplay = totalCalls.Get()
		let res = CheckPlanPaths(
			model,
			plan,
			func(start joinState) PathSession[joinCmd, Observed[joinState, int, core.Never], joinDriveErr] fails joinOpenErr {
				opens.Set(opens.Get() + 1)
				joinSess{state: sync.NewRef(start), closes: closes}
			},
		)
		match res.Verdict {
		case CampaignPassed:
		case _:
			return false
		}
		if totalCalls.Get() != stepBeforeReplay {
			return false
		}
		if opens.Get() != plan.Stats.Paths || closes.Get() != plan.Stats.Paths {
			return false
		}
		if res.Counts.Opened != plan.Stats.Paths || res.Counts.InitialReads != plan.Stats.Paths || res.Counts.CheckedSteps != plan.Stats.Steps || res.Counts.MatchedSteps != plan.Stats.Steps {
			return false
		}
	}

	true
}
