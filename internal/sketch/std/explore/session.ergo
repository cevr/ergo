import core
import gen
import option
import sync
import task

// PathSession is one fresh, owned provider session for a single path case.
// Read observes the settled initial or current state; Apply delivers one input
// and returns after acknowledgment with the protocol observation (including
// expected rejections or terminal outcomes). DriveErr carries typed
// infrastructure failures separate from expected protocol outcomes.
// law-exempt: provider-specific session protocol whose reads and step outcomes depend on the implementation under test; SessionReleasesOnEveryExit and CheckPathsObservesPrefixes hold the session lifecycle.
type PathSession[E, Obs, DriveErr] {
	..core.Closer,
	Read() Obs fails DriveErr,
	Apply(input E) Obs fails DriveErr,
}

// SessionOutcome reports the settled outcome of driving one fresh PathSession.
// Expected protocol outcomes are compared in SessionMatched and SessionMismatch;
// typed infrastructure failures remain separate in SessionOpenFailed and
// SessionDriveFailed.
type SessionOutcome[Obs, OpenErr, DriveErr, Mismatch] =
	| SessionMatched{Initial Obs, Observed []Obs}
	| SessionMismatch{Step int, Observed Obs, Detail Mismatch}
	| SessionOpenFailed{Err OpenErr}
	| SessionDriveFailed{Step int, Err DriveErr}

// WithPathSession opens one fresh PathSession for start, lends it only to the
// non-escaping use function, and releases it via owner scope on every exit.
func WithPathSession[Start, E, Obs, OpenErr, DriveErr, Out, UseErr](
	start Start,
	open own func(start Start) PathSession[E, Obs, DriveErr] fails OpenErr,
	use func(s PathSession[E, Obs, DriveErr]) Out fails UseErr,
) Out fails OpenErr | UseErr {
	let s = try open(start)
	try use(s)
}

// DrivePathSession opens one fresh PathSession for start, checks the initial
// Read and each acknowledged Apply of inputs in order, and releases the session
// via owner scope on every exit before returning SessionOutcome.
func DrivePathSession[Start, E, Obs, OpenErr, DriveErr, Mismatch](
	start Start,
	inputs []E,
	open own func(start Start) PathSession[E, Obs, DriveErr] fails OpenErr,
	checkInitial func(obs Obs) option.Option[Mismatch],
	checkStep func(step int, input E, obs Obs) option.Option[Mismatch],
) SessionOutcome[Obs, OpenErr, DriveErr, Mismatch] {
	let s = open(start) catch {
	case err:
		return SessionOpenFailed[OpenErr]{Err: err}
	}
	let initial = s.Read() catch {
	case err:
		return SessionDriveFailed[DriveErr]{Step: 0, Err: err}
	}
	match checkInitial(initial) {
	case option.Some as m:
		return SessionMismatch[Obs, Mismatch]{Step: 0, Observed: initial, Detail: m.Value}
	case option.None:
	}
	let mut observed = []Obs{}
	for i in 0..inputs.Len() {
		let input = inputs[i]
		let obs = s.Apply(input) catch {
		case err:
			return SessionDriveFailed[DriveErr]{Step: i + 1, Err: err}
		}
		match checkStep(i+1, input, obs) {
		case option.Some as m:
			return SessionMismatch[Obs, Mismatch]{Step: i + 1, Observed: obs, Detail: m.Value}
		case option.None:
		}
		observed = observed.Append(obs)
	}
	SessionMatched[Obs]{Initial: initial, Observed: observed}
}

// RunPathSession drives one fresh PathSession for start and inputs, ensuring
// the acquired session is released on every exit before publish observes the
// resulting SessionOutcome.
func RunPathSession[Start, E, Obs, OpenErr, DriveErr, Mismatch, Out](
	start Start,
	inputs []E,
	open own func(start Start) PathSession[E, Obs, DriveErr] fails OpenErr,
	checkInitial func(obs Obs) option.Option[Mismatch],
	checkStep func(step int, input E, obs Obs) option.Option[Mismatch],
	publish func(out SessionOutcome[Obs, OpenErr, DriveErr, Mismatch]) Out,
) Out {
	let out = DrivePathSession(start, inputs, open, checkInitial, checkStep)
	publish(out)
}

type psOpenErr { Why string }

type psDriveErr { Why string }

type psMismatch { Step int, Want int, Got int }

type psObs = psReady{Val int} | psApplied{Val int} | psRejected{At int}

type psEvent { Acquire bool, Item int }

type psPart {
	id  int,
	log sync.Ref[[]psEvent],
} implements core.Closer

func Close(p psPart) {
	p.log.Update(func(xs []psEvent) []psEvent { xs.Append(psEvent{Acquire: false, Item: p.id}) })
}

func psAcquirePart(id int, log sync.Ref[[]psEvent]) psPart {
	log.Update(func(xs []psEvent) []psEvent { xs.Append(psEvent{Acquire: true, Item: id}) })
	psPart{id: id, log: log}
}

type psSession {
	first    psPart,
	second   psPart,
	val      sync.Ref[int],
	failRead bool,
	failStep int,
} implements PathSession[int, psObs, psDriveErr]

func Read(s psSession) psObs fails psDriveErr {
	if s.failRead {
		return psDriveErr{Why: "read transport error"}
	}
	psReady{Val: s.val.Get()}
}

func Apply(s psSession, n int) psObs fails psDriveErr {
	if s.failStep == n {
		return psDriveErr{Why: "apply transport error"}
	}
	if n < 0 {
		return psRejected{At: s.val.Get()}
	}
	let next = sync.Modify(s.val, func(cur int) (int, int) { (cur + n, cur + n) })
	psApplied{Val: next}
}

func Close(s psSession) {
	let _ = s.val.Get()
}

type psStart {
	baseID     int,
	initVal    int,
	failSecond bool,
	failRead   bool,
	failStep   int,
	log        sync.Ref[[]psEvent],
}

func psOpen(st psStart) PathSession[int, psObs, psDriveErr] fails psOpenErr {
	let p1 = psAcquirePart(st.baseID, st.log)
	if st.failSecond {
		return psOpenErr{Why: "second part unavailable"}
	}
	let p2 = psAcquirePart(st.baseID+1, st.log)
	let val = sync.NewRef(st.initVal)
	psSession{
		first:    p1,
		second:   p2,
		val:      val,
		failRead: st.failRead,
		failStep: st.failStep,
	}
}

func psLogBalanced(events []psEvent, wantItems []int) bool {
	if events.Len() != wantItems.Len()*2 {
		return false
	}
	let mut stack = []int{}
	let mut seenAcq = []int{}
	for ev in events {
		if ev.Acquire {
			stack = stack.Append(ev.Item)
			seenAcq = seenAcq.Append(ev.Item)
		} else {
			if stack.Len() == 0 {
				return false
			}
			let top = stack[stack.Len()-1]
			if top != ev.Item {
				return false
			}
			stack = stack[0 : stack.Len()-1]
		}
	}
	stack.Len() == 0 && seenAcq == wantItems
}

// SessionReleasesOnEveryExit exercises an Ergo resource and acknowledged
// PathSession driver across normal match, mismatch/refutation, partial
// acquisition failure, typed drive failure, and supervised child stop/defect,
// asserting every acquired item is released once in reverse order before
// verdicts are published.
law SessionReleasesOnEveryExit() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let bias = gen.Named("bias", showInt, func() int needs gen.Draws { gen.IntIn(0, 4) })

		let matchLog = sync.NewRef([]psEvent{})
		let matchStart = psStart{baseID: 10, initVal: bias, failSecond: false, failRead: false, failStep: 99, log: matchLog}
		let matchOK = RunPathSession(
			matchStart,
			[]int{2, -1, 3},
			psOpen,
			func(obs psObs) option.Option[psMismatch] {
				match obs {
				case psReady as r:
					if r.Val == bias { option.None } else { option.Some[psMismatch]{Value: psMismatch{Step: 0, Want: bias, Got: r.Val}} }
				case _:
					option.Some[psMismatch]{Value: psMismatch{Step: 0, Want: bias, Got: -1}}
				}
			},
			func(step int, input int, obs psObs) option.Option[psMismatch] {
				if step == 1 && input == 2 {
					match obs {
					case psApplied as a:
						if a.Val == bias+2 { option.None } else { option.Some[psMismatch]{Value: psMismatch{Step: 1, Want: bias + 2, Got: a.Val}} }
					case _:
						option.Some[psMismatch]{Value: psMismatch{Step: 1, Want: bias + 2, Got: -1}}
					}
				} else if step == 2 && input == -1 {
					match obs {
					case psRejected as r:
						if r.At == bias+2 { option.None } else { option.Some[psMismatch]{Value: psMismatch{Step: 2, Want: bias + 2, Got: r.At}} }
					case _:
						option.Some[psMismatch]{Value: psMismatch{Step: 2, Want: bias + 2, Got: -1}}
					}
				} else {
					match obs {
					case psApplied as a:
						if a.Val == bias+5 { option.None } else { option.Some[psMismatch]{Value: psMismatch{Step: 3, Want: bias + 5, Got: a.Val}} }
					case _:
						option.Some[psMismatch]{Value: psMismatch{Step: 3, Want: bias + 5, Got: -1}}
					}
				}
			},
			func(out SessionOutcome[psObs, psOpenErr, psDriveErr, psMismatch]) bool {
				if !psLogBalanced(matchLog.Get(), []int{10, 11}) {
					return false
				}
				match out {
				case SessionMatched as m:
					m.Observed.Len() == 3
				case _:
					false
				}
			},
		)
		if !matchOK {
			return false
		}

		let misLog = sync.NewRef([]psEvent{})
		let misStart = psStart{baseID: 20, initVal: bias, failSecond: false, failRead: false, failStep: 99, log: misLog}
		let misOK = RunPathSession(
			misStart,
			[]int{1, 2},
			psOpen,
			func(_ psObs) option.Option[psMismatch] { option.None },
			func(step int, _ int, obs psObs) option.Option[psMismatch] {
				if step == 1 {
					option.Some[psMismatch]{Value: psMismatch{Step: 1, Want: 999, Got: bias + 1}}
				} else {
					option.None
				}
			},
			func(out SessionOutcome[psObs, psOpenErr, psDriveErr, psMismatch]) bool {
				if !psLogBalanced(misLog.Get(), []int{20, 21}) {
					return false
				}
				match out {
				case SessionMismatch as m:
					m.Step == 1 && m.Detail.Want == 999
				case _:
					false
				}
			},
		)
		if !misOK {
			return false
		}

		let initMisLog = sync.NewRef([]psEvent{})
		let initMisStart = psStart{baseID: 24, initVal: bias, failSecond: false, failRead: false, failStep: 99, log: initMisLog}
		let initMisOK = RunPathSession(
			initMisStart,
			[]int{},
			psOpen,
			func(_ psObs) option.Option[psMismatch] { option.Some[psMismatch]{Value: psMismatch{Step: 0, Want: -1, Got: bias}} },
			func(_ int, _ int, _ psObs) option.Option[psMismatch] { option.None },
			func(out SessionOutcome[psObs, psOpenErr, psDriveErr, psMismatch]) bool {
				if !psLogBalanced(initMisLog.Get(), []int{24, 25}) {
					return false
				}
				match out {
				case SessionMismatch as m:
					m.Step == 0
				case _:
					false
				}
			},
		)
		if !initMisOK {
			return false
		}

		let partialLog = sync.NewRef([]psEvent{})
		let partialStart = psStart{baseID: 30, initVal: bias, failSecond: true, failRead: false, failStep: 99, log: partialLog}
		let partialOK = RunPathSession(
			partialStart,
			[]int{1},
			psOpen,
			func(_ psObs) option.Option[psMismatch] { option.None },
			func(_ int, _ int, _ psObs) option.Option[psMismatch] { option.None },
			func(out SessionOutcome[psObs, psOpenErr, psDriveErr, psMismatch]) bool {
				if !psLogBalanced(partialLog.Get(), []int{30}) {
					return false
				}
				match out {
				case SessionOpenFailed:
					true
				case _:
					false
				}
			},
		)
		if !partialOK {
			return false
		}

		let readErrLog = sync.NewRef([]psEvent{})
		let readErrStart = psStart{baseID: 40, initVal: bias, failSecond: false, failRead: true, failStep: 99, log: readErrLog}
		let readErrOK = RunPathSession(
			readErrStart,
			[]int{1},
			psOpen,
			func(_ psObs) option.Option[psMismatch] { option.None },
			func(_ int, _ int, _ psObs) option.Option[psMismatch] { option.None },
			func(out SessionOutcome[psObs, psOpenErr, psDriveErr, psMismatch]) bool {
				if !psLogBalanced(readErrLog.Get(), []int{40, 41}) {
					return false
				}
				match out {
				case SessionDriveFailed as d:
					d.Step == 0
				case _:
					false
				}
			},
		)
		if !readErrOK {
			return false
		}

		let applyErrLog = sync.NewRef([]psEvent{})
		let applyErrStart = psStart{baseID: 50, initVal: bias, failSecond: false, failRead: false, failStep: 7, log: applyErrLog}
		let applyErrOK = RunPathSession(
			applyErrStart,
			[]int{1, 7},
			psOpen,
			func(_ psObs) option.Option[psMismatch] { option.None },
			func(_ int, _ int, _ psObs) option.Option[psMismatch] { option.None },
			func(out SessionOutcome[psObs, psOpenErr, psDriveErr, psMismatch]) bool {
				if !psLogBalanced(applyErrLog.Get(), []int{50, 51}) {
					return false
				}
				match out {
				case SessionDriveFailed as d:
					d.Step == 2
				case _:
					false
				}
			},
		)
		if !applyErrOK {
			return false
		}

		let escLog = sync.NewRef([]psEvent{})
		let escStart = psStart{baseID: 60, initVal: bias, failSecond: false, failRead: false, failStep: 99, log: escLog}
		let escOK = WithPathSession(escStart, psOpen, func(s PathSession[int, psObs, psDriveErr]) bool fails psDriveErr | psMismatch {
			let _ = try s.Read()
			return psMismatch{Step: 0, Want: 1, Got: 2}
		}) catch {
		case psMismatch:
			psLogBalanced(escLog.Get(), []int{60, 61})
		case psOpenErr, psDriveErr:
			false
		}
		if !escOK {
			return false
		}

		let stopLog = sync.NewRef([]psEvent{})
		let stopStart = psStart{baseID: 70, initVal: bias, failSecond: false, failRead: false, failStep: 99, log: stopLog}
		let entered = sync.NewLatch()
		let park = sync.NewLatch()
		let stoppedChild = task.Go() {
			WithPathSession(stopStart, psOpen, func(s PathSession[int, psObs, psDriveErr]) int fails psDriveErr {
				let _ = try s.Read()
				let _ = sync.Open(entered)
				sync.Await(park)
				0
			})
		}
		sync.Await(entered)
		stoppedChild.Stop()
		if !psLogBalanced(stopLog.Get(), []int{70, 71}) {
			return false
		}

		let defLog = sync.NewRef([]psEvent{})
		let defStart = psStart{baseID: 80, initVal: bias, failSecond: false, failRead: false, failStep: 99, log: defLog}
		let defChild = task.Go() {
			WithPathSession(defStart, psOpen, func(s PathSession[int, psObs, psDriveErr]) int fails psDriveErr {
				let _ = try s.Read()
				let xs = []int{}
				xs[0]
			})
		}
		let defExited = match task.ExitOf(defChild) {
		case task.Defected:
			true
		case _:
			false
		}
		defExited && psLogBalanced(defLog.Get(), []int{80, 81})
	})) == ""
	true
}
