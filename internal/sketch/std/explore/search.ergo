// The state explorer (docs/spec/stdlib.md, Testing; types.md, Laws 13;
// MODELCHECK E1). A Graph is a set of starts, a list of signals and a
// step; Always, Sometimes and Path decide a property on the graph by a
// breadth-first search with a visited set of 128-bit keys, so a
// counterexample or a witness is a shortest run, and the search says
// "proved" only when it saw the whole graph within its budget of states.
// A machine law (`never reaches`, `always`, `sometimes`, `path`) is decided
// by these same functions on Of(machine); a user's own graph gets the same
// search and the same keys. It is ordinary Ergo: no Go body, no rule of
// the compiler keyed on this package.
//
// Prior art: TLC's breadth-first search over fingerprints (64-bit; here
// 128, Q6), its parent pointers for the trace; Stateright's embedded
// checker, whose model is compiled host code; P's PEx keeps hashes of
// visited states.

import go math
import dense
import gen

// Graph is what a search explores: its starts, its signals, and its step
// as an edge, None when the step ends the run (no edge).
type Graph[S, E] {
	Starts  []S,
	Signals []E,
	Step    func(s S, e E) Option[S],
}

// Hash is the 128-bit key of a state: the hash of the events of its wire
// form (types.md, Codecs). Equal values write equal events, so they have
// one key; the events are prefix free (each starts with its kind and each
// count and text with its length) and a float writes its bits, so two
// values a step can tell apart write different events, and share a key
// only by a hash collision (about 2^-128 a pair).
type Hash { Hi uint64, Lo uint64 }

// Hasher is a Writer that hashes the events written to it: Sum is the key
// of the events so far, size the count of 64-bit words it took in (the
// size of the state, by which a search decides to keep it whole). size is
// unexported, so the operation type is sealed in this package and a
// hasher moves into a cell as json's text does.
// law-exempt: Hasher is a Writer whose reads are Sum and size, a hash; KeyIsEquality states its law over the values written (equal values, equal keys; unequal values, unequal keys).
type Hasher {
	..Writer,
	Sum() Hash,
	size() int,
}

// hasher is Hasher's one provider: the two lanes of the hash and the
// count of words.
type hasher { hi uint64, lo uint64, n int } implements Hasher

// The odd constants of the mixes: the golden ratio's (Fibonacci hashing),
// murmur3's and splitmix64's finalizers.
let golden uint64 = 0x9e3779b97f4a7c15
let mixHi uint64 = 0xc2b2ae3d27d4eb4f
let smixA uint64 = 0xbf58476d1ce4e5b9
let smixB uint64 = 0x94d049bb133111eb

func newHasher() hasher { hasher{hi: uint64(0x6c62272e07bb0142), lo: uint64(0x62b821756295c58d), n: 0} }

// absorb takes in one word: each lane is a multiply and a shift, and the
// high lane reads the low one, so the state is 128 bits wide.
func absorb(h mut hasher, x uint64) {
	let lo = (h.lo ^ x) * golden
	let l = lo ^ (lo >> uint64(31))
	let hi = (h.hi ^ x ^ l) * mixHi
	h.hi = hi ^ (hi >> uint64(29))
	h.lo = l
	h.n = h.n + 1
}

// absorbText takes in a text: its length, then its bytes, eight to a word.
func absorbText(h mut hasher, s string) {
	absorb(h, uint64(len(s)))
	let mut w = uint64(0)
	let mut k = 0
	for i in 0..len(s) {
		w = w | (uint64(s[i]) << uint64(8*k))
		k = k + 1
		if k == 8 {
			absorb(h, w)
			w = uint64(0)
			k = 0
		}
	}
	if k > 0 {
		absorb(h, w)
	}
}

func Null(h mut hasher) { absorb(h, uint64(1)) }
func Number(h mut hasher, text string) {
	absorb(h, uint64(2))
	absorbText(h, text)
}
func Bool(h mut hasher, b bool) { absorb(h, if b { uint64(4) } else { uint64(3) }) }
func Int(h mut hasher, n int64) {
	absorb(h, uint64(5))
	absorb(h, uint64(n))
}
func Uint(h mut hasher, n uint64) {
	absorb(h, uint64(6))
	absorb(h, n)
}

// Float takes in the float's bits as they are: 0 and -0 stay apart, as a
// step can tell them apart, and a NaN is one state by its payload
// (batch-15 X1 M1).
func Float(h mut hasher, f float64) {
	absorb(h, uint64(7))
	absorb(h, math.Float64bits(f))
}
func String(h mut hasher, s string) {
	absorb(h, uint64(8))
	absorbText(h, s)
}

// StringBytes takes in the string its bytes spell, as String does, with
// no string made of them (Writer's StringBytes, GX12).
func StringBytes(h mut hasher, b []byte) {
	absorb(h, uint64(8))
	absorb(h, uint64(len(b)))
	let mut w = uint64(0)
	let mut k = 0
	for i in 0..len(b) {
		w = w | (uint64(b[i]) << uint64(8*k))
		k = k + 1
		if k == 8 {
			absorb(h, w)
			w = uint64(0)
			k = 0
		}
	}
	if k > 0 {
		absorb(h, w)
	}
}
func BeginList(h mut hasher, n int) {
	absorb(h, uint64(9))
	absorb(h, uint64(n))
}
func EndList(h mut hasher) { absorb(h, uint64(10)) }
func BeginObject(h mut hasher, n int) {
	absorb(h, uint64(11))
	absorb(h, uint64(n))
}
func Tag(h mut hasher, name string) {
	absorb(h, uint64(12))
	absorbText(h, name)
}
func Key(h mut hasher, k string) {
	absorb(h, uint64(13))
	absorbText(h, k)
}
func EndObject(h mut hasher) { absorb(h, uint64(14)) }
func Sum(h hasher) Hash      { Hash{Hi: h.hi, Lo: h.lo} }
func size(h hasher) int      { h.n }

// KeyOf is the key of s and the count of words its wire form took.
func KeyOf[S wire](s S) (Hash, int) needs wired[S] {
	let h Hasher = newHasher()
	encode(s, h)
	(h.Sum(), h.size())
}

// KeyIsEquality: two values have one key exactly when they are equal,
// a float compared by its bits (types.md, Laws 13). b is a near miss of a:
// a with one part changed, often to a value equal to the old one, or to
// one that writes the same bytes but for a length ("a" and "a\x00"), or
// to -0 for 0, so equal and unequal pairs are both common and differ in
// one place. The seeded property TestKeyEqualsEquality (std explore's
// Go test) holds it over generated types as well.
law KeyIsEquality(a Probe, which uint8, n int) {
	let b = nearby(a, which, n)
	let (ka, _) = KeyOf(a)
	let (kb, _) = KeyOf(b)
	(ka == kb) == sameBits(a, b)
}

// Probe is a state type the law above draws: a record, a union, a slice,
// a Map, a float and a text, so each event kind is taken in.
type Probe { N int, On bool, F float64, Text string, Xs []uint8, M Map[string, int], Pick Pick }

type Pick = Left{} | Right{V int} | Both{A int8, B string}

// nearby is a with the part which picks changed by n.
func nearby(a Probe, which uint8, n int) Probe {
	let mut b = a
	let flip = n%2 == 0
	let w = which % uint8(8)
	if w == uint8(0) {
		b.N = if flip { a.N } else { a.N + 1 }
	} else if w == uint8(1) {
		b.On = flip
	} else if w == uint8(2) {
		b.Text = if flip { a.Text + "\x00" } else { a.Text }
	} else if w == uint8(3) {
		b.Xs = if flip { a.Xs.Append(uint8(0)) } else { a.Xs }
	} else if w == uint8(4) {
		b.M = a.M.Put("k", n%3)
	} else if w == uint8(5) {
		b.Pick = if flip { Left } else { Right{V: n % 2} }
	} else if w == uint8(6) {
		b.F = 0.0 - a.F
	} else {
		b.F = if flip { a.F } else { 0.0 }
	}
	b
}

// sameBits is a == b with the floats compared by their bits.
func sameBits(a Probe, b Probe) bool {
	a.N == b.N && a.On == b.On && math.Float64bits(a.F) == math.Float64bits(b.F) && a.Text == b.Text && a.Xs == b.Xs && a.M == b.M && a.Pick == b.Pick
}

// Stats is what a search did: the states it saw, the steps it took that
// did not end the run (edges), the longest shortest run of a state it saw
// (Depth), the longest run length up to which it checked every run
// (Checked: Depth when Complete, else one less than the layer the budget
// stopped, -1 when the budget stopped it among the starts), whether it
// saw the whole graph, and the peak count of whole states it kept in its
// frontier (Frontier: a wide state is rebuilt from its run instead).
type Stats {
	States   int,
	Edges    int,
	Depth    int,
	Checked  int,
	Complete bool,
	Frontier int,
}

// Run is a run of a graph: the index of its start in Starts and the
// indexes of its signals in Signals, in order.
type Run { Start int, Signals []int }

// Result is a search: Found is the node of the first target it met (for
// Path, of the last layer), or -1; Stats its counters. parent and sig are
// the nodes it saw: from the start Starts[sig] when parent is -1, else
// from the node parent by Signals[sig].
type Result { Found int, Stats Stats, parent []int32, sig []int32 }

func floatBits(f float64) uint64 { math.Float64bits(f) }

func reconstructRun(parent []int32, sig []int32, i int) Run {
	let mut back = []int{}
	let mut at = i
	for parent[at] >= int32(0) {
		back = back.Append(int(sig[at]))
		at = int(parent[at])
	}
	let mut sigs = []int{}
	for j in 0..len(back) {
		sigs = sigs.Append(back[len(back)-1-j])
	}
	Run{Start: int(sig[at]), Signals: sigs}
}

func pushKept[S](kept []Option[S], held int, s S, words int) ([]Option[S], int) {
	if words <= SmallWords {
		return (kept.Append(Some[S]{Value: s}), held + 1)
	}
	(kept.Append(None), held)
}

// RunTo is the run to the node i of r.
func RunTo(r Result, i int) Run { reconstructRun(r.parent, r.sig, i) }

// ReplayRun is the state at the end of run, stepped from its start. A step
// that ends the run keeps the state.
func ReplayRun[S, E](g Graph[S, E], run Run) S {
	let mut s = g.Starts[run.Start]
	for e in run.Signals {
		match g.Step(s, g.Signals[e]) {
		case Some[S] as t:
			s = t.Value
		case None:
		}
	}
	s
}

func larger(a int, b int) int { if a > b { a } else { b } }

// SmallWords is the widest state, in words of its key's events, that a
// search keeps whole in its frontier; a wider one is rebuilt by replaying
// its run when it is expanded (batch-15 r7: a frontier of whole worlds
// ran out of memory at 5 M states).
let SmallWords = 16

// Search explores g breadth first from its starts, the starts included,
// until it meets a state for which target holds or it has seen budget
// states. The first target it meets has a shortest run.
func Search[S wire, E](g Graph[S, E], target func(s S) bool, budget int) Result needs wired[S] {
	let mut seen = dense.NewKeys()
	let mut parent = []int32{}
	let mut sig = []int32{}
	let mut st = Stats{States: 0, Edges: 0, Depth: 0, Checked: 0, Complete: false, Frontier: 0}
	let mut ids = []int{}
	let mut kept = []Option[S]{}
	let mut held = 0
	for i in 0..len(g.Starts) {
		let s = g.Starts[i]
		let (k, words) = KeyOf(s)
		if !dense.AddKey(&seen, k.Hi, k.Lo) {
			continue
		}
		if len(parent) == budget {
			st.Checked = -1
			return Result{Found: -1, Stats: st, parent: parent, sig: sig}
		}
		parent = parent.Append(int32(-1))
		sig = sig.Append(int32(i))
		st.States = st.States + 1
		if target(s) {
			return Result{Found: len(parent) - 1, Stats: st, parent: parent, sig: sig}
		}
		let (k2, h2) = pushKept(kept, held, s, words)
		kept = k2
		held = h2
		st.Frontier = larger(st.Frontier, held)
		ids = ids.Append(len(parent) - 1)
	}
	let mut depth = 1
	for len(ids) > 0 {
		let mut next = []int{}
		let mut nextKept = []Option[S]{}
		let mut nextHeld = 0
		for f in 0..len(ids) {
			let s = frontierState(g, parent, sig, kept[f], ids[f])
			for e in 0..len(g.Signals) {
				match g.Step(s, g.Signals[e]) {
				case None:
				case Some[S] as stepped:
					let t = stepped.Value
					st.Edges = st.Edges + 1
					let (k, words) = KeyOf(t)
					if dense.AddKey(&seen, k.Hi, k.Lo) {
						if len(parent) == budget {
							st.Checked = depth - 1
							return Result{Found: -1, Stats: st, parent: parent, sig: sig}
						}
						parent = parent.Append(int32(ids[f]))
						sig = sig.Append(int32(e))
						st.States = st.States + 1
						st.Depth = depth
						if target(t) {
							return Result{Found: len(parent) - 1, Stats: st, parent: parent, sig: sig}
						}
						let (nk2, nh2) = pushKept(nextKept, nextHeld, t, words)
						nextKept = nk2
						nextHeld = nh2
						st.Frontier = larger(st.Frontier, held+nextHeld)
						next = next.Append(len(parent) - 1)
					}
				}
			}
		}
		ids = next
		kept = nextKept
		held = nextHeld
		depth = depth + 1
	}
	st.Checked = st.Depth
	st.Complete = true
	Result{Found: -1, Stats: st, parent: parent, sig: sig}
}

// frontierState is the state of the node id: the kept one, or the one its
// run replays to.
func frontierState[S, E](g Graph[S, E], parent []int32, sig []int32, kept Option[S], id int) S {
	match kept {
	case Some[S] as s:
		s.Value
	case None:
		ReplayRun(g, reconstructRun(parent, sig, id))
	}
}

// PathSearch looks for a run whose first len(targets) states meet targets
// in order: layer k holds the distinct states that a run meeting
// targets[0] to targets[k] reaches. It stops at budget states over all
// layers. Found is a node of the last layer, or -1; Complete is true when
// the search ended within the budget.
func PathSearch[S wire, E](g Graph[S, E], targets []func(s S) bool, budget int) Result needs wired[S] {
	let mut layer = dense.NewKeys()
	let mut parent = []int32{}
	let mut sig = []int32{}
	let mut st = Stats{States: 0, Edges: 0, Depth: 0, Checked: 0, Complete: false, Frontier: 0}
	let mut ids = []int{}
	let mut kept = []Option[S]{}
	let mut held = 0
	if len(targets) == 0 {
		st.Complete = true
		return Result{Found: -1, Stats: st, parent: parent, sig: sig}
	}
	for i in 0..len(g.Starts) {
		let s = g.Starts[i]
		if targets[0](s) {
			let (k, words) = KeyOf(s)
			if dense.AddKey(&layer, k.Hi, k.Lo) {
				if len(parent) == budget {
					st.States = len(parent)
					return Result{Found: -1, Stats: st, parent: parent, sig: sig}
				}
				parent = parent.Append(int32(-1))
				sig = sig.Append(int32(i))
				let (k2, h2) = pushKept(kept, held, s, words)
				kept = k2
				held = h2
				st.Frontier = larger(st.Frontier, held)
				ids = ids.Append(len(parent) - 1)
			}
		}
	}
	let mut d = 1
	for d < len(targets) && len(ids) > 0 {
		layer = dense.NewKeys()
		let mut next = []int{}
		let mut nextKept = []Option[S]{}
		let mut nextHeld = 0
		for f in 0..len(ids) {
			let s = frontierState(g, parent, sig, kept[f], ids[f])
			for e in 0..len(g.Signals) {
				match g.Step(s, g.Signals[e]) {
				case None:
				case Some[S] as stepped:
					let t = stepped.Value
					st.Edges = st.Edges + 1
					if targets[d](t) {
						let (k, words) = KeyOf(t)
						if dense.AddKey(&layer, k.Hi, k.Lo) {
							if len(parent) == budget {
								st.States = len(parent)
								return Result{Found: -1, Stats: st, parent: parent, sig: sig}
							}
							parent = parent.Append(int32(ids[f]))
							sig = sig.Append(int32(e))
							let (nk2, nh2) = pushKept(nextKept, nextHeld, t, words)
							nextKept = nk2
							nextHeld = nh2
							st.Frontier = larger(st.Frontier, held+nextHeld)
							next = next.Append(len(parent) - 1)
						}
					}
				}
			}
		}
		ids = next
		kept = nextKept
		held = nextHeld
		st.Depth = d
		d = d + 1
	}
	st.States = len(parent)
	st.Checked = st.Depth
	st.Complete = true
	let found = if len(ids) > 0 { ids[0] } else { -1 }
	Result{Found: found, Stats: st, parent: parent, sig: sig}
}

// Moves is the indexes of the signals whose step from s does not end the
// run and goes to a state with another key: the moves a random walk picks
// from, so it does not spend its steps on Ignore and Reject.
func Moves[S wire, E](g Graph[S, E], s S) []int needs wired[S] {
	let (here, _) = KeyOf(s)
	let mut out = []int{}
	for e in 0..len(g.Signals) {
		match g.Step(s, g.Signals[e]) {
		case None:
		case Some[S] as t:
			let (k, _) = KeyOf(t.Value)
			if k != here {
				out = out.Append(e)
			}
		}
	}
	out
}

type ceState { Tag uint8, Val int }

type ceEvent = ceBump{Delta int} | ceProbe{Kind uint8} | ceFinish{Code int}

type ceOut { Code int, At int }

type ceOracleEdge { Source int, Signal int, EventID int, Target EdgeTarget, Obs MachineObs[ceOut] }

func ceMachine(mod int, bonus int) Machine[ceState, ceEvent, ceOut] {
	Machine[ceState, ceEvent, ceOut]{
		Initial: ceState{Tag: uint8(0), Val: 0},
		Step:    func(s ceState, e ceEvent) Decision[ceState, ceOut] {
			match e {
			case ceBump as b:
				let nextVal = (s.Val + b.Delta) % mod
				let nextTag = if nextVal == 0 { uint8(1) } else { s.Tag }
				let next = ceState{Tag: nextTag, Val: nextVal}
				if b.Delta == 1 {
					Enter[ceState]{Next: next}
				} else {
					Emit[ceState, ceOut]{Next: next, Output: ceOut{Code: b.Delta + bonus, At: s.Val}}
				}
			case ceProbe as p:
				if p.Kind == uint8(0) {
					Ignore
				} else {
					Reject
				}
			case ceFinish as f:
				Done[ceOut]{Output: ceOut{Code: f.Code, At: s.Val}}
			}
		},
		After: func(_ ceState) Option[Timeout[ceEvent]] { None },
		Work:  func(_ ceState) Option[func(send func(e ceEvent))] { None },
		Exit:  func(_ ceState) Option[func()] { None },
	}
}

func ceOracleFindState(xs []ceState, x ceState) int {
	for i in 0..len(xs) {
		if xs[i] == x {
			return i
		}
	}
	-1
}

func ceOracleFindEvent(xs []ceEvent, x ceEvent) int {
	for i in 0..len(xs) {
		if xs[i] == x {
			return i
		}
	}
	-1
}

func ceOracleBuild(m Machine[ceState, ceEvent, ceOut], rawSignals []ceEvent) (int, []ceOracleEdge, int) {
	let mut sigs = []ceEvent{}
	let mut sigIdx = []int{}
	for i in 0..len(rawSignals) {
		if ceOracleFindEvent(sigs, rawSignals[i]) < 0 {
			sigs = sigs.Append(rawSignals[i])
			sigIdx = sigIdx.Append(i)
		}
	}
	let mut states = []ceState{m.Initial}
	let mut frontier = []int{0}
	let mut edges = []ceOracleEdge{}
	let mut depth = 0
	let mut d = 1
	for len(frontier) > 0 {
		let mut next = []int{}
		for src in frontier {
			let s = states[src]
			for evID in 0..len(sigs) {
				let dec = m.Step(s, sigs[evID])
				match dec {
				case Done[ceOut] as done:
					edges = edges.Append(ceOracleEdge{
						Source:  src,
						Signal:  sigIdx[evID],
						EventID: evID,
						Target:  Ended,
						Obs:     MachineObs[ceOut]{Kind: DisDone, Output: Some[ceOut]{Value: done.Output}},
					})
				case Ignore:
					edges = edges.Append(ceOracleEdge{
						Source:  src,
						Signal:  sigIdx[evID],
						EventID: evID,
						Target:  ToState{State: src},
						Obs:     MachineObs[ceOut]{Kind: DisIgnore, Output: None},
					})
				case Reject:
					edges = edges.Append(ceOracleEdge{
						Source:  src,
						Signal:  sigIdx[evID],
						EventID: evID,
						Target:  ToState{State: src},
						Obs:     MachineObs[ceOut]{Kind: DisReject, Output: None},
					})
				case Enter[ceState] as en:
					let mut dst = ceOracleFindState(states, en.Next)
					if dst < 0 {
						dst = len(states)
						states = states.Append(en.Next)
						next = next.Append(dst)
						depth = d
					}
					edges = edges.Append(ceOracleEdge{
						Source:  src,
						Signal:  sigIdx[evID],
						EventID: evID,
						Target:  ToState{State: dst},
						Obs:     MachineObs[ceOut]{Kind: DisEnter, Output: None},
					})
				case Stay[ceState] as st:
					let mut dst = ceOracleFindState(states, st.Next)
					if dst < 0 {
						dst = len(states)
						states = states.Append(st.Next)
						next = next.Append(dst)
						depth = d
					}
					edges = edges.Append(ceOracleEdge{
						Source:  src,
						Signal:  sigIdx[evID],
						EventID: evID,
						Target:  ToState{State: dst},
						Obs:     MachineObs[ceOut]{Kind: DisStay, Output: None},
					})
				case Emit[ceState, ceOut] as em:
					let mut dst = ceOracleFindState(states, em.Next)
					if dst < 0 {
						dst = len(states)
						states = states.Append(em.Next)
						next = next.Append(dst)
						depth = d
					}
					edges = edges.Append(ceOracleEdge{
						Source:  src,
						Signal:  sigIdx[evID],
						EventID: evID,
						Target:  ToState{State: dst},
						Obs:     MachineObs[ceOut]{Kind: DisEmit, Output: Some[ceOut]{Value: em.Output}},
					})
				case Tell[ceState, ceOut] as tl:
					let mut dst = ceOracleFindState(states, tl.Next)
					if dst < 0 {
						dst = len(states)
						states = states.Append(tl.Next)
						next = next.Append(dst)
						depth = d
					}
					edges = edges.Append(ceOracleEdge{
						Source:  src,
						Signal:  sigIdx[evID],
						EventID: evID,
						Target:  ToState{State: dst},
						Obs:     MachineObs[ceOut]{Kind: DisTell, Output: Some[ceOut]{Value: tl.Output}},
					})
				}
			}
		}
		frontier = next
		d = d + 1
	}
	(len(states), edges, depth)
}

func checkForcedCollision(val int, hashHi uint64) bool {
	let ka = CanonicalKeyOf(ceState{Tag: uint8(0), Val: val}) catch {
	case Keyless:
		return false
	}
	let kb = CanonicalKeyOf(ceState{Tag: uint8(1), Val: val}) catch {
	case Keyless:
		return false
	}
	let zero = if hashHi == uint64(0) { 0.0 } else { 0.0 }
	let negOne = if hashHi == uint64(0) { -1.0 } else { -1.0 }
	let kPosZero = CanonicalKeyOf(zero) catch {
	case Keyless:
		return false
	}
	let floatNeg = CanonicalKeyOf(negOne * zero) catch {
	case Keyless:
		return false
	}
	let forced = Hash{Hi: hashHi, Lo: hashHi ^ uint64(0x55aa)}
	let mut kt = NewKeyTable()
	let (idA, freshA, _) = InternWithHash(&kt, ka.Bytes, forced)
	let (idB, freshB, _) = InternWithHash(&kt, kb.Bytes, forced)
	let (idA2, freshA2, _) = InternWithHash(&kt, ka.Bytes, forced)
	let (idB2, freshB2, _) = InternWithHash(&kt, kb.Bytes, forced)
	let mut ft = NewKeyTable()
	let (f0, ff0, _) = InternWithHash(&ft, kPosZero.Bytes, forced)
	let (f1, ff1, _) = InternWithHash(&ft, floatNeg.Bytes, forced)
	idA == 0 && freshA && idB == 1 && freshB && idA2 == 0 && !freshA2 && idB2 == 1 && !freshB2 && KeyTableLen(kt) == 2 && f0 == 0 && ff0 && f1 == 1 && ff1
}

// EdgesKeepIdentity checks that BuildConcrete agrees with an independent table
// oracle on concrete states and attempted edges (including back-edges to visited
// nodes, distinct Ignore vs Reject self-loops, distinct payload aliases under one
// tag, Done with output, Disabled work charging, and reachability agreement) and
// that KeyTable keeps distinct canonical keys separate even under hash collision.
law EdgesKeepIdentity() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let mod = gen.Named("mod", showInt, func() int needs gen.Draws { gen.IntIn(3, 5) })
		let bonus = gen.Named("bonus", showInt, func() int needs gen.Draws { gen.IntIn(0, 4) })
		let finishCode = gen.Named("finishCode", showInt, func() int needs gen.Draws { gen.IntIn(1, 11) })
		let val = gen.Named("val", showInt, func() int needs gen.Draws { gen.IntIn(0, 96) })
		let hashHi = gen.Named("hashHi", showUint64, func() uint64 needs gen.Draws { gen.Below(uint64(0)) })
		if !checkForcedCollision(val, hashHi) {
			return false
		}
		let m = ceMachine(mod, bonus)
		let signals = []ceEvent{
			ceBump{Delta: 1},
			ceBump{Delta: 2},
			ceBump{Delta: 1},
			ceProbe{Kind: uint8(0)},
			ceProbe{Kind: uint8(1)},
			ceFinish{Code: finishCode},
		}
		let bounds = ConcreteBounds{MaxStates: 64, MaxEdges: 256, MaxWork: 100000, MaxBytes: 65536}
		let res = BuildConcrete(ConcreteOfMachine(m, signals), bounds)
		match res.Stop {
		case ConcreteComplete:
		case OverStates, OverEdges, OverWork, OverBytes, InvalidBounds, Unkeyable:
			return false
		}
		let (wantStates, wantEdges, wantDepth) = ceOracleBuild(m, signals)
		if res.Stats.States != wantStates || res.Stats.Edges != len(wantEdges) || res.Stats.Depth != wantDepth || len(res.Edges) != len(wantEdges) || res.Roots != []int{0} {
			return false
		}
		let mut sawVisited = false
		let mut sawIgnore = false
		let mut sawReject = false
		let mut sawDone = false
		let mut sawAlias1 = false
		let mut sawAlias2 = false
		for i in 0..len(wantEdges) {
			let got = res.Edges[i]
			let want = wantEdges[i]
			if got.Source != want.Source || got.Signal != want.Signal || got.EventID != want.EventID || got.Target != want.Target || got.Obs != want.Obs {
				return false
			}
			match got.Target {
			case ToState as ts:
				if ts.State <= got.Source && got.Obs.Kind != DisIgnore && got.Obs.Kind != DisReject {
					sawVisited = true
				}
			case Ended:
				let wantDone = Some[ceOut]{Value: ceOut{Code: finishCode, At: 0}}
				if got.Obs.Kind == DisDone && got.Obs.Output == wantDone {
					sawDone = true
				}
			}
			if got.Source == 0 && got.Obs.Kind == DisIgnore {
				sawIgnore = true
			}
			if got.Source == 0 && got.Obs.Kind == DisReject {
				sawReject = true
			}
			if got.Source == 0 && got.Signal == 0 && got.Obs.Kind == DisEnter {
				sawAlias1 = true
			}
			if got.Source == 0 && got.Signal == 1 && got.Obs.Kind == DisEmit {
				sawAlias2 = true
			}
		}
		if !sawVisited || !sawIgnore || !sawReject || !sawDone || !sawAlias1 || !sawAlias2 {
			return false
		}
		let disabledGraph = ConcreteGraph[int, int, int]{
			Starts:  []int{0},
			Signals: []int{0, 1},
			Step:    func(s int, e int) EdgeOutcome[int, int] {
				if e == 0 {
					Disabled[int]{Obs: -1}
				} else {
					Terminal[int]{Obs: s + 1}
				}
			},
		}
		let disRes = BuildConcrete(disabledGraph, bounds)
		let disOK = disRes.Stop == ConcreteComplete && disRes.Stats.Disabled == 1 && disRes.Stats.Edges == 1 && disRes.Stats.Work > 2
		let tightEdges = BuildConcrete(ConcreteOfMachine(m, signals), ConcreteBounds{MaxStates: 64, MaxEdges: 1, MaxWork: 100000, MaxBytes: 65536})
		let tightOK = tightEdges.Stop == OverEdges && len(tightEdges.Edges) == 1
		let reach = Always(OfMachine(m, signals), func(s ceState) bool { s.Val >= 0 }, 64)
		let reachOK = match reach {
		case Proved as pr:
			pr.Stats.States == wantStates
		case NotProved, Refuted, Witness, Absent:
			false
		}
		disOK && tightOK && reachOK
	})) == ""
	true
}
