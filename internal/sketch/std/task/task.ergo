// Package task starts tasks (docs/spec/runtime.md, Tasks; #207). A Task is
// the prelude's Task[T, E]: Wait() T fails E and Stop(). The Go body is
// runtime/v1's Go; its hidden arguments, the caller's frame scope and the
// call's site, are docs/spec/stdlib.md's Hidden arguments.

import queue
import scope
import strings
import time

// Go starts body as a child task of the calling task and returns at once:
// the block runs later (parse-v1 ruling 5). The calling function owns the
// Task until a Wait, a Stop or a direct return; when it returns without
// them, it stops the task and waits until it has ended. The block's value
// and failures are the Task's T and E; the providers it needs are the
// caller's. The block outlives the call, so its parameter is `escaping`
// (196e): it captures no non-escaping function value.
extern go ergo.local/prototype/runtime/v1.Go func Go[T own, E, R](body own func() T fails E needs R defects) Task[T, E] needs R

// Done is a task whose block returned Value.
type Done[T own] { Value T }

// Failed is a task whose whole exit is one typed failure of its row.
type Failed[E] { Error E }

// Defect is an opaque read-only view of the defect cause that ended a task
// or actor, preserving source position, monotonic occurrence id, full cause
// count, and exact nominal payload lookup via ReasonOf/ReasonAs.
// law-exempt: Defect is sealed by runtimeOnly and created only by ExitOf after a defect; task's defect laws verify it.
extern go ergo.local/prototype/runtime/v1.Defect type Defect {
	runtimeOnly(),
	// Text is the rendered diagnostic text of the first defect.
	Text() string,
	// Position is the source position of the first deliberate defect, or "" for a foreign defect.
	Position() string,
	// Occurrence is the monotonic occurrence id of the first defect.
	Occurrence() int,
	// CauseCount is the total number of reasons recorded in the exit cause.
	CauseCount() int,
	// DefectCount is the number of defect reasons recorded in the exit cause.
	DefectCount() int,
}

// Defected is a task that a defect ended: Reason is the defect's text, as
// the runtime's report writes it after "panic: " (an Unreachable's
// "unreachable at a.ergo:9:3: no route"), the text actor.Defected holds,
// and Defect is the structured read-only cause view for ReasonAs.
type Defected { Reason string, Defect Defect }

// ReasonOf looks up the deliberate defect payload of d at the exact nominal
// type T. Foreign faults and payloads of any other type return None.
func ReasonOf[T](d Defect) Option[T] {
	if defectHas[T](d) {
		Some[T]{Value: defectAs[T](d)}
	} else {
		None
	}
}

// ReasonAs looks up the deliberate defect payload of d at the exact nominal
// type T. Foreign faults and payloads of any other type return None.
func ReasonAs[T](d Defected) Option[T] { ReasonOf[T](d.Defect) }

// Stopped is a task that a stop ended which was not its waiter's: any stop
// that did not come from the task that called ExitOf, such as a StopAfter
// alarm, or a stop of the task that started it while another task waits.
// A block that returned before the stop reached it is Done, never Stopped.
type Stopped {}

// Exit is how a task ended: its value, its typed failure, a defect, or a
// stop that was not its waiter's.
type Exit[T own, E] = Done[T] | Failed[E] | Defected | Stopped

// OverSteps is a task that stopped because its own step budget ran out.
type OverSteps {}

// Outcome is how a budgeted task ended: its value, its typed failure, a
// defect, its own step budget running out, or another stop.
type Outcome[T own, E] = Done[T] | Failed[E] | Defected | OverSteps | Stopped

// ExitOf waits for t to end, as Wait does, and is how it ended
// (docs/spec/runtime.md, Tasks 13). It consumes t. A defect it gives as
// Defected is contained: neither this call nor t's owner raises it again.
// The task's exit actions have run before it returns. A stop of the
// waiting task is Wait's: t is stopped and drained, and the waiter's exit
// is the interruption with t's defects; any other stop that ended t is
// Stopped. A Go fatal error (out of memory, a stack overflow) is no
// defect, and ends the program.
func ExitOf[T own, E](t own Task[T, E]) Exit[T, E] {
	let k = exitOf(t) catch {
	case err:
		let _ = exitReason(t)
		return Failed[E]{Error: err}
	}
	if k == 2 {
		let d = exitDefect(t)
		return Defected{Reason: d.Text(), Defect: d}
	}
	if k == 3 || k == 4 {
		let _ = exitReason(t)
		return Stopped
	}
	Done[T]{Value: exitValue(t)}
}

// OutcomeOf waits for t as ExitOf does and distinguishes a stop caused by
// t's own step budget (OverSteps) from another stop (Stopped).
func OutcomeOf[T own, E](t own Task[T, E]) Outcome[T, E] {
	let k = exitOf(t) catch {
	case err:
		let _ = exitReason(t)
		return Failed[E]{Error: err}
	}
	if k == 2 {
		let d = exitDefect(t)
		return Defected{Reason: d.Text(), Defect: d}
	}
	if k == 4 {
		let _ = exitReason(t)
		return OverSteps
	}
	if k == 3 {
		let _ = exitReason(t)
		return Stopped
	}
	Done[T]{Value: exitValue(t)}
}

// LimitSteps sets a step budget of n unmasked interruption points on the
// calling task and its unshielded child tasks. A nonpositive n does nothing.
extern go ergo.local/prototype/runtime/v1.TaskLimitSteps func LimitSteps(n int)

// exitOf waits for t and gives how it ended: 0 the block's value, 2 a
// defect, whose text exitReason gives, 3 a stop that was not the
// waiter's; a lone typed failure is its failure. It consumes t, and
// leaves the value in it for exitValue.
extern go ergo.local/prototype/runtime/v1.TaskExit func exitOf[T own, E](t Task[T, E]) int fails E

// Alarm is what StopAfter armed: one alarm on the Scheduler's clock that
// stops a task. It is a resource: its release disarms it.
// law-exempt: a member law has no Scheduler to arm on and no clock to move; its laws bind a clock and run beside it (CancelBeforeFireNeverStops, AlarmOutlivesItsTask) or in testing, which may import both clocks (testing.StopAfterStopsAtD).
extern go ergo.local/prototype/runtime/v1.TaskAlarm type Alarm {
	runtimeOnly(),
	..Closer,
	// Cancel disarms the alarm and reports whether it was still armed:
	// false once it fired, after a Cancel, and for an alarm that armed
	// nothing (a d of zero or less).
	Cancel() bool,
}

// StopAfter arms one alarm on the Scheduler's clock that stops t once d
// has passed, as t.Stop would, without waiting for t or consuming it: the
// task that waits for t sees ExitOf give Stopped. It starts no task: one
// host timer, or one alarm on a time.Manual, which Advance fires. A d of
// zero or less arms nothing. At the alarm's instant every other event of
// that instant comes first: a block whose sleep ends then has woken, and
// one that returns before its next wait is Done. A fire after t ended, or
// after a Wait, Stop or ExitOf consumed it, stops nothing. The Alarm may
// outlive t: process.Run's join consumes t and then releases the Alarm.
// A Wait on t that the alarm stops raises the stop in the waiter, as
// Wait raises any interruption of its task; ExitOf is the call that sees
// it as a value.
extern go ergo.local/prototype/runtime/v1.TaskStopAfter func StopAfter[T own, E](t Task[T, E], d duration) Alarm needs Scheduler

// exitReason takes t after exitOf, on a path that gives no value (no
// value is left in t), and is the text of the defect exitOf gave as 2,
// else "". Every path of ExitOf takes t, so no generic release of T
// follows it (GEN9-GAP42).
extern go ergo.local/prototype/runtime/v1.TaskReason func exitReason[T own, E](t own Task[T, E]) string

// exitDefect takes t after exitOf gave 2 and returns the opaque Defect view.
extern go ergo.local/prototype/runtime/v1.TaskDefect func exitDefect[T own, E](t own Task[T, E]) Defect

// defectHas reports whether d's first defect is a source die with payload T.
extern go ergo.local/prototype/runtime/v1.DefectHas func defectHas[T](d Defect) bool

// defectAs returns d's first source die payload as T.
extern go ergo.local/prototype/runtime/v1.DefectAs func defectAs[T](d Defect) T

// exitValue takes the value t's block returned, after exitOf gave 0.
extern go ergo.local/prototype/runtime/v1.TaskValue func exitValue[T own, E](t own Task[T, E]) T

// CancelBeforeFireNeverStops: an alarm of d ms cancelled c ms after it was
// armed reports true when c < d, and then never stops its task, which
// sleeps w ms and returns; when c >= d it fired and reports false, and the
// task is Stopped when w > d.
law CancelBeforeFireNeverStops(w int, d int, c int) {
	let wait = 1 + ((w%6)+6)%6
	let limit = 1 + ((d%6)+6)%6
	let after = ((c % 7) + 7) % 7
	let m = time.NewManual(0)
	let marks = queue.New[int](1)
	let gate = queue.New[int](1)
	with context { Scheduler: m } {
		let t = Go() { try slept(0, marks, gate, time.Times(1ms, wait)) }
		let a = try armed(t, gate, m, false, time.Times(1ms, limit))
		m.Advance(time.Times(1ms, after))
		let armedStill = a.Cancel()
		for _ in 0..7 {
			m.Advance(1ms)
		}
		let stopped = after >= limit && wait > limit
		let ended = match ExitOf(t) {
		case Done[int]:
			!stopped
		case Stopped:
			stopped
		case _:
			false
		}
		ended && armedStill == (after < limit)
	}
}

// AlarmOutlivesItsTask: an alarm whose task ended before d (ended, then
// consumed by ExitOf, Wait or Stop, by how) fires as a no-op: no defect,
// and it stops no other task: a task that sleeps past it still sleeps.
// The type cannot rule this out: an Alarm outliving its task is the
// normal case (process.Run consumes the task, then releases the Alarm).
law AlarmOutlivesItsTask(how int, d int) {
	let limit = 1 + ((d%6)+6)%6
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let other = Go() {
			Scheduler.Sleep(1h)
			0
		}
		let t = Go() { 1 }
		let a = StopAfter(t, time.Times(1ms, limit))
		let h = ((how % 3) + 3) % 3
		let gave = if h == 0 {
			match ExitOf(t) {
			case Done[int] as v:
				v.Value == 1
			case _:
				false
			}
		} else if h == 1 {
			t.Wait() == 1
		} else {
			t.Stop()
			true
		}
		for m.Sleepers() < 2 {
		}
		m.Advance(time.Times(1ms, limit+1))
		let asleep = m.Sleepers() == 1
		other.Stop()
		gave && asleep && !a.Cancel()
	}
}

// slept is the block of the StopAfter laws: n exit actions, each pushing
// its mark, then one value from gate, a sleep of wait, and 1.
func slept(n int, marks queue.Queue[int], gate queue.Queue[int], wait duration) int fails queue.Closed needs Scheduler {
	for i in 0..n {
		scope.OnExit() {
			marks.Push(i) catch {
			case queue.Closed:
			}
		}
	}
	try gate.Pop()
	Scheduler.Sleep(wait)
	1
}

// armed arms StopAfter(t, d) before t sleeps (first) or once it sleeps:
// the two arming orders of the alarm and t's sleep on m's timeline.
func armed(t Task[int, queue.Closed], gate queue.Queue[int], m time.Manual, first bool, d duration) Alarm fails queue.Closed needs Scheduler {
	if first {
		let a = StopAfter(t, d)
		try gate.Push(0)
		return a
	}
	try gate.Push(0)
	for m.Sleepers() == 0 {
	}
	StopAfter(t, d)
}

// DefectIsObservedOnce: a defect of a task's block reaches ExitOf as
// Defected with the report's text, and nothing raises it again: not
// ExitOf, not the owner's release when the law returns. A typed failure
// is Failed, a value Done.
law DefectIsObservedOnce(n int) {
	let k = ((n % 3) + 3) % 3
	let t = Go() { try ended(k, n) }
	match ExitOf(t) {
	case Defected as d:
		k == 0 && strings.HasPrefix(d.Reason, "unreachable at ") && strings.HasSuffix(d.Reason, ": crash \(n)")
	case Failed[odd] as f:
		k == 1 && f.Error.N == n
	case Done[int] as v:
		k == 2 && v.Value == n
	case Stopped:
		false
	}
}

// odd is the typed failure DefectIsObservedOnce's block fails with.
type odd { N int }

// ended is n for k 2, the failure odd for k 1, and a defect for k 0.
func ended(k int, n int) int fails odd {
	if k == 0 {
		Unreachable("crash \(n)")
	}
	if k == 1 {
		return odd{N: n}
	}
	n
}

// crashed registers k exit actions, each pushing its mark, then raises a
// defect.
func crashed(k int, marks queue.Queue[int]) int {
	for i in 0..k {
		scope.OnExit() {
			marks.Push(i) catch {
			case queue.Closed:
			}
		}
	}
	Unreachable("after \(k) actions")
}

// ExitOfWaitsForCleanup: the exit actions of a task that a defect ended
// have run when ExitOf returns: each pushed its mark before it.
law ExitOfWaitsForCleanup(n int) {
	let k = ((n % 4) + 4) % 4
	let marks = queue.New[int](4)
	let t = Go() { crashed(k, marks) }
	match ExitOf(t) {
	case Defected:
		marks.Len() == k
	case _:
		false
	}
}

// ExitOfAnywhere: ExitOf of a task that was returned out of the block of
// the task that started it, and waited for elsewhere, gives the task's
// end: the waiter is the task that calls ExitOf, not the starter.
law ExitOfAnywhere(n int) {
	let outer = Go() { Go() { n } }
	let t = outer.Wait()
	match ExitOf(t) {
	case Done[int] as d:
		d.Value == n
	case _:
		false
	}
}

// StopOfWaiterStillInterrupts: a task that waits in ExitOf on a task that
// sleeps forever ends when it is stopped, by the interruption, not with
// an Exit: ExitOf never returns to it (a return would reach the
// Unreachable, whose defect Stop raises), and the sleeper is stopped and
// drained.
law StopOfWaiterStillInterrupts() {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let waiter = Go() {
			let sleeper = Go() {
				Scheduler.Sleep(1h)
				0
			}
			let _ = ExitOf(sleeper)
			Unreachable("ExitOf returned to a stopped waiter")
		}
		for m.Sleepers() == 0 {
		}
		waiter.Stop()
		m.Sleepers() == 0
	}
}

// WaitReturnsTheBlock: Wait gives the value of the task's block.
law WaitReturnsTheBlock(n int) {
	let t = Go() { n }
	t.Wait() == n
}

// StopIsIdempotent: Stop of a running task, then a second Stop, returns
// and never fails (the prelude's Task states it for every task; here it
// runs on a task that Go starts and that waits). The task sleeps on a
// time.Manual that no one advances, so it waits until the Stop; a law
// cannot hold Ambient, so it binds no host provider.
law StopIsIdempotent() {
	let t = with context { Scheduler: time.NewManual(0) } {
		Go() {
			Scheduler.Sleep(1h)
			0
		}
	}
	t.Stop()
	t.Stop()
	true
}

// SleepAdvancesNow: a task that sleeps d on a time.Manual wakes only after
// the clock has moved by d, so the time it reads after the sleep is d or
// more after the time it read before. The law advances the clock once the
// task sleeps; the queue woke tells it when the task got past the sleep
// with no Advance, so a sleep that returns at once makes the law false.
// The law is in task, not time: task imports time, so time cannot import
// task (TestStdImportsAreAcyclic).
law SleepAdvancesNow(n int64) {
	let m = time.NewManual(0)
	let d = duration(1 + (n%1099511627775+1099511627775)%1099511627775)
	let woke = queue.New[duration](1)
	let t = with context { Scheduler: m, time.Clock: m } {
		Go() {
			let before = time.Clock.Now()
			Scheduler.Sleep(d)
			try woke.Push(time.Clock.Now().Sub(before))
		}
	}
	for m.Sleepers() == 0 && woke.Len() == 0 {
	}
	m.Advance(d)
	try t.Wait()
	try woke.Pop() >= d
}
