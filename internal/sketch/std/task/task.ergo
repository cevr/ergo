// Package task starts tasks (docs/spec/runtime.md, Tasks; #207). A Task is
// the prelude's Task[T, E]: Wait() T fails E and Stop(). The Go body is
// runtime/v1's Go; its hidden arguments, the caller's frame scope and the
// call's site, are docs/spec/stdlib.md's Hidden arguments.

import queue
import time

// Go starts body as a child task of the calling task and returns at once:
// the block runs later (parse-v1 ruling 5). The calling function owns the
// Task until a Wait, a Stop or a direct return; when it returns without
// them, it stops the task and waits until it has ended. The block's value
// and failures are the Task's T and E; the providers it needs are the
// caller's. The block outlives the call, so its parameter is `escaping`
// (196e): it captures no non-escaping function value.
extern go ergo.local/prototype/runtime/v1.Go func Go[T, E, R](body escaping func() T fails E needs R) Task[T, E] needs R

// WaitReturnsTheBlock: Wait gives the value of the task's block.
law WaitReturnsTheBlock(n int) {
	let t = Go() { n }
	t.Wait() == n
}

// StopIsIdempotent: Stop of a running task, then a second Stop, returns
// and never fails (the prelude's Task states it for every task; here it
// runs on a task that Go starts and that waits). The task sleeps on a
// time.Manual that no one advances, so it waits until the Stop; a law
// cannot hold Ambient, so it binds no host provider.
law StopIsIdempotent() {
	let t = with context { Scheduler: time.NewManual(0) } {
		Go() {
			Scheduler.Sleep(1h)
			0
		}
	}
	t.Stop()
	t.Stop()
	true
}

// SleepAdvancesNow: a task that sleeps d on a time.Manual wakes only after
// the clock has moved by d, so the time it reads after the sleep is d or
// more after the time it read before. The law advances the clock once the
// task sleeps; the queue woke tells it when the task got past the sleep
// with no Advance, so a sleep that returns at once makes the law false.
// The law is in task, not time: task imports time, so time cannot import
// task (TestStdImportsAreAcyclic).
law SleepAdvancesNow(n int64) {
	let m = time.NewManual(0)
	let d = duration(1 + (n%1099511627775+1099511627775)%1099511627775)
	let woke = queue.New[duration](1)
	let t = with context { Scheduler: m, time.Clock: m } {
		Go() {
			let before = time.Clock.Now()
			Scheduler.Sleep(d)
			try woke.Push(time.Clock.Now().Sub(before))
		}
	}
	for m.Sleepers() == 0 && woke.Len() == 0 {
	}
	m.Advance(d)
	try t.Wait()
	try woke.Pop() >= d
}
