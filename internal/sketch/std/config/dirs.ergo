import strings

// Dirs are a program's own directories under the user's base directories
// (the XDG Base Directory specification): Config for files the user edits,
// Cache for what the program can make again, State for what it keeps
// between runs (history, logs).
type Dirs { Config string, Cache string, State string }

// NoHome is the failure of a base directory that needs HOME when HOME is
// unset, empty or not an absolute path.
type NoHome {}

// UserDirs is app's directories, by the XDG rules on Linux and macOS
// alike: $XDG_CONFIG_HOME/app, else $HOME/.config/app; $XDG_CACHE_HOME/app,
// else $HOME/.cache/app; $XDG_STATE_HOME/app, else $HOME/.local/state/app.
// A variable that is unset, empty or not an absolute path is ignored, as
// the specification says. Go's os.UserConfigDir gives ~/Library/
// Application Support on macOS; command-line programs there (git, gh,
// fish) read ~/.config, and so does this.
func UserDirs(app string) Dirs fails NoHome needs Config {
	Dirs{
		Config: try base("XDG_CONFIG_HOME", ".config") + "/" + app,
		Cache: try base("XDG_CACHE_HOME", ".cache") + "/" + app,
		State: try base("XDG_STATE_HOME", ".local/state") + "/" + app,
	}
}

// base is the variable name when it is an absolute path, else HOME/rel.
func base(name string, rel string) string fails NoHome needs Config {
	match Config.Lookup(name) {
	case Some as v:
		if strings.HasPrefix(v.Value, "/") {
			return strings.TrimSuffix(v.Value, "/")
		}
	case None:
	}
	match Config.Lookup("HOME") {
	case Some as h:
		if strings.HasPrefix(h.Value, "/") {
			return strings.TrimSuffix(h.Value, "/") + "/" + rel
		}
		return NoHome
	case None:
		return NoHome
	}
}
