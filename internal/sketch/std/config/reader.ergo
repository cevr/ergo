import codec
import json
import option
import strconv
import strings
import sync
import utf8

// The reader of the merged layers: a provider of the prelude's Reader
// that decode[T] reads (docs/spec/stdlib.md, config 4). A file's value is
// read as its kind is. A text, from a flag or a variable, is read as the
// kind the field asks for: Int by strconv.ParseInt(text, 0, 64), as std
// flag reads an Int; Uint the same and not negative; Float by
// strconv.ParseFloat; Bool by strconv.ParseBool; String as it is. A list
// field reads the texts, each split at ",": "a,b" is two items, and so is
// a repeated flag given a and b. A union field reads a text as the name of
// a variant with no field (Level = Debug | Info: NOTES_LEVEL=Info). A text
// has the kind String to an untyped json.Value.
//
// A failure's Path is the key, and for a value of the wrong kind its
// source: "port (env NOTES_PORT)". The text of the value is never in it,
// so a secret's failure does not show the secret.

// frame is an object or list being read: its members (a list's have the
// key ""), the index of the next one, the index of the one read last (-1
// before the first), its path, and the union tag it has.
type frame { members []member, next int, cur int, path string, list bool, tag option.Option[string] }

// reader reads the tree root. Its frames are in a Ref, so every copy of
// it is one reader.
type reader { stack sync.Ref[[]frame] } implements codec.Reader

func newReader(root node) reader {
	let top = frame{members: []member{member{Key: "", Value: root}}, next: 0, cur: -1, path: "", list: false, tag: option.None}
	reader{stack: sync.NewRef[[]frame]([]frame{top})}
}

func top(r reader) frame {
	let st = r.stack.Get()
	st[st.Len()-1]
}

func setTop(r reader, f frame) {
	r.stack.Update(func(st []frame) []frame {
		let mut out = st
		out[out.Len()-1] = f
		out
	})
}

// peekNode is the next value, which the read leaves.
func peekNode(r reader) option.Option[node] {
	let f = top(r)
	if f.next >= f.members.Len() {
		return option.None
	}
	option.Some{Value: f.members[f.next].Value}
}

// take passes the next value and gives it: it is the one read last.
func take(r reader) node {
	let f = top(r)
	if f.next >= f.members.Len() {
		return scalar{Value: json.Null, From: FromDefault}
	}
	setTop(r, frame{members: f.members, next: f.next + 1, cur: f.next, path: f.path, list: f.list, tag: f.tag})
	f.members[f.next].Value
}

// childPath is the path of member i of f.
func childPath(f frame, i int) string {
	if f.list {
		return f.path + "[" + strconv.Itoa(i) + "]"
	}
	let key = f.members[i].Key
	if f.path == "" { key } else if key == "" { f.path } else { f.path + "." + key }
}

func Path(r reader) string {
	let f = top(r)
	if f.cur < 0 { f.path } else { childPath(f, f.cur) }
}

// wrong is the failure of the value just read, which is not a want.
func wrong(r reader, n node, want string) codec.WireWrongKind {
	codec.WireWrongKind{Path: Path(r) + " (" + Describe(sourceOf(n)) + ")", Want: want}
}

// last is the text a scalar read takes: a repeated flag's last.
func last(t texts) string {
	if t.Items.Len() == 0 { "" } else { t.Items[t.Items.Len()-1] }
}

func TakeNull(r reader) bool {
	match peekNode(r) {
	case option.Some as n:
		match n.Value {
		case scalar as s:
			match s.Value {
			case json.Null:
				let _ = take(r)
				true
			case _:
				false
			}
		case _:
			false
		}
	case option.None:
		false
	}
}

func Peek(r reader) codec.WireKind {
	match peekNode(r) {
	case option.None:
		codec.WireEnd
	case option.Some as n:
		match n.Value {
		case texts:
			codec.WireString
		case branch:
			codec.WireObject
		case items:
			codec.WireList
		case scalar as s:
			match s.Value {
			case json.Null:
				codec.WireNull
			case json.Boolean:
				codec.WireBool
			case json.Num:
				codec.WireNumber
			case json.Str:
				codec.WireString
			case json.Array:
				codec.WireList
			case json.Object:
				codec.WireObject
			}
		}
	}
}

func Number(r reader) string fails codec.WireWrongKind {
	let n = take(r)
	match n {
	case scalar as s:
		match s.Value {
		case json.Num as v:
			return v.Wire()
		case _:
		}
	case texts as t:
		let v = json.ParseNum(last(t)) catch {
		case json.Malformed:
			return wrong(r, n, "number")
		}
		return v.Wire()
	case _:
	}
	wrong(r, n, "number")
}

func Bool(r reader) bool fails codec.WireWrongKind {
	let n = take(r)
	match n {
	case scalar as s:
		match s.Value {
		case json.Boolean as b:
			return b.Value
		case _:
		}
	case texts as t:
		return strconv.ParseBool(last(t)) catch {
		case strconv.Malformed:
			return wrong(r, n, "bool")
		}
	case _:
	}
	wrong(r, n, "bool")
}

// numberText is the spelling of a number a read takes, or None.
func numberText(n node) option.Option[string] {
	match n {
	case scalar as s:
		match s.Value {
		case json.Num as v:
			option.Some{Value: v.Wire()}
		case _:
			option.None
		}
	case texts as t:
		option.Some{Value: last(t)}
	case _:
		option.None
	}
}

func Int(r reader) int64 fails codec.WireWrongKind {
	let n = take(r)
	match numberText(n) {
	case option.Some as text:
		strconv.ParseInt(text.Value, 0, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return wrong(r, n, "int")
		}
	case option.None:
		wrong(r, n, "int")
	}
}

func Uint(r reader) uint64 fails codec.WireWrongKind {
	let n = take(r)
	match numberText(n) {
	case option.Some as text:
		let v = strconv.ParseInt(text.Value, 0, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return wrong(r, n, "uint")
		}
		if v < 0 {
			return wrong(r, n, "uint")
		}
		uint64(v)
	case option.None:
		wrong(r, n, "uint")
	}
}

func Float(r reader) float64 fails codec.WireWrongKind {
	let n = take(r)
	match n {
	case scalar as s:
		match s.Value {
		case json.Str as v:
			if v.Value == "NaN" || v.Value == "Infinity" || v.Value == "-Infinity" {
				return strconv.ParseFloat(v.Value) catch {
				case strconv.Malformed, strconv.OutOfRange:
					return wrong(r, n, "float")
				}
			}
		case _:
		}
	case _:
	}
	match numberText(n) {
	case option.Some as text:
		strconv.ParseFloat(text.Value) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return wrong(r, n, "float")
		}
	case option.None:
		wrong(r, n, "float")
	}
}

func String(r reader) string fails codec.WireWrongKind {
	let n = take(r)
	match n {
	case scalar as s:
		match s.Value {
		case json.Str as v:
			return v.Value
		case _:
		}
	case texts as t:
		return last(t)
	case _:
	}
	wrong(r, n, "string")
}

func StringBytes(r reader, into []byte) []byte fails codec.WireWrongKind { appendText(into, try r.String()) }

// ReaderStringBytesReadsString: a config reader's StringBytes adds to into
// the bytes String reads from the same tree (GX12b).
law ReaderStringBytesReadsString(s string, pre []byte) {
	let a = newReader(scalar{Value: json.Str{Value: s}, From: FromDefault})
	let b = newReader(scalar{Value: json.Str{Value: s}, From: FromDefault})
	let got = try a.StringBytes(pre)
	utf8.String(got) == utf8.String(pre)+try b.String()
}

// appendText is Go's append(into, s...).
extern go append func appendText(into []byte, s string) []byte

// push opens a frame for the value just read, at the path of it.
func push(r reader, members []member, list bool, tag option.Option[string]) {
	let p = Path(r)
	r.stack.Update(func(st []frame) []frame {
		st.Append(frame{members: members, next: 0, cur: -1, path: p, list: list, tag: tag})
	})
}

func BeginList(r reader) fails codec.WireWrongKind {
	let n = take(r)
	match n {
	case items as l:
		let mut ms = []member{}
		for x in l.Elems {
			ms = ms.Append(member{Key: "", Value: x})
		}
		push(r, ms, true, option.None)
	case texts as t:
		let mut ms = []member{}
		for item in t.Items {
			if item != "" {
				for part in strings.Split(item, ",") {
					ms = ms.Append(member{Key: "", Value: texts{Items: []string{part}, From: t.From}})
				}
			}
		}
		push(r, ms, true, option.None)
	case _:
		return wrong(r, n, "list")
	}
}

func BeginObject(r reader) fails codec.WireWrongKind {
	let n = take(r)
	match n {
	case branch as b:
		let mut ms = []member{}
		let mut tag option.Option[string] = option.None
		for m in b.Members {
			if m.Key == "_tag" {
				match m.Value {
				case scalar as s:
					match s.Value {
					case json.Str as name:
						tag = option.Some{Value: name.Value}
					case _:
					}
				case texts as t:
					tag = option.Some{Value: last(t)}
				case _:
				}
			} else {
				ms = ms.Append(m)
			}
		}
		push(r, ms, false, tag)
	case texts as t:
		push(r, []member{}, false, option.Some{Value: last(t)})
	case _:
		return wrong(r, n, "object")
	}
}

func Tag(r reader) string fails codec.WireMissingField {
	match top(r).tag {
	case option.Some as t:
		t.Value
	case option.None:
		codec.WireMissingField{Path: Path(r), Field: "_tag"}
	}
}

func More(r reader) bool {
	let f = top(r)
	f.next < f.members.Len()
}

func Key(r reader) string {
	let f = top(r)
	if f.next < f.members.Len() { f.members[f.next].Key } else { "" }
}

func Skip(r reader) { let _ = take(r) }

func End(r reader) {
	r.stack.Update(func(st []frame) []frame {
		if st.Len() > 1 { st[:st.Len()-1] } else { st }
	})
}
