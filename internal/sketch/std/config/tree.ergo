import codec
import flag
import json
import option
import strconv
import strings
import sync
import utf8

// The layers, as trees (docs/spec/stdlib.md, config 3). A file is a tree
// of JSON values; a flag and a variable are text, which the reader reads
// as the kind the field asks for; the defaults are the events of a value's
// encode. Each node keeps the source of the layer it came from, which a
// failure names.
type scalar { Value json.Value, From Source }
type texts { Items []string, From Source }
type branch { Members []member, From Source }
type items { Elems []node, From Source }
type node = scalar | texts | branch | items
type member { Key string, Value node }

// sourceOf is the source of n.
func sourceOf(n node) Source {
	match n {
	case scalar as s:
		s.From
	case texts as t:
		t.From
	case branch as b:
		b.From
	case items as l:
		l.From
	}
}

// merge is high over low: two branches merge key by key, high's keys
// first; anything else is high whole, so a list or a value of a higher
// layer replaces the lower one's.
func merge(high node, low node) node {
	match high {
	case branch as h:
		match low {
		case branch as l:
			let mut out = []member{}
			for m in h.Members {
				let mut v = m.Value
				for o in l.Members {
					if o.Key == m.Key {
						v = merge(m.Value, o.Value)
					}
				}
				out = out.Append(member{Key: m.Key, Value: v})
			}
			for o in l.Members {
				let mut seen = false
				for m in h.Members {
					seen = seen || m.Key == o.Key
				}
				if !seen {
					out = out.Append(o)
				}
			}
			branch{Members: out, From: h.From}
		case _:
			high
		}
	case _:
		high
	}
}

// empty is the tree of a layer with nothing in it.
func empty(from Source) node { branch{Members: []member{}, From: from} }

// put is t with v at the dotted key path, t a branch; an existing value
// at the path is replaced.
func put(t node, path []string, v node) node {
	if path.Len() == 0 {
		return v
	}
	match t {
	case branch as b:
		let mut out = []member{}
		let mut done = false
		for m in b.Members {
			if m.Key == path[0] {
				out = out.Append(member{Key: m.Key, Value: put(m.Value, path[1:], v)})
				done = true
			} else {
				out = out.Append(m)
			}
		}
		if !done {
			out = out.Append(member{Key: path[0], Value: put(empty(b.From), path[1:], v)})
		}
		branch{Members: out, From: b.From}
	case _:
		put(empty(sourceOf(t)), path, v)
	}
}

// fromValue is the tree of a JSON value read from the file at path.
func fromValue(v json.Value, from Source) node {
	match v {
	case json.Object as o:
		let mut out = []member{}
		for m in o.Members {
			out = out.Append(member{Key: m.Key, Value: fromValue(m.Value, from)})
		}
		branch{Members: out, From: from}
	case json.Array as a:
		let mut out = []node{}
		for x in a.Items {
			out = out.Append(fromValue(x, from))
		}
		items{Elems: out, From: from}
	case _:
		scalar{Value: v, From: from}
	}
}

type listBuild { elems []node }
type objectBuild { members []member, key option.Option[string] }
type buildFrame = listBuild | objectBuild
type buildState { frames []buildFrame, root option.Option[node] }
type treeWriter { state sync.Ref[buildState], from Source } implements codec.Writer

func newTreeWriter(from Source) treeWriter {
	treeWriter{state: sync.NewRef[buildState](buildState{frames: []buildFrame{}, root: option.None}), from: from}
}

func finish(w treeWriter) option.Option[node] { w.state.Get().root }

func putNode(w treeWriter, v node) {
	w.state.Update(func(st buildState) buildState {
		let n = st.frames.Len()
		if n == 0 {
			return buildState{frames: st.frames, root: option.Some[node]{Value: v}}
		}
		let mut frames = st.frames
		match frames[n-1] {
		case listBuild as l:
			frames[n-1] = listBuild{elems: l.elems.Append(v)}
		case objectBuild as o:
			match o.key {
			case option.Some as k:
				frames[n-1] = objectBuild{members: o.members.Append(member{Key: k.Value, Value: v}), key: option.None}
			case option.None:
			}
		}
		buildState{frames: frames, root: st.root}
	})
}

func pushFrame(w treeWriter, f buildFrame) {
	w.state.Update(func(st buildState) buildState {
		buildState{frames: st.frames.Append(f), root: st.root}
	})
}

func numNode(w treeWriter, text string) node {
	let n = json.ParseNum(text) catch {
	case json.Malformed:
		return scalar{Value: json.Str{Value: text}, From: w.from}
	}
	scalar{Value: n, From: w.from}
}

func Null(w treeWriter)                { putNode(w, scalar{Value: json.Null, From: w.from}) }
func Number(w treeWriter, text string) { putNode(w, numNode(w, text)) }
func Bool(w treeWriter, b bool)        { putNode(w, scalar{Value: json.Boolean{Value: b}, From: w.from}) }
func Int(w treeWriter, n int64)        { putNode(w, scalar{Value: json.IntNumber(n), From: w.from}) }

func Uint(w treeWriter, n uint64) {
	if n > 9223372036854775807 {
		putNode(w, numNode(w, strconv.FormatFloat(float64(n), 'f', -1)))
		return
	}
	putNode(w, numNode(w, strconv.FormatInt(int64(n), 10)))
}

func Float(w treeWriter, f float64)      { putNode(w, numNode(w, floatText(f))) }
func String(w treeWriter, s string)      { putNode(w, scalar{Value: json.Str{Value: s}, From: w.from}) }
func StringBytes(w treeWriter, b []byte) { putNode(w, scalar{Value: json.Str{Value: utf8.String(b)}, From: w.from}) }
func BeginList(w treeWriter, n int)      { pushFrame(w, listBuild{elems: []node{}}) }

func EndList(w treeWriter) {
	let done = sync.Modify(w.state, func(st buildState) (option.Option[node], buildState) {
		let n = st.frames.Len()
		if n == 0 {
			return (option.None, st)
		}
		match st.frames[n-1] {
		case listBuild as l:
			(option.Some[node]{Value: items{Elems: l.elems, From: w.from}}, buildState{frames: st.frames[:n-1], root: st.root})
		case objectBuild:
			(option.None, st)
		}
	})
	match done {
	case option.Some as v:
		putNode(w, v.Value)
	case option.None:
	}
}

func BeginObject(w treeWriter, n int) { pushFrame(w, objectBuild{members: []member{}, key: option.None}) }

func Tag(w treeWriter, name string) {
	w.state.Update(func(st buildState) buildState {
		let n = st.frames.Len()
		if n == 0 {
			return st
		}
		let mut frames = st.frames
		match frames[n-1] {
		case objectBuild as o:
			frames[n-1] = objectBuild{members: o.members.Append(member{Key: "_tag", Value: scalar{Value: json.Str{Value: name}, From: w.from}}), key: o.key}
		case listBuild:
		}
		buildState{frames: frames, root: st.root}
	})
}

func Key(w treeWriter, k string) {
	w.state.Update(func(st buildState) buildState {
		let n = st.frames.Len()
		if n == 0 {
			return st
		}
		let mut frames = st.frames
		match frames[n-1] {
		case objectBuild as o:
			frames[n-1] = objectBuild{members: o.members, key: option.Some[string]{Value: k}}
		case listBuild:
		}
		buildState{frames: frames, root: st.root}
	})
}

func EndObject(w treeWriter) {
	let done = sync.Modify(w.state, func(st buildState) (option.Option[node], buildState) {
		let n = st.frames.Len()
		if n == 0 {
			return (option.None, st)
		}
		match st.frames[n-1] {
		case objectBuild as o:
			(option.Some[node]{Value: branch{Members: o.members, From: w.from}}, buildState{frames: st.frames[:n-1], root: st.root})
		case listBuild:
			(option.None, st)
		}
	})
	match done {
	case option.Some as v:
		putNode(w, v.Value)
	case option.None:
	}
}

// floatText is f as json writes it: a number, or the strings of NaN and
// the infinities, which Float reads back.
func floatText(f float64) string {
	if f != f {
		return "NaN"
	}
	if f > 1.7976931348623157e308 {
		return "Infinity"
	}
	if f < -1.7976931348623157e308 {
		return "-Infinity"
	}
	strconv.FormatFloat(f, 'g', -1)
}

// fromFlags is the tree of the given flags: each flag's name is its key
// (ConfigFlagKey), and its texts are its value.
func fromFlags(given []flag.Given) node {
	let mut t = empty(FromFlag{Name: ""})
	for g in given {
		let key = flagKey(g.Name)
		t = put(t, strings.Split(key, "."), texts{Items: g.Texts, From: FromFlag{Name: g.Name}})
	}
	t
}

// fromEnv is the tree of the variables that start with prefix and "_":
// each name's rest is its key (ConfigEnvKey).
func fromEnv(vars []Variable, prefix string) node {
	let mut t = empty(FromEnv{Name: ""})
	for v in vars {
		let rest = strings.TrimPrefix(v.Name, prefix+"_")
		if rest != "" {
			t = put(t, strings.Split(envKey(rest), "."), texts{Items: []string{v.Text}, From: FromEnv{Name: v.Name}})
		}
	}
	t
}

extern go ergo.local/prototype/runtime/v1.ConfigFlagName func flagName(key string) string
extern go ergo.local/prototype/runtime/v1.ConfigEnvName func envName(prefix string, key string) string
extern go ergo.local/prototype/runtime/v1.ConfigFlagKey func flagKey(name string) string
extern go ergo.local/prototype/runtime/v1.ConfigEnvKey func envKey(rest string) string
