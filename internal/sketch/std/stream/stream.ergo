// Package stream holds the operators of a Seq that read time (Effect
// Stream's throttle, debounce and groupedWithin; Rx's throttleFirst and
// debounceTime). Each reads the clock it is given at each value's
// arrival and decides there: a Seq is a push iterator that one task runs,
// so a value can leave only when the source yields one or ends. The
// clock is a value, not a need: a Seq carries no row. A producer that
// sleeps on the context's Scheduler between values, and the clock that
// Scheduler moves, give the times; under time.Manual a test sets every
// arrival (`let m = time.NewManual(0)`, then `stream.Throttle(s, d, m)`
// with s advancing m).
//
// The read at an arrival is Elapsed since the time the operator keeps
// (the host's reads only its monotonic clock, as Go's time.Since does),
// and that time moves on by what Elapsed gave (Time.Add): only the first
// value, and the first of each chunk, reads Now.
import core
import option
import time

// Throttle keeps the first value of s and each later value that arrives d
// or more after the last value it kept, and drops the others (Effect's
// throttle with one unit per d and the enforce strategy; Rx's
// throttleFirst). A d of zero or less keeps every value.
func Throttle[T](s core.Seq[T], d duration, clock time.Clock) core.Seq[T] {
	core.Seq[T](func(yield func(v T) bool) {
		let mut kept = false
		let mut last = time.NewTime(0, 0)
		for v in s {
			if kept {
				let e = clock.Elapsed(last)
				if e < d {
					continue
				}
				last = last.Add(e)
			} else {
				kept = true
				last = clock.Now()
			}
			if !yield(v) {
				return
			}
		}
	})
}

// ThrottleMatchesModel: Throttle keeps the values the model keeps: the
// first, then each that arrives the window or more after the last kept.
law ThrottleMatchesModel(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	sameInts(collect(Throttle(arrivals(m, gaps, xs), millis(window(w)), m)), throttleModel(arrivalsAt(gaps, xs.Len()), xs, window(w)))
}

// arrivals is xs as a Seq on m: before each value it moves m on by the
// value's gap.
func arrivals(m time.Manual, gaps []int, xs []int) core.Seq[int] {
	core.Seq[int](func(yield func(v int) bool) {
		for i, x in xs {
			m.Advance(millis(gapAt(gaps, i)))
			if !yield(x) {
				return
			}
		}
	})
}

// arrivalsAt is the arrival time of each of n values, in milliseconds
// from the first run's start.
func arrivalsAt(gaps []int, n int) []int {
	let mut at = []int{}
	let mut t = 0
	for i in 0..n {
		t = t + gapAt(gaps, i)
		at = at.Append(t)
	}
	at
}

// throttleModel keeps xs[0] and each xs[i] whose arrival is d or more
// after the last kept one's.
func throttleModel(at []int, xs []int, d int) []int {
	let mut out = []int{}
	let mut last = 0
	for i, x in xs {
		if i == 0 || at[i]-last >= d {
			out = out.Append(x)
			last = at[i]
		}
	}
	out
}

// ThrottleStops: Throttle is a Seq that stops.
law ThrottleStops(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	stops(Throttle(arrivals(m, gaps, xs), millis(window(w)), m))
}

// stops: s is a Seq that stops (stdlib.md, Std laws 5): with n the count
// of its values, a yield that returns false at its k-th call (k from 1 to
// n+1) is called min(k, n) times.
func stops[T](s core.Seq[T]) bool {
	let mut n = 0
	s(func(v T) bool {
		n = n + 1
		true
	})
	for k in 1..n+2 {
		let mut calls = 0
		s(func(v T) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// Debounce keeps each value of s that the next value arrives d or more
// after, and the last value, and drops the others: a burst of values less
// than d apart leaves its last (Effect's debounce, Rx's debounceTime). A
// kept value leaves when the next one arrives or s ends, the first moment
// a Seq can tell that d of quiet passed. A d of zero or less keeps every
// value.
func Debounce[T](s core.Seq[T], d duration, clock time.Clock) core.Seq[T] {
	core.Seq[T](func(yield func(v T) bool) {
		let mut pending option.Option[T] = option.None
		let mut at = time.NewTime(0, 0)
		for v in s {
			match pending {
			case option.Some[T] as p:
				let e = clock.Elapsed(at)
				if e >= d && !yield(p.Value) {
					return
				}
				at = at.Add(e)
			case option.None:
				at = clock.Now()
			}
			pending = option.Some[T]{Value: v}
		}
		match pending {
		case option.Some[T] as p:
			yield(p.Value)
		case option.None:
		}
	})
}

// DebounceMatchesModel: Debounce keeps the values the model keeps: each
// that the next arrives the window or more after, and the last.
law DebounceMatchesModel(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	sameInts(collect(Debounce(arrivals(m, gaps, xs), millis(window(w)), m)), debounceModel(arrivalsAt(gaps, xs.Len()), xs, window(w)))
}

// debounceModel keeps each xs[i] that the next value arrives d or more
// after, and the last.
func debounceModel(at []int, xs []int, d int) []int {
	let mut out = []int{}
	for i, x in xs {
		if i == xs.Len()-1 || at[i+1]-at[i] >= d {
			out = out.Append(x)
		}
	}
	out
}

// DebounceStops: Debounce is a Seq that stops.
law DebounceStops(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	stops(Debounce(arrivals(m, gaps, xs), millis(window(w)), m))
}

// GroupedWithin is the values of s in chunks, in order (Effect's
// groupedWithin): a chunk starts at its first value and closes when it
// holds n values, or when a value arrives d or more after the chunk's
// first value, which then starts the next chunk. The last chunk leaves
// when s ends. No chunk is empty; an n of one or less makes each value a
// chunk.
func GroupedWithin[T](s core.Seq[T], n int, d duration, clock time.Clock) core.Seq[[]T] {
	core.Seq[[]T](func(yield func(v []T) bool) {
		let mut chunk = []T{}
		let mut start = time.NewTime(0, 0)
		for v in s {
			if chunk.Len() > 0 && clock.Elapsed(start) >= d {
				if !yield(chunk) {
					return
				}
				chunk = []T{}
			}
			if chunk.Len() == 0 {
				start = clock.Now()
			}
			chunk = chunk.Append(v)
			if chunk.Len() >= n {
				if !yield(chunk) {
					return
				}
				chunk = []T{}
			}
		}
		if chunk.Len() > 0 {
			yield(chunk)
		}
	})
}

// GroupedWithinMatchesModel: GroupedWithin's chunks are the model's.
law GroupedWithinMatchesModel(gaps []int, xs []int, w int, k int) {
	let m = time.NewManual(0)
	sameChunks(collectChunks(GroupedWithin(arrivals(m, gaps, xs), size(k), millis(window(w)), m)), groupedModel(arrivalsAt(gaps, xs.Len()), xs, size(k), window(w)))
}

// size is k as a chunk size from 0 to 5.
func size(k int) int { ((k % 6) + 6) % 6 }

// groupedModel is the chunks of xs: one closes at n values or before a
// value arriving d or more after its first.
func groupedModel(at []int, xs []int, n int, d int) [][]int {
	let mut out = [][]int{}
	let mut chunk = []int{}
	let mut start = 0
	for i, x in xs {
		if chunk.Len() > 0 && at[i]-start >= d {
			out = out.Append(chunk)
			chunk = []int{}
		}
		if chunk.Len() == 0 {
			start = at[i]
		}
		chunk = chunk.Append(x)
		if chunk.Len() >= n {
			out = out.Append(chunk)
			chunk = []int{}
		}
	}
	if chunk.Len() > 0 {
		out = out.Append(chunk)
	}
	out
}

// collectChunks is the chunks of s.
func collectChunks(s core.Seq[[]int]) [][]int {
	let mut out = [][]int{}
	for c in s {
		out = out.Append(c)
	}
	out
}

// sameChunks reports that a and b hold the same chunks in order.
func sameChunks(a [][]int, b [][]int) bool {
	let mut same = a.Len() == b.Len()
	for i in 0..a.Len() {
		same = same && i < b.Len() && sameInts(a[i], b[i])
	}
	same
}

// GroupedWithinKeepsEveryValue: the chunks, joined, are the values of s
// in order, and none is empty.
law GroupedWithinKeepsEveryValue(gaps []int, xs []int, w int, k int) {
	let m = time.NewManual(0)
	let mut joined = []int{}
	let mut empty = false
	for c in GroupedWithin(arrivals(m, gaps, xs), size(k), millis(window(w)), m) {
		empty = empty || c.Len() == 0
		for x in c {
			joined = joined.Append(x)
		}
	}
	!empty && sameInts(joined, xs)
}

// GroupedWithinStops: GroupedWithin is a Seq that stops.
law GroupedWithinStops(gaps []int, xs []int, w int, k int) {
	let m = time.NewManual(0)
	stops(GroupedWithin(arrivals(m, gaps, xs), size(k), millis(window(w)), m))
}
