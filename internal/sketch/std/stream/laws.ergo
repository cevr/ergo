// The laws of stream: each operator against a reference model over the
// arrival times (milliseconds) a time.Manual gives the values, and each
// operator is a Seq that stops (stdlib.md, Std laws 5).
import time

// ThrottleMatchesModel: Throttle keeps the values the model keeps: the
// first, then each that arrives the window or more after the last kept.
law ThrottleMatchesModel(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	sameInts(collect(Throttle(arrivals(m, gaps, xs), millis(window(w)), m)), throttleModel(arrivalsAt(gaps, len(xs)), xs, window(w)))
}

// DebounceMatchesModel: Debounce keeps the values the model keeps: each
// that the next arrives the window or more after, and the last.
law DebounceMatchesModel(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	sameInts(collect(Debounce(arrivals(m, gaps, xs), millis(window(w)), m)), debounceModel(arrivalsAt(gaps, len(xs)), xs, window(w)))
}

// GroupedWithinMatchesModel: GroupedWithin's chunks are the model's.
law GroupedWithinMatchesModel(gaps []int, xs []int, w int, k int) {
	let m = time.NewManual(0)
	sameChunks(collectChunks(GroupedWithin(arrivals(m, gaps, xs), size(k), millis(window(w)), m)), groupedModel(arrivalsAt(gaps, len(xs)), xs, size(k), window(w)))
}

// GroupedWithinKeepsEveryValue: the chunks, joined, are the values of s
// in order, and none is empty.
law GroupedWithinKeepsEveryValue(gaps []int, xs []int, w int, k int) {
	let m = time.NewManual(0)
	let mut joined = []int{}
	let mut empty = false
	for c in GroupedWithin(arrivals(m, gaps, xs), size(k), millis(window(w)), m) {
		empty = empty || len(c) == 0
		for x in c {
			joined = joined.Append(x)
		}
	}
	!empty && sameInts(joined, xs)
}

// ThrottleStops: Throttle is a Seq that stops.
law ThrottleStops(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	stops(Throttle(arrivals(m, gaps, xs), millis(window(w)), m))
}

// DebounceStops: Debounce is a Seq that stops.
law DebounceStops(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	stops(Debounce(arrivals(m, gaps, xs), millis(window(w)), m))
}

// GroupedWithinStops: GroupedWithin is a Seq that stops.
law GroupedWithinStops(gaps []int, xs []int, w int, k int) {
	let m = time.NewManual(0)
	stops(GroupedWithin(arrivals(m, gaps, xs), size(k), millis(window(w)), m))
}

// gapAt is the gap before the i-th value, in milliseconds: gaps[i] mod 50,
// or 0 past the end of gaps.
func gapAt(gaps []int, i int) int {
	if i < len(gaps) {
		((gaps[i] % 50) + 50) % 50
	} else {
		0
	}
}

// window is w as a window from 0 to 59 milliseconds: 0 keeps every value.
func window(w int) int { ((w % 60) + 60) % 60 }

// size is k as a chunk size from 0 to 5.
func size(k int) int { ((k % 6) + 6) % 6 }

// millis is n milliseconds.
func millis(n int) duration { time.Times(1ms, n) }

// arrivals is xs as a Seq on m: before each value it moves m on by the
// value's gap.
func arrivals(m time.Manual, gaps []int, xs []int) Seq[int] {
	Seq[int](func(yield func(v int) bool) {
		for i, x in xs {
			m.Advance(millis(gapAt(gaps, i)))
			if !yield(x) {
				return
			}
		}
	})
}

// arrivalsAt is the arrival time of each of n values, in milliseconds
// from the first run's start.
func arrivalsAt(gaps []int, n int) []int {
	let mut at = []int{}
	let mut t = 0
	for i in 0..n {
		t = t + gapAt(gaps, i)
		at = at.Append(t)
	}
	at
}

// throttleModel keeps xs[0] and each xs[i] whose arrival is d or more
// after the last kept one's.
func throttleModel(at []int, xs []int, d int) []int {
	let mut out = []int{}
	let mut last = 0
	for i, x in xs {
		if i == 0 || at[i]-last >= d {
			out = out.Append(x)
			last = at[i]
		}
	}
	out
}

// debounceModel keeps each xs[i] that the next value arrives d or more
// after, and the last.
func debounceModel(at []int, xs []int, d int) []int {
	let mut out = []int{}
	for i, x in xs {
		if i == len(xs)-1 || at[i+1]-at[i] >= d {
			out = out.Append(x)
		}
	}
	out
}

// groupedModel is the chunks of xs: one closes at n values or before a
// value arriving d or more after its first.
func groupedModel(at []int, xs []int, n int, d int) [][]int {
	let mut out = [][]int{}
	let mut chunk = []int{}
	let mut start = 0
	for i, x in xs {
		if len(chunk) > 0 && at[i]-start >= d {
			out = out.Append(chunk)
			chunk = []int{}
		}
		if len(chunk) == 0 {
			start = at[i]
		}
		chunk = chunk.Append(x)
		if len(chunk) >= n {
			out = out.Append(chunk)
			chunk = []int{}
		}
	}
	if len(chunk) > 0 {
		out = out.Append(chunk)
	}
	out
}

// collect is the values of s.
func collect(s Seq[int]) []int {
	let mut out = []int{}
	for v in s {
		out = out.Append(v)
	}
	out
}

// collectChunks is the chunks of s.
func collectChunks(s Seq[[]int]) [][]int {
	let mut out = [][]int{}
	for c in s {
		out = out.Append(c)
	}
	out
}

// sameInts reports that a and b hold the same values in order.
func sameInts(a []int, b []int) bool {
	let mut same = len(a) == len(b)
	for i in 0..len(a) {
		same = same && i < len(b) && a[i] == b[i]
	}
	same
}

// sameChunks reports that a and b hold the same chunks in order.
func sameChunks(a [][]int, b [][]int) bool {
	let mut same = len(a) == len(b)
	for i in 0..len(a) {
		same = same && i < len(b) && sameInts(a[i], b[i])
	}
	same
}

// stops: s is a Seq that stops (stdlib.md, Std laws 5): with n the count
// of its values, a yield that returns false at its k-th call (k from 1 to
// n+1) is called min(k, n) times.
func stops[T](s Seq[T]) bool {
	let mut n = 0
	s(func(v T) bool {
		n = n + 1
		true
	})
	for k in 1..n+2 {
		let mut calls = 0
		s(func(v T) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}
