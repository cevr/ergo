import queue
import task
import time
import timeout

// Debounced moves the values of src to out and keeps only the last value
// of each burst (Effect's Stream.debounce, Rx's debounceTime). Unlike
// Debounce over a Seq, it has a timer: a value leaves d after it arrived
// when no newer value arrived by then, even while src stays open and
// silent. Run it as a task of its own (`task.Go() { stream.Debounced(src,
// d, out) }`). It waits for a value of src, then waits up to d on the
// Scheduler for the next one (timeout.PopWithin). A newer value
// replaces the held one and starts a new wait. When d passes first, it
// pushes the held value to out. When src ends, it pushes the held value at
// once and ends out. A value that arrives at the deadline's own instant
// may either replace the held one or follow it; it is never lost. Values
// already queued are taken with no timer, so a backlog costs none. A d of zero or less keeps every value. It fails Closed
// when out is closed before it ends.
func Debounced[T](src queue.Queue[T], d duration, out queue.Queue[T]) fails queue.Closed needs Scheduler {
	if d <= 0ns {
		for v in src.Values() {
			try out.Push(v)
		}
		out.End()
		return
	}
	let mut pending Option[T] = None
	let mut open = true
	for open {
		let e = match pending {
		case Some[T]:
			nextWithin(src, d)
		case None:
			nextOf(src)
		}
		match e {
		case arrival[T] as a:
			pending = Some[T]{Value: a.Value}
		case quiet:
			try pushHeld(out, pending)
			pending = None
		case ended:
			try pushHeld(out, pending)
			out.End()
			open = false
		}
	}
}

// DebouncedMatchesModel: Debounced emits the last value of each burst d
// after it arrived, never while the burst goes on, and the last value of
// src when src ends (debouncedModel). A producer task pushes xs with
// even gaps of 0 to 98 ms on a time.Manual, the window d is odd (1 to 59
// ms), so no arrival falls on a deadline's instant, and a reader task
// records each value of out with the time it arrived.
law DebouncedMatchesModel(gaps []int, xs []int, w int) {
	let m = time.NewManual(0)
	let d = 2*(window(w)%30) + 1
	let n = len(xs)
	let start = m.Now()
	with context { Scheduler: m } {
		let src = queue.New[int](n + 1)
		let out = queue.New[int](n + 1)
		let seen = queue.New[int](2*n + 1)
		let producer = task.Go() {
			for i, x in xs {
				Scheduler.Sleep(millis(2 * gapAt(gaps, i)))
				src.Push(x) catch {
				case queue.Closed:
				}
			}
			src.End()
		}
		let debouncer = task.Go() {
			Debounced(src, millis(d), out) catch {
			case queue.Closed:
			}
		}
		let reader = task.Go() {
			for v in out.Values() {
				seen.Push(v) catch {
				case queue.Closed:
				}
				seen.Push(time.Count(m.Elapsed(start), 1ms)) catch {
				case queue.Closed:
				}
			}
			seen.End()
		}
		let at = evenArrivals(gaps, n)
		m.Advance(millis(lastOf(at) + d + 1))
		producer.Wait()
		debouncer.Wait()
		reader.Wait()
		sameInts(collect(seen.Values()), debouncedModel(at, xs, d))
	}
}

// debouncedModel is what Debounced emits for values xs arriving at at
// (ms) with window d, as value, time pairs: each xs[i] whose next value
// arrives more than d later, at at[i]+d, and the last at its arrival.
func debouncedModel(at []int, xs []int, d int) []int {
	let mut out = []int{}
	for i, x in xs {
		if i == len(xs)-1 {
			out = out.Append(x).Append(at[i])
		} else if at[i+1]-at[i] > d {
			out = out.Append(x).Append(at[i] + d)
		}
	}
	out
}

// evenArrivals is the arrival time of each of n values with the gaps
// doubled, in milliseconds.
func evenArrivals(gaps []int, n int) []int {
	let mut at = []int{}
	let mut t = 0
	for i in 0..n {
		t = t + 2*gapAt(gaps, i)
		at = at.Append(t)
	}
	at
}

// lastOf is the last value of at, or 0 when at is empty.
func lastOf(at []int) int {
	if len(at) == 0 {
		0
	} else {
		at[len(at)-1]
	}
}

// pushHeld pushes the value pending holds, if any, to out.
func pushHeld[T](out queue.Queue[T], pending Option[T]) fails queue.Closed {
	match pending {
	case Some[T] as p:
		try out.Push(p.Value)
	case None:
	}
}

// arrival is a value of the source; quiet, a wait that d ended; ended,
// the end of the source.
type arrival[T] { Value T }
type quiet {}
type ended {}
type event[T] = arrival[T] | quiet | ended

// nextOf waits for the next value of src, with no deadline.
func nextOf[T](src queue.Queue[T]) event[T] {
	let v = src.Pop() catch {
	case queue.Closed:
		return ended
	}
	arrival[T]{Value: v}
}

// nextWithin waits up to d for the next value of src. A value already in
// src is taken with no timer; a value that enters at the deadline's
// instant is taken or stays in src, never lost.
func nextWithin[T](src queue.Queue[T], d duration) event[T] needs Scheduler {
	let v = timeout.PopWithin(src, d) catch {
	case timeout.Expired:
		return quiet
	case queue.Closed:
		return ended
	}
	arrival[T]{Value: v}
}
