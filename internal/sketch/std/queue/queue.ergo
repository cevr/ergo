// Package queue is a first-in-first-out list of values between tasks
// (docs/spec/runtime.md, Queues; #207). The Go bodies are runtime/v1's New
// and the methods of its Queue; the caller's task, a hidden argument of
// Push, Pop and Values, is docs/spec/stdlib.md's Hidden arguments.

// Closed is the failure of Push on a closed queue and of Pop on a closed,
// empty one. A closed queue is a normal end of the protocol, not a stop.
extern go ergo.local/prototype/runtime/v1.Closed type Closed {}

// Full is the failure of Offer on a queue with no room now.
extern go ergo.local/prototype/runtime/v1.Full type Full {}

// Queue is a queue of T with a fixed capacity.
extern go ergo.local/prototype/runtime/v1.Queue type Queue[T own] {
	runtimeOnly(),
	// Push adds v at the back, waiting while the queue is full. It fails
	// with Closed when the queue is closed, or closes while it waits. It
	// takes v: a resource moves into the queue (resources R13).
	Push(v own T) fails Closed,
	// Pop takes the value at the front, waiting while the queue is open and
	// empty. It fails with Closed when the queue is closed and empty.
	Pop() T fails Closed,
	// End ends admission. It does nothing on a closed queue, never waits
	// and never fails; the values in the queue stay for Pop. It is a
	// half-close (Node's writable.end(), gRPC's CloseSend, Go's
	// CloseWrite), not a release, so a Queue of plain values stays a
	// shared handle (#197 q53).
	End(),
	// Values pops each value in turn, as a Seq for a for loop: it waits
	// like Pop and ends when the queue is closed and empty. A break stops
	// it; the values not yet popped stay in the queue.
	//
	// Unbounded: it ends only when another task closes the queue, so a
	// loop that collects it all waits for that close.
	Values() Seq[T],
	// Poll takes the value Pop would take when one is there now, and is
	// None when there is none, open or closed. It never waits. With
	// capacity 0 it takes the value of a waiting Push, which then
	// succeeds.
	Poll() Option[T],
	// Offer adds v at the back now, or not at all: it never waits. It fails
	// with Full when the queue holds its capacity, or when earlier Pushes
	// still wait for room, and with Closed when the queue is closed. A
	// producer that must not wait catches Full and drops v (Effect's
	// dropping strategy: the oldest values stay), or calls Slide. On a
	// queue of capacity 0 it always fails Full. It takes v, as Push does.
	Offer(v own T) fails Closed | Full,
	// Slide adds v at the back now, never waiting: when the queue holds its
	// capacity, the value at the front leaves it and Slide gives it back,
	// so the queue keeps the newest values (Effect's sliding strategy) and
	// the caller owns the evicted one: a resource must be bound, and its
	// scope releases it (resources R42), as for Poll. The eviction and
	// the entry are one step of the queue, so v enters exactly once and no
	// other producer takes the room between them. A Push still waiting for
	// room keeps waiting. It fails with Closed on a closed queue; a capacity
	// of 0 is a defect: there is never room to slide into. It takes v, as
	// Push does.
	Slide(v own T) Option[T] fails Closed,
	// Cap is the capacity New gave the queue.
	Cap() int,
	// Len is how many values are in the queue that nothing has taken yet,
	// from 0 to the capacity. The value of a Push that still waits for
	// room is not counted. It never waits.
	Len() int,
	// A queue keeps the values it takes (the prelude's Keeping; resources
	// R13, Q7): Keeping's drain is its release when its values are
	// resources. It ends admission, as End does, and gives every value
	// left, oldest first; the owner's release releases them last entered
	// first. Only the release calls it; it never waits.
	..Keeping[T],

	// EndIsIdempotent: a second End returns at once and never fails.
	law EndIsIdempotent() {
		End()
		End()
		true
	},
	// PushAfterEndFails: Push after End fails Closed at once,
	// whatever its capacity and contents.
	law PushAfterEndFails(v T) {
		End()
		Push(v) catch {
		case Closed:
			return true
		}
		false
	},
	// ValuesStops: Values is a Seq that stops (stdlib.md, Std laws 5). On
	// the closed queue, with n values in it, a yield that returns false at
	// its k-th call (k of 1 or more) is called min(k, n) times, and the
	// values it did not take stay in the queue: Len() is n - min(k, n).
	law ValuesStops(k int) {
		if k < 1 {
			return true
		}
		End()
		let n = Len()
		let mut calls = 0
		let s = Values()
		s(func(v T) bool {
			calls = calls + 1
			calls < k
		})
		let taken = if k < n { k } else { n }
		calls == taken && Len() == n-taken
	},
}

// FirstInFirstOut: Pop gives the values in the order Push added them.
law FirstInFirstOut(a int, b int) {
	let q = New[int](2)
	try q.Push(a)
	try q.Push(b)
	let first = try q.Pop()
	let second = try q.Pop()
	first == a && second == b
}

// EndKeepsValues: End ends admission and keeps the values in the queue
// for Pop.
law EndKeepsValues(v int) {
	let q = New[int](1)
	try q.Push(v)
	q.End()
	try q.Pop() == v
}

// PollOnEmptyIsNone: Poll on an empty queue is None at once, open or
// closed.
law PollOnEmptyIsNone() {
	let q = New[int](1)
	let open = q.Poll() == None
	q.End()
	open && q.Poll() == None
}

// PollTakesTheFront: Poll takes the values in the order Push added them,
// also after End, and is None when they are all taken.
law PollTakesTheFront(a int, b int) {
	let q = New[int](2)
	try q.Push(a)
	try q.Push(b)
	q.End()
	q.Poll() == Some[int]{Value: a} && q.Poll() == Some[int]{Value: b} && q.Poll() == None
}

// LenCountsUntaken: Len is the count of values pushed and not yet taken.
law LenCountsUntaken(xs []int) {
	let q = New[int](len(xs))
	for x in xs {
		try q.Push(x)
	}
	let full = q.Len() == len(xs)
	let mut drained = true
	for x in xs {
		drained = drained && q.Poll() == Some[int]{Value: x}
	}
	full && drained && q.Len() == 0
}

// releaseCount records a release in Seen, with no capability row: a release
// that has no needs row can still change shared state and must run. queue
// observes it with a queue, since sync imports task, which imports queue.
type releaseCount { Seen Queue[int] } implements Closer

func Close(r releaseCount) {
	r.Seen.Push(1) catch {
	case Closed:
		return
	}
}

// PushAfterEndReleases: rejected admission releases the taken value in
// the call's step, not at the end of its caller's scope.
law PushAfterEndReleases() {
	let seen = New[int](8)
	let q = New[releaseCount](1)
	q.End()
	let r = releaseCount{Seen: seen}
	q.Push(r) catch {
	case Closed:
		return seen.Len() == 1
	}
	false
}

// DrainReleasesLeft: ending the queue's owner releases every value left.
law DrainReleasesLeft(n int) {
	let k = (n%8 + 8) % 8
	let seen = New[int](8)
	if true {
		let q = New[releaseCount](k)
		for _ in 0..k {
			let r = releaseCount{Seen: seen}
			try q.Push(r)
		}
	}
	seen.Len() == k
}

// New makes an open, empty queue that holds up to capacity values no Pop
// has taken yet; 0 makes each Push wait for its Pop. A negative capacity
// is a defect.
extern go ergo.local/prototype/runtime/v1.New func New[T own](capacity int) Queue[T]

// SlidingKeepsTheNewest: Slide into a queue of capacity c never waits and
// leaves the last c values sent, in order.
law SlidingKeepsTheNewest(xs []int, c int) {
	let capacity = 1 + (c%4+4)%4
	let q = New[int](capacity)
	for x in xs {
		try q.Slide(x)
	}
	q.End()
	let from = if len(xs) > capacity { len(xs) - capacity } else { 0 }
	let mut ok = q.Len() == len(xs)-from
	for i in from..len(xs) {
		ok = ok && try q.Pop() == xs[i]
	}
	ok
}

// DroppingKeepsTheOldest: Offer into a queue of capacity c keeps the first
// c values and fails Full on each later one; Pop then gives the kept
// values in order.
law DroppingKeepsTheOldest(xs []int, c int) {
	let capacity = 1 + (c%4+4)%4
	let q = New[int](capacity)
	let mut kept = []int{}
	let mut ok = true
	for x in xs {
		q.Offer(x) catch {
		case Full:
			ok = ok && len(kept) == capacity
			continue
		case Closed:
			return false
		}
		kept = kept.Append(x)
	}
	q.End()
	for k in kept {
		ok = ok && try q.Pop() == k
	}
	ok && q.Len() == 0 && len(kept) <= capacity
}
