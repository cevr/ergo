// Package queue is a first-in-first-out list of values between tasks
// (docs/spec/runtime.md, Queues; #207). The Go bodies are runtime/v1's New
// and the methods of its Queue; the caller's task, a hidden argument of
// Push, Pop and Values, is docs/spec/stdlib.md's Hidden arguments.

// Closed is the failure of Push on a closed queue and of Pop on a closed,
// empty one. A closed queue is a normal end of the protocol, not a stop.
type Closed {}

// Queue is a queue of T with a fixed capacity.
type Queue[T] {
	// Push adds v at the back, waiting while the queue is full. It fails
	// with Closed when the queue is closed, or closes while it waits.
	Push(v T) fails Closed,
	// Pop takes the value at the front, waiting while the queue is open and
	// empty. It fails with Closed when the queue is closed and empty.
	Pop() T fails Closed,
	// Close ends admission. It does nothing on a closed queue, never waits
	// and never fails; the values in the queue stay for Pop.
	Close(),
	// Values pops each value in turn, as a Seq for a for loop: it waits
	// like Pop and ends when the queue is closed and empty. A break stops
	// it; the values not yet popped stay in the queue.
	Values() Seq[T],
	// Poll takes the value Pop would take when one is there now, and is
	// None when there is none, open or closed. It never waits. With
	// capacity 0 it takes the value of a waiting Push, which then
	// succeeds.
	Poll() Option[T],
	// Len is how many values are in the queue that nothing has taken yet,
	// from 0 to the capacity. The value of a Push that still waits for
	// room is not counted. It never waits.
	Len() int,

	// CloseIsIdempotent: a second Close returns at once and never fails.
	law CloseIsIdempotent() {
		Close()
		Close()
		true
	},
	// PushAfterCloseFails: Push on a closed queue fails Closed at once,
	// whatever its capacity and contents.
	law PushAfterCloseFails(v T) {
		Close()
		Push(v) catch {
		case Closed:
			return true
		}
		false
	},
	// ValuesStops: Values is a Seq that stops (stdlib.md, Std laws 5). On
	// the closed queue, with n values in it, a yield that returns false at
	// its k-th call (k of 1 or more) is called min(k, n) times, and the
	// values it did not take stay in the queue: Len() is n - min(k, n).
	law ValuesStops(k int) {
		if k < 1 {
			return true
		}
		Close()
		let n = Len()
		let mut calls = 0
		let s = Values()
		s(func(v T) bool {
			calls = calls + 1
			calls < k
		})
		let taken = if k < n { k } else { n }
		calls == taken && Len() == n-taken
	},
}

// FirstInFirstOut: Pop gives the values in the order Push added them.
law FirstInFirstOut(a int, b int) {
	let q = New[int](2)
	try q.Push(a)
	try q.Push(b)
	let first = try q.Pop()
	let second = try q.Pop()
	first == a && second == b
}

// CloseKeepsValues: Close ends admission and keeps the values in the queue
// for Pop.
law CloseKeepsValues(v int) {
	let q = New[int](1)
	try q.Push(v)
	q.Close()
	try q.Pop() == v
}

// PollOnEmptyIsNone: Poll on an empty queue is None at once, open or
// closed.
law PollOnEmptyIsNone() {
	let q = New[int](1)
	let open = q.Poll() == None
	q.Close()
	open && q.Poll() == None
}

// PollTakesTheFront: Poll takes the values in the order Push added them,
// also after Close, and is None when they are all taken.
law PollTakesTheFront(a int, b int) {
	let q = New[int](2)
	try q.Push(a)
	try q.Push(b)
	q.Close()
	q.Poll() == Some[int]{Value: a} && q.Poll() == Some[int]{Value: b} && q.Poll() == None
}

// LenCountsUntaken: Len is the count of values pushed and not yet taken.
law LenCountsUntaken(xs []int) {
	let q = New[int](len(xs))
	for x in xs {
		try q.Push(x)
	}
	let full = q.Len() == len(xs)
	let mut drained = true
	for x in xs {
		drained = drained && q.Poll() == Some[int]{Value: x}
	}
	full && drained && q.Len() == 0
}

// New makes an open, empty queue that holds up to capacity values no Pop
// has taken yet; 0 makes each Push wait for its Pop. A negative capacity
// is a defect.
extern go ergo.local/prototype/runtime/v1.New func New[T](capacity int) Queue[T]
