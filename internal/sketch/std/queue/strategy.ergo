// What a producer does when a bounded queue is full (Effect's queue
// strategies: suspend, dropping, sliding). Ergo does not fix the strategy
// in the queue: each send says it. Push waits for room (back-pressure);
// Offer, caught on Full, drops the new value and keeps the oldest; Slide
// drops the oldest and keeps the newest. One queue can take all three.

// Slide adds v at the back without waiting: when the queue is full it
// takes the value at the front and drops it, then adds v, so the queue
// keeps the newest values (Effect's sliding strategy). Another producer may
// take the room first; Slide then drops one more and tries again. It fails
// with Closed on a closed queue. A capacity of 0 is a defect: there is
// never room to slide into.
func Slide[T](q Queue[T], v T) fails Closed {
	if q.Cap() == 0 {
		Unreachable("queue.Slide: a queue of capacity 0 has no room to slide into")
	}
	for {
		q.Offer(v) catch {
		case Full:
			let _ = q.Poll()
			continue
		case Closed:
			return Closed
		}
		return
	}
}

// DroppingKeepsTheOldest: Offer into a queue of capacity c keeps the first
// c values and fails Full on each later one; Pop then gives the kept
// values in order.
law DroppingKeepsTheOldest(xs []int, c int) {
	let capacity = 1 + (c%4+4)%4
	let q = New[int](capacity)
	let mut kept = []int{}
	let mut ok = true
	for x in xs {
		q.Offer(x) catch {
		case Full:
			ok = ok && len(kept) == capacity
			continue
		case Closed:
			return false
		}
		kept = kept.Append(x)
	}
	q.End()
	for k in kept {
		ok = ok && try q.Pop() == k
	}
	ok && q.Len() == 0 && len(kept) <= capacity
}

// SlidingKeepsTheNewest: Slide into a queue of capacity c never waits and
// leaves the last c values sent, in order.
law SlidingKeepsTheNewest(xs []int, c int) {
	let capacity = 1 + (c%4+4)%4
	let q = New[int](capacity)
	for x in xs {
		try Slide(q, x)
	}
	q.End()
	let from = if len(xs) > capacity { len(xs) - capacity } else { 0 }
	let mut ok = q.Len() == len(xs) - from
	for i in from..len(xs) {
		ok = ok && try q.Pop() == xs[i]
	}
	ok
}
