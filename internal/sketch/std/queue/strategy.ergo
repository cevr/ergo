// What a producer does when a bounded queue is full (Effect's queue
// strategies: suspend, dropping, sliding). Ergo does not fix the strategy
// in the queue: each send says it. Push waits for room (back-pressure);
// Offer, caught on Full, drops the new value and keeps the oldest; Slide
// drops the oldest and keeps the newest, in one step of the queue (an
// operation of Queue, not a retry of Offer: a value of an own T is handed
// off once). One queue can take all three.

// SlidingKeepsTheNewest: Slide into a queue of capacity c never waits and
// leaves the last c values sent, in order.
law SlidingKeepsTheNewest(xs []int, c int) {
	let capacity = 1 + (c%4+4)%4
	let q = New[int](capacity)
	for x in xs {
		try q.Slide(x)
	}
	q.End()
	let from = if len(xs) > capacity { len(xs) - capacity } else { 0 }
	let mut ok = q.Len() == len(xs)-from
	for i in from..len(xs) {
		ok = ok && try q.Pop() == xs[i]
	}
	ok
}
