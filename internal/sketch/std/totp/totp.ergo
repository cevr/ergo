// Package totp is time-based one-time passwords (RFC 6238; docs/spec/
// stdlib.md, totp): the six-digit codes an authenticator app shows, each
// the HMAC-SHA-1 of a shared secret and the number of periods since 1970,
// cut to its digits (RFC 4226's dynamic truncation). It is pure: a code is
// a function of the secret and the time. A code is good for its period,
// and Verify accepts the codes of a window of periods around now for a
// clock that drifts; that a period's code is used once is the caller's
// to keep, with proof.Store's Claim (proof.VerifyCode).
//
// Effect: none; the pin has no one-time password module. Go: the
// pquerna/otp package's totp.GenerateCode and totp.Validate; yielded/auth
// and better-auth's two-factor plugin keep the same three parameters.

import option
import strconv
import strings
import time

// Params is how codes are made: digits per code, the period of a code,
// and the periods on each side of now that Verify accepts. NewParams
// makes one; Default is the one apps expect.
type Params { digits int, period duration, window int }

// BadParams is parameters NewParams refuses.
type BadParams { Reason string }

// NewParams is codes of digits digits, each good for period, verified
// within window periods on each side of now. It fails for digits outside
// 6..8, a period under one second or not whole seconds, and a window
// outside 0..2: RFC 6238 (5.2) asks for at most one period of drift
// backwards, and a wider window lets a guess match more codes.
func NewParams(digits int, period duration, window int) Params fails BadParams {
	if digits < 6 || digits > 8 {
		return BadParams{Reason: "the digits are 6, 7 or 8"}
	}
	if period < 1s || int64(period)%int64(1s) != 0 {
		return BadParams{Reason: "the period is whole seconds, one or more"}
	}
	if window < 0 || window > 2 {
		return BadParams{Reason: "the window is 0, 1 or 2 periods"}
	}
	Params{digits: digits, period: period, window: window}
}

// Default is six digits, a period of 30 seconds and a window of one
// period on each side: what authenticator apps make.
func Default() Params { Params{digits: 6, period: 30s, window: 1} }

// Period is how long a code of p is good for.
func Period(p Params) duration { p.period }

// Window is the periods on each side of now that Verify accepts under p.
func Window(p Params) int { p.window }

// StepOf is the number of whole periods from 1970 to t, under p.
func StepOf(p Params, t time.Time) int64 {
	let sec = time.UnixSeconds(t)
	let per = int64(p.period) / int64(1s)
	if sec < 0 && sec%per != 0 {
		return sec/per - 1
	}
	sec / per
}

// Key is a secret made ready once (KeyOf): the states of HMAC-SHA-1's
// inner and outer hash after the secret's pads (RFC 2104), never the
// secret. A server that checks many codes of one secret keys it once and
// verifies with VerifyKey, so a check costs the window's hashes alone.
// A Key is a value: two tasks may verify with one at once. The states
// are bytes, so a step resumes them where they lie, with no copy.
type Key { inner []byte, outer []byte }

// KeyOf is secret made ready for VerifyKey.
func KeyOf(secret string) Key {
	let inner, outer = keyState(secret)
	Key{inner: inner, outer: outer}
}

// keyState is the two SHA-1 states after the secret's pads, as hmac.Key
// keeps them for SHA1; hotpNumber resumes them for one step and
// truncates the tag (RFC 4226 5.3), with no copy and no allocation.
extern go ergo.local/prototype/runtime/v1/digest.HotpKeyState func keyState(secret string) ([]byte, []byte)
extern go ergo.local/prototype/runtime/v1/digest.HotpNumber func hotpNumber(inner []byte, outer []byte, counter int64) int

// CodeOf is the code of step under p and secret: the HMAC-SHA-1 of the
// step as eight big-endian bytes, cut at the offset its last byte's low
// four bits give, to 31 bits, then to p's digits with leading zeros.
func CodeOf(p Params, secret string, step int64) string {
	let text = strconv.Itoa(numberAt(KeyOf(secret), step, modOf(p)))
	strings.Repeat("0", p.digits-text.Len()) + text
}

// numberAt is the number CodeOf writes for step under k: the step's
// truncated HMAC modulo mod (modOf: 10 to p's digits), so Verify
// compares numbers, never texts, and works out mod once per check.
func numberAt(k Key, step int64, mod int) int { hotpNumber(k.inner, k.outer, step) % mod }

// modOf is 10 to the power of p's digits.
func modOf(p Params) int {
	let mut mod = 1
	for _ in 0..p.digits {
		mod = mod * 10
	}
	mod
}

// Code is the code of the period that holds t.
func Code(p Params, secret string, t time.Time) string { CodeOf(p, secret, StepOf(p, t)) }

// Verify is the step whose code code is, among the steps of p's window
// around now, or None: VerifyKey under the secret keyed for this call.
func Verify(p Params, secret string, code string, now time.Time) option.Option[int64] { VerifyKey(p, KeyOf(secret), code, now) }

// VerifyKey is Verify under a secret keyed once; Verify is it, so
// Verify's laws state it. A code that is not p's digits matches no step.
// Otherwise it reads code's number once and compares it with every
// step's of the window, with no early exit, so the work it does says
// nothing of which step matched (law SameWorkForEveryCode).
func VerifyKey(p Params, k Key, code string, now time.Time) option.Option[int64] {
	let found, _ = VerifyWork(p, k, code, now)
	found
}

// VerifyWork is VerifyKey and the number of steps it hashed: the work
// counter that shows a check's cost does not depend on its code (law
// SameWorkForEveryCode), counted, never timed.
func VerifyWork(p Params, k Key, code string, now time.Time) (option.Option[int64], int) {
	if code.Len() != p.digits {
		return (option.None, 0)
	}
	let mut want = 0
	for i in 0..code.Len() {
		let c = code[i]
		if c < '0' || c > '9' {
			return (option.None, 0)
		}
		want = want*10 + int(c-'0')
	}
	let at = StepOf(p, now)
	let mut found option.Option[int64] = option.None
	let mut hashed = 0
	let mod = modOf(p)
	for d in -p.window..p.window+1 {
		let step = at + int64(d)
		hashed += 1
		if numberAt(k, step, mod) == want && found == option.None {
			found = option.Some[int64]{Value: step}
		}
	}
	(found, hashed)
}

// URI is the otpauth:// text an authenticator app reads from a QR code:
// the issuer and the account in its label, the secret in base32 with no
// padding, and p's digits and period (the Key URI Format of Google
// Authenticator).
func URI(p Params, issuer string, account string, secret string) string {
	let label = escape(issuer) + ":" + escape(account)
	"otpauth://totp/" + label + "?secret=" + base32(secret) + "&issuer=" + escape(issuer) + "&algorithm=SHA1&digits=\(p.digits)&period=\(int64(p.period) / int64(1s))"
}

// base32 is s in RFC 4648 base32, with no padding.
func base32(s string) string {
	let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
	let bs = strings.Bytes(s)
	let mut out = []byte{}
	let mut buf = 0
	let mut bits = 0
	for b in bs {
		buf = (buf << 8) | int(b)
		bits = bits + 8
		for bits >= 5 {
			bits = bits - 5
			out = out.Append(strings.Bytes(alphabet)[(buf>>bits)&31])
		}
		buf = buf & ((1 << bits) - 1)
	}
	if bits > 0 {
		out = out.Append(strings.Bytes(alphabet)[(buf<<(5-bits))&31])
	}
	strings.FromBytes(out)
}

// escape is s with every byte but a letter, a digit and -._~ written as
// %XX (RFC 3986's unreserved bytes kept).
func escape(s string) string {
	let digits = "0123456789ABCDEF"
	let mut out = []byte{}
	for b in strings.Bytes(s) {
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '-' || b == '.' || b == '_' || b == '~' {
			out = out.Append(b)
		} else {
			out = out.Append('%').Append(strings.Bytes(digits)[int(b)>>4]).Append(strings.Bytes(digits)[int(b)&15])
		}
	}
	strings.FromBytes(out)
}

// vector is one row of RFC 6238's appendix B for SHA-1: the Unix time and
// the eight-digit code.
type vector { Sec int64, Code string }

// MatchesRFC6238: Code gives RFC 6238's eight-digit SHA-1 codes for its
// test times, with the secret "12345678901234567890" and a period of 30
// seconds.
law MatchesRFC6238() {
	let p = NewParams(8, 30s, 1) catch {
	case BadParams:
		return false
	}
	let rows = []vector{
		vector{Sec: 59, Code: "94287082"},
		vector{Sec: 1111111109, Code: "07081804"},
		vector{Sec: 1111111111, Code: "14050471"},
		vector{Sec: 1234567890, Code: "89005924"},
		vector{Sec: 2000000000, Code: "69279037"},
		vector{Sec: 20000000000, Code: "65353130"},
	}
	for r in rows {
		if Code(p, "12345678901234567890", time.Unix(r.Sec, 0)) != r.Code {
			return false
		}
	}
	true
}

// VerifyOfCode: the code of a time verifies at that time, as that
// time's step, and within the window around it.
law VerifyOfCode(secret string, sec int64, drift int) {
	let p = Default()
	let t = time.Unix(((sec%10000000000)+10000000000)%10000000000, 0)
	let step = StepOf(p, t)
	let code = Code(p, secret, t)
	let later = t.Add(time.Times(30s, ((drift%2)+2)%2))
	match Verify(p, secret, code, later) {
	case option.Some[int64] as s:
		s.Value == step || CodeOf(p, secret, s.Value) == code
	case option.None:
		false
	}
}

// SameWorkForEveryCode: Verify hashes every step of the window, for a
// code of the window's first step, of its last, and of none: where a
// code matches does not change the work, so it cannot change the time.
law SameWorkForEveryCode(secret string, sec int64, w int) {
	let p = NewParams(6, 30s, ((w%3)+3)%3) catch {
	case BadParams:
		return false
	}
	let now = time.Unix(((sec%10000000000)+10000000000)%10000000000, 0)
	let at = StepOf(p, now)
	let k = KeyOf(secret)
	let first = CodeOf(p, secret, at-int64(Window(p)))
	let last = CodeOf(p, secret, at+int64(Window(p)))
	let mut none = "000000"
	for n in 0..2*Window(p)+2 {
		let text = strconv.Itoa(n)
		let c = strings.Repeat("0", 6-text.Len()) + text
		let found, _ = VerifyWork(p, k, c, now)
		if found == option.None {
			none = c
		}
	}
	let a, wa = VerifyWork(p, k, first, now)
	let b, wb = VerifyWork(p, k, last, now)
	let c, wc = VerifyWork(p, k, none, now)
	a != option.None && b != option.None && c == option.None && wa == 2*Window(p)+1 && wb == wa && wc == wa
}

// OutsideWindowFails: the code of a step more than the window away from
// now does not verify, unless a step within the window has the same code
// (one chance in a million for each).
law OutsideWindowFails(secret string, sec int64, far int) {
	let p = Default()
	let now = time.Unix(((sec%10000000000)+10000000000)%10000000000, 0)
	let at = StepOf(p, now)
	let k = int64(2 + ((far%20)+20)%20)
	for sign in []int64{-1, 1} {
		let code = CodeOf(p, secret, at+sign*k)
		let same = CodeOf(p, secret, at-1) == code || CodeOf(p, secret, at) == code || CodeOf(p, secret, at+1) == code
		if !same && Verify(p, secret, code, now) != option.None {
			return false
		}
	}
	true
}

// ShortCodeFails: a code with its first digit cut does not verify, even
// when that digit is 0 and the number is the same: a code is p's digits.
law ShortCodeFails(secret string, sec int64) {
	let p = Default()
	let now = time.Unix(((sec%10000000000)+10000000000)%10000000000, 0)
	Verify(p, secret, Code(p, secret, now)[1:], now) == option.None
}

// NewParamsBoundsTheWindow: NewParams refuses a window outside 0..2, and
// keeps one inside it.
law NewParamsBoundsTheWindow(window int) {
	let w = ((window%40)+40)%40 - 20
	let _ = NewParams(6, 30s, w) catch {
	case BadParams:
		return w < 0 || w > 2
	}
	w >= 0 && w <= 2
}

// StepsAreWholePeriods: the step of a time is the periods from 1970 to
// it, rounded down, before 1970 too.
law StepsAreWholePeriods(sec int64) {
	let p = Default()
	let s = sec % 100000000000
	let step = StepOf(p, time.Unix(s, 0))
	step*30 <= s && s < (step+1)*30
}

// URIOfTheRFCSecret: the otpauth text of RFC 6238's secret holds it in
// base32, and the issuer and account escaped.
law URIOfTheRFCSecret() {
	URI(Default(), "Example Co", "a@b.c", "12345678901234567890") == "otpauth://totp/Example%20Co:a%40b.c?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ&issuer=Example%20Co&algorithm=SHA1&digits=6&period=30"
}
