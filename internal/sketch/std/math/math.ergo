// Package math is Go's math for float64 (docs/spec/stdlib.md, math and
// bits; std-text-runes). Its functions call Go's math through import
// go, as a user binds it (NP4f), so a call compiles to Go's own call, an
// instruction for Floor, Ceil, Trunc, Sqrt and Abs on amd64 and arm64.
// ToInt, ToInt64, ToUint, ToUint64 and ToUintptr are Ergo (NP4f-16): each
// guards the conversion with the open interval in which the truncation
// fits, and converts through int64(f) or uint64(f), whose helper's compare
// is the guard's own, so Go's CSE and prove pass drop it. The externs
// ToInt8 … ToUint32 bind runtime/v1 bodies (runtime/v1/numbers.go): an
// Ergo body pays the helper's 64-bit compare and clamps inside its guard
// (std-go-share.txt names why). Go's constants are functions here
// (MaxInt64()): a std package let has no Go name in a build yet.

import go math

// Abs is the absolute value of f; Abs(±Inf) is +Inf and Abs(NaN) is NaN.
func Abs(f float64) float64 { math.Abs(f) }

// Ceil is the least integer value at least f.
func Ceil(f float64) float64 { math.Ceil(f) }

// Floor is the greatest integer value at most f.
func Floor(f float64) float64 { math.Floor(f) }

// Trunc is the integer value of f, toward zero.
func Trunc(f float64) float64 { math.Trunc(f) }

// Round is the nearest integer to f, half away from zero.
func Round(f float64) float64 { math.Round(f) }

// Sqrt is the square root of f; Sqrt of a negative f is NaN, as in Go.
func Sqrt(f float64) float64 { math.Sqrt(f) }

// Pow is x to the power y, with Go's special cases.
func Pow(x float64, y float64) float64 { math.Pow(x, y) }

// FMA is x*y + z rounded once, as Go's math.FMA: the fused multiply-add,
// for a program that asks for it by name. Ergo's own x*y + z rounds the
// product and then the sum, on every host (docs/spec/types.md, Operators
// 5); FMA is the same on every host too, Go's exact software form where
// the host has no fused instruction.
func FMA(x float64, y float64, z float64) float64 { math.FMA(x, y, z) }

// Mod is the remainder of x / y, with the sign of x, as Go's math.Mod.
func Mod(x float64, y float64) float64 { math.Mod(x, y) }

// Log is the natural logarithm of f, with Go's special cases: Log(+Inf)
// is +Inf, Log(0) is -Inf, and Log of a negative f or NaN is NaN.
func Log(f float64) float64 { math.Log(f) }

// Exp is e to the power f, with Go's special cases: Exp(+Inf) is +Inf,
// Exp(NaN) is NaN, and a very large f gives +Inf and a very small one 0.
func Exp(f float64) float64 { math.Exp(f) }

// Sin is the sine of x radians, as Go's math.Sin: Sin(±0) is ±0, and
// Sin(±Inf) and Sin(NaN) are NaN.
func Sin(x float64) float64 { math.Sin(x) }

// Sin is odd, bit for bit.
law SinIsOdd(x float64) { IsNaN(Sin(x)) || Sin(-x) == -Sin(x) }

// Cos is the cosine of x radians, as Go's math.Cos: Cos(±Inf) and
// Cos(NaN) are NaN.
func Cos(x float64) float64 { math.Cos(x) }

// Cos is even, bit for bit.
law CosIsEven(x float64) { IsNaN(Cos(x)) || Cos(-x) == Cos(x) }

// Tan is the tangent of x radians, as Go's math.Tan: Tan(±0) is ±0, and
// Tan(±Inf) and Tan(NaN) are NaN.
func Tan(x float64) float64 { math.Tan(x) }

// Tan is odd, bit for bit.
law TanIsOdd(x float64) { IsNaN(Tan(x)) || Tan(-x) == -Tan(x) }

// Asin is the arcsine of x in radians, as Go's math.Asin: Asin(±0) is ±0,
// and Asin of x outside [-1, 1] is NaN.
func Asin(x float64) float64 { math.Asin(x) }

// Asin is odd, bit for bit.
law AsinIsOdd(x float64) { IsNaN(Asin(x)) || Asin(-x) == -Asin(x) }

// Acos is the arccosine of x in radians, as Go's math.Acos: Acos of x
// outside [-1, 1] is NaN.
func Acos(x float64) float64 { math.Acos(x) }

// Acos lies in [0, Pi].
law AcosInRange(x float64) { IsNaN(Acos(x)) || Acos(x) >= 0.0 && Acos(x) <= 3.141592653589793 }

// Atan is the arctangent of x in radians, as Go's math.Atan: Atan(±0) is
// ±0 and Atan(±Inf) is ±Pi/2.
func Atan(x float64) float64 { math.Atan(x) }

// Atan is odd, lies in [-Pi/2, Pi/2], and never falls as x rises.
law AtanIsOddAndBounded(x float64) { IsNaN(x) || Atan(-x) == -Atan(x) && Atan(x) >= -1.5707963267948966 && Atan(x) <= 1.5707963267948966 }

law AtanIsMonotonic(a float64, b float64) { IsNaN(a) || IsNaN(b) || a > b || Atan(a) <= Atan(b) }

// Atan2 is the arctangent of y/x in radians, its quadrant from the signs
// of both, as Go's math.Atan2 with its special cases (Atan2(y, NaN) is
// NaN, Atan2(±0, x>=0) is ±0, Atan2(±0, x<=-0) is ±Pi, …).
func Atan2(y float64, x float64) float64 { math.Atan2(y, x) }

// On the right half plane Atan2 is Atan of the quotient.
law Atan2IsAtanOnTheRight(y float64, x float64) { IsNaN(y) || IsInf(y, 0) || IsNaN(x) || IsInf(x, 0) || x <= 0.0 || Atan2(y, x) == Atan(y/x) }

// Hypot is Sqrt(p*p + q*q) without needless overflow or underflow, as
// Go's math.Hypot: Hypot(±Inf, q) and Hypot(p, ±Inf) are +Inf, and with a
// NaN and no infinity it is NaN.
func Hypot(p float64, q float64) float64 { math.Hypot(p, q) }

// Hypot reads neither the signs nor the order of its sides.
law HypotIgnoresSignAndOrder(p float64, q float64) { IsNaN(Hypot(p, q)) || Hypot(-q, p) == Hypot(p, q) && Hypot(p, -q) == Hypot(p, q) }

// Cbrt is the cube root of x, as Go's math.Cbrt: Cbrt(±0) is ±0,
// Cbrt(±Inf) is ±Inf and Cbrt(NaN) is NaN.
func Cbrt(x float64) float64 { math.Cbrt(x) }

// Cbrt is odd and gives back the root of an integer's cube exactly.
law CbrtIsOdd(x float64) { IsNaN(x) || Cbrt(-x) == -Cbrt(x) }

law CbrtOfCube(k int) {
	let x = float64(k % 100000)
	Cbrt(x * x * x) == x
}

// Log2 is the binary logarithm of x, as Go's math.Log2, with Log's
// special cases.
func Log2(x float64) float64 { math.Log2(x) }

// Log2 of a power of two is its exponent exactly.
law Log2OfPowerOfTwo(k int) {
	let e = float64(k % 1023)
	Log2(Pow(2.0, e)) == e
}

// Log10 is the decimal logarithm of x, as Go's math.Log10, with Log's
// special cases.
func Log10(x float64) float64 { math.Log10(x) }

// Log10 never falls as x rises.
law Log10IsMonotonic(a float64, b float64) { IsNaN(a) || IsNaN(b) || a > b || Log10(a) <= Log10(b) || a < 0.0 }

// Inf is +Inf when sign is 0 or more, and -Inf otherwise.
func Inf(sign int) float64 { math.Inf(sign) }

// NaN is the IEEE 754 not-a-number value.
func NaN() float64 { math.NaN() }

// IsNaN reports whether f is a not-a-number value.
func IsNaN(f float64) bool { math.IsNaN(f) }

// IsInf reports whether f is an infinity: +Inf when sign is more than 0,
// -Inf when it is less, and either when it is 0.
func IsInf(f float64, sign int) bool { math.IsInf(f, sign) }

// MaxInt64 is the largest int64, Go's math.MaxInt64.
func MaxInt64() int64 { 9223372036854775807 }

// MinInt64 is the smallest int64, Go's math.MinInt64.
func MinInt64() int64 { -9223372036854775807 - 1 }

// MaxInt is the largest int, Go's math.MaxInt: Ergo's targets have 64-bit
// ints.
func MaxInt() int { 9223372036854775807 }

// MinInt is the smallest int, Go's math.MinInt.
func MinInt() int { -9223372036854775807 - 1 }

// OutOfRange is the failure of a float that an integer type cannot hold:
// NaN, an infinity, or a value whose truncation lies outside the type's
// range. Value is the float.
extern go ergo.local/prototype/runtime/v1.MathOutOfRange type OutOfRange { Value float64 }

// The checked conversions, one per integer type T that a float converts
// to (docs/spec/types.md, Conversions 4): ToT(f) is f toward zero, as
// T(f) is, when the result fits T. Where T(f) saturates (an infinity, a
// value out of range) or gives 0 for NaN, ToT fails OutOfRange, for a
// caller that must know. byte is ToUint8 and rune is ToInt32.

// ToInt is the checked int(f).
func ToInt(f float64) int fails OutOfRange {
	if f < 9223372036854775808.0 && f >= -9223372036854775808.0 {
		return int(int64(f))
	}
	OutOfRange{Value: f}
}

// ToInt8 is the checked int8(f).
extern go ergo.local/prototype/runtime/v1.MathToInt8 func ToInt8(f float64) int8 fails OutOfRange

// ToInt16 is the checked int16(f).
extern go ergo.local/prototype/runtime/v1.MathToInt16 func ToInt16(f float64) int16 fails OutOfRange

// ToInt32 is the checked int32(f).
extern go ergo.local/prototype/runtime/v1.MathToInt32 func ToInt32(f float64) int32 fails OutOfRange

// ToInt64 is the checked int64(f).
func ToInt64(f float64) int64 fails OutOfRange {
	if f < 9223372036854775808.0 && f >= -9223372036854775808.0 {
		return int64(f)
	}
	OutOfRange{Value: f}
}

// ToUint is the checked uint(f).
func ToUint(f float64) uint fails OutOfRange {
	if f > -1.0 && f < 18446744073709551616.0 {
		return uint(uint64(f))
	}
	OutOfRange{Value: f}
}

// ToUint8 is the checked uint8(f).
extern go ergo.local/prototype/runtime/v1.MathToUint8 func ToUint8(f float64) uint8 fails OutOfRange

// ToUint16 is the checked uint16(f).
extern go ergo.local/prototype/runtime/v1.MathToUint16 func ToUint16(f float64) uint16 fails OutOfRange

// ToUint32 is the checked uint32(f).
extern go ergo.local/prototype/runtime/v1.MathToUint32 func ToUint32(f float64) uint32 fails OutOfRange

// ToUint64 is the checked uint64(f).
func ToUint64(f float64) uint64 fails OutOfRange {
	if f > -1.0 && f < 18446744073709551616.0 {
		return uint64(f)
	}
	OutOfRange{Value: f}
}

// ToUintptr is the checked uintptr(f).
func ToUintptr(f float64) uintptr fails OutOfRange {
	if f > -1.0 && f < 18446744073709551616.0 {
		return uintptr(uint64(f))
	}
	OutOfRange{Value: f}
}

// FloorCeilBracket: a finite f lies between its Floor and its Ceil, which
// are at most 1 apart.
law FloorCeilBracket(f float64) {
	if IsNaN(f) || IsInf(f, 0) {
		return true
	}
	Floor(f) <= f && f <= Ceil(f) && Ceil(f)-Floor(f) <= 1.0
}

// TruncTowardZero: Trunc never moves away from zero, and is idempotent.
law TruncTowardZero(f float64) {
	if IsNaN(f) {
		return true
	}
	Abs(Trunc(f)) <= Abs(f) && Trunc(Trunc(f)) == Trunc(f)
}

// FMAWithinTheUnfusedError: FMA and the unfused x*y + z are each within
// one rounding of the exact x*y + z, so they differ by at most the two
// roundings of the unfused form and the one of FMA: 2^-53 of |x*y|, of
// the unfused sum and of FMA's result, doubled for the slack of bounding
// exact values by rounded ones. The values are finite and normal (built
// from integers), with z near -x*y so the sum cancels.
law FMAWithinTheUnfusedError(a int, b int, c int) {
	let x = float64(a%1000003) / 3.0
	let y = float64(b%1000033) / 7.0
	let p = x * y
	let z = float64(c%1009)/11.0 - p
	let unfused = p + z
	let fused = FMA(x, y, z)
	let eps = 1.1102230246251565e-16
	Abs(fused-unfused) <= 2.0*eps*(Abs(p)+Abs(unfused)+Abs(fused))
}

// FMARoundsOnce: with d = k·2^-30, (1+d)(1-d) - 1 is exactly -d², which a
// float64 holds, so FMA, which rounds once, gives it; the unfused form
// rounds 1 - d² first and loses it for most k.
law FMARoundsOnce(k int) {
	let d = float64((k%1000+1000)%1000+1) * 9.313225746154785e-10
	FMA(1.0+d, 1.0-d, -1.0) == -(d * d)
}

// AbsIsNonNegative: Abs is never below zero.
law AbsIsNonNegative(f float64) { IsNaN(f) || Abs(f) >= 0.0 }

// ToTFailsOnlyOutside, one law per checked conversion: ToT fails exactly
// for NaN, for f at or past T's greatest value plus one, and for a
// truncation below T's least value; otherwise it gives f's truncation,
// which is T(f).

law ToIntFailsOnlyOutside(f float64) {
	let n = ToInt(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 9223372036854775808.0 || Trunc(f) < -9223372036854775808.0
	}
	float64(n) == Trunc(f) && n == int(f)
}

law ToInt8FailsOnlyOutside(f float64) {
	let n = ToInt8(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 128.0 || Trunc(f) < -128.0
	}
	float64(n) == Trunc(f) && n == int8(f)
}

law ToInt16FailsOnlyOutside(f float64) {
	let n = ToInt16(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 32768.0 || Trunc(f) < -32768.0
	}
	float64(n) == Trunc(f) && n == int16(f)
}

law ToInt32FailsOnlyOutside(f float64) {
	let n = ToInt32(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 2147483648.0 || Trunc(f) < -2147483648.0
	}
	float64(n) == Trunc(f) && n == int32(f)
}

law ToInt64FailsOnlyOutside(f float64) {
	let n = ToInt64(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 9223372036854775808.0 || Trunc(f) < -9223372036854775808.0
	}
	float64(n) == Trunc(f) && n == int64(f)
}

law ToUintFailsOnlyOutside(f float64) {
	let n = ToUint(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 18446744073709551616.0 || Trunc(f) < 0.0
	}
	float64(n) == Trunc(f) && n == uint(f)
}

law ToUint8FailsOnlyOutside(f float64) {
	let n = ToUint8(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 256.0 || Trunc(f) < 0.0
	}
	float64(n) == Trunc(f) && n == uint8(f)
}

law ToUint16FailsOnlyOutside(f float64) {
	let n = ToUint16(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 65536.0 || Trunc(f) < 0.0
	}
	float64(n) == Trunc(f) && n == uint16(f)
}

law ToUint32FailsOnlyOutside(f float64) {
	let n = ToUint32(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 4294967296.0 || Trunc(f) < 0.0
	}
	float64(n) == Trunc(f) && n == uint32(f)
}

law ToUint64FailsOnlyOutside(f float64) {
	let n = ToUint64(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 18446744073709551616.0 || Trunc(f) < 0.0
	}
	float64(n) == Trunc(f) && n == uint64(f)
}

law ToUintptrFailsOnlyOutside(f float64) {
	let n = ToUintptr(f) catch {
	case OutOfRange:
		return IsNaN(f) || f >= 18446744073709551616.0 || Trunc(f) < 0.0
	}
	float64(n) == Trunc(f) && n == uintptr(f)
}
