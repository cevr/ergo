import actor
import queue
import time

// The crash view (H6a). An app's actor that ends with a defect (of its
// step, its timer or its work) or with its step's typed failure has
// crashed: the window stays open on the program's crash view, not on a
// view of the dead state, the program's report runs once, and a signal of
// the crash view starts a fresh actor from the machine's initial state.
// A declared failure of a view never crashes: a view's row is empty at a
// host entry (H8a), so it is a boundary's. A Done or a Stop is an end, not
// a crash: the loop ends as Run's does.

// DefectCrash is a crash by a defect, which RunApp raises when the window
// closes: Reason is the defect's text, as the runtime's report writes it
// after "panic: " (actor.Defected's; FK13-g1).
type DefectCrash { Reason string }

// FailureCrash is a crash by the step's typed failure, which RunApp fails
// with when the window closes.
type FailureCrash[F] { Failure F }

// CrashCause is what ended an app's actor.
type CrashCause[F] = DefectCrash | FailureCrash[F]

// Crash is how an app's actor crashed (FK13-g1): its Cause, the State it
// crashed in (its last committed state, the one the crashing step began
// from), and the Signal of the session's that it crashed on: Some when
// the actor ended on the signal the session had just sent it (its step's
// defect or failure), None when it ended by its timer or its work, which
// no signal of the session's caused.
type Crash[S, E, F] { Cause CrashCause[F], State S, Signal Option[E] }

// Crashes is what an app shows and does when it crashes: View is its
// crash view, whose signals reload (PlainCrash when the app has none), and
// Report runs once per crash, on the loop, before the crash view's first
// pass (a log line, a crash report sent by the program's work).
type Crashes[S, E, F] { View func(f *Frame[E], c Crash[S, E, F]), Report func(c Crash[S, E, F]) }

// PlainCrash is the crash view of an app that gives none: a line that
// says the program stopped and why, and a line that says whether a signal
// of the window's caused it. It sends no signal, so it cannot reload.
func PlainCrash[S, E, F](f *Frame[E], c Crash[S, E, F]) {
	match c.Cause {
	case DefectCrash as d:
		Text(f, "The program stopped: a defect ended it: \(d.Reason)")
	case FailureCrash[F]:
		Text(f, "The program stopped: its step failed.")
	}
	Text(f, signalLine(c))
}

// signalLine says what c crashed on: the window's signal, or none (a
// timer or a work, which no signal of the window's caused).
func signalLine[S, E, F](c Crash[S, E, F]) string {
	match c.Signal {
	case Some[E]:
		"signal: the last one the window sent"
	case None:
		"signal: none (timer or work)"
	}
}

// PlainCrashes is the Crashes of an app that gives none: PlainCrash, and no
// report.
func PlainCrashes[S, E, F]() Crashes[S, E, F] { Crashes[S, E, F]{View: PlainCrash[S, E, F], Report: noReport[S, E, F]} }

// crashOf is how an ended actor crashed: None for a Done or a stop.
func crashOf[S, E, O, F](a actor.Actor[S, E, Decision[S, O], F]) Option[CrashCause[F]] {
	match actor.ExitOf(a) {
	case actor.Defected as d:
		Some{Value: DefectCrash{Reason: d.Reason}}
	case actor.Failed[F] as x:
		Some{Value: FailureCrash[F]{Failure: x.Error}}
	case _:
		None
	}
}

// keeps is a step that takes every signal and changes nothing: alive asks
// actor.Can with it, so Can is false only when the actor has ended.
func keeps[S, E, O](s S, e E) Decision[S, O] { Enter[S]{Next: s} }

// aliveAfter is whether a is still running after every signal admitted
// before the call (actor.Can reads the state as State does).
func aliveAfter[S, E, O, F](a actor.Actor[S, E, Decision[S, O], F], e E) bool { actor.Can(a, keeps[S, E, O], e) }

// StartApp is Start for an app: it starts m as an actor with an inbox of
// capacity signals, on the providers in force, and its session shows
// crashes.View when that actor crashes, reports it with crashes.Report,
// and starts a fresh actor from m on a signal of the crash view.
func StartApp[E comparable, S, O, F, R, W, Q](m Machine[S, E, O, F, R, W], capacity int, view escaping func(f *Frame[E], s S) needs Q, crashes Crashes[S, E, F], post escaping func(ev Event[E])) (Session[S, E, Decision[S, O], F], []Op[E]) needs R | W | Scheduler | Q {
	let ctx = InForce[R | W | Scheduler]()
	let fresh = func() actor.Actor[S, E, Decision[S, O], F] {
		with ctx {
			actor.StartMachine(m, capacity, func(o O) {})
		}
	}
	let (s, first) = Start(fresh(), view, post)
	let mut app = s
	app.exit = crashOf[S, E, O, F]
	app.alive = aliveAfter[S, E, O, F]
	app.fresh = Some{Value: fresh}
	app.crashView = crashes.View
	app.report = crashes.Report
	(app, first)
}

// CrashOf is the crash a test host's app shows, None while its actor
// runs.
func CrashOf[S, E, D, F](h *TestHost[S, E, D, F]) Option[Crash[S, E, F]] { h.session.crash }

// NewAppTestHost is NewTestHost for an app (StartApp): m's actor, its
// crash view once it crashed, and a fresh actor on a reload.
func NewAppTestHost[E comparable, S, O, F, R, W, Q](m Machine[S, E, O, F, R, W], capacity int, view escaping func(f *Frame[E], s S) needs Q, crashes Crashes[S, E, F], clock time.Manual, room int) TestHost[S, E, Decision[S, O], F] fails BadPatch needs R | W | Scheduler | Q {
	let posted = queue.New[Event[E]](room)
	let (s, first) = StartApp(m, capacity, view, crashes, func(ev Event[E]) {
		posted.Push(ev) catch {
		case queue.Closed:
		}
	})
	try hostOf(s, first, posted, clock)
}

// RunApp is Run for an app (StartApp): it shows view of m's actor on h,
// and its crash view once the actor crashed, until h closes. When h
// closes on a crash, RunApp ends as the actor did, as its Stop does: it
// fails with the step's failure, or raises the defect; else it fails
// Closed, and Stopped when the actor ended with a Done or a stop.
func RunApp[E comparable, S, O, F, R, W, Q](h Host[E], m Machine[S, E, O, F, R, W], capacity int, view escaping func(f *Frame[E], s S) needs Q, crashes Crashes[S, E, F]) fails Closed | F | actor.Stopped needs R | W | Scheduler | Q {
	let (s, first) = StartApp(m, capacity, view, crashes, func(ev Event[E]) { h.Post(ev) })
	let mut session = s
	h.Show(first)
	let mut frames = Animating(&session.frame)
	h.Frames(frames)
	for {
		let ev = h.Next() catch {
		case Closed:
			if crashing(&session) {
				try session.actor.Stop()
			}
			return Closed
		}
		let ops = try Step(&session, ev)
		if len(ops) > 0 {
			h.Show(ops)
		}
		if Animating(&session.frame) != frames {
			frames = !frames
			h.Frames(frames)
		}
	}
}
