// Virtual rows (H5b): a list of many rows of one height, of which the
// composer runs only the rows a viewport shows, plus Overscan rows on each
// side. The viewport is view-local state the host owns, as a field's text
// is: a host reports it (Scrolled), and the next pass writes the rows it
// shows. A row's identity and cells are by its key, as in Each, so a row
// keeps them while it stays in the rows written, wherever it moves.

import time
import actor
import machines

// Overscan is the number of rows written past each edge of the viewport,
// so a small scroll shows rows already written.
let Overscan = 2

// Viewport is a list's scroll offset and visible height.
type Viewport { Offset Length, Height Length }

// Visible is the range [first, last) of the rows a list of count rows of
// rowHeight writes at viewport v: the rows v shows, with Overscan rows on
// each side, inside [0, count). A height under 1 counts as 1.
func Visible(count int, rowHeight Length, v Viewport) (int, int) {
	let mut h = rowHeight
	if h < 1.0 {
		h = 1.0
	}
	let mut off = v.Offset
	if off < 0.0 {
		off = 0.0
	}
	let mut height = v.Height
	if height < 0.0 {
		height = 0.0
	}
	let top = int(float64(off / h))
	let mut bottom = int(float64((off + height) / h))
	if float64(bottom)*float64(h) < float64(off+height) {
		bottom = bottom + 1
	}
	let mut first = top - Overscan
	if first < 0 {
		first = 0
	}
	let mut last = bottom + Overscan
	if last > count {
		last = count
	}
	if first > last {
		first = last
	}
	(first, last)
}

// Rows writes a list named label of count rows, each rowHeight high, a
// scroll container whose content is count * rowHeight high. Only the rows
// of Visible at the list's viewport run row(i), under key(i); the node
// says which row comes first, so a host places the rows at
// First * rowHeight, and the offset the pass used (Offset), which a host
// scrolls to when it is not its own. The viewport is (0, 0) until a host
// reports one.
func Rows[E, F, R](f mut Frame[E], label string, count int, rowHeight Length, key func(i int) Key, row func(i int) fails F needs R, at CallSite) fails F needs R {
	try rowsKeeping(f, label, count, rowHeight, -1, key, row, at)
}

// RowsAreTheCutEach: a long keyed list of rows with a toggle each, under
// drawn scrolls and resizes, adds at the end, drops of the first row and
// toggles of rows on the screen: after each step the list on the test host
// is the full list cut to the rows its viewport shows (shownRows), each
// with its toggle as the model keeps it by key (a row that leaves the
// rows written starts off when it returns), and the pass ran one row
// function per row written: the work grows with the viewport, not with the
// count (a list of 1,000 runs as few rows as one of 50).
law RowsAreTheCutEach(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		rowsFollow(seed, steps, m)
	}
}

// roster is the state of the long-list app: its rows' keys, in order, and
// the next key.
type roster { items []int, next int }

// rosterStep: 0 adds a row with the next key at the end; 1 drops the first
// row, so every other row moves up one.
func rosterStep(s roster, e int) Decision[roster, int] {
	if e == 0 {
		return Enter[roster]{Next: roster{items: s.items.Append(s.next), next: s.next + 1}}
	}
	if len(s.items) == 0 {
		return Enter[roster]{Next: s}
	}
	Enter[roster]{Next: roster{items: s.items[1:], next: s.next}}
}

func rosterTimer(s roster) Option[Timeout[int]] { None }

func rosterWork(s roster) Option[func(send func(e int))] { None }

func rosterExit(s roster) Option[func()] { None }

func rosterMachine(n int) Machine[roster, int, int] {
	let mut items = []int{}
	for k in 0..n {
		items = items.Append(k)
	}
	Machine[roster, int, int]{Initial: roster{items: items, next: n}, Step: rosterStep, After: rosterTimer, Work: rosterWork, Exit: rosterExit}
}

// shownRows is the model of the rows a list writes, by brute force over
// every row: row i is written when its box, grown by Overscan rows on each
// side, overlaps the viewport [off, off+height) (an empty viewport at off
// overlaps the boxes whose inside holds off).
func shownRows(count int, rh float64, off float64, height float64) []int {
	let mut out = []int{}
	for i in 0..count {
		let top = float64(i-Overscan) * rh
		let bottom = float64(i+1+Overscan) * rh
		if bottom > off && top < off+height {
			out = out.Append(i)
		}
	}
	out
}

func rowsFollow(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let sizes = []int{0, 3, 50, 1000}
	let n = sizes[draw(&r, len(sizes))]
	let rh = float64(draw(&r, 40) + 10)
	let view = func(f mut Frame[int], s roster) {
		Pressable(f, "add", 0) {
			Text(f, "+")
		}
		Pressable(f, "drop", 1) {
			Text(f, "-")
		}
		Rows(f, "list", len(s.items), Length(rh), func(i int) Key { ByInt(s.items[i]) }) func(i int) {
			let fl = NewFlag(f, false)
			Toggle(f, fl, "row \(s.items[i])")
		}
	}
	let a = actor.StartMachine(rosterMachine(n), 1, func(o int) {})
	let mut h = NewTestHost(a, view, m, 4) catch {
	case BadPatch:
		return false
	}
	let mut model = StateOf(&h)
	let mut off = 0.0
	let mut height = 0.0
	let mut on = Map[int, bool]{}
	for _ in 0..(steps%24+24)%24+1 {
		let shown = shownRows(len(model.items), rh, off, height)
		let mut act Act = SettleAll
		match draw(&r, 4) {
		case 0:
			off = float64(draw(&r, len(model.items)*int(rh)+1))
			height = float64(draw(&r, 300))
			act = ScrollOn{Label: "list", Offset: Length(off), Height: Length(height)}
		case 1:
			act = TapOn{Label: "add"}
			model = machines.Next(model, rosterStep(model, 0))
		case 2:
			act = TapOn{Label: "drop"}
			model = machines.Next(model, rosterStep(model, 1))
		case _:
			if len(shown) > 0 {
				let k = model.items[shown[draw(&r, len(shown))]]
				act = TapOn{Label: "row \(k)"}
				on[k] = !(on.Get(k) == (Some{Value: true}))
			}
		}
		Play(&h, []Act{act}) catch {
		case _:
			return false
		}
		let now = shownRows(len(model.items), rh, off, height)
		let mut kept = Map[int, bool]{}
		let mut rows = []Shape[int]{}
		for i in now {
			let k = model.items[i]
			let lit = on.Get(k) == (Some{Value: true})
			if lit {
				kept[k] = true
			}
			rows = rows.Append(Shape[int]{Node: ToggleNode{Label: "row \(k)", On: lit}, Kids: []Shape[int]{}})
		}
		on = kept
		let mut first = len(model.items)
		if len(now) > 0 {
			first = now[0]
		}
		let want = Shape[int]{Node: RowsNode{Label: "list", Count: len(model.items), RowHeight: Length(rh), First: first, Offset: Length(off)}, Kids: rows}
		let screen = Screen(&h)
		if StateOf(&h) != model || len(screen) != 3 || !SameShapes(screen[2:], []Shape[int]{want}) {
			return false
		}
		if RowRuns(&h) != len(now) || RowRuns(&h) > int(height/rh)+2+2*Overscan {
			return false
		}
	}
	true
}

// RowsKeeping is Rows that brings row keep into view when keep changed
// since the last pass (GP1b: a list that follows its cursor): the offset
// moves the least that shows the whole row, up to its top or down to its
// bottom, and the node's Offset tells the host to scroll there. A scroll
// of the host's after it stays, as long as keep stays, so a user can
// scroll away from the cursor; a keep outside [0, count) brings nothing.
// While the host has reported no height, the row's top is the offset.
func RowsKeeping[E, F, R](f mut Frame[E], label string, count int, rowHeight Length, keep int, key func(i int) Key, row func(i int) fails F needs R, at CallSite) fails F needs R {
	try rowsKeeping(f, label, count, rowHeight, keep, key, row, at)
}

// Keep is the offset of a list of rows of rowHeight at viewport v that
// shows the whole of row keep, moving the least from v's offset: the
// row's top when it starts above the viewport or the viewport is shorter
// than a row or not reported, its bottom less the height when it ends
// below, and v's offset otherwise. A height under 1 counts as 1.
func Keep(keep int, rowHeight Length, v Viewport) Length {
	let mut h = rowHeight
	if h < 1.0 {
		h = 1.0
	}
	let top = Length(float64(keep)) * h
	let bottom = top + h
	if top < v.Offset || v.Height < h {
		return top
	}
	if bottom > v.Offset+v.Height {
		return bottom - v.Height
	}
	v.Offset
}

func rowsKeeping[E, F, R](f mut Frame[E], label string, count int, rowHeight Length, keep int, key func(i int) Key, row func(i int) fails F needs R, at CallSite) fails F needs R {
	let m = markOf(f)
	let (id, prev) = cellSlot(f, at)
	let mut v = Viewport{Offset: 0, Height: 0}
	let mut follow = -1
	match prev {
	case Some[Cell] as existing:
		match existing.Value {
		case ViewCell as x:
			v = Viewport{Offset: x.Offset, Height: x.Height}
			follow = x.Follow
		case TextCell, FlagCell, PresenceCell:
		}
	case None:
	}
	let where = storeCell(f, id, ViewCell{Offset: v.Offset, Height: v.Height, Follow: follow})
	if keep != follow {
		if keep >= 0 && keep < count {
			v.Offset = Keep(keep, rowHeight, v)
		}
		f.cells[f.ncells-1].cell = ViewCell{Offset: v.Offset, Height: v.Height, Follow: keep}
	}
	let (first, last) = Visible(count, rowHeight, v)
	f.parent = put(f, RowsNode{Label: label, Count: count, RowHeight: rowHeight, First: first, Offset: v.Offset}, None, Some{Value: where}, at)
	let outerEach = f.each
	let outerKey = f.key
	for i in first..last {
		f.each = at
		f.key = key(i)
		f.rowRuns = f.rowRuns + 1
		row(i) catch {
		case err:
			cut(f, m)
			return err
		}
	}
	f.each = outerEach
	f.key = outerKey
	f.parent = m.parent
}

// ranRows is how many row functions of Rows the last pass ran: the work a
// list costs, which grows with the viewport and not with the count.
func ranRows[E](f mut Frame[E]) int { f.rowRuns }
