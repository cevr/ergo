// Fingers (MB4): the touch scroll machine, the reach margin and the
// insets. Std ui owns touch as it owns the mouse: a host feeds a finger's
// touches, moves and lifts and its frames to the machine, and shows the
// offsets it gives, so every host scrolls a finger's drag alike, as every
// host hit-tests alike. The machine is pure: no clock but the times its
// inputs carry, which is why its laws can say what holds at a time t.
// Not here (MOBILE Q3): pinch, pull to refresh, edge back and selection
// handles.

import math

// TouchLook is a platform's touch constants, data and not code: Slop, the
// distance in DIP a finger moves before it drags (below it, a lift is a
// tap); LongPress, how long a still finger holds before it long-presses;
// Friction, the rate per second at which a fling's speed decays (its
// speed after t seconds is v·e^(-Friction·t), so the decay is per time,
// whatever the frames); MinFling, the speed in DIP per second under which
// a lift does not fling and a fling rests; MaxFling, the fastest fling;
// Stretch, how much of a drag past the content's edge the offset follows
// (0 to 1); Return, the rate per second at which an offset past the edge
// returns to it; Rest, the distance from the edge at which it is there.
type TouchLook { Slop float64, LongPress duration, Friction float64, MinFling float64, MaxFling float64, Stretch float64, Return float64, Rest float64 }

// IOSTouch is iOS's: UIScrollView's normal deceleration (0.998 per ms),
// a 10 DIP slop and a half-strength rubber band.
func IOSTouch() TouchLook {
	TouchLook{Slop: 10, LongPress: 500ms, Friction: 2.0, MinFling: 50, MaxFling: 8000, Stretch: 0.5, Return: 12, Rest: 0.5}
}

// AndroidTouch is Android's: ViewConfiguration's 8 DIP slop, 400 ms long
// press, 50 to 8000 DIP per second flings, a faster decay and a stiffer
// edge.
func AndroidTouch() TouchLook {
	TouchLook{Slop: 8, LongPress: 400ms, Friction: 3.0, MinFling: 50, MaxFling: 8000, Stretch: 0.3, Return: 16, Rest: 0.5}
}

// Axis is the direction a drag scrolls.
type Axis = AxisX | AxisY

// AxisX is a horizontal scroll.
type AxisX {}

// AxisY is a vertical scroll.
type AxisY {}

// TouchPhase is where the machine is: Idle → Pressed (a finger down, not
// yet past the slop) → Dragging (past it, locked to one axis) → Flinging
// (lifted while moving) or Settling (lifted past the content's edge) →
// Idle. A finger down during a fling or a return catches it.
type TouchPhase = TouchIdle | TouchPressed | TouchDragging{Axis Axis} | TouchFlinging{Axis Axis, Speed float64} | TouchSettling{Axis Axis}

// TouchIdle is no finger and nothing moving.
type TouchIdle {}

// TouchPressed is a finger down that has not moved past the slop.
type TouchPressed {}

// TouchInput is what a host feeds the machine: a finger's touch, move,
// lift or cancel (the system took it), each with the finger's Id, its
// position in the container's box and the time; or a frame at a time.
type TouchInput = FingerDown{Id int, X float64, Y float64, At duration} | FingerMove{Id int, X float64, Y float64, At duration} | FingerUp{Id int, X float64, Y float64, At duration} | FingerCancel{Id int, At duration} | TouchFrame{At duration}

// TouchSignal is what a finger meant besides a scroll: a tap (a lift
// within the slop, before the long press) or a long press (still for
// LongPress), at the finger's touch.
type TouchSignal = Tapped{X float64, Y float64} | LongPressed{X float64, Y float64}

// Touch is the machine's state for one container: its Phase and its
// offsets X and Y, from 0 to the room the content leaves on each axis
// (past it only while a finger stretches it or it returns). One finger
// owns it from its touch to its lift; another finger's inputs change
// nothing meanwhile.
type Touch {
	Phase  TouchPhase,
	X      float64,
	Y      float64,
	roomX  float64,
	roomY  float64,
	finger int,
	downX  float64,
	downY  float64,
	downAt duration,
	// from is the finger's position on the axis and base the offset when
	// the drag locked, so the offset follows the finger from there.
	from    float64,
	base    float64,
	lastP   float64,
	lastAt  duration,
	speed   float64,
	frameAt duration,
	long    bool,
	caught  bool,
}

// NewTouch is the machine at rest at offset 0 on a content that leaves
// roomX and roomY to scroll (content less viewport; 0: the axis does not
// scroll).
func NewTouch(roomX float64, roomY float64) Touch {
	Touch{Phase: TouchIdle, X: 0, Y: 0, roomX: nonNegative(roomX), roomY: nonNegative(roomY), finger: -1, downX: 0, downY: 0, downAt: duration(int64(0)), from: 0, base: 0, lastP: 0, lastAt: duration(int64(0)), speed: 0, frameAt: duration(int64(0)), long: false, caught: false}
}

// TouchRoom is t over a content whose room changed (a list grew, a window
// resized): the offsets stay, and the next frame of a fling or a return
// works against the new edges.
func TouchRoom(t Touch, roomX float64, roomY float64) Touch {
	let mut n = t
	n.roomX = nonNegative(roomX)
	n.roomY = nonNegative(roomY)
	n
}

// TouchMoving is whether t moves with no finger on it (a fling or a
// return): a host asks for frames while it does.
func TouchMoving(t Touch) bool {
	match t.Phase {
	case TouchFlinging, TouchSettling:
		true
	case TouchIdle, TouchPressed, TouchDragging:
		false
	}
}

func nonNegative(v float64) float64 { if v > 0 { v } else { 0 } }

func touchSeconds(d duration) float64 { float64(int64(d)) / 1000000000.0 }

func touchAbs(v float64) float64 { if v < 0 { -v } else { v } }

func roomOn(t Touch, a Axis) float64 {
	match a {
	case AxisX:
		t.roomX
	case AxisY:
		t.roomY
	}
}

func offsetOn(t Touch, a Axis) float64 {
	match a {
	case AxisX:
		t.X
	case AxisY:
		t.Y
	}
}

func withOffset(t Touch, a Axis, v float64) Touch {
	let mut n = t
	match a {
	case AxisX:
		n.X = v
	case AxisY:
		n.Y = v
	}
	n
}

// edgeOf is the nearest offset of the content to o: o itself inside it.
func edgeOf(o float64, room float64) float64 {
	if o < 0 {
		return 0
	}
	if o > room {
		return room
	}
	o
}

// stretched is the offset a drag to raw shows: raw inside the content,
// and Stretch of the way past its edge.
func stretched(raw float64, room float64, look TouchLook) float64 {
	let e = edgeOf(raw, room)
	e + (raw-e)*look.Stretch
}

// TouchStep is the machine's step: t after the input, and the signal it
// meant, if any.
func TouchStep(t Touch, input TouchInput, look TouchLook) (Touch, Option[TouchSignal]) {
	match input {
	case FingerDown as d:
		match t.Phase {
		case TouchPressed, TouchDragging:
			// Another finger owns the container.
			return (t, None)
		case TouchIdle, TouchFlinging, TouchSettling:
		}
		let mut n = t
		n.caught = TouchMoving(t)
		n.Phase = TouchPressed
		n.finger = d.Id
		n.downX = d.X
		n.downY = d.Y
		n.downAt = d.At
		n.long = false
		n.speed = 0
		(n, None)
	case FingerMove as m:
		if m.Id != t.finger {
			return (t, None)
		}
		match t.Phase {
		case TouchPressed:
			let dx = m.X - t.downX
			let dy = m.Y - t.downY
			if dx*dx+dy*dy <= look.Slop*look.Slop {
				return stillFor(t, m.At, look)
			}
			// Past the slop: the drag locks to the axis this move went
			// further along, and follows the finger from here.
			let axis Axis = if touchAbs(dx) > touchAbs(dy) { AxisX } else { AxisY }
			let p = along(axis, m.X, m.Y)
			let mut n = t
			n.Phase = TouchDragging{Axis: axis}
			n.from = p
			n.base = offsetOn(t, axis)
			n.lastP = p
			n.lastAt = m.At
			n.speed = 0
			(n, None)
		case TouchDragging as g:
			(dragTo(t, g.Axis, m.X, m.Y, m.At, look), None)
		case TouchIdle, TouchFlinging, TouchSettling:
			(t, None)
		}
	case FingerUp as u:
		if u.Id != t.finger {
			return (t, None)
		}
		match t.Phase {
		case TouchPressed:
			let (s, sig) = stillFor(t, u.At, look)
			let mut n = s
			n.finger = -1
			n.Phase = TouchIdle
			match sig {
			case Some[TouchSignal]:
				return (n, sig)
			case None:
			}
			if s.long || t.caught {
				return (n, None)
			}
			(n, Some{Value: Tapped{X: t.downX, Y: t.downY}})
		case TouchDragging as g:
			let moved = dragTo(t, g.Axis, u.X, u.Y, u.At, look)
			// A finger held still before it lifts flings nothing.
			let held = int64(u.At-t.lastAt) > int64(100ms)
			(lifted(moved, g.Axis, if held { 0.0 } else { moved.speed }, u.At, look), None)
		case TouchIdle, TouchFlinging, TouchSettling:
			(t, None)
		}
	case FingerCancel as c:
		if c.Id != t.finger {
			return (t, None)
		}
		match t.Phase {
		case TouchDragging as g:
			// The system took the finger: no fling, a return if past the
			// edge.
			(lifted(t, g.Axis, 0.0, c.At, look), None)
		case TouchPressed:
			let mut n = t
			n.finger = -1
			n.Phase = TouchIdle
			(n, None)
		case TouchIdle, TouchFlinging, TouchSettling:
			(t, None)
		}
	case TouchFrame as fr:
		match t.Phase {
		case TouchPressed:
			stillFor(t, fr.At, look)
		case TouchFlinging as fl:
			(flung(t, fl.Axis, fl.Speed, fr.At, look), None)
		case TouchSettling as st:
			(settled(t, st.Axis, fr.At, look), None)
		case TouchIdle, TouchDragging:
			(t, None)
		}
	}
}

func along(a Axis, x float64, y float64) float64 {
	match a {
	case AxisX:
		x
	case AxisY:
		y
	}
}

// stillFor is a pressed finger still at time at: its long press once it
// held LongPress.
func stillFor(t Touch, at duration, look TouchLook) (Touch, Option[TouchSignal]) {
	if t.long || t.caught || int64(at-t.downAt) < int64(look.LongPress) {
		return (t, None)
	}
	let mut n = t
	n.long = true
	(n, Some{Value: LongPressed{X: t.downX, Y: t.downY}})
}

// dragTo is a dragging finger at x, y at time at: the offset on the
// locked axis follows it (an axis with no room stays), and its speed is
// the last move's.
func dragTo(t Touch, a Axis, x float64, y float64, at duration, look TouchLook) Touch {
	let p = along(a, x, y)
	let room = roomOn(t, a)
	let mut n = t
	if room > 0 {
		n = withOffset(t, a, stretched(t.base-(p-t.from), room, look))
	}
	let dt = touchSeconds(at - t.lastAt)
	if dt > 0 {
		n.speed = -(p - t.lastP) / dt
	}
	n.lastP = p
	n.lastAt = at
	n
}

// lifted is the finger gone at time at with the offset moving at speed:
// a return when past the edge, a fling when fast enough, else rest.
func lifted(t Touch, a Axis, speed float64, at duration, look TouchLook) Touch {
	let mut n = t
	n.finger = -1
	n.frameAt = at
	let o = offsetOn(t, a)
	let room = roomOn(t, a)
	if o != edgeOf(o, room) {
		n.Phase = TouchSettling{Axis: a}
		return n
	}
	if room > 0 && touchAbs(speed) >= look.MinFling {
		let v = if speed > look.MaxFling { look.MaxFling } else if speed < -look.MaxFling { -look.MaxFling } else { speed }
		n.Phase = TouchFlinging{Axis: a, Speed: v}
		return n
	}
	n.Phase = TouchIdle
	n
}

// flung is a fling at time at: its speed decays by e^(-Friction·dt) and
// the offset moves by the speed's integral, so where it is at a time does
// not depend on the frames before it. It rests at an edge it reaches, or
// where its speed falls under MinFling.
func flung(t Touch, a Axis, speed float64, at duration, look TouchLook) Touch {
	let dt = touchSeconds(at - t.frameAt)
	if dt <= 0 {
		return t
	}
	let decay = math.Exp(-look.Friction * dt)
	let room = roomOn(t, a)
	let o = offsetOn(t, a) + speed*(1.0-decay)/look.Friction
	let v = speed * decay
	let mut n = withOffset(t, a, edgeOf(o, room))
	n.frameAt = at
	if o != edgeOf(o, room) || touchAbs(v) < look.MinFling {
		n.Phase = TouchIdle
		return n
	}
	n.Phase = TouchFlinging{Axis: a, Speed: v}
	n
}

// settled is a return at time at: the distance past the edge shrinks by
// e^(-Return·dt), and the offset is at the edge once it is within Rest.
func settled(t Touch, a Axis, at duration, look TouchLook) Touch {
	let dt = touchSeconds(at - t.frameAt)
	if dt <= 0 {
		return t
	}
	let o = offsetOn(t, a)
	let e = edgeOf(o, roomOn(t, a))
	let next = e + (o-e)*math.Exp(-look.Return*dt)
	let mut n = t
	n.frameAt = at
	if touchAbs(next-e) < look.Rest {
		n = withOffset(n, a, e)
		n.Phase = TouchIdle
		return n
	}
	withOffset(n, a, next)
}

// Reachable is a control a finger may hit: its box in the window and
// whether it takes a press.
type Reachable { Box Rect, Enabled bool }

// ReachMargin is MyGo's reach margin for a finger, in DIP.
let ReachMargin = 14.0

// Reach is the control a finger at x, y hits (MB4), as an index of
// targets, which are in paint order (the last on top): the top one whose
// box holds the point, enabled or not (a disabled control under the
// finger takes it, so nothing is pressed); else the enabled one whose box
// is nearest the point, within margin, the top one of those as near; else
// None. A mouse hits only what is under it: a host calls Reach for a
// finger.
func Reach(targets []Reachable, x float64, y float64, margin float64) Option[int] {
	let mut i = len(targets) - 1
	for i >= 0 {
		if reachDistance(targets[i].Box, x, y) == 0 {
			return Some{Value: i}
		}
		i = i - 1
	}
	let mut best = -1
	let mut bestD = 0.0
	for j, r in targets {
		if r.Enabled {
			let d = reachDistance(r.Box, x, y)
			if d <= margin && (best < 0 || d <= bestD) {
				best = j
				bestD = d
			}
		}
	}
	if best < 0 {
		return None
	}
	Some{Value: best}
}

// reachDistance is how far x, y is from the box: 0 inside it or on its
// edge.
func reachDistance(b Rect, x float64, y float64) float64 {
	let l = float64(b.X)
	let t = float64(b.Y)
	let r = l + float64(b.W)
	let btm = t + float64(b.H)
	let dx = if x < l { l - x } else if x > r { x - r } else { 0.0 }
	let dy = if y < t { t - y } else if y > btm { y - btm } else { 0.0 }
	math.Sqrt(dx*dx + dy*dy)
}

// Insets are the parts of a window the system covers (its bars, a
// cutout, the keyboard), in DIP from each edge. A host lays the root out
// inside them (InsetRect), so no content is under them; the window's
// background still fills them.
type Insets { Top Length, Right Length, Bottom Length, Left Length }

// NoInsets is a window the system covers nowhere.
let NoInsets = Insets{Top: 0, Right: 0, Bottom: 0, Left: 0}

// InsetRect is the part of view the insets leave, never less than empty.
func InsetRect(view Rect, ins Insets) Rect {
	let w = float64(view.W) - float64(ins.Left) - float64(ins.Right)
	let h = float64(view.H) - float64(ins.Top) - float64(ins.Bottom)
	Rect{X: view.X + ins.Left, Y: view.Y + ins.Top, W: Length(if w > 0 { w } else { 0.0 }), H: Length(if h > 0 { h } else { 0.0 })}
}
