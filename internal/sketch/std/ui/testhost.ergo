import actor
import queue
import time

// TestHost runs a view over an actor in process, for a test or an agent:
// the host a scene script drives. It steps the same Session that Run
// steps, so what it shows is what a window would show for the same
// events. What it shows is a Mirror built only from the patches; it finds
// nodes by their label, presses and types into them, and settles the
// loads. Time moves only when Advance moves it, and while the view
// animates, Advance sends a Tick at each frame period of the clock's time.
//
// It lays nothing out: a tap names a node, not a point. Hit testing by
// boxes comes with the layout kernel (ui/layout).
type TestHost[S, E, D, F] {
	clock   time.Manual,
	start   time.Time,
	period  duration,
	owed    duration,
	frames  int,
	posted  queue.Queue[Event[E]],
	mirror  Mirror[E],
	session Session[S, E, D, F],
}

// NoNode is the failure of a script step whose label names no node on the
// screen.
type NoNode { Label string }

// NewTestHost shows view of a's state. clock is the time the program's
// tasks sleep on (a test binds it as their Scheduler); only Advance moves
// it. A fetch's result waits in a queue of room results until the host
// takes it.
func NewTestHost[E comparable, S, D, F](a actor.Actor[S, E, D, F], view escaping func(f *Frame[E], s S), clock time.Manual, room int) TestHost[S, E, D, F] fails BadPatch {
	let posted = queue.New[Event[E]](room)
	let (s, first) = Start(a, view, func(ev Event[E]) {
		posted.Push(ev) catch {
		case queue.Closed:
		}
	})
	let mut session = s
	let mut m = NewMirror[E](Root(&session.frame))
	try Apply(&m, first)
	TestHost[S, E, D, F]{clock: clock, start: clock.Now(), period: 16ms, owed: duration(int64(0)), frames: 0, posted: posted, mirror: m, session: session}
}

// apply steps one event and shows its patch.
func apply[E comparable, S, D, F](h *TestHost[S, E, D, F], ev Event[E]) fails actor.Stopped | BadPatch {
	let ops = try Step(&h.session, ev)
	try Apply(&h.mirror, ops)
}

// Tap presses the node id.
func Tap[E comparable, S, D, F](h *TestHost[S, E, D, F], id Id[E]) fails actor.Stopped | BadPatch {
	try apply(h, Press[E]{Id: id})
}

// TypeText types text into the node id.
func TypeText[E comparable, S, D, F](h *TestHost[S, E, D, F], id Id[E], text string) fails actor.Stopped | BadPatch {
	try apply(h, Type[E]{Id: id, Text: text})
}

// Pump takes every result a fetch has posted, without waiting.
func Pump[E comparable, S, D, F](h *TestHost[S, E, D, F]) fails actor.Stopped | BadPatch {
	for {
		match h.posted.Poll() {
		case Some[Event[E]] as ev:
			try apply(h, ev.Value)
		case None:
			return
		}
	}
}

// Settle waits until no fetch is in flight and every posted result is
// taken: the screen then shows the actor's latest state with each live
// load's result (models/uiloop SettledShowsLatest). A fetch that waits on
// the clock waits until an Advance; Settle does not move the clock, so a
// script advances first.
func Settle[E comparable, S, D, F](h *TestHost[S, E, D, F]) fails actor.Stopped | BadPatch {
	for InFlight(&h.session) > 0 {
		let ev = h.posted.Pop() catch {
		case queue.Closed:
			return
		}
		try apply(h, ev)
	}
	try Pump(h)
}

// Advance moves the clock by d. While the view animates, it moves it a
// frame period at a time and steps a Tick at the end of each period, with
// the clock's time since the host started; time short of a period is owed
// to the next Advance while the view still animates. A pass that stops
// animating stops the frames: the rest of d passes with no Tick, and
// nothing is owed. Advance takes no fetch result: a fetch it wakes posts
// on its own task, and Settle or Pump takes it.
func Advance[E comparable, S, D, F](h *TestHost[S, E, D, F], d duration) fails actor.Stopped | BadPatch {
	let mut left = d
	for Animating(&h.session.frame) && left >= h.period-h.owed {
		let due = h.period - h.owed
		h.clock.Advance(due)
		left = left - due
		h.owed = duration(int64(0))
		h.frames = h.frames + 1
		try apply(h, Tick{At: h.clock.Now().Sub(h.start)})
	}
	h.clock.Advance(left)
	if Animating(&h.session.frame) {
		h.owed = h.owed + left
	} else {
		h.owed = duration(int64(0))
	}
}

// FrameEvery sets the frame period of Advance (16ms when made); a period
// under 1ns leaves it as it is.
func FrameEvery[S, E, D, F](h *TestHost[S, E, D, F], period duration) {
	if period >= 1ns {
		h.period = period
	}
}

// WantsFrames is whether the view asks for frames: whether its last pass
// made an Animate (what Run tells a window through Host.Frames).
func WantsFrames[S, E, D, F](h *TestHost[S, E, D, F]) bool { Animating(&h.session.frame) }

// Frames is the number of Ticks the host has sent.
func Frames[S, E, D, F](h *TestHost[S, E, D, F]) int { h.frames }

// PointAt sends a pointer event to the node id (the host's hit test, which
// a test does by naming the node).
func PointAt[E comparable, S, D, F](h *TestHost[S, E, D, F], id Id[E], p PointerEvent) fails actor.Stopped | BadPatch {
	try apply(h, Point[E]{Id: id, Pointer: p})
}

// ScrollTo reports the viewport of the list id: its scroll offset and
// visible height (a host sends this as it scrolls or sizes the list).
func ScrollTo[E comparable, S, D, F](h *TestHost[S, E, D, F], id Id[E], offset Length, height Length) fails actor.Stopped | BadPatch {
	try apply(h, Scrolled[E]{Id: id, Offset: offset, Height: height})
}

// RowRuns is how many row functions of Rows the last pass ran: the work
// a list costs, which grows with its viewport and not with its count.
func RowRuns[S, E, D, F](h *TestHost[S, E, D, F]) int { ranRows(&h.session.frame) }

// PressKey sends a key press.
func PressKey[E comparable, S, D, F](h *TestHost[S, E, D, F], k KeyPress) fails actor.Stopped | BadPatch {
	try apply(h, KeyDown{Press: k})
}

// Now is the clock's time.
func Now[S, E, D, F](h *TestHost[S, E, D, F]) time.Time { h.clock.Now() }

// Screen is what the host shows, built only from the patches.
func Screen[S, E, D, F](h *TestHost[S, E, D, F]) []Shape[E] { MirrorShape(&h.mirror) }

// StateOf is the actor's state.
func StateOf[S, E, D, F](h *TestHost[S, E, D, F]) S { h.session.actor.State() }

// Fetching is the number of fetches in flight.
func Fetching[S, E, D, F](h *TestHost[S, E, D, F]) int { InFlight(&h.session) }

// Find is the first node on the screen, in tree order, whose label is
// label: a Pressable's, a Check's or a Toggle's label, a Text's value, an
// Input's placeholder.
func Find[S, E, D, F](h *TestHost[S, E, D, F], label string) Option[Id[E]] {
	findIn(&h.mirror, h.mirror.root, label)
}

func findIn[E](m *Mirror[E], id Id[E], label string) Option[Id[E]] {
	match m.nodes.Get(id) {
	case Some[mirrored[E]] as n:
		for k in n.Value.kids {
			match m.nodes.Get(k) {
			case Some[mirrored[E]] as c:
				if labelOf(c.Value.node) == (Some{Value: label}) {
					return Some{Value: k}
				}
			case None:
			}
			match findIn[E](m, k, label) {
			case Some[Id[E]] as found:
				return found
			case None:
			}
		}
		None
	case None:
		None
	}
}

// labelOf is the label Find matches, None for a node with none.
func labelOf[E](n Node[E]) Option[string] {
	match n {
	case PressableNode[E] as x:
		Some{Value: x.Label}
	case CheckNode[E] as x:
		Some{Value: x.Label}
	case ToggleNode as x:
		Some{Value: x.Label}
	case AreaNode as x:
		Some{Value: x.Label}
	case CanvasNode as x:
		Some{Value: x.Label}
	case RowsNode as x:
		Some{Value: x.Label}
	case TextNode as x:
		Some{Value: x.Value}
	case InputNode as x:
		Some{Value: x.Placeholder}
	case _:
		None
	}
}

// Locate is the nodes on the screen that loc finds, in tree order (H4r).
func Locate[S, E, D, F](h *TestHost[S, E, D, F], loc Locator) []Id[E] { LocateIn(&h.mirror, loc) }

// AccessAt is the node id names on the screen as a locator reads it.
func AccessAt[S, E, D, F](h *TestHost[S, E, D, F], id Id[E]) Access { AccessOf(&h.mirror, id) }

// Expect checks is against what loc finds on the screen.
func Expect[S, E, D, F](h *TestHost[S, E, D, F], loc Locator, is Matcher) fails Mismatch {
	try ExpectIn(&h.mirror, loc, is)
}

// Act is one step of a scene script: by label (TapOn, TypeInto, PointOn,
// ScrollOn), or by locator (ClickOn and FillIn act on the first node it
// finds; ExpectOn checks a matcher), or on the host.
type Act = TapOn{Label string} | TypeInto{Label string, Text string} | SettleAll | AdvanceBy{By duration} | KeyIn{Press KeyPress} | PointOn{Label string, Pointer PointerEvent} | ScrollOn{Label string, Offset Length, Height Length} | ClickOn{At Locator} | FillIn{At Locator, Text string} | ExpectOn{At Locator, Is Matcher}

// SettleAll settles the loads.
type SettleAll {}

// Play runs a script in order. A step whose label or locator names no
// node fails NoNode with that label or locator, and an ExpectOn that does
// not hold fails Mismatch.
func Play[E comparable, S, D, F](h *TestHost[S, E, D, F], script []Act) fails NoNode | Mismatch | actor.Stopped | BadPatch {
	for act in script {
		match act {
		case TapOn as x:
			try Tap(h, try found(h, x.Label))
		case TypeInto as x:
			try TypeText(h, try found(h, x.Label), x.Text)
		case SettleAll:
			try Settle(h)
		case AdvanceBy as x:
			try Advance(h, x.By)
		case KeyIn as x:
			try PressKey(h, x.Press)
		case PointOn as x:
			try PointAt(h, try found(h, x.Label), x.Pointer)
		case ScrollOn as x:
			try ScrollTo(h, try found(h, x.Label), x.Offset, x.Height)
		case ClickOn as x:
			try Tap(h, try first(h, x.At))
		case FillIn as x:
			try TypeText(h, try first(h, x.At), x.Text)
		case ExpectOn as x:
			try Expect(h, x.At, x.Is)
		}
	}
}

func first[S, E, D, F](h *TestHost[S, E, D, F], loc Locator) Id[E] fails NoNode {
	let ids = Locate(h, loc)
	if len(ids) == 0 {
		return NoNode{Label: locatorText(loc)}
	}
	ids[0]
}

func found[S, E, D, F](h *TestHost[S, E, D, F], label string) Id[E] fails NoNode {
	match Find(h, label) {
	case Some[Id[E]] as id:
		id.Value
	case None:
		NoNode{Label: label}
	}
}

// Screenshot is the screen as text, one node a line, indented by depth:
// what an agent reads. A canvas's paint list follows it, one op a line.
func Screenshot[S, E, D, F](h *TestHost[S, E, D, F]) string {
	let mut out = ""
	for line in shotLines(Screen(h), "") {
		out = out + line + "\n"
	}
	out
}

func shotLines[E](shapes []Shape[E], indent string) []string {
	let mut out = []string{}
	for s in shapes {
		out = out.Append(indent + nodeText(s.Node))
		for l in paintLines(PaintOf(s.Node), indent+"  ") {
			out = out.Append(l)
		}
		for l in shotLines[E](s.Kids, indent+"  ") {
			out = out.Append(l)
		}
	}
	out
}

func nodeText[E](n Node[E]) string {
	match n {
	case BoxNode:
		"box"
	case RowNode:
		"row"
	case ColumnNode:
		"column"
	case ScrollNode:
		"scroll"
	case AreaNode as x:
		"area \"\(x.Label)\""
	case CanvasNode as x:
		"canvas \"\(x.Label)\" \(x.Width)x\(x.Height)"
	case RowsNode as x:
		"rows \"\(x.Label)\" \(x.Count) of \(x.RowHeight) from \(x.First)"
	case TextNode as x:
		"text \"\(x.Value)\""
	case PressableNode[E] as x:
		"button \"\(x.Label)\""
	case CheckNode[E] as x:
		if x.Checked {
			return "[x] \"\(x.Label)\""
		}
		"[ ] \"\(x.Label)\""
	case ToggleNode as x:
		if x.On {
			return "(on) \"\(x.Label)\""
		}
		"(off) \"\(x.Label)\""
	case InputNode as x:
		"input \"\(x.Value)\" (\(x.Placeholder))"
	case FieldsetNode as x:
		let mut out = "fieldset"
		if x.Disabled {
			out = out + " disabled"
		}
		if x.Description != "" {
			out = out + " \"\(x.Description)\""
		}
		out
	}
}
