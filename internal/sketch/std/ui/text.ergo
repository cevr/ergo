import sync
import utf8

// Text layout (H5d): multi-line text broken into lines at a width, the
// caret and selection geometry of offsets in it, and the offset under a
// point, all through a Measure the host gives (the desktop host's text
// engine, or Monospace in a test or a cell grid). Offsets are byte offsets
// of the text at rune boundaries. An editor program keeps its own buffer,
// caret and undo in its machine state and asks these functions where
// things are; ui keeps no editing state (v1-gui kept undo and rich text
// out of Input, and they stay out).

// Font names a face and a size; the host's Measure maps it to its own.
type Font { Family string, Size Length }

// Measure is the host's text measurement.
type Measure {
	// Width is the advance of text set in font on one line.
	Width(text string, font Font) Length,
	// LineHeight is the distance between two lines of font.
	LineHeight(font Font) Length,

	// EmptyIsZero: no text takes no room.
	law EmptyIsZero(font Font) {
		Width("", font) == 0.0
	},
	// WidthGrows: text and more text is never narrower than the text,
	// which line breaking needs (a longer line never fits where a shorter
	// one did not).
	law WidthGrows(a string, b string, font Font) {
		Width(a+b, font) >= Width(a, font)
	},
}

// Monospace measures every rune as Advance wide and every line as Line
// high: a cell grid's measure, and the test host's.
type Monospace { Advance Length, Line Length } implements Measure

// Width is the runes of text times m.Advance (a negative Advance counts as
// 0).
func Width(m Monospace, text string, font Font) Length {
	if m.Advance < 0.0 {
		return 0.0
	}
	Length(float64(utf8.RuneCount(text))) * m.Advance
}

// LineHeight is m.Line.
func LineHeight(m Monospace, font Font) Length { m.Line }

// Line is one line of a layout: the bytes [Start, End) of the text, and
// how wide they are without their trailing spaces. Wrapped is whether the
// line ends at a soft break (the next line starts at End); else it ends
// at a newline (the next line starts at End + 1) or at the end of the
// text.
type Line { Start int, End int, Width Length, Wrapped bool }

// TextLayout is a text broken into lines at a width.
type TextLayout { Text string, Font Font, MaxWidth Length, LineHeight Length, Lines []Line }

// Caret is where the caret at an offset is drawn: X on the line whose top
// is Top, Height high.
type Caret { X Length, Top Length, Height Length }

// Rect is a box at X, Y of W by H.
type Rect { X Length, Y Length, W Length, H Length }

// LayerStaysInViewAndTouches (UG4): over drawn views, anchors in them,
// layer sizes no larger than the view, sides, alignments and gaps,
// PlaceLayer's box has the layer's size and lies in the view; when its
// side has room it touches the anchor's edge on that side, a gap away,
// and else, when the other side has room, the anchor's other edge; along
// the side it is at its alignment's place when that place is in the
// view. With no anchor it is centred in the view.
law LayerStaysInViewAndTouches(seed int) {
	let mut r = seeded(seed)
	let view = Rect{X: dip(draw(&r, 50)), Y: dip(draw(&r, 50)), W: dip(draw(&r, 500) + 100), H: dip(draw(&r, 500) + 100)}
	let aw = dip(draw(&r, whole(view.W)) + 1)
	let ah = dip(draw(&r, whole(view.H)) + 1)
	let a = Rect{X: view.X + dip(draw(&r, whole(view.W-aw)+1)), Y: view.Y + dip(draw(&r, whole(view.H-ah)+1)), W: aw, H: ah}
	let w = dip(draw(&r, whole(view.W)) + 1)
	let h = dip(draw(&r, whole(view.H)) + 1)
	let side = draw(&r, 4)
	let align = draw(&r, 4)
	let p = Place{Side: sideOf(side), Align: alignOf(align), Gap: dip(draw(&r, 9))}
	let b = PlaceLayer(Some{Value: a}, w, h, view, p)
	if b.W != w || b.H != h || b.X < view.X || b.Y < view.Y || b.X+b.W > view.X+view.W || b.Y+b.H > view.Y+view.H {
		return false
	}
	let vertical = side < 2
	// The main axis.
	let (lo, hi, at, span, size, got) = if vertical { (view.Y, view.Y + view.H, a.Y, a.H, h, b.Y) } else { (view.X, view.X + view.W, a.X, a.W, w, b.X) }
	let before = side == 0 || side == 2
	let beforeAt = at - p.Gap - size
	let afterAt = at + span + p.Gap
	let roomBefore = beforeAt >= lo
	let roomAfter = afterAt+size <= hi
	let (mine, other, mineAt, otherAt) = if before { (roomBefore, roomAfter, beforeAt, afterAt) } else { (roomAfter, roomBefore, afterAt, beforeAt) }
	if mine && got != mineAt {
		return false
	}
	if !mine && other && got != otherAt {
		return false
	}
	// The cross axis.
	let (clo, chi, cat, cspan, csize, cgot) = if vertical { (view.X, view.X + view.W, a.X, a.W, w, b.X) } else { (view.Y, view.Y + view.H, a.Y, a.H, h, b.Y) }
	let want = if align == 1 { cat + (cspan-csize)/2 } else if align == 2 { cat + cspan - csize } else { cat }
	if want >= clo && want+csize <= chi && cgot != want {
		return false
	}
	let c = PlaceLayer(None, w, h, view, p)
	c.X == view.X+(view.W-w)/2 && c.Y == view.Y+(view.H-h)/2 && c.W == w && c.H == h
}

// dip is n DIPs. (a law's helper)
func dip(n int) Length { Length(float64(n)) }

// whole is l's whole DIPs. (a law's helper)
func whole(l Length) int { int(float64(l)) }

// sideOf is side k of four. (a law's helper)
func sideOf(k int) Side {
	if k == 0 { SideTop } else if k == 1 { SideBottom } else if k == 2 { SideLeft } else { SideRight }
}

// alignOf is alignment k of four. (a law's helper)
func alignOf(k int) Align {
	if k == 0 { AlignStart } else if k == 1 { AlignCenter } else if k == 2 { AlignEnd } else { AlignStretch }
}

// LayoutText breaks text into lines no wider than width: at each newline,
// and else after the last run of spaces that keeps the line within width
// (the spaces stay at the end of the line and take no width). A word wider
// than width alone on a line breaks between runes, with at least one rune
// on each line.
func LayoutText(m Measure, text string, font Font, width Length) TextLayout {
	let mut lines = []Line{}
	let mut start = 0
	for {
		let end = paragraphEnd(text, start)
		for l in breakParagraph(m, text, font, width, start, end) {
			lines = lines.Append(l)
		}
		if end >= len(text) {
			break
		}
		start = end + 1
	}
	TextLayout{Text: text, Font: font, MaxWidth: width, LineHeight: m.LineHeight(font), Lines: lines}
}

// LinesCoverText: the lines of a layout cover the text in order, each
// next line starting where a wrapped one ends or after the newline that
// ends the other; no line holds a newline; a line is as wide as its text
// without trailing spaces and no wider than the width unless that text is
// one rune; and a wrapped line is greedy: the next place it could have
// ended overflows the width.
law LinesCoverText(seed int) {
	let c = drawText(seed)
	let l = LayoutText(c.m, c.text, mono, c.width)
	if len(l.Lines) == 0 {
		return false
	}
	let mut at = 0
	for i, ln in l.Lines {
		if ln.Start != at || ln.End < ln.Start || ln.End > len(c.text) {
			return false
		}
		for j in ln.Start..ln.End {
			if c.text[j] == '\n' {
				return false
			}
		}
		let shown = trimmed(c.text[ln.Start:ln.End])
		if ln.Width != c.m.Width(shown, mono) || ln.Width > c.width && utf8.RuneCount(shown) > 1 {
			return false
		}
		if ln.Wrapped {
			if ln.End == ln.Start || !overflows(c.m, c.text, ln, c.width) {
				return false
			}
			at = ln.End
		} else if i < len(l.Lines)-1 {
			if ln.End >= len(c.text) || c.text[ln.End] != '\n' {
				return false
			}
			at = ln.End + 1
		} else if ln.End != len(c.text) {
			return false
		}
	}
	true
}

// pieces are what a drawn text is made of.
let pieces = []string{"a", "bb", "ccc", "dddddddddddd", " ", "  ", "\n", "é", "日本", "x y"}

// textCase is a drawn layout problem.
type textCase { m Monospace, text string, width Length }

func drawText(seed int) textCase {
	let mut r = seeded(seed)
	let m = Monospace{Advance: Length(float64(draw(&r, 3) + 1)), Line: Length(float64(draw(&r, 3) + 2))}
	let mut text = ""
	for _ in 0..draw(&r, 14) {
		text = text + pieces[draw(&r, len(pieces))]
	}
	textCase{m: m, text: text, width: Length(float64(draw(&r, 24)))}
}

let mono = Font{Family: "mono", Size: 12.0}

// trimmed is s without trailing spaces.
func trimmed(s string) string {
	let mut e = len(s)
	for e > 0 && s[e-1] == ' ' {
		e = e - 1
	}
	s[:e]
}

// sizeAt is the size in bytes of the rune at offset at of s.
func sizeAt(s string, at int) int { utf8.RuneLen(utf8.DecodeRuneInString(s[at:]).Rune) }

// newlineAt is the offset of the first newline of s at or after from, or
// len(s).
func newlineAt(s string, from int) int {
	let mut i = from
	for i < len(s) && s[i] != '\n' {
		i = i + 1
	}
	i
}

// overflows is whether the wrapped line ln could not have held more: the
// next place it could end (the next break after a run of spaces, or the
// next rune of a word it broke) makes it wider than width.
func overflows(m Monospace, text string, ln Line, width Length) bool {
	if text[ln.End-1] == ' ' {
		let pe = newlineAt(text, ln.End)
		let mut k = ln.End + 1
		for k < pe && !(text[k-1] == ' ' && text[k] != ' ') {
			k = k + 1
		}
		return m.Width(trimmed(text[ln.Start:k]), mono) > width
	}
	m.Width(text[ln.Start:ln.End+sizeAt(text, ln.End)], mono) > width
}

// HitFindsTheCaret: for every rune boundary of the text, the offset under
// the middle of its caret is that boundary; and the boxes of a drawn
// selection hold the middle of each rune's box exactly when the rune is
// selected (newlines have no box).
law HitFindsTheCaret(seed int, a int, b int) {
	let c = drawText(seed)
	let l = LayoutText(c.m, c.text, mono, c.width)
	let bounds = boundaryList(c.text)
	for o in bounds {
		let k = CaretAt(c.m, l, o)
		if OffsetAt(c.m, l, k.X, k.Top+k.Height/2.0) != o {
			return false
		}
	}
	let from = bounds[(a%len(bounds)+len(bounds))%len(bounds)]
	let to = bounds[(b%len(bounds)+len(bounds))%len(bounds)]
	let rects = SelectionRects(c.m, l, from, to)
	for o in bounds {
		if o < len(c.text) && c.text[o] != '\n' {
			let k = CaretAt(c.m, l, o)
			let x = k.X + c.m.Width(c.text[o:o+sizeAt(c.text, o)], mono)/2.0
			let y = k.Top + k.Height/2.0
			let mut inside = false
			for r in rects {
				if x >= r.X && x < r.X+r.W && y >= r.Y && y < r.Y+r.H {
					inside = true
				}
			}
			let want = from <= o && o < to || to <= o && o < from
			if inside != want {
				return false
			}
		}
	}
	true
}

// boundaryList is every rune boundary of s, 0 and len(s) included.
func boundaryList(s string) []int {
	let mut out = []int{0}
	let mut o = 0
	for o < len(s) {
		o = o + sizeAt(s, o)
		out = out.Append(o)
	}
	out
}

// paragraphEnd is the offset of the first newline at or after start, or
// the text's length.
func paragraphEnd(text string, start int) int {
	let mut i = start
	for i < len(text) && text[i] != '\n' {
		i = i + 1
	}
	i
}

// breakParagraph breaks the bytes [start, end), which hold no newline.
func breakParagraph(m Measure, text string, font Font, width Length, start int, end int) []Line {
	let mut out = []Line{}
	let mut pos = start
	for {
		let mut fit = -1
		for b in breaks(text, pos, end) {
			if m.Width(trimSpaces(text[pos:b]), font) > width {
				break
			}
			fit = b
		}
		if fit < 0 {
			fit = runeFit(m, text, font, width, pos, end)
		}
		out = out.Append(Line{Start: pos, End: fit, Width: m.Width(trimSpaces(text[pos:fit]), font), Wrapped: fit < end})
		if fit >= end {
			return out
		}
		pos = fit
	}
	out
}

// breaks are the offsets in (pos, end] where a line may end: after each
// run of spaces, and end.
func breaks(text string, pos int, end int) []int {
	let mut out = []int{}
	for i in pos+1..end {
		if text[i-1] == ' ' && text[i] != ' ' {
			out = out.Append(i)
		}
	}
	out.Append(end)
}

// runeFit is the longest run of whole runes from pos that fits in width,
// at least one rune.
func runeFit(m Measure, text string, font Font, width Length, pos int, end int) int {
	if pos >= end {
		return end
	}
	let mut fit = pos + runeSize(text, pos)
	let mut next = fit
	for next < end {
		next = next + runeSize(text, next)
		if m.Width(text[pos:next], font) > width {
			break
		}
		fit = next
	}
	fit
}

func runeSize(text string, at int) int {
	let d = utf8.DecodeRuneInString(text[at:])
	if d.Size < 1 {
		return 1
	}
	d.Size
}

// trimSpaces is s without its trailing spaces.
func trimSpaces(s string) string {
	let mut e = len(s)
	for e > 0 && s[e-1] == ' ' {
		e = e - 1
	}
	s[:e]
}

// lineOf is the line the caret at offset is on: the line holding it, where
// the end of a wrapped line is the start of the next.
func lineOf(l TextLayout, offset int) int {
	for i, ln in l.Lines {
		if offset >= ln.Start && (offset < ln.End || offset == ln.End && !ln.Wrapped) {
			return i
		}
	}
	len(l.Lines) - 1
}

// CaretAt is where the caret at offset is drawn. An offset outside the
// text is taken as its nearest end.
func CaretAt(m Measure, l TextLayout, offset int) Caret {
	let mut o = offset
	if o < 0 {
		o = 0
	}
	if o > len(l.Text) {
		o = len(l.Text)
	}
	let i = lineOf(l, o)
	let ln = l.Lines[i]
	Caret{X: m.Width(l.Text[ln.Start:o], l.Font), Top: Length(float64(i)) * l.LineHeight, Height: l.LineHeight}
}

// OffsetAt is the offset whose caret is nearest the point x, y: on the
// line under y (the first or the last line past the text's edges), the
// rune boundary whose caret is nearest x, the earlier on a tie.
func OffsetAt(m Measure, l TextLayout, x Length, y Length) int {
	let mut i = 0
	if l.LineHeight > 0.0 && y > 0.0 {
		i = int(float64(y / l.LineHeight))
	}
	if i >= len(l.Lines) {
		i = len(l.Lines) - 1
	}
	let ln = l.Lines[i]
	let mut best = ln.Start
	let mut gap = distance(m.Width("", l.Font), x)
	let mut o = ln.Start
	for o < ln.End {
		o = o + runeSize(l.Text, o)
		if o == ln.End && ln.Wrapped {
			break
		}
		let d = distance(m.Width(l.Text[ln.Start:o], l.Font), x)
		if d < gap {
			best = o
			gap = d
		}
	}
	best
}

func distance(a Length, b Length) Length {
	if a > b {
		return a - b
	}
	b - a
}

// SelectionRects are the boxes that show the selection of the bytes
// [from, to) (either order): one per line it holds runes of, from the
// caret of its first rune to the end of its last.
func SelectionRects(m Measure, l TextLayout, from int, to int) []Rect {
	let mut a = from
	let mut b = to
	if a > b {
		a = to
		b = from
	}
	let mut out = []Rect{}
	for i, ln in l.Lines {
		let mut s = ln.Start
		if a > s {
			s = a
		}
		let mut e = ln.End
		if b < e {
			e = b
		}
		if s < e {
			let x = m.Width(l.Text[ln.Start:s], l.Font)
			let w = m.Width(l.Text[ln.Start:e], l.Font) - x
			out = out.Append(Rect{X: x, Y: Length(float64(i)) * l.LineHeight, W: w, H: l.LineHeight})
		}
	}
	out
}

// Clipboard is the system clipboard's text: a capability an editor's
// cut, copy and paste need, which cmd/<name>/main.ergo binds (the desktop
// host's, or MemoryClipboard in a test).
type Clipboard {
	// Read is the text on the clipboard.
	Read() string,
	// Write puts text on the clipboard.
	Write(text string),

	// WriteThenRead: what was written last is what is read.
	law WriteThenRead(text string) {
		Write(text)
		Read() == text
	},
}

// MemoryClipboard is a Clipboard in memory; its copies share one text.
type MemoryClipboard { text sync.Ref[string] } implements Clipboard

// NewMemoryClipboard is an empty MemoryClipboard.
func NewMemoryClipboard() MemoryClipboard { MemoryClipboard{text: sync.NewRef("")} }

// Read is the text written last.
func Read(c MemoryClipboard) string { c.text.Get() }

// Write replaces the text.
func Write(c MemoryClipboard, text string) { c.text.Set(text) }

// Hints are what a text field tells a phone's keyboard (MB5): which keys
// it shows, what its return key says, what it capitalises and whether it
// corrects words. A desktop shows its keyboard whatever they say; a
// password field's text is not read back by the keyboard's suggestions.
type Hints { Keyboard Keyboard, Return ReturnKey, Capitalize Capitalize, Autocorrect bool }

// PlainHints are a field's hints when it states none: text keys, a return
// key that says Done, sentences capitalised, words corrected.
let PlainHints = Hints{Keyboard: TextKeys, Return: ReturnDone, Capitalize: CapSentences, Autocorrect: true}

// Keyboard is the keys a field asks for, as HTML's inputmode and input
// types name them.
type Keyboard = TextKeys | EmailKeys | NumberKeys | PhoneKeys | URLKeys | PasswordKeys

// TextKeys are a keyboard's letters.
type TextKeys {}

// EmailKeys are letters with @ and . at hand.
type EmailKeys {}

// NumberKeys are digits, a decimal point and a sign.
type NumberKeys {}

// PhoneKeys are a phone's dial pad.
type PhoneKeys {}

// URLKeys are letters with / and . at hand.
type URLKeys {}

// PasswordKeys are letters with no suggestions and the text hidden.
type PasswordKeys {}

// ReturnKey is what a field's return key says, as HTML's enterkeyhint
// names it.
type ReturnKey = ReturnDone | ReturnNext | ReturnSearch | ReturnSend

// ReturnDone ends the editing.
type ReturnDone {}

// ReturnNext goes to the next field.
type ReturnNext {}

// ReturnSearch searches for the text.
type ReturnSearch {}

// ReturnSend sends the text.
type ReturnSend {}

// Capitalize is what the keyboard capitalises, as HTML's autocapitalize
// names it.
type Capitalize = CapNone | CapWords | CapSentences | CapAll

// CapNone capitalises nothing.
type CapNone {}

// CapWords capitalises each word's first letter.
type CapWords {}

// CapSentences capitalises each sentence's first letter.
type CapSentences {}

// CapAll capitalises every letter.
type CapAll {}

// KeyboardName is k as HTML's inputmode or input type names it: "text",
// "email", "numeric", "tel", "url" or "password". A host hands it to
// the platform's text input.
func KeyboardName(k Keyboard) string {
	match k {
	case TextKeys:
		"text"
	case EmailKeys:
		"email"
	case NumberKeys:
		"numeric"
	case PhoneKeys:
		"tel"
	case URLKeys:
		"url"
	case PasswordKeys:
		"password"
	}
}
