// The laws of the composer, at int signals (a top-level law is not
// generic). Each draws a view program and states from a seed: a program
// is a tree of primitives whose texts, keys and signals read the state,
// so a run of states grows, shrinks, reorders and edits the tree. model
// is the shape a program means, written without a Frame, so a law checks
// what a frame records as well as what a commit makes of it.

// prog is a generated view. pSwap writes a Text or a Check at one
// forwarded call site, as a helper with a CallSite parameter can. pBound
// is a group with a catch right after it (a Boundary, a Box or an Each,
// by form), whose arms write a Text for Pending, and for Missing a Text
// only when its value is even (so a group may leave nothing); pRead,
// drawn only under a pBound, is a read that fails with Pending or Missing by
// the state (H8a), so a failure leaves nested containers, Each rows and
// inner boundaries.
type prog = pText{slot int} | pInput{slot int} | pCheck{slot int} | pSwap{slot int} | pBox{slot int, kids []prog} | pRow{kids []prog} | pPress{slot int, kids []prog} | pEach{slot int, kids []prog} | pBound{form int, slot int, kids []prog} | pRead{slot int} | pFieldset{slot int, kids []prog}

// Missing is the drawn read's failure that is not Pending.
type Missing { V int }

// rng is the laws' generator (a linear congruence).
type rng { x int }

func draw(r *rng, n int) int {
	r.x = (r.x*1103515245 + 12345) % 2147483648
	(r.x / 65536) % n
}

func seeded(seed int) rng { rng{x: (seed%2147483648 + 2147483648) % 2147483648} }

let slots = 6

func genProg(r *rng, depth int, bounded bool) prog {
	let kind = draw(r, 11)
	if kind == 9 && bounded {
		return pRead{slot: draw(r, slots)}
	}
	if depth == 0 || kind < 4 {
		match kind % 4 {
		case 0:
			pText{slot: draw(r, slots)}
		case 1:
			pInput{slot: draw(r, slots)}
		case 2:
			pCheck{slot: draw(r, slots)}
		case _:
			pSwap{slot: draw(r, slots)}
		}
	} else {
		let inner = bounded || kind == 8 || kind == 9
		let mut kids = []prog{}
		for _ in 0..draw(r, 4) {
			kids = kids.Append(genProg(r, depth-1, inner))
		}
		match kind {
		case 4:
			pBox{slot: draw(r, slots), kids: kids}
		case 5:
			pRow{kids: kids}
		case 6:
			pPress{slot: draw(r, slots), kids: kids}
		case 7:
			pEach{slot: draw(r, slots), kids: kids}
		case 10:
			pFieldset{slot: draw(r, slots), kids: kids}
		case _:
			pBound{form: draw(r, 3), slot: draw(r, slots), kids: kids.Append(pRead{slot: draw(r, slots)})}
		}
	}
}

func genState(r *rng) []int {
	let mut s = []int{}
	for _ in 0..slots {
		s = s.Append(draw(r, 64))
	}
	s
}

// items are the keys an Each shows for state value v: 0 to 5 turned by v,
// some left out, so a change of v moves, adds and removes rows.
func items(v int) []int {
	let mut out = []int{}
	for i in 0..6 {
		let k = (i + v) % 6
		if (k+v/6)%3 != 0 {
			out = out.Append(k)
		}
	}
	out
}

func gapped(v int) Style {
	let mut st = Plain()
	st.Gap = Length(float64(v % 3))
	st
}

// described is the description of a pFieldset at state value v: a text
// for an even v, none for an odd one.
func described(v int) string {
	if v%2 == 0 {
		return "d\(v)"
	}
	""
}

// swap writes a Text or a Check at its caller's site.
func swap(f *Frame[int], v int, at CallSite) {
	if v%2 == 0 {
		Text(f, "even \(v)", at)
	} else {
		Check(f, "odd", v%3 == 0, v, at)
	}
}

func render(f *Frame[int], p prog, s []int, row int) fails Missing | Pending {
	match p {
	case pText as x:
		Text(f, "t\(s[x.slot] + row)")
	case pInput as x:
		let v = s[x.slot] + row
		Input(f, "v\(v)", "type", func(t string) int { len(t) + v })
	case pCheck as x:
		Check(f, "c", s[x.slot]%2 == 0, s[x.slot]+row)
	case pSwap as x:
		swap(f, s[x.slot]+row)
	case pBox as x:
		try Box(f, gapped(s[x.slot])) {
			for c in x.kids {
				try render(f, c, s, row)
			}
		}
	case pRow as x:
		try Row(f, Plain()) {
			for c in x.kids {
				try render(f, c, s, row)
			}
		}
		Text(f, "after")
	case pPress as x:
		try Pressable(f, "press", s[x.slot]%4+row) {
			for c in x.kids {
				try render(f, c, s, row)
			}
		}
	case pFieldset as x:
		try Fieldset(f, s[x.slot]%3 == 0, described(s[x.slot])) {
			for c in x.kids {
				try render(f, c, s, row)
			}
		}
	case pEach as x:
		try Each(f, items(s[x.slot]), func(k int) Key { ByInt(k) }) func(k int) fails Missing | Pending {
			for c in x.kids {
				try render(f, c, s, k)
			}
		}
		Text(f, "after")
	case pBound as x:
		if x.form == 0 {
			Boundary(f) {
				for c in x.kids {
					try render(f, c, s, row)
				}
			} catch {
			case Pending:
				Text(f, "pending")
			case Missing as e:
				if e.V%2 == 0 {
					Text(f, "missing \(e.V)")
				}
			}
		} else if x.form == 1 {
			Box(f, Plain()) {
				for c in x.kids {
					try render(f, c, s, row)
				}
			} catch {
			case Pending:
				Text(f, "pending")
			case Missing as e:
				if e.V%2 == 0 {
					Text(f, "missing \(e.V)")
				}
			}
		} else {
			Each(f, items(s[x.slot]), func(k int) Key { ByInt(k) }) func(k int) fails Missing | Pending {
				for c in x.kids {
					try render(f, c, s, k)
				}
			} catch {
			case Pending:
				Text(f, "pending")
			case Missing as e:
				if e.V%2 == 0 {
					Text(f, "missing \(e.V)")
				}
			}
		}
	case pRead as x:
		let v = s[x.slot] + row
		if v%3 == 1 {
			return Pending
		}
		if v%3 == 2 {
			return Missing{V: v}
		}
	}
}

// outcome is what a program means at a state: its shapes, or the failure
// that leaves it (0 none, 1 Pending, 2 Missing with value v).
type outcome { shapes []Shape[int], fail int, v int }

func done(shapes []Shape[int]) outcome { outcome{shapes: shapes, fail: 0, v: 0} }

// model is what p means at state s: a failure in a container's body or an
// Each row leaves the whole container or Each, and a pBound shows its
// arm's Text in place of a body that failed.
func model(p prog, s []int, row int) outcome {
	match p {
	case pText as x:
		done([]Shape[int]{leaf(TextNode{Value: "t\(s[x.slot] + row)", Style: Plain()})})
	case pInput as x:
		done([]Shape[int]{leaf(InputNode{Value: "v\(s[x.slot] + row)", Placeholder: "type"})})
	case pCheck as x:
		done([]Shape[int]{leaf(CheckNode{Label: "c", Checked: s[x.slot]%2 == 0, On: s[x.slot] + row})})
	case pSwap as x:
		let v = s[x.slot] + row
		if v%2 == 0 {
			return done([]Shape[int]{leaf(TextNode{Value: "even \(v)", Style: Plain()})})
		}
		done([]Shape[int]{leaf(CheckNode{Label: "odd", Checked: v%3 == 0, On: v})})
	case pBox as x:
		let o = outcomes(x.kids, s, row)
		if o.fail != 0 {
			return o
		}
		done([]Shape[int]{Shape[int]{Node: BoxNode{Style: gapped(s[x.slot])}, Kids: o.shapes}})
	case pRow as x:
		let o = outcomes(x.kids, s, row)
		if o.fail != 0 {
			return o
		}
		done([]Shape[int]{Shape[int]{Node: RowNode{Style: Plain()}, Kids: o.shapes}, leaf(TextNode{Value: "after", Style: Plain()})})
	case pPress as x:
		let o = outcomes(x.kids, s, row)
		if o.fail != 0 {
			return o
		}
		done([]Shape[int]{Shape[int]{Node: PressableNode{Label: "press", On: s[x.slot]%4 + row, Style: Plain()}, Kids: o.shapes}})
	case pFieldset as x:
		let o = outcomes(x.kids, s, row)
		if o.fail != 0 {
			return o
		}
		done([]Shape[int]{Shape[int]{Node: FieldsetNode{Disabled: s[x.slot]%3 == 0, Description: described(s[x.slot])}, Kids: o.shapes}})
	case pEach as x:
		let mut out = []Shape[int]{}
		for k in items(s[x.slot]) {
			let o = outcomes(x.kids, s, k)
			if o.fail != 0 {
				return o
			}
			for c in o.shapes {
				out = out.Append(c)
			}
		}
		done(out.Append(leaf(TextNode{Value: "after", Style: Plain()})))
	case pBound as x:
		let mut out = []Shape[int]{}
		for k in boundRows(x, s, row) {
			let o = outcomes(x.kids, s, k)
			if o.fail == 1 {
				return done([]Shape[int]{leaf(TextNode{Value: "pending", Style: Plain()})})
			}
			if o.fail == 2 && o.v%2 == 0 {
				return done([]Shape[int]{leaf(TextNode{Value: "missing \(o.v)", Style: Plain()})})
			}
			if o.fail == 2 {
				return done([]Shape[int]{})
			}
			for c in o.shapes {
				out = out.Append(c)
			}
		}
		if x.form == 1 {
			return done([]Shape[int]{Shape[int]{Node: BoxNode{Style: Plain()}, Kids: out}})
		}
		done(out)
	case pRead as x:
		let v = s[x.slot] + row
		if v%3 == 0 {
			return done([]Shape[int]{})
		}
		outcome{shapes: []Shape[int]{}, fail: v % 3, v: v}
	}
}

func outcomes(ps []prog, s []int, row int) outcome {
	let mut out = []Shape[int]{}
	for p in ps {
		let o = model(p, s, row)
		if o.fail != 0 {
			return o
		}
		for x in o.shapes {
			out = out.Append(x)
		}
	}
	done(out)
}

// models is what the top programs mean: a failure never leaves them, as
// a read is drawn only under a pBound.
func models(ps []prog, s []int, row int) []Shape[int] { outcomes(ps, s, row).shapes }

// stops is whether some pBound of ps fails at s: then the frame may park
// what it held; otherwise it holds only the tree.
func stopsAt(ps []prog, s []int, row int) bool {
	for p in ps {
		if stopIn(p, s, row) {
			return true
		}
	}
	false
}

func stopIn(p prog, s []int, row int) bool {
	match p {
	case pBox as x:
		stopsAt(x.kids, s, row)
	case pRow as x:
		stopsAt(x.kids, s, row)
	case pPress as x:
		stopsAt(x.kids, s, row)
	case pFieldset as x:
		stopsAt(x.kids, s, row)
	case pEach as x:
		for k in items(s[x.slot]) {
			if stopsAt(x.kids, s, k) {
				return true
			}
		}
		false
	case pBound as x:
		for k in boundRows(x, s, row) {
			if outcomes(x.kids, s, k).fail != 0 || stopsAt(x.kids, s, k) {
				return true
			}
		}
		false
	case _:
		false
	}
}

// boundRows is the rows a pBound runs its kids in: the Each's items for
// form 2, and the enclosing row otherwise.
func boundRows(x pBound, s []int, row int) []int {
	if x.form == 2 {
		return items(s[x.slot])
	}
	[]int{row}
}

func leaf(n Node[int]) Shape[int] { Shape[int]{Node: n, Kids: []Shape[int]{}} }

// pass renders the programs ps at state s as one pass of f.
func pass(f *Frame[int], ps []prog, s []int) []Op[int] {
	Render(f, func(g *Frame[int], st []int) {
		for p in ps {
			render(g, p, st, 0) catch {
			case Missing:
				Unreachable("ui laws: a read is drawn only under a boundary")
			case Pending:
				Unreachable("ui laws: a read is drawn only under a boundary")
			}
		}
	}, s)
}

func genRoot(r *rng) []prog {
	let mut ps = []prog{}
	for _ in 0..draw(r, 4)+1 {
		ps = ps.Append(genProg(r, 3, false))
	}
	ps
}

func nodes(shapes []Shape[int]) int {
	let mut n = 0
	for x in shapes {
		n = n + 1 + nodes(x.Kids)
	}
	n
}

// IncrementalEqualsFresh: committing the frames of a run of states in
// order leaves the tree, and the mirror built from the patches, showing
// what the program means at the last state, as a fresh commit of that
// frame shows it. The tree holds no node more than the frame wrote, and
// after a pass in which no boundary stopped, the frame holds no parked
// node either. The programs hold boundaries whose reads fail by the
// state, inside containers, Each rows and other boundaries (H8a).
law IncrementalEqualsFresh(seed int, steps int) {
	let mut r = seeded(seed)
	let ps = genRoot(&r)
	let mut f = NewFrame[int]()
	let mut m = NewMirror[int](Root(&f))
	for _ in 0..(steps%8+8)%8+1 {
		let s = genState(&r)
		Apply(&m, pass(&f, ps, s)) catch {
		case BadPatch:
			return false
		}
		let mut fresh = NewFrame[int]()
		let mut fm = NewMirror[int](Root(&fresh))
		Apply(&fm, pass(&fresh, ps, s)) catch {
		case BadPatch:
			return false
		}
		let want = models(ps, s, 0)
		if !SameShapes(FrameShape(&f), want) || !SameShapes(TreeShape(&f), want) || !SameShapes(MirrorShape(&m), want) || !SameShapes(MirrorShape(&fm), want) {
			return false
		}
		if Len(&f) != nodes(want)+1 || Held(&m) != Len(&f) {
			return false
		}
		if !stopsAt(ps, s, 0) && Retained(&f) != Len(&f) {
			return false
		}
	}
	true
}

// IdempotentCommit: a second pass of an equal view changes nothing.
law IdempotentCommit(seed int) {
	let mut r = seeded(seed)
	let ps = genRoot(&r)
	let mut f = NewFrame[int]()
	let s0 = genState(&r)
	let s1 = genState(&r)
	let _ = pass(&f, ps, s0)
	let _ = pass(&f, ps, s1)
	len(pass(&f, ps, s1)) == 0
}

func shuffled(xs []int, r *rng) []int {
	let mut out = xs
	for i in 0..len(out) {
		let j = i + draw(r, len(out)-i)
		let x = out[i]
		out[i] = out[j]
		out[j] = x
	}
	out
}

func keyedRows(f *Frame[int], xs []int) {
	Column(f, Plain()) {
		Each(f, xs, func(x int) Key { ByInt(x) }) func(x int) {
			Text(f, "row \(x)")
			Pressable(f, "go", x) {
				Text(f, "go")
			}
		}
		Text(f, "end")
	}
}

// rowIds is the Ids of each key's two nodes, by key, in the column the
// view writes.
func rowIds(f *Frame[int], xs []int) Map[int, (Id[int], Id[int])] {
	let mut out = Map[int, (Id[int], Id[int])]{}
	let col = Kids(f, Root(f))
	if len(col) != 1 {
		return out
	}
	let kids = Kids(f, col[0])
	if len(kids) != 2*len(xs)+1 {
		return out
	}
	for i, x in xs {
		out[x] = (kids[2*i], kids[2*i+1])
	}
	out[-1] = (kids[2*len(xs)], kids[2*len(xs)])
	out
}

// KeyedIdentity: a permutation of keyed rows keeps each row's nodes, and
// the node after the Each, with their Ids, and the patch only moves them.
law KeyedIdentity(seed int, count int) {
	let mut r = seeded(seed)
	let mut xs = []int{}
	for i in 0..(count%12+12)%12+1 {
		xs = xs.Append(i * 7)
	}
	let ys = shuffled(xs, &r)
	let mut f = NewFrame[int]()
	let mut m = NewMirror[int](Root(&f))
	Apply(&m, Render(&f, keyedRows, xs)) catch {
	case BadPatch:
		return false
	}
	let before = rowIds(&f, xs)
	let ops = Render(&f, keyedRows, ys)
	Apply(&m, ops) catch {
	case BadPatch:
		return false
	}
	for op in ops {
		match op {
		case Move[int]:
		case _:
			return false
		}
	}
	let after = rowIds(&f, ys)
	if len(before) != len(xs)+1 || len(after) != len(xs)+1 || !SameShapes(MirrorShape(&m), FrameShape(&f)) {
		return false
	}
	for x, ids in before {
		if after.Get(x) != (Some{Value: ids}) {
			return false
		}
	}
	true
}

// sent is the signal o holds, or -1 for None (the laws' signals are not
// negative).
func sent(o Option[int]) int {
	match o {
	case Some[int] as v:
		v.Value
	case None:
		-1
	}
}

func signalsAgree(f *Frame[int], id Id[int], off bool) bool {
	let mut ok = true
	let mut under = off
	let pressed = sent(Handle(f, Press[int]{Id: id}).Signal)
	let typed = sent(Handle(f, Type[int]{Id: id, Text: "abc"}).Signal)
	match NodeOf(f, id) {
	case Some[Node[int]] as n:
		match n.Value {
		case FieldsetNode as d:
			under = off || d.Disabled
			ok = pressed == -1 && typed == -1
		case PressableNode[int] as p:
			ok = pressed == p.On && typed == -1
		case CheckNode[int] as c:
			ok = pressed == c.On && typed == -1
		case InputNode as i:
			ok = i.Value == "v\(typed - 3)" && pressed == -1
		case _:
			ok = pressed == -1 && typed == -1
		}
		if off {
			ok = pressed == -1 && typed == -1
		}
	case None:
		return false
	}
	for k in Kids(f, id) {
		ok = ok && signalsAgree(f, k, under)
	}
	ok
}

// PressGivesSignal: a press of a Pressable or a Check sends its On, a
// text into an Input sends the Input's signal, and any other node sends
// nothing, after every commit of a run; under a disabled Fieldset no
// node sends anything (H4r).
law PressGivesSignal(seed int) {
	let mut r = seeded(seed)
	let ps = genRoot(&r)
	let mut f = NewFrame[int]()
	let mut ok = true
	for _ in 0..3 {
		let _ = pass(&f, ps, genState(&r))
		for k in Kids(&f, Root(&f)) {
			ok = ok && signalsAgree(&f, k, false)
		}
	}
	ok
}

// seen is one node of a model screen as a locator reads it: its node,
// its access and its text content.
type seen { node Node[int], a Access, text string }

// accessModel is shapes in tree order as an accessibility tree reads
// them, written from the shapes alone: a node's role and name from its
// kind and label, disabled for a control under a disabled Fieldset, the
// description of the nearest Fieldset (itself included) that has one.
func accessModel(shapes []Shape[int], off bool, desc string) []seen {
	let mut out = []seen{}
	for sh in shapes {
		let mut o = off
		let mut d = desc
		match sh.Node {
		case FieldsetNode as x:
			o = off || x.Disabled
			if x.Description != "" {
				d = x.Description
			}
		case _:
		}
		out = out.Append(seen{node: sh.Node, a: readAs(sh.Node, o, d), text: textOf(sh)})
		for x in accessModel(sh.Kids, o, d) {
			out = out.Append(x)
		}
	}
	out
}

func readAs(n Node[int], off bool, desc string) Access {
	let base = Access{Role: Generic, Name: "", Disabled: false, Description: desc, Checked: None, Value: None}
	match n {
	case PressableNode[int] as x:
		Access{Role: Button, Name: x.Label, Disabled: off, Description: desc, Checked: None, Value: None}
	case CheckNode[int] as x:
		Access{Role: Checkbox, Name: x.Label, Disabled: off, Description: desc, Checked: Some{Value: x.Checked}, Value: None}
	case ToggleNode as x:
		Access{Role: Switch, Name: x.Label, Disabled: off, Description: desc, Checked: Some{Value: x.On}, Value: None}
	case InputNode as x:
		Access{Role: TextBox, Name: x.Placeholder, Disabled: off, Description: desc, Checked: None, Value: Some{Value: x.Value}}
	case TextNode as x:
		Access{Role: Static, Name: x.Value, Disabled: false, Description: desc, Checked: None, Value: None}
	case FieldsetNode:
		Access{Role: Group, Name: "", Disabled: false, Description: desc, Checked: None, Value: None}
	case AreaNode as x:
		Access{Role: Region, Name: x.Label, Disabled: false, Description: desc, Checked: None, Value: None}
	case CanvasNode as x:
		Access{Role: Image, Name: x.Label, Disabled: false, Description: desc, Checked: None, Value: None}
	case RowsNode as x:
		Access{Role: List, Name: x.Label, Disabled: false, Description: desc, Checked: None, Value: None}
	case _:
		base
	}
}

func textOf(sh Shape[int]) string {
	let mut out = ""
	match sh.Node {
	case TextNode as t:
		out = t.Value
	case _:
	}
	for k in sh.Kids {
		out = out + textOf(k)
	}
	out
}

// wants is whether the model says loc finds x: a role and a name (any
// name for an empty one); a label, the name of a node whose primitive
// takes one; a placeholder, a TextBox's name; a text, a Static's name.
func wants(loc Locator, x seen) bool {
	match loc {
	case WithRole as l:
		x.a.Role == l.Role && (l.Name == "" || x.a.Name == l.Name)
	case WithLabel as l:
		let labelled = x.a.Role == Button || x.a.Role == Checkbox || x.a.Role == Switch || x.a.Role == Region || x.a.Role == Image || x.a.Role == List
		labelled && x.a.Name == l.Label
	case WithPlaceholder as l:
		x.a.Role == TextBox && x.a.Name == l.Text
	case WithText as l:
		x.a.Role == Static && x.a.Name == l.Text
	}
}

func matches(m *Mirror[int], loc Locator, is Matcher) bool {
	ExpectIn(m, loc, is) catch {
	case Mismatch:
		return false
	}
	true
}

// extras writes, after a generated program, one node of each kind the
// generator does not draw: a Toggle, an Area, a Canvas and a list, with
// labels read from the state, inside a disabled Fieldset for an odd
// state value.
func extras(f *Frame[int], v int) {
	Fieldset(f, v%2 == 1, "x\(v)") {
		let on = NewFlag(f, true)
		Toggle(f, on, "tg\(v % 3)")
		Area(f, "area\(v % 2)", Plain(), func(p PointerEvent) Option[int] { None }) {
			Text(f, "in area")
		}
		Canvas(f, "c\(v % 4)", 4, 4) func(p *Paint) {}
		Rows(f, "rows", 0, 10, func(i int) Key { ByInt(i) }) func(i int) {}
	}
}

func extraShapes(v int) []Shape[int] {
	let kids = []Shape[int]{leaf(ToggleNode{Label: "tg\(v % 3)", On: true}), Shape[int]{Node: AreaNode{Label: "area\(v % 2)", Style: Plain()}, Kids: []Shape[int]{leaf(TextNode{Value: "in area", Style: Plain()})}}, leaf(CanvasNode{Label: "c\(v % 4)", Width: 4, Height: 4, Paint: []PaintOp{}}), leaf(RowsNode{Label: "rows", Count: 0, RowHeight: 10, First: 0})}
	[]Shape[int]{Shape[int]{Node: FieldsetNode{Disabled: v%2 == 1, Description: "x\(v)"}, Kids: kids}}
}

// LocatorAgreesWithAccessTree (H4r): on the mirror a host builds from the
// patches of generated programs (with Fieldsets that disable and
// describe what is under them) and one node of each other kind, each
// role finds exactly the nodes of the model's accessibility tree with
// that role, in tree order, each read as the model reads it; a drawn
// node's role and name, label, placeholder and text find what the model
// says; and the matchers agree with the model on the first match.
law LocatorAgreesWithAccessTree(seed int) {
	let mut r = seeded(seed)
	let ps = genRoot(&r)
	let mut f = NewFrame[int]()
	let mut m = NewMirror[int](Root(&f))
	for _ in 0..3 {
		let s = genState(&r)
		let ops = Render(&f, func(g *Frame[int], st []int) {
			for p in ps {
				render(g, p, st, 0) catch {
				case Missing:
					Unreachable("ui laws: a read is drawn only under a boundary")
				case Pending:
					Unreachable("ui laws: a read is drawn only under a boundary")
				}
			}
			extras(g, st[0])
		}, s)
		Apply(&m, ops) catch {
		case BadPatch:
			return false
		}
		let mut shapes = models(ps, s, 0)
		for x in extraShapes(s[0]) {
			shapes = shapes.Append(x)
		}
		let want = accessModel(shapes, false, "")
		let mut locs = []Locator{}
		for role in []Role{Button, Checkbox, Switch, TextBox, Static, Group, Region, Image, List, Generic} {
			locs = locs.Append(WithRole{Role: role, Name: ""})
		}
		let w = want[draw(&r, len(want))]
		locs = locs.Append(WithRole{Role: w.a.Role, Name: w.a.Name})
		locs = locs.Append(WithLabel{Label: w.a.Name})
		locs = locs.Append(WithPlaceholder{Text: w.a.Name})
		locs = locs.Append(WithText{Text: w.a.Name})
		for loc in locs {
			let mut model = []seen{}
			for x in want {
				if wants(loc, x) {
					model = model.Append(x)
				}
			}
			let got = LocateIn(&m, loc)
			if len(got) != len(model) {
				return false
			}
			for i, id in got {
				if AccessOf(&m, id) != model[i].a {
					return false
				}
			}
			if matches(&m, loc, ToHaveCount{Count: len(model)}) != true || matches(&m, loc, ToHaveCount{Count: len(model) + 1}) || matches(&m, loc, ToHaveCount{Count: len(model) - 1}) || matches(&m, loc, ToExist) != (len(model) > 0) || matches(&m, loc, ToBeAbsent) != (len(model) == 0) {
				return false
			}
			if len(model) > 0 {
				let x = model[0]
				let checked = x.a.Checked == (Some{Value: true})
				let unchecked = x.a.Checked == (Some{Value: false})
				if matches(&m, loc, ToBeDisabled) != x.a.Disabled || matches(&m, loc, ToBeEnabled) == x.a.Disabled || matches(&m, loc, ToBeChecked) != checked || matches(&m, loc, ToBeUnchecked) != unchecked {
					return false
				}
				if !matches(&m, loc, ToHaveDescription{Text: x.a.Description}) || matches(&m, loc, ToHaveDescription{Text: x.a.Description + "!"}) {
					return false
				}
				if !matches(&m, loc, ToContainText{Text: x.text}) || !matches(&m, loc, ToContainText{Text: ""}) || matches(&m, loc, ToContainText{Text: x.text + "!"}) {
					return false
				}
				match x.a.Value {
				case Some[string] as v:
					if !matches(&m, loc, ToHaveValue{Value: v.Value}) || matches(&m, loc, ToHaveValue{Value: v.Value + "!"}) {
						return false
					}
				case None:
					if matches(&m, loc, ToHaveValue{Value: ""}) {
						return false
					}
				}
			}
		}
	}
	true
}
