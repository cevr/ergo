import actor

// Event is what a host reports: a press of a node, or a text typed into
// an Input node.
type Event[E] = Press{Id Id[E]} | Type{Id Id[E], Text string}

// Closed is the failure of Next when the host has closed (its window, its
// terminal, its script ended).
type Closed {}

// Host shows patches and reports input. Providers: the test host (H4),
// the desktop host, the terminal host; cmd/<name>/main.ergo chooses one.
// law-exempt: a host's laws (the mirror of its patches is what it shows, a tap at a node's box sends that node's event) need a running host and its screen; they run against each provider (the test host, H4), not here.
type Host[E] {
	// Show applies one commit's changes.
	Show(ops []Op[E]),
	// Next waits for the next input; it fails Closed when the host closed.
	Next() Event[E] fails Closed,
}

// Run shows view of a's state on h until h closes: each input is handled
// (Handle), its signal is sent to a, and the state after it is shown. The
// fetches of a commit run after it is shown, in order, and the signal of
// each is sent while its load still wants it (Arrive). Run fails with h's
// Closed, or with Stopped when a has ended.
//
// This is the reference loop: a fetch runs on the loop, so input waits for
// it. The test host (H4) runs fetches as tasks and interleaves them with
// input, under the same rule.
func Run[S, E comparable, D, F](h Host[E], a actor.Actor[S, E, D, F], view func(f *Frame[E], s S)) fails Closed | actor.Stopped {
	let mut f = NewFrame[E]()
	try show(h, a, &f, view)
	for {
		let input = try h.Next()
		let done = Handle(&f, input)
		match done.Signal {
		case Some[E] as e:
			try a.Send(e.Value)
			try show(h, a, &f, view)
		case None:
			if done.Changed {
				try show(h, a, &f, view)
			}
		}
	}
}

// show renders a's state, shows the patch and runs the commit's fetches.
func show[S, E comparable, D, F](h Host[E], a actor.Actor[S, E, D, F], f *Frame[E], view func(f *Frame[E], s S)) fails actor.Stopped {
	h.Show(Render(f, view, a.State()))
	let mut jobs = Jobs(f)
	for len(jobs) > 0 {
		let mut next = []Job[E]{}
		for j in jobs {
			match j {
			case Fetch[E] as x:
				if Arrive(f, x.Epoch) {
					try a.Send(x.Run())
					h.Show(Render(f, view, a.State()))
					for k in Jobs(f) {
						next = next.Append(k)
					}
				}
			case Cancel:
			}
		}
		jobs = next
	}
}
