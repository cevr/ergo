import arena

// Groups (P-ui, skipping; stdlib.md, UI 13). A component is a view
// function the program declares, called with a frame and arguments that
// compare with == and hold no pointer. The compiler passes such a call
// through group: when the call returns under the same parent with the
// same identity and arguments equal to the last pass's, the group writes
// the nodes the last pass's call wrote, without running it. That is sound
// because a view is pure apart from its writes through the frame (UI 1):
// equal arguments write equal nodes. A call that read a cell, a load, a
// key or a frame callback is not kept, since what it writes depends on
// more than its arguments; it runs every pass. Prior art: Compose skips a
// composable whose arguments are stable and equal, inferred by its
// compiler; Elm's Html.Lazy and React's memo leave it to the author.

// GroupArgs is the frame's memo of each kept group's arguments, held by
// the runtime: Ergo has no type for a value of any comparable type.
// law-exempt: runtime-only, with no operation a program calls; TestUISkipAgrees holds its rules (a slot compares equal to what was put or set in it; a freed slot is held no more).
extern go ergo.local/prototype/runtime/v1.GroupArgs type GroupArgs {
	runtimeOnly(),
}

extern go ergo.local/prototype/runtime/v1.NewUIArgs func newArgs() GroupArgs

extern go ergo.local/prototype/runtime/v1.UIArgsPut func argsPut[A comparable](m GroupArgs, a A) int

extern go ergo.local/prototype/runtime/v1.UIArgsSame func argsSame[A comparable](m GroupArgs, slot int, a A) bool

extern go ergo.local/prototype/runtime/v1.UIArgsSet func argsSet[A comparable](m GroupArgs, slot int, a A)

extern go ergo.local/prototype/runtime/v1.UIArgsFree func argsFree(m GroupArgs, slot int)

extern go ergo.local/prototype/runtime/v1.UIArgsHeld func argsHeld(m GroupArgs) int

// groupKey names a group across passes: the node it writes under and its
// identity there.
type groupKey[E] { owner arena.Ref[node[E]], id ident }

// keptGroup is a group of the last pass that a pass may write again: its
// arguments' slot, the specs it wrote (parent -1 for one under the group's
// parent, else an index among these specs) with the node each became, and
// the keys of the groups inside it.
type keptGroup[E] { slot int, specs []spec[E], inner []groupKey[E] }

// groupRec is one group of a pass: its parent spec, identity and slot, the
// specs it wrote [start, end), the enclosing group (-1 none), whether it
// may be kept, and the index in keptList of the kept group it wrote
// again (-1 none).
type groupRec[E] { parent int, id ident, slot int, start int, end int, outer int, pure bool, again int }

// group writes body's nodes as one group (the compiler's form of a
// component call, never written by a program): the nodes of the last
// pass's group when it is kept with arguments equal to args, else body's.
func group[E comparable, A comparable](f *Frame[E], args A, body func(), at CallSite) {
	let id = groupIdent(f, at)
	let key = groupKey[E]{owner: owner(f, f.parent), id: id}
	let outer = f.group
	let r = len(f.groups)
	let mut slot = -1
	// The kept groups are a list the map indexes: a Map whose values hold
	// slices is copied whole when read (measured: 93% of a pass).
	match f.kept.Get(key) {
	case Some[int] as i:
		slot = f.keptList[i.Value].slot
		if argsSame(f.args, slot, args) && writeAgain(f, i.Value) {
			f.groups = f.groups.Append(groupRec[E]{parent: f.parent, id: id, slot: slot, start: f.nspecs - len(f.keptList[i.Value].specs), end: f.nspecs, outer: outer, pure: true, again: i.Value})
			return
		}
		argsSet(f.args, slot, args)
	case None:
		slot = argsPut(f.args, args)
	}
	f.groups = f.groups.Append(groupRec[E]{parent: f.parent, id: id, slot: slot, start: f.nspecs, end: f.nspecs, outer: outer, pure: true, again: -1})
	let cells = f.ncells
	let loads = f.nloads
	let keys = f.nkeys
	let anims = f.nanims
	let cuts = f.cuts
	f.group = r
	f.groupRuns = f.groupRuns + 1
	body()
	f.group = outer
	f.groups[r].end = f.nspecs
	// A boundary inside that stopped (a cut) wrote what a Pending or
	// another failure left, which equal arguments do not decide: such a
	// call is not kept (H8a), as one that read a cell is not.
	f.groups[r].pure = f.ncells == cells && f.nloads == loads && f.nkeys == keys && f.nanims == anims && f.cuts == cuts
}

// groupIdent is the identity of a group under the current parent, counted
// apart from the nodes' (identify): a node keeps the identity it has when
// the call is no group, so cells and matching see the same nodes under
// either lowering.
func groupIdent[E](f *Frame[E], at CallSite) ident {
	let s = slotOf{parent: f.parent, b: base{site: at, each: f.each, key: f.key}}
	let n = count(f.groupSeen, s)
	f.groupSeen[s] = n + 1
	if f.ngroupLog < len(f.groupLog) {
		f.groupLog[f.ngroupLog] = s
	} else {
		f.groupLog = f.groupLog.Append(s)
	}
	f.ngroupLog = f.ngroupLog + 1
	ident{site: at, each: f.each, key: f.key, n: n}
}

// writeAgain writes the specs of kept group i under the current parent, as its call would:
// each spec under the group's parent takes the next count of its identity
// there, which must be the count it had, else nothing is written and the
// call runs. It is true when it wrote them.
func writeAgain[E](f *Frame[E], i int) bool {
	let mut counts = Map[slotOf, int]{}
	for s in f.keptList[i].specs {
		if s.parent < 0 {
			let at = slotOf{parent: f.parent, b: base{site: s.id.site, each: s.id.each, key: s.id.key}}
			let n = count(counts, at)
			if count(f.seen, at)+n != s.id.n {
				return false
			}
			counts[at] = n + 1
		}
	}
	for at, n in counts {
		for _ in 0..n {
			bump(f, at)
		}
	}
	let first = f.nspecs
	for s in f.keptList[i].specs {
		let mut parent = f.parent
		if s.parent >= 0 {
			parent = first + s.parent
		}
		let _ = link(f, spec[E]{node: s.node, id: s.id, parent: parent, prev: s.ref, ref: arena.Null[node[E]](), onText: s.onText, onPoint: s.onPoint, onKey: s.onKey, binds: s.binds, off: false, memo: 0, same: None, skip: false, live: false, first: -1, last: -1, next: -1, before: -1})
	}
	true
}

// keepGroups makes the pass's groups the kept groups of the next pass,
// after Commit set each spec's node: a pure group is kept with the specs
// it wrote; a group written again also keeps the groups inside it. The
// slot of a group no longer kept is freed.
func keepGroups[E](f *Frame[E]) {
	let mut next = Map[groupKey[E], int]{}
	let mut list = []keptGroup[E]{}
	let mut keys = []groupKey[E]{}
	let mut inner = [][]groupKey[E]{}
	for g in f.groups {
		let mut o = f.root
		if g.parent >= 0 {
			o = f.specs[g.parent].ref
		}
		keys = keys.Append(groupKey[E]{owner: o, id: g.id})
		inner = inner.Append([]groupKey[E]{})
	}
	for i, g in f.groups {
		let mut add = []groupKey[E]{keys[i]}
		if g.again >= 0 {
			for x in f.keptList[g.again].inner {
				add = add.Append(x)
				match f.kept.Get(x) {
				case Some[int] as old:
					next[x] = len(list)
					list = list.Append(f.keptList[old.Value])
				case None:
				}
			}
			inner[i] = f.keptList[g.again].inner
		}
		let mut up = g.outer
		for up >= 0 {
			for x in add {
				inner[up] = inner[up].Append(x)
			}
			up = f.groups[up].outer
		}
	}
	for i, g in f.groups {
		if g.pure {
			let mut specs = []spec[E]{}
			for j in g.start..g.end {
				let mut c = f.specs[j]
				if c.parent < g.start {
					c.parent = -1
				} else {
					c.parent = c.parent - g.start
				}
				specs = specs.Append(c)
			}
			next[keys[i]] = len(list)
			list = list.Append(keptGroup[E]{slot: g.slot, specs: specs, inner: inner[i]})
		}
	}
	// Each slot the last pass's groups or this pass's held and no kept
	// group holds now is freed, once.
	let mut live = Map[int, bool]{}
	for k in list {
		live[k.slot] = true
	}
	for old in f.keptList {
		if !isLive(live, old.slot) {
			argsFree(f.args, old.slot)
			live[old.slot] = true
		}
	}
	for g in f.groups {
		if !isLive(live, g.slot) {
			argsFree(f.args, g.slot)
			live[g.slot] = true
		}
	}
	f.kept = next
	f.keptList = list
}

// cutGroups takes this pass's groups back to the first n, and the group
// identity counts to the first logged ones (a cut, boundary.ergo): a group
// written since goes, and the slot of one that no kept group holds is
// freed.
func cutGroups[E](f *Frame[E], n int, logged int) {
	for i in logged..f.ngroupLog {
		let s = f.groupLog[i]
		let c = count(f.groupSeen, s)
		if c <= 1 {
			f.groupSeen = f.groupSeen.Delete(s)
		} else {
			f.groupSeen[s] = c - 1
		}
	}
	f.ngroupLog = logged
	if len(f.groups) <= n {
		return
	}
	let mut held = Map[int, bool]{}
	for k in f.keptList {
		held[k.slot] = true
	}
	let mut left = []groupRec[E]{}
	for i, g in f.groups {
		if i < n {
			left = left.Append(g)
		} else if !isLive(held, g.slot) {
			argsFree(f.args, g.slot)
			held[g.slot] = true
		}
	}
	f.groups = left
}

// isLive reports slot marked in live (a set of ints; also the parents
// prior has indexed).
func isLive(live Map[int, bool], slot int) bool {
	match live.Get(slot) {
	case Some[bool]:
		true
	case None:
		false
	}
}

// GroupRuns is how many component calls the last pass of f ran: a call
// written again from the last pass does not count. A growth guard counts
// it (one changed row of many runs one row's component), never times.
func GroupRuns[E](f *Frame[E]) int { f.groupRuns }

// GroupsKept is how many groups f keeps for its next pass, and so how many
// argument slots it holds: the memo's size.
func GroupsKept[E](f *Frame[E]) int { argsHeld(f.args) }
