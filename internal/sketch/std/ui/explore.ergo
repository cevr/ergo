import actor
import gen
import machines
import option
import strings
import temporal
import time

// OfferKind classifies an offered screen interaction for swarm subsetting and
// weighting.
type OfferKind = PressOffer | InputOffer | ScrollOffer | KeyOffer | BackOffer | TimeOffer

// PressOffer is an offer that clicks an enabled button, checkbox, switch, or
// clickable semantic control.
type PressOffer {}

// InputOffer is an offer that types text into an enabled text field.
type InputOffer {}

// ScrollOffer is an offer that scrolls a virtualized list.
type ScrollOffer {}

// KeyOffer is an offer that sends a key press to the focused node or key
// handler.
type KeyOffer {}

// BackOffer is an offer that navigates back in history.
type BackOffer {}

// TimeOffer is an offer that advances the manual clock to wake timers or
// animation frames.
type TimeOffer {}

// Offer is one actionable interaction the screen offers now: its kind, label,
// selection weight, playable act, optional keyboard hint for input text
// generation, optional raw accessible locator, and the number of nodes that
// raw locator matches.
type Offer {
	Kind     OfferKind,
	Label    string,
	Weight   int,
	Act      Act,
	Keyboard option.Option[Keyboard],
	Locator  option.Option[Locator],
	Matches  int,
}

// ExploreSnapshot is the settled observation passed to temporal properties
// after each exploration step.
type ExploreSnapshot[S, E] {
	State       S,
	Screen      []Shape[E],
	Offers      []Offer,
	Fetching    int,
	WantsFrames bool,
	Focus       option.Option[Id[E]],
	FocusValid  bool,
	Time        time.Time,
}

// ExploreConfig configures an autonomous exploration walk: step budget,
// optional swarm subsetting of offer kinds, clock step for advancing sleeping
// timers, and optional per-label offer weights.
type ExploreConfig {
	Steps       int,
	Swarm       bool,
	AdvanceStep duration,
	Weights     Map[string, int],
}

// DefaultExploreConfig returns the default exploration configuration: 40
// steps, swarm disabled, 500ms clock step, and default offer weights.
func DefaultExploreConfig() ExploreConfig {
	ExploreConfig{Steps: 40, Swarm: false, AdvanceStep: 500ms, Weights: Map[string, int]{}}
}

// SwarmExploreConfig returns an exploration configuration with swarm offer-kind
// subsetting enabled.
func SwarmExploreConfig() ExploreConfig {
	ExploreConfig{Steps: 40, Swarm: true, AdvanceStep: 500ms, Weights: Map[string, int]{}}
}

// Clean is a finding where no property was violated: how many steps ran, how
// many distinct (state, act) pairs were covered, those covered pair keys, any
// expected pairs that stayed uncovered, and how the run ended (Idle or Cut).
type Clean {
	Steps     int,
	Covered   int,
	Pairs     []string,
	Uncovered []string,
	End       temporal.End,
}

// Found is a finding where a property or host invariant failed: the exact
// script of played acts up to the failure, the deciding step index, and a
// human-readable violation description.
type Found {
	Script    []Act,
	Step      int,
	Violation string,
}

// Finding is the outcome of Explore: Clean or Found.
type Finding = Clean | Found

// Defaults returns the default exploration properties over ExploreSnapshot:
// every offered locator is unambiguous, focus refers to an existing enabled
// node, every started load settles within 2s of virtual time, and every
// animation settles within 2s of virtual time.
func Defaults[S, E]() []temporal.Formula[ExploreSnapshot[S, E]] {
	DefaultsWith[S, E](2s)
}

// DefaultsWith returns the default exploration properties with settleTimeout as
// the virtual-time bound for loads and animations to settle.
func DefaultsWith[S, E](settleTimeout duration) []temporal.Formula[ExploreSnapshot[S, E]] {
	[]temporal.Formula[ExploreSnapshot[S, E]]{
		temporal.Always[ExploreSnapshot[S, E]](temporal.Named[ExploreSnapshot[S, E]]("offers-unambiguous", func(s ExploreSnapshot[S, E]) bool {
			offersAreUnambiguous(s.Offers)
		})),
		temporal.Always[ExploreSnapshot[S, E]](temporal.Named[ExploreSnapshot[S, E]]("focus-valid", func(s ExploreSnapshot[S, E]) bool {
			s.FocusValid
		})),
		temporal.Always[ExploreSnapshot[S, E]](temporal.Implies[ExploreSnapshot[S, E]](
			temporal.Named[ExploreSnapshot[S, E]]("fetching", func(s ExploreSnapshot[S, E]) bool { s.Fetching > 0 }),
			temporal.EventuallyWithin[ExploreSnapshot[S, E]](
				temporal.Named[ExploreSnapshot[S, E]]("loads-settled", func(s ExploreSnapshot[S, E]) bool { s.Fetching == 0 }),
				settleTimeout,
			),
		)),
		temporal.Always[ExploreSnapshot[S, E]](temporal.Implies[ExploreSnapshot[S, E]](
			temporal.Named[ExploreSnapshot[S, E]]("animating", func(s ExploreSnapshot[S, E]) bool { s.WantsFrames }),
			temporal.EventuallyWithin[ExploreSnapshot[S, E]](
				temporal.Named[ExploreSnapshot[S, E]]("frames-settled", func(s ExploreSnapshot[S, E]) bool { !s.WantsFrames }),
				settleTimeout,
			),
		)),
	}
}

func offersAreUnambiguous(offers []Offer) bool {
	for o in offers {
		match o.Locator {
		case option.Some[Locator]:
			if o.Matches != 1 {
				return false
			}
		case option.None:
		}
	}
	true
}

type mirrorCounts {
	byRole     Map[string, int],
	byRoleName Map[string, int],
}

func incCount(m Map[string, int], k string) Map[string, int] {
	let mut next = m
	let prev = match next.Get(k) {
	case option.Some[int] as v:
		v.Value
	case option.None:
		0
	}
	next[k] = prev + 1
	next
}

func getCount(m Map[string, int], k string) int {
	match m.Get(k) {
	case option.Some[int] as v:
		v.Value
	case option.None:
		0
	}
}

func countMirror[E](m mut Mirror[E], at option.Option[Id[E]], off bool, desc string, acc mirrorCounts) mirrorCounts {
	let mut counts = acc
	let mut c = at
	for {
		match c {
		case option.Some[Id[E]] as x:
			let e = entry(m, refOf(m, x.Value))
			let hn = Lower(e.node)
			let (o, d) = HostScope(hn, off, desc)
			let a = HostAccess(hn, o, d)
			let rn = roleText(a.Role)
			counts.byRole = incCount(counts.byRole, rn)
			counts.byRoleName = incCount(counts.byRoleName, rn+"\x00"+a.Name)
			counts = countMirror[E](m, e.first, o, d, counts)
			c = e.next
		case option.None:
			return counts
		}
	}
}

func roleMatchCount(counts mirrorCounts, r Role, name string) int {
	let rn = roleText(r)
	if name == "" {
		return getCount(counts.byRole, rn)
	}
	getCount(counts.byRoleName, rn+"\x00"+name)
}

// OffersIn inspects mirror m's access tree and returns all actionable offers in
// tree order, excluding disabled controls.
func OffersIn[E](m mut Mirror[E]) []Offer {
	match entryOf(m, m.root) {
	case option.Some[mirrored[E]] as r:
		let counts = countMirror[E](m, r.Value.first, false, "", mirrorCounts{byRole: Map[string, int]{}, byRoleName: Map[string, int]{}})
		collectOffers[E](m, r.Value.first, false, "", counts, []Offer{})
	case option.None:
		[]Offer{}
	}
}

func collectOffers[E](m mut Mirror[E], at option.Option[Id[E]], off bool, desc string, counts mirrorCounts, acc []Offer) []Offer {
	let mut out = acc
	let mut c = at
	for {
		match c {
		case option.Some[Id[E]] as x:
			let e = entry(m, refOf(m, x.Value))
			let hn = Lower(e.node)
			let (o, d) = HostScope(hn, off, desc)
			let a = HostAccess(hn, o, d)
			if !a.Disabled {
				out = appendNodeOffer[E](m, counts, e.node, a, out)
			}
			out = collectOffers[E](m, e.first, o, d, counts, out)
			c = e.next
		case option.None:
			return out
		}
	}
}

func appendNodeOffer[E](m mut Mirror[E], counts mirrorCounts, n Node[E], a Access, out []Offer) []Offer {
	match n {
	case PressableNode[E]:
		let raw = WithRole{Role: Button, Name: a.Name}
		let nMatch = roleMatchCount(counts, Button, a.Name)
		let playLoc = if nMatch > 1 { First{At: raw} } else { raw }
		out.Append(Offer{Kind: PressOffer, Label: a.Name, Weight: 4, Act: ClickOn{At: playLoc}, Keyboard: option.None, Locator: option.Some[Locator]{Value: raw}, Matches: nMatch})
	case CheckNode[E]:
		let raw = WithRole{Role: Checkbox, Name: a.Name}
		let nMatch = roleMatchCount(counts, Checkbox, a.Name)
		let playLoc = if nMatch > 1 { First{At: raw} } else { raw }
		out.Append(Offer{Kind: PressOffer, Label: a.Name, Weight: 3, Act: ClickOn{At: playLoc}, Keyboard: option.None, Locator: option.Some[Locator]{Value: raw}, Matches: nMatch})
	case ToggleNode:
		let raw = WithRole{Role: Switch, Name: a.Name}
		let nMatch = roleMatchCount(counts, Switch, a.Name)
		let playLoc = if nMatch > 1 { First{At: raw} } else { raw }
		out.Append(Offer{Kind: PressOffer, Label: a.Name, Weight: 3, Act: ClickOn{At: playLoc}, Keyboard: option.None, Locator: option.Some[Locator]{Value: raw}, Matches: nMatch})
	case SemanticNode[E] as x:
		match x.On {
		case option.Some[E]:
			let raw = WithRole{Role: a.Role, Name: a.Name}
			let nMatch = roleMatchCount(counts, a.Role, a.Name)
			let playLoc = if nMatch > 1 { First{At: raw} } else { raw }
			out.Append(Offer{Kind: PressOffer, Label: a.Name, Weight: 3, Act: ClickOn{At: playLoc}, Keyboard: option.None, Locator: option.Some[Locator]{Value: raw}, Matches: nMatch})
		case option.None:
			out
		}
	case InputNode as x:
		let raw = WithRole{Role: TextBox, Name: a.Name}
		let nMatch = roleMatchCount(counts, TextBox, a.Name)
		let playLoc = if nMatch > 1 { First{At: raw} } else { raw }
		out.Append(Offer{Kind: InputOffer, Label: a.Name, Weight: 3, Act: FillIn{At: playLoc, Text: ""}, Keyboard: option.Some[Keyboard]{Value: x.Hints.Keyboard}, Locator: option.Some[Locator]{Value: raw}, Matches: nMatch})
	case RowsNode as x:
		if x.Label == "" {
			return out
		}
		let nMatch = withLabel(m, m.root, x.Label, []Id[E]{}).Len()
		let step = if x.RowHeight > Length(0.0) { x.RowHeight } else { Length(10.0) }
		let nextOff = x.Offset + step
		let vh = step * Length(4.0)
		out.Append(Offer{Kind: ScrollOffer, Label: x.Label, Weight: 2, Act: ScrollOn{Label: x.Label, Offset: nextOff, Height: vh}, Keyboard: option.None, Locator: option.Some[Locator]{Value: WithRole{Role: List, Name: x.Label}}, Matches: nMatch})
	case _:
		out
	}
}

func plainMods() Mods { Mods{Shift: false, Ctrl: false, Alt: false, Meta: false} }

// Offers returns every actionable interaction the test host h offers right now:
// enabled controls from the mirror's access tree, keys for the focused node or
// active key handlers, GoBack when history depth is positive, and AdvanceBy
// when timers or animations are pending.
func Offers[S, E, D, F](h mut TestHost[S, E, D, F]) []Offer {
	offersWithAdvance(h, 500ms)
}

func offersWithAdvance[S, E, D, F](h mut TestHost[S, E, D, F], adv duration) []Offer {
	let mut out = OffersIn(&h.mirror)
	match FocusOf(h) {
	case option.Some[Id[E]] as fid:
		match entryOf(&h.mirror, fid.Value) {
		case option.Some[mirrored[E]] as e:
			if !AccessOf(&h.mirror, fid.Value).Disabled {
				match e.Value.node {
				case InputNode, PressableNode[E], CheckNode[E], ToggleNode:
					out = out.Append(Offer{Kind: KeyOffer, Label: "key:Enter", Weight: 1, Act: KeyIn{Press: KeyPress{Name: "Enter", Mods: plainMods()}}, Keyboard: option.None, Locator: option.None, Matches: 1})
				case SemanticNode[E] as sx:
					match sx.On {
					case option.Some[E]:
						out = out.Append(Offer{Kind: KeyOffer, Label: "key:Enter", Weight: 1, Act: KeyIn{Press: KeyPress{Name: "Enter", Mods: plainMods()}}, Keyboard: option.None, Locator: option.None, Matches: 1})
					case option.None:
					}
				case _:
				}
			}
		case option.None:
		}
	case option.None:
	}
	if h.session.frame.nkeys > 0 {
		out = out.Append(Offer{Kind: KeyOffer, Label: "key:Tab", Weight: 1, Act: KeyIn{Press: KeyPress{Name: "Tab", Mods: plainMods()}}, Keyboard: option.None, Locator: option.None, Matches: 1})
	}
	if Depth(History(h)) > 0 {
		out = out.Append(Offer{Kind: BackOffer, Label: "back", Weight: 3, Act: GoBack, Keyboard: option.None, Locator: option.None, Matches: 1})
	}
	if time.Sleepers(h.clock) > 0 || WantsFrames(h) {
		let by = if WantsFrames(h) && time.Sleepers(h.clock) == 0 { h.period } else if adv > 0ns { adv } else { 500ms }
		out = out.Append(Offer{Kind: TimeOffer, Label: "advance", Weight: 3, Act: AdvanceBy{By: by}, Keyboard: option.None, Locator: option.None, Matches: 1})
	}
	out
}

func focusIsValid[S, E, D, F](h mut TestHost[S, E, D, F]) bool {
	match FocusOf(h) {
	case option.None:
		true
	case option.Some[Id[E]] as fid:
		if !holds(&h.mirror, fid.Value) {
			return false
		}
		!AccessOf(&h.mirror, fid.Value).Disabled
	}
}

func snapshotOf[S, E, D, F](h mut TestHost[S, E, D, F], adv duration) ExploreSnapshot[S, E] {
	ExploreSnapshot[S, E]{
		State:       StateOf(h),
		Screen:      Screen(h),
		Offers:      offersWithAdvance(h, adv),
		Fetching:    Fetching(h),
		WantsFrames: WantsFrames(h),
		Focus:       FocusOf(h),
		FocusValid:  focusIsValid(h),
		Time:        Now(h),
	}
}

func allOfferKinds() []OfferKind {
	[]OfferKind{PressOffer, InputOffer, ScrollOffer, KeyOffer, BackOffer, TimeOffer}
}

func drawSwarmKinds() []OfferKind needs gen.Draws {
	let mut out = []OfferKind{}
	for k in allOfferKinds() {
		if gen.Bool() {
			out = out.Append(k)
		}
	}
	out
}

func hasOfferKind(xs []OfferKind, k OfferKind) bool {
	for x in xs {
		if x == k {
			return true
		}
	}
	false
}

func offersOfKind(offers []Offer, k OfferKind) []Offer {
	let mut out = []Offer{}
	for o in offers {
		if o.Kind == k {
			out = out.Append(o)
		}
	}
	out
}

func filterSwarm(offers []Offer, allowed []OfferKind) []Offer {
	if offers.Len() == 0 {
		return offers
	}
	let mut out = []Offer{}
	for o in offers {
		if hasOfferKind(allowed, o.Kind) {
			out = out.Append(o)
		}
	}
	if out.Len() == 0 {
		return offersOfKind(offers, offers[0].Kind)
	}
	out
}

func drawInputText(kb Keyboard) string needs gen.Draws {
	match kb {
	case TextKeys:
		gen.OneOf([]string{"", "a", "hello", "item-1", "long text value"})
	case EmailKeys:
		gen.OneOf([]string{"", "a@b.c", "user@example.com", "not-an-email"})
	case NumberKeys:
		gen.OneOf([]string{"", "0", "1", "42", "-1", "99999"})
	case PhoneKeys:
		gen.OneOf([]string{"", "555-0100", "+15550199"})
	case URLKeys:
		gen.OneOf([]string{"", "/", "/items", "https://example.com"})
	case PasswordKeys:
		gen.OneOf([]string{"", "x", "secret-123"})
	}
}

func materializeOffer(o Offer) Act needs gen.Draws {
	match o.Act {
	case FillIn as x:
		let kb = match o.Keyboard {
		case option.Some[Keyboard] as k:
			k.Value
		case option.None:
			TextKeys
		}
		let txt = drawInputText(kb)
		FillIn{At: x.At, Text: txt}
	case _:
		o.Act
	}
}

func recordPlayedAct(a Act) Act {
	match a {
	case FillIn as x:
		FillIn{At: x.At, Text: x.Text}
	case _:
		a
	}
}

func recordCoveredPair(seen []string, pair string) []string {
	for existing in seen {
		if existing == pair {
			return seen
		}
	}
	seen.Append(pair)
}

func containsPair(xs []string, pair string) bool {
	for x in xs {
		if x == pair {
			return true
		}
	}
	false
}

func offerWeight(o Offer, stateKey string, covered []string, weights Map[string, int]) int {
	let mut w = match weights.Get(o.Label) {
	case option.Some[int] as cw:
		cw.Value
	case option.None:
		o.Weight
	}
	if w < 1 {
		w = 1
	}
	let pair = pairKey(stateKey, actText(o.Act))
	if !containsPair(covered, pair) {
		w = w * 2
	}
	w
}

func pickWeightedOffer(offers []Offer, stateKey string, covered []string, weights Map[string, int]) Offer needs gen.Draws {
	let mut total = 0
	for o in offers {
		total = total + offerWeight(o, stateKey, covered, weights)
	}
	let mut target = int(gen.Below(uint64(total)))
	for o in offers {
		let w = offerWeight(o, stateKey, covered, weights)
		if target < w {
			return o
		}
		target = target - w
	}
	offers[0]
}

func pairKey(stateKey string, actKey string) string {
	stateKey + " -> " + actKey
}

func exploreEnd(exhausted bool) temporal.End {
	if exhausted {
		return temporal.Idle
	}
	temporal.Cut
}

func exploreStep[E comparable, S, D, F](h mut TestHost[S, E, D, F], act Act) fails NoNode | Ambiguous | Mismatch | actor.Stopped | BadPatch {
	try Play(h, []Act{act})
	try Settle(h)
}

func stepResiduals[S, E](rs []temporal.Residual[ExploreSnapshot[S, E]], snap ExploreSnapshot[S, E]) ([]temporal.Residual[ExploreSnapshot[S, E]], option.Option[string]) {
	let mut next = []temporal.Residual[ExploreSnapshot[S, E]]{}
	let mut violation option.Option[string] = option.None
	for r in rs {
		let r2 = temporal.Step[ExploreSnapshot[S, E]](r, snap, snap.Time)
		next = next.Append(r2)
		if violation == option.None && temporal.Decided[ExploreSnapshot[S, E]](r2) {
			match temporal.Stop[ExploreSnapshot[S, E]](r2, temporal.Cut) {
			case temporal.Violated as v:
				violation = option.Some[string]{Value: temporal.FormatVerdict(v)}
			case _:
			}
		}
	}
	(next, violation)
}

func stopResiduals[S, E](rs []temporal.Residual[ExploreSnapshot[S, E]], end temporal.End) option.Option[string] {
	for r in rs {
		match temporal.Stop[ExploreSnapshot[S, E]](r, end) {
		case temporal.Violated as v:
			return option.Some[string]{Value: temporal.FormatVerdict(v)}
		case _:
		}
	}
	option.None
}

func uncoveredOf(expected []string, covered []string) []string {
	let mut out = []string{}
	for p in expected {
		if !containsPair(covered, p) {
			out = out.Append(p)
		}
	}
	out
}

// Explore runs an autonomous exploration walk on test host h using gen.Draws,
// checking every temporal formula in props after each settled step. It stops
// on the first violation (Found), at cfg.Steps (Clean with End Cut), or when
// nothing is offered and nothing is pending (Clean with End Idle).
func Explore[E comparable, S, D, F](h mut TestHost[S, E, D, F], props []temporal.Formula[ExploreSnapshot[S, E]], cfg ExploreConfig) Finding needs gen.Draws {
	exploreRun(h, false, func(s S) string { "" }, []string{}, props, cfg)
}

// ExploreWith runs Explore with an explicit state key function and optional
// expected (state, act) pair list for graph-guided weighting and uncovered
// pair reporting in Clean.
func ExploreWith[E comparable, S, D, F](h mut TestHost[S, E, D, F], stateKey func(s S) string, expectedPairs []string, props []temporal.Formula[ExploreSnapshot[S, E]], cfg ExploreConfig) Finding needs gen.Draws {
	exploreRun(h, true, stateKey, expectedPairs, props, cfg)
}

func hostStateKey[S, E, D, F](h mut TestHost[S, E, D, F], useKey bool, stateKey func(s S) string) string {
	if useKey {
		return stateKey(StateOf(h))
	}
	Screenshot(h)
}

func exploreRun[E comparable, S, D, F](h mut TestHost[S, E, D, F], useKey bool, stateKey func(s S) string, expectedPairs []string, props []temporal.Formula[ExploreSnapshot[S, E]], cfg ExploreConfig) Finding needs gen.Draws {
	let mut rs = []temporal.Residual[ExploreSnapshot[S, E]]{}
	for p in props {
		rs = rs.Append(temporal.Start[ExploreSnapshot[S, E]](p))
	}
	let allowed = if cfg.Swarm { drawSwarmKinds() } else { allOfferKinds() }
	let mut script = []Act{}
	let mut covered = []string{}
	let initSnap = snapshotOf(h, cfg.AdvanceStep)
	let (rs0, vio0) = stepResiduals[S, E](rs, initSnap)
	rs = rs0
	match vio0 {
	case option.Some[string] as v:
		return Found{Script: script, Step: 0, Violation: v.Value}
	case option.None:
	}
	let mut steps = 0
	let mut exhausted = false
	for steps < cfg.Steps {
		let rawOffers = offersWithAdvance(h, cfg.AdvanceStep)
		if rawOffers.Len() == 0 {
			if Fetching(h) == 0 && !WantsFrames(h) && time.Sleepers(h.clock) == 0 {
				exhausted = true
			}
			break
		}
		let candidates = if cfg.Swarm { filterSwarm(rawOffers, allowed) } else { rawOffers }
		if candidates.Len() == 0 {
			break
		}
		let sk = hostStateKey(h, useKey, stateKey)
		gen.Draws.Begin("step")
		let chosen = pickWeightedOffer(candidates, sk, covered, cfg.Weights)
		let act = materializeOffer(chosen)
		gen.Draws.End()
		let recorded = recordPlayedAct(act)
		covered = recordCoveredPair(covered, pairKey(sk, actText(recorded)))
		script = script.Append(recorded)
		steps = steps + 1
		exploreStep(h, act) catch {
		case NoNode as x:
			return Found{Script: script, Step: steps, Violation: "no node: \(x.Label)"}
		case Ambiguous as x:
			return Found{Script: script, Step: steps, Violation: "ambiguous locator \(x.At): matched \(x.Count) nodes"}
		case Mismatch as x:
			return Found{Script: script, Step: steps, Violation: "mismatch: want \(x.Want), got \(x.Got)"}
		case actor.Stopped:
			return Found{Script: script, Step: steps, Violation: "actor stopped unexpectedly"}
		case BadPatch as x:
			return Found{Script: script, Step: steps, Violation: "bad patch: \(x.Why)"}
		}
		let snap = snapshotOf(h, cfg.AdvanceStep)
		let (rsNext, vio) = stepResiduals[S, E](rs, snap)
		rs = rsNext
		match vio {
		case option.Some[string] as v:
			return Found{Script: script, Step: steps, Violation: v.Value}
		case option.None:
		}
	}
	let end = exploreEnd(exhausted)
	match stopResiduals[S, E](rs, end) {
	case option.Some[string] as v:
		return Found{Script: script, Step: steps, Violation: v.Value}
	case option.None:
	}
	Clean{Steps: steps, Covered: covered.Len(), Pairs: covered, Uncovered: uncoveredOf(expectedPairs, covered), End: end}
}

// FormatSceneTest formats a Found exploration script as a paste-able Ergo test
// block that replays script against hostExpr.
func FormatSceneTest(name string, hostExpr string, script []Act, violation string) string {
	let mut out = "test \(name) {\n\tlet mut h = \(hostExpr)\n\ttry ui.Play(&h, []ui.Act{\n"
	for act in script {
		out = out + "\t\t" + formatActLiteral(act) + ",\n"
	}
	out = out + "\t})\n\tlet _ = \"\(escapeErgoString(violation))\"\n}\n"
	out
}

func escapeErgoString(s string) string {
	let mut out = ""
	for i in 0..s.Len() {
		let b = s[i]
		if b == '\\' {
			out = out + "\\\\"
		} else if b == '"' {
			out = out + "\\\""
		} else if b == '\n' {
			out = out + "\\n"
		} else if b == '\t' {
			out = out + "\\t"
		} else {
			out = out + s[i:i+1]
		}
	}
	out
}

