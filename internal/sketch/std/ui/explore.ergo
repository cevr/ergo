func formatLocatorLiteral(loc Locator) string {
	match loc {
	case WithRole as x:
		"ui.WithRole{Role: \(formatRoleLiteral(x.Role)), Name: \"\(escapeErgoString(x.Name))\"}"
	case WithLabel as x:
		"ui.WithLabel{Label: \"\(escapeErgoString(x.Label))\"}"
	case WithPlaceholder as x:
		"ui.WithPlaceholder{Text: \"\(escapeErgoString(x.Text))\"}"
	case WithText as x:
		"ui.WithText{Text: \"\(escapeErgoString(x.Text))\"}"
	case WithZone as x:
		match x.Key {
		case IntKey as k:
			"ui.WithZone{Key: ui.ByInt(\(k.Value))}"
		case TextKey as k:
			"ui.WithZone{Key: ui.ByText(\"\(escapeErgoString(k.Value))\")}"
		case NoKey:
			"ui.WithZone{Key: ui.NoKey}"
		}
	case First as x:
		"ui.First{At: \(formatLocatorLiteral(x.At))}"
	case Within as x:
		"ui.Within{In: \(formatLocatorLiteral(x.In)), At: \(formatLocatorLiteral(x.At))}"
	}
}

func formatActLiteral(a Act) string {
	match a {
	case ClickOn as x:
		"ui.ClickOn{At: \(formatLocatorLiteral(x.At))}"
	case FillIn as x:
		"ui.FillIn{At: \(formatLocatorLiteral(x.At)), Text: \"\(escapeErgoString(x.Text))\"}"
	case ScrollOn as x:
		"ui.ScrollOn{Label: \"\(escapeErgoString(x.Label))\", Offset: ui.Length(\(x.Offset)), Height: ui.Length(\(x.Height))}"
	case KeyIn as x:
		"ui.KeyIn{Press: ui.KeyPress{Name: \"\(escapeErgoString(x.Press.Name))\", Mods: ui.Mods{Shift: \(x.Press.Mods.Shift), Ctrl: \(x.Press.Mods.Ctrl), Alt: \(x.Press.Mods.Alt), Meta: \(x.Press.Mods.Meta)}}}"
	case GoBack:
		"ui.GoBack"
	case AdvanceBy as x:
		"ui.AdvanceBy{By: duration(\(int64(x.By)))}"
	case NavigateTo as x:
		"ui.NavigateTo{Href: \"\(escapeErgoString(x.Href))\"}"
	case TapOn as x:
		"ui.TapOn{Label: \"\(escapeErgoString(x.Label))\"}"
	case TypeInto as x:
		"ui.TypeInto{Label: \"\(escapeErgoString(x.Label))\", Text: \"\(escapeErgoString(x.Text))\"}"
	case SettleAll:
		"ui.SettleAll"
	case ExpectOn as x:
		"ui.ExpectOn{At: \(formatLocatorLiteral(x.At)), Is: ui.ToExist}"
	case PointOn as x:
		"ui.PointOn{Label: \"\(escapeErgoString(x.Label))\", Pointer: ui.PointerEvent{Pointer: ui.MousePointer, Phase: ui.Down, X: \(x.Pointer.X), Y: \(x.Pointer.Y), Zone: None}}"
	}
}

func isActionableModelNode(x seen) bool {
	if x.a.Disabled {
		return false
	}
	match x.node {
	case PressableNode[int], CheckNode[int], ToggleNode, InputNode:
		true
	case RowsNode as rn:
		rn.Label != ""
	case SemanticNode[int] as sn:
		sn.On != option.None
	case _:
		false
	}
}

func actResolvesOnce[E](m mut Mirror[E], a Act) bool {
	match a {
	case ClickOn as x:
		LocateIn(m, x.At).Len() == 1
	case FillIn as x:
		LocateIn(m, x.At).Len() == 1
	case ScrollOn as x:
		withLabel(m, m.root, x.Label, []Id[E]{}).Len() == 1
	case _:
		true
	}
}

func offerTargetEnabled[E](m mut Mirror[E], a Act) bool {
	match a {
	case ClickOn as x:
		let ids = LocateIn(m, x.At)
		ids.Len() == 1 && !AccessOf(m, ids[0]).Disabled
	case FillIn as x:
		let ids = LocateIn(m, x.At)
		ids.Len() == 1 && !AccessOf(m, ids[0]).Disabled
	case ScrollOn as x:
		let ids = withLabel(m, m.root, x.Label, []Id[E]{})
		ids.Len() == 1 && !AccessOf(m, ids[0]).Disabled
	case _:
		true
	}
}

// OffersArePlayable: on the mirrors of generated programs (using the generator
// of LocatorAgreesWithAccessTree with disabled Fieldsets), every enabled
// actionable node produces an offer, no disabled node is offered, and every
// offer resolves to exactly one enabled node without NoNode or Ambiguous.
law OffersArePlayable(seed int) {
	let mut r = seeded(seed)
	let ps = genRoot(&r)
	let mut f = NewFrame[int]()
	let mut m = NewMirror[int](Root(&f))
	for _ in 0..3 {
		let s = genState(&r)
		let ops = Render(&f, func(g mut Frame[int], st []int) {
			for p in ps {
				render(g, p, st, 0) catch {
				case Missing:
				case Pending:
				}
			}
			extras(g, st[0])
		}, s)
		Apply(&m, ops) catch {
		case BadPatch:
			return false
		}
		let mut shapes = models(ps, s, 0)
		for x in extraShapes(s[0]) {
			shapes = shapes.Append(x)
		}
		let want = accessModel(shapes, false, "")
		let mut wantCount = 0
		for x in want {
			if isActionableModelNode(x) {
				wantCount = wantCount + 1
			}
		}
		let offers = OffersIn(&m)
		if offers.Len() != wantCount {
			return false
		}
		let mut checked = Map[string, bool]{}
		for o in offers {
			let key = actText(o.Act)
			if checked.Get(key) != option.None {
				continue
			}
			checked[key] = true
			if !actResolvesOnce(&m, o.Act) {
				return false
			}
			if o.Matches == 1 && !offerTargetEnabled(&m, o.Act) {
				return false
			}
		}
	}
	true
}

// SwarmNeverLeavesNone: for any non-empty list of offers and any drawn swarm
// subset of offer kinds, filterSwarm keeps at least one offer from the list.
law SwarmNeverLeavesNone(seed int) {
	let mut r = seeded(seed)
	let kinds = allOfferKinds()
	let count = draw(&r, 6) + 1
	let mut offers = []Offer{}
	for i in 0..count {
		let k = kinds[draw(&r, kinds.Len())]
		offers = offers.Append(Offer{Kind: k, Label: "o\(i)", Weight: 1, Act: GoBack, Keyboard: option.None, Locator: option.None, Matches: 1})
	}
	let mut allowed = []OfferKind{}
	for k in kinds {
		if draw(&r, 3) == 0 {
			allowed = allowed.Append(k)
		}
	}
	let filtered = filterSwarm(offers, allowed)
	if filtered.Len() == 0 {
		return false
	}
	for fo in filtered {
		let mut found = false
		for orig in offers {
			if orig.Label == fo.Label && orig.Kind == fo.Kind {
				found = true
			}
		}
		if !found {
			return false
		}
	}
	true
}

// CoveredPairsNeverOvercount: recording duplicate (state, act) pairs keeps each
// distinct pair exactly once and never inflates the covered count.
law CoveredPairsNeverOvercount(seed int) {
	let mut r = seeded(seed)
	let pool = []string{"s0 -> ClickOn \"a\"", "s0 -> ClickOn \"b\"", "s1 -> ClickOn \"a\"", "s1 -> GoBack"}
	let mut seen = []string{}
	let mut has0 = false
	let mut has1 = false
	let mut has2 = false
	let mut has3 = false
	for _ in 0..12 {
		let idx = draw(&r, pool.Len())
		if idx == 0 { has0 = true }
		if idx == 1 { has1 = true }
		if idx == 2 { has2 = true }
		if idx == 3 { has3 = true }
		seen = recordCoveredPair(seen, pool[idx])
	}
	let mut distinct = 0
	if has0 { distinct = distinct + 1 }
	if has1 { distinct = distinct + 1 }
	if has2 { distinct = distinct + 1 }
	if has3 { distinct = distinct + 1 }
	seen.Len() == distinct
}

type noteState { text string, clicks int }

type noteSignal = noteTyped{text string} | noteClick

type noteClick {}

func noteStep(s noteState, e noteSignal) machines.Decision[noteState, int] {
	match e {
	case noteTyped as x:
		machines.Enter[noteState]{Next: noteState{text: x.text, clicks: s.clicks}}
	case noteClick:
		machines.Enter[noteState]{Next: noteState{text: s.text, clicks: s.clicks + 1}}
	}
}

func noteMachine() machines.Machine[noteState, noteSignal, int] {
	machines.Machine[noteState, noteSignal, int]{
		Initial: noteState{text: "", clicks: 0},
		Step:    noteStep,
		After:   func(s noteState) option.Option[machines.Timeout[noteSignal]] { option.None },
		Work:    func(s noteState) option.Option[func(send func(e noteSignal))] { option.None },
		Exit:    func(s noteState) option.Option[func()] { option.None },
	}
}

func noteView(f mut Frame[noteSignal], s noteState) {
	Column(f, Plain()) {
		Text(f, "clicks \(s.clicks)")
		LabelledInput(f, FieldLabel{Text: "Note", Description: "", Invalid: false}, s.text, "note", func(t string) noteSignal { noteTyped{text: t} })
		Pressable(f, "Count", noteClick) {
			Text(f, "Count")
		}
	}
}

// FindingsReplay: every Found script produced by Explore replays on a fresh
// TestHost to reproduce the same violation, including typed text in FillIn
// steps, and FormatSceneTest renders a valid test block containing the script.
law FindingsReplay() {
	let mut foundText = false
	let props = []temporal.Formula[ExploreSnapshot[noteState, noteSignal]]{
		temporal.Always[ExploreSnapshot[noteState, noteSignal]](temporal.Named[ExploreSnapshot[noteState, noteSignal]]("note-empty", func(s ExploreSnapshot[noteState, noteSignal]) bool {
			s.State.text == ""
		})),
	}
	let mut replaysOK = true
	for caseNum in 0..8 {
		let m = time.NewManual(0)
		with context { time.Scheduler: m } {
			let a = actor.StartMachine(noteMachine(), 1, func(o int) {})
			let mut h = NewTestHost(a, noteView, m, 4) catch {
			case BadPatch:
				return false
			}
			let mut finding Finding = Clean{Steps: 0, Covered: 0, Pairs: []string{}, Uncovered: []string{}, End: temporal.Cut}
			let _ = gen.Replay(gen.Tape{Size: caseNum + 2, Draws: []uint64{uint64(caseNum % 2), uint64(1), uint64(caseNum % 2), uint64(2), uint64(0), uint64(1)}}, func() bool fails gen.Rejected needs gen.Draws {
				finding = Explore(&h, props, ExploreConfig{Steps: 8, Swarm: false, AdvanceStep: 500ms, Weights: Map[string, int]{}})
				true
			})
			match finding {
			case Found as fd:
				foundText = true
				let m2 = time.NewManual(0)
				with context { time.Scheduler: m2 } {
					let a2 = actor.StartMachine(noteMachine(), 1, func(o int) {})
					let mut h2 = NewTestHost(a2, noteView, m2, 4) catch {
					case BadPatch:
						replaysOK = false
						return false
					}
					Play(&h2, fd.Script) catch {
					case _:
						replaysOK = false
						return false
					}
					Settle(&h2) catch {
					case _:
						replaysOK = false
						return false
					}
					if StateOf(&h2).text == "" {
						replaysOK = false
					}
					let rendered = FormatSceneTest("ReplayNote", "runNoteHost(m)", fd.Script, fd.Violation)
					if !strings.Contains(rendered, "test ReplayNote") || !strings.Contains(rendered, "ui.FillIn") {
						replaysOK = false
					}
				}
			case Clean:
			}
		}
	}
	foundText && replaysOK
}

type settleState { loading bool, done bool }

func settleStep(s settleState, e int) machines.Decision[settleState, int] {
	if e == 1 {
		return machines.Enter[settleState]{Next: settleState{loading: true, done: false}}
	}
	machines.Enter[settleState]{Next: settleState{loading: false, done: true}}
}

func settleWork(s settleState) option.Option[func(send func(e int))] {
	if !s.loading {
		return option.None
	}
	option.Some{Value: func(send func(e int)) {
		let mut x = 1
		for i in 0..2000000 {
			x = (x*31 + i) % 1000003
		}
		if x >= 0 {
			send(2)
		}
	}}
}

func settleMachine() machines.Machine[settleState, int, int] {
	machines.Machine[settleState, int, int]{
		Initial: settleState{loading: false, done: false},
		Step:    settleStep,
		After:   func(s settleState) option.Option[machines.Timeout[int]] { option.None },
		Work:    settleWork,
		Exit:    func(s settleState) option.Option[func()] { option.None },
	}
}

func settleView(f mut Frame[int], s settleState) {
	Column(f, Plain()) {
		Text(f, if s.loading { "loading" } else if s.done { "done" } else { "idle" })
		if !s.done {
			Pressable(f, "Load", 1) {
				Text(f, "Load")
			}
		}
	}
}

// ExploreSettlesBeforeChecking: Explore settles pending work after each act
// before snapshotting state and stepping temporal properties.
law ExploreSettlesBeforeChecking() {
	let m = time.NewManual(0)
	with context { time.Scheduler: m } {
		let a = actor.StartMachine(settleMachine(), 1, func(o int) {})
		let mut h = NewTestHost(a, settleView, m, 4) catch {
		case BadPatch:
			return false
		}
		let props = []temporal.Formula[ExploreSnapshot[settleState, int]]{
			temporal.Always[ExploreSnapshot[settleState, int]](temporal.Named[ExploreSnapshot[settleState, int]]("never-observes-loading", func(s ExploreSnapshot[settleState, int]) bool {
				!s.State.loading
			})),
		}
		let mut finding Finding = Found{Script: []Act{}, Step: 0, Violation: "not run"}
		let _ = gen.Replay(gen.Tape{Size: 2, Draws: []uint64{uint64(0)}}, func() bool fails gen.Rejected needs gen.Draws {
			finding = Explore(&h, props, ExploreConfig{Steps: 5, Swarm: false, AdvanceStep: 500ms, Weights: Map[string, int]{}})
			true
		})
		match finding {
		case Clean as c:
			c.Steps == 1 && StateOf(&h).done && !StateOf(&h).loading
		case Found:
			false
		}
	}
}

type termState { finished bool }

func termStep(s termState, e int) machines.Decision[termState, int] {
	machines.Enter[termState]{Next: termState{finished: true}}
}

func termMachine() machines.Machine[termState, int, int] {
	machines.Machine[termState, int, int]{
		Initial: termState{finished: false},
		Step:    termStep,
		After:   func(s termState) option.Option[machines.Timeout[int]] { option.None },
		Work:    func(s termState) option.Option[func(send func(e int))] { option.None },
		Exit:    func(s termState) option.Option[func()] { option.None },
	}
}

func termView(f mut Frame[int], s termState) {
	Column(f, Plain()) {
		Text(f, if s.finished { "finished" } else { "open" })
		if !s.finished {
			Pressable(f, "Finish", 1) {
				Text(f, "Finish")
			}
		}
	}
}

// ExploreEndsIdleWhenExhausted: when no offers remain and nothing is pending,
// Explore closes with temporal.Idle so unmet Eventually formulas report Found
// rather than Clean with Cut.
law ExploreEndsIdleWhenExhausted() {
	let m1 = time.NewManual(0)
	let mut cleanIdle = false
	with context { time.Scheduler: m1 } {
		let a1 = actor.StartMachine(termMachine(), 1, func(o int) {})
		let mut h1 = NewTestHost(a1, termView, m1, 4) catch {
		case BadPatch:
			return false
		}
		let mut f1 Finding = Found{Script: []Act{}, Step: 0, Violation: "not run"}
		let _ = gen.Replay(gen.Tape{Size: 2, Draws: []uint64{uint64(0)}}, func() bool fails gen.Rejected needs gen.Draws {
			f1 = Explore(&h1, Defaults[termState, int](), ExploreConfig{Steps: 5, Swarm: false, AdvanceStep: 500ms, Weights: Map[string, int]{}})
			true
		})
		match f1 {
		case Clean as c:
			cleanIdle = c.End == temporal.Idle && c.Steps == 1
		case Found:
			cleanIdle = false
		}
	}
	let m2 = time.NewManual(0)
	let mut unmetFound = false
	with context { time.Scheduler: m2 } {
		let a2 = actor.StartMachine(termMachine(), 1, func(o int) {})
		let mut h2 = NewTestHost(a2, termView, m2, 4) catch {
		case BadPatch:
			return false
		}
		let props2 = []temporal.Formula[ExploreSnapshot[termState, int]]{
			temporal.Eventually[ExploreSnapshot[termState, int]](temporal.Named[ExploreSnapshot[termState, int]]("never-true", func(s ExploreSnapshot[termState, int]) bool {
				false
			})),
		}
		let mut f2 Finding = Clean{Steps: 0, Covered: 0, Pairs: []string{}, Uncovered: []string{}, End: temporal.Cut}
		let _ = gen.Replay(gen.Tape{Size: 2, Draws: []uint64{uint64(0)}}, func() bool fails gen.Rejected needs gen.Draws {
			f2 = Explore(&h2, props2, ExploreConfig{Steps: 5, Swarm: false, AdvanceStep: 500ms, Weights: Map[string, int]{}})
			true
		})
		match f2 {
		case Found:
			unmetFound = true
		case Clean:
			unmetFound = false
		}
	}
	cleanIdle && unmetFound
}
