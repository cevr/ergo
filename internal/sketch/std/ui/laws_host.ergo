// The laws of the test host: a scene script on TestHost shows what the
// view means at the actor's state, reached by the signals the script's
// presses send; a fetch whose load ends is stopped, and Settle waits for
// the live one. They run their actors on a time.Manual (a law cannot hold
// Ambient, so it binds no host Scheduler).

import actor
import hex
import json
import machines
import queue
import scope
import strings
import sync
import time

// shelf is the state of the list app: its rows, by key, and the next key.
type shelf { rows []int, next int }

// shelfStep: signal 0 adds a row with the next key; signal k removes the
// row k.
func shelfStep(s shelf, e int) Decision[shelf, int] {
	if e == 0 {
		return Enter[shelf]{Next: shelf{rows: s.rows.Append(s.next), next: s.next + 1}}
	}
	let mut rows = []int{}
	for k in s.rows {
		if k != e {
			rows = rows.Append(k)
		}
	}
	Enter[shelf]{Next: shelf{rows: rows, next: s.next}}
}

func shelfTimer(s shelf) Option[Timeout[int]] { None }

func shelfWork(s shelf) Option[func(send func(e int))] { None }

func shelfMachine() Machine[shelf, int, int] {
	Machine[shelf, int, int]{Initial: shelf{rows: []int{}, next: 1}, Step: shelfStep, After: shelfTimer, Work: shelfWork}
}

// shelfView shows the count, an add button, and each row with a delete
// button: every row's button has the label "del", so a press by label
// takes the first row on the screen.
func shelfView(f *Frame[int], s shelf) {
	Column(f, Plain()) {
		Text(f, "\(len(s.rows)) rows")
		Pressable(f, "add", 0) {
			Text(f, "+")
		}
		Each(f, s.rows, func(k int) Key { ByInt(k) }) func(k int) {
			Row(f, Plain()) {
				Text(f, "row \(k)")
				Pressable(f, "del", k) {
					Text(f, "x")
				}
			}
		}
	}
}

// freshShape is what view means at s: one pass of a new frame.
func freshShape[S](view func(f *Frame[int], s S), s S) []Shape[int] {
	let mut g = NewFrame[int]()
	let _ = Render(&g, view, s)
	FrameShape(&g)
}

// ScriptShowsTheView: after each step of a drawn script of presses by
// label ("add", or "del", the first row's), the test host's screen is the
// view of the actor's state, and that state is the model's: a press of
// "del" removes the first row on the screen. The clock never moves. Half
// the presses are by locator, and the expectations of a scene hold.
law ScriptShowsTheView(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		scriptShows(seed, steps, m)
	}
}

func scriptShows(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let a = actor.StartMachine(shelfMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, shelfView, m, 4) catch {
	case BadPatch:
		return false
	}
	let start = Now(&h)
	let mut model = shelf{rows: []int{}, next: 1}
	for _ in 0..(steps%16+16)%16+1 {
		let mut label = "add"
		if len(model.rows) > 0 && draw(&r, 2) == 0 {
			label = "del"
			model = machines.Next(model, shelfStep(model, model.rows[0]))
		} else {
			model = machines.Next(model, shelfStep(model, 0))
		}
		// Half the presses go by locator, and each step expects the count
		// the model shows and the number of delete buttons (H4r).
		let mut tap Act = TapOn{Label: label}
		if draw(&r, 2) == 0 {
			tap = ClickOn{At: WithRole{Role: Button, Name: label}}
		}
		let expect = []Act{ExpectOn{At: WithText{Text: "\(len(model.rows)) rows"}, Is: ToExist}, ExpectOn{At: WithLabel{Label: "del"}, Is: ToHaveCount{Count: len(model.rows)}}}
		Play(&h, []Act{tap, expect[0], expect[1]}) catch {
		case _:
			return false
		}
		let mut refused = false
		Play(&h, []Act{ExpectOn{At: WithLabel{Label: "del"}, Is: ToHaveCount{Count: len(model.rows) + 1}}}) catch {
		case Mismatch:
			refused = true
		case _:
			return false
		}
		if !refused {
			return false
		}
		let s = StateOf(&h)
		if s != model || !SameShapes(Screen(&h), freshShape(shelfView, s)) || Now(&h) != start {
			return false
		}
	}
	true
}

// chosen is the state of the load app: the key its view loads, and the
// result the program holds (-1 for none yet).
type chosen { key int, ready int }

// chosenStep: a signal of 0 or more is a new key, and the result goes back to
// none; a negative signal is a fetch's result.
func chosenStep(s chosen, e int) Decision[chosen, int] {
	if e >= 0 {
		return Enter[chosen]{Next: chosen{key: e, ready: -1}}
	}
	Enter[chosen]{Next: chosen{key: s.key, ready: -1 - e}}
}

func chosenTimer(s chosen) Option[Timeout[int]] { None }

func chosenWork(s chosen) Option[func(send func(e int))] { None }

func chosenMachine() Machine[chosen, int, int] {
	Machine[chosen, int, int]{Initial: chosen{key: 0, ready: -1}, Step: chosenStep, After: chosenTimer, Work: chosenWork}
}

// valueOf is what the fetch of key k gives.
func valueOf(k int) int { k*10 + 7 }

// CancelledFetchStops: the load app's fetch says when it starts and when
// it ends, and sleeps an hour on the clock. A press of "next" changes the
// key: when the press returns, the fetch of the old key has ended (its task
// was stopped, not left asleep), one fetch is in flight, and the program
// holds no result. After the clock moves an hour, Settle returns with the
// live key's result shown and no fetch in flight (settledShowsLatest).
law CancelledFetchStops(steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		cancelStops(steps, m)
	}
}

func cancelStops(steps int, m time.Manual) bool needs Scheduler {
	let started = queue.New[int](64)
	let ended = queue.New[int](64)
	let view = func(f *Frame[int], s chosen) {
		let k = s.key
		Text(f, "key \(k) ready \(s.ready)")
		Pressable(f, "next", k+1+k%3) {
			Text(f, "next")
		}
		Load(f, ByInt(k), func() int {
			started.Push(k) catch {
			case queue.Closed:
			}
			scope.OnExit() {
				ended.Push(k) catch {
				case queue.Closed:
				}
			}
			time.Sleep(m, 1h)
			-1 - valueOf(k)
		})
	}
	let a = actor.StartMachine(chosenMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, view, m, 4) catch {
	case BadPatch:
		return false
	}
	let first = started.Pop() catch {
	case queue.Closed:
		return false
	}
	if first != 0 {
		return false
	}
	for _ in 0..(steps%8+8)%8+1 {
		let old = StateOf(&h).key
		Play(&h, []Act{TapOn{Label: "next"}}) catch {
		case _:
			return false
		}
		let s = StateOf(&h)
		if ended.Poll() != (Some{Value: old}) || Fetching(&h) != 1 || s.ready != -1 {
			return false
		}
		let now = started.Pop() catch {
		case queue.Closed:
			return false
		}
		if now != s.key {
			return false
		}
	}
	Play(&h, []Act{AdvanceBy{By: 1h}, SettleAll}) catch {
	case _:
		return false
	}
	let s = StateOf(&h)
	s.ready == valueOf(s.key) && Fetching(&h) == 0 && SameShapes(Screen(&h), freshShape(view, s))
}

// spin is the state of the animation app: the frames it still wants, and
// the time of the last frame it took (in nanoseconds since the host
// started, -1 for none).
type spin { left int, at int }

// spinStep: a signal of 0 or more asks for that many frames; a negative
// signal is a frame at -1-e nanoseconds.
func spinStep(s spin, e int) Decision[spin, int] {
	if e >= 0 {
		return Enter[spin]{Next: spin{left: e, at: s.at}}
	}
	Enter[spin]{Next: spin{left: s.left - 1, at: -1 - e}}
}

func spinTimer(s spin) Option[Timeout[int]] { None }

func spinWork(s spin) Option[func(send func(e int))] { None }

func spinMachine() Machine[spin, int, int] {
	Machine[spin, int, int]{Initial: spin{left: 0, at: -1}, Step: spinStep, After: spinTimer, Work: spinWork}
}

// spinView animates while frames are left; "go0" to "go3" ask for that
// many.
func spinView(f *Frame[int], s spin) {
	Text(f, "left \(s.left) at \(s.at)")
	for n in 0..4 {
		Pressable(f, "go\(n)", n) {
			Text(f, "go")
		}
	}
	if s.left > 0 {
		Animate(f, func(at duration) int { -1 - int(int64(at)) })
	}
}

// frameModel is the host's frames written without a frame: the time
// since the host started, the time owed to the next frame, and the ticks
// sent.
type frameModel { since duration, owed duration, frames int, app spin }

// advanced is the model after the clock moves d at frame period p.
func advanced(m frameModel, d duration, p duration) frameModel {
	let mut x = m
	let mut left = d
	for x.app.left > 0 && left >= p-x.owed {
		let due = p - x.owed
		x.since = x.since + due
		left = left - due
		x.owed = 0ns
		x.frames = x.frames + 1
		x.app = spin{left: x.app.left - 1, at: int(int64(x.since))}
	}
	x.since = x.since + left
	if x.app.left > 0 {
		x.owed = x.owed + left
	} else {
		x.owed = 0ns
	}
	x
}

// NoTickWhenSettled: over a drawn script of presses (asking for 0 to 3
// frames) and clock moves, the test host sends a Tick exactly at each
// frame period the view animates through, with the clock's time since it
// started, and none while the last pass made no Animate: it wants frames
// only while the model has frames left, and the screen is the view of the
// model's state.
law NoTickWhenSettled(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		ticksFollow(seed, steps, m)
	}
}

func ticksFollow(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let a = actor.StartMachine(spinMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, spinView, m, 4) catch {
	case BadPatch:
		return false
	}
	let p = 16ms
	let start = Now(&h)
	let mut model = frameModel{since: 0ns, owed: 0ns, frames: 0, app: spin{left: 0, at: -1}}
	let moves = []duration{0ns, 5ms, 11ms, 16ms, 40ms, 100ms}
	for _ in 0..(steps%24+24)%24+1 {
		let mut act Act = SettleAll
		if draw(&r, 2) == 0 {
			let n = draw(&r, 4)
			act = TapOn{Label: "go\(n)"}
			model.app = machines.Next(model.app, spinStep(model.app, n))
		} else {
			let d = moves[draw(&r, len(moves))]
			act = AdvanceBy{By: d}
			model = advanced(model, d, p)
		}
		Play(&h, []Act{act}) catch {
		case _:
			return false
		}
		let s = StateOf(&h)
		if s != model.app || Frames(&h) != model.frames || Now(&h).Sub(start) != model.since || WantsFrames(&h) != (model.app.left > 0) || !SameShapes(Screen(&h), freshShape(spinView, s)) {
			return false
		}
	}
	true
}

// pad is the state of the input app: whether its dialog is open, the
// last signal the pad gave, and how many it gave.
type pad { open bool, last int, n int }

// padStep: 1 closes the dialog, 2 opens it, anything else is a pad's
// signal.
func padStep(s pad, e int) Decision[pad, int] {
	if e == 1 {
		return Enter[pad]{Next: pad{open: false, last: s.last, n: s.n}}
	}
	if e == 2 {
		return Enter[pad]{Next: pad{open: true, last: s.last, n: s.n}}
	}
	Enter[pad]{Next: pad{open: s.open, last: e, n: s.n + 1}}
}

func padTimer(s pad) Option[Timeout[int]] { None }

func padWork(s pad) Option[func(send func(e int))] { None }

func padMachine() Machine[pad, int, int] {
	Machine[pad, int, int]{Initial: pad{open: false, last: 0, n: 0}, Step: padStep, After: padTimer, Work: padWork}
}

// onPad is the pad's function at s: a press gives 1000 plus its x plus
// 100 for each signal the pad gave (mod 3), so the function a pass makes
// reads the state; a release gives 2000 plus its y, a wheel 3000 plus its
// dy, and a move nothing.
func onPad(s pad, p PointerEvent) Option[int] {
	match p.Phase {
	case Down:
		Some{Value: 1000 + int(p.X) + 100*(s.n%3)}
	case Up:
		Some{Value: 2000 + int(p.Y)}
	case Wheel as w:
		Some{Value: 3000 + int(w.DY)}
	case Moved:
		None
	}
}

// padView: while the dialog is open, its OnKey comes first and takes
// Escape (closing it); the page's OnKey takes any key with Ctrl (opening
// the dialog) and gives the pad a 4000 plus the name's length for Enter.
func padView(f *Frame[int], s pad) {
	Text(f, "last \(s.last) of \(s.n)")
	if s.open {
		OnKey(f, func(k KeyPress) Option[int] {
			if k.Name == "Escape" {
				return Some{Value: 1}
			}
			None
		})
	}
	OnKey(f, func(k KeyPress) Option[int] {
		if k.Mods.Ctrl {
			return Some{Value: 2}
		}
		if k.Name == "Enter" {
			return Some{Value: 4005}
		}
		None
	})
	Area(f, "pad", Plain(), func(p PointerEvent) Option[int] { onPad(s, p) }) {
		Text(f, "pad")
	}
}

// keySignal is the signal a key press gives padView at s, written without
// a frame.
func keySignal(s pad, k KeyPress) Option[int] {
	if s.open && k.Name == "Escape" {
		return Some{Value: 1}
	}
	if k.Mods.Ctrl {
		return Some{Value: 2}
	}
	if k.Name == "Enter" {
		return Some{Value: 4005}
	}
	None
}

// InputGivesSignal: over a drawn script of pointer events on the pad and
// key presses (with and without Ctrl), the actor's state is the model's
// fold of the signals the pad's function and the first OnKey that takes
// a key give, and the screen is the view of that state. Escape with Ctrl
// while the dialog is open closes it: the dialog's OnKey, made first,
// takes it.
law InputGivesSignal(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		inputFollows(seed, steps, m)
	}
}

func inputFollows(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let a = actor.StartMachine(padMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, padView, m, 4) catch {
	case BadPatch:
		return false
	}
	let mut model = pad{open: false, last: 0, n: 0}
	let names = []string{"a", "Enter", "Escape"}
	for _ in 0..(steps%24+24)%24+1 {
		let mut act Act = SettleAll
		let mut sent Option[int] = None
		if draw(&r, 2) == 0 {
			let k = KeyPress{Name: names[draw(&r, len(names))], Mods: Mods{Shift: false, Ctrl: draw(&r, 2) == 0, Alt: false, Meta: false}}
			act = KeyIn{Press: k}
			sent = keySignal(model, k)
		} else {
			let x = float64(draw(&r, 100)) + 0.5
			let y = float64(draw(&r, 100)) + 0.25
			let mut phase Phase = Moved
			match draw(&r, 4) {
			case 0:
				phase = Down
			case 1:
				phase = Up
			case 2:
				phase = Wheel{DX: 0.0, DY: float64(draw(&r, 9))}
			case _:
			}
			let ev = PointerEvent{Phase: phase, X: x, Y: y}
			act = PointOn{Label: "pad", Pointer: ev}
			sent = onPad(model, ev)
		}
		match sent {
		case Some[int] as e:
			model = machines.Next(model, padStep(model, e.Value))
		case None:
		}
		Play(&h, []Act{act}) catch {
		case _:
			return false
		}
		let s = StateOf(&h)
		if s != model || !SameShapes(Screen(&h), freshShape(padView, s)) {
			return false
		}
	}
	true
}

// pp is a generated paint program: fills and strokes of paths, and
// transforms and clips around programs of their own. Every number it
// paints reads the state, so a new state repaints.
type pp = ppFill{k int} | ppStroke{k int} | ppRect{k int} | ppMove{k int, kids []pp} | ppClip{k int, kids []pp}

func genPaint(r *rng, depth int) []pp {
	let mut out = []pp{}
	for _ in 0..draw(r, 4) {
		let k = draw(r, 50)
		let kind = draw(r, 5)
		if depth == 0 || kind < 3 {
			match kind % 3 {
			case 0:
				out = out.Append(ppFill{k: k})
			case 1:
				out = out.Append(ppStroke{k: k})
			case _:
				out = out.Append(ppRect{k: k})
			}
		} else if kind == 3 {
			out = out.Append(ppMove{k: k, kids: genPaint(r, depth-1)})
		} else {
			out = out.Append(ppClip{k: k, kids: genPaint(r, depth-1)})
		}
	}
	out
}

// num is the i-th number of op k at state s.
func num(s int, k int, i int) float64 { float64((s*7+k*13+i*5)%60) + 0.5 }

func tone(s int, k int) Color { Color{R: uint8((s + k) % 256), G: uint8(k % 256), B: uint8((s * 3) % 256), A: 255} }

// tri is the path of op k at state s: a move, a line, a quad, a cubic and
// a close.
func tri(s int, k int) Path {
	Path{Segs: []Seg{MoveTo{X: num(s, k, 0), Y: num(s, k, 1)}, LineTo{X: num(s, k, 2), Y: num(s, k, 3)}, QuadTo{CX: num(s, k, 4), CY: num(s, k, 5), X: num(s, k, 6), Y: num(s, k, 7)}, CubicTo{C1X: num(s, k, 8), C1Y: num(s, k, 9), C2X: num(s, k, 10), C2Y: num(s, k, 11), X: num(s, k, 12), Y: num(s, k, 13)}, ClosePath}}
}

// paintProg paints prog at s through the package's painting functions.
func paintProg(p *Paint, prog []pp, s int) {
	for op in prog {
		match op {
		case ppFill as x:
			Fill(p, tri(s, x.k), tone(s, x.k))
		case ppStroke as x:
			Stroke(p, tri(s, x.k), tone(s, x.k), num(s, x.k, 14))
		case ppRect as x:
			Fill(p, RectPath(num(s, x.k, 0), num(s, x.k, 1), num(s, x.k, 2), num(s, x.k, 3)), tone(s, x.k))
		case ppMove as x:
			Transformed(p, Affine{A: num(s, x.k, 0), B: 0.0, C: 0.0, D: num(s, x.k, 1), E: num(s, x.k, 2), F: num(s, x.k, 3)}) {
				paintProg(p, x.kids, s)
			}
		case ppClip as x:
			Clipped(p, num(s, x.k, 0), num(s, x.k, 1), num(s, x.k, 2), num(s, x.k, 3)) {
				paintProg(p, x.kids, s)
			}
		}
	}
}

// paintModel is the list prog means at s, written without a Paint: a
// rectangle is its four corners closed, and a transform or a clip is its
// push, its program's list and a pop.
func paintModel(prog []pp, s int) []PaintOp {
	let mut out = []PaintOp{}
	for op in prog {
		match op {
		case ppFill as x:
			out = out.Append(FillOp{Path: tri(s, x.k), Color: tone(s, x.k)})
		case ppStroke as x:
			out = out.Append(StrokeOp{Path: tri(s, x.k), Color: tone(s, x.k), Width: num(s, x.k, 14)})
		case ppRect as x:
			let rx = num(s, x.k, 0)
			let ry = num(s, x.k, 1)
			let rw = num(s, x.k, 2)
			let rh = num(s, x.k, 3)
			let corners = Path{Segs: []Seg{MoveTo{X: rx, Y: ry}, LineTo{X: rx + rw, Y: ry}, LineTo{X: rx + rw, Y: ry + rh}, LineTo{X: rx, Y: ry + rh}, ClosePath}}
			out = out.Append(FillOp{Path: corners, Color: tone(s, x.k)})
		case ppMove as x:
			out = out.Append(PushTransform{M: Affine{A: num(s, x.k, 0), B: 0.0, C: 0.0, D: num(s, x.k, 1), E: num(s, x.k, 2), F: num(s, x.k, 3)}})
			for o in paintModel(x.kids, s) {
				out = out.Append(o)
			}
			out = out.Append(PopPaint)
		case ppClip as x:
			out = out.Append(PushClip{X: num(s, x.k, 0), Y: num(s, x.k, 1), W: num(s, x.k, 2), H: num(s, x.k, 3)})
			for o in paintModel(x.kids, s) {
				out = out.Append(o)
			}
			out = out.Append(PopPaint)
		}
	}
	out
}

func dialStep(s int, e int) Decision[int, int] { Enter[int]{Next: e} }

func dialTimer(s int) Option[Timeout[int]] { None }

func dialWork(s int) Option[func(send func(e int))] { None }

func dialMachine() Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: dialStep, After: dialTimer, Work: dialWork}
}

// canvasOf is the paint list of the first canvas among shapes, and
// whether there is one.
func canvasOf(shapes []Shape[int]) ([]PaintOp, bool) {
	for x in shapes {
		match x.Node {
		case CanvasNode as c:
			return (c.Paint, true)
		case _:
		}
	}
	([]PaintOp{}, false)
}

// PaintMatchesList: a drawn paint program on a canvas, over states a
// press moves to: after each press the test host's canvas shows exactly
// the list the program means at the actor's state, written without a
// Paint, its screenshot has a line for each node and each paint op, and
// the canvas is findable by its label. A second pass at the
// same state is an empty patch: an unchanged list repaints nothing.
law PaintMatchesList(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		paintFollows(seed, steps, m)
	}
}

func paintFollows(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let prog = genPaint(&r, 2)
	let view = func(f *Frame[int], s int) {
		Text(f, "at \(s)")
		Pressable(f, "next", (s*5+3)%11) {
			Text(f, "next")
		}
		Canvas(f, "board", 120, 80) func(p *Paint) {
			paintProg(p, prog, s)
		}
	}
	let a = actor.StartMachine(dialMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, view, m, 4) catch {
	case BadPatch:
		return false
	}
	for _ in 0..(steps%12+12)%12+1 {
		Play(&h, []Act{TapOn{Label: "next"}}) catch {
		case _:
			return false
		}
		let s = StateOf(&h)
		let (shown, ok) = canvasOf(Screen(&h))
		let want = paintModel(prog, s)
		if !ok || shown != want || Find(&h, "board") == None || strings.Count(Screenshot(&h), "\n") != 4+len(want) {
			return false
		}
		let mut g = NewFrame[int]()
		let _ = Render(&g, view, s)
		if len(Render(&g, view, s)) != 0 {
			return false
		}
	}
	true
}

// roster is the state of the long-list app: its rows' keys, in order, and
// the next key.
type roster { items []int, next int }

// rosterStep: 0 adds a row with the next key at the end; 1 drops the first
// row, so every other row moves up one.
func rosterStep(s roster, e int) Decision[roster, int] {
	if e == 0 {
		return Enter[roster]{Next: roster{items: s.items.Append(s.next), next: s.next + 1}}
	}
	if len(s.items) == 0 {
		return Enter[roster]{Next: s}
	}
	Enter[roster]{Next: roster{items: s.items[1:], next: s.next}}
}

func rosterTimer(s roster) Option[Timeout[int]] { None }

func rosterWork(s roster) Option[func(send func(e int))] { None }

func rosterMachine(n int) Machine[roster, int, int] {
	let mut items = []int{}
	for k in 0..n {
		items = items.Append(k)
	}
	Machine[roster, int, int]{Initial: roster{items: items, next: n}, Step: rosterStep, After: rosterTimer, Work: rosterWork}
}

// shownRows is the model of the rows a list writes, by brute force over
// every row: row i is written when its box, grown by Overscan rows on each
// side, overlaps the viewport [off, off+height) (an empty viewport at off
// overlaps the boxes whose inside holds off).
func shownRows(count int, rh float64, off float64, height float64) []int {
	let mut out = []int{}
	for i in 0..count {
		let top = float64(i-Overscan) * rh
		let bottom = float64(i+1+Overscan) * rh
		if bottom > off && top < off+height {
			out = out.Append(i)
		}
	}
	out
}

// RowsAreTheCutEach: a long keyed list of rows with a toggle each, under
// drawn scrolls and resizes, adds at the end, drops of the first row and
// toggles of rows on the screen: after each step the list on the test host
// is the full list cut to the rows its viewport shows (shownRows), each
// with its toggle as the model keeps it by key (a row that leaves the
// rows written starts off when it returns), and the pass ran one row
// function per row written: the work grows with the viewport, not with the
// count (a list of 1,000 runs as few rows as one of 50).
law RowsAreTheCutEach(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		rowsFollow(seed, steps, m)
	}
}

func rowsFollow(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let sizes = []int{0, 3, 50, 1000}
	let n = sizes[draw(&r, len(sizes))]
	let rh = float64(draw(&r, 40) + 10)
	let view = func(f *Frame[int], s roster) {
		Pressable(f, "add", 0) {
			Text(f, "+")
		}
		Pressable(f, "drop", 1) {
			Text(f, "-")
		}
		Rows(f, "list", len(s.items), Length(rh), func(i int) Key { ByInt(s.items[i]) }) func(i int) {
			let fl = NewFlag(f, false)
			Toggle(f, fl, "row \(s.items[i])")
		}
	}
	let a = actor.StartMachine(rosterMachine(n), 1, func(o int) {})
	let mut h = NewTestHost(a, view, m, 4) catch {
	case BadPatch:
		return false
	}
	let mut model = StateOf(&h)
	let mut off = 0.0
	let mut height = 0.0
	let mut on = Map[int, bool]{}
	for _ in 0..(steps%24+24)%24+1 {
		let shown = shownRows(len(model.items), rh, off, height)
		let mut act Act = SettleAll
		match draw(&r, 4) {
		case 0:
			off = float64(draw(&r, len(model.items)*int(rh)+1))
			height = float64(draw(&r, 300))
			act = ScrollOn{Label: "list", Offset: Length(off), Height: Length(height)}
		case 1:
			act = TapOn{Label: "add"}
			model = machines.Next(model, rosterStep(model, 0))
		case 2:
			act = TapOn{Label: "drop"}
			model = machines.Next(model, rosterStep(model, 1))
		case _:
			if len(shown) > 0 {
				let k = model.items[shown[draw(&r, len(shown))]]
				act = TapOn{Label: "row \(k)"}
				on[k] = !(on.Get(k) == (Some{Value: true}))
			}
		}
		Play(&h, []Act{act}) catch {
		case _:
			return false
		}
		let now = shownRows(len(model.items), rh, off, height)
		let mut kept = Map[int, bool]{}
		let mut rows = []Shape[int]{}
		for i in now {
			let k = model.items[i]
			let lit = on.Get(k) == (Some{Value: true})
			if lit {
				kept[k] = true
			}
			rows = rows.Append(Shape[int]{Node: ToggleNode{Label: "row \(k)", On: lit}, Kids: []Shape[int]{}})
		}
		on = kept
		let mut first = len(model.items)
		if len(now) > 0 {
			first = now[0]
		}
		let want = Shape[int]{Node: RowsNode{Label: "list", Count: len(model.items), RowHeight: Length(rh), First: first, Offset: Length(off)}, Kids: rows}
		let screen = Screen(&h)
		if StateOf(&h) != model || len(screen) != 3 || !SameShapes(screen[2:], []Shape[int]{want}) {
			return false
		}
		if RowRuns(&h) != len(now) || RowRuns(&h) > int(height/rh)+2+2*Overscan {
			return false
		}
	}
	true
}

// places are the addresses the router app knows, by index; "/nowhere"
// is one it does not know.
let places = []string{"/", "/a", "/b?x=1", "/c#top", "/a/b?q=2#f"}

// placeOf is the index of u in places, None for an address the app does
// not know.
func placeOf(u URL) Option[int] {
	for i, p in places {
		if Href(u) == p {
			return Some{Value: i}
		}
	}
	None
}

// routeStep: the signal is the index of the place the app shows.
func routeStep(s int, e int) Decision[int, int] { Enter[int]{Next: e} }

func routeTimer(s int) Option[Timeout[int]] { None }

func routeWork(s int) Option[func(send func(e int))] { None }

func routeMachine() Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: routeStep, After: routeTimer, Work: routeWork}
}

// home is the router app's fallback: an address it does not know shows
// "/". It is written after placeOf, so it takes only what placeOf leaves.
func home(u URL) Option[int] { Some{Value: 0} }

// routeView shows the place at s.
func routeView(f *Frame[int], s int) {
	OnURL(f, placeOf)
	OnURL(f, home)
	Text(f, "at \(places[s])")
}

// HrefParses: ParseURL reads back what Href prints, for drawn paths,
// queries and fragments that hold no '?' or '#' (a path never does).
law HrefParses(seed int) {
	let mut r = seeded(seed)
	let parts = []string{"", "a", "b/c", "x=1", "q=2&y", "top"}
	let u = URL{Path: "/" + parts[draw(&r, len(parts))], Query: parts[draw(&r, len(parts))], Fragment: parts[draw(&r, len(parts))]}
	ParseURL(Href(u)) == u
}

// NavigationFollowsModel (H7): over drawn navigations of the user (to a
// place the app knows, or to one it does not) and presses of back, on the
// test host of a router app, the history is a model stack: its current
// place and depth are the model's after each step, back at the first
// entry does nothing, and the app shows the place of the last change it
// knows ("/" for one it does not: its second OnURL takes what the first
// leaves), which reached it as URLChanged.
law NavigationFollowsModel(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		navigationFollows(seed, steps, m)
	}
}

func navigationFollows(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let a = actor.StartMachine(routeMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, routeView, m, 4) catch {
	case BadPatch:
		return false
	}
	let mut stack = []string{"/"}
	let mut shown = 0
	for _ in 0..(steps%16+16)%16+1 {
		let mut act Act = GoBack
		if draw(&r, 3) != 0 {
			let mut href = "/nowhere"
			if draw(&r, 4) != 0 {
				href = places[draw(&r, len(places))]
			}
			act = NavigateTo{Href: href}
			stack = stack.Append(href)
		} else if len(stack) > 1 {
			let mut kept = []string{}
			for i in 0..len(stack)-1 {
				kept = kept.Append(stack[i])
			}
			stack = kept
		} else {
			act = GoBack
		}
		Play(&h, []Act{act}) catch {
		case _:
			return false
		}
		let top = stack[len(stack)-1]
		match placeOf(ParseURL(top)) {
		case Some[int] as p:
			shown = p.Value
		case None:
			shown = 0
		}
		if Href(Current(History(&h))) != top || Depth(History(&h)) != len(stack)-1 || StateOf(&h) != shown {
			return false
		}
		Play(&h, []Act{ExpectOn{At: WithText{Text: "at \(places[shown])"}, Is: ToExist}}) catch {
		case _:
			return false
		}
	}
	true
}

// capA, capB and capC are the capabilities the loads of LoadUsesTheBoundService
// need (H8b): each gives its provider's tag.
// law-exempt: a law's test capability, whose one operation gives its provider's tag and nothing else.
type capA { tagA() int }

// law-exempt: a law's test capability, whose one operation gives its provider's tag and nothing else.
type capB { tagB() int }

// law-exempt: a law's test capability, whose one operation gives its provider's tag and nothing else.
type capC { tagC() int }

// aIs, bIs and cIs are their providers, by tag.
type aIs { v int }

type bIs { v int }

type cIs { v int }

func tagA(p aIs) int { p.v }

func tagB(p bIs) int { p.v }

func tagC(p cIs) int { p.v }

// boundLoad is one drawn load: the capabilities its fetch needs (bit 0 A,
// bit 1 B, bit 2 C) and whether the view writes an inner with around it.
type boundLoad { set int, inner bool }

// The fetches, one per set of capabilities: each gives the tags of the
// providers it ran with (A ones, B tens, C hundreds).
func fetchNone() int { 0 }

func fetchA() int needs capA { capA.tagA() }

func fetchB() int needs capB { 10 * capB.tagB() }

func fetchAB() int needs capA | capB { capA.tagA() + 10*capB.tagB() }

func fetchC() int needs capC { 100 * capC.tagC() }

func fetchAC() int needs capA | capC { capA.tagA() + 100*capC.tagC() }

func fetchBC() int needs capB | capC { 10*capB.tagB() + 100*capC.tagC() }

func fetchABC() int needs capA | capB | capC { capA.tagA() + 10*capB.tagB() + 100*capC.tagC() }

// loadFor writes load i with the fetch of its set; its signal is
// 1000*(i+1) plus the fetch's tags.
func loadFor(f *Frame[int], i int, set int) needs capA | capB | capC {
	let base = 1000 * (i + 1)
	match set {
	case 1:
		Load(f, ByInt(i), func() int needs capA { base + fetchA() })
	case 2:
		Load(f, ByInt(i), func() int needs capB { base + fetchB() })
	case 3:
		Load(f, ByInt(i), func() int needs capA | capB { base + fetchAB() })
	case 4:
		Load(f, ByInt(i), func() int needs capC { base + fetchC() })
	case 5:
		Load(f, ByInt(i), func() int needs capA | capC { base + fetchAC() })
	case 6:
		Load(f, ByInt(i), func() int needs capB | capC { base + fetchBC() })
	case 7:
		Load(f, ByInt(i), func() int needs capA | capB | capC { base + fetchABC() })
	case _:
		Load(f, ByInt(i), func() int { base + fetchNone() })
	}
}

// boundView writes each load under a Box of its own, in an inner with of
// the other provider of each pair when it is drawn so.
func boundView(f *Frame[int], plan []boundLoad, outer []int) needs capA | capB | capC {
	for i, l in plan {
		Box(f, Plain()) {
			if l.inner {
				with context { capA: aIs{v: 3 - outer[0]}, capB: bIs{v: 3 - outer[1]}, capC: cIs{v: 3 - outer[2]} } {
					loadFor(f, i, l.set)
				}
			} else {
				loadFor(f, i, l.set)
			}
		}
	}
	Text(f, "loads")
}

// logStep keeps each signal.
func logStep(s []int, e int) Decision[[]int, int] { Enter[[]int]{Next: s.Append(e)} }

func logTimer(s []int) Option[Timeout[int]] { None }

func logWork(s []int) Option[func(send func(e int))] { None }

func logMachine() Machine[[]int, int, int] {
	Machine[[]int, int, int]{Initial: []int{}, Step: logStep, After: logTimer, Work: logWork}
}

// LoadUsesTheBoundService (H8b): over drawn views of one to three loads,
// each under a component of its own, each needing a drawn subset of three
// capabilities, with a drawn pair of providers per capability, every
// fetch's result comes from the provider in force where its Load was
// called: the one the with around NewTestHost bound, or the one of an
// inner with the view wrote around the load's subtree. Each fetch runs
// once, on the host's task, after the pass.
law LoadUsesTheBoundService(seed int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		loadsBound(seed, m)
	}
}

func loadsBound(seed int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let mut plan = []boundLoad{}
	for _ in 0..draw(&r, 3)+1 {
		plan = plan.Append(boundLoad{set: draw(&r, 8), inner: draw(&r, 2) == 0})
	}
	let outer = []int{draw(&r, 2) + 1, draw(&r, 2) + 1, draw(&r, 2) + 1}
	let mut want = []int{}
	for i, l in plan {
		let mut code = 1000 * (i + 1)
		for c in 0..3 {
			if l.set/[]int{1, 2, 4}[c]%2 == 1 {
				let mut tag = outer[c]
				if l.inner {
					tag = 3 - outer[c]
				}
				code = code + tag*[]int{1, 10, 100}[c]
			}
		}
		want = want.Append(code)
	}
	with context { capA: aIs{v: outer[0]}, capB: bIs{v: outer[1]}, capC: cIs{v: outer[2]} } {
		let a = actor.StartMachine(logMachine(), 4, func(o int) {})
		let mut h = NewTestHost(a, func(f *Frame[int], s []int) needs capA | capB | capC { boundView(f, plan, outer) }, m, 8) catch {
		case BadPatch:
			return false
		}
		Play(&h, []Act{SettleAll}) catch {
		case _:
			return false
		}
		let got = StateOf(&h)
		if len(got) != len(plan) {
			return false
		}
		for g in got {
			let mut seen = false
			for w in want {
				seen = seen || w == g
			}
			if !seen {
				return false
			}
		}
	}
	true
}

// cursorStep: the signal is the cursor's row.
func cursorStep(s int, e int) Decision[int, int] { Enter[int]{Next: e} }

func cursorTimer(s int) Option[Timeout[int]] { None }

func cursorWork(s int) Option[func(send func(e int))] { None }

func cursorMachine() Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: cursorStep, After: cursorTimer, Work: cursorWork}
}

// keptOffset is the model of the offset that shows row k whole, by its
// two candidates: the offset stays when the row is inside the viewport;
// else the viewport's top or its bottom meets the row's, whichever is
// nearer, and its top when the viewport is shorter than a row.
func keptOffset(k int, rh float64, off float64, height float64) float64 {
	let top = float64(k) * rh
	let bottom = top + rh
	if height >= rh && top >= off && bottom <= off+height {
		return off
	}
	if height < rh {
		return top
	}
	let up = top
	let down = bottom - height
	if (off-up)*(off-up) <= (down-off)*(down-off) {
		return up
	}
	down
}

// RowsKeepTheCursor (GP1b): a long list that keeps its cursor's row in
// view (RowsKeeping), under drawn host scrolls and resizes and drawn
// moves of the cursor, some past the list's end: after each step the
// node's offset is the model's, where a move brings the row whole into
// view by the least move and a scroll of the host's stays until the
// cursor moves again, and the list shows the rows that offset shows.
law RowsKeepTheCursor(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		cursorKept(seed, steps, m)
	}
}

func cursorKept(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let sizes = []int{0, 3, 50, 1000}
	let n = sizes[draw(&r, len(sizes))]
	let rh = float64(draw(&r, 40) + 10)
	let view = func(f *Frame[int], s int) {
		OnKey(f, func(k KeyPress) Option[int] {
			for i in 0..n+1 {
				if k.Name == "\(i)" {
					return Some{Value: i}
				}
			}
			None
		})
		RowsKeeping(f, "list", n, Length(rh), s, func(i int) Key { ByInt(i) }) func(i int) {
			Text(f, "row \(i)")
		}
	}
	let a = actor.StartMachine(cursorMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, view, m, 4) catch {
	case BadPatch:
		return false
	}
	let mut off = 0.0
	let mut height = 0.0
	for _ in 0..(steps%24+24)%24+1 {
		let mut act Act = SettleAll
		if draw(&r, 2) == 0 {
			off = float64(draw(&r, n*int(rh)+1))
			height = float64(draw(&r, 300))
			act = ScrollOn{Label: "list", Offset: Length(off), Height: Length(height)}
		} else {
			let k = draw(&r, n+1)
			act = KeyIn{Press: KeyPress{Name: "\(k)", Mods: Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}
			if k != StateOf(&h) && k < n {
				off = keptOffset(k, rh, off, height)
			}
		}
		Play(&h, []Act{act}) catch {
		case _:
			return false
		}
		let now = shownRows(n, rh, off, height)
		let mut rows = []Shape[int]{}
		for i in now {
			rows = rows.Append(leaf(TextNode{Value: "row \(i)", Style: Plain()}))
		}
		let mut first = n
		if len(now) > 0 {
			first = now[0]
		}
		let want = Shape[int]{Node: RowsNode{Label: "list", Count: n, RowHeight: Length(rh), First: first, Offset: Length(off)}, Kids: rows}
		if !SameShapes(Screen(&h), []Shape[int]{want}) {
			return false
		}
	}
	true
}

// escapedForm is whether e is a component Escape may write: every byte
// unreserved, or a '%' with two upper-case hex digits after it.
func escapedForm(e string) bool {
	let mut i = 0
	for i < len(e) {
		let c = e[i]
		if c == '%' {
			if i+2 >= len(e) || !strings.Contains("0123456789ABCDEF", e[i+1:i+2]) || !strings.Contains("0123456789ABCDEF", e[i+2:i+3]) {
				return false
			}
			i = i + 3
		} else if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '.' || c == '_' || c == '~' {
			i = i + 1
		} else {
			return false
		}
	}
	true
}

// EscapeRoundTrips: Escape writes only unreserved bytes and upper-case
// %XX, so no '/', '?', '#', '&', '=' or '+' of s survives it; Unescape
// reads it back, and reads %xx in lower case too (hex.Encode's); a text
// with no '%' is its own unescape, and a '%' not followed by two hex
// digits stays as it is ("%4g" is three bytes).
law EscapeRoundTrips(s string, t string) {
	let e = Escape(s)
	let mut lower = ""
	for i in 0..len(s) {
		lower = lower + "%" + hex.Encode(s[i:i+1])
	}
	let plain = strings.ReplaceAll(t, "%", "")
	escapedForm(e) && Unescape(e) == s && Unescape(lower) == s && Unescape(plain) == plain && Unescape(s+"%4g"+plain) == Unescape(s)+"%4g"+plain
}

// SegmentsReadPathOf: Segments reads back the segments PathOf writes,
// but for the empty ones it skips, whatever bytes they hold; the path
// holds no '?' or '#', so ParseURL keeps it whole.
law SegmentsReadPathOf(xs []string) {
	let path = PathOf(xs)
	let mut want = []string{}
	for x in xs {
		if x != "" {
			want = want.Append(x)
		}
	}
	let got = Segments(URL{Path: path, Query: "", Fragment: ""})
	if len(got) != len(want) || ParseURL(path).Path != path {
		return false
	}
	for i, x in want {
		if got[i] != x {
			return false
		}
	}
	true
}

// queryRecord is QueryRoundTrips' record: a field of each scalar kind, a
// key that needs escaping (a space and an '&'), an optional field and a list.
type queryRecord {
	Name  string,
	Sort  string "sort by&",
	Page  int,
	Big   uint64,
	Ratio float64,
	On    bool,
	Note  json.Optional[string],
	Tags  []string,
}

// queryNested has a field with no query form.
type queryNested { Name string, Inner queryRecord }

// QueryRoundTrips: QueryOf reads back the query WithQuery writes, through
// Href and ParseURL, for drawn records whose texts hold any byte; a
// record field has no query form and fails QueryShape naming its key, and
// so does a value that is not a record, with no key.
law QueryRoundTrips(seed int, a string, b string, tags []string) {
	let mut r = seeded(seed)
	let mut note json.Optional[string] = json.Absent
	if draw(&r, 2) == 0 {
		note = json.Present{Value: b + a}
	}
	let mut ts = tags
	if len(ts) == 0 {
		ts = []string{a}
	}
	let v = queryRecord{Name: a, Sort: b, Page: draw(&r, 2001) - 1000, Big: uint64(draw(&r, 1000000)) * 18446744073709, Ratio: float64(draw(&r, 2001)-1000) / 8.0, On: draw(&r, 2) == 0, Note: note, Tags: ts}
	let u = WithQuery(URL{Path: "/list", Query: "", Fragment: "top"}, v) catch {
	case QueryShape:
		return false
	}
	let back = QueryOf[queryRecord](ParseURL(Href(u))) catch {
	case _:
		return false
	}
	let nested = EncodeQuery(queryNested{Name: a, Inner: v}) catch {
	case QueryShape as q:
		q.Key
	}
	let scalar = EncodeQuery(draw(&r, 9)) catch {
	case QueryShape as q:
		"none" + q.Key
	}
	back == v && u.Path == "/list" && u.Fragment == "top" && nested == "inner" && scalar == "none"
}

// replyWork is the work of the reply app's state s: while s is under
// last, it waits for the law to release one reply on gate and sends the
// next state, as a request's reply arrives through a machine's work.
func replyWork(gate queue.Queue[int], last int) func(s int) Option[func(send func(e int))] {
	func(s int) Option[func(send func(e int))] {
		if s >= last {
			return None
		}
		Some{Value: func(send func(e int)) {
			let _ = gate.Pop() catch {
			case queue.Closed:
				return
			}
			send(s + 1)
		}}
	}
}

func replyStep(s int, e int) Decision[int, int] { Enter[int]{Next: e} }

func replyTimer(s int) Option[Timeout[int]] { None }

func replyMachine(gate queue.Queue[int], last int) Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: replyStep, After: replyTimer, Work: replyWork(gate, last)}
}

// replyView shows the reply app's state.
func replyView(f *Frame[int], s int) { Text(f, "at \(s)") }

// WorkReplyIsShown (DOMAIN PX3a): a reply that reaches the actor through
// its machine's work, not through an event of the loop, is on the test
// host's screen after a Settle, one reply at a time; before the first,
// the screen shows the first state.
law WorkReplyIsShown(n int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		replyShown(n, m)
	}
}

func replyShown(n int, m time.Manual) bool needs Scheduler {
	let last = (n%3+3)%3 + 1
	let gate = queue.New[int](last)
	let a = actor.StartMachine(replyMachine(gate, last), 1, func(o int) {})
	let mut h = NewTestHost(a, replyView, m, 4) catch {
	case BadPatch:
		return false
	}
	if !SameShapes(Screen(&h), []Shape[int]{leaf(TextNode{Value: "at 0", Style: Plain()})}) {
		return false
	}
	for i in 0..last {
		gate.Push(i) catch {
		case queue.Closed:
			return false
		}
		let _ = actor.WaitFor(a, func(s int) bool { s == i+1 }) catch {
		case actor.Stopped:
			return false
		}
		Settle(&h) catch {
		case _:
			return false
		}
		if !SameShapes(Screen(&h), []Shape[int]{leaf(TextNode{Value: "at \(i + 1)", Style: Plain()})}) {
			return false
		}
	}
	true
}

// WatcherShowsWorkReplies (DOMAIN PX3a): a Session, as Run drives it,
// shows each reply its actor's work commits with no event of the host's:
// the session's watcher posts Committed, and the Step of it writes the
// reply's text (a Committed of a state a pass showed already writes
// nothing, and the law takes the next). The law waits for each post; a session that never posts hangs the law, which
// the test's deadline names.
law WatcherShowsWorkReplies(n int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		watchReplies(n)
	}
}

func watchReplies(n int) bool needs Scheduler {
	let last = (n%3+3)%3 + 1
	let gate = queue.New[int](last)
	let posted = queue.New[Event[int]](8)
	let a = actor.StartMachine(replyMachine(gate, last), 1, func(o int) {})
	let (s, first) = Start(a, replyView, func(ev Event[int]) {
		posted.Push(ev) catch {
		case queue.Closed:
		}
	})
	let mut session = s
	if !writesText(first, "at 0") {
		return false
	}
	for i in 1..last+1 {
		gate.Push(i) catch {
		case queue.Closed:
			return false
		}
		let mut shown = false
		for !shown {
			let ev = posted.Pop() catch {
			case queue.Closed:
				return false
			}
			match ev {
			case Committed:
			case _:
				return false
			}
			let ops = Step(&session, ev) catch {
			case actor.Stopped:
				return false
			}
			shown = writesText(ops, "at \(i)")
		}
	}
	true
}

// writesText is whether ops write a text node of value v.
func writesText(ops []Op[int], v string) bool {
	for op in ops {
		let mut node Option[Node[int]] = None
		match op {
		case Insert[int] as x:
			node = Some{Value: x.Node}
		case Set[int] as x:
			node = Some{Value: x.Node}
		case _:
		}
		match node {
		case Some[Node[int]] as x:
			match x.Value {
			case TextNode as t:
				if t.Value == v {
					return true
				}
			case _:
			}
		case None:
		}
	}
	false
}

// Boom is the crash app's typed failure: the count when its step failed.
type Boom { N int }

// crashStep: 0 adds one; 1 is a defect of the step; 2 fails the step with
// Boom; any other signal changes nothing.
func crashStep(s int, e int) Decision[int, int] fails Boom {
	if e == 1 {
		Unreachable("crash app: a defect, on purpose")
	}
	if e == 2 {
		return Boom{N: s}
	}
	if e == 0 {
		return Enter[int]{Next: s + 1}
	}
	Enter[int]{Next: s}
}

func crashTimer(s int) Option[Timeout[int]] { None }

func crashWork(s int) Option[func(send func(e int))] { None }

func crashMachine() Machine[int, int, int, Boom] {
	Machine[int, int, int, Boom]{Initial: 0, Step: crashStep, After: crashTimer, Work: crashWork}
}

// crashAppView shows the count, a button per signal, and a check box whose
// flag is view-local state.
func crashAppView(f *Frame[int], s int) {
	Text(f, "count \(s)")
	Pressable(f, "add", 0) {
		Text(f, "+")
	}
	Pressable(f, "defect", 1) {
		Text(f, "!")
	}
	Pressable(f, "fail", 2) {
		Text(f, "x")
	}
	let fl = NewFlag(f, false)
	Toggle(f, fl, "keep")
}

// crashText is the crash view's line for c.
func crashText(c Crash[Boom]) string {
	match c {
	case DefectCrash:
		"crashed: defect"
	case FailureCrash[Boom] as x:
		match x.Failure {
		case Boom as b:
			"crashed: failure \(b.N)"
		}
	}
}

// crashOwnView is the crash app's crash view: what crashed, and a reload.
func crashOwnView(f *Frame[int], c Crash[Boom]) {
	Text(f, crashText(c))
	Pressable(f, "reload", 3) {
		Text(f, "reload")
	}
}

func pressShape(label string, on int, text string) Shape[int] {
	Shape[int]{Node: PressableNode{Label: label, On: on, Style: Plain()}, Kids: []Shape[int]{leaf(TextNode{Value: text, Style: Plain()})}}
}

// crashAppShapes is the model of the app's screen at count n with the
// check box at on.
func crashAppShapes(n int, on bool) []Shape[int] {
	[]Shape[int]{leaf(TextNode{Value: "count \(n)", Style: Plain()}), pressShape("add", 0, "+"), pressShape("defect", 1, "!"), pressShape("fail", 2, "x"), leaf(ToggleNode{Label: "keep", On: on})}
}

// CrashShowsTheCrashView (H6a): under drawn taps of an app whose step can
// add, defect or fail with a typed failure, and of the check box, the
// screen is the app's view of the model's count while the actor runs; once
// it crashed, the crash view of the model's crash, which only a reload
// leaves; the report ran once per crash, before the crash view showed; and
// the test host's crash is the model's.
law CrashShowsTheCrashView(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		crashShown(seed, steps, m)
	}
}

func crashShown(seed int, steps int, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let reports = sync.NewRef(0)
	let crashes = Crashes[int, Boom]{View: crashOwnView, Report: func(c Crash[Boom]) {
		reports.Update(func(n int) int { n + 1 })
	}}
	let mut h = NewAppTestHost(crashMachine(), 1, crashAppView, crashes, m, 4) catch {
	case BadPatch:
		return false
	}
	let mut count = 0
	let mut on = false
	let mut crash Option[Crash[Boom]] = None
	let mut crashed = 0
	for _ in 0..(steps%24+24)%24+1 {
		let pick = draw(&r, 4)
		let mut label = "reload"
		match crash {
		case Some[Crash[Boom]]:
			crash = None
			count = 0
			on = false
		case None:
			if pick == 0 {
				label = "add"
				count = count + 1
			} else if pick == 1 {
				label = "defect"
				crash = Some{Value: DefectCrash}
				crashed = crashed + 1
			} else if pick == 2 {
				label = "fail"
				crash = Some{Value: FailureCrash[Boom]{Failure: Boom{N: count}}}
				crashed = crashed + 1
			} else {
				label = "keep"
				on = !on
			}
		}
		Play(&h, []Act{TapOn{Label: label}}) catch {
		case _:
			return false
		}
		let want = match crash {
		case Some[Crash[Boom]] as c:
			[]Shape[int]{leaf(TextNode{Value: crashText(c.Value), Style: Plain()}), pressShape("reload", 3, "reload")}
		case None:
			crashAppShapes(count, on)
		}
		if !SameShapes(Screen(&h), want) || reports.Get() != crashed || CrashOf(&h) != crash {
			return false
		}
	}
	true
}

// ReloadIsInitial (H6a): after drawn adds and presses of the check box, a
// crash and a reload, the app's screen is a fresh test host's first
// screen: the actor starts from the machine's initial state and the view's
// own state from its initial values.
law ReloadIsInitial(seed int, defect bool) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		reloadInitial(seed, defect, m)
	}
}

func reloadInitial(seed int, defect bool, m time.Manual) bool needs Scheduler {
	let mut r = seeded(seed)
	let mut h = NewAppTestHost(crashMachine(), 1, crashAppView, Crashes[int, Boom]{View: crashOwnView, Report: func(c Crash[Boom]) {}}, m, 4) catch {
	case BadPatch:
		return false
	}
	let mut script = []Act{}
	for _ in 0..draw(&r, 6) {
		script = script.Append(TapOn{Label: if draw(&r, 2) == 0 { "add" } else { "keep" }})
	}
	script = script.Append(TapOn{Label: if defect { "defect" } else { "fail" }})
	script = script.Append(TapOn{Label: "reload"})
	Play(&h, script) catch {
	case _:
		return false
	}
	let mut fresh = NewAppTestHost(crashMachine(), 1, crashAppView, Crashes[int, Boom]{View: crashOwnView, Report: func(c Crash[Boom]) {}}, m, 4) catch {
	case BadPatch:
		return false
	}
	SameShapes(Screen(&h), Screen(&fresh)) && CrashOf(&h) == None
}

// workCrashStep: 1 is a defect of the step; 5 enters the state -1, whose
// work defects once the law releases it.
func workCrashStep(s int, e int) Decision[int, int] fails Boom {
	if e == 1 {
		Unreachable("crash app: a defect, on purpose")
	}
	if e == 5 {
		return Enter[int]{Next: -1}
	}
	Enter[int]{Next: s}
}

func workCrashWork(gate queue.Queue[int]) func(s int) Option[func(send func(e int))] {
	func(s int) Option[func(send func(e int))] {
		if s != -1 {
			return None
		}
		Some{Value: func(send func(e int)) {
			let _ = gate.Pop() catch {
			case queue.Closed:
				return
			}
			Unreachable("crash app: a defect of the work, on purpose")
		}}
	}
}

// keyView is the session law's view: its key presses are its signals, by
// the key's name ("1", "5"), and it shows the state.
func keyView(f *Frame[int], s int) {
	OnKey(f, func(k KeyPress) Option[int] {
		if k.Name == "1" {
			return Some{Value: 1}
		}
		if k.Name == "5" {
			return Some{Value: 5}
		}
		None
	})
	Text(f, "at \(s)")
}

// keyCrashView is its crash view: any key reloads.
func keyCrashView(f *Frame[int], c Crash[Boom]) {
	OnKey(f, func(k KeyPress) Option[int] { Some{Value: 0} })
	Text(f, "crashed")
}

func key(name string) Event[int] {
	KeyDown{Press: KeyPress{Name: name, Mods: Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}
}

// endedOf takes the posted events up to the Ended of run, stepping the
// others, and is that Ended's patch.
func endedOf(session *Session[int, int, Decision[int, int], Boom], posted queue.Queue[Event[int]], run int) Option[[]Op[int]] {
	for {
		let ev = posted.Pop() catch {
		case queue.Closed:
			return None
		}
		let ops = Step(session, ev) catch {
		case actor.Stopped:
			return None
		}
		match ev {
		case Ended as x:
			if x.Run == run {
				return Some{Value: ops}
			}
		case _:
		}
	}
}

// SessionCrashFollowsTheEnd (H6a): an app's session, as RunApp drives it,
// shows the crash view after a signal whose step defects and reports it
// once, also when the crashed actor's Ended comes after (it changes
// nothing); a reload's patch shows the fresh actor, and the Ended of an
// actor a reload replaced changes nothing either; a defect of the fresh
// actor's work, which no signal of the loop caused, reaches the loop as
// Ended and shows the crash view. Each crash is reported once.
law SessionCrashFollowsTheEnd(n int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		crashFollows()
	}
}

func crashFollows() bool needs Scheduler {
	let gate = queue.New[int](1)
	let posted = queue.New[Event[int]](64)
	let reports = sync.NewRef(0)
	let mach = Machine[int, int, int, Boom]{Initial: 0, Step: workCrashStep, After: replyTimer, Work: workCrashWork(gate)}
	let crashes = Crashes[int, Boom]{View: keyCrashView, Report: func(c Crash[Boom]) {
		reports.Update(func(k int) int { k + 1 })
	}}
	let (s, first) = StartApp(mach, 1, keyView, crashes, func(ev Event[int]) {
		posted.Push(ev) catch {
		case queue.Closed:
		}
	})
	let mut session = s
	if !writesText(first, "at 0") {
		return false
	}
	// A defect of a step; its actor's Ended comes before the reload.
	let a = Step(&session, key("1")) catch {
	case actor.Stopped:
		return false
	}
	if !writesText(a, "crashed") || reports.Get() != 1 || !endsQuiet(&session, posted, 0) || reports.Get() != 1 {
		return false
	}
	let b = Step(&session, key("r")) catch {
	case actor.Stopped:
		return false
	}
	// A defect of the second actor; its Ended comes after the reload.
	let c = Step(&session, key("1")) catch {
	case actor.Stopped:
		return false
	}
	let d = Step(&session, key("r")) catch {
	case actor.Stopped:
		return false
	}
	if !writesText(b, "at 0") || !writesText(c, "crashed") || !writesText(d, "at 0") || !endsQuiet(&session, posted, 1) || reports.Get() != 2 {
		return false
	}
	// A defect of the third actor's work.
	let e = Step(&session, key("5")) catch {
	case actor.Stopped:
		return false
	}
	if !writesText(e, "at -1") {
		return false
	}
	gate.Push(0) catch {
	case queue.Closed:
		return false
	}
	match endedOf(&session, posted, 2) {
	case Some[[]Op[int]] as ops:
		writesText(ops.Value, "crashed") && reports.Get() == 3
	case None:
		false
	}
}

// endsQuiet is whether the Ended of run, when the loop takes it, changes
// nothing on the screen.
func endsQuiet(session *Session[int, int, Decision[int, int], Boom], posted queue.Queue[Event[int]], run int) bool {
	match endedOf(session, posted, run) {
	case Some[[]Op[int]] as ops:
		len(ops.Value) == 0
	case None:
		false
	}
}

// statsApp is a pass's parameters for StatsCountEveryPhase: texts, paint
// ops, rows of a list, whether the group stops, and the load's key.
type statsApp { texts int, paints int, rows int, stops bool, key int }

// Halt is the stats app's group's failure.
type Halt {}

func haltIf(b bool) fails Halt {
	if b {
		return Halt
	}
}

func statsStep(s int, e int) Decision[int, int] { Enter[int]{Next: e} }

func statsMachine() Machine[int, int, int] {
	Machine[int, int, int]{Initial: 0, Step: statsStep, After: replyTimer, Work: replyWork(queue.New[int](1), 0)}
}

// statsView shows the app of apps[s]; the key "i" signals i.
func statsView(apps []statsApp) func(f *Frame[int], s int) {
	func(f *Frame[int], s int) {
		let st = apps[s]
		OnKey(f, func(k KeyPress) Option[int] {
			for i in 0..len(apps) {
				if k.Name == "\(i)" {
					return Some{Value: i}
				}
			}
			None
		})
		Column(f, Plain()) {
			for j in 0..st.texts {
				Text(f, "t\(j)")
			}
			Canvas(f, "c", 40, 40) func(p *Paint) {
				for j in 0..st.paints {
					Fill(p, RectPath(float64(j), 0.0, 1.0, 1.0), tone(j, j))
				}
			}
			Rows(f, "list", st.rows, 10, func(i int) Key { ByInt(i) }) func(i int) {
				Text(f, "r\(i)")
			}
			Boundary(f) {
				Text(f, "in")
				try haltIf(st.stops)
			} catch {
			case Halt:
				Text(f, "out")
			}
			let key = st.key
			Load(f, ByInt(key), func() int { s })
		}
	}
}

// opCounts is the patch's ops by kind (Insert, Move, Remove, Set) and the
// paint ops of the canvases it writes, counted from the patch itself.
func opCounts(ops []Op[int]) (int, int, int, int, int) {
	let mut ins = 0
	let mut mov = 0
	let mut rem = 0
	let mut set = 0
	let mut paint = 0
	for op in ops {
		let mut node Option[Node[int]] = None
		match op {
		case Insert[int] as x:
			ins = ins + 1
			node = Some{Value: x.Node}
		case Move[int]:
			mov = mov + 1
		case Remove[int]:
			rem = rem + 1
		case Set[int] as x:
			set = set + 1
			node = Some{Value: x.Node}
		}
		match node {
		case Some[Node[int]] as n:
			match n.Value {
			case CanvasNode as c:
				paint = paint + len(c.Paint)
			case _:
			}
		case None:
		}
	}
	(ins, mov, rem, set, paint)
}

// StatsCountEveryPhase (H6b): over drawn passes of an app with texts, a
// canvas, a list, a group that may stop and a load whose key may change,
// a session's stats of each pass are the model's: one signal (the step);
// the nodes the view wrote, the stopped group's text among them, and the
// rows run (the view); the nodes committed (the compose); the patch's ops
// by kind and its paint ops, as counted from the patch (the patch and the
// paint); a fetch and a cancel when the key changed (the loads); and the
// stopped group's call site once when it stopped.
law StatsCountEveryPhase(seed int, steps int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		statsFollow(seed, steps)
	}
}

func statsFollow(seed int, steps int) bool needs Scheduler {
	let mut r = seeded(seed)
	let mut apps = []statsApp{statsApp{texts: 0, paints: 0, rows: 0, stops: false, key: 0}}
	let n = (steps%12+12)%12 + 1
	for _ in 0..n {
		apps = apps.Append(statsApp{texts: draw(&r, 5), paints: draw(&r, 4), rows: draw(&r, 3) * 10, stops: draw(&r, 2) == 0, key: draw(&r, 2)})
	}
	let a = actor.StartMachine(statsMachine(), 1, func(o int) {})
	let (s, _) = Start(a, statsView(apps), func(ev Event[int]) {})
	let mut session = s
	let mut prev = apps[0]
	for i in 1..len(apps) {
		let ops = Step(&session, KeyDown{Press: KeyPress{Name: "\(i)", Mods: Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}) catch {
		case actor.Stopped:
			return false
		}
		let st = apps[i]
		let shown = len(shownRows(st.rows, 10.0, 0.0, 0.0))
		let stopped = if st.stops { 1 } else { 0 }
		let changed = if st.key != prev.key { 1 } else { 0 }
		let (ins, mov, rem, set, paint) = opCounts(ops)
		let want = Stats{Signals: 1, Written: 4 + st.texts + shown + stopped, Rows: shown, Skipped: 0, Stopped: stopped, Committed: 4 + st.texts + shown, Inserted: ins, Moved: mov, Removed: rem, Set: set, Painted: paint, Fetches: changed, Cancels: changed}
		let got = SessionStats(&session)
		if got != want || len(StoppedAt(&session)) != stopped {
			return false
		}
		// The paint ops are the canvas's when its paint changed.
		if st.paints != prev.paints && paint != st.paints {
			return false
		}
		prev = st
	}
	true
}

// slowApp's state is a list of the Slow signals it got; signal 0 adds a
// text, and a Slow is logged.
type slowLog { texts int, log []Slow }

type slowSignal = MoreText{} | WasSlow{S Slow}

func slowStep(s slowLog, e slowSignal) Decision[slowLog, int] {
	match e {
	case MoreText:
		Enter[slowLog]{Next: slowLog{texts: s.texts + 1, log: s.log}}
	case WasSlow as w:
		Enter[slowLog]{Next: slowLog{texts: s.texts, log: s.log.Append(w.S)}}
	}
}

func slowTimer(s slowLog) Option[Timeout[slowSignal]] { None }

func slowWork(s slowLog) Option[func(send func(e slowSignal))] { None }

// SlowAboveTheBudget (H6b): a view that asks for its slow passes with a
// budget of written nodes gets one Slow per pass of its input over it,
// with the count and the bound, and none for a pass of a commit it did
// not cause (the one that shows the log).
law SlowAboveTheBudget(seed int, bound int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		slowFollow(seed, (bound%5+5)%5+1)
	}
}

func slowFollow(seed int, bound int) bool needs Scheduler {
	let mut r = seeded(seed)
	let view = func(f *Frame[slowSignal], s slowLog) {
		OnSlow(f, Budget{Signals: 0, Written: bound, Committed: 0, Ops: 0, Painted: 0, Fetches: 0}, func(x Slow) slowSignal { WasSlow{S: x} })
		OnKey(f, func(k KeyPress) Option[slowSignal] { Some{Value: MoreText} })
		Text(f, "log \(len(s.log))")
		for j in 0..s.texts {
			Text(f, "t\(j)")
		}
	}
	let posted = queue.New[Event[slowSignal]](256)
	let a = actor.StartMachine(Machine[slowLog, slowSignal, int]{Initial: slowLog{texts: 0, log: []Slow{}}, Step: slowStep, After: slowTimer, Work: slowWork}, 1, func(o int) {})
	let (s, _) = Start(a, view, func(ev Event[slowSignal]) {
		posted.Push(ev) catch {
		case queue.Closed:
		}
	})
	let mut session = s
	let mut want = []Slow{}
	for _ in 0..draw(&r, 8)+1 {
		let _ = Step(&session, KeyDown{Press: KeyPress{Name: "k", Mods: Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}) catch {
		case actor.Stopped:
			return false
		}
		// The pass wrote the log's line and the texts.
		let texts = a.State().texts
		if texts+1 > bound {
			want = want.Append(Slow{Counter: "Written", Count: texts + 1, Bound: bound})
			// The pass that shows the Slow, a Committed's, is not judged:
			// the law takes the posted events until it shows it.
			let mut shown = false
			for !shown {
				let ev = posted.Pop() catch {
				case queue.Closed:
					return false
				}
				let ops = Step(&session, ev) catch {
				case actor.Stopped:
					return false
				}
				for op in ops {
					match op {
					case Set[slowSignal] as x:
						shown = shown || x.Node == TextNode{Value: "log \(len(want))", Style: Plain()}
					case _:
					}
				}
			}
		}
	}
	let log = a.State().log
	if len(log) != len(want) {
		return false
	}
	for i, x in want {
		if log[i] != x {
			return false
		}
	}
	true
}
