import core
import option
import slices
import time
import actor
import strings

// Canvas (H5c): a node whose content is a paint list, values a host
// replays: paths filled and stroked, under transforms and clips that nest.
// The list is part of the node, so a pass that paints the same list
// changes nothing, and a test or an agent reads what a canvas shows as
// data (the list is the screenshot).

// Seg is one segment of a path, in the canvas's coordinates (after the
// transforms that enclose it).
type Seg = MoveTo{X float64, Y float64} | LineTo{X float64, Y float64} | QuadTo{CX float64, CY float64, X float64, Y float64} | CubicTo{C1X float64, C1Y float64, C2X float64, C2Y float64, X float64, Y float64} | ClosePath

// ClosePath joins a path's last point to its last MoveTo.
type ClosePath {}

// Path is a list of segments.
type Path { Segs []Seg }

// RectPath is the closed path of the rectangle at x, y of w by h.
func RectPath(x float64, y float64, w float64, h float64) Path {
	Path{Segs: []Seg{MoveTo{X: x, Y: y}, LineTo{X: x + w, Y: y}, LineTo{X: x + w, Y: y + h}, LineTo{X: x, Y: y + h}, ClosePath}}
}

// Color is a colour with straight alpha, a byte each.
type Color { R uint8, G uint8, B uint8, A uint8 }

// Affine maps x, y to A*x + C*y + E, B*x + D*y + F (the canvas
// setTransform order).
type Affine { A float64, B float64, C float64, D float64, E float64, F float64 }

// Identity is the Affine that moves nothing.
func Identity() Affine { Affine{A: 1.0, B: 0.0, C: 0.0, D: 1.0, E: 0.0, F: 0.0} }

// Translate moves by dx, dy.
func Translate(dx float64, dy float64) Affine { Affine{A: 1.0, B: 0.0, C: 0.0, D: 1.0, E: dx, F: dy} }

// Scale scales by sx, sy about the origin.
func Scale(sx float64, sy float64) Affine { Affine{A: sx, B: 0.0, C: 0.0, D: sy, E: 0.0, F: 0.0} }

// PaintOp is one entry of a paint list. A PushTransform or a PushClip
// holds until its PopPaint; Transformed and Clipped write both, so a list
// a Canvas made is balanced. An ImageOp draws Part of the image the host
// finds at Src into the rectangle at X, Y of W by H.
type PaintOp = FillOp{Path Path, Color Color} | StrokeOp{Path Path, Color Color, Width float64} | PushTransform{M Affine} | PushClip{X float64, Y float64, W float64, H float64} | PopPaint | ImageOp{Src string, Part ImagePart, X float64, Y float64, W float64, H float64}

// ImagePart is what of an image a draw takes: all of it, or the region
// at X, Y of W by H in the image's pixels (a sprite of an atlas).
type ImagePart = WholeImage | ImageRegion{X float64, Y float64, W float64, H float64}

// WholeImage is all of an image.
type WholeImage {}

// PopPaint ends the innermost PushTransform or PushClip.
type PopPaint {}

// Paint is where a canvas's draw function paints. Only Canvas makes one,
// and it lives for one call of that function. A Frame's canvases all
// paint into the Frame's one Paint, a scratch kept from canvas to canvas
// and pass to pass: the ops, the segments of their paths in segs, and for
// each op the end of its path in segs. Canvas copies out what its draw
// added and cuts the scratch back, so a canvas costs its list and its
// segments, and a path built for one call (RectPath) is copied in and
// never kept.
type Paint { ops []PaintOp, segs []Seg, ends []int }

// PaintMatchesList: a drawn paint program on a canvas, over states a
// press moves to: after each press the test host's canvas shows exactly
// the list the program means at the actor's state, written without a
// Paint, its screenshot has a line for each node and each paint op, and
// the canvas is findable by its label. A second pass at the
// same state is an empty patch: an unchanged list repaints nothing. A
// second canvas, and a third written inside the second's draw, show
// exactly their own lists, though a frame's canvases paint into one scratch.
law PaintMatchesList(seed int, steps int) {
	let m = time.NewManual(0)
	with context { time.Scheduler: m } {
		paintFollows(seed, steps, m)
	}
}

// num is the i-th number of op k at state s.
func num(s int, k int, i int) float64 { float64((s*7+k*13+i*5)%60) + 0.5 }

func tone(s int, k int) Color { Color{R: uint8((s + k) % 256), G: uint8(k % 256), B: uint8((s * 3) % 256), A: 255} }

// tri is the path of op k at state s: a move, a line, a quad, a cubic and
// a close.
func tri(s int, k int) Path {
	Path{Segs: []Seg{MoveTo{X: num(s, k, 0), Y: num(s, k, 1)}, LineTo{X: num(s, k, 2), Y: num(s, k, 3)}, QuadTo{CX: num(s, k, 4), CY: num(s, k, 5), X: num(s, k, 6), Y: num(s, k, 7)}, CubicTo{C1X: num(s, k, 8), C1Y: num(s, k, 9), C2X: num(s, k, 10), C2Y: num(s, k, 11), X: num(s, k, 12), Y: num(s, k, 13)}, ClosePath}}
}

// paintProg paints prog at s through the package's painting functions.
func paintProg(p mut Paint, prog []pp, s int) {
	for op in prog {
		match op {
		case ppFill as x:
			Fill(p, tri(s, x.k), tone(s, x.k))
		case ppStroke as x:
			Stroke(p, tri(s, x.k), tone(s, x.k), num(s, x.k, 14))
		case ppRect as x:
			Fill(p, RectPath(num(s, x.k, 0), num(s, x.k, 1), num(s, x.k, 2), num(s, x.k, 3)), tone(s, x.k))
		case ppImage as x:
			DrawImage(p, "img\(x.k % 3).png", num(s, x.k, 0), num(s, x.k, 1), num(s, x.k, 2), num(s, x.k, 3))
		case ppSprite as x:
			DrawSprite(p, "atlas.png", ImageRegion{X: num(s, x.k, 4), Y: num(s, x.k, 5), W: num(s, x.k, 6), H: num(s, x.k, 7)}, num(s, x.k, 0), num(s, x.k, 1), num(s, x.k, 2), num(s, x.k, 3))
		case ppMove as x:
			Transformed(p, Affine{A: num(s, x.k, 0), B: 0.0, C: 0.0, D: num(s, x.k, 1), E: num(s, x.k, 2), F: num(s, x.k, 3)}) {
				paintProg(p, x.kids, s)
			}
		case ppClip as x:
			Clipped(p, num(s, x.k, 0), num(s, x.k, 1), num(s, x.k, 2), num(s, x.k, 3)) {
				paintProg(p, x.kids, s)
			}
		}
	}
}

// paintModel is the list prog means at s, written without a Paint: a
// rectangle is its four corners closed, and a transform or a clip is its
// push, its program's list and a pop.
func paintModel(prog []pp, s int) []PaintOp {
	let mut out = []PaintOp{}
	for op in prog {
		match op {
		case ppFill as x:
			out = out.Append(FillOp{Path: tri(s, x.k), Color: tone(s, x.k)})
		case ppStroke as x:
			out = out.Append(StrokeOp{Path: tri(s, x.k), Color: tone(s, x.k), Width: num(s, x.k, 14)})
		case ppRect as x:
			let rx = num(s, x.k, 0)
			let ry = num(s, x.k, 1)
			let rw = num(s, x.k, 2)
			let rh = num(s, x.k, 3)
			let corners = Path{Segs: []Seg{MoveTo{X: rx, Y: ry}, LineTo{X: rx + rw, Y: ry}, LineTo{X: rx + rw, Y: ry + rh}, LineTo{X: rx, Y: ry + rh}, ClosePath}}
			out = out.Append(FillOp{Path: corners, Color: tone(s, x.k)})
		case ppImage as x:
			out = out.Append(ImageOp{Src: "img\(x.k % 3).png", Part: WholeImage, X: num(s, x.k, 0), Y: num(s, x.k, 1), W: num(s, x.k, 2), H: num(s, x.k, 3)})
		case ppSprite as x:
			out = out.Append(ImageOp{Src: "atlas.png", Part: ImageRegion{X: num(s, x.k, 4), Y: num(s, x.k, 5), W: num(s, x.k, 6), H: num(s, x.k, 7)}, X: num(s, x.k, 0), Y: num(s, x.k, 1), W: num(s, x.k, 2), H: num(s, x.k, 3)})
		case ppMove as x:
			out = out.Append(PushTransform{M: Affine{A: num(s, x.k, 0), B: 0.0, C: 0.0, D: num(s, x.k, 1), E: num(s, x.k, 2), F: num(s, x.k, 3)}})
			for o in paintModel(x.kids, s) {
				out = out.Append(o)
			}
			out = out.Append(PopPaint)
		case ppClip as x:
			out = out.Append(PushClip{X: num(s, x.k, 0), Y: num(s, x.k, 1), W: num(s, x.k, 2), H: num(s, x.k, 3)})
			for o in paintModel(x.kids, s) {
				out = out.Append(o)
			}
			out = out.Append(PopPaint)
		}
	}
	out
}

// canvasOf is the paint list of the first canvas among shapes, and
// whether there is one.
func canvasOf(shapes []Shape[int], label string) ([]PaintOp, bool) {
	for x in shapes {
		match x.Node {
		case CanvasNode as c:
			if c.Label == label {
				return (c.Paint, true)
			}
		case _:
		}
	}
	([]PaintOp{}, false)
}

func paintFollows(seed int, steps int, m time.Manual) bool needs time.Scheduler {
	let mut r = seeded(seed)
	let prog = genPaint(&r, 2)
	let view = func(f mut Frame[int], s int) {
		Text(f, "at \(s)")
		Pressable(f, "next", (s*5+3)%11) {
			Text(f, "next")
		}
		Canvas(f, "board", 120, 80) func(p mut Paint) {
			paintProg(p, prog, s)
		}
		Canvas(f, "rest", 120, 80) func(p mut Paint) {
			paintProg(p, prog, s+1)
		}
		Canvas(f, "inner", 40, 40) func(q mut Paint) {
			paintProg(q, prog, s+2)
		}
	}
	let a = actor.StartMachine(dialMachine(), 1, func(o int) {})
	let mut h = NewTestHost(a, view, m, 4) catch {
	case BadPatch:
		return false
	}
	for _ in 0..(steps%12+12)%12+1 {
		Play(&h, []Act{TapOn{Label: "next"}}) catch {
		case _:
			return false
		}
		let s = StateOf(&h)
		let (shown, ok) = canvasOf(Screen(&h), "board")
		let want = paintModel(prog, s)
		let (rest, okRest) = canvasOf(Screen(&h), "rest")
		let (inner, okInner) = canvasOf(Screen(&h), "inner")
		if !ok || shown != want || Find(&h, "board") == option.None || strings.Count(Screenshot(&h), "\n") != 6+3*want.Len() {
			return false
		}
		if !okRest || !okInner || rest != paintModel(prog, s+1) || inner != paintModel(prog, s+2) {
			return false
		}
		let mut g = NewFrame[int]()
		let _ = Render(&g, view, s)
		if Render(&g, view, s).Len() != 0 {
			return false
		}
	}
	true
}

// Fill fills path with c.
func Fill(p mut Paint, path Path, c Color) {
	p.segs = slices.AppendAll(p.segs, path.Segs)
	add(p, FillOp{Path: Path{Segs: []Seg{}}, Color: c})
}

// Stroke strokes path with c, width wide.
func Stroke(p mut Paint, path Path, c Color, width float64) {
	p.segs = slices.AppendAll(p.segs, path.Segs)
	add(p, StrokeOp{Path: Path{Segs: []Seg{}}, Color: c, Width: width})
}

// add writes op, whose path is the segments added since the last op.
func add(p mut Paint, op PaintOp) {
	p.ops = p.ops.Append(op)
	p.ends = p.ends.Append(p.segs.Len())
}

// DrawImage draws the image at src (a host decodes it: the desktop host
// reads a PNG or JPEG file) into the rectangle at x, y of w by h,
// stretched to fill it. An image the host cannot read draws nothing.
func DrawImage(p mut Paint, src string, x float64, y float64, w float64, h float64) {
	add(p, ImageOp{Src: src, Part: WholeImage, X: x, Y: y, W: w, H: h})
}

// DrawSprite draws the region part of the image at src into the
// rectangle at x, y of w by h, as DrawImage does.
func DrawSprite(p mut Paint, src string, part ImageRegion, x float64, y float64, w float64, h float64) {
	add(p, ImageOp{Src: src, Part: part, X: x, Y: y, W: w, H: h})
}

// Transformed paints body under m, composed with the transforms around
// it.
func Transformed(p mut Paint, m Affine, body func()) {
	add(p, PushTransform{M: m})
	body()
	add(p, PopPaint)
}

// Clipped paints body inside the rectangle at x, y of w by h, in the
// coordinates of the transforms around it.
func Clipped(p mut Paint, x float64, y float64, w float64, h float64, body func()) {
	add(p, PushClip{X: x, Y: y, W: w, H: h})
	body()
	add(p, PopPaint)
}

// Canvas writes a canvas of width by height whose content is what draw
// paints, a leaf named label. draw runs during the pass, once. It paints
// into f's scratch after what is there (an enclosing canvas's ops, when
// this one is written inside another's draw), and the canvas's list is
// what it added (paintList).
func Canvas[E](f mut Frame[E], label string, width Length, height Length, draw func(p mut Paint), at core.CallSite) {
	let from = f.paint.ops.Len()
	let segsFrom = f.paint.segs.Len()
	draw(&f.paint)
	let ops = paintList(&f.paint, from, segsFrom)
	let _ = put(f, CanvasNode{Label: label, Width: width, Height: height, Paint: ops}, option.None, option.None, at)
}

// paintList is the list of p's ops from from on, each path its own
// segments from segsFrom on, in a list of ops and a list of segments of
// its own; p is cut back to from and segsFrom.
func paintList(p mut Paint, from int, segsFrom int) []PaintOp {
	let segs = p.segs[segsFrom:]
	let mut out = slices.WithCapacity[PaintOp](p.ops.Len() - from)
	let mut at = 0
	for i in from..p.ops.Len() {
		let end = p.ends[i] - segsFrom
		match p.ops[i] {
		case FillOp as x:
			out = out.Append(FillOp{Path: Path{Segs: segs[at:end]}, Color: x.Color})
		case StrokeOp as x:
			out = out.Append(StrokeOp{Path: Path{Segs: segs[at:end]}, Color: x.Color, Width: x.Width})
		case PushTransform as x:
			out = out.Append(PushTransform{M: x.M})
		case PushClip as x:
			out = out.Append(PushClip{X: x.X, Y: x.Y, W: x.W, H: x.H})
		case PopPaint:
			out = out.Append(PopPaint)
		case ImageOp as x:
			out = out.Append(ImageOp{Src: x.Src, Part: x.Part, X: x.X, Y: x.Y, W: x.W, H: x.H})
		}
		at = end
	}
	p.ops = p.ops[0:from]
	p.segs = p.segs[0:segsFrom]
	p.ends = p.ends[0:from]
	out
}

// PaintOf is the paint list of a canvas node, empty for any other node.
func PaintOf[E](n Node[E]) []PaintOp {
	match n {
	case CanvasNode as c:
		c.Paint
	case _:
		[]PaintOp{}
	}
}

// paintLines is a paint list as text, one op a line, indented inside its
// pushes: the canvas part of a screenshot.
func paintLines(ops []PaintOp, indent string) []string {
	let mut out = []string{}
	let mut at = indent
	for op in ops {
		match op {
		case FillOp as x:
			out = out.Append(at + "fill \(colorText(x.Color)) \(pathText(x.Path))")
		case StrokeOp as x:
			out = out.Append(at + "stroke \(colorText(x.Color)) \(x.Width) \(pathText(x.Path))")
		case PushTransform as x:
			let m = x.M
			out = out.Append(at + "transform \(m.A) \(m.B) \(m.C) \(m.D) \(m.E) \(m.F) {")
			at = at + "  "
		case PushClip as x:
			out = out.Append(at + "clip \(x.X) \(x.Y) \(x.W) \(x.H) {")
			at = at + "  "
		case ImageOp as x:
			out = out.Append(at + "image \(x.Src)\(partText(x.Part)) at \(x.X) \(x.Y) \(x.W) \(x.H)")
		case PopPaint:
			if at.Len() >= indent.Len()+2 {
				at = at[2:]
			}
			out = out.Append(at + "}")
		}
	}
	out
}

func partText(p ImagePart) string {
	match p {
	case WholeImage:
		""
	case ImageRegion as r:
		" part \(r.X) \(r.Y) \(r.W) \(r.H)"
	}
}

func colorText(c Color) string { "rgba(\(c.R),\(c.G),\(c.B),\(c.A))" }

func pathText(p Path) string {
	let mut out = ""
	for s in p.Segs {
		if out.Len() > 0 {
			out = out + " "
		}
		match s {
		case MoveTo as x:
			out = out + "M \(x.X) \(x.Y)"
		case LineTo as x:
			out = out + "L \(x.X) \(x.Y)"
		case QuadTo as x:
			out = out + "Q \(x.CX) \(x.CY) \(x.X) \(x.Y)"
		case CubicTo as x:
			out = out + "C \(x.C1X) \(x.C1Y) \(x.C2X) \(x.C2Y) \(x.X) \(x.Y)"
		case ClosePath:
			out = out + "Z"
		}
	}
	out
}
