import arena

// Pending is the failure of a read whose data has not arrived yet (H8a,
// stdlib.md UI 15): an error type in a fails row, as any other. A view
// that reads a load's value before it is there fails with it, and the
// nearest group whose catch names it shows something else.
type Pending {}

// Boundary runs body as a group with no node of its own (H8a). When a
// failure leaves body, the pass goes back to where the group started:
// nothing body wrote stays (no node, no key or frame function, no cell
// or load under a node it wrote), and the failure passes on to the
// caller's catch, whose arms write at the group's place. What the group
// held in the last passes is parked, not dropped (Frame, node.parked).
// What body writes directly under the parent is identified under the
// boundary's call site, as an Each's rows are under the Each's, so a
// sibling after the boundary keeps its identity however far body got;
// two calls of one boundary site under one parent with one row key share
// their counts (stdlib.md, UI 15).
func Boundary[E, F](f *Frame[E], body func() fails F, at CallSite) fails F {
	let m = markOf(f)
	f.each = at
	body() catch {
	case err:
		cut(f, m)
		return err
	}
	f.each = m.each
}

// mark is where a pass stood when a group started: the lengths of the
// pass's lists, the identity counts taken, the parent and its last child,
// and the row a group in an Each started in.
type mark { nspecs int, ncells int, nloads int, nkeys int, nurls int, nanims int, nseen int, parent int, last int, each CallSite, key Key }

func markOf[E](f *Frame[E]) mark {
	mark{nspecs: f.nspecs, ncells: f.ncells, nloads: f.nloads, nkeys: f.nkeys, nurls: f.nurls, nanims: f.nanims, nseen: f.nseen, parent: f.parent, last: lastKid(f, f.parent), each: f.each, key: f.key}
}

// cut takes the pass back to m: the specs, cells, key and frame
// functions written since go, the identity counts taken since are given
// back (their spec indices are written again), and the parent's child
// list ends where it ended. A cell read since needs no keeping: the
// parent is marked stopped, so its old children that this pass does not
// write are parked, and the cells its node held that this pass did not
// read are kept (store). A load read since under the parent stays, so a
// new one is fetched; one under a spec that goes stays in that spec's old
// node, which is parked, or moves to the parent when the old node does
// not hold it.
func cut[E](f *Frame[E], m mark) {
	for i in m.nseen..f.nseen {
		let s = f.seenLog[i]
		let c = count(f.seen, s)
		if c <= 1 {
			f.seen = f.seen.Delete(s)
		} else {
			f.seen[s] = c - 1
		}
	}
	f.nseen = m.nseen
	f.ncells = m.ncells
	let mut v = m.nloads
	for i in m.nloads..f.nloads {
		let mut l = f.loads[i]
		let mut stays = l.parent < m.nspecs
		if !stays && !heldBy(f, f.specs[l.parent].prev, l.id, l.key) {
			// A load whose old node does not already hold it (a node new in
			// this pass, or a new key) has nowhere to be parked: it is
			// fetched under the group's parent, so a body that loads and
			// then reads what it loaded does not wait for ever. One its old
			// node holds stays there, parked with it.
			l.parent = m.parent
			stays = true
		}
		if stays {
			f.loads[v] = l
			v = v + 1
		}
	}
	f.nloads = v
	for p, _ in f.stopped {
		if p >= m.nspecs {
			f.stopped = f.stopped.Delete(p)
		}
	}
	f.nspecs = m.nspecs
	f.nkeys = m.nkeys
	f.nurls = m.nurls
	f.nanims = m.nanims
	f.parent = m.parent
	f.each = m.each
	f.key = m.key
	if m.last < 0 {
		if m.parent < 0 {
			f.first = -1
		} else {
			f.specs[m.parent].first = -1
		}
	} else {
		f.specs[m.last].next = -1
	}
	if m.parent < 0 {
		f.last = m.last
	} else {
		f.specs[m.parent].last = m.last
	}
	f.stopped[m.parent] = true
}

// heldBy is whether the node r names (Null for none) holds load id with
// key.
func heldBy[E](f *Frame[E], r arena.Ref[node[E]], id ident, key Key) bool {
	if !arena.Has(f.nodes, r) {
		return false
	}
	match loadAt(f, r, id) {
	case Some[slot] as s:
		s.Value.key == key
	case None:
		false
	}
}

// parkedOf is the parked children of the node r names.
func parkedOf[E](f *Frame[E], r arena.Ref[node[E]]) []arena.Ref[node[E]] {
	let mut out = []arena.Ref[node[E]]{}
	change(f, r, func(n *node[E]) {
		if len(n.parked) > 0 {
			out = n.parked
		}
	})
	out
}

// parkedCount is the number of parked children of the node r names.
func parkedCount[E](f *Frame[E], r arena.Ref[node[E]]) int {
	let mut c = 0
	change(f, r, func(n *node[E]) { c = len(n.parked) })
	c
}

// stops is whether a group directly under spec p (-1 the root) stopped in
// this pass.
func stops[E](f *Frame[E], p int) bool { has(f.stopped, p) }
