// UG3's laws: hover costs no pass, the pointer's enter and leave, and the
// focus against a reference ring (tab stops, roving groups, focus scopes,
// Focus requests).

import actor
import time

// tinted is a look filled with the colour c. (a law's helper)
func tinted(c uint32) Look {
	let mut l = Bare()
	l.Fill = Rgb(c)
	l
}

// stateLooks is node i's Looks, a fill per state. (a law's helper)
func stateLooks(i int) Looks {
	let c = uint32(i)
	Looks{Rest: tinted(0x100000 + c), Hover: tinted(0x200000 + c), Focus: tinted(0x300000 + c), Active: tinted(0x400000 + c), Disabled: tinted(0x500000 + c)}
}

// hoverScreen is n Pressables "h0" to "h<n-1>", each with its
// stateLooks. (a law's helper)
func hoverScreen(f *Frame[int], s int, n int) {
	Column(f, Plain()) {
		for i in 0..n {
			let mut st = PressStyle()
			st.Look = LookFor(f, stateLooks(i))
			PressableStyled(f, "h\(i)", s+i, st) {
				Text(f, "t\(i)")
			}
		}
	}
}

// HoverCostsNoPass (UG3, a counted guard): over screens of 2 to 7
// Pressables, each with its own look per state, drawn pointer moves onto
// them and off every node run no pass (the step's counts are none), and
// after each the node the pointer is over shows its Hover look and every
// other node its Rest look.
law HoverCostsNoPass(seed int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let mut r = seeded(seed)
		let n = draw(&r, 6) + 2
		let view = func(f *Frame[int], s int) { hoverScreen(f, s, n) }
		let a = actor.StartMachine(Machine[int, int, int]{Initial: 0, Step: semStep, After: semTimer, Work: semWork, Exit: func(at int) Option[func()] { None }}, 1, func(o int) {})
		let mut h = NewTestHost(a, view, m, 4) catch {
		case BadPatch:
			return false
		}
		let mut at = -1
		for _ in 0..draw(&r, 8)+4 {
			let j = draw(&r, n+1)
			if j == n {
				PointNowhere(&h) catch {
				case _:
					return false
				}
				at = -1
			} else {
				Play(&h, []Act{PointOn{Label: "h\(j)", Pointer: PointerEvent{Phase: Moved, X: 1, Y: 1, Zone: None}}}) catch {
				case _:
					return false
				}
				at = j
			}
			if Counts(&h) != NoCounts() {
				return false
			}
			for i in 0..n {
				let ids = Locate(&h, WithLabel{Label: "h\(i)"})
				if len(ids) != 1 {
					return false
				}
				let want LookState = if i == at { Hover } else { Rest }
				if LookStateAt(&h, ids[0]) != want || LookShownAt(&h, ids[0]) != LookNow(stateLooks(i), want) {
					return false
				}
			}
		}
		true
	}
}

// crossStep logs each signal. (a law's helper)
func crossStep(s string, e int) Decision[string, int] {
	Enter[string]{Next: s + "\(e),"}
}

func crossTimer(s string) Option[Timeout[int]] {
	None
}

func crossWork(s string) Option[func(send func(e int))] {
	None
}

// crossScreen is n Areas "a0" to "a<n-1>"; Area i gives 10i+1 on the
// pointer's enter, 10i+2 on its leave, and nothing else. (a law's helper)
func crossScreen(f *Frame[int], n int) {
	Column(f, Plain()) {
		for i in 0..n {
			Area(f, "a\(i)", Plain(), func(p PointerEvent) Option[int] {
				match p.Phase {
				case PointerEnter:
					Some{Value: 10*i + 1}
				case PointerLeave:
					Some{Value: 10*i + 2}
				case _:
					None
				}
			}) {
				Text(f, "t\(i)")
			}
		}
	}
}

// PointerCrossesOnce (UG3): over screens of 2 to 5 Areas, drawn pointer
// moves onto them and off every node give, each time the node under the
// pointer changes, the Leave of the node it left and then the Enter of
// the node it came to, and nothing while it stays, so the program's log
// is the model's.
law PointerCrossesOnce(seed int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let mut r = seeded(seed)
		let n = draw(&r, 4) + 2
		let view = func(f *Frame[int], s string) { crossScreen(f, n) }
		let a = actor.StartMachine(Machine[string, int, int]{Initial: "", Step: crossStep, After: crossTimer, Work: crossWork, Exit: func(at string) Option[func()] { None }}, 1, func(o int) {})
		let mut h = NewTestHost(a, view, m, 4) catch {
		case BadPatch:
			return false
		}
		let mut at = -1
		let mut log = ""
		for _ in 0..draw(&r, 10)+4 {
			let j = draw(&r, n+1)
			if j == n {
				PointNowhere(&h) catch {
				case _:
					return false
				}
			} else {
				Play(&h, []Act{PointOn{Label: "a\(j)", Pointer: PointerEvent{Phase: Moved, X: 2, Y: 2, Zone: None}}}) catch {
				case _:
					return false
				}
			}
			let to = if j == n { -1 } else { j }
			if to != at {
				if at >= 0 {
					log = log + "\(10*at + 2),"
				}
				if to >= 0 {
					log = log + "\(10*to + 1),"
				}
				at = to
			}
			if StateOf(&h) != log {
				return false
			}
		}
		true
	}
}

// ringScreen writes the drawn items in a Column: 0 a Text "n<i>", 1 a
// Pressable "p<i>", 2 a Pressable "d<i>" under a disabled Fieldset, 3 a
// Roving group of sizes[i] Pressables "g<i>m<j>". (a law's helper)
func ringScreen(f *Frame[int], s int, kinds []int, sizes []int) {
	Column(f, Plain()) {
		for i, k in kinds {
			if k == 0 {
				Text(f, "n\(i)")
			} else if k == 1 {
				Pressable(f, "p\(i)", s) {
					Text(f, "x")
				}
			} else if k == 2 {
				Fieldset(f, true, "") {
					Pressable(f, "d\(i)", s) {
						Text(f, "x")
					}
				}
			} else {
				Roving(f) {
					for j in 0..sizes[i] {
						Pressable(f, "g\(i)m\(j)", s) {
							Text(f, "x")
						}
					}
				}
			}
		}
	}
}

// keyIn presses the key name, with Shift when shift. (a law's helper)
func keyIn(name string, shift bool) Act {
	KeyIn{Press: KeyPress{Name: name, Mods: Mods{Shift: shift, Ctrl: false, Alt: false, Meta: false}}}
}

// focusName is the name of the node the focus is on, "" for none. (a
// law's helper)
func focusName[S, D, F](h *TestHost[S, int, D, F]) string {
	match FocusOf(h) {
	case Some[Id[int]] as id:
		AccessAt(h, id.Value).Name
	case None:
		""
	}
}

// ringName is the name of item i's member j in ringScreen. (a law's
// helper)
func ringName(kinds []int, i int, j int) string {
	if kinds[i] == 3 { "g\(i)m\(j)" } else { "p\(i)" }
}

// FocusFollowsTheRing (UG3): over drawn screens of texts, Pressables,
// disabled Pressables and roving groups of 1 to 3 Pressables, and drawn
// Tabs, Shift+Tabs, arrows, Home, End and clicks, the focus is the
// reference ring's: Tab and Shift+Tab walk the tab stops in tree order,
// round at the ends, a roving group being one stop, its member the focus
// was last on (its first before any); an arrow, Home or End moves inside
// the roving group the focus is in, round at the ends, and does nothing
// elsewhere; a click puts the focus on what it pressed. The focused node
// shows its focus look after a key moved the focus there, and after a
// click its hover look (the pointer stays over it).
law FocusFollowsTheRing(seed int, steps int) {
	let mut r = seeded(seed)
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let mut kinds = []int{}
		let mut sizes = []int{}
		let mut mem = []int{}
		let mut labels = []string{}
		for _ in 0..draw(&r, 6)+2 {
			let k = draw(&r, 4)
			kinds = kinds.Append(k)
			sizes = sizes.Append(draw(&r, 3) + 1)
			mem = mem.Append(0)
		}
		for i, k in kinds {
			if k == 1 {
				labels = labels.Append("p\(i)")
			} else if k == 3 {
				for j in 0..sizes[i] {
					labels = labels.Append("g\(i)m\(j)")
				}
			}
		}
		let ks = kinds
		let ss = sizes
		let view = func(f *Frame[int], s int) { ringScreen(f, s, ks, ss) }
		let a = actor.StartMachine(Machine[int, int, int]{Initial: 0, Step: semStep, After: semTimer, Work: semWork, Exit: func(at int) Option[func()] { None }}, 1, func(o int) {})
		let mut h = NewTestHost(a, view, m, 4) catch {
		case BadPatch:
			return false
		}
		let mut fi = -1
		let mut fm = 0
		let mut visible = false
		for _ in 0..(steps%16+16)%16+4 {
			let act = draw(&r, 7)
			if act == 6 && len(labels) == 0 {
				// nothing to click
			} else if act == 6 {
				let l = labels[draw(&r, len(labels))]
				Play(&h, []Act{ClickOn{At: WithLabel{Label: l}}}) catch {
				case _:
					return false
				}
				for i, k in kinds {
					if k == 1 && l == "p\(i)" {
						fi = i
						fm = 0
					} else if k == 3 {
						for j in 0..sizes[i] {
							if l == "g\(i)m\(j)" {
								fi = i
								fm = j
								mem[i] = j
							}
						}
					}
				}
				visible = false
			} else if act < 2 {
				let back = act == 1
				Play(&h, []Act{keyIn("Tab", back)}) catch {
				case _:
					return false
				}
				let mut ring = []int{}
				for i, k in kinds {
					if k == 1 || k == 3 {
						ring = ring.Append(i)
					}
				}
				let n = len(ring)
				if n == 0 {
					fi = -1
				} else {
					let mut pos = -1
					for p, i in ring {
						if i == fi {
							pos = p
						}
					}
					pos = if pos < 0 { if back { n - 1 } else { 0 } } else if back { (pos + n - 1) % n } else { (pos + 1) % n }
					fi = ring[pos]
					fm = if kinds[fi] == 3 { mem[fi] } else { 0 }
				}
				visible = true
			} else {
				let names = []string{"ArrowRight", "ArrowLeft", "Home", "End"}
				let key = names[act-2]
				Play(&h, []Act{keyIn(key, false)}) catch {
				case _:
					return false
				}
				if fi >= 0 && kinds[fi] == 3 {
					let k = sizes[fi]
					fm = if key == "ArrowRight" { (fm + 1) % k } else if key == "ArrowLeft" { (fm + k - 1) % k } else if key == "Home" { 0 } else { k - 1 }
					mem[fi] = fm
					visible = true
				}
			}
			let want = if fi < 0 { "" } else { ringName(kinds, fi, fm) }
			if focusName(&h) != want {
				return false
			}
			match FocusOf(&h) {
			case Some[Id[int]] as id:
				let shown LookState = if visible { FocusVisible } else { Hover }
				if LookStateAt(&h, id.Value) != shown {
					return false
				}
			case None:
			}
		}
		true
	}
}

// scopeScreen is outside Pressables "o0" to "o<outs-1>", each sending 1,
// and while s is 1 a FocusScope of Pressables "s0" to "s<ins-1>", each
// sending 1, and "close", sending 0, the last; Escape sends 0 from
// anywhere. (a law's helper)
func scopeScreen(f *Frame[int], s int, outs int, ins int) {
	OnKey(f, func(k KeyPress) Option[int] {
		if k.Name == "Escape" { Some{Value: 0} } else { None }
	})
	Column(f, Plain()) {
		for i in 0..outs {
			Pressable(f, "o\(i)", 1) {
				Text(f, "x")
			}
		}
		if s == 1 {
			FocusScope(f) {
				for j in 0..ins {
					Pressable(f, "s\(j)", 1) {
						Text(f, "x")
					}
				}
				Pressable(f, "close", 0) {
					Text(f, "x")
				}
			}
		}
	}
}

// FocusStaysInScope (UG3): over drawn screens with 1 to 4 Pressables
// outside a focus scope and 1 to 4 (and "close") inside it, a click
// outside opens the scope and the focus moves to its first Pressable;
// then drawn Tabs, Shift+Tabs and arrows keep the focus inside it, Tab
// going round the scope's own stops.
law FocusStaysInScope(seed int, steps int) {
	let mut r = seeded(seed)
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let outs = draw(&r, 4) + 1
		let ins = draw(&r, 4) + 1
		let view = func(f *Frame[int], s int) { scopeScreen(f, s, outs, ins) }
		let a = actor.StartMachine(Machine[int, int, int]{Initial: 0, Step: semStep, After: semTimer, Work: semWork, Exit: func(at int) Option[func()] { None }}, 1, func(o int) {})
		let mut h = NewTestHost(a, view, m, 4) catch {
		case BadPatch:
			return false
		}
		Play(&h, []Act{ClickOn{At: WithLabel{Label: "o\(draw(&r, outs))"}}}) catch {
		case _:
			return false
		}
		if focusName(&h) != "s0" {
			return false
		}
		let n = ins + 1
		let mut at = 0
		for _ in 0..(steps%12+12)%12+4 {
			let act = draw(&r, 3)
			if act == 2 {
				Play(&h, []Act{keyIn("ArrowDown", false)}) catch {
				case _:
					return false
				}
			} else {
				Play(&h, []Act{keyIn("Tab", act == 1)}) catch {
				case _:
					return false
				}
				at = if act == 1 { (at + n - 1) % n } else { (at + 1) % n }
			}
			let want = if at == ins { "close" } else { "s\(at)" }
			if focusName(&h) != want {
				return false
			}
		}
		true
	}
}

// FocusReturnsOnEnd (UG3): drawn rounds over a screen with 1 to 4
// Pressables outside a focus scope: a click on one opens the scope (the
// focus moves in), drawn Tabs move inside it, a drawn click outside moves
// the focus out, and the scope closes by "close" or by Escape; then the
// focus is on the Pressable that opened it, or, when a click had moved
// the focus out and Escape closed it, stays where the click put it.
law FocusReturnsOnEnd(seed int) {
	let mut r = seeded(seed)
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let outs = draw(&r, 4) + 1
		let ins = draw(&r, 3) + 1
		let view = func(f *Frame[int], s int) { scopeScreen(f, s, outs, ins) }
		let a = actor.StartMachine(Machine[int, int, int]{Initial: 0, Step: semStep, After: semTimer, Work: semWork, Exit: func(at int) Option[func()] { None }}, 1, func(o int) {})
		let mut h = NewTestHost(a, view, m, 4) catch {
		case BadPatch:
			return false
		}
		for _ in 0..draw(&r, 3)+1 {
			let opener = draw(&r, outs)
			let mut want = "o\(opener)"
			Play(&h, []Act{ClickOn{At: WithLabel{Label: want}}}) catch {
			case _:
				return false
			}
			for _ in 0..draw(&r, 4) {
				Play(&h, []Act{keyIn("Tab", false)}) catch {
				case _:
					return false
				}
			}
			let out = draw(&r, 2) == 0
			if out {
				want = "o\(draw(&r, outs))"
				Play(&h, []Act{ClickOn{At: WithLabel{Label: want}}}) catch {
				case _:
					return false
				}
			}
			let escape = out || draw(&r, 2) == 0
			let close = if escape { keyIn("Escape", false) } else { ClickOn{At: WithLabel{Label: "close"}} }
			Play(&h, []Act{close}) catch {
			case _:
				return false
			}
			if focusName(&h) != want {
				return false
			}
		}
		true
	}
}

// askScreen is "next", sending s+1, and n Semantic groups keyed 0 to
// n-1, group i holding a Pressable "t<i>"; the pass asks for the focus
// on key (s/2)%n. (a law's helper)
func askScreen(f *Frame[int], s int, n int) {
	Focus(f, ByInt((s/2)%n))
	Column(f, Plain()) {
		Pressable(f, "next", s+1) {
			Text(f, "x")
		}
		for i in 0..n {
			let mut a = Named(Group, "z\(i)")
			a.Key = ByInt(i)
			Semantic(f, a, None, Plain()) {
				Pressable(f, "t\(i)", s) {
					Text(f, "x")
				}
			}
		}
	}
}

// FocusGoesWhereAsked (UG3): a view that asks for the focus on the key
// (s/2)%n: the first pass puts the focus on t0; a click on "next" moves
// the focus to the group the new request names when the request changed,
// shown, and leaves it on "next" when the request is the last pass's;
// drawn Tabs between move it, and a pass asking again for the same key
// does not take it back.
law FocusGoesWhereAsked(seed int) {
	let mut r = seeded(seed)
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let n = draw(&r, 4) + 2
		let view = func(f *Frame[int], s int) { askScreen(f, s, n) }
		let a = actor.StartMachine(Machine[int, int, int]{Initial: 0, Step: semStep, After: semTimer, Work: semWork, Exit: func(at int) Option[func()] { None }}, 1, func(o int) {})
		let mut h = NewTestHost(a, view, m, 4) catch {
		case BadPatch:
			return false
		}
		if focusName(&h) != "t0" {
			return false
		}
		let mut s = 0
		let mut at = 1
		for _ in 0..draw(&r, 10)+4 {
			if draw(&r, 2) == 0 {
				Play(&h, []Act{ClickOn{At: WithLabel{Label: "next"}}}) catch {
				case _:
					return false
				}
				let was = (s / 2) % n
				s = s + 1
				let now = (s / 2) % n
				at = if now != was { now + 1 } else { 0 }
			} else {
				let back = draw(&r, 2) == 0
				Play(&h, []Act{keyIn("Tab", back)}) catch {
				case _:
					return false
				}
				at = if back { (at + n) % (n + 1) } else { (at + 1) % (n + 1) }
			}
			let want = if at == 0 { "next" } else { "t\(at - 1)" }
			if focusName(&h) != want {
				return false
			}
		}
		true
	}
}
