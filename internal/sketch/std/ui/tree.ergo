import arena

// Id names one node of a Tree, from the frame that made it until the frame
// that removes it. A host keeps its own copy of the tree by Id.
type Id[E] { ref arena.Ref[node[E]] }

// ident is a node's identity among its siblings: the call that wrote it,
// its Each row, and n, how many siblings before it have the same call and
// row. Commit keeps a node across frames exactly when its identity
// returns under the same parent.
type ident { site CallSite, each CallSite, key Key, n int }

// base is ident without n.
type base { site CallSite, each CallSite, key Key }

// node is one retained node: what it shows, its identity, the signal of a
// text for an Input, and its children in order.
type node[E] {
	node   Node[E],
	id     ident,
	onText Option[func(t string) E],
	kids   []arena.Ref[node[E]],
}

// Tree is the retained tree of the frames committed so far. Its nodes live
// in one arena, so the tree holds Refs, not pointers.
type Tree[E] {
	nodes arena.Of[node[E]],
	root  arena.Ref[node[E]],
	ops   []Op[E],
}

// Op is one change a host applies, in order. Before names the sibling the
// node goes in front of; None puts it last.
type Op[E] = Insert{Id Id[E], Parent Id[E], Before Option[Id[E]], Node Node[E]} | Move{Id Id[E], Parent Id[E], Before Option[Id[E]]} | Remove{Id Id[E]} | Set{Id Id[E], Node Node[E]}

// NewTree is a tree with only its root.
func NewTree[E]() Tree[E] {
	let mut nodes = arena.New[node[E]]()
	let root = nodes.Put(node[E]{node: BoxNode{Style: Plain()}, id: ident{site: nowhere, each: nowhere, key: NoKey, n: 0}, onText: None, kids: []arena.Ref[node[E]]{}})
	Tree[E]{nodes: nodes, root: root, ops: []Op[E]{}}
}

// Root is the Id of the root, the parent of what a view writes at its top.
func Root[E](t *Tree[E]) Id[E] { Id[E]{ref: t.root} }

// Len is the number of nodes in t, the root included.
func Len[E](t *Tree[E]) int { arena.Len(t.nodes) }

// Commit makes t show what f holds and returns the changes, in the order a
// host applies them. A node whose identity returns under the same parent
// keeps its Id; a keyed row that moved is one Move.
func Commit[E comparable](t *Tree[E], f *Frame[E]) []Op[E] {
	t.ops = []Op[E]{}
	let kids = childLists(f)
	reconcile(t, f, kids, t.root, kids[0])
	t.ops
}

// childLists gives the spec indices of each node's children: [0] for the
// root, [i+1] for spec i.
func childLists[E](f *Frame[E]) [][]int {
	let mut out = [][]int{[]int{}}
	for _ in f.specs {
		out = out.Append([]int{})
	}
	for i, s in f.specs {
		out[s.parent+1] = out[s.parent+1].Append(i)
	}
	out
}

// at is the node r names; every Ref the tree holds is live.
func at[E](t *Tree[E], r arena.Ref[node[E]]) node[E] {
	t.nodes.Get(r) catch {
	case arena.Stale:
		Unreachable("ui: the tree holds a freed node")
	}
}

// change runs edit on the node r names.
func change[E](t *Tree[E], r arena.Ref[node[E]], edit func(n *node[E])) {
	t.nodes.Update(r, edit) catch {
	case arena.Stale:
		Unreachable("ui: the tree holds a freed node")
	}
}

// emit adds one op to the commit's patch.
func emit[E](t *Tree[E], op Op[E]) { t.ops = t.ops.Append(op) }

// reconcile makes the children of parent the nodes of want (spec
// indices), keeping each old child whose identity returns, and then does
// the same below each child.
func reconcile[E comparable](t *Tree[E], f *Frame[E], kids [][]int, parent arena.Ref[node[E]], want []int) {
	let old = at(t, parent).kids
	let mut oldAt = Map[ident, int]{}
	let mut used = []bool{}
	for i, r in old {
		oldAt[at(t, r).id] = i
		used = used.Append(false)
	}
	let mut seen = Map[base, int]{}
	let mut ids = []ident{}
	let mut src = []int{}
	for s in want {
		let sp = f.specs[s]
		let b = base{site: sp.site, each: sp.each, key: sp.key}
		let k = count(seen, b)
		seen[b] = k + 1
		let id = ident{site: sp.site, each: sp.each, key: sp.key, n: k}
		let mut from = -1
		match oldAt.Get(id) {
		case Some[int] as o:
			if !used[o.Value] && kindOf(at(t, old[o.Value]).node) == kindOf(sp.node) {
				from = o.Value
				used[o.Value] = true
			}
		case None:
		}
		ids = ids.Append(id)
		src = src.Append(from)
	}
	for i, r in old {
		if !used[i] {
			emit(t, Remove{Id: Id[E]{ref: r}})
			drop(t, r)
		}
	}
	let keep = increasing(src)
	let mut refs = []arena.Ref[node[E]]{}
	for j, s in want {
		if src[j] >= 0 {
			refs = refs.Append(old[src[j]])
		} else {
			let sp = f.specs[s]
			refs = refs.Append(t.nodes.Put(node[E]{node: sp.node, id: ids[j], onText: sp.onText, kids: []arena.Ref[node[E]]{}}))
		}
	}
	change(t, parent, func(n *node[E]) { n.kids = refs })
	let p = Id[E]{ref: parent}
	for k in 0..len(want) {
		let j = len(want) - 1 - k
		let mut before Option[Id[E]] = None
		if j+1 < len(refs) {
			before = Some{Value: Id[E]{ref: refs[j+1]}}
		}
		let sp = f.specs[want[j]]
		let id = Id[E]{ref: refs[j]}
		if src[j] < 0 {
			emit(t, Insert{Id: id, Parent: p, Before: before, Node: sp.node})
		} else {
			if at(t, refs[j]).node != sp.node {
				emit(t, Set{Id: id, Node: sp.node})
			}
			change(t, refs[j], func(n *node[E]) {
				n.node = sp.node
				n.onText = sp.onText
			})
			if !keep[j] {
				emit(t, Move{Id: id, Parent: p, Before: before})
			}
		}
		reconcile[E](t, f, kids, refs[j], kids[want[j]+1])
	}
}

// count is how many siblings before have identity b.
func count(seen Map[base, int], b base) int {
	match seen.Get(b) {
	case Some[int] as c:
		c.Value
	case None:
		0
	}
}

// drop frees the node r names and every node below it.
func drop[E](t *Tree[E], r arena.Ref[node[E]]) {
	for k in at(t, r).kids {
		drop[E](t, k)
	}
	let _ = t.nodes.Free(r) catch {
	case arena.Stale:
		Unreachable("ui: the tree holds a freed node")
	}
}

// increasing marks the kept children: the longest run of reused children
// whose old positions increase in their new order (src[j] is the old
// position of new child j, or -1 for a new one). A kept child stays where
// it is; every other reused child is one Move. Patience sorting, O(n log n).
func increasing(src []int) []bool {
	let mut keep = []bool{}
	let mut prev = []int{}
	for _ in src {
		keep = keep.Append(false)
		prev = prev.Append(-1)
	}
	let mut tails = []int{}
	for j, v in src {
		if v >= 0 {
			let mut lo = 0
			let mut hi = len(tails)
			for lo < hi {
				let mid = (lo + hi) / 2
				if src[tails[mid]] < v {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			if lo > 0 {
				prev[j] = tails[lo-1]
			}
			if lo == len(tails) {
				tails = tails.Append(j)
			} else {
				tails[lo] = j
			}
		}
	}
	if len(tails) > 0 {
		let mut j = tails[len(tails)-1]
		for j >= 0 {
			keep[j] = true
			j = prev[j]
		}
	}
	keep
}

// kindOf numbers the variants of Node: a node keeps its Id only while its
// kind stays.
func kindOf[E](n Node[E]) int {
	match n {
	case BoxNode:
		0
	case RowNode:
		1
	case ColumnNode:
		2
	case ScrollNode:
		3
	case TextNode:
		4
	case PressableNode[E]:
		5
	case CheckNode[E]:
		6
	case InputNode:
		7
	}
}

// Kids are the children of id, in order; none for an Id t does not hold.
func Kids[E](t *Tree[E], id Id[E]) []Id[E] {
	let n = t.nodes.Get(id.ref) catch {
	case arena.Stale:
		return []Id[E]{}
	}
	let mut out = []Id[E]{}
	for r in n.kids {
		out = out.Append(Id[E]{ref: r})
	}
	out
}

// NodeOf is what id shows; None for an Id t does not hold.
func NodeOf[E](t *Tree[E], id Id[E]) Option[Node[E]] {
	let n = t.nodes.Get(id.ref) catch {
	case arena.Stale:
		return None
	}
	Some{Value: n.node}
}

// Pressed is the signal a press of id sends: the On of a Pressable or a
// Check; None for any other node or an Id t does not hold.
func Pressed[E](t *Tree[E], id Id[E]) Option[E] {
	let n = t.nodes.Get(id.ref) catch {
	case arena.Stale:
		return None
	}
	match n.node {
	case PressableNode[E] as p:
		Some{Value: p.On}
	case CheckNode[E] as c:
		Some{Value: c.On}
	case _:
		None
	}
}

// Typed is the signal text typed into the Input id sends; None for any
// other node or an Id t does not hold.
func Typed[E](t *Tree[E], id Id[E], text string) Option[E] {
	let n = t.nodes.Get(id.ref) catch {
	case arena.Stale:
		return None
	}
	match n.onText {
	case Some[func(t string) E] as f:
		Some{Value: f.Value(text)}
	case None:
		None
	}
}
