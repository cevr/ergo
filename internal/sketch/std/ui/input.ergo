import arena

// Pointer, key and frame events (H5a). Each reaches the program as a
// signal of its own type E, which a view's function makes from the event's
// data, so the program's machine steps it like a press. The host finds the
// node under a pointer (it has the boxes); the composer finds the
// function.

// Phase is what a pointer did: pressed, moved, released, or a wheel turned
// by DX and DY.
type Phase = Down | Moved | Up | Wheel{DX float64, DY float64}

// Down is a pointer pressed.
type Down {}

// Moved is a pointer moved, pressed or not.
type Moved {}

// Up is a pointer released.
type Up {}

// PointerEvent is a pointer's phase and its position in the node's box,
// in device-independent pixels from the box's top left corner, and the
// zone under it (H5g): the composer fills Zone from the host's hit test
// (Point.Over), so a host sends None.
type PointerEvent { Phase Phase, X float64, Y float64, Zone Option[ZoneHit] }

// Mods are the modifier keys held with a key.
type Mods { Shift bool, Ctrl bool, Alt bool, Meta bool }

// KeyPress is a key pressed: its name ("a", "Enter", "ArrowUp", as the
// web's KeyboardEvent.key names it) and the modifiers held.
type KeyPress { Name string, Mods Mods }

// Area is a container whose box takes pointer events: on makes the signal
// of each, None for an event the program ignores (a move with no button
// down). label names it to a test host and to assistive technology; body
// is what it shows.
func Area[E, F, R](f *Frame[E], label string, style Style, on own func(p PointerEvent) Option[E], body func() fails F needs R, at CallSite) fails F needs R {
	let m = markOf(f)
	let i = put(f, AreaNode{Label: label, Style: style}, None, None, at)
	f.specs[i].onPoint = Some{Value: on}
	f.parent = i
	body() catch {
	case err:
		cut(f, m)
		return err
	}
	f.parent = m.parent
}

// OnKey takes the key presses of this pass: a press goes to the OnKey
// calls in the order the pass made them, and the first that gives a signal
// takes it, so a dialog written before the page it covers takes its keys
// first.
func OnKey[E](f *Frame[E], on own func(k KeyPress) Option[E]) {
	if f.nkeys < len(f.keys) {
		f.keys[f.nkeys] = on
	} else {
		f.keys = f.keys.Append(on)
	}
	f.nkeys = f.nkeys + 1
}

// OnFocusKey takes the key presses that reach the container being
// written (UC-FOCUS): while the keyboard's focus is on it or on a node
// inside it, a press goes first to the OnFocusKey of the focused node,
// then of each container above it in turn, as a DOM keydown bubbles from
// its target, and only then to the OnKey calls; the first that gives a
// signal takes it. A press on a node, or a text typed into one, puts the
// focus there, as a click on a control does. A container has one; a later
// call replaces it. At the top, outside any container, it is an OnKey.
func OnFocusKey[E](f *Frame[E], on own func(k KeyPress) Option[E]) {
	if f.parent < 0 {
		OnKey(f, on)
		return
	}
	f.specs[f.parent].onKey = Some{Value: on}
}

// Focused is the node the keyboard is on: the last one pressed or typed
// into while the tree holds it, None before any.
func Focused[E](f *Frame[E]) Option[Id[E]] {
	if f.focus == arena.Null[node[E]]() || !arena.Has(f.nodes, f.focus) {
		return None
	}
	Some{Value: Id[E]{ref: f.focus}}
}

// Animate asks for frames while a pass makes it: the host sends a Tick per
// frame, and on makes the signal of each from the frame's time (since the
// host started). A pass that makes no Animate asks for no frame, so a
// settled screen costs nothing.
func Animate[E](f *Frame[E], on own func(at duration) E) {
	if f.nanims < len(f.anims) {
		f.anims[f.nanims] = on
	} else {
		f.anims = f.anims.Append(on)
	}
	f.nanims = f.nanims + 1
}

// Animating is whether the last pass made an Animate or has a Presence
// row in motion: whether the host should send frames.
func Animating[E](f *Frame[E]) bool { f.nanims > 0 || f.moving }

// ticked is the signals of a frame at time at: one per Animate of the last
// pass, in pass order.
func ticked[E](f *Frame[E], at duration) []E {
	f.now = at
	f.tickAt = Some{Value: at}
	let mut out = []E{}
	for i in 0..f.nanims {
		out = out.Append(f.anims[i](at))
	}
	out
}

// pointed is the signal of a pointer event on the node id: None for a
// node with no Area function, one the tree no longer holds, or an event
// the function ignores.
func pointed[E](f *Frame[E], id Id[E], p PointerEvent) Option[E] {
	let n = f.nodes.Get(id.ref) catch {
	case arena.Stale:
		return None
	}
	match n.onPoint {
	case Some[func(p PointerEvent) Option[E]] as on:
		on.Value(p)
	case None:
		None
	}
}

// keyed is the signal of a key press: the first OnFocusKey on the path
// from the focused node up that gives one, else the first OnKey of the
// last pass that gives one.
func keyed[E](f *Frame[E], k KeyPress) Option[E] {
	match Focused(f) {
	case Some[Id[E]]:
		match focusKey(f, f.root, k).signal {
		case Some[E] as e:
			return Some{Value: e.Value}
		case None:
		}
	case None:
	}
	for i in 0..f.nkeys {
		match f.keys[i](k) {
		case Some[E] as e:
			return Some{Value: e.Value}
		case None:
		}
	}
	None
}

// focusHit is focusKey's answer under one node: whether the node holds
// the focus, and the signal of the first OnFocusKey on the way up from
// the focused node that gave one.
type focusHit[E] { found bool, signal Option[E] }

// focusKey looks for the focused node under r (r itself included) and,
// on the way back up, asks each node's OnFocusKey for k until one gives a
// signal.
func focusKey[E](f *Frame[E], r arena.Ref[node[E]], k KeyPress) focusHit[E] {
	let n = nodeAt(f, r)
	let mut hit = focusHit[E]{found: r == f.focus, signal: None}
	if !hit.found {
		for c in n.kids {
			if !hit.found {
				hit = focusKey[E](f, c, k)
			}
		}
	}
	if !hit.found {
		return hit
	}
	match hit.signal {
	case Some[E]:
		return hit
	case None:
	}
	match n.onKey {
	case Some[func(k KeyPress) Option[E]] as on:
		hit.signal = on.Value(k)
	case None:
	}
	hit
}
