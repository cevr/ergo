import arena

// Frame is the composer: the retained tree of the passes committed so far
// and the pass a view is writing. A view writes nodes into it; Render
// runs a view and commits the pass. The nodes live in one arena, so the
// tree holds Refs, not pointers.
//
// A pass reuses the storage of the last one (GP frame cost, UC-3): the
// pass's specs, cells, loads, key and frame functions are the first
// nspecs, ncells, nloads, nkeys and nanims elements of their lists, the
// rest is an older pass's, written over before it is read; the pass's
// maps are emptied in place. first and last are the root's first and
// last child spec (-1 for none).
type Frame[E] {
	nodes   arena.Of[node[E]],
	root    arena.Ref[node[E]],
	specs   []spec[E],
	nspecs  int,
	first   int,
	last    int,
	cells   []cellSpec,
	ncells  int,
	loads   []loadSpec[E],
	nloads  int,
	seen    Map[slotOf, int],
	seenLog []slotOf,
	nseen   int,
	index   Map[kid[E], arena.Ref[node[E]]],
	indexed Map[arena.Ref[node[E]], bool],
	stopped Map[int, bool],
	parent  int,
	each    CallSite,
	key     Key,
	epoch   int,
	ops     []Op[E],
	jobs    []Job[E],
	keys    []func(k KeyPress) Option[E],
	nkeys   int,
	anims   []func(at duration) E,
	nanims  int,
	rowRuns int,
}

// Id names one node of a Frame's tree, from the pass that made it until
// the pass that removes it. A host keeps its own copy of the tree by Id.
type Id[E] { ref arena.Ref[node[E]] }

// ident is a node's identity among its siblings: the call that wrote it,
// its Each row, and n, how many siblings before it have the same call and
// row. A node is kept across passes exactly when its identity returns
// under the same parent and its kind stays.
type ident { site CallSite, each CallSite, key Key, n int }

// kid is a node's identity among the children of one parent: owner is
// the parent's node of the last pass. The pass's index of the last pass's
// children is flat, one entry a child, so a lookup reads one entry and
// copies no sibling list (GP frame cost, UC-1). It is keyed by the old
// node, not by the spec, so a spec index that a cut gives back and the
// pass writes again finds its own parent's children.
type kid[E] { owner arena.Ref[node[E]], id ident }

// base is ident without n.
type base { site CallSite, each CallSite, key Key }

// slotOf is a base under one parent spec (-1 the root), for counting n.
type slotOf { parent int, b base }

// node is one retained node: what it shows, its identity, its children in
// order, the signal of a text (an Input), the cell an event on it writes
// (a Field, a Toggle, a Submit), and the cells and loads read directly
// under it. parked holds the old children that a stopped group did not
// write (H8a): out of the tree and the host's copy, with their cells,
// loads and subtrees, until a pass writes them again or a pass under this
// node stops no group.
type node[E] {
	node    Node[E],
	id      ident,
	kids    []arena.Ref[node[E]],
	parked  []arena.Ref[node[E]],
	off     bool,
	onText  Option[func(t string) E],
	onPoint Option[func(p PointerEvent) Option[E]],
	binds   Option[bound[E]],
	cells   Map[ident, Cell],
	loads   Map[ident, slot],
}

// bound is the cell an event on a node writes: the cell id of node owner.
type bound[E] { owner arena.Ref[node[E]], id ident }

// spec is one node a pass wrote: what it shows, its identity, the index
// of its parent spec (-1 for a child of the root), the node of the last
// pass with its identity (prev, Null for none) and the node of this pass
// (ref, set by Commit). The pass's tree is linked through the specs: first
// and last are the spec's first and last child, next and before its next
// and previous sibling (-1 for none), so the children of a spec are a
// walk, not a list built each pass.
type spec[E] {
	node    Node[E],
	id      ident,
	parent  int,
	prev    arena.Ref[node[E]],
	ref     arena.Ref[node[E]],
	onText  Option[func(t string) E],
	onPoint Option[func(p PointerEvent) Option[E]],
	binds   Option[cellAt],
	off     bool,
	first   int,
	last    int,
	next    int,
	before  int,
}

let nowhere = CallSite{File: "", Line: 0, Column: 0}

// Op is one change a host applies, in order. Before names the sibling the
// node goes in front of; None puts it last.
type Op[E] = Insert{Id Id[E], Parent Id[E], Before Option[Id[E]], Node Node[E]} | Move{Id Id[E], Parent Id[E], Before Option[Id[E]]} | Remove{Id Id[E]} | Set{Id Id[E], Node Node[E]}

// NewFrame is a composer whose tree has only its root.
func NewFrame[E]() Frame[E] {
	let mut nodes = arena.New[node[E]]()
	let root = nodes.Put(fresh[E](BoxNode{Style: Plain()}, ident{site: nowhere, each: nowhere, key: NoKey, n: 0}, None, None, false))
	Frame[E]{nodes: nodes, root: root, specs: []spec[E]{}, nspecs: 0, first: -1, last: -1, cells: []cellSpec{}, ncells: 0, loads: []loadSpec[E]{}, nloads: 0, seen: Map[slotOf, int]{}, seenLog: []slotOf{}, nseen: 0, index: Map[kid[E], arena.Ref[node[E]]]{}, indexed: Map[arena.Ref[node[E]], bool]{}, stopped: Map[int, bool]{}, parent: -1, each: nowhere, key: NoKey, epoch: 0, ops: []Op[E]{}, jobs: []Job[E]{}, keys: []func(k KeyPress) Option[E]{}, nkeys: 0, anims: []func(at duration) E{}, nanims: 0, rowRuns: 0}
}

func fresh[E](n Node[E], id ident, onText Option[func(t string) E], onPoint Option[func(p PointerEvent) Option[E]], off bool) node[E] {
	node[E]{node: n, id: id, kids: []arena.Ref[node[E]]{}, parked: []arena.Ref[node[E]]{}, off: off, onText: onText, onPoint: onPoint, binds: None, cells: Map[ident, Cell]{}, loads: Map[ident, slot]{}}
}

// Render writes view(s) as one pass of f and commits it: f's tree then
// shows what the view wrote, and the result is the changes a host applies.
func Render[E comparable, S](f *Frame[E], view func(f *Frame[E], s S), s S) []Op[E] {
	begin(f)
	view(f, s)
	Commit(f)
}

// begin starts a pass: nothing written yet.
func begin[E](f *Frame[E]) {
	f.nspecs = 0
	f.first = -1
	f.last = -1
	f.ncells = 0
	f.nloads = 0
	for s, _ in f.seen {
		f.seen = f.seen.Delete(s)
	}
	for k, _ in f.index {
		f.index = f.index.Delete(k)
	}
	for p, _ in f.indexed {
		f.indexed = f.indexed.Delete(p)
	}
	for p, _ in f.stopped {
		f.stopped = f.stopped.Delete(p)
	}
	f.nseen = 0
	f.parent = -1
	f.each = nowhere
	f.key = NoKey
	f.nkeys = 0
	f.nanims = 0
	f.rowRuns = 0
}

// identify is the identity of the next entry at site under the current
// parent and row.
func identify[E](f *Frame[E], at CallSite) ident {
	let s = slotOf{parent: f.parent, b: base{site: at, each: f.each, key: f.key}}
	let n = count(f.seen, s)
	f.seen[s] = n + 1
	if f.nseen < len(f.seenLog) {
		f.seenLog[f.nseen] = s
	} else {
		f.seenLog = f.seenLog.Append(s)
	}
	f.nseen = f.nseen + 1
	ident{site: at, each: f.each, key: f.key, n: n}
}

func count(seen Map[slotOf, int], s slotOf) int {
	match seen.Get(s) {
	case Some[int] as c:
		c.Value
	case None:
		0
	}
}

// owner is the node of the last pass that the current parent spec was:
// the root for the top, Null when the parent is new in this pass.
func owner[E](f *Frame[E], parent int) arena.Ref[node[E]] {
	if parent < 0 {
		return f.root
	}
	f.specs[parent].prev
}

// prior is the node of the last pass with identity id under the current
// parent, Null for none.
func prior[E](f *Frame[E], id ident) arena.Ref[node[E]] {
	let o = owner(f, f.parent)
	if !arena.Has(f.nodes, o) {
		return arena.Null[node[E]]()
	}
	if f.indexed.Get(o) == None {
		for i in 0..kidCount(f, o) {
			let r = kidAt(f, o, i)
			f.index[kid[E]{owner: o, id: idOf(f, r)}] = r
		}
		for r in parkedOf(f, o) {
			let k = kid[E]{owner: o, id: idOf(f, r)}
			if !has(f.index, k) {
				f.index[k] = r
			}
		}
		f.indexed[o] = true
	}
	match f.index.Get(kid[E]{owner: o, id: id}) {
	case Some[arena.Ref[node[E]]] as r:
		r.Value
	case None:
		arena.Null[node[E]]()
	}
}

// put writes one node under the current parent and returns its index.
func put[E](f *Frame[E], n Node[E], onText Option[func(t string) E], binds Option[cellAt], at CallSite) int {
	let id = identify(f, at)
	let mut prev = prior(f, id)
	if arena.Has(f.nodes, prev) && kindAt(f, prev) != kindOf(n) {
		prev = arena.Null[node[E]]()
	}
	let i = f.nspecs
	let p = f.parent
	let sp = spec[E]{node: n, id: id, parent: p, prev: prev, ref: arena.Null[node[E]](), onText: onText, onPoint: None, binds: binds, off: (p >= 0 && f.specs[p].off) || disables(n), first: -1, last: -1, next: -1, before: lastKid(f, p)}
	if i < len(f.specs) {
		f.specs[i] = sp
	} else {
		f.specs = f.specs.Append(sp)
	}
	f.nspecs = i + 1
	if p < 0 {
		if f.last < 0 {
			f.first = i
		} else {
			f.specs[f.last].next = i
		}
		f.last = i
	} else {
		if f.specs[p].last < 0 {
			f.specs[p].first = i
		} else {
			f.specs[f.specs[p].last].next = i
		}
		f.specs[p].last = i
	}
	i
}

// firstKid is the first child spec of spec p (-1 the root), -1 for none.
func firstKid[E](f *Frame[E], p int) int {
	if p < 0 {
		return f.first
	}
	f.specs[p].first
}

// lastKid is the last child spec of spec p (-1 the root), -1 for none.
func lastKid[E](f *Frame[E], p int) int {
	if p < 0 {
		return f.last
	}
	f.specs[p].last
}

// childrenOf is the child specs of spec p (-1 the root), in order.
func childrenOf[E](f *Frame[E], p int) []int {
	let mut out = []int{}
	let mut s = firstKid(f, p)
	for s >= 0 {
		out = out.Append(s)
		s = f.specs[s].next
	}
	out
}

// open writes a node and runs body with that node as the parent. It is a
// group (H8a): a failure that leaves body cuts the node and what body
// wrote, and passes on.
func open[E, F](f *Frame[E], n Node[E], body func() fails F, at CallSite) fails F {
	let m = markOf(f)
	f.parent = put(f, n, None, None, at)
	body() catch {
	case err:
		cut(f, m)
		return err
	}
	f.parent = m.parent
}

// Fieldset is a container that says what its controls are (H4r), as
// HTML's fieldset does: while disabled, a press or a text on any node
// under it does nothing (Handle), and a locator reports each control
// under it disabled; description, when not empty, is the accessible
// description of the nodes under it that no nearer Fieldset describes.
func Fieldset[E, F](f *Frame[E], disabled bool, description string, body func() fails F, at CallSite) fails F {
	try open(f, FieldsetNode{Disabled: disabled, Description: description}, body, at)
}

// disables is whether n is a disabled Fieldset.
func disables[E](n Node[E]) bool {
	match n {
	case FieldsetNode as x:
		x.Disabled
	case _:
		false
	}
}

// Box is a container that stacks its children.
func Box[E, F](f *Frame[E], style Style, body func() fails F, at CallSite) fails F {
	try open(f, BoxNode{Style: style}, body, at)
}

// Row lays its children out left to right.
func Row[E, F](f *Frame[E], style Style, body func() fails F, at CallSite) fails F {
	try open(f, RowNode{Style: style}, body, at)
}

// Column lays its children out top to bottom.
func Column[E, F](f *Frame[E], style Style, body func() fails F, at CallSite) fails F {
	try open(f, ColumnNode{Style: style}, body, at)
}

// Scroll shows its children in a scrolled viewport.
func Scroll[E, F](f *Frame[E], style Style, body func() fails F, at CallSite) fails F {
	try open(f, ScrollNode{Style: style}, body, at)
}

// Pressable sends on when the host presses it; body is what it shows.
func Pressable[E, F](f *Frame[E], label string, on E, body func() fails F, at CallSite) fails F {
	try open(f, PressableNode{Label: label, On: on, Style: Plain()}, body, at)
}

// Text shows a string.
func Text[E](f *Frame[E], value string, at CallSite) {
	let _ = put(f, TextNode{Value: value, Style: Plain()}, None, None, at)
}

// Check shows a check box; a press sends on.
func Check[E](f *Frame[E], label string, checked bool, on E, at CallSite) {
	let _ = put(f, CheckNode{Label: label, Checked: checked, On: on}, None, None, at)
}

// Input shows a text field with value; a text the host takes in it sends
// onText(text). The program owns the value (in its machine state).
func Input[E](f *Frame[E], value string, placeholder string, onText escaping func(t string) E, at CallSite) {
	let _ = put(f, InputNode{Value: value, Placeholder: placeholder}, Some{Value: onText}, None, at)
}

// Each writes row(x) for each x of xs. The nodes a row writes take the
// row's key, so a row keeps its instance when xs is reordered. It is a
// group with no node of its own (H8a): a failure that leaves a row cuts
// every row written so far and passes on.
func Each[E, F, T](f *Frame[E], xs []T, key func(x T) Key, row func(x T) fails F, at CallSite) fails F {
	let m = markOf(f)
	let outerEach = f.each
	let outerKey = f.key
	for x in xs {
		f.each = at
		f.key = key(x)
		row(x) catch {
		case err:
			cut(f, m)
			return err
		}
	}
	f.each = outerEach
	f.key = outerKey
}

// Commit makes f's tree show what the pass wrote and returns the changes,
// in the order a host applies them. A node whose identity returns under
// the same parent keeps its Id; a keyed row that moved is one Move. It
// also decides the pass's jobs (Jobs): a load that is new or has a new
// key is fetched, and a load that ended or changed key is cancelled.
func Commit[E comparable](f *Frame[E]) []Op[E] {
	f.ops = []Op[E]{}
	f.jobs = []Job[E]{}
	reconcile(f, -1, f.root)
	settle(f)
	f.ops
}

// at is the node r names; every Ref the tree holds is live.
func nodeAt[E](f *Frame[E], r arena.Ref[node[E]]) node[E] {
	f.nodes.Get(r) catch {
	case arena.Stale:
		Unreachable("ui: the tree holds a freed node")
	}
}

// The readers of one field of a retained node read it in place, through
// the arena's borrow, and copy only what they return: nodeAt copies the
// whole node, its children and its cell and load maps, to read one field
// (GP frame cost, UC-2).

// idOf is the identity of the node r names.
func idOf[E](f *Frame[E], r arena.Ref[node[E]]) ident {
	let mut id = ident{site: nowhere, each: nowhere, key: NoKey, n: 0}
	change(f, r, func(n *node[E]) { id = n.id })
	id
}

// kindAt is the kind of what the node r names shows.
func kindAt[E](f *Frame[E], r arena.Ref[node[E]]) int {
	let mut k = -1
	change(f, r, func(n *node[E]) { k = kindOf(n.node) })
	k
}

// shows is whether the node r names shows x.
func shows[E comparable](f *Frame[E], r arena.Ref[node[E]], x Node[E]) bool {
	let mut same = false
	change(f, r, func(n *node[E]) { same = n.node == x })
	same
}

// kidCount is the number of children of the node r names.
func kidCount[E](f *Frame[E], r arena.Ref[node[E]]) int {
	let mut c = 0
	change(f, r, func(n *node[E]) { c = len(n.kids) })
	c
}

// kidAt is child i of the node r names.
func kidAt[E](f *Frame[E], r arena.Ref[node[E]], i int) arena.Ref[node[E]] {
	let mut k = arena.Null[node[E]]()
	change(f, r, func(n *node[E]) { k = n.kids[i] })
	k
}

// kidsOf is the children of the node r names.
func kidsOf[E](f *Frame[E], r arena.Ref[node[E]]) []arena.Ref[node[E]] {
	let mut kids = []arena.Ref[node[E]]{}
	change(f, r, func(n *node[E]) { kids = n.kids })
	kids
}

// change runs edit on the node r names.
func change[E](f *Frame[E], r arena.Ref[node[E]], edit func(n *node[E])) {
	f.nodes.Update(r, edit) catch {
	case arena.Stale:
		Unreachable("ui: the tree holds a freed node")
	}
}

func emit[E](f *Frame[E], op Op[E]) { f.ops = f.ops.Append(op) }

// reconcile makes the children of parent (spec index p, node pr) the nodes
// of the child specs of p, keeping each old child that put matched (prev),
// and then does the same below each child. When every child is the old
// child at its place, nothing moves, and the pass builds no list (UC-3).
func reconcile[E comparable](f *Frame[E], p int, pr arena.Ref[node[E]]) {
	if inPlace(f, p, pr) {
		let mut s = lastKid(f, p)
		for s >= 0 {
			let r = f.specs[s].prev
			f.specs[s].ref = r
			update(f, s, r)
			reconcile[E](f, s, r)
			s = f.specs[s].before
		}
		return
	}
	let want = childrenOf(f, p)
	let old = kidsOf(f, pr)
	let mut oldAt = Map[arena.Ref[node[E]], int]{}
	let mut used = []bool{}
	for i, r in old {
		oldAt[r] = i
		used = used.Append(false)
	}
	let mut src = []int{}
	for s in want {
		let mut from = -1
		match oldAt.Get(f.specs[s].prev) {
		case Some[int] as o:
			if !used[o.Value] {
				from = o.Value
				used[o.Value] = true
			}
		case None:
		}
		src = src.Append(from)
	}
	// A parked child that a spec matched comes back (revived); the other
	// parked children stay parked while a group under p stopped in this
	// pass, and are dropped otherwise. An old child the pass did not write
	// leaves the host's copy, and is parked or dropped by the same rule.
	let park = stops(f, p)
	let held = parkedOf(f, pr)
	let mut heldAt = Map[arena.Ref[node[E]], int]{}
	let mut back = []bool{}
	for i, r in held {
		heldAt[r] = i
		back = back.Append(false)
	}
	let mut revive = []bool{}
	for j, s in want {
		let mut again = false
		if src[j] < 0 {
			match heldAt.Get(f.specs[s].prev) {
			case Some[int] as h:
				if !back[h.Value] {
					back[h.Value] = true
					again = true
				}
			case None:
			}
		}
		revive = revive.Append(again)
	}
	let mut parked = []arena.Ref[node[E]]{}
	for i, r in old {
		if !used[i] {
			emit(f, Remove{Id: Id[E]{ref: r}})
			if park {
				parked = parked.Append(r)
			} else {
				drop(f, r)
			}
		}
	}
	for i, r in held {
		if !back[i] {
			if park {
				parked = parked.Append(r)
			} else {
				drop(f, r)
			}
		}
	}
	let keep = increasing(src)
	let mut refs = []arena.Ref[node[E]]{}
	for j, s in want {
		let sp = f.specs[s]
		if src[j] >= 0 {
			refs = refs.Append(old[src[j]])
		} else if revive[j] {
			refs = refs.Append(sp.prev)
			unpark(f, sp.prev)
		} else {
			refs = refs.Append(f.nodes.Put(fresh(sp.node, sp.id, sp.onText, sp.onPoint, sp.off)))
		}
		f.specs[s].ref = refs[j]
	}
	change(f, pr, func(n *node[E]) {
		n.kids = refs
		n.parked = parked
	})
	let parent = Id[E]{ref: pr}
	for k in 0..len(want) {
		let j = len(want) - 1 - k
		let mut before Option[Id[E]] = None
		if j+1 < len(refs) {
			before = Some{Value: Id[E]{ref: refs[j+1]}}
		}
		let sp = f.specs[want[j]]
		let id = Id[E]{ref: refs[j]}
		if src[j] < 0 {
			emit(f, Insert{Id: id, Parent: parent, Before: before, Node: sp.node})
			if revive[j] {
				change(f, refs[j], func(n *node[E]) {
					n.node = sp.node
					n.onText = sp.onText
					n.onPoint = sp.onPoint
					n.off = sp.off
				})
			}
		} else {
			update(f, want[j], refs[j])
			if !keep[j] {
				emit(f, Move{Id: id, Parent: parent, Before: before})
			}
		}
		reconcile[E](f, want[j], refs[j])
	}
}

// unpark makes a parked node that comes back hold no child in the tree:
// the host's copy has none of them, so its old children are parked under
// it, and each comes back by the same rule when the pass wrote it.
func unpark[E](f *Frame[E], r arena.Ref[node[E]]) {
	change(f, r, func(n *node[E]) {
		let mut all = n.parked
		for k in n.kids {
			all = all.Append(k)
		}
		n.parked = all
		n.kids = []arena.Ref[node[E]]{}
	})
}

// inPlace is whether the child specs of p are the children of pr, each
// the old child at its own place, and pr holds no parked child.
func inPlace[E](f *Frame[E], p int, pr arena.Ref[node[E]]) bool {
	if parkedCount(f, pr) > 0 {
		return false
	}
	let n = kidCount(f, pr)
	let mut i = 0
	let mut s = firstKid(f, p)
	for s >= 0 {
		if i >= n || f.specs[s].prev != kidAt(f, pr, i) {
			return false
		}
		i = i + 1
		s = f.specs[s].next
	}
	i == n
}

// update makes the kept node r show spec s: a Set when what it shows
// changed, and the spec's functions.
func update[E comparable](f *Frame[E], s int, r arena.Ref[node[E]]) {
	let sp = f.specs[s]
	if !shows(f, r, sp.node) {
		emit(f, Set{Id: Id[E]{ref: r}, Node: sp.node})
	}
	change(f, r, func(n *node[E]) {
		n.node = sp.node
		n.onText = sp.onText
		n.onPoint = sp.onPoint
		n.off = sp.off
	})
}

// drop frees the node r names and every node below it; each load they
// own is cancelled.
func drop[E](f *Frame[E], r arena.Ref[node[E]]) {
	let n = nodeAt(f, r)
	for k in n.kids {
		drop[E](f, k)
	}
	for k in n.parked {
		drop[E](f, k)
	}
	for _, l in n.loads {
		f.jobs = f.jobs.Append(Cancel{Epoch: l.epoch})
	}
	let _ = f.nodes.Free(r) catch {
	case arena.Stale:
		Unreachable("ui: the tree holds a freed node")
	}
}

// increasing marks the kept children: the longest run of reused children
// whose old positions increase in their new order (src[j] is the old
// position of new child j, or -1 for a new one). A kept child stays where
// it is; every other reused child is one Move. Patience sorting, O(n log n).
func increasing(src []int) []bool {
	let mut keep = []bool{}
	let mut prev = []int{}
	for _ in src {
		keep = keep.Append(false)
		prev = prev.Append(-1)
	}
	let mut tails = []int{}
	for j, v in src {
		if v >= 0 {
			let mut lo = 0
			let mut hi = len(tails)
			for lo < hi {
				let mid = (lo + hi) / 2
				if src[tails[mid]] < v {
					lo = mid + 1
				} else {
					hi = mid
				}
			}
			if lo > 0 {
				prev[j] = tails[lo-1]
			}
			if lo == len(tails) {
				tails = tails.Append(j)
			} else {
				tails[lo] = j
			}
		}
	}
	if len(tails) > 0 {
		let mut j = tails[len(tails)-1]
		for j >= 0 {
			keep[j] = true
			j = prev[j]
		}
	}
	keep
}

// kindOf numbers the variants of Node: a node keeps its Id only while its
// kind stays.
func kindOf[E](n Node[E]) int {
	match n {
	case BoxNode:
		0
	case RowNode:
		1
	case ColumnNode:
		2
	case ScrollNode:
		3
	case TextNode:
		4
	case PressableNode[E]:
		5
	case CheckNode[E]:
		6
	case InputNode:
		7
	case ToggleNode:
		8
	case AreaNode:
		9
	case CanvasNode:
		10
	case RowsNode:
		11
	case FieldsetNode:
		12
	}
}

// Root is the Id of the root, the parent of what a view writes at its top.
func Root[E](f *Frame[E]) Id[E] { Id[E]{ref: f.root} }

// Len is the number of nodes in f's tree, the root included. A parked
// node is not in the tree.
func Len[E](f *Frame[E]) int { treeSize(f, f.root) }

func treeSize[E](f *Frame[E], r arena.Ref[node[E]]) int {
	let mut c = 1
	for i in 0..kidCount(f, r) {
		c = c + treeSize[E](f, kidAt(f, r, i))
	}
	c
}

// Retained is the number of nodes f holds: the tree's and the parked ones,
// with their subtrees. It is the frame's memory: a parked node that is
// never released shows here (the growth guard of the boundary laws).
func Retained[E](f *Frame[E]) int { arena.Len(f.nodes) }

// Kids are the children of id, in order; none for an Id f does not hold.
func Kids[E](f *Frame[E], id Id[E]) []Id[E] {
	let n = f.nodes.Get(id.ref) catch {
	case arena.Stale:
		return []Id[E]{}
	}
	let mut out = []Id[E]{}
	for r in n.kids {
		out = out.Append(Id[E]{ref: r})
	}
	out
}

// NodeOf is what id shows; None for an Id f does not hold.
func NodeOf[E](f *Frame[E], id Id[E]) Option[Node[E]] {
	let n = f.nodes.Get(id.ref) catch {
	case arena.Stale:
		return None
	}
	Some{Value: n.node}
}
