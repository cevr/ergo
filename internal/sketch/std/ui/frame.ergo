// Frame is one build pass of a view: the nodes it wrote, in preorder. Only
// New and the primitives change it.
type Frame[E] {
	specs  []spec[E],
	parent int,
	each   CallSite,
	key    Key,
}

// spec is one node a view wrote: what it shows, the call that wrote it,
// the Each row it belongs to (each, key), the index of its parent spec (-1
// for a child of the root), and, for an Input, the signal of a text.
type spec[E] {
	node   Node[E],
	site   CallSite,
	each   CallSite,
	key    Key,
	parent int,
	onText Option[func(t string) E],
}

let nowhere = CallSite{File: "", Line: 0, Column: 0}

// NewFrame is an empty frame.
func NewFrame[E]() Frame[E] {
	Frame[E]{specs: []spec[E]{}, parent: -1, each: nowhere, key: NoKey}
}

// put writes one node under the current parent and returns its index.
func put[E](f *Frame[E], n Node[E], onText Option[func(t string) E], at CallSite) int {
	f.specs = f.specs.Append(spec[E]{node: n, site: at, each: f.each, key: f.key, parent: f.parent, onText: onText})
	len(f.specs) - 1
}

// open writes a node and runs body with that node as the parent.
func open[E](f *Frame[E], n Node[E], body func(), at CallSite) {
	let outer = f.parent
	f.parent = put(f, n, None, at)
	body()
	f.parent = outer
}

// Box is a container that stacks its children.
func Box[E](f *Frame[E], style Style, body func(), at CallSite) {
	open(f, BoxNode{Style: style}, body, at)
}

// Row lays its children out left to right.
func Row[E](f *Frame[E], style Style, body func(), at CallSite) {
	open(f, RowNode{Style: style}, body, at)
}

// Column lays its children out top to bottom.
func Column[E](f *Frame[E], style Style, body func(), at CallSite) {
	open(f, ColumnNode{Style: style}, body, at)
}

// Scroll shows its children in a scrolled viewport.
func Scroll[E](f *Frame[E], style Style, body func(), at CallSite) {
	open(f, ScrollNode{Style: style}, body, at)
}

// Pressable sends on when the host presses it; body is what it shows.
func Pressable[E](f *Frame[E], label string, on E, body func(), at CallSite) {
	open(f, PressableNode{Label: label, On: on, Style: Plain()}, body, at)
}

// Text shows a string.
func Text[E](f *Frame[E], value string, at CallSite) {
	let _ = put(f, TextNode{Value: value, Style: Plain()}, None, at)
}

// Check shows a check box; a press sends on.
func Check[E](f *Frame[E], label string, checked bool, on E, at CallSite) {
	let _ = put(f, CheckNode{Label: label, Checked: checked, On: on}, None, at)
}

// Input shows a text field with value; a text the host takes in it sends
// onText(text).
func Input[E](f *Frame[E], value string, placeholder string, onText escaping func(t string) E, at CallSite) {
	let _ = put(f, InputNode{Value: value, Placeholder: placeholder}, Some{Value: onText}, at)
}

// Each writes row(x) for each x of xs. The nodes a row writes take the
// row's key, so a row keeps its instance when xs is reordered.
func Each[E, T](f *Frame[E], xs []T, key func(x T) Key, row func(x T), at CallSite) {
	let outerEach = f.each
	let outerKey = f.key
	for x in xs {
		f.each = at
		f.key = key(x)
		row(x)
	}
	f.each = outerEach
	f.key = outerKey
}
