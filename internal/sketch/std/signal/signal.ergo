// Package signal is the stops the host sends a process from outside:
// Ctrl-C, a service manager's terminate, a closed terminal (Go's
// os/signal for SIGINT, SIGTERM and SIGHUP; Effect's interruption of the
// main fiber on SIGINT). Stops is the capability; Watched is the host's
// provider and Script the provider a test or a law raises stops on. Both
// providers deliver through a queue.Queue, so Next waits as Pop does: it
// is an interruption point, and a stopped task never hangs in it.
// UntilStop turns a stop into structured cancellation: the body is
// stopped, its exit actions run, and UntilStop fails with Stopped.

import os
import queue
import scope
import sync
import tasks

// Interrupt is SIGINT: Ctrl-C at a terminal.
type Interrupt {}

// Terminate is SIGTERM: a polite request to end, as a service manager or
// kill sends it.
type Terminate {}

// Hangup is SIGHUP: the controlling terminal went away.
type Hangup {}

// Stop is a stop the host sent.
type Stop = Interrupt | Terminate | Hangup

// Stopped is the failure of UntilStop when a stop ended its body: Kind
// says which.
type Stopped { Kind Stop }

// Stops is a source of stops.
// law-exempt: Stops has no operation that makes a stop, so a member law
// cannot set one up; the host's Watched gets stops only from signals a law
// cannot send. The top-level laws RaisedInOrder, PollTakesOnce,
// QuietRunsBody and StopEndsBody state Next and Poll on Script.
type Stops {
	// Next waits for the next stop and takes it. It is an interruption
	// point of the calling task.
	Next() Stop,
	// Poll takes a stop already delivered, and is None when there is
	// none. It never waits.
	Poll() Option[Stop],
}

// Watched is the host's Stops for the kinds Watch named. Its fields give
// this package the construction authority, so only Watch makes one.
type Watched { q queue.Queue[int], id int } implements Stops

// Watch starts taking the stops of kinds from the host: from now until
// Unwatch, such a stop no longer ends the process but is delivered to
// Next. Pair it with scope.OnExit() { signal.Unwatch(w) }. It needs
// Ambient: only code that may choose the host's behaviour takes its
// stops. A stop that comes while eight wait untaken is dropped, as the
// host coalesces stops of one kind.
func Watch(kinds []Stop) Watched needs Ambient {
	let q = queue.New[int](8)
	let mut codes = []int{}
	for k in kinds {
		codes = codes.Append(codeOf(k))
	}
	Watched{q: q, id: hostWatch(q, codes)}
}

// Unwatch gives the host back its default action for the kinds w took:
// a later stop ends the process. Stops delivered before it stay for Poll
// and Next. A second Unwatch of w does nothing.
func Unwatch(w Watched) { hostUnwatch(w.id) }

// Next is the next stop the host sent, waiting for it.
func Next(w Watched) Stop { nextOf(w.q) }

// Poll is a stop the host already sent, if any.
func Poll(w Watched) Option[Stop] { pollOf(w.q) }

extern go ergo.local/prototype/runtime/v1.SignalWatch func hostWatch(q queue.Queue[int], kinds []int) int
extern go ergo.local/prototype/runtime/v1.SignalUnwatch func hostUnwatch(id int)

// Script is a Stops a program raises stops on itself: the provider of a
// test or a law, which sends no host signal. Raise may run in any task.
type Script { q queue.Queue[int] } implements Stops

// NewScript is a Script with raised already delivered, in order.
func NewScript(raised []Stop) Script {
	let s = Script{q: queue.New[int](len(raised) + 8)}
	for k in raised {
		s.Raise(k)
	}
	s
}

// Raise delivers k to s, after every stop raised before it. It waits
// while eight raised stops wait untaken beyond the ones NewScript gave.
func Raise(s Script, k Stop) {
	s.q.Push(codeOf(k)) catch {
	case queue.Closed:
		Unreachable("a Script's queue is never closed")
	}
}

// Next is the next stop raised on s, waiting for it.
func Next(s Script) Stop { nextOf(s.q) }

// Poll is a stop raised on s and not yet taken, if any.
func Poll(s Script) Option[Stop] { pollOf(s.q) }

// RaisedInOrder: the stops raised on a Script come out of Next in the
// order they were raised, and then Poll is None.
law RaisedInOrder(picks []int) {
	let mut raised = []Stop{}
	for p in picks {
		raised = raised.Append(stopOf((p%3+3)%3 + 1))
	}
	let s = NewScript(raised)
	for k in raised {
		if s.Next() != k {
			return false
		}
	}
	s.Poll() == None
}

// PollTakesOnce: a stop Poll took is gone; a second Poll is None.
law PollTakesOnce(pick int) {
	let k = stopOf((pick%3+3)%3 + 1)
	let s = NewScript([]Stop{k})
	s.Poll() == Some[Stop]{Value: k} && s.Poll() == None
}

// UntilStop runs body until it ends or a stop comes from s, whichever is
// first. When a stop comes first, body's task is stopped (its exit
// actions run before UntilStop returns) and UntilStop fails with
// Stopped. A stop that comes as body ends may be taken and dropped, as a
// loser of tasks.Race may take a value.
func UntilStop[T own, E, R](s Stops, body own func() T fails E needs R) T fails E | Stopped needs R {
	try tasks.Race([]func() T fails E | Stopped needs R{
		func() T fails E | Stopped needs R { try body() },
		func() T fails E | Stopped needs R { Stopped{Kind: s.Next()} },
	})
}

// QuietRunsBody: with no stop raised, UntilStop is its body's value.
law QuietRunsBody(n int) {
	let got = UntilStop(NewScript([]Stop{}), func() int { n }) catch {
	case Stopped:
		return false
	}
	got == n
}

// StopEndsBody: a stop raised while a body waits forever ends it; the
// body's exit action has run when UntilStop fails with Stopped of that
// kind. The stop comes once the body has started (afterStart): a stop
// already there may win before the body runs at all, and then the body
// has no exit action to run.
law StopEndsBody(pick int) {
	let k = stopOf((pick%3+3)%3 + 1)
	let cleaned = sync.NewRef[int](0)
	let started = queue.New[int](1)
	let never = queue.New[int](0)
	let _ = UntilStop(afterStart{started: started, k: k}, func() int {
		scope.OnExit() { cleaned.Update(func(v int) int { v + 1 }) }
		started.Push(1) catch {
		case queue.Closed:
		}
		never.Pop() catch {
		case queue.Closed:
			0
		}
	}) catch {
	case Stopped as st:
		return st.Kind == k && cleaned.Get() == 1
	}
	false
}

// afterStart is StopEndsBody's Stops: Next gives k once the body has
// pushed to started, so the stop comes while the body waits.
type afterStart { started queue.Queue[int], k Stop } implements Stops

func Next(a afterStart) Stop {
	let _ = a.started.Pop() catch {
	case queue.Closed:
		return a.k
	}
	a.k
}

func Poll(_ afterStart) Option[Stop] { None }

// StatusOf is the exit status of a program a stop of kind k ended: 128
// plus the signal's number, as a shell reports it: 130 for Interrupt, 143
// for Terminate, 129 for Hangup (the numbers are one on every Unix host).
// A main ends with it as signal.UntilStop(stops, run) catch { case
// signal.Stopped as s: return os.Exit{Code: signal.StatusOf(s.Kind),
// Message: ""} }, which writes no text, as the Go driver passes a stopped
// program's status on.
func StatusOf(k Stop) os.Code {
	match k {
	case Interrupt:
		130
	case Terminate:
		143
	case Hangup:
		129
	}
}

// StatusIsTheShells: StatusOf(k) is 128 plus the host's number of k's
// signal, and never a status of a program's own failure (1..125).
law StatusIsTheShells(pick int) {
	let k = stopOf((pick%3+3)%3 + 1)
	let s = int(StatusOf(k))
	s == 128 + hostNumber(codeOf(k)) && !(1 <= s && s <= 125)
}

extern go ergo.local/prototype/runtime/v1.SignalNumber func hostNumber(code int) int

// nextOf takes the next stop of q, waiting for it.
func nextOf(q queue.Queue[int]) Stop {
	let c = q.Pop() catch {
	case queue.Closed:
		Unreachable("a stop queue is never closed")
	}
	stopOf(c)
}

// pollOf takes a stop of q already there.
func pollOf(q queue.Queue[int]) Option[Stop] {
	match q.Poll() {
	case Some[int] as c:
		Some[Stop]{Value: stopOf(c.Value)}
	case None:
		None
	}
}

// codeOf is the code runtime/v1's SignalWatch names k by.
func codeOf(k Stop) int {
	match k {
	case Interrupt:
		1
	case Terminate:
		2
	case Hangup:
		3
	}
}

// stopOf is the Stop of a code codeOf gave.
func stopOf(c int) Stop {
	if c == 1 {
		Interrupt
	} else if c == 2 {
		Terminate
	} else {
		Hangup
	}
}
