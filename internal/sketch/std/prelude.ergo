// The prelude of the language (docs/spec/stdlib.md, Prelude). It is
// ordinary Ergo source, checked by internal/sketch/check like any other
// package; its exported names are in scope in every package without an
// import. The operation sets of the four capabilities are provisional: they
// hold only what the fixtures and the v0 corpus call (#209).

// Console writes lines to the host's standard output. Println writes one
// line; several values are one interpolated string, "\(a) \(b)".
type Console {
	Println(line string),
}

// Ambient is the authority to choose the host (docs/spec/stdlib.md, Host
// packages). Only the entry provides it: main lists it, and the host binds
// it. Its one operation is unexported, so no program type implements it
// and no context binds it. A host package's NewHost has it in its row:
// code that makes a host provider shows Ambient in its row too.
type Ambient {
	ambient(),
}

// Scheduler suspends the calling task.
type Scheduler {
	Sleep(d duration),
}

// LiveScheduler is the host's Scheduler provider: Sleep below is its
// operation, because its first parameter is a LiveScheduler (196m).
type LiveScheduler {}

// Sleep suspends the calling task for d on the host's clock.
extern go ergo.local/prototype/runtime/rt.Sleep func Sleep(s LiveScheduler, d duration)

// Clock reads the current time.
type Clock {
	Now() int64,
}

// Random draws random numbers.
type Random {
	Int63() int64,
}

// Option is a value that may be absent (#99).
type Some[T] { Value T }
type None {}
type Option[T] = Some[T] | None

// Range is the integers from Start up to End, End excluded: `a..b` builds
// one, and `for i in r` counts through it (#196, one for). A for and `..`
// take an integer T only; the type itself takes any ordered T.
type Range[T ordered] { Start T, End T }

// The functions on slices and Maps (#196, fourth round, item 2; spec
// D-D6). Each is reached only by the dot form on a value of exactly its
// first parameter's type, xs.Append(x), m.Get(k), m.Delete(k) (D-D8): it
// is an operation of the slice or Map type, not a name in a package's
// scope, as MoonBit's fn Array::push is called xs.push(x).

// Append is xs with x added at the end. Like Go's append, the result may
// share xs's array (aliasing follows Go in v1, check-v1 Q2).
extern go ergo.local/prototype/runtime/v1.Append func Append[T](xs []T, x T) []T

// Get is the value of k in m, Some{v}, or None when m has no key k: a Map
// read may miss, so it returns an Option.
extern go ergo.local/prototype/runtime/v1.Get func Get[K comparable, V](m Map[K, V], k K) Option[V]

// Delete is m without the key k. It changes m itself, as Go's delete does,
// and returns it (m = m.Delete(k)).
extern go ergo.local/prototype/runtime/v1.Delete func Delete[K comparable, V](m Map[K, V], k K) Map[K, V]

// Seq is an iterator: it calls yield with each value in turn and stops
// when yield returns false. `for v in s` runs the loop body as yield, and a
// break makes yield return false. Law: a Seq never calls yield again after
// yield returns false. Any function of this shape is a Seq by conversion,
// Seq[T](f). A Seq value lowers to the one Go shape of every Ergo function
// value (spec D5); the for adapts it to Go's range over func at the loop,
// and a std binding that returns Go's iter.Seq[T] adapts at the call.
type Seq[T] func(yield func(v T) bool)

// Decision is the result of a machine's step (docs/spec/runtime.md,
// Machines and actors).
type Enter[S] { Next S }
type Stay[S] { Next S }
type Ignore {}
type Reject {}
type Done[O] { Output O }
type Decision[S, O] = Enter[S] | Stay[S] | Ignore | Reject | Done[O]

// Task is a started task: task.Go() { … } yields one
// (docs/spec/runtime.md, Tasks). E is an error row.
type Task[T, E] {
	Wait() T fails E,
	Stop(),
}
