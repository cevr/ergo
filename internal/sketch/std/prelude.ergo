// The prelude of the language (docs/spec/stdlib.md, Prelude). It is
// ordinary Ergo source, checked by internal/sketch/check like any other
// package; its exported names are in scope in every package without an
// import. The operation sets of the capabilities are provisional: they
// hold only what the fixtures and the v0 corpus call (#209). Clock is in
// std time (time.Clock), because its Now returns a time.Time, which the
// prelude cannot name (std-align S2b).

// Console writes lines to the host's standard output. Println writes one
// line; several values are one interpolated string, "\(a) \(b)".
// law-exempt: Console has no read operation, so no law over its own operations can observe a write; the recording provider of std io carries the law (PrintsConcatenate).
type Console {
	Println(line string),
}

// Ambient is the authority to choose the host (docs/spec/stdlib.md, Host
// packages). Only the entry provides it: main lists it, and the host binds
// it. Its one operation is unexported, so no program type implements it
// and no context binds it. A host package's NewHost has it in its row:
// code that makes a host provider shows Ambient in its row too.
// law-exempt: its one operation is unexported and returns nothing, so no law can call or observe it; the authority rule is checked by TestStdHostProvidersHaveAuthority instead.
type Ambient {
	ambient(),
}

// Scheduler suspends the calling task.
// law-exempt: Sleep returns nothing, and a law over Scheduler alone sees no clock, so it cannot observe a sleep; the sleep laws are on time.Manual, which provides Scheduler and time.Clock together (TestManualClockModel).
type Scheduler {
	Sleep(d duration),
}

// LiveScheduler is the host's Scheduler provider: Sleep below is its
// operation, because its first parameter is a LiveScheduler (196m). It
// sleeps on the host's clock, so it is a host provider (docs/spec/
// stdlib.md, Host packages): its field gives the prelude the construction
// authority, and only NewLiveScheduler makes one (std-align S2b).
type LiveScheduler { live liveOnly }

// liveOnly is the zero-size type of LiveScheduler's field.
type liveOnly {}

// NewLiveScheduler is the host's Scheduler provider. It needs Ambient: only
// code whose row holds the authority to choose the host makes one. A test
// binds time.Manual instead.
func NewLiveScheduler() LiveScheduler needs Ambient { LiveScheduler{live: liveOnly} }

// Sleep suspends the calling task for d on the host's clock.
extern go ergo.local/prototype/runtime/rt.Sleep func Sleep(s LiveScheduler, d duration)

// Random draws random numbers, with the names and meaning of Go's
// math/rand/v2 (Effect Random). Uint64 is 64 random bits; IntN(n) is in
// 0..n-1, and an n of zero or less is a defect, as Go's IntN panics;
// Float64 is in [0, 1). std rand provides it: rand.Seeded(seed) for tests
// and replays, rand.NewHost() for the host (std-align S2c).
type Random {
	Uint64() uint64,
	IntN(n int) int,
	Float64() float64,

	// IntNInRange: a draw of IntN(n) is in 0..n-1, for each n above zero.
	law IntNInRange(n int) {
		if n <= 0 {
			return true
		}
		let x = IntN(n)
		x >= 0 && x < n
	},

	// Float64InUnit: a draw of Float64 is in [0, 1).
	law Float64InUnit() {
		let f = Float64()
		f >= 0.0 && f < 1.0
	},
}

// Option is a value that may be absent (#99).
type Some[T] { Value T }
type None {}
type Option[T] = Some[T] | None

// Range is the integers from Start up to End, End excluded: `a..b` builds
// one, and `for i in r` counts through it (#196, one for). A for and `..`
// take an integer T only; the type itself takes any ordered T.
type Range[T ordered] { Start T, End T }

// The functions on slices and Maps (#196, fourth round, item 2; spec
// D-D6). Each is reached only by the dot form on a value of exactly its
// first parameter's type, xs.Append(x), m.Get(k), m.Delete(k) (D-D8): it
// is an operation of the slice or Map type, not a name in a package's
// scope, as MoonBit's fn Array::push is called xs.push(x).

// Append is xs with x added at the end. xs is unchanged: a slice is a
// value (owner q26; types.md, Bindings), and the lowering appends in place
// only for xs = xs.Append(x) or a dead xs.
extern go ergo.local/prototype/runtime/v1.Append func Append[T](xs []T, x T) []T

// Get is the value of k in m, Some{v}, or None when m has no key k: a Map
// read may miss, so it returns an Option.
extern go ergo.local/prototype/runtime/v1.Get func Get[K comparable, V](m Map[K, V], k K) Option[V]

// Delete is m without the key k. m is unchanged: a Map is a value (owner
// q26), and the lowering deletes in place only for m = m.Delete(k) or a
// dead m.
extern go ergo.local/prototype/runtime/v1.Delete func Delete[K comparable, V](m Map[K, V], k K) Map[K, V]

// Unreachable states that a path cannot run (owner q29, 2026-11-08). When
// it runs anyway, it raises a defect that holds reason and the call's
// source position: never a typed failure, so it is in no row and no catch
// handles it (docs/spec/runtime.md, Exit causes 3). Its result is the
// bottom type: the checker gives the call the type its position expects (a
// typed let, an argument, a return, a branch of a value if or match), and
// as the last statement of a body or branch it yields no value and joins
// any type, as return does (docs/spec/types.md, Unreachable).
extern go ergo.local/prototype/runtime/v1.Unreachable func Unreachable(reason string)

// Seq is an iterator: it calls yield with each value in turn and stops
// when yield returns false. `for v in s` runs the loop body as yield, and a
// break makes yield return false. Seq is a function type, so it carries no
// member law: each std producer of a Seq states that it stops as a law of
// its own, <Producer>Stops (docs/spec/stdlib.md, Std laws 5). Any function of this shape is a Seq by conversion,
// Seq[T](f). A Seq value lowers to the one Go shape of every Ergo function
// value (spec D5); the for adapts it to Go's range over func at the loop,
// and a std binding that returns Go's iter.Seq[T] adapts at the call.
type Seq[T] func(yield func(v T) bool)

// Decision is the result of a machine's step (docs/spec/runtime.md,
// Machines and actors).
type Enter[S] { Next S }
type Stay[S] { Next S }
type Emit[S, O] { Next S, Output O }
type Ignore {}
type Reject {}
type Done[O] { Output O }

// Enter moves to Next and opens a new entry; Stay moves to Next and keeps
// the entry; Emit moves to Next, opens a new entry, as Enter does, and
// gives Output while the machine keeps running; Ignore and Reject keep the
// state; Done ends the machine with Output.
type Decision[S, O] = Enter[S] | Stay[S] | Emit[S, O] | Ignore | Reject | Done[O]

// Timeout is a state's timer: when an entry of the state lasts In, the
// runner gives the machine Signal. The runner owns the timer: it starts
// when the entry opens, a Stay keeps it, and it never fires after its
// entry ended (docs/spec/runtime.md, Machines and actors 9).
type Timeout[E] { In duration, Signal E }

// Machine is a machine as a value: its initial state, its step, with the
// step's output O, error row F and capability row R, and the timer of each
// state (README Gap 46). A value of a machine declaration `type X
// machine[S, E]` converts to Machine[S, E, O, F, R], with O, F and R read
// from its step's signature and After from its `after` entry (None for
// every state when it has none) and Work from its `work` entry: the Start
// of the state's std machines.Work, which the runner calls with the
// entry's send (None for every state when it has none; R then holds the
// work's row too). So a function over any machine names them (std
// machines.Run). A Machine is also an ordinary record: a test may build
// one from parts. The work's type is std machines.Work, not a prelude
// name: every prelude name is one a program cannot declare.
type Machine[S, E, O, F, R] {
	Initial S,
	Step func(s S, e E) Decision[S, O] fails F needs R,
	After func(s S) Option[Timeout[E]],
	Work func(s S) Option[func(send func(e E)) needs R],
}

// InputMachine is a machine whose initial state is a function of an input
// I (V4; owner decision O3b): a machine declaration whose initial names a
// function `func(i I) S` converts to it, as one with an initial value
// converts to Machine. std machines.Start gives the Machine that starts
// from Start(input).
type InputMachine[I, S, E, O, F, R] {
	Start func(input I) S,
	Step func(s S, e E) Decision[S, O] fails F needs R,
	After func(s S) Option[Timeout[E]],
	Work func(s S) Option[func(send func(e E)) needs R],
}

// Task is a started task: task.Go() { … } yields one
// (docs/spec/runtime.md, Tasks). E is an error row.
type Task[T, E] {
	Wait() T fails E,
	Stop(),

	// StopIsIdempotent: a second Stop returns, never fails and changes
	// nothing.
	law StopIsIdempotent() {
		Stop()
		Stop()
		true
	},
}
