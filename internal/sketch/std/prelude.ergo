// The prelude of the language (docs/spec/stdlib.md, Prelude). It is
// ordinary Ergo source, checked by internal/sketch/check like any other
// package; its exported names are in scope in every package without an
// import. The operation sets of the capabilities are provisional: they
// hold only what the fixtures and the v0 corpus call (#209). Clock is in
// std time (time.Clock), because its Now returns a time.Time, which the
// prelude cannot name (std-align S2b).

// Console writes lines to the host's standard output. Println writes one
// line; several values are one interpolated string, "\(a) \(b)".
// law-exempt: Console has no read operation, so no law over its own operations can observe a write; the recording provider of std io carries the law (PrintsConcatenate).
type Console {
	Println(line string),
}

// Ambient is the authority to choose the host (docs/spec/stdlib.md, Host
// packages). Only the entry provides it: main lists it, and the host binds
// it. Its one operation is unexported, so no program type implements it
// and no context binds it. A host package's NewHost has it in its row:
// code that makes a host provider shows Ambient in its row too.
// law-exempt: its one operation is unexported and returns nothing, so no law can call or observe it; the authority rule is checked by TestStdHostProvidersHaveAuthority instead.
type Ambient {
	ambient(),
}

// TestAmbient is the test's ambient (docs/spec/rows.md, Test's ambient;
// runtime.md, Tests 11): the authority a test has to reach the host,
// confined to a fresh temporary folder per case, which only the test
// runner provides. It is never the host's Ambient, which a test never
// holds. A named context whose header says `needs TestAmbient` may make
// the confined host providers (fs.NewTestHost, exec.NewTestHost,
// os.NewTestHost) while it is built:
//
//	let onHost = context needs TestAmbient { exec.Runner: exec.NewTestHost() }
//
// Each build of such a context, a with of it in a test or one case of a
// law run under it, gets a fresh empty folder under the test's temporary
// directory (TMPDIR), and the runner removes the folder and all it holds
// when the case ends. Its one operation is unexported, so no program type
// implements it and no context entry binds it.
// law-exempt: its one operation is unexported, so no law can call it; the confinement it gives is stated by the laws of fstest.Confined, which run over fstest.NewFolder, the Host of fs.NewTestHost in the same folder.
type TestAmbient {
	folder() string,
}

// TestFolder is the absolute path of the case's folder, with its symbolic
// links resolved. It exists and is empty when the case starts.
func TestFolder() string needs TestAmbient { TestAmbient.folder() }

// Scheduler suspends the calling task. Alarms is the same time as the
// runtime's own waits use it: an AlarmClock, on which a wait that runs no
// Ergo code (http.Serve's bound on each read phase) arms a deadline with
// no task and no sleep. A provider gives the AlarmClock of the time it
// sleeps on.
// law-exempt: Sleep returns nothing, and a law over Scheduler alone sees no clock, so it cannot observe a sleep; the sleep laws are on time.Manual, which provides Scheduler and time.Clock together (TestManualClockModel). An AlarmClock has no operation an Ergo law can call: only the runtime arms an alarm.
type Scheduler {
	Sleep(d duration),
	Alarms() AlarmClock,
}

// AlarmClock is a Scheduler's time as the runtime's waits use it
// (Scheduler.Alarms). Only the runtime makes one: LiveScheduler's is the
// host's timers, and a time.Manual's or a testing.VirtualClock's is its
// timeline.
// law-exempt: its one operation is the unexported runtimeOnly, so no law can call it; the runtime's After is held against NewTimer by TestVirtualAfterFuncIsTimer (runtime/rt).
extern go ergo.local/prototype/runtime/v1.AlarmClock type AlarmClock {
	runtimeOnly(),
}

// LiveScheduler is the host's Scheduler provider: Sleep below is its
// operation, because its first parameter is a LiveScheduler (196m). It
// sleeps on the host's clock, so it is a host provider (docs/spec/
// stdlib.md, Host packages): its field gives the prelude the construction
// authority, and only NewLiveScheduler makes one (std-align S2b).
type LiveScheduler { live liveOnly } implements Scheduler

// liveOnly is the zero-size type of LiveScheduler's field.
type liveOnly {}

// NewLiveScheduler is the host's Scheduler provider. It needs Ambient: only
// code whose row holds the authority to choose the host makes one. A test
// binds time.Manual instead.
func NewLiveScheduler() LiveScheduler needs Ambient { LiveScheduler{live: liveOnly} }

// Sleep suspends the calling task for d on the host's clock.
extern go ergo.local/prototype/runtime/rt.Sleep func Sleep(s LiveScheduler, d duration)

// Alarms is the host's timers, as the runtime arms them.
func Alarms(s LiveScheduler) AlarmClock { hostAlarms() }

extern go ergo.local/prototype/runtime/v1.HostAlarms func hostAlarms() AlarmClock

// Random draws random numbers, with the names and meaning of Go's
// math/rand/v2 (Effect Random). Uint64 is 64 random bits; IntN(n) is in
// 0..n-1, and an n of zero or less is a defect, as Go's IntN panics;
// Float64 is in [0, 1). std rand provides it: rand.Seeded(seed) for tests
// and replays, rand.NewHost() for the host (std-align S2c).
type Random {
	Uint64() uint64,
	IntN(n int) int,
	Float64() float64,

	// IntNInRange: a draw of IntN(n) is in 0..n-1, for each n above zero.
	law IntNInRange(n int) {
		if n <= 0 {
			return true
		}
		let x = IntN(n)
		x >= 0 && x < n
	},

	// Float64InUnit: a draw of Float64 is in [0, 1).
	law Float64InUnit() {
		let f = Float64()
		f >= 0.0 && f < 1.0
	},
}

// Option is a value that may be absent (#99).
type Some[T] { Value T }
type None {}
type Option[T] = Some[T] | None

// Unsatisfied is the failure of a refined type's derived parse function,
// ParsePort for `type Port int where 1 <= it && it <= 65535`: the value
// does not pass the where. Type is the refined type's name and Where the
// predicate's text (types.md, Refinements).
type Unsatisfied { Type string, Where string }

// unsatisfied fails u. Its row makes Unsatisfied an error type of the
// prelude, which declares it (types.md, Error types 1), so it is one in
// every package: each derived ParseN fails it, and its Go type has the
// Error method wherever a refined type is declared.
func unsatisfied(u Unsatisfied) fails Unsatisfied { u }

// NoMatch is the failure of a derived pattern's parse function, ParseDate
// for `type Date derive Pattern(…)`: Type is the derived type's name and
// At the length of the longest prefix of the text that is a prefix of a
// word of the pattern (patterns.md, The pattern bundle 2).
type NoMatch { Type string, At int }

// noMatch fails m; its row makes NoMatch an error type of the prelude, as
// unsatisfied does for Unsatisfied.
func noMatch(m NoMatch) fails NoMatch { m }

// Writer takes the events of a value's wire form (types.md, Codecs):
// the predeclared encode(v, w) calls it, and a format (std json) is a
// provider of it that writes text. A record is BeginObject(n), then Key
// and the field's events for each of its n fields, then EndObject; a
// union value is a record that starts with Tag(variant); a slice or tuple
// is BeginList(n), n values, EndList; a Map is an object keyed by its
// keys in order. Prior art: serde's Serializer, Roc's Encoding, Go json
// v2's jsontext.Encoder.
// law-exempt: Writer has no read operation, so no law over its own operations can observe an event; std codec's Events records them and carries the laws (EventsReplay).
type Writer {
	mut Null(),
	// Number writes the spelling of a number a Reader's Number read, as it
	// is; json.Value writes its numbers through it.
	mut Number(text string),
	mut Bool(b bool),
	mut Int(n int64),
	mut Uint(n uint64),
	mut Float(f float64),
	mut String(s string),
	// StringBytes writes the string whose UTF-8 bytes are b, as String
	// does (GX10): a by-name pair's append form writes its text through
	// it, so no string of the text is made. The writer reads b during the
	// call only and keeps none of it.
	mut StringBytes(b []byte),
	mut BeginList(n int),
	mut EndList(),
	mut BeginObject(n int),
	mut Tag(name string),
	mut Key(k string),
	mut EndObject(),
}

// Reader gives the events of a wire form back, in the order
// decode[T](r) asks for them: the pull form of Writer. A format's
// decode has checked the whole text first (phase 1), so a Reader
// fails only the shape failures: the event is not of the kind T needs
// (WireWrongKind), or an object has no tag (WireMissingField). More reports a
// next element or key before the end; Key reads it; Skip passes over the
// next value; End closes the list or object. Path is where the reader is,
// for a failure's text.
// law-exempt: a law over Reader alone has no events to read; std codec's Replay reads the events Events recorded and carries the laws (EventsReplay).
type Reader {
	// TakeNull consumes the next value only when it is null; otherwise it
	// leaves the reader at that value. No path or list index changes on false.
	mut TakeNull() bool,
	// Peek is the kind of the next value, which it leaves; an untyped
	// value (json.Value) reads by it.
	mut Peek() WireKind,
	// Number reads the next number's spelling, unparsed.
	mut Number() string fails WireWrongKind,
	mut Path() string,
	mut Bool() bool fails WireWrongKind,
	mut Int() int64 fails WireWrongKind,
	mut Uint() uint64 fails WireWrongKind,
	mut Float() float64 fails WireWrongKind,
	mut String() string fails WireWrongKind,
	// StringBytes reads the next string as String does and gives into with
	// its UTF-8 bytes added (GX12): an append-form pair's decode lends a
	// buffer and gives its ParseX the bytes, so no string of the text is
	// made. The reader keeps none of into.
	mut StringBytes(into []byte) []byte fails WireWrongKind,
	mut BeginList() fails WireWrongKind,
	mut BeginObject() fails WireWrongKind,
	mut Tag() string fails WireMissingField,
	mut More() bool,
	mut Key() string,
	mut Skip(),
	mut End(),
}

// The shape failures of decode (types.md, Codecs 2). WireWrongKind is a value
// of another kind than the type takes at Path, Want the kind it takes;
// WireMissingField is a field the object at Path does not have; WireUnknownTag is
// a union's tag that names none of its variants.
type WireWrongKind { Path string, Want string }

// WireKind is the kind of a Reader's next value (Reader.Peek). WireEnd is
// the end of the list or object being read: there is no next value.
type WireNull {}
type WireBool {}
type WireNumber {}
type WireString {}
type WireList {}
type WireObject {}
type WireEnd {}
type WireKind = WireNull | WireBool | WireNumber | WireString | WireList | WireObject | WireEnd
type WireMissingField { Path string, Field string }
type WireUnknownTag { Path string, Tag string }

// WireForm(x X)'s result declares X's representation to the wire protocol.
// These markers carry no runtime data. The codec checks the structural
// requirements of the selected form (types.md, Codecs 8).
type WireOmittable {}
type WireNullable {}
type WireBare {}
type WireNumberText {}
type WireMembers {}

// The rows of these functions make the shape failures error types of the
// prelude, as unsatisfied does for Unsatisfied.
func wireWrongKind(e WireWrongKind) fails WireWrongKind          { e }
func wireMissingField(e WireMissingField) fails WireMissingField { e }
func wireUnknownTag(e WireUnknownTag) fails WireUnknownTag       { e }

// Range is the integers from Start up to End, End excluded: `a..b` builds
// one, and `for i in r` counts through it (#196, one for). A for and `..`
// take an integer T only; the type itself takes any ordered T.
type Range[T ordered] { Start T, End T }

// CallSite is a position in Ergo source: File as a defect names it, Line
// and Column from 1, Column in bytes. A call may leave out its callee's
// final CallSite parameter, and the compiler passes the call's own site
// (types.md, Call sites). Id is the number the compiler gives that
// position, from 1, distinct for distinct positions of one program; a
// CallSite the program writes carries the Id it writes, 0 by convention.
type CallSite { File string, Line int, Column int, Id int }

// Context is a context as a value: the providers of the capability row R,
// built where a context converts to it (`let w Context[Store | Log] =
// context { … }`, an argument, a return). `with w { … }` installs them and
// discharges R; it builds nothing (rows.md, Context values). Only that
// conversion makes one: its field is the compiler's.
type Context[R] { install func() needs R }

// InForce is the providers of R in force at the call, as a Context value
// (rows.md, Context values, InForce): a function that keeps a function
// with needs R for later keeps InForce[R]() with it, and `with w { … }`
// installs them where it runs. It builds nothing. The value borrows the
// with blocks in force at the call: installed after the innermost owning
// one has ended, it is a defect. The compiler lowers each call in place;
// the Go function is never called.
extern go ergo.local/prototype/runtime/v1.InForce func InForce[R]() Context[R] needs R

// The operations of the slice and Map types (#196, fourth round, item 2;
// spec D-D6; PRIM-2b): xs.Append(x), m.Get(k), m.Put(k, v), m.Delete(k)
// and m.Take(k). Each is reached only by the dot form on a value of
// exactly a slice or Map type (D-D8): it is an operation of the type, the
// same in every program, not a name in a package's scope, as MoonBit's
// fn Array::push is called xs.push(x). The language declares them
// (check/collop.go); their laws are these, checked against the Go
// reference bodies of runtime/v1 (TestCollLaws).

// GetAfterPut: a Get of the key a Put set is Some of the value put.
law GetAfterPut(m Map[int, int], k int, v int) {
	match m.Put(k, v).Get(k) {
	case Some[int] as x:
		x.Value == v
	case None:
		false
	}
}

// GetAfterDelete: a Get of the key a Delete removed is None.
law GetAfterDelete(m Map[int, int], k int) {
	match m.Delete(k).Get(k) {
	case Some[int]:
		false
	case None:
		true
	}
}

// TakeIsGetAndDelete: a Take is the Get of its key and the Delete of it,
// and the Map it took from keeps its entries.
law TakeIsGetAndDelete(m Map[int, int], k int) {
	let v, rest = m.Take(k)
	sameEntry(v, m.Get(k)) && sameEntry(rest.Get(k), None) && len(rest) == len(m.Delete(k))
}

// AppendIsLast: Append adds one element, at the end.
law AppendIsLast(xs []int, x int) {
	let ys = xs.Append(x)
	len(ys) == len(xs)+1 && ys[len(xs)] == x
}

// TakeAtIsIndexAndRest: TakeAt is the element at i and xs without it, in
// order (PRIM-4).
law TakeAtIsIndexAndRest(xs []int, i int) {
	if i < 0 || i >= len(xs) {
		return true
	}
	let x, rest = xs.TakeAt(i)
	let mut ok = x == xs[i] && len(rest) == len(xs)-1
	for k, y in rest {
		ok = ok && (k < i && y == xs[k] || k >= i && y == xs[k+1])
	}
	ok
}

// SliceIsWindow: Slice is the elements of xs from i up to j (PRIM-4).
law SliceIsWindow(xs []int, i int, j int) {
	if i < 0 || j > len(xs) || i > j {
		return true
	}
	let w = xs.Slice(i, j)
	let mut ok = len(w) == j-i
	for k, y in w {
		ok = ok && y == xs[i+k]
	}
	ok
}

// CloneIsEqual: a Clone has m's entries (PRIM-4).
law CloneIsEqual(m Map[int, int], k int) {
	let c = m.Clone()
	len(c) == len(m) && sameEntry(c.Get(k), m.Get(k))
}

// sameEntry reports two reads of a Map entry as equal.
func sameEntry(a Option[int], b Option[int]) bool {
	match a {
	case Some[int] as x:
		match b {
		case Some[int] as y:
			x.Value == y.Value
		case None:
			false
		}
	case None:
		match b {
		case Some[int]:
			false
		case None:
			true
		}
	}
}

// Unreachable states that a path cannot run (owner q29, 2026-11-08). When
// it runs anyway, it raises a defect that holds reason and the call's
// source position: never a typed failure, so it is in no row and no catch
// handles it (docs/spec/runtime.md, Exit causes 3). Its result is the
// bottom type: the checker gives the call the type its position expects (a
// typed let, an argument, a return, a branch of a value if or match), and
// as the last statement of a body or branch it yields no value and joins
// any type, as return does (docs/spec/types.md, Unreachable).
extern go ergo.local/prototype/runtime/v1.Unreachable func Unreachable(reason string)

// AsWritten is v. A call tree inside it is kept as written: a rewrite law
// over functions never takes it as its root or a part of its match
// (docs/spec/types.md, Laws 14). The lowering knows it by its body's mark
// (//ergo:aswritten), never by its name.
extern go ergo.local/prototype/runtime/v1.AsWritten func AsWritten[T](v T) T

// Seq is an iterator: it calls yield with each value in turn and stops
// when yield returns false. `for v in s` runs the loop body as yield, and a
// break makes yield return false. Seq is a function type, so it carries no
// member law: each std producer of a Seq states that it stops as a law of
// its own, <Producer>Stops (docs/spec/stdlib.md, Std laws 5). Any function of this shape is a Seq by conversion,
// Seq[T](f). A Seq value lowers to the one Go shape of every Ergo function
// value (spec D5); the for adapts it to Go's range over func at the loop,
// and a std binding that returns Go's iter.Seq[T] adapts at the call.
type Seq[T own] func(yield func(v T) bool)

// Decision is the result of a machine's step (docs/spec/runtime.md,
// Machines and actors).
type Enter[S] { Next S }
type Stay[S] { Next S }
type Emit[S, O] { Next S, Output O }
type Ignore {}
type Reject {}
type Done[O] { Output O }
type Tell[S, O] { Next S, Output O }

// Enter moves to Next and opens a new entry; Stay moves to Next and keeps
// the entry; Emit moves to Next, opens a new entry, as Enter does, and
// gives Output while the machine keeps running; Tell moves to Next and
// keeps the entry, as Stay does, and gives Output, as Emit does; Ignore
// and Reject keep the state; Done ends the machine with Output. Only the
// first state, an Enter and an Emit open an entry: a Stay and a Tell keep
// the entry's timer and work (docs/spec/runtime.md, Machines and actors
// 2 and 9).
type Decision[S, O] = Enter[S] | Stay[S] | Emit[S, O] | Ignore | Reject | Done[O] | Tell[S, O]

// Never is the type with no value: a closed union of no variants
// (docs/spec/types.md, Never; owner, 2026-11-13). No literal, conversion
// or zero value makes one, so a value of a type that holds a Never (an
// Emit[S, Never], a Done[Never]) is never made either. A machine that
// gives no output is a Decision[S, Never]: its step writes no Emit and no
// Done, and a match over its decisions or outcomes writes no arm for them.
// A match on a Never value needs no arm. Never is no bottom type: it
// converts to no other type, except through Absurd. No source form
// declares an empty union, so this declaration's braces are the prelude's
// one exception (check, emptyUnion); it lowers to Go's struct{}, never
// built.
type Never {}

// Absurd is the value of any type T that a Never gives: since no Never is
// made, Absurd is never called (Elm's never, Haskell's absurd, Rust's
// match on Infallible). It is how a branch that holds a Never fits where a
// T is wanted.
func Absurd[T](n Never) T {
	match n {
	}
}

// Timeout is a state's timer: when an entry of the state lasts In, the
// runner gives the machine Signal. The runner owns the timer: it starts
// when the entry opens, a Stay or a Tell keeps it, and it never fires after its
// entry ended (docs/spec/runtime.md, Machines and actors 9).
type Timeout[E] { In duration, Signal E }

// Machine is a machine as a value: its initial state, its step, with the
// step's output O, error row F and capability row R, the timer of each
// state, and its work, whose capability row is W (README Gap 46). A value
// of a machine declaration `type X machine[S, E]` converts to Machine[S,
// E, O, F, R, W], with O, F and R read from its step's signature, After
// from its `after` entry (None for every state when it has none), and
// Work and W from its `work` entry: the Start of the state's std
// machines.Work, which the runner calls with the entry's send (None for
// every state when it has none; W is then empty). W is apart from R, so a
// fold, which runs no work, needs R only (std machines.Run), and the
// runner needs both. A Machine is also an ordinary record: a test may build
// one from parts. The work's type is std machines.Work, not a prelude
// name: every prelude name is one a program cannot declare.
//
// Exit is each state's exit action (FK9-g1; runtime.md, Machines and
// actors 12a): when an entry ends, the runner calls Exit with the state
// the entry holds then (its last commit, never the next entry's) and, on
// Some, runs the action, masked, once its children, timer and work ended
// and before the next entry opens; a Stay ends no entry. A machine with no
// `exit` entry gives every state None. The action's row is part of W; a
// fold runs no exit action.
type Machine[S, E, O, F, R, W] {
	Initial S,
	Step    func(s S, e E) Decision[S, O] fails F needs R,
	After   func(s S) Option[Timeout[E]],
	Work    func(s S) Option[func(send func(e E)) needs W],
	Exit    func(s S) Option[func() needs W],
}

// InputMachine is a machine whose initial state is a function of an input
// I (V4; owner decision O3b): a machine declaration whose initial names a
// function `func(i I) S` converts to it, as one with an initial value
// converts to Machine. std machines.Start gives the Machine that starts
// from Start(input).
type InputMachine[I, S, E, O, F, R, W] {
	Start func(input I) S,
	Step  func(s S, e E) Decision[S, O] fails F needs R,
	After func(s S) Option[Timeout[E]],
	Work  func(s S) Option[func(send func(e E)) needs W],
	Exit  func(s S) Option[func() needs W],
}

// Closer is the release contract (resources R1): a type that implements
// it is a resource, and its owner's scope calls Close where the value
// dies, on every exit. Close takes the value it is called on (R19). It is
// an ordinary operation type: a type declares it with `implements
// Closer`, and an operation type includes it with `..Closer` (types.md,
// Interface assignability 1).
// law-exempt: Close takes the value and returns nothing, so no law can call an operation after it or observe it; the release rules are the checker's (resources R1 to R24).
type Closer {
	own Close(),
}

// Keeping is the contract of a type that keeps the values it takes
// (resources R13): an operation type that includes it with `..Keeping[T]`
// holds values of T, and the release of its value calls drain, after its
// Close if it has one, and releases each value drain gives, last first.
// drain is unexported, so only the release calls it, and only a type whose
// operations are a Go body of the runtime implements it (a queue's values
// left, a Task's result no Wait took); an Ergo record that keeps values
// holds them in its fields, which its own release releases (R3).
// law-exempt: drain takes the value and only the release calls it, so no law can call it or observe it; the keeping rules are the checker's (resources R13, R35).
type Keeping[T own] {
	own drain() []T,
}

// Task is a started task: task.Go() { … } yields one
// (docs/spec/runtime.md, Tasks). E is an error row.
extern go ergo.local/prototype/runtime/v1.Task type Task[T own, E] {
	runtimeOnly(),
	// Wait takes the task: its one result moves out once (#197 q54).
	// Stop lends it, so a law can say what holds after it.
	own Wait() T fails E,
	Stop(),
	// Closer's Close is the Task's release (#197 L8 B3t; resources R1):
	// its owner's scope calls it at the scope's end when no Wait took the
	// task. It stops the task and waits until it has ended, as Stop does,
	// and drops its typed failure; a Task is a resource.
	..Closer,
	// Keeping's drain gives back the result the body returned that no Wait
	// took, for the owner's release after Close (resources R13, Q5). Only
	// the release calls it.
	..Keeping[T],

	// StopIsIdempotent: a second Stop returns, never fails and changes
	// nothing.
	law StopIsIdempotent() {
		Stop()
		Stop()
		true
	},
}
