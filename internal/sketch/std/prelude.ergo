// The prelude of the language (docs/spec/stdlib.md, Prelude). It is
// ordinary Ergo source, checked by internal/sketch/check like any other
// package; its exported names are in scope in every package without an
// import. The operation sets of the capabilities are provisional: they
// hold only what the fixtures and the v0 corpus call (#209). Clock is in
// std time (time.Clock), because its Now returns a time.Time, which the
// prelude cannot name (std-align S2b).

// Console writes lines to the host's standard output. Println writes one
// line; several values are one interpolated string, "\(a) \(b)".
// law-exempt: Console has no read operation, so no law over its own operations can observe a write; the recording provider of std io carries the law (PrintsConcatenate).
type Console {
	Println(line string),
}

// Ambient is the authority to choose the host (docs/spec/stdlib.md, Host
// packages). Only the entry provides it: main lists it, and the host binds
// it. Its one operation is unexported, so no program type implements it
// and no context binds it. A host package's NewHost has it in its row:
// code that makes a host provider shows Ambient in its row too.
// law-exempt: its one operation is unexported and returns nothing, so no law can call or observe it; the authority rule is checked by TestStdHostProvidersHaveAuthority instead.
type Ambient {
	ambient(),
}

// Scheduler suspends the calling task.
// law-exempt: Sleep returns nothing, and a law over Scheduler alone sees no clock, so it cannot observe a sleep; the sleep laws are on time.Manual, which provides Scheduler and time.Clock together (TestManualClockModel).
type Scheduler {
	Sleep(d duration),
}

// LiveScheduler is the host's Scheduler provider: Sleep below is its
// operation, because its first parameter is a LiveScheduler (196m). It
// sleeps on the host's clock, so it is a host provider (docs/spec/
// stdlib.md, Host packages): its field gives the prelude the construction
// authority, and only NewLiveScheduler makes one (std-align S2b).
type LiveScheduler { live liveOnly }

// liveOnly is the zero-size type of LiveScheduler's field.
type liveOnly {}

// NewLiveScheduler is the host's Scheduler provider. It needs Ambient: only
// code whose row holds the authority to choose the host makes one. A test
// binds time.Manual instead.
func NewLiveScheduler() LiveScheduler needs Ambient { LiveScheduler{live: liveOnly} }

// Sleep suspends the calling task for d on the host's clock.
extern go ergo.local/prototype/runtime/rt.Sleep func Sleep(s LiveScheduler, d duration)

// Random draws random numbers, with the names and meaning of Go's
// math/rand/v2 (Effect Random). Uint64 is 64 random bits; IntN(n) is in
// 0..n-1, and an n of zero or less is a defect, as Go's IntN panics;
// Float64 is in [0, 1). std rand provides it: rand.Seeded(seed) for tests
// and replays, rand.NewHost() for the host (std-align S2c).
type Random {
	Uint64() uint64,
	IntN(n int) int,
	Float64() float64,

	// IntNInRange: a draw of IntN(n) is in 0..n-1, for each n above zero.
	law IntNInRange(n int) {
		if n <= 0 {
			return true
		}
		let x = IntN(n)
		x >= 0 && x < n
	},

	// Float64InUnit: a draw of Float64 is in [0, 1).
	law Float64InUnit() {
		let f = Float64()
		f >= 0.0 && f < 1.0
	},
}

// Option is a value that may be absent (#99).
type Some[T] { Value T }
type None {}
type Option[T] = Some[T] | None

// Unsatisfied is the failure of a refined type's derived parse function,
// ParsePort for `type Port int where 1 <= it && it <= 65535`: the value
// does not pass the where. Type is the refined type's name and Where the
// predicate's text (types.md, Refinements).
type Unsatisfied { Type string, Where string }

// unsatisfied fails u. Its row makes Unsatisfied an error type of the
// prelude, which declares it (types.md, Error types 1), so it is one in
// every package: each derived ParseN fails it, and its Go type has the
// Error method wherever a refined type is declared.
func unsatisfied(u Unsatisfied) fails Unsatisfied { u }

// Writer takes the events of a value's wire form (types.md, Codecs):
// the predeclared encode(v, w) calls it, and a format (std json) is a
// provider of it that writes text. A record is BeginObject(n), then Key
// and the field's events for each of its n fields, then EndObject; a
// union value is a record that starts with Tag(variant); a slice or tuple
// is BeginList(n), n values, EndList; a Map is an object keyed by its
// keys in order. Prior art: serde's Serializer, Roc's Encoding, Go json
// v2's jsontext.Encoder.
// law-exempt: Writer has no read operation, so no law over its own operations can observe an event; std codec's Events records them and carries the laws (EventsReplay).
type Writer {
	Null(),
	// Number writes the spelling of a number a Reader's Number read, as it
	// is; json.Value writes its numbers through it.
	Number(text string),
	Bool(b bool),
	Int(n int64),
	Uint(n uint64),
	Float(f float64),
	String(s string),
	BeginList(n int),
	EndList(),
	BeginObject(n int),
	Tag(name string),
	Key(k string),
	EndObject(),
}

// Reader gives the events of a wire form back, in the order
// decode[T](r) asks for them: the pull form of Writer. A format's
// decode has checked the whole text first (phase 1), so a Reader
// fails only the shape failures: the event is not of the kind T needs
// (WireWrongKind), or an object has no tag (WireMissingField). More reports a
// next element or key before the end; Key reads it; Skip passes over the
// next value; End closes the list or object. Path is where the reader is,
// for a failure's text.
// law-exempt: a law over Reader alone has no events to read; std codec's Replay reads the events Events recorded and carries the laws (EventsReplay).
type Reader {
	// TakeNull consumes the next value only when it is null; otherwise it
	// leaves the reader at that value. No path or list index changes on false.
	TakeNull() bool,
	// Peek is the kind of the next value, which it leaves; an untyped
	// value (json.Value) reads by it.
	Peek() WireKind,
	// Number reads the next number's spelling, unparsed.
	Number() string fails WireWrongKind,
	Path() string,
	Bool() bool fails WireWrongKind,
	Int() int64 fails WireWrongKind,
	Uint() uint64 fails WireWrongKind,
	Float() float64 fails WireWrongKind,
	String() string fails WireWrongKind,
	BeginList() fails WireWrongKind,
	BeginObject() fails WireWrongKind,
	Tag() string fails WireMissingField,
	More() bool,
	Key() string,
	Skip(),
	End(),
}

// The shape failures of decode (types.md, Codecs 2). WireWrongKind is a value
// of another kind than the type takes at Path, Want the kind it takes;
// WireMissingField is a field the object at Path does not have; WireUnknownTag is
// a union's tag that names none of its variants.
type WireWrongKind { Path string, Want string }

// WireKind is the kind of a Reader's next value (Reader.Peek). WireEnd is
// the end of the list or object being read: there is no next value.
type WireNull {}
type WireBool {}
type WireNumber {}
type WireString {}
type WireList {}
type WireObject {}
type WireEnd {}
type WireKind = WireNull | WireBool | WireNumber | WireString | WireList | WireObject | WireEnd
type WireMissingField { Path string, Field string }
type WireUnknownTag { Path string, Tag string }

// The rows of these functions make the shape failures error types of the
// prelude, as unsatisfied does for Unsatisfied.
func wireWrongKind(e WireWrongKind) fails WireWrongKind { e }
func wireMissingField(e WireMissingField) fails WireMissingField { e }
func wireUnknownTag(e WireUnknownTag) fails WireUnknownTag { e }

// Range is the integers from Start up to End, End excluded: `a..b` builds
// one, and `for i in r` counts through it (#196, one for). A for and `..`
// take an integer T only; the type itself takes any ordered T.
type Range[T ordered] { Start T, End T }

// CallSite is a position in Ergo source: File as a defect names it, Line
// and Column from 1, Column in bytes. A call may leave out its callee's
// final CallSite parameter, and the compiler passes the call's own site
// (types.md, Call sites).
type CallSite { File string, Line int, Column int }

// Context is a context as a value: the providers of the capability row R,
// built where a context converts to it (`let w Context[Store | Log] =
// context { … }`, an argument, a return). `with w { … }` installs them and
// discharges R; it builds nothing (rows.md, Context values). Only that
// conversion makes one: its field is the compiler's.
type Context[R] { install func() needs R }

// The functions on slices and Maps (#196, fourth round, item 2; spec
// D-D6). Each is reached only by the dot form on a value of exactly its
// first parameter's type, xs.Append(x), m.Get(k), m.Delete(k) (D-D8): it
// is an operation of the slice or Map type, not a name in a package's
// scope, as MoonBit's fn Array::push is called xs.push(x).

// Append is xs with x added at the end. xs is unchanged: a slice is a
// value (owner q26; types.md, Bindings), and the lowering appends in place
// only for xs = xs.Append(x) or a dead xs. With resource elements it takes
// xs and x: the result is their one owner (#197 L8 A3, resources R14).
extern go ergo.local/prototype/runtime/v1.Append func Append[T](xs []T, x T) []T takes xs, x

// Get is the value of k in m, Some{v}, or None when m has no key k: a Map
// read may miss, so it returns an Option.
extern go ergo.local/prototype/runtime/v1.Get func Get[K comparable, V](m Map[K, V], k K) Option[V]

// Delete is m without the key k. m is unchanged: a Map is a value (owner
// q26), and the lowering deletes in place only for m = m.Delete(k) or a
// dead m. It binds Go's builtin delete (OPT7): the call is the builtin
// itself, with no Go function between.
extern go delete func Delete[K comparable, V](m Map[K, V], k K) Map[K, V]

// Put is m with k set to v: the entry is added, or its value replaced. m
// is unchanged, as Delete leaves it (owner q26), and the lowering writes
// in place only for m = m.Put(k, v) or a dead m (#196 item 13, L2).
extern go ergo.local/prototype/runtime/v1.Put func Put[K comparable, V](m Map[K, V], k K, v V) Map[K, V]

// Take gives up m and returns the value at k (Some, or None if absent)
// and the map without k. Resource values and the remainder have separate
// owners. With plain-data values, m is unchanged (mode crossing).
extern go ergo.local/prototype/runtime/v1.MapTake func Take[K comparable, V](m Map[K, V], k K) (Option[V], Map[K, V]) takes m

// Unreachable states that a path cannot run (owner q29, 2026-11-08). When
// it runs anyway, it raises a defect that holds reason and the call's
// source position: never a typed failure, so it is in no row and no catch
// handles it (docs/spec/runtime.md, Exit causes 3). Its result is the
// bottom type: the checker gives the call the type its position expects (a
// typed let, an argument, a return, a branch of a value if or match), and
// as the last statement of a body or branch it yields no value and joins
// any type, as return does (docs/spec/types.md, Unreachable).
extern go ergo.local/prototype/runtime/v1.Unreachable func Unreachable(reason string)

// Seq is an iterator: it calls yield with each value in turn and stops
// when yield returns false. `for v in s` runs the loop body as yield, and a
// break makes yield return false. Seq is a function type, so it carries no
// member law: each std producer of a Seq states that it stops as a law of
// its own, <Producer>Stops (docs/spec/stdlib.md, Std laws 5). Any function of this shape is a Seq by conversion,
// Seq[T](f). A Seq value lowers to the one Go shape of every Ergo function
// value (spec D5); the for adapts it to Go's range over func at the loop,
// and a std binding that returns Go's iter.Seq[T] adapts at the call.
type Seq[T] func(yield func(v T) bool)

// Decision is the result of a machine's step (docs/spec/runtime.md,
// Machines and actors).
type Enter[S] { Next S }
type Stay[S] { Next S }
type Emit[S, O] { Next S, Output O }
type Ignore {}
type Reject {}
type Done[O] { Output O }

// Enter moves to Next and opens a new entry; Stay moves to Next and keeps
// the entry; Emit moves to Next, opens a new entry, as Enter does, and
// gives Output while the machine keeps running; Ignore and Reject keep the
// state; Done ends the machine with Output.
type Decision[S, O] = Enter[S] | Stay[S] | Emit[S, O] | Ignore | Reject | Done[O]

// Timeout is a state's timer: when an entry of the state lasts In, the
// runner gives the machine Signal. The runner owns the timer: it starts
// when the entry opens, a Stay keeps it, and it never fires after its
// entry ended (docs/spec/runtime.md, Machines and actors 9).
type Timeout[E] { In duration, Signal E }

// Machine is a machine as a value: its initial state, its step, with the
// step's output O, error row F and capability row R, the timer of each
// state, and its work, whose capability row is W (README Gap 46). A value
// of a machine declaration `type X machine[S, E]` converts to Machine[S,
// E, O, F, R, W], with O, F and R read from its step's signature, After
// from its `after` entry (None for every state when it has none), and
// Work and W from its `work` entry: the Start of the state's std
// machines.Work, which the runner calls with the entry's send (None for
// every state when it has none; W is then empty). W is apart from R, so a
// fold, which runs no work, needs R only (std machines.Run), and the
// runner needs both. A Machine is also an ordinary record: a test may build
// one from parts. The work's type is std machines.Work, not a prelude
// name: every prelude name is one a program cannot declare.
type Machine[S, E, O, F, R, W] {
	Initial S,
	Step func(s S, e E) Decision[S, O] fails F needs R,
	After func(s S) Option[Timeout[E]],
	Work func(s S) Option[func(send func(e E)) needs W],
}

// InputMachine is a machine whose initial state is a function of an input
// I (V4; owner decision O3b): a machine declaration whose initial names a
// function `func(i I) S` converts to it, as one with an initial value
// converts to Machine. std machines.Start gives the Machine that starts
// from Start(input).
type InputMachine[I, S, E, O, F, R, W] {
	Start func(input I) S,
	Step func(s S, e E) Decision[S, O] fails F needs R,
	After func(s S) Option[Timeout[E]],
	Work func(s S) Option[func(send func(e E)) needs W],
}

// Task is a started task: task.Go() { … } yields one
// (docs/spec/runtime.md, Tasks). E is an error row.
type Task[T, E] {
	// Wait takes the task: its one result moves out once (#197 q54).
	// Stop lends it, so a law can say what holds after it.
	Wait() T fails E takes,
	Stop(),
	// Close is the Task's release (#197 L8 B3t; resources R1): its owner's
	// scope calls it at the scope's end when no Wait took the task. It
	// stops the task and waits until it has ended, as Stop does, and drops
	// its typed failure; a Task is a resource.
	Close(),

	// StopIsIdempotent: a second Stop returns, never fails and changes
	// nothing.
	law StopIsIdempotent() {
		Stop()
		Stop()
		true
	},
}
