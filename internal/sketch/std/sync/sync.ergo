// Package sync is state that several tasks share (docs/spec/stdlib.md,
// Sync and STM; #208). It follows Effect's Ref and Go's sync.Mutex. A Ref
// is a synchronised handle (runtime.md, Tasks rule 6): every copy of it is
// the same cell, so a task, a provider or a record that holds one sees the
// changes the others make, and two tasks may change it at once. The Go
// bodies are runtime/v1's NewRef, RefModify and the methods of its Ref.

import task

// Ref is one value of T that tasks share. Each operation is atomic: no
// other operation of the Ref runs inside it.
type Ref[T] {
	// Get is the value the Ref holds.
	Get() T,
	// Set stores v.
	Set(v T),
	// Update stores f of the value the Ref holds. No other operation of the
	// Ref runs between the read and the store, so two Updates at once never
	// lose one of them. It calls f exactly once. A function literal written
	// here takes the value over and may change it in place; no binding
	// outside the Ref sees that change (a Ref owns its value). A defect in
	// f poisons the Ref: every later operation raises a defect.
	Update(f func(v T) T),

	// UpdateCallsOnce: Update calls its function exactly once; it never
	// retries, so a function that counts its calls sees one.
	law UpdateCallsOnce() {
		let mut calls = 0
		Update(func(v T) T {
			calls = calls + 1
			v
		})
		calls == 1
	},
}

// NewRef is a new Ref that holds v.
extern go ergo.local/prototype/runtime/v1.NewRef func NewRef[T](v T) Ref[T]

// Modify calls f once on the value r holds, stores the second element of
// its result and returns the first, with no other operation of r between
// the read and the store (Effect's Ref.modify). As in Update, a literal f
// takes the value over, and a defect in f poisons r.
extern go ergo.local/prototype/runtime/v1.RefModify func Modify[T, R](r Ref[T], f func(v T) (R, T)) R

// GetAfterSet: Get gives the value the last Set stored.
law GetAfterSet(a int, b int) {
	let r = NewRef[int](a)
	let first = r.Get() == a
	r.Set(b)
	first && r.Get() == b
}

// UpdateComposes: two Updates store the composition of their functions.
law UpdateComposes(a int) {
	let r = NewRef[int](a)
	r.Update(func(v int) int { v + 1 })
	r.Update(func(v int) int { v * 3 })
	r.Get() == (a+1)*3
}

// ModifyReturnsAndStores: Modify returns the first element of its
// function's result and stores the second.
law ModifyReturnsAndStores(a int, b int) {
	let r = NewRef[int](a)
	let old = Modify(r, func(v int) (int, int) { (v, b) })
	old == a && r.Get() == b
}

// UpdateIsAtomic: Updates from two tasks at once all count: none is lost
// between its read and its store.
law UpdateIsAtomic(n int) {
	let k = 1000 + (n%1000+1000)%1000
	let r = NewRef[int](0)
	let a = task.Go() {
		for _ in 0..k {
			r.Update(func(v int) int { v + 1 })
		}
	}
	let b = task.Go() {
		for _ in 0..k {
			r.Update(func(v int) int { v + 1 })
		}
	}
	a.Wait()
	b.Wait()
	r.Get() == 2*k
}
