// Held is a Model whose stream the test lets through delta by delta
// (wf10 LLM-HELD, for GE's E4b): a test that checks what a caller does
// while a reply is still arriving (a cancel, a timeout on a virtual clock,
// a second ask) releases the reply's deltas one at a time and looks in
// between. No clock is read and nothing sleeps: the test waits on Held's
// steps, the events "the stream waits at delta i" and "delta i was
// given", so every step is decided by an event, never by time.
//
// Prior art: the Vercel AI SDK's simulateReadableStream (chunks with a
// delay, driven by fake timers) and Effect's TestClock-driven streams;
// here the gate is the test's own Release, so no timer is involved.

import llm
import queue
import strings
import task

// HeldStep is a step of a Held's stream: it waits at delta At for a
// release (At deltas were given), or gave delta At to the sink.
type HeldStep = Waits{At int} | Gave{At int}

// Held plays one Reply as Scripted does, except that Stream waits for a
// release before it gives each delta: a Release of n lets the next n
// through, and Open lets the rest through and every later one. Generate
// gives no delta, so it does not wait. Each Held is one gate: copies share
// it.
type Held { Reply Reply, gate queue.Queue[int], steps queue.OpenQueue[HeldStep] } implements llm.Model

func Hold(reply Reply) Held {
	let n = heldDeltas(reply)
	Held{Reply: reply, gate: queue.New[int](n + 1), steps: queue.NewOpen[HeldStep](2*n + 2)}
}

// heldDeltas is the number of deltas reply streams: the most a test
// releases.
func heldDeltas(reply Reply) int {
	match reply {
	case Says as y:
		len(y.Deltas)
	case Cuts as y:
		len(y.Deltas)
	case Breaks as y:
		len(y.Deltas)
	case Fails:
		1
	}
}

// Release lets the next n deltas through; on an open Held it does nothing.
func Release(h Held, n int) {
	for _ in 0..n {
		h.gate.Push(1) catch {
		case queue.Closed:
			return
		}
	}
}

// Open lets every delta through from now on.
func Open(h Held) { h.gate.End() }

// Next waits for the stream's next step and is it. The steps of one
// stream come in order: Waits{0}, then, after a release, Gave{0}, then
// Waits{1}, and so on. A step finds room for the steps of one stream that
// no test reads; past that room a step is dropped (an open Held a test
// never reads is not kept waiting on it).
func Next(h Held) HeldStep {
	h.steps.Pop()
}

func told(h Held, s HeldStep) {
	h.steps.Offer(s) catch {
	case queue.Full:
	}
}

// pass says the stream waits at delta i, then waits until it is released,
// or the Held is open.
func pass(h Held, i int) {
	told(h, Waits{At: i})
	let _ = h.gate.Pop() catch {
	case queue.Closed:
		0
	}
}

func Generate(h Held, r llm.Request) llm.Turn fails llm.RateLimited | llm.Overloaded | llm.Unauthorized | llm.Refused | llm.Truncated | llm.Transport | llm.InvalidRequest | llm.InvalidResponse | llm.UnsupportedSchema {
	try generated(h.Reply)
}

func Stream(h Held, r llm.Request, put func(d llm.Delta) fails llm.SinkFailed) llm.Turn fails llm.RateLimited | llm.Overloaded | llm.Unauthorized | llm.Refused | llm.Truncated | llm.Transport | llm.InvalidRequest | llm.InvalidResponse | llm.UnsupportedSchema | llm.SinkFailed {
	try streamHeld(h, put)
}

func StreamEach(h Held, r llm.Request, put func(d llm.Delta)) llm.Turn fails llm.RateLimited | llm.Overloaded | llm.Unauthorized | llm.Refused | llm.Truncated | llm.Transport | llm.InvalidRequest | llm.InvalidResponse | llm.UnsupportedSchema {
	try streamHeld(h, put)
}

func streamHeld[E](h Held, put func(d llm.Delta) fails E) llm.Turn fails llm.RateLimited | llm.Overloaded | llm.Unauthorized | llm.Refused | llm.Truncated | llm.Transport | llm.InvalidRequest | llm.InvalidResponse | llm.UnsupportedSchema | E {
	let mut i = 0
	try streamed(h.Reply, func(d llm.Delta) fails E {
		pass(h, i)
		try put(d)
		told(h, Gave{At: i})
		i = i + 1
	})
}

// ReleasedArriveInOrder: a held reply's stream waits at each delta until
// the test releases it, then gives it, so the steps are Waits{0}, Gave{0},
// Waits{1}, … with no delta given before its release; the deltas reach
// the sink in the reply's order, and the stream ends with its turn.
law ReleasedArriveInOrder(texts []string) {
	let h = Hold(Says{Deltas: heldTexts(texts), Stop: llm.Ended, Usage: none()})
	let t = task.Go() { heardTexts(h) }
	let mut fine = true
	for i in 0..len(texts) {
		fine = fine && isStep(h.Next(), Waits{At: i})
		h.Release(1)
		fine = fine && isStep(h.Next(), Gave{At: i})
	}
	let joined = strings.Join(texts, "")
	fine && t.Wait() == joined+"|"+joined
}

func isStep(got HeldStep, want HeldStep) bool { got == want }

func heldTexts(texts []string) []llm.Delta {
	let mut ds = []llm.Delta{}
	for s in texts {
		ds = ds.Append(llm.Text{Text: s})
	}
	ds
}

// heardTexts streams h and is the texts its sink got, in order, then the
// turn's text, or "!" when the stream fails.
func heardTexts(h Held) string {
	let mut got = []string{}
	let done = h.Stream(plain("q"), func(d llm.Delta) fails llm.SinkFailed {
		match d {
		case llm.Text as x:
			got = got.Append(x.Text)
		case llm.Reasoning, llm.CallStart, llm.CallArgs, llm.CallEnd:
		}
	}) catch {
	case _:
		return "!"
	}
	strings.Join(got, "") + "|" + done.Text
}

// OpenLetsAllThrough: an open Held streams as Scripted does, with no
// release: the same deltas, and the same turn or failure.
law OpenLetsAllThrough(first []string, tools []string, cut bool) {
	let s = NewScripted(first, tools, cut, []Reply{})
	let h = Hold(s.Replies[0])
	h.Open()
	let r = plain("q")
	heardOf(h, r) == heardOf(s, r)
}

// heard is what Stream of a request gave: how many deltas and their fold's
// text, then the turn's text or the failure.
type heard = heardTurn{deltas int, text string, turn string} | heardFailure{deltas int, text string, failure llm.Failure} | heardSink{}

func heardOf(m llm.Model, r llm.Request) heard {
	let mut ds = []llm.Delta{}
	let t = m.Stream(r, func(d llm.Delta) fails llm.SinkFailed {
		ds = ds.Append(d)
	}) catch {
	case llm.SinkFailed:
		return heardSink
	case f:
		let failure llm.Failure = f
		return heardFailure{deltas: len(ds), text: llm.Fold(ds).Text, failure: failure}
	}
	heardTurn{deltas: len(ds), text: llm.Fold(ds).Text, turn: t.Text}
}
