import strings

func isSpaceOrTab(c int) bool { c == 32 || c == 9 }

func isLineEnd(c int) bool { c == 10 || c == 13 }

func isASCIIPunct(c int) bool {
	(c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126)
}

func isDigit(c int) bool { c >= 48 && c <= 57 }

func isAlpha(c int) bool { (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }

func isAlnum(c int) bool { isAlpha(c) || isDigit(c) }

func isHex(c int) bool { isDigit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) }

func lowerASCII(c int) int { if c >= 65 && c <= 90 { c + 32 } else { c } }

func hexValue(c int) int {
	if isDigit(c) {
		c - 48
	} else if c >= 97 {
		c - 87
	} else {
		c - 55
	}
}

func isUnicodeSpace(r int) bool {
	r == 32 || r == 9 || r == 10 || r == 12 || r == 13 || r == 0xa0 || r == 0x1680 || (r >= 0x2000 && r <= 0x200a) || r == 0x202f || r == 0x205f || r == 0x3000
}

func isUnicodePunct(r int) bool {
	if r < 128 {
		return isASCIIPunct(r)
	}
	let mut lo = 0
	let mut hi = punctRanges.Len() / 2
	for lo < hi {
		let mid = (lo + hi) / 2
		if punctRanges[2*mid+1] < r {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	lo < punctRanges.Len()/2 && punctRanges[2*lo] <= r
}

func decodeRuneAt(buf []byte, i int, end int) (int, int) {
	let c0 = int(buf[i])
	if c0 < 0x80 {
		return (c0, 1)
	}
	if c0 >= 0xc2 && c0 <= 0xdf && i+1 < end && isCont(buf[i+1]) {
		return (((c0 & 0x1f) << 6) | (int(buf[i+1]) & 0x3f), 2)
	}
	if c0 >= 0xe0 && c0 <= 0xef && i+2 < end && isCont(buf[i+1]) && isCont(buf[i+2]) {
		let r = ((c0 & 0x0f) << 12) | ((int(buf[i+1]) & 0x3f) << 6) | (int(buf[i+2]) & 0x3f)
		if r >= 0x800 && (r < 0xd800 || r > 0xdfff) {
			return (r, 3)
		}
	}
	if c0 >= 0xf0 && c0 <= 0xf4 && i+3 < end && isCont(buf[i+1]) && isCont(buf[i+2]) && isCont(buf[i+3]) {
		let r = ((c0 & 0x07) << 18) | ((int(buf[i+1]) & 0x3f) << 12) | ((int(buf[i+2]) & 0x3f) << 6) | (int(buf[i+3]) & 0x3f)
		if r >= 0x10000 && r <= 0x10ffff {
			return (r, 4)
		}
	}
	(0xfffd, 1)
}

func isCont(b byte) bool { b >= 0x80 && b <= 0xbf }

func runeBefore(buf []byte, start int, i int) int {
	if i <= start {
		return 10
	}
	let mut j = i - 1
	for j > start && j > i-4 && isCont(buf[j]) {
		j = j - 1
	}
	let (r, n) = decodeRuneAt(buf, j, i)
	if j+n == i { r } else { 0xfffd }
}

func appendRune(buf []byte, r int) []byte {
	let mut b = buf
	let c = if r < 0 || r > 0x10ffff || (r >= 0xd800 && r <= 0xdfff) { 0xfffd } else { r }
	if c < 0x80 {
		b = b.Append(byte(c))
	} else if c < 0x800 {
		b = b.Append(byte(0xc0 | (c >> 6)))
		b = b.Append(byte(0x80 | (c & 0x3f)))
	} else if c < 0x10000 {
		b = b.Append(byte(0xe0 | (c >> 12)))
		b = b.Append(byte(0x80 | ((c >> 6) & 0x3f)))
		b = b.Append(byte(0x80 | (c & 0x3f)))
	} else {
		b = b.Append(byte(0xf0 | (c >> 18)))
		b = b.Append(byte(0x80 | ((c >> 12) & 0x3f)))
		b = b.Append(byte(0x80 | ((c >> 6) & 0x3f)))
		b = b.Append(byte(0x80 | (c & 0x3f)))
	}
	b
}

func entityIndex(name string) int {
	let mut lo = 0
	let mut hi = entityNames.Len()
	for lo < hi {
		let mid = (lo + hi) / 2
		if entityNames[mid] < name {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo < entityNames.Len() && entityNames[lo] == name { lo } else { -1 }
}

func foldIndex(r int) int {
	let mut lo = 0
	let mut hi = foldRunes.Len()
	for lo < hi {
		let mid = (lo + hi) / 2
		if foldRunes[mid] < r {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo < foldRunes.Len() && foldRunes[lo] == r { lo } else { -1 }
}

func entityLen(buf []byte, i int, end int) int {
	if i+2 >= end || buf[i] != '&' {
		return 0
	}
	let mut j = i + 1
	if buf[j] == '#' {
		j = j + 1
		let mut digits = 0
		if j < end && (buf[j] == 'x' || buf[j] == 'X') {
			j = j + 1
			for j < end && digits < 7 && isHex(int(buf[j])) {
				j = j + 1
				digits = digits + 1
			}
			if digits < 1 || digits > 6 {
				return 0
			}
		} else {
			for j < end && digits < 8 && isDigit(int(buf[j])) {
				j = j + 1
				digits = digits + 1
			}
			if digits < 1 || digits > 7 {
				return 0
			}
		}
		if j < end && buf[j] == ';' { j + 1 - i } else { 0 }
	} else {
		let mut n = 0
		for j < end && n < 33 && isAlnum(int(buf[j])) {
			j = j + 1
			n = n + 1
		}
		if n < 2 || n > 32 || !isAlpha(int(buf[i+1])) || j >= end || buf[j] != ';' {
			return 0
		}
		if entityIndex(buf[i+1:j].Text()) < 0 {
			return 0
		}
		j + 1 - i
	}
}

func appendEntity(buf []byte, at int, n int) []byte {
	if buf[at+1] == '#' {
		let mut v = 0
		let hex = buf[at+2] == 'x' || buf[at+2] == 'X'
		let from = if hex { at + 3 } else { at + 2 }
		for k in from..at+n-1 {
			let c = int(buf[k])
			v = if hex { v*16 + hexValue(c) } else { v*10 + c - 48 }
		}
		return appendRune(buf, if v == 0 { 0xfffd } else { v })
	}
	let idx = entityIndex(buf[at+1 : at+n-1].Text())
	buf.AppendString(entityTexts[idx])
}

func appendUnescaped(buf []byte, from int, to int) []byte {
	let mut b = buf
	let mut i = from
	for i < to {
		let c = int(b[i])
		if c == 92 && i+1 < to && isASCIIPunct(int(b[i+1])) {
			b = b.Append(b[i+1])
			i = i + 2
		} else if c == 38 {
			let n = entityLen(b, i, to)
			if n > 0 {
				b = appendEntity(b, i, n)
				i = i + n
			} else {
				b = b.Append(b[i])
				i = i + 1
			}
		} else {
			b = b.Append(b[i])
			i = i + 1
		}
	}
	b
}

func needsUnescape(buf []byte, from int, to int) bool {
	for i in from..to {
		if buf[i] == 92 || buf[i] == 38 {
			return true
		}
	}
	false
}

let uriSafe = ";/?:@&=+$,-_.!~*'()#"

func appendNormalizedURI(buf []byte, from int, to int) []byte {
	let mut b = buf
	let hexDigits = "0123456789ABCDEF"
	let mut i = from
	for i < to {
		let c = int(b[i])
		if c == 37 && i+2 < to && isHex(int(b[i+1])) && isHex(int(b[i+2])) {
			b = b.Append(b[i])
			b = b.Append(b[i+1])
			b = b.Append(b[i+2])
			i = i + 3
		} else if isAlnum(c) || (c < 128 && strings.IndexByte(uriSafe, byte(c)) >= 0) {
			b = b.Append(b[i])
			i = i + 1
		} else {
			b = b.Append('%')
			b = b.Append(hexDigits[c>>4])
			b = b.Append(hexDigits[c&15])
			i = i + 1
		}
	}
	b
}

func appendFolded(buf []byte, from int, to int) []byte {
	let mut b = buf
	let mut i = from
	let mut space = false
	let mut started = false
	for i < to {
		let (r, n) = decodeRuneAt(b, i, to)
		i = i + n
		if r == 32 || r == 9 || r == 10 || r == 13 {
			space = started
			continue
		}
		if space {
			b = b.Append(' ')
			space = false
		}
		started = true
		if r < 128 {
			b = b.Append(byte(lowerASCII(r)))
		} else {
			let k = foldIndex(r)
			if k >= 0 {
				b = b.AppendString(foldTexts[k])
			} else {
				b = appendRune(b, r)
			}
		}
	}
	b
}
