// Package codec records and replays the events of a wire form (types.md,
// Codecs; L11). Events is a provider of the prelude's Writer that keeps
// every event encode(v, w) writes; Replay is a provider of the Reader that
// gives a list of events back in the order decode[T](r) asks for them. A
// test encodes into Events and decodes from Replay to see a type's wire
// form, and the laws of this package (laws.ergo) hold the round trip of
// the derived codec: decode[T](Replay(encode(v))) is v.
//
// Replay reads integers across kinds as a format would: Int takes an
// EUint that fits int64, Uint an EInt that is not negative, and Float any
// number. It fails WireWrongKind for an event of another kind and
// WireMissingField when an object starts with no tag where a union's is
// needed. Path is the index of the next event, "event 3".
//
// Both keep their state in a sync.Ref, so every copy is the same record.

import strconv
import sync
import utf8

// Writer receives wire events from Encode.
//
// ergo:alias Writer
type Writer {}

// Reader yields wire events to Decode.
//
// ergo:alias Reader
type Reader {}

// WireWrongKind reports a wire event whose kind does not match the expected type.
//
// ergo:alias WireWrongKind
type WireWrongKind {}

// WireNull marks a null wire value.
//
// ergo:alias WireNull
type WireNull {}

// WireBool marks a boolean wire value.
//
// ergo:alias WireBool
type WireBool {}

// WireNumber marks a numeric wire value.
//
// ergo:alias WireNumber
type WireNumber {}

// WireString marks a string wire value.
//
// ergo:alias WireString
type WireString {}

// WireList marks a list wire value.
//
// ergo:alias WireList
type WireList {}

// WireObject marks an object wire value.
//
// ergo:alias WireObject
type WireObject {}

// WireEnd marks the end of a wire list or object.
//
// ergo:alias WireEnd
type WireEnd {}

// WireKind is the union of wire value kinds returned by Reader.Peek.
//
// ergo:alias WireKind
type WireKind {}

// WireMissingField reports a missing required field during Decode.
//
// ergo:alias WireMissingField
type WireMissingField {}

// WireUnknownTag reports an unrecognized union tag during Decode.
//
// ergo:alias WireUnknownTag
type WireUnknownTag {}

// WireOmittable marks an omittable wire field representation.
//
// ergo:alias WireOmittable
type WireOmittable {}

// WireNullable marks a nullable wire field representation.
//
// ergo:alias WireNullable
type WireNullable {}

// WireBare marks a bare wire representation.
//
// ergo:alias WireBare
type WireBare {}

// WireNumberText marks a text-encoded numeric wire representation.
//
// ergo:alias WireNumberText
type WireNumberText {}

// WireMembers marks a members-encoded wire representation.
//
// ergo:alias WireMembers
type WireMembers {}

// Encode writes the wire representation of v to w.
//
// ergo:builtin encode
func Encode[T wire](v T, w Writer) needs wired[T] { encode(v, w) }

// Decode reads a value of type T from r.
//
// ergo:builtin decode
func Decode[T wire](r Reader) T fails wired[T] needs wired[T] { try decode[T](r) }

// The events, one record each, as the Writer's operations name them.
type BoolEvent { V bool }
type IntEvent { V int64 }
type UintEvent { V uint64 }
type FloatEvent { V float64 }
type StringEvent { V string }
type BeginListEvent { N int }
type EndListEvent {}
type BeginObjectEvent { N int }
type TagEvent { Name string }
type KeyEvent { K string }
type EndObjectEvent {}
type NullEvent {}
type NumberEvent { Text string }

// Event is one event of a wire form.
type Event = BoolEvent | IntEvent | UintEvent | FloatEvent | StringEvent | BeginListEvent | EndListEvent | BeginObjectEvent | TagEvent | KeyEvent | EndObjectEvent | NullEvent | NumberEvent

// MissingFieldFails: an object with no keys decodes as no record with
// fields: the decode fails WireMissingField.
law MissingFieldFails() {
	let empty = []Event{BeginObjectEvent{N: 0}, EndObjectEvent}
	let _ = decode[up](NewReplay(empty)) catch {
	case WireMissingField:
		return true
	case _:
		return false
	}
	false
}

// UnknownTagFails: a tag no variant has fails WireUnknownTag.
law UnknownTagFails(name string) {
	if name == "up" {
		return true
	}
	if name == "down" {
		return true
	}
	let evs = []Event{BeginObjectEvent{N: 0}, TagEvent{Name: name}, EndObjectEvent}
	let _ = decode[state](NewReplay(evs)) catch {
	case WireUnknownTag:
		return true
	case _:
		return false
	}
	false
}

// Events records the events written to it.
type Events { log sync.Ref[[]Event] } implements Writer

// NewEvents is an Events with no event yet.
func NewEvents() Events { Events{log: sync.NewRef[[]Event]([]Event{})} }

// BasicReplay: a basic value at the top, not inside a record, is one event,
// and decode[T] of a basic T reads it back: every kind (string, bool, a
// narrow integer, an unsigned one, a float). decode[T] here is the direct
// call, not RoundTrip's witness.
law BasicReplay(s string, b bool, i int8, u uint8, f float64) {
	let e = NewEvents()
	encode(s, e)
	encode(b, e)
	encode(i, e)
	encode(u, e)
	encode(f, e)
	let r = NewReplay(Recorded(e))
	let s2 = decode[string](r) catch {
	case _:
		return false
	}
	let b2 = decode[bool](r) catch {
	case _:
		return false
	}
	let i2 = decode[int8](r) catch {
	case _:
		return false
	}
	let u2 = decode[uint8](r) catch {
	case _:
		return false
	}
	let f2 = decode[float64](r) catch {
	case _:
		return false
	}
	s2 == s && b2 == b && i2 == i && u2 == u && f2 == f
}

// GenericReplay: a list of union values and its first value, encoded and
// decoded inside a generic function, read back as they were.
law GenericReplay(vs []state) {
	let (back, first) = many(vs) catch {
	case _:
		return false
	}
	let want Option[state] = if len(vs) > 0 { Some{Value: vs[0]} } else { None }
	back == vs && first == want
}

// many is vs through Events and back as one list, so the codec of []T and
// Option[T] runs inside a generic function, on T's witness.
func many[T wire](vs []T) ([]T, Option[T]) fails wired[Option[T]] needs wired[T] {
	let e = NewEvents()
	encode(vs, e)
	let first Option[T] = if len(vs) > 0 { Some{Value: vs[0]} } else { None }
	encode(first, e)
	let r = NewReplay(Recorded(e))
	(try decode[[]T](r), try decode[Option[T]](r))
}

// EncodeNests: the events of one value open and close as many times, and
// never close more than they opened.
law EncodeNests(v fleet) {
	let e = NewEvents()
	encode(v, e)
	let mut open = 0
	let mut ok = true
	for ev in Recorded(e) {
		open = open + depth(ev)
		if open < 0 {
			ok = false
		}
	}
	ok && open == 0
}

// Recorded is the events written to e, in order.
func Recorded(e Events) []Event { e.log.Get() }

func record(e Events, ev Event) { e.log.Update(func(xs []Event) []Event { xs.Append(ev) }) }

// The Writer's operations.
func Null(e Events)              { record(e, NullEvent) }
func Number(e Events, text string) { record(e, NumberEvent{Text: text}) }
func Bool(e Events, b bool)       { record(e, BoolEvent{V: b}) }
func Int(e Events, n int64)       { record(e, IntEvent{V: n}) }
func Uint(e Events, n uint64)     { record(e, UintEvent{V: n}) }
func Float(e Events, f float64)   { record(e, FloatEvent{V: f}) }
func String(e Events, s string)   { record(e, StringEvent{V: s}) }
func StringBytes(e Events, b []byte) { record(e, StringEvent{V: utf8.String(b)}) }
func BeginList(e Events, n int)   { record(e, BeginListEvent{N: n}) }
func EndList(e Events)            { record(e, EndListEvent) }
func BeginObject(e Events, n int) { record(e, BeginObjectEvent{N: n}) }
func Tag(e Events, name string)   { record(e, TagEvent{Name: name}) }
func Key(e Events, k string)      { record(e, KeyEvent{K: k}) }
func EndObject(e Events)          { record(e, EndObjectEvent) }

// StringBytesRecordsString: StringBytes records the String event of the
// string its bytes spell.
law StringBytesRecordsString(b []byte) {
	let e = NewEvents()
	e.StringBytes(b)
	let got = Recorded(e)
	if len(got) != 1 {
		return false
	}
	match got[0] {
	case StringEvent as x:
		x.V == utf8.String(b)
	case _:
		false
	}
}

// RoundTrip is v through Events and back: decode[T] of a Replay of the
// events encode(v) wrote. Its row is wired[T], the row of decode[T].
func RoundTrip[T wire](v T) T fails wired[T] needs wired[T] {
	let e = NewEvents()
	encode(v, e)
	decode[T](NewReplay(Recorded(e)))
}

// EventsReplay: what encode writes on Events, decode reads back from a
// Replay of those events as the same value. RoundTrip is generic, so the
// law runs the codec through its witness too.
law EventsReplay(v fleet) {
	let back = RoundTrip(v) catch {
	case _:
		return false
	}
	back == v
}

type up { Host string, Port int, Tags []string, Load float64 }

type down {}

type state = up | down

type widths { A int8, B int16, C int32, D int64, E uint8, F uint16, G uint32, H uint64, I int, J uint, K float32, L bool }

type fleet { Name string, States []state, Spare Option[up], Meta Map[string, int], Sizes widths }

// Replay reads back a list of events.
type Replay { events []Event, at sync.Ref[int] } implements Reader

// NewReplay reads events from the first.
func NewReplay(events []Event) Replay { Replay{events: events, at: sync.NewRef[int](0)} }

// next is the next event, which the read passes; EndObject past the end.
func next(r Replay) Event {
	let i = r.at.Get()
	if i >= len(r.events) {
		return EndObjectEvent
	}
	r.at.Set(i + 1)
	r.events[i]
}

// peek is the next event, which the read leaves; EndObject past the end.
func peek(r Replay) Event {
	let i = r.at.Get()
	if i >= len(r.events) { EndObjectEvent } else { r.events[i] }
}

// depth is how an event changes the nesting: +1 opens, -1 closes.
func depth(e Event) int {
	match e {
	case BeginListEvent, BeginObjectEvent:
		1
	case EndListEvent, EndObjectEvent:
		-1
	case _:
		0
	}
}

// The Reader's operations.
func TakeNull(r Replay) bool {
	match peek(r) {
	case NullEvent:
		_ = next(r)
		true
	case _:
		false
	}
}

func Peek(r Replay) WireKind {
	match peek(r) {
	case NullEvent: WireNull
	case BoolEvent: WireBool
	case IntEvent, UintEvent, FloatEvent, NumberEvent: WireNumber
	case StringEvent, TagEvent: WireString
	case BeginListEvent: WireList
	case BeginObjectEvent: WireObject
	case KeyEvent, EndListEvent, EndObjectEvent: WireEnd
	}
}

// Number is a number's spelling: NumberEvent's as written, and a typed
// number's as strconv formats it. A uint past int64 is formatted through
// float64 and loses digits.
func Number(r Replay) string fails WireWrongKind {
	match next(r) {
	case NumberEvent as n:
		n.Text
	case IntEvent as n:
		strconv.FormatInt(n.V, 10)
	case UintEvent as n:
		if n.V > 9223372036854775807 {
			return strconv.FormatFloat(float64(n.V), 'f', -1)
		}
		strconv.FormatInt(int64(n.V), 10)
	case FloatEvent as f:
		strconv.FormatFloat(f.V, 'g', -1)
	case _:
		return WireWrongKind{Path: Path(r), Want: "number"}
	}
}

func Path(r Replay) string { "event " + strconv.Itoa(r.at.Get()) }

func Bool(r Replay) bool fails WireWrongKind {
	match next(r) {
	case BoolEvent as b:
		b.V
	case _:
		return WireWrongKind{Path: Path(r), Want: "bool"}
	}
}

func Int(r Replay) int64 fails WireWrongKind {
	match next(r) {
	case IntEvent as n:
		n.V
	case UintEvent as n:
		if n.V > 9223372036854775807 {
			return WireWrongKind{Path: Path(r), Want: "int"}
		}
		int64(n.V)
	case NumberEvent as n:
		strconv.ParseInt(n.Text, 10, 64) catch { case _: return WireWrongKind{Path: Path(r), Want: "int"} }
	case _:
		return WireWrongKind{Path: Path(r), Want: "int"}
	}
}

func Uint(r Replay) uint64 fails WireWrongKind {
	match next(r) {
	case UintEvent as n:
		n.V
	case IntEvent as n:
		if n.V < 0 {
			return WireWrongKind{Path: Path(r), Want: "uint"}
		}
		uint64(n.V)
	case NumberEvent as n:
		let v = strconv.ParseInt(n.Text, 10, 64) catch { case _: return WireWrongKind{Path: Path(r), Want: "uint"} }
		if v < 0 {
			return WireWrongKind{Path: Path(r), Want: "uint"}
		}
		uint64(v)
	case _:
		return WireWrongKind{Path: Path(r), Want: "uint"}
	}
}

func Float(r Replay) float64 fails WireWrongKind {
	match next(r) {
	case FloatEvent as f:
		f.V
	case IntEvent as n:
		float64(n.V)
	case UintEvent as n:
		float64(n.V)
	case NumberEvent as n:
		strconv.ParseFloat(n.Text) catch { case _: return WireWrongKind{Path: Path(r), Want: "float"} }
	case _:
		return WireWrongKind{Path: Path(r), Want: "float"}
	}
}

// StringBytes is into with the bytes of the string String reads (GX12).
func StringBytes(r Replay, into []byte) []byte fails WireWrongKind { appendText(into, try r.String()) }

// appendText is Go's append(into, s...).
extern go append func appendText(into []byte, s string) []byte

// StringBytesReplaysString: a Replay's StringBytes adds the string event's
// bytes to into (GX12).
law StringBytesReplaysString(s string, pre []byte) {
	let got = NewReplay([]Event{StringEvent{V: s}}).StringBytes(pre) catch {
	case _:
		return false
	}
	utf8.String(got) == utf8.String(pre)+s
}

func String(r Replay) string fails WireWrongKind {
	match next(r) {
	case StringEvent as s:
		s.V
	case TagEvent as t:
		t.Name
	case _:
		return WireWrongKind{Path: Path(r), Want: "string"}
	}
}

func BeginList(r Replay) fails WireWrongKind {
	match next(r) {
	case BeginListEvent as b:
		_ = b
	case _:
		return WireWrongKind{Path: Path(r), Want: "list"}
	}
}

func BeginObject(r Replay) fails WireWrongKind {
	match next(r) {
	case BeginObjectEvent as b:
		_ = b
	case _:
		return WireWrongKind{Path: Path(r), Want: "object"}
	}
}

func Tag(r Replay) string fails WireMissingField {
	match peek(r) {
	case TagEvent as t:
		_ = next(r)
		t.Name
	case _:
		return WireMissingField{Path: Path(r), Field: "_tag"}
	}
}

func More(r Replay) bool { depth(peek(r)) >= 0 }

// Key reads a key. A union's tag is the member "_tag", as a format writes
// it, so Key leaves the tag for String or Skip to read.
func Key(r Replay) string {
	match peek(r) {
	case TagEvent:
		"_tag"
	case KeyEvent as k:
		_ = next(r)
		k.K
	case _:
		_ = next(r)
		""
	}
}

func Skip(r Replay) {
	let mut open = depth(next(r))
	for open > 0 {
		open = open + depth(next(r))
	}
}

func End(r Replay) { _ = next(r) }
