// Package text gives spans: a piece of a text named by two byte offsets,
// with no pointer (docs/spec/stdlib.md, Text spans). A record or a slice
// of tokens that holds spans in place of strings has no pointer, so Go's
// collector never scans it and a store into it has no write barrier. The
// text is held once, by the value that owns the spans, and a read takes the
// text and the span together.
//
// The package is ordinary Ergo over std strings: no extern of its own and
// no compiler rule keyed on its name, so a module can copy it and get the
// same code (TestStdCopyAgrees). Until facts land (facts.md), each read is
// checked: Get, Sub and Find give None for a span outside the text, and Cut
// is a defect there, as an index out of range is.
//
// Prior art: Zig's tokens (a tag and a start offset into the source), Go's
// go/token.Pos, rustc's Span and tree-sitter's byte ranges.
import option
import strings

// Span is the bytes of a text from Start up to End, End excluded. It holds
// no text: the same Span names different pieces of different texts.
type Span { Start int, End int }

// In reports whether sp is a piece of s: 0 <= Start <= End <= len(s).
func In(s string, sp Span) bool { 0 <= sp.Start && sp.Start <= sp.End && sp.End <= s.Len() }

// Whole is the span of all of s.
func Whole(s string) Span { Span{Start: 0, End: s.Len()} }

// Width is the number of bytes sp names.
func Width(sp Span) int { sp.End - sp.Start }

// Cut is the piece of s that sp names. It shares the bytes of s and
// allocates nothing (Go's s[i:j]). A span that is not In s is a defect, as
// an index out of range is; Get is the checked form.
func Cut(s string, sp Span) string { strings.Slice(s, sp.Start, sp.End) }

// CutOfWholeIsTheText: the whole span is In the text and its piece is the
// text.
law CutOfWholeIsTheText(s string) { In(s, Whole(s)) && Cut(s, Whole(s)) == s && Width(Whole(s)) == s.Len() }

// Get is the piece of s that sp names, or None when sp is not In s.
func Get(s string, sp Span) option.Option[string] {
	if In(s, sp) {
		option.Some[string]{Value: Cut(s, sp)}
	} else {
		option.None
	}
}

// GetIsCut: Get is the piece Cut reads when the span is In the text, and
// None when it is not.
law GetIsCut(s string, a int, b int) {
	let sp = spanNear(s, a, b)
	match Get(s, sp) {
	case option.Some[string] as v:
		In(s, sp) && v.Value == Cut(s, sp) && v.Value.Len() == Width(sp)
	case option.None:
		!In(s, sp)
	}
}

// near is k folded into -1..n+1: an offset of a text of n bytes, or one
// step outside it. A negative n (the width of a reversed span) counts as 0.
func near(n int, k int) int {
	let m = if n < 0 { 3 } else { n + 3 }
	(k%m+m)%m - 1
}

// spanNear is the span of a and b folded by near into s.
func spanNear(s string, a int, b int) Span { Span{Start: near(s.Len(), a), End: near(s.Len(), b)} }

// Sub is the span of the bytes from to to of the piece sp names, offsets
// relative to sp.Start: Cut(s, Sub(…)) is Slice(Cut(s, sp), from, to). It
// is None when sp is not In s, or when 0 <= from <= to <= Width(sp) does
// not hold.
func Sub(s string, sp Span, from int, to int) option.Option[Span] {
	if !In(s, sp) || from < 0 || from > to || to > Width(sp) {
		return option.None
	}
	option.Some[Span]{Value: Span{Start: sp.Start + from, End: sp.Start + to}}
}

// SubThenCutIsCutThenSlice: a sub-span is In the text and reads what a
// slice of the span's piece reads; it is None exactly when the span is not
// In the text or the offsets are outside the piece.
law SubThenCutIsCutThenSlice(s string, a int, b int, from int, to int) {
	let sp = spanNear(s, a, b)
	let f = near(Width(sp), from)
	let t = near(Width(sp), to)
	match Sub(s, sp, f, t) {
	case option.Some[Span] as u:
		In(s, u.Value) && Cut(s, u.Value) == strings.Slice(Cut(s, sp), f, t)
	case option.None:
		!In(s, sp) || f < 0 || f > t || t > Width(sp)
	}
}

// Equal reports whether sp is In s and its piece is lit. It reads the
// piece in place: no string is made.
func Equal(s string, sp Span, lit string) bool { In(s, sp) && Cut(s, sp) == lit }

// EqualAgreesWithCut: Equal is whether Get reads lit.
law EqualAgreesWithCut(s string, a int, b int, lit string) {
	let sp = spanNear(s, a, b)
	Equal(s, sp, lit) == (Get(s, sp) == option.Some[string]{Value: lit}) && (!In(s, sp) || Equal(s, sp, Cut(s, sp)))
}

// Find is the span of the first sub inside the piece sp names, or None
// when sp is not In s or the piece has no sub.
func Find(s string, sp Span, sub string) option.Option[Span] {
	if !In(s, sp) {
		return option.None
	}
	let i = strings.Index(Cut(s, sp), sub)
	if i < 0 {
		return option.None
	}
	option.Some[Span]{Value: Span{Start: sp.Start + i, End: sp.Start + i + sub.Len()}}
}

// FindIsTheFirstInside: Find's span is In the text, inside the searched
// span, and reads sub, with no sub before it inside the span; None means
// the span is not In the text or its piece has no sub.
law FindIsTheFirstInside(s string, a int, b int, sub string) {
	let sp = spanNear(s, a, b)
	match Find(s, sp, sub) {
	case option.Some[Span] as f:
		let u = f.Value
		let first = if sub == "" { u.Start == sp.Start } else { !strings.Contains(strings.Slice(s, sp.Start, u.End-1), sub) }
		In(s, u) && sp.Start <= u.Start && u.End <= sp.End && Cut(s, u) == sub && first
	case option.None:
		!In(s, sp) || !strings.Contains(Cut(s, sp), sub)
	}
}

// space reports the white space bytes of Go's ASCII set: space, tab, line
// feed, vertical tab, form feed and carriage return.
func space(b byte) bool { b == 32 || (b >= 9 && b <= 13) }

// Fields is the spans of the runs of s between ASCII white space, in
// order; none when s is all space. For an ASCII s their pieces are Go's
// strings.Fields(s), with no string made.
func Fields(s string) []Span {
	let mut out = []Span{}
	let mut start = -1
	for i in 0..s.Len() {
		if space(s[i]) {
			if start >= 0 {
				out = out.Append(Span{Start: start, End: i})
				start = -1
			}
		} else if start < 0 {
			start = i
		}
	}
	if start >= 0 {
		out = out.Append(Span{Start: start, End: s.Len()})
	}
	out
}

// FieldsAreGoFields: for an ASCII text of words, the pieces of Fields are
// Go's strings.Fields, each span In the text, in order and apart.
law FieldsAreGoFields(raw string) {
	let s = wordText(raw)
	let spans = Fields(s)
	let words = strings.Fields(s)
	if spans.Len() != words.Len() {
		return false
	}
	let mut ok = true
	let mut last = -1
	for i, sp in spans {
		ok = ok && In(s, sp) && Width(sp) > 0 && sp.Start > last && Cut(s, sp) == words[i]
		last = sp.End
	}
	ok
}

// wordText is an ASCII text of words and white space made from the bytes
// of s, one byte each, so a generated s gives words to cut.
func wordText(s string) string {
	let alphabet = "  abcab\tc"
	let mut out = ""
	for i in 0..s.Len() {
		let k = int(s[i]) % alphabet.Len()
		out = out + strings.Slice(alphabet, k, k+1)
	}
	out
}

// ModelAgrees is the seeded property: a run of up to 63 operations over
// the words of a text (cut a word, a sub-span of it, a find in it, store
// the spans and read one back) agrees step by step with a model that keeps
// every word as its own string, read with Go's strings.
law ModelAgrees(raw string, seed int, count int) {
	let s = wordText(raw)
	let n = (count%64 + 64) % 64
	let mut x = (seed%2147483648 + 2147483648) % 2147483648
	let spans = Fields(s)
	let words = strings.Fields(s)
	if spans.Len() == 0 {
		return true
	}
	let d = match Collect(s, spans) {
	case option.Some[Spans] as v:
		v.Value
	case option.None:
		return false
	}
	for _ in 0..n {
		x = (x*1103515245 + 12345) % 2147483648
		let k = (x / 65536) % spans.Len()
		let sp = spans[k]
		let w = words[k]
		let from = (x / 8) % (w.Len() + 1)
		let to = from + (x/512)%(w.Len()-from+1)
		match (x / 2) % 4 {
		case 0:
			if Cut(s, sp) != w || Get(s, sp) != (option.Some[string]{Value: w}) {
				return false
			}
		case 1:
			match Sub(s, sp, from, to) {
			case option.Some[Span] as u:
				if Cut(s, u.Value) != strings.Slice(w, from, to) {
					return false
				}
			case option.None:
				return false
			}
		case 2:
			let sub = strings.Slice(w, from, to)
			let want = strings.Index(w, sub)
			match Find(s, sp, sub) {
			case option.Some[Span] as f:
				if f.Value.Start-sp.Start != want || Cut(s, f.Value) != sub {
					return false
				}
			case option.None:
				return false
			}
		case _:
			if At(d, k) != w || SpanAt(d, k) != sp || !Equal(s, sp, w) {
				return false
			}
		}
	}
	true
}

// Spans is a text and spans of it, each In the text: one string for n
// pieces. Its fields are unexported, so Collect is the only way to make
// one, and every Spans holds only spans of its own text.
type Spans { src string, at []Span }

// Collect is the Spans of src and at, or None when a span of at is not In
// src.
func Collect(src string, at []Span) option.Option[Spans] {
	for sp in at {
		if !In(src, sp) {
			return option.None
		}
	}
	option.Some[Spans]{Value: Spans{src: src, at: at}}
}

// CollectRefusesPastTheEnd: a span that ends one byte past its text is not
// In it, so Collect gives None for it: no text of another length, longer
// or shorter, decides it.
law CollectRefusesPastTheEnd(s string) {
	match Collect(s, []Span{Span{Start: 0, End: s.Len() + 1}}) {
	case option.Some[Spans]:
		false
	case option.None:
		true
	}
}

// CollectChecksEverySpan: Collect makes a Spans exactly when every span is
// In the text, and its reads are the pieces of the text.
law CollectChecksEverySpan(s string, xs []int) {
	let mut at = []Span{}
	for i in 0..xs.Len()/2 {
		at = at.Append(spanNear(s, xs[2*i], xs[2*i+1]))
	}
	let mut all = true
	for sp in at {
		all = all && In(s, sp)
	}
	match Collect(s, at) {
	case option.Some[Spans] as d:
		let mut ok = all && Source(d.Value) == s && Count(d.Value) == at.Len()
		for i, sp in at {
			ok = ok && SpanAt(d.Value, i) == sp && At(d.Value, i) == Cut(s, sp)
		}
		ok
	case option.None:
		!all
	}
}

// Source is the text of d.
func Source(d Spans) string { d.src }

// Count is the number of spans of d.
func Count(d Spans) int { d.at.Len() }

// SpanAt is the i-th span of d. An i outside 0..Count(d) is a defect, as
// an index out of range is.
func SpanAt(d Spans, i int) Span { d.at[i] }

// At is the piece of the i-th span of d. An i outside 0..Count(d) is a
// defect, as an index out of range is; the span is In the text, since
// Collect checked it.
func At(d Spans, i int) string { Cut(d.src, d.at[i]) }
