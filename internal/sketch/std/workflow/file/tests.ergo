// The laws of workflow.Store run for the file store under this context,
// over a disk in memory: each case opens a fresh log.

import fstest
import sync
import workflow

let onMemoryDisk = context { workflow.Store: fresh() }

func fresh() Store {
	let disk = fstest.NewMemory()
	Store{path: "runs.log", files: disk, writes: disk, state: sync.NewRef(workflow.Empty()), broken: sync.NewRef(false), cut: sync.NewRef(-1), lock: sync.NewSemaphore(1), replayed: 0}
}
