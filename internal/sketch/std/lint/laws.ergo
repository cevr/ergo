// The laws of the encoded forms a pack reads and writes. The ledger in
// docs/spec/stdlib.md names the test that runs each law.

import json
import strings

// SnapshotRoundTrips: the text EncodeSnapshot writes, in the Go SDK's
// form that leaves empty lists, flags and texts out, DecodeSnapshot reads
// back as the same snapshot, every kind of fact by its name.
law SnapshotRoundTrips(s Snapshot) {
	let back = DecodeSnapshot(EncodeSnapshot(s)) catch {
	case SnapshotFailed:
		return false
	}
	back == s
}

// FrameRoundTrips: ReadFrame reads the payload WriteFrame framed, in this
// package's protocol version, whatever bytes the payload holds.
law FrameRoundTrips(payload string) {
	let f = ReadFrame(WriteFrame(payload)) catch {
	case FrameMalformed:
		return false
	}
	f == Frame{Version: ProtocolVersion, Payload: payload}
}

// FrameIsExact: a frame with a byte more or a byte less than its header
// says is malformed, so a pack never answers a request it read in part.
law FrameIsExact(payload string, extra string) {
	let framed = WriteFrame(payload)
	let _ = ReadFrame(framed + extra + "x") catch {
	case FrameMalformed:
		let _ = ReadFrame(strings.Slice(framed, 0, len(framed)-1)) catch {
		case FrameMalformed:
			return true
		}
		return false
	}
	false
}

// NamesReadBack: a severity and an option type read back from their names.
law NamesReadBack(t OptionType, s Severity) {
	let parsedType = ParseOptionType(t.Wire()) catch {
	case UnknownKind:
		return false
	}
	let parsedSeverity = ParseSeverity(s.Wire()) catch {
	case UnknownKind:
		return false
	}
	parsedType == t && parsedSeverity == s
}

// AnswerAdmitsAndChecks: Answer runs a requested rule only at the version
// the pack implements, fails a finding whose span is outside the one
// admitted source, and completes one inside it, with the Go SDK's texts.
law AnswerAdmitsAndChecks(offset int, length int, sameVersion bool) {
	let o = offset % 20
	let l = length % 20
	let span = Span{File: "a.ergo", Offset: o, Length: l, Line: 1, Column: 1}
	let rule = Rule{Name: "probe", Version: "1", Description: "d", DefaultSeverity: Warning, Requires: []Family{}, Options: []OptionSpec{}, Check: func(s Snapshot, options json.Value) []Finding fails RuleFailed {
		[]Finding{Finding{Message: "m", Span: span, Related: []Related{}, Suggestions: []Suggestion{}}}
	}}
	let p = Pack{Namespace: "ns", Version: "0", Description: "", FactVersions: []int{SchemaVersion}, Rules: []Rule{rule}, Presets: []Preset{}}
	let s = Snapshot{Schema: Schema{Name: SchemaName, Version: SchemaVersion}, Semantic: Semantic{Revision: "r", Target: "go", Producer: "", ReuseScope: ""}, Sources: []Source{Source{File: "a.ergo", URI: "", Bytes: 16}}, Checked: true, Families: []Family{CallsFamily}, Unavailable: []UnavailableFamily{}, Types: []TypeDecl{}, Contexts: []Context{}, Callables: []Callable{}, Calls: []Call{}, Withs: []With{}, Bindings: []Binding{}, Imports: []Import{}}
	let version = if sameVersion { "1" } else { "2" }
	let text = "{\"id\":\"i\",\"pack\":{\"namespace\":\"ns\",\"version\":\"0\",\"identity\":\"x\"},\"rules\":[{\"name\":\"probe\",\"version\":\"" + version + "\",\"options\":{}}],\"snapshot\":" + EncodeSnapshot(s) + "}"
	let answer = Answer(p, WriteFrame(text)) catch {
	case _:
		return false
	}
	let frame = ReadFrame(answer) catch {
	case FrameMalformed:
		return false
	}
	let inside = o >= 0 && l >= 0 && o <= 16 && l <= 16-o
	let want = if !sameVersion {
		"\"status\":\"failed\",\"reason\":\"manifest declares rule version 2; the pack implements 1\""
	} else if inside {
		"\"status\":\"completed\",\"findings\":[{\"message\":\"m\""
	} else {
		"\"status\":\"failed\",\"reason\":\"finding \\\"m\\\": span {File:a.ergo Offset:"
	}
	strings.Contains(frame.Payload, want)
}
