// Optional is a record field whose key can be absent. Present writes its
// value directly, Absent writes no key. Outside a record field Optional
// keeps its tagged union form: an array slot or root cannot be absent.
// Option is unchanged and always keeps its tagged form.
type Absent {}
type Present[T] { Value T }
type Optional[T] = Absent | Present[T]

law OptionalRoundTrips(v Option[int]) { optionalRoundTrips(v) }

// Option inputs give the law runner ordinary, seeded generators. The wire
// records contain the JSON-specific alternatives, not Option wire values.
type optionalField { Value Optional[int] }

func optionalOf[T](v Option[T]) Optional[T] {
	match v {
	case None:
		Absent
	case Some[T] as p:
		Present{Value: p.Value}
	}
}

func optionalRoundTrips(v Option[int]) bool {
	let field = optionalField{Value: optionalOf(v)}
	let back = Decode(c[optionalField](), Encode(c[optionalField](), field)) catch {
	case _:
		return false
	}
	back == field
}
func WireForm[T](x Optional[T]) WireOmittable { WireOmittable }

// Nullable writes null or the value directly. A Nullable record field is
// required: a missing key is WireMissingField, not Null. Optional[Nullable[T]]
// is the three-state field: Absent, Present{Null}, Present{NonNull{value}}.
type Null {}
type NonNull[T] { Value T }
type Nullable[T] = Null | NonNull[T]

law NullableRoundTrips(v Option[int]) { nullableRoundTrips(v) }

type nullableField { Value Nullable[int] }

func nullableOf[T](v Option[T]) Nullable[T] {
	match v {
	case None:
		Null
	case Some[T] as p:
		NonNull{Value: p.Value}
	}
}

func nullableRoundTrips(v Option[int]) bool {
	let field = nullableField{Value: nullableOf(v)}
	let back = Decode(c[nullableField](), Encode(c[nullableField](), field)) catch {
	case _:
		return false
	}
	back == field
}
func WireForm[T](x Nullable[T]) WireNullable { WireNullable }
