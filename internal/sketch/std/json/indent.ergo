// Indent formats one JSON value with each element or member on its own
// line. Each added line starts with prefix and one indent per nesting
// level. Empty arrays and objects stay on one line. As in Go, Indent drops
// leading whitespace, preserves trailing whitespace, and copies prefix and
// indent verbatim. Text that breaks Open's rules fails Malformed.
func Indent(text string, prefix string, indent string) string fails Malformed {
	let _ = try Open(text, 0, 0)
	indented(text, prefix, indent)
}

// EncodeIndent applies Indent's layout to the JSON produced by Encode.
func EncodeIndent[T wire](c Codec[T], v T, prefix string, indent string) string needs wired[T] {
	indented(Encode(c, v), prefix, indent)
}

// indented is Indent of a text Open accepts. A string is copied as it is;
// outside strings, a { or [ delays its new line until its first element,
// so an empty list or object stays on one line (Go's needIndent).
func indented(text string, prefix string, indent string) string {
	let mut out = []byte{}
	out = out.Grow(2 * text.Len())
	let mut depth = 0
	let mut open = false
	let mut started = false
	let mut i = 0
	let end = text.Len()
	for i < end {
		let c = text[i]
		i = i + 1
		// Validation rules out any other byte below space outside strings.
		if c <= ' ' {
			// Kept only after the value: a valid text has one value, so
			// white space at depth 0 once it began, outside a pending
			// list or object, follows it.
			if started && depth == 0 && !open {
				out = out.Append(c)
			}
			continue
		}
		started = true
		if open && c != '}' && c != ']' {
			open = false
			depth = depth + 1
			newline(&out, prefix, indent, depth)
		}
		if c == '{' || c == '[' {
			open = true
			out = out.Append(c)
		} else if c == ',' {
			out = out.Append(c)
			newline(&out, prefix, indent, depth)
		} else if c == ':' {
			out = out.Append(c)
			out = out.Append(' ')
		} else if c == '}' || c == ']' {
			if open {
				open = false
			} else {
				depth = depth - 1
				newline(&out, prefix, indent, depth)
			}
			out = out.Append(c)
		} else if c == '"' {
			let start = i - 1
			for i < end {
				let q = text[i]
				i = i + 1
				if q == '"' {
					break
				}
				if q == '\\' {
					i = i + 1
				}
			}
			out = out.AppendString(text[start:i])
		} else {
			out = out.Append(c)
		}
	}
	out.Text()
}

// newline borrows the output buffer so appends can use its spare room.
func newline(out mut []byte, prefix string, indent string, depth int) {
	*out = (*out).Append('\n')
	if prefix != "" {
		*out = (*out).AppendString(prefix)
	}
	for _ in 0..depth {
		*out = (*out).AppendString(indent)
	}
}

// IndentWritesGoForm: the indented text is encoding/json's Indent's,
// byte for byte, on a text with every token kind, nesting, empty lists
// and objects, escapes in strings and white space around the value.
law IndentWritesGoForm() {
	let text = " {\"a\" : [1, {}, [], \"x\\\"]\"], \"b\":{\"c\":null,\"d\":true}, \"e\":-1.5e3}\n"
	let want = "{\n>  \"a\": [\n>    1,\n>    {},\n>    [],\n>    \"x\\\"]\"\n>  ],\n>  \"b\": {\n>    \"c\": null,\n>    \"d\": true\n>  },\n>  \"e\": -1.5e3\n>}\n"
	let got = Indent(text, ">", "  ") catch {
	case Malformed:
		return false
	}
	got == want
}

// IndentDecodesAsCompact: the indented text of an encoding decodes as the
// compact encoding does, for any white space prefix and indent, and
// EncodeIndent is Indent of Encode.
law IndentDecodesAsCompact(v fleet, prefix int, width int) {
	let compact = Encode(codec(), v)
	let p = blanks(prefix)
	let ind = blanks(width)
	let text = Indent(compact, p, ind) catch {
	case Malformed:
		return false
	}
	let a = Decode(codec(), text) catch {
	case _:
		return false
	}
	let b = Decode(codec(), compact) catch {
	case _:
		return false
	}
	Encode(codec(), a) == Encode(codec(), b) && EncodeIndent(codec(), v, p, ind) == text
}

// IndentIsFixpoint: indenting an indented text, with the same prefix and
// indent, gives it back: the white space Indent writes is the white space
// it drops.
law IndentIsFixpoint(v fleet, prefix int, width int) {
	let p = blanks(prefix)
	let ind = blanks(width)
	let once = EncodeIndent(codec(), v, p, ind)
	let twice = Indent(once, p, ind) catch {
	case Malformed:
		return false
	}
	twice == once
}

// IndentRefusesMalformed: an encoding cut short is no value, and Indent
// fails Malformed on it as Decode does.
law IndentRefusesMalformed(v fleet, cut int) {
	let text = Encode(codec(), v)
	let short = text[:nat(cut)%text.Len()]
	let _ = Indent(short, "", "  ") catch {
	case Malformed:
		return true
	}
	false
}

// blanks is white space drawn from n: up to three spaces or tabs.
func blanks(n int) string {
	let k = nat(n)
	let mut s = ""
	for i in 0..k%4 {
		let blank = if (k/4+i)%2 == 0 { " " } else { "\t" }
		s = s + blank
	}
	s
}
