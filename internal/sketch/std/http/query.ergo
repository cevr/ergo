import hex
import json
import strconv
import strings
import sync

// QueryRepeated is a query that gives Key more than one value where the
// record's field takes one (a scalar field). A slice field takes them all.
type QueryRepeated { Key string }

// ParseQuery is the fields of a raw query string ("a=1&b=%20x"), as Serve
// gives them in Request.Query: Go's url.ParseQuery, with "+" a space and
// %XX an escape; the fields are in key order, and the values of one key
// in the order they came. A pair with a malformed escape is dropped, as
// Go's Request.URL.Query drops it.
extern go ergo.local/prototype/runtime/v1.HTTPParseQuery func ParseQuery(raw string) []Field

// DecodeQuery reads a T from query fields through the derived codec
// (types.md, Codecs), as json.Decode reads one from a text, so a query
// record follows the codec's rules: a field's key is its wire name, an
// unknown key is skipped, and a field the query does not name fails
// WireMissingField unless its type is json.Optional. A scalar field
// (string, bool, a number or a refined type over one) takes exactly one
// value: a key given twice fails QueryRepeated naming it, never first or
// last wins. A slice field takes every value of its key, in order. A
// value that does not parse as the field's type fails WireWrongKind with
// the key as Path. A query value has no object form, so a field of a
// record or union type fails WireWrongKind. Booleans are "true" and
// "false"; numbers are Go's decimal spellings.
func DecodeQuery[T wire](fields []Field) T fails QueryRepeated | wired[T] {
	let r = queryReaderOf(fields)
	try decode[T](r) catch {
	case WireWrongKind as w:
		match r.repeated.Get() {
		case Some as key:
			return QueryRepeated{Key: key.Value}
		case None:
			return w
		}
	}
}

// queryGroup is one key and its values, in the order the query gave them.
type queryGroup { name string, values []string }

// queryReader gives a query's events to decode: an object whose keys are
// the query's names, each once, and whose values are a name's one value,
// or the list of its values when the field asks for a list. Its states:
// 0 before the object, 1 between keys, 2 at a key's value, 3 in a key's
// list, 4 after the object. at is the current key; item the next value of
// the list; repeated the key a scalar read met with more than one value.
type queryReader { groups []queryGroup, state sync.Ref[int], at sync.Ref[int], item sync.Ref[int], repeated sync.Ref[Option[string]] }

func queryReaderOf(fields []Field) queryReader {
	let mut groups = []queryGroup{}
	for f in fields {
		let mut found = false
		for i, g in groups {
			if g.name == f.Name {
				groups[i] = queryGroup{name: g.name, values: g.values.Append(f.Value)}
				found = true
			}
		}
		if !found {
			groups = groups.Append(queryGroup{name: f.Name, values: []string{f.Value}})
		}
	}
	queryReader{groups: groups, state: sync.NewRef[int](0), at: sync.NewRef[int](0), item: sync.NewRef[int](0), repeated: sync.NewRef[Option[string]](None)}
}

func Path(r queryReader) string {
	let s = r.state.Get()
	if s == 2 {
		return r.groups[r.at.Get()].name
	}
	if s == 3 {
		return r.groups[r.at.Get()].name + "[" + strconv.Itoa(r.item.Get()) + "]"
	}
	""
}

// value takes the next scalar value: the key's one value, or the list's
// next. want names the kind for a WireWrongKind.
func value(r queryReader, want string) string fails WireWrongKind {
	let s = r.state.Get()
	if s == 2 {
		let g = r.groups[r.at.Get()]
		if len(g.values) != 1 {
			r.repeated.Set(Some{g.name})
			return WireWrongKind{Path: g.name, Want: "one value"}
		}
		r.state.Set(1)
		r.at.Set(r.at.Get() + 1)
		return g.values[0]
	}
	if s == 3 {
		let i = r.item.Get()
		r.item.Set(i + 1)
		return r.groups[r.at.Get()].values[i]
	}
	WireWrongKind{Path: Path(r), Want: want}
}

func TakeNull(r queryReader) bool { false }

func Peek(r queryReader) WireKind {
	let s = r.state.Get()
	if s == 0 {
		return WireObject
	}
	if s == 2 {
		return if len(r.groups[r.at.Get()].values) == 1 { WireString } else { WireList }
	}
	if s == 3 && r.item.Get() < len(r.groups[r.at.Get()].values) {
		return WireString
	}
	WireEnd
}

func Number(r queryReader) string fails WireWrongKind {
	let path = Path(r)
	let v = try value(r, "a number")
	let _ = strconv.ParseFloat(v) catch {
	case _:
		return WireWrongKind{Path: path, Want: "a number"}
	}
	v
}

func String(r queryReader) string fails WireWrongKind { try value(r, "a string") }

func Bool(r queryReader) bool fails WireWrongKind {
	let path = Path(r)
	let v = try value(r, "a boolean")
	if v == "true" {
		return true
	}
	if v == "false" {
		return false
	}
	WireWrongKind{Path: path, Want: "a boolean"}
}

func Int(r queryReader) int64 fails WireWrongKind {
	let path = Path(r)
	let v = try value(r, "an integer")
	strconv.ParseInt(v, 10, 64) catch {
	case _:
		return WireWrongKind{Path: path, Want: "an integer"}
	}
}

func Uint(r queryReader) uint64 fails WireWrongKind {
	let path = Path(r)
	let v = try value(r, "an unsigned integer")
	match parseUint(v) {
	case Some as n:
		n.Value
	case None:
		WireWrongKind{Path: path, Want: "an unsigned integer"}
	}
}

// parseUint reads decimal digits into a uint64, None for anything else
// or a value over its range.
func parseUint(s string) Option[uint64] {
	if s == "" {
		return None
	}
	let mut n uint64 = 0
	for i in 0..len(s) {
		let c = s[i]
		if c < '0' || c > '9' {
			return None
		}
		let d = uint64(c - '0')
		if n > (18446744073709551615-d)/10 {
			return None
		}
		n = n*10 + d
	}
	Some{n}
}

func Float(r queryReader) float64 fails WireWrongKind {
	let path = Path(r)
	let v = try value(r, "a number")
	strconv.ParseFloat(v) catch {
	case _:
		return WireWrongKind{Path: path, Want: "a number"}
	}
}

func BeginList(r queryReader) fails WireWrongKind {
	if r.state.Get() != 2 {
		return WireWrongKind{Path: Path(r), Want: "a list"}
	}
	r.state.Set(3)
	r.item.Set(0)
}

func BeginObject(r queryReader) fails WireWrongKind {
	if r.state.Get() != 0 {
		return WireWrongKind{Path: Path(r), Want: "an object"}
	}
	r.state.Set(1)
}

// A query has no tagged object: a union T has no query form.
func Tag(r queryReader) string fails WireMissingField { WireMissingField{Path: Path(r), Field: "_tag"} }

func More(r queryReader) bool {
	let s = r.state.Get()
	if s == 1 {
		return r.at.Get() < len(r.groups)
	}
	s == 3 && r.item.Get() < len(r.groups[r.at.Get()].values)
}

func Key(r queryReader) string {
	r.state.Set(2)
	r.groups[r.at.Get()].name
}

// Skip passes over an unknown key's values.
func Skip(r queryReader) {
	r.state.Set(1)
	r.at.Set(r.at.Get() + 1)
}

func End(r queryReader) {
	if r.state.Get() == 3 {
		r.state.Set(1)
		r.at.Set(r.at.Get() + 1)
		return
	}
	r.state.Set(4)
}

// queryProbe is QueryDecodesByTheRule's record: a field of each scalar
// kind, optional and required, and a list. Its fields are declared in the
// order of their keys, the order ParseQuery gives the fields in.
type queryProbe { Load json.Optional[float64], Name string, Note json.Optional[string], On json.Optional[bool], Page int, Size json.Optional[uint64], Tags []string }

// queryEscape writes s as a query component: when plain, an unreserved
// byte as itself and a space as "+"; every other byte as %XX, in upper or
// lower case hex.
func queryEscape(s string, plain bool, upper bool) string {
	let mut out = ""
	for i in 0..len(s) {
		let c = s[i]
		let unreserved = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '.' || c == '_' || c == '~'
		if plain && unreserved {
			out = out + s[i:i+1]
		} else if plain && c == ' ' {
			out = out + "+"
		} else {
			let h = hex.Encode(s[i : i+1])
			out = out + "%" + if upper { strings.ToUpper(h) } else { h }
		}
	}
	out
}

// queryValues is the values of key among pairs, in order.
func queryValues(pairs []Field, key string) []string {
	let mut out = []string{}
	for p in pairs {
		if p.Name == key {
			out = out.Append(p.Value)
		}
	}
	out
}

// queryNumber is the integer a generated value spells; a value the law
// made unreadable ends in "x".
func queryNumber(v string) int {
	strconv.Atoi(v) catch {
	case _:
		-1
	}
}

// queryExpected is the reference of DecodeQuery over queryProbe: "ok"
// and the record, or the first refusal. The decode reads the keys in
// ParseQuery's order, which is the fields' order, so a scalar key given
// twice or a typed value that does not parse refuses in that order; then
// the missing required fields, in declaration order. An unknown key
// ("other key") never refuses.
func queryExpected(pairs []Field) (string, queryProbe) {
	let none = queryProbe{Load: json.Absent, Name: "", Note: json.Absent, On: json.Absent, Page: 0, Size: json.Absent, Tags: []string{}}
	for key in []string{"load", "name", "note", "on", "page", "size"} {
		let vs = queryValues(pairs, key)
		if len(vs) > 1 {
			return ("repeated " + key, none)
		}
		if len(vs) == 1 && key != "name" && key != "note" && strings.HasSuffix(vs[0], "x") {
			return ("wrong " + key, none)
		}
	}
	let names = queryValues(pairs, "name")
	let pages = queryValues(pairs, "page")
	let tags = queryValues(pairs, "tags")
	if len(names) == 0 {
		return ("missing name", none)
	}
	if len(pages) == 0 {
		return ("missing page", none)
	}
	if len(tags) == 0 {
		return ("missing tags", none)
	}
	let loads = queryValues(pairs, "load")
	let notes = queryValues(pairs, "note")
	let ons = queryValues(pairs, "on")
	let sizes = queryValues(pairs, "size")
	let load json.Optional[float64] = if len(loads) == 0 { json.Absent } else { json.Present{Value: float64(queryNumber(loads[0]))} }
	let note json.Optional[string] = if len(notes) == 0 { json.Absent } else { json.Present{Value: notes[0]} }
	let on json.Optional[bool] = if len(ons) == 0 { json.Absent } else { json.Present{Value: ons[0] == "true"} }
	let size json.Optional[uint64] = if len(sizes) == 0 { json.Absent } else { json.Present{Value: uint64(queryNumber(sizes[0]))} }
	("ok", queryProbe{Load: load, Name: names[0], Note: note, On: on, Page: queryNumber(pages[0]), Size: size, Tags: tags})
}

// QueryDecodesByTheRule: a query string with repeated keys, an unknown
// key, percent escapes in upper and lower case, "+" for a space and
// dropped malformed pairs, read by ParseQuery and DecodeQuery, gives the
// reference's record or its first refusal: a scalar key given twice is
// QueryRepeated naming it, a list takes every value in order, a value
// that does not parse is WireWrongKind at its key, and an unknown key is
// skipped. counts choose how many times each key comes (once when counts
// is short); numbers choose each value and its spelling; texts are the
// text values.
law QueryDecodesByTheRule(counts []int, numbers []int, texts []string) {
	let keys = []string{"load", "name", "note", "on", "other key", "page", "size", "tags"}
	let mut pairs = []Field{}
	let mut raw = ""
	let mut i = 0
	for j, key in keys {
		let k = if j < len(counts) { ((counts[j] % 6) + 6) % 6 } else { 5 }
		let times = if k == 0 { 0 } else if k == 1 { 2 } else if k == 2 { 3 } else { 1 }
		for _ in 0..times {
			let n = if len(numbers) == 0 { i } else { numbers[i%len(numbers)] }
			let m = if n < 0 { -(n % 1000) } else { n % 1000 }
			let text = if len(texts) == 0 { "" } else { texts[i%len(texts)] }
			let typed = key == "load" || key == "on" || key == "page" || key == "size"
			let value = if !typed { text } else if m%7 == 6 { text + "x" } else if key == "on" { if m%2 == 0 { "true" } else { "false" } } else { strconv.Itoa(1000 + 13*m) }
			pairs = pairs.Append(Field{Name: key, Value: value})
			let part = queryEscape(key, m%2 == 0, m%3 == 0) + "=" + queryEscape(value, m%5 != 0, m%3 == 1)
			raw = if i == 0 { part } else { raw + "&" + part }
			if m%11 == 0 {
				raw = raw + "&bad=%zz"
			}
			i = i + 1
		}
	}
	let (want, record) = queryExpected(pairs)
	let got = DecodeQuery[queryProbe](ParseQuery(raw)) catch {
	case QueryRepeated as q:
		return want == "repeated "+q.Key
	case WireWrongKind as w:
		return want == "wrong "+w.Path
	case WireMissingField as f:
		return want == "missing "+f.Field
	case WireUnknownTag:
		return false
	}
	want == "ok" && got == record
}
