import json
import option
import slices
import strings

// Route matches exact path segments; :name captures one non-empty segment.
// Routes are considered in slice order. An explicit HEAD route wins over
// a GET fallback. There is no path cleaning or implicit trailing slash.
// Value is what the route stands for (an endpoint), so a Found route
// names its endpoint by a field read, with no lookup that could miss.
// Status is the explicit success status; Success uses it for the reply.
type Route[T] { Value T, Method string, Path string, Status int }
type Found[T] { Route Route[T], Params Map[string, string] }
type NotFound {}

// MethodNotAllowed is a path that routes take with other methods: Allow
// is those methods, each once, in route order, with HEAD after GET when
// GET serves it, as RFC 9110 asks of a 405's Allow header.
type MethodNotAllowed { Allow []string }
type MatchResult[T] = Found[T] | NotFound | MethodNotAllowed

// Success answers a matched route with its declared success status and a JSON
// body. A no-content status (204 or 205) has neither a body nor a content type.
// Failure uses the separate failure-status table for typed refusals.
func Success[T](route Route[T], body string) Response {
	if route.Status == 204 || route.Status == 205 {
		return Response{Status: route.Status, Header: []Field{}, Body: ""}
	}
	Response{Status: route.Status, Header: []Field{Field{Name: "Content-Type", Value: "application/json"}}, Body: body}
}

// SuccessJSON answers as Success(route, json.Encode(c, v)) does, with
// v's text written straight to the connection (SendBytes), never made a
// string: a 204 or a 205 has no body, as Success has none.
func SuccessJSON[T, V wire](route Route[T], c json.Codec[V], v V) Response needs Streaming | wired[V] {
	if route.Status == 205 || route.Status == 204 { return Success(route, "") }
	json.EncodeWith(c, v, func(text []byte) Response needs Streaming {
		SendBytes(route.Status, []Field{Field{Name: "Content-Type", Value: "application/json"}}, text)
	})
}

// SuccessJSONIsSuccess: under a Recorder, SuccessJSON answers as Success
// answers with the value's Encode text, for each success status, 204 and
// 205 (no body) among them.
law SuccessJSONIsSuccess(pick int, items []string) {
	let statuses = []int{200, 201, 202, 204, 205, 299}
	let status = statuses[((pick%statuses.Len())+statuses.Len())%statuses.Len()]
	let route = Route{Value: "reply", Method: "GET", Path: "/", Status: status}
	let c = json.Codec[[]string]{MaxBytes: 0, MaxDepth: 0}
	let sent = with context { Streaming: NewRecorder() } { SuccessJSON(route, c, items) }
	let want = Success(route, json.Encode(c, items))
	sent.Status == want.Status && sent.Body == want.Body && slices.Equal(sent.Header, want.Header)
}

// SuccessUsesRoute catches a reply that defaults to 200, drops its body, or
// writes a JSON body for a no-content status. The generated status is explicit.
law SuccessUsesRoute(pick int, body string) {
	let status = 200 + ((pick%100)+100)%100
	let route = Route{Value: "reply", Method: "POST", Path: "/", Status: status}
	let response = Success(route, body)
	response.Status == status && if status == 204 || status == 205 {
		response.Body == "" && response.Header.Len() == 0
	} else {
		response.Body == body && Header(response.Header, "Content-Type") == option.Some{"application/json"}
	}
}

func parameters(pattern string, path string) option.Option[Map[string, string]] {
	// Only the route that matches splits and captures: a request tries
	// every route, and a split per route was most of its allocations.
	if !segmentsMatch(pattern, path) { return option.None }
	let want = strings.Split(pattern, "/")
	let got = strings.Split(path, "/")
	if want.Len() != got.Len() { return option.None }
	let mut params = Map[string, string]{}
	for i, part in want {
		if strings.HasPrefix(part, ":") && part.Len() > 1 {
			if got[i] == "" { return option.None }
			params[strings.TrimPrefix(part, ":")] = got[i]
		} else if part != got[i] {
			return option.None
		}
	}
	option.Some{params}
}

// segmentsMatch reports whether path matches pattern segment by segment,
// as parameters' split does, with no allocation: the two have as many
// segments, each :name segment (with a name) takes a non-empty one, and
// every other segment is equal.
func segmentsMatch(pattern string, path string) bool {
	let mut want = pattern
	let mut got = path
	for {
		let wi = strings.Index(want, "/")
		let gi = strings.Index(got, "/")
		if (wi < 0) != (gi < 0) { return false }
		let w = if wi < 0 { want } else { strings.Slice(want, 0, wi) }
		let g = if gi < 0 { got } else { strings.Slice(got, 0, gi) }
		if strings.HasPrefix(w, ":") && w.Len() > 1 {
			if g == "" { return false }
		} else if w != g {
			return false
		}
		if wi < 0 { return true }
		want = strings.Slice(want, wi+1, want.Len())
		got = strings.Slice(got, gi+1, got.Len())
	}
}

// MatchIsSplitMatch: Match finds a route exactly when its path and the
// asked path split into as many segments, each :name segment (with a
// name) takes a non-empty one and every other is equal, on generated
// patterns and paths of empty, plain, :name and bare-colon segments.
law MatchIsSplitMatch(pattern []int, path []int) {
	let parts = []string{"", "a", "b", ":x", ":"}
	let pick = func(xs []int) string {
		let mut text = ""
		for i, p in xs {
			let part = parts[if p < 0 { -(p % parts.Len()) } else { p % parts.Len() }]
			text = if i == 0 { part } else { text + "/" + part }
		}
		text
	}
	let want = strings.Split(pick(pattern), "/")
	let got = strings.Split(pick(path), "/")
	let mut split = want.Len() == got.Len()
	for i, part in want {
		if split && strings.HasPrefix(part, ":") && part.Len() > 1 {
			split = got[i] != ""
		} else if split {
			split = part == got[i]
		}
	}
	let found = match Match([]Route[int]{Route{Value: 1, Method: "GET", Path: pick(pattern), Status: 200}}, "GET", pick(path)) {
	case Found:
		true
	case NotFound, MethodNotAllowed:
		false
	}
	found == split
}

func Match[T](routes []Route[T], method string, path string) MatchResult[T] {
	let mut allow = []string{}
	for route in routes {
		match parameters(route.Path, path) {
		case option.Some as p:
			if route.Method == method { return Found{Route: route, Params: p.Value} }
			if !slices.Contains(allow, route.Method) { allow = allow.Append(route.Method) }
		case option.None:
		}
	}
	if method == "HEAD" {
		for route in routes {
			if route.Method == "GET" {
				match parameters(route.Path, path) {
				case option.Some as p:
					return Found{Route: route, Params: p.Value}
				case option.None:
				}
			}
		}
	}
	if allow.Len() == 0 { return NotFound }
	if slices.Contains(allow, "HEAD") { return MethodNotAllowed{Allow: allow} }
	let mut withHead = []string{}
	for m in allow {
		withHead = withHead.Append(m)
		if m == "GET" { withHead = withHead.Append("HEAD") }
	}
	MethodNotAllowed{Allow: withHead}
}

// BuiltPathMatches is the route-construction law for two path segments.
// Empty strings and strings with a slash are not one path segment.
law BuiltPathMatches(a string, b string) {
	if a == "" || b == "" || strings.Contains(a, "/") || strings.Contains(b, "/") { return true }
	let route = Route{Value: "pair", Method: "GET", Path: "/:a/:b", Status: 201}
	match Match([]Route[string]{route}, "GET", "/"+a+"/"+b) {
	case Found as f:
		f.Route == route && f.Params.Get("a") == option.Some{a} && f.Params.Get("b") == option.Some{b}
	case NotFound, MethodNotAllowed:
		false
	}
}

// AllowIsWhatMatches: for routes of one path with generated methods, a
// method is in a 405's Allow exactly when Match finds a route for it, and
// Allow names each method once.
law AllowIsWhatMatches(picks []int, asked int) {
	let methods = []string{"GET", "HEAD", "POST", "PUT", "DELETE"}
	let pick = func(i int) string { methods[if i < 0 { -(i % methods.Len()) } else { i % methods.Len() }] }
	let mut routes = []Route[int]{}
	for i, p in picks {
		routes = routes.Append(Route{Value: i, Method: pick(p), Path: "/r/:id", Status: 200})
	}
	match Match(routes, pick(asked), "/r/7") {
	case Found, NotFound:
		true
	case MethodNotAllowed as m:
		for i, a in m.Allow {
			if slices.Contains(m.Allow[i+1:], a) { return false }
		}
		for name in methods {
			let found = match Match(routes, name, "/r/7") {
			case Found:
				true
			case NotFound, MethodNotAllowed:
				false
			}
			if found != slices.Contains(m.Allow, name) { return false }
		}
		true
	}
}
