import slices
import strings

// Route matches exact path segments; :name captures one non-empty segment.
// Routes are considered in slice order. An explicit HEAD route wins over
// a GET fallback. There is no path cleaning or implicit trailing slash.
// Value is what the route stands for (an endpoint), so a Found route
// names its endpoint by a field read, with no lookup that could miss.
// Status is the explicit success status; Success uses it for the reply.
type Route[T] { Value T, Method string, Path string, Status int }
type Found[T] { Route Route[T], Params Map[string, string] }
type NotFound {}

// MethodNotAllowed is a path that routes take with other methods: Allow
// is those methods, each once, in route order, with HEAD after GET when
// GET serves it, as RFC 9110 asks of a 405's Allow header.
type MethodNotAllowed { Allow []string }
type MatchResult[T] = Found[T] | NotFound | MethodNotAllowed

// Success answers a matched route with its declared success status and a JSON
// body. A no-content status (204 or 205) has neither a body nor a content type.
// Failure uses the separate failure-status table for typed refusals.
func Success[T](route Route[T], body string) Response {
	if route.Status == 204 || route.Status == 205 {
		return Response{Status: route.Status, Header: []Field{}, Body: ""}
	}
	Response{Status: route.Status, Header: []Field{Field{Name: "Content-Type", Value: "application/json"}}, Body: body}
}

// SuccessUsesRoute catches a reply that defaults to 200, drops its body, or
// writes a JSON body for a no-content status. The generated status is explicit.
law SuccessUsesRoute(pick int, body string) {
	let status = 200 + ((pick%100)+100)%100
	let route = Route{Value: "reply", Method: "POST", Path: "/", Status: status}
	let response = Success(route, body)
	response.Status == status && if status == 204 || status == 205 {
		response.Body == "" && len(response.Header) == 0
	} else {
		response.Body == body && Header(response.Header, "Content-Type") == Some{"application/json"}
	}
}

func parameters(pattern string, path string) Option[Map[string, string]] {
	let want = strings.Split(pattern, "/")
	let got = strings.Split(path, "/")
	if len(want) != len(got) { return None }
	let mut params = Map[string, string]{}
	for i, part in want {
		if strings.HasPrefix(part, ":") && len(part) > 1 {
			if got[i] == "" { return None }
			params[strings.TrimPrefix(part, ":")] = got[i]
		} else if part != got[i] {
			return None
		}
	}
	Some{params}
}

func Match[T](routes []Route[T], method string, path string) MatchResult[T] {
	let mut allow = []string{}
	for route in routes {
		match parameters(route.Path, path) {
		case Some as p:
			if route.Method == method { return Found{Route: route, Params: p.Value} }
			if !slices.Contains(allow, route.Method) { allow = allow.Append(route.Method) }
		case None:
		}
	}
	if method == "HEAD" {
		for route in routes {
			if route.Method == "GET" {
				match parameters(route.Path, path) {
				case Some as p:
					return Found{Route: route, Params: p.Value}
				case None:
				}
			}
		}
	}
	if len(allow) == 0 { return NotFound }
	if slices.Contains(allow, "HEAD") { return MethodNotAllowed{Allow: allow} }
	let mut withHead = []string{}
	for m in allow {
		withHead = withHead.Append(m)
		if m == "GET" { withHead = withHead.Append("HEAD") }
	}
	MethodNotAllowed{Allow: withHead}
}

// BuiltPathMatches is the route-construction law for two path segments.
// Empty strings and strings with a slash are not one path segment.
law BuiltPathMatches(a string, b string) {
	if a == "" || b == "" || strings.Contains(a, "/") || strings.Contains(b, "/") { return true }
	let route = Route{Value: "pair", Method: "GET", Path: "/:a/:b", Status: 201}
	match Match([]Route[string]{route}, "GET", "/"+a+"/"+b) {
	case Found as f:
		f.Route == route && f.Params.Get("a") == Some{a} && f.Params.Get("b") == Some{b}
	case NotFound, MethodNotAllowed:
		false
	}
}

// AllowIsWhatMatches: for routes of one path with generated methods, a
// method is in a 405's Allow exactly when Match finds a route for it, and
// Allow names each method once.
law AllowIsWhatMatches(picks []int, asked int) {
	let methods = []string{"GET", "HEAD", "POST", "PUT", "DELETE"}
	let pick = func(i int) string { methods[if i < 0 { -(i % len(methods)) } else { i % len(methods) }] }
	let mut routes = []Route[int]{}
	for i, p in picks {
		routes = routes.Append(Route{Value: i, Method: pick(p), Path: "/r/:id", Status: 200})
	}
	match Match(routes, pick(asked), "/r/7") {
	case Found, NotFound:
		true
	case MethodNotAllowed as m:
		for i, a in m.Allow {
			if slices.Contains(m.Allow[i+1:], a) { return false }
		}
		for name in methods {
			let found = match Match(routes, name, "/r/7") {
			case Found:
				true
			case NotFound, MethodNotAllowed:
				false
			}
			if found != slices.Contains(m.Allow, name) { return false }
		}
		true
	}
}
