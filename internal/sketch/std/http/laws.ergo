import fs
import strings
import sync

// filesProbe is this law's private recorder. It refuses every read; the
// law observes the paths, not file contents. These helpers are reachable
// only from the law and emit no code in a non-test build. The functional
// property uses fstest.Tree without making http import a test provider.
type filesProbe { paths sync.Ref[[]string] } implements fs.Root

func noteFilePath(p filesProbe, path string) {
	sync.Modify(p.paths, func(ps []string) (bool, []string) { (true, ps.Append(path)) })
}

func Name(_ filesProbe) string { "probe" }
func ReadFile(p filesProbe, path string) string fails fs.Escapes {
	noteFilePath(p, path)
	fs.Escapes{Path: path}
}
func ReadDir(p filesProbe, path string) []string fails fs.Escapes {
	noteFilePath(p, path)
	fs.Escapes{Path: path}
}
func Stat(p filesProbe, path string) fs.Info fails fs.Escapes {
	noteFilePath(p, path)
	fs.Escapes{Path: path}
}

// fileSegment is the request path element that step picks: names, links,
// "." and "..", empty elements and their encoded forms (Serve gives
// Files the decoded path, so "%2e%2e" is a name here, not "..").
func fileSegment(step int) string {
	let segments = []string{"..", ".", "", "a.txt", "sub", "out", "in", "%2e%2e", "...", "..a", "b.txt"}
	let i = if step < 0 { -(step % len(segments)) } else { step % len(segments) }
	segments[i]
}

// FilesAsksBeneath: whatever the request path, Files asks its root for
// at most one path, and that path is relative, with no "..", "." or empty
// element, so it names a file below the root before any link is read
// (fs.Root confines the links). A request path with a ".." element after
// the prefix reaches no read. steps picks the elements of the request
// path after "/static/", and the parity of their count GET or HEAD.
law FilesAsksBeneath(steps []int, prefixed bool) {
	let mut rest = ""
	let mut dotdot = false
	for i, s in steps {
		let e = fileSegment(s)
		dotdot = dotdot || e == ".."
		rest = if i == 0 { e } else { rest + "/" + e }
	}
	let path = if prefixed { "/static/" + rest } else { "/" + rest }
	let method = if len(steps)%2 == 0 { "GET" } else { "HEAD" }
	let root = filesProbe{paths: sync.NewRef[[]string]([]string{})}
	let response = Files(root, "/static/", Request{Method: method, Path: path, RawPath: path, Query: []Field{}, Header: []Field{}, Body: Buffered{Text: ""}})
	let asked = root.paths.Get()
	if len(asked) > 1 || (dotdot || !prefixed) && len(asked) != 0 {
		return false
	}
	for p in asked {
		if strings.HasPrefix(p, "/") {
			return false
		}
		for e in strings.Split(p, "/") {
			if e == "" || e == "." || e == ".." {
				return false
			}
		}
	}
	response.Status == 200 || response.Status == 403 || response.Status == 404
}

// StreamIsItsWrites: Stream answers with its status and header, and its
// body is every part write wrote, in order (under a Recorder, which keeps
// what Serve's provider sends).
law StreamIsItsWrites(status int, parts []string) {
	let header = []Field{Field{Name: "Content-Type", Value: "text/plain"}}
	let response = with context { Streaming: NewRecorder() } {
		Stream(status, header, func(w BodyWriter) fails WriteFailed {
			for p in parts {
				try w.Write(p)
			}
		})
	}
	let mut want = ""
	for p in parts {
		want = want + p
	}
	response == Response{Status: status, Header: header, Body: want}
}

// InMemorySendIntoIsSend: the in-memory Net's SendInto gives put exactly
// Send's body, and an empty Body back, when accept takes the status; any
// other status fails StatusRefused with the status and the body's first
// 1024 bytes, and put gets nothing. accept is the 2xx rule, or values
// with the status added when listed is odd.
law InMemorySendIntoIsSend(status int, body string, long bool, explicit bool, listed int, values []int) {
	let text = if long { strings.Repeat(body+"x", 1100) } else { body }
	let set = if listed%2 == 0 { values } else { values.Append(status) }
	let accept Accept = if explicit { Statuses{Values: set} } else { AnySuccess }
	let mut taken = !explicit && status >= 200 && status < 300
	for v in set {
		taken = taken || explicit && v == status
	}
	let h = InMemory(func(r Request) Response needs Streaming { Response{Status: status, Header: []Field{}, Body: text} })
	let got = sync.NewRef[string]("")
	let r = Request{Method: "GET", Path: "/", RawPath: "/", Query: []Field{}, Header: []Field{}, Body: Buffered{Text: ""}}
	let response = h.SendInto(r, accept, func(part string) fails SinkFailed { got.Update(func(s string) string { s + part }) }) catch {
	case StatusRefused as s:
		let want = if len(text) > 1024 { text[0:1024] } else { text }
		return !taken && s.Status == status && s.Prefix == want && got.Get() == ""
	case RequestFailed, SinkFailed:
		return false
	}
	taken && got.Get() == text && response.Status == status && response.Body == ""
}

// WriteAfterStreamFails: a BodyWriter kept past the function Stream ran
// fails WriteFailed, and the answer does not change.
law WriteAfterStreamFails(text string) {
	let kept = sync.NewRef[[]BodyWriter]([]BodyWriter{})
	let response = with context { Streaming: NewRecorder() } {
		Stream(200, []Field{}, func(w BodyWriter) fails WriteFailed {
			kept.Set([]BodyWriter{w})
		})
	}
	for w in kept.Get() {
		w.Write(text) catch {
		case WriteFailed:
			return response.Body == ""
		}
	}
	false
}

// RawPathDecodesToPath: a request sent through an InMemoryNetwork, so
// through Go's client and server as Serve reads one, reaches its handler
// with RawPath as the URL wrote the path and Path that RawPath's
// DecodePath: a "/" inside a segment stays "%2F" in RawPath and only Path
// splits there. segments are the path's segments, each escaped in upper
// or lower case hex, every other one with its unreserved bytes plain.
law RawPathDecodesToPath(segments []string, upper bool) {
	let mut raw = ""
	for i, s in segments {
		let seg = if s == "" { "-" } else { s }
		raw = raw + "/" + queryEscape(seg, i%2 == 0, upper)
	}
	if raw == "" {
		raw = "/"
	}
	let n = InMemoryNetwork(AnyOrigin, Limits{MaxBodyBytes: 1 << 16, MaxHeaderBytes: 1 << 16, IdleTimeout: 30s, ReadHeaderTimeout: 10s, ReadBodyTimeout: 10s}, NoRedirects, func(origin string, r Request) Response needs Streaming {
		Response{Status: 200, Header: []Field{}, Body: r.RawPath + "\n" + r.Path}
	}) catch {
	case InvalidClient, InvalidLimits:
		return false
	}
	let got = n.SendURL(URLRequest{URL: "http://raw.test" + raw, Method: "GET", Header: []Field{}, Credentials: []Credential{}, Body: ""}) catch {
	case RequestFailed, OriginRefused, RedirectLimit:
		return false
	}
	let decoded = DecodePath(raw) catch {
	case BadEscape:
		return false
	}
	got.Body == raw + "\n" + decoded
}
