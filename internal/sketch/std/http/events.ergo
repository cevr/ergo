// Server-sent events (text/event-stream), by the WHATWG HTML standard's
// rules (§9.2.6, "Interpreting an event stream"). The reader is pure: it
// takes a body a part at a time, in any cuts, and gives each event as its
// blank line ends it. A body that ends inside an event is Truncated, a
// failure that carries the unfinished text, never a last event. Effect's
// Sse decoder's purpose (fields, multi-line data, the last event id, the
// retry field) is kept; its Channel API is not: a part in, events out.

import strings
import rand
import strconv
import sync

// ServerEvent is one event: its type ("message" when the stream names
// none), its data (the data lines joined by line feeds) and the last
// event id the stream set, which an event keeps until a later id field
// changes it.
type ServerEvent { Event string, Data string, ID string }

// Truncated is a body that ended inside an event: Text is what the
// stream sent of it, after the last blank line, with each line end
// written as a line feed.
type Truncated { Text string }

// Unwritable is an event that no event stream carries as it is: an
// Event or ID with a line end, an ID with a NUL, or Data with a carriage
// return (a reader reads every line end as a line feed).
type Unwritable { Field string, Value string }

// EventReader is a stream read so far.
type EventReader {
	line    string,
	afterCR bool,
	started bool,
	event   string,
	data    string,
	hasData bool,
	id      string,
	retry   Option[int],
	open    string,
	fields  bool,
}

// bom is the byte order mark a stream may begin with, which the reader
// drops.
let bom = "\xEF\xBB\xBF"

// NewEventReader is a reader at the start of a stream.
func NewEventReader() EventReader {
	EventReader{line: "", afterCR: false, started: false, event: "", data: "", hasData: false, id: "", retry: None, open: "", fields: false}
}

// Retry is the reconnection time in milliseconds of the last retry field
// whose value is all ASCII digits, or None when there is none.
func Retry(r EventReader) Option[int] { r.retry }

// Feed reads the next part of the stream: the reader after it, and the
// events whose blank line it held, in order. A line end cut between two
// parts (CR at the end of one, LF at the start of the next) is one line
// end.
//
// The open event's text (End's Truncated) is kept as the span of the part
// since the last blank line, and joined to the reader's once per part, so
// a line costs no copy of the text before it.
func Feed(r EventReader, part string) (EventReader, []ServerEvent) {
	let mut at = r
	let mut text = part
	if !at.started {
		let head = at.line + part
		if len(head) < len(bom) && strings.HasPrefix(bom, head) {
			return (EventReader{..at, line: head}, []ServerEvent{})
		}
		at = EventReader{..at, started: true, line: ""}
		text = strings.TrimPrefix(head, bom)
	}
	let mut out = []ServerEvent{}
	if len(text) == 0 {
		return (at, out)
	}
	let mut i = 0
	if at.afterCR && text[0] == '\n' {
		i = 1
	}
	at.afterCR = false
	// from is where this part's open text begins; carried is the line the
	// last part left unended, which the first line here completes.
	let mut from = i
	let mut carried = at.line
	let mut lines = 0
	for _ in 0..len(text)+1 {
		if i >= len(text) {
			break
		}
		let j = lineEnd(text, i)
		if j < 0 {
			break
		}
		let ln = if at.line == "" { strings.Slice(text, i, j) } else { at.line + strings.Slice(text, i, j) }
		lines = lines + 1
		at.line = ""
		let event = lineOf(&at, ln)
		let mut after = j + 1
		if text[j] == '\r' {
			if j+1 == len(text) {
				at.afterCR = true
			} else if text[j+1] == '\n' {
				after = j + 2
			}
		}
		if ln == "" {
			// A blank line ends the open text: it starts again after it.
			at.open = ""
			carried = ""
			from = after
		}
		match event {
		case Some[ServerEvent] as e:
			out = out.Append(e.Value)
		case None:
		}
		i = after
	}
	let rest = strings.Slice(text, i, len(text))
	let ended = strings.Slice(text, from, i)
	if lines == 0 {
		carried = ""
	}
	if carried != "" || ended != "" {
		at.open = at.open + carried + lineFeeds(ended)
	}
	(EventReader{..at, line: at.line + rest}, out)
}

// lineFeeds is s with each line end (CR LF, CR or LF) written as LF.
func lineFeeds(s string) string {
	if strings.IndexByte(s, '\r') < 0 {
		return s
	}
	strings.ReplaceAll(strings.ReplaceAll(s, "\r\n", "\n"), "\r", "\n")
}

// End is the end of the stream: None after a blank line (or a comment),
// else the event the stream was inside.
func End(r EventReader) Option[Truncated] {
	let partial = r.line != "" && !strings.HasPrefix(r.line, ":")
	if r.fields || partial {
		return Some[Truncated]{Value: Truncated{Text: r.open + r.line}}
	}
	None
}

// ReadEvents is the events of a whole body.
func ReadEvents(body string) []ServerEvent fails Truncated {
	let r, events = Feed(NewEventReader(), body)
	match r.End() {
	case Some[Truncated] as t:
		t.Value
	case None:
		events
	}
}

// lineEnd is the index of the first CR or LF of s at from or after, or
// -1.
func lineEnd(s string, from int) int {
	for k in from..len(s) {
		if s[k] == '\n' || s[k] == '\r' {
			return k
		}
	}
	-1
}

// lineOf reads one whole line into r, and is the event a blank line
// ends.
func lineOf(r mut EventReader, ln string) Option[ServerEvent] {
	if ln == "" {
		let had = r.hasData
		let event = ServerEvent{Event: if r.event == "" { "message" } else { r.event }, Data: r.data, ID: r.id}
		r.event = ""
		r.data = ""
		r.hasData = false
		r.fields = false
		if !had {
			return None
		}
		return Some[ServerEvent]{Value: event}
	}
	if ln[0] == ':' {
		return None
	}
	r.fields = true
	let colon = strings.IndexByte(ln, ':')
	let field = if colon < 0 { ln } else { strings.Slice(ln, 0, colon) }
	let rest = if colon < 0 { "" } else { strings.Slice(ln, colon+1, len(ln)) }
	let value = strings.TrimPrefix(rest, " ")
	match field {
	case "event":
		r.event = value
	case "data":
		// One data line is the event's data as it is; another joins it
		// after a line feed.
		r.data = if r.hasData { r.data + "\n" + value } else { value }
		r.hasData = true
	case "id":
		if strings.IndexByte(value, 0) < 0 {
			r.id = value
		}
	case "retry":
		if digits(value) {
			let ms = strconv.Atoi(value) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return None
			}
			r.retry = Some[int]{Value: ms}
		}
	case _:
	}
	None
}

// digits reports whether s is one or more ASCII digits.
func digits(s string) bool {
	if s == "" {
		return false
	}
	for k in 0..len(s) {
		if s[k] < '0' || s[k] > '9' {
			return false
		}
	}
	true
}

// WriteEvents is the text of a stream of events, which ReadEvents reads
// back: an event line when the type is not "message", an id line when
// the id is not the one the stream holds, a data line per line of the
// data, and a blank line.
func WriteEvents(events []ServerEvent) string fails Unwritable {
	let mut b = strings.NewBuilder()
	let mut id = ""
	for e in events {
		if breaks(e.Event, false) {
			return Unwritable{Field: "Event", Value: e.Event}
		}
		if breaks(e.ID, true) {
			return Unwritable{Field: "ID", Value: e.ID}
		}
		if strings.IndexByte(e.Data, '\r') >= 0 {
			return Unwritable{Field: "Data", Value: e.Data}
		}
		if e.Event != "" && e.Event != "message" {
			b.WriteString("event: " + e.Event + "\n")
		}
		if e.ID != id {
			b.WriteString("id: " + e.ID + "\n")
			id = e.ID
		}
		for line in strings.Split(e.Data, "\n") {
			b.WriteString("data: " + line + "\n")
		}
		b.WriteString("\n")
	}
	b.String()
}

// breaks reports whether s holds a CR or an LF, or a NUL when nul.
func breaks(s string, nul bool) bool {
	strings.IndexByte(s, '\r') >= 0 || strings.IndexByte(s, '\n') >= 0 || (nul && strings.IndexByte(s, 0) >= 0)
}

// Events sends r through the bound Net and hands each event of a 2xx
// body to on, as its blank line arrives. A body that ends inside an
// event fails Truncated after on took every event before it.
func Events(r Request, on func(e ServerEvent) fails SinkFailed) Response fails RequestFailed | StatusRefused | SinkFailed | Truncated needs Net {
	let reader = sync.NewRef[EventReader](NewEventReader())
	let response = try DoInto(r, func(part string) fails SinkFailed {
		let next, events = Feed(reader.Get(), part)
		reader.Set(next)
		for e in events {
			try on(e)
		}
	})
	match reader.Get().End() {
	case Some[Truncated] as t:
		t.Value
	case None:
		response
	}
}

// The laws of the reader and the writer, beside them. FeedMatchesModel
// holds the reader to a model of the WHATWG rules written another way
// (modelRead); the others hold the writer and the reader to each other.

// writable is e with what no stream carries taken out: line ends from
// Event and ID, NUL from ID, CR from Data.
func writable(events []ServerEvent) []ServerEvent {
	let mut out = []ServerEvent{}
	for e in events {
		let event = strings.ReplaceAll(strings.ReplaceAll(e.Event, "\r", ""), "\n", "")
		let id = strings.ReplaceAll(strings.ReplaceAll(strings.ReplaceAll(e.ID, "\r", ""), "\n", ""), "\x00", "")
		out = out.Append(ServerEvent{Event: event, Data: strings.ReplaceAll(e.Data, "\r", ""), ID: id})
	}
	out
}

// typed is events as a reader gives them: a type of "" is "message".
func typed(events []ServerEvent) []ServerEvent {
	let mut out = []ServerEvent{}
	for e in events {
		out = out.Append(ServerEvent{..e, Event: if e.Event == "" { "message" } else { e.Event }})
	}
	out
}

// feedIn is text fed to a new reader in parts of the lengths sizes
// draws, 0 to 9 bytes each, in turn: the reader at the end and every
// event.
func feedIn(text string, sizes []int) (EventReader, []ServerEvent) {
	let mut r = NewEventReader()
	let mut out = []ServerEvent{}
	let mut from = 0
	for k in 0..len(text)+1 {
		if from >= len(text) || len(sizes) == 0 {
			break
		}
		let s = sizes[k%len(sizes)]
		let n = if s < 0 { -(s % 10) } else { s % 10 }
		let to = if from+n > len(text) { len(text) } else { from + n }
		let next, events = Feed(r, strings.Slice(text, from, to))
		r = next
		for e in events {
			out = out.Append(e)
		}
		from = to
	}
	let last, events = Feed(r, strings.Slice(text, from, len(text)))
	for e in events {
		out = out.Append(e)
	}
	(last, out)
}

// WriteThenRead: the text WriteEvents writes reads back as its events.
law WriteThenRead(events []ServerEvent) {
	let clean = writable(events)
	let text = WriteEvents(clean) catch {
	case Unwritable:
		return false
	}
	let back = ReadEvents(text) catch {
	case Truncated:
		return false
	}
	back == typed(clean)
}

// ChunkingDoesNotMatter: a stream fed in any cuts gives the events of
// the whole, and ends outside an event.
law ChunkingDoesNotMatter(events []ServerEvent, sizes []int) {
	let clean = writable(events)
	let text = WriteEvents(clean) catch {
	case Unwritable:
		return false
	}
	let r, got = feedIn(text, sizes)
	got == typed(clean) && r.End() == None
}

// CutIsNotAnEvent: a stream that loses some bytes of its last event,
// not all, gives the events before it, and ends Truncated with what it
// sent of the last.
law CutIsNotAnEvent(events []ServerEvent, k int, sizes []int) {
	let clean = writable(events)
	if len(clean) == 0 {
		return true
	}
	let before = WriteEvents(clean[0:len(clean)-1]) catch {
	case Unwritable:
		return false
	}
	let whole = WriteEvents(clean) catch {
	case Unwritable:
		return false
	}
	let last = len(whole) - len(before)
	let drop = 1 + (if k < 0 { -(k % (last - 1)) } else { k % (last - 1) })
	let body = strings.Slice(whole, 0, len(whole)-drop)
	let r, got = feedIn(body, sizes)
	got == typed(clean[0:len(clean)-1]) && r.End() == Some[Truncated]{Value: Truncated{Text: strings.Slice(body, len(before), len(body))}}
}

// FeedMatchesModel: over text of up to 120 pieces drawn from seed, fed
// in drawn cuts, the reader gives the model's events, its end and its
// retry.
law FeedMatchesModel(seed int) {
	let pieces = []string{"data", "data:", "data: ", "event: ", "event", "id: ", "id", "retry: ", "retry:", "12", "x", " ", ":", "\n", "\n", "\r", "\r\n", "\x00", "-1", bom, "é"}
	with context { Random: rand.Seeded(uint64(seed)) } {
		let mut text = if Random.IntN(4) == 0 { bom } else { "" }
		for _ in 0..Random.IntN(120) {
			text = text + pieces[Random.IntN(len(pieces))]
		}
		let mut sizes = []int{}
		for _ in 0..1+Random.IntN(8) {
			sizes = sizes.Append(Random.IntN(10))
		}
		let r, got = feedIn(text, sizes)
		let want, end, retry = modelRead(text)
		got == want && r.End() == end && Retry(r) == retry
	}
}

// modelRead is the events of a whole body by the WHATWG rules, written
// apart from the reader: the BOM dropped, every CRLF and CR made LF, the
// text split at LF, and each line read by strings.Cut.
func modelRead(text string) ([]ServerEvent, Option[Truncated], Option[int]) {
	let lf = strings.ReplaceAll(strings.ReplaceAll(strings.TrimPrefix(text, bom), "\r\n", "\n"), "\r", "\n")
	let lines = strings.Split(lf, "\n")
	let mut out = []ServerEvent{}
	let mut kind = ""
	let mut data = []string{}
	let mut id = ""
	let mut retry Option[int] = None
	let mut open = ""
	let mut fields = false
	for i, ln in lines {
		if i == len(lines)-1 {
			break
		}
		if ln == "" {
			if len(data) > 0 {
				out = out.Append(ServerEvent{Event: if kind == "" { "message" } else { kind }, Data: strings.Join(data, "\n"), ID: id})
			}
			kind = ""
			data = []string{}
			open = ""
			fields = false
			continue
		}
		open = open + ln + "\n"
		let (name, value) = match strings.Cut(ln, ":") {
		case Some[strings.Halves] as h:
			(h.Value.Before, strings.TrimPrefix(h.Value.After, " "))
		case None:
			(ln, "")
		}
		if name == "" && strings.HasPrefix(ln, ":") {
			continue
		}
		fields = true
		if name == "event" {
			kind = value
		} else if name == "data" {
			data = data.Append(value)
		} else if name == "id" && !strings.Contains(value, "\x00") {
			id = value
		} else if name == "retry" && value != "" && strings.TrimLeft(value, "0123456789") == "" {
			let ms = strconv.Atoi(value) catch {
			case strconv.Malformed, strconv.OutOfRange:
				-1
			}
			if ms >= 0 {
				retry = Some[int]{Value: ms}
			}
		}
	}
	let partial = lines[len(lines)-1]
	let end = if fields || (partial != "" && !strings.HasPrefix(partial, ":")) { Some[Truncated]{Value: Truncated{Text: open + partial}} } else { None }
	(out, end, retry)
}
