// The client half: one buffered request to one origin. Effect HttpClient's
// purpose is a request that keeps its failures typed and that a test can
// replace; here Net is an operation type a context binds, the failure is
// a closed union and the caller's scope is the only time limit, so there
// is no service tag, layer, middleware chain or implicit timeout.

import config
import fs
import strings
import sync

// InvalidClient is an origin that is not scheme://authority (http or
// https), or a budget that is not positive.
extern go ergo.local/prototype/runtime/v1/http.HTTPInvalidClient type InvalidClient { Origin string, Reason string }

// The causes of a failed request. Refused: nothing accepted the
// connection. Transport: the exchange broke after it started, or the
// response was not HTTP. TooLarge: the response's header or body went
// over its budget. Malformed: the request cannot be sent (a method or
// header name that is not a token, a path without "/", a refused body).
type Refused { Reason string }
type Transport { Reason string }
type TooLarge { Limit int }
type Malformed { Reason string }
type Cause = Refused | Transport | TooLarge | Malformed
type RequestFailed { Cause Cause }

// Accept is the statuses whose body goes to a sink. AnySuccess is the
// default rule of every sink form (DoInto, DoFile, FetchInto, FetchFile):
// 200 to 299. Statuses accepts exactly its values.
type Accept = AnySuccess{} | Statuses{Values []int}

// Accepts is the one rule: whether a sink takes the body of a response
// with status.
func Accepts(a Accept, status int) bool {
	match a {
	case AnySuccess:
		status >= 200 && status < 300
	case Statuses as s:
		for v in s.Values {
			if v == status { return true }
		}
		false
	}
}

// StatusRefused is a final response whose status the caller does not
// accept: no part of its body reached the sink (and no file was made or
// replaced). Prefix is the first bytes of the body, at most 1024, for a
// message.
extern go ergo.local/prototype/runtime/v1/http.HTTPStatusRefused type StatusRefused { Status int, Prefix string }

// SinkFailed is a sink that refused a part of a body: the fetch stops
// there, lets its connection go, and fails with it.
extern go ergo.local/prototype/runtime/v1/http.HTTPSinkFailed type SinkFailed { Reason string }

// Net sends one request to its origin. A stop of the caller ends a call
// with the stop, after the exchange let go.
// law-exempt: a provider is a peer; the loopback model properties TestHTTPClientMatchesModel and TestHTTPFetchIntoMatchesModel hold Client's rules, and the law InMemorySendIntoIsSend holds Handler's.
type Net {
	// Send returns the whole response.
	Send(r Request) Response fails RequestFailed,
	// SendInto is Send, but when accept takes the status the body goes
	// to put while it arrives, a part at a time and in order, and the
	// returned Response has an empty Body. Any other status fails
	// StatusRefused and put gets nothing. put is the caller's and is used
	// only during the call. A failure of put, or a stop, ends the call
	// after the connection was let go.
	SendInto(r Request, accept Accept, put func(part string) fails SinkFailed) Response fails RequestFailed | StatusRefused | SinkFailed,
}

// Do sends r through the bound Net (Gleam httpc's send, Effect
// HttpClient.execute).
func Do(r Request) Response fails RequestFailed needs Net { try Net.Send(r) }

// DoInto sends r through the bound Net and gives a 2xx body to put as it
// arrives; another status fails StatusRefused. For another set of
// statuses, call Net.SendInto.
func DoInto(r Request, put func(part string) fails SinkFailed) Response fails RequestFailed | StatusRefused | SinkFailed needs Net {
	try Net.SendInto(r, AnySuccess, put)
}

// DoFile sends r through the bound Net and writes a 2xx body to the file
// at path below root, as FetchFile does. For another set of statuses,
// call IntoFile with Net.SendInto.
func DoFile(root fs.HostRoot, path string, r Request) Response fails RequestFailed | StatusRefused | SinkFailed | fs.NotFound | fs.Denied | fs.Failed | fs.Escapes needs Net {
	try IntoFile(root, path, func(file BodyFile) Response fails RequestFailed | StatusRefused | SinkFailed needs Net {
		try Net.SendInto(r, AnySuccess, func(part string) fails SinkFailed { try file.Put(part) })
	})
}

// Client is the host's Net for one origin. Its fields are this
// package's, so only NewClient makes one.
type Client { origin string, limits Limits, credentials []Credential } implements Net

// NewClient is a Net to origin (scheme://authority) whose responses have
// at most limits.MaxHeaderBytes of header and limits.MaxBodyBytes of body,
// and that sends each credential with every request, after the request's
// own header. A credential is the only way to give a Net a secret header:
// it stays Redacted inside the Client, so a provider wrapped around the
// Net never sees it. A credential of another origin is InvalidClient. No
// request is made until a Send.
func NewClient(origin string, limits Limits, credentials []Credential) Client fails InvalidClient | InvalidLimits needs Ambient {
	try checkOrigin(origin, limits)
	Client{origin: origin, limits: limits, credentials: try bound(origin, credentials)}
}

// bound is credentials when each is origin's, or InvalidClient naming the
// first that is not: a Net has one origin, and a credential goes only to
// its own.
func bound(origin string, credentials []Credential) []Credential fails InvalidClient {
	if len(credentials) == 0 {
		return credentials
	}
	let own = try originOf(origin)
	for c in credentials {
		if c.origin != own {
			return InvalidClient{Origin: origin, Reason: "a credential of " + c.origin + " is not this Net's"}
		}
	}
	credentials
}

// sent is header and then each credential's field: the header a Net's
// transport sends.
func sent(header []Field, credentials []Credential) []Field {
	let mut out = header
	for c in credentials {
		out = out.Append(revealed(c))
	}
	out
}

// Send joins r.Path and r.Query to the origin and sends r with the
// Client's credentials. Redirects are responses; there is no retry and no
// timeout of its own.
func Send(c Client, r Request) Response fails RequestFailed {
	let text = match r.Body {
	case Buffered as b:
		b.Text
	case BodyTooLarge, BodyReadFailed:
		return RequestFailed{Cause: Malformed{Reason: "a request sends a Buffered body"}}
	}
	send(c.origin, c.limits, r.Method, r.Path, r.RawPath, r.Query, sent(r.Header, c.credentials), text) catch {
	case SendFailed as f:
		return RequestFailed{Cause: causeOf(f.Kind, f.Reason, f.Limit)}
	}
}

// SendInto is Send with the body streamed to put (Net.SendInto). It
// shares the streamed exchange of Remote.SendURLInto.
func SendInto(c Client, r Request, accept Accept, put func(part string) fails SinkFailed) Response fails RequestFailed | StatusRefused | SinkFailed {
	let text = match r.Body {
	case Buffered as b:
		b.Text
	case BodyTooLarge, BodyReadFailed:
		return RequestFailed{Cause: Malformed{Reason: "a request sends a Buffered body"}}
	}
	try sendInto(c.origin, c.limits, r.Method, r.Path, r.RawPath, r.Query, sent(r.Header, c.credentials), text, func(status int) bool { Accepts(accept, status) }, put) catch {
	case SendFailed as f:
		return RequestFailed{Cause: causeOf(f.Kind, f.Reason, f.Limit)}
	}
}

extern go ergo.local/prototype/runtime/v1/http.HTTPDoInto func sendInto(origin string, limits Limits, method string, path string, rawPath string, query []Field, header []Field, body string, accepts func(status int) bool, put func(part string) fails SinkFailed) Response fails SendFailed | StatusRefused | SinkFailed

// SendFailed is the host's form of a RequestFailed: one record for the four
// causes (a Go type cannot be a union variant), which Send turns into the
// Cause; no other function fails with it. causeOf names: Kind 0 Refused, 1 Transport, 2 TooLarge, 3 Malformed.
extern go ergo.local/prototype/runtime/v1/http.HTTPSendFailed type SendFailed { Kind int, Reason string, Limit int }

func causeOf(kind int, reason string, limit int) Cause {
	if kind == 0 {
		Refused{Reason: reason}
	} else if kind == 1 {
		Transport{Reason: reason}
	} else if kind == 2 {
		TooLarge{Limit: limit}
	} else {
		Malformed{Reason: reason}
	}
}

extern go ergo.local/prototype/runtime/v1/http.HTTPDo func send(origin string, limits Limits, method string, path string, rawPath string, query []Field, header []Field, body string) Response fails SendFailed

// Handler is a Net with no socket: Send calls handle under a Recorder, as
// Serve would call it, and never fails. A test binds it so a client is
// checked against its server in memory.
type Handler { handle func(Request) Response needs Streaming, credentials []Credential } implements Net

// InMemory is a Net that answers with handle.
func InMemory(handle own func(Request) Response needs Streaming) Handler { Handler{handle: handle, credentials: []Credential{}} }

// InMemoryAt is a Net of origin that answers with handle and sends it each
// credential, as NewClient's Client sends them: handle reads the request's
// own header and then each credential's field. A credential of another
// origin is InvalidClient.
func InMemoryAt(origin string, credentials []Credential, handle own func(Request) Response needs Streaming) Handler fails InvalidClient {
	Handler{handle: handle, credentials: try bound(origin, credentials)}
}

// CredentialPassesUnseen: a Net wrapped around a Net that holds a
// credential (a recorder, a logger) sees, in the whole text of every
// request it forwards and every response and part it gets back, no byte
// of the secret, while the handler behind it reads the request's own
// header and then the credential's field, by Send and by SendInto. A
// credential of another origin is refused where the Net is made.
law CredentialPassesUnseen(secret string, header []Field, into bool) {
	let key = "key-" + secret
	let r = Request{Method: "GET", Path: "/", RawPath: "/", Query: []Field{}, Header: header, Body: Buffered{Text: ""}}
	if strings.Contains("\(r)", key) {
		return true
	}
	let c = ForOrigin("http://api.test", "X-Api-Key", config.NewRedacted(key)) catch {
	case InvalidClient:
		return false
	}
	let got = sync.NewRef[[]Field]([]Field{})
	let inner = InMemoryAt("http://api.test", []Credential{c}, func(q Request) Response needs Streaming {
		got.Set(q.Header)
		Response{Status: 200, Header: []Field{}, Body: "ok"}
	}) catch {
	case InvalidClient:
		return false
	}
	let w = watched{inner: inner, seen: sync.NewRef[string]("")}
	if into {
		let _ = w.SendInto(r, AnySuccess, func(part string) fails SinkFailed {}) catch {
		case RequestFailed, StatusRefused, SinkFailed:
			return false
		}
	} else {
		let _ = w.Send(r) catch {
		case RequestFailed:
			return false
		}
	}
	!strings.Contains(w.seen.Get(), key) && got.Get() == header.Append(Field{Name: "X-Api-Key", Value: key}) && refusesOther(c)
}

// watched is a Net around inner that keeps the text of every request it
// forwards and every response and part it gets back, as a recorder would.
type watched { inner Handler, seen sync.Ref[string] } implements Net

func Send(w watched, r Request) Response fails RequestFailed {
	w.seen.Update(func(s string) string { s + "\(r)" })
	let response = try w.inner.Send(r)
	w.seen.Update(func(s string) string { s + "\(response)" })
	response
}

func SendInto(w watched, r Request, accept Accept, put func(part string) fails SinkFailed) Response fails RequestFailed | StatusRefused | SinkFailed {
	w.seen.Update(func(s string) string { s + "\(r)" })
	let response = try w.inner.SendInto(r, accept, func(part string) fails SinkFailed {
		w.seen.Update(func(s string) string { s + part })
		try put(part)
	})
	w.seen.Update(func(s string) string { s + "\(response)" })
	response
}

// refusesOther is whether a Net of another origin refuses c.
func refusesOther(c Credential) bool {
	let _ = InMemoryAt("http://other.test", []Credential{c}, func(q Request) Response needs Streaming { Response{Status: 200, Header: []Field{}, Body: ""} }) catch {
	case InvalidClient:
		return true
	}
	false
}

// InMemorySendIntoIsSend: the in-memory Net's SendInto gives put exactly
// Send's body, and an empty Body back, when accept takes the status; any
// other status fails StatusRefused with the status and the body's first
// 1024 bytes, and put gets nothing. accept is the 2xx rule, or values
// with the status added when listed is odd.
law InMemorySendIntoIsSend(status int, body string, long bool, explicit bool, listed int, values []int) {
	let text = if long { strings.Repeat(body+"x", 1100) } else { body }
	let set = if listed%2 == 0 { values } else { values.Append(status) }
	let accept Accept = if explicit { Statuses{Values: set} } else { AnySuccess }
	let mut taken = !explicit && status >= 200 && status < 300
	for v in set {
		taken = taken || explicit && v == status
	}
	let h = InMemory(func(r Request) Response needs Streaming { Response{Status: status, Header: []Field{}, Body: text} })
	let got = sync.NewRef[string]("")
	let r = Request{Method: "GET", Path: "/", RawPath: "/", Query: []Field{}, Header: []Field{}, Body: Buffered{Text: ""}}
	let response = h.SendInto(r, accept, func(part string) fails SinkFailed { got.Update(func(s string) string { s + part }) }) catch {
	case StatusRefused as s:
		let want = if len(text) > 1024 { text[0:1024] } else { text }
		return !taken && s.Status == status && s.Prefix == want && got.Get() == ""
	case RequestFailed, SinkFailed:
		return false
	}
	taken && got.Get() == text && response.Status == status && response.Body == ""
}

func Send(h Handler, r Request) Response fails RequestFailed {
	with context { Streaming: NewRecorder() } { h.handle(Request{..r, Header: sent(r.Header, h.credentials)}) }
}

// SendInto answers as Send, then gives an accepted body to put in one
// part (none when it is empty).
func SendInto(h Handler, r Request, accept Accept, put func(part string) fails SinkFailed) Response fails RequestFailed | StatusRefused | SinkFailed {
	let response = with context { Streaming: NewRecorder() } { h.handle(Request{..r, Header: sent(r.Header, h.credentials)}) }
	if !Accepts(accept, response.Status) {
		return StatusRefused{Status: response.Status, Prefix: refusedPrefix(response.Body)}
	}
	if response.Body != "" {
		try put(response.Body)
	}
	Response{Status: response.Status, Header: response.Header, Body: ""}
}

// refusedPrefix is StatusRefused's Prefix of body: its first 1024 bytes.
func refusedPrefix(body string) string {
	if len(body) > 1024 { body[0:1024] } else { body }
}
