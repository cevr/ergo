// A Network delegates host authority once, then accepts runtime URLs under
// its policy. Both it and the fixed-origin Net stream a body to a sink
// under one status rule (Accept, client.ergo).

import fs
type OriginPolicy = AnyOrigin{} | Origins{Values []string}
type RedirectPolicy = NoRedirects{} | Follow{MaxHops int}
extern go ergo.local/prototype/runtime/v1.HTTPOriginRefused type OriginRefused { Origin string }
extern go ergo.local/prototype/runtime/v1.HTTPRedirectLimit type RedirectLimit { URL string, Limit int }

// Credential is a header bound to one origin. Only ForOrigin builds it.
type Credential { origin string, field Field }

func ForOrigin(origin string, field Field) Credential fails InvalidClient {
	let checked = checkNetwork([]string{origin}, Limits{MaxBodyBytes: 1, MaxHeaderBytes: 1, IdleTimeout: 1s, ReadHeaderTimeout: 1s, ReadBodyTimeout: 1s}) catch {
	case InvalidLimits:
		Unreachable("Origin uses positive limits")
	case InvalidClient as e:
		return e
	}
	Credential{origin: checked[0], field: field}
}

// URLRequest has one absolute http(s) URL. A marked credential is never a
// public Header: the transport adds it only at its own origin, at every hop.
type URLRequest { URL string, Method string, Header []Field, Credentials []Credential, Body string }

// law-exempt: policy, credential confinement and hop limits are checked by the two-peer model TestHTTPNetworkMatchesModel; interruption by TestHTTPNetworkStops; SendURLInto's parts and statuses by TestHTTPFetchIntoMatchesModel; the in-memory Local against a loopback Serve by TestHTTPLocalMatchesLoopback.
type Network {
	SendURL(r URLRequest) Response fails RequestFailed | OriginRefused | RedirectLimit,
	// SendURLInto is SendURL, but when accept takes the final response's
	// status its body goes to put while it arrives, a part at a time and
	// in order, and the returned Response has an empty Body. Any other
	// final status fails StatusRefused and put gets nothing. put is the
	// caller's and is used only during the call. Limits.MaxBodyBytes
	// bounds the bytes put is given: a body over it fails TooLarge,
	// before any part when its length is declared. A failure of put, or a
	// stop, ends the call after the connection was let go.
	SendURLInto(r URLRequest, accept Accept, put func(part string) fails SinkFailed) Response fails RequestFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed,
}

func Fetch(r URLRequest) Response fails RequestFailed | OriginRefused | RedirectLimit needs Network {
	try Network.SendURL(r)
}

// FetchInto sends r through the bound Network and gives a 2xx body to put
// as it arrives (Elixir Req's into:, Go's io.Copy from resp.Body); another
// final status fails StatusRefused. The body is consumed inside the call:
// no part stays to read after it. For another set of statuses, call
// Network.SendURLInto.
func FetchInto(r URLRequest, put func(part string) fails SinkFailed) Response fails RequestFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed needs Network {
	try Network.SendURLInto(r, AnySuccess, put)
}

// FetchFile sends r through the bound Network and writes a 2xx body to the
// file at path below root, which stays the caller's; another final status
// fails StatusRefused. The body goes to a new file beside path, made at
// its first part, which replaces path only when the whole body has
// arrived: a refused status, a failure, a body over its budget or a stop
// leaves no new file and path as it was. For another set of statuses,
// call IntoFile with Network.SendURLInto.
func FetchFile(root fs.HostRoot, path string, r URLRequest) Response fails RequestFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed | fs.NotFound | fs.Denied | fs.Failed | fs.Escapes needs Network {
	try IntoFile(root, path, func(file BodyFile) Response fails RequestFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed needs Network {
		try Network.SendURLInto(r, AnySuccess, func(part string) fails SinkFailed { try file.Put(part) })
	})
}

// BodyFile is the new file of one IntoFile: only IntoFile makes one, and
// it is valid only while the fetch it was given to runs.
// law-exempt: only IntoFile makes one; TestHTTPFetchIntoMatchesModel and TestHTTPFetchIntoStops hold its file.
extern go ergo.local/prototype/runtime/v1.BodyFile type BodyFile { Put(part string) fails SinkFailed, partOnly() }

// IntoFile runs fetch with the new file of path below root, which stays
// the caller's, and puts it in place of path when fetch succeeds. The new
// file is made beside path at its first Put (or at the end, for an empty
// body), so a fetch that puts nothing and fails touches no file; a fetch
// that fails, or a stop, leaves path as it was. FetchFile and DoFile are
// IntoFile with the 2xx rule.
extern go ergo.local/prototype/runtime/v1.HTTPIntoFile func IntoFile[F, R](root fs.HostRoot, path string, fetch func(file BodyFile) Response fails F needs R) Response fails F | fs.NotFound | fs.Denied | fs.Failed | fs.Escapes needs R

// Remote is a provider of Network. Only NewNet delegates Ambient to it.
type Remote { origins []string, anyOrigin bool, limits Limits, hops int }

func NewNet(policy OriginPolicy, limits Limits, redirects RedirectPolicy) Remote fails InvalidClient | InvalidLimits needs Ambient {
	let p = try policyOf(policy, limits, redirects)
	Remote{origins: p.origins, anyOrigin: p.anyOrigin, limits: p.limits, hops: p.hops}
}

// netPolicy is the checked policy of NewNet and InMemoryNetwork.
type netPolicy { origins []string, anyOrigin bool, limits Limits, hops int }

func policyOf(policy OriginPolicy, limits Limits, redirects RedirectPolicy) netPolicy fails InvalidClient | InvalidLimits {
	let hops = match redirects {
	case NoRedirects:
		-1
	case Follow as f:
		if f.MaxHops < 0 { return InvalidClient{Origin: "", Reason: "MaxHops must not be negative"} }
		f.MaxHops
	}
	let origins = match policy {
	case AnyOrigin:
		[]string{}
	case Origins as p:
		p.Values
	}
	let anyOrigin = match policy {
	case AnyOrigin:
		true
	case Origins:
		false
	}
	let checked = try checkNetwork(origins, limits)
	netPolicy{origins: checked, anyOrigin: anyOrigin, limits: limits, hops: hops}
}

extern go ergo.local/prototype/runtime/v1.HTTPCheckNetwork func checkNetwork(origins []string, limits Limits) []string fails InvalidClient | InvalidLimits

func SendURL(n Remote, r URLRequest) Response fails RequestFailed | OriginRefused | RedirectLimit {
	let mut owners = []string{}
	let mut fields = []Field{}
	for c in r.Credentials {
		owners = owners.Append(c.origin)
		fields = fields.Append(c.field)
	}
	try fetch(n.origins, n.anyOrigin, n.limits, n.hops, r.Method, r.URL, r.Header, owners, fields, r.Body) catch {
	case SendFailed as f:
		return RequestFailed{Cause: causeOf(f.Kind, f.Reason, f.Limit)}
	}
}

func SendURLInto(n Remote, r URLRequest, accept Accept, put func(part string) fails SinkFailed) Response fails RequestFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed {
	let mut owners = []string{}
	let mut fields = []Field{}
	for c in r.Credentials {
		owners = owners.Append(c.origin)
		fields = fields.Append(c.field)
	}
	try fetchInto(n.origins, n.anyOrigin, n.limits, n.hops, r.Method, r.URL, r.Header, owners, fields, r.Body, func(status int) bool { Accepts(accept, status) }, put) catch {
	case SendFailed as f:
		return RequestFailed{Cause: causeOf(f.Kind, f.Reason, f.Limit)}
	}
}

extern go ergo.local/prototype/runtime/v1.HTTPFetchInto func fetchInto(origins []string, anyOrigin bool, limits Limits, hops int, method string, url string, header []Field, owners []string, credentials []Field, body string, accepts func(status int) bool, put func(part string) fails SinkFailed) Response fails SendFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed

// Local is a Network with no socket: a test binds it so a client of many
// origins is checked against its servers in memory. Only InMemoryNetwork
// makes one.
type Local { net netPolicy, handle escaping func(origin string, r Request) Response needs Streaming }

// InMemoryNetwork is a Network that answers each exchange with handle,
// given the URL's origin (scheme://host[:port], as the policy reads it)
// and the request as Serve gives a handler: the decoded path, the parsed
// query, the header and a Buffered body. handle routes by the origin and
// the path; it runs on the caller's task, under a Recorder, as
// InMemory's does. Everything else is NewNet's: the origin policy, a
// credential only at its own origin, redirects and their hop limit, and
// the body budget. What a caller sees is what the same exchange gives
// through Serve on a loopback socket (runtime/v1
// TestHTTPLocalMatchesLoopback): no body for HEAD, 204 or 304, a 1xx
// status read as the 200 after it, and no header field that Go's
// transport adds (Date, Content-Length, Content-Type, User-Agent,
// Accept-Encoding). A status outside 100-999 fails Transport. It needs no
// Ambient: it reaches no host.
func InMemoryNetwork(policy OriginPolicy, limits Limits, redirects RedirectPolicy, handle escaping func(origin string, r Request) Response needs Streaming) Local fails InvalidClient | InvalidLimits {
	Local{net: try policyOf(policy, limits, redirects), handle: handle}
}

func SendURL(n Local, r URLRequest) Response fails RequestFailed | OriginRefused | RedirectLimit {
	let m = n.net
	try fetchLocal(m.origins, m.anyOrigin, m.limits, m.hops, r.Method, r.URL, r.Header, owners(r), credentials(r), r.Body, n.answerer()) catch {
	case SendFailed as f:
		return RequestFailed{Cause: causeOf(f.Kind, f.Reason, f.Limit)}
	}
}

func SendURLInto(n Local, r URLRequest, accept Accept, put func(part string) fails SinkFailed) Response fails RequestFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed {
	let m = n.net
	try fetchLocalInto(m.origins, m.anyOrigin, m.limits, m.hops, r.Method, r.URL, r.Header, owners(r), credentials(r), r.Body, func(status int) bool { Accepts(accept, status) }, put, n.answerer()) catch {
	case SendFailed as f:
		return RequestFailed{Cause: causeOf(f.Kind, f.Reason, f.Limit)}
	}
}

// answerer is n's handle as the runtime calls it: the request's parts made a
// Request, answered under a Recorder.
func answerer(n Local) func(origin string, method string, path string, query []Field, header []Field, body string) Response {
	let handle = n.handle
	func(origin string, method string, path string, query []Field, header []Field, body string) Response {
		with context { Streaming: NewRecorder() } {
			handle(origin, Request{Method: method, Path: path, Query: query, Header: header, Body: Buffered{Text: body}})
		}
	}
}

// owners and credentials are r's marked credentials, as two lists in one
// order: each credential's origin, and its field.
func owners(r URLRequest) []string {
	let mut out = []string{}
	for c in r.Credentials {
		out = out.Append(c.origin)
	}
	out
}

func credentials(r URLRequest) []Field {
	let mut out = []Field{}
	for c in r.Credentials {
		out = out.Append(c.field)
	}
	out
}

extern go ergo.local/prototype/runtime/v1.HTTPFetchLocal func fetchLocal[R](origins []string, anyOrigin bool, limits Limits, hops int, method string, url string, header []Field, owners []string, credentials []Field, body string, handle func(origin string, method string, path string, query []Field, header []Field, body string) Response needs R) Response fails SendFailed | OriginRefused | RedirectLimit needs R

extern go ergo.local/prototype/runtime/v1.HTTPFetchLocalInto func fetchLocalInto[R](origins []string, anyOrigin bool, limits Limits, hops int, method string, url string, header []Field, owners []string, credentials []Field, body string, accepts func(status int) bool, put func(part string) fails SinkFailed, handle func(origin string, method string, path string, query []Field, header []Field, body string) Response needs R) Response fails SendFailed | OriginRefused | RedirectLimit | StatusRefused | SinkFailed needs R

extern go ergo.local/prototype/runtime/v1.HTTPFetch func fetch(origins []string, anyOrigin bool, limits Limits, hops int, method string, url string, header []Field, owners []string, credentials []Field, body string) Response fails SendFailed | OriginRefused | RedirectLimit
