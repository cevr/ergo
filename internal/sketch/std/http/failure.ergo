import json
import option

type FailureStatus { Tag string, Status int }

func StatusOf(table []FailureStatus, tag string) option.Option[int] {
	let mut result option.Option[int] = option.None
	for entry in table {
		if entry.Tag == tag {
			if result != option.None || entry.Status < 400 || entry.Status > 599 {
				return option.None
			}
			result = option.Some{entry.Status}
		}
	}
	result
}

func Failure(table []FailureStatus, body string) Response fails Malformed {
	let r = json.Open(body, 0, 0) catch {
	case _:
		return Malformed{Reason: "HTTP failure body is not JSON"}
	}
	r.BeginObject() catch {
	case _:
		return Malformed{Reason: "HTTP failure body is not an object"}
	}
	let tag = r.Tag() catch {
	case _:
		return Malformed{Reason: "HTTP failure body has no tag"}
	}
	let status = match StatusOf(table, tag) {
	case option.Some as s:
		s.Value
	case option.None:
		return Malformed{Reason: "HTTP failure needs exactly one valid status: " + tag}
	}
	Response{Status: status, Header: []Field{Field{Name: "Content-Type", Value: "application/json"}}, Body: body}
}

law FailureUsesTable(pick int, tag string) {
	let status = 400 + ((pick%200)+200)%200
	let entry = FailureStatus{Tag: tag, Status: status}
	let other = FailureStatus{Tag: tag + "!", Status: if status == 400 { 599 } else { 400 }}
	let table = []FailureStatus{other, entry}
	let body = "{\"_tag\":" + json.Encode(json.Codec[string]{MaxBytes: 0, MaxDepth: 0}, tag) + "}"
	let response = Failure(table, body) catch {
	case Malformed:
		return false
	}
	let badJson = Failure(table, "{") catch {
	case Malformed:
		Response{Status: 0, Header: []Field{}, Body: ""}
	}
	let badObject = Failure(table, "1") catch {
	case Malformed:
		Response{Status: 0, Header: []Field{}, Body: ""}
	}
	let badTag = Failure(table, "{}") catch {
	case Malformed:
		Response{Status: 0, Header: []Field{}, Body: ""}
	}
	let badStatus = Failure([]FailureStatus{other}, body) catch {
	case Malformed:
		Response{Status: 0, Header: []Field{}, Body: ""}
	}
	response.Status == status && response.Body == body && Header(response.Header, "Content-Type") == option.Some{"application/json"} && badJson.Status == 0 && badObject.Status == 0 && badTag.Status == 0 && badStatus.Status == 0 && StatusOf([]FailureStatus{other}, tag) == option.None && StatusOf([]FailureStatus{entry, entry}, tag) == option.None && StatusOf([]FailureStatus{FailureStatus{Tag: tag, Status: 200}}, tag) == option.None && StatusOf([]FailureStatus{FailureStatus{Tag: tag, Status: 600}}, tag) == option.None
}
