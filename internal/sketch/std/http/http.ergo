// Package http serves buffered requests with ordinary function handlers.
// Effect HttpServer's purpose is a scoped server whose handlers keep their
// service requirements; here rows and child tasks supply those guarantees,
// without service tags, Effect values or middleware builders. Go net/http
// owns HTTP parsing and connections. Match is independent of the server.
// A handler that needs to send its body in parts uses Stream, through the
// Streaming capability Serve binds per request.

import net
import option
import os
import strings
import sync
import time
import utf8

extern go ergo.local/prototype/runtime/v1/http.HTTPListenFailed type ListenFailed { Addr string, Reason string }
extern go ergo.local/prototype/runtime/v1/http.HTTPInvalidLimits type InvalidLimits { MaxBodyBytes int, MaxHeaderBytes int, IdleTimeout duration, ReadHeaderTimeout duration, ReadBodyTimeout duration }

// Limits are shared by the server and client. Every field must be positive.
// Serve uses all five fields; NewClient and NewNet use only the byte budgets
// and leave time limits to the caller's scope. The timeouts bound how long Serve lets
// a connection stay in each read phase, on the program's Scheduler:
// IdleTimeout the wait for the next request on a kept-alive connection,
// ReadHeaderTimeout the header (from the accept, or from the next
// request's first byte), and ReadBodyTimeout the body.
extern go ergo.local/prototype/runtime/v1/http.HTTPLimits type Limits { MaxBodyBytes int, MaxHeaderBytes int, IdleTimeout duration, ReadHeaderTimeout duration, ReadBodyTimeout duration }

// Listen binds addr on the host's TCP for Serve. The listener is std net's
// net.Listener, the transport shared by server protocols; Close releases
// one that the program does not hand to Serve. Serve serves any
// net.Listener: one from Listen or net.Host, or a nettest.Pipe's, which a
// test dials in memory.
extern go ergo.local/prototype/runtime/v1/http.HTTPListen func Listen(addr string) net.Listener fails ListenFailed needs os.Ambient

// Field is one header or query pair. Repeated names keep all their values.
extern go ergo.local/prototype/runtime/v1/http.HTTPField type Field { Name string, Value string }
type Buffered { Text string }
type BodyTooLarge { Limit int }
type BodyReadFailed { Reason string }
type Body = Buffered | BodyTooLarge | BodyReadFailed
// Request is one HTTP request. Path is the decoded path and RawPath the
// escaped one, as it came ("/a%2Fb" for the Path "/a/b"), so a route may
// split RawPath on "/" and decode each segment with DecodePath. A client
// sends RawPath when it is an encoding of Path, and Path escaped otherwise.
type Request { Method string, Path string, RawPath string, Query []Field, Header []Field, Body Body }
extern go ergo.local/prototype/runtime/v1/http.HTTPResponse type Response { Status int, Header []Field, Body string }

// Header returns the first value of name, ignoring ASCII case. A missing
// name is None, distinct from a header with an empty value.
func Header(fields []Field, name string) option.Option[string] {
	for f in fields {
		if strings.EqualFold(f.Name, name) { return option.Some{f.Value} }
	}
	option.None
}

// Query returns the first query value with the exact name. DecodeQuery
// reads a typed record and refuses a scalar key given twice.
func Query(fields []Field, name string) option.Option[string] {
	for f in fields {
		if f.Name == name { return option.Some{f.Value} }
	}
	option.None
}

// DecodePath is the path raw escapes, decoded as Serve decodes a
// request's Path from its RawPath: "%XX" is the byte, and "+" stays "+".
// A "%" that two hex digits do not follow is BadEscape.
extern go ergo.local/prototype/runtime/v1/http.HTTPDecodePath func DecodePath(raw string) string fails BadEscape

// BadEscape is a path DecodePath cannot decode.
extern go ergo.local/prototype/runtime/v1/http.HTTPBadEscape type BadEscape { Raw string }

// Serve owns l until the calling task stops. Every handle invocation runs
// on a child task; a disconnect after a buffered read stops that child.
// A failed read still reaches the handler (a peer may have half-closed).
// Serve closes the
// listener and drains every child, including releases, before it ends.
// InvalidLimits leaves l open so the caller may retry or Close it.
// Body refusals reach handle as values; the program chooses their status.
// Each invocation runs with its request's Streaming provider bound, so a
// handler may answer with Stream; a handler that does not stays a
// function of a narrower row.
// The limits' timeouts are measured on the Scheduler, as timeout.After's
// deadline is, so a test Scheduler decides when a phase expires. An idle
// or header phase that expires closes the connection; a body phase that
// expires reaches handle as BodyReadFailed, and its answer is the
// connection's last.
func Serve[R](l net.Listener, limits Limits, handle own func(Request) Response needs R | Streaming) fails InvalidLimits needs R | time.Scheduler {
	return serve(l, limits, func(x Exchange, method string, path string, rawPath string, query []Field, header []Field, text string, tooLarge bool, readError string) Response needs R {
		let body Body = if tooLarge {
			BodyTooLarge{Limit: limits.MaxBodyBytes}
		} else if readError != "" {
			BodyReadFailed{Reason: readError}
		} else {
			Buffered{Text: text}
		}
		with context { Streaming: live{x: x} } {
			handle(Request{Method: method, Path: path, RawPath: rawPath, Query: query, Header: header, Body: body})
		}
	})
}

// The transport's scalar arguments become a closed body value above.
extern go ergo.local/prototype/runtime/v1/http.HTTPServe func serve[R](l net.Listener, limits Limits, handle own func(Exchange, string, string, string, []Field, []Field, string, bool, string) Response needs R) fails InvalidLimits needs R | time.Scheduler

// WriteFailed is a streamed write that did not reach the client: the
// connection refused it (the client went away), or its stream had ended.
extern go ergo.local/prototype/runtime/v1/http.HTTPWriteFailed type WriteFailed { Reason string }

// BodyWriter writes the parts of a streamed body. Only this package makes
// one; it is valid while the function Stream ran it with is running.
type BodyWriter { put func(text string) fails WriteFailed }

// Write sends text as the next part of the body. The live provider
// flushes it to the client before Write returns.
func Write(w BodyWriter, text string) fails WriteFailed { try w.put(text) }

// WriteAfterStreamFails: a BodyWriter kept past the function Stream ran
// fails WriteFailed, and the answer does not change.
law WriteAfterStreamFails(text string) {
	let kept = sync.NewRef[[]BodyWriter]([]BodyWriter{})
	let response = with context { Streaming: NewRecorder() } {
		Stream(200, []Field{}, func(w BodyWriter) fails WriteFailed {
			kept.Set([]BodyWriter{w})
		})
	}
	for w in kept.Get() {
		w.Write(text) catch {
		case WriteFailed:
			return response.Body == ""
		}
	}
	false
}

// Streaming is the response side of the request a handler answers: Serve
// binds one per request, and NewRecorder makes one for a test. Its
// operations are this package's; a program streams through Stream.
// law-exempt: its rules are Stream's, held by StreamIsItsWrites and WriteAfterStreamFails over a Recorder and by the runtime/v1 stream tests over Serve's provider.
type Streaming {
	open(status int, header []Field) BodyWriter,
	close() string,
	reply(status int, header []Field, body []byte) string,
}

// SendBytes answers the request with status, header and body, of body's
// length. Under Serve it writes body to the connection where it is, with
// no string of it, and the result's Body is empty; under a Recorder the
// Body is body's text. A response that has started (a Stream or a
// SendBytes before) is a defect. json.EncodeWith lends a value's text as
// bytes, so a JSON body is written once, into a pooled buffer (GX9).
func SendBytes(status int, header []Field, body []byte) Response needs Streaming {
	Response{Status: status, Header: header, Body: Streaming.reply(status, header, body)}
}

// Stream answers the request with status and header, then a body that
// write sends in parts (Effect HttpServerResponse.stream; Go's Flusher).
// status and header are sent before write starts, so they cannot depend
// on what it writes. Each Write is flushed. The BodyWriter closes when
// write returns: a later Write fails WriteFailed. A WriteFailed of write
// ends the stream; a client that goes away also stops the request task,
// so write ends at its next Write. A second Stream in one request is a
// defect. Under Serve the result's Body is empty, and Serve sends nothing
// more; under a Recorder it is every part written, in order.
func Stream[R](status int, header []Field, write func(w BodyWriter) fails WriteFailed needs R) Response needs R | Streaming {
	let w = Streaming.open(status, header)
	write(w) catch {
	case WriteFailed:
	}
	Response{Status: status, Header: header, Body: Streaming.close()}
}

// StreamIsItsWrites: Stream answers with its status and header, and its
// body is every part write wrote, in order (under a Recorder, which keeps
// what Serve's provider sends).
law StreamIsItsWrites(status int, parts []string) {
	let header = []Field{Field{Name: "Content-Type", Value: "text/plain"}}
	let response = with context { Streaming: NewRecorder() } {
		Stream(status, header, func(w BodyWriter) fails WriteFailed {
			for p in parts {
				try w.Write(p)
			}
		})
	}
	let mut want = ""
	for p in parts {
		want = want + p
	}
	response == Response{Status: status, Header: header, Body: want}
}

// Exchange is the response side of one served request on the host. Only
// Serve has one.
// law-exempt: only the transport makes one; the runtime/v1 stream tests hold its writes, its end and its hang-up.
extern go ergo.local/prototype/runtime/v1/http.Exchange type Exchange {
	runtimeOnly(),
	Begin(status int, header []Field),
	Write(text string) fails WriteFailed,
	End(),
	// Send writes status, header and body as the whole response, with its
	// length.
	Send(status int, header []Field, body []byte),
}

// live is Serve's Streaming provider for one request.
type live { x Exchange } implements Streaming

func open(l live, status int, header []Field) BodyWriter {
	l.x.Begin(status, header)
	BodyWriter{put: func(text string) fails WriteFailed { try l.x.Write(text) }}
}

func close(l live) string {
	l.x.End()
	""
}

func reply(l live, status int, header []Field, body []byte) string {
	l.x.Send(status, header, body)
	""
}

// Recorder is a Streaming provider for a test: Stream under it returns
// the parts written as a buffered Response, so a streaming handler is
// tested as a function, as a buffered one is.
type Recorder { text sync.Ref[string], state sync.Ref[int] } implements Streaming

// NewRecorder is a Recorder that has not started.
func NewRecorder() Recorder { Recorder{text: sync.NewRef[string](""), state: sync.NewRef[int](0)} }

// The Recorder's states: 0 not started, 1 streaming, 2 ended.
func open(r Recorder, status int, header []Field) BodyWriter {
	if r.state.Get() != 0 {
		Unreachable("http.Stream: the response has already started")
	}
	r.state.Set(1)
	BodyWriter{put: func(text string) fails WriteFailed {
		if r.state.Get() != 1 {
			return WriteFailed{Reason: "the stream has ended"}
		}
		r.text.Update(func(s string) string { s + text })
	}}
}

func close(r Recorder) string {
	r.state.Set(2)
	r.text.Get()
}

func reply(r Recorder, status int, header []Field, body []byte) string {
	if r.state.Get() != 0 {
		Unreachable("http.SendBytes: the response has already started")
	}
	r.state.Set(2)
	utf8.String(body)
}
