// Package file is a jobs.Queue kept in a file of the host, so its jobs
// outlive the process (docs/spec/stdlib.md, jobs). The file is a log of
// the operations that changed the queue, one line each, appended before
// any caller sees the outcome: Open replays them with jobs.Apply, which
// is a pure function of the policy, the state and the operation, so the
// replay reaches the state the queue had. A Reserve that found no job and
// ended no lease, and an ack or a fail of an Unknown ticket, change
// nothing and are not kept.
//
// The lines are tab-separated fields, each text quoted by strconv.Quote:
// `enq SEC NSEC "job"`, `res SEC NSEC`, `ack ID ATTEMPT SEC NSEC` and
// `fail ID ATTEMPT SEC NSEC "why"`, a job as the text its codec gives. A
// crash inside an append can leave a part of the last line: Open drops it
// and writes the log back without it. A whole line that is not an
// operation is a broken log, and Open fails naming it.
//
// One task at a time changes the queue: each operation takes the
// queue's lock (a queue.Queue of one slot), applies the operation to the
// state, and appends its line. A failed append leaves the state ahead of
// the log, so the queue refuses every later operation with Failed until
// it is opened again from its log. One process opens the file at a time.
// A Queue holds the file system it uses as values (rows.md, Context 2):
// a program gives Open its fs.Host, a test an fstest.Memory.
//
// Effect: PersistedQueue over a store the program picks. Go control: an
// append-only log of the operations, replayed at start.

import fs
import fstest
import jobs
import jobs/memory
import journal
import queue
import schedule
import strconv
import strings
import sync
import time

// Queue is the file queue of jobs of type J. Open makes one.
type Queue[J] {
	path   string,
	files  fs.Files,
	writes fs.Writes,
	codec  journal.Codec[J],
	policy jobs.Policy,
	state  sync.Ref[jobs.State[J]],
	broken sync.Ref[bool],
	lock   queue.Queue[int],
} implements jobs.Queue[J]

// Open is the queue of the log at path, read with files and written with
// writes, with policy p and the codec of its jobs: an empty queue when
// there is no file there yet. It fails when the log cannot be read, when
// a whole line of it is not an operation, when it cannot drop a cut last
// line, and when p's lease is not above zero.
func Open[J](files fs.Files, writes fs.Writes, path string, p jobs.Policy, codec journal.Codec[J]) Queue[J] fails jobs.Failed {
	let policy = jobs.Check(p) catch {
	case jobs.BadPolicy as b:
		return jobs.Failed{Reason: b.Reason}
	}
	let text = files.ReadFile(path) catch {
	case fs.NotFound:
		""
	case fs.Denied:
		return jobs.Failed{Reason: "\(path): permission denied"}
	case fs.Failed as f:
		return jobs.Failed{Reason: "\(path): \(f.Reason)"}
	}
	let mut s = jobs.Empty[J]()
	let mut n = 0
	let mut whole = 0
	for raw in strings.Lines(text) {
		if !strings.HasSuffix(raw, "\n") {
			break
		}
		n = n + 1
		let op = try opOf(path, n, strings.TrimSuffix(raw, "\n"), codec)
		let (_, next, _) = jobs.Apply(policy, s, op)
		s = next
		whole = whole + len(raw)
	}
	if whole < len(text) {
		writes.WriteFile(path, strings.Slice(text, 0, whole)) catch {
		case fs.NotFound:
			return jobs.Failed{Reason: "\(path): no such directory"}
		case fs.Denied:
			return jobs.Failed{Reason: "\(path): permission denied"}
		case fs.Failed as f:
			return jobs.Failed{Reason: "\(path): \(f.Reason)"}
		}
	}
	Queue[J]{path: path, files: files, writes: writes, codec: codec, policy: policy, state: sync.NewRef(s), broken: sync.NewRef(false), lock: queue.New[int](1)}
}

// apply runs op under the lock: it applies op to the state, and appends
// op's line when the state changed.
func applyStep[J, R](q Queue[J], line string, fn func(s jobs.State[J]) (R, jobs.State[J], bool)) R fails jobs.Failed {
	q.lock.Push(0) catch {
	case queue.Closed:
		Unreachable("the lock is never closed")
	}
	let o = stepWith(q, line, fn) catch {
	case jobs.Failed as f:
		unlock(q)
		return f
	}
	unlock(q)
	o
}

func apply[J](q Queue[J], op jobs.Op[J]) jobs.Outcome[J] fails jobs.Failed {
	let p = q.policy
	try applyStep(q, lineOf(op, q.codec), func(s jobs.State[J]) (jobs.Outcome[J], jobs.State[J], bool) {
		jobs.Apply(p, s, op)
	})
}

func unlock[J](q Queue[J]) {
	let _ = q.lock.Pop() catch {
	case queue.Closed:
		Unreachable("the lock is never closed")
	}
}

func stepWith[J, R](q Queue[J], line string, fn func(s jobs.State[J]) (R, jobs.State[J], bool)) R fails jobs.Failed {
	if q.broken.Get() {
		return jobs.Failed{Reason: "\(q.path): a write failed; open the queue again"}
	}
	let (o, changed) = sync.Modify(q.state, func(s jobs.State[J]) ((R, bool), jobs.State[J]) {
		let (o, next, changed) = fn(s)
		((o, changed), next)
	})
	if changed {
		q.writes.AppendFile(q.path, line) catch {
		case fs.NotFound:
			q.broken.Set(true)
			return jobs.Failed{Reason: "\(q.path): no such directory"}
		case fs.Denied:
			q.broken.Set(true)
			return jobs.Failed{Reason: "\(q.path): permission denied"}
		case fs.Failed as f:
			q.broken.Set(true)
			return jobs.Failed{Reason: "\(q.path): \(f.Reason)"}
		}
	}
	o
}

func EnqueueAt[J](q Queue[J], job J, at time.Time) int fails jobs.Failed {
	let line = lineOf(jobs.Enqueue[J]{Job: job, At: at}, q.codec)
	try applyStep(q, line, func(s jobs.State[J]) (int, jobs.State[J], bool) {
		let (id, next) = jobs.ApplyEnqueue(s, job, at)
		(id, next, true)
	})
}

func ReserveAt[J](q Queue[J], now time.Time) Option[jobs.Lease[J]] fails jobs.Failed {
	let p = q.policy
	let line = lineOf(jobs.Reserve{Now: now}, q.codec)
	try applyStep(q, line, func(s jobs.State[J]) (Option[jobs.Lease[J]], jobs.State[J], bool) {
		jobs.ApplyReserve(p, s, now)
	})
}

// AckAt ends the lease of t as done.
func AckAt[J](q Queue[J], t jobs.Ticket, now time.Time) fails jobs.Unknown | jobs.Failed {
	settle(try apply(q, jobs.Ack{Ticket: t, Now: now}))
}

// FailAt ends the lease of t as a failure.
func FailAt[J](q Queue[J], t jobs.Ticket, why string, now time.Time) fails jobs.Unknown | jobs.Failed {
	settle(try apply(q, jobs.Fail{Ticket: t, Why: why, Now: now}))
}

// settle is the failure of an ack's or a fail's outcome.
func settle[J](o jobs.Outcome[J]) fails jobs.Unknown {
	match o {
	case jobs.NotLeased as n:
		return jobs.Unknown{Ticket: n.Ticket}
	case _:
	}
}

// DeadLetters is the dead letters.
func DeadLetters[J](q Queue[J]) []jobs.Dead[J] fails jobs.Failed {
	sync.Modify(q.state, func(s jobs.State[J]) ([]jobs.Dead[J], jobs.State[J]) { (jobs.DeadOf(s), s) })
}

// Count is how many jobs are in each state.
func Count[J](q Queue[J]) jobs.Counts fails jobs.Failed {
	sync.Modify(q.state, func(s jobs.State[J]) (jobs.Counts, jobs.State[J]) { (jobs.CountOf(s), s) })
}

// Text is the codec of jobs that are text: each job is its own text.
type Text {} implements journal.Codec[string]

// Encode is job.
func Encode(_ Text, job string) string { job }

// Decode is text.
func Decode(_ Text, text string) string fails journal.Failed { text }

// script is one step of a FileIsMemory script: wait Wait milliseconds,
// then enqueue, reserve, ack or fail the Pick-th lease handed out, or
// open the file queue again.
type script = enqueueAt{Wait int} | reserveAt{Wait int} | ackAt{Pick int, Wait int} | failAt{Pick int, Wait int} | reopen{}

// FileIsMemory: a file queue answers a generated script of enqueues,
// reserves, acks, fails and reopens as a memory queue of the same policy
// does, outcome by outcome; and so does the queue a reopen gives after a
// crash cut its last append (torn, a part of a line with no line feed),
// also after one more enqueue and a reopen.
law FileIsMemory(steps []script, torn string) {
	let p = jobs.Policy{Retry: schedule.Recurs(2), Lease: 10ms}
	let disk = fstest.NewMemory()
	let want = try memory.New[string](p)
	let mut got = try Open(disk, disk, "jobs.log", p, Text)
	let mut now = time.Unix(0, 0)
	let mut n = 0
	let mut tickets = []jobs.Ticket{}
	for st in steps {
		match st {
		case enqueueAt as e:
			now = now.Add(time.Times(1ms, ((e.Wait%20)+20)%20))
			n = n + 1
			if try want.EnqueueAt("job \(n)\t\n", now) != try got.EnqueueAt("job \(n)\t\n", now) {
				return false
			}
		case reserveAt as r:
			now = now.Add(time.Times(1ms, ((r.Wait%20)+20)%20))
			let a = try want.ReserveAt(now)
			if a != try got.ReserveAt(now) {
				return false
			}
			match a {
			case Some[jobs.Lease[string]] as l:
				tickets = tickets.Append(l.Value.Ticket)
			case None:
			}
		case ackAt as a:
			now = now.Add(time.Times(1ms, ((a.Wait%20)+20)%20))
			let t = if len(tickets) == 0 { jobs.Ticket{ID: 0, Attempt: 0} } else { tickets[((a.Pick%len(tickets))+len(tickets))%len(tickets)] }
			if try acked(want, t, now) != try acked(got, t, now) {
				return false
			}
		case failAt as f:
			now = now.Add(time.Times(1ms, ((f.Wait%20)+20)%20))
			let t = if len(tickets) == 0 { jobs.Ticket{ID: 0, Attempt: 0} } else { tickets[((f.Pick%len(tickets))+len(tickets))%len(tickets)] }
			if try failed(want, t, now) != try failed(got, t, now) {
				return false
			}
		case reopen:
			got = try Open(disk, disk, "jobs.log", p, Text)
		}
	}
	if try got.Count() != try want.Count() || try got.DeadLetters() != try want.DeadLetters() {
		return false
	}
	try disk.AppendFile("jobs.log", "enq\t"+strings.ReplaceAll(torn, "\n", ""))
	let back = try Open(disk, disk, "jobs.log", p, Text)
	if try back.Count() != try want.Count() || try back.DeadLetters() != try want.DeadLetters() {
		return false
	}
	let _ = try back.EnqueueAt(torn, now)
	let _ = try want.EnqueueAt(torn, now)
	let again = try Open(disk, disk, "jobs.log", p, Text)
	try again.Count() == try want.Count() && try again.ReserveAt(now) == try want.ReserveAt(now)
}

// acked is whether q acked t at now, or found it Unknown.
func acked(q jobs.Queue[string], t jobs.Ticket, now time.Time) bool fails jobs.Failed {
	try q.AckAt(t, now) catch {
	case jobs.Unknown:
		return false
	}
	true
}

// failed is whether q failed t at now, or found it Unknown.
func failed(q jobs.Queue[string], t jobs.Ticket, now time.Time) bool fails jobs.Failed {
	try q.FailAt(t, "no", now) catch {
	case jobs.Unknown:
		return false
	}
	true
}

// OpenRefusesABrokenLine: a whole line that is not an operation, after
// good ones, makes Open fail.
law OpenRefusesABrokenLine(job string, line string) {
	let p = jobs.Policy{Retry: schedule.Forever(), Lease: 1s}
	let disk = fstest.NewMemory()
	let q = try Open(disk, disk, "jobs.log", p, Text)
	let _ = try q.EnqueueAt(job, time.Unix(0, 0))
	try disk.AppendFile("jobs.log", "x"+strings.ReplaceAll(line, "\n", "")+"\n")
	let _ = Open(disk, disk, "jobs.log", p, Text) catch {
	case jobs.Failed:
		return true
	}
	false
}

// timeText is the two fields of t.
func timeText(t time.Time) string { "\(time.UnixSeconds(t))\t\(time.Nanosecond(t))" }

// lineOf is the log line of op, with its line feed.
func lineOf[J](op jobs.Op[J], codec journal.Codec[J]) string {
	match op {
	case jobs.Enqueue[J] as e:
		"enq\t" + timeText(e.At) + "\t" + strconv.Quote(codec.Encode(e.Job)) + "\n"
	case jobs.Reserve as r:
		"res\t" + timeText(r.Now) + "\n"
	case jobs.Ack as a:
		"ack\t\(a.Ticket.ID)\t\(a.Ticket.Attempt)\t" + timeText(a.Now) + "\n"
	case jobs.Fail as f:
		"fail\t\(f.Ticket.ID)\t\(f.Ticket.Attempt)\t" + timeText(f.Now) + "\t" + strconv.Quote(f.Why) + "\n"
	}
}

// opOf is the operation of line, the n-th of the log at path.
func opOf[J](path string, n int, line string, codec journal.Codec[J]) jobs.Op[J] fails jobs.Failed {
	let f = strings.Split(line, "\t")
	let bad = jobs.Failed{Reason: "\(path):\(n): not an operation"}
	match (f[0], len(f)) {
	case ("enq", 4):
		let text = try unquote(f[3], bad)
		let job = codec.Decode(text) catch {
		case journal.Failed:
			return bad
		}
		jobs.Enqueue[J]{Job: job, At: try timeOf(f[1], f[2], bad)}
	case ("res", 3):
		jobs.Reserve{Now: try timeOf(f[1], f[2], bad)}
	case ("ack", 5):
		jobs.Ack{Ticket: jobs.Ticket{ID: try intOf(f[1], bad), Attempt: try intOf(f[2], bad)}, Now: try timeOf(f[3], f[4], bad)}
	case ("fail", 6):
		jobs.Fail{Ticket: jobs.Ticket{ID: try intOf(f[1], bad), Attempt: try intOf(f[2], bad)}, Why: try unquote(f[5], bad), Now: try timeOf(f[3], f[4], bad)}
	case (_, _):
		bad
	}
}

// intOf is the number of a field, or bad.
func intOf(field string, bad jobs.Failed) int fails jobs.Failed {
	strconv.Atoi(field) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return bad
	}
}

// timeOf is the time of two fields, or bad.
func timeOf(sec string, nsec string, bad jobs.Failed) time.Time fails jobs.Failed {
	time.Unix(int64(try intOf(sec, bad)), int64(try intOf(nsec, bad)))
}

// unquote is the text of a quoted field, or bad.
func unquote(field string, bad jobs.Failed) string fails jobs.Failed {
	strconv.Unquote(field) catch {
	case strconv.Malformed:
		return bad
	}
}
