import http
import mcp
import strings
import sync

// UnexpectedStatus is an HTTP transport rejection such as 401, 403, 404, 405, 406, 413, or 415.
type UnexpectedStatus { Status int, Body string }

// BadResponse is an HTTP response whose body or media type violates the MCP Streamable HTTP framing.
type BadResponse { Reason string }

// Client sends MCP JSON-RPC messages over an http.Net and tracks Mcp-Session-Id.
type Client {
	transport http.Net,
	path      string,
	headers   []http.Field,
	accept    string,
	session   sync.Ref[string],
}

// NewClient creates an MCP Streamable HTTP client posting to path over transport.
func NewClient(transport http.Net, path string) Client {
	NewClientWithHeaders(transport, path, []http.Field{})
}

// NewClientWithHeaders creates an MCP Streamable HTTP client that includes headers on each request.
func NewClientWithHeaders(transport http.Net, path string, headers []http.Field) Client {
	Client{
		transport: transport,
		path:      path,
		headers:   headers,
		accept:    "application/json, text/event-stream",
		session:   sync.NewRef[string](""),
	}
}

// NewSSEClient creates an MCP Streamable HTTP client requesting text/event-stream responses.
func NewSSEClient(transport http.Net, path string) Client {
	Client{
		transport: transport,
		path:      path,
		headers:   []http.Field{},
		accept:    "text/event-stream",
		session:   sync.NewRef[string](""),
	}
}

// SessionID returns the current Mcp-Session-Id tracked by c, or "" when none is active.
func SessionID(c Client) string { c.session.Get() }

// Call posts one JSON-RPC message (or batch) to c's endpoint.
// Notifications answered with 202 Accepted return None; JSON or SSE answers return Some.
func Call(c Client, message string) Option[string] fails http.RequestFailed | UnexpectedStatus | BadResponse {
	let mut hdr = []http.Field{
		http.Field{Name: "Content-Type", Value: "application/json"},
		http.Field{Name: "Accept", Value: c.accept},
		http.Field{Name: ProtocolVersionHeader, Value: mcp.Version},
	}
	let sid = c.session.Get()
	if sid != "" {
		hdr = hdr.Append(http.Field{Name: SessionHeader, Value: sid})
	}
	for f in c.headers {
		hdr = hdr.Append(f)
	}
	let req = http.Request{
		Method:  "POST",
		Path:    c.path,
		RawPath: c.path,
		Query:   []http.Field{},
		Header:  hdr,
		Body:    http.Buffered{Text: message},
	}
	let resp = try c.transport.Send(req)
	let returnedSession = headerValue(resp.Header, SessionHeader)
	if returnedSession != "" {
		c.session.Set(returnedSession)
	}
	if resp.Status == 202 {
		if resp.Body != "" {
			return BadResponse{Reason: "202 Accepted must have an empty body"}
		}
		return None
	}
	let ct = mediaTypeOf(headerValue(resp.Header, "Content-Type"))
	if resp.Status == 200 || (resp.Status == 400 && (ct == "application/json" || ct == "text/event-stream")) {
		if ct == "application/json" {
			return Some[string]{Value: resp.Body}
		}
		if ct == "text/event-stream" {
			let events = http.ReadEvents(resp.Body) catch {
			case http.Truncated:
				return BadResponse{Reason: "truncated event stream"}
			}
			if len(events) == 0 {
				return BadResponse{Reason: "empty event stream"}
			}
			if len(events) == 1 {
				return Some[string]{Value: events[0].Data}
			}
			let mut items = []string{}
			for e in events {
				items = items.Append(e.Data)
			}
			return Some[string]{Value: "[" + strings.Join(items, ",") + "]"}
		}
		return BadResponse{Reason: "unexpected Content-Type: " + ct}
	}
	UnexpectedStatus{Status: resp.Status, Body: resp.Body}
}

// Terminate sends DELETE to end the active session tracked by c and clears it locally.
func Terminate(c Client) fails http.RequestFailed | UnexpectedStatus | BadResponse {
	let mut hdr = []http.Field{http.Field{Name: ProtocolVersionHeader, Value: mcp.Version}}
	let sid = c.session.Get()
	if sid != "" {
		hdr = hdr.Append(http.Field{Name: SessionHeader, Value: sid})
	}
	for f in c.headers {
		hdr = hdr.Append(f)
	}
	let req = http.Request{
		Method:  "DELETE",
		Path:    c.path,
		RawPath: c.path,
		Query:   []http.Field{},
		Header:  hdr,
		Body:    http.Buffered{Text: ""},
	}
	let resp = try c.transport.Send(req)
	if resp.Status == 204 || resp.Status == 200 {
		c.session.Set("")
		return
	}
	UnexpectedStatus{Status: resp.Status, Body: resp.Body}
}
