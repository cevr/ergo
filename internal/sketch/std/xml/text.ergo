import codec
import strconv
import strings
import utf8

// Text is XML being written: the prelude's Writer events, so encode(v, t)
// writes any value, and the private parts the events are made of. Its one
// provider is text, so an encode on a Text a let binds by a cell of text
// calls text's functions directly, and the build joins constant bytes by
// the law RawJoins, which ergo test proves.
type Text {
	..codec.Writer,
	// Written is the text written so far.
	mut Written() string,

	// raw appends text as it is.
	mut raw(s string),
	// open writes the start tag of a value's element, and close the end
	// tag of the innermost element still open.
	mut open(name string),
	mut close(),
	// enter starts a value: in a list, its item element.
	mut enter(),
	// finish is the text written, and gives the buffer back (Encode
	// only: nothing may use the Text after).
	mut finish(hint int) string,

	law RawJoins(a string, b string) { raw(a); raw(b) } == { raw(a + b) },
}

// text is Text's provider. stack[0:depth] are the elements open,
// innermost last. The stack keeps its length past its top, so a
// document's writing allocates it once, or again only past eight deep.
type text { out []byte, stack []element, depth int } implements Text

// element is an element open: its name, whether it holds a list, whose
// values each take an item element, and end, the length of the text
// when its start tag was written (WireWrite adds an attribute to a start
// tag that nothing has followed yet). An object or a list is the
// content of the innermost element open when it begins, so that element
// says whether a value written next is a list's.
type element { name string, list bool, end int }

extern go append func appendString(out []byte, s string) []byte

extern go append func appendByte[T](out []T, b T) []T

func raw(t mut text, s string) { t.out = appendString(t.out, s) }

// push opens an element named name, whose start tag was written.
func push(t mut text, name string) {
	if t.depth < t.stack.Len() {
		t.stack[t.depth] = element{name: name, list: false, end: t.out.Len()}
	} else {
		t.stack = t.stack.Append(element{name: name, list: false, end: t.out.Len()})
	}
	t.depth = t.depth + 1
}

// nest starts an object (list false) or a list, the innermost element's
// content.
func nest(t mut text, list bool) {
	if t.depth > 0 {
		t.stack[t.depth-1].list = list
	}
}

// open writes <name>, or <_ key="name"> for a name that is not an XML
// name.
//
// For a constant name, the build folds Name(name) and unfolds open by its
// definition, so a record's key is one constant append, "<name>", that
// RawJoins joins with the text before it.
func open(t mut text, name string) {
	if Name(name) {
		t.raw("<")
		t.raw(name)
		t.raw(">")
		t.push(name)
	} else {
		t.other(name)
	}
}

// other opens an element for a name that is not an XML name.
func other(t mut text, name string) {
	t.raw("<_ key=\"")
	t.escape(name, true)
	t.raw("\">")
	t.push("_")
}

func close(t mut text) {
	if t.depth == 0 {
		return
	}
	t.depth = t.depth - 1
	t.raw("</")
	t.raw(t.stack[t.depth].name)
	t.raw(">")
}

func enter(t mut text) {
	if t.depth > 0 && t.stack[t.depth-1].list {
		t.raw("<item>")
		t.push("item")
	}
}

func Null(t mut text) {
	t.enter()
	t.raw("<null/>")
	t.close()
}

func Number(t mut text, text string) {
	t.enter()
	t.escape(text, false)
	t.close()
}

func Bool(t mut text, b bool) {
	t.enter()
	if b {
		t.raw("true")
	} else {
		t.raw("false")
	}
	t.close()
}

// Int, Uint and Float append the number to t.out in place with std
// strconv's appenders, as std json's writer does. (escape writes to t.out
// itself too: a function of this package given t.out and returning it
// would be given a copy, since t still holds the buffer.)
func Int(t mut text, n int64) {
	t.enter()
	t.out = strconv.AppendInt(t.out, n, 10)
	t.close()
}

func Uint(t mut text, n uint64) {
	t.enter()
	t.out = strconv.AppendUint(t.out, n, 10)
	t.close()
}

// escape writes s as character data: &, < and > as entities, a carriage
// return as &#xD; (a reader turns a line end into a line feed), and a
// character XML cannot hold as U+FFFD. In an attribute value (attr) it
// also writes ", a tab and a line feed as character references, which a
// reader keeps.
func escape(t mut text, s string, attr bool) {
	let mut from = 0
	let mut i = 0
	for i < s.Len() {
		let c = s[i]
		if c >= 0x20 && c < 0x80 && c != '&' && c != '<' && c != '>' && (c != '"' || !attr) {
			i = i + 1
			continue
		}
		let mut size = 1
		let mut rep = ""
		if c < 0x80 {
			if c == '&' {
				rep = "&amp;"
			} else if c == '<' {
				rep = "&lt;"
			} else if c == '>' {
				rep = "&gt;"
			} else if c == '\r' {
				rep = "&#xD;"
			} else if attr && c == '"' {
				rep = "&quot;"
			} else if attr && c == '\t' {
				rep = "&#x9;"
			} else if attr && c == '\n' {
				rep = "&#xA;"
			} else if c < 0x20 && c != '\t' && c != '\n' {
				rep = "\uFFFD"
			}
		} else {
			let d = utf8.DecodeRuneInString(strings.Slice(s, i, s.Len()))
			size = d.Size
			if d.Size <= 1 || !charRune(d.Rune) {
				rep = "\uFFFD"
			}
		}
		if rep != "" {
			t.out = appendString(t.out, strings.Slice(s, from, i))
			t.out = appendString(t.out, rep)
			from = i + size
		}
		i = i + size
	}
	t.out = appendString(t.out, strings.Slice(s, from, s.Len()))
}

// Float writes f's shortest spelling that reads back as f (Go's 'g', -1).
func Float(t mut text, f float64) {
	t.enter()
	t.out = strconv.AppendFloat(t.out, f, 'g', -1)
	t.close()
}

func String(t mut text, s string) {
	t.enter()
	t.escape(s, false)
	t.close()
}

// StringBytes writes the string whose bytes are b, as String does (the
// prelude Writer's StringBytes, GX10).
func StringBytes(t mut text, b []byte) { t.String(utf8.String(b)) }

func BeginList(t mut text, n int) {
	t.enter()
	t.nest(true)
}

func EndList(t mut text) {
	t.close()
}

func BeginObject(t mut text, n int) {
	t.enter()
	t.nest(false)
}

func EndObject(t mut text) {
	t.close()
}

// Tag writes a union's variant as the first child, <_tag>Name</_tag>.
func Tag(t mut text, name string) {
	t.raw("<_tag>")
	t.escape(name, false)
	t.raw("</_tag>")
}

func Key(t mut text, k string) { t.open(k) }

func Written(t mut text) string { strings.FromBytes(t.out) }

func finish(t mut text, hint int) string {
	let s = strings.FromBytes(t.out)
	t.out = strings.Give(t.out, hint)
	s
}

// Encode is v's XML: the element c.Root (root when it is empty) holding
// v's form. It is well formed for every v (OutputIsWellFormed): a
// character XML cannot hold is written as U+FFFD, as encoding/xml writes
// it. (Its Text's buffer is borrowed from std strings with T's size hint,
// as std json's Encode borrows its own.)
func Encode[T wire](c Codec[T], v T) string needs wired[T] {
	let hint = strings.Hint[text, T]()
	let t Text = text{out: strings.Borrow(hint), stack: emptyStack(), depth: 0}
	t.open(rootOf(c.Root))
	codec.Encode(v, t)
	t.finish(hint)
}

// emptyStack is a stack eight elements deep, the one allocation it
// takes for most documents.
func emptyStack() []element {
	let e = element{name: "", list: false, end: 0}
	[]element{e, e, e, e, e, e, e, e}
}

func rootOf(name string) string { if name == "" { "root" } else { name } }
