// Package schedule says when to try again and when to stop: the policy of
// a retry, a repeat or a restart budget (docs/spec/stdlib.md, Schedule;
// #179). Effect's Schedule is the reference for the intent. A Schedule
// here is a pure value, not an effect: Decide(s, runs, elapsed) is the whole
// of its meaning, a function of the runs so far and the time since the
// first began, so a test folds it with no clock, and tasks.Retry and
// tasks.Repeat read the time only through the context's one clock
// (runtime.md, Machines and actors 9.6).

import cron
import gen
import math
import option
import time
import tz

// Schedule is a policy. Build one with Spaced, Exponential, Recurs,
// Forever and Cron, and combine them with And, Or, UpTo and Jitter. Its variants
// are this package's own, so every Schedule is one these functions made.
type Schedule = spaced | exponential | recurs | upTo | jitter | both | either | cronAt

type spaced { every duration }

type exponential { base duration, factor float64, cap duration }

type recurs { times int }

type upTo { inner Schedule, limit duration }

type jitter { inner Schedule, low float64, high float64, seed uint64 }

type both { first Schedule, second Schedule }

type either { first Schedule, second Schedule }

type cronAt { expr cron.Expr, zone tz.Zone, start time.Time }

// Next is a schedule's decision after a run: run again after a delay, or
// stop.
type Next = Continue | Stop

// Continue: start the next run After this delay.
type Continue { After duration }

// Stop: start no more runs.
type Stop {}

// Spaced continues forever, every d after the run before ends (Effect
// spaced). A d below zero is zero, as Go's time.Sleep reads it.
func Spaced(d duration) Schedule { spaced{every: atLeastZero(d)} }

// Forever continues forever with no delay (Effect forever).
func Forever() Schedule { spaced{every: 0s} }

// Exponential continues forever; the delay after run n is base times
// factor to the power n-1, and never more than cap (Effect exponential,
// with the cap Go's backoff libraries add). A factor below 1 is 1; a base
// or cap below zero is zero.
func Exponential(base duration, factor float64, cap duration) Schedule {
	let f = if factor >= 1.0 { factor } else { 1.0 }
	exponential{base: atLeastZero(base), factor: f, cap: atLeastZero(cap)}
}

// ExponentialUnderCap: an exponential delay never exceeds its cap, and
// never falls from one run to the next.
law ExponentialUnderCap(base int64, cap int64, factor int64, runs int64) {
	let c = duration(within(cap, 0, 1000000000000))
	let s = Exponential(duration(within(base, 0, 1000000000000)), 1.0+float64(within(factor, 0, 40))/10.0, c)
	let r = int(within(runs, 1, 200))
	match (Decide(s, r, 0s), Decide(s, r+1, 0s)) {
	case (Continue as x, Continue as y):
		x.After <= c && x.After <= y.After
	case _:
		false
	}
}

// Recurs continues n times with no delay, then stops (Effect recurs): a
// retry by it runs at most n+1 times. An n below zero is zero.
func Recurs(n int) Schedule { recurs{times: if n > 0 { n } else { 0 }} }

// RecursStopsAfter: Recurs(k) continues with no delay after runs 1 to k
// and stops after run k+1, at any elapsed time.
law RecursStopsAfter(n int64, at int64) {
	let k = int(within(n, 0, 64))
	let e = duration(within(at, 0, 1000000000000))
	let s = Recurs(k)
	let mut ok = Decide(s, k+1, e) == Stop
	for runs in 1..k+1 {
		ok = ok && Decide(s, runs, e) == Continue{After: 0s}
	}
	ok
}

// within is n moved into lo..hi, so a law covers every n.
func within(n int64, lo int64, hi int64) int64 {
	let span = hi - lo + 1
	let r = n % span
	if r < 0 {
		lo + (r + span)
	} else {
		lo + r
	}
}

// UpTo is s, but it stops where s would start a run more than limit after
// the first run began (Effect upTo, which may still start one late; this
// one never does).
func UpTo(s Schedule, limit duration) Schedule { upTo{inner: s, limit: atLeastZero(limit)} }

// UpToNeverPassesLimit: UpTo(s, limit) never starts a run more than limit
// after the first began: a Continue's delay ends by limit.
law UpToNeverPassesLimit() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let s = gen.Named("schedule", showSchedule, func() Schedule needs gen.Draws { drawnSchedule(3) })
		let l = duration(int64(gen.Named("limitMs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 10000) })) * 1000000)
		let e = duration(int64(gen.Named("elapsedMs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 20000) })) * 1000000)
		let r = gen.Named("runs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(1, 20) })
		match Decide(UpTo(s, l), r, e) {
		case Continue as c:
			e+c.After <= l
		case Stop:
			true
		}
	})) == ""
	true
}

func showSchedule(s Schedule) string {
	match s {
	case spaced as p:
		"Spaced(\(int64(p.every) / 1000000)ms)"
	case exponential as e:
		"Exponential(\(int64(e.base) / 1000000)ms, \(e.factor), \(int64(e.cap) / 1000000)ms)"
	case recurs as r:
		"Recurs(\(r.times))"
	case upTo as u:
		"UpTo(\(showSchedule(u.inner)), \(int64(u.limit) / 1000000)ms)"
	case jitter as j:
		"Jitter(\(showSchedule(j.inner)), \(j.low), \(j.high), \(j.seed))"
	case both as b:
		"And(\(showSchedule(b.first)), \(showSchedule(b.second)))"
	case either as e:
		"Or(\(showSchedule(e.first)), \(showSchedule(e.second)))"
	case cronAt:
		"Cron(...)"
	}
}

func drawnSchedule(depth int) Schedule needs gen.Draws {
	let kinds = if depth > 0 { 8 } else { 4 }
	let kind = gen.IntIn(0, kinds-1)
	let d = duration(int64(gen.IntIn(0, 999)) * 1000000)
	match kind {
	case 0:
		Spaced(d)
	case 1:
		Exponential(d, 1.0+float64(gen.IntIn(0, 29))/10.0, duration(int64(gen.IntIn(0, 9999))*1000000))
	case 2:
		Recurs(gen.IntIn(0, 7))
	case 3:
		Forever()
	case 4:
		UpTo(drawnSchedule(depth-1), duration(int64(d)*10))
	case 5:
		Jitter(drawnSchedule(depth-1), float64(gen.IntIn(0, 19))/10.0, float64(gen.IntIn(0, 19))/10.0, gen.Below(uint64(0)))
	case 6:
		And(drawnSchedule(depth-1), drawnSchedule(depth-1))
	case _:
		Or(drawnSchedule(depth-1), drawnSchedule(depth-1))
	}
}

// Jitter is s with each delay scaled by a factor drawn from [low, high)
// (Effect jittered, 0.8 to 1.2 by default). The draw is a hash of seed and
// the run count, so the schedule stays a pure value: to keep many clients
// apart, give each its own seed (from Random). Each bound is moved into
// [0, 1000] (NaN is 0), and a high below low is low.
func Jitter(s Schedule, low float64, high float64, seed uint64) Schedule {
	let lo = factorIn(low)
	let hi = factorIn(high)
	jitter{inner: s, low: lo, high: if hi >= lo { hi } else { lo }, seed: seed}
}

// JitterInBounds: a jittered delay is the inner delay times a factor in
// [low, high], to within a nanosecond.
law JitterInBounds() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let d = duration(int64(gen.Named("everyMs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 1099511) })) * 1000000)
		let loStep = gen.Named("lowTenths", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 29) })
		let spanStep = gen.Named("spanTenths", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 29) })
		let low = float64(loStep) / 10.0
		let high = low + float64(spanStep)/10.0
		let r = gen.Named("runs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(1, 1000) })
		let s0 = gen.Below(uint64(0))
		match Decide(Jitter(Spaced(d), low, high, s0), r, 0s) {
		case Continue as c:
			let got = float64(int64(c.After))
			got >= float64(int64(d))*low-1.0 && got <= float64(int64(d))*high+1.0
		case Stop:
			false
		}
	})) == ""
	true
}

func factorIn(f float64) float64 {
	if f >= 1000.0 {
		return 1000.0
	}
	if f >= 0.0 { f } else { 0.0 }
}

// Cron continues at each firing of e in z (Effect's Schedule.cron):
// after a run, it waits until e's next firing after start plus the time
// elapsed, where start is the instant the first run began; it stops when e
// fires no more (cron.Next is None). The time stays an argument, so the
// schedule is still a pure value: tasks.Repeat(Cron(e, z, now), f) with
// now from the context's clock runs f at each firing.
func Cron(e cron.Expr, z tz.Zone, start time.Time) Schedule { cronAt{expr: e, zone: z, start: start} }

// CronWaitsForAFiring: after any run, Cron waits a positive time that
// ends at a minute e fires at, and no more than e's longest gap (three
// days for a weekday job).
law CronWaitsForAFiring(sec int64, wait int64, runs int) {
	let e = try cron.Parse("0 9 * * mon-fri")
	let start = time.Unix(within(sec, 0, 4102444800), 0)
	let elapsed = duration(within(wait, 0, 864000) * 1000000000)
	match Decide(Cron(e, tz.UTC(), start), runs, elapsed) {
	case Continue as c:
		let at = time.Add(time.Add(start, elapsed), c.After)
		c.After > 0s && c.After <= 72h && cron.Matches(e, tz.Civil(tz.UTC(), at)) && time.UnixSeconds(at)%60 == 0
	case Stop:
		false
	}
}

// And continues while both continue, after the longer of their delays
// (Effect intersect).
func And(a Schedule, b Schedule) Schedule { both{first: a, second: b} }

// AndIsMaxOrIsMin: And continues when both do, after the longer delay;
// Or continues when either does, after the shorter of those that continue.
law AndIsMaxOrIsMin() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let x = gen.Named("first", showSchedule, func() Schedule needs gen.Draws { drawnSchedule(2) })
		let y = gen.Named("second", showSchedule, func() Schedule needs gen.Draws { drawnSchedule(2) })
		let r = gen.Named("runs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(1, 20) })
		let e = duration(int64(gen.Named("elapsedMs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 20000) })) * 1000000)
		let both = Decide(And(x, y), r, e)
		let either = Decide(Or(x, y), r, e)
		match (Decide(x, r, e), Decide(y, r, e)) {
		case (Continue as p, Continue as q):
			let long = if p.After >= q.After { p.After } else { q.After }
			let short = if p.After <= q.After { p.After } else { q.After }
			both == Continue{After: long} && either == Continue{After: short}
		case (Continue as p, Stop):
			both == Stop && either == p
		case (Stop, Continue as q):
			both == Stop && either == q
		case (Stop, Stop):
			both == Stop && either == Stop
		}
	})) == ""
	true
}

// Or continues while either continues, after the shorter of the delays of
// those that continue (Effect union).
func Or(a Schedule, b Schedule) Schedule { either{first: a, second: b} }

// Decide is s's decision after runs runs (1 for the first), when elapsed
// has passed since the first run began. It reads nothing else: the same
// arguments give the same decision.
func Decide(s Schedule, runs int, elapsed duration) Next {
	match s {
	case spaced as p:
		Continue{After: p.every}
	case exponential as e:
		Continue{After: grow(e.base, e.factor, e.cap, runs)}
	case recurs as r:
		if runs <= r.times {
			return Continue{After: 0s}
		}
		Stop
	case upTo as u:
		match Decide(u.inner, runs, elapsed) {
		case Continue as c:
			if c.After > u.limit-elapsed {
				return Stop
			}
			c
		case Stop:
			Stop
		}
	case jitter as j:
		match Decide(j.inner, runs, elapsed) {
		case Continue as c:
			// No product is added to in float64, so no Go target can
			// fuse a multiply-add and round it another way.
			let span = j.high - j.low
			Continue{After: scale(c.After, j.low) + scale(c.After, span*unit(j.seed, runs))}
		case Stop:
			Stop
		}
	case both as b:
		match (Decide(b.first, runs, elapsed), Decide(b.second, runs, elapsed)) {
		case (Continue as x, Continue as y):
			if x.After >= y.After { x } else { y }
		case _:
			Stop
		}
	case cronAt as c:
		let now = time.Add(c.start, elapsed)
		match cron.Next(c.expr, c.zone, now) {
		case option.Some[time.Time] as n:
			Continue{After: time.Sub(n.Value, now)}
		case option.None:
			Stop
		}
	case either as e:
		match (Decide(e.first, runs, elapsed), Decide(e.second, runs, elapsed)) {
		case (Continue as x, Continue as y):
			if x.After <= y.After { x } else { y }
		case (Continue as x, Stop):
			x
		case (Stop, Continue as y):
			y
		case (Stop, Stop):
			Stop
		}
	}
}

// Timed is whether Decide(s, runs, elapsed) reads elapsed: whether s holds
// an UpTo or a Cron. A loop that runs by a schedule that is not timed
// needs no clock to decide (llm.Retry reads none then).
func Timed(s Schedule) bool {
	match s {
	case upTo, cronAt:
		true
	case spaced, exponential, recurs:
		false
	case jitter as j:
		Timed(j.inner)
	case both as b:
		Timed(b.first) || Timed(b.second)
	case either as e:
		Timed(e.first) || Timed(e.second)
	}
}

// UntimedIgnoresElapsed: a schedule that is not Timed decides the same at
// any elapsed time, so a loop that runs by it may pass any elapsed time.
law UntimedIgnoresElapsed() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let s = gen.Named("schedule", showSchedule, func() Schedule needs gen.Draws { drawnSchedule(3) })
		let r = gen.Named("runs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(1, 20) })
		let a = duration(int64(gen.Named("aMs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 20000) })) * 1000000)
		let b = duration(int64(gen.Named("bMs", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 20000) })) * 1000000)
		Timed(s) || Decide(s, r, a) == Decide(s, r, b)
	})) == ""
	true
}

// grow is base times factor to the power runs-1, saturated at cap; runs
// below 1 count as 1.
func grow(base duration, factor float64, cap duration, runs int) duration {
	if base == 0s {
		return 0s
	}
	let n = if runs > 1 { runs - 1 } else { 0 }
	let x = float64(int64(base)) * math.Pow(factor, float64(n))
	if x >= float64(int64(cap)) {
		return cap
	}
	duration(int64(x))
}

// scale is d times f, f of zero or more, saturated at 4.6e18 ns (about
// 146 years), so the sum of two scales fits a duration.
func scale(d duration, f float64) duration {
	let x = float64(int64(d)) * f
	if x >= 4.6e18 {
		return duration(int64(4600000000000000000))
	}
	duration(int64(x))
}

// unit is a draw in [0, 1) for run n of a jitter seeded by seed:
// SplitMix64 of seed+n, its top 53 bits.
func unit(seed uint64, n int) float64 {
	float64(mix(seed+uint64(n))>>11) / 9007199254740992.0
}

// mix is SplitMix64's output for the state x.
func mix(x uint64) uint64 {
	let mut z = x + 0x9e3779b97f4a7c15
	z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
	z = (z ^ (z >> 27)) * 0x94d049bb133111eb
	z ^ (z >> 31)
}

func atLeastZero(d duration) duration { if d > 0s { d } else { 0s } }
