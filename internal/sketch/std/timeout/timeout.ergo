import option
import queue
import task
import time

// Expired is the failure of a body that did not finish before its deadline.
extern go ergo.local/prototype/runtime/v1.Expired type Expired {}

// After runs f as a child task and fails with Expired when d passes first
// (docs/spec/runtime.md, Timeouts). It is an ordinary library function: a
// trailing block is its f argument, and its row parameters give the rows
// that the prototype gave timeout.After by name (README Gap 31). The host
// implements it: it is an extern go binding (grammar.md, Declarations 2).
// f is escaping because it runs on another task. In particular, lending a
// caller-owned resource here would also lend task-affine resources such as
// tasks.Set, whose operations must run on their owning task.
extern go ergo.local/prototype/runtime/v1.After func After[A own, E, R](d duration, f own func() A fails E needs R) A fails E | Expired needs R | time.Scheduler

// AfterKeepsWhatTheBodyTook: a value the body has taken is never lost to
// the deadline (RT-AFTERDROP). A producer pushes 0 to 39, one a
// millisecond, into a queue of capacity 0 to 2, and a consumer pops each
// under a deadline of 1 to 3 milliseconds, so the deadline and a push
// often fall on one instant. Every value reaches the consumer, in order:
// a body that has its value when After sees the deadline gives it.
law AfterKeepsWhatTheBodyTook(c int, w int) {
	let m = time.NewManual(0)
	with context { time.Scheduler: m } {
		let n = 40
		let q = queue.New[int](((c % 3) + 3) % 3)
		let kept = queue.New[int](n)
		let producer = task.Go() {
			for i in 0..n {
				time.Scheduler.Sleep(1ms)
				q.Push(i) catch {
				case queue.Closed:
				}
			}
			q.End()
		}
		let consumer = task.Go() {
			let mut done = false
			for !done {
				let v = After(time.Times(1ms, 1+((w%3)+3)%3)) { try q.Pop() } catch {
				case Expired:
					-1
				case queue.Closed:
					-2
				}
				if v == -2 {
					done = true
				} else if v >= 0 {
					kept.Push(v) catch {
					case queue.Closed:
					}
				}
			}
			kept.End()
		}
		for _ in 0..n+2 {
			m.Advance(1ms)
		}
		producer.Wait()
		consumer.Wait()
		let mut next = 0
		for v in kept.Values() {
			if v == next {
				next = next + 1
			}
		}
		next == n
	}
}

// The laws bind a time.Manual as the Scheduler: a law cannot hold Ambient,
// so it binds no host provider, and the deadline passes only when the law
// advances the Manual.

// QuickBodyWins: a body that ends before its deadline gives its value, and
// After does not fail Expired.
law QuickBodyWins(n int) {
	with context { time.Scheduler: time.NewManual(0) } {
		try After(1h) { n } == n
	}
}

// DeadlineFirstExpires: a body that is still waiting when the deadline
// passes is stopped, and After fails Expired. The body waits until the
// deadline's sleep is armed, then moves the time past it.
law DeadlineFirstExpires() {
	let m = time.NewManual(0)
	with context { time.Scheduler: m } {
		After(1ms) {
			for m.Sleepers() == 0 {
			}
			m.Advance(1ms)
			time.Scheduler.Sleep(1h)
			false
		} catch {
		case Expired:
			true
		}
	}
}

// PopWithin takes the value at the front of q, waiting up to d for one on
// the Scheduler (Go's select over a channel and a timer; Effect's
// Queue.take with a timeout). It fails Expired when d passes first, having
// taken nothing, and Closed when q is closed and empty. A value that is
// there now is taken with no deadline, so a burst arms no timer; a wait
// arms one Deadline, an alarm of the Scheduler with no task, and stops it
// before PopWithin returns. A value that enters at the deadline's instant
// is either taken or left in q, never lost. A d of zero or less never
// waits.
extern go ergo.local/prototype/runtime/v1.PopWithin func PopWithin[T](q queue.Queue[T], d duration) T fails queue.Closed | Expired needs time.Scheduler

// Deadline is one re-armable deadline on the Scheduler (Go's time.Timer
// with Reset): Arm arms one alarm of the Scheduler's AlarmClock, with no
// task and no sleep, and PopBefore waits on a queue until it fires. A
// value that comes first leaves it armed, so a loop that takes many values
// under one deadline arms it once (stream.Debounced arms one per window of
// d, not one per value). One task waits on a Deadline at a time.
// law-exempt: a member law has no Scheduler to arm on and no clock to move; its laws bind a time.Manual and run beside it (PopBeforeKeepsTheDeadline, and PopWithin's laws, which arm one).
extern go ergo.local/prototype/runtime/v1.Deadline type Deadline {
	runtimeOnly(),
	// Arm arms the deadline to fire once d has passed, replacing an
	// earlier arm and a fire PopBefore has not taken. A d of zero or less
	// fires at once.
	Arm(d duration),
	// Armed reports that Arm armed it and neither PopBefore took its fire
	// nor Stop disarmed it.
	Armed() bool,
	// Stop disarms it; it does nothing on a deadline that is not armed.
	Stop(),
}

// NewDeadline is a Deadline that is not armed, on the Scheduler's
// AlarmClock.
extern go ergo.local/prototype/runtime/v1.NewDeadline func NewDeadline() Deadline needs time.Scheduler

// PopBefore takes the value at the front of q, waiting for one until dl
// fires. It fails Expired when dl has fired, taking the fire, so dl is no
// longer armed; Closed when q is closed and empty. A value there now is
// taken first, even after the fire. On a deadline that is not armed it
// waits as Pop does.
extern go ergo.local/prototype/runtime/v1.PopBefore func PopBefore[T](q queue.Queue[T], dl Deadline) T fails queue.Closed | Expired

// PopWithinWaitsUpToD: a value pushed gap ms after the call is taken at
// gap when gap is less than d, and no deadline sleeps on after it; when d
// is less, PopWithin fails Expired at d and the value stays in the queue;
// at a tie, one of the two. A producer task and a consumer task run on a
// time.Manual, and the consumer records what PopWithin gave, when, and
// how many tasks sleep on the Manual then.
law PopWithinWaitsUpToD(g int, w int) {
	let m = time.NewManual(0)
	let gap = ((g % 60) + 60) % 60
	let d = ((w%59)+59)%59 + 1
	let start = m.Now()
	with context { time.Scheduler: m } {
		let q = queue.New[int](1)
		let got = queue.New[int](3)
		let producer = task.Go() {
			time.Scheduler.Sleep(time.Times(1ms, gap))
			q.Push(7) catch {
			case queue.Closed:
			}
		}
		let consumer = task.Go() {
			let v = PopWithin(q, time.Times(1ms, d)) catch {
			case Expired:
				-1
			case queue.Closed:
				-2
			}
			got.Push(v) catch {
			case queue.Closed:
			}
			got.Push(time.Count(m.Elapsed(start), 1ms)) catch {
			case queue.Closed:
			}
			got.Push(m.Sleepers()) catch {
			case queue.Closed:
			}
		}
		m.Advance(120ms)
		producer.Wait()
		consumer.Wait()
		let v = got.Poll()
		let at = got.Poll()
		let asleep = got.Poll()
		let took = v == option.Some[int]{Value: 7} && at == option.Some[int]{Value: gap} && q.Len() == 0 && asleep == option.Some[int]{Value: 0}
		let expired = v == option.Some[int]{Value: -1} && at == option.Some[int]{Value: d} && q.Len() == 1
		if gap < d {
			took
		} else if gap > d {
			expired
		} else {
			took || expired
		}
	}
}

// PopWithinTakesWhatIsThere: a value in the queue is taken at once, with
// no deadline, even for a d of zero; then the closed, empty queue fails
// Closed, not Expired.
law PopWithinTakesWhatIsThere(v int) {
	with context { time.Scheduler: time.NewManual(0) } {
		let q = queue.New[int](1)
		try q.Push(v)
		q.End()
		let first = try PopWithin(q, 0ns)
		let then = PopWithin(q, 0ns) catch {
		case queue.Closed:
			-1
		case Expired:
			-2
		}
		first == v && then == -1 && q.Len() == 0
	}
}

// PopBeforeKeepsTheDeadline: one Deadline, armed once for an odd D ms,
// bounds a loop of PopBefore while a producer pushes 0, 1, ... with even
// gaps: Armed reports it armed once Arm returns, the loop takes, in order,
// each value that arrives before D, then fails Expired at D with the
// deadline no longer armed, and the values that arrive later stay in the
// queue. A value taken does not move or disarm the deadline. The producer ends the queue long after D, so a
// deadline that never fires ends the loop by Closed, and the law is false.
law PopBeforeKeepsTheDeadline(gaps []int, w int) {
	let m = time.NewManual(0)
	let big = 2*(((w%30)+30)%30) + 1
	let n = gaps.Len()
	let start = m.Now()
	with context { time.Scheduler: m } {
		let q = queue.New[int](n + 1)
		let got = queue.New[int](n + 4)
		let producer = task.Go() {
			for i, g in gaps {
				time.Scheduler.Sleep(time.Times(1ms, 2*(((g%10)+10)%10)))
				q.Push(i) catch {
				case queue.Closed:
				}
			}
			time.Scheduler.Sleep(time.Times(1ms, 2*big))
			q.End()
		}
		let consumer = task.Go() {
			let dl = NewDeadline()
			dl.Arm(time.Times(1ms, big))
			got.Push(if dl.Armed() { 1 } else { 0 }) catch {
			case queue.Closed:
			}
			let mut open = true
			for open {
				let v = PopBefore(q, dl) catch {
				case Expired:
					-1
				case queue.Closed:
					-2
				}
				if v >= 0 {
					got.Push(v) catch {
					case queue.Closed:
					}
				} else {
					open = false
					got.Push(v) catch {
					case queue.Closed:
					}
					got.Push(time.Count(m.Elapsed(start), 1ms)) catch {
					case queue.Closed:
					}
					got.Push(if dl.Armed() { 1 } else { 0 }) catch {
					case queue.Closed:
					}
				}
			}
			got.End()
		}
		m.Advance(time.Times(1ms, 20*n+4*big+2))
		producer.Wait()
		consumer.Wait()
		let mut want = []int{1}
		let mut at = 0
		for i, g in gaps {
			at = at + 2*(((g%10)+10)%10)
			if at < big {
				want = want.Append(i)
			}
		}
		let left = n - (want.Len() - 1)
		want = want.Append(-1).Append(big).Append(0)
		let mut same = true
		let mut k = 0
		for v in got.Values() {
			same = same && k < want.Len() && v == want[k]
			k = k + 1
		}
		same && k == want.Len() && q.Len() == left
	}
}
