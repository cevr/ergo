import queue
import task
import time

// AfterKeepsWhatTheBodyTook: a value the body has taken is never lost to
// the deadline (RT-AFTERDROP). A producer pushes 0 to 39, one a
// millisecond, into a queue of capacity 0 to 2, and a consumer pops each
// under a deadline of 1 to 3 milliseconds, so the deadline and a push
// often fall on one instant. Every value reaches the consumer, in order:
// a body that has its value when After sees the deadline gives it.
law AfterKeepsWhatTheBodyTook(c int, w int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		let n = 40
		let q = queue.New[int](((c % 3) + 3) % 3)
		let kept = queue.New[int](n)
		let producer = task.Go() {
			for i in 0..n {
				Scheduler.Sleep(1ms)
				q.Push(i) catch {
				case queue.Closed:
				}
			}
			q.End()
		}
		let consumer = task.Go() {
			let mut done = false
			for !done {
				let v = After(time.Times(1ms, 1+((w%3)+3)%3)) { try q.Pop() } catch {
				case Expired:
					-1
				case queue.Closed:
					-2
				}
				if v == -2 {
					done = true
				} else if v >= 0 {
					kept.Push(v) catch {
					case queue.Closed:
					}
				}
			}
			kept.End()
		}
		for _ in 0..n+2 {
			m.Advance(1ms)
		}
		producer.Wait()
		consumer.Wait()
		let mut next = 0
		for v in kept.Values() {
			if v == next {
				next = next + 1
			}
		}
		next == n
	}
}
