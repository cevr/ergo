// The law of kv.Of over a memory store: a typed view keeps each value as
// its JSON text and gives it back.

import json
import kv

// note is a record of several wire kinds, for OfRoundTrips.
type note { Title string, Tags []string, N int }

// OfRoundTrips: a value put through kv.Of is the value Get gives back, a
// delete removes it, and a text that is not a note's JSON fails Get.
law OfRoundTrips(key string, title string, tags []string, n int) {
	let s = New()
	let notes = kv.Of[note](s)
	let x = note{Title: title, Tags: tags, N: n}
	try notes.Put(key, x)
	if try notes.Get(key) != (Some[note]{Value: x}) || !try notes.Delete(key) || try notes.Get(key) != None {
		return false
	}
	try s.Put(key, "{")
	let _ = notes.Get(key) catch {
	case json.Malformed:
		return true
	case kv.Failed, WireMissingField, WireWrongKind:
		return false
	}
	false
}
