import maps
import option
import slices
import strings

type FileLength { File int, Lines int }

type FileLengths { Files []FileLength, Work int }

func LongFile(f FileLength, max int) bool { f.Lines > max }

func PhysicalLines(r Rows, modules []int) FileLengths {
	let mut work = 0
	let mut chosen = Map[int, bool]{}
	for m in modules {
		chosen[m] = true
	}
	let mut places = []place{}
	let mut files = []FileLength{}
	for i, row in r.Nodes {
		work = work + 1
		let mut at = place{Package: -1, File: -1, Top: -1, Ordinary: true, InScope: false}
		if row.Parent >= 0 {
			at = if row.Parent < i { places[row.Parent] } else { placeOf(r, row.Parent, chosen) }
		}
		let here = placed(r, i, at, chosen)
		places = places.Append(here)
		if row.Kind == "file" && here.InScope {
			files = files.Append(FileLength{File: i, Lines: row.Lines})
		}
	}
	FileLengths{Files: files, Work: work}
}

law PhysicalLinesWorkIsLinear(seed int, size int) { physicalLinesWorkIsLinear(seed, size) }

func physicalLinesWorkIsLinear(seed int, size int) bool {
	let r = drawnRows(seed, size)
	let got = PhysicalLines(r, []int{0})
	for f in got.Files {
		if r.Nodes[f.File].Kind != "file" || f.Lines != r.Nodes[f.File].Lines {
			return false
		}
	}
	got.Work <= r.Nodes.Len()+1
}

type Directory { Path string, Members []string, Anchor int }

type DirectoryList { Directories []Directory, Work int }

func WideDirectory(d Directory, max int) bool { d.Members.Len() > max }

func childEntry(parts []string, k int) string { parts[k] }

func Directories(r Rows, modules []int) DirectoryList {
	let mut work = 0
	let mut chosen = Map[int, bool]{}
	for m in modules {
		chosen[m] = true
	}
	let mut places = []place{}
	let mut dirs = []string{}
	let mut members = Map[string, []string]{}
	let mut seen = Map[string, bool]{}
	let mut directAnchor = Map[string, int]{}
	let mut anyAnchor = Map[string, int]{}
	for i, row in r.Nodes {
		work = work + 1
		let mut at = place{Package: -1, File: -1, Top: -1, Ordinary: true, InScope: false}
		if row.Parent >= 0 {
			at = if row.Parent < i { places[row.Parent] } else { placeOf(r, row.Parent, chosen) }
		}
		let here = placed(r, i, at, chosen)
		places = places.Append(here)
		if row.Kind != "file" || !here.InScope || row.Name == "" {
			continue
		}
		let raw = strings.Split(row.Name, "/")
		let mut parts = []string{}
		for p in raw {
			if p != "" && p != "." {
				parts = parts.Append(p)
			}
		}
		for k in 0..parts.Len() {
			work = work + 1
			let dir = if k == 0 { "." } else { strings.Join(parts[0:k], "/") }
			let child = childEntry(parts, k)
			let key = dir + "\n" + child
			if seen.Get(key) == option.None {
				seen[key] = true
				if members.Get(dir) == option.None {
					dirs = dirs.Append(dir)
				}
				members[dir] = maps.GetOr(members, dir, []string{}).Append(child)
			}
			if k == parts.Len()-1 {
				match directAnchor.Get(dir) {
				case option.None:
					directAnchor[dir] = i
				case option.Some[int] as prev:
					if row.Name < r.Nodes[prev.Value].Name {
						directAnchor[dir] = i
					}
				}
			}
			match anyAnchor.Get(dir) {
			case option.None:
				anyAnchor[dir] = i
			case option.Some[int] as prev:
				if row.Name < r.Nodes[prev.Value].Name {
					anyAnchor[dir] = i
				}
			}
		}
	}
	let mut out = []Directory{}
	for d in slices.Sort(dirs) {
		let anchor = match directAnchor.Get(d) {
		case option.Some[int] as a:
			a.Value
		case option.None:
			maps.GetOr(anyAnchor, d, -1)
		}
		out = out.Append(Directory{Path: d, Members: slices.Sort(maps.GetOr(members, d, []string{})), Anchor: anchor})
	}
	DirectoryList{Directories: out, Work: work}
}

law DirectoriesWorkIsLinear(seed int, size int) { directoriesWorkIsLinear(seed, size) }

func directoriesWorkIsLinear(seed int, size int) bool {
	let r = drawnRows(seed, size)
	let got = Directories(r, []int{0})
	let mut parts = 0
	for n in r.Nodes {
		if n.Kind == "file" {
			parts = parts + strings.Split(n.Name, "/").Len()
		}
	}
	for d in got.Directories {
		if d.Anchor < 0 || r.Nodes[d.Anchor].Kind != "file" || d.Members.Len() == 0 {
			return false
		}
	}
	got.Work <= r.Nodes.Len()+parts+1
}

type ForeignFieldWrite {
	Field        int,
	Record       int,
	PrivateField int,
	Callers      []int,
	Sites        []int,
}

type ForeignFieldWrites { Writes []ForeignFieldWrite, Work int }

func isFieldWrite(how string) bool { how == "write" }

func hasPrivateField(priv Map[int, int], record int) bool { priv.Get(record) != option.None }

func ForeignRecordFieldWrites(r Rows, modules []int) ForeignFieldWrites {
	let mut work = 0
	let mut chosen = Map[int, bool]{}
	for m in modules {
		chosen[m] = true
	}
	let mut places = []place{}
	let mut privateField = Map[int, int]{}
	for i, row in r.Nodes {
		work = work + 1
		let mut at = place{Package: -1, File: -1, Top: -1, Ordinary: true, InScope: false}
		if row.Parent >= 0 {
			at = if row.Parent < i { places[row.Parent] } else { placeOf(r, row.Parent, chosen) }
		}
		places = places.Append(placed(r, i, at, chosen))
		if row.Kind == "decl" && row.Sub == "field" && row.Parent >= 0 && r.Nodes[row.Parent].Sub == "type" && !exported(row.Name) && privateField.Get(row.Parent) == option.None {
			privateField[row.Parent] = i
		}
	}
	let width = r.Nodes.Len()
	let mut fields = []int{}
	let mut callersOf = Map[int, []int]{}
	let mut firstSite = Map[int, int]{}
	for k, e in r.Edges {
		work = work + 1
		if e.Kind != "uses" || !isFieldWrite(e.How) || !places[e.From].Ordinary || !places[e.To].Ordinary {
			continue
		}
		let a = places[e.From]
		let b = places[e.To]
		if !a.InScope || !b.InScope || a.File < 0 || b.File < 0 || a.Package < 0 || b.Package < 0 || a.Package == b.Package {
			continue
		}
		let to = r.Nodes[e.To]
		if to.Kind != "decl" || to.Sub != "field" || !exported(to.Name) || to.Parent < 0 || r.Nodes[to.Parent].Sub != "type" {
			continue
		}
		if !hasPrivateField(privateField, to.Parent) {
			continue
		}
		let pair = e.To*width + e.From
		if firstSite.Get(pair) == option.None {
			firstSite[pair] = k
			if callersOf.Get(e.To) == option.None {
				fields = fields.Append(e.To)
			}
			callersOf[e.To] = maps.GetOr(callersOf, e.To, []int{}).Append(e.From)
		}
	}
	let mut out = []ForeignFieldWrite{}
	for f in slices.Sort(fields) {
		let callers = slices.Sort(maps.GetOr(callersOf, f, []int{}))
		let mut sites = []int{}
		for c in callers {
			sites = sites.Append(maps.GetOr(firstSite, f*width+c, -1))
		}
		let record = r.Nodes[f].Parent
		out = out.Append(ForeignFieldWrite{Field: f, Record: record, PrivateField: maps.GetOr(privateField, record, -1), Callers: callers, Sites: sites})
	}
	ForeignFieldWrites{Writes: out, Work: work}
}

law ForeignRecordFieldWritesWorkIsLinear(seed int, size int) { foreignRecordFieldWritesWorkIsLinear(seed, size) }

func foreignRecordFieldWritesWorkIsLinear(seed int, size int) bool {
	let r = drawnRows(seed, size)
	let got = ForeignRecordFieldWrites(r, []int{0})
	for w in got.Writes {
		if r.Nodes[w.Field].Sub != "field" || r.Nodes[w.Record].Sub != "type" || w.PrivateField < 0 || w.Callers.Len() == 0 || w.Callers.Len() != w.Sites.Len() {
			return false
		}
	}
	got.Work <= r.Nodes.Len()+r.Edges.Len()+1
}
