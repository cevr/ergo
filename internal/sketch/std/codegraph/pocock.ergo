import maps
import option
import slices
import strings

type SupportEntry { Package string, Seam string }

type TestSupportUse {
	Caller int,
	Target int,
	Site   int,
	Import int,
}

type TestSupportUses { Uses []TestSupportUse, Work int }

func callerExempt(ord bool, fileHasTest bool) bool { !ord }

func supportAllowed(callerSeams []string, targetSeams []string) bool {
	if callerSeams.Len() == 0 {
		return false
	}
	for ts in targetSeams {
		if ts == "" || slices.Contains(callerSeams, ts) {
			return true
		}
	}
	false
}

func ProductionUsesTestSupport(r Rows, modules []int, support []SupportEntry) TestSupportUses {
	if support.Len() == 0 {
		return TestSupportUses{Uses: []TestSupportUse{}, Work: 0}
	}
	let mut work = 0
	let mut chosen = Map[int, bool]{}
	for m in modules {
		chosen[m] = true
	}
	let mut supportSeams = Map[string, []string]{}
	for s in support {
		work = work + 1
		let cur = maps.GetOr(supportSeams, s.Package, []string{})
		if !slices.Contains(cur, s.Seam) {
			supportSeams[s.Package] = cur.Append(s.Seam)
		}
	}
	let mut places = []place{}
	let mut fileHasTest = Map[int, bool]{}
	for i, row in r.Nodes {
		work = work + 1
		let mut at = place{Package: -1, File: -1, Top: -1, Ordinary: true, InScope: false}
		if row.Parent >= 0 {
			at = if row.Parent < i { places[row.Parent] } else { placeOf(r, row.Parent, chosen) }
		}
		let here = placed(r, i, at, chosen)
		places = places.Append(here)
		if (row.Sub == "test" || row.Sub == "law") && here.File >= 0 {
			fileHasTest[here.File] = true
		}
	}
	let width = r.Nodes.Len()
	let mut importSite = Map[int, int]{}
	for k, e in r.Edges {
		work = work + 1
		if e.Kind == "imports" {
			let key = e.From*width + e.To
			if importSite.Get(key) == option.None {
				importSite[key] = k
			}
		}
	}
	let mut pairs = []int{}
	let mut firstSite = Map[int, int]{}
	for k, e in r.Edges {
		work = work + 1
		if e.Kind != "uses" {
			continue
		}
		let a = places[e.From]
		let b = places[e.To]
		if !a.InScope || a.Package < 0 || b.Package < 0 || a.Package == b.Package || a.File < 0 {
			continue
		}
		let targetPkg = r.Nodes[b.Package].Name
		let tSeams = maps.GetOr(supportSeams, targetPkg, []string{})
		if tSeams.Len() == 0 {
			continue
		}
		if callerExempt(a.Ordinary, fileHasTest.Get(a.File) != option.None) {
			continue
		}
		let callerPkg = r.Nodes[a.Package].Name
		if supportAllowed(maps.GetOr(supportSeams, callerPkg, []string{}), tSeams) {
			continue
		}
		let pair = e.From*width + b.Package
		if firstSite.Get(pair) == option.None {
			firstSite[pair] = k
			pairs = pairs.Append(pair)
		}
	}
	let mut out = []TestSupportUse{}
	for pair in slices.Sort(pairs) {
		let caller = pair / width
		let target = pair % width
		let imp = maps.GetOr(importSite, places[caller].File*width+target, -1)
		out = out.Append(TestSupportUse{Caller: caller, Target: target, Site: maps.GetOr(firstSite, pair, -1), Import: imp})
	}
	TestSupportUses{Uses: out, Work: work}
}

law ProductionUsesTestSupportWorkIsLinear(seed int, size int) { productionUsesTestSupportWorkIsLinear(seed, size) }

func productionUsesTestSupportWorkIsLinear(seed int, size int) bool {
	let r = drawnRows(seed, size)
	let got = ProductionUsesTestSupport(r, []int{0}, []SupportEntry{SupportEntry{Package: "m/p0", Seam: ""}})
	for u in got.Uses {
		if r.Nodes[u.Target].Name != "m/p0" || u.Site < 0 {
			return false
		}
	}
	got.Work <= r.Nodes.Len()+2*r.Edges.Len()+4
}

type SeamSpec {
	Root               string,
	Packages           []string,
	Entries            []string,
	TestSupport        []string,
	TestThroughEntries bool,
}

type SeamViolation {
	Seam      int,
	Import    int,
	File      int,
	CallerPkg int,
	TargetPkg int,
	Inside    bool,
	TestSites []int,
}

type SeamViolations { Violations []SeamViolation, Work int }

func inSeam(pkg string, s SeamSpec) bool {
	slices.Contains(s.Packages, pkg) || (s.Root != "" && (pkg == s.Root || strings.HasPrefix(pkg, s.Root+"/")))
}

func insideTestViolates(hasTest bool, hasOrdinary bool) bool { hasTest }

func roleOf(r Rows, i int, roles []string) string {
	let row = r.Nodes[i]
	if row.Sub == "test" {
		return "test"
	}
	if row.Sub == "law" {
		return "law"
	}
	if row.Parent < 0 {
		return "ordinary"
	}
	if row.Parent < i {
		return roles[row.Parent]
	}
	let mut n = row.Parent
	let mut steps = 0
	for n >= 0 && steps <= r.Nodes.Len() {
		if r.Nodes[n].Sub == "test" {
			return "test"
		}
		if r.Nodes[n].Sub == "law" {
			return "law"
		}
		n = r.Nodes[n].Parent
		steps = steps + 1
	}
	"ordinary"
}

func SeamEntrypoints(r Rows, modules []int, seams []SeamSpec) SeamViolations {
	if seams.Len() == 0 {
		return SeamViolations{Violations: []SeamViolation{}, Work: 0}
	}
	let mut work = 0
	let mut chosen = Map[int, bool]{}
	for m in modules {
		chosen[m] = true
	}
	let mut places = []place{}
	let mut roles = []string{}
	for i, row in r.Nodes {
		work = work + 1
		let mut at = place{Package: -1, File: -1, Top: -1, Ordinary: true, InScope: false}
		if row.Parent >= 0 {
			at = if row.Parent < i { places[row.Parent] } else { placeOf(r, row.Parent, chosen) }
		}
		places = places.Append(placed(r, i, at, chosen))
		roles = roles.Append(roleOf(r, i, roles))
	}
	let width = r.Nodes.Len()
	let mut hasOrdinary = Map[int, bool]{}
	let mut hasTestOrLaw = Map[int, bool]{}
	let mut testSites = Map[int, []int]{}
	for k, e in r.Edges {
		work = work + 1
		if e.Kind != "uses" {
			continue
		}
		let a = places[e.From]
		let b = places[e.To]
		if !a.InScope || a.File < 0 || b.Package < 0 {
			continue
		}
		let key = a.File*width + b.Package
		match roles[e.From] {
		case "test":
			hasTestOrLaw[key] = true
			testSites[key] = maps.GetOr(testSites, key, []int{}).Append(k)
		case "law":
			hasTestOrLaw[key] = true
		case _:
			hasOrdinary[key] = true
		}
	}
	let mut out = []SeamViolation{}
	for k, e in r.Edges {
		work = work + 1
		if e.Kind != "imports" {
			continue
		}
		let a = places[e.From]
		let b = places[e.To]
		if !a.InScope || !b.InScope || a.Package < 0 {
			continue
		}
		let callerName = r.Nodes[a.Package].Name
		let targetName = r.Nodes[e.To].Name
		let key = e.From*width + e.To
		let ord = hasOrdinary.Get(key) != option.None
		let tl = hasTestOrLaw.Get(key) != option.None
		let testOnly = tl && !ord
		let tSites = maps.GetOr(testSites, key, []int{})
		for si, seam in seams {
			work = work + 1
			if !inSeam(targetName, seam) || slices.Contains(seam.Entries, targetName) {
				continue
			}
			let fromInside = inSeam(callerName, seam)
			let allowedSupport = slices.Contains(seam.TestSupport, targetName)
			if !fromInside {
				if !(allowedSupport && testOnly) {
					out = out.Append(SeamViolation{Seam: si, Import: k, File: e.From, CallerPkg: a.Package, TargetPkg: e.To, Inside: false, TestSites: tSites})
				}
			} else if seam.TestThroughEntries && !allowedSupport && insideTestViolates(tSites.Len() > 0, ord) {
				out = out.Append(SeamViolation{Seam: si, Import: k, File: e.From, CallerPkg: a.Package, TargetPkg: e.To, Inside: true, TestSites: tSites})
			}
		}
	}
	SeamViolations{Violations: out, Work: work}
}

law SeamEntrypointsWorkIsLinear(seed int, size int) { seamEntrypointsWorkIsLinear(seed, size) }

func seamEntrypointsWorkIsLinear(seed int, size int) bool {
	let r = drawnRows(seed, size)
	let seam = SeamSpec{Root: "m", Packages: []string{}, Entries: []string{"m/p0"}, TestSupport: []string{}, TestThroughEntries: true}
	let got = SeamEntrypoints(r, []int{0}, []SeamSpec{seam})
	for v in got.Violations {
		if r.Nodes[v.TargetPkg].Name == "m/p0" || v.Import < 0 {
			return false
		}
	}
	got.Work <= r.Nodes.Len()+3*r.Edges.Len()+4
}
