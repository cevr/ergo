let adlerMod uint32 = uint32(65521)
let adlerNMax = 5552

// UpdateAdler32 updates a running RFC 1950 Adler-32 checksum with data.
func UpdateAdler32(sum uint32, data []byte) uint32 {
	let mut s1 = sum & uint32(65535)
	let mut s2 = (sum >> uint32(16)) & uint32(65535)
	let n = data.Len()
	let mut i = 0
	for i < n {
		let mut end = i + adlerNMax
		if end > n {
			end = n
		}
		for i < end {
			s1 = s1 + uint32(data[i])
			s2 = s2 + s1
			i = i + 1
		}
		s1 = s1 % adlerMod
		s2 = s2 % adlerMod
	}
	(s2 << uint32(16)) | s1
}

// Adler32 computes the RFC 1950 Adler-32 checksum of data.
func Adler32(data []byte) uint32 {
	UpdateAdler32(uint32(1), data)
}
