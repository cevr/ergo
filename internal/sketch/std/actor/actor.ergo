// Package actor runs a machine live, as an actor: one task of its own that
// steps the machine over the signals of an inbox, one at a time
// (docs/spec/runtime.md, Machines and actors 6, 7 and 11; #57, #101). The
// pure fold of the same machine is std machines; machines.RunTimed is the
// reference this runner keeps (rule 10 of the runner contract). The Go body
// is runtime/v1's MachineStart and the methods of its Actor; the caller's
// task and Scheduler are hidden arguments (docs/spec/stdlib.md, Hidden
// arguments).
//
// Effect: effect-machine's Machine.spawn and its actor ref (send, call,
// waitFor, subscribe, stop); Erlang gen_statem run by its process. Go
// control: a goroutine with a channel and a switch on the state.

import machines
import schedule
import tasks
import time
import sync
import testing

// Stopped is the failure of Send and Ask on an actor that has ended (Done,
// a failure after a Send or a timer, a defect, Stop) or whose Stop was
// requested, and the answer of an Ask that was queued or in a step when
// the actor ended. An ended actor is a normal end of the protocol, not a
// stop of the caller.
extern go ergo.local/prototype/runtime/v1.ActorStopped type Stopped {}

// RejectKeepsState: an Ask that the step rejects answers Reject and keeps
// the state.
law RejectKeepsState(signals []int, n int) {
	with context { Scheduler: time.NewManual(0) } {
		rejectKeeps(signals, n)
	}
}

// sent is a tally actor that was sent signals; a Send after a Done fails
// Stopped, which it ignores.
func sent(signals []int) Actor[int, int, Decision[int, int]] needs Scheduler {
	let a = StartMachine(tally(), 1, func(o int) {})
	for e in signals {
		a.Send(e) catch {
		case Stopped:
		}
	}
	a
}

// rejectKeeps: an Ask of a rejected signal answers Reject and keeps the
// state.
func rejectKeeps(signals []int, n int) bool needs Scheduler {
	let a = sent(signals)
	let before = a.State()
	let (_, done) = folded(signals)
	let d = a.Ask(6*(n%1000) + 3) catch {
	case Stopped:
		a.Stop()
		return done
	}
	let after = a.State()
	a.Stop()
	match d {
	case Reject:
		after == before && !done
	case _:
		false
	}
}

// DoneIsFinal: after an Ask answered Done, the actor steps nothing: Send
// fails Stopped, and State stays the state the Done saw.
law DoneIsFinal(signals []int, e int) {
	with context { Scheduler: time.NewManual(0) } {
		doneFinal(signals, e)
	}
}

// doneFinal: after an Ask answered Done, Send fails Stopped and State is
// the state the Done saw.
func doneFinal(signals []int, e int) bool needs Scheduler {
	let a = sent(signals)
	let before = a.State()
	let d = a.Ask(5) catch {
	case Stopped:
		a.Stop()
		return true
	}
	let mut final = false
	match d {
	case Done[int] as dn:
		final = dn.Output == before
	case _:
	}
	a.Send(e) catch {
	case Stopped:
		final = final && a.State() == before
		a.Stop()
		return final
	}
	a.Stop()
	false
}

// Actor is a running machine with state S, signal E, step decision D and
// step error row F (StartMachine gives D = Decision[S, O]). Its values are
// copies of one handle: any task may Send, Ask, read State and Stop.
extern go ergo.local/prototype/runtime/v1.Actor type Actor[S, E, D, F] {
	runtimeOnly(),
	// Send admits e into the inbox, waiting while it is full, and returns
	// once e is queued, before it is stepped. A sender's signals are
	// stepped in the order it sent them. It fails Stopped when the actor
	// has ended or its Stop was requested.
	Send(e E) fails Stopped,
	// Ask admits e and waits until the actor has stepped it, committed and
	// answered: the step's decision (a Reject included), or the step's
	// failure, after which the actor goes on. It fails Stopped when the
	// actor ended before e was stepped.
	Ask(e E) D fails Stopped | F,
	// State is the state after every signal admitted before it; on an
	// ended actor, its last state. It never fails.
	State() S,
	// Stop closes admission, stops the actor and waits until it has ended,
	// its timer stopped and its queued Asks answered Stopped. It fails with
	// the step failure that ended the actor after a Send or a timer, if
	// one did. A second Stop does the same at once.
	Stop() fails F,
	// Dropped is how many timer and work signals of ended entries the
	// actor dropped instead of stepping them (runner rules 6 and 11).
	Dropped() int,
	// LatestChanges is the actor's state when the loop begins, then its
	// latest state each time the loop reads after a commit (Enter, Stay,
	// Emit, Tell): a loop slower than the actor skips the states between,
	// so it holds at most one state however long it does not read
	// (F-GP4c-1). It ends after the actor ends and it gave the last state,
	// also one a stop overtook. A break ends it. A loop that needs every
	// state reads Changes(a, room).
	//
	// Unbounded: it ends only when the actor ends, so a loop that collects
	// it all waits for the actor's end.
	LatestChanges() Seq[S],
	// Held is how many committed states its loops (Changes, LatestChanges)
	// hold and have not given yet, summed: a loop that stops reading keeps
	// it at its room, never one per commit (the counter a growth guard
	// reads).
	Held() int,
	// Drain closes admission, so later Sends and Asks fail Stopped, and
	// waits until the actor has stepped every signal queued before it, in
	// order, its Asks answered, and then ended. A Done, a failure or a
	// defect among them ends it there. It returns as Stop does, and a Stop
	// overtakes it: the rest is dropped.
	Drain() fails F,

	// StopIsFinal: after Stop, no signal is admitted: Send fails Stopped.
	law StopIsFinal(e E) {
		Stop() catch {
		case _:
		}
		Send(e) catch {
		case Stopped:
			return true
		}
		false
	},
	// LatestChangesStops: LatestChanges is a Seq that stops (stdlib.md,
	// Std laws 5). On a stopped actor it gives one value, its last state,
	// so a yield that returns false at its k-th call (k of 1 or more) is
	// called once.
	law LatestChangesStops(k int) {
		Stop() catch {
		case _:
		}
		if k < 1 {
			return true
		}
		let mut calls = 0
		let s = LatestChanges()
		s(func(v S) bool {
			calls = calls + 1
			calls < k
		})
		calls == 1
	},
}

type actorLawFailed {}

let liveActorForLaws = context {
	Scheduler: time.NewManual(0),
	Actor[int, int, Decision[int, int], actorLawFailed]: actorForLaw(),
}

func actorForLaw() Actor[int, int, Decision[int, int], actorLawFailed] needs Scheduler {
	let m = Machine[int, int, int, actorLawFailed]{Initial: 0, Step: tallyStepForLaw, After: untimed, Work: unworked, Exit: unexited}
	StartMachine(m, 1, func(o int) {})
}

func tallyStepForLaw(s int, e int) Decision[int, int] fails actorLawFailed {
	tallyStep(s, e)
}

// start is the Go body: the machine's first state, the state of each
// restart (fresh; its failure is a defect of the restart) and the number
// of restarts after a defect (limit; 0 restarts none, and fresh never
// runs), its step, the step of a timer signal (fire), the delay of each
// state's timer (noTimer() for none; one that is not positive is a
// defect), each state's work (workOf gives it, hasWork says whether it is
// one, and work runs it with the entry's send), each state's exit action
// (hasExit says whether the state has one, and leave runs it, masked, on
// the actor's task, when an entry in that state ends), the decision's kind
// (Enter 0, Stay 1, Emit 2, Ignore 3, Reject 4, Done 5, Tell 6), the
// state after
// a decision, the output of a decision, and the inbox's capacity.
extern go ergo.local/prototype/runtime/v1.MachineSupervise func start[S, E, D, W, F, R, G, C](initial S, fresh own func() S fails G needs R, limit int, decide own func() duration needs C, step own func(s S, e E) D fails F needs R, fire own func(at S, s S) D fails F needs R, delay own func(s S) duration, workOf own func(s S) W, hasWork own func(w W) bool, work own func(w W, send func(e E)) needs R, hasExit own func(s S) bool, leave own func(s S) needs R, kind own func(d D) int, next own func(s S, d D) S, out own func(d D) needs R, capacity int) Actor[S, E, D, F] needs R | C | Scheduler

// fired is the timer of the entry that opened in at, as it fires: m's
// After under the firing mark, so a machines.Every timer's signal carries
// time.Clock's reading now. The fire of start and child reads it so; the
// delay reads only In.
func fired[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], at S) Option[Timeout[E]] {
	machines.AfterFiring(m, at)
}

// exits is whether the state s has an exit action (m.Exit gives Some): the
// runner reads it at each entry's end and enters the mask only when it
// is true, so a machine with no exit action pays one call per entry end
// (FK9-g1; runtime.md, Machines and actors 12a).
func exits[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], s S) bool {
	match m.Exit(s) {
	case Some[func() needs W]:
		true
	case None:
		false
	}
}

// exitOf runs the exit action of the state s, which the runner calls,
// masked, after exits(m, s) was true: m.Exit is a function of the state,
// so it gives the same action again.
func exitOf[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], s S) needs W {
	match m.Exit(s) {
	case Some[func() needs W] as x:
		x.Value()
	case None:
	}
}

// noTimer is the delay start reads as "no timer" for a state whose After
// is None.
extern go ergo.local/prototype/runtime/v1.ActorNoTimer func noTimer() duration

// StartMachine runs m as an actor with an inbox of capacity signals (0
// makes each Send wait for the actor to take it; a negative capacity is a
// defect) and returns at once. The actor steps one signal at a time, on
// its own task, which a stop of the calling task stops: Enter, Stay, Emit
// and Tell commit their Next; each entry (the first state, an Enter, an
// Emit; a Stay and a Tell keep the entry, its timer and its work) arms m.After's timer on the caller's Scheduler, stopped and drained
// before the next entry arms its own; a timer of an ended entry is
// dropped. A timer whose In is not positive is a defect that ends the
// actor, as in machines.RunTimed: it would fire at its entry's instant,
// and a state whose timer re-enters it would never let time pass. sink gets each Emit's, Tell's and Done's output, in order, on
// the actor's task, before any observer sees the decision or its state
// (runtime.md, Machines and actors 11.15); Done then ends the actor. A machine with an input
// starts as machines.Start(m, input). sink is escaping: the actor's task
// calls it after StartMachine returned, while the caller runs on, so a
// literal sink writes no let mut of its caller (types.md, Function values
// 2 and 3).
func StartMachine[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], capacity int, sink own func(o O) needs R) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler {
	let first = m.Initial
	launch(m, capacity, sink, func() S { first }, 0, func() duration { -1ns })
}

// SendsStepInOrder: the actor steps a sender's signals in the order it
// sent them: its State after them is the pure fold's, and a Send fails
// Stopped only once a Done was stepped.
law SendsStepInOrder(signals []int) {
	with context { Scheduler: time.NewManual(0) } {
		inOrder(signals)
	}
}

// tallyStep reaches each Decision by the signal mod 6.
func tallyStep(s int, e int) Decision[int, int] {
	match ((e % 6) + 6) % 6 {
	case 0:
		Enter[int]{Next: s + e}
	case 1:
		Stay[int]{Next: s + 1}
	case 2:
		Ignore
	case 3:
		Reject
	case 4:
		Emit[int, int]{Next: s - 1, Output: s}
	case _:
		Done[int]{Output: s}
	}
}

func untimed(s int) Option[Timeout[int]] { None }

func unworked(s int) Option[func(send func(e int))] { None }

func unexited(s int) Option[func()] { None }

func tally() Machine[int, int, int] { Machine[int, int, int]{Initial: 0, Step: tallyStep, After: untimed, Work: unworked, Exit: unexited} }

// folded is the state of tally after signals, as the pure step gives it,
// up to the first Done, and whether a Done came.
func folded(signals []int) (int, bool) {
	let mut s = 0
	for e in signals {
		let d = tallyStep(s, e)
		match d {
		case Done[int]:
			return (s, true)
		case _:
			s = machines.Next(s, d)
		}
	}
	(s, false)
}

// inOrder: the State after signals is the pure fold's, and a Send fails
// Stopped only after a Done.
func inOrder(signals []int) bool needs Scheduler {
	let a = StartMachine(tally(), 1, func(o int) {})
	let mut refused = false
	for e in signals {
		a.Send(e) catch {
		case Stopped:
			refused = true
		}
	}
	let s = a.State()
	a.Stop()
	let (want, done) = folded(signals)
	s == want && (done || !refused)
}

// SinkGetsEachOutput: the actor gives its sink each Emit's and Tell's
// output, in order, before it answers the Ask.
law SinkGetsEachOutput(signals []int) {
	with context { Scheduler: time.NewManual(0) } {
		heard(signals)
	}
}

// tellStep: a signal e decides by its rest modulo 3: 0 tells s and moves
// to s + 1, 1 emits -s and moves to s + 1, 2 stays at s + e.
func tellStep(s int, e int) Decision[int, int] {
	match ((e % 3) + 3) % 3 {
	case 0:
		Tell[int, int]{Next: s + 1, Output: s}
	case 1:
		Emit[int, int]{Next: s + 1, Output: -s}
	case _:
		Stay[int]{Next: s + e}
	}
}

// heard: a tellStep actor asked each signal gave its sink the outputs of
// the pure step's Emits and Tells, in order.
func heard(signals []int) bool needs Scheduler {
	let got = sync.NewRef[[]int]([]int{})
	let a = StartMachine(Machine[int, int, int]{Initial: 0, Step: tellStep, After: untimed, Work: unworked, Exit: unexited}, 1, func(o int) {
		got.Set(got.Get().Append(o))
	})
	let mut s = 0
	let mut want = []int{}
	for e in signals {
		let d = tellStep(s, e)
		match d {
		case Emit[int, int] as em:
			want = want.Append(em.Output)
		case Tell[int, int] as tl:
			want = want.Append(tl.Output)
		case _:
		}
		s = machines.Next(s, d)
		let _ = a.Ask(e) catch {
		case Stopped:
			a.Stop()
			return false
		}
	}
	a.Stop()
	got.Get() == want
}

// ActorStageAgreesWithFold: a scene of adds, saves, moves of the clock and
// settles, played on the stage of an actor, shows after each settle the
// state the fold gives, and one show per step.
law ActorStageAgreesWithFold(acts []int) {
	let clock = time.NewManual(0)
	with context { Scheduler: clock } { stagedAgrees(acts, clock) }
}

// staged counts what was added and the ticks of its timer while open;
// a save is work, and its end closes it.
type staged = stagedOpen{N int, Ticks int} | stagedSaving{N int, Ticks int} | stagedSaved{N int, Ticks int}

// stagedSignal is what staged reads: an add, a save, the save's end (its
// work's signal) and a tick (its timer's).
type stagedSignal = stagedAdd{N int} | stagedSave{} | stagedStored{} | stagedTick{}

// stagedStep: an add keeps the open entry and its timer (Stay); a tick
// re-enters it, so the timer re-arms; a save enters saving, whose work
// sends the end.
func stagedStep(s staged, e stagedSignal) Decision[staged, int] {
	match (s, e) {
	case (stagedOpen as o, stagedAdd as a):
		Stay[staged]{Next: stagedOpen{N: o.N + a.N, Ticks: o.Ticks}}
	case (stagedOpen as o, stagedTick):
		Enter[staged]{Next: stagedOpen{N: o.N, Ticks: o.Ticks + 1}}
	case (stagedOpen as o, stagedSave):
		Enter[staged]{Next: stagedSaving{N: o.N, Ticks: o.Ticks}}
	case (stagedSaving as v, stagedStored):
		Enter[staged]{Next: stagedSaved{N: v.N, Ticks: v.Ticks}}
	case (_, _):
		Ignore
	}
}

// stagedTimer ticks an open entry each second.
func stagedTimer(s staged) Option[Timeout[stagedSignal]] {
	match s {
	case stagedOpen:
		Some[Timeout[stagedSignal]]{Value: Timeout[stagedSignal]{In: 1s, Signal: stagedTick}}
	case stagedSaving, stagedSaved:
		None
	}
}

// stagedWork is the save: it sends its end.
func stagedWork(s staged) Option[machines.Work[stagedSignal, Scheduler]] {
	match s {
	case stagedSaving:
		Some[machines.Work[stagedSignal, Scheduler]]{Value: machines.Do[stagedSignal, Scheduler](func() stagedSignal { stagedStored })}
	case stagedOpen, stagedSaved:
		None
	}
}

type stagedLife machine[staged, stagedSignal] {
	initial: stagedOpen{N: 0, Ticks: 0},
	step:    stagedStep,
	after:   stagedTimer,
	work:    stagedWork,
}

// stagedStepOf is the step of the act k: an add of k, a save, a move of
// the clock by k mod 1500 milliseconds, or a settle.
func stagedStepOf(k int) testing.Step[stagedSignal] {
	match ((k % 4) + 4) % 4 {
	case 0:
		testing.Do[stagedSignal]{Act: stagedAdd{N: k}}
	case 1:
		testing.Do[stagedSignal]{Act: stagedSave}
	case 2:
		testing.Advance{By: stagedMove(k)}
	case _:
		testing.Settle
	}
}

// stagedMove is the move of the act k.
func stagedMove(k int) duration { duration(int64(((k%1500)+1500)%1500) * int64(1ms)) }

// stagedFolded is the state after each act, by the fold: an add adds, a
// save ends saved (the work's end), a move ticks once per second the open
// entry has waited since it was last entered, and a settle changes
// nothing.
func stagedFolded(acts []int) []staged {
	let mut s staged = stagedOpen{N: 0, Ticks: 0}
	let mut since = 0
	let mut out = []staged{}
	for k in acts {
		match (s, stagedStepOf(k)) {
		case (stagedOpen as o, testing.Do as d):
			match d.Act {
			case stagedAdd as a:
				s = stagedOpen{N: o.N + a.N, Ticks: o.Ticks}
			case stagedSave:
				s = stagedSaved{N: o.N, Ticks: o.Ticks}
			case stagedStored, stagedTick:
			}
		case (stagedOpen as o, testing.Advance as m):
			let waited = since + int(int64(m.By)/int64(1ms))
			s = stagedOpen{N: o.N, Ticks: o.Ticks + waited/1000}
			since = waited % 1000
		case (_, _):
		}
		out = out.Append(s)
	}
	out
}

// stagedAgrees plays each act, then a settle, on a stage of stagedLife
// over clock, and compares each settled show with the fold; Play gives
// one show per step.
func stagedAgrees(acts []int, clock time.Manual) bool needs Scheduler {
	let mut steps = []testing.Step[stagedSignal]{}
	for k in acts {
		steps = steps.Append(stagedStepOf(k)).Append(testing.Settle)
	}
	let a = StartMachine(stagedLife{}, 8, func(o int) {})
	let shows = testing.Play(NewStage(a, clock), steps) catch {
	case testing.Refused:
		return false
	}
	a.Stop()
	let want = stagedFolded(acts)
	let mut same = len(shows) == len(steps)
	for i, s in want {
		same = same && shows[2*i+1] == s
	}
	same
}

func waitFromVerdict(v tasks.Verdict) duration {
	match v {
	case tasks.RestartAfter as r:
		if r.Wait < 0ns {
			return 0ns
		}
		r.Wait
	case tasks.GiveUp:
		-1ns
	}
}

// Supervise is StartMachine for an actor that restarts after a defect
// (MU7; runtime.md, Machines and actors 18), under the policy of
// tasks.Restart evaluated through tasks.Decide: a defect of a step, a timer,
// a work, a child or a source ends the actor's incarnation, and while fewer
// than policy.Limit restarts were made, a new incarnation starts in m's
// initial state, never in the last one. The crash ends the incarnation as
// an end does: its children, timer and work stop, the Ask in the step and
// every queued Ask get Stopped, queued Sends are dropped; Sends and Asks
// after it go to the new incarnation, through the same Actor. Done, Stop,
// Drain and a typed failure that ends the actor are final: no restart
// follows them. The defect that finds the budget spent ends the actor, and
// Stop raises it. Restarts counts the restarts. A negative Limit is a defect.
func Supervise[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], capacity int, sink own func(o O) needs R, policy tasks.Restart) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler {
	let first = m.Initial
	let sup = tasks.LimitPolicy(policy.Limit)
	let past = sync.NewRef[[]duration]([]duration{})
	launch(m, capacity, sink, func() S { first }, policy.Limit, func() duration {
		waitFromVerdict(tasks.NextRestart(sup, past, 0s))
	})
}

// SuperviseWith is Supervise under a full tasks.Supervision policy
// (Intensity sliding window and Backoff schedule evaluated through
// tasks.Decide on time.Clock and slept on Scheduler).
func SuperviseWith[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], capacity int, sink own func(o O) needs R, policy tasks.Supervision) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler | time.Clock {
	let first = m.Initial
	let origin = time.Clock.Now()
	let past = sync.NewRef[[]duration]([]duration{})
	let active = if policy.Intensity.Max > 0 { 1 } else { 0 }
	launch(m, capacity, sink, func() S { first }, active, func() duration needs time.Clock {
		let now = time.Clock.Now().Sub(origin)
		waitFromVerdict(tasks.NextRestart(policy, past, now))
	})
}

// RestartIsFresh: under Supervise, a defect answers the Ask Stopped and
// restarts the actor in its initial state, never the last one, while the
// budget lasts; the defect after it ends the actor (Defected); Done ends
// it for good; Restarts counts the restarts.
law RestartIsFresh(signals []int, n int) {
	with context { Scheduler: time.NewManual(0) } {
		restarted(signals, n)
	}
}

// crashes reports whether the step of e is an injected defect: a signal
// whose value mod 5 is 4.
func crashes(e int) bool { ((e%5)+5)%5 == 4 }

// crashStep is tallyStep, with a defect for each signal crashes names.
func crashStep(s int, e int) Decision[int, int] {
	if crashes(e) {
		Unreachable("an injected defect")
	}
	tallyStep(s, e)
}

func crashy() Machine[int, int, int] { Machine[int, int, int]{Initial: 0, Step: crashStep, After: untimed, Work: unworked, Exit: unexited} }

// supervised asks a supervised crashy actor each signal, with a restart
// budget of n mod 3, and compares it with the pure fold: a defect restarts
// the actor in the state fresh gives (0, or the last saved one when kept)
// while the budget lasts and ends it after, and Done ends it for good.
// a.State() and Restarts(a) are the fold's, and an actor that the defect
// ended exits Defected.
func supervised(a Actor[int, int, Decision[int, int]], signals []int, limit int, kept bool) bool needs Scheduler {
	let mut s = 0
	let mut restarts = 0
	let mut ended = false
	let mut defected = false
	for e in signals {
		let _ = a.Ask(e) catch {
		case Stopped:
			Ignore
		}
		if !ended {
			if crashes(e) {
				if restarts < limit {
					restarts = restarts + 1
					if !kept {
						s = 0
					}
				} else {
					ended = true
					defected = true
				}
			} else {
				let d = tallyStep(s, e)
				match d {
				case Done[int]:
					ended = true
				case _:
					s = machines.Next(s, d)
				}
			}
		}
	}
	let same = a.State() == s && Restarts(a) == restarts
	if defected {
		match ExitOf(a) {
		case Defected:
			return same
		case _:
			return false
		}
	}
	a.Stop()
	same
}

// restarted is supervised over Supervise: each restart starts in the
// initial state.
func restarted(signals []int, n int) bool needs Scheduler {
	let limit = ((n % 3) + 3) % 3
	supervised(Supervise(crashy(), 1, func(o int) {}, tasks.Restart{Limit: limit}), signals, limit, false)
}

// Restarts is how many times a restarted after a defect (Supervise,
// SuperviseDurable); 0 for an actor that never did.
extern go ergo.local/prototype/runtime/v1.ActorRestarts func Restarts[S, E, D, F](a Actor[S, E, D, F]) int

func launch[S, E, O, F, R, W, G, C](m Machine[S, E, O, F, R, W], capacity int, sink own func(o O) needs R, fresh own func() S fails G needs R, limit int, decide own func() duration needs C) Actor[S, E, Decision[S, O], F] needs R | W | C | Scheduler {
	start(m.Initial, fresh, limit, decide, m.Step, func(at S, s S) Decision[S, O] fails F needs R {
		match fired(m, at) {
		case Some[Timeout[E]] as t:
			try m.Step(s, t.Value.Signal)
		case None:
			Ignore
		}
	}, func(s S) duration {
		match m.After(s) {
		case Some[Timeout[E]] as t:
			t.Value.In
		case None:
			noTimer()
		}
	}, m.Work, func(w Option[func(send func(e E)) needs W]) bool {
		match w {
		case Some[func(send func(e E)) needs W]:
			true
		case None:
			false
		}
	}, func(w Option[func(send func(e E)) needs W], send func(e E)) needs W {
		match w {
		case Some[func(send func(e E)) needs W] as wk:
			wk.Value(send)
		case None:
		}
	}, func(s S) bool { exits(m, s) }, func(s S) needs W { exitOf(m, s) }, func(d Decision[S, O]) int {
		match d {
		case Enter[S]:
			0
		case Stay[S]:
			1
		case Emit[S, O]:
			2
		case Ignore:
			3
		case Reject:
			4
		case Done[O]:
			5
		case Tell[S, O]:
			6
		}
	}, func(s S, d Decision[S, O]) S { machines.Next(s, d) }, func(d Decision[S, O]) needs R {
		match d {
		case Emit[S, O] as em:
			sink(em.Output)
		case Done[O] as dn:
			sink(dn.Output)
		case Tell[S, O] as tl:
			sink(tl.Output)
		case Enter[S]:
		case Stay[S]:
		case Ignore:
		case Reject:
		}
	}, capacity)
}

// StartDurable is StartMachine for a machine whose transitions outlive the
// actor (MU9; runtime.md, Machines and actors 17). recover runs once, at
// the start: Some state is the state the actor starts in, None starts it
// in m's initial state; a failure of recover fails StartDurable, and no
// actor starts. save gets the state before, the state after and the
// signal of each step that commits (Enter, Stay, Emit, Tell; a timer's and a
// work's signal too). It runs after the step decided and before the actor
// commits the state, opens the entry, gives an output or answers the Ask,
// so no one sees a state that save did not keep. Ignore, Reject and Done
// commit no state, so save does not run for them. A failure of save is a
// defect that ends the actor (ActorSaveDefect, with the failure's text):
// the actor cannot keep its promise that a committed state outlives it,
// and the state does not change; an Ask in the step gets Stopped.
//
// The step of m must be pure: the checker refuses a machine whose step
// has an effect (S108), because a recovery steps the saved signals again.
// Work and timers stay: their results reach the step as signals, and save
// keeps those the step commits. A signal of an ended entry is dropped
// before the step (runner rule 6), so it is never saved and never
// replayed.
//
// The step may make hosts (NewHost): a host is entry data, not durable
// data. A host that recover makes (in a replay of the step) is unbound;
// the actor's first entry binds each one its first state holds, and its
// work fills them with new children. Every other host recover made is
// closed when StartDurable returns, so a journal never keeps a live child.
func StartDurable[S, E, O, F, R, W, G](m pure Machine[S, E, O, F, R, W], capacity int, sink own func(o O) needs R, recover func() Option[S] fails G needs R, save own func(prev S, next S, sig E) fails G needs R) Actor[S, E, Decision[S, O], F] fails G needs R | W | Scheduler {
	try recovering(func() S fails G needs R { try recovered(recover, m.Initial) }, func(initial S) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler {
		StartMachine(durable(m, initial, save), capacity, sink)
	})
}

// recovering runs recover, so each host it makes is unbound, and then
// start with its state: the first entry of the actor start opens binds the
// hosts that state holds; the others close when start returns, and all of
// them close when recover fails (Go body ActorRecovering; runtime.md,
// Machines and actors 17).
extern go ergo.local/prototype/runtime/v1.ActorRecovering func recovering[S, A, G, R, Q](recover func() S fails G needs R, start func(s S) A needs Q) A fails G needs R | Q

// SuperviseDurable is Supervise for a durable machine (StartDurable): the
// first incarnation starts as StartDurable starts, and each restart runs
// recover again, so the new incarnation starts in the last state save
// kept (or m's initial state on None), never in the crashed one's memory.
// A failure of recover at the start fails SuperviseDurable; at a restart
// it is a defect of the new incarnation (ActorFreshDefect), which the
// budget counts like any other.
func SuperviseDurable[S, E, O, F, R, W, G](m pure Machine[S, E, O, F, R, W], capacity int, sink own func(o O) needs R, policy tasks.Restart, recover own func() Option[S] fails G needs R, save own func(prev S, next S, sig E) fails G needs R) Actor[S, E, Decision[S, O], F] fails G needs R | W | Scheduler {
	let first = m.Initial
	let sup = tasks.LimitPolicy(policy.Limit)
	let past = sync.NewRef[[]duration]([]duration{})
	try recovering(func() S fails G needs R { try recovered(recover, first) }, func(initial S) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler {
		launch(durable(m, initial, save), capacity, sink, func() S fails G needs R { try recovered(recover, first) }, policy.Limit, func() duration {
			waitFromVerdict(tasks.NextRestart(sup, past, 0s))
		})
	})
}

// SuperviseDurableWith is SuperviseDurable under a full tasks.Supervision
// policy (Intensity sliding window and Backoff schedule evaluated through
// tasks.Decide on time.Clock and slept on Scheduler).
func SuperviseDurableWith[S, E, O, F, R, W, G](m pure Machine[S, E, O, F, R, W], capacity int, sink own func(o O) needs R, policy tasks.Supervision, recover own func() Option[S] fails G needs R, save own func(prev S, next S, sig E) fails G needs R) Actor[S, E, Decision[S, O], F] fails G needs R | W | Scheduler | time.Clock {
	let first = m.Initial
	let active = if policy.Intensity.Max > 0 { 1 } else { 0 }
	try recovering(func() S fails G needs R { try recovered(recover, first) }, func(initial S) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler | time.Clock {
		let origin = time.Clock.Now()
		let past = sync.NewRef[[]duration]([]duration{})
		launch(durable(m, initial, save), capacity, sink, func() S fails G needs R { try recovered(recover, first) }, active, func() duration needs time.Clock {
			let now = time.Clock.Now().Sub(origin)
			waitFromVerdict(tasks.NextRestart(policy, past, now))
		})
	})
}

law SuperviseWithWindowAndBackoff(k int) {
	let _ = k
	let policy = tasks.Supervision{Strategy: tasks.OneForOne, Intensity: tasks.Intensity{Max: 2, Period: 10s}, Backoff: schedule.Exponential(1s, 2.0, 10s)}
	let c1 = testing.NewVirtualClock(0)
	let slid = with context { Scheduler: c1, time.Clock: c1 } {
		let start = time.Clock.Now()
		let a = SuperviseWith(crashy(), 1, func(o int) {}, policy)
		let _ = a.Ask(6) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(1) catch {
		case Stopped:
			Ignore
		}
		let t1 = time.Clock.Now().Sub(start)
		let s1 = a.State()
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(1) catch {
		case Stopped:
			Ignore
		}
		let t2 = time.Clock.Now().Sub(start)
		Scheduler.Sleep(10s)
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(1) catch {
		case Stopped:
			Ignore
		}
		let t3 = time.Clock.Now().Sub(start)
		let r = Restarts(a)
		a.Stop()
		s1 == 1 && t1 == 1s && t2 == 3s && t3 == 14s && r == 3
	}
	let c2 = testing.NewVirtualClock(0)
	let gaveUp = with context { Scheduler: c2, time.Clock: c2 } {
		let start = time.Clock.Now()
		let a = SuperviseWith(crashy(), 1, func(o int) {}, policy)
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(1) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(1) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		match ExitOf(a) {
		case Defected:
			Restarts(a) == 2 && time.Clock.Now().Sub(start) == 3s
		case _:
			false
		}
	}
	slid && gaveUp
}

law SuperviseDurableWithRecoversAndBacksOff(k int) {
	let _ = k
	let policy = tasks.Supervision{Strategy: tasks.OneForOne, Intensity: tasks.Intensity{Max: 2, Period: 10s}, Backoff: schedule.Exponential(1s, 2.0, 10s)}
	let c = testing.NewVirtualClock(0)
	let cell = sync.NewRef[Option[int]](None)
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		let a = SuperviseDurableWith(Machine[int, int, int]{Initial: 0, Step: crashStep, After: untimed, Work: unworked, Exit: unexited}, 1, func(o int) {}, policy, func() Option[int] { cell.Get() }, func(prev int, next int, sig int) {
			cell.Set(Some[int]{Value: next})
		})
		let _ = a.Ask(6) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(1) catch {
		case Stopped:
			Ignore
		}
		let t1 = time.Clock.Now().Sub(start)
		let s1 = a.State()
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		let _ = a.Ask(1) catch {
		case Stopped:
			Ignore
		}
		let t2 = time.Clock.Now().Sub(start)
		let s2 = a.State()
		let _ = a.Ask(4) catch {
		case Stopped:
			Ignore
		}
		match ExitOf(a) {
		case Defected:
			s1 == 7 && t1 == 1s && s2 == 8 && t2 == 3s && a.State() == 8 && Restarts(a) == 2 && time.Clock.Now().Sub(start) == 3s
		case _:
			false
		}
	}
}

// RestartRecovers: under SuperviseDurable, each restart starts in the
// state recover gives, the last one save kept.
law RestartRecovers(signals []int, n int) {
	with context { Scheduler: time.NewManual(0) } {
		recoveredRun(signals, n)
	}
}

// recoveredRun is supervised over SuperviseDurable with a journal of one
// cell: save keeps the committed state, recover gives it, so each restart
// starts in the state the crash found.
func recoveredRun(signals []int, n int) bool needs Scheduler {
	let limit = ((n % 3) + 3) % 3
	let cell = sync.NewRef[Option[int]](None)
	let a = SuperviseDurable(Machine[int, int, int]{Initial: 0, Step: crashStep, After: untimed, Work: unworked, Exit: unexited}, 1, func(o int) {}, tasks.Restart{Limit: limit}, func() Option[int] { cell.Get() }, func(prev int, next int, sig int) {
		cell.Set(Some[int]{Value: next})
	})
	supervised(a, signals, limit, true)
}

// recovered is recover's state, or initial on None.
func recovered[S, G, R](recover func() Option[S] fails G needs R, initial own S) S fails G needs R {
	match try recover() {
	case Some[S] as s:
		s.Value
	case None:
		initial
	}
}

// durable is m starting in initial, with save run on each committed
// transition (keep) before the actor commits it.
func durable[S, E, O, F, R, W, G](m Machine[S, E, O, F, R, W], initial own S, save own func(prev S, next S, sig E) fails G needs R) Machine[S, E, O, F, R, W] {
	let step = m.Step
	Machine[S, E, O, F, R, W]{Initial: initial, Step: func(s S, e E) Decision[S, O] fails F needs R {
		let d = try step(s, e)
		match d {
		case Enter[S] as en:
			keep(save, s, en.Next, e)
		case Stay[S] as st:
			keep(save, s, st.Next, e)
		case Emit[S, O] as em:
			keep(save, s, em.Next, e)
		case Tell[S, O] as tl:
			keep(save, s, tl.Next, e)
		case Ignore:
		case Reject:
		case Done[O]:
		}
		d
	}, After: m.After, Work: m.Work, Exit: m.Exit}
}

// keep is save(prev, next, sig), with its failure a defect
// (ActorSaveDefect): the Go body ActorKeep.
extern go ergo.local/prototype/runtime/v1.ActorKeep func keep[S, E, G, R](save func(prev S, next S, sig E) fails G needs R, prev S, next S, sig E) needs R

// child is start for a child of an entry (MU5; Go body MachineChild): out
// gets each decision with deliver, which gives a child output to the
// parent as a signal of the entry that owns the child. host is the host
// the child fills (ChildIn), or noHost() (Child).
extern go ergo.local/prototype/runtime/v1.MachineChild func child[S, E, D, W, F, R, P](host Host[Actor[S, E, D, F]], initial S, step own func(s S, e E) D fails F needs R, fire own func(at S, s S) D fails F needs R, delay own func(s S) duration, workOf own func(s S) W, hasWork own func(w W) bool, work own func(w W, send func(e E)) needs R, hasExit own func(s S) bool, leave own func(s S) needs R, kind own func(d D) int, next own func(s S, d D) S, out own func(d D, deliver func(p P)) needs R, capacity int) Actor[S, E, D, F] needs R | Scheduler

// Child runs m as an actor that the entry of the calling work owns
// (runtime.md, Machines and actors 14), with an inbox of capacity
// signals, and returns it; call it in a machine's work, with that work's
// send. The child runs as StartMachine runs it. Its Emit, Tell and Done outputs
// reach the parent through toParent, as signals of the entry that started
// the child: one that arrives after that entry ended is dropped, never
// stepped. When the entry ends, and when the parent ends, its children
// stop, the last started first, each one with its own children first,
// before the parent's timer and work stop and before its next entry
// opens; a Send to a stopped child fails Stopped. Children are kept by
// identity: two children of one machine are two children. A child's
// failure ends only the child (ExitOf reads it); a child's defect ends the
// parent. send names the entry's signal type, so toParent gives the
// parent's signals. It is an entry func: the send the runner gave the
// entry's work (machines.Work's Start), or one a caller passed on to a
// parameter written entry; no other value is one (types.md, Function
// values).
func Child[S, E, O, F, R, W, P](send entry func(e P), m Machine[S, E, O, F, R, W], capacity int, toParent own func(o O) P) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler {
	childOf(noHost[Actor[S, E, Decision[S, O], F]](), m, capacity, toParent)
}

// Hosts (mu-host; runtime.md, Machines and actors 16): a name for a child
// before it exists.

// Host is an empty slot for one A, the child that an entry's work starts.
// A step makes it with NewHost and puts it in the state it enters; that
// entry owns it, its work fills it once with ChildIn, and it ends with the
// entry. The actor shows the entry only after its work filled its hosts,
// waited, or ended, so a reader that sees the entry finds each host filled
// unless the work waited first.
// law-exempt: a host's answers depend on its owner entry, which only an actor's runner opens, fills and ends, and a law has no running entry; the runner's property TestActorHostAgreesWithModel holds its rules against the model models/host.
extern go ergo.local/prototype/runtime/v1.Host type Host[A] {
	runtimeOnly(),
	// Get is the child once the entry's work filled the host, waiting
	// while it is empty; it fails Stopped once the entry ended, also after
	// the fill, so a host never gives a child of another entry.
	Get() A fails Stopped,
}

// NewHost is an empty host. Made in a step of an actor, it belongs to the
// entry the step enters (an Enter or an Emit; a Stay's and a Tell's is the current
// entry's) and closes when the step enters no state. Made in the recover
// of StartDurable or SuperviseDurable (a replay of the step), it is
// unbound: the recovered actor's first entry owns it when its first state
// holds it, and it closes otherwise. Made anywhere else, no entry owns it:
// Get fails Stopped and ChildIn on it is a defect. A durable step may call
// NewHost (the checker's S108 admits it): it makes an empty cell and acts
// on nothing outside.
extern go ergo.local/prototype/runtime/v1.NewHost func NewHost[A]() Host[A]

// noHost is the host Child gives child: none.
extern go ergo.local/prototype/runtime/v1.ActorNoHost func noHost[A]() Host[A]

// ChildIn is Child that fills host with the child it starts: call it in a
// machine's work, with that work's send, on a host that the entry of the
// work owns and that is empty. Any other host is a defect, with no child
// started: a host of an ended entry (a state that carried it into a new
// entry), a filled host, or one that no entry owns.
func ChildIn[S, E, O, F, R, W, P](send entry func(e P), host Host[Actor[S, E, Decision[S, O], F]], m Machine[S, E, O, F, R, W], capacity int, toParent own func(o O) P) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler {
	childOf(host, m, capacity, toParent)
}

// childOf is the body of Child and ChildIn.
func childOf[S, E, O, F, R, W, P](host Host[Actor[S, E, Decision[S, O], F]], m Machine[S, E, O, F, R, W], capacity int, toParent own func(o O) P) Actor[S, E, Decision[S, O], F] needs R | W | Scheduler {
	child(host, m.Initial, m.Step, func(at S, s S) Decision[S, O] fails F needs R {
		match fired(m, at) {
		case Some[Timeout[E]] as t:
			try m.Step(s, t.Value.Signal)
		case None:
			Ignore
		}
	}, func(s S) duration {
		match m.After(s) {
		case Some[Timeout[E]] as t:
			t.Value.In
		case None:
			noTimer()
		}
	}, m.Work, func(w Option[func(send func(e E)) needs W]) bool {
		match w {
		case Some[func(send func(e E)) needs W]:
			true
		case None:
			false
		}
	}, func(w Option[func(send func(e E)) needs W], wsend func(e E)) needs W {
		match w {
		case Some[func(send func(e E)) needs W] as wk:
			wk.Value(wsend)
		case None:
		}
	}, func(s S) bool { exits(m, s) }, func(s S) needs W { exitOf(m, s) }, func(d Decision[S, O]) int {
		match d {
		case Enter[S]:
			0
		case Stay[S]:
			1
		case Emit[S, O]:
			2
		case Ignore:
			3
		case Reject:
			4
		case Done[O]:
			5
		case Tell[S, O]:
			6
		}
	}, func(s S, d Decision[S, O]) S { machines.Next(s, d) }, func(d Decision[S, O], deliver func(p P)) needs R {
		match d {
		case Emit[S, O] as em:
			deliver(toParent(em.Output))
		case Done[O] as dn:
			deliver(toParent(dn.Output))
		case Tell[S, O] as tl:
			deliver(toParent(tl.Output))
		case Enter[S]:
		case Stay[S]:
		case Ignore:
		case Reject:
		}
	}, capacity)
}

// Sources of an actor (MU10; runtime.md, Machines and actors 15).

// feed is Feed's Go body (ActorFeed): it admits run, which the actor's
// runner starts on a task of its own with a send of the actor's signals.
extern go ergo.local/prototype/runtime/v1.ActorFeed func feed[S, E, D, F](a Actor[S, E, D, F], run own func(send func(e E))) fails Stopped

// Feed gives a the values of source as signals, in source's order, for as
// long as a runs, and returns once the source is admitted. The source runs
// on a task that a owns, not the caller: it ends when it ends, and when a
// ends (a Done, a failure, a defect, Stop, Drain) its next value is not
// sent and the source ends there; a source that waits is stopped. When
// Stop, Drain or ExitOf returns, no source of a runs. A source's values
// are a sender's: a full inbox makes the source wait, and Stop drops the
// queued ones. A defect of the source ends a, as a work's defect does. It
// fails Stopped when a has ended or its Stop was requested; the source
// then never runs. The card reader of a sign-in screen is one: each card
// it reads is a signal, and the reader stops with the screen.
func Feed[S, E, D, F](a Actor[S, E, D, F], source Seq[E]) fails Stopped {
	try feed(a, func(send func(e E)) {
		for e in source {
			send(e)
		}
	})
}

// FeedStepsInOrder: the actor steps a source's values in the source's
// order, each once.
law FeedStepsInOrder(xs []int) {
	with context { Scheduler: time.NewManual(0) } {
		fed(xs)
	}
}

// logStep keeps every signal: the state is the list of them, in order.
func logStep(s []int, e int) Decision[[]int, int] { Stay[[]int]{Next: s.Append(e)} }

func logUntimed(s []int) Option[Timeout[int]] { None }

func logUnworked(s []int) Option[func(send func(e int))] { None }

func logUnexited(s []int) Option[func()] { None }

// fed: a source's values are stepped in its order, each once: the state
// the actor reaches once it has stepped as many signals is xs.
func fed(xs []int) bool needs Scheduler {
	let a = StartMachine(Machine[[]int, int, int]{Initial: []int{}, Step: logStep, After: logUntimed, Work: logUnworked, Exit: logUnexited}, 1, func(o int) {})
	Feed(a, source(xs)) catch {
	case Stopped:
		return false
	}
	let s = WaitFor(a, func(s []int) bool { len(s) >= len(xs) }) catch {
	case Stopped:
		return false
	}
	a.Stop()
	let mut same = len(s) == len(xs)
	for i in 0..len(s) {
		same = same && s[i] == xs[i]
	}
	same
}

// source is xs as a Seq.
func source(xs []int) Seq[int] {
	Seq[int](func(yield func(v int) bool) {
		for x in xs {
			if !yield(x) {
				return
			}
		}
	})
}

// OnEnd runs f once when a ends, after a's sources stopped and before its
// end is published: before Stop, Drain or ExitOf of a returns, whatever
// ended it (a Done, a failure, a defect, a Stop, a Drain). It runs masked
// on a's runner, in the order the OnEnd calls came; a defect in f joins
// a's exit. It fails Stopped once a's end has taken its actions; f then
// never runs. A Registry removes an ended actor's entry with it.
extern go ergo.local/prototype/runtime/v1.ActorOnEnd func OnEnd[S, E, D, F](a Actor[S, E, D, F], f own func()) fails Stopped

// OnEndRunsOnce: each of the n actions added before the end runs exactly
// once, in order, before Stop or Drain returns, whatever the signals did
// (one may be a Done); an OnEnd after the end fails Stopped and never
// runs.
law OnEndRunsOnce(n int, signals []int, drain bool) {
	with context { Scheduler: time.NewManual(0) } {
		endActions(((n%4)+4)%4+1, signals, drain)
	}
}

// endActions adds n actions to an actor that was sent signals, each
// appending its number to a shared list, and ends it.
func endActions(n int, signals []int, drain bool) bool needs Scheduler {
	let a = sent(signals)
	let ran = sync.NewRef[[]int]([]int{})
	let mut added = 0
	for i in 0..n {
		let mut took = true
		OnEnd(a, appends(ran, i)) catch {
		case Stopped:
			took = false
		}
		if took {
			added = added + 1
		}
	}
	if drain {
		a.Drain()
	} else {
		a.Stop()
	}
	let got = ran.Get()
	let mut late = false
	OnEnd(a, func() { ran.Update(func(xs []int) []int { xs.Append(-1) }) }) catch {
	case Stopped:
		late = true
	}
	let mut inOrder = len(got) == added
	for i in 0..len(got) {
		inOrder = inOrder && got[i] == i
	}
	inOrder && late && len(ran.Get()) == len(got)
}

// appends is an action that appends v to ran.
func appends(ran sync.Ref[[]int], v int) func() {
	func() { ran.Update(func(xs []int) []int { xs.Append(v) }) }
}

// live is a State read that fails Stopped when a has ended before it was
// answered (ActorLiveState).
extern go ergo.local/prototype/runtime/v1.ActorLiveState func live[S, E, D, F](a Actor[S, E, D, F]) S fails Stopped

// Can is whether a would take e now: false when a has ended (no step
// runs then), else machines.Can(step, s, e) for the state s after every
// signal admitted before it, as State reads it. step is a's step, pure:
// Can runs it on the caller's task and commits nothing. A screen greys a
// key whose signal the actor cannot take.
func Can[S, E, O, F](a Actor[S, E, Decision[S, O], F], step func(s S, e E) Decision[S, O], e E) bool {
	let s = live(a) catch {
	case Stopped:
		return false
	}
	machines.Can(step, s, e)
}

// CanIsTheStep: Can answers as the step would in the actor's state, takes
// nothing, and answers false once the actor has ended.
law CanIsTheStep(signals []int, e int) {
	with context { Scheduler: time.NewManual(0) } {
		can(signals, e)
	}
}

// can: Can is the pure step's answer in the actor's state while it runs,
// and false once it has ended (after a Done among the signals).
func can(signals []int, e int) bool needs Scheduler {
	let a = sent(signals)
	let (_, done) = folded(signals)
	let s = a.State()
	let c = Can(a, tallyStep, e)
	let kept = a.State() == s
	a.Stop()
	let after = Can(a, tallyStep, e)
	kept && !after && (if done { !c } else { c == machines.Can(tallyStep, s, e) })
}

// Changed is a state the actor committed, in a Changes loop.
type Changed[S] { State S }

// Overflowed is the gap of a Changes loop that fell room states behind:
// Missed is how many committed states it dropped, just before the next
// Changed, which is the state that found it full.
type Overflowed { Missed int }

// Change is one step of a Changes loop.
type Change[S] = Changed[S] | Overflowed

// Changes is a's state when the loop begins, then each state it commits
// (Enter, Stay, Emit, Tell), in order, once each, as Changed; it ends after the
// actor ends and it gave every state committed before the end, also one a
// stop overtook. It holds at most room states (1 for a room under 1): a
// commit that finds room states unread drops them, and the loop reads an
// Overflowed with their number before that commit's state, so a loop that
// does not read holds room states, never one per commit (F-GP4c-1; owner,
// 2026-11-15). A break ends it. A loop that wants only the current state
// reads a.LatestChanges().
//
// Unbounded: it ends only when the actor ends, so a loop that collects it
// all waits for the actor's end.
func Changes[S, E, D, F](a Actor[S, E, D, F], room int) Seq[Change[S]] {
	changesOf(a, room, changedOf[S], overflowedOf[S])
}

// ChangesCountsWhatItDrops: a Changes loop that falls more than its room
// behind the actor reads an Overflowed with the number of states it
// dropped, then the states it kept: it holds room states, never one per
// commit (F-GP4c-1; owner, 2026-11-15).
law ChangesCountsWhatItDrops(room int, n int) {
	with context { Scheduler: time.NewManual(0) } {
		dropped(room, n)
	}
}

// dropped: a Changes loop of room 1 to 4 that reads its first state,
// then lags while the actor commits 1 to 10 states, reads its start, then
// an Overflowed of the states its room dropped, then the ones it kept, in
// order.
func dropped(room int, n int) bool needs Scheduler {
	let r = (room%4+4)%4 + 1
	let k = (n%10+10)%10 + 1
	let a = StartMachine(tally(), 1, func(o int) {})
	let mut got = []Change[int]{}
	for c in Changes(a, r) {
		if len(got) == 0 {
			for _ in 0..k {
				a.Send(1) catch {
				case Stopped:
				}
			}
			let _ = a.State()
			a.Stop()
		}
		got = got.Append(c)
	}
	let mut kept = []int{}
	let mut missed = 0
	for i in 1..k+1 {
		if len(kept) >= r {
			missed = missed + len(kept)
			kept = []int{}
		}
		kept = kept.Append(i)
	}
	let mut want = []Change[int]{Changed[int]{State: 0}}
	if missed > 0 {
		want = want.Append(Overflowed{Missed: missed})
	}
	for s in kept {
		want = want.Append(Changed[int]{State: s})
	}
	if len(got) != len(want) {
		return false
	}
	for i in 0..len(got) {
		if got[i] != want[i] {
			return false
		}
	}
	true
}

// ActorChangesStops: Changes is a Seq that stops (stdlib.md, Std laws 5).
law ActorChangesStops(k int) {
	with context { Scheduler: time.NewManual(0) } {
		changesStop(k)
	}
}

// changesStop: on a stopped actor, Changes gives one value, its last
// state, so a yield that returns false at its k-th call (k of 1 or more)
// is called once.
func changesStop(k int) bool needs Scheduler {
	if k < 1 {
		return true
	}
	let a = StartMachine(tally(), 1, func(o int) {})
	a.Stop()
	let mut calls = 0
	let s = Changes(a, 2)
	s(func(c Change[int]) bool {
		calls = calls + 1
		calls < k
	})
	calls == 1
}

func changedOf[S](s S) Change[S] { Changed[S]{State: s} }

func overflowedOf[S](n int) Change[S] { Overflowed{Missed: n} }

// changesOf is the loop of Changes(a, room), built by changed and
// overflowed.
extern go ergo.local/prototype/runtime/v1.ActorChanges func changesOf[S, E, D, F, C](a Actor[S, E, D, F], room int, changed own func(s S) C, overflowed own func(n int) C) Seq[C]

// waitRoom is the room of the loops of WaitFor and SendAndWait.
func waitRoom() int { 256 }

// Observing an actor (MU12; runtime.md, Machines and actors 13). Each of
// these is a loop over Changes(a, waitRoom()), so it judges the state at
// its start, then each committed state once, in order, and it releases
// its subscription when it returns. A loop more than 256 states behind
// the actor skips the states its Overflowed counts and judges the rest:
// it holds 256 states at most, never one per commit. No callback is
// registered with the actor and none runs on its task.

// WaitFor is the first state that pred accepts: the state when the call
// begins, then each state the actor commits after it, in order; a state
// committed before the actor ended counts, also when a stop overtook it.
// It fails Stopped when the actor ends with no such state.
func WaitFor[S, E, D, F, R](a Actor[S, E, D, F], pred func(s S) bool needs R) S fails Stopped needs R {
	for c in Changes(a, waitRoom()) {
		match c {
		case Changed[S] as s:
			if pred(s.State) {
				return s.State
			}
		case Overflowed:
		}
	}
	Stopped
}

// SendAndWait sends e, and is the first state that pred accepts from the
// state before e on: it takes the actor's state, sends e, then judges
// that state and each one the actor commits after it, as WaitFor does. So
// a change e makes is never missed, also when another sender's signal
// comes between. It fails Stopped when the Send does, or when the actor
// ends with no such state.
func SendAndWait[S, E, D, F, R](a Actor[S, E, D, F], e E, pred func(s S) bool needs R) S fails Stopped needs R {
	let mut sent = false
	for c in Changes(a, waitRoom()) {
		if !sent {
			sent = true
			try a.Send(e)
		}
		match c {
		case Changed[S] as s:
			if pred(s.State) {
				return s.State
			}
		case Overflowed:
		}
	}
	Stopped
}

// Finished is an actor that its step ended with Done: its last state and
// Done's output.
type Finished[S, O] {
	State  S,
	Output O,
}

// Halted is an actor that Stop, Drain or a stop of the task that started
// it ended: its last state.
type Halted[S] {
	State S,
}

// Defected is an actor that a defect ended (of its step, its timer or its
// work): Reason is the defect's text, as the runtime's report writes it
// after "panic: " (an Unreachable's "unreachable at a.ergo:9:3: no
// route"). The defect itself is Stop's to raise (FK13-g1).
type Defected { Reason string }

// Failed is an actor that its step's typed failure ended, after a Send or
// a timer: the failure, a value of the row F (owner q47; an Ask's failure
// goes to the asker and ends nothing).
type Failed[F] {
	Error F,
}

// FailedIsExit: a step's typed failure after a Send ends the actor, and
// its exit is Failed with that failure (owner q47), one value for every
// caller.
law FailedIsExit(n int) {
	with context { Scheduler: time.NewManual(0) } {
		failedExit(n)
	}
}

func boomStep(s int, e int) Decision[int, int] fails Boom {
	if e < 0 {
		return Boom{At: s}
	}
	Enter[int]{Next: s + 1}
}

func boom() Machine[int, int, int, Boom] { Machine[int, int, int, Boom]{Initial: 0, Step: boomStep, After: untimed, Work: unworked, Exit: unexited} }

// failedExit sends n mod 4 signals and then one that fails: the failure
// ends the actor, and each ExitOf gives it as Failed, with the state the
// step failed in.
func failedExit(n int) bool needs Scheduler {
	let k = ((n % 4) + 4) % 4
	let a = StartMachine(boom(), 1, func(o int) {})
	for _ in 0..k {
		a.Send(1) catch {
		case Stopped:
		}
	}
	a.Send(-1) catch {
	case Stopped:
	}
	failedAt(k, ExitOf(a)) && failedAt(k, ExitOf(a))
}

// failedAt is whether x is Failed with the state k.
func failedAt(k int, x Exit[int, int, Boom | Boom]) bool {
	match x {
	case Failed as f:
		match f.Error {
		case Boom as b:
			b.At == k
		}
	case _:
		false
	}
}

// Exit is how an actor ended, as Effect's Exit is: done, stopped, failed
// with a typed failure, or a defect.
type Exit[S, O, F] = Finished[S, O] | Halted[S] | Failed[F] | Defected

// ExitIsShared: Drain steps every queued signal, and the exit is one
// value: each ExitOf gives the same, the pure fold's.
law ExitIsShared(signals []int) {
	with context { Scheduler: time.NewManual(0) } {
		drainedExit(signals)
	}
}

// exitParts is an exit as its variant (0 Finished, 1 Halted, 2 Defected,
// 3 Failed), its state and its output.
func exitParts[F](x Exit[int, int, F]) (int, int, int) {
	match x {
	case Finished[int, int] as f:
		(0, f.State, f.Output)
	case Halted[int] as h:
		(1, h.State, 0)
	case Defected:
		(2, 0, 0)
	case Failed[F]:
		(3, 0, 0)
	}
}

// drainedExit: after the signals and a Drain, two ExitOf calls give the
// same exit, the one the pure fold gives: Finished with the state the
// Done saw when a Done came, else Halted with the folded state.
func drainedExit(signals []int) bool needs Scheduler {
	let a = sent(signals)
	a.Drain()
	let (k1, s1, o1) = exitParts(ExitOf(a))
	let (k2, s2, o2) = exitParts(ExitOf(a))
	let (want, done) = folded(signals)
	let mut kind = 1
	if done {
		kind = 0
	}
	k1 == k2 && s1 == s2 && o1 == o2 && k1 == kind && s1 == want && (!done || o1 == want)
}

// ExitOf waits until a has ended and is how it ended. The exit is one
// value: every caller, at any time, gets the same, and Stop and Drain
// return the failure that Failed holds or raise the defect that Defected
// reports. A stop of the waiting task ends the wait.
func ExitOf[S, E, O, F](a Actor[S, E, Decision[S, O], F]) Exit[S, O, F] {
	let k = exitKind(a)
	if k == 0 {
		match final(a) {
		case Done[O] as d:
			return Finished[S, O]{State: a.State(), Output: d.Output}
		case _:
		}
	}
	if k == 2 {
		failure(a) catch {
		case err:
			return Failed[F]{Error: err}
		}
	}
	if k == 3 {
		return Defected{Reason: defectOf(a)}
	}
	Halted[S]{State: a.State()}
}

// Ended is whether a has ended: true exactly when ExitOf of a would not
// wait. Once true it stays true. It never waits, so an actor's own step
// may ask it of itself (an actor's end as a value, without the wait
// ExitOf has).
extern go ergo.local/prototype/runtime/v1.ActorEnded func Ended[S, E, D, F](a Actor[S, E, D, F]) bool

// EndedIsMonotone: once Ended is true it stays true; Stop, Drain and
// ExitOf return only after it is.
law EndedIsMonotone(signals []int, drain bool) {
	with context { Scheduler: time.NewManual(0) } {
		endedStays(signals, drain)
	}
}

// endedStays: an actor that was sent signals (one may be a Done) ends by
// Drain or Stop; Ended before the end may be either, and after it, and at
// every later read, is true.
func endedStays(signals []int, drain bool) bool needs Scheduler {
	let a = sent(signals)
	let before = Ended(a)
	if drain {
		a.Drain()
	} else {
		a.Stop()
	}
	let after = Ended(a)
	let _ = exitCode(ExitOf(a))
	(!before || after) && after && Ended(a)
}

// EndedAgreesWithExit: Ended is false for an actor that runs (it has
// stepped signals and no Done) and true once its end returned, when ExitOf
// gives its exit at once.
law EndedAgreesWithExit(signals []int) {
	with context { Scheduler: time.NewManual(0) } {
		endedAgrees(signals)
	}
}

// endedAgrees sends an actor that never ends by itself the signals, reads
// Ended while it runs, then stops it.
func endedAgrees(signals []int) bool needs Scheduler {
	let a = StartMachine(Machine[[]int, int, int]{Initial: []int{}, Step: logStep, After: logUntimed, Work: logUnworked, Exit: logUnexited}, 1, func(o int) {})
	for e in signals {
		a.Send(e) catch {
		case Stopped:
			return false
		}
	}
	let s = WaitFor(a, func(s []int) bool { len(s) >= len(signals) }) catch {
	case Stopped:
		return false
	}
	let running = !Ended(a)
	a.Stop()
	let ended = Ended(a)
	match ExitOf(a) {
	case Halted[[]int] as h:
		running && ended && len(h.State) == len(s)
	case _:
		false
	}
}

// Watch sends watcher the signal toSignal(x) once a has ended, x its exit
// (ExitOf): a monitor whose report is a signal in the watcher's inbox
// (Erlang's monitor and its 'DOWN' message, typed by the watcher's
// signal). An actor that ended before the call is reported too. The wait
// runs on a task the watcher owns, as a Feed's source does: it ends when
// the watcher ends, so a watcher that ended first gets nothing and holds
// nothing. It fails Stopped when the watcher has ended or its Stop was
// requested.
func Watch[S, E, O, F, S2, E2, D2, F2](watcher Actor[S2, E2, D2, F2], a Actor[S, E, Decision[S, O], F], toSignal own func(x Exit[S, O, F]) E2) fails Stopped {
	try feed(watcher, func(send func(e E2)) {
		send(toSignal(ExitOf(a)))
	})
}

// exitCode is an exit as a number: 1 Finished, 2 Halted, 3 Failed, 4
// Defected.
func exitCode[F](x Exit[int, int, F]) int {
	match x {
	case Finished[int, int]:
		1
	case Halted[int]:
		2
	case Failed[F]:
		3
	case Defected:
		4
	}
}

// WatchSeesTheEnd: a watcher gets the exit of the actor it watches as one
// signal, whether the actor ends after the Watch or had ended before it.
law WatchSeesTheEnd(signals []int, before bool) {
	with context { Scheduler: time.NewManual(0) } {
		watched(signals, before)
	}
}

// watched: a log actor watches a tally actor that was sent signals; the
// tally ends (Done, or the Stop after the signals) before or after the
// Watch, and the log's one signal is the tally's exit code.
func watched(signals []int, before bool) bool needs Scheduler {
	let log = StartMachine(Machine[[]int, int, int]{Initial: []int{}, Step: logStep, After: logUntimed, Work: logUnworked, Exit: logUnexited}, 1, func(o int) {})
	watchedBy(log, sent(signals), before)
}

// watchedBy: log watches a, which ends before or after the Watch.
func watchedBy[F](log Actor[[]int, int, Decision[[]int, int]], a Actor[int, int, Decision[int, int], F], before bool) bool needs Scheduler {
	if before {
		a.Stop() catch {
		case _:
		}
	}
	Watch(log, a, func(x Exit[int, int, F]) int { exitCode(x) }) catch {
	case Stopped:
		return false
	}
	if !before {
		a.Stop() catch {
		case _:
		}
	}
	let want = exitCode(ExitOf(a))
	let got = WaitFor(log, func(s []int) bool { len(s) >= 1 }) catch {
	case Stopped:
		return false
	}
	log.Stop()
	len(got) == 1 && got[0] == want
}

// Registry names live actors of one type by a typed key: no name is a
// string the program spells twice, and no registry is ambient (a program
// makes one and passes it). An actor leaves it when it ends: once Ended of
// a registered actor is true, Lookup of its key is None and the key is
// free. Its values are copies of one registry.
type Registry[K comparable, S, E, D, F] {
	entries sync.Ref[Map[K, registered[S, E, D, F]]],
	next    sync.Ref[int],
}

// registered is an actor in a registry, with the number of its Register,
// so the end of an actor removes its own entry and never a later one.
type registered[S, E, D, F] {
	Actor Actor[S, E, D, F],
	N     int,
}

// Taken is the failure of Register when a live actor holds the key.
type Taken {}

// NewRegistry is an empty registry.
func NewRegistry[K comparable, S, E, D, F]() Registry[K, S, E, D, F] {
	Registry[K, S, E, D, F]{
		entries: sync.NewRef[Map[K, registered[S, E, D, F]]](Map[K, registered[S, E, D, F]]{}),
		next:    sync.NewRef[int](0),
	}
}

// Register names a by k. It fails Taken while another live actor holds k,
// and Stopped when a has ended (it then names nothing). The entry is
// removed by an end action of a (OnEnd), so before Stop, Drain or ExitOf
// of a returns, and a registry runs no task of its own; Lookup and
// Register never take an ended actor's entry as live (Ended).
func Register[K comparable, S, E, D, F](r Registry[K, S, E, D, F], k K, a Actor[S, E, D, F]) fails Taken | Stopped {
	let _ = Lookup(r, k)
	let n = sync.Modify(r.next, func(v int) (int, int) { (v + 1, v + 1) })
	let free = sync.Modify(r.entries, func(m Map[K, registered[S, E, D, F]]) (bool, Map[K, registered[S, E, D, F]]) {
		match m.Get(k) {
		case Some[registered[S, E, D, F]]:
			(false, m)
		case None:
			(true, m.Put(k, registered[S, E, D, F]{Actor: a, N: n}))
		}
	})
	if !free {
		return Taken
	}
	let entries = r.entries
	OnEnd(a, func() {
		entries.Update(func(m Map[K, registered[S, E, D, F]]) Map[K, registered[S, E, D, F]] { unregistered(m, k, n) })
	}) catch {
	case Stopped:
		entries.Update(func(m Map[K, registered[S, E, D, F]]) Map[K, registered[S, E, D, F]] { unregistered(m, k, n) })
		return Stopped
	}
}

// unregistered is m without k's entry when that entry is the n-th
// Register's.
func unregistered[K comparable, S, E, D, F](m Map[K, registered[S, E, D, F]], k K, n int) Map[K, registered[S, E, D, F]] {
	match m.Get(k) {
	case Some[registered[S, E, D, F]] as e:
		if e.Value.N == n {
			return m.Delete(k)
		}
		m
	case None:
		m
	}
}

// Lookup is the actor that k names, None when no live actor holds it (an
// entry whose actor has ended is dropped here). It never waits, so an
// actor's own step may look itself up.
func Lookup[K comparable, S, E, D, F](r Registry[K, S, E, D, F], k K) Option[Actor[S, E, D, F]] {
	match r.entries.Get().Get(k) {
	case Some[registered[S, E, D, F]] as e:
		if Ended(e.Value.Actor) {
			let n = e.Value.N
			r.entries.Update(func(m Map[K, registered[S, E, D, F]]) Map[K, registered[S, E, D, F]] { unregistered(m, k, n) })
			return None
		}
		Some[Actor[S, E, D, F]]{Value: e.Value.Actor}
	case None:
		None
	}
}

// LookupFromOwnStep: an actor's own step looks up the key it is
// registered by and finds it, without waiting.
law LookupFromOwnStep(k int) {
	with context { Scheduler: time.NewManual(0) } {
		selfLookup(k)
	}
}

// selfLookup registers an actor whose step counts the signals it stepped
// while Lookup of k found an actor, sends it one signal and waits for it.
func selfLookup(k int) bool needs Scheduler {
	let r = NewRegistry[int, int, int, Decision[int, int]]()
	let step = func(s int, e int) Decision[int, int] {
		match Lookup(r, k) {
		case Some[Actor[int, int, Decision[int, int]]]:
			Stay[int]{Next: s + 1}
		case None:
			Stay[int]{Next: s - 1}
		}
	}
	let a = StartMachine(Machine[int, int, int]{Initial: 0, Step: step, After: untimed, Work: unworked, Exit: unexited}, 1, func(o int) {})
	Register(r, k, a) catch {
	case Taken, Stopped:
		a.Stop()
		return false
	}
	a.Send(1) catch {
	case Stopped:
		return false
	}
	let s = WaitFor(a, func(s int) bool { s != 0 }) catch {
	case Stopped:
		return false
	}
	a.Stop()
	s == 1
}

// RegistryDropsTheEnded: a registered actor is found by its key and the
// key is taken; once it has ended (a Stop, or a Done among its signals),
// its key names nothing and a new actor may take it.
law RegistryDropsTheEnded(signals []int, k int) {
	with context { Scheduler: time.NewManual(0) } {
		registryDrops(signals, k)
	}
}

// registryDrops registers a tally actor that was sent signals under k,
// stops it, and registers a second one under k.
func registryDrops(signals []int, k int) bool needs Scheduler {
	let r = NewRegistry[int, int, int, Decision[int, int]]()
	let a = StartMachine(tally(), 1, func(o int) {})
	Register(r, k, a) catch {
	case Taken, Stopped:
		a.Stop()
		return false
	}
	let found = named(r, k)
	let b = StartMachine(tally(), 1, func(o int) {})
	let mut taken = false
	Register(r, k, b) catch {
	case Taken:
		taken = true
	case Stopped:
	}
	for e in signals {
		a.Send(e) catch {
		case Stopped:
		}
	}
	a.Stop()
	let gone = !named(r, k)
	Register(r, k, b) catch {
	case Taken, Stopped:
		b.Stop()
		return false
	}
	let back = named(r, k)
	// b ends right after its Register: the entry is removed by the end
	// itself (OnEnd), not only hidden by Lookup.
	b.Stop()
	found && taken && gone && back && !held(r, k)
}

// held is whether r holds an entry for k, live or not: what the end of
// the actor removed, read without Lookup's own drop.
func held(r Registry[int, int, int, Decision[int, int]], k int) bool {
	match r.entries.Get().Get(k) {
	case Some[registered[int, int, Decision[int, int]]]:
		true
	case None:
		false
	}
}

// named is whether k names an actor in r.
func named(r Registry[int, int, int, Decision[int, int]], k int) bool {
	match Lookup(r, k) {
	case Some[Actor[int, int, Decision[int, int]]]:
		true
	case None:
		false
	}
}

// Latest is the decision of the last signal a stepped (a Reject and an
// Ignore included; a dropped timer or work signal is not stepped), None
// before the first. It does not wait.
func Latest[S, E, D, F](a Actor[S, E, D, F]) Option[D] {
	if hasLatest(a) {
		Some[D]{Value: latest(a)}
	} else {
		None
	}
}

// Shown is the state a showed last, the one a Changes loop was given
// last, and its version: how many states a has shown, 1 for its first and
// one more for each state it commits after (each Enter, Stay, Emit and
// Tell; an entry with hosts and a work shows its state once). A watcher
// that redraws compares versions, so it redraws once per change, never
// twice for one (VersionCountsCommits). It does not wait: the state is
// the one shown, not the one after every signal admitted (State).
func Shown[S, E, D, F](a Actor[S, E, D, F]) (S, int) { shown(a) }

// Version is the version of the state a showed last (Shown).
func Version[S, E, D, F](a Actor[S, E, D, F]) int {
	let (_, v) = shown(a)
	v
}

// VersionCountsCommits: an actor's version counts the states it shows,
// one per commit, so a watcher that redraws when the version moved
// redraws once per change; Shown gives the state with its version.
law VersionCountsCommits(signals []int) {
	with context { Scheduler: time.NewManual(0) } {
		versioned(signals)
	}
}

// versioned: a tally actor asked each signal shows one version more for
// each decision that commits (Enter, Stay, Emit; tally has no Tell, work
// or hosts) and none for an Ignore or a Reject, starting at 1 for its
// first state; Shown's state is the actor's State. It stops at a Done.
func versioned(signals []int) bool needs Scheduler {
	let a = StartMachine(tally(), 1, func(o int) {})
	let _ = a.State()
	let mut want = 1
	for e in signals {
		let d = a.Ask(e) catch {
		case Stopped:
			a.Stop()
			return false
		}
		match d {
		case Done[int]:
			a.Stop()
			return Version(a) == want
		case Ignore, Reject:
		case _:
			want = want + 1
		}
		let (s, v) = Shown(a)
		if v != want || s != a.State() {
			a.Stop()
			return false
		}
	}
	a.Stop()
	true
}

// Select is f of each state of changes, with each value equal (==) to
// the one before it dropped: a view of one part of the state that changes
// only when that part does. Select(a.LatestChanges(), f) gives f of the state
// at its start first.
func Select[S, T comparable](changes Seq[S], f own func(s S) T) Seq[T] {
	SelectBy(changes, f, func(x T, y T) bool { x == y })
}

// SelectOncePerChange: Select gives f of each value, with each value
// equal to the one before it dropped.
law SelectOncePerChange(xs []int) {
	let mut want = []int{}
	for x in xs {
		if len(want) == 0 || want[len(want)-1] != x%3 {
			want = want.Append(x % 3)
		}
	}
	let mut got = []int{}
	for v in Select(Seq[int](func(yield func(v int) bool) {
		for x in xs {
			if !yield(x) {
				return
			}
		}
	}), func(x int) int { x % 3 }) {
		got = got.Append(v)
	}
	let mut same = len(got) == len(want)
	for i in 0..len(got) {
		same = same && got[i] == want[i]
	}
	same
}

// SelectStops: Select is a Seq that stops.
law SelectStops(xs []int) {
	selectStops(Select(source(xs), func(x int) int { x % 3 }))
}

// selectStops: s is a Seq that stops (stdlib.md, Std laws 5): with n the
// count of its values, a yield that returns false at its k-th call (k
// from 1 to n+1) is called min(k, n) times.
func selectStops(s Seq[int]) bool {
	let mut n = 0
	s(func(v int) bool {
		n = n + 1
		true
	})
	for k in 1..n+2 {
		let mut calls = 0
		s(func(v int) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// SelectBy is Select with the equality same.
func SelectBy[S, T](changes Seq[S], f own func(s S) T, same own func(x T, y T) bool) Seq[T] {
	Seq[T](func(yield func(v T) bool) {
		let mut prev = []T{}
		for s in changes {
			let v = f(s)
			if len(prev) == 1 && same(prev[0], v) {
				continue
			}
			prev = []T{v}
			if !yield(v) {
				return
			}
		}
	})
}

// SelectByStops: SelectBy is a Seq that stops.
law SelectByStops(xs []int) {
	selectStops(SelectBy(source(xs), func(x int) int { x % 3 }, func(a int, b int) bool { a == b }))
}

// exitKind waits until a has ended and gives how: 0 Finished, 1 Halted,
// 2 Failed, 3 Defected. final is the Done that ended it (kind 0), failure
// fails with its typed failure (kind 2), and hasLatest and latest are
// the decision of its last step.
extern go ergo.local/prototype/runtime/v1.ActorExitKind func exitKind[S, E, D, F](a Actor[S, E, D, F]) int

extern go ergo.local/prototype/runtime/v1.ActorFinal func final[S, E, D, F](a Actor[S, E, D, F]) D

extern go ergo.local/prototype/runtime/v1.ActorFailure func failure[S, E, D, F](a Actor[S, E, D, F]) fails F

// defectOf is the text of the defect that ended a (kind 3).
extern go ergo.local/prototype/runtime/v1.ActorDefectReason func defectOf[S, E, D, F](a Actor[S, E, D, F]) string

extern go ergo.local/prototype/runtime/v1.ActorHasLatest func hasLatest[S, E, D, F](a Actor[S, E, D, F]) bool

extern go ergo.local/prototype/runtime/v1.ActorLatest func latest[S, E, D, F](a Actor[S, E, D, F]) D

// shown is the state a showed last and its version, read together.
extern go ergo.local/prototype/runtime/v1.ActorShown func shown[S, E, D, F](a Actor[S, E, D, F]) (S, int)
