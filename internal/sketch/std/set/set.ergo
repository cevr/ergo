// Package set holds Set, a value set of comparable keys (std-spike D1):
// Effect's HashSet with Go's map underneath, as a Go programmer writes
// map[K]struct{}. A Set is a value, as a Map is (types.md, Bindings): Add
// and Remove return a new Set, and a copy never sees a later change.

import slices

// Set is a set of keys of K, with no order.
type Set[K comparable] { items Map[K, bool] }

// New is the empty Set.
func New[K comparable]() Set[K] { Set[K]{items: Map[K, bool]{}} }

// Of is the Set of the elements of xs, each once (Effect HashSet.fromIterable).
func Of[K comparable](xs []K) Set[K] {
	let mut items = Map[K, bool]{}
	for x in xs {
		items[x] = true
	}
	Set[K]{items: items}
}

// Add is s with k (Effect HashSet.add).
func Add[K comparable](s Set[K], k K) Set[K] {
	let mut items = s.items
	items[k] = true
	Set[K]{items: items}
}

// Remove is s without k (Effect HashSet.remove).
func Remove[K comparable](s Set[K], k K) Set[K] { Set[K]{items: s.items.Delete(k)} }

// Has reports whether s holds k (Effect HashSet.has).
func Has[K comparable](s Set[K], k K) bool { s.items.Get(k) != None }

// Len is the number of keys s holds (Effect HashSet.size).
func Len[K comparable](s Set[K]) int { len(s.items) }

// Values is the keys of s, each once, in an unspecified order, as a for
// over a Map is.
func Values[K comparable](s Set[K]) Seq[K] {
	Seq[K](func(yield func(k K) bool) {
		for k, _ in s.items {
			if !yield(k) {
				return
			}
		}
	})
}

// SetValuesStops: Values is a Seq that stops when yield says so, as maps'
// Keys is.
law SetValuesStops(xs []int) {
	let s = Values(Of(xs))
	let n = Len(Of(xs))
	for k in 1..n+2 {
		let mut calls = 0
		s(func(v int) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// Sorted is the keys of s in ascending order.
func Sorted[K ordered](s Set[K]) []K { slices.Sorted(Values(s)) }

// AddHasRemoveHasNot: after Add, s holds k and every key it held; after
// Remove, it does not hold k and holds every other key it held; s itself
// is unchanged.
law AddHasRemoveHasNot(xs []int, k int) {
	let s = Of(xs)
	let added = Add(s, k)
	let removed = Remove(s, k)
	let mut ok = Has(added, k) && !Has(removed, k) && Has(s, k) == slices.Contains(xs, k)
	for x in xs {
		ok = ok && Has(s, x) && Has(added, x) && Has(removed, x) == (x != k)
	}
	ok && Len(s) == len(slices.Dedupe(xs))
}

// Union is the keys in a or in b (Effect HashSet.union).
func Union[K comparable](a Set[K], b Set[K]) Set[K] {
	let mut items = a.items
	for k, _ in b.items {
		items[k] = true
	}
	Set[K]{items: items}
}

// Intersection is the keys in both a and b (Effect HashSet.intersection).
func Intersection[K comparable](a Set[K], b Set[K]) Set[K] {
	let mut items = Map[K, bool]{}
	for k, _ in a.items {
		if b.items.Get(k) != None {
			items[k] = true
		}
	}
	Set[K]{items: items}
}

// Difference is the keys in a and not in b (Effect HashSet.difference).
func Difference[K comparable](a Set[K], b Set[K]) Set[K] {
	let mut items = Map[K, bool]{}
	for k, _ in a.items {
		if b.items.Get(k) == None {
			items[k] = true
		}
	}
	Set[K]{items: items}
}

// IsSubset reports whether every key of a is in b (Effect
// HashSet.isSubset).
func IsSubset[K comparable](a Set[K], b Set[K]) bool {
	for k, _ in a.items {
		if b.items.Get(k) == None {
			return false
		}
	}
	true
}

// Equal reports whether a and b hold the same keys.
func Equal[K comparable](a Set[K], b Set[K]) bool { Len(a) == Len(b) && IsSubset(a, b) }

// SetAlgebra: a key is in Union, Intersection and Difference as the
// truth tables of or, and and and-not say; Union commutes; a is the
// Union of its Difference with b and its Intersection with b, which share
// no key.
law SetAlgebra(xs []int, ys []int, k int) {
	let a = Of(xs)
	let b = Of(ys)
	let inA = Has(a, k)
	let inB = Has(b, k)
	let d = Difference(a, b)
	let i = Intersection(a, b)
	Has(Union(a, b), k) == (inA || inB) && Has(i, k) == (inA && inB) && Has(d, k) == (inA && !inB) && Equal(Union(a, b), Union(b, a)) && Equal(Union(d, i), a) && Len(Intersection(d, i)) == 0 && IsSubset(i, a) && IsSubset(i, b)
}
