// Package maps reads Maps (docs/spec/stdlib.md, Slices and Maps;
// std-align S2a). It follows Go's maps package: Keys and Values are Seqs,
// in an unspecified order, as a for over a Map is (types.md, Loops and len
// 1). slices.Sorted(maps.Keys(m)) gives the keys in a fixed order. Clone
// binds a runtime/v1 body; the rest is Ergo source.

// Clone is a new Map with the keys and values of m: Go's maps.Clone. A
// write to the clone never reaches m.
extern go ergo.local/prototype/runtime/v1.MapsClone func Clone[K comparable, V](m Map[K, V]) Map[K, V]

// GetOr is the value of k in m, or def when m has no key k: Effect's
// HashMap.get then Option.getOrElse, and Go's comma-ok read with a
// default.
func GetOr[K comparable, V](m Map[K, V], k K, def V) V {
	match m.Get(k) {
	case Some[V] as v:
		v.Value
	case None:
		def
	}
}

// Update sets the value of k in m to f of its value now: Some of it, or
// None when m has no key k (Effect's HashMap.modifyAt, an upsert), and
// returns the result. m is a value (types.md, Bindings), so the caller's m
// is unchanged, as the prelude's Delete leaves its argument: write
// m = maps.Update(m, k, f). f runs once; its failure ends Update with it.
func Update[K comparable, V, E, R](m Map[K, V], k K, f func(old Option[V]) V fails E needs R) Map[K, V] fails E needs R {
	let v = try f(m.Get(k))
	let mut out = m
	out[k] = v
	out
}

// Keys is the keys of m, each once, in an unspecified order.
func Keys[K comparable, V](m Map[K, V]) Seq[K] {
	Seq[K](func(yield func(k K) bool) {
		for k, _ in m {
			if !yield(k) {
				return
			}
		}
	})
}

// Values is the values of m, one per key, in an unspecified order.
func Values[K comparable, V](m Map[K, V]) Seq[V] {
	Seq[V](func(yield func(v V) bool) {
		for v in m {
			if !yield(v) {
				return
			}
		}
	})
}

// KeysVisitEachKeyOnce: Keys yields each key of m exactly once.
law KeysVisitEachKeyOnce(m Map[string, int]) {
	let mut seen = Map[string, bool]{}
	for k in Keys(m) {
		if seen.Get(k) != None || m.Get(k) == None {
			return false
		}
		seen[k] = true
	}
	len(seen) == len(m)
}

// ValuesMatchKeys: Values yields one value per key, and their sum is the
// sum of the values of the keys.
law ValuesMatchKeys(m Map[string, int]) {
	let mut total = 0
	for k in Keys(m) {
		match m.Get(k) {
		case Some[int] as v:
			total = total + v.Value
		case None:
			return false
		}
	}
	let mut sum = 0
	let mut n = 0
	for v in Values(m) {
		sum = sum + v
		n = n + 1
	}
	n == len(m) && sum == total
}

// KeysStops: Keys is a Seq that stops (stdlib.md, Std laws 5): for each k
// from 1 to len(m)+1, a yield that returns false at its k-th call is
// called min(k, len(m)) times.
law KeysStops(m Map[string, int]) {
	let s = Keys(m)
	let n = len(m)
	for k in 1..n+2 {
		let mut calls = 0
		s(func(key string) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// CloneIsIndependent: Clone has the keys and values of m, and a write to
// the clone leaves m as it was.
law CloneIsIndependent(m Map[string, int], k string) {
	let size = len(m)
	let had = m.Get(k)
	let mut c = Clone(m)
	let mut same = len(c) == size
	for key, v in m {
		same = same && c.Get(key) == Some[int]{Value: v}
	}
	c[k] = 7
	same && len(m) == size && m.Get(k) == had
}

// UpdateSeesTheOldValue: Update gives f the value of k now, None for a
// missing key, and k then holds f's result.
law UpdateSeesTheOldValue(m Map[string, int], k string, v int) {
	let before = m.Get(k)
	let mut seen Option[int] = Some[int]{Value: v + 1}
	let out = Update(Clone(m), k, func(old Option[int]) int {
		seen = old
		v
	})
	let grew = if before == None { 1 } else { 0 }
	seen == before && out.Get(k) == Some[int]{Value: v} && len(out) == len(m)+grew
}

// GetOrDefaults: GetOr is the value of k when m has one, and def
// otherwise.
law GetOrDefaults(m Map[string, int], k string, def int) {
	match m.Get(k) {
	case Some[int] as v:
		GetOr(m, k, def) == v.Value
	case None:
		GetOr(m, k, def) == def
	}
}

// ValuesStops: Values is a Seq that stops, as Keys is.
law ValuesStops(m Map[string, int]) {
	let s = Values(m)
	let n = len(m)
	for k in 1..n+2 {
		let mut calls = 0
		s(func(v int) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}
