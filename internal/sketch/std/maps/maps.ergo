// Package maps reads Maps (docs/spec/stdlib.md, Slices and Maps;
// std-align S2a). It follows Go's maps package: Keys and Values are Seqs,
// in an unspecified order, as a for over a Map is (types.md, Loops and len
// 1). slices.Sorted(maps.Keys(m)) gives the keys in a fixed order. It is
// Ergo source; Clone is the Map operation m.Clone() (PRIM-4).

import core
import option

// Hashing is the hash and equality contract for Map keys.
//
// ergo:alias Hashing
type Hashing[K comparable] {}

// Structural is the default Hashing provider for comparable keys.
//
// ergo:alias Structural
type Structural[K comparable] {}

// Hash returns a uint64 hash of k such that a == b implies Hash(a) == Hash(b).
//
// ergo:builtin hash
func Hash[K comparable](k K) uint64 { hash(k) }

// Clone is a new Map with the keys and values of m: Go's maps.Clone. A
// write to the clone never reaches m.
func Clone[K comparable, V](m Map[K, V]) Map[K, V] { m.Clone() }

// Using is an empty Map whose provider is by: the Map of a provider with
// fields, such as a seeded hash, which has no default (types.md, Maps 3).
// Rust's HashMap::with_hasher.
func Using[K comparable, V any, H Hashing[K]](by H) Map[K, V, H] { MakeMap[K, V, H](by) }

// GetOr is the value of k in m, or def when m has no key k: Effect's
// HashMap.get then Option.getOrElse, and Go's comma-ok read with a
// default.
func GetOr[K comparable, V](m Map[K, V], k K, def V) V {
	match m.Get(k) {
	case option.Some[V] as v:
		v.Value
	case option.None:
		def
	}
}

// Update sets the value of k in m to f of its value now: Some of it, or
// None when m has no key k (Effect's HashMap.modifyAt, an upsert), and
// returns the result. m is a value (types.md, Bindings), so the caller's m
// is unchanged, as the prelude's Delete leaves its argument: write
// m = maps.Update(m, k, f). f runs once; its failure ends Update with it.
func Update[K comparable, V, E, R](m Map[K, V], k K, f func(old option.Option[V]) V fails E needs R) Map[K, V] fails E needs R {
	let v = try f(m.Get(k))
	let mut out = m
	out[k] = v
	out
}

// Keys is the keys of m, each once, in an unspecified order.
func Keys[K comparable, V](m Map[K, V]) core.Seq[K] {
	core.Seq[K](func(yield func(k K) bool) {
		for k, _ in m {
			if !yield(k) {
				return
			}
		}
	})
}

// Values is the values of m, one per key, in an unspecified order.
func Values[K comparable, V](m Map[K, V]) core.Seq[V] {
	core.Seq[V](func(yield func(v V) bool) {
		for v in m {
			if !yield(v) {
				return
			}
		}
	})
}

// KeysVisitEachKeyOnce: Keys yields each key of m exactly once.
law KeysVisitEachKeyOnce(m Map[string, int]) {
	let mut seen = Map[string, bool]{}
	for k in Keys(m) {
		if seen.Get(k) != option.None || m.Get(k) == option.None {
			return false
		}
		seen[k] = true
	}
	seen.Len() == m.Len()
}

// ValuesMatchKeys: Values yields one value per key, and their sum is the
// sum of the values of the keys.
law ValuesMatchKeys(m Map[string, int]) {
	let mut total = 0
	for k in Keys(m) {
		match m.Get(k) {
		case option.Some[int] as v:
			total = total + v.Value
		case option.None:
			return false
		}
	}
	let mut sum = 0
	let mut n = 0
	for v in Values(m) {
		sum = sum + v
		n = n + 1
	}
	n == m.Len() && sum == total
}

// KeysStops: Keys is a Seq that stops (stdlib.md, Std laws 5): for each k
// from 1 to len(m)+1, a yield that returns false at its k-th call is
// called min(k, len(m)) times.
law KeysStops(m Map[string, int]) {
	let s = Keys(m)
	let n = m.Len()
	for k in 1..n+2 {
		let mut calls = 0
		s(func(key string) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// CloneIsIndependent: Clone has the keys and values of m, and a write to
// the clone leaves m as it was.
law CloneIsIndependent(m Map[string, int], k string) {
	let size = m.Len()
	let had = m.Get(k)
	let mut c = Clone(m)
	let mut same = c.Len() == size
	for key, v in m {
		same = same && c.Get(key) == option.Some[int]{Value: v}
	}
	c[k] = 7
	same && m.Len() == size && m.Get(k) == had
}

// UpdateSeesTheOldValue: Update gives f the value of k now, None for a
// missing key, and k then holds f's result.
law UpdateSeesTheOldValue(m Map[string, int], k string, v int) {
	let before = m.Get(k)
	let mut seen option.Option[int] = option.Some[int]{Value: v + 1}
	let out = Update(Clone(m), k, func(old option.Option[int]) int {
		seen = old
		v
	})
	let grew = if before == option.None { 1 } else { 0 }
	seen == before && out.Get(k) == option.Some[int]{Value: v} && out.Len() == m.Len()+grew
}

// GetOrDefaults: GetOr is the value of k when m has one, and def
// otherwise.
law GetOrDefaults(m Map[string, int], k string, def int) {
	match m.Get(k) {
	case option.Some[int] as v:
		GetOr(m, k, def) == v.Value
	case option.None:
		GetOr(m, k, def) == def
	}
}

// ValuesStops: Values is a Seq that stops, as Keys is.
law ValuesStops(m Map[string, int]) {
	let s = Values(m)
	let n = m.Len()
	for k in 1..n+2 {
		let mut calls = 0
		s(func(v int) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}
