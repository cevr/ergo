import fs
import sync

// Recorder is an fs.Root that passes each operation to the Root it wraps
// and keeps every path it is asked for, in order: a test sees what a
// reader of a Root asks, such as the names http.Files reads. Its copies
// share one record. NewRecorder is its one constructor.
type Recorder { inner fs.Root, paths sync.Ref[[]string] }

// NewRecorder is a Recorder of inner that has seen no path yet.
func NewRecorder(inner fs.Root) Recorder {
	Recorder{inner: inner, paths: sync.NewRef[[]string]([]string{})}
}

// Paths is every path r was asked for, in order.
func Paths(r Recorder) []string {
	sync.Modify(r.paths, func(ps []string) ([]string, []string) { (ps, ps) })
}

// note adds path to the paths of r.
func note(r Recorder, path string) {
	sync.Modify(r.paths, func(ps []string) (bool, []string) { (true, ps.Append(path)) })
}

// Name is "recorder": a Recorder names itself, as a Root in memory does,
// and notes no path.
func Name(_ Recorder) string { "recorder" }

// ReadFile is the inner Root's ReadFile of path, after noting path.
func ReadFile(r Recorder, path string) string fails fs.NotFound | fs.Denied | fs.Failed | fs.Escapes {
	note(r, path)
	try r.inner.ReadFile(path)
}

// ReadDir is the inner Root's ReadDir of path, after noting path.
func ReadDir(r Recorder, path string) []string fails fs.NotFound | fs.Denied | fs.Failed | fs.Escapes {
	note(r, path)
	try r.inner.ReadDir(path)
}

// Stat is the inner Root's Stat of path, after noting path.
func Stat(r Recorder, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed | fs.Escapes {
	note(r, path)
	try r.inner.Stat(path)
}
