// The laws of fs's tree functions (Walk, RemoveAll, MkdirTemp, Scratch)
// over a Memory: each builds its tree from the generated paths, so a law
// reads no disk.

import filepath
import fs
import option
import strings

// grown is a new Memory with a file "x" at each of paths that can hold
// one, its directories made first; a path that cannot is left out.
func grown(paths []string) Memory {
	let m = NewMemory()
	for p in paths {
		m.MkdirAll(filepath.Dir(p)) catch {
		case fs.Denied, fs.Failed:
		}
		m.WriteFile(p, "x") catch {
		case fs.NotFound, fs.Denied, fs.Failed:
		}
	}
	m
}

// under reports whether the cleaned path q is p or below it.
func under(q string, p string) bool { q == p || strings.HasPrefix(q, p+"/") }

// WalkVisitsEachOnce: a walk of "." lists "." first and every path once,
// each after its directory, and lists every file the tree holds.
law WalkVisitsEachOnce(paths []string) {
	let m = grown(paths)
	with context { fs.Files: m, fs.Writes: m } {
		let walked = try fs.Walk(".")
		if walked.Len() == 0 || walked[0] != "." {
			return false
		}
		let mut seen = Map[string, int]{}
		let mut i = 0
		for w in walked {
			if seen.Get(w) != option.None {
				return false
			}
			if i > 0 && seen.Get(filepath.Dir(w)) == option.None {
				return false
			}
			seen[w] = i
			i = i + 1
		}
		for p in paths {
			let info = m.Stat(p) catch {
			case fs.NotFound, fs.Denied, fs.Failed:
				continue
			}
			if !info.Dir && seen.Get(filepath.Clean(p)) == option.None {
				return false
			}
		}
		true
	}
}

// RemoveAllTouchesOnlyPath: RemoveAll of a path of the tree leaves
// nothing at or below it and every other path of the tree where it was.
law RemoveAllTouchesOnlyPath(paths []string, pick int) {
	let m = grown(paths)
	with context { fs.Files: m, fs.Writes: m } {
		let before = try fs.Walk(".")
		let target = before[(pick%before.Len()+before.Len())%before.Len()]
		if target == "." {
			return true
		}
		try fs.RemoveAll(target)
		for q in before {
			let _ = m.Lstat(q) catch {
			case fs.NotFound:
				if !under(q, target) {
					return false
				}
				continue
			case fs.Denied, fs.Failed:
				return false
			}
			if under(q, target) {
				return false
			}
		}
		true
	}
}

// MkdirTempIsNew: two MkdirTemp in one directory give two new empty
// directories in it.
law MkdirTempIsNew(paths []string, prefix string) {
	if strings.Contains(prefix, "/") {
		return true
	}
	let m = grown(paths)
	with context { fs.Files: m, fs.Writes: m } {
		let a = try fs.MkdirTemp(".", prefix)
		let b = try fs.MkdirTemp(".", prefix)
		let inA = try fs.Walk(a)
		let inB = try fs.Walk(b)
		a != b && filepath.Dir(a) == "." && filepath.Dir(b) == "." && inA.Len() == 1 && inB.Len() == 1
	}
}

// ScratchIsRemoved: a Scratch is gone, with what was written in it, once
// its owner's scope ends.
law ScratchIsRemoved(name string) {
	if name == "" || strings.Contains(name, "/") || name == "." || name == ".." {
		return true
	}
	let m = NewMemory()
	let made = func() string fails fs.NotFound | fs.Denied | fs.Failed {
		let s = try fs.NewScratch(m, m, ".", "t")
		try m.WriteFile(filepath.Join([]string{s.Path, name}), "x")
		s.Path
	}
	let path = try made()
	let _ = m.Lstat(path) catch {
	case fs.NotFound:
		return true
	case fs.Denied, fs.Failed:
		return false
	}
	false
}

// ScanAgreesWithWalk: fs.Scan with default options visits the exact same paths
// in the exact same deterministic order as fs.Walk with zero errors and
// matching non-following Entry metadata.
law ScanAgreesWithWalk(paths []string) {
	let m = grown(paths)
	with context { fs.Files: m, fs.Writes: m, fs.Entries: m, fs.Scans: m } {
		let walked = fs.Walk(".") catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		let scanned = fs.Scan(".", fs.DefaultScanOptions()) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		if scanned.Paths != walked || scanned.Errors.Len() != 0 {
			return false
		}
		for i in 0..scanned.Len() {
			let single = m.ReadEntry(scanned.Paths[i]) catch {
			case fs.NotFound, fs.Denied, fs.Failed:
				return false
			}
			let got = fs.EntryAt(scanned, uint32(i))
			if got.Kind != single.Kind || got.Size != single.Size || got.AllocatedBytes != single.AllocatedBytes || got.ID != single.ID {
				return false
			}
		}
		true
	}
}

// ScanOneFileSystemStaysOnRootDev: with OneFileSystem enabled, fs.Scan stays
// on the root device and never crosses mount boundaries, while OneFileSystem
// disabled visits mounted subtrees on distinct devices.
law ScanOneFileSystemStaysOnRootDev(name string) {
	let leaf = if name == "" || name == "." || name == ".." || strings.Contains(name, "/") { "item.txt" } else { name }
	let m = NewVolumes([]string{"/", "/mnt"})
	m.MkdirAll("/sub") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	m.MkdirAll("/mnt") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	m.WriteFile("/root.txt", "a") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	m.WriteFile("/sub/"+leaf, "bb") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	m.WriteFile("/mnt/external.txt", "cccc") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	with context { fs.Files: m, fs.Writes: m, fs.Entries: m, fs.Scans: m } {
		let sameDev = fs.Scan("/", fs.ScanOptions{OneFileSystem: true, MaxDepth: -1}) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		if sameDev.Len() == 0 || sameDev.Errors.Len() != 0 {
			return false
		}
		let rootDev = sameDev.Devs[0]
		for i in 0..sameDev.Len() {
			if sameDev.Devs[i] != rootDev || under(sameDev.Paths[i], "/mnt") {
				return false
			}
		}
		let crossDev = fs.Scan("/", fs.ScanOptions{OneFileSystem: false, MaxDepth: -1}) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		let mut sawMounted = false
		for p in crossDev.Paths {
			if p == "/mnt/external.txt" {
				sawMounted = true
			}
		}
		let wantSame = []string{"/", "/root.txt", "/sub", "/sub/" + leaf}
		sameDev.Paths == wantSame && sawMounted
	}
}

// ScanBoundedDepthAndParents: bounded scans stay within MaxDepth, preserve
// dense parent invariants (Parents[i] < i), and keep SoA totals exact.
law ScanBoundedDepthAndParents(paths []string, maxDepth int) {
	let limit = ((maxDepth%5 + 5) % 5) - 1
	let m = grown(paths)
	m.MkdirAll("_d1/_d2") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	m.WriteFile("_d1/_d2/leaf.txt", "depth2") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	with context { fs.Files: m, fs.Writes: m, fs.Entries: m, fs.Scans: m } {
		let buf = fs.Scan(".", fs.ScanOptions{OneFileSystem: false, MaxDepth: limit}) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		if buf.Len() == 0 || buf.Parents[0] != fs.NoParent || buf.Depths[0] != uint32(0) {
			return false
		}
		let mut sawLeaf = false
		let mut sizeSum = 0
		let mut allocSum = 0
		for i in 0..buf.Len() {
			if buf.Paths[i] == "_d1/_d2/leaf.txt" {
				sawLeaf = true
			}
			if limit >= 0 && int(buf.Depths[i]) > limit {
				return false
			}
			if i > 0 {
				let p = int(buf.Parents[i])
				if p < 0 || p >= i || buf.Depths[i] != buf.Depths[p]+uint32(1) {
					return false
				}
			}
			if !buf.Duplicates[i] {
				allocSum = allocSum + buf.AllocBytes[i]
				let isDir = match buf.Kinds[i] {
				case fs.DirEntry:
					true
				case fs.FileEntry, fs.SymlinkEntry, fs.OtherEntry:
					false
				}
				if !isDir {
					sizeSum = sizeSum + buf.Sizes[i]
				}
			}
		}
		let depthOK = if limit < 0 || limit >= 3 { sawLeaf } else { !sawLeaf }
		depthOK && buf.TotalSize == sizeSum && buf.TotalAlloc == allocSum && buf.Errors.Len() == 0
	}
}

// ScanBufferResetMatchesFresh: reusing a ScanBuffer via ScanInto across
// distinct trees leaves no stale rows and agrees with fresh Scan calls.
law ScanBufferResetMatchesFresh(first []string, second []string) {
	let m1 = grown(first)
	let m2 = grown(second)
	let mut buf = fs.NewScanBuffer()
	with context { fs.Files: m1, fs.Writes: m1, fs.Entries: m1, fs.Scans: m1 } {
		fs.ScanInto(".", fs.DefaultScanOptions(), &buf) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
	}
	fs.Reset(&buf)
	with context { fs.Files: m2, fs.Writes: m2, fs.Entries: m2, fs.Scans: m2 } {
		fs.ScanInto(".", fs.DefaultScanOptions(), &buf) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		let fresh = fs.Scan(".", fs.DefaultScanOptions()) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		buf.Paths == fresh.Paths && buf.Kinds == fresh.Kinds && buf.Sizes == fresh.Sizes && buf.TotalSize == fresh.TotalSize && buf.TotalAlloc == fresh.TotalAlloc && buf.Parents == fresh.Parents && buf.Depths == fresh.Depths
	}
}

// ScanPruneAndSkipControlSubtrees: Skip omits the subtree while Prune keeps
// the directory entry without descending into its children.
law ScanPruneAndSkipControlSubtrees() {
	let m = NewMemory()
	m.MkdirAll("keep") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	m.MkdirAll("skip") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	m.MkdirAll("prune") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	m.WriteFile("keep/ok.txt", "k") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	m.WriteFile("skip/hidden.txt", "s") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	m.WriteFile("prune/hidden.txt", "p") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	with context { fs.Files: m, fs.Writes: m, fs.Entries: m, fs.Scans: m } {
		let (paths, errs) = fs.WalkWith(".", fs.DefaultScanOptions(), func(path string, _ fs.Entry, _ int) fs.VisitAction {
			let base = filepath.Base(path)
			if base == "skip" {
				return fs.Skip
			}
			if base == "prune" {
				return fs.Prune
			}
			fs.Include
		}) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		let want = []string{".", "keep", "keep/ok.txt", "prune"}
		paths == want && errs.Len() == 0
	}
}
