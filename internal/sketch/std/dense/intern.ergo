import strings
import maps

// Interner gives each distinct value of T one id, the id of its row: the
// first Intern of a value puts it, and every later Intern of an equal
// value returns the same id (Zig's InternPool, rustc's interners). Ids
// compare where values would: two ids are equal exactly when their values
// are. Values are never removed; for values that come and go, use
// Counted.
type Interner[T comparable] { ids Map[T, ID[T]], rows []T }

// DistinctValuesDistinctIDs: two ids are equal exactly when their values
// are.
law DistinctValuesDistinctIDs(xs []int) {
	let (_, ids, _, tids) = interned(xs)
	let mut ok = true
	for i, x in xs {
		for j, y in xs {
			ok = ok && (x == y) == (ids[i] == ids[j]) && (word(x) == word(y)) == (tids[i] == tids[j])
		}
	}
	ok
}

// NewInterner is an interner of no values.
func NewInterner[T comparable]() Interner[T] { Interner[T]{ids: Map[T, ID[T]]{}, rows: []T{}} }

// Intern is the id of v: the id an equal value was given before, or a new
// one.
func Intern[T comparable](s mut Interner[T], v T) ID[T] {
	match s.ids.Get(v) {
	case Some[ID[T]] as id:
		id.Value
	case None:
		let id = next[T](len(s.rows))
		s.rows = s.rows.Append(v)
		s.ids = s.ids.Put(v, id)
		id
	}
}

// InternTwiceSameID: interning a value again gives the id it was given
// first, and adds nothing.
law InternTwiceSameID(xs []int) {
	let (s0, ids, t0, tids) = interned(xs)
	let mut s = s0
	let mut t = t0
	let mut ok = true
	for i, x in xs {
		ok = ok && s.Intern(x) == ids[i] && t.InternText(word(x)) == tids[i]
	}
	ok && Interned(s) == Interned(s0) && Texts(t) == Texts(t0)
}

// word is the text of x, empty for a multiple of 5, so the texts repeat,
// differ in length and include the empty text.
func word(x int) string {
	if x%5 == 0 { "" } else { "w\(x)" }
}

// interned is an Interner and a Strings after an Intern of each of xs (as
// x and as word(x)), and the ids each gave.
func interned(xs []int) (Interner[int], []ID[int], Strings, []ID[Str]) {
	let mut s = NewInterner[int]()
	let mut t = NewStrings()
	let mut ids = []ID[int]{}
	let mut tids = []ID[Str]{}
	for x in xs {
		ids = ids.Append(s.Intern(x))
		tids = tids.Append(t.InternText(word(x)))
	}
	(s, ids, t, tids)
}

// Value is the value id names. An id past the end is a defect.
func Value[T comparable](s Interner[T], id ID[T]) T { s.rows[int(id.n)] }

// ValueOfIntern: an id names the value interned under it, Lookup and
// FindText find it, and the counts are the counts of distinct values.
law ValueOfIntern(xs []int, probe int) {
	let (s, ids, t, tids) = interned(xs)
	let mut values = Map[int, bool]{}
	let mut texts = Map[string, bool]{}
	let mut ok = true
	for i, x in xs {
		values[x] = true
		texts[word(x)] = true
		ok = ok && Value(s, ids[i]) == x && Text(t, tids[i]) == word(x)
		ok = ok && Lookup(s, x) == Some[ID[int]]{Value: ids[i]} && FindText(t, word(x)) == Some[ID[Str]]{Value: tids[i]}
	}
	let absent = maps.GetOr(values, probe, false)
	let absentText = maps.GetOr(texts, word(probe), false)
	ok = ok && (absent || Lookup(s, probe) == None) && (absentText || FindText(t, word(probe)) == None)
	ok && Interned(s) == len(values) && Texts(t) == len(texts)
}

// Lookup is the id of v, or None when v was never interned.
func Lookup[T comparable](s Interner[T], v T) Option[ID[T]] { s.ids.Get(v) }

// Interned is the count of distinct values.
func Interned[T comparable](s Interner[T]) int { len(s.rows) }

// Str is the row tag of interned text: an ID[Str] names a text of a
// Strings table.
type Str {}

// Strings interns text with few pointers: every text that is settled lies
// in one string, addressed by a pair of uint32 offsets per id, and the
// table that finds a text is a []uint32 of ids, open addressed by an
// FNV-1a hash. Texts interned since the last settling wait in a short list
// of their own, which is joined onto the one string when it holds as many
// bytes as the string (so each byte is copied a bounded number of times).
// Where Go keeps a map[string]uint32, the collector here scans the one
// string and the short list, not a pointer per text.
type Strings {
	text    string,
	tail    []string,
	pending int,
	spans   []uint32,
	slots   []uint32,
	used    int,
}

// NewStrings is a table of no texts.
func NewStrings() Strings {
	Strings{text: "", tail: []string{}, pending: 0, spans: []uint32{}, slots: []uint32{}, used: 0}
}

// Texts is the count of distinct texts.
func Texts(s Strings) int { len(s.spans)/2 + len(s.tail) }

// Text is the text id names: a part of the one string, not a copy, once
// the text is settled. An id past the end is a defect.
func Text(s Strings, id ID[Str]) string {
	let i = int(id.n)
	let settled = len(s.spans) / 2
	if i < settled {
		return s.text[int(s.spans[2*i]):int(s.spans[2*i+1])]
	}
	s.tail[i-settled]
}

// fnv is the 32-bit FNV-1a hash of text.
func fnv(text string) uint32 {
	let mut h = uint32(2166136261)
	for i in 0..len(text) {
		h = (h ^ uint32(text[i])) * uint32(16777619)
	}
	h
}

// FindText is the id of text, or None when it was never interned.
func FindText(s Strings, text string) Option[ID[Str]] {
	if len(s.slots) == 0 {
		return None
	}
	let mask = len(s.slots) - 1
	let mut at = int(fnv(text)) & mask
	for s.slots[at] != 0 {
		let id = ID[Str]{n: s.slots[at] - 1}
		if Text(s, id) == text {
			return Some[ID[Str]]{Value: id}
		}
		at = (at + 1) & mask
	}
	None
}

// place puts id in the first free slot of its text's probe sequence.
func place(s mut Strings, id ID[Str], text string) {
	let mask = len(s.slots) - 1
	let mut at = int(fnv(text)) & mask
	for s.slots[at] != 0 {
		at = (at + 1) & mask
	}
	s.slots[at] = id.n + 1
	s.used = s.used + 1
}

// grow doubles the slots, at least 16, and places every id again.
func grow(s mut Strings) {
	let mut n = len(s.slots) * 2
	if n < 16 {
		n = 16
	}
	let mut slots = []uint32{}
	for _ in 0..n {
		slots = slots.Append(uint32(0))
	}
	s.slots = slots
	s.used = 0
	for i in 0..Texts(*s) {
		let id = ID[Str]{n: uint32(i)}
		place(s, id, Text(*s, id))
	}
}

// settle joins the waiting texts onto the one string.
func settle(s mut Strings) {
	let mut start = len(s.text)
	let mut parts = []string{s.text}
	for t in s.tail {
		parts = parts.Append(t)
		// Two appends: a chained x.Append(a).Append(b) copies x (the
		// lowering clips the receiver of the outer Append).
		s.spans = s.spans.Append(uint32(start))
		s.spans = s.spans.Append(uint32(start + len(t)))
		start = start + len(t)
	}
	s.text = strings.Join(parts, "")
	s.tail = []string{}
	s.pending = 0
}

// InternText is the id of text: the id an equal text was given before, or
// a new one.
func InternText(s mut Strings, text string) ID[Str] {
	match FindText(*s, text) {
	case Some[ID[Str]] as found:
		return found.Value
	case None:
	}
	if len(s.text)+s.pending+len(text) >= int(limit) {
		Unreachable("dense: a Strings table holds at most 4294967295 bytes")
	}
	let id = next[Str](Texts(*s))
	s.tail = s.tail.Append(text)
	s.pending = s.pending + len(text)
	if (s.used+1)*4 > len(s.slots)*3 {
		grow(s)
	} else {
		place(s, id, text)
	}
	if s.pending > 0 && s.pending >= len(s.text) {
		settle(s)
	}
	id
}
