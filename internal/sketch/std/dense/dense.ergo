// Package dense is stores of rows addressed by 4-byte ids
// (docs/spec/stdlib.md, Dense stores). A program that holds many values
// of one kind keeps them as rows of a store and links them by ids, where
// Go links them by pointers: an id is a uint32, so a store of rows with no
// pointer field is pointer-free, the collector never scans it, and a
// row that links others is half the size it would be with 8-byte ids
// (the DOD0 receipt, decision 1).
//
// Rows are never removed. A Table appends rows and returns their ids; a
// Count and its Cols are the same thing by hand, one column per field
// (struct of arrays). A Side holds data that few ids have, and a Pool
// holds many short lists in one slice, each a Run. For rows that are
// removed while others keep handles, use arena, whose Refs carry a
// generation.
//
// An ID[K] is made only here: every ID[K] came from a Put or a Next of
// some store of K, so an id is never forged and never of another row
// type. An id is meaningful only for the store that made it; an id of
// another store of the same row type that is in range reads that store's
// row, never memory outside it. At and Of on an id past the end are a
// defect, as an index past the end of a slice is.
//
// The shape is Zig's MultiArrayList and the index arenas of rustc, Zig
// and Go's own compiler (cmd/compile's ssa.ID); Effect has no such module.
// The package is Ergo source with no Go body (STD-NOPRIV).

import core
import option
import slices
import maps

// ID is the id of a row of a store of K: four bytes, no pointer. IDs
// compare with ==, in the order the rows were put.
type ID[K] { n uint32 }

// Opt is an ID or none, in four bytes: it holds an id's number plus one,
// and none is 0, so a run of Opts zeroed by Go (a cleared row) holds none
// and a fill with none is a clear. It is the "no link" of a row (a first
// child, a next sibling) where Option[ID[K]] would take eight bytes.
type Opt[K] { n uint32 }

// limit is one past the last id a store can make: the largest uint32, so
// an id plus one fits an Opt.
let limit = uint32(0xffffffff)

// full is the defect of a store that holds as many rows as ids exist.
let full = "dense: a store holds at most 4294967295 rows"

// OptOf is the Opt that holds id.
func OptOf[K](id ID[K]) Opt[K] { Opt[K]{n: id.n + uint32(1)} }

// NoID is the Opt that holds no id.
func NoID[K]() Opt[K] { Opt[K]{n: uint32(0)} }

// Or is the id o holds, or the id or when it holds none.
func Or[K](o Opt[K], or ID[K]) ID[K] {
	if o.n == uint32(0) { or } else { ID[K]{n: o.n - uint32(1)} }
}

// Unpack is o as an Option, for a match.
func Unpack[K](o Opt[K]) option.Option[ID[K]] {
	if o.n == uint32(0) {
		return option.None
	}
	option.Some[ID[K]]{Value: ID[K]{n: o.n - uint32(1)}}
}

// OptRoundTrips: an Opt holds the id it was made of, or none.
law OptRoundTrips(xs []int, k int) {
	if xs.Len() == 0 {
		return Unpack(NoID[int]()) == option.None
	}
	let (_, ids) = filled(xs)
	let id = ids[pick(k, ids.Len())]
	let other = ids[0]
	Unpack(OptOf(id)) == option.Some[ID[int]]{Value: id} && Unpack(NoID[int]()) == option.None && Or(OptOf(id), other) == id && Or(NoID[int](), other) == other
}

// Index is the position of id's row: 0 for the first row put.
func Index[K](id ID[K]) int { int(id.n) }

// next is the id of a store that holds n rows already.
func next[K](n int) ID[K] {
	if n >= int(limit) {
		Unreachable(full)
	}
	ID[K]{n: uint32(n)}
}

// Table is an append-only store of rows of T. Its field is unexported,
// so only New and the operations make and change one; change it through
// a *Table borrow.
type Table[T] { rows []T }

// TableEachStops: Each stops when its yield returns false.
law TableEachStops(xs []int) {
	let (t, _) = filled(xs)
	let s = Each(t)
	let n = xs.Len()
	for k in 1..n+2 {
		let mut calls = 0
		s(func(e Entry[int]) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// TableIDsStops: IDs stops when its yield returns false.
law TableIDsStops(xs []int) {
	let (t, _) = filled(xs)
	let s = IDs(t)
	let n = xs.Len()
	for k in 1..n+2 {
		let mut calls = 0
		s(func(id ID[int]) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// New is an empty table.
func New[T]() Table[T] { Table[T]{rows: []T{}} }

type Capacity {}

type Room { count int }

func Reserve(n int) Room fails Capacity {
	if uint64(n) > uint64(limit) {
		return Capacity
	}
	Room{count: n}
}

law ReserveRejectsOutOfRange(seed int) {
	let shift = seed & 255
	for n in []int{-1 - shift, 4294967296 + shift} {
		let _ = Reserve(n) catch {
		case Capacity:
			continue
		}
		return false
	}
	true
}

func WithCap[T](room Room) Table[T] {
	Table[T]{rows: slices.WithCapacity[T](room.count)}
}

// Len is the count of rows.
func Len[T](t Table[T]) int { t.rows.Len() }

// Has reports whether id names a row of t.
func Has[T](t Table[T], id ID[T]) bool { int(id.n) < t.rows.Len() }

// Put appends v and returns its id. Every id that named a row before
// still names the same row.
func Put[T](t mut Table[T], v T) ID[T] {
	let n = t.rows.Len()
	let grows = room(t.rows) == n
	// A table's room is at most one per id (WithCap, and the regrowth
	// below), so a store with room left is not full: only a Put that grows
	// the table checks (SL2b).
	if grows && n >= int(limit) {
		Unreachable(full)
	}
	t.rows = t.rows.Append(v)
	if grows && (room(t.rows) > int(limit) || (n > 1 && room(t.rows) == n+1)) {
		// Room past one per id is cut back to it. And only rows of no size
		// grow to exactly one more than they hold: Go grows any other full
		// slice of two rows or more to at least twice, or a quarter more.
		// Go grows a slice of rows of no size on every append, so the
		// table takes room for every id at once; rows of no size take no
		// memory (SL2b).
		let mut all = slices.WithCapacity[T](int(limit))
		all = slices.AppendAll(all, t.rows)
		t.rows = all
	}
	ID[T]{n: uint32(n)}
}

// PutThenAt: At reads what Put appended, and Len counts it.
law PutThenAt(xs []int, v int) {
	let (start, _) = filled(xs)
	let mut t = start
	let id = t.Put(v)
	At(t, id) == v && Has(t, id) && Len(t) == xs.Len()+1
}

// PutKeepsOthers: a Put changes no row an earlier id names.
law PutKeepsOthers(xs []int, v int) {
	let (start, ids) = filled(xs)
	let mut t = start
	let fresh = t.Put(v)
	let mut ok = true
	for i, id in ids {
		ok = ok && id != fresh && At(t, id) == xs[i]
	}
	ok
}

// room is Go's cap (an extern of Go's builtin, OPT4b).
extern go cap func room[T](xs []T) int

// flat is a row of no size, for the law below.
type flat {}

// FlatRowsKeepIDs: a table of rows of no size, made empty or with a
// capacity, gives ids 0 to n-1 and counts its rows, past the Put where it
// takes room for every id.
law FlatRowsKeepIDs(k int, c int) {
	let n = (k%300 + 300) % 300
	let mut a = New[flat]()
	let room = Reserve((c%40 + 40) % 40) catch {
	case Capacity:
		return false
	}
	let mut b = WithCap[flat](room)
	let mut ok = true
	for i in 0..n {
		let ia = a.Put(flat)
		let ib = b.Put(flat)
		ok = ok && Index(ia) == i && Index(ib) == i && Len(a) == i+1 && Len(b) == i+1 && Has(a, ia) && Has(b, ib)
	}
	ok && Rows(a).Len() == n && Rows(b).Len() == n
}

// At is the row id names. An id past the end is a defect.
func At[T](t Table[T], id ID[T]) T { t.rows[int(id.n)] }

// Get is the row id names, or None for an id past the end: for an id
// that came from outside, such as a decoded one.
func Get[T](t Table[T], id ID[T]) option.Option[T] {
	if int(id.n) < t.rows.Len() {
		return option.Some[T]{Value: t.rows[int(id.n)]}
	}
	option.None
}

// GetAgreesWithHas: Get is Some exactly when Has, and then holds the row
// At reads. The ids come from a longer table, so some are past the end.
law GetAgreesWithHas(xs []int) {
	let (t, _) = filled(xs)
	let (_, ids) = filled(xs.Append(0).Append(0))
	let mut ok = true
	for id in ids {
		match Get(t, id) {
		case option.Some[int] as v:
			ok = ok && Has(t, id) && v.Value == At(t, id)
		case option.None:
			ok = ok && !Has(t, id)
		}
	}
	ok
}

// Set replaces the row id names. An id past the end is a defect.
func Set[T](t mut Table[T], id ID[T], v T) { t.rows[int(id.n)] = v }

// SetThenAt: At reads what Set wrote, and Set changes no other row.
law SetThenAt(xs []int, k int, v int) {
	if xs.Len() == 0 {
		return true
	}
	let (start, ids) = filled(xs)
	let mut t = start
	let i = pick(k, xs.Len())
	t.Set(ids[i], v)
	let mut ok = At(t, ids[i]) == v && Len(t) == xs.Len()
	for j, id in ids {
		ok = ok && (j == i || At(t, id) == xs[j])
	}
	ok
}

// pick is a position of 0..n, from k; n is positive.
func pick(k int, n int) int { (k%n + n) % n }

// Entry is a row and its id, as Each gives them.
type Entry[T] { ID ID[T], Row T }

// Each is the rows of t with their ids, in the order they were put. It
// reads the rows as they are when it starts; a body that changes t
// iterates for i in 0..Len(t) with IDOf.
func Each[T](t Table[T]) core.Seq[Entry[T]] {
	let rows = t.rows
	core.Seq[Entry[T]](func(yield func(e Entry[T]) bool) {
		for i, row in rows {
			if !yield(Entry[T]{ID: ID[T]{n: uint32(i)}, Row: row}) {
				return
			}
		}
	})
}

// IDs is the ids of t, in the order they were put.
func IDs[T](t Table[T]) core.Seq[ID[T]] {
	let n = t.rows.Len()
	core.Seq[ID[T]](func(yield func(id ID[T]) bool) {
		for i in 0..n {
			if !yield(ID[T]{n: uint32(i)}) {
				return
			}
		}
	})
}

// IDsAreDense: Each, IDs and Rows give the rows in the order they were
// put, with ids 0 to Len-1, and IDOf is the id of each position.
law IDsAreDense(xs []int) {
	let (t, ids) = filled(xs)
	let mut i = 0
	let mut ok = true
	for e in Each(t) {
		ok = ok && i < xs.Len() && e.ID == ids[i] && Index(e.ID) == i && e.Row == xs[i]
		i = i + 1
	}
	let mut j = 0
	for id in IDs(t) {
		ok = ok && j < ids.Len() && id == ids[j]
		j = j + 1
	}
	for k, row in Rows(t) {
		ok = ok && row == xs[k] && IDOf(t, k) == ids[k]
	}
	ok && i == xs.Len() && j == xs.Len() && Rows(t).Len() == xs.Len()
}

// Rows is the rows of t in id order: for i, row in Rows(t), with
// IDOf(t, i) the id of position i.
func Rows[T](t Table[T]) []T { t.rows }

// IDOf is the id of position i of t. A position outside 0..Len(t) is a
// defect.
func IDOf[T](t Table[T], i int) ID[T] {
	if i < 0 || i >= t.rows.Len() {
		Unreachable("dense: IDOf of a position outside the table")
	}
	ID[T]{n: uint32(i)}
}

// Count makes the ids of hand columns: one Count per row type, and a Col
// per field, each pushed once per Next, so the columns are as long as the
// count and share its ids.
type Count[K] { n uint32 }

// NewCount is a count of no rows.
func NewCount[K]() Count[K] { Count[K]{n: uint32(0)} }

// Next is the id of the next row.
func Next[K](c mut Count[K]) ID[K] {
	let id = next[K](int(c.n))
	c.n = c.n + 1
	id
}

// NextThenOf: hand columns pushed once per Next read back by the id Next
// gave, and Total counts the ids.
law NextThenOf(xs []int) {
	let mut c = NewCount[int]()
	let mut col = NewCol[int, int]()
	let mut ids = []ID[int]{}
	for x in xs {
		ids = ids.Append(c.Next())
		col.Push(x)
	}
	let mut ok = Total(c) == xs.Len()
	for i, id in ids {
		ok = ok && In(col, id) && Of(col, id) == xs[i] && Index(id) == i
	}
	if ids.Len() > 0 {
		col.SetOf(ids[0], -1)
		ok = ok && Of(col, ids[0]) == -1
	}
	ok
}

// Total is the count of ids Next made.
func Total[K](c Count[K]) int { int(c.n) }

// IDAt is the id Next made at position i of c: for i in 0..Total(c). A
// position outside it is a defect. With it, rows whose fields all live in
// Cols need no Table: a Table of a type with no fields still keeps a slice.
func IDAt[K](c Count[K], i int) ID[K] {
	if i < 0 || i >= int(c.n) {
		Unreachable("dense: IDAt of a position outside the count")
	}
	ID[K]{n: uint32(i)}
}

// IDAtIsNext: IDAt of each position is the id Next made there.
law IDAtIsNext(k int) {
	let n = (k%32 + 32) % 32
	let mut c = NewCount[int]()
	let mut ids = []ID[int]{}
	for _ in 0..n {
		ids = ids.Append(c.Next())
	}
	let mut ok = true
	for i, id in ids {
		ok = ok && IDAt(c, i) == id
	}
	ok
}

// Col is a column of V for the rows of K: one field of hand columns.
type Col[K, V] { xs []V }

// NewCol is an empty column.
func NewCol[K, V]() Col[K, V] { Col[K, V]{xs: []V{}} }

// ColWithCap is an empty column with room for n values, as WithCap is a
// table.
func ColWithCap[K, V](n int) Col[K, V] { Col[K, V]{xs: slices.WithCapacity[V](n)} }

// Push appends the value of the next row.
func Push[K, V](c mut Col[K, V], v V) { c.xs = c.xs.Append(v) }

// In reports whether the column holds a value for id.
func In[K, V](c Col[K, V], id ID[K]) bool { int(id.n) < c.xs.Len() }

// Of is the value of id. An id past the end is a defect.
func Of[K, V](c Col[K, V], id ID[K]) V { c.xs[int(id.n)] }

// SetOf replaces the value of id. An id past the end is a defect.
func SetOf[K, V](c mut Col[K, V], id ID[K], v V) { c.xs[int(id.n)] = v }

// Side holds data that few rows of K have, with a default for the rest:
// where Go keeps a map keyed by a pointer. It is as long as the largest
// id set, so it suits ids that come early, or data most rows have.
type Side[K, V] { xs []V, zero V }

// NewSide is a side column whose every id holds zero.
func NewSide[K, V](zero V) Side[K, V] { Side[K, V]{xs: []V{}, zero: zero} }

// SideDefaults: SideOf is the value last set for an id, and the default
// for every other id, past the end too.
law SideDefaults(xs []int, sets []int, d int) {
	let (_, ids) = filled(xs)
	let mut s = NewSide[int, int](d)
	let mut model = Map[ID[int], int]{}
	if ids.Len() > 0 {
		for v in sets {
			let id = ids[pick(v, ids.Len())]
			s.SideSet(id, v)
			model[id] = v
		}
	}
	let mut ok = true
	for id in ids {
		ok = ok && SideOf(s, id) == maps.GetOr(model, id, d)
	}
	ok
}

// SideOf is the value of id: the default for an id never set.
func SideOf[K, V](s Side[K, V], id ID[K]) V {
	if int(id.n) < s.xs.Len() { s.xs[int(id.n)] } else { s.zero }
}

// SideSet sets the value of id.
func SideSet[K, V](s mut Side[K, V], id ID[K], v V) {
	let i = int(id.n)
	for s.xs.Len() <= i {
		s.xs = s.xs.Append(s.zero)
	}
	s.xs[i] = v
}

// Run is one list of a Pool: where it starts and how long it is.
type Run[E] { start uint32, n uint32 }

// Pool holds many short lists of E in one slice: the children of nodes,
// the members of objects. A list is put whole and never changes.
type Pool[E] { items []E }

// NewPool is an empty pool.
func NewPool[E]() Pool[E] { Pool[E]{items: []E{}} }

// ListsDoNotOverlap: a later PutList changes no earlier list.
law ListsDoNotOverlap(a []int, b []int, c []int) {
	let mut p = NewPool[int]()
	let ra = p.PutList(a)
	let rb = p.PutList(b)
	let rc = p.PutList(c)
	slices.Equal(List(p, ra), a) && slices.Equal(List(p, rb), b) && slices.Equal(List(p, rc), c) && Items(p) == a.Len()+b.Len()+c.Len()
}

// PoolWithCap is an empty pool with room for n items of all its lists, as
// WithCap is a table.
func PoolWithCap[E](n int) Pool[E] { Pool[E]{items: slices.WithCapacity[E](n)} }

// PutList appends xs as one list and returns its run. No earlier list
// changes. The items go in one bulk append, and an empty list does no
// work but give its run the pool's end.
func PutList[E](p mut Pool[E], xs []E) Run[E] {
	let start = p.items.Len()
	if xs.Len() == 0 {
		return Run[E]{start: uint32(start), n: uint32(0)}
	}
	if start+xs.Len() >= int(limit) {
		Unreachable(full)
	}
	p.items = slices.AppendAll(p.items, xs)
	Run[E]{start: uint32(start), n: uint32(xs.Len())}
}

// EmptyRunsKeepTheirPlace: an empty list's run starts at the pool's end,
// so two empty runs put on either side of a list are different runs.
law EmptyRunsKeepTheirPlace(xs []int) {
	let mut p = NewPool[int]()
	let before = p.PutList([]int{})
	let _ = p.PutList(xs)
	let after = p.PutList([]int{})
	RunLen(before) == 0 && RunLen(after) == 0 && (before == after) == (xs.Len() == 0)
}

// List is the items of r. A run of another pool that ends past this
// pool's end is a defect.
func List[E](p Pool[E], r Run[E]) []E { p.items[int(r.start) : int(r.start)+int(r.n)] }

// ListRoundTrips: List reads the items PutList put.
law ListRoundTrips(xs []int) {
	let mut p = NewPool[int]()
	let r = p.PutList(xs)
	slices.Equal(List(p, r), xs) && RunLen(r) == xs.Len()
}

// RunLen is the count of items of r.
func RunLen[E](r Run[E]) int { int(r.n) }

// Items is the count of items of every list of p.
func Items[E](p Pool[E]) int { p.items.Len() }

// Stack is a scratch stack for gathering lists: a parser pushes the
// children of a node as it reads them, marks where a list starts, and puts
// the part since the mark into a Pool when the list ends (PutSince), so
// one stack serves every nesting depth. It keeps its top in an integer:
// Cut lowers the top and keeps the rows' room, so no push after a cut
// allocates until the stack is deeper than it ever was. Rows above the
// top stay in that room until a push writes them; a Stack of rows that
// hold pointers keeps them alive until then.
type Stack[T] { items []T, top int }

// NewStack is an empty stack.
func NewStack[T]() Stack[T] { Stack[T]{items: []T{}, top: 0} }

// StackWithCap is an empty stack with room for n rows.
func StackWithCap[T](n int) Stack[T] { Stack[T]{items: slices.WithCapacity[T](n), top: 0} }

// StackPush puts v on top of s.
func StackPush[T](s mut Stack[T], v T) {
	if s.top < s.items.Len() {
		s.items[s.top] = v
	} else {
		s.items = s.items.Append(v)
	}
	s.top = s.top + 1
}

// Depth is the count of rows on s.
func Depth[T](s Stack[T]) int { s.top }

// Mark is the place of the next row pushed on s: a list that starts now
// is the rows Since that mark.
func Mark[T](s Stack[T]) int { s.top }

// Since is the rows pushed on s after mark m, bottom first: a window of
// the stack, no copy. A mark above the top, or below 0, is a defect.
func Since[T](s Stack[T], m int) []T {
	if m < 0 || m > s.top {
		Unreachable("dense: a mark above the stack's top")
	}
	s.items[m:s.top]
}

// Cut drops the rows pushed after mark m: Depth is m after it, and the
// rows below m are unchanged. A mark above the top, or below 0, is a
// defect.
func Cut[T](s mut Stack[T], m int) {
	if m < 0 || m > s.top {
		Unreachable("dense: a mark above the stack's top")
	}
	s.top = m
}

// PutSince puts the rows pushed on s after mark m into p as one list and
// cuts s to m: PutList(p, Since(s, m)), then Cut(s, m), with no copy
// between.
func PutSince[E](p mut Pool[E], s mut Stack[E], m int) Run[E] {
	if m < 0 || m > s.top {
		Unreachable("dense: a mark above the stack's top")
	}
	let r = PutList(p, s.items[m:s.top])
	s.top = m
	r
}

// CutRestores: after pushes past a mark and Cut to it, Depth is the mark
// and the rows below it are unchanged; a push after the cut lands at the
// mark.
law CutRestores(below []int, above []int, v int) {
	let mut s = NewStack[int]()
	for x in below {
		s.StackPush(x)
	}
	let m = Mark(s)
	for x in above {
		s.StackPush(x)
	}
	let deep = Depth(s) == below.Len()+above.Len() && slices.Equal(Since(s, m), above)
	s.Cut(m)
	let cut = Depth(s) == m && m == below.Len() && slices.Equal(Since(s, 0), below) && Since(s, m).Len() == 0
	s.StackPush(v)
	deep && cut && Depth(s) == m+1 && Since(s, m)[0] == v && slices.Equal(Since(s, 0)[0:m], below)
}

// PutSinceIsPutList: PutSince is PutList of Since, then Cut, on a pool
// that holds lists already.
law PutSinceIsPutList(before []int, below []int, above []int) {
	let mut p = NewPool[int]()
	let _ = p.PutList(before)
	let mut q = p
	let mut s = NewStack[int]()
	for x in below {
		s.StackPush(x)
	}
	let m = Mark(s)
	for x in above {
		s.StackPush(x)
	}
	let mut t = s
	let r = PutSince(&p, &s, m)
	let rq = q.PutList(Since(t, m))
	t.Cut(m)
	r == rq && slices.Equal(List(p, r), above) && Items(p) == Items(q) && Depth(s) == Depth(t) && slices.Equal(Since(s, 0), Since(t, 0))
}

// WithCapIsNew: stores made with a capacity read as stores made empty
// after the same writes, whatever the capacity.
law WithCapIsNew(xs []int, n int) {
	let c = (n%64 + 64) % 64
	let mut a = New[int]()
	let room = Reserve(c) catch {
	case Capacity:
		return false
	}
	let mut b = WithCap[int](room)
	let mut ca = NewCol[int, int]()
	let mut cb = ColWithCap[int, int](c)
	let mut pa = NewPool[int]()
	let mut pb = PoolWithCap[int](c)
	let mut sa = NewStack[int]()
	let mut sb = StackWithCap[int](c)
	let mut ok = Len(b) == 0 && Items(pb) == 0 && Depth(sb) == 0
	for x in xs {
		let ia = a.Put(x)
		let ib = b.Put(x)
		ca.Push(x)
		cb.Push(x)
		sa.StackPush(x)
		sb.StackPush(x)
		ok = ok && ia == ib && At(b, ib) == x && Of(cb, ib) == x
	}
	let ra = pa.PutList(xs)
	let rb = pb.PutList(xs)
	ok && Len(a) == Len(b) && slices.Equal(Rows(a), Rows(b)) && ra == rb && slices.Equal(List(pa, ra), List(pb, rb)) && Items(pa) == Items(pb) && slices.Equal(Since(sa, 0), Since(sb, 0))
}
