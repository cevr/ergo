import testing

// TestHost is the host process as a test in the case's folder sees it
// (testing.Ambient; docs/spec/rows.md, Entry 5): no arguments, the folder
// as its working directory, and an environment of HOME, TMPDIR and PWD,
// each the folder, and PATH, the host's, so a program the test runs is
// found as on the host. Every other key is unset, so no test reads the
// host's configuration. Its field gives this package the construction
// authority, so only NewTestHost makes one.
type TestHost { root string } implements Process

// NewTestHost is the Process of the case's folder. It needs the test's
// ambient, which only the test runner provides, to a context that states
// it: `context needs testing.Ambient { os.Process: os.NewTestHost() }`.
func NewTestHost() TestHost needs testing.Ambient { TestHost{root: testing.Folder()} }

// Args is no arguments.
func Args(_ TestHost) []string { []string{} }

// Getenv is the folder for HOME, TMPDIR and PWD, the host's PATH, and
// None for every other key.
func Getenv(h TestHost, key string) Option[string] {
	if key == "HOME" || key == "TMPDIR" || key == "PWD" {
		Some[string]{Value: h.root}
	} else if key == "PATH" && hostHasEnv(key) {
		Some[string]{Value: hostGetenv(key)}
	} else {
		None
	}
}

// Getwd is the folder.
func Getwd(h TestHost) string fails NoWorkdir { h.root }
