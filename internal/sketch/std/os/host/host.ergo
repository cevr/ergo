// Package host provides host CPU, load average, memory, filesystem volume, and
// operating-system process visibility for Ergo programs.

import option
import slices
import strconv

// LoadAvg holds the host's 1-minute, 5-minute, and 15-minute run-queue load
// averages along with the runnable and total kernel scheduling entity counts.
type LoadAvg {
	One      float64,
	Five     float64,
	Fifteen  float64,
	Running  int,
	Entities int,
}

// Memory holds host physical memory measurements in bytes.
type Memory {
	TotalBytes     int64,
	AvailableBytes int64,
	FreeBytes      int64,
	UsedBytes      int64,
}

// Volume holds capacity measurements in bytes for one filesystem path.
type Volume {
	Path           string,
	TotalBytes     int64,
	FreeBytes      int64,
	AvailableBytes int64,
	UsedBytes      int64,
}

// Status is a point-in-time snapshot of host CPU cores, run-queue load
// averages, physical memory, and requested volume capacities.
type Status {
	Cores   int,
	Load    LoadAvg,
	Memory  Memory,
	Volumes []Volume,
}

// Process describes one operating-system process read from the host process
// table.
type Process {
	PID        int,
	PPID       int,
	State      string,
	Comm       string,
	Cmdline    []string,
	UserTicks  int64,
	SysTicks   int64,
	StartTicks int64,
	RSSBytes   int64,
	VSizeBytes int64,
	Threads    int,
}

// ProcStat holds the parsed fields of a Linux /proc/<pid>/stat line.
type ProcStat {
	PID        int,
	Comm       string,
	State      string,
	PPID       int,
	UserTicks  int64,
	SysTicks   int64,
	Threads    int,
	StartTicks int64,
	VSizeBytes int64,
	RSSPages   int64,
}

// ProcStatm holds the parsed page-scaled memory metrics of /proc/<pid>/statm.
type ProcStatm {
	SizeBytes     int64,
	ResidentBytes int64,
	SharedBytes   int64,
}

// Unavailable is the failure when a host resource or path cannot be read or
// queried from the operating system.
type Unavailable { Target string, Reason string }

// NotFound is the failure when a requested host entity such as a process ID
// does not exist.
type NotFound { Target string }

// Malformed is the failure when host telemetry input fails syntactic or
// invariant validation.
type Malformed { Source string, Reason string }

// Error is the closed union of failures returned by package host.
type Error = Unavailable | NotFound | Malformed

// System is the capability providing host resource status and active process
// snapshots.
type System {
	// Status returns host CPU core count, load averages, physical memory, and
	// capacity statistics for every path in volumes.
	Status(volumes []string) Status fails Unavailable | Malformed,
	// Processes returns snapshots of active processes visible to the caller,
	// sorted by ascending PID.
	Processes() []Process fails Unavailable | Malformed,

	// StatusInvariants: CPU core count is non-negative, load averages are
	// finite and non-negative, memory and every volume satisfy Available <= Total,
	// Free <= Total, and Used <= Total, and Volumes has one entry per path.
	law StatusInvariants(volumes []string) {
		let base = Status([]string{}) catch {
		case Unavailable, Malformed:
			return true
		}
		if !validStatus(base) || base.Volumes.Len() != 0 {
			return false
		}
		let st = Status(volumes) catch {
		case Unavailable, Malformed:
			return true
		}
		validStatus(st) && st.Volumes.Len() == volumes.Len()
	},

	// ProcessesValid: every returned process has positive PID, non-negative PPID,
	// non-negative tick and thread counts, non-negative RSS and virtual sizes,
	// and ascending PID order.
	law ProcessesValid() {
		let ps = Processes() catch {
		case Unavailable, Malformed:
			return true
		}
		validProcessList(ps)
	},
}

// Static is an in-memory System provider constructed from validated snapshots
// for deterministic tests and check-time laws.
type Static {
	cores     int,
	load      LoadAvg,
	memory    Memory,
	volumes   Map[string, Volume],
	processes []Process,
} implements System

// NewStatic constructs a Static System provider after validating every field of
// status and processes against package invariants.
func NewStatic(status Status, processes []Process) Static fails Malformed {
	if !validStatus(status) {
		return Malformed{Source: "static", Reason: "status failed invariant check"}
	}
	for p in processes {
		if !validProcess(p) {
			return Malformed{Source: "static", Reason: "process failed invariant check"}
		}
	}
	let mut vols = Map[string, Volume]{}
	for v in status.Volumes {
		vols = vols.Put(v.Path, v)
	}
	let procs = slices.SortFunc(slices.Clone(processes), compareProcessPID)
	Static{
		cores:     status.Cores,
		load:      status.Load,
		memory:    status.Memory,
		volumes:   vols,
		processes: procs,
	}
}

// Status returns the Static provider's recorded CPU, load, and memory status
// along with each requested volume configured in s.
func Status(s Static, volumes []string) Status fails Unavailable | Malformed {
	let mut out = slices.WithCapacity[Volume](volumes.Len())
	for path in volumes {
		match s.volumes.Get(path) {
		case option.Some[Volume] as found:
			out = out.Append(found.Value)
		case option.None:
			return Unavailable{Target: path, Reason: "volume not configured"}
		}
	}
	Status{
		Cores:   s.cores,
		Load:    s.load,
		Memory:  s.memory,
		Volumes: out,
	}
}

// Processes returns a cloned slice of the Static provider's recorded processes
// sorted by ascending PID.
func Processes(s Static) []Process fails Unavailable | Malformed {
	slices.Clone(s.processes)
}

// CPUTicks returns the combined user and kernel CPU clock ticks for p.
func CPUTicks(p Process) int64 {
	p.UserTicks + p.SysTicks
}

// CPUPercent converts a delta of CPU clock ticks over windowSeconds at clockHz
// ticks per second into a non-negative percentage across one or more cores.
func CPUPercent(deltaTicks int64, windowSeconds float64, clockHz int64) float64 {
	if deltaTicks <= int64(0) || clockHz <= int64(0) || windowSeconds-windowSeconds != 0.0 || windowSeconds <= 0.0 {
		return 0.0
	}
	float64(deltaTicks) * 100.0 / (windowSeconds * float64(clockHz))
}

// FindProcess looks up the first entry in processes matching pid or fails
// NotFound.
func FindProcess(processes []Process, pid int) Process fails NotFound {
	for p in processes {
		if p.PID == pid {
			return p
		}
	}
	return NotFound{Target: strconv.Itoa(pid)}
}

// CPUPercentInvariants: CPUPercent is never negative, returns zero when
// deltaTicks <= 0 or windowSeconds <= 0, and is monotonic in deltaTicks.
law CPUPercentInvariants(a int64, b int64, hz int64) {
	let zero = CPUPercent(int64(0), 1.0, 100)
	let negWindow = CPUPercent(int64(50), -1.0, 100)
	let negDelta = CPUPercent(int64(-5), 1.0, 100)
	if zero != 0.0 || negWindow != 0.0 || negDelta != 0.0 {
		return false
	}
	if a < int64(0) || b < int64(0) || a > int64(1000000000) || b > int64(1000000000) || hz <= int64(0) || hz > int64(100000) {
		return true
	}
	let pa = CPUPercent(a, 2.0, hz)
	let pb = CPUPercent(b, 2.0, hz)
	pa >= 0.0 && pb >= 0.0 && (a > b || pa <= pb) && (b > a || pb <= pa)
}

// FindProcessFindsOrFails: FindProcess returns a process with matching PID when
// present in processes, or fails NotFound when no entry matches.
law FindProcessFindsOrFails(pid int, other int) {
	let p = Process{
		PID:        if pid <= 0 { 1 } else { pid },
		PPID:       0,
		State:      "R",
		Comm:       "worker",
		Cmdline:    []string{"worker"},
		UserTicks:  10,
		SysTicks:   2,
		StartTicks: 100,
		RSSBytes:   4096,
		VSizeBytes: 8192,
		Threads:    1,
	}
	let ps = []Process{p}
	let found = FindProcess(ps, p.PID) catch {
	case NotFound:
		return false
	}
	if found.PID != p.PID || CPUTicks(found) != int64(12) {
		return false
	}
	if other == p.PID {
		return true
	}
	let _ = FindProcess(ps, other) catch {
	case NotFound:
		return true
	}
	false
}

let staticSample = context fails Malformed {
	System: try NewStatic(
		Status{
			Cores:  8,
			Load:   LoadAvg{One: 1.5, Five: 1.25, Fifteen: 0.75, Running: 2, Entities: 120},
			Memory: Memory{
				TotalBytes:     int64(17179869184),
				AvailableBytes: int64(10737418240),
				FreeBytes:      int64(4294967296),
				UsedBytes:      int64(6442450944),
			},
			Volumes: []Volume{
				Volume{
					Path:           "/",
					TotalBytes:     int64(107374182400),
					FreeBytes:      int64(53687091200),
					AvailableBytes: int64(42949672960),
					UsedBytes:      int64(53687091200),
				},
			},
		},
		[]Process{
			Process{
				PID:        1,
				PPID:       0,
				State:      "S",
				Comm:       "init",
				Cmdline:    []string{"/sbin/init"},
				UserTicks:  int64(10),
				SysTicks:   int64(5),
				StartTicks: int64(1),
				RSSBytes:   int64(4194304),
				VSizeBytes: int64(16777216),
				Threads:    1,
			},
		},
	),
}

func compareProcessPID(a Process, b Process) int {
	if a.PID < b.PID {
		-1
	} else if a.PID > b.PID {
		1
	} else {
		0
	}
}

func finiteNonNeg(x float64) bool {
	x-x == 0.0 && x >= 0.0
}

func validLoad(l LoadAvg) bool {
	finiteNonNeg(l.One) && finiteNonNeg(l.Five) && finiteNonNeg(l.Fifteen) && l.Running >= 0 && l.Entities >= 0
}

func validMemory(m Memory) bool {
		m.TotalBytes >= int64(0) &&
		m.AvailableBytes >= int64(0) &&
		m.FreeBytes >= int64(0) &&
		m.UsedBytes >= int64(0) &&
		m.AvailableBytes <= m.TotalBytes &&
		m.FreeBytes <= m.TotalBytes &&
		m.UsedBytes <= m.TotalBytes &&
		m.UsedBytes+m.AvailableBytes == m.TotalBytes
}

func validVolume(v Volume) bool {
		v.TotalBytes >= int64(0) &&
		v.FreeBytes >= int64(0) &&
		v.AvailableBytes >= int64(0) &&
		v.UsedBytes >= int64(0) &&
		v.FreeBytes <= v.TotalBytes &&
		v.AvailableBytes <= v.TotalBytes &&
		v.UsedBytes <= v.TotalBytes
}

func validStatus(st Status) bool {
	if st.Cores < 0 || !validLoad(st.Load) || !validMemory(st.Memory) {
		return false
	}
	for v in st.Volumes {
		if !validVolume(v) {
			return false
		}
	}
	true
}

func validProcess(p Process) bool {
		p.PID > 0 &&
		p.PPID >= 0 &&
		p.State.Len() == 1 &&
		p.UserTicks >= int64(0) &&
		p.SysTicks >= int64(0) &&
		p.StartTicks >= int64(0) &&
		p.RSSBytes >= int64(0) &&
		p.VSizeBytes >= int64(0) &&
		p.Threads >= 0
}

func validProcessList(ps []Process) bool {
	let mut prevPID = 0
	for p in ps {
		if !validProcess(p) || p.PID <= prevPID {
			return false
		}
		prevPID = p.PID
	}
	true
}
