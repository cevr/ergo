// Package os is the host process: its arguments, its environment and its
// exit status (docs/spec/stdlib.md, host packages). Process is the
// capability; Host is the host's provider of it. Host has an unexported
// field, so only this package builds one (S114), and NewHost, its one
// constructor, needs the prelude's Ambient, which only the entry provides.
// So code that makes a Host shows Ambient in its row: main lists it and
// binds `context { os.Process: os.NewHost() }`. A test cannot get Ambient
// and binds its own provider instead. The externs are unexported, so a
// program reaches the host only through a Host it was given or made under
// Ambient.

import filepath

// Exit is the failure that ends main with status Code. When it is main's
// only reason, the entry writes Message and a line feed to standard error,
// verbatim, and exits with Code; Code must be in 1..125 (docs/spec/
// runtime.md, Exit causes). It is a failure, not a call, so every scope's
// cleanup runs before the program ends.
type Exit { Code int, Message string }

// NoWorkdir is the failure of Getwd when the host cannot name the
// process's working directory: it was removed, or a directory above it
// cannot be read. Message is the host's reason. Getwd fails with NoWorkdir
// when the working directory has been removed, on every host.
type NoWorkdir { Message string }

// Process is the host process: the arguments after the program name, the
// environment and the working directory.
type Process {
	Args() []string,
	Getenv(key string) Option[string],
	Getwd() string fails NoWorkdir,

	// GetenvIsStable: two reads of one key agree.
	law GetenvIsStable(key string) { Getenv(key) == Getenv(key) },

	// GetwdIsStable: with no change of directory between them, two reads
	// of the working directory agree, in value and in failure. A process
	// has no operation that changes it.
	law GetwdIsStable() {
		let first = Getwd() catch {
		case NoWorkdir:
			let _ = Getwd() catch {
			case NoWorkdir:
				return true
			}
			return false
		}
		let second = Getwd() catch {
		case NoWorkdir:
			return false
		}
		first == second
	},

	// GetwdIsAbsolute: the working directory is an absolute path, so a
	// message that names a file under it names one place.
	law GetwdIsAbsolute() {
		let dir = Getwd() catch {
		case NoWorkdir:
			return true
		}
		filepath.IsAbs(dir)
	},
}

// Host is the host's Process provider. Its field gives this package the
// construction authority (types.md, Zero values 6): no other package
// writes os.Host{}, its zero value or a record update of it.
type Host { live hostOnly }

// hostOnly is the zero-size type of Host's field, so Host stays zero size.
type hostOnly {}

// NewHost is the host's Process provider. It needs Ambient: only code
// whose row holds the authority to choose the host makes one.
func NewHost() Host needs Ambient { Host{live: hostOnly} }

// Args is the host process's arguments after the program name.
func Args(_ Host) []string { hostArgs() }

// Getenv is the value of the environment variable key: None when key is
// unset, Some("") when it is set to the empty string.
func Getenv(_ Host, key string) Option[string] {
	if hostHasEnv(key) {
		Some[string]{Value: hostGetenv(key)}
	} else {
		None
	}
}

// Getwd is the host process's working directory, an absolute path (Go's
// os.Getwd). It fails NoWorkdir when the host cannot name it.
func Getwd(_ Host) string fails NoWorkdir { try hostGetwd() }

extern go ergo.local/prototype/runtime/v1.OSArgs func hostArgs() []string
extern go ergo.local/prototype/runtime/v1.OSGetwd func hostGetwd() string fails NoWorkdir
extern go ergo.local/prototype/runtime/v1.OSHasEnv func hostHasEnv(key string) bool
extern go ergo.local/prototype/runtime/v1.OSGetenv func hostGetenv(key string) string
