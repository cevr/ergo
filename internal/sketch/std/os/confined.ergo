// The host process as a test in the case's folder sees it (TestAmbient;
// docs/spec/rows.md, Test's ambient): NewTestHost is a Host with no arguments, the
// folder as its working directory, and an environment of HOME, TMPDIR and
// PWD, each the folder, and PATH, the host's, so a program the test runs
// is found as on the host. Every other key is unset, so no test reads the
// host's configuration.

import option

// NewTestHost is the Process of the case's folder. It needs the test's
// ambient, which only the test runner provides, to a context that states
// it: `context needs TestAmbient { os.Process: os.NewTestHost() }`.
func NewTestHost() Host needs TestAmbient { Host{root: TestFolder()} }

// confinedEnviron is the environment of a test's Host, h: the keys
// confinedEnv gives.
func confinedEnviron(h Host) Map[string, string] {
	let mut env = Map[string, string]{}
	for key in []string{"HOME", "PATH", "PWD", "TMPDIR"} {
		match confinedEnv(h, key) {
		case option.Some[string] as v:
			env[key] = v.Value
		case option.None:
		}
	}
	env
}

// confinedEnv is the value of key for a test's Host, h.
func confinedEnv(h Host, key string) option.Option[string] {
	if key == "HOME" || key == "TMPDIR" || key == "PWD" {
		option.Some[string]{Value: h.root}
	} else if key == "PATH" && hostHasEnv(key) {
		option.Some[string]{Value: hostGetenv(key)}
	} else {
		option.None
	}
}
