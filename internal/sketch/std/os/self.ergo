// The process's facts about itself beyond Process: its id, the user's
// directories and its own executable. Host provides both capabilities.
// A test's Host answers with directories under the case's folder.

import filepath
import go runtime

// NoDir is the failure of a directory Self cannot name: the variable it
// is read from is unset or not absolute. Message is the reason, as Go's.
extern go ergo.local/prototype/runtime/v1.NoDir type NoDir { Message string }

// Self is the process's facts about itself.
type Self {
	// Pid is the process's id.
	Pid() int,
	// HomeDir is the user's home directory.
	HomeDir() string fails NoDir,
	// CacheDir is the directory for the user's cached files: on Linux
	// $XDG_CACHE_HOME or $HOME/.cache, on darwin $HOME/Library/Caches.
	CacheDir() string fails NoDir,
	// ConfigDir is the directory for the user's configuration: on Linux
	// $XDG_CONFIG_HOME or $HOME/.config, on darwin $HOME/Library/
	// Application Support.
	ConfigDir() string fails NoDir,
	// Executable is the path of the program's own executable.
	Executable() string fails NoDir,

	// PidIsPositive: a process's id is above zero.
	law PidIsPositive() { Pid() > 0 },

	// DirsAreAbsolute: a directory Self names is an absolute path, so a
	// file named under it is one place whatever the working directory.
	law DirsAreAbsolute() {
		let home = HomeDir() catch {
		case NoDir:
			"/"
		}
		let cache = CacheDir() catch {
		case NoDir:
			"/"
		}
		let config = ConfigDir() catch {
		case NoDir:
			"/"
		}
		let exe = Executable() catch {
		case NoDir:
			"/"
		}
		filepath.IsAbs(home) && filepath.IsAbs(cache) && filepath.IsAbs(config) && filepath.IsAbs(exe)
	},
}

// Pid is the process's id; a test's Host has the test process's.
func Pid(_ Host) int { hostPid() }

// HomeDir is the user's home: the test's folder for a test's Host.
func HomeDir(h Host) string fails NoDir {
	if h.root != "" {
		return h.root
	}
	try hostHomeDir()
}

// CacheDir is the user's cache directory: the folder's .cache for a
// test's Host.
func CacheDir(h Host) string fails NoDir {
	if h.root != "" {
		return filepath.Join([]string{h.root, ".cache"})
	}
	try hostCacheDir()
}

// ConfigDir is the user's configuration directory: the folder's .config
// for a test's Host.
func ConfigDir(h Host) string fails NoDir {
	if h.root != "" {
		return filepath.Join([]string{h.root, ".config"})
	}
	try hostConfigDir()
}

// Executable is the program's executable: the test binary's for a
// test's Host too, since a test that starts itself again runs it.
func Executable(_ Host) string fails NoDir { try hostExecutable() }

extern go ergo.local/prototype/runtime/v1.OSPid func hostPid() int
extern go ergo.local/prototype/runtime/v1.OSHomeDir func hostHomeDir() string fails NoDir
extern go ergo.local/prototype/runtime/v1.OSCacheDir func hostCacheDir() string fails NoDir
extern go ergo.local/prototype/runtime/v1.OSConfigDir func hostConfigDir() string fails NoDir
extern go ergo.local/prototype/runtime/v1.OSExecutable func hostExecutable() string fails NoDir

// Platform is the system and the processor a program was built for, as
// Go names them (GOOS and GOARCH): "linux" and "amd64", "darwin" and
// "arm64".
type Platform { OS string, Arch string }

// Current is the platform this program was built for. It is a fact of
// the built program, not of the host it runs on, so it needs no
// capability.
func Current() Platform { Platform{OS: runtime.GOOS, Arch: runtime.GOARCH} }
