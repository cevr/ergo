// Package bench is the referee of `ergo bench` (docs/specs/bench.md): the
// statistics that judge two sides of a benchmark from paired blocks. This
// file is the statistics (BN1): the Wilcoxon signed-rank test with the
// exact null distribution of tied ranks, the Hodges-Lehmann estimate with
// its distribution-free interval of Walsh averages, the levels of the
// planned looks, Holm's step-down for secondaries, the pairs a verdict
// still needs, and Decide, which turns the pairs of one series into a
// Verdict. Every function is pure: no clock, no process, no host.
//
// The method is strobe's (docs/specs/bench.md, Method; SPEC 9.3 of strobe
// 0.32.0), with three changes: the equivalence bound is symmetric in log
// space, so swapping the sides mirrors every verdict (law Mirror); there
// is no normal approximation, since a series is at most MaxPairs pairs and
// the exact distribution is cheap there; and an exact counter that moves
// is refused, not compared like a timed one.

import cmp
import gen
import math
import option
import slices
import strings

// MaxPairs is the most pairs one series may hold. Decide refuses more
// (TooManyPairs): up to it the exact null distribution is cheap, so no
// code path uses a normal approximation.
func MaxPairs() int { 400 }

// MinPairs is the fewest pairs at which any series gets a verdict: below
// it Decide refuses (FewPairs). At 6 pairs the signed-rank interval can
// reach 95%; below, its [min, max] covers at most 1 - 2^(1-n).
func MinPairs() int { 6 }

// Pair is one pair of blocks: the value of the counter on the base side
// and on the head side.
type Pair { Base float64, Head float64 }

// Kind is the kind of a counter (docs/specs/bench.md, Counters). An Exact
// counter holds one value on each side and is compared exactly; a Counted
// one (instructions, branches) and a Timed one (CPU, wall, peak memory)
// are judged over pairs.
type Kind = Exact | Counted | Timed

// Exact is the kind of a counter that holds one value per side.
type Exact {}

func drawUnit() float64 needs gen.Draws {
	float64(gen.Below(uint64(1)<<uint64(53))) / 9007199254740992.0
}

func showPairs(xs []Pair) string {
	let mut parts = []string{}
	for p in xs {
		parts = parts.Append("(\(p.Base),\(p.Head))")
	}
	"[\(strings.Join(parts, ", "))]"
}

func showFloats(xs []float64) string {
	let mut parts = []string{}
	for x in xs {
		parts = parts.Append("\(x)")
	}
	"[\(strings.Join(parts, ", "))]"
}

func showKind(k Kind) string {
	match k {
	case Exact:
		"Exact"
	case Counted:
		"Counted"
	case Timed:
		"Timed"
	}
}

func drawKind() Kind needs gen.Draws { kindOf(gen.IntIn(0, 2)) }

func drawLevel() float64 needs gen.Draws {
	if gen.Bool() { Level(Planned) } else { Level(Fixed{Pairs: 8}) }
}

// ScaleFree: both sides times one k > 0 keep the verdict, on the log
// scale and on the difference scale (half the series start with a base of
// 0 here).
law ScaleFree() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let kind = gen.Named("kind", showKind, drawKind)
		let zero = gen.Bool() && kind != Exact
		let k = gen.Named("scale", func(v float64) string { "\(v)" }, func() float64 needs gen.Draws {
			float64(gen.IntIn(1, 1000)) / 37.0 * math.Pow(10.0, float64(gen.IntIn(-3, 3)))
		})
		let n = gen.IntIn(0, lawPairs())
		let raw = gen.Named("pairs", showPairs, func() []Pair needs gen.Draws { drawnSeries(n, kind) })
		let mut pairs = []Pair{}
		let mut scaled = []Pair{}
		for i, p in raw {
			let base = if zero && i == 0 { 0.0 } else { p.Base }
			pairs = pairs.Append(Pair{Base: base, Head: p.Head})
			scaled = scaled.Append(Pair{Base: k * base, Head: k * p.Head})
		}
		let c = gen.OneOf([]Claim{Change{Bound: 0.02}, Change{Bound: 0.5}, NoWorseThan{Margin: 0.0}, NoWorseThan{Margin: 0.1}})
		let level = drawLevel()
		tag(Decide(pairs, kind, c, level)) == tag(Decide(scaled, kind, c, level))
	})) == ""
	true
}

// tag numbers the variants of a verdict, for laws that compare verdicts
// by what they decided.
func tag(v Verdict) int {
	match v {
	case Better:
		0
	case Worse:
		1
	case Same:
		2
	case NoWorse:
		3
	case Unclear:
		4
	case Underpowered:
		5
	case Refused:
		6
	}
}

// ExactIsExact: an exact counter that holds one value per side is decided
// by its one difference with coverage 1; one that moves once is refused.
law ExactIsExact() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let moved = gen.Named("moved", func(v bool) string { if v { "true" } else { "false" } }, gen.Bool)
		let n = gen.IntIn(MinPairs(), lawPairs())
		let pairs = gen.Named("pairs", showPairs, func() []Pair needs gen.Draws { drawnSeries(n, Exact) })
		let mut seen = []Pair{}
		for i, p in pairs {
			seen = seen.Append(if moved && i == pairs.Len()-1 { Pair{Base: p.Base, Head: p.Head + 1.0} } else { p })
		}
		let e = math.Log(pairs[0].Head) - math.Log(pairs[0].Base)
		match Decide(seen, Exact, Change{Bound: 0.5}, Level(Planned)) {
		case Refused as r:
			moved && r.Why == CounterUnstable
		case Better as b:
			!moved && e < 0.0 && b.Of.Exact && b.Of.Estimate == e && b.Of.Coverage == 1.0
		case Worse as w:
			!moved && e > 0.0 && w.Of.Exact && w.Of.Estimate == e && w.Of.Coverage == 1.0
		case Same as s:
			!moved && e == 0.0 && s.Of.Exact
		case _:
			false
		}
	})) == ""
	true
}

// Counted is the kind of a hardware count, tight but not exact.
type Counted {}

// Timed is the kind of a time or a memory peak.
type Timed {}

// IntervalHoldsEstimate: the interval holds its estimate.
law IntervalHoldsEstimate() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let n = gen.IntIn(1, lawPairs())
		let pairs = gen.Named("pairs", showPairs, func() []Pair needs gen.Draws { drawnSeries(n, Timed) })
		let level = gen.Named("level", func(v float64) string { "\(v)" }, drawLevel)
		let e = HodgesLehmann(differences(pairs, positive(pairs)), level)
		e.Low <= e.Center && e.Center <= e.High
	})) == ""
	true
}

// lawPairs is the most pairs a law of the statistics draws for one
// series: the exact null table costs about n^3/4 additions, and a law's
// 100 cases stay inside check time's budget at 12 (BENCH-LAW-COST). No
// branch of Decide needs more: every level a design asks is reached at
// PairsFor(level), 7 at most. Past 12 pairs, up to MaxPairs, a seeded
// property of a built program holds SignedRankP and HodgesLehmann to the
// reference (lower TestStdBenchMatchesReference, BENCH-PROP).
func lawPairs() int { 12 }

// drawnSeries is n pairs drawn from gen.Draws for a counter of kind k: an
// effect from -30% to +30% (with 0 and the ±2% edges likely), a noise
// width from 0.1% to 300%, and in one series of eight a 0 on the base
// side, which moves it to the difference scale. An Exact series holds one
// whole value per side, from 1 to 1000.
func drawnSeries(n int, k Kind) []Pair needs gen.Draws {
	let effect = gen.OneOf([]float64{0.0, -0.3, -0.0202, -0.0198, 0.0, 0.0198, 0.0202, 0.3})
	let width = gen.OneOf([]float64{0.001, 0.02, 0.2, 1.0, 3.0})
	let zero = gen.IntIn(0, 7) == 1 && k != Exact
	let exactBase = float64(gen.IntIn(1, 1000))
	let exactHead = float64(gen.IntIn(1, 1000))
	let mut out = []Pair{}
	for i in 0..n {
		let base = match k {
		case Exact:
			exactBase
		case Counted, Timed:
			100.0 * (1.0 + drawUnit())
		}
		let noise = match k {
		case Exact:
			0.0
		case Counted, Timed:
			width * (drawUnit() - 0.5)
		}
		let head = match k {
		case Exact:
			exactHead
		case Counted, Timed:
			base * math.Exp(effect+noise)
		}
		out = out.Append(Pair{Base: if zero && i == 0 { 0.0 } else { base }, Head: head})
	}
	out
}

// Claim is the question a series answers. Every counter is better lower:
// a count of work, a time, a size.
type Claim = Change | NoWorseThan

// Change asks whether head differs from base. Bound is the equivalence
// bound as a fraction (0.02 for 2%): Same when the interval lies inside
// it. On the log scale the bound is ±ln(1 + Bound), the same both ways.
// A Bound below 0 is 0.
type Change { Bound float64 }

// Mirror: swapping the sides negates the estimate, mirrors the interval,
// swaps Better and Worse and keeps every other verdict, its p-value and
// its pairs needed, for every kind, scale and bound.
law Mirror() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let k = gen.Named("kind", showKind, drawKind)
		let n = gen.IntIn(0, lawPairs())
		let pairs = gen.Named("pairs", showPairs, func() []Pair needs gen.Draws { drawnSeries(n, k) })
		let c = Change{Bound: gen.OneOf([]float64{0.0, 0.02, 0.5, 1.0})}
		let level = drawLevel()
		mirror(Decide(pairs, k, c, level), Decide(swapped(pairs), k, c, level))
	})) == ""
	true
}

// kindOf is the kind of counter pick names.
func kindOf(pick int) Kind {
	match within(pick, 0, 2) {
	case 0:
		Exact
	case 1:
		Counted
	case _:
		Timed
	}
}

// swapped is pairs with base and head swapped.
func swapped(pairs []Pair) []Pair {
	let mut out = []Pair{}
	for p in pairs {
		out = out.Append(Pair{Base: p.Head, Head: p.Base})
	}
	out
}

// mirror reports whether b is a with the sides swapped: Better and Worse
// change places, every other variant stays, and its difference is negated
// with the same pairs, coverage, p-value and pairs needed.
func mirror(a Verdict, b Verdict) bool {
	match (a, b) {
	case (Better as x, Worse as y):
		negated(x.Of, y.Of)
	case (Worse as x, Better as y):
		negated(x.Of, y.Of)
	case (Same as x, Same as y):
		negated(x.Of, y.Of)
	case (NoWorse as x, NoWorse as y):
		negated(x.Of, y.Of)
	case (Unclear as x, Unclear as y):
		negated(x.Of, y.Of) && x.Needed == y.Needed
	case (Underpowered as x, Underpowered as y):
		negated(x.Of, y.Of) && x.Needed == y.Needed
	case (Refused as x, Refused as y):
		x.Why == y.Why
	case _:
		false
	}
}

func negated(x Difference, y Difference) bool {
	x.Pairs == y.Pairs && x.Log == y.Log && x.Exact == y.Exact && y.Estimate == -x.Estimate && y.Low == -x.High && y.High == -x.Low && y.Coverage == x.Coverage && y.P == x.P
}

// NoWorseThan asks whether head is at most Margin worse than base, as a
// fraction (0 for "no worse at all"). A Margin below 0 is 0.
type NoWorseThan { Margin float64 }

// Design is the plan of a series' looks: Planned, strobe's five Pocock
// looks, or Fixed, one look after Pairs pairs.
type Design = Planned | Fixed

// Planned looks at 8, 12, 18, 26 and 40 pairs, each at PocockLevel, so
// the chance of any false verdict over the five looks is 5%.
type Planned {}

// PlannedLevelIsPocock: a planned look's level is Pocock's boundary 2.413
// for five looks at 5% overall, as a two-sided level, and one fixed look
// is at 95%.
law PlannedLevelIsPocock() {
	math.Abs(Level(Planned)-(1.0-erfc(2.413/math.Sqrt(2.0)))) < 5e-5 && Level(Fixed{Pairs: 8}) == 0.95
}

// erfc is the complementary error function (Numerical Recipes erfcc,
// fractional error below 1.2e-7).
func erfc(x float64) float64 {
	let z = math.Abs(x)
	let t = 1.0 / (1.0 + 0.5*z)
	let r = t * math.Exp(-z*z-1.26551223+t*(1.00002368+t*(0.37409196+t*(0.09678418+t*(-0.18628806+t*(0.27886807+t*(-1.13520398+t*(1.48851587+t*(-0.82215223+t*0.17087277)))))))))
	if x >= 0.0 { r } else { 2.0 - r }
}

// Fixed looks once, after Pairs pairs, at 95%.
type Fixed { Pairs int }

// Level is the confidence of an interval at a look of d: 98.42% for each
// planned look (Pocock's constant 2.413 for five looks at 5%), 95% for one
// fixed look.
func Level(d Design) float64 {
	match d {
	case Planned:
		0.9842
	case Fixed:
		0.95
	}
}

// IntervalCoverageIsExact: for n distinct sizes, the share of the 2^n sign
// patterns whose Hodges-Lehmann interval leaves out 0 is 1 - Coverage
// exactly, and Coverage reaches the level once n reaches PairsFor(level).
law IntervalCoverageIsExact() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let n = gen.Named("n", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(1, 6) })
		let level = gen.Named("level", func(v float64) string { "\(v)" }, func() float64 needs gen.Draws {
			gen.OneOf([]float64{0.5, 0.9, Level(Fixed{Pairs: n}), Level(Planned)})
		})
		let sizes = gen.Named("sizes", showFloats, func() []float64 needs gen.Draws {
			let mut out = []float64{}
			for k in 0..n {
				out = out.Append(float64(k+1) + float64(gen.IntIn(0, 999))/2000.0)
			}
			out
		})
		let untied = untiedNull(n)
		let mut out = 0
		let mut coverage = 0.0
		for mask in 0..(1 << n) {
			let mut d = []float64{}
			for k, x in sizes {
				d = d.Append(if (mask>>k)&1 == 1 { x } else { -x })
			}
			let e = hodgesLehmann(d, level, untied)
			coverage = e.Coverage
			if e.Low > 0.0 || e.High < 0.0 {
				out = out + 1
			}
		}
		math.Abs(float64(out)/float64(1<<n)-(1.0-coverage)) <= 1e-12 && (n < PairsFor(level) || coverage+1e-12 >= level)
	})) == ""
	true
}

// Looks are the pairs after which d judges, in order.
func Looks(d Design) []int {
	match d {
	case Planned:
		[]int{8, 12, 18, 26, 40}
	case Fixed as f:
		[]int{f.Pairs}
	}
}

// IsLook reports whether d judges after n pairs.
func IsLook(d Design, n int) bool { slices.Contains(Looks(d), n) }

// Difference is what a judged series measured, in the scale of its
// differences: ln(head) - ln(base) per pair when every value is above 0
// (Log), else head - base. Estimate is the Hodges-Lehmann estimate, Low
// and High its interval, Coverage the confidence the interval reaches
// (at least the level asked, or the verdict is Unclear), and P the
// two-sided signed-rank p-value (of the differences less the margin for
// a NoWorseThan claim). An Exact difference holds one value: Low and High
// are the Estimate, Coverage is 1 and P is 0 when it moved, 1 when not.
type Difference {
	Pairs    int,
	Log      bool,
	Estimate float64,
	Low      float64,
	High     float64,
	Coverage float64,
	P        float64,
	Exact    bool,
}

// Verdict is what the referee says of one series. Every variant but
// Refused carries its Difference; a Refused one carries no number at all.
type Verdict = Better | Worse | Same | NoWorse | Unclear | Underpowered | Refused

// Better: head is lower than base (its interval lies below 0).
type Better { Of Difference }

// Worse: head is higher than base (its interval lies above 0), or above
// the margin of a NoWorseThan claim.
type Worse { Of Difference }

// Same: the interval lies inside the equivalence bound.
type Same { Of Difference }

// AllEqualIsSame: pairs whose sides are equal are Same on a change claim
// and NoWorse on a no-worse claim with a margin above 0, once there are
// pairs enough for the level. (With a margin of 0 an interval of [0, 0]
// lies not below the margin: a judged series says Unclear there, and only
// an exact counter, which has no interval, says NoWorse.)
law AllEqualIsSame() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let k = gen.Named("kind", showKind, drawKind)
		let level = drawLevel()
		let n = gen.IntIn(PairsFor(level), lawPairs())
		let raw = gen.Named("pairs", showPairs, func() []Pair needs gen.Draws { drawnSeries(n, k) })
		let mut pairs = []Pair{}
		for p in raw {
			pairs = pairs.Append(Pair{Base: p.Base, Head: p.Base})
		}
		let worse = NoWorseThan{Margin: float64(gen.IntIn(1, 3)) / 10.0}
		let change = Change{Bound: float64(gen.IntIn(0, 2)) / 50.0}
		match (Decide(pairs, k, change, level), Decide(pairs, k, worse, level)) {
		case (Same, NoWorse):
			true
		case _:
			false
		}
	})) == ""
	true
}

// NoWorse: the interval lies below the margin of a NoWorseThan claim.
type NoWorse { Of Difference }

// NoWorseReadsTheInterval: a no-worse claim is NoWorse exactly when the
// interval reaches the level and lies below the margin in the scale of the
// differences (ln(1 + Margin) on the log scale), and Worse exactly when it
// reaches the level and lies above it.
law NoWorseReadsTheInterval() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let n = gen.IntIn(MinPairs(), lawPairs())
		let pairs = gen.Named("pairs", showPairs, func() []Pair needs gen.Draws { drawnSeries(n, Counted) })
		let m = gen.Named("margin", func(v float64) string { "\(v)" }, func() float64 needs gen.Draws {
			gen.OneOf([]float64{0.0, 0.02, 0.1})
		})
		let level = drawLevel()
		let shift = threshold(pairs, positive(pairs), NoWorseThan{Margin: m})
		let e = HodgesLehmann(differences(pairs, positive(pairs)), level)
		let covered = e.Coverage+1e-9 >= level
		match Decide(pairs, Counted, NoWorseThan{Margin: m}, level) {
		case NoWorse:
			covered && e.High < shift
		case Worse:
			covered && e.Low > shift
		case Unclear:
			!(covered && (e.High < shift || e.Low > shift))
		case _:
			false
		}
	})) == ""
	true
}

// Unclear: the pairs decide nothing yet. Needed is the pairs projected
// for an 80% chance to decide, when a projection exists.
type Unclear { Of Difference, Needed option.Option[int] }

// Underpowered: the series stopped undecided because it would need more
// pairs than its design has (the referee's futility stop, BN2).
type Underpowered { Of Difference, Needed int }

// Refused: the series has no valid value. Why names the validator.
type Refused { Why Refusal }

// Refusal is why a series has no value (docs/specs/bench.md, Refusals).
type Refusal = NoCounter | Multiplexed | RunIncomplete | NotEquivalent | CounterUnstable | NoMetric | FewPairs | TooManyPairs | NotFinite | SharedRunner

// NoCounter: the host has no counter of this kind.
type NoCounter {}

// Multiplexed: the kernel counted the event for part of the run only.
type Multiplexed {}

// RunIncomplete: a block exited nonzero or left a process running.
type RunIncomplete {}

// NotEquivalent: the sides printed different sums, so they did not do the
// same work.
type NotEquivalent {}

// CounterUnstable: an exact counter took more than one value on a side.
type CounterUnstable {}

// NoMetric: a declared counter that a block did not report. A run that
// printed none is not 0.
type NoMetric {}

// FewPairs: fewer than MinPairs pairs, which no interval can judge.
type FewPairs { Pairs int }

// FewPairsNeverDecide: fewer than 6 pairs are refused, whatever their
// kind and claim.
law FewPairsNeverDecide() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let n = gen.Named("n", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 5) })
		let k = gen.Named("kind", showKind, drawKind)
		let c = gen.OneOf([]Claim{Change{Bound: 0.02}, NoWorseThan{Margin: 0.0}})
		let pairs = gen.Named("pairs", showPairs, func() []Pair needs gen.Draws { drawnSeries(n, k) })
		match Decide(pairs, k, c, drawLevel()) {
		case Refused as r:
			r.Why == FewPairs{Pairs: n}
		case _:
			false
		}
	})) == ""
	true
}

// TooManyPairs: more than MaxPairs pairs in one series.
type TooManyPairs { Pairs int }

// NotFinite: the pair at index Pair holds a NaN or an infinity.
type NotFinite { Pair int }

// SharedRunner: a timed counter in a shared CI virtual machine.
type SharedRunner {}

// Decide judges the pairs of one series of a counter of kind k on claim c
// at confidence level (Level of the design at this look). It refuses more
// than MaxPairs pairs, a value that is not finite, and fewer than MinPairs
// pairs. An Exact counter that holds one value on each side is compared
// exactly; one that moved is CounterUnstable. Any other counter is judged
// by its interval: Better or Worse when it lies wholly on one side of 0,
// Same when it lies inside the bound, NoWorse or Worse when it lies below
// or above the margin; else Unclear. An interval that does not reach the
// level decides nothing.
func Decide(pairs []Pair, k Kind, c Claim, level float64) Verdict {
	let n = pairs.Len()
	if n > MaxPairs() {
		return Refused{Why: TooManyPairs{Pairs: n}}
	}
	for i, p in pairs {
		if !finite(p.Base) || !finite(p.Head) {
			return Refused{Why: NotFinite{Pair: i}}
		}
	}
	if n < MinPairs() {
		return Refused{Why: FewPairs{Pairs: n}}
	}
	let log = positive(pairs)
	let d = differences(pairs, log)
	let shift = threshold(pairs, log, c)
	match k {
	case Exact:
		exactly(pairs, d, log, c, shift)
	case Counted, Timed:
		judge(d, log, c, shift, level)
	}
}

// exactly compares an exact counter: its difference is the answer when
// each side held one value.
func exactly(pairs []Pair, d []float64, log bool, c Claim, shift float64) Verdict {
	for p in pairs {
		if p.Base != pairs[0].Base || p.Head != pairs[0].Head {
			return Refused{Why: CounterUnstable}
		}
	}
	let e = d[0]
	let of = Difference{Pairs: d.Len(), Log: log, Estimate: e, Low: e, High: e, Coverage: 1.0, P: if e == 0.0 { 1.0 } else { 0.0 }, Exact: true}
	match c {
	case Change:
		if e < 0.0 {
			return Better{Of: of}
		}
		if e > 0.0 {
			return Worse{Of: of}
		}
		Same{Of: of}
	case NoWorseThan:
		if e <= shift {
			return NoWorse{Of: of}
		}
		Worse{Of: of}
	}
}

// judge reads the interval of d at level against claim c, whose bound or
// margin is shift in d's scale.
func judge(d []float64, log bool, c Claim, shift float64, level float64) Verdict {
	let untied = untiedNull(d.Len())
	let hl = hodgesLehmann(d, level, untied)
	let covered = hl.Coverage+1e-9 >= level
	match c {
	case Change:
		let of = Difference{Pairs: d.Len(), Log: log, Estimate: hl.Center, Low: hl.Low, High: hl.High, Coverage: hl.Coverage, P: signedRankP(d, untied), Exact: false}
		if !covered {
			return Unclear{Of: of, Needed: Needed(d, shift, level, 0.8)}
		}
		if hl.High < 0.0 {
			return Better{Of: of}
		}
		if hl.Low > 0.0 {
			return Worse{Of: of}
		}
		if (hl.Low > -shift && hl.High < shift) || (hl.Low == 0.0 && hl.High == 0.0) {
			return Same{Of: of}
		}
		Unclear{Of: of, Needed: Needed(d, shift, level, 0.8)}
	case NoWorseThan:
		let mut moved = []float64{}
		for x in d {
			moved = moved.Append(x - shift)
		}
		let of = Difference{Pairs: d.Len(), Log: log, Estimate: hl.Center, Low: hl.Low, High: hl.High, Coverage: hl.Coverage, P: signedRankP(moved, untied), Exact: false}
		if !covered {
			return Unclear{Of: of, Needed: neededBeside(d, shift, level, 0.8)}
		}
		if hl.High < shift {
			return NoWorse{Of: of}
		}
		if hl.Low > shift {
			return Worse{Of: of}
		}
		Unclear{Of: of, Needed: neededBeside(d, shift, level, 0.8)}
	}
}

// threshold is c's bound or margin in the scale of the differences:
// ln(1 + x) on the log scale; else x times the larger of the two sides'
// medians, so that swapping the sides keeps it.
func threshold(pairs []Pair, log bool, c Claim) float64 {
	let x = match c {
	case Change as ch:
		ch.Bound
	case NoWorseThan as nw:
		nw.Margin
	}
	let f = if x > 0.0 { x } else { 0.0 }
	if log {
		return math.Log(1.0 + f)
	}
	let mut bs = []float64{}
	let mut hs = []float64{}
	for p in pairs {
		bs = bs.Append(p.Base)
		hs = hs.Append(p.Head)
	}
	let b = math.Abs(Median(bs))
	let h = math.Abs(Median(hs))
	f * if b >= h { b } else { h }
}

// differences are the per-pair differences: ln(head) - ln(base) on the
// log scale (a subtraction, so swapping the sides negates each exactly),
// else head - base.
func differences(pairs []Pair, log bool) []float64 {
	let mut d = []float64{}
	for p in pairs {
		d = d.Append(if log { math.Log(p.Head) - math.Log(p.Base) } else { p.Head - p.Base })
	}
	d
}

// positive reports whether every value of pairs is above 0.
func positive(pairs []Pair) bool {
	for p in pairs {
		if !(p.Base > 0.0) || !(p.Head > 0.0) {
			return false
		}
	}
	true
}

func finite(x float64) bool { !math.IsNaN(x) && !math.IsInf(x, 0) }

// signed is one nonzero difference: its size and whether it is above 0.
type signed { size float64, up bool }

// SignedRankP is the two-sided p-value of the Wilcoxon signed-rank test
// of d. Zeros are dropped; tied sizes share their mid-rank, and the null
// distribution is that of those ranks over every sign assignment, built
// exactly (nullOf the doubled ranks), never the untied distribution or a
// normal tail. With no nonzero difference it is 1.
func SignedRankP(d []float64) float64 { signedRankP(d, []float64{}) }

// MatchesEnumeration: for up to 9 differences of small whole sizes (many
// ties and zeros), SignedRankP is the count over all 2^m sign patterns of
// the m nonzero differences, with zeros dropped and ties at their
// mid-rank: twice the smaller tail at the observed statistic, at most 1.
law MatchesEnumeration() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let d = gen.Named("d", showFloats, func() []float64 needs gen.Draws {
			gen.ListOf(0, 9, func() float64 needs gen.Draws { float64(gen.IntIn(-3, 3)) })
		})
		let mut sizes = []float64{}
		let mut ups = []bool{}
		for x in d {
			if x != 0.0 {
				sizes = sizes.Append(math.Abs(x))
				ups = ups.Append(x > 0.0)
			}
		}
		let m = sizes.Len()
		let ranks = doubledRanks(sizes)
		let mut t = 0
		for k, r in ranks {
			if ups[k] {
				t = t + r
			}
		}
		let mut low = 0
		let mut high = 0
		for mask in 0..(1 << m) {
			let mut s = 0
			for k, r in ranks {
				if (mask>>k)&1 == 1 {
					s = s + r
				}
			}
			if s <= t {
				low = low + 1
			}
			if s >= t {
				high = high + 1
			}
		}
		let tail = if low <= high { low } else { high }
		let twice = 2.0 * float64(tail) / float64(1<<m)
		let want = if twice < 1.0 { twice } else { 1.0 }
		math.Abs(SignedRankP(d)-want) <= 1e-12
	})) == ""
	true
}

// within is n moved into lo..hi, so a law covers every n.
func within(n int, lo int, hi int) int {
	let span = hi - lo + 1
	let r = n % span
	if r < 0 { lo + r + span } else { lo + r }
}

// doubledRanks are the doubled mid-ranks of sizes, by brute force: a size
// with b smaller and e equal sizes (itself included) has mid-rank b +
// (e + 1) / 2.
func doubledRanks(sizes []float64) []int {
	let mut out = []int{}
	for x in sizes {
		let mut below = 0
		let mut equal = 0
		for y in sizes {
			if y < x {
				below = below + 1
			}
			if y == x {
				equal = equal + 1
			}
		}
		out = out.Append(2*below + equal + 1)
	}
	out
}

// SignedRankPMatchesReference: SignedRankP, and its form that reads a
// Decide's untied table, give the p-value of the reference table.
law SignedRankPMatchesReference() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let whole = gen.Named("whole", func(v bool) string { if v { "true" } else { "false" } }, gen.Bool)
		let d = gen.Named("d", showFloats, func() []float64 needs gen.Draws { drawnDifferences(12, whole) })
		let mut sizes = []float64{}
		let mut ups = []bool{}
		for x in d {
			if x != 0.0 {
				sizes = sizes.Append(if x < 0.0 { -x } else { x })
				ups = ups.Append(x > 0.0)
			}
		}
		let ranks = doubledRanks(sizes)
		let mut t2 = 0
		for k, r in ranks {
			if ups[k] {
				t2 = t2 + r
			}
		}
		let null = refNull(ranks)
		let top = null.Len() - 1
		let t = if t2 <= top-t2 { t2 } else { top - t2 }
		let mut tail = 0.0
		for k in 0..t+1 {
			tail = tail + null[k]
		}
		let twice = 2.0 * tail
		let p = if sizes.Len() == 0 { 1.0 } else { if twice < 1.0 { twice } else { 1.0 } }
		SignedRankP(d) == p && signedRankP(d, untiedNull(d.Len())) == p
	})) == ""
	true
}

// signedRankP is SignedRankP, reading the lower half of the untied null
// distribution from untied (untiedNull of len(d)) when d has no zero and
// no tie, so a Decide builds that table once for its interval and its
// p-value; an untied of another length is not read.
func signedRankP(d []float64, untied []float64) float64 {
	let mut s = []signed{}
	for x in d {
		if x != 0.0 {
			s = s.Append(signed{size: math.Abs(x), up: x > 0.0})
		}
	}
	let n = s.Len()
	if n == 0 {
		return 1.0
	}
	let sorted = slices.SortFunc(s, func(a signed, b signed) int { cmp.Compare(a.size, b.size) })
	// Doubled mid-ranks: a tie at sorted positions i to j (0-based) has
	// rank (i + j + 2) / 2 each, so i + j + 2 doubled, a whole number.
	let mut ranks = []int{}
	let mut t2 = 0
	let mut tied = false
	let mut i = 0
	for i < n {
		let mut j = i
		for j+1 < n && sorted[j+1].size == sorted[i].size {
			j = j + 1
			tied = true
		}
		for k in i..j+1 {
			let r = i + j + 2
			ranks = ranks.Append(r)
			if sorted[k].up {
				t2 = t2 + r
			}
		}
		i = j + 1
	}
	let mut top = 0
	let mut g = 0
	for r in ranks {
		top = top + r
		g = gcd(g, r)
	}
	// The distribution is symmetric, so the smaller tail is the lower tail
	// at the nearer end; summing that one side keeps p the same, bit for
	// bit, when the sides swap. Only that tail is built, over the ranks
	// divided by their common divisor (every doubled rank is even when no
	// size ties), which keeps each sum and its chance.
	let t = if t2 <= top-t2 { t2 } else { top - t2 }
	let mut tail = 0.0
	if !tied && n == d.Len() && t/g < untied.Len() {
		// Untied doubled ranks are 2, 4, …, 2n: the untied table at t/2.
		for k in 0..t/g+1 {
			tail = tail + untied[k]
		}
	} else {
		let mut scaled = []int{}
		for r in ranks {
			scaled = scaled.Append(r / g)
		}
		for x in nullOf(scaled, t/g) {
			tail = tail + x
		}
	}
	let p = 2.0 * tail
	if p < 1.0 { p } else { 1.0 }
}

// nullOf is the lower part of the null distribution of the signed-rank
// statistic for ranks: nullOf(ranks, upto)[s], for s from 0 to upto (at
// most the sum of the ranks), is the chance that the ranks given a plus
// sign sum to s when each sign is a fair coin. A sum up to upto is made
// only of smaller sums, so the part is exact without the rest. It counts
// the sign patterns of each sum (each rank adds the counts r below; a
// count is at most 2^MaxPairs, inside a float64) and divides by 2^n once
// at the end, so the work is the counts' additions alone: at most
// len(ranks) times upto, where the whole table was len(ranks) times the
// sum, cubic in the pairs.
func nullOf(ranks []int, upto int) []float64 {
	let mut top = 0
	for r in ranks {
		top = top + r
	}
	let u = if upto < top { upto } else { top }
	let mut c = []float64{}
	for _ in 0..u+1 {
		c = c.Append(0.0)
	}
	c[0] = 1.0
	let mut reach = 0
	for r in ranks {
		reach = reach + r
		let mut s = if reach < u { reach } else { u }
		for s >= r {
			c[s] = c[s] + c[s-r]
			s = s - 1
		}
	}
	// 2^-n, exact: n halvings of 1 stay normal floats for n up to
	// MaxPairs.
	let mut scale = 1.0
	for _ in ranks {
		scale = scale * 0.5
	}
	for s in 0..u+1 {
		c[s] = c[s] * scale
	}
	c
}

// gcd is the greatest common divisor of a and b, for a, b >= 0; gcd(0, b)
// is b.
func gcd(a int, b int) int {
	let mut x = a
	let mut y = b
	for y != 0 {
		let r = x % y
		x = y
		y = r
	}
	x
}

// NullMatchesReference: the part of the table nullOf builds is the
// reference table's, for the doubled tied ranks of drawn differences and
// for the same ranks over their common divisor, up to any cut.
law NullMatchesReference() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let whole = gen.Named("whole", func(v bool) string { if v { "true" } else { "false" } }, gen.Bool)
		let divide = gen.Named("divide", func(v bool) string { if v { "true" } else { "false" } }, gen.Bool)
		let d = gen.Named("d", showFloats, func() []float64 needs gen.Draws { drawnDifferences(12, whole) })
		let mut sizes = []float64{}
		for x in d {
			if x != 0.0 {
				sizes = sizes.Append(if x < 0.0 { -x } else { x })
			}
		}
		let doubled = doubledRanks(sizes)
		let mut g = 0
		for r in doubled {
			g = gcd(g, r)
		}
		let mut ranks = []int{}
		for r in doubled {
			ranks = ranks.Append(if divide && g > 0 { r / g } else { r })
		}
		let want = refNull(ranks)
		let upto = gen.Named("upto", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, want.Len()) })
		let got = nullOf(ranks, upto)
		let mut same = got.Len() == (if upto < want.Len() { upto + 1 } else { want.Len() })
		for s, x in got {
			same = same && x == want[s]
		}
		same
	})) == ""
	true
}

// refNull is the whole null distribution of the signed-rank statistic for
// ranks, built as BN1 built it: each rank halves the chances it adds to.
func refNull(ranks []int) []float64 {
	let mut top = 0
	for r in ranks {
		top = top + r
	}
	let mut c = []float64{}
	for _ in 0..top+1 {
		c = c.Append(0.0)
	}
	c[0] = 1.0
	let mut reach = 0
	for r in ranks {
		reach = reach + r
		let mut s = reach
		for s >= 0 {
			let below = if s >= r { c[s-r] } else { 0.0 }
			c[s] = 0.5 * (c[s] + below)
			s = s - 1
		}
	}
	c
}

// drawnDifferences are up to max differences drawn from gen.Draws: small
// whole sizes from -4 to 4 (ties and zeros) when whole, else reals in
// [-0.5, 0.5).
func drawnDifferences(max int, whole bool) []float64 needs gen.Draws {
	gen.ListOf(0, max, func() float64 needs gen.Draws {
		if whole { float64(gen.IntIn(-4, 4)) } else { drawUnit() - 0.5 }
	})
}

// Estimate is a Hodges-Lehmann estimate: Center, its interval from Low to
// High, and the Coverage that interval reaches.
type Estimate { Center float64, Low float64, High float64, Coverage float64 }

// HodgesLehmann is the Hodges-Lehmann estimate of d, the median of its
// Walsh averages (d[i] + d[j]) / 2 for i <= j, and its distribution-free
// interval at level: [W(c), W(m-1-c)] of the m sorted averages (0-based),
// with c the largest value where P(T <= c) <= (1 - level) / 2 for the
// signed-rank statistic T of len(d) untied ranks. It covers
// 1 - 2 P(T <= c). When even c = 0 is too likely (too few pairs for the
// level), the interval is [min, max], which covers 1 - 2 P(T = 0). With
// no differences every field is 0.
func HodgesLehmann(d []float64, level float64) Estimate { hodgesLehmann(d, level, untiedNull(d.Len())) }

// HodgesLehmannMatchesReference: the interval read from the half table
// untiedNull is the one read from the reference's whole table, at levels
// from 0 to 99.9%.
law HodgesLehmannMatchesReference() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let d = gen.Named("d", showFloats, func() []float64 needs gen.Draws { drawnDifferences(12, false) })
		let level = gen.Named("level", func(v float64) string { "\(v)" }, func() float64 needs gen.Draws {
			gen.OneOf([]float64{0.0, 0.5, 0.9, 0.95, 0.9842, 0.999})
		})
		let want = hodgesLehmann(d, level, refNull(ranksTo(d.Len())))
		HodgesLehmann(d, level) == want && hodgesLehmann(d, level, untiedNull(d.Len())) == want
	})) == ""
	true
}

// untiedNull is the lower half of the null distribution of n untied ranks
// 1..n: nullOf of them up to their median n(n+1)/4. The distribution is
// symmetric, so a lower tail below one half lies in it.
func untiedNull(n int) []float64 { nullOf(ranksTo(n), n*(n+1)/4) }

// ranksTo is the ranks 1..n.
func ranksTo(n int) []int {
	let mut ranks = []int{}
	for k in 1..n+1 {
		ranks = ranks.Append(k)
	}
	ranks
}

// hodgesLehmann is HodgesLehmann with untied, untiedNull(len(d)), given.
func hodgesLehmann(d []float64, level float64, untied []float64) Estimate {
	let n = d.Len()
	if n == 0 {
		return Estimate{Center: 0.0, Low: 0.0, High: 0.0, Coverage: 0.0}
	}
	let mut walsh = []float64{}
	for i in 0..n {
		for j in i..n {
			walsh = walsh.Append((d[i] + d[j]) / 2.0)
		}
	}
	let w = slices.Sort(walsh)
	let m = w.Len()
	let center = if m%2 == 1 { w[m/2] } else { (w[m/2-1] + w[m/2]) / 2.0 }
	let half = (1.0 - level) / 2.0
	// A lower tail up to half, below one half, ends inside untied; a level
	// below 0 asks for more, and builds the whole table.
	let null = if half < 0.5 { untied } else { nullOf(ranksTo(n), n*(n+1)/2) }
	let mut acc = 0.0
	let mut c = -1
	let mut k = 0
	for k < null.Len() && acc+null[k] <= half {
		acc = acc + null[k]
		c = k
		k = k + 1
	}
	if c < 0 {
		return Estimate{Center: center, Low: w[0], High: w[m-1], Coverage: 1.0 - 2.0*null[0]}
	}
	Estimate{Center: center, Low: w[c], High: w[m-1-c], Coverage: 1.0 - 2.0*acc}
}

// Median is the median of xs: the middle value, or the mean of the two
// middle values. Of no values it is 0.
func Median(xs []float64) float64 {
	let n = xs.Len()
	if n == 0 {
		return 0.0
	}
	let s = slices.Sort(xs)
	if n%2 == 1 { s[n/2] } else { (s[n/2-1] + s[n/2]) / 2.0 }
}

// Spread is a robust standard deviation of xs: 1.4826 times the median
// absolute deviation from the median. When over half the values are one
// value (a count, a quantized time), that is 0, so it is then the mean
// absolute deviation from the median times sqrt(pi / 2), the normal's
// sigma.
func Spread(xs []float64) float64 {
	let med = Median(xs)
	let mut dev = []float64{}
	for x in xs {
		dev = dev.Append(math.Abs(x - med))
	}
	let r = 1.4826 * Median(dev)
	if r > 0.0 || xs.Len() == 0 {
		return r
	}
	let mut sum = 0.0
	for x in dev {
		sum = sum + x
	}
	1.2533 * sum / float64(xs.Len())
}

// Needed is the pairs projected for a power chance that an interval at
// level clears a bound shift away (in d's scale): the distance from d's
// median to 0 or to the bound, whichever is farther, over the spread, with
// the Hodges-Lehmann efficiency 0.955, and never fewer than the pairs the
// level needs. None when nothing projects: fewer than 2 differences, or a
// median on the boundary.
func Needed(d []float64, shift float64, level float64, power float64) option.Option[int] {
	if d.Len() < 2 {
		return option.None
	}
	let med = math.Abs(Median(d))
	let far = shift - med
	project(Spread(d), if med >= far { med } else { far }, level, power)
}

// neededBeside is Needed for a NoWorseThan claim: the distance that
// decides is the one from d's median to the margin, either way.
func neededBeside(d []float64, shift float64, level float64, power float64) option.Option[int] {
	if d.Len() < 2 {
		return option.None
	}
	project(Spread(d), math.Abs(Median(d)-shift), level, power)
}

// project is ((z(level) + z(power)) sigma / dist)^2 / 0.955 pairs, at
// least the pairs whose interval can reach level; None for dist 0 or a
// count too large to run.
func project(sigma float64, dist float64, level float64, power float64) option.Option[int] {
	if !(dist > 0.0) || !finite(sigma) {
		return option.None
	}
	let z = Quantile(1.0-(1.0-level)/2.0) + Quantile(power)
	let x = z * sigma / dist
	let pairs = math.Ceil(x * x / 0.955)
	if !(pairs < 1e9) {
		return option.None
	}
	let least = PairsFor(level)
	option.Some[int]{Value: if int(pairs) >= least { int(pairs) } else { least }}
}

// PairsFor is the fewest pairs whose signed-rank interval can reach
// level: the least n with 1 - 2^(1-n) >= level (6 at 95%, 7 at 98.42%).
func PairsFor(level float64) int {
	let mut n = 1
	let mut tail = 1.0
	for n < 64 && 1.0-tail < level {
		n = n + 1
		tail = tail / 2.0
	}
	n
}

// Quantile is the standard normal quantile of p in (0, 1), by Acklam's
// rational approximation (relative error below 1.2e-9).
func Quantile(p float64) float64 {
	let low = 0.02425
	if p < low {
		let q = math.Sqrt(-2.0 * math.Log(p))
		return (((((-0.007784894002430293*q-0.3223964580411365)*q-2.400758277161838)*q-2.549732539343734)*q+4.374664141464968)*q + 2.938163982698783) / ((((0.007784695709041462*q+0.3224671290700398)*q+2.445134137142996)*q+3.754408661907416)*q + 1.0)
	}
	if p > 1.0-low {
		return -Quantile(1.0 - p)
	}
	let q = p - 0.5
	let r = q * q
	(((((-39.69683028665376*r+220.9460984245205)*r-275.9285104469687)*r+138.357751867269)*r-30.66479806614716)*r + 2.506628277459239) * q / (((((-54.47609879822406*r+161.5858368580409)*r-155.6989798598866)*r+66.80131188771972)*r-13.28068155288572)*r + 1.0)
}

// Holm is Holm's step-down at alpha: which of the p-values ps are
// rejected, in their order. The k-th smallest (from 0) is rejected when it
// and every smaller one is at most alpha / (len(ps) - k).
func Holm(ps []float64, alpha float64) []bool {
	let n = ps.Len()
	let mut order = []int{}
	for i in 0..n {
		order = order.Append(i)
	}
	let sorted = slices.SortStableFunc(order, func(a int, b int) int { cmp.Compare(ps[a], ps[b]) })
	let mut out = []bool{}
	for _ in 0..n {
		out = out.Append(false)
	}
	for rank, i in sorted {
		if !(ps[i] <= alpha/float64(n-rank)) {
			return out
		}
		out[i] = true
	}
	out
}

// HolmRejectsNoMore: Holm rejects no p-value above alpha, and every one at
// most alpha over their number (Bonferroni's); n equal p-values are all
// rejected exactly when they are at most alpha / n.
law HolmRejectsNoMore() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let ps = gen.Named("ps", showFloats, func() []float64 needs gen.Draws {
			gen.ListOf(1, 12, func() float64 needs gen.Draws { float64(gen.IntIn(0, 99)) / 1000.0 })
		})
		let n = ps.Len()
		let mut same = []float64{}
		for _ in 0..n {
			same = same.Append(ps[0])
		}
		for i, rejected in Holm(ps, 0.05) {
			if rejected && ps[i] > 0.05 || !rejected && ps[i] <= 0.05/float64(n) {
				return false
			}
		}
		for rejected in Holm(same, 0.05) {
			if rejected != (ps[0] <= 0.05/float64(n)) {
				return false
			}
		}
		true
	})) == ""
	true
}
