// Package atomic provides counters and flags shared by tasks. Operations
// are sequentially consistent, as Go sync/atomic. Each copy of a handle
// names the same cell. Use sync.Ref for an arbitrary value or a compound
// update; an atomic Load followed by Store is not a compound operation.
// Effect Ref has the same shared-state intent. Ergo uses scalar operations
// and operation laws, not modify tuples, pipe or dual-call encodings.
//
// Int64 and Bool hold Go's sync/atomic values by address (go.New), so a
// copy of a handle shares the cell, and each operation is Go's method,
// which needs no row: sync/atomic's methods are memory-only.

import go sync/atomic
import tasks

// Int64 is a shared counter: every copy is the same cell.
type Int64 { cell go.Ref[atomic.Int64] }

// Bool is a shared flag, with the same ordering and identity as Int64.
type Bool { cell go.Ref[atomic.Bool] }

// NewInt64 is a fresh counter holding value.
func NewInt64(value int64) Int64 {
	let cell = go.New[atomic.Int64]()
	cell.Store(value)
	Int64{cell: cell}
}

// NewBool is a fresh flag holding value.
func NewBool(value bool) Bool {
	let cell = go.New[atomic.Bool]()
	cell.Store(value)
	Bool{cell: cell}
}

// Load is the counter's value.
func Load(c Int64) int64 { c.cell.Load() }

// Store sets the counter to value.
func Store(c Int64, value int64) { c.cell.Store(value) }

// Add adds delta to the counter and gives the sum.
func Add(c Int64, delta int64) int64 { c.cell.Add(delta) }

// Swap sets the counter to value and gives the value it held.
func Swap(c Int64, value int64) int64 { c.cell.Swap(value) }

// CompareAndSwap sets the counter to value if it holds old, and says
// whether it did.
func CompareAndSwap(c Int64, old int64, value int64) bool { c.cell.CompareAndSwap(old, value) }

// Load is the flag's value.
func Load(f Bool) bool { f.cell.Load() }

// Store sets the flag to value.
func Store(f Bool, value bool) { f.cell.Store(value) }

// Swap sets the flag to value and gives the value it held.
func Swap(f Bool, value bool) bool { f.cell.Swap(value) }

// CompareAndSwap sets the flag to value if it holds old, and says whether
// it did.
func CompareAndSwap(f Bool, old bool, value bool) bool { f.cell.CompareAndSwap(old, value) }

law InitialValues(value int64, flag bool) {
	NewInt64(value).Load() == value && NewBool(flag).Load() == flag
}

law StoresAndAdds(a int64, b int64) {
	let c = NewInt64(0)
	c.Store(a)
	let sum = c.Add(b)
	let seen = c.Load()
	let previous = c.Swap(a)
	let changed = c.CompareAndSwap(a, b)
	let unchanged = !c.CompareAndSwap(b+1, a)
	sum == a+b && seen == sum && previous == sum && changed && unchanged && c.Load() == b
}

law Exchanges(a bool, b bool) {
	let f = NewBool(false)
	f.Store(a)
	let previous = f.Swap(b)
	let seen = f.Load()
	let changed = f.CompareAndSwap(b, a)
	let unchanged = !f.CompareAndSwap(!a, b)
	previous == a && seen == b && changed && unchanged && f.Load() == a
}

law IncrementsCount(n int) {
	let k = 1 + (n%8+8)%8
	let c = NewInt64(0)
	let s = tasks.NewSet(tasks.FailFast)
	for _ in 0..k {
		try tasks.Go(s, func() { _ = c.Add(1) })
	}
	s.Wait()
	c.Load() == int64(k)
}
