import strings

// The laws of ansi (UC2): a painted text is its text once stripped; with
// colour off nothing is painted; a style's codes are xterm's, recorded;
// colour is off as NO_COLOR, TERM and a pipe ask.

// StripUndoesPaint: with colour on, Strip of a text painted in any drawn
// style is the text (Strip of the text, so the text holds no escape of
// its own); and Strip twice is Strip once.
law StripUndoesPaint(seed int, text string) {
	let t = Strip(text)
	let s = drawStyle(seed)
	let painted = with context { Colors: Always } { Paint(s, t) }
	Strip(painted) == t && Strip(t) == t
}

// NeverPaints: with colour off, Paint is the text, whatever the style,
// and so is WritePaint.
law NeverPaints(seed int, text string) {
	let s = drawStyle(seed)
	with context { Colors: Never } {
		let mut b = strings.NewBuilder()
		WritePaint(&b, s, text)
		Paint(s, text) == text && b.String() == text
	}
}

// PaintIsSGRAndReset: with colour on, Paint is SGR's codes, the text and
// Reset, or the text alone for Plain; WritePaint writes the same.
law PaintIsSGRAndReset(seed int, text string) {
	let s = drawStyle(seed)
	with context { Colors: Always } {
		let mut b = strings.NewBuilder()
		WritePaint(&b, s, text)
		let want = if s == Plain { text } else { SGR(s) + text + Reset }
		Paint(s, text) == want && b.String() == want
	}
}

// SGRIsTheTable: the codes of recorded styles are xterm's (ECMA-48 SGR:
// 1 bold, 2 dim, 3 italic, 4 underline, 7 reverse, 9 strike; 30-37 and
// 90-97 the basic and bright colours, 38;5;n indexed, 38;2;r;g;b RGB,
// and 40 more for a background), with a number out of range held to it.
law SGRIsTheTable() {
	let p = Plain
		SGR(p) == "" &&
		SGR(Style{..p, Fg: Red}) == "\x1b[31m" &&
		SGR(Style{..p, Fg: Basic(9)}) == "\x1b[91m" &&
		SGR(Style{..p, Bg: Blue}) == "\x1b[44m" &&
		SGR(Style{..p, Bg: Basic(15)}) == "\x1b[107m" &&
		SGR(Style{..p, Fg: Indexed(208)}) == "\x1b[38;5;208m" &&
		SGR(Style{..p, Bg: Indexed(300)}) == "\x1b[48;5;255m" &&
		SGR(Style{..p, Fg: RGB(255, 128, -4)}) == "\x1b[38;2;255;128;0m" &&
		SGR(Style{..p, Bold: true}) == "\x1b[1m" &&
		SGR(Style{..p, Bold: true, Underline: true, Fg: Green, Bg: Black}) == "\x1b[1;4;32;40m" &&
		SGR(Style{..p, Dim: true, Italic: true, Reverse: true, Strike: true}) == "\x1b[2;3;7;9m"
}

// StripIsTheTable: Strip takes out recorded sequences whole: SGR, cursor
// moves, private modes, OSC titles and links ended by BEL or ESC \, and
// a two-byte escape; and a sequence the text ends inside.
law StripIsTheTable() {
		Strip("a\x1b[1;31mb\x1b[0mc") == "abc" &&
		Strip("\x1b[2J\x1b[Hx\x1b[10;4H") == "x" &&
		Strip("\x1b[?25lhi\x1b[?1049h") == "hi" &&
		Strip("\x1b]0;title\x07t") == "t" &&
		Strip("\x1b]8;;https://e.org\x1b\\link\x1b]8;;\x1b\\") == "link" &&
		Strip("\x1b7a\x1b8") == "a" &&
		Strip("a\x1b[2@b") == "ab" &&
		Strip("ok\x1b[38;5") == "ok" &&
		Strip("界\x1b[4mé") == "界é" &&
		Strip("plain") == "plain"
}

// DetectIsTheEnvironment: colour is on just when NO_COLOR is unset or
// empty, TERM is not dumb, and standard output is a terminal.
law DetectIsTheEnvironment(noColor int, term int, terminal bool) {
	let nc = []Option[string]{None, Some[string]{Value: ""}, Some[string]{Value: "1"}}[(noColor%3+3)%3]
	let tm = []Option[string]{None, Some[string]{Value: "xterm-256color"}, Some[string]{Value: "dumb"}}[(term%3+3)%3]
	let off = nc == (Some[string]{Value: "1"}) || tm == (Some[string]{Value: "dumb"}) || !terminal
	Decide(nc, tm, terminal).On() == !off
}

// drawStyle is a style drawn from seed: each attribute, and colours of
// every kind, out-of-range numbers too. (a law's helper)
func drawStyle(seed int) Style {
	let mut x = (seed%2147483648 + 2147483648) % 2147483648
	let mut bits = []int{}
	for _ in 0..16 {
		x = (x*1103515245 + 12345) % 2147483648
		bits = bits.Append(x / 65536)
	}
	Style{
		Fg:        drawColor(bits[0], bits[1]),
		Bg:        drawColor(bits[2], bits[3]),
		Bold:      bits[4]%2 == 0,
		Dim:       bits[5]%2 == 0,
		Italic:    bits[6]%2 == 0,
		Underline: bits[7]%2 == 0,
		Reverse:   bits[8]%2 == 0,
		Strike:    bits[9]%2 == 0,
	}
}

// drawColor is a colour of kind k%4 and number n, from -20 to 299. (a
// law's helper)
func drawColor(k int, n int) Color {
	let v = n%320 - 20
	match k % 4 {
	case 0:
		DefaultColor
	case 1:
		Basic(v % 20)
	case 2:
		Indexed(v)
	case _:
		RGB(v, 255-v, v/2)
	}
}
