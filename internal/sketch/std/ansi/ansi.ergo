// Package ansi is the escape codes of a terminal (docs/spec/stdlib.md,
// ansi): styles and colours (the 16 basic colours, the 256 indexed ones
// and RGB), the cursor's moves and the screen's clears, and Strip, which
// takes every escape sequence out of a text. A style is painted only
// where colour is on: Paint needs Colors; its providers are Always,
// Never and Detect's (NO_COLOR, TERM=dumb, and whether standard output is
// a terminal), so a program that pipes its output, or a person who set
// NO_COLOR, gets plain text with no change to the program.
//
// The codes are ECMA-48's (SGR, CUU and the rest) as xterm reads them.
// Prior art: Go has no standard package (fatih/color and lipgloss read
// NO_COLOR; x/term only sizes); Effect's cli has a colour flag on its
// output; Bun has Bun.color and Bun.stripANSI; Rust's anstyle and
// anstream split the style from the stream that decides colour, as
// Paint and Colors do here. https://no-color.org: a NO_COLOR present
// and not empty turns colour off.

import io
import os
import strings

// Color is a text's or a background's colour: the terminal's own
// (DefaultColor), one of the 16 basic colours (Basic 0 to 7, and 8 to 15
// the bright ones), one of the 256 indexed colours (Indexed), or an RGB
// colour (each part 0 to 255). A number outside its range is held to it
// where it is written. Its variants carry no pointer, so a Style is flat.
type Color = DefaultColor{} | Basic{N int} | Indexed{N int} | RGB{R int, G int, B int}

// The basic colours by name.
let Black = Basic{N: 0}
let Red = Basic{N: 1}
let Green = Basic{N: 2}
let Yellow = Basic{N: 3}
let Blue = Basic{N: 4}
let Magenta = Basic{N: 5}
let Cyan = Basic{N: 6}
let White = Basic{N: 7}

// Style is how a text is painted: its colour, its background, and its
// attributes.
type Style { Fg Color, Bg Color, Bold bool, Dim bool, Italic bool, Underline bool, Reverse bool, Strike bool }

// Plain is the style with no colour and no attribute: Paint writes the
// text alone.
let Plain = Style{Fg: DefaultColor, Bg: DefaultColor, Bold: false, Dim: false, Italic: false, Underline: false, Reverse: false, Strike: false}

// Colors decides whether a style is painted.
type Colors {
	// On is whether colour is on.
	On() bool,

	// OnIsStable: two asks agree.
	law OnIsStable() { On() == On() },
}

// Always is the Colors provider with colour on.
type Always {} implements Colors

// On is true.
func On(_ Always) bool { true }

// Never is the Colors provider with colour off.
type Never {} implements Colors

// On is false.
func On(_ Never) bool { false }

// Detected is the Colors provider Detect decides once.
type Detected { on bool } implements Colors

// On is what Detect decided.
func On(d Detected) bool { d.on }

// Detect is colour as the environment asks: off when NO_COLOR is set and
// not empty, when TERM is dumb, or when standard output is not a
// terminal; on otherwise.
func Detect() Detected needs os.Process | io.Stdout {
	Decide(os.Process.Getenv("NO_COLOR"), os.Process.Getenv("TERM"), io.Stdout.IsTerminal())
}

// Decide is colour for NO_COLOR's and TERM's values and whether
// standard output is a terminal, as Detect decides; for a program that
// reads them itself.
func Decide(noColor Option[string], term Option[string], terminal bool) Detected {
	let off = match noColor {
	case Some[string] as v:
		v.Value != ""
	case None:
		false
	}
	let dumb = match term {
	case Some[string] as v:
		v.Value == "dumb"
	case None:
		false
	}
	Detected{on: !off && !dumb && terminal}
}

let onTerminal = context { Colors: Decide(None, None, true) }
let onDumbTerminal = context { Colors: Decide(None, Some[string]{Value: "dumb"}, true) }

// Paint is text in style s when colour is on: s's codes (SGR), text, and
// the reset. With colour off, or s Plain, it is text.
func Paint(s Style, text string) string needs Colors {
	if s == Plain || !Colors.On() {
		return text
	}
	let mut b = strings.NewBuilder()
	writeSGR(&b, s)
	b.WriteString(text)
	b.WriteString(Reset)
	b.String()
}

// WritePaint writes Paint(s, text) to b.
func WritePaint(b mut strings.Builder, s Style, text string) needs Colors {
	if s == Plain || !Colors.On() {
		b.WriteString(text)
		return
	}
	writeSGR(b, s)
	b.WriteString(text)
	b.WriteString(Reset)
}

// SGR is s's codes: the one sequence that sets s's colours and
// attributes; "" for Plain. It is no capability's: a caller that writes
// it decides colour itself.
func SGR(s Style) string {
	if s == Plain {
		return ""
	}
	let mut b = strings.NewBuilder()
	writeSGR(&b, s)
	b.String()
}

// Reset is the sequence that ends every style.
let Reset = "\x1b[0m"

// writeSGR writes s's codes to b: ESC [, the codes split by ';', m.
func writeSGR(b mut strings.Builder, s Style) {
	b.WriteString("\x1b[")
	let mut first = true
	let attrs = [](bool, int){(s.Bold, 1), (s.Dim, 2), (s.Italic, 3), (s.Underline, 4), (s.Reverse, 7), (s.Strike, 9)}
	for a in attrs {
		let (on, code) = a
		if on {
			first = sep(b, first)
			writeInt(b, code)
		}
	}
	first = writeColor(b, s.Fg, 30, first)
	let _ = writeColor(b, s.Bg, 40, first)
	b.WriteByte('m')
}

// sep writes ';' unless first; it is false.
func sep(b mut strings.Builder, first bool) bool {
	if !first {
		b.WriteByte(';')
	}
	false
}

// writeColor writes the codes of c as a foreground (base 30) or a
// background (base 40), and is whether nothing is written yet.
func writeColor(b mut strings.Builder, c Color, base int, first bool) bool {
	match c {
	case DefaultColor:
		first
	case Basic as x:
		let n = clamp(x.N, 15)
		let _ = sep(b, first)
		writeInt(b, if n < 8 { base + n } else { base + 60 + n - 8 })
		false
	case Indexed as x:
		let _ = sep(b, first)
		writeInt(b, base+8)
		b.WriteString(";5;")
		writeInt(b, clamp(x.N, 255))
		false
	case RGB as x:
		let _ = sep(b, first)
		writeInt(b, base+8)
		b.WriteString(";2;")
		writeInt(b, clamp(x.R, 255))
		b.WriteByte(';')
		writeInt(b, clamp(x.G, 255))
		b.WriteByte(';')
		writeInt(b, clamp(x.B, 255))
		false
	}
}

// clamp is n held to [0, most].
func clamp(n int, most int) int { if n < 0 { 0 } else if n > most { most } else { n } }

// writeInt writes n, which is 0 or more, in decimal.
func writeInt(b mut strings.Builder, n int) {
	if n >= 10 {
		writeInt(b, n/10)
	}
	b.WriteByte(byte('0' + n%10))
}

// Up, Down, Forward and Back move the cursor n cells (n under 1 is 1).
func Up(n int) string { move(n, 'A') }

func Down(n int) string { move(n, 'B') }

func Forward(n int) string { move(n, 'C') }

func Back(n int) string { move(n, 'D') }

func move(n int, final byte) string {
	let mut b = strings.NewBuilder()
	b.WriteString("\x1b[")
	writeInt(&b, if n < 1 { 1 } else { n })
	b.WriteByte(final)
	b.String()
}

// MoveTo moves the cursor to row and col, counted from 1 at the top left
// (under 1 is 1).
func MoveTo(row int, col int) string {
	let mut b = strings.NewBuilder()
	b.WriteString("\x1b[")
	writeInt(&b, if row < 1 { 1 } else { row })
	b.WriteByte(';')
	writeInt(&b, if col < 1 { 1 } else { col })
	b.WriteByte('H')
	b.String()
}

// The screen's and the cursor's other sequences.
let ClearScreen = "\x1b[2J"
let ClearLine = "\x1b[2K"
let ClearToEnd = "\x1b[0J"
let Home = "\x1b[H"
let HideCursor = "\x1b[?25l"
let ShowCursor = "\x1b[?25h"
let AltScreen = "\x1b[?1049h"
let MainScreen = "\x1b[?1049l"

// Strip is s with every escape sequence taken out: CSI (ESC [, parameter
// and intermediate bytes, a final byte in 0x40-0x7e), OSC (ESC ], up to a
// BEL or ESC \), and ESC with one byte after it. A sequence that s ends
// inside is taken out to the end.
func Strip(s string) string {
	if strings.IndexByte(s, 0x1b) < 0 {
		return s
	}
	let mut b = strings.NewBuilder()
	let mut i = 0
	for i < len(s) {
		if s[i] != 0x1b {
			let j = strings.IndexByte(s[i:], 0x1b)
			let end = if j < 0 { len(s) } else { i + j }
			b.WriteString(s[i:end])
			i = end
			continue
		}
		i = i + sequenceLen(s[i:])
	}
	b.String()
}

// sequenceLen is the length of the escape sequence at the front of s,
// which starts with ESC.
func sequenceLen(s string) int {
	if len(s) < 2 {
		return len(s)
	}
	if s[1] == '[' {
		for i in 2..len(s) {
			if s[i] >= 0x40 && s[i] <= 0x7e {
				return i + 1
			}
		}
		return len(s)
	}
	if s[1] == ']' {
		for i in 2..len(s) {
			if s[i] == 0x07 {
				return i + 1
			}
			if s[i] == 0x1b && i+1 < len(s) && s[i+1] == '\\' {
				return i + 2
			}
		}
		return len(s)
	}
	2
}

// StripUndoesPaint: with colour on, Strip of a text painted in any drawn
// style is the text (Strip of the text, so the text holds no escape of
// its own); and Strip twice is Strip once.
law StripUndoesPaint(seed int, text string) {
	let t = Strip(text)
	let s = drawStyle(seed)
	let painted = with context { Colors: Always } { Paint(s, t) }
	Strip(painted) == t && Strip(t) == t
}

// NeverPaints: with colour off, Paint is the text, whatever the style,
// and so is WritePaint.
law NeverPaints(seed int, text string) {
	let s = drawStyle(seed)
	with context { Colors: Never } {
		let mut b = strings.NewBuilder()
		WritePaint(&b, s, text)
		Paint(s, text) == text && b.String() == text
	}
}

// PaintIsSGRAndReset: with colour on, Paint is SGR's codes, the text and
// Reset, or the text alone for Plain; WritePaint writes the same.
law PaintIsSGRAndReset(seed int, text string) {
	let s = drawStyle(seed)
	with context { Colors: Always } {
		let mut b = strings.NewBuilder()
		WritePaint(&b, s, text)
		let want = if s == Plain { text } else { SGR(s) + text + Reset }
		Paint(s, text) == want && b.String() == want
	}
}

// SGRIsTheTable: the codes of recorded styles are xterm's (ECMA-48 SGR:
// 1 bold, 2 dim, 3 italic, 4 underline, 7 reverse, 9 strike; 30-37 and
// 90-97 the basic and bright colours, 38;5;n indexed, 38;2;r;g;b RGB,
// and 40 more for a background), with a number out of range held to it.
law SGRIsTheTable() {
	let p = Plain
		SGR(p) == "" &&
		SGR(Style{..p, Fg: Red}) == "\x1b[31m" &&
		SGR(Style{..p, Fg: Basic{N: 9}}) == "\x1b[91m" &&
		SGR(Style{..p, Bg: Blue}) == "\x1b[44m" &&
		SGR(Style{..p, Bg: Basic{N: 15}}) == "\x1b[107m" &&
		SGR(Style{..p, Fg: Indexed{N: 208}}) == "\x1b[38;5;208m" &&
		SGR(Style{..p, Bg: Indexed{N: 300}}) == "\x1b[48;5;255m" &&
		SGR(Style{..p, Fg: RGB{R: 255, G: 128, B: -4}}) == "\x1b[38;2;255;128;0m" &&
		SGR(Style{..p, Bold: true}) == "\x1b[1m" &&
		SGR(Style{..p, Bold: true, Underline: true, Fg: Green, Bg: Black}) == "\x1b[1;4;32;40m" &&
		SGR(Style{..p, Dim: true, Italic: true, Reverse: true, Strike: true}) == "\x1b[2;3;7;9m"
}

// StripIsTheTable: Strip takes out recorded sequences whole: SGR, cursor
// moves, private modes, OSC titles and links ended by BEL or ESC \, and
// a two-byte escape; and a sequence the text ends inside.
law StripIsTheTable() {
		Strip("a\x1b[1;31mb\x1b[0mc") == "abc" &&
		Strip("\x1b[2J\x1b[Hx\x1b[10;4H") == "x" &&
		Strip("\x1b[?25lhi\x1b[?1049h") == "hi" &&
		Strip("\x1b]0;title\x07t") == "t" &&
		Strip("\x1b]8;;https://e.org\x1b\\link\x1b]8;;\x1b\\") == "link" &&
		Strip("\x1b7a\x1b8") == "a" &&
		Strip("a\x1b[2@b") == "ab" &&
		Strip("ok\x1b[38;5") == "ok" &&
		Strip("界\x1b[4mé") == "界é" &&
		Strip("plain") == "plain"
}

// DetectIsTheEnvironment: colour is on just when NO_COLOR is unset or
// empty, TERM is not dumb, and standard output is a terminal.
law DetectIsTheEnvironment(noColor int, term int, terminal bool) {
	let nc = []Option[string]{None, Some[string]{Value: ""}, Some[string]{Value: "1"}}[(noColor%3+3)%3]
	let tm = []Option[string]{None, Some[string]{Value: "xterm-256color"}, Some[string]{Value: "dumb"}}[(term%3+3)%3]
	let off = nc == (Some[string]{Value: "1"}) || tm == (Some[string]{Value: "dumb"}) || !terminal
	Decide(nc, tm, terminal).On() == !off
}

// drawStyle is a style drawn from seed: each attribute, and colours of
// every kind, out-of-range numbers too. (a law's helper)
func drawStyle(seed int) Style {
	let mut x = (seed%2147483648 + 2147483648) % 2147483648
	let mut bits = []int{}
	for _ in 0..16 {
		x = (x*1103515245 + 12345) % 2147483648
		bits = bits.Append(x / 65536)
	}
	Style{
		Fg:        drawColor(bits[0], bits[1]),
		Bg:        drawColor(bits[2], bits[3]),
		Bold:      bits[4]%2 == 0,
		Dim:       bits[5]%2 == 0,
		Italic:    bits[6]%2 == 0,
		Underline: bits[7]%2 == 0,
		Reverse:   bits[8]%2 == 0,
		Strike:    bits[9]%2 == 0,
	}
}

// drawColor is a colour of kind k%4 and number n, from -20 to 299. (a
// law's helper)
func drawColor(k int, n int) Color {
	let v = n%320 - 20
	match k % 4 {
	case 0:
		DefaultColor
	case 1:
		Basic{N: v % 20}
	case 2:
		Indexed{N: v}
	case _:
		RGB{R: v, G: 255 - v, B: v / 2}
	}
}
