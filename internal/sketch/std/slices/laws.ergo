// The algebra of package slices (docs/spec/stdlib.md, Std laws). Each law
// is stated at []int: a top-level law takes no type parameter. The ledger
// names the Go test that runs each one until #162.

// tagged is an element and its index in the slice it came from: the
// stability law sorts by Key and reads At.
type tagged { Key int, At int }

// isSorted reports whether xs is in ascending order.
func isSorted(xs []int) bool {
	for i in 1..len(xs) {
		if xs[i-1] > xs[i] {
			return false
		}
	}
	true
}

// count is how often x is in xs.
func count(xs []int, x int) int {
	len(Filter(xs, func(y int) bool { y == x }))
}

// byKey orders two tagged values by Key alone.
func byKey(a tagged, b tagged) int {
	if a.Key < b.Key {
		-1
	} else if a.Key > b.Key {
		1
	} else {
		0
	}
}

// SortOrders: Sort's result is in ascending order.
law SortOrders(xs []int) { isSorted(Sort(xs)) }

// SortPermutes: Sort's result holds the elements of xs, each as often.
law SortPermutes(xs []int) {
	let sorted = Sort(xs)
	let mut same = len(sorted) == len(xs)
	for x in xs {
		same = same && count(sorted, x) == count(xs, x)
	}
	same
}

// SortIsIdempotent: sorting a sorted slice changes nothing.
law SortIsIdempotent(xs []int) { Equal(Sort(Sort(xs)), Sort(xs)) }

// SortLeavesItsArgument: Sort returns a new slice; xs is unchanged.
law SortLeavesItsArgument(xs []int) {
	let before = Transform(xs, func(x int) int { x })
	let sorted = Sort(xs)
	len(sorted) == len(xs) && Equal(xs, before)
}

// SortStableKeepsTies: of two elements whose keys are equal,
// SortStableFunc keeps first the one that is first in xs. The key is
// x % 3, so ties are common.
law SortStableKeepsTies(xs []int) {
	let mut tags = []tagged{}
	for i, x in xs {
		tags = tags.Append(tagged{Key: x % 3, At: i})
	}
	let sorted = SortStableFunc(tags, byKey)
	let mut ok = len(sorted) == len(xs)
	for i in 1..len(sorted) {
		let a = sorted[i-1]
		let b = sorted[i]
		ok = ok && (a.Key < b.Key || a.Key == b.Key && a.At < b.At)
	}
	ok
}

// ReverseTwiceIsSame: Reverse(Reverse(xs)) is xs.
law ReverseTwiceIsSame(xs []int) { Equal(Reverse(Reverse(xs)), xs) }

// ContainsIffIndex: x is in xs exactly when Index finds it, and the
// element at that index is x.
law ContainsIffIndex(xs []int, x int) {
	let i = Index(xs, x)
	Contains(xs, x) == (i >= 0) && (i < 0 || xs[i] == x)
}

// MaxIsLastSorted: Max is the last element of Sort(xs), or None for an
// empty xs.
law MaxIsLastSorted(xs []int) {
	let s = Sort(xs)
	if len(s) == 0 {
		return Max(xs) == None && Min(xs) == None
	}
	Max(xs) == Some[int]{Value: s[len(s)-1]} && Min(xs) == Some[int]{Value: s[0]}
}

// AscendOrders: the items of Ascend(xs) are in ascending order.
law AscendOrders(xs []int) { isSorted(Items(Ascend(xs))) }

// AscendPermutes: the items of Ascend(xs) are the elements of xs, each as
// often.
law AscendPermutes(xs []int) {
	let items = Items(Ascend(xs))
	let mut same = len(items) == len(xs)
	for x in xs {
		same = same && count(items, x) == count(xs, x)
	}
	same
}

// AscendLeavesItsArgument: Ascend copies; xs is unchanged.
law AscendLeavesItsArgument(xs []int) {
	let before = Transform(xs, func(x int) int { x })
	let a = Ascend(xs)
	len(Items(a)) == len(xs) && Equal(xs, before)
}

// ItemsIsACopy: a change to the slice Items returns does not change the
// Ascending, so it stays sorted: its items are still Sort(xs).
law ItemsIsACopy(xs []int) {
	let a = Ascend(xs)
	let mut changed = Items(a)
	for i in 0..len(changed) {
		changed[i] = len(changed) - i
	}
	Equal(Items(a), Sort(xs))
}

// BinarySearchFindsTheFirst: in an Ascending, BinarySearch finds the first
// x, or None when there is no x.
law BinarySearchFindsTheFirst(xs []int, x int) {
	let a = Ascend(xs)
	let s = Items(a)
	match BinarySearch(a, x) {
	case Some[int] as found:
		s[found.Value] == x && (found.Value == 0 || s[found.Value-1] < x)
	case None:
		!Contains(s, x)
	}
}

// CollectInvertsValues: Collect(Values(xs)) is xs.
law CollectInvertsValues(xs []int) { Equal(Collect(Values(xs)), xs) }

// ValuesStops: Values is a Seq that stops (stdlib.md, Std laws 5): for
// each k from 1 to len(xs)+1, a yield that returns false at its k-th call
// is called min(k, len(xs)) times.
law ValuesStops(xs []int) {
	let s = Values(xs)
	let n = len(xs)
	for k in 1..n+2 {
		let mut calls = 0
		s(func(v int) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// TransformIdentity: Transform with the identity is xs.
law TransformIdentity(xs []int) { Equal(Transform(xs, func(x int) int { x }), xs) }

// TransformComposes: Transform(Transform(xs, f), g) is Transform(xs, g
// after f).
law TransformComposes(xs []int) {
	let f = func(x int) int { x * 3 }
	let g = func(x int) int { x - 7 }
	Equal(Transform(Transform(xs, f), g), Transform(xs, func(x int) int { g(f(x)) }))
}

// FilterIsIdempotent: filtering twice by one predicate is filtering once.
law FilterIsIdempotent(xs []int) {
	let even = func(x int) bool { x%2 == 0 }
	Equal(Filter(Filter(xs, even), even), Filter(xs, even))
}

// FilterKeepsTheAccepted: Filter keeps each element that keep accepts, in
// order, and drops each one it refuses.
law FilterKeepsTheAccepted(xs []int) {
	let even = func(x int) bool { x%2 == 0 }
	let kept = Filter(xs, even)
	let mut i = 0
	for x in xs {
		if even(x) {
			if i >= len(kept) || kept[i] != x {
				return false
			}
			i = i + 1
		}
	}
	i == len(kept)
}

// FoldSumMatchesLoop: Fold with + is the sum a loop computes.
law FoldSumMatchesLoop(xs []int) {
	let mut sum = 0
	for x in xs {
		sum = sum + x
	}
	Fold(xs, 0, func(acc int, x int) int { acc + x }) == sum
}

// CloneCopies: Clone is equal to xs, and a write to a clone leaves xs as
// it was.
law CloneCopies(xs []int) {
	let c = Clone(xs)
	let mut d = Clone(xs)
	for i in 0..len(d) {
		d[i] = d[i] + 1
	}
	Equal(c, xs) && (len(xs) == 0 || !Equal(d, xs))
}

// ConcatJoins: Concat(a, b) is the elements of a, then those of b.
law ConcatJoins(a []int, b []int) {
	let c = Concat(a, b)
	len(c) == len(a)+len(b) && Equal(Slice(c, 0, len(a)), a) && Equal(Slice(c, len(a), len(c)), b)
}

// ConcatIsIsolated: an Append to a slice with room after its elements does
// not change a Concat made from it.
law ConcatIsIsolated(a []int, b []int, x int) {
	let mut roomy = WithCapacity[int](len(a) + len(b) + 1)
	for v in a {
		roomy = roomy.Append(v)
	}
	let c = Concat(roomy, b)
	let before = Clone(c)
	let grown = roomy.Append(x)
	Equal(c, before) && len(grown) == len(a)+1 && Equal(Slice(c, len(a), len(c)), b)
}

// RepeatRepeats: Repeat(xs, n) is xs n times over.
law RepeatRepeats(xs []int, n int) {
	let k = (n%8 + 8) % 8
	let r = Repeat(xs, k)
	let mut ok = len(r) == len(xs)*k
	for i, v in r {
		ok = ok && v == xs[i%len(xs)]
	}
	ok
}

// SliceHasNoRoom: an Append to Slice(xs, 0, j) never writes xs.
law SliceHasNoRoom(xs []int, i int, x int) {
	if len(xs) == 0 {
		return true
	}
	let j = (i%len(xs) + len(xs)) % len(xs)
	let before = Clone(xs)
	let grown = Slice(xs, 0, j).Append(x)
	Equal(xs, before) && Equal(Slice(grown, 0, j), Slice(xs, 0, j)) && grown[j] == x
}

// LenAndAtReadItems: Len and At read an Ascending as Items does.
law LenAndAtReadItems(xs []int) {
	let a = Ascend(xs)
	let items = Items(a)
	let mut ok = Len(a) == len(items)
	for i, v in items {
		ok = ok && At(a, i) == v
	}
	ok
}
