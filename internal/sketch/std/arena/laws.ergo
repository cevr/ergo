// The laws of an arena, at int values (a top-level law is not generic).
// ModelAgrees is the seeded property: a run of operations agrees, step by
// step, with a Map from Ref to value.

// filled is a store after a Put of each of xs, and the Refs Put returned.
func filled(xs []int) (Of[int], []Ref[int]) {
	let mut a = New[int]()
	let mut refs = []Ref[int]{}
	for x in xs {
		refs = refs.Append(a.Put(x))
	}
	(a, refs)
}

// stale is whether r is stale in a: Has is false, Get, Set, Update and
// Free fail with Stale, Update does not call its function, and Len stays.
func stale(a Of[int], r Ref[int]) bool {
	let mut b = a
	let size = Len(b)
	let mut failed = 0
	let mut called = false
	let _ = b.Get(r) catch {
	case Stale:
		failed = failed + 1
		0
	}
	b.Set(r, 0) catch {
	case Stale:
		failed = failed + 1
	}
	b.Update(r, func(v *int) { called = true }) catch {
	case Stale:
		failed = failed + 1
	}
	let _ = b.Free(r) catch {
	case Stale:
		failed = failed + 1
		0
	}
	!Has(b, r) && failed == 4 && !called && Len(b) == size
}

// GetAfterPut: Get gives back what Put stored, for every Ref of a run of
// Puts, and Len counts them.
law GetAfterPut(xs []int) {
	let (start, refs) = filled(xs)
	let mut a = start
	let mut ok = Len(a) == len(xs)
	for i, r in refs {
		let v = a.Get(r) catch {
		case Stale:
			return false
		}
		ok = ok && v == xs[i] && Has(a, r)
	}
	ok
}

// FreeThenStale: Free returns the value and makes its Ref stale; the
// other Refs keep their values.
law FreeThenStale(xs []int, k int) {
	if len(xs) == 0 {
		return true
	}
	let (start, refs) = filled(xs)
	let mut a = start
	let i = (k%len(xs) + len(xs)) % len(xs)
	let v = a.Free(refs[i]) catch {
	case Stale:
		return false
	}
	let mut ok = v == xs[i] && stale(a, refs[i]) && Len(a) == len(xs)-1
	for j, r in refs {
		if j != i {
			let w = a.Get(r) catch {
			case Stale:
				return false
			}
			ok = ok && w == xs[j]
		}
	}
	ok
}

// ReuseNeverAliases: a Put after a Free reuses the freed slot (Cap does
// not grow), and its Ref is new: the freed Ref stays stale and names no
// value of the new Put.
law ReuseNeverAliases(xs []int, k int, v int) {
	if len(xs) == 0 {
		return true
	}
	let (start, refs) = filled(xs)
	let mut a = start
	let i = (k%len(xs) + len(xs)) % len(xs)
	let slots = Cap(a)
	let _ = a.Free(refs[i]) catch {
	case Stale:
		return false
	}
	let fresh = a.Put(v)
	let got = a.Get(fresh) catch {
	case Stale:
		return false
	}
	let mut ok = Cap(a) == slots && got == v && stale(a, refs[i])
	for r in refs {
		ok = ok && r != fresh
	}
	ok
}

// NullIsStale: Null names no value, in any store.
law NullIsStale(xs []int) {
	let (a, refs) = filled(xs)
	let mut ok = stale(a, Null[int]()) && stale(New[int](), Null[int]())
	for r in refs {
		ok = ok && r != Null[int]()
	}
	ok
}

// ModelAgrees: a run of Put, Get, Set, Update and Free drawn from seed
// agrees with a Map from Ref to value after every step: each operation
// fails with Stale exactly when the model has no value at its Ref. The
// operations pick any Ref Put ever returned, so the run also uses freed
// and reused slots.
law ModelAgrees(seed int, count int) {
	let n = (count%64 + 64) % 64
	let mut x = (seed%2147483648 + 2147483648) % 2147483648
	let mut a = New[int]()
	let mut model = Map[Ref[int], int]{}
	let mut refs = []Ref[int]{}
	for i in 0..n {
		x = (x*1103515245 + 12345) % 2147483648
		let op = (x / 8) % 5
		if op == 0 || len(refs) == 0 {
			let r = a.Put(i)
			if model.Get(r) != None {
				return false
			}
			model[r] = i
			refs = refs.Append(r)
		} else {
			let r = refs[(x/65536)%len(refs)]
			let want = model.Get(r)
			let mut failed = false
			let mut got = i
			match op {
			case 1:
				got = a.Get(r) catch {
				case Stale:
					failed = true
					i
				}
			case 2:
				a.Set(r, -i) catch {
				case Stale:
					failed = true
				}
				got = -i
			case 3:
				let mut seen = i
				a.Update(r, func(v *int) {
					seen = *v
					*v = *v + i
				}) catch {
				case Stale:
					failed = true
				}
				got = seen
			case _:
				got = a.Free(r) catch {
				case Stale:
					failed = true
					i
				}
			}
			match want {
			case Some[int] as w:
				if failed || (op != 2 && got != w.Value) {
					return false
				}
				match op {
				case 2:
					model[r] = -i
				case 3:
					model[r] = w.Value + i
				case 4:
					model = model.Delete(r)
				case _:
				}
			case None:
				if !failed || Has(a, r) {
					return false
				}
			}
		}
		if Len(a) != len(model) {
			return false
		}
	}
	for r, v in model {
		let got = a.Get(r) catch {
		case Stale:
			return false
		}
		if got != v {
			return false
		}
	}
	true
}
