// Package arena is a growable store of values of one type, addressed by
// typed handles (docs/spec/stdlib.md, Arenas). Graphs, linked lists and
// entity tables keep Refs where Go keeps pointers: a Ref is two integers,
// so a store of many values holds no pointer of its own and the values sit
// in one Go slice.
//
// A Ref carries the generation of its slot. Free and Put each advance the
// generation, so a Ref kept after Free is stale: Get, Set and Free fail
// with Stale on it, also after Put reuses the slot. Only this package builds a Ref, so
// every Ref is one that Put returned, or Null. A Ref is meaningful only
// for the arena that returned it.
//
// The shape is Rust's slotmap and generational-arena; Effect has no
// arena module. The lowering is a slice of slots and a free list linked
// through the free slots, with no interface value.

import option

// Ref names one value of an Of[T]. Refs compare with ==: two Refs are
// equal when they name the same value of the same slot.
type Ref[T] { index int, gen int }

// Stale is the failure of an operation on a Ref whose value was freed, or
// on Null.
type Stale {}

// slot is one cell of the store. gen is odd while the slot holds a value
// and even while it is free (slotmap's version parity): Put makes it odd,
// Free makes it even, each by one step. Every Ref carries an odd
// generation (Null's is 0), so a Ref equals the generation of no free
// slot, of this store or of another: one compare tells a live slot, and
// a Ref from another store never reads cleared free storage. next links
// the free slots; none ends the list.
type slot[T] { value stored[T], gen int, next int }

// stored is the private host storage cell. takeValue clears its physical
// storage after removing the value. No zero T is made available to callers:
// only a live Ref permits a read, and Free invalidates it before returning.
extern go ergo.local/prototype/runtime/v1.ArenaValue type stored[T] { Value T }

extern go ergo.local/prototype/runtime/v1.ArenaTake func takeValue[T](s mut stored[T]) T

// grow is Go's append (an extern of a Go builtin): Put's call is the builtin
// itself, with no Go function between.
extern go append func grow[T](xs []T, x T) []T

let none = -1

// Of is the store. Its fields are unexported, so only New and the
// operations make one. Change it through a *Of borrow.
type Of[T] { slots []slot[T], free int, live int }

// New is an empty store.
func New[T]() Of[T] { Of[T]{slots: []slot[T]{}, free: none, live: 0} }

// ModelAgrees: a run of Put, Get, Set, Update and Free drawn from seed
// agrees with a Map from Ref to value after every step: each operation
// fails with Stale exactly when the model has no value at its Ref. The
// operations pick any Ref Put ever returned, so the run also uses freed
// and reused slots.
law ModelAgrees(seed int, count int) {
	let n = (count%64 + 64) % 64
	let mut x = (seed%2147483648 + 2147483648) % 2147483648
	let mut a = New[int]()
	let mut model = Map[Ref[int], int]{}
	let mut refs = []Ref[int]{}
	for i in 0..n {
		x = (x*1103515245 + 12345) % 2147483648
		let op = (x / 8) % 5
		if op == 0 || refs.Len() == 0 {
			let r = a.Put(i)
			if model.Get(r) != option.None {
				return false
			}
			model[r] = i
			refs = refs.Append(r)
		} else {
			let r = refs[(x/65536)%refs.Len()]
			let want = model.Get(r)
			let mut failed = false
			let mut got = i
			match op {
			case 1:
				got = a.Get(r) catch {
				case Stale:
					failed = true
					i
				}
			case 2:
				a.Set(r, -i) catch {
				case Stale:
					failed = true
				}
				got = -i
			case 3:
				let mut seen = i
				a.Update(r, func(v mut int) {
					seen = *v
					*v = *v + i
				}) catch {
				case Stale:
					failed = true
				}
				got = seen
			case _:
				got = a.Free(r) catch {
				case Stale:
					failed = true
					i
				}
			}
			match want {
			case option.Some[int] as w:
				if failed || (op != 2 && got != w.Value) {
					return false
				}
				match op {
				case 2:
					model[r] = -i
				case 3:
					model[r] = w.Value + i
				case 4:
					model = model.Delete(r)
				case _:
				}
			case option.None:
				if !failed || Has(a, r) {
					return false
				}
			}
		}
		if Len(a) != model.Len() {
			return false
		}
	}
	for r, v in model {
		let got = a.Get(r) catch {
		case Stale:
			return false
		}
		if got != v {
			return false
		}
	}
	true
}

// Null is the Ref that never names a value: Has is false and Get, Set and
// Free fail with Stale. It is the "no link" of a linked structure. Slot
// generations start at 1, so no Put returns Null.
func Null[T]() Ref[T] { Ref[T]{index: -1, gen: 0} }

// NullIsStale: Null names no value, in any store.
law NullIsStale(xs []int) {
	let (a, refs) = filled(xs)
	let mut ok = stale(a, Null[int]()) && stale(New[int](), Null[int]())
	for r in refs {
		ok = ok && r != Null[int]()
	}
	ok
}

// Put stores v and returns its Ref. It reuses the slot freed last, when
// one is free, with a generation no earlier Ref of that slot has.
func Put[T](a mut Of[T], v T) Ref[T] {
	a.live = a.live + 1
	let at = a.free
	if at == -1 {
		a.slots = grow(a.slots, slot[T]{value: stored[T]{Value: v}, gen: 1, next: none})
		return Ref[T]{index: a.slots.Len() - 1, gen: 1}
	}
	a.free = reuse(&a.slots[at], v)
	Ref[T]{index: at, gen: a.slots[at].gen}
}

// reuse stores v in the free slot s, makes its generation odd (live) and
// returns the slot's free-list link. Put writes the slot through this one
// borrow, so the lowered Go indexes the store once, as hand-written Go
// does with a pointer to the slot.
func reuse[T](s mut slot[T], v own T) int {
	s.value = stored[T]{Value: v}
	s.gen = s.gen + 1
	s.next
}

// Has reports whether r names a value of a.
func Has[T](a Of[T], r Ref[T]) bool { live(a.slots, r) }

// live is Has on the store's slots. The operations call it with a.slots
// of their borrow, not Has(*a, r), which copies the store's header: the
// lowered Go then checks the very slice it indexes after the check, and
// proves that index in range (no bounds check left). The result holds no
// slice, so the argument is not copied (types.md, Result aliasing). A
// free slot's generation is even and a Ref's odd or 0 (slot), so equal
// generations mean a live slot.
func live[T](slots []slot[T], r Ref[T]) bool {
	r.index >= 0 && r.index < slots.Len() && slots[r.index].gen == r.gen
}

// Get is the value r names. It fails with Stale when r's value was freed.
// It takes a borrow, as Set does: a value argument read from a let mut
// root is copied whole when T may hold a slice or Map (the value rule,
// types.md, Bindings 2), which would make a Get cost the store.
func Get[T](a mut Of[T], r Ref[T]) T fails Stale {
	if !live(a.slots, r) {
		return Stale
	}
	a.slots[r.index].value.Value
}

// GetAfterPut: Get gives back what Put stored, for every Ref of a run of
// Puts, and Len counts them.
law GetAfterPut(xs []int) {
	let (start, refs) = filled(xs)
	let mut a = start
	let mut ok = Len(a) == xs.Len()
	for i, r in refs {
		let v = a.Get(r) catch {
		case Stale:
			return false
		}
		ok = ok && v == xs[i] && Has(a, r)
	}
	ok
}

// filled is a store after a Put of each of xs, and the Refs Put returned.
func filled(xs []int) (Of[int], []Ref[int]) {
	let mut a = New[int]()
	let mut refs = []Ref[int]{}
	for x in xs {
		refs = refs.Append(a.Put(x))
	}
	(a, refs)
}

// Set replaces the value r names. It fails with Stale when r's value was
// freed, and then changes nothing.
func Set[T](a mut Of[T], r Ref[T], v T) fails Stale {
	if !live(a.slots, r) {
		return Stale
	}
	a.slots[r.index].value.Value = v
}

// Update changes the value r names in place: f gets a borrow of it. It
// fails with Stale when r's value was freed, and then does not call f.
// A write of one field is Go's write of that field, with no copy of T.
func Update[T](a mut Of[T], r Ref[T], f func(v mut T)) fails Stale {
	if !live(a.slots, r) {
		return Stale
	}
	f(&a.slots[r.index].value.Value)
}

// Free removes the value r names and returns it. Every Ref to it is stale
// from now on. It fails with Stale when the value was freed already, and
// then changes nothing. The private host cell clears the removed storage,
// so a freed pointerful value is no longer kept alive by the arena.
func Free[T](a mut Of[T], r Ref[T]) T fails Stale {
	if !live(a.slots, r) {
		return Stale
	}
	let free = a.free
	let v = vacate(&a.slots[r.index], r.gen+1, free)
	a.free = r.index
	a.live = a.live - 1
	v
}

// FreeThenStale: Free returns the value and makes its Ref stale; the
// other Refs keep their values.
law FreeThenStale(xs []int, k int) {
	if xs.Len() == 0 {
		return true
	}
	let (start, refs) = filled(xs)
	let mut a = start
	let i = (k%xs.Len() + xs.Len()) % xs.Len()
	let v = a.Free(refs[i]) catch {
	case Stale:
		return false
	}
	let mut ok = v == xs[i] && stale(a, refs[i]) && Len(a) == xs.Len()-1
	for j, r in refs {
		if j != i {
			let w = a.Get(r) catch {
			case Stale:
				return false
			}
			ok = ok && w == xs[j]
		}
	}
	ok
}

// stale is whether r is stale in a: Has is false, Get, Set, Update and
// Free fail with Stale, Update does not call its function, and Len stays.
func stale(a Of[int], r Ref[int]) bool {
	let mut b = a
	let size = Len(b)
	let mut failed = 0
	let mut called = false
	let _ = b.Get(r) catch {
	case Stale:
		failed = failed + 1
		0
	}
	b.Set(r, 0) catch {
	case Stale:
		failed = failed + 1
	}
	b.Update(r, func(v mut int) { called = true }) catch {
	case Stale:
		failed = failed + 1
	}
	let _ = b.Free(r) catch {
	case Stale:
		failed = failed + 1
		0
	}
	!Has(b, r) && failed == 4 && !called && Len(b) == size
}

// FreeSlotNamesNothing: a free slot names no value, even through a Ref
// of another store at the same index. Two stores fill the same values;
// one frees slot i, the other frees it and reuses it. The reused slot's
// Ref is stale in the store whose slot i is free, so it never reads that
// slot's cleared storage (generation parity: a free slot's is even, a
// Ref's odd).
law FreeSlotNamesNothing(xs []int, k int, v int) {
	if xs.Len() == 0 {
		return true
	}
	let (start, refs) = filled(xs)
	let i = (k%xs.Len() + xs.Len()) % xs.Len()
	let mut a = start
	let _ = a.Free(refs[i]) catch {
	case Stale:
		return false
	}
	let (other, otherRefs) = filled(xs)
	let mut b = other
	let _ = b.Free(otherRefs[i]) catch {
	case Stale:
		return false
	}
	let fresh = b.Put(v)
	stale(a, fresh) && stale(a, refs[i])
}

// vacate takes the value out of the live slot s, gives s the generation
// gen (even: free) and links it to the free slot next. Free writes the slot through
// this one borrow (see reuse).
func vacate[T](s mut slot[T], gen int, next int) T {
	let v = takeValue(&s.value)
	s.gen = gen
	s.next = next
	v
}

// Len is the number of values in a.
func Len[T](a Of[T]) int { a.live }

// Cap is the number of slots a holds, in use or free: Put grows it only
// when no slot is free.
func Cap[T](a Of[T]) int { a.slots.Len() }

// ReuseNeverAliases: a Put after a Free reuses the freed slot (Cap does
// not grow), and its Ref is new: the freed Ref stays stale and names no
// value of the new Put.
law ReuseNeverAliases(xs []int, k int, v int) {
	if xs.Len() == 0 {
		return true
	}
	let (start, refs) = filled(xs)
	let mut a = start
	let i = (k%xs.Len() + xs.Len()) % xs.Len()
	let slots = Cap(a)
	let _ = a.Free(refs[i]) catch {
	case Stale:
		return false
	}
	let fresh = a.Put(v)
	let got = a.Get(fresh) catch {
	case Stale:
		return false
	}
	let mut ok = Cap(a) == slots && got == v && stale(a, refs[i])
	for r in refs {
		ok = ok && r != fresh
	}
	ok
}
