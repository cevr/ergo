// Package arena is a growable store of values of one type, addressed by
// typed handles (docs/spec/stdlib.md, Arenas). Graphs, linked lists and
// entity tables keep Refs where Go keeps pointers: a Ref is two integers,
// so a store of many values holds no pointer of its own and the values sit
// in one Go slice.
//
// A Ref carries the generation of its slot. Free advances the generation,
// so a Ref kept after Free is stale: Get, Set and Free fail with Stale on
// it, also after Put reuses the slot. Only this package builds a Ref, so
// every Ref is one that Put returned, or Null. A Ref is meaningful only
// for the arena that returned it.
//
// The shape is Rust's slotmap and generational-arena; Effect has no
// arena module. The lowering is a slice of slots and a free list linked
// through the free slots, with no interface value.

// Ref names one value of an Of[T]. Refs compare with ==: two Refs are
// equal when they name the same value of the same slot.
type Ref[T] { index int, gen int }

// Stale is the failure of an operation on a Ref whose value was freed, or
// on Null.
type Stale {}

// slot is one cell of the store. gen is the generation of the value in
// it, or of the next value when the slot is free: no Ref with that
// generation exists until Put reuses the slot, so a Ref names a value
// exactly when its generation is its slot's. next links the free slots;
// -1 ends the list (a literal: a package let read from a generic std body
// has no Go name yet, the follow-up in this unit's state).
type slot[T] { value T, gen int, next int }

// Of is the store. Its fields are unexported, so only New and the
// operations make one. Change it through a *Of borrow.
type Of[T] { slots []slot[T], free int, live int }

// New is an empty store.
func New[T]() Of[T] { Of[T]{slots: []slot[T]{}, free: -1, live: 0} }

// Null is the Ref that never names a value: Has is false and Get, Set and
// Free fail with Stale. It is the "no link" of a linked structure. Slot
// generations start at 1, so no Put returns Null.
func Null[T]() Ref[T] { Ref[T]{index: -1, gen: 0} }

// Put stores v and returns its Ref. It reuses the slot freed last, when
// one is free, with a generation no earlier Ref of that slot has.
func Put[T](a *Of[T], v T) Ref[T] {
	a.live = a.live + 1
	let at = a.free
	if at == -1 {
		a.slots = a.slots.Append(slot[T]{value: v, gen: 1, next: -1})
		return Ref[T]{index: len(a.slots) - 1, gen: 1}
	}
	a.free = a.slots[at].next
	a.slots[at].value = v
	a.slots[at].next = -1
	Ref[T]{index: at, gen: a.slots[at].gen}
}

// Has reports whether r names a value of a.
func Has[T](a Of[T], r Ref[T]) bool {
	r.index >= 0 && r.index < len(a.slots) && a.slots[r.index].gen == r.gen
}

// Get is the value r names. It fails with Stale when r's value was freed.
// It takes a borrow, as Set does: a value argument read from a let mut
// root is copied whole when T may hold a slice or Map (the value rule,
// types.md, Bindings 2), which would make a Get cost the store.
func Get[T](a *Of[T], r Ref[T]) T fails Stale {
	if !Has(*a, r) {
		return Stale
	}
	a.slots[r.index].value
}

// Set replaces the value r names. It fails with Stale when r's value was
// freed, and then changes nothing.
func Set[T](a *Of[T], r Ref[T], v T) fails Stale {
	if !Has(*a, r) {
		return Stale
	}
	a.slots[r.index].value = v
}

// Update changes the value r names in place: f gets a borrow of it. It
// fails with Stale when r's value was freed, and then does not call f.
// A write of one field is Go's write of that field, with no copy of T.
func Update[T](a *Of[T], r Ref[T], f func(v *T)) fails Stale {
	if !Has(*a, r) {
		return Stale
	}
	f(&a.slots[r.index].value)
}

// Free removes the value r names and returns it. Every Ref to it is stale
// from now on. It fails with Stale when the value was freed already, and
// then changes nothing. The slot keeps the old value until Put reuses it:
// a type parameter has no zero value to clear it with (G-ex-f-4).
func Free[T](a *Of[T], r Ref[T]) T fails Stale {
	if !Has(*a, r) {
		return Stale
	}
	let v = a.slots[r.index].value
	a.slots[r.index].gen = r.gen + 1
	a.slots[r.index].next = a.free
	a.free = r.index
	a.live = a.live - 1
	v
}

// Len is the number of values in a.
func Len[T](a Of[T]) int { a.live }

// Cap is the number of slots a holds, in use or free: Put grows it only
// when no slot is free.
func Cap[T](a Of[T]) int { len(a.slots) }
