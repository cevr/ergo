// Package sqltest is a database for tests (docs/spec/stdlib.md, Host
// packages, sql). Script is a sql.DB and a sql.Conn that runs nothing: it
// keeps every call it is given, one line each, in the order it was given
// them, and answers each statement from rules. A test binds it as sql.DB
// and reads Log after, so it states what a program sent and in which
// transaction, with no database and no host. Each copy of a Script is the
// same script: its log is a sync.Ref.

import sql
import sync

// Rule is how a Script answers a statement: with rows and a count of rows
// changed, or with a failure. A rule's Statement is the statement's text,
// or one of the lines a Script logs for transaction control: BEGIN,
// COMMIT, SAVEPOINT name, RELEASE SAVEPOINT name and ROLLBACK TO
// SAVEPOINT name. A statement no rule names gives no rows and changes
// none. The first rule that names a statement answers it.
type Rule = Answer{Statement string, Rows []sql.Row, Affected int64} | Refuse{Statement string, With sql.Failure}

// Script is a database that keeps the calls it is given. Begin gives the
// Script itself as the transaction's connection, so one log holds them
// all.
type Script { log sync.Ref[[]string], rules []Rule } implements sql.DB, sql.Conn

// NewScript is a script with an empty log that answers by rules.
func NewScript(rules []Rule) Script { Script{log: sync.NewRef[[]string]([]string{}), rules: rules} }

// Log is every line the script kept: each statement's text, and BEGIN,
// COMMIT, ROLLBACK and the savepoint lines, in the order they came.
func Log(s Script) []string { s.log.Get() }

// keep adds line to the log and is the rule that answers it, if any.
func keep(s Script, line string) Option[Rule] {
	s.log.Update() func(lines []string) []string { lines.Append(line) }
	for r in s.rules {
		let named = match r {
		case Answer as a:
			a.Statement
		case Refuse as f:
			f.Statement
		}
		if named == line {
			return Some[Rule]{Value: r}
		}
	}
	None
}

// refused is the failure of a statement refused with f. A failure a
// statement cannot give (NoRows) is Other.
func refused(f sql.Failure) fails sql.Unique | sql.Serialization | sql.Deadlock | sql.Timeout | sql.Closed | sql.Other {
	match f {
	case sql.Unique as u:
		u
	case sql.Serialization as x:
		x
	case sql.Deadlock as x:
		x
	case sql.Timeout as x:
		x
	case sql.Closed as x:
		x
	case sql.Other as x:
		x
	case sql.NoRows as n:
		sql.Other{Code: "", Message: "no rows: " + n.Statement}
	}
}

// control is the failure of a transaction-control line refused with f,
// within the failures of a savepoint operation.
func control(f sql.Failure) fails sql.Timeout | sql.Closed | sql.Other {
	match f {
	case sql.Timeout as x:
		x
	case sql.Closed as x:
		x
	case sql.Other as x:
		x
	case _:
		sql.Other{Code: "", Message: "refused"}
	}
}

// Exec keeps stmt and answers it.
func Exec(s Script, stmt string, args []sql.Value) sql.Result fails sql.Unique | sql.Serialization | sql.Deadlock | sql.Timeout | sql.Closed | sql.Other {
	match keep(s, stmt) {
	case Some[Rule] as r:
		match r.Value {
		case Answer as a:
			sql.Result{Affected: a.Affected}
		case Refuse as f:
			try refused(f.With)
			sql.Result{Affected: 0}
		}
	case None:
		sql.Result{Affected: 0}
	}
}

// Query keeps stmt and answers it.
func Query(s Script, stmt string, args []sql.Value) []sql.Row fails sql.Unique | sql.Serialization | sql.Deadlock | sql.Timeout | sql.Closed | sql.Other {
	match keep(s, stmt) {
	case Some[Rule] as r:
		match r.Value {
		case Answer as a:
			a.Rows
		case Refuse as f:
			try refused(f.With)
			[]sql.Row{}
		}
	case None:
		[]sql.Row{}
	}
}

// line keeps a transaction-control line and fails as its rule says.
func line(s Script, text string) fails sql.Unique | sql.Serialization | sql.Deadlock | sql.Timeout | sql.Closed | sql.Other {
	match keep(s, text) {
	case Some[Rule] as r:
		match r.Value {
		case Refuse as f:
			try refused(f.With)
		case Answer:
		}
	case None:
	}
}

// Begin keeps BEGIN and is the script as the transaction's connection.
func Begin(s Script) sql.Conn fails sql.Serialization | sql.Deadlock | sql.Timeout | sql.Closed | sql.Other {
	line(s, "BEGIN") catch {
	case sql.Unique as u:
		return sql.Other{Code: "23505", Message: u.Constraint}
	case sql.Serialization as x:
		return x
	case sql.Deadlock as x:
		return x
	case sql.Timeout as x:
		return x
	case sql.Closed as x:
		return x
	case sql.Other as x:
		return x
	}
	s
}

// Commit keeps COMMIT.
func Commit(s Script) fails sql.Unique | sql.Serialization | sql.Deadlock | sql.Timeout | sql.Closed | sql.Other {
	try line(s, "COMMIT")
}

// Rollback keeps ROLLBACK. It never fails.
func Rollback(s Script) {
	let _ = keep(s, "ROLLBACK")
}

func savepointLine(s Script, text string) fails sql.Timeout | sql.Closed | sql.Other {
	match keep(s, text) {
	case Some[Rule] as r:
		match r.Value {
		case Refuse as f:
			try control(f.With)
		case Answer:
		}
	case None:
	}
}

// Savepoint keeps SAVEPOINT name.
func Savepoint(s Script, name string) fails sql.Timeout | sql.Closed | sql.Other {
	try savepointLine(s, "SAVEPOINT "+name)
}

// Release keeps RELEASE SAVEPOINT name.
func Release(s Script, name string) fails sql.Timeout | sql.Closed | sql.Other {
	try savepointLine(s, "RELEASE SAVEPOINT "+name)
}

// RollbackTo keeps ROLLBACK TO SAVEPOINT name.
func RollbackTo(s Script, name string) fails sql.Timeout | sql.Closed | sql.Other {
	try savepointLine(s, "ROLLBACK TO SAVEPOINT "+name)
}
