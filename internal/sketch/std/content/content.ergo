// AssetOrigin identifies the source site that invoked a content mapper.
type AssetOrigin =
	| FileAsset{
		// Path is the imported asset path relative to the module root.
		Path string,
		// Package is the canonical package path receiving the mapped declarations.
		Package string,
	}
	| InlineDerive{
		// Package is the canonical package path declaring the derived type.
		Package string,
		// File is the declaring file name within the package.
		File string,
		// Target is the declared type name of the derive.
		Target string,
		// Line is the one-based source line of the derive declaration.
		Line uint32,
		// Col is the one-based UTF-16 column of the derive declaration.
		Col uint32,
	}

// CompanionAsset carries the path and bytes of a closed companion input.
type CompanionAsset {
	// Path is the module-relative companion path.
	Path string,
	// Bytes are the raw companion payload bytes.
	Bytes []byte,
}

// ContentInput holds the closed check-time input passed to every content mapper.
type ContentInput {
	// Target is the declared type name or asset package stem being generated.
	Target string,
	// Origin records whether the mapper runs for a file asset or inline derive.
	Origin AssetOrigin,
	// MediaKind tags the asset format or pattern kind.
	MediaKind string,
	// Bytes are the raw payload bytes of the primary asset.
	Bytes []byte,
	// Companions are the canonically ordered explicit companion inputs.
	Companions []CompanionAsset,
}

// SourceSpan is a half-open UTF-8 byte interval [Start, End).
type SourceSpan {
	// Start is the inclusive start byte offset.
	Start uint32,
	// End is the exclusive end byte offset.
	End uint32,
}

// SpanMapping associates a generated byte range with its originating asset or companion range.
type SpanMapping {
	// Generated is the byte range in MappedErgo.Source.
	Generated SourceSpan,
	// Companion is Some{index} for a companion input or None for the primary payload.
	Companion Option[uint32],
	// Source is the originating byte range in the selected input bytes.
	Source SourceSpan,
	// Label describes the mapped declaration or clause for inspection.
	Label string,
}

// SourceSpanMap holds sorted, disjoint span mappings for a generated output.
type SourceSpanMap {
	// Entries are ordered by Generated.Start and mutually disjoint.
	Entries []SpanMapping,
}

// DiagSeverity classifies a mapper diagnostic.
type DiagSeverity = Error{} | Warning{}

// MapperDiag is a structured diagnostic emitted by a content mapper before frontend parsing.
type MapperDiag {
	// Severity indicates whether compilation of generated output stops before parsing.
	Severity DiagSeverity,
	// Companion selects a companion index when the mistake lies in a companion asset.
	Companion Option[uint32],
	// Span is the originating byte range inside the selected asset payload.
	Span SourceSpan,
	// Code is the stable mapper diagnostic code.
	Code string,
	// Message explains the mistake directly.
	Message string,
	// Hint suggests an actionable correction when available.
	Hint string,
}

// MappedErgo is the deterministic check-time output of a content mapper.
type MappedErgo {
	// Source is the synthesized in-memory Ergo source text.
	Source string,
	// Spans maps generated byte ranges back to the input or companion bytes.
	Spans SourceSpanMap,
	// Diags reports asset-level errors or warnings detected by the mapper.
	Diags []MapperDiag,
	// Digest optionally records a deterministic mapper output fingerprint.
	Digest []byte,
}

// Mapper is the capability-free check-time function signature implemented by every content mapper.
type Mapper func(ContentInput) MappedErgo

// Plan pairs a pure content mapper function with its inline payload bytes for `type T derive E`.
type Plan {
	// Mapper is the pure check-time mapper function to execute with the target metadata.
	Mapper func(ContentInput) MappedErgo,
	// MediaKind tags the inline payload format.
	MediaKind string,
	// Bytes holds the serialized inline payload bytes.
	Bytes []byte,
	// Companions holds any inline companion payloads bound to this derive.
	Companions []CompanionAsset,
}

// NewSpan constructs a SourceSpan covering [start, end).
func NewSpan(start uint32, end uint32) SourceSpan {
	SourceSpan{Start: start, End: end}
}

// ErrorDiag constructs an Error MapperDiag on the primary asset bytes.
func ErrorDiag(start uint32, end uint32, code string, message string, hint string) MapperDiag {
	MapperDiag{
		Severity:  Error,
		Companion: None,
		Span:      SourceSpan{Start: start, End: end},
		Code:      code,
		Message:   message,
		Hint:      hint,
	}
}

// VerifySpans checks bounds, sorting, and disjointness of spans against generated and input sizes.
func VerifySpans(genLen uint32, assetLen uint32, compLens []uint32, entries []SpanMapping) bool {
	let mut prevEnd = uint32(0)
	for i, e in entries {
		if e.Generated.Start > e.Generated.End || e.Generated.End > genLen {
			return false
		}
		if i > 0 && e.Generated.Start < prevEnd {
			return false
		}
		prevEnd = e.Generated.End
		let srcLimit = match e.Companion {
		case None:
			assetLen
		case Some{Value: idx}:
			if int(idx) >= compLens.Len() {
				return false
			}
			compLens[int(idx)]
		}
		if e.Source.Start > e.Source.End || e.Source.End > srcLimit {
			return false
		}
	}
	true
}

// VerifySpansAcceptsSortedDisjoint holds when non-overlapping spans lie in bounds.
law VerifySpansAcceptsSortedDisjoint(a uint32, b uint32, c uint32) {
	let s0 = a % uint32(20)
	let e0 = s0 + (b % uint32(20))
	let s1 = e0 + (c % uint32(20))
	let e1 = s1 + uint32(5)
	let entries = []SpanMapping{
		SpanMapping{
			Generated: SourceSpan{Start: s0, End: e0},
			Companion: None,
			Source:    SourceSpan{Start: uint32(0), End: uint32(4)},
			Label:     "first",
		},
		SpanMapping{
			Generated: SourceSpan{Start: s1, End: e1},
			Companion: None,
			Source:    SourceSpan{Start: uint32(4), End: uint32(8)},
			Label:     "second",
		},
	}
	VerifySpans(e1+uint32(10), uint32(16), []uint32{}, entries)
}

// VerifySpansRejectsOverlap refuses overlapping generated span intervals.
law VerifySpansRejectsOverlap(a uint32) {
	let start = a % uint32(10)
	let entries = []SpanMapping{
		SpanMapping{
			Generated: SourceSpan{Start: start, End: start + uint32(5)},
			Companion: None,
			Source:    SourceSpan{Start: uint32(0), End: uint32(2)},
			Label:     "a",
		},
		SpanMapping{
			Generated: SourceSpan{Start: start + uint32(4), End: start + uint32(8)},
			Companion: None,
			Source:    SourceSpan{Start: uint32(2), End: uint32(4)},
			Label:     "b",
		},
	}
	!VerifySpans(start+uint32(16), uint32(16), []uint32{}, entries)
}
