// Builder builds a text by appending to one buffer, as Go's
// strings.Builder does: a loop of writes allocates what Go's does, where
// a loop of + copies the text each time. Go's Builder panics when a copy
// of it is written after a write; a Builder here is a value, so a copy is
// its own builder and a write to one never reaches the other (types.md,
// Bindings 1). Build one with NewBuilder; Builder is the program's value,
// so it has no zero value outside this package.
type Builder { buf []byte }

// NewBuilder is an empty Builder.
func NewBuilder() Builder { Builder{buf: []byte{}} }

// WriteString adds s at the end of b, as Go's Builder.WriteString.
func WriteString(b mut Builder, s string) { b.buf = b.buf.AppendString(s) }

// WriteByte adds c at the end of b, as Go's Builder.WriteByte.
func WriteByte(b mut Builder, c byte) { b.buf = b.buf.Append(c) }

// WriteBytes adds the bytes of bs at the end of b, as Go's Builder.Write.
func WriteBytes(b mut Builder, bs []byte) { b.buf = b.buf.AppendBytes(bs) }

// WriteFrom adds n bytes at the end of b, copied from b's text at start
// on, as an LZ77 decoder copies a match: byte k of the n is the byte at
// start+k of the text after the call, so a run that reaches past the end
// repeats what the call wrote (WriteFrom(b.Len()-1, n) repeats the last
// byte n times). A negative n, a start outside the text, or a start at
// its end with n > 0, is a defect. It copies whole runs, never byte by byte: a run the text holds
// already is one append, as hand Go copies from its own []byte (Go's
// Builder has no such write).
func WriteFrom(b mut Builder, start int, n int) { b.buf = b.buf.AppendFrom(start, n) }

// Grow makes room for n more bytes in b, so that the next n bytes written
// allocate nothing, as Go's Builder.Grow; a negative n is a defect, as Go
// panics.
func Grow(b mut Builder, n int) { b.buf = b.buf.Grow(n) }

// Len is the number of bytes written to b.
func Len(b Builder) int { b.buf.Len() }

// String is the text written to b.
func String(b Builder) string { b.buf.Text() }

// BuilderConcatenates: a Builder's text is its writes joined in order,
// Len is that text's length, and a copy taken after a write is its own
// builder: a write to the copy leaves the original as it was.
law BuilderConcatenates(a string, c byte, d string) {
	let mut b = NewBuilder()
	b.WriteString(a)
	b.Grow(d.Len())
	b.WriteByte(c)
	let mut copy = b
	copy.WriteString(d)
	let want = a + []byte{c}.Text()
	b.String() == want && b.Len() == want.Len() && copy.String() == want+d && copy.Len() == want.Len()+d.Len()
}

// WriteFromRepeats: WriteFrom is a loop of WriteByte that reads each byte
// from the text as it grows, from any start in the text and for any count,
// a run that overlaps its own output included.
law WriteFromRepeats(a string, start int, n int) {
	let text = a + "x"
	let from = if start < 0 { -(start + 1) % text.Len() } else { start % text.Len() }
	let count = if n < 0 { -(n + 1) % 300 } else { n % 300 }
	let mut b = NewBuilder()
	b.WriteString(text)
	b.WriteFrom(from, count)
	let mut want = Bytes(text)
	for k in 0..count {
		want = want.Append(want[from+k])
	}
	b.String() == FromBytes(want) && b.Len() == text.Len()+count
}

// BytesRoundTrip: Bytes and FromBytes convert both ways, WriteBytes writes
// what WriteString writes, and the text FromBytes gives is its own: a
// later write to the bytes, through the binding it read or one that
// shared them, leaves it.
law BytesRoundTrip(s string, c byte) {
	let text = s + "x"
	let mut a = Bytes(text)
	let shared = a
	let t = FromBytes(shared)
	let u = FromBytes(a)
	a[0] = c
	let mut b = NewBuilder()
	b.WriteString(s)
	b.WriteBytes(a)
	let mut w = NewBuilder()
	w.WriteString(s)
	w.WriteByte(c)
	w.WriteString(Slice(text, 1, text.Len()))
	t == text && u == text && FromBytes(Bytes(s)) == s && b.String() == w.String() && b.Len() == s.Len()+text.Len()
}
