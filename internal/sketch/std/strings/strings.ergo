// Package strings works on text (docs/spec/stdlib.md, strings and strconv).
// Its functions call Go's strings package through import go, as a user
// binds it (NP4f), so Go's assembly kernels (IndexByte, Index, Count) stay
// Go's; Slice binds a runtime/v1 body until PRIM; Cut is Ergo over Index
// and Slice. Lengths and indexes
// are bytes, as len(s) is.

import go strings
import core
import option
import utf8

// Split is the parts of s between each sep. An empty sep splits s after
// each UTF-8 sequence.
func Split(s string, sep string) []string { strings.Split(s, sep) }

// Join is the elements of xs with sep between each pair.
extern go ergo.local/prototype/runtime/v1.StringsJoin func Join(xs []string, sep string) string

// HasPrefix reports whether s begins with prefix.
func HasPrefix(s string, prefix string) bool { strings.HasPrefix(s, prefix) }

// HasSuffix reports whether s ends with suffix.
func HasSuffix(s string, suffix string) bool { strings.HasSuffix(s, suffix) }

// TrimSpace is s with its leading and trailing white space removed.
func TrimSpace(s string) string { strings.TrimSpace(s) }

// TrimPrefix is s without prefix, or s when it does not begin with prefix.
func TrimPrefix(s string, prefix string) string { strings.TrimPrefix(s, prefix) }

// TrimSuffix is s without suffix, or s when it does not end with suffix.
func TrimSuffix(s string, suffix string) string { strings.TrimSuffix(s, suffix) }

// TrimLeft is s without its leading runes that cutset holds, as Go's
// strings.TrimLeft: cutset is a set of runes, not a prefix (TrimPrefix
// removes a prefix).
func TrimLeft(s string, cutset string) string { strings.TrimLeft(s, cutset) }

// TrimRight is s without its trailing runes that cutset holds, as Go's
// strings.TrimRight.
func TrimRight(s string, cutset string) string { strings.TrimRight(s, cutset) }

// Fields is the runs of s between white space; none when s is all space.
func Fields(s string) []string { strings.Fields(s) }

// FieldsFunc is the runs of s between runes that sep accepts; none when
// sep accepts every rune, as Go's strings.FieldsFunc. s is read as a for
// over it reads it (a byte that begins no valid rune is U+FFFD), and sep
// may be called on a rune more than once.
func FieldsFunc[R](s string, sep func(r rune) bool needs R) []string needs R { strings.FieldsFunc(s, sep) }

// TrimFunc is s without its leading and trailing runes that cut accepts,
// as Go's strings.TrimFunc.
func TrimFunc[R](s string, cut func(r rune) bool needs R) string needs R { strings.TrimFunc(s, cut) }

// Repeat is n copies of s. A negative n is a defect.
func Repeat(s string, n int) string { strings.Repeat(s, n) }

// ToLower is s with each letter in lower case.
func ToLower(s string) string { strings.ToLower(s) }

// ToUpper is s with each letter in upper case.
func ToUpper(s string) string { strings.ToUpper(s) }

// Index is the byte index of the first sub in s, or -1.
func Index(s string, sub string) int { strings.Index(s, sub) }

// IndexByte is the byte index of the first c in s, or -1: Index of a
// one-byte sub, without Index's switch on its length (std-speed-1).
func IndexByte(s string, c byte) int { strings.IndexByte(s, c) }

// IndexAny is the byte index of the first rune of s that chars holds, or
// -1, as Go's strings.IndexAny: s is read as a for over it reads it, so a
// byte that begins no valid rune is U+FFFD, which chars holds when it
// has U+FFFD or a byte that begins no valid rune.
func IndexAny(s string, chars string) int { strings.IndexAny(s, chars) }

// LastIndexAny is the byte index of the last rune of s that chars holds,
// or -1, as Go's strings.LastIndexAny.
func LastIndexAny(s string, chars string) int { strings.LastIndexAny(s, chars) }

// Contains reports whether sub is in s.
func Contains(s string, sub string) bool { strings.Contains(s, sub) }

// Slice is the bytes of s from i up to j. An i or j outside 0..len(s), or
// an i after j, is a defect, as an index out of range is.
func Slice(s string, i int, j int) string { s.Slice(i, j) }

// ReplaceAll is s with each non-overlapping old, from the left, replaced
// by repl. An empty old matches at the start of s and after each UTF-8
// sequence, as in Go.
func ReplaceAll(s string, old string, repl string) string { strings.ReplaceAll(s, old, repl) }

// LastIndex is the byte index of the last sub in s, or -1.
func LastIndex(s string, sub string) int { strings.LastIndex(s, sub) }

// Count is the number of non-overlapping sub in s. An empty sub counts
// one more than the UTF-8 sequences of s, as in Go.
func Count(s string, sub string) int { strings.Count(s, sub) }

// SplitN is Split with at most n parts: the last part is the rest of s.
// n == 0 gives no parts, and a negative n gives all parts, as in Go.
func SplitN(s string, sep string, n int) []string {
	// Go's SplitN is nil for n == 0; an Ergo slice is empty.
	if n == 0 {
		return []string{}
	}
	strings.SplitN(s, sep, n)
}

// EqualFold reports whether s and t are equal under simple Unicode case
// folding.
func EqualFold(s string, t string) bool { strings.EqualFold(s, t) }

// ContainsRune reports whether the UTF-8 encoding of r is in s.
func ContainsRune(s string, r rune) bool { strings.ContainsRune(s, r) }

// ToValidUTF8 is s with each run of invalid UTF-8 bytes replaced by
// replacement, as Go's strings.ToValidUTF8: a run is replaced once, and
// an empty replacement drops it.
func ToValidUTF8(s string, replacement string) string { strings.ToValidUTF8(s, replacement) }

// ToValidUTF8IsValid: ToValidUTF8 with U+FFFD gives valid UTF-8, leaves a
// text that is valid as it was, and replaces (never drops) the invalid
// bytes of one that is not.
law ToValidUTF8IsValid(s string) {
	let v = ToValidUTF8(s, "\uFFFD")
	utf8.ValidString(v) && (!utf8.ValidString(s) || v == s) && (utf8.ValidString(s) || Contains(v, "\uFFFD"))
}

// Halves is the text before and after a separator.
type Halves { Before string, After string }

// Cut is the text before and after the first sep in s, or None when s has
// no sep.
func Cut(s string, sep string) option.Option[Halves] {
	let i = Index(s, sep)
	if i < 0 {
		option.None
	} else {
		option.Some[Halves]{Value: Halves{Before: Slice(s, 0, i), After: Slice(s, i+sep.Len(), s.Len())}}
	}
}

// Lines is the lines of s, each with its line feed; a last line with no
// line feed is a line, and an empty s has no lines. It is Go 1.24's
// strings.Lines, written in Ergo over Index and Slice, because a pure Go
// body cannot import iter.
func Lines(s string) core.Seq[string] {
	core.Seq[string](func(yield func(v string) bool) {
		let mut rest = s
		for _ in 0..s.Len() {
			if rest == "" {
				return
			}
			let i = IndexByte(rest, '\n')
			if i < 0 {
				yield(rest)
				return
			}
			if !yield(Slice(rest, 0, i+1)) {
				return
			}
			rest = Slice(rest, i+1, rest.Len())
		}
	})
}

// The algebra of strings (docs/spec/stdlib.md, Std laws). Each law holds
// for every string, invalid UTF-8 included.

// JoinInvertsSplit: joining the parts of a split by its separator gives
// the text back.
law JoinInvertsSplit(s string, sep string) {
	if sep == "" {
		return true
	}
	Join(Split(s, sep), sep) == s
}

// CountMatchesSplit: a text with n separators splits into n+1 parts.
law CountMatchesSplit(s string, sep string) {
	if sep == "" {
		return true
	}
	Count(s, sep) == Split(s, sep).Len()-1
}

// CutRebuilds: the halves of a cut and the separator are the text; a text
// with no cut has no separator.
law CutRebuilds(s string, sep string) {
	match Cut(s, sep) {
	case option.Some[Halves] as h:
		h.Value.Before+sep+h.Value.After == s && Index(h.Value.Before+sep, sep) == h.Value.Before.Len()
	case option.None:
		!Contains(s, sep)
	}
}

// TrimSpaceIsIdempotent: trimming twice is trimming once.
law TrimSpaceIsIdempotent(s string) { TrimSpace(TrimSpace(s)) } == { TrimSpace(s) }

// TrimLeftRightKeepEnds: TrimLeft keeps a suffix of s and TrimRight a
// prefix, and trimming twice is trimming once.
law TrimLeftRightKeepEnds(s string, cutset string) {
	let l = TrimLeft(s, cutset)
	let r = TrimRight(s, cutset)
	HasSuffix(s, l) && HasPrefix(s, r) && TrimLeft(l, cutset) == l && TrimRight(r, cutset) == r
}

// ToLowerIsIdempotent: lower case twice is lower case once.
law ToLowerIsIdempotent(s string) { ToLower(ToLower(s)) } == { ToLower(s) }

// IndexFinds: Index points at the first sub, and LastIndex points at the
// last one: no sub ends before the first's end, and none starts after the
// last's start; -1 means s has no sub. The empty sub is at 0 and len(s).
law IndexFinds(s string, sub string) {
	let i = Index(s, sub)
	let j = LastIndex(s, sub)
	if i < 0 {
		return j < 0 && !Contains(s, sub)
	}
	if sub == "" {
		return i == 0 && j == s.Len()
	}
	Slice(s, i, i+sub.Len()) == sub && Slice(s, j, j+sub.Len()) == sub && i <= j && LastIndex(Slice(s, 0, i+sub.Len()-1), sub) < 0 && Index(Slice(s, j+1, s.Len()), sub) < 0
}

// IndexAnyFinds: IndexAny and LastIndexAny are the offsets of the first
// and last runes of s, as a for over s reads them, that chars holds
// (ContainsRune), or -1 when there is none.
law IndexAnyFinds(s string, chars string) {
	let mut first = -1
	let mut last = -1
	for i, r in s {
		if ContainsRune(chars, r) {
			if first < 0 {
				first = i
			}
			last = i
		}
	}
	IndexAny(s, chars) == first && LastIndexAny(s, chars) == last
}

// HasPrefixOfConcat: p is a prefix of p+s.
law HasPrefixOfConcat(p string, s string) { HasPrefix(p+s, p) && HasSuffix(p+s, s) }

// RepeatLength: n copies of s are n times as long as s.
law RepeatLength(s string, n int) {
	if n < 0 || n > 64 {
		return true
	}
	Repeat(s, n).Len() == n*s.Len()
}

// FieldsHaveNoSpace: each field is a non-empty run with no white space.
law FieldsHaveNoSpace(s string) {
	for f in Fields(s) {
		let again = Fields(f)
		if again.Len() != 1 || Join(again, "") != f {
			return false
		}
	}
	true
}

// ReplaceAllLength: each of the Count(s, old) replacements changes the
// length by len(repl) - len(old). (The plan's ReplaceAllRemoves is false:
// ReplaceAll("aabb", "ab", "") is "ab".)
law ReplaceAllLength(s string, old string, repl string) {
	if old == "" {
		return true
	}
	ReplaceAll(s, old, repl).Len() == s.Len()+Count(s, old)*(repl.Len()-old.Len())
}

// LinesRebuild: the lines of s, joined, are s.
law LinesRebuild(s string) {
	let mut joined = ""
	for line in Lines(s) {
		joined = joined + line
	}
	joined == s
}

// LinesStops: Lines is a Seq that stops (stdlib.md, Std laws 5): with n
// the count of lines a yield that always returns true gets, for each k
// from 1 to n+1, a yield that returns false at its k-th call is called
// min(k, n) times.
law LinesStops(s string) {
	let lines = Lines(s)
	let mut n = 0
	lines(func(line string) bool {
		n = n + 1
		true
	})
	for k in 1..n+2 {
		let mut calls = 0
		lines(func(line string) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// EqualFoldIsSymmetric: folding equality is reflexive and symmetric. (A
// text and its case maps are not always equal under folding: ToLower of
// "İ" is "i", which does not fold to "İ".)
law EqualFoldIsSymmetric(s string, t string) { EqualFold(s, s) && EqualFold(s, t) == EqualFold(t, s) }
