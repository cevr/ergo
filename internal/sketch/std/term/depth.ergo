import color
import io
import option
import os
import strings

let xterm16 = []int{0x000000, 0xcd0000, 0x00cd00, 0xcdcd00, 0x0000ee, 0xcd00cd, 0x00cdcd, 0xe5e5e5, 0x7f7f7f, 0xff0000, 0x00ff00, 0xffff00, 0x5c5cff, 0xff00ff, 0x00ffff, 0xffffff}

type byteValue int where it >= 0 && it <= 255

func cubeLevel(i int) int { if i == 0 { 0 } else { 55 + 40*i } }

// Palette is xterm's colour n of 256 (n held to [0, 255]): 0 to 15 the
// basic colours of xterm's default theme, 16 to 231 the 6x6x6 cube (levels
// 0, 95, 135, 175, 215, 255), 232 to 255 the greys 8 to 238 in steps of
// 10. It is opaque.
func Palette(n int) color.RGBA {
	let i = if n < 0 { 0 } else if n > 255 { 255 } else { n }
	if i < 16 {
		return color.FromRGB24(uint32(xterm16[i]))
	}
	if i < 232 {
		let k = i - 16
		return color.RGB(uint8(cubeLevel(k/36)), uint8(cubeLevel(k/6%6)), uint8(cubeLevel(k%6)))
	}
	let g = uint8(8 + 10*(i-232))
	color.RGB(g, g, g)
}

func cubeAxis(v int) int {
	if v < 48 {
		return 0
	}
	if v <= 115 {
		return 1
	}
	2 + (v-116)/40
}

func distance(c color.RGBA, r int, g int, b int) int {
	let dr = int(c.R) - r
	let dg = int(c.G) - g
	let db = int(c.B) - b
	dr*dr + dg*dg + db*db
}

// Nearest256 is the colour of 16 to 255 of Palette nearest to c by
// squared distance in sRGB, the lowest index on a tie; c's alpha is not
// read. The 16 basic colours are left out, since terminals theme them.
func Nearest256(c color.RGBA) int {
	let r = cubeAxis(int(c.R))
	let g = cubeAxis(int(c.G))
	let b = cubeAxis(int(c.B))
	let cube = 16 + 36*r + 6*g + b
	let dc = distance(c, cubeLevel(r), cubeLevel(g), cubeLevel(b))
	let mean = (int(c.R) + int(c.G) + int(c.B)) / 3
	let guess = (mean - 3) / 10
	let mut grey = -1
	let mut dg = 0
	for k in guess-1..guess+2 {
		if k < 0 || k > 23 {
			continue
		}
		let v = 8 + 10*k
		let d = distance(c, v, v, v)
		if grey < 0 || d < dg {
			grey = k
			dg = d
		}
	}
	if dg < dc { 232 + grey } else { cube }
}

func nearestIn(c color.RGBA, from int, to int) int {
	let mut best = from
	let mut bestD = -1
	for i in from..to {
		let p = Palette(i)
		let d = distance(c, int(p.R), int(p.G), int(p.B))
		if bestD < 0 || d < bestD {
			best = i
			bestD = d
		}
	}
	best
}

// Nearest256IsBruteForce: Nearest256 is the nearest of every colour 16 to
// 255 of Palette, found by trying each in turn.
law Nearest256IsBruteForce(c color.RGBA) { Nearest256(c) == nearestIn(c, 16, 256) }

// Nearest256AtTheBoundaries: for every channel value v, the colours
// whose channels are v, 0 and 255 in turn, the greys among them, are
// nearest where trying each colour says, ties included.
law Nearest256AtTheBoundaries(n byteValue) {
	let v = uint8(int(n))
	let w = 255 - v
	let probes = []color.RGBA{color.RGB(v, 0, 0), color.RGB(0, v, 255), color.RGB(v, v, v), color.RGB(v, v, w), color.RGB(w, v, v)}
	let mut ok = true
	for p in probes {
		if Nearest256(p) != nearestIn(p, 16, 256) {
			ok = false
		}
	}
	ok
}

// Nearest16 is the colour of 0 to 15 of Palette (xterm's default theme)
// nearest to c by squared distance in sRGB, the lowest index on a tie.
func Nearest16(c color.RGBA) int { nearestIn(c, 0, 16) }

// PaletteIsFixed: each colour of Palette is its own nearest: n for 16 to
// 255 by Nearest256, and n for 0 to 15 by Nearest16.
law PaletteIsFixed(n byteValue) {
	let i = int(n)
	if i < 16 { Nearest16(Palette(i)) == i } else { Nearest256(Palette(i)) == i }
}

// PaletteIsTheTable: recorded xterm palette entries and nearest colours.
law PaletteIsTheTable() {
	let red = color.RGB(255, 0, 0)
		Palette(0) == color.Black &&
		Palette(12) == color.RGB(0x5c, 0x5c, 0xff) &&
		Palette(16) == color.Black &&
		Palette(196) == red &&
		Palette(231) == color.White &&
		Palette(232) == color.RGB(8, 8, 8) &&
		Palette(255) == color.RGB(238, 238, 238) &&
		Palette(-4) == Palette(0) &&
		Palette(999) == Palette(255) &&
		Nearest256(red) == 196 &&
		Nearest256(color.RGB(128, 128, 128)) == 244 &&
		Nearest16(red) == 9 &&
		Nearest16(color.RGB(200, 10, 10)) == 1
}

// Palette16IsNearest: a Palette16 of any 16 colours writes a colour as
// the nearest of them (the lowest on a tie), writes again what it shows
// the same, and Xterm16 agrees with Nearest16; a palette of another size
// fails InvalidPalette.
law Palette16IsNearest(c color.RGBA, drawn []color.RGBA) {
	let mut cs = []color.RGBA{}
	for i in 0..16 {
		cs = cs.Append(if i < drawn.Len() { drawn[i] } else { Palette(i) })
	}
	let p = NewPalette16(cs) catch {
	case InvalidPalette:
		return false
	}
	let mut best = 0
	let mut bestD = -1
	for i in 0..16 {
		let d = distance(c, int(cs[i].R), int(cs[i].G), int(cs[i].B))
		if bestD < 0 || d < bestD {
			best = i
			bestD = d
		}
	}
	let q = p.Quantize(c)
	let again = match p.Expand(q) {
	case option.Some[color.RGBA] as e:
		p.Quantize(e.Value) == q
	case option.None:
		false
	}
	let mut short = false
	let _ = NewPalette16(cs[1:]) catch {
	case InvalidPalette as e:
		short = e.Len == 15
		p
	}
	q == Basic{N: best} && again && Xterm16().Quantize(c) == Basic{N: Nearest16(c)} && short
}

// Depth is what a terminal can show: Quantize is the terminal colour it
// writes for c, and Expand the colour it shows for a terminal colour, None
// when it shows none.
type Depth {
	Quantize(c color.RGBA) Color,
	Expand(c Color) option.Option[color.RGBA],

	// QuantizeIsIdempotent: what Quantize writes, shown and quantized
	// again, is written the same.
	law QuantizeIsIdempotent(c color.RGBA) {
		let q = Quantize(c)
		match Expand(q) {
		case option.Some[color.RGBA] as e:
			Quantize(e.Value) == q
		case option.None:
			q == DefaultColor
		}
	},

	// ExpandIsOpaque: a colour a terminal shows is opaque.
	law ExpandIsOpaque(c color.RGBA) {
		match Expand(Quantize(c)) {
		case option.Some[color.RGBA] as e:
			e.Value.A == 255
		case option.None:
			true
		}
	},
}

func expandWith(c Color, system []color.RGBA) option.Option[color.RGBA] {
	match c {
	case DefaultColor:
		option.None
	case Basic as b:
		option.Some[color.RGBA]{Value: shown(system, if b.N < 0 { 0 } else if b.N > 15 { 15 } else { b.N })}
	case Indexed as x:
		option.Some[color.RGBA]{Value: shown(system, if x.N < 0 { 0 } else if x.N > 255 { 255 } else { x.N })}
	case RGB as x:
		option.Some[color.RGBA]{Value: color.RGBA{R: uint8(clamp(x.R, 255)), G: uint8(clamp(x.G, 255)), B: uint8(clamp(x.B, 255)), A: 255}}
	}
}

func shown(system []color.RGBA, n int) color.RGBA {
	if n < 16 && n < system.Len() { color.RGB(system[n].R, system[n].G, system[n].B) } else { Palette(n) }
}

// TrueColor is the Depth of a 24-bit terminal: every colour is written as
// its RGB.
type TrueColor {} implements Depth

// Quantize is c's RGB.
func Quantize(_ TrueColor, c color.RGBA) Color { RGB{R: int(c.R), G: int(c.G), B: int(c.B)} }

// Expand is c as xterm shows it.
func Expand(_ TrueColor, c Color) option.Option[color.RGBA] { expandWith(c, []color.RGBA{}) }

// Palette256 is the Depth of a 256-colour terminal: a colour is written
// as its Nearest256.
type Palette256 {} implements Depth

// Quantize is Indexed of Nearest256(c).
func Quantize(_ Palette256, c color.RGBA) Color { Indexed{N: Nearest256(c)} }

// Expand is c as xterm shows it.
func Expand(_ Palette256, c Color) option.Option[color.RGBA] { expandWith(c, []color.RGBA{}) }

let onXterm16 = context { Depth: Xterm16() }

// Palette16 is the Depth of a 16-colour terminal with its 16 colours:
// xterm's (Xterm16) or the ones a program read from its terminal
// (NewPalette16). A colour is written as the nearest of them.
type Palette16 { colors []color.RGBA } implements Depth

// InvalidPalette is a palette of other than 16 colours; Len is how many
// it has.
type InvalidPalette { Len int }

// Xterm16 is the Palette16 of xterm's default theme: Palette 0 to 15.
func Xterm16() Palette16 {
	let mut cs = []color.RGBA{}
	for i in 0..16 {
		cs = cs.Append(Palette(i))
	}
	Palette16{colors: cs}
}

// NewPalette16 is the Palette16 of colors, the terminal's colours 0 to 15
// in order, made opaque.
func NewPalette16(colors []color.RGBA) Palette16 fails InvalidPalette {
	if colors.Len() != 16 {
		return InvalidPalette{Len: colors.Len()}
	}
	let mut cs = []color.RGBA{}
	for c in colors {
		cs = cs.Append(color.RGB(c.R, c.G, c.B))
	}
	Palette16{colors: cs}
}

// Quantize is Basic of the nearest of p's colours (the lowest on a tie).
func Quantize(p Palette16, c color.RGBA) Color {
	let n = if p.colors.Len() < 16 { p.colors.Len() } else { 16 }
	if n == 0 {
		return Basic{N: Nearest16(c)}
	}
	let mut best = 0
	let mut bestD = -1
	for i in 0..n {
		let x = p.colors[i]
		let d = distance(c, int(x.R), int(x.G), int(x.B))
		if bestD < 0 || d < bestD {
			best = i
			bestD = d
		}
	}
	Basic{N: best}
}

// Expand is c as a terminal with p's colours shows it.
func Expand(p Palette16, c Color) option.Option[color.RGBA] { expandWith(c, p.colors) }

// Uncolored is the Depth of a terminal that shows no colour: every colour
// is written as the terminal's own.
type Uncolored {} implements Depth

// Quantize is DefaultColor.
func Quantize(_ Uncolored, c color.RGBA) Color { DefaultColor }

// Expand is None.
func Expand(_ Uncolored, c Color) option.Option[color.RGBA] { option.None }

// Level is how many colours a terminal shows: none, the 16 basic ones,
// the 256 indexed ones, or 24-bit colour.
type Level = LevelOff{} | Level16{} | Level256{} | LevelTrue{}

// Env is what Decide reads: the variables NO_COLOR, FORCE_COLOR, TERM and
// COLORTERM, and whether the output is a terminal.
type Env { NoColor option.Option[string], ForceColor option.Option[string], Term option.Option[string], ColorTerm option.Option[string], Terminal bool }

// Detected is the terminal colour capability that Decide produces: it
// provides both Depth and Colors.
type Detected { level Level } implements Depth, Colors

// NewDetected is the Detected of level l, for a program that knows its
// terminal's level (a flag, a configuration).
func NewDetected(l Level) Detected { Detected{level: l} }

// LevelOf is d's level.
func LevelOf(d Detected) Level { d.level }

// On reports whether d enables terminal colour output.
func On(d Detected) bool { d.level != LevelOff }

// Quantize is c at d's level: Uncolored's, Xterm16's, Palette256's or
// TrueColor's.
func Quantize(d Detected, c color.RGBA) Color {
	match d.level {
	case LevelOff:
		DefaultColor
	case Level16:
		Basic{N: Nearest16(c)}
	case Level256:
		Indexed{N: Nearest256(c)}
	case LevelTrue:
		RGB{R: int(c.R), G: int(c.G), B: int(c.B)}
	}
}

// Expand is c as a terminal of d's level shows it.
func Expand(d Detected, c Color) option.Option[color.RGBA] {
	match d.level {
	case LevelOff:
		option.None
	case Level16, Level256, LevelTrue:
		expandWith(c, []color.RGBA{})
	}
}

func rank(l Level) int {
	match l {
	case LevelOff:
		0
	case Level16:
		1
	case Level256:
		2
	case LevelTrue:
		3
	}
}

func nonNeg(n int) int { if n < 0 { -(n + 1) } else { n } }

func text(v option.Option[string]) string {
	match v {
	case option.Some[string] as s:
		s.Value
	case option.None:
		""
	}
}

func hasNoColor(v option.Option[string]) bool {
	match v {
	case option.Some[string] as s:
		s.Value != ""
	case option.None:
		false
	}
}

func termLevel(env Env) Level {
	let tm = strings.ToLower(text(env.Term))
	if tm == "" || tm == "dumb" {
		return LevelOff
	}
	let ct = strings.ToLower(text(env.ColorTerm))
	if ct == "truecolor" || ct == "24bit" || strings.HasSuffix(tm, "-direct") || strings.Contains(tm, "truecolor") || strings.Contains(tm, "24bit") {
		return LevelTrue
	}
	if strings.Contains(tm, "256color") {
		return Level256
	}
	Level16
}

// Decide is the colour capability env asks for: a FORCE_COLOR of 0 or
// false is no colour, of 1, true or empty at least 16 colours, of 2 at
// least 256 and of 3 24-bit; without FORCE_COLOR a NO_COLOR present and
// not empty, an output that is not a terminal, or a TERM unset, empty or
// dumb is no colour; otherwise COLORTERM truecolor or 24bit, or a TERM
// ending -direct or naming truecolor or 24bit, is 24-bit, a TERM naming
// 256color is 256, and any other TERM 16.
func Decide(env Env) Detected {
	match env.ForceColor {
	case option.Some[string] as f:
		let v = strings.ToLower(f.Value)
		if v == "0" || v == "false" {
			return Detected{level: LevelOff}
		}
		let floor = if v == "3" { LevelTrue } else if v == "2" { Level256 } else { Level16 }
		let seen = termLevel(env)
		return Detected{level: if rank(seen) > rank(floor) { seen } else { floor }}
	case option.None:
	}
	if hasNoColor(env.NoColor) || !env.Terminal {
		return Detected{level: LevelOff}
	}
	Detected{level: termLevel(env)}
}

// Detect is Decide of this process's environment and standard output.
func Detect() Detected needs os.Process | io.Stdout {
	Decide(Env{
		NoColor:    os.Process.Getenv("NO_COLOR"),
		ForceColor: os.Process.Getenv("FORCE_COLOR"),
		Term:       os.Process.Getenv("TERM"),
		ColorTerm:  os.Process.Getenv("COLORTERM"),
		Terminal:   io.Stdout.IsTerminal(),
	})
}

// DetectIsTheEnvironment: over every drawn NO_COLOR, FORCE_COLOR, TERM,
// COLORTERM and terminal, Decide's level and Colors.On follow the rules
// in order: a FORCE_COLOR of 0 or false is off; one of 1 to 3 raises
// the TERM's level to it; else non-empty NO_COLOR, no terminal, or no
// usable TERM is off.
law DetectIsTheEnvironment(nc int, fc int, tm int, ct int, terminal bool) {
	let ncs = []option.Option[string]{option.None, option.Some[string]{Value: ""}, option.Some[string]{Value: "1"}}
	let fcs = []option.Option[string]{option.None, option.Some[string]{Value: "0"}, option.Some[string]{Value: ""}, option.Some[string]{Value: "1"}, option.Some[string]{Value: "2"}, option.Some[string]{Value: "3"}, option.Some[string]{Value: "false"}}
	let tms = []option.Option[string]{option.None, option.Some[string]{Value: "dumb"}, option.Some[string]{Value: "xterm"}, option.Some[string]{Value: "xterm-256color"}, option.Some[string]{Value: "xterm-direct"}, option.Some[string]{Value: ""}}
	let cts = []option.Option[string]{option.None, option.Some[string]{Value: "truecolor"}, option.Some[string]{Value: "24bit"}}
	let env = Env{NoColor: ncs[nonNeg(nc)%3], ForceColor: fcs[nonNeg(fc)%7], Term: tms[nonNeg(tm)%6], ColorTerm: cts[nonNeg(ct)%3], Terminal: terminal}
	let t = nonNeg(tm) % 6
	let usable = t >= 2 && t <= 4
	let fromTerm = if !usable { 0 } else if t == 4 || nonNeg(ct)%3 != 0 { 3 } else if t == 3 { 2 } else { 1 }
	let f = nonNeg(fc) % 7
	let want = if f == 1 || f == 6 {
		0
	} else if f != 0 {
		let floor = if f == 5 { 3 } else if f == 4 { 2 } else { 1 }
		if fromTerm > floor { fromTerm } else { floor }
	} else if nonNeg(nc)%3 == 2 || !terminal {
		0
	} else {
		fromTerm
	}
	let d = Decide(env)
	rank(LevelOf(d)) == want && d.On() == (want != 0)
}
