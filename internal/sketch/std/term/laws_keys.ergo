import io

// The laws of the key table (UC1, keys.ergo): the bytes terminals send
// for a key, recorded from xterm, kitty and the Linux console, decode to
// the key, whole and when the bytes come in any chunks.

// recorded is one key's bytes as a terminal sends them and its key. (a
// law's helper)
type recorded { bytes string, key Key }

// mods is a Chord's modifiers: Shift, Alt, Ctrl. (a law's helper)
func mods(shift bool, alt bool, ctl bool) Mods { Mods{Shift: shift, Ctrl: ctl, Alt: alt, Meta: false} }

// keyTable is the recorded keys. (a law's helper)
let keyTable = []recorded{
	recorded{bytes: "a", key: Char{Text: "a"}},
	recorded{bytes: "~", key: Char{Text: "~"}},
	recorded{bytes: "é", key: Char{Text: "é"}},
	recorded{bytes: "界", key: Char{Text: "界"}},
	recorded{bytes: "🙂", key: Char{Text: "🙂"}},
	recorded{bytes: "\r", key: Return},
	recorded{bytes: "\n", key: Return},
	recorded{bytes: "\x7f", key: Backspace},
	recorded{bytes: "\x08", key: Backspace},
	recorded{bytes: "\t", key: Tab},
	recorded{bytes: "\x1b", key: Escape},
	recorded{bytes: "\x03", key: Interrupt},
	recorded{bytes: "\x04", key: EndOfInput},
	recorded{bytes: "\x01", key: Chord{Mods: mods(false, false, true), Name: "a"}},
	recorded{bytes: "\x1a", key: Chord{Mods: mods(false, false, true), Name: "z"}},
	recorded{bytes: "\x00", key: Chord{Mods: mods(false, false, true), Name: " "}},
	recorded{bytes: "\x1b[A", key: Up},
	recorded{bytes: "\x1b[B", key: Down},
	recorded{bytes: "\x1b[C", key: Right},
	recorded{bytes: "\x1b[D", key: Left},
	recorded{bytes: "\x1bOA", key: Up},
	recorded{bytes: "\x1bOD", key: Left},
	recorded{bytes: "\x1b[H", key: Home},
	recorded{bytes: "\x1b[F", key: End},
	recorded{bytes: "\x1bOH", key: Home},
	recorded{bytes: "\x1bOF", key: End},
	recorded{bytes: "\x1b[1~", key: Home},
	recorded{bytes: "\x1b[4~", key: End},
	recorded{bytes: "\x1b[2~", key: Insert},
	recorded{bytes: "\x1b[3~", key: Delete},
	recorded{bytes: "\x1b[5~", key: PageUp},
	recorded{bytes: "\x1b[6~", key: PageDown},
	recorded{bytes: "\x1bOP", key: F{N: 1}},
	recorded{bytes: "\x1bOS", key: F{N: 4}},
	recorded{bytes: "\x1b[15~", key: F{N: 5}},
	recorded{bytes: "\x1b[17~", key: F{N: 6}},
	recorded{bytes: "\x1b[21~", key: F{N: 10}},
	recorded{bytes: "\x1b[24~", key: F{N: 12}},
	recorded{bytes: "\x1b[1;5A", key: Chord{Mods: mods(false, false, true), Name: "ArrowUp"}},
	recorded{bytes: "\x1b[1;2D", key: Chord{Mods: mods(true, false, false), Name: "ArrowLeft"}},
	recorded{bytes: "\x1b[1;3C", key: Chord{Mods: mods(false, true, false), Name: "ArrowRight"}},
	recorded{bytes: "\x1b[1;6H", key: Chord{Mods: mods(true, false, true), Name: "Home"}},
	recorded{bytes: "\x1b[3;5~", key: Chord{Mods: mods(false, false, true), Name: "Delete"}},
	recorded{bytes: "\x1b[5;2~", key: Chord{Mods: mods(true, false, false), Name: "PageUp"}},
	recorded{bytes: "\x1b[1;2P", key: Chord{Mods: mods(true, false, false), Name: "F1"}},
	recorded{bytes: "\x1b[15;5~", key: Chord{Mods: mods(false, false, true), Name: "F5"}},
	recorded{bytes: "\x1b[Z", key: Chord{Mods: mods(true, false, false), Name: "Tab"}},
	recorded{bytes: "\x1bx", key: Chord{Mods: mods(false, true, false), Name: "x"}},
	recorded{bytes: "\x1b\x7f", key: Chord{Mods: mods(false, true, false), Name: "Backspace"}},
	recorded{bytes: "\x1b\x01", key: Chord{Mods: mods(false, true, true), Name: "a"}},
	recorded{bytes: "\x1b\x1b[A", key: Chord{Mods: mods(false, true, false), Name: "ArrowUp"}},
	recorded{bytes: "\x1b[97;5u", key: Chord{Mods: mods(false, false, true), Name: "a"}},
	recorded{bytes: "\x1b[13;2u", key: Chord{Mods: mods(true, false, false), Name: "Enter"}},
	recorded{bytes: "\x1b[27u", key: Escape},
	recorded{bytes: "\x1b[127;3u", key: Chord{Mods: mods(false, true, false), Name: "Backspace"}},
	recorded{bytes: "\x1b[1089::99;5u", key: Chord{Mods: mods(false, false, true), Name: "с"}},
	recorded{bytes: "\x1b[200~hello\r\nworld\x1b[201~", key: Paste{Text: "hello\r\nworld"}},
	recorded{bytes: "\x1b[200~\x1b[201~", key: Paste{Text: ""}},
	recorded{bytes: "\x1b[<64;10;5M", key: Wheel{Up: true, Col: 10, Row: 5}},
	recorded{bytes: "\x1b[<65;1;24M", key: Wheel{Up: false, Col: 1, Row: 24}},
	recorded{bytes: "\x1b[<80;3;3M", key: Wheel{Up: true, Col: 3, Row: 3}},
	recorded{bytes: "\x1b[<0;3;3M", key: Other{Bytes: "\x1b[<0;3;3M"}},
	recorded{bytes: "\x1b[99X", key: Other{Bytes: "\x1b[99X"}},
	recorded{bytes: "\x1c", key: Other{Bytes: "\x1c"}},
}

// DecodeIsTheTable: over drawn runs of recorded keys sent in drawn
// chunks, Feed and then Flush give the run's keys in order, and each
// recorded key's bytes are one key (Cut) that Decode names. A chunk never
// ends right after an ESC with more of its key to come, and always ends
// after an Escape key alone, since a terminal writes each key in one
// write: that is the one rule that tells Escape and then a key from Alt
// and the key.
law DecodeIsTheTable(seed int, length int) {
	let mut r = seeded(seed)
	let n = (length%24+24)%24 + 1
	let mut want = []Key{}
	let mut chunks = []string{}
	let mut chunk = ""
	for _ in 0..n {
		let e = keyTable[draw(&r, len(keyTable))]
		if Cut(e.bytes, false) != len(e.bytes) || Decode(e.bytes) != e.key {
			return false
		}
		want = want.Append(e.key)
		for i in 0..len(e.bytes) {
			chunk = chunk + e.bytes[i:i+1]
			let startsLonger = e.bytes[i] == 0x1b && i+1 < len(e.bytes)
			if !startsLonger && draw(&r, 3) == 0 {
				chunks = chunks.Append(chunk)
				chunk = ""
			}
		}
		if e.bytes == "\x1b" && chunk != "" {
			chunks = chunks.Append(chunk)
			chunk = ""
		}
	}
	chunks = chunks.Append(chunk)
	let mut d = NewDecoder()
	let mut got = []Key{}
	for c in chunks {
		for k in Feed(&d, c) {
			got = got.Append(k)
		}
	}
	for k in Flush(&d) {
		got = got.Append(k)
	}
	got == want
}

// CutTakesOneKey: over drawn bytes, Cut at the end of the input takes
// between one byte and all of them from a nonempty b, and Cut before the
// end takes no more than at the end, or waits. (a property against no
// table: a cut never runs past its bytes or loops on none)
law CutTakesOneKey(seed int, size int) {
	let mut r = seeded(seed)
	let mut b = ""
	let alphabet = "\x1b[O;<0123456789~uAHPMZ\x01\x7fa\xc3\xa9\xe7\x95\x8c"
	for _ in 0..(size%12+12)%12 {
		let i = draw(&r, len(alphabet))
		b = b + alphabet[i:i+1]
	}
	let atEnd = Cut(b, true)
	let before = Cut(b, false)
	if len(b) == 0 {
		return atEnd == 0 && before == -1
	}
	atEnd >= 1 && atEnd <= len(b) && (before == -1 || (before >= 1 && before <= atEnd))
}

// ScriptResizes: a Script's Size is its window until it plays a Resized,
// and that Resized's window after.
law ScriptResizes(cols int, rows int) {
	let w = Window{Cols: (cols%300+300)%300 + 1, Rows: (rows%100+100)%100 + 1}
	let s = NewScript([]Key{Char{Text: "a"}, Resized{Window: w}, Char{Text: "b"}}, Window{Cols: 80, Rows: 24})
	let mut sizes = []Window{}
	with context { Terminal: s } {
		for _ in 0..3 {
			let _ = Terminal.ReadKey() catch {
			case io.ReadFailed:
				EndOfInput
			}
			sizes = sizes.Append(Terminal.Size() catch {
			case NotTerminal:
				Window{Cols: 0, Rows: 0}
			})
		}
	}
	sizes == []Window{Window{Cols: 80, Rows: 24}, w, w}
}

// rng is a law's seeded generator. (a law's helper)
type rng { x int }

// draw is a number in [0, n) from r. (a law's helper)
func draw(r *rng, n int) int {
	r.x = (r.x*1103515245 + 12345) % 2147483648
	(r.x / 65536) % n
}

// seeded is the generator of seed. (a law's helper)
func seeded(seed int) rng { rng{x: (seed%2147483648 + 2147483648) % 2147483648} }
