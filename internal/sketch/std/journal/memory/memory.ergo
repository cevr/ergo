// Package memory is a journal.Journal kept in the process's memory (MU9).
// It outlives an actor, not the process: a test crashes an actor, starts a
// new one with journal.Start over the same Journal, and checks what it
// recovered. A program that must survive a restart of the process uses
// journal/file.

import journal
import option
import sync
import time
import machines
import actor
import queue

// Journal is the memory journal of states S and signals E. Its values are
// copies of one journal: each sees what any of them kept.
type Journal[S, E] {
	append   func(e E, expected int) fails journal.Stale | journal.Failed,
	snapshot func(s S),
	load     func() journal.Log[S, E],
} implements journal.Journal[S, E]

// RecoveryIsTheFold: after any crash, the recovered actor's state is
// machines.From of every signal the journal kept, and every Ask answered
// with a commit is in the journal.
law RecoveryIsTheFold(ops []int, every int) {
	with context { time.Scheduler: time.NewManual(0) } {
		let (j, arm, all) = crashing()
		recovers(j, arm, all, ops, every)
	}
}

// tallyStep reaches each committing Decision and Ignore and Reject by the
// signal mod 5; it has no Done, so an actor ends only by a crash. Its
// states stay in 0..1008, and an Enter's state depends on the order of
// the signals.
func tallyStep(s int, e int) machines.Decision[int, int] {
	match ((e % 5) + 5) % 5 {
	case 0:
		machines.Enter[int]{Next: ((s*3+e%1009)%1009 + 1009) % 1009}
	case 1:
		machines.Stay[int]{Next: (s + 1) % 1009}
	case 2:
		machines.Ignore
	case 3:
		machines.Reject
	case _:
		machines.Emit[int, int]{Next: (s * 2) % 1009, Output: s}
	}
}

func untimed(s int) option.Option[machines.Timeout[int]] { option.None }

func unworked(s int) option.Option[func(send func(e int))] { option.None }

func unexited(s int) option.Option[func()] { option.None }

func tally() machines.Machine[int, int, int] { machines.Machine[int, int, int]{Initial: 0, Step: tallyStep, After: untimed, Work: unworked, Exit: unexited} }

// fold is machines.From over the signals from tally's initial state: the
// state a recovery must reach.
func fold(signals []int) int {
	let o = machines.From(tally(), 0, signals) catch {
	case machines.Rejected:
		return -1
	}
	match o {
	case machines.Running[int, int] as r:
		r.State
	case machines.Finished[int, int]:
		-1
	}
}

// within is whether want is a subsequence of all: each answered commit is
// kept, in order.
func within(want []int, all []int) bool {
	let mut i = 0
	for x in all {
		if i < want.Len() && want[i] == x {
			i = i + 1
		}
	}
	i == want.Len()
}

// crashing is a memory journal whose next Append fails when armed: mode 1
// before it writes, mode 2 after. all is every signal it wrote, also
// those a snapshot dropped (the model's history).
// armed and all are sync.Refs: the closures outlive crashing, and a let
// mut they captured would be a copy (types.md, Function values 3).
func crashing() (Journal[int, int], func(mode int), func() []int) {
	let inner = New[int, int]()
	let armed = sync.NewRef(0)
	let all = sync.NewRef([]int{})
	let j = Journal[int, int]{
		append: func(e int, expected int) fails journal.Stale | journal.Failed {
			let mode = armed.Get()
			armed.Set(0)
			if mode == 1 {
				return journal.Failed{Reason: "crash before the write"}
			}
			try inner.Append(e, expected)
			all.Update(func(xs []int) []int { xs.Append(e) })
			if mode == 2 {
				return journal.Failed{Reason: "crash after the write"}
			}
		},
		snapshot: func(s int) { inner.snapshot(s) },
		load:     func() journal.Log[int, int] { inner.load() },
	}
	(j, func(mode int) { armed.Set(mode) }, func() []int { all.Get() })
}

// recovers runs ops over a durable tally actor on j: an op k mod 9 of 8
// crashes the actor between steps, 7 arms a crash of the next save, and
// any other op is a signal, asked; a snapshot is taken every 1 to 3
// saves. After each crash a new actor recovers from j. It holds that each
// recovered state is the fold of every signal kept, and that each Ask
// answered with a commit is kept.
func recovers(j journal.Journal[int, int], arm func(mode int), all func() []int, ops []int, every int) bool needs time.Scheduler {
	let n = 1 + ((every%3)+3)%3
	let mut a = journal.Start(tally(), j, n, 4, func(o int) {}) catch {
	case _:
		return false
	}
	let mut want = []int{}
	for x in ops {
		let k = ((x % 9) + 9) % 9
		let mut crashed = false
		if k == 8 {
			a.Stop()
			crashed = true
		} else if k == 7 {
			arm(1 + ((x/9)%2+2)%2)
		} else {
			let d = a.Ask(x) catch {
			case actor.Stopped:
				// The save failed: a defect ended the actor.
				crashed = true
				machines.Ignore
			}
			match d {
			case machines.Enter[int]:
				want = want.Append(x)
			case machines.Stay[int]:
				want = want.Append(x)
			case machines.Emit[int, int]:
				want = want.Append(x)
			case _:
			}
			if !within(want, all()) {
				return false
			}
		}
		if crashed {
			a = journal.Start(tally(), j, n, 4, func(o int) {}) catch {
			case _:
				return false
			}
			if a.State() != fold(all()) {
				return false
			}
		}
	}
	let last = a.State()
	a.Stop()
	last == fold(all()) && within(want, all())
}

// New is an empty journal: no snapshot and no signals. Its closures share
// one sync.Ref of the log: a slice is a value (types.md, Values 1), so a
// captured `let mut` would give each closure a copy of its own.
func New[S, E]() Journal[S, E] {
	let log = sync.NewRef(journal.Log[S, E]{Snapshot: option.None, Signals: []E{}})
	Journal[S, E]{
		append: func(e E, expected int) fails journal.Stale | journal.Failed {
			let actual = sync.Modify(log, func(l journal.Log[S, E]) (int, journal.Log[S, E]) {
				if l.Signals.Len() != expected {
					return (l.Signals.Len(), l)
				}
				(expected, journal.Log[S, E]{Snapshot: l.Snapshot, Signals: l.Signals.Append(e)})
			})
			if actual != expected {
				return journal.Stale{Expected: expected, Actual: actual}
			}
		},
		snapshot: func(s S) { log.Set(journal.Log[S, E]{Snapshot: option.Some[S]{Value: s}, Signals: []E{}}) },
		load:     func() journal.Log[S, E] { log.Get() },
	}
}

// StaleAppendKeepsNothing: after k appends, each under the count before
// it, an append that expects another count than k is Stale with the
// journal's count and keeps nothing, and one under k is kept.
law StaleAppendKeepsNothing(k int, off int) {
	let n = ((k % 8) + 8) % 8
	let wrong = n + 1 + ((off%3)+3)%3
	let j = New[int, int]()
	for i in 0..n {
		try j.Append(i, i)
	}
	let before = try j.Load()
	try j.Append(-1, wrong) catch {
	case journal.Stale as s:
		if s != (journal.Stale{Expected: wrong, Actual: n}) || try j.Load() != before {
			return false
		}
		try j.Append(n, n)
		return (try j.Load()).Signals.Len() == n+1
	}
	false
}

// DroppedIsNotJournaled: a work's signal that its entry's end dropped is
// not kept, so a recovery does not step it.
law DroppedIsNotJournaled() {
	with context { time.Scheduler: time.NewManual(0) } {
		dropped(New[int, int]())
	}
}

// relay is the machine of DroppedIsNotJournaled: state 0's work sends
// Ping (12) once gate opens; 10 Go Emits into 1; 11 Leave Enters 2; Ping
// Stays with 100 more; 13 is ignored.
func relayStep(s int, e int) machines.Decision[int, int] {
	match (s, e) {
	case (0, 10):
		machines.Emit[int, int]{Next: 1, Output: 0}
	case (1, 11):
		machines.Enter[int]{Next: 2}
	case (_, 12):
		machines.Stay[int]{Next: s + 100}
	case (_, _):
		machines.Ignore
	}
}

// relay is the machine of relayStep whose state 0's work waits for gate,
// sends Ping and then pushes to sent. Its body is the literal, so
// journal.Start sees its step (rows.md, Footprints 6).
func relay(gate queue.Queue[int], sent queue.Queue[int]) machines.Machine[int, int, int] {
	machines.Machine[int, int, int]{Initial: 0, Step: relayStep, After: func(s int) option.Option[machines.Timeout[int]] { option.None }, Work: func(s int) option.Option[func(send func(e int))] {
		if s != 0 {
			return option.None
		}
		option.Some[func(send func(e int))]{Value: func(send func(e int)) {
			gate.Pop() catch {
			case queue.Closed:
				return
			}
			send(12)
			sent.Push(1) catch {
			case queue.Closed:
			}
		}}
	}, Exit: unexited}
}

// dropped runs relay so that a Ping of entry 0 is sent after Go ended
// that entry, and so dropped: the sink of Go's Emit runs before the runner
// acts on the decision (runner rule 17), and it holds the runner until
// entry 0's work has sent Ping. It holds that the actor dropped one
// signal, that the journal kept Go and Leave only, and that a recovery
// reaches the actor's state.
func dropped(j journal.Journal[int, int]) bool needs time.Scheduler {
	let gate = queue.New[int](1)
	let sent = queue.New[int](1)
	let a = journal.Start(relay(gate, sent), j, 0, 4, func(o int) {
		gate.Push(1) catch {
		case queue.Closed:
		}
		sent.Pop() catch {
		case queue.Closed:
		}
	}) catch {
	case _:
		return false
	}
	a.Send(10) catch {
	case actor.Stopped:
		return false
	}
	a.Send(11) catch {
	case actor.Stopped:
		return false
	}
	a.Ask(13) catch {
	case actor.Stopped:
		return false
	}
	let state = a.State()
	let drops = a.Dropped()
	a.Stop()
	let log = j.Load() catch {
	case journal.Failed:
		return false
	}
	let b = journal.Start(relay(gate, sent), j, 0, 4, func(o int) {}) catch {
	case _:
		return false
	}
	let back = b.State()
	b.Stop()
	drops == 1 && state == 2 && back == 2 && log.Signals.Len() == 2 && log.Signals[0] == 10 && log.Signals[1] == 11
}

// Append keeps e after the expected signals kept before it, else it is
// Stale. A journal from New fails nothing else; the row is the
// contract's, and this package's laws build a journal whose append fails,
// to crash an actor at a chosen save.
func Append[S, E](j Journal[S, E], e E, expected int) fails journal.Stale | journal.Failed { try j.append(e, expected) }

// Snapshot keeps s and drops the signals kept so far. It never fails
// (the row is the contract's).
func Snapshot[S, E](j Journal[S, E], s S) fails journal.Failed { j.snapshot(s) }

// Load is the last snapshot and the signals after it. It never fails
// (the row is the contract's).
func Load[S, E](j Journal[S, E]) journal.Log[S, E] fails journal.Failed { j.load() }
