// Package file is a journal.Journal kept in a file of the host (MU9), so a
// durable actor recovers after the process ends. The file is text, one
// line per entry: `s "…"` for the snapshot (the first line, when there is
// one) and `e "…"` for each signal after it, each value the Go-quoted text
// its codec gives. Each Append adds its one line at the end of the file
// with fs.AppendFile; a crash inside it can leave a part of that line,
// which Open drops and writes the file back without. A Snapshot writes the
// whole file through fs.WriteFile, which writes a new file and renames it
// over the old one: a crash leaves the old journal or the new one, never a
// part. Snapshots keep the file short, since they drop the signals before
// them.
//
// Effect: effect-machine's cluster journal (an append per accepted event)
// over a store the program picks. Go control: an O_APPEND write of one
// line per entry; os.WriteFile of a temporary file and os.Rename, the
// atomic replace of one file, for a snapshot.

import fs
import fstest
import journal
import journal/memory
import option
import strconv
import strings
import sync

// Journal is the file journal of states S and signals E. Its values are
// copies of one journal; one process writes the file at a time.
type Journal[S, E] {
	append   func(e E, expected int) fails journal.Stale | journal.Failed,
	snapshot func(s S) fails journal.Failed,
	load     func() journal.Log[S, E],
} implements journal.Journal[S, E]

// Open is the journal of the file at path, read and written with host: an
// empty one when there is no file there yet. states and signals turn the
// values into text and back. It fails when the file cannot be read or
// holds a whole line that is not an entry, or a value its codec cannot
// decode, and when it cannot drop a cut last line.
func Open[S, E](host fs.Host, path string, states journal.Codec[S], signals journal.Codec[E]) Journal[S, E] fails journal.Failed {
	try open(host, host, path, states, signals)
}

// open is Open over files and writes.
func open[S, E](files fs.Files, writes fs.Writes, path string, states journal.Codec[S], signals journal.Codec[E]) Journal[S, E] fails journal.Failed {
	let text = files.ReadFile(path) catch {
	case fs.NotFound:
		""
	case fs.Denied:
		return journal.Failed{Reason: "\(path): permission denied"}
	case fs.Failed as f:
		return journal.Failed{Reason: "\(path): \(f.Reason)"}
	}
	let (log, whole) = try parse(text, states, signals)
	if whole < text.Len() {
		try write(writes, path, strings.Slice(text, 0, whole))
	}
	// The functions share the log, which outlives Open: a Ref, since a let
	// mut they captured would be a copy (types.md, Function values 3).
	let kept = sync.NewRef(log)
	Journal[S, E]{
		append: func(e E, expected int) fails journal.Stale | journal.Failed {
			let actual = kept.Get().Signals.Len()
			if actual != expected {
				return journal.Stale{Expected: expected, Actual: actual}
			}
			writes.AppendFile(path, "e "+strconv.Quote(signals.Encode(e))+"\n") catch {
			case fs.NotFound:
				return journal.Failed{Reason: "\(path): no such directory"}
			case fs.Denied:
				return journal.Failed{Reason: "\(path): permission denied"}
			case fs.Failed as f:
				return journal.Failed{Reason: "\(path): \(f.Reason)"}
			}
			kept.Update(func(l journal.Log[S, E]) journal.Log[S, E] {
				journal.Log[S, E]{Snapshot: l.Snapshot, Signals: l.Signals.Append(e)}
			})
		},
		snapshot: func(s S) fails journal.Failed {
			try write(writes, path, "s "+strconv.Quote(states.Encode(s))+"\n")
			kept.Set(journal.Log[S, E]{Snapshot: option.Some[S]{Value: s}, Signals: []E{}})
		},
		load: func() journal.Log[S, E] { kept.Get() },
	}
}

// Append writes e as one line after the expected signals kept before it,
// else it is Stale.
func Append[S, E](j Journal[S, E], e E, expected int) fails journal.Stale | journal.Failed { try j.append(e, expected) }

// Snapshot writes the file anew with s as its only entry.
func Snapshot[S, E](j Journal[S, E], s S) fails journal.Failed { try j.snapshot(s) }

// Load is the last snapshot and the signals after it, as written. It
// never fails (the row is the contract's): Open read the file, and only
// this journal writes it.
func Load[S, E](j Journal[S, E]) journal.Log[S, E] fails journal.Failed { j.load() }

// write makes the file at path hold text.
func write(writes fs.Writes, path string, text string) fails journal.Failed {
	writes.WriteFile(path, text) catch {
	case fs.NotFound:
		return journal.Failed{Reason: "\(path): no such directory"}
	case fs.Denied:
		return journal.Failed{Reason: "\(path): permission denied"}
	case fs.Failed as f:
		return journal.Failed{Reason: "\(path): \(f.Reason)"}
	}
}

// parse reads the entries of a journal file, and the length of its whole
// lines: a last line with no line feed is a cut append, and is not read.
func parse[S, E](text string, states journal.Codec[S], signals journal.Codec[E]) (journal.Log[S, E], int) fails journal.Failed {
	let mut snap option.Option[S] = option.None
	let mut kept = []E{}
	let mut n = 0
	let mut whole = 0
	for raw in strings.Lines(text) {
		if !strings.HasSuffix(raw, "\n") {
			break
		}
		n = n + 1
		whole = whole + raw.Len()
		let line = strings.TrimSuffix(raw, "\n")
		if line.Len() < 2 {
			return journal.Failed{Reason: "line \(n) is not an entry"}
		}
		let quoted = strconv.Unquote(strings.Slice(line, 2, line.Len())) catch {
		case strconv.Malformed:
			return journal.Failed{Reason: "line \(n) is not an entry"}
		}
		if strings.HasPrefix(line, "s ") && n == 1 {
			snap = option.Some[S]{Value: try states.Decode(quoted)}
		} else if strings.HasPrefix(line, "e ") {
			kept = kept.Append(try signals.Decode(quoted))
		} else {
			return journal.Failed{Reason: "line \(n) is not an entry"}
		}
	}
	(journal.Log[S, E]{Snapshot: snap, Signals: kept}, whole)
}

// texts is the codec of values that are text: each is its own text.
type texts {} implements journal.Codec[string]

// Encode is v.
func Encode(_ texts, v string) string { v }

// Decode is text.
func Decode(_ texts, text string) string fails journal.Failed { text }

// FileIsMemory: a file journal over a disk in memory keeps what a memory
// journal keeps for a generated script of appends, each under the count
// it loaded or one off (Stale, kept by neither), and snapshots; and so
// does the journal a reopen gives after a crash cut its last append
// (torn, a part of a line with no line feed), also after one more append.
law FileIsMemory(ops []int, torn string) {
	let disk = fstest.NewMemory()
	let want = memory.New[string, string]()
	let mut got = try open(disk, disk, "j.log", texts, texts)
	for i, op in ops {
		let n = (try want.Load()).Signals.Len()
		let v = "v\t\"\n\(i)"
		match ((op % 7) + 7) % 7 {
		case 0:
			try want.Snapshot(v)
			try got.Snapshot(v)
		case 1:
			got = try open(disk, disk, "j.log", texts, texts)
		case _:
			let off = if op%5 == 0 { 1 } else { 0 }
			if stale(want, v, n+off) != stale(got, v, n+off) {
				return false
			}
		}
		if try want.Load() != try got.Load() {
			return false
		}
	}
	try disk.AppendFile("j.log", "e "+strings.ReplaceAll(torn, "\n", ""))
	let back = try open(disk, disk, "j.log", texts, texts)
	if try back.Load() != try want.Load() {
		return false
	}
	let n = (try want.Load()).Signals.Len()
	let _ = stale(want, torn, n)
	let _ = stale(back, torn, n)
	let again = try open(disk, disk, "j.log", texts, texts)
	try again.Load() == try want.Load()
}

// stale is whether j's Append of v under expected was Stale (a failure
// counts as stale too, and neither journal here fails).
func stale(j journal.Journal[string, string], v string, expected int) bool {
	j.Append(v, expected) catch {
	case journal.Stale, journal.Failed:
		return true
	}
	false
}
