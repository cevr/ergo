// Package crc32 computes the CRC-32 checksum of text with the IEEE
// polynomial (docs/spec/stdlib.md, encodings and digests; G3 std-digest).
// It is Go's hash/crc32 with IEEETable over Ergo's strings, which hold
// bytes (types.md, Strings 1). Checksum calls Go's hash/crc32 through
// import go, as a user binds it (NP4f), on a view of s's bytes (interop.md,
// Foreign facts 8); Update passes Go's package variable IEEETable (GBX3).

import go hash/crc32
import strings

// Checksum is the IEEE CRC-32 of the bytes of s, as Go's ChecksumIEEE.
func Checksum(s string) uint32 { crc32.ChecksumIEEE(strings.Bytes(s)) }

// Update is the checksum crc carried over the bytes of s, as Go's Update
// with IEEETable: a checksum of a text read in parts.
func Update(crc uint32, s string) uint32 { crc32.Update(crc, crc32.IEEETable, strings.Bytes(s)) }

// ChecksumBytes is the IEEE CRC-32 of data, as Go's ChecksumIEEE: Checksum
// for bytes a caller already holds, with no string made of them.
func ChecksumBytes(data []byte) uint32 { crc32.ChecksumIEEE(data) }

// UpdateBytes is the checksum crc carried over data, as Go's Update with
// IEEETable.
func UpdateBytes(crc uint32, data []byte) uint32 { crc32.Update(crc, crc32.IEEETable, data) }

// BytesAgree: the byte forms give the checksums of the text forms over the
// same bytes.
law BytesAgree(s string, crc uint32) { ChecksumBytes(s.Bytes()) == Checksum(s) && UpdateBytes(crc, s.Bytes()) == Update(crc, s) }

// UpdateChains: the checksum of a, carried over b, is the checksum of a +
// b.
law UpdateChains(a string, b string) { Update(Checksum(a), b) == Checksum(a+b) }

// UpdateFromZero: carrying the zero checksum over s is the checksum of s.
law UpdateFromZero(s string) { Update(0, s) == Checksum(s) }
