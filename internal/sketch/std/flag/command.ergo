import option
import slices
import strings
import strconv

// Command is one subcommand of a program whose commands are the union C
// (@effect/cli Command.withSubcommands): its name, its usage line, its
// Set, and Build, which makes the program's C from the parsed Values.
// Build may fail with the program's own failures E as well as the flag
// failures (a port that is not a number, a path that does not exist): E
// is a row parameter, empty when Build fails only as Parse does. Commands
// are the children. A group dispatches to a child; only a leaf uses Set
// and Build. Group makes a group without a dummy Build at the call site.
// A group's child named "" is the group's own leaf (Cobra's Run on a
// parent; @effect/cli's handler on a command withSubcommands): it runs
// when no child name follows the group, so `tool auth` runs it and
// `tool auth whoami` runs the child. A level holds at most one such leaf.
type Command[C, E] {
	Name     string,
	Usage    string,
	Set      Set,
	Build    func(v Values) C fails E | Help | Unknown | NeedsValue | Invalid | Missing | Extra | UnknownCommand,
	Commands []Command[C, E],
}

// EachCommandReaches: each command's name runs that command's Build.
law EachCommandReaches(i int) {
	let commands = lawCommands()
	if i < 0 || i >= commands.Len() {
		return true
	}
	commandName(try ParseCommand("law", "", commands, []string{commands[i].Name})) == commands[i].Name
}

// lawCommand is the union of the commands of EachCommandReaches.
type lawCommand = lawList{} | lawShow{}

// lawCommands are two commands that each build their own variant. Their
// Build fails nothing of its own, so the row E is left out (types.md,
// Generics 7).
func lawCommands() []Command[lawCommand] {
	[]Command[lawCommand]{
		Command[lawCommand]{Name: "list", Usage: "list", Set: lawSet(), Build: buildList, Commands: []Command[lawCommand]{}},
		Command[lawCommand]{Name: "show", Usage: "show", Set: lawSet(), Build: buildShow, Commands: []Command[lawCommand]{}},
	}
}

// buildList is the list command's Build.
func buildList(_ Values) lawCommand { lawList }

// buildShow is the show command's Build.
func buildShow(_ Values) lawCommand { lawShow }

// commandName is the name of the command that built c.
func commandName(c lawCommand) string {
	match c {
	case lawList:
		"list"
	case lawShow:
		"show"
	}
}

// BuildFailureReaches: a Build's own failure reaches the caller of
// ParseCommand as it is, with its value.
law BuildFailureReaches(text string) {
	let commands = []Command[lawCommand, lawRefused]{Command[lawCommand, lawRefused]{Name: "refuse", Usage: "refuse", Set: lawSet(), Build: buildRefuse, Commands: []Command[lawCommand, lawRefused]{}}}
	ParseCommand("law", "", commands, []string{"refuse", "-s=" + text}) catch {
	case lawRefused as r:
		return r.Text == text
	case _:
		return false
	}
	false
}

// lawRefused is the own failure of BuildFailureReaches's command.
type lawRefused { Text string }

// buildRefuse is a Build that fails with its own failure, carrying the
// value of -s.
func buildRefuse(v Values) lawCommand fails lawRefused {
	return lawRefused{Text: lawText.Get(v)}
}

// HelpNamesEveryCommand: a level's help lists every descendant path, each
// level's own leaf at the level's path among them.
law HelpNamesEveryCommand(n int) {
	let depth = treeDepth(n)
	let help = CommandUsage("tree", "", treeCommands(depth))
	let own = "\n    \tthe level's own\n"
	if !strings.Contains(help, "\n  tree"+own) { return false }
	let mut prefix = ""
	for _ in 0..depth {
		if !strings.Contains(help, "\n  "+prefix+"read\n") { return false }
		prefix = prefix + "group"
		if !strings.Contains(help, "\n  "+prefix+own) { return false }
		prefix = prefix + " "
	}
	strings.Contains(help, "\n  "+prefix+"read\n")
}

// Group declares a command level. Flags belong to leaves; a group consumes
// exactly its name and delegates the remaining arguments to its children.
func Group[C, E](name string, usage string, commands []Command[C, E]) Command[C, E] {
	if commands.Len() == 0 { return Unreachable("flag: a group needs a child command") }
	Command[C, E]{Name: name, Usage: usage, Set: Set{Name: name, Usage: usage, Flags: []Flag{}, Args: []ArgSpec{}}, Build: func(_ Values) C { Unreachable("flag: a group has no Build") }, Commands: commands}
}

// Root declares the program name and its optional --version built-in.
// None means --version is not declared. A Version result is handled beside
// Help, without adding it to a leaf Build's failure row.
type Root[C, E] { Name string, Usage string, Commands []Command[C, E], Version option.Option[string] }
type Version { Text string }

func ParseRoot[C, E](root Root[C, E], args []string) C fails E | Version | Help | Unknown | NeedsValue | Invalid | Missing | Extra | UnknownCommand {
	if args.Len() > 0 && (args[0] == "--help" || args[0] == "-help" || args[0] == "-h") {
		return Help{Text: RootUsage(root)}
	}
	if args.Len() > 0 && args[0] == "--version" {
		match root.Version {
		case option.Some as v:
			return Version{Text: v.Value}
		case option.None:
		}
	}
	try ParseCommand(root.Name, root.Usage, root.Commands, args)
}

// RootUsage includes only built-ins that the root declares.
func RootUsage[C, E](root Root[C, E]) string {
	let help = CommandUsage(root.Name, root.Usage, root.Commands)
	match root.Version {
	case option.None:
		help
	case option.Some:
		help + "  --version\n    \tprint the version\n"
	}
}

// ParseCommand reads args as a command name and that command's own
// arguments, and returns what its Build makes; Parse of the command's Set
// reads its help. A failure of Build reaches the caller as it is, in E.
// When the first argument names no command, -h, -help or --help anywhere
// before "--" fails Help with CommandUsage, as @effect/cli's help wins
// over a parse error. Otherwise the level's own leaf (a child named "")
// parses every argument when there is one and no argument follows, the
// first is a flag or "--", or the leaf takes positional arguments; else a
// name of no command, or no name, fails UnknownCommand, whose Group is the
// path of group names below the root.
func ParseCommand[C, E](name string, usage string, commands []Command[C, E], args []string) C fails E | Help | Unknown | NeedsValue | Invalid | Missing | Extra | UnknownCommand {
	try parseLevel[C, E](name, usage, []string{}, commands, args)
}

// RenderParseTreeRoundTrip includes the path and all cardinalities, to a
// named leaf or to a level's own leaf. Each generated line parses, so the
// law does not discard invalid test inputs.
law RenderParseTreeRoundTrip(n int, text string, num int, items []string, rest []string) {
	let depth = treeDepth(n)
	let commands = treeCommands(depth)
	let path = treePath(depth, treeOwn(n))
	let mut args = path
	args = args.Append("--text=" + text).Append("--number=" + strconv.Itoa(num))
	for item in items { args = args.Append("--item=" + item) }
	args = args.Append("--")
	for r in rest { args = args.Append(r) }
	let v = try ParseCommand("tree", "", commands, args)
	let again = try ParseCommand("tree", "", commands, RenderCommand(path, v))
	Equal(v, again) && treeText.Get(again) == option.Some[string]{Value: text} && treeNumber.Get(again) == option.Some[int]{Value: num} && sameStrings(treeItems.Get(again), items) && sameStrings(Rest(again), rest)
}

let treeText = OptionalString("text", "optional text").WithAlias("t")

let treeNumber = OptionalInt("number", "optional number").WithAlias("n")

let treeItems = String("item", "", "an item").Repeated().WithAlias("i")

func treeSet() Set {
	Set{Name: "leaf", Usage: "a leaf", Flags: []Flag{treeText, treeNumber, treeItems}, Args: []ArgSpec{Remaining("rest", "remaining arguments")}}
}

func treeBuild(v Values) Values { v }

// treeCommands generates both branching and nesting. Depth is bounded by
// the law's input normalization, not by the parser. Each level has its
// own leaf, the child named "" (gap-group), beside a leaf "read" and,
// below the last level, a group.
func treeCommands(depth int) []Command[Values] {
	let leaf = Command[Values]{Name: "read", Usage: "read", Set: treeSet(), Build: treeBuild, Commands: []Command[Values]{}}
	let own = Command[Values]{Name: "", Usage: "the level's own", Set: treeSet(), Build: treeBuild, Commands: []Command[Values]{}}
	if depth == 0 { return []Command[Values]{leaf, own} }
	[]Command[Values]{leaf, own, Group("group", "a group", treeCommands(depth-1))}
}

func treeDepth(n int) int {
	let r = n % 3
	if r < 0 { -r } else { r }
}

// treeOwn draws, from n, whether the law's path ends at a level's own leaf.
func treeOwn(n int) bool { (n/3)%2 != 0 }

func treeGroupPath(depth int) []string {
	let mut path = []string{}
	for _ in 0..depth { path = path.Append("group") }
	path
}

func treePath(depth int, own bool) []string {
	if own { return treeGroupPath(depth) }
	treeGroupPath(depth).Append("read")
}

// parseLevel is ParseCommand at one level of the tree: groups is the path
// of group names from the root to this level.
func parseLevel[C, E](name string, usage string, groups []string, commands []Command[C, E], args []string) C fails E | Help | Unknown | NeedsValue | Invalid | Missing | Extra | UnknownCommand {
	let first = if args.Len() > 0 { args[0] } else { "" }
	let rest = if args.Len() > 0 { slices.Slice(args, 1, args.Len()) } else { args }
	if args.Len() > 0 {
		for c in commands {
			if c.Name != "" && c.Name == first {
				let path = if name == "" { c.Name } else { name + " " + c.Name }
				if c.Commands.Len() > 0 {
					return try parseLevel[C, E](path, c.Usage, groups.Append(c.Name), c.Commands, rest)
				}
				let v = try Parse(Set{..c.Set, Name: path}, rest)
				return try c.Build(v)
			}
		}
	}
	match ownLeaf(commands) {
	case option.Some[Command[C, E]] as own:
		let leaf = own.Value
		if leaf.Commands.Len() > 0 {
			return Unreachable("flag: a group's own leaf has no children")
		}
		if helpAsked(Set{..leaf.Set, Name: name}, args) {
			return Help{Text: CommandUsage(name, usage, commands)}
		}
		if args.Len() == 0 || strings.HasPrefix(first, "-") || leaf.Set.Args.Len() > 0 {
			let v = try Parse(Set{..leaf.Set, Name: name}, args)
			return try leaf.Build(v)
		}
	case option.None:
		if helpAsked(Set{Name: name, Usage: usage, Flags: []Flag{}, Args: []ArgSpec{}}, args) {
			return Help{Text: CommandUsage(name, usage, commands)}
		}
	}
	UnknownCommand{Name: first, Known: commandNames(commands), Group: groups}
}

// ownLeaf is the child named "" of a level: its own leaf.
func ownLeaf[C, E](commands []Command[C, E]) option.Option[Command[C, E]] {
	for c in commands {
		if c.Name == "" {
			return option.Some[Command[C, E]]{Value: c}
		}
	}
	option.None
}

// CommandUsage is the help of a program of commands: "Usage of NAME:",
// usage on its own line when it is not empty, and then each command with
// its usage line, in declaration order.
func CommandUsage[C, E](name string, usage string, commands []Command[C, E]) string {
	let mut out = if name == "" { "Usage:\n" } else { "Usage of " + name + ":\n" }
	if usage != "" {
		out = out + usage + "\n"
	}
	out = out + "Commands:\n"
	out = out + commandHelp(name, "", commands)
	out
}

// commandHelp lists complete relative paths, including every descendant.
// A level's own leaf is listed at the level's path, or at name, the
// program's, at the top.
func commandHelp[C, E](name string, prefix string, commands []Command[C, E]) string {
	let mut out = ""
	for c in commands {
		let path = if c.Name == "" { prefix } else if prefix == "" { c.Name } else { prefix + " " + c.Name }
		let shown = if path == "" { name } else { path }
		out = out + "  " + shown + "\n    \t" + c.Usage + "\n"
		out = out + commandHelp[C, E](name, path, c.Commands)
	}
	out
}

// RenderCommand prefixes a leaf's canonical arguments with its command path.
// The path is data supplied by the program, like the names in Command.
func RenderCommand(path []string, v Values) []string {
	let mut out = path
	for a in Render(v) { out = out.Append(a) }
	out
}

// commandNames is the names of commands, in order, without a level's own
// leaf, which no name selects.
func commandNames[C, E](commands []Command[C, E]) []string {
	let mut out = []string{}
	for c in commands {
		if c.Name != "" {
			out = out.Append(c.Name)
		}
	}
	out
}
