import strconv
import strings

let treeText = OptionalString("text", "optional text").WithAlias("t")
let treeNumber = OptionalInt("number", "optional number").WithAlias("n")
let treeItems = String("item", "", "an item").Repeated().WithAlias("i")

func treeSet() Set {
	Set{Name: "leaf", Usage: "a leaf", Flags: []Flag{treeText, treeNumber, treeItems}, Args: []ArgSpec{Remaining("rest", "remaining arguments")}}
}

func treeBuild(v Values) Values { v }

// treeCommands generates both branching and nesting. Depth is bounded by
// the law's input normalization, not by the parser. Each level has its
// own leaf, the child named "" (gap-group), beside a leaf "read" and,
// below the last level, a group.
func treeCommands(depth int) []Command[Values] {
	let leaf = Command[Values]{Name: "read", Usage: "read", Set: treeSet(), Build: treeBuild, Commands: []Command[Values]{}}
	let own = Command[Values]{Name: "", Usage: "the level's own", Set: treeSet(), Build: treeBuild, Commands: []Command[Values]{}}
	if depth == 0 { return []Command[Values]{leaf, own} }
	[]Command[Values]{leaf, own, Group("group", "a group", treeCommands(depth-1))}
}

// treeGroups is treeCommands with no level's own leaf.
func treeGroups(depth int) []Command[Values] {
	let leaf = Command[Values]{Name: "read", Usage: "read", Set: treeSet(), Build: treeBuild, Commands: []Command[Values]{}}
	if depth == 0 { return []Command[Values]{leaf} }
	[]Command[Values]{leaf, Group("group", "a group", treeGroups(depth-1))}
}

func treeDepth(n int) int {
	let r = n % 3
	if r < 0 { -r } else { r }
}

// treeOwn draws, from n, whether the law's path ends at a level's own leaf.
func treeOwn(n int) bool { (n / 3) % 2 != 0 }

func treeGroupPath(depth int) []string {
	let mut path = []string{}
	for _ in 0..depth { path = path.Append("group") }
	path
}

func treePath(depth int, own bool) []string {
	if own { return treeGroupPath(depth) }
	treeGroupPath(depth).Append("read")
}

// RenderParseTreeRoundTrip includes the path and all cardinalities, to a
// named leaf or to a level's own leaf. Each generated line parses, so the
// law does not discard invalid test inputs.
law RenderParseTreeRoundTrip(n int, text string, num int, items []string, rest []string) {
	let depth = treeDepth(n)
	let commands = treeCommands(depth)
	let path = treePath(depth, treeOwn(n))
	let mut args = path
	args = args.Append("--text=" + text).Append("--number=" + strconv.Itoa(num))
	for item in items { args = args.Append("--item=" + item) }
	args = args.Append("--")
	for r in rest { args = args.Append(r) }
	let v = try ParseCommand("tree", "", commands, args)
	let again = try ParseCommand("tree", "", commands, RenderCommand(path, v))
	Equal(v, again) && treeText.Get(again) == Some[string]{Value: text} && treeNumber.Get(again) == Some[int]{Value: num} && sameStrings(treeItems.Get(again), items) && sameStrings(Rest(again), rest)
}

law DeclaredShortAndLongAgree(text string) {
	Equal(try Parse(treeSet(), []string{"-t=" + text}), try Parse(treeSet(), []string{"--text=" + text}))
}

law AbsentIsNone() {
	let v = try Parse(treeSet(), []string{})
	treeText.Get(v) == None && treeNumber.Get(v) == None
}

law RepeatedKeepsOrder(items []string) {
	let mut args = []string{}
	for item in items { args = args.Append("-i=" + item) }
	sameStrings(treeItems.Get(try Parse(treeSet(), args)), items)
}

// HelpNamesEveryCommand: a level's help lists every descendant path, each
// level's own leaf at the level's path among them.
law HelpNamesEveryCommand(n int) {
	let depth = treeDepth(n)
	let help = CommandUsage("tree", "", treeCommands(depth))
	let own = "\n    \tthe level's own\n"
	if !strings.Contains(help, "\n  tree"+own) { return false }
	let mut prefix = ""
	for _ in 0..depth {
		if !strings.Contains(help, "\n  "+prefix+"read\n") { return false }
		prefix = prefix + "group"
		if !strings.Contains(help, "\n  "+prefix+own) { return false }
		prefix = prefix + " "
	}
	strings.Contains(help, "\n  "+prefix+"read\n")
}

// UnknownCommandNamesItsGroup: a word that names no child of a level with
// no own leaf, or no word, fails UnknownCommand with the word and the
// path of group names to that level.
law UnknownCommandNamesItsGroup(n int, word string) {
	let depth = treeDepth(n)
	let groups = treeGroupPath(depth)
	let name = if word == "read" || word == "group" || strings.HasPrefix(word, "-") { "" } else { word }
	let args = if name == "" { groups } else { groups.Append(name) }
	let _ = ParseCommand("tree", "", treeGroups(depth), args) catch {
	case UnknownCommand as u:
		return u.Name == name && sameStrings(u.Group, groups)
	case Help, Unknown, NeedsValue, Invalid, Missing, Extra:
		return false
	}
	false
}
