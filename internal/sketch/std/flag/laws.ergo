import strconv
import strings

// The laws of flag (docs/spec/stdlib.md, Std laws), stated over one set:
// a text -s, an integer -n, a switch -b and the remaining arguments.

let lawText = String("s", "d", "a text")
let lawNumber = Int("n", 0, "a number")
let lawSwitch = Bool("b", false, "a switch")
let lawRequired = RequiredString("r", "a required text")

// lawSet is the set the laws parse with.
func lawSet() Set {
	Set{Name: "law", Usage: "", Flags: []Flag{lawText, lawNumber, lawSwitch}, Args: []ArgSpec{Remaining("rest", "the rest")}}
}

// lawCommand is the union of the commands of EachCommandReaches.
type lawCommand = lawList{} | lawShow{}

// lawCommands are two commands that each build their own variant. Their
// Build fails nothing of its own, so the row E is left out (types.md,
// Generics 7).
func lawCommands() []Command[lawCommand] {
	[]Command[lawCommand]{
		Command[lawCommand]{Name: "list", Usage: "list", Set: lawSet(), Build: buildList, Commands: []Command[lawCommand]{}},
		Command[lawCommand]{Name: "show", Usage: "show", Set: lawSet(), Build: buildShow, Commands: []Command[lawCommand]{}},
	}
}

// buildList is the list command's Build.
func buildList(_ Values) lawCommand { lawList }

// buildShow is the show command's Build.
func buildShow(_ Values) lawCommand { lawShow }

// commandName is the name of the command that built c.
func commandName(c lawCommand) string {
	match c {
	case lawList:
		"list"
	case lawShow:
		"show"
	}
}

let lawFirst = Arg("first", "the first")
let lawSecond = OptionalArg("second", "the second")

// lawArgsSet is lawSet with a required and an optional positional argument
// before the remaining ones.
func lawArgsSet() Set {
	Set{Name: "law", Usage: "", Flags: []Flag{lawText, lawNumber, lawSwitch}, Args: []ArgSpec{lawFirst, lawSecond, Remaining("rest", "the rest")}}
}

// sameReads reports whether a and b give the same value to each read of
// lawArgsSet: each flag's Get, each argument's Get and Rest. It reads
// through the handles, not through Render or Equal.
func sameReads(a Values, b Values) bool {
	lawText.Get(a) == lawText.Get(b) && lawNumber.Get(a) == lawNumber.Get(b) && lawSwitch.Get(a) == lawSwitch.Get(b) && sameArg(lawFirst.Get(a), lawFirst.Get(b)) && sameArg(lawSecond.Get(a), lawSecond.Get(b)) && sameStrings(Rest(a), Rest(b))
}

// RenderParseRoundTrip: what parses, rendered and parsed again, gives the
// same value to every read.
law RenderParseRoundTrip(args []string) {
	let v = Parse(lawArgsSet(), args) catch {
	case _:
		return true
	}
	sameReads(try Parse(lawArgsSet(), Render(v)), v)
}

// IndependentFlagsCommute: the order of two different flags does not
// matter.
law IndependentFlagsCommute(a string, n int) {
	let first = try Parse(lawSet(), []string{"-s=" + a, "-n=" + strconv.Itoa(n)})
	Equal(first, try Parse(lawSet(), []string{"-n=" + strconv.Itoa(n), "-s=" + a}))
}

// LastWins: of a repeated flag, the last value counts.
law LastWins(a string, b string) {
	let v = try Parse(lawSet(), []string{"-s", a, "-s", b})
	lawText.Get(v) == b
}

// DoubleDashEndsFlags: after "--", an argument that looks like a flag is
// positional.
law DoubleDashEndsFlags(x string) {
	let rest = Rest(try Parse(lawSet(), []string{"--", "-" + x}))
	len(rest) == 1 && rest[0] == "-"+x
}

// ShortAndLongAgree: -name and --name are one flag.
law ShortAndLongAgree(v string) {
	Equal(try Parse(lawSet(), []string{"-s=" + v}), try Parse(lawSet(), []string{"--s=" + v}))
}

// DefaultWhenAbsent: an absent flag has its default, and an absent
// required flag fails Missing with its name.
law DefaultWhenAbsent() {
	let v = try Parse(lawSet(), []string{})
	let required = Set{Name: "law", Usage: "", Flags: []Flag{lawText, lawRequired}, Args: []ArgSpec{}}
	Parse(required, []string{}) catch {
	case Missing as m:
		return m.Name == "r" && lawText.Get(v) == "d" && lawNumber.Get(v) == 0 && !lawSwitch.Get(v)
	case _:
		return false
	}
	false
}

// UnknownNamesTheFlag: a flag the set does not declare fails Unknown with
// its name.
law UnknownNamesTheFlag(name string) {
	if name == "" || name == "h" || name == "help" || name == "s" || name == "n" || name == "b" || strings.Contains(name, "=") || strings.HasPrefix(name, "-") {
		return true
	}
	Parse(lawSet(), []string{"-" + name}) catch {
	case Unknown as u:
		return u.Name == name
	case _:
		return false
	}
	false
}

// HelpNamesEveryFlag: the help has a line for each flag of the set.
law HelpNamesEveryFlag(names []string) {
	let mut flags = []Flag{}
	let mut seen Map[string, bool]
	for name in names {
		match seen.Get(name) {
		case Some[bool]:
		case None:
			seen[name] = true
			flags = flags.Append(String(name, "", "u"))
		}
	}
	let help = Usage(Set{Name: "law", Usage: "", Flags: flags, Args: []ArgSpec{}})
	for name in names {
		if !strings.Contains(help, "\n  -"+name+" string\n") {
			return false
		}
	}
	true
}

// EachCommandReaches: each command's name runs that command's Build.
law EachCommandReaches(i int) {
	let commands = lawCommands()
	if i < 0 || i >= len(commands) {
		return true
	}
	commandName(try ParseCommand("law", "", commands, []string{commands[i].Name})) == commands[i].Name
}

// lawRefused is the own failure of BuildFailureReaches's command.
type lawRefused { Text string }

// buildRefuse is a Build that fails with its own failure, carrying the
// value of -s.
func buildRefuse(v Values) lawCommand fails lawRefused {
	return lawRefused{Text: lawText.Get(v)}
}

// BuildFailureReaches: a Build's own failure reaches the caller of
// ParseCommand as it is, with its value.
law BuildFailureReaches(text string) {
	let commands = []Command[lawCommand, lawRefused]{Command[lawCommand, lawRefused]{Name: "refuse", Usage: "refuse", Set: lawSet(), Build: buildRefuse, Commands: []Command[lawCommand, lawRefused]{}}}
	ParseCommand("law", "", commands, []string{"refuse", "-s=" + text}) catch {
	case lawRefused as r:
		return r.Text == text
	case _:
		return false
	}
	false
}

// FlagCrossesPositional: a flag before or after a positional argument
// gives the same values (owner, 2026-11-06: flags may follow positional
// arguments).
law FlagCrossesPositional(p string, a string) {
	let before = try Parse(lawSet(), []string{"p" + p, "-s=" + a})
	Equal(before, try Parse(lawSet(), []string{"-s=" + a, "p" + p}))
}
