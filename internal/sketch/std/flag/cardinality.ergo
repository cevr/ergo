import slices
import strconv
import strings
import time

// Optional flags distinguish absence from an explicit empty string or zero.
type OptionalStringFlag { base StringFlag }
type OptionalIntFlag { base IntFlag }

// Repeated flags have no default. Get returns the occurrences in input order.
type RepeatedStringFlag { base StringFlag }
type RepeatedIntFlag { base IntFlag }
type RepeatedBoolFlag { base BoolFlag }
type RepeatedDurationFlag { base DurationFlag }
type RepeatedChoiceFlag { base ChoiceFlag }

func OptionalString(name string, usage string) OptionalStringFlag {
	OptionalStringFlag{base: String(name, "", usage)}
}

func OptionalInt(name string, usage string) OptionalIntFlag {
	OptionalIntFlag{base: Int(name, 0, usage)}
}

func Repeated(f StringFlag) RepeatedStringFlag     { RepeatedStringFlag{base: f} }

law RepeatedKeepsOrder(items []string) {
	let mut args = []string{}
	for item in items { args = args.Append("-i=" + item) }
	sameStrings(treeItems.Get(try Parse(treeSet(), args)), items)
}
func Repeated(f IntFlag) RepeatedIntFlag           { RepeatedIntFlag{base: f} }
func Repeated(f BoolFlag) RepeatedBoolFlag         { RepeatedBoolFlag{base: f} }
func Repeated(f DurationFlag) RepeatedDurationFlag { RepeatedDurationFlag{base: f} }
func Repeated(f ChoiceFlag) RepeatedChoiceFlag     { RepeatedChoiceFlag{base: f} }

// scalarFlag is a flag's element kind, independent of its cardinality.
type scalarFlag = StringFlag | IntFlag | BoolFlag | DurationFlag | ChoiceFlag

func scalar(f Flag) scalarFlag {
	match f {
	case StringFlag as s:
		s
	case IntFlag as n:
		n
	case BoolFlag as b:
		b
	case DurationFlag as d:
		d
	case ChoiceFlag as c:
		c
	case OptionalStringFlag as s:
		s.base
	case OptionalIntFlag as n:
		n.base
	case RepeatedStringFlag as s:
		s.base
	case RepeatedIntFlag as n:
		n.base
	case RepeatedBoolFlag as b:
		b.base
	case RepeatedDurationFlag as d:
		d.base
	case RepeatedChoiceFlag as c:
		c.base
	}
}

func cardinality(f Flag) int {
	match f {
	case OptionalStringFlag, OptionalIntFlag:
		1
	case RepeatedStringFlag, RepeatedIntFlag, RepeatedBoolFlag, RepeatedDurationFlag, RepeatedChoiceFlag:
		2
	case _:
		0
	}
}

func Get(f OptionalStringFlag, v Values) Option[string] {
	let s = v.slots[heldFlag(f, v)]
	if s.given == 0 {
		return None
	}
	Some[string]{Value: s.last.text}
}

func Get(f OptionalIntFlag, v Values) Option[int] {
	let s = v.slots[heldFlag(f, v)]
	if s.given == 0 {
		return None
	}
	Some[int]{Value: s.last.n}
}

// items is every occurrence of a repeated f in v, in input order.
func items(f Flag, v Values) []item { v.slots[heldFlag(f, v)].all }

func Get(f RepeatedStringFlag, v Values) []string {
	let xs = items(f, v)
	let mut out = slices.WithCapacity[string](len(xs))
	for x in xs {
		out = out.Append(x.text)
	}
	out
}

func Get(f RepeatedChoiceFlag, v Values) []string {
	let xs = items(f, v)
	let mut out = slices.WithCapacity[string](len(xs))
	for x in xs {
		out = out.Append(x.text)
	}
	out
}

func Get(f RepeatedIntFlag, v Values) []int {
	let xs = items(f, v)
	let mut out = slices.WithCapacity[int](len(xs))
	for x in xs {
		out = out.Append(x.n)
	}
	out
}

// RepeatedIntsKeepOrder: a repeated integer flag reads every integer the
// command line gave it, in input order, by its long name and its alias
// alike.
law RepeatedIntsKeepOrder(ns []int) {
	let counts = Int("count", 0, "a count").Repeated().WithAlias("c")
	let s = Set{Name: "law", Usage: "", Flags: []Flag{counts}, Args: []ArgSpec{}}
	let mut args = []string{}
	for i, n in ns {
		let spelling = if i % 2 == 0 { "-c=" } else { "--count=" }
		args = args.Append(spelling + strconv.Itoa(n))
	}
	let got = counts.Get(try Parse(s, args))
	if len(got) != len(ns) {
		return false
	}
	for i, n in ns {
		if got[i] != n {
			return false
		}
	}
	true
}

func Get(f RepeatedBoolFlag, v Values) []bool {
	let xs = items(f, v)
	let mut out = slices.WithCapacity[bool](len(xs))
	for x in xs {
		out = out.Append(x.b)
	}
	out
}

func Get(f RepeatedDurationFlag, v Values) []duration {
	let xs = items(f, v)
	let mut out = slices.WithCapacity[duration](len(xs))
	for x in xs {
		out = out.Append(x.d)
	}
	out
}

// ShortNamesMatchASCII compares alias admission with the ASCII alphanumeric
// spelling set, including raw non-ASCII bytes and trailing characters.
law ShortNamesMatchASCII(suffix string) {
	let ascii = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
	for i in 0..256 {
		let raw = strings.FromBytes([]byte{byte(i)})
		let want = strings.Contains(ascii, raw)
		let name = ParseShortName(raw) catch {
		case Unsatisfied:
			if want {
				return false
			}
			continue
		}
		if !want || string(name) != raw {
			return false
		}
	}
	rejectsShortName("") && rejectsShortName("a-" + suffix)
}

func rejectsShortName(raw string) bool {
	let _ = ParseShortName(raw) catch {
	case Unsatisfied:
		return true
	}
	false
}

// ShortName is one ASCII letter or digit. ParseShortName validates a
// computed string; a literal is checked at compile time.
type ShortName string where len(it) == 1 && matches(it, `[0-9A-Za-z]`)

// WithAlias replaces the previous alias with a checked short name.
func WithAlias(f StringFlag, a ShortName) StringFlag                     { StringFlag{..f, alias: string(a)} }
func WithAlias(f IntFlag, a ShortName) IntFlag                           { IntFlag{..f, alias: string(a)} }
func WithAlias(f BoolFlag, a ShortName) BoolFlag                         { BoolFlag{..f, alias: string(a)} }
func WithAlias(f DurationFlag, a ShortName) DurationFlag                 { DurationFlag{..f, alias: string(a)} }
func WithAlias(f ChoiceFlag, a ShortName) ChoiceFlag                     { ChoiceFlag{..f, alias: string(a)} }
func WithAlias(f OptionalStringFlag, a ShortName) OptionalStringFlag     { OptionalStringFlag{base: f.base.WithAlias(a)} }
func WithAlias(f OptionalIntFlag, a ShortName) OptionalIntFlag           { OptionalIntFlag{base: f.base.WithAlias(a)} }
func WithAlias(f RepeatedStringFlag, a ShortName) RepeatedStringFlag     { RepeatedStringFlag{base: f.base.WithAlias(a)} }
func WithAlias(f RepeatedIntFlag, a ShortName) RepeatedIntFlag           { RepeatedIntFlag{base: f.base.WithAlias(a)} }
func WithAlias(f RepeatedBoolFlag, a ShortName) RepeatedBoolFlag         { RepeatedBoolFlag{base: f.base.WithAlias(a)} }
func WithAlias(f RepeatedDurationFlag, a ShortName) RepeatedDurationFlag { RepeatedDurationFlag{base: f.base.WithAlias(a)} }
func WithAlias(f RepeatedChoiceFlag, a ShortName) RepeatedChoiceFlag     { RepeatedChoiceFlag{base: f.base.WithAlias(a)} }

func aliasOf(f Flag) string {
	match f {
	case StringFlag as s:
		s.alias
	case IntFlag as n:
		n.alias
	case BoolFlag as b:
		b.alias
	case DurationFlag as d:
		d.alias
	case ChoiceFlag as c:
		c.alias
	case OptionalStringFlag as s:
		s.base.alias
	case OptionalIntFlag as n:
		n.base.alias
	case RepeatedStringFlag as s:
		s.base.alias
	case RepeatedIntFlag as n:
		n.base.alias
	case RepeatedBoolFlag as b:
		b.base.alias
	case RepeatedDurationFlag as d:
		d.base.alias
	case RepeatedChoiceFlag as c:
		c.base.alias
	}
}

// stored is each value v keeps for f, as a value of f's kind: none when
// it was not given, its last for a scalar or optional flag, every
// occurrence for a repeated one.
func stored(f Flag, v Values) []value {
	let s = v.slots[heldFlag(f, v)]
	if s.given == 0 {
		return []value{}
	}
	if cardinality(f) == 2 {
		let mut out = slices.WithCapacity[value](len(s.all))
		for x in s.all {
			out = out.Append(valueOf(f, x))
		}
		return out
	}
	[]value{valueOf(f, s.last)}
}

// valueOf is x as a value of f's kind.
func valueOf(f Flag, x item) value {
	match f {
	case IntFlag, OptionalIntFlag, RepeatedIntFlag:
		intValue{V: x.n}
	case BoolFlag, RepeatedBoolFlag:
		boolValue{V: x.b}
	case DurationFlag, RepeatedDurationFlag:
		durationValue{V: x.d}
	case StringFlag, ChoiceFlag, OptionalStringFlag, RepeatedStringFlag, RepeatedChoiceFlag:
		textValue{V: x.text}
	}
}

func shownValue(x value) string {
	match x {
	case textValue as s:
		s.V
	case intValue as n:
		strconv.Itoa(n.V)
	case boolValue as b:
		strconv.FormatBool(b.V)
	case durationValue as d:
		time.DurationText(d.V)
	}
}
