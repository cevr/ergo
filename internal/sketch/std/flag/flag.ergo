// Package flag reads a command line (docs/spec/stdlib.md, flag). It takes
// Go's flag syntax and names (String, Int, Bool, "-name=value", "-name
// value", "--name", "--" ends the flags, the last scalar occurrence wins,
// Usage in PrintDefaults' layout) and Effect's typed commands
// (@effect/cli: Choice, required flags, positional arguments,
// subcommands that parse into the program's own union, a closed union of
// failures). As in @effect/cli (owner, 2026-11-06), flags may follow
// positional arguments until a bare "--", and -h, -help and --help print
// the help to standard output and end with status 0; a usage error goes
// to standard error with status 2.
//
// A flag's kind is its handle's type, so a read needs no assertion: Get of
// an IntFlag is an int. Each handle has unexported fields, so only this
// package builds one. The package is Ergo over strings and strconv: no
// runtime body and no compiler rule.

import io
import os
import strconv
import strings
import time

// StringFlag is the handle of a text flag.
type StringFlag { name string, def string, usage string, required bool, alias string }

// IntFlag is the handle of an integer flag. Its value is read as Go's
// strconv.ParseInt(s, 0, 64) reads it: 0x10, 0o17, 0b1 and 1_000 too.
type IntFlag { name string, def int, usage string, required bool, alias string }

// BoolFlag is the handle of a switch: -name is true, -name=false is false;
// a switch never takes the next argument as its value.
type BoolFlag { name string, def bool, usage string, alias string }

// DurationFlag is the handle of a duration flag. Its value is read as Go's
// time.ParseDuration reads it: 1h30m, 1.5s, 300ms (std-duration).
type DurationFlag { name string, def duration, usage string, alias string }

// ChoiceFlag is the handle of a text flag whose value is one of choices.
type ChoiceFlag { name string, def string, choices []string, usage string, alias string }

// Flag is any flag handle.
type Flag = StringFlag | IntFlag | BoolFlag | ChoiceFlag | DurationFlag | OptionalStringFlag | OptionalIntFlag | RepeatedStringFlag | RepeatedIntFlag | RepeatedBoolFlag | RepeatedDurationFlag | RepeatedChoiceFlag

// HelpNamesEveryFlag: the help has a line for each flag of the set.
law HelpNamesEveryFlag(names []string) {
	let mut flags = []Flag{}
	let mut seen Map[string, bool]
	for name in names {
		match seen.Get(name) {
		case Some[bool]:
		case None:
			seen[name] = true
			flags = flags.Append(String(name, "", "u"))
		}
	}
	let help = UsageText(Set{Name: "law", Usage: "", Flags: flags, Args: []ArgSpec{}})
	for name in names {
		if !strings.Contains(help, "\n  -"+name+" string\n") {
			return false
		}
	}
	true
}

// FlagCrossesPositional: a flag before or after a positional argument
// gives the same values (owner, 2026-11-06: flags may follow positional
// arguments).
law FlagCrossesPositional(p string, a string) {
	let before = try Parse(lawSet(), []string{"p" + p, "-s=" + a})
	Equal(before, try Parse(lawSet(), []string{"-s=" + a, "p" + p}))
}

// ArgSpec is the handle of a positional argument.
type ArgSpec { name string, usage string, arity arity }

// arity is how many positional arguments a spec takes.
type arity = one{} | optional{} | many{}

// Set is a command line's flags and positional arguments. Name and Usage
// head its help.
type Set { Name string, Usage string, Flags []Flag, Args []ArgSpec }

// Values is the result of a Parse: read it with each handle's Get.
// slots[i] is what the command line gave set.Flags[i], and args[i] the
// positional argument of set.Args[i]: a read finds its flag by position,
// with no map and no boxed value (FLAG-FLOOR).
type Values { set Set, slots []slot, args []slot, rest []string }

// slot is what a command line gave one flag or positional argument: given
// counts the occurrences; a scalar or optional flag keeps its last value
// in last, a repeated flag every occurrence in all, a positional argument
// its text in last.text. (A slot that also carried the flag's names and
// kind, read once per Parse, measured slower: FLAG-FLOOR round 1.)
type slot { given int, last item, all []item }

// noItem is the item of no value.
func noItem() item { item{text: "", n: 0, b: false, d: 0s} }

// item is one parsed value: the field of its flag's kind holds it.
type item { text string, n int, b bool, d duration }

// value is a flag's parsed value, as GivenFlags, Render and Equal read it.
type value = textValue{V string} | intValue{V int} | boolValue{V bool} | durationValue{V duration}

// String is a text flag with a default.
func String(name string, def string, usage string) StringFlag {
	StringFlag{name: name, def: def, usage: usage, required: false, alias: ""}
}

// Int is an integer flag with a default.
func Int(name string, def int, usage string) IntFlag {
	IntFlag{name: name, def: def, usage: usage, required: false, alias: ""}
}

// Bool is a switch with a default.
func Bool(name string, def bool, usage string) BoolFlag { BoolFlag{name: name, def: def, usage: usage, alias: ""} }

// RequiredString is a text flag with no default: a Parse without it fails
// Missing.
func RequiredString(name string, usage string) StringFlag {
	StringFlag{name: name, def: "", usage: usage, required: true, alias: ""}
}

// RequiredInt is an integer flag with no default: a Parse without it fails
// Missing.
func RequiredInt(name string, usage string) IntFlag {
	IntFlag{name: name, def: 0, usage: usage, required: true, alias: ""}
}

// Duration is a duration flag with a default: Go's flag.Duration.
func Duration(name string, def duration, usage string) DurationFlag {
	DurationFlag{name: name, def: def, usage: usage, alias: ""}
}

// Choice is a text flag whose value must be one of choices; def is its
// value when it is absent.
func Choice(name string, def string, choices []string, usage string) ChoiceFlag {
	ChoiceFlag{name: name, def: def, choices: choices, usage: usage, alias: ""}
}

// Arg is a positional argument that must be given.
func Arg(name string, usage string) ArgSpec { ArgSpec{name: name, usage: usage, arity: one} }

// OptionalArg is a positional argument that may be absent.
func OptionalArg(name string, usage string) ArgSpec { ArgSpec{name: name, usage: usage, arity: optional} }

// Remaining takes every positional argument the specs before it leave. It
// stands last.
func Remaining(name string, usage string) ArgSpec { ArgSpec{name: name, usage: usage, arity: many} }

// Get is the value of f: the last one given, or its default. A handle
// that is not a flag of v's set is a defect.
func Get(f StringFlag, v Values) string {
	let s = v.slots[f.held(v)]
	if s.given == 0 { f.def } else { s.last.text }
}

// Get is the value of f: the last one given, or its default. A handle
// that is not a flag of v's set is a defect.
func Get(f IntFlag, v Values) int {
	let s = v.slots[f.held(v)]
	if s.given == 0 { f.def } else { s.last.n }
}

// Get is the value of f: the last one given, or its default. A handle
// that is not a flag of v's set is a defect.
func Get(f BoolFlag, v Values) bool {
	let s = v.slots[f.held(v)]
	if s.given == 0 { f.def } else { s.last.b }
}

// Get is the value of f: the last one given, or its default. A handle
// that is not a flag of v's set is a defect.
func Get(f ChoiceFlag, v Values) string {
	let s = v.slots[f.held(v)]
	if s.given == 0 { f.def } else { s.last.text }
}

// Get is the value of f: the last one given, or its default. A handle
// that is not a flag of v's set is a defect.
func Get(f DurationFlag, v Values) duration {
	let s = v.slots[f.held(v)]
	if s.given == 0 { f.def } else { s.last.d }
}

// Get is the positional argument of a, or None when an optional one is
// absent.
func Get(a ArgSpec, v Values) Option[string] {
	for i, spec in v.set.Args {
		if spec.name == a.name {
			let s = v.args[i]
			if s.given == 0 {
				return None
			}
			return Some[string]{Value: s.last.text}
		}
	}
	None
}

// Require reads the positional argument. A Values that does not hold it
// fails Missing; a present empty string is still an argument.
func Require(a ArgSpec, v Values) string fails Missing {
	for i, spec in v.set.Args {
		if spec.name == a.name {
			if v.args[i].given > 0 {
				return v.args[i].last.text
			}
			break
		}
	}
	Missing{Name: a.name}
}

// position is the index of the flag of flags whose long name is name, or
// -1.
func position(flags []Flag, name string) int {
	for i, f in flags {
		if nameOf(f) == name {
			return i
		}
	}
	-1
}

// spelled is the index of the flag of flags that name spells, its long
// name or its alias, or -1.
func spelled(flags []Flag, name string) int {
	for i, f in flags {
		let (long, alias) = spellings(f)
		if long == name || alias != "" && alias == name {
			return i
		}
	}
	-1
}

// spellings is f's long name and its alias ("" when it has none), from
// one match of f: nameOf and aliasOf in one.
func spellings(f Flag) (string, string) {
	match f {
	case StringFlag as s:
		(s.name, s.alias)
	case IntFlag as n:
		(n.name, n.alias)
	case BoolFlag as b:
		(b.name, b.alias)
	case ChoiceFlag as c:
		(c.name, c.alias)
	case DurationFlag as d:
		(d.name, d.alias)
	case OptionalStringFlag as s:
		(s.base.name, s.base.alias)
	case OptionalIntFlag as n:
		(n.base.name, n.base.alias)
	case RepeatedStringFlag as s:
		(s.base.name, s.base.alias)
	case RepeatedIntFlag as n:
		(n.base.name, n.base.alias)
	case RepeatedBoolFlag as b:
		(b.base.name, b.base.alias)
	case RepeatedDurationFlag as d:
		(d.base.name, d.base.alias)
	case RepeatedChoiceFlag as c:
		(c.base.name, c.base.alias)
	}
}

// held is the position in v's set of f: the set's flag of f's name is f,
// of the same kind with the same default. A handle of another set, or of
// another kind under the name of one of the set's flags, is a defect. One
// function per kind, so f is compared as it is, never boxed as a Flag.
func held(f StringFlag, v Values) int {
	let i = position(v.set.Flags, f.name)
	if i >= 0 {
		match v.set.Flags[i] {
		case StringFlag as g:
			if g == f { return i }
		case _:
		}
	}
	len(notInSet(f.name))
}

func held(f IntFlag, v Values) int {
	let i = position(v.set.Flags, f.name)
	if i >= 0 {
		match v.set.Flags[i] {
		case IntFlag as g:
			if g == f { return i }
		case _:
		}
	}
	len(notInSet(f.name))
}

func held(f BoolFlag, v Values) int {
	let i = position(v.set.Flags, f.name)
	if i >= 0 {
		match v.set.Flags[i] {
		case BoolFlag as g:
			if g == f { return i }
		case _:
		}
	}
	len(notInSet(f.name))
}

func held(f DurationFlag, v Values) int {
	let i = position(v.set.Flags, f.name)
	if i >= 0 {
		match v.set.Flags[i] {
		case DurationFlag as g:
			if g == f { return i }
		case _:
		}
	}
	len(notInSet(f.name))
}

func held(f ChoiceFlag, v Values) int {
	let i = position(v.set.Flags, f.name)
	if i >= 0 {
		match v.set.Flags[i] {
		case ChoiceFlag as g:
			if sameChoice(g, f) { return i }
		case _:
		}
	}
	len(notInSet(f.name))
}

// sameChoice reports whether x and y are one Choice handle.
func sameChoice(x ChoiceFlag, y ChoiceFlag) bool {
	x.name == y.name && x.def == y.def && x.usage == y.usage && x.alias == y.alias && sameStrings(x.choices, y.choices)
}

// heldFlag is held for any handle: the position of f in v's set.
func heldFlag(f Flag, v Values) int {
	let name = nameOf(f)
	let i = position(v.set.Flags, name)
	if i >= 0 && sameHandle(v.set.Flags[i], f) {
		return i
	}
	len(notInSet(name))
}

// Rest is the positional arguments that the Remaining spec took.
func Rest(v Values) []string { v.rest }

// DoubleDashEndsFlags: after "--", an argument that looks like a flag is
// positional.
law DoubleDashEndsFlags(x string) {
	let rest = Rest(try Parse(lawSet(), []string{"--", "-" + x}))
	len(rest) == 1 && rest[0] == "-"+x
}

// Given is a flag the command line gave: its long name and the text of
// each occurrence it keeps, in input order (one for a scalar or optional
// flag, its last; every one for a repeated flag).
type Given { Name string, Texts []string }

// Declared is the long name of each flag of v's set, in declaration order.
func Declared(v Values) []string {
	let mut out = []string{}
	for f in v.set.Flags {
		out = out.Append(nameOf(f))
	}
	out
}

// GivenFlags is each flag of v's set that the command line gave, in
// declaration order. A flag left at its default is not given, so a layer
// over other sources (std config) takes a flag only when it was typed.
func GivenFlags(v Values) []Given {
	let mut out = []Given{}
	for f in v.set.Flags {
		let xs = stored(f, v)
		if len(xs) > 0 {
			let mut texts = []string{}
			for x in xs {
				texts = texts.Append(shownValue(x))
			}
			out = out.Append(Given{Name: nameOf(f), Texts: texts})
		}
	}
	out
}

// Render is a command line that parses to v again: each flag of v's set as
// -name=value in declaration order, then "--", then the positional
// arguments.
func Render(v Values) []string {
	let mut out = []string{}
	for f in v.set.Flags {
		if cardinality(f) == 0 {
			out = out.Append("-" + nameOf(f) + "=" + shown(f, v))
		} else {
			for x in stored(f, v) {
				out = out.Append("-" + nameOf(f) + "=" + shownValue(x))
			}
		}
	}
	out = out.Append("--")
	for a in v.set.Args {
		match a.Get(v) {
		case Some[string] as found:
			out = out.Append(found.Value)
		case None:
		}
	}
	for r in v.rest {
		out = out.Append(r)
	}
	out
}

// RenderParseRoundTrip: what parses, rendered and parsed again, gives the
// same value to every read.
law RenderParseRoundTrip(args []string) {
	let v = Parse(lawArgsSet(), args) catch {
	case _:
		return true
	}
	sameReads(try Parse(lawArgsSet(), Render(v)), v)
}

let lawText = String("s", "d", "a text")

let lawNumber = Int("n", 0, "a number")

let lawSwitch = Bool("b", false, "a switch")

let lawFirst = Arg("first", "the first")

let lawSecond = OptionalArg("second", "the second")

// lawArgsSet is lawSet with a required and an optional positional argument
// before the remaining ones.
func lawArgsSet() Set {
	Set{Name: "law", Usage: "", Flags: []Flag{lawText, lawNumber, lawSwitch}, Args: []ArgSpec{lawFirst, lawSecond, Remaining("rest", "the rest")}}
}

// sameReads reports whether a and b give the same value to each read of
// lawArgsSet: each flag's Get, each argument's Get and Rest. It reads
// through the handles, not through Render or Equal.
func sameReads(a Values, b Values) bool {
	lawText.Get(a) == lawText.Get(b) && lawNumber.Get(a) == lawNumber.Get(b) && lawSwitch.Get(a) == lawSwitch.Get(b) && sameArg(lawFirst.Get(a), lawFirst.Get(b)) && sameArg(lawSecond.Get(a), lawSecond.Get(b)) && sameStrings(Rest(a), Rest(b))
}

// Equal reports whether a and b have sets with the same flags and
// argument specs, and hold the same value for each flag and the same
// positional arguments. It reads each value with its handle's Get, not
// through Render.
func Equal(a Values, b Values) bool {
	if len(a.set.Flags) != len(b.set.Flags) || len(a.set.Args) != len(b.set.Args) {
		return false
	}
	for i, f in a.set.Flags {
		if !sameHandle(f, b.set.Flags[i]) || !sameValue(f, a, b) {
			return false
		}
	}
	for i, spec in a.set.Args {
		if spec.name != b.set.Args[i].name || !sameArg(spec.Get(a), b.set.Args[i].Get(b)) {
			return false
		}
	}
	sameStrings(a.rest, b.rest)
}

// ShortAndLongAgree: -name and --name are one flag.
law ShortAndLongAgree(v string) {
	Equal(try Parse(lawSet(), []string{"-s=" + v}), try Parse(lawSet(), []string{"--s=" + v}))
}

law DeclaredShortAndLongAgree(text string) {
	Equal(try Parse(treeSet(), []string{"-t=" + text}), try Parse(treeSet(), []string{"--text=" + text}))
}

// sameStrings reports whether x and y hold the same texts in order.
func sameStrings(x []string, y []string) bool {
	if len(x) != len(y) {
		return false
	}
	for i, s in x {
		if s != y[i] {
			return false
		}
	}
	true
}

// sameValue reports whether a and b hold one value for f.
func sameValue(f Flag, a Values, b Values) bool {
	if cardinality(f) != 0 {
		let x = stored(f, a)
		let y = stored(f, b)
		if len(x) != len(y) { return false }
		for i, v in x {
			if shownValue(v) != shownValue(y[i]) { return false }
		}
		return true
	}
	match f {
	case StringFlag as s:
		s.Get(a) == s.Get(b)
	case IntFlag as n:
		n.Get(a) == n.Get(b)
	case BoolFlag as x:
		x.Get(a) == x.Get(b)
	case ChoiceFlag as c:
		c.Get(a) == c.Get(b)
	case DurationFlag as d:
		d.Get(a) == d.Get(b)
	case _:
		Unreachable("flag: unknown cardinality")
	}
}

// sameArg reports whether two reads of a positional argument agree.
func sameArg(x Option[string], y Option[string]) bool {
	match x {
	case Some[string] as p:
		match y {
		case Some[string] as q:
			p.Value == q.Value
		case None:
			false
		}
	case None:
		match y {
		case Some[string]:
			false
		case None:
			true
		}
	}
}

// shown is the text of f's value in v, as Render writes it.
func shown(f Flag, v Values) string {
	match f {
	case StringFlag as s:
		s.Get(v)
	case IntFlag as n:
		strconv.Itoa(n.Get(v))
	case BoolFlag as b:
		strconv.FormatBool(b.Get(v))
	case ChoiceFlag as c:
		c.Get(v)
	case DurationFlag as d:
		time.DurationText(d.Get(v))
	case _:
		Unreachable("flag: a scalar value was required")
	}
}

// nameOf is f's name, read from its own variant: no re-wrap of f as a
// scalarFlag (FLAG-FLOOR: scalar's re-wrap was 17% of a command line).
func nameOf(f Flag) string {
	match f {
	case StringFlag as s:
		s.name
	case IntFlag as n:
		n.name
	case BoolFlag as b:
		b.name
	case ChoiceFlag as c:
		c.name
	case DurationFlag as d:
		d.name
	case OptionalStringFlag as s:
		s.base.name
	case OptionalIntFlag as n:
		n.base.name
	case RepeatedStringFlag as s:
		s.base.name
	case RepeatedIntFlag as n:
		n.base.name
	case RepeatedBoolFlag as b:
		b.base.name
	case RepeatedDurationFlag as d:
		d.base.name
	case RepeatedChoiceFlag as c:
		c.base.name
	}
}

// find is the flag of s named name.
func find(s Set, name string) Option[Flag] { findIn(s.Flags, name) }

// findIn is the flag of flags named name.
func findIn(flags []Flag, name string) Option[Flag] {
	let i = spelled(flags, name)
	if i < 0 {
		return None
	}
	Some[Flag]{Value: flags[i]}
}

// sameHandle reports whether a and b are one handle: the same kind, name,
// default, usage and, for a Choice, choices.
func sameHandle(a Flag, b Flag) bool {
	match a {
	case StringFlag as x:
		match b {
		case StringFlag as y:
			x == y
		case _:
			false
		}
	case IntFlag as x:
		match b {
		case IntFlag as y:
			x == y
		case _:
			false
		}
	case BoolFlag as x:
		match b {
		case BoolFlag as y:
			x == y
		case _:
			false
		}
	case DurationFlag as x:
		match b {
		case DurationFlag as y:
			x == y
		case _:
			false
		}
	case ChoiceFlag as x:
		match b {
		case ChoiceFlag as y:
			sameChoice(x, y)
		case _:
			false
		}
	case OptionalStringFlag as x:
		match b {
		case OptionalStringFlag as y:
			x.base == y.base
		case _:
			false
		}
	case OptionalIntFlag as x:
		match b {
		case OptionalIntFlag as y:
			x.base == y.base
		case _:
			false
		}
	case RepeatedStringFlag as x:
		match b {
		case RepeatedStringFlag as y:
			x.base == y.base
		case _:
			false
		}
	case RepeatedIntFlag as x:
		match b {
		case RepeatedIntFlag as y:
			x.base == y.base
		case _:
			false
		}
	case RepeatedBoolFlag as x:
		match b {
		case RepeatedBoolFlag as y:
			x.base == y.base
		case _:
			false
		}
	case RepeatedDurationFlag as x:
		match b {
		case RepeatedDurationFlag as y:
			x.base == y.base
		case _:
			false
		}
	case RepeatedChoiceFlag as x:
		match b {
		case RepeatedChoiceFlag as y:
			sameChoice(x.base, y.base)
		case _:
			false
		}
	}
}

// notInSet ends the program with a defect: a handle read from Values of a
// Set that does not hold it, or holds another kind under its name.
func notInSet(name string) string {
	Unreachable("flag -" + name + " is not a flag of the parsed set")
}

// The failures of a command line. Each one's text is Describe's.

// Help is a request for help (-h, -help or --help, when the set does not
// declare h or help): Text is the help. Exit prints it to standard output.
type Help { Text string }

// HelpWinsInEveryForm: -h, --h, -help and --help, bare or with "=…",
// fail Help wherever they stand before "--", after a flag whose value is
// any text ("--" too) and before an unknown flag.
law HelpWinsInEveryForm(k int, x string) {
	let forms = []string{"-h", "--h", "-help", "--help", "-h=" + x, "--help=" + x}
	let form = forms[((k%6)+6)%6]
	asksHelp([]string{"-s", x, form, "-q"}) && asksHelp([]string{"-s", "--", form, "-q"})
}

// asksHelp reports whether Parse of lawSet fails Help on args.
func asksHelp(args []string) bool {
	Parse(lawSet(), args) catch {
	case Help:
		return true
	case _:
		return false
	}
	false
}

// Unknown is a flag the set does not declare.
type Unknown { Name string }

// UnknownNamesTheFlag: a flag the set does not declare fails Unknown with
// its name.
law UnknownNamesTheFlag(name string) {
	if name == "" || name == "h" || name == "help" || name == "s" || name == "n" || name == "b" || strings.Contains(name, "=") || strings.HasPrefix(name, "-") {
		return true
	}
	Parse(lawSet(), []string{"-" + name}) catch {
	case Unknown as u:
		return u.Name == name
	case _:
		return false
	}
	false
}

// NeedsValue is a flag with no value: it was the last argument.
type NeedsValue { Name string }

// Invalid is a value the flag cannot take, or an argument that is not a
// flag's syntax (Name is empty then, and Text is the argument).
type Invalid { Name string, Text string, Reason string }

// Missing is a required flag or positional argument that is absent.
type Missing { Name string }

// Extra is a positional argument that no spec takes.
type Extra { Text string }

// UnknownCommand is a first argument that names no command of Known, or
// no argument where a command name is needed. Group is the path of group
// names from the root to the level that looked it up: empty at the root,
// ["auth"] for `tool auth bogus`.
type UnknownCommand { Name string, Known []string, Group []string }

// UnknownCommandNamesItsGroup: a word that names no child of a level with
// no own leaf, or no word, fails UnknownCommand with the word and the
// path of group names to that level.
law UnknownCommandNamesItsGroup(n int, word string) {
	let depth = treeDepth(n)
	let groups = treeGroupPath(depth)
	let name = if word == "read" || word == "group" || strings.HasPrefix(word, "-") { "" } else { word }
	let args = if name == "" { groups } else { groups.Append(name) }
	let _ = ParseCommand("tree", "", treeGroups(depth), args) catch {
	case UnknownCommand as u:
		return u.Name == name && sameStrings(u.Group, groups)
	case Help, Unknown, NeedsValue, Invalid, Missing, Extra:
		return false
	}
	false
}

// treeGroups is treeCommands with no level's own leaf.
func treeGroups(depth int) []Command[Values] {
	let leaf = Command[Values]{Name: "read", Usage: "read", Set: treeSet(), Build: treeBuild, Commands: []Command[Values]{}}
	if depth == 0 { return []Command[Values]{leaf} }
	[]Command[Values]{leaf, Group("group", "a group", treeGroups(depth-1))}
}

// Failure is every failure of Parse and ParseCommand.
type Failure = Help | Unknown | NeedsValue | Invalid | Missing | Extra | UnknownCommand

// Describe is the text of f, Go's where Go's flag has one.
func Describe(f Failure) string {
	match f {
	case Help:
		"flag: help requested"
	case Unknown as u:
		"flag provided but not defined: -" + u.Name
	case NeedsValue as n:
		"flag needs an argument: -" + n.Name
	case Invalid as i:
		if i.Name == "" {
			"bad flag syntax: " + i.Text
		} else {
			"invalid value " + strconv.Quote(i.Text) + " for flag -" + i.Name + ": " + i.Reason
		}
	case Missing as m:
		"missing required flag or argument: " + m.Name
	case Extra as e:
		"unexpected argument: " + e.Text
	case UnknownCommand as c:
		let at = if len(c.Group) == 0 { "" } else { " of " + strings.Join(c.Group, " ") }
		if c.Name == "" {
			"missing command" + at + "; commands: " + strings.Join(c.Known, ", ")
		} else {
			"unknown command " + strconv.Quote(c.Name) + at + "; commands: " + strings.Join(c.Known, ", ")
		}
	}
}

// Exit ends a command line's failure as Go's flag.ExitOnError and
// @effect/cli do: Help prints its text to standard output and returns, so
// main ends with status 0; any other failure fails os.Exit with status 2,
// whose message, Describe's text and then usage, the entry writes to
// standard error.
func Exit(f Failure, usage string) fails os.Exit needs io.Stdout {
	match f {
	case Help as h:
		io.Stdout.Print(h.Text)
	case _:
		return os.Exit{Code: 2, Message: Describe(f) + "\n" + strings.TrimSuffix(usage, "\n")}
	}
}
