import option
import slices
import strconv
import strings
import time

// Parse reads args against s. An argument is a flag when it starts with
// "-" and is longer than "-"; a flag is -name or --name, with its value
// after "=" or, for a flag that is not a switch, in the next argument.
// Flags and positional arguments may interleave; a bare "--" ends the
// flags, and every argument after it is positional. A scalar or optional
// flag keeps its last value; a Repeated handle keeps every occurrence.
// Then each required flag must be given, and the
// positional arguments go to the specs of s.Args in order. A request for
// help wins over every other failure, wherever it stands before "--", as
// in @effect/cli (helpAsked).
func Parse(s Set, args []string) Values fails Help | Unknown | NeedsValue | Invalid | Missing | Extra {
	validateFlags(s.Flags)
	if mayAskHelp(args) && helpAsked(s, args) {
		return Help{Text: UsageText(s)}
	}
	let none = slot{given: 0, last: noItem(), all: []item{}}
	let mut slots = slices.WithCapacity[slot](s.Flags.Len())
	for _ in s.Flags {
		slots = slots.Append(none)
	}
	let mut positional = slices.WithCapacity[string](args.Len())
	let mut open = true
	let mut i = 0
	for i < args.Len() {
		let arg = args[i]
		i += 1
		if !open || arg.Len() < 2 || !strings.HasPrefix(arg, "-") {
			positional = positional.Append(arg)
			continue
		}
		if arg == "--" {
			open = false
			continue
		}
		let body = if strings.HasPrefix(arg, "--") { strings.Slice(arg, 2, arg.Len()) } else { strings.Slice(arg, 1, arg.Len()) }
		if body == "" || strings.HasPrefix(body, "-") || strings.HasPrefix(body, "=") {
			return Invalid{Name: "", Text: arg, Reason: "bad flag syntax"}
		}
		let mut name = body
		let mut given = ""
		let mut hasValue = false
		let eq = strings.Index(body, "=")
		if eq > 0 {
			name = strings.Slice(body, 0, eq)
			given = strings.Slice(body, eq+1, body.Len())
			hasValue = true
		}
		let at = spelled(s.Flags, name)
		if at < 0 {
			return Unknown{Name: name}
		}
		let f = s.Flags[at]
		let mut x = noItem()
		if isSwitch(f) {
			if hasValue {
				let b = strconv.ParseBool(given) catch {
				case strconv.Malformed:
					return Invalid{Name: name, Text: given, Reason: "parse error"}
				}
				x = item{..x, b: b}
			} else {
				x = item{..x, b: true}
			}
		} else {
			if !hasValue {
				if i >= args.Len() {
					return NeedsValue{Name: name}
				}
				given = args[i]
				i += 1
			}
			x = try read(f, name, given)
		}
		slots[at].given += 1
		slots[at].last = x
		if cardinality(f) == 2 {
			slots[at].all = slots[at].all.Append(x)
		}
	}
	for j, f in s.Flags {
		if slots[j].given == 0 && isRequired(f) {
			return Missing{Name: nameOf(f)}
		}
	}
	let mut named = slices.WithCapacity[slot](s.Args.Len())
	let mut rest = []string{}
	let mut next = 0
	for a in s.Args {
		match a.arity {
		case one:
			if next >= positional.Len() {
				return Missing{Name: a.name}
			}
			named = named.Append(slot{..none, given: 1, last: item{..none.last, text: positional[next]}})
			next += 1
		case optional:
			if next < positional.Len() {
				named = named.Append(slot{..none, given: 1, last: item{..none.last, text: positional[next]}})
				next += 1
			} else {
				named = named.Append(none)
			}
		case many:
			named = named.Append(none)
			rest = slices.Slice(positional, next, positional.Len())
			next = positional.Len()
		}
	}
	if next < positional.Len() {
		return Extra{Text: positional[next]}
	}
	Values{set: s, slots: slots, args: named, rest: rest}
}

// IndependentFlagsCommute: the order of two different flags does not
// matter.
law IndependentFlagsCommute(a string, n int) {
	let first = try Parse(lawSet(), []string{"-s=" + a, "-n=" + strconv.Itoa(n)})
	Equal(first, try Parse(lawSet(), []string{"-n=" + strconv.Itoa(n), "-s=" + a}))
}

// lawSet is the set the laws parse with.
func lawSet() Set {
	Set{Name: "law", Usage: "", Flags: []Flag{lawText, lawNumber, lawSwitch}, Args: []ArgSpec{Remaining("rest", "the rest")}}
}

// LastWins: of a repeated flag, the last value counts.
law LastWins(a string, b string) {
	let v = try Parse(lawSet(), []string{"-s", a, "-s", b})
	lawText.Get(v) == b
}

// DefaultWhenAbsent: an absent flag has its default, and an absent
// required flag fails Missing with its name.
law DefaultWhenAbsent() {
	let v = try Parse(lawSet(), []string{})
	let required = Set{Name: "law", Usage: "", Flags: []Flag{lawText, lawRequired}, Args: []ArgSpec{}}
	Parse(required, []string{}) catch {
	case Missing as m:
		return m.Name == "r" && lawText.Get(v) == "d" && lawNumber.Get(v) == 0 && !lawSwitch.Get(v)
	case _:
		return false
	}
	false
}

let lawRequired = RequiredString("r", "a required text")

law AbsentIsNone() {
	let v = try Parse(treeSet(), []string{})
	treeText.Get(v) == option.None && treeNumber.Get(v) == option.None
}

// mayAskHelp reports whether an argument could ask for help: -h, -help,
// --h or --help, with or without "=…". It reads no flag of the set, so
// most command lines skip helpAsked's second pass (FLAG-FLOOR); helpAsked
// can only answer true at such an argument. It looks past "--", which
// may be a flag's value (HelpWinsInEveryForm).
func mayAskHelp(args []string) bool {
	for arg in args {
		let body = if strings.HasPrefix(arg, "--") { strings.Slice(arg, 2, arg.Len()) } else if strings.HasPrefix(arg, "-") { strings.Slice(arg, 1, arg.Len()) } else { "" }
		if body == "h" || body == "help" || strings.HasPrefix(body, "h=") || strings.HasPrefix(body, "help=") {
			return true
		}
	}
	false
}

// isSwitch reports whether f is a switch, which never takes the next
// argument as its value.
func isSwitch(f Flag) bool {
	match f {
	case BoolFlag, RepeatedBoolFlag:
		true
	case _:
		false
	}
}

// helpAsked reports whether args ask for help: -h, -help or --help (or
// -h=x), when s does not declare that name, as a flag before "--" and not
// as the value of a flag. It reads the arguments as Parse does, but does
// not stop at a failure, so help wins over an Unknown, Invalid or other
// failure before or after it (@effect/cli Command.runWith reads its
// global --help from every argument before it reports a parse error).
func helpAsked(s Set, args []string) bool {
	let mut i = 0
	for i < args.Len() {
		let arg = args[i]
		i += 1
		if arg == "--" {
			return false
		}
		if arg.Len() < 2 || !strings.HasPrefix(arg, "-") {
			continue
		}
		let body = if strings.HasPrefix(arg, "--") { strings.Slice(arg, 2, arg.Len()) } else { strings.Slice(arg, 1, arg.Len()) }
		let eq = strings.Index(body, "=")
		let name = if eq > 0 { strings.Slice(body, 0, eq) } else { body }
		let at = spelled(s.Flags, name)
		if at < 0 {
			if name == "h" || name == "help" {
				return true
			}
		} else if !isSwitch(s.Flags[at]) && eq <= 0 {
			i += 1
		}
	}
	false
}

// read is the value of a flag that takes one, from its text: the field
// of its kind set in an item.
func read(f Flag, name string, given string) item fails Invalid {
	match f {
	case IntFlag, OptionalIntFlag, RepeatedIntFlag:
		let n = strconv.ParseInt(given, 0, 64) catch {
		case strconv.Malformed:
			return Invalid{Name: name, Text: given, Reason: "parse error"}
		case strconv.OutOfRange:
			return Invalid{Name: name, Text: given, Reason: "value out of range"}
		}
		item{text: "", n: int(n), b: false, d: 0s}
	case DurationFlag, RepeatedDurationFlag:
		let d = time.ParseDuration(given) catch {
		case time.ParseError:
			return Invalid{Name: name, Text: given, Reason: "parse error"}
		}
		item{text: "", n: 0, b: false, d: d}
	case ChoiceFlag as c:
		try chosen(c, name, given)
	case RepeatedChoiceFlag as c:
		try chosen(c.base, name, given)
	case StringFlag, OptionalStringFlag, RepeatedStringFlag, BoolFlag, RepeatedBoolFlag:
		item{text: given, n: 0, b: false, d: 0s}
	}
}

// chosen is given as the value of the Choice c, when it is one of its
// choices. The failure's text is built only on a failure.
func chosen(c ChoiceFlag, name string, given string) item fails Invalid {
	for choice in c.choices {
		if choice == given {
			return item{text: given, n: 0, b: false, d: 0s}
		}
	}
	Invalid{Name: name, Text: given, Reason: "not one of " + strings.Join(c.choices, ", ")}
}

// isRequired reports whether f has no default.
func isRequired(f Flag) bool {
	match f {
	case StringFlag as s:
		s.required
	case IntFlag as n:
		n.required
	case _:
		false
	}
}

// A spelling denotes one handle. Declaration errors are defects, not bad
// user input. Check before help too, so help cannot hide an ambiguous set.
func validateFlags(flags []Flag) {
	match doubled(flags) {
	case option.Some[string] as d:
		Unreachable("flag: a flag spelling is declared twice: " + d.Value)
	case option.None:
	}
}

// doubled is the first spelling (a long name or an alias) that flags
// declare twice, or None. Each spelling is compared with those before it:
// no map is built for the few flags of a command line (FLAG-FLOOR).
func doubled(flags []Flag) option.Option[string] {
	for i, f in flags {
		let (name, alias) = spellings(f)
		if alias != "" && alias == name {
			return option.Some[string]{Value: name}
		}
		for j in 0..i {
			let (gn, ga) = spellings(flags[j])
			if name == gn || name == ga && ga != "" {
				return option.Some[string]{Value: name}
			}
			if alias != "" && (alias == gn || alias == ga) {
				return option.Some[string]{Value: alias}
			}
		}
	}
	option.None
}

// DoubledSpellingIsFound: doubled finds a spelling exactly when one is
// declared twice, by long name or alias, and the one it names is declared
// twice. The spellings come from a small alphabet so that they collide.
law DoubledSpellingIsFound(picks []int) {
	let longs = []string{"a", "b", "ab", "c"}
	let shorts = []option.Option[ShortName]{option.None, option.Some[ShortName]{Value: "a"}, option.Some[ShortName]{Value: "b"}, option.Some[ShortName]{Value: "c"}}
	let mut flags = []Flag{}
	let mut all = []string{}
	for p in picks {
		let k = if p < 0 { -(p + 1) } else { p }
		let long = longs[k%4]
		all = all.Append(long)
		match shorts[(k/4)%4] {
		case option.None:
			flags = flags.Append(String(long, "", "u"))
		case option.Some[ShortName] as short:
			flags = flags.Append(String(long, "", "u").WithAlias(short.Value))
			all = all.Append(string(short.Value))
		}
	}
	match doubled(flags) {
	case option.Some[string] as d:
		occurrences(all, d.Value) >= 2
	case option.None:
		for s in all {
			if occurrences(all, s) >= 2 {
				return false
			}
		}
		true
	}
}

// occurrences is how many times s is in xs.
func occurrences(xs []string, s string) int {
	let mut n = 0
	for x in xs {
		if x == s {
			n += 1
		}
	}
	n
}
