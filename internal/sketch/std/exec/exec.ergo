// Package exec runs programs of the host (docs/spec/stdlib.md, exec;
// Effect's ChildProcess, Go's os/exec). A Command is a value: New makes one
// and WithEnv, WithDir and WithStdin give changed copies. Runner is the
// capability that runs one to its end. Host is the host's provider of it:
// it has an unexported field, so only this package builds one (S114), and
// NewHost, its one constructor, needs the prelude's Ambient, which only
// the entry provides. So main lists Ambient and binds
// `context { exec.Runner: exec.NewHost() }`. A test cannot get Ambient and
// binds a Script instead, which runs nothing and gives the Result recorded
// for each command. The extern is unexported, so a program starts a
// process only through a Host it was given or made under Ambient.

import slices
import strings

// NotFound is the failure of a program Name that is not on the PATH, or of
// a path Name with no file at it.
type NotFound { Name string }

// Denied is the failure of a file Name that the process may not run.
type Denied { Name string }

// Failed is any other failure to start the program Name, such as a
// working directory that does not exist. Reason is the host's text for it.
type Failed { Name string, Reason string }

// Result is what a program that ran gives back: its exit status and all
// it wrote to standard output and standard error. A status that is not 0
// is a Result, not a failure, so a caller matches on it. A program that a
// signal ended has the status 128 plus the signal's number, as a shell
// reports it.
type Result { Status int, Stdout string, Stderr string }

// Command is one program to run: the program Name (a name looked up on
// the PATH, or a path), its arguments after the name, the environment
// entries set over the host process's environment, the working directory
// ("" is the caller's), the text its standard input reads, and the Grace
// a stop gives it: SIGTERM to its process group, then SIGKILL when it has
// not ended within Grace. A Grace of 0 sends SIGKILL at once.
type Command {
	Name  string,
	Args  []string,
	Env   Map[string, string],
	Dir   string,
	Stdin string,
	Grace duration,
}

// New is the command that runs name with args, in the caller's working
// directory, with the host process's environment, an empty standard input
// and no grace.
func New(name string, args []string) Command {
	Command{Name: name, Args: args, Env: Map[string, string]{}, Dir: "", Stdin: "", Grace: 0s}
}

// WithGrace is c with the grace d: a stop, a timeout or the release of its
// Running sends SIGTERM to the program's group and SIGKILL only when the
// program has not ended d later.
func WithGrace(c Command, d duration) Command { Command{..c, Grace: d} }

// WithEnv is c with the environment entry key set to value, over any entry
// of key that c sets. c itself is unchanged: the copy has its own Env.
func WithEnv(c Command, key string, value string) Command {
	let mut env = Map[string, string]{}
	for k, v in c.Env {
		env[k] = v
	}
	env[key] = value
	Command{..c, Env: env}
}

// WithDir is c run in the working directory dir.
func WithDir(c Command, dir string) Command { Command{..c, Dir: dir} }

// WithStdin is c with text as the whole of its standard input.
func WithStdin(c Command, text string) Command { Command{..c, Stdin: text} }

// Key is the text that names c's program and arguments: the name and each
// argument, with a NUL byte before each argument. No name or argument of a
// program holds a NUL byte (the host refuses one), so two commands have one
// Key exactly when their names and arguments are equal.
func Key(c Command) string {
	let mut parts = slices.WithCapacity[string](len(c.Args) + 1)
	parts = parts.Append(c.Name)
	for a in c.Args {
		parts = parts.Append(a)
	}
	strings.Join(parts, "\x00")
}

// WithEnvOverrides: a second entry of one key wins.
law WithEnvOverrides(key string, first string, second string) {
	let c = New("x", []string{}).WithEnv(key, first).WithEnv(key, second)
	c.Env.Get(key) == Some[string]{Value: second}
}

// WithEnvKeepsTheOriginal: WithEnv changes a copy, never the command it is
// given.
law WithEnvKeepsTheOriginal(key string, first string, second string) {
	let c = New("x", []string{}).WithEnv(key, first)
	let d = c.WithEnv(key, second)
	c.Env.Get(key) == Some[string]{Value: first} && d.Env.Get(key) == Some[string]{Value: second}
}

// Split is the lines of text as Lines gives them: each without its line
// feed, and a last line with no line feed included. Empty text has none.
func Split(text string) []string {
	if text == "" {
		return []string{}
	}
	let parts = strings.Split(text, "\n")
	if strings.HasSuffix(text, "\n") {
		return slices.Slice(parts, 0, len(parts)-1)
	}
	parts
}

// Inherit is a sink: the program writes to the stream of this process.
type Inherit {}

// Discard is a sink: the program writes to the null device.
type Discard {}

// ToFile is a sink: the program writes to the file at Path, created when
// missing, emptied first unless Append. The bytes reach the file as the
// program writes them: the file is the program's own stream.
type ToFile { Path string, Append bool }

// ToCaller is a sink: the caller reads the program's bytes from Chunks,
// or its lines from Lines, as they come.
type ToCaller {}

// Sink is where a stream of a started program goes.
type Sink = Inherit | Discard | ToFile | ToCaller

// Streams are the sinks of a started program's standard output and
// standard error.
type Streams { Stdout Sink, Stderr Sink }

// Line is one line of a stream whose sink is ToCaller, without its line
// feed, and whether it came from standard error.
type Line { Text string, Stderr bool }

// Chunk is what one read of a stream whose sink is ToCaller gave: its
// bytes as the program wrote them (any bytes, line feeds included), and
// whether it came from standard error. A Chunk with no bytes is the end of
// its stream. Where a stream is cut into chunks is not a promise: only the
// bytes of each stream, in their order, are.
type Chunk { Text string, Stderr bool }

// Running is a started program. It is a resource: the scope that owns it
// ends the program when it ends (SIGTERM to the program's process group,
// the command's Grace, then SIGKILL), reaps it and waits until no process
// of its group is left, on every exit, a stop and a timeout included.
//
// law-exempt: the lifecycle is a property against a model over a fake
// process (runtime/v1 TestRunningMatchesModel); a real program's streams
// are TestExecStreams.
type Running {
	// Lines gives the lines of the streams whose sink is ToCaller, each
	// without its line feed, in the order their line feeds come, until both
	// end; a last line with no line feed comes at its stream's end. It
	// reads the chunks Chunks gives, so a caller may mix the two. A break
	// or a stop leaves the bytes read and not given for the next Lines or
	// Chunks; after Wait it gives none.
	// seq-exempt: Running is law-exempt (its lines come from a program, which a law cannot generate); TestRunningMatchesModel (runtime/v1) holds Lines over chunks cut anywhere, a break and the bytes it leaves for Chunks, and the stop of a reader against its model, and lower TestExecStartRuns a break on the host (a follower).
	Lines() Seq[Line],
	// Chunks gives the bytes of the streams whose sink is ToCaller as they
	// are read, with no wait for a line feed, each stream's in its order,
	// then an empty Chunk at each stream's end, until both end. A full
	// buffer of 64 chunks makes the program wait in its write, so the
	// caller's reading paces it. A tee is the caller's loop: write each
	// Chunk where it goes and keep it. A break leaves the rest for the next
	// Chunks; after Wait it gives none.
	// seq-exempt: Running is law-exempt (its bytes come from a program, which a law cannot generate); TestRunningMatchesModel (runtime/v1) holds the bytes of each stream as they come and at the end, a break and the stop of a reader against its model, and lower TestExecStartRuns a tee on the host.
	Chunks() Seq[Chunk],
	// Wait waits for the program's end and gives its status, 128 plus the
	// signal's number for a program a signal ended. It drops the bytes not
	// read yet. A stop of the caller ends the wait; the program then runs
	// until the owner's scope ends it.
	Wait() int,
	// Stop takes ownership, ends the group by the command's Grace rule,
	// reaps it and returns its actual status, as Wait does. Cleanup is
	// masked even when the caller has been stopped. Start outside a
	// timeout, Wait inside it, and Stop in its Expired catch to observe
	// the status after termination. Close is the scope-release form.
	Stop() int takes,
	Close(),
}

// Runner runs a program to its end, or starts it. A stop of the calling
// task ends the program and every process it started in its process
// group, and Run returns only after they are gone.
type Runner {
	Run(c Command) Result fails NotFound | Denied | Failed,

	// Start starts c with its streams going to s, and returns once it has
	// started. The caller owns the Running.
	Start(c Command, s Streams) Running fails NotFound | Denied | Failed,

	// StartAgreesWithRun: a started program whose streams go to the
	// caller gives the lines and the status Run gives.
	law StartAgreesWithRun(name string) {
		let c = New(name, []string{})
		let want = Run(c) catch {
		case NotFound, Denied, Failed:
			return true
		}
		let p = Start(c, Streams{Stdout: ToCaller, Stderr: ToCaller}) catch {
		case NotFound, Denied, Failed:
			return false
		}
		let mut out = []string{}
		let mut errs = []string{}
		for l in p.Lines() {
			if l.Stderr {
				errs = errs.Append(l.Text)
			} else {
				out = out.Append(l.Text)
			}
		}
		slices.Equal(out, Split(want.Stdout)) && slices.Equal(errs, Split(want.Stderr)) && p.Wait() == want.Status
	},

	// NotFoundNamesTheProgram: a program that is not found is named by its
	// failure.
	law NotFoundNamesTheProgram(name string) {
		Run(New(name, []string{})) catch {
		case NotFound as n:
			return n.Name == name
		case Denied, Failed:
			return true
		}
		true
	},
}

// Script is a Runner for tests. It runs nothing: Run gives the Result that
// Results holds at the command's Key, and fails NotFound when it holds
// none. The environment, the directory and the standard input are not in
// the Key.
type Script { Results Map[string, Result] }

// Run is the Result recorded for c, or NotFound.
func Run(s Script, c Command) Result fails NotFound | Denied | Failed {
	match s.Results.Get(Key(c)) {
	case Some[Result] as hit:
		return hit.Value
	case None:
		return NotFound{Name: c.Name}
	}
}

// Start is a Running that replays the Result recorded for c: Chunks gives
// its Stdout, then its Stderr, each when its sink is ToCaller (so Lines
// gives the lines of each), and Wait its Status. It writes nothing to a
// file or a stream of this process. It fails NotFound when Results holds
// no Result for c.
func Start(s Script, c Command, st Streams) Running fails NotFound | Denied | Failed {
	match s.Results.Get(Key(c)) {
	case Some[Result] as hit:
		let mut cs = []Chunk{}
		if toCaller(st.Stdout) {
			cs = whole(cs, hit.Value.Stdout, false)
		}
		if toCaller(st.Stderr) {
			cs = whole(cs, hit.Value.Stderr, true)
		}
		return replay(cs, hit.Value.Status, toCaller(st.Stdout) || toCaller(st.Stderr))
	case None:
		return NotFound{Name: c.Name}
	}
}

// whole is cs with the stream text as one Chunk, when it is not empty, and
// then the stream's end.
func whole(cs []Chunk, text string, stderr bool) []Chunk {
	let mut out = cs
	if text != "" {
		out = out.Append(Chunk{Text: text, Stderr: stderr})
	}
	out.Append(Chunk{Text: "", Stderr: stderr})
}

func toCaller(s Sink) bool {
	match s {
	case ToCaller:
		true
	case Inherit, Discard, ToFile:
		false
	}
}

extern go ergo.local/prototype/runtime/v1.ExecReplay func replay(cs []Chunk, status int, caller bool) Running

// ScriptReplaysRecorded: a Script gives back the Result recorded for a
// command, whatever its status, and two commands whose arguments differ
// never share a record: the arguments arg, arg and the one argument
// arg + "," + arg each get their own.
law ScriptReplaysRecorded(name string, arg string, status int, out string) {
	let c = New(name, []string{arg, arg})
	let joined = New(name, []string{arg + "," + arg})
	let mut results = Map[string, Result]{}
	results[Key(c)] = Result{Status: status, Stdout: out, Stderr: ""}
	results[Key(joined)] = Result{Status: status + 1, Stdout: out, Stderr: ""}
	let r = Script{Results: results}.Run(c) catch {
	case NotFound, Denied, Failed:
		return false
	}
	let s = Script{Results: results}.Run(joined) catch {
	case NotFound, Denied, Failed:
		return false
	}
	r.Status == status && r.Stdout == out && r.Stderr == "" && s.Status == status+1
}

// Host is the host's Runner. Its field gives this package the construction
// authority (types.md, Zero values 6): no other package writes exec.Host{},
// its zero value or a record update of it.
type Host { live hostOnly }

// hostOnly is the zero-size type of Host's field, so Host stays zero size.
type hostOnly {}

// NewHost is the host's Runner. It needs Ambient: only code whose row
// holds the authority to choose the host makes one.
func NewHost() Host needs Ambient { Host{live: hostOnly} }

// Run runs c to its end on the host. The program starts in a process group
// of its own; Run returns after it exits and is reaped, with all its
// output. A stop of the calling task kills the group, waits for the reap
// and ends the call.
func Run(_ Host, c Command) Result fails NotFound | Denied | Failed {
	try hostRun(c.Name, c.Args, c.Env, c.Dir, c.Stdin, c.Grace)
}

extern go ergo.local/prototype/runtime/v1.ExecRun func hostRun(name string, args []string, env Map[string, string], dir string, stdin string, grace duration) Result fails NotFound | Denied | Failed

// Start starts c on the host, in a process group of its own, with its
// standard output and standard error going to s's sinks. A file sink that
// cannot be opened fails Failed and starts nothing.
func Start(_ Host, c Command, s Streams) Running fails NotFound | Denied | Failed {
	try hostStart(c.Name, c.Args, c.Env, c.Dir, c.Stdin, c.Grace, sinkKind(s.Stdout), sinkPath(s.Stdout), sinkAppends(s.Stdout), sinkKind(s.Stderr), sinkPath(s.Stderr), sinkAppends(s.Stderr))
}

// sinkKind is the runtime's number of a sink (runtime/v1 exec_start.go).
func sinkKind(s Sink) int {
	match s {
	case Inherit:
		0
	case Discard:
		1
	case ToFile:
		2
	case ToCaller:
		3
	}
}

func sinkPath(s Sink) string {
	match s {
	case ToFile as f:
		f.Path
	case Inherit, Discard, ToCaller:
		""
	}
}

func sinkAppends(s Sink) bool {
	match s {
	case ToFile as f:
		f.Append
	case Inherit, Discard, ToCaller:
		false
	}
}

extern go ergo.local/prototype/runtime/v1.ExecStart func hostStart(name string, args []string, env Map[string, string], dir string, stdin string, grace duration, outKind int, outPath string, outAppend bool, errKind int, errPath string, errAppend bool) Running fails NotFound | Denied | Failed
