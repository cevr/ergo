// Package exec runs programs of the host (docs/spec/stdlib.md, exec;
// Effect's ChildProcess, Go's os/exec). A Command is a value: New makes one
// and WithEnv, WithDir and WithStdin give changed copies. Runner is the
// capability that runs one to its end. Host is the host's provider of it:
// it has an unexported field, so only this package builds one (S114), and
// NewHost, its one constructor, needs the prelude's Ambient, which only
// the entry provides. So main lists Ambient and binds
// `context { exec.Runner: exec.NewHost() }`. A test cannot get Ambient and
// binds a Script instead, which runs nothing and gives the Result recorded
// for each command, or runs commands for real in a folder of its case's
// own through NewTestHost, under the test's ambient (confined.ergo). The
// extern is unexported, so a program starts a
// process only through a Host it was given or made under Ambient.

import slices
import strconv
import strings
import time
import sync
import timeout

// NotFound is the failure of a program Name that is not on the PATH, or of
// a path Name with no file at it.
extern go ergo.local/prototype/runtime/v1/exec.ExecNotFound type NotFound { Name string }

// Denied is the failure of a file Name that the process may not run.
extern go ergo.local/prototype/runtime/v1/exec.ExecDenied type Denied { Name string }

// Failed is any other failure to start the program Name, such as a
// working directory that does not exist. Reason is the host's text for it.
extern go ergo.local/prototype/runtime/v1/exec.ExecFailed type Failed { Name string, Reason string }

// Result is what a program that ran gives back: its exit status and all
// it wrote to standard output and standard error. A status that is not 0
// is a Result, not a failure, so a caller matches on it. A program that a
// signal ended has the status 128 plus the signal's number, as a shell
// reports it.
extern go ergo.local/prototype/runtime/v1/exec.ExecResult type Result { Status int, Stdout string, Stderr string }

// Command is one program to run: the program Name (a name looked up on
// the PATH, or a path), its arguments after the name, the environment
// entries set over the host process's environment, the working directory
// ("" is the caller's), the text its standard input reads, and the Grace
// a stop gives it: SIGTERM to its process group, then SIGKILL when it has
// not ended within Grace. A Grace of 0 sends SIGKILL at once.
type Command {
	Name  string,
	Args  []string,
	Env   Map[string, string],
	Dir   string,
	Stdin string,
	Grace duration,
}

// New is the command that runs name with args, in the caller's working
// directory, with the host process's environment, an empty standard input
// and no grace.
func New(name string, args []string) Command {
	Command{Name: name, Args: args, Env: Map[string, string]{}, Dir: "", Stdin: "", Grace: 0s}
}

// WithGrace is c with the grace d: a stop, a timeout or the release of its
// Running sends SIGTERM to the program's group and SIGKILL only when the
// program has not ended d later.
func WithGrace(c Command, d duration) Command { Command{..c, Grace: d} }

// WithEnv is c with the environment entry key set to value, over any entry
// of key that c sets. c itself is unchanged: the copy has its own Env.
func WithEnv(c Command, key string, value string) Command {
	let mut env = Map[string, string]{}
	for k, v in c.Env {
		env[k] = v
	}
	env[key] = value
	Command{..c, Env: env}
}

// WithDir is c run in the working directory dir.
func WithDir(c Command, dir string) Command { Command{..c, Dir: dir} }

// WithStdin is c with text as the whole of its standard input.
func WithStdin(c Command, text string) Command { Command{..c, Stdin: text} }

// Key is the text that names c's program and arguments: the name and each
// argument, with a NUL byte before each argument. No name or argument of a
// program holds a NUL byte (the host refuses one), so two commands have one
// Key exactly when their names and arguments are equal.
func Key(c Command) string {
	let mut parts = slices.WithCapacity[string](len(c.Args) + 1)
	parts = parts.Append(c.Name)
	for a in c.Args {
		parts = parts.Append(a)
	}
	strings.Join(parts, "\x00")
}

// WithEnvOverrides: a second entry of one key wins.
law WithEnvOverrides(key string, first string, second string) {
	let c = New("x", []string{}).WithEnv(key, first).WithEnv(key, second)
	c.Env.Get(key) == Some[string]{Value: second}
}

// WithEnvKeepsTheOriginal: WithEnv changes a copy, never the command it is
// given.
law WithEnvKeepsTheOriginal(key string, first string, second string) {
	let c = New("x", []string{}).WithEnv(key, first)
	let d = c.WithEnv(key, second)
	c.Env.Get(key) == Some[string]{Value: first} && d.Env.Get(key) == Some[string]{Value: second}
}

// Split is the lines of text as Lines gives them: each without its line
// feed, and a last line with no line feed included. Empty text has none.
func Split(text string) []string {
	if text == "" {
		return []string{}
	}
	let parts = strings.Split(text, "\n")
	if strings.HasSuffix(text, "\n") {
		return slices.Slice(parts, 0, len(parts)-1)
	}
	parts
}

// Inherit is a sink: the program writes to the stream of this process.
type Inherit {}

// Discard is a sink: the program writes to the null device.
type Discard {}

// ToFile is a sink: the program writes to the file at Path, created when
// missing, emptied first unless Append. The bytes reach the file as the
// program writes them: the file is the program's own stream.
type ToFile { Path string, Append bool }

// ToCaller is a sink: the caller reads the program's bytes from Chunks,
// or its lines from Lines, as they come.
type ToCaller {}

// ToStdout is a sink of standard error: the program writes it where its
// standard output goes, to the same pipe, file or stream (the shell's
// 2>&1; Go's CombinedOutput), so the bytes of the two keep the order the
// program wrote them in. With a Stdout of ToCaller, Chunks and Lines give
// them as one stream, none marked Stderr; with Discard both go to the null
// device. As the sink of standard output it is Failed: standard output
// cannot go to itself.
type ToStdout {}

// Sink is where a stream of a started program goes.
type Sink = Inherit | Discard | ToFile | ToCaller | ToStdout

// Streams are the sinks of a started program's standard output and
// standard error.
type Streams { Stdout Sink, Stderr Sink }

// Line is one line of a stream whose sink is ToCaller, without its line
// feed, and whether it came from standard error.
extern go ergo.local/prototype/runtime/v1/exec.ExecLine type Line { Text string, Stderr bool }

// Chunk is what one read of a stream whose sink is ToCaller gave: its
// bytes as the program wrote them (any bytes, line feeds included), and
// whether it came from standard error. A Chunk with no bytes is the end of
// its stream. Where a stream is cut into chunks is not a promise: only the
// bytes of each stream, in their order, are.
extern go ergo.local/prototype/runtime/v1/exec.ExecChunk type Chunk { Text string, Stderr bool }

// Running is a started program. It is a resource: the scope that owns it
// ends the program when it ends (SIGTERM to the program's process group,
// the command's Grace, then SIGKILL), reaps it and waits until no process
// of its group is left, on every exit, a stop and a timeout included.
//
// law-exempt: the lifecycle is a property against a model over a fake
// process (runtime/v1/exec TestRunningMatchesModel); a real program's streams
// are TestExecStreams.
extern go ergo.local/prototype/runtime/v1/exec.Running type Running {
	runtimeOnly(),
	..Closer,
	// Lines gives the lines of the streams whose sink is ToCaller, each
	// without its line feed, in the order their line feeds come, until both
	// end; a last line with no line feed comes at its stream's end. It
	// reads the chunks Chunks gives, so a caller may mix the two. A break
	// or a stop leaves the bytes read and not given for the next Lines or
	// Chunks; after Wait it gives none.
	// seq-exempt: Running is law-exempt (its lines come from a program, which a law cannot generate); TestRunningMatchesModel (runtime/v1/exec) holds Lines over chunks cut anywhere, a break and the bytes it leaves for Chunks, and the stop of a reader against its model, and lower TestExecStartRuns a break on the host (a follower).
	Lines() Seq[Line],
	// Chunks gives the bytes of the streams whose sink is ToCaller as they
	// are read, with no wait for a line feed, each stream's in its order,
	// then an empty Chunk at each stream's end, until both end. A full
	// buffer of 64 chunks makes the program wait in its write, so the
	// caller's reading paces it. A tee is the caller's loop: write each
	// Chunk where it goes and keep it. A break leaves the rest for the next
	// Chunks; after Wait it gives none.
	// seq-exempt: Running is law-exempt (its bytes come from a program, which a law cannot generate); TestRunningMatchesModel (runtime/v1/exec) holds the bytes of each stream as they come and at the end, a break and the stop of a reader against its model, and lower TestExecStartRuns a tee on the host.
	Chunks() Seq[Chunk],
	// Wait waits for the program's end and gives its status, 128 plus the
	// signal's number for a program a signal ended. It drops the bytes not
	// read yet. A stop of the caller ends the wait; the program then runs
	// until the owner's scope ends it.
	Wait() int,
	// Stop takes ownership, ends the group by the command's Grace rule,
	// reaps it and returns its actual status, as Wait does. Cleanup is
	// masked even when the caller has been stopped. WaitFor waits with a
	// deadline; Stop in its Expired catch observes the status after
	// termination. Close is the scope-release form.
	own Stop() int,
}

// WaitFor waits at most d for p's end and gives its status, as Wait
// does, or fails Expired when d passes first. The deadline is the
// Scheduler's time. Expired leaves p running and its unread bytes for
// Lines and Chunks: the caller still owns p, and Stop ends it and gives
// its status. A program that has ended gives its status at once, whatever
// d is. A program that ends as d passes may give Expired; Stop then gives
// its status. A stop of the caller ends the wait, as Wait's.
//
//	let code = p.WaitFor(5s) catch {
//	case timeout.Expired:
//		p.Stop()
//	}
func WaitFor(p Running, d duration) int fails timeout.Expired needs Scheduler { try waitFor(p, d) }

extern go ergo.local/prototype/runtime/v1/exec.ExecWaitFor func waitFor(p Running, d duration) int fails timeout.Expired needs Scheduler

// WaitForEndedGivesStatus: a program that has ended gives the status Wait
// gives, never Expired, whatever the deadline. A Script's Running has
// ended when Start returns.
law WaitForEndedGivesStatus(status int, d int64) {
	let c = New("x", []string{})
	let mut results = Map[string, Result]{}
	results[Key(c)] = Result{Status: status, Stdout: "", Stderr: ""}
	let p = Script{Results: results}.Start(c, Streams{Stdout: Discard, Stderr: Discard}) catch {
	case NotFound, Denied, Failed:
		return false
	}
	with context { Scheduler: time.NewManual(0) } {
		let code = p.WaitFor(duration(d)) catch {
		case timeout.Expired:
			return false
		}
		code == status
	}
}

// Runner runs a program to its end, or starts it. A stop of the calling
// task ends the program and every process it started in its process
// group, and Run returns only after they are gone.
type Runner {
	Run(c Command) Result fails NotFound | Denied | Failed,

	// Start starts c with its streams going to s, and returns once it has
	// started. The caller owns the Running.
	Start(c Command, s Streams) Running fails NotFound | Denied | Failed,

	// StartAgreesWithRun: a started program whose streams go to the
	// caller gives the lines and the status Run gives. The program is a
	// drawn Shell, so on a host each case runs one.
	law StartAgreesWithRun(sh Shell) {
		let c = ShellCommand(sh)
		let want = Run(c) catch {
		case NotFound, Denied, Failed:
			return true
		}
		let p = Start(c, Streams{Stdout: ToCaller, Stderr: ToCaller}) catch {
		case NotFound, Denied, Failed:
			return false
		}
		let mut out = []string{}
		let mut errs = []string{}
		for l in p.Lines() {
			if l.Stderr {
				errs = errs.Append(l.Text)
			} else {
				out = out.Append(l.Text)
			}
		}
		slices.Equal(out, Split(want.Stdout)) && slices.Equal(errs, Split(want.Stderr)) && p.Wait() == want.Status
	},

	// StartMergedInterleavesRun: a started program whose standard error
	// goes to its standard output (ToStdout), which goes to the caller,
	// gives one stream, no byte of it marked Stderr: the bytes of Run's
	// Stdout and Stderr, each in its order, interleaved; and Run's status.
	law StartMergedInterleavesRun(sh Shell) {
		let c = ShellCommand(sh)
		let want = Run(c) catch {
		case NotFound, Denied, Failed:
			return true
		}
		let p = Start(c, Streams{Stdout: ToCaller, Stderr: ToStdout}) catch {
		case NotFound, Denied, Failed:
			return false
		}
		let mut got = ""
		for k in p.Chunks() {
			if k.Stderr {
				return false
			}
			got = got + k.Text
		}
		Interleaves(got, want.Stdout, want.Stderr) && p.Wait() == want.Status
	},

	// ShellRunsAsWritten: a Shell that runs writes its texts, each to its
	// stream, and exits with its Status's low 8 bits, so the Shell laws
	// above run the program they draw.
	law ShellRunsAsWritten(sh Shell) {
		let r = Run(ShellCommand(sh)) catch {
		case NotFound, Denied, Failed:
			return true
		}
		let mut out = ""
		let mut errs = ""
		for w in sh.Writes {
			if w.Stderr {
				errs = errs + w.Text
			} else {
				out = out + w.Text
			}
		}
		r.Stdout == out && r.Stderr == errs && r.Status == (sh.Status % 256 + 256) % 256
	},

	// NotFoundNamesTheProgram: a program that is not found is named by its
	// failure.
	law NotFoundNamesTheProgram(name string) {
		Run(New(name, []string{})) catch {
		case NotFound as n:
			return n.Name == name
		case Denied, Failed:
			return true
		}
		true
	},
}

// Interleaves reports whether s is a and b merged, each one's bytes kept
// in its order: what a stream of a program whose Stderr is ToStdout holds
// of the program's two streams (StartMergedInterleavesRun). It takes
// time len(a) times len(b).
func Interleaves(s string, a string, b string) bool {
	if len(s) != len(a)+len(b) {
		return false
	}
	// ok[j] is whether s's first i+j bytes merge a's first i and b's first
	// j, for the row i.
	let mut ok = []bool{}
	for j in 0..len(b)+1 {
		ok = ok.Append(j == 0 || ok[j-1] && b[j-1] == s[j-1])
	}
	for i in 1..len(a)+1 {
		ok[0] = ok[0] && a[i-1] == s[i-1]
		for j in 1..len(b)+1 {
			ok[j] = (ok[j] && a[i-1] == s[i+j-1]) || (ok[j-1] && b[j-1] == s[i+j-1])
		}
	}
	ok[len(b)]
}

// InterleavesMatchesModel: Interleaves agrees with a search written apart
// from it, merged, on a merge of a and b by picks, that merge with its
// first two bytes swapped, t, and the merge with a byte more (a and b and
// t cut to 5 bytes).
law InterleavesMatchesModel(a string, b string, picks []bool, t string) {
	let x = upTo5(a)
	let y = upTo5(b)
	let s = pickMerge(x, y, picks)
	let checks = []string{s, swapFirst(s), upTo5(t), s + "x"}
	slices.All(checks, func(u string) bool { Interleaves(u, x, y) == merged(u, x, y) })
}

// upTo5 is s's first 5 bytes at most, so merged's search stays small.
func upTo5(s string) string { if len(s) < 5 { s } else { strings.Slice(s, 0, 5) } }

// pickMerge is a and b merged, each in its order: the next byte from a
// when picks says so (cycling) or b is used up.
func pickMerge(a string, b string, picks []bool) string {
	let mut s = ""
	let mut i = 0
	let mut j = 0
	for k in 0..len(a)+len(b) {
		let fromA = j == len(b) || (i < len(a) && len(picks) > 0 && picks[k%len(picks)])
		if fromA {
			s = s + strings.Slice(a, i, i+1)
			i = i + 1
		} else {
			s = s + strings.Slice(b, j, j+1)
			j = j + 1
		}
	}
	s
}

// swapFirst is s with its first two bytes swapped.
func swapFirst(s string) string {
	if len(s) < 2 {
		return s
	}
	strings.Slice(s, 1, 2) + strings.Slice(s, 0, 1) + strings.Slice(s, 2, len(s))
}

// merged is Interleaves' model, written apart from it: the first byte of
// s comes from a or from b, and the rest merges what is left.
func merged(s string, a string, b string) bool {
	if a == "" {
		return s == b
	}
	if b == "" {
		return s == a
	}
	if s == "" {
		return false
	}
	let rest = strings.Slice(s, 1, len(s))
	(s[0] == a[0] && merged(rest, strings.Slice(a, 1, len(a)), b)) || (s[0] == b[0] && merged(rest, a, strings.Slice(b, 1, len(b))))
}

// Shell is a program for the Runner laws that exists on every host: sh
// writes each of Writes in order, then exits with Status (its low 8
// bits). A law that draws a Shell runs a real program on a host provider,
// where a drawn name would mostly be NotFound.
type Shell { Writes []ShellWrite, Status int }

// ShellWrite is one write of a Shell: Text, any bytes, to standard error
// when Stderr, else to standard output.
type ShellWrite { Text string, Stderr bool }

// ShellCommand is sh as a Command: sh -c with a script of one printf per
// write, each byte of its text written as an octal escape, so every byte,
// NUL included, reaches the stream as it is.
func ShellCommand(sh Shell) Command {
	let mut script = ""
	for w in sh.Writes {
		let mut format = ""
		for k in 0..len(w.Text) {
			let b = int(w.Text[k])
			format = format + "\\" + octal(b / 64) + octal(b / 8 % 8) + octal(b % 8)
		}
		script = script + "printf '" + format + "'" + (if w.Stderr { " >&2" } else { "" }) + "\n"
	}
	let status = (sh.Status % 256 + 256) % 256
	New("sh", []string{"-c", script + "exit " + strconv.Itoa(status)})
}

// octal is the digit d, 0 to 7.
func octal(d int) string { strings.Slice("01234567", d, d+1) }

// Detached names a program started to outlive the code that started it
// (Spawner.Spawn). It is plain data: it crosses, has no release, and is
// stored in a pidfile or a state, so a later Alive or Kill, from this
// process or another one, acts on it. Pid is the program's process id and
// the id of its session and process group. Start is its start time as the
// host reports it, so Alive and Kill never act on another process that
// reused the pid. Name is the program's name.
extern go ergo.local/prototype/runtime/v1/exec.ExecDetached type Detached { Pid int, Start int64, Name string }

// Spawner starts programs that outlive the caller's scope, and finds and
// ends them later. It is a capability apart from Runner, so a detached
// start shows in the row of the code that does it; a Running stays owned
// by its scope, and no Running becomes a Detached.
type Spawner {
	// Spawn starts c in a new session and process group, with its streams
	// going to s, and returns once it has started. A sink of s that is
	// ToCaller is Failed: no caller outlives the program to read it. A
	// stop of the calling task does not end the program.
	Spawn(c Command, s Streams) Detached fails NotFound | Denied | Failed,

	// Alive reports that d's program is still running: the same process,
	// by its pid and its start time.
	Alive(d Detached) bool,

	// Kill ends d's process group: SIGTERM, then SIGKILL when the group
	// has not ended grace later (a grace of 0 sends SIGKILL at once), and
	// returns once no process of the group is left. A d whose program is
	// gone is no failure.
	Kill(d Detached, grace duration),

	// KilledIsNotAlive: a spawned program that Kill ended is not Alive.
	law KilledIsNotAlive(name string) {
		let d = Spawn(New(name, []string{}), Streams{Stdout: Discard, Stderr: Discard}) catch {
		case NotFound, Denied, Failed:
			return true
		}
		Kill(d, 0s)
		!Alive(d)
	},

	// KillIsIdempotent: a second Kill of a program that is gone is no
	// failure and leaves it gone.
	law KillIsIdempotent(name string) {
		let d = Spawn(New(name, []string{}), Streams{Stdout: Discard, Stderr: Discard}) catch {
		case NotFound, Denied, Failed:
			return true
		}
		Kill(d, 0s)
		Kill(d, 0s)
		!Alive(d)
	},
}

// Processes is the memory Spawner, for laws and for the tests of code
// that spawns: Spawn records a live entry for c and gives it the next
// pid, Alive reads the entry, Kill removes it. It runs nothing. Spawn
// fails NotFound when Programs does not list c.Name, and Failed for a
// ToCaller sink, as the host's does. Its table is in a sync.Ref, so the
// copies of one Processes share it, as handles of one host do.
type Processes { Programs []string, live sync.Ref[Map[int, string]], next sync.Ref[int] } implements Spawner

// NewProcesses is a memory Spawner whose Spawn knows the programs named.
func NewProcesses(programs []string) Processes {
	Processes{Programs: programs, live: sync.NewRef(Map[int, string]{}), next: sync.NewRef(0)}
}

// Spawn records c as a live program under the next pid. The pid is its
// Start too: the memory host never reuses one.
func Spawn(p Processes, c Command, s Streams) Detached fails NotFound | Denied | Failed {
	if !slices.Contains(p.Programs, c.Name) {
		return NotFound{Name: c.Name}
	}
	if toCaller(s.Stdout) || toCaller(s.Stderr) {
		return Failed{Name: c.Name, Reason: "a detached program has no caller to read it (ToCaller)"}
	}
	if toStdout(s.Stdout) {
		return Failed{Name: c.Name, Reason: toItself}
	}
	let pid = p.next.Get() + 1
	p.next.Set(pid)
	let mut m = p.live.Get()
	m[pid] = c.Name
	p.live.Set(m)
	Detached{Pid: pid, Start: int64(pid), Name: c.Name}
}

// Alive reports that d names a live entry: its pid holds d's Name and d's
// Start is that pid's.
func Alive(p Processes, d Detached) bool {
	d.Start == int64(d.Pid) && p.live.Get().Get(d.Pid) == Some[string]{Value: d.Name}
}

// Kill removes d's entry, if it is there.
func Kill(p Processes, d Detached, _ duration) {
	if p.Alive(d) {
		p.live.Set(p.live.Get().Delete(d.Pid))
	}
}

// Script is a Runner for tests. It runs nothing: Run gives the Result that
// Results holds at the command's Key, and fails NotFound when it holds
// none. The environment, the directory and the standard input are not in
// the Key.
type Script { Results Map[string, Result] } implements Runner

// Run is the Result recorded for c, or NotFound.
func Run(s Script, c Command) Result fails NotFound | Denied | Failed {
	match s.Results.Get(Key(c)) {
	case Some[Result] as hit:
		return hit.Value
	case None:
		return NotFound{Name: c.Name}
	}
}

// Start is the Running of the Result recorded for c (Ended). It fails
// NotFound when Results holds no Result for c, and Failed for a Stdout of
// ToStdout, as the host's does.
func Start(s Script, c Command, st Streams) Running fails NotFound | Denied | Failed {
	if toStdout(st.Stdout) {
		return Failed{Name: c.Name, Reason: toItself}
	}
	match s.Results.Get(Key(c)) {
	case Some[Result] as hit:
		return Ended(hit.Value, st)
	case None:
		return NotFound{Name: c.Name}
	}
}

// Ended is the Running of a program that has already ended with r: Chunks
// gives r's Stdout, then its Stderr, each when its sink in s is ToCaller
// (so Lines gives the lines of each), and Wait gives r's Status. A Stderr
// of ToStdout joins Stdout's stream: r's Stdout then its Stderr as one
// stream, unmarked, when Stdout's sink is ToCaller (a Result keeps no
// order between the two, and this one is an interleaving). It starts
// nothing and writes nothing to a file or a stream of this process. It is
// how any Runner that runs no program, Script or a module's own fake, gives
// the Running its Start returns: a Running is the runtime's value, so no
// other package's type implements it.
func Ended(r Result, s Streams) Running {
	let mut cs = []Chunk{}
	if toCaller(s.Stdout) && toStdout(s.Stderr) {
		return replay(whole(cs, r.Stdout + r.Stderr, false), r.Status, true)
	}
	if toCaller(s.Stdout) {
		cs = whole(cs, r.Stdout, false)
	}
	if toCaller(s.Stderr) {
		cs = whole(cs, r.Stderr, true)
	}
	replay(cs, r.Status, toCaller(s.Stdout) || toCaller(s.Stderr))
}

// whole is cs with the stream text as one Chunk, when it is not empty, and
// then the stream's end.
func whole(cs []Chunk, text string, stderr bool) []Chunk {
	let mut out = cs
	if text != "" {
		out = out.Append(Chunk{Text: text, Stderr: stderr})
	}
	out.Append(Chunk{Text: "", Stderr: stderr})
}

func toCaller(s Sink) bool {
	match s {
	case ToCaller:
		true
	case Inherit, Discard, ToFile, ToStdout:
		false
	}
}

func toStdout(s Sink) bool {
	match s {
	case ToStdout:
		true
	case Inherit, Discard, ToFile, ToCaller:
		false
	}
}

// toItself is the failure of a Stdout of ToStdout, as the runtime's.
let toItself = "stdout: ToStdout is a sink of standard error, and standard output cannot go to itself"

extern go ergo.local/prototype/runtime/v1/exec.ExecReplay func replay(cs []Chunk, status int, caller bool) Running

// ScriptReplaysRecorded: a Script gives back the Result recorded for a
// command, whatever its status, and two commands whose arguments differ
// never share a record: the arguments arg, arg and the one argument
// arg + "," + arg each get their own.
law ScriptReplaysRecorded(name string, arg string, status int, out string) {
	let c = New(name, []string{arg, arg})
	let joined = New(name, []string{arg + "," + arg})
	let mut results = Map[string, Result]{}
	results[Key(c)] = Result{Status: status, Stdout: out, Stderr: ""}
	results[Key(joined)] = Result{Status: status + 1, Stdout: out, Stderr: ""}
	let r = Script{Results: results}.Run(c) catch {
	case NotFound, Denied, Failed:
		return false
	}
	let s = Script{Results: results}.Run(joined) catch {
	case NotFound, Denied, Failed:
		return false
	}
	r.Status == status && r.Stdout == out && r.Stderr == "" && s.Status == status+1
}

// Host is the host's Runner. Its field gives this package the construction
// authority (types.md, Zero values 6): no other package writes exec.Host{},
// its zero value or a record update of it. root is "" for the host's own
// (NewHost), and the case's folder for a test's (NewTestHost,
// confined.ergo).
type Host { root string } implements Runner, Spawner

// NewHost is the host's Runner. It needs Ambient: only code whose row
// holds the authority to choose the host makes one.
func NewHost() Host needs Ambient { Host{root: ""} }

// Run runs c to its end on the host. The program starts in a process group
// of its own; Run returns after it exits and is reaped, with all its
// output. A stop of the calling task kills the group, waits for the reap
// and ends the call.
func Run(h Host, c Command) Result fails NotFound | Denied | Failed {
	if h.root != "" {
		return try runConfined(h, c)
	}
	try hostRun(c.Name, c.Args, c.Env, c.Dir, c.Stdin, c.Grace)
}

extern go ergo.local/prototype/runtime/v1/exec.ExecRun func hostRun(name string, args []string, env Map[string, string], dir string, stdin string, grace duration) Result fails NotFound | Denied | Failed

// Start starts c on the host, in a process group of its own, with its
// standard output and standard error going to s's sinks. A file sink that
// cannot be opened fails Failed and starts nothing.
func Start(h Host, c Command, s Streams) Running fails NotFound | Denied | Failed {
	if h.root != "" {
		return try startConfined(h, c, s)
	}
	try hostStart(c.Name, c.Args, c.Env, c.Dir, c.Stdin, c.Grace, sinkKind(s.Stdout), sinkPath(s.Stdout), sinkAppends(s.Stdout), sinkKind(s.Stderr), sinkPath(s.Stderr), sinkAppends(s.Stderr))
}

// sinkKind is the runtime's number of a sink (runtime/v1/exec exec_start.go).
func sinkKind(s Sink) int {
	match s {
	case Inherit:
		0
	case Discard:
		1
	case ToFile:
		2
	case ToCaller:
		3
	case ToStdout:
		4
	}
}

func sinkPath(s Sink) string {
	match s {
	case ToFile as f:
		f.Path
	case Inherit, Discard, ToCaller, ToStdout:
		""
	}
}

func sinkAppends(s Sink) bool {
	match s {
	case ToFile as f:
		f.Append
	case Inherit, Discard, ToCaller, ToStdout:
		false
	}
}

// Spawn starts c on the host in a new session and process group, so it
// outlives the calling task's scope and this process. Its streams go to
// s's sinks; a file sink that cannot be opened, or a ToCaller sink, fails
// Failed and starts nothing. A test's Host (NewTestHost) spawns nothing:
// a detached program would outlive the case's folder and its sandbox, so
// Spawn fails Failed, Alive is false and Kill signals nothing.
func Spawn(h Host, c Command, s Streams) Detached fails NotFound | Denied | Failed {
	if h.root != "" {
		return Failed{Name: c.Name, Reason: "a test's host spawns no detached program"}
	}
	try hostSpawn(c.Name, c.Args, c.Env, c.Dir, c.Stdin, sinkKind(s.Stdout), sinkPath(s.Stdout), sinkAppends(s.Stdout), sinkKind(s.Stderr), sinkPath(s.Stderr), sinkAppends(s.Stderr))
}

// Alive reports that d's program is running on the host: its pid names a
// process that has not ended and that started at d.Start.
func Alive(h Host, d Detached) bool { h.root == "" && hostAlive(d.Pid, d.Start) }

// Kill ends d's process group on the host (Spawner.Kill). A pid that
// another process now has gets no signal.
func Kill(h Host, d Detached, grace duration) {
	if h.root == "" {
		hostKill(d.Pid, d.Start, grace)
	}
}

extern go ergo.local/prototype/runtime/v1/exec.ExecSpawn func hostSpawn(name string, args []string, env Map[string, string], dir string, stdin string, outKind int, outPath string, outAppend bool, errKind int, errPath string, errAppend bool) Detached fails NotFound | Denied | Failed

extern go ergo.local/prototype/runtime/v1/exec.ExecAlive func hostAlive(pid int, start int64) bool

extern go ergo.local/prototype/runtime/v1/exec.ExecKill func hostKill(pid int, start int64, grace duration)

extern go ergo.local/prototype/runtime/v1/exec.ExecStart func hostStart(name string, args []string, env Map[string, string], dir string, stdin string, grace duration, outKind int, outPath string, outAppend bool, errKind int, errPath string, errAppend bool) Running fails NotFound | Denied | Failed
