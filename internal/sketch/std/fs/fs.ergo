// Package fs is the host file system (docs/spec/stdlib.md, host packages).
// Files reads it and Writes changes it: two capabilities, so code that
// only reads shows only Files in its row, and Files has no writer. Host is
// the host's provider of both. Host has an unexported field, so only this
// package builds one (S114), and NewHost, its one constructor, needs the
// prelude's Ambient, which only the entry provides. So code that makes a
// Host shows Ambient in its row: main lists it and binds
// `context { fs.Files: fs.NewHost() }`. A test cannot get Ambient and
// binds fstest.Memory instead, a tree of files in memory, or the disk in
// a folder of its case's own through NewTestHost, under the test's
// ambient (confined.ergo). The
// externs are unexported, so a program reads or writes the disk only
// through a Host it was given or made under Ambient. No handle is exposed,
// so no file stays open after a call returns, except an explicit HostRoot.

import core
import option
import os
import time

// NotFound is the failure of a path that does not exist.
extern go ergo.local/prototype/runtime/v1.NotFound type NotFound { Path string }

// Denied is the failure of a path the process may not read or write.
extern go ergo.local/prototype/runtime/v1.Denied type Denied { Path string }

// Failed is any other failure of an operation at Path. Reason is the
// host's text for it, without the path, such as "is a directory".
extern go ergo.local/prototype/runtime/v1.Failed type Failed { Path string, Reason string }

// CrossDevice is the failure of a hard link or a rename between two file
// systems: Link and Rename never copy instead (G6).
extern go ergo.local/prototype/runtime/v1.CrossDevice type CrossDevice { From string, To string }

// NotRegular is the failure of MapBounded for a path that is not a
// regular file: a directory, a pipe, a device (CAP-FILE).
extern go ergo.local/prototype/runtime/v1.NotRegular type NotRegular { Path string }

// TooLarge is the failure of MapBounded for a file of more than Limit
// bytes; Size is its size when it was opened.
extern go ergo.local/prototype/runtime/v1.TooLarge type TooLarge { Path string, Size int, Limit int }

// Exists is the failure of Mkdir when something, a file, a directory or
// a link, is at Path already.
extern go ergo.local/prototype/runtime/v1.Exists type Exists { Path string }

// Info describes the file at a path: its last element, its size in bytes,
// whether it is a directory, and its permission bits as Perm gives them
// (Go's fs.FileMode.Perm), so `info.Perm == fs.Perm(fs.Private())` tests
// a mode. Perm is bits, not a Mode, because Mode has no value for some
// bits, such as a write without a read.
extern go ergo.local/prototype/runtime/v1.Info type Info { Name string, Size int, Dir bool, Perm int }

// EntryKind is the kind of filesystem entry observed by ReadEntry without
// following symbolic links.
type EntryKind = FileEntry{} | DirEntry{} | SymlinkEntry{} | OtherEntry{}

// FileID is the opaque, comparable identity of a filesystem object,
// pairing its device and inode numbers.
type FileID { dev uint64, ino uint64 }

// NewFileID constructs a FileID from device and inode identifiers.
func NewFileID(dev uint64, ino uint64) FileID { FileID{dev: dev, ino: ino} }

// Entry describes the object at a path without following symbolic links
// (Lstat semantics).
type Entry {
	Kind           EntryKind,
	Size           int,
	AllocatedBytes int,
	ModTime        time.Time,
	AccessTime     time.Time,
	Nlink          int,
	ID             FileID,
}

extern go ergo.local/prototype/runtime/v1.FSEntry type rawEntry {
	Kind           int,
	Size           int,
	AllocatedBytes int,
	ModSec         int64,
	ModNsec        int64,
	AccessSec      int64,
	AccessNsec     int64,
	Nlink          int,
	Dev            uint64,
	Ino            uint64,
}

// Access is what one class of users may do with a file: the three
// permission bits of that class (read 4, write 2, execute 1). The variants
// are the useful ones; a write without a read is not one of them. On a
// directory, execute is the right to pass through it.
type Access = NoAccess{} | Execute{} | ReadOnly{} | ReadExecute{} | ReadWrite{} | ReadWriteExecute{}

// Mode is the permission of a file for its owner, its group and every
// other user. It is a record, not an octal number, so a mode reads as what
// it allows: Private() is Mode{Owner: ReadWrite, Group: NoAccess, Other:
// NoAccess}, which Go writes 0o600. Perm is its bits.
type Mode { Owner Access, Group Access, Other Access }

// Private is the mode of a file only its owner reads and writes, 0o600:
// Go's convention for a secret, such as a key file.
func Private() Mode { Mode{Owner: ReadWrite, Group: NoAccess, Other: NoAccess} }

// PrivateDir is the mode of a directory only its owner reads, writes and
// passes through, 0o700: Go's convention for a directory of secrets.
func PrivateDir() Mode { Mode{Owner: ReadWriteExecute, Group: NoAccess, Other: NoAccess} }

// Shared is the mode of a file its owner writes and every user reads,
// 0o644.
func Shared() Mode { Mode{Owner: ReadWrite, Group: ReadOnly, Other: ReadOnly} }

// SharedDir is the mode of a directory its owner writes and every user
// reads and passes through, 0o755.
func SharedDir() Mode { Mode{Owner: ReadWriteExecute, Group: ReadExecute, Other: ReadExecute} }

// Bits is the three permission bits of a: read 4, write 2, execute 1.
func Bits(a Access) int {
	match a {
	case NoAccess:
		0
	case Execute:
		1
	case ReadOnly:
		4
	case ReadExecute:
		5
	case ReadWrite:
		6
	case ReadWriteExecute:
		7
	}
}

// Perm is the Unix permission bits of m, as Go's fs.FileMode.Perm gives
// them: the owner's bits times 64, the group's times 8, then the others'.
// Private is 384 (0o600).
func Perm(m Mode) int { Bits(m.Owner)*64 + Bits(m.Group)*8 + Bits(m.Other) }

// Files reads the file system. A path is the host's: relative paths are
// relative to the working directory.
type Files {
	ReadFile(path string) string fails NotFound | Denied | Failed,
	// ReadDir is the names of the entries of the directory path, sorted.
	ReadDir(path string) []string fails NotFound | Denied | Failed,
	Stat(path string) Info fails NotFound | Denied | Failed,
	// Lstat is Stat, but a symbolic link at path is described itself, not
	// followed: a link is never Dir. A provider with no links gives Stat.
	Lstat(path string) Info fails NotFound | Denied | Failed,

	// LstatDirIsStatDir: a directory Lstat sees is one Stat sees too.
	law LstatDirIsStatDir(path string) {
		let l = Lstat(path) catch {
		case NotFound, Denied, Failed:
			return true
		}
		if !l.Dir {
			return true
		}
		let s = try Stat(path)
		s.Dir
	},

	// ReadIsRepeatable: with no writer, two reads of one path agree: both
	// give the same text, or both fail with the same failure, its kind and
	// its fields. A second read that fails after a first that succeeds
	// escapes, and an escaping failure refutes a law. The law is written
	// out by kind: a law runs in the package that sees its providers, so
	// it can call no helper of fs's own.
	law ReadIsRepeatable(path string) {
		let first = ReadFile(path) catch {
		case NotFound as e:
			let _ = ReadFile(path) catch {
			case NotFound as again:
				return again == e
			case Denied, Failed:
				return false
			}
			return false
		case Denied as e:
			let _ = ReadFile(path) catch {
			case Denied as again:
				return again == e
			case NotFound, Failed:
				return false
			}
			return false
		case Failed as e:
			let _ = ReadFile(path) catch {
			case Failed as again:
				return again == e
			case NotFound, Denied:
				return false
			}
			return false
		}
		try ReadFile(path) == first
	},
}

// Writes changes the file system. A path is the host's, as for Files. A
// provider of Files and Writes over one store also keeps these contracts,
// which no single law can state yet (a member law sees only the
// operations of its own type), with no other writer:
//   - after WriteFile(path, text) succeeds, ReadFile(path) is text;
//   - AppendConcatenates: after WriteFile(path, a) and AppendFile(path,
//     b) succeed, ReadFile(path) is a + b;
//   - ModeIsKept: after WriteFileMode(path, text, m) succeeds, the file
//     has mode m, and a later WriteFile or AppendFile keeps it.
type Writes {
	// WriteFile makes the file at path hold text: it writes a new file in
	// the directory of path and renames it over path, so a reader sees the
	// old text or the new text, never a part. A new file has mode
	// 0666 less the umask; a file that was there keeps its mode. A
	// symbolic link at path is followed, as Go's os.WriteFile follows it:
	// the file it names gets the text and the link stays.
	WriteFile(path string, text string) fails NotFound | Denied | Failed,
	// MkdirAll makes the directory path and each missing parent, with mode
	// 0777 less the umask. A directory that is there already is no failure.
	MkdirAll(path string) fails Denied | Failed,
	// WriteFileMode is WriteFile, but the file at path gets exactly mode,
	// whatever the umask, and a file that was there gets mode too. The new
	// file is made with mode before any byte is written, so no reader
	// wider than mode can open it.
	WriteFileMode(path string, text string, mode Mode) fails NotFound | Denied | Failed,
	// MkdirAllMode is MkdirAll, but each directory it makes gets exactly
	// mode, whatever the umask. A directory that is there keeps its mode.
	MkdirAllMode(path string, mode Mode) fails Denied | Failed,
	// AppendFile adds text at the end of the file at path in one write,
	// and makes the file, with mode 0666 less the umask, when there is
	// none. A file that was there keeps its mode.
	AppendFile(path string, text string) fails NotFound | Denied | Failed,
	// Chmod gives the file at path exactly mode. A symbolic link is
	// followed.
	Chmod(path string, mode Mode) fails NotFound | Denied | Failed,
	// Rename moves the file at from to to, and replaces a file at to. A
	// move to another file system is CrossDevice, and moves nothing: it
	// never copies.
	Rename(from string, to string) fails NotFound | Denied | Failed | CrossDevice,
	// Remove removes the file, or the empty directory, at path.
	Remove(path string) fails NotFound | Denied | Failed,
	// Mkdir makes the one directory path, with exactly mode, whatever the
	// umask, when nothing is at path; anything there, a link included, is
	// Exists. So of two Mkdir of one path at most one succeeds: MkdirTemp
	// rests on it. A missing parent is NotFound.
	Mkdir(path string, mode Mode) fails NotFound | Denied | Failed | Exists,

	// MkdirThenExists: when Mkdir(path, mode) succeeds, a second
	// Mkdir(path, mode) fails Exists.
	law MkdirThenExists(path string) {
		Mkdir(path, PrivateDir()) catch {
		case NotFound, Denied, Failed, Exists:
			return true
		}
		Mkdir(path, PrivateDir()) catch {
		case Exists:
			return true
		case NotFound, Denied, Failed:
			return false
		}
		false
	},

	// MkdirAllIsIdempotent: when MkdirAll(path) succeeds, a second
	// MkdirAll(path) succeeds too.
	law MkdirAllIsIdempotent(path string) {
		MkdirAll(path) catch {
		case Denied, Failed:
			return true
		}
		try MkdirAll(path)
		true
	},

	// RemoveThenNotFound: when Remove(path) succeeds, the file is gone,
	// so a second Remove(path) fails NotFound.
	law RemoveThenNotFound(path string) {
		Remove(path) catch {
		case NotFound, Denied, Failed:
			return true
		}
		Remove(path) catch {
		case NotFound:
			return true
		case Denied, Failed:
			return false
		}
		false
	},

	// RenameMoves: when a file is at from and none is at to, and
	// Rename(from, to) succeeds, nothing is left at from, so a second
	// Rename(from, to) fails NotFound.
	law RenameMoves(from string, to string, text string) {
		if from == to {
			return true
		}
		WriteFile(from, text) catch {
		case NotFound, Denied, Failed:
			return true
		}
		Remove(to) catch {
		case NotFound:
		case Denied, Failed:
			return true
		}
		Rename(from, to) catch {
		case NotFound, Denied, Failed, CrossDevice:
			return true
		}
		Rename(from, to) catch {
		case NotFound:
			return true
		case Denied, Failed, CrossDevice:
			return false
		}
		false
	},

	// CrossDeviceMovesNothing: when Rename(from, to) of a file fails
	// CrossDevice, the file is still at from, so Remove(from) succeeds.
	law CrossDeviceMovesNothing(from string, to string, text string) {
		WriteFile(from, text) catch {
		case NotFound, Denied, Failed:
			return true
		}
		Rename(from, to) catch {
		case CrossDevice:
			Remove(from) catch {
			case NotFound, Denied, Failed:
				return false
			}
			return true
		case NotFound, Denied, Failed:
			return true
		}
		true
	},
}

// Escapes is the failure of a Root path that leaves the root: an absolute
// path, a ".." past the root, or a symbolic link whose target is absolute
// or leads past the root, even when a later element comes back in.
extern go ergo.local/prototype/runtime/v1.Escapes type Escapes { Path string }

// Root reads one directory tree and nothing outside it. A path is
// relative to the root, its elements separated by "/". Each operation
// resolves the path element by element from the root, as Go's os.Root
// does: a symbolic link inside the root is followed, its target spliced
// in where the link was; ".." removes the element before it; and any
// step that would leave the root is Escapes, whatever the step after it.
// The check and the read are one host operation (openat below the root's
// descriptor), so a link changed between them cannot lead out. The empty
// path is Failed "empty path". A chain of more than eight links is Failed
// "too many levels of symbolic links".
type Root {
	ReadFile(path string) string fails NotFound | Denied | Failed | Escapes,
	// ReadDir is the names of the entries of the directory path, sorted.
	ReadDir(path string) []string fails NotFound | Denied | Failed | Escapes,
	// Stat describes the file at path, after symbolic links. Its Name is
	// the last element of path as it was given (filepath.Base).
	Stat(path string) Info fails NotFound | Denied | Failed | Escapes,
	// Name is the directory the root was opened at, as OpenRoot was given
	// it (Go's os.Root.Name); a Root in memory names itself. It is also
	// what makes a Root more than its reads: without it every Files
	// provider, whose reads have the same form and fewer failures, would
	// implement Root, so a reader that looks outside (fs.Host through a
	// link) would pass where a confined Root is asked for.
	Name() string,

	// LeavingEscapes: a path that starts with ".." or "/" leaves the root
	// before any lookup, so every operation on it fails Escapes, whatever
	// the tree holds. A provider that answers NotFound there has looked
	// outside.
	law LeavingEscapes(path string) {
		let _ = ReadFile("../" + path) catch {
		case Escapes:
			let _ = ReadFile("/" + path) catch {
			case Escapes:
				let _ = Stat("../" + path) catch {
				case Escapes:
					return true
				case NotFound, Denied, Failed:
					return false
				}
				return false
			case NotFound, Denied, Failed:
				return false
			}
			return false
		case NotFound, Denied, Failed:
			return false
		}
		false
	},
}

// HostRoot is the host's Root provider: a directory of the host disk,
// held from the time it was opened. Only OpenRoot makes one (the runtime's
// type). It resolves below one Go os.Root handle, even if its original
// directory name is renamed or replaced. The acquiring function's scope
// closes it on every exit; do not return or retain it beyond that scope
// until local resource ownership (#197) tracks that move.
// law-exempt: the host's Root; Root's law runs on it in the host agreement property.
extern go ergo.local/prototype/runtime/v1.HostRoot type HostRoot {
	..Root,
	hostRooted(),
}

// OpenRoot is the Root of the host directory dir. It fails when dir is
// not a directory the process may open. It needs Ambient: only code whose
// row holds the authority to choose the host makes one.
extern go ergo.local/prototype/runtime/v1.FSOpenRoot func OpenRoot(dir string) HostRoot fails NotFound | Denied | Failed needs os.Ambient

// Host is the host's Files and Writes provider. Its field gives this
// Entries reads the file system and rich non-following entry metadata.
type Entries {
	..Files,
	// ReadEntry describes the object at path without following symbolic
	// links (Lstat semantics).
	ReadEntry(path string) Entry fails NotFound | Denied | Failed,

	// EntryAgreesWithLstat: ReadEntry matches Lstat on failures,
	// directory status, and byte size, reports non-negative 512-byte
	// aligned allocated bytes, and reports at least one link.
	law EntryAgreesWithLstat(path string) {
		let l = Lstat(path) catch {
		case NotFound as err:
			let _ = ReadEntry(path) catch {
			case NotFound as got:
				return got == err
			case Denied, Failed:
				return false
			}
			return false
		case Denied as err:
			let _ = ReadEntry(path) catch {
			case Denied as got:
				return got == err
			case NotFound, Failed:
				return false
			}
			return false
		case Failed as err:
			let _ = ReadEntry(path) catch {
			case Failed as got:
				return got == err
			case NotFound, Denied:
				return false
			}
			return false
		}
		let e = ReadEntry(path) catch {
		case NotFound, Denied, Failed:
			return false
		}
		let isDir = match e.Kind {
		case DirEntry:
			true
		case FileEntry, SymlinkEntry, OtherEntry:
			false
		}
		isDir == l.Dir && e.Size == l.Size && e.AllocatedBytes >= 0 && e.AllocatedBytes%512 == 0 && e.Nlink >= 1
	},
}

// Host is the file system of this host. Its unexported field gives this
// package the construction authority (types.md, Zero values 6): no other
// package writes fs.Host{}, its zero value or a record update of it. root
// is "" for the host's own (NewHost), and the case's folder for a test's
// (NewTestHost, confined.ergo).
type Host { root string } implements Files, Writes, Entries

// NewHost is the host's Files and Writes provider. It needs Ambient: only
// code whose row holds the authority to choose the host makes one.
func NewHost() Host needs os.Ambient { Host{root: ""} }

// ReadFile is the whole text of the file at path.
func ReadFile(h Host, path string) string fails NotFound | Denied | Failed {
	try hostReadFile(try at(h, path))
}

// Text is the text of a Mapped: a borrow of it (types.md, Borrows 8). It
// stands only as a parameter's type, a let's value, an argument of a Text
// parameter, the operand of an index, a slice, len or a comparison, and
// the range of a for; never in a result, a field, an element, a type
// argument, an interpolation, an assignment or a frame that may outlive
// the call. Every use of a text is a use of its Mapped, so no text is read
// after its Mapped is closed. A slice of a text is a text of the same
// Mapped. Clone copies one into a string that may outlive it; no
// conversion makes a string of a Text or a Text of a string. Its Go type
// is the runtime's mapped text, and the borrow rule reads that, not this
// package's name: a copy of fs is the same.
extern go ergo.local/prototype/runtime/v1.MappedText type Text string

// Mapped is a file's text, read through a read-only mapping of the file
// instead of a copy (MapFile), or a text held in memory (MapText). Close
// unmaps it; the release of its owner closes it otherwise. Text is the
// text, a borrow of the Mapped. Only the runtime makes one.
// law-exempt: only MapFile and MapText make one; MapTextIsText and the
// runtime's TestFSMappedKeepsItsInvariant check their texts.
extern go ergo.local/prototype/runtime/v1.Mapped type Mapped {
	..core.Closer,
	runtimeOnly(),
	Text() Text,
	// Size is the length of the text in bytes: the file's size when it
	// was opened.
	Size() int,
	// PhysicalPath is the absolute path the host gave for the file when
	// MapBounded opened it, its links resolved; "" for a Mapped of
	// MapFile or MapText.
	PhysicalPath() string,
}

// MapFile maps the file at path: its text is the whole file, as ReadFile
// gives it, read where the page cache holds it, so a large file costs no
// read and no heap until its bytes are read. A file that is not regular
// (a pipe, a device) is read into memory. A file that another process
// truncates while it is mapped makes a read past its new end a defect that
// names the file, never a crash of the process. It is a function of Host
// alone, not an operation of Files.
func MapFile(h Host, path string) Mapped fails NotFound | Denied | Failed {
	try hostMapFile(try at(h, path))
}

// MapBounded maps the regular file at path, of at most limit bytes. It
// opens the file once, without waiting (a pipe put at path does not block
// it), and checks the open file, not the path: a file that is not regular
// fails NotRegular and one over limit fails TooLarge, before anything is
// read, so a file swapped in after a Stat of path is never read. The
// Mapped keeps the identity of the file it read (SameAs) and the path the
// host gives for it (Mapped.PhysicalPath). It is a function of Host alone,
// as MapFile is (fs/mapped states its laws).
func MapBounded(h Host, path string, limit int) Mapped fails NotFound | Denied | Failed | NotRegular | TooLarge {
	try hostMapBounded(try at(h, path), limit)
}

// SameAs reports whether the file at path, its links followed as SameFile
// reads a path, is the file m was mapped from by MapBounded: false once
// another file is renamed over path. A Mapped of MapFile or MapText is the
// same as no file.
func SameAs(h Host, m Mapped, path string) bool fails NotFound | Denied | Failed {
	try hostSameAs(try at(h, path), m)
}

// MapText is a Mapped whose text is text, held in memory: a provider in
// memory gives one where a host provider maps a file. Its Close releases
// nothing.
extern go ergo.local/prototype/runtime/v1.FSMapText func MapText(text string) Mapped

// Clone is a copy of the text t as a string, which outlives t's Mapped.
extern go ergo.local/prototype/runtime/v1.FSClone func Clone(t Text) string

// Len returns the number of bytes in t.
extern go len func Len(t Text) int

// MapTextIsText: the text of MapText(s) is s.
law MapTextIsText(s string) {
	let m = MapText(s)
	Clone(m.Text()) == s
}

// ReadDir is the names of the entries of the directory at path, sorted.
func ReadDir(h Host, path string) []string fails NotFound | Denied | Failed {
	try hostReadDir(try at(h, path))
}

// Stat describes the file at path, after symbolic links.
func Stat(h Host, path string) Info fails NotFound | Denied | Failed {
	try hostStat(try at(h, path))
}

// Lstat is Stat of path itself: a symbolic link is not followed.
func Lstat(h Host, path string) Info fails NotFound | Denied | Failed {
	try hostLstat(try atLast(h, path))
}

// ReadEntry returns rich non-following metadata (Lstat semantics) for path.
func ReadEntry(h Host, path string) Entry fails NotFound | Denied | Failed {
	let raw = try hostLstatEntry(try atLast(h, path))
	Entry{
		Kind: match raw.Kind {
		case 0:
			FileEntry
		case 1:
			DirEntry
		case 2:
			SymlinkEntry
		case _:
			OtherEntry
		},
		Size:           raw.Size,
		AllocatedBytes: raw.AllocatedBytes,
		ModTime:        time.Unix(raw.ModSec, raw.ModNsec),
		AccessTime:     time.Unix(raw.AccessSec, raw.AccessNsec),
		Nlink:          raw.Nlink,
		ID:             NewFileID(raw.Dev, raw.Ino),
	}
}

// WriteFile makes the file at path hold text, by a new file in its
// directory renamed over it.
func WriteFile(h Host, path string, text string) fails NotFound | Denied | Failed {
	try hostWriteFile(try at(h, path), text)
}

// MkdirAll makes the directory path and each missing parent.
func MkdirAll(h Host, path string) fails Denied | Failed {
	try hostMkdirAll(try at(h, path))
}

// Mkdir makes the one directory path with exactly mode, or fails Exists.
func Mkdir(h Host, path string, mode Mode) fails NotFound | Denied | Failed | Exists {
	try hostMkdir(try at(h, path), Perm(mode))
}

// WriteFileMode makes the file at path hold text with exactly mode, by a
// new file made with mode in its directory and renamed over it.
func WriteFileMode(h Host, path string, text string, mode Mode) fails NotFound | Denied | Failed {
	try hostWriteFileMode(try at(h, path), text, Perm(mode))
}

// MkdirAllMode makes the directory path and each missing parent, each
// with exactly mode.
func MkdirAllMode(h Host, path string, mode Mode) fails Denied | Failed {
	try hostMkdirAllMode(try at(h, path), Perm(mode))
}

// AppendFile adds text at the end of the file at path in one write.
func AppendFile(h Host, path string, text string) fails NotFound | Denied | Failed {
	try hostAppendFile(try at(h, path), text)
}

// Chmod gives the file at path exactly mode.
func Chmod(h Host, path string, mode Mode) fails NotFound | Denied | Failed {
	try hostChmod(try at(h, path), Perm(mode))
}

// Rename moves the file at from to to. Two file systems are CrossDevice
// (Go's os.Rename fails EXDEV), never a copy.
func Rename(h Host, from string, to string) fails NotFound | Denied | Failed | CrossDevice {
	try hostRename(try atLast(h, from), try atLast(h, to))
}

// Remove removes the file, or the empty directory, at path.
func Remove(h Host, path string) fails NotFound | Denied | Failed {
	try hostRemove(try atLast(h, path))
}

// Exchange makes the files at a and b trade places in one host call, so
// a reader of either path sees the old file or the new one and never no
// file. Both must be there: a missing one is NotFound, naming it, and
// nothing moves. A host or a file system with no atomic exchange is
// Failed "no atomic exchange on this host": Exchange is never done by
// renames a reader could see half done. Linux has one (renameat2 with
// RENAME_EXCHANGE), and macOS (renamex_np with RENAME_SWAP). It is a function of Host alone, not an operation of Writes, as
// LockFile is.
func Exchange(h Host, a string, b string) fails NotFound | Denied | Failed {
	try hostExchange(try at(h, a), try at(h, b))
}

// Link makes to a second name of the file at from, a hard link (G6): both
// names are one file, so a write through either is read through the
// other, and SameFile(from, to) holds. A file at to is Failed "file
// exists": Link never replaces one, so a caller links at a new name beside
// to and renames it over to. Two file systems are CrossDevice, never a
// copy. It is a function of Host alone, not an operation of Writes, as
// Exchange is.
func Link(h Host, from string, to string) fails NotFound | Denied | Failed | CrossDevice {
	try hostLink(try at(h, from), try at(h, to))
}

// SameFile reports whether the paths a and b name one file, after
// symbolic links, by the host's identity of a file (the device and the
// inode on Unix), not by name or bytes (G6): a hard link and its source
// are one file; a copy is not. A path with no file is NotFound, naming it.
func SameFile(h Host, a string, b string) bool fails NotFound | Denied | Failed {
	try hostSameFile(try at(h, a), try at(h, b))
}

// FileLock is an exclusive kernel lock on a file, which LockFile took and
// UnlockFile gives back. Its field gives this package the construction
// authority: no other package makes one.
type FileLock { fd int }

// LockFile takes an exclusive kernel lock (flock) on the file at path,
// made when it is missing, or None when another open of the file holds
// it for all of wait (0 tries once). Two LockFile calls exclude each
// other whether they are in one process or two, and the host releases
// the lock of a process that ends, however it ends, so a dead holder
// never strands it. The lock is advisory: it excludes only LockFile. The
// wait is a host wait, as a slow read's is: a stop of the caller ends it
// at most wait later. It is a function of Host alone: a memory disk has
// one process, whose own lock counts. A test's Host locks in its folder.
func LockFile(h Host, path string, wait duration) option.Option[FileLock] fails NotFound | Denied | Failed {
	let fd = try hostLockFile(try at(h, path), wait)
	if fd < 0 {
		return option.None
	}
	option.Some[FileLock]{Value: FileLock{fd: fd}}
}

// UnlockFile gives back the lock l. A second UnlockFile of l does
// nothing.
func UnlockFile(_ Host, l FileLock) { hostUnlockFile(l.fd) }

extern go ergo.local/prototype/runtime/v1.FSLockFile func hostLockFile(path string, wait duration) int fails NotFound | Denied | Failed
extern go ergo.local/prototype/runtime/v1.FSUnlockFile func hostUnlockFile(fd int)
