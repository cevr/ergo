// Package fs is the host file system, read only (docs/spec/stdlib.md, host
// packages). Files is the capability; Host is the host's provider of it.
// Host has an unexported field, so only this package builds one (S114),
// and NewHost, its one constructor, needs the prelude's Ambient, which only
// the entry provides. So code that makes a Host shows Ambient in its row:
// main lists it and binds `context { fs.Files: fs.NewHost() }`. A test
// cannot get Ambient and binds its own provider instead, such as a map of
// paths to text. The externs are unexported, so a program reads the disk
// only through a Host it was given or made under Ambient. No handle is
// exposed, so no file stays open after a call returns.

// NotFound is the failure of a path that does not exist.
type NotFound { Path string }

// Denied is the failure of a path the process may not read.
type Denied { Path string }

// Failed is any other failure of a read at Path. Reason is the host's
// text for it, without the path, such as "is a directory".
type Failed { Path string, Reason string }

// Info describes the file at a path: its last element, its size in bytes,
// and whether it is a directory.
type Info { Name string, Size int, Dir bool }

// Files reads the file system. A path is the host's: relative paths are
// relative to the working directory.
type Files {
	ReadFile(path string) string fails NotFound | Denied | Failed,
	// ReadDir is the names of the entries of the directory path, sorted.
	ReadDir(path string) []string fails NotFound | Denied | Failed,
	Stat(path string) Info fails NotFound | Denied | Failed,

	// ReadIsRepeatable: with no writer, two reads of one path agree.
	law ReadIsRepeatable(path string) {
		let first = try ReadFile(path)
		try ReadFile(path) == first
	},
}

// Host is the host's Files provider. Its field gives this package the
// construction authority (types.md, Zero values 6): no other package
// writes fs.Host{}, its zero value or a record update of it.
type Host { live hostOnly }

// hostOnly is the zero-size type of Host's field, so Host stays zero size.
type hostOnly {}

// NewHost is the host's Files provider. It needs Ambient: only code whose
// row holds the authority to choose the host makes one.
func NewHost() Host needs Ambient { Host{live: hostOnly} }

// ReadFile is the whole text of the file at path.
func ReadFile(_ Host, path string) string fails NotFound | Denied | Failed {
	try hostReadFile(path)
}

// ReadDir is the names of the entries of the directory at path, sorted.
func ReadDir(_ Host, path string) []string fails NotFound | Denied | Failed {
	try hostReadDir(path)
}

// Stat describes the file at path, after symbolic links.
func Stat(_ Host, path string) Info fails NotFound | Denied | Failed {
	try hostStat(path)
}

extern go ergo.local/prototype/runtime/v1.FSReadFile func hostReadFile(path string) string fails NotFound | Denied | Failed
extern go ergo.local/prototype/runtime/v1.FSReadDir func hostReadDir(path string) []string fails NotFound | Denied | Failed
extern go ergo.local/prototype/runtime/v1.FSStat func hostStat(path string) Info fails NotFound | Denied | Failed
