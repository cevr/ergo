// Package mapped states the laws of a store that maps files and keeps
// what it mapped (CAP-FILE): fs.MapBounded and fs.SameAs on the host. A
// store in memory has no descriptors, so the contract has one provider,
// the host's, and its laws run under OnTestHost, in a folder of the case's
// own (rows.md, Test's ambient).

import fs

// Maps is a file store that maps a regular file of at most a limit, and
// tells whether a path still leads to the file it mapped. Its files are
// written and renamed through the store's Writes, so a law sets up the
// files it maps.
type Maps {
	..fs.Files,
	..fs.Writes,
	// MapBounded is fs.MapBounded on the store's files.
	MapBounded(path string, limit int) fs.Mapped fails fs.NotFound | fs.Denied | fs.Failed | fs.NotRegular | fs.TooLarge,
	// SameAs is fs.SameAs on the store's files.
	SameAs(m fs.Mapped, path string) bool fails fs.NotFound | fs.Denied | fs.Failed,
	// BoundedIsTheText: a file of at most the limit maps to its text, of
	// its size, and its path leads to the file mapped, also by the
	// physical path the host gave.
	law BoundedIsTheText(text string) { boundedIsTheText(text) },
	// OverLimitIsTooLarge: a file of one byte more than the limit is
	// TooLarge, naming its size and the limit.
	law OverLimitIsTooLarge(text string) { overLimitIsTooLarge(text) },
	// DirIsNotRegular: a directory is NotRegular, whatever the limit.
	law DirIsNotRegular(limit int) { dirIsNotRegular(limit) },
	// ReplacedIsNotSame: once another file is renamed over the path, the
	// path no longer leads to the file mapped, and the Mapped still holds
	// the text it read.
	law ReplacedIsNotSame(a string, b string) { replacedIsNotSame(a, b) },
}

// Host is the host's Maps: fs.Host's files, with fs.MapBounded and
// fs.SameAs. It holds the functions NewHost built over the fs.Host it was
// given, as code.HostFiles does: building one takes an fs.Host, and using
// one hands no fs.Host out, so its functions need no Ambient (stdlib.md,
// Host packages; TestStdHostProvidersHaveAuthority).
type Host {
	readFile      func(path string) string fails fs.NotFound | fs.Denied | fs.Failed,
	readDir       func(path string) []string fails fs.NotFound | fs.Denied | fs.Failed,
	stat          func(path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed,
	lstat         func(path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed,
	writeFile     func(path string, text string) fails fs.NotFound | fs.Denied | fs.Failed,
	mkdirAll      func(path string) fails fs.Denied | fs.Failed,
	writeFileMode func(path string, text string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed,
	mkdirAllMode  func(path string, mode fs.Mode) fails fs.Denied | fs.Failed,
	appendFile    func(path string, text string) fails fs.NotFound | fs.Denied | fs.Failed,
	chmod         func(path string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed,
	rename        func(from string, to string) fails fs.NotFound | fs.Denied | fs.Failed,
	remove        func(path string) fails fs.NotFound | fs.Denied | fs.Failed,
	mkdir         func(path string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed | fs.Exists,
	mapBounded    func(path string, limit int) fs.Mapped fails fs.NotFound | fs.Denied | fs.Failed | fs.NotRegular | fs.TooLarge,
	sameAs        func(m fs.Mapped, path string) bool fails fs.NotFound | fs.Denied | fs.Failed,
} implements Maps

// NewHost is the Maps of the host file system h.
func NewHost(h fs.Host) Host {
	Host{
		readFile: func(path string) string fails fs.NotFound | fs.Denied | fs.Failed { try fs.ReadFile(h, path) },
		readDir: func(path string) []string fails fs.NotFound | fs.Denied | fs.Failed { try fs.ReadDir(h, path) },
		stat: func(path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed { try fs.Stat(h, path) },
		lstat: func(path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed { try fs.Lstat(h, path) },
		writeFile: func(path string, text string) fails fs.NotFound | fs.Denied | fs.Failed { try fs.WriteFile(h, path, text) },
		mkdirAll: func(path string) fails fs.Denied | fs.Failed { try fs.MkdirAll(h, path) },
		writeFileMode: func(path string, text string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed { try fs.WriteFileMode(h, path, text, mode) },
		mkdirAllMode: func(path string, mode fs.Mode) fails fs.Denied | fs.Failed { try fs.MkdirAllMode(h, path, mode) },
		appendFile: func(path string, text string) fails fs.NotFound | fs.Denied | fs.Failed { try fs.AppendFile(h, path, text) },
		chmod: func(path string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed { try fs.Chmod(h, path, mode) },
		rename: func(from string, to string) fails fs.NotFound | fs.Denied | fs.Failed { try fs.Rename(h, from, to) },
		remove: func(path string) fails fs.NotFound | fs.Denied | fs.Failed { try fs.Remove(h, path) },
		mkdir: func(path string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed | fs.Exists { try fs.Mkdir(h, path, mode) },
		mapBounded: func(path string, limit int) fs.Mapped fails fs.NotFound | fs.Denied | fs.Failed | fs.NotRegular | fs.TooLarge { try fs.MapBounded(h, path, limit) },
		sameAs: func(m fs.Mapped, path string) bool fails fs.NotFound | fs.Denied | fs.Failed { try fs.SameAs(h, m, path) },
	}
}

// NewTestHost is the Maps of the case's folder (fs.NewTestHost).
func NewTestHost() Host needs TestAmbient { NewHost(fs.NewTestHost()) }

// OnTestHost runs Maps's laws on the host, in a folder of the case's own.
let OnTestHost = context needs TestAmbient { Maps: NewTestHost() }

func ReadFile(h Host, path string) string fails fs.NotFound | fs.Denied | fs.Failed { try h.readFile(path) }

func ReadDir(h Host, path string) []string fails fs.NotFound | fs.Denied | fs.Failed { try h.readDir(path) }

func Stat(h Host, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed { try h.stat(path) }

func Lstat(h Host, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed { try h.lstat(path) }

func WriteFile(h Host, path string, text string) fails fs.NotFound | fs.Denied | fs.Failed { try h.writeFile(path, text) }

func MkdirAll(h Host, path string) fails fs.Denied | fs.Failed { try h.mkdirAll(path) }

func WriteFileMode(h Host, path string, text string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed { try h.writeFileMode(path, text, mode) }

func MkdirAllMode(h Host, path string, mode fs.Mode) fails fs.Denied | fs.Failed { try h.mkdirAllMode(path, mode) }

func AppendFile(h Host, path string, text string) fails fs.NotFound | fs.Denied | fs.Failed { try h.appendFile(path, text) }

func Chmod(h Host, path string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed { try h.chmod(path, mode) }

func Rename(h Host, from string, to string) fails fs.NotFound | fs.Denied | fs.Failed { try h.rename(from, to) }

func Remove(h Host, path string) fails fs.NotFound | fs.Denied | fs.Failed { try h.remove(path) }

func Mkdir(h Host, path string, mode fs.Mode) fails fs.NotFound | fs.Denied | fs.Failed | fs.Exists { try h.mkdir(path, mode) }

func MapBounded(h Host, path string, limit int) fs.Mapped fails fs.NotFound | fs.Denied | fs.Failed | fs.NotRegular | fs.TooLarge { try h.mapBounded(path, limit) }

func SameAs(h Host, m fs.Mapped, path string) bool fails fs.NotFound | fs.Denied | fs.Failed { try h.sameAs(m, path) }

func boundedIsTheText(text string) bool needs Maps {
	Maps.WriteFile("f", text) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	let m = Maps.MapBounded("f", len(text)) catch {
	case fs.NotFound, fs.Denied, fs.Failed, fs.NotRegular, fs.TooLarge:
		return false
	}
	let same = Maps.SameAs(m, "f") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		false
	}
	let physical = Maps.SameAs(m, m.PhysicalPath()) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		false
	}
	let ok = same && physical && m.Size() == len(text) && fs.Clone(m.Text()) == text
	m.Close()
	ok
}

func overLimitIsTooLarge(text string) bool needs Maps {
	if len(text) == 0 {
		return true
	}
	Maps.WriteFile("f", text) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	let m = Maps.MapBounded("f", len(text)-1) catch {
	case fs.TooLarge as t:
		return t.Size == len(text) && t.Limit == len(text)-1
	case fs.NotFound, fs.Denied, fs.Failed, fs.NotRegular:
		return false
	}
	m.Close()
	false
}

func dirIsNotRegular(limit int) bool needs Maps {
	Maps.MkdirAll("d") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	let m = Maps.MapBounded("d", limit) catch {
	case fs.NotRegular:
		return true
	case fs.NotFound, fs.Denied, fs.Failed, fs.TooLarge:
		return false
	}
	m.Close()
	false
}

func replacedIsNotSame(a string, b string) bool needs Maps {
	Maps.WriteFile("f", a) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	let m = Maps.MapBounded("f", len(a)) catch {
	case fs.NotFound, fs.Denied, fs.Failed, fs.NotRegular, fs.TooLarge:
		return false
	}
	// WriteFile writes a new file and renames it over f.
	Maps.WriteFile("f", b) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		m.Close()
		return false
	}
	let same = Maps.SameAs(m, "f") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		true
	}
	let ok = !same && fs.Clone(m.Text()) == a
	m.Close()
	ok
}
