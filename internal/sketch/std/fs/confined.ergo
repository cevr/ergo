// The host file system of a test (TestAmbient; docs/spec/rows.md,
// Test's ambient): NewTestHost is a Host confined to the case's folder. A
// relative path is relative to the folder; an absolute path must lie in
// it. A path that leads out of the folder, by "..", by an absolute path
// elsewhere or through a symbolic link that points out, is refused with
// Denied of the path as written, before anything is read or written.

// NewTestHost is the Host of the case's folder: Files and Writes on the
// real disk, for a test. It needs the test's ambient, which only the test
// runner provides, to a context that states it:
// `context needs TestAmbient { fs.Files: fs.NewTestHost() }`.
func NewTestHost() Host needs TestAmbient { Host{root: TestFolder()} }

// at is path as the host's body gets it: itself for the host's own Host,
// and resolved in the folder, or Denied, for a test's.
func at(h Host, path string) string fails Denied {
	if h.root == "" {
		return path
	}
	try confine(h.root, path)
}

extern go ergo.local/prototype/runtime/v1.FSConfine func confine(root string, path string) string fails Denied

// atLast is at for an operation on path itself, as Go's Lstat, Remove,
// Rename, Readlink and Symlink are: a test's Host resolves the directory
// above path and not its last element, so a link there is the link and
// never what it leads to (a walk lists it, a removal removes it).
func atLast(h Host, path string) string fails Denied {
	if h.root == "" {
		return path
	}
	try confineLast(h.root, path)
}

extern go ergo.local/prototype/runtime/v1.FSConfineLast func confineLast(root string, path string) string fails Denied

// TestRootFolder is the sealed directory of this case.
func TestRootFolder() TestDirectory needs TestAmbient { TestFolderHandle() }

// OpenTestRoot opens dir below the case folder. The runner closes the
// handle when the case ends.
extern go ergo.local/prototype/runtime/v1.FSOpenTestRoot func OpenTestRoot(folder TestDirectory, dir string) HostRoot fails NotFound | Denied | Failed needs TestAmbient

let onTestRoot = context fails NotFound | Denied | Failed needs TestAmbient {
	Root: try OpenTestRoot(TestRootFolder(), "."),
}

type rootOpeningCheck {
	DeniedOutside() bool,
	law OpeningIsConfined() {
		rootOpeningCheck.DeniedOutside()
	},
}

type openingVerdict { denied bool } implements rootOpeningCheck

func DeniedOutside(v openingVerdict) bool { v.denied }

func openingDenied(folder TestDirectory, path string) bool needs TestAmbient {
	let _ = OpenTestRoot(folder, path) catch {
	case Denied as d:
		return d.Path == path
	case NotFound, Failed:
		return false
	}
	false
}

func checkOutsideOpening() openingVerdict fails NotFound | Denied | Failed | Escapes needs TestAmbient {
	let folder = TestRootFolder()
	let inside = try OpenTestRoot(folder, ".")
	let empty = (try inside.ReadDir(".")).Len() == 0
	try Symlink(NewTestHost(), "..", "to-parent")
	openingVerdict{denied: empty && openingDenied(folder, "..") && openingDenied(folder, "to-parent") && openingDenied(folder, TestFolder())}
}

let outsideTestRoot = context fails NotFound | Denied | Failed | Escapes needs TestAmbient {
	rootOpeningCheck: try checkOutsideOpening(),
}
