// Package csv reads and writes comma-separated values as Go's
// encoding/csv does (docs/spec/stdlib.md, csv; std-csv U4): RFC 4180
// quotes, a quote written twice inside a quoted field, CR LF read as LF,
// LazyQuotes off, and every record holding as many fields as the first.
// Its bodies are encoding/csv over the text, so they read no host state.
// Rules that differ from Go, each for a guarantee:
//   - ReadAll fails ParseError, a record in the row, not an error value;
//   - Rows is a Seq of the union Row, so a stream of records ends in a
//     Malformed row a match must cover, where Go's Read returns an error
//     beside the record;
//   - Format writes a row of one empty field as "", where Go writes an
//     empty line that a reader skips, so every row with a field reads back.

import core
import slices
import strings

// ParseError is the failure of ReadAll, Go's *csv.ParseError: Line and
// Column (bytes, from 1) are where the text breaks the format, Reason is
// Go's reason ("wrong number of fields", "bare \" in non-quoted field")
// and Message Go's whole text of the error.
extern go ergo.local/prototype/runtime/v1/csv.CSVParseError type ParseError { Line int, Column int, Reason string, Message string }

// Position is where a field starts in the text, as Go's Reader.FieldPos
// gives it: Line and Column count from 1, and Column counts bytes, as in
// ParseError. A quoted field starts at its opening quote, and a field may
// start on a later line than its record when a quoted field before it
// spans lines.
extern go ergo.local/prototype/runtime/v1/csv.CSVPosition type Position { Line int, Column int }

// Parsed is one record of a text: its fields, and where each starts
// (At[i] is the start of Fields[i]), so a program that finds a bad value
// in a field names its line and column, as ParseError does.
type Parsed { Fields []string, At []Position }

// Malformed is the end of a text that breaks the format: the error Go's
// reader stops at.
type Malformed { Error ParseError }

// Row is one step of Rows: a record, or the error that ends the text.
type Row = Parsed | Malformed

// ReadAll is every record of text, as Go's
// csv.NewReader(strings.NewReader(text)).ReadAll(), or its first error.
// A text with no record is no rows.
extern go ergo.local/prototype/runtime/v1/csv.CSVReadAll func ReadAll(text string) [][]string fails ParseError

// RoundTrip: rows that ReadAll can give format to a text that reads back
// to the same rows.
law RoundTrip(rows [][]string) {
	let kept = sample(rows)
	let back = ReadAll(Format(kept)) catch {
	case ParseError:
		return false
	}
	same(back, kept)
}

// spice is s with a b z A Z turned into , " LF CR and CR LF, the bytes the
// format gives a meaning, so a generated text holds them.
func spice(s string) string {
	let crlf = strings.ReplaceAll(s, "Z", "\r\n")
	let cr = strings.ReplaceAll(crlf, "A", "\r")
	let lf = strings.ReplaceAll(cr, "z", "\n")
	let quote = strings.ReplaceAll(lf, "b", "\"")
	strings.ReplaceAll(quote, "a", ",")
}

// lf is s with no CR before a LF: the reader reads a CR LF that ends a
// line as LF, once, so "\r\r\n" reads as "\r\n" and only a field with no
// CR LF reads back as written.
func lf(s string) string {
	let mut out = s
	for strings.Contains(out, "\r\n") {
		out = strings.ReplaceAll(out, "\r\n", "\n")
	}
	out
}

// sample is rows as ReadAll can give them: spiced fields with no CR LF
// (lf), no row of no field, and every row as wide as the first (the reader
// holds the first row's width).
func sample(rows [][]string) [][]string {
	let mut out = [][]string{}
	let mut width = 0
	for fields in rows {
		if fields.Len() == 0 {
			continue
		}
		if width == 0 {
			width = fields.Len()
		}
		let mut row = []string{}
		for i in 0..width {
			let f = if i < fields.Len() { fields[i] } else { "" }
			row = row.Append(lf(spice(f)))
		}
		out = out.Append(row)
	}
	out
}

// Format is rows as text, as Go's csv.Writer writes them: fields joined by
// commas, each row ended by a line feed, and a field quoted, its quotes
// written twice, when it holds a comma, a quote, a CR or a LF, or starts
// with a space. A row of one empty field is "" (Go writes an empty line);
// a row of no field is an empty line, which ReadAll skips.
extern go ergo.local/prototype/runtime/v1/csv.CSVFormat func Format(rows [][]string) string

// LinesCount: Format writes one line per row, and one more for each line
// feed in a field.
law LinesCount(rows [][]string) {
	let kept = sample(rows)
	let mut lines = kept.Len()
	for fields in kept {
		for f in fields {
			lines = lines + strings.Count(f, "\n")
		}
	}
	strings.Count(Format(kept), "\n") == lines
}

// FormatIsStable: formatting what ReadAll read from Format's text gives
// the text again.
law FormatIsStable(rows [][]string) {
	let text = Format(sample(rows))
	let back = ReadAll(text) catch {
	case ParseError:
		return false
	}
	Format(back) == text
}

// PositionsPointAtFields: Rows gives each field where it starts: one
// position per field, each after the one before, and at it the field's
// text, or the quote that opens it.
law PositionsPointAtFields(rows [][]string) {
	let text = Format(sample(rows))
	let lines = strings.Split(text, "\n")
	let mut last = Position{Line: 0, Column: 0}
	for r in Rows(text) {
		match r {
		case Parsed as p:
			if p.At.Len() != p.Fields.Len() {
				return false
			}
			for i, at in p.At {
				if at.Line < 1 || at.Line < last.Line || at.Line == last.Line && at.Column <= last.Column || at.Line > lines.Len() {
					return false
				}
				last = at
				let line = lines[at.Line-1]
				if at.Column < 1 || at.Column > line.Len()+1 {
					return false
				}
				let rest = strings.Slice(line, at.Column-1, line.Len())
				if !strings.HasPrefix(rest, "\"") && !strings.HasPrefix(rest, p.Fields[i]) {
					return false
				}
			}
		case Malformed:
			return false
		}
	}
	true
}

// Rows is the records of text, each a Parsed, then a Malformed with the
// error when the text breaks the format: the rows ReadAll gives, or the
// records before ReadAll's error and the error. A Seq cannot fail, so the
// error is a row. Rows reads the text lazily, in one pass, as Go's
// Reader.Read loop does: each record is read when the loop asks for it,
// and a stop reads no further record (fs3).
func Rows(text string) core.Seq[Row] {
	core.Seq[Row](func(yield func(r Row) bool) {
		let e = scan(text, func(fields []string, at []Position) bool { yield(Parsed{Fields: fields, At: at}) })
		if e.Reason != "" {
			yield(Malformed{Error: e})
		}
	})
}

// RowsStops: Rows is a Seq that stops (stdlib.md, Std laws 5): with n the
// count of rows a yield that always returns true gets, for each k from 1
// to n+1, a yield that returns false at its k-th call is called min(k, n)
// times.
law RowsStops(s string) {
	let rows = Rows(spice(s))
	let mut n = 0
	rows(func(r Row) bool {
		n = n + 1
		true
	})
	for k in 1..n+2 {
		let mut calls = 0
		rows(func(r Row) bool {
			calls = calls + 1
			calls < k
		})
		if calls != (if k < n { k } else { n }) {
			return false
		}
	}
	true
}

// RowsKeepTheRecordsBefore: rows that read, then a bare quote in a field
// that is not quoted, are the rows as Parsed, then one Malformed.
law RowsKeepTheRecordsBefore(rows [][]string) {
	let kept = sample(rows)
	let mut parsed = [][]string{}
	let mut ends = 0
	for r in Rows(Format(kept) + "x\"y\n") {
		match r {
		case Parsed as p:
			parsed = parsed.Append(p.Fields)
		case Malformed:
			ends = ends + 1
		}
	}
	ends == 1 && same(parsed, kept)
}

// RowsFollowReadAll: Rows gives ReadAll's rows when it reads the text, and
// otherwise ends in one Malformed with ReadAll's error.
law RowsFollowReadAll(text string) {
	let t = spice(text)
	let mut parsed = [][]string{}
	let mut ends = 0
	let mut last = ParseError{Line: 0, Column: 0, Reason: "", Message: ""}
	for r in Rows(t) {
		match r {
		case Parsed as p:
			if ends > 0 {
				return false
			}
			parsed = parsed.Append(p.Fields)
		case Malformed as m:
			ends = ends + 1
			last = m.Error
		}
	}
	let all = ReadAll(t) catch {
	case ParseError as e:
		return ends == 1 && last == e
	}
	ends == 0 && same(parsed, all)
}

// scan calls each with every record of text and where each of its fields
// starts, in order, until each returns false or the text ends, and gives
// the error Go's reader stopped at, or a ParseError with no Reason when
// there was none or each stopped.
extern go ergo.local/prototype/runtime/v1/csv.CSVScan func scan(text string, each func(fields []string, at []Position) bool) ParseError

// same reports whether a and b hold the same fields in the same rows.
func same(a [][]string, b [][]string) bool {
	if a.Len() != b.Len() {
		return false
	}
	for i in 0..a.Len() {
		if !slices.Equal(a[i], b[i]) {
			return false
		}
	}
	true
}
