// Package tasks runs a function over many values at once (docs/spec/
// stdlib.md, Tasks; #207). Transform is the first: Effect's Effect.forEach
// with { concurrency }, Go's errgroup.Group with SetLimit. Its name is
// slices.Transform's, the concurrent form of it: Map is the prelude's type,
// which no package redeclares (#196). Race is Effect's raceAll. Set is
// runtime.md G4's.

import schedule
import scope
import sync
import testing
import time

// Race runs each block on a task of its own, and the first block to end
// decides: Race gives its value, or fails with its failure. The other
// blocks are stopped, and Race returns only after each has ended, its exit
// actions included. Blocks that end at the same instant, before the stop
// reaches them, tie, and the earliest of them in blocks wins. A loser's
// failure is dropped; a defect in any block is raised. A stop of the
// calling task stops every block. Race of no blocks is a defect.
//
// A loser may end its work before the stop reaches it, so a race of two
// queue Pops can take a value from the losing queue and drop it. To wait
// for whichever of two sources has a value, give the task one queue of a
// union that every source pushes to (the inbox pattern) instead. A value
// a loser returned is released when T holds a resource, and so is every
// value when Race fails (Gap 47).
extern go ergo.local/prototype/runtime/v1.TasksRace func Race[T, E, R](blocks []func() T fails E needs R) T fails E needs R

// Retry runs block until it gives a value or s stops (Effect retry): after
// the n-th run fails, s decides by n and the time since the first run
// began on the context's time.Clock; Continue sleeps its delay on the
// context's Scheduler and runs block again, and Stop fails with that run's
// failure. A defect or a stop of the task ends Retry at once. s does not
// read the failure: a failure that must not be retried is caught in block
// and given as a value of block's result.
func Retry[T, E, R](s schedule.Schedule, block func() T fails E needs R) T fails E needs R | Scheduler | time.Clock {
	let start = time.Clock.Now()
	let mut runs = 0
	for {
		runs = runs + 1
		let v = block() catch {
		case err:
			match schedule.Decide(s, runs, time.Clock.Now().Sub(start)) {
			case schedule.Continue as c:
				Scheduler.Sleep(c.After)
				continue
			case schedule.Stop:
				return err
			}
		}
		return v
	}
}

// Repeat runs block, and again while s continues (Effect repeat): after
// the n-th run gives a value, s decides by n and the time since the first
// run began; Continue sleeps its delay, and Stop gives the last value. A
// failure of block is Repeat's at once.
func Repeat[T, E, R](s schedule.Schedule, block func() T fails E needs R) T fails E needs R | Scheduler | time.Clock {
	let start = time.Clock.Now()
	let mut runs = 0
	for {
		runs = runs + 1
		let v = try block()
		match schedule.Decide(s, runs, time.Clock.Now().Sub(start)) {
		case schedule.Continue as c:
			Scheduler.Sleep(c.After)
		case schedule.Stop:
			return v
		}
	}
}

// lawFailed is the failure of the retry laws' block: the run that failed.
type lawFailed { Run int }

// lawSchedule is an exponential backoff from 10ms, at most 1 to 6
// retries, up to a limit of 1ms to 5s, drawn from k and limit.
func lawSchedule(k int, limit int) schedule.Schedule {
	let retries = schedule.Recurs(1 + (k%6+6)%6)
	let l = duration(int64(1+(limit%5000+5000)%5000) * 1000000)
	schedule.Exponential(10ms, 2.0, 1s).And(retries).UpTo(l)
}

// RetryFollowsDecide: on a VirtualClock, Retry runs block as often as
// Decide says, sleeps the delays it gives, and ends with the run the fold
// of Decide ends with: the first run that does not fail, or the failure
// of the run after which Decide stops. Each run takes w.
law RetryFollowsDecide(failing int, work int, k int, limit int) {
	let s = lawSchedule(k, limit)
	let w = duration(int64((work%300+300)%300) * 1000000)
	let n = (failing%10 + 10) % 10
	let mut runs = 0
	let mut at = 0s
	let mut want = 0
	for want == 0 {
		runs = runs + 1
		at = at + w
		if runs > n {
			want = runs
		} else {
			match schedule.Decide(s, runs, at) {
			case schedule.Continue as c:
				at = at + c.After
			case schedule.Stop:
				want = 0 - runs
			}
		}
	}
	let c = testing.NewVirtualClock(0)
	let calls = sync.NewRef[int](0)
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		let got = Retry(s, func() int fails lawFailed needs Scheduler {
			Scheduler.Sleep(w)
			let i = sync.Modify(calls, func(v int) (int, int) { (v + 1, v + 1) })
			if i <= n {
				return lawFailed{Run: i}
			}
			i
		}) catch {
		case lawFailed as f:
			0 - f.Run
		}
		got == want && calls.Get() == runs && time.Clock.Now().Sub(start) == at
	}
}

// RepeatFollowsDecide: on a VirtualClock, Repeat runs block until Decide
// stops, sleeps the delays it gives, and gives the last run's value. Each
// run takes w.
law RepeatFollowsDecide(work int, k int, limit int) {
	let s = lawSchedule(k, limit)
	let w = duration(int64((work%300+300)%300) * 1000000)
	let mut runs = 0
	let mut at = 0s
	let mut more = true
	for more {
		runs = runs + 1
		at = at + w
		match schedule.Decide(s, runs, at) {
		case schedule.Continue as c:
			at = at + c.After
		case schedule.Stop:
			more = false
		}
	}
	let c = testing.NewVirtualClock(0)
	let calls = sync.NewRef[int](0)
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		let got = Repeat(s, func() int needs Scheduler {
			Scheduler.Sleep(w)
			sync.Modify(calls, func(v int) (int, int) { (v + 1, v + 1) })
		})
		got == runs && calls.Get() == runs && time.Clock.Now().Sub(start) == at
	}
}

// Transform is f of each element of xs, in the order of xs, with each
// call on a task of its own and at most limit calls running at once. It
// waits for whichever call ends first: when one fails, no call starts
// after it, the calls still running are stopped and waited for, and
// Transform fails with that failure. Every task it starts has ended when
// it returns. A stop of the calling task stops every call. A limit below 1
// is a defect. The calls share f's providers, which the caller's row
// binds.
extern go ergo.local/prototype/runtime/v1.TasksTransform func Transform[A, B, E, R](xs []A, limit int, f func(x A) B fails E needs R) []B fails E needs R

// Closed is the failure of Go on a Set that admits no more tasks: FailFast
// ended it, or it was stopped. Like queue.Closed, it is a normal end of
// the protocol, not a stop of the caller.
type Closed {}

// FailFast is the policy under which the first failure or defect of a
// member ends the Set: admission closes, the other members are stopped,
// and Wait gives it.
type FailFast {}

// LogFailures is the policy under which a member's failure or defect is
// written to the program's standard error, as main's exit report writes
// it, and dropped; the Set goes on. A server's handlers use it: one
// handler's end is not the server's.
type LogFailures {}

// Restart is the policy under which a member's defect runs its body again,
// on the same task, up to Limit times for each Go. A typed failure, and
// the defect after the last restart, end the Set as under FailFast. A
// negative Limit is a defect.
type Restart {
	Limit int,
}

// Policy is what a member's failure or defect does to its Set. A member
// stopped by its Set or by its owner has no failure under any policy.
type Policy = FailFast | LogFailures | Restart

// Set owns any number of tasks, each started by Go and dropped when it
// ends (docs/spec/runtime.md, G4). The frame that made it owns it, as a
// frame owns a Task: the frame's end stops every member and waits for
// it, a return moves the Set to the caller, and no block or other task
// may hold it. Only the task that made it calls its operations.
type Set[E] {
	runtimeOnly(),
	// Wait waits until no member runs. It fails with the failure that
	// ended the Set, at this Wait and at each later one, and raises the
	// defects of members that no Wait or Stop raised yet. A stop of the
	// caller ends the wait.
	Wait() fails E,
	// Stop closes admission, stops every member and waits until each has
	// ended, its exit actions included. It raises the members' defects
	// and drops their failures.
	Stop(),
	// Close is the Set's release (#197 L8 B3t; resources R1): its owner's
	// scope calls it at the scope's end. It is Stop; a Set is a resource.
	Close(),
	// Len is how many members run now.
	Len() int,

	// StopEndsEveryMember: after Stop no member runs, and a second Stop
	// returns and changes nothing.
	law StopEndsEveryMember() {
		Stop()
		Stop()
		Len() == 0
	},
}

// NewSet is an empty Set with the policy p, owned by the calling frame.
func NewSet[E](p Policy) Set[E] {
	match p {
	case FailFast:
		newSet(0, 0)
	case LogFailures:
		newSet(1, 0)
	case Restart as r:
		newSet(2, r.Limit)
	}
}

extern go ergo.local/prototype/runtime/v1.TasksNewSet func newSet[E](kind int, limit int) Set[E]

// Go starts body as a member of set, on a task of its own below the
// caller's, and returns at once. The body keeps running after Go returns,
// so it is escaping. It fails with Closed, and starts nothing, when set
// admits no more tasks.
extern go ergo.local/prototype/runtime/v1.TasksGo func Go[E, R](set Set[E], body escaping func() fails E needs R) fails Closed needs R

// setFailed is the failure of a member in the Set laws.
type setFailed {}

// sleepers starts k members of a Set it owns, each counting itself in,
// counting itself out in an exit action and sleeping an hour, and
// returns after a second: its frame's end stops them.
func sleepers(k int, started sync.Ref[int], running sync.Ref[int]) needs Scheduler {
	let set = NewSet(FailFast)
	for _ in 0..k {
		Go(set, func() needs Scheduler {
			started.Update(func(v int) int { v + 1 })
			running.Update(func(v int) int { v + 1 })
			scope.OnExit() { running.Update(func(v int) int { v - 1 }) }
			Scheduler.Sleep(1h)
		}) catch {
		case Closed:
		}
	}
	Scheduler.Sleep(1s)
}

// NoMemberOutlivesItsFrame: when the function that made a Set returns,
// every member has ended, its exit actions included, though each would
// sleep an hour; the return does not wait the hour out.
law NoMemberOutlivesItsFrame(n int) {
	let k = limitOf(n)
	let c = testing.NewVirtualClock(0)
	let started = sync.NewRef[int](0)
	let running = sync.NewRef[int](0)
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		sleepers(k, started, running)
		started.Get() == k && running.Get() == 0 && time.Clock.Now().Sub(start) == 1s
	}
}

// FinishedAreDropped: a member that ends leaves its Set with no Wait: Len
// counts the members running, and is 0 once each has ended.
law FinishedAreDropped(n int) {
	let k = limitOf(n)
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let set = NewSet(FailFast)
		for i in 0..k {
			Go(set, func() needs Scheduler { Scheduler.Sleep(duration(int64(i + 1))) }) catch {
			case Closed:
			}
		}
		let before = set.Len()
		Scheduler.Sleep(duration(int64(k + 1)))
		before == k && set.Len() == 0
	}
}

// FailFastStopsTheRest: under FailFast, the first failure stops the other
// members, and Wait fails with it at its instant, not after the others'
// sleeps; then Go fails Closed.
law FailFastStopsTheRest(n int) {
	let k = limitOf(n)
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let set = NewSet[setFailed](FailFast)
		let start = time.Clock.Now()
		for _ in 0..k {
			Go(set, func() needs Scheduler { Scheduler.Sleep(1h) }) catch {
			case Closed:
			}
		}
		Go(set, func() fails setFailed needs Scheduler {
			Scheduler.Sleep(1s)
			return setFailed
		}) catch {
		case Closed:
		}
		set.Wait() catch {
		case setFailed:
			return time.Clock.Now().Sub(start) == 1s && set.Len() == 0 && closedNow(set)
		}
		false
	}
}

// closedNow reports whether Go on set fails Closed.
func closedNow(set Set[setFailed]) bool {
	Go(set, func() {}) catch {
	case Closed:
		return true
	}
	false
}

// RestartRunsAgain: under Restart, a member whose body has a defect runs
// again, Limit times, and the run after them ends it.
law RestartRunsAgain(n int) {
	let limit = limitOf(n) - 1
	let runs = sync.NewRef[int](0)
	let set = NewSet(Restart{Limit: limit})
	Go(set, func() {
		let r = sync.Modify(runs, func(v int) (int, int) { (v + 1, v + 1) })
		if r <= limit {
			Unreachable("a defect the Set restarts")
		}
	}) catch {
	case Closed:
	}
	set.Wait()
	runs.Get() == limit + 1
}

// limitOf is a limit from 1 to 4, drawn from k.
func limitOf(k int) int { 1 + (k%4+4)%4 }

// TransformEqualsLoop: with no failure, Transform gives what a loop over xs gives.
law TransformEqualsLoop(xs []int, k int) {
	let got = Transform(xs, limitOf(k), func(x int) int { x*3 - 1 })
	let mut ok = len(got) == len(xs)
	for i in 0..len(xs) {
		ok = ok && got[i] == xs[i]*3-1
	}
	ok
}

// TransformKeepsOrder: the results are in the order of xs, not the order the
// calls end. Each call sleeps longer the earlier its element, on a
// VirtualClock, so the calls end last to first.
law TransformKeepsOrder(xs []int, k int) {
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let n = len(xs)
		let mut idx = []int{}
		for i in 0..n {
			idx = idx.Append(i)
		}
		let got = Transform(idx, limitOf(k), func(i int) int needs Scheduler {
			Scheduler.Sleep(duration(int64(n - i)))
			xs[i]
		})
		let mut ok = len(got) == n
		for i in 0..n {
			ok = ok && got[i] == xs[i]
		}
		ok
	}
}

// LimitHolds: at most limit calls run at once, and limit of them do when
// xs has that many. Each call counts itself in while it sleeps on a
// VirtualClock, so every call started before the clock moves overlaps.
law LimitHolds(xs []int, k int) {
	let limit = limitOf(k)
	let c = testing.NewVirtualClock(0)
	let running = sync.NewRef[int](0)
	let most = sync.NewRef[int](0)
	with context { Scheduler: c, time.Clock: c } {
		let got = Transform(xs, limit, func(x int) int needs Scheduler {
			let now = sync.Modify(running, func(v int) (int, int) { (v + 1, v + 1) })
			most.Update(func(m int) int {
				if now > m {
					return now
				}
				m
			})
			Scheduler.Sleep(1s)
			running.Update(func(v int) int { v - 1 })
			x
		})
		let want = if len(xs) < limit { len(xs) } else { limit }
		len(got) == len(xs) && most.Get() == want && running.Get() == 0
	}
}

// EarliestWins: on a VirtualClock, the block with the shortest sleep wins,
// the earliest of them on a tie, and Race returns at that instant: the
// longer sleeps were stopped, not waited out.
law EarliestWins(ds []int) {
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let mut blocks = []func() int needs Scheduler{}
		let mut best = 0
		let mut sleeps = []int{}
		for d in ds.Append(0) {
			let i = len(sleeps)
			let s = 1 + (d%5+5)%5
			sleeps = sleeps.Append(s)
			if s < sleeps[best] {
				best = i
			}
			blocks = blocks.Append(func() int needs Scheduler {
				Scheduler.Sleep(duration(int64(s)))
				i
			})
		}
		let start = time.Clock.Now()
		let won = Race(blocks)
		won == best && time.Clock.Now().Sub(start) == duration(int64(sleeps[best]))
	}
}

// LosersStopped: Race returns after every loser has ended, its exit
// actions included: a loser that sleeps an hour is stopped, and its
// cleanup has run when Race returns.
law LosersStopped(n int) {
	let c = testing.NewVirtualClock(0)
	let cleaned = sync.NewRef[int](0)
	with context { Scheduler: c, time.Clock: c } {
		let won = Race([]func() int needs Scheduler{
			func() int needs Scheduler {
				scope.OnExit() { cleaned.Update(func(v int) int { v + 1 }) }
				Scheduler.Sleep(1h)
				0
			},
			func() int needs Scheduler { n },
		})
		won == n && cleaned.Get() == 1
	}
}
