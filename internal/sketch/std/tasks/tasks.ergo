// Package tasks runs a function over many values at once (docs/spec/
// stdlib.md, Tasks; #207). Transform is the first: Effect's Effect.forEach
// with { concurrency }, Go's errgroup.Group with SetLimit. Its name is
// slices.Transform's, the concurrent form of it: Map is the prelude's type,
// which no package redeclares (#196). Race is Effect's raceAll. Set is
// runtime.md G4's.

import schedule
import scope
import sync
import testing
import time

// Race runs each block on a task of its own, and the first block to end
// decides: Race gives its value, or fails with its failure. The other
// blocks are stopped, and Race returns only after each has ended, its exit
// actions included. Blocks that end at the same instant, before the stop
// reaches them, tie, and the earliest of them in blocks wins. A loser's
// failure is dropped; a defect in any block is raised. A stop of the
// calling task stops every block. Race of no blocks is a defect.
//
// A loser may end its work before the stop reaches it, so a race of two
// queue Pops can take a value from the losing queue and drop it. To wait
// for whichever of two sources has a value, give the task one queue of a
// union that every source pushes to (the inbox pattern) instead. A value
// a loser returned is released when T holds a resource, and so is every
// value when Race fails (Gap 47).
extern go ergo.local/prototype/runtime/v1.TasksRace func Race[T own, E, R](blocks []func() T fails E needs R) T fails E needs R

// Retry runs block until it gives a value or s stops (Effect retry): after
// the n-th run fails, s decides by n and, if timed, the time since the
// first run began on the context's time.Clock. Continue sleeps its delay
// on the context's Scheduler and runs block again; Stop fails with that
// run's failure. A defect or a stop of the task ends Retry at once. s does not
// read the failure: a failure that must not be retried is caught in block
// and given as a value of block's result.
func Retry[T, E, R](s schedule.Schedule, block func() T fails E needs R) T fails E needs R | Scheduler | time.Clock {
	let start = startOf(s)
	let mut runs = 0
	for {
		runs = runs + 1
		let v = block() catch {
		case err:
			match schedule.Decide(s, runs, since(start)) {
			case schedule.Continue as c:
				Scheduler.Sleep(c.After)
				continue
			case schedule.Stop:
				return err
			}
		}
		return v
	}
}

// Repeat runs block, and again while s continues (Effect repeat): after
// the n-th run gives a value, s decides by n and, if timed, the time since
// the first run began. Continue sleeps its delay; Stop gives the last
// value. A failure of block is Repeat's at once.
func Repeat[T, E, R](s schedule.Schedule, block func() T fails E needs R) T fails E needs R | Scheduler | time.Clock {
	let start = startOf(s)
	let mut runs = 0
	for {
		runs = runs + 1
		let v = try block()
		match schedule.Decide(s, runs, since(start)) {
		case schedule.Continue as c:
			Scheduler.Sleep(c.After)
		case schedule.Stop:
			return v
		}
	}
}

// startOf reads the clock before the first run only if s uses elapsed time.
func startOf(s schedule.Schedule) Option[time.Time] needs time.Clock {
	if schedule.Timed(s) {
		Some[time.Time]{Value: time.Clock.Now()}
	} else {
		None
	}
}

// since reads elapsed time only when startOf captured a start.
func since(start Option[time.Time]) duration needs time.Clock {
	match start {
	case Some[time.Time] as t:
		time.Since(t.Value)
	case None:
		0s
	}
}

// lawFailed is the failure of the retry laws' block: the run that failed.
type lawFailed { Run int }

// lawSchedule draws a bounded backoff, with an elapsed limit only when timed.
func lawSchedule(k int, limit int, timed bool) schedule.Schedule {
	let retries = schedule.Recurs(1 + (k%6+6)%6)
	let s = schedule.Exponential(10ms, 2.0, 1s).And(retries)
	if timed {
		let l = duration(int64(1+(limit%500+500)%500) * 1000000)
		return s.UpTo(l)
	}
	s
}

// lawClock counts clock reads, but not sleeps or the law's own readings.
type lawClock { clock testing.VirtualClock, reads sync.Ref[int] } implements time.Clock

func newLawClock() lawClock {
	lawClock{clock: testing.NewVirtualClock(0), reads: sync.NewRef[int](0)}
}

func Now(c lawClock) time.Time {
	c.reads.Update(func(n int) int { n + 1 })
	c.clock.Now()
}

func Elapsed(c lawClock, start time.Time) duration { c.Now().Sub(start) }

// RetryFollowsDecide: on a VirtualClock, Retry runs block as often as
// Decide says, sleeps the delays it gives, and ends with the run the fold
// of Decide ends with: the first run that does not fail, or the failure
// of the run after which Decide stops. Only a timed schedule reads the
// clock, once at the start and once per decision.
law RetryFollowsDecide(failing int, work int, k int, limit int, timed bool) {
	let s = lawSchedule(k, limit, timed)
	let w = duration(int64(1+(work%300+300)%300) * 1000000)
	let n = (failing%10 + 10) % 10
	let mut runs = 0
	let mut decisions = 0
	let mut at = 0s
	let mut want = 0
	for want == 0 {
		runs = runs + 1
		at = at + w
		if runs > n {
			want = runs
		} else {
			decisions = decisions + 1
			match schedule.Decide(s, runs, at) {
			case schedule.Continue as c:
				at = at + c.After
			case schedule.Stop:
				want = 0 - runs
			}
		}
	}
	let p = newLawClock()
	let c = p.clock
	let calls = sync.NewRef[int](0)
	let start = c.Now()
	with context { Scheduler: c, time.Clock: p } {
		let got = Retry(s, func() int fails lawFailed needs Scheduler {
			Scheduler.Sleep(w)
			let i = sync.Modify(calls, func(v int) (int, int) { (v + 1, v + 1) })
			if i <= n {
				return lawFailed{Run: i}
			}
			i
		}) catch {
		case lawFailed as f:
			0 - f.Run
		}
		let wantReads = if timed { decisions + 1 } else { 0 }
		got == want && calls.Get() == runs && c.Elapsed(start) == at && p.reads.Get() == wantReads
	}
}

// RepeatFollowsDecide: on a VirtualClock, Repeat runs block until Decide
// stops, sleeps the delays it gives, and gives the last run's value. Only
// a timed schedule reads the clock, once at the start and once per decision.
law RepeatFollowsDecide(work int, k int, limit int, timed bool) {
	let s = lawSchedule(k, limit, timed)
	let w = duration(int64(1+(work%300+300)%300) * 1000000)
	let mut runs = 0
	let mut at = 0s
	let mut more = true
	for more {
		runs = runs + 1
		at = at + w
		match schedule.Decide(s, runs, at) {
		case schedule.Continue as c:
			at = at + c.After
		case schedule.Stop:
			more = false
		}
	}
	let p = newLawClock()
	let c = p.clock
	let calls = sync.NewRef[int](0)
	let start = c.Now()
	with context { Scheduler: c, time.Clock: p } {
		let got = Repeat(s, func() int needs Scheduler {
			Scheduler.Sleep(w)
			sync.Modify(calls, func(v int) (int, int) { (v + 1, v + 1) })
		})
		let wantReads = if timed { runs + 1 } else { 0 }
		got == runs && calls.Get() == runs && c.Elapsed(start) == at && p.reads.Get() == wantReads
	}
}

// Transform is f of each element of xs, in the order of xs, with each
// call on a task of its own and at most limit calls running at once. It
// waits for whichever call ends first: when one fails, no call starts
// after it, the calls still running are stopped and waited for, and
// Transform fails with that failure. Every task it starts has ended when
// it returns. A stop of the calling task stops every call. A limit below 1
// is a defect. The calls share f's providers, which the caller's row
// binds. f is escaping: its calls run on other tasks, at once, so a
// literal f writes no let mut of its caller (types.md, Function values 2
// and 3); a result it builds is its own.
extern go ergo.local/prototype/runtime/v1.TasksTransform func Transform[A, B own, E, R](xs []A, limit int, f own func(x A) B fails E needs R) []B fails E needs R

// Closed is the failure of Go on a Set that admits no more tasks: FailFast
// ended it, or it was stopped. Like queue.Closed, it is a normal end of
// the protocol, not a stop of the caller.
extern go ergo.local/prototype/runtime/v1.TasksClosed type Closed {}

// FailFast is the policy under which the first failure or defect of a
// member ends the Set: admission closes, the other members are stopped,
// and Wait gives it.
type FailFast {}

// LogFailures is the policy under which a member's failure or defect is
// written to the program's standard error, as main's exit report writes
// it, and dropped; the Set goes on. A server's handlers use it: one
// handler's end is not the server's.
type LogFailures {}

// Restart is the policy under which a member's defect runs its body again,
// on the same task, up to Limit times for each Go. A typed failure, and
// the defect after the last restart, end the Set as under FailFast. A
// negative Limit is a defect.
type Restart {
	Limit int,
}

// Policy is what a member's failure or defect does to its Set. A member
// stopped by its Set or by its owner has no failure under any policy.
type Policy = FailFast | LogFailures | Restart

// Restart strategies of a group (Erlang/OTP's one_for_one, one_for_all and
// rest_for_one; the model models/supervise, group.ergo). A group's members
// are numbered in start order.

// OneForOne restarts only the member that crashed.
type OneForOne {}

// AllForOne restarts every member when one crashes: members that depend
// on each other start again together.
type AllForOne {}

// RestForOne restarts the member that crashed and every member started
// after it: a later member may depend on an earlier one, never the
// reverse.
type RestForOne {}

// Strategy is which members a crash restarts.
type Strategy = OneForOne | AllForOne | RestForOne

// Restarted is whether a crash of member failed restarts member j, both
// numbered in start order.
func Restarted(s Strategy, failed int, j int) bool {
	match s {
	case OneForOne:
		j == failed
	case AllForOne:
		true
	case RestForOne:
		j >= failed
	}
}

// strategyOf is one of the three strategies, drawn from k.
func strategyOf(k int) Strategy {
	let i = (k%3 + 3) % 3
	if i == 0 {
		return OneForOne
	}
	if i == 1 {
		return AllForOne
	}
	RestForOne
}

// StrategiesNest: each strategy restarts the member that crashed; what
// OneForOne restarts, RestForOne restarts, and what RestForOne restarts,
// AllForOne restarts; AllForOne restarts every member, and RestForOne
// never one started before the crashed one.
law StrategiesNest(failed int, j int) {
	let f = (failed%8 + 8) % 8
	let m = (j%8 + 8) % 8
	let one = Restarted(OneForOne, f, m)
	let rest = Restarted(RestForOne, f, m)
	let all = Restarted(AllForOne, f, m)
	Restarted(OneForOne, f, f) && Restarted(RestForOne, f, f) && (!one || rest) && (!rest || all) && all && (m >= f || !rest)
}

// Intensity is a restart budget over time (OTP's intensity and period):
// at most Max restarts in any Period. A Period of zero or less holds no
// restart, so Max applies to nothing and every restart is allowed only
// when Max is above zero.
type Intensity {
	Max int,
	Period duration,
}

// Allows is whether a restart at now keeps at most i.Max restarts in the
// Period that ends at now, given the instants of the earlier restarts.
// Instants are durations since the group began; one in the Period is
// after now - Period and at or before now.
func Allows(i Intensity, past []duration, now duration) bool {
	let mut n = 0
	for t in past {
		if t > now-i.Period && t <= now {
			n = n + 1
		}
	}
	n < i.Max
}

// Recent is past without the instants that have left the Period ending at
// now: what a supervisor keeps, so it holds at most Max instants however
// long it runs.
func Recent(i Intensity, past []duration, now duration) []duration {
	let mut out = []duration{}
	for t in past {
		if t > now-i.Period && t <= now {
			out = out.Append(t)
		}
	}
	out
}

// intensityOf is a budget of 1 to 4 restarts in 1 to 10 seconds, drawn
// from k and p.
func intensityOf(k int, p int) Intensity {
	Intensity{Max: 1 + (k%4+4)%4, Period: duration(int64(1+(p%10+10)%10) * 1000000000)}
}

// instantsOf is gaps as instants: each one 0 to 3 seconds after the one
// before, from the start.
func instantsOf(gaps []int) []duration {
	let mut at = 0s
	let mut out = []duration{}
	for g in gaps {
		at = at + duration(int64((g%4+4)%4)*1000000000)
		out = out.Append(at)
	}
	out
}

// WindowForgets: a restart is allowed again once a whole Period has passed
// since the last restart, however many came before; and refused while Max
// of them are in the Period, as when Max restarts came at one instant.
law WindowForgets(gaps []int, k int, p int) {
	let i = intensityOf(k, p)
	let past = instantsOf(gaps)
	let last = if len(past) == 0 { 0s } else { past[len(past)-1] }
	let mut burst = []duration{}
	for _ in 0..i.Max {
		burst = burst.Append(last)
	}
	Allows(i, past, last+i.Period) && !Allows(i, burst, last)
}

// RecentKeepsTheVerdict: Recent drops only instants Allows does not
// count, now and at every later instant, and a group that restarts only
// when Allows says so keeps at most Max of them.
law RecentKeepsTheVerdict(gaps []int, k int, p int, later int) {
	let i = intensityOf(k, p)
	let past = instantsOf(gaps)
	let now = if len(past) == 0 { 0s } else { past[len(past)-1] }
	let then = now + duration(int64((later%5+5)%5)*1000000000)
	let mut kept = []duration{}
	for t in past {
		if Allows(i, kept, t) {
			kept = Recent(i, kept.Append(t), t)
		}
	}
	let r = Recent(i, past, now)
	Allows(i, r, now) == Allows(i, past, now) && Allows(i, Recent(i, past, now), then) == Allows(i, past, then) && len(kept) <= i.Max
}

// Supervision is how a group answers a member's crash: which members
// restart (Strategy), how many restarts it allows in a time (Intensity),
// and how long it waits before each (Backoff, decided with the restarts
// still in the window as its runs, so a quiet Period resets the backoff).
type Supervision {
	Strategy Strategy,
	Intensity Intensity,
	Backoff schedule.Schedule,
}

// RestartAfter is Decide's answer: restart after Wait.
type RestartAfter { Wait duration }

// GiveUp is Decide's answer: stop every member and end; the Intensity is
// spent, or Backoff stopped.
type GiveUp {}

// Verdict is Decide's answer to a crash.
type Verdict = RestartAfter | GiveUp

// Decide answers a crash at now, given the instants of the restarts before
// it: GiveUp when the Intensity does not allow one more; else Backoff's
// decision after as many runs as the restarts in the window plus one, at
// the time since the first of them (0 for none): RestartAfter its delay,
// or GiveUp when it stops.
func Decide(s Supervision, past []duration, now duration) Verdict {
	let mut n = 0
	let mut first = now
	for t in past {
		if t > now-s.Intensity.Period && t <= now {
			if n == 0 {
				first = t
			}
			n = n + 1
		}
	}
	if n >= s.Intensity.Max {
		return GiveUp
	}
	match schedule.Decide(s.Backoff, n+1, now-first) {
	case schedule.Continue as c:
		RestartAfter{Wait: c.After}
	case schedule.Stop:
		GiveUp
	}
}

// DecideWaitsTheBackoff: when the Intensity allows a restart, Decide
// waits what Backoff gives for the restarts in the window: an exponential
// backoff from 1s doubles with each restart in the window and starts at
// 1s again after a quiet Period.
law DecideWaitsTheBackoff(gaps []int, k int, p int) {
	let i = intensityOf(k, p)
	let s = Supervision{Strategy: OneForOne, Intensity: i, Backoff: schedule.Exponential(1s, 2.0, 1h)}
	let past = instantsOf(gaps)
	let now = if len(past) == 0 { 0s } else { past[len(past)-1] }
	let n = len(Recent(i, past, now))
	let mut want = 1s
	for _ in 0..n {
		want = duration(int64(want) * 2)
	}
	let quiet = match Decide(s, past, now+i.Period) {
	case RestartAfter as r:
		r.Wait == 1s
	case GiveUp:
		false
	}
	match Decide(s, past, now) {
	case RestartAfter as r:
		quiet && Allows(i, past, now) && r.Wait == want
	case GiveUp:
		quiet && !Allows(i, past, now)
	}
}

// Set owns any number of tasks, each started by Go and dropped when it
// ends (docs/spec/runtime.md, G4). The frame that made it owns it, as a
// frame owns a Task: the frame's end stops every member and waits for
// it, a return moves the Set to the caller, and no block or other task
// may hold it. Only the task that made it calls its operations.
extern go ergo.local/prototype/runtime/v1.Set type Set[E] {
	runtimeOnly(),
	..Closer,
	// Wait waits until no member runs. It fails with the failure that
	// ended the Set, at this Wait and at each later one, and raises the
	// defects of members that no Wait or Stop raised yet. A stop of the
	// caller ends the wait.
	Wait() fails E,
	// Stop closes admission, stops every member and waits until each has
	// ended, its exit actions included. It raises the members' defects
	// and drops their failures.
	Stop(),
	// Len is how many members run now.
	Len() int,

	// StopEndsEveryMember: after Stop no member runs, and a second Stop
	// returns and changes nothing.
	law StopEndsEveryMember() {
		Stop()
		let left = Len()
		Stop()
		left == 0 && Len() == left
	},
}

// NewSet is an empty Set with the policy p, owned by the calling frame.
func NewSet[E](p Policy) Set[E] {
	match p {
	case FailFast:
		newSet(0, 0)
	case LogFailures:
		newSet(1, 0)
	case Restart as r:
		newSet(2, r.Limit)
	}
}

extern go ergo.local/prototype/runtime/v1.TasksNewSet func newSet[E](kind int, limit int) Set[E]

// Go starts body as a member of set, on a task of its own below the
// caller's, and returns at once. The body keeps running after Go returns,
// so it is escaping. It fails with Closed, and starts nothing, when set
// admits no more tasks.
extern go ergo.local/prototype/runtime/v1.TasksGo func Go[E, R](set Set[E], body own func() fails E needs R) fails Closed needs R

// setFailed is the failure of a member in the Set laws.
type setFailed {}

let liveSetForLaws = context { Set[setFailed]: setWithMembers() }

// Both members stay live until the case stops them. Waiting on the
// unopened latch, rather than on time, also makes an empty setup fail.
func setWithMembers() Set[setFailed] {
	let s = NewSet[setFailed](FailFast)
	let blocked = sync.NewLatch()
	for _ in 0..2 {
		let ready = sync.NewLatch()
		Go(s, func() {
			ready.Open()
			blocked.Await()
		}) catch {
		case Closed:
			Unreachable("a fresh Set refused a member")
		}
		ready.Await()
	}
	if s.Len() != 2 {
		Unreachable("the law needs two live members")
	}
	s
}

// sleepers starts k members of a Set it owns, each counting itself in,
// counting itself out in an exit action and sleeping an hour, and
// returns after a second: its frame's end stops them.
func sleepers(k int, started sync.Ref[int], running sync.Ref[int]) needs Scheduler {
	let set = NewSet(FailFast)
	for _ in 0..k {
		Go(set, func() needs Scheduler {
			started.Update(func(v int) int { v + 1 })
			running.Update(func(v int) int { v + 1 })
			scope.OnExit() { running.Update(func(v int) int { v - 1 }) }
			Scheduler.Sleep(1h)
		}) catch {
		case Closed:
		}
	}
	Scheduler.Sleep(1s)
}

// NoMemberOutlivesItsFrame: when the function that made a Set returns,
// every member has ended, its exit actions included, though each would
// sleep an hour; the return does not wait the hour out.
law NoMemberOutlivesItsFrame(n int) {
	let k = limitOf(n)
	let c = testing.NewVirtualClock(0)
	let started = sync.NewRef[int](0)
	let running = sync.NewRef[int](0)
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		sleepers(k, started, running)
		started.Get() == k && running.Get() == 0 && time.Clock.Now().Sub(start) == 1s
	}
}

// FinishedAreDropped: a member that ends leaves its Set with no Wait: Len
// counts the members running, and is 0 once each has ended.
law FinishedAreDropped(n int) {
	let k = limitOf(n)
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let set = NewSet(FailFast)
		for i in 0..k {
			Go(set, func() needs Scheduler { Scheduler.Sleep(duration(int64(i + 1))) }) catch {
			case Closed:
			}
		}
		let before = set.Len()
		Scheduler.Sleep(duration(int64(k + 1)))
		before == k && set.Len() == 0
	}
}

// FailFastStopsTheRest: under FailFast, the first failure stops the other
// members, and Wait fails with it at its instant, not after the others'
// sleeps; then Go fails Closed.
law FailFastStopsTheRest(n int) {
	let k = limitOf(n)
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let set = NewSet[setFailed](FailFast)
		let start = time.Clock.Now()
		for _ in 0..k {
			Go(set, func() needs Scheduler { Scheduler.Sleep(1h) }) catch {
			case Closed:
			}
		}
		Go(set, func() fails setFailed needs Scheduler {
			Scheduler.Sleep(1s)
			return setFailed
		}) catch {
		case Closed:
		}
		set.Wait() catch {
		case setFailed:
			return time.Clock.Now().Sub(start) == 1s && set.Len() == 0 && closedNow(set)
		}
		false
	}
}

// closedNow reports whether Go on set fails Closed.
func closedNow(set Set[setFailed]) bool {
	Go(set, func() {}) catch {
	case Closed:
		return true
	}
	false
}

// RestartRunsAgain: under Restart, a member whose body has a defect runs
// again, Limit times, and the run after them ends it.
law RestartRunsAgain(n int) {
	let limit = limitOf(n) - 1
	let runs = sync.NewRef[int](0)
	let set = NewSet(Restart{Limit: limit})
	Go(set, func() {
		let r = sync.Modify(runs, func(v int) (int, int) { (v + 1, v + 1) })
		if r <= limit {
			Unreachable("a defect the Set restarts")
		}
	}) catch {
	case Closed:
	}
	set.Wait()
	runs.Get() == limit+1
}

// limitOf is a limit from 1 to 4, drawn from k.
func limitOf(k int) int { 1 + (k%4+4)%4 }

// TransformEqualsLoop: with no failure, Transform gives what a loop over xs gives.
law TransformEqualsLoop(xs []int, k int) {
	let got = Transform(xs, limitOf(k), func(x int) int { x*3 - 1 })
	let mut ok = len(got) == len(xs)
	for i in 0..len(xs) {
		ok = ok && got[i] == xs[i]*3-1
	}
	ok
}

// TransformKeepsOrder: the results are in the order of xs, not the order the
// calls end. Each call sleeps longer the earlier its element, on a
// VirtualClock, so the calls end last to first.
law TransformKeepsOrder(xs []int, k int) {
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let n = len(xs)
		let mut idx = []int{}
		for i in 0..n {
			idx = idx.Append(i)
		}
		let got = Transform(idx, limitOf(k), func(i int) int needs Scheduler {
			Scheduler.Sleep(duration(int64(n - i)))
			xs[i]
		})
		let mut ok = len(got) == n
		for i in 0..n {
			ok = ok && got[i] == xs[i]
		}
		ok
	}
}

// LimitHolds: at most limit calls run at once, and limit of them do when
// xs has that many. Each call counts itself in while it sleeps on a
// VirtualClock, so every call started before the clock moves overlaps.
law LimitHolds(xs []int, k int) {
	let limit = limitOf(k)
	let c = testing.NewVirtualClock(0)
	let running = sync.NewRef[int](0)
	let most = sync.NewRef[int](0)
	with context { Scheduler: c, time.Clock: c } {
		let got = Transform(xs, limit, func(x int) int needs Scheduler {
			let now = sync.Modify(running, func(v int) (int, int) { (v + 1, v + 1) })
			most.Update(func(m int) int {
				if now > m {
					return now
				}
				m
			})
			Scheduler.Sleep(1s)
			running.Update(func(v int) int { v - 1 })
			x
		})
		let want = if len(xs) < limit { len(xs) } else { limit }
		len(got) == len(xs) && most.Get() == want && running.Get() == 0
	}
}

// EarliestWins: on a VirtualClock, the block with the shortest sleep wins,
// the earliest of them on a tie, and Race returns at that instant: the
// longer sleeps were stopped, not waited out.
law EarliestWins(ds []int) {
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let mut blocks = []func() int needs Scheduler{}
		let mut best = 0
		let mut sleeps = []int{}
		for d in ds.Append(0) {
			let i = len(sleeps)
			let s = 1 + (d%5+5)%5
			sleeps = sleeps.Append(s)
			if s < sleeps[best] {
				best = i
			}
			blocks = blocks.Append(func() int needs Scheduler {
				Scheduler.Sleep(duration(int64(s)))
				i
			})
		}
		let start = time.Clock.Now()
		let won = Race(blocks)
		won == best && time.Clock.Now().Sub(start) == duration(int64(sleeps[best]))
	}
}

// LosersStopped: the winner cannot finish before the loser registers
// its exit action. Race stops the loser's work and waits for that
// action to finish before returning.
law LosersStopped(n int) {
	let c = testing.NewVirtualClock(0)
	let ready = sync.NewLatch()
	let cleaned = sync.NewRef[int](0)
	let cleanupTime = duration(int64(limitOf(n)))
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		let won = Race([]func() int needs Scheduler{
			func() int needs Scheduler {
				scope.OnExit() {
					Scheduler.Sleep(cleanupTime)
					cleaned.Update(func(v int) int { v + 1 })
				}
				let _ = sync.Open(ready)
				Scheduler.Sleep(1h)
				0
			},
			func() int needs Scheduler {
				sync.Await(ready)
				n
			},
		})
		won == n && cleaned.Get() == 1 && time.Clock.Now().Sub(start) == cleanupTime
	}
}
