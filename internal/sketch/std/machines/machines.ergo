// Package machines runs a machine as a pure fold over its signals
// (docs/spec/runtime.md, Machines and actors 2, 8 and 9). A machine
// declaration's value is a prelude Machine[S, E, O, F, R, W] (README Gap 46),
// so machines.Run(Shell{}, signals) takes any machine: the step's output O, error
// row F and capability row R come from its step, and W from its work. A
// fold runs no work, so it needs R and never W (fumb-e). The fold is ordinary
// Ergo code: a loop that calls the step once per signal. RunTimed is the
// fold over signals at times, with the states' timers (the machine's after
// entry), on the program's one clock: it reads time.Clock and waits on
// Scheduler, as every task sleep and the live runner, the actor library
// (#57), do. A test binds testing.VirtualClock (or time.Manual) for both,
// and the machine's timers and the test's sleeps move together.
//
// Effect: @effect/experimental Machine; XState's pure transition and
// interpret, and its after transitions; Erlang gen_statem and its
// state_timeout. Go control: a for over the signals that calls the step
// function.

import option
import time
import testing
// Work is the work a state's entry owns (docs/spec/runtime.md, Machines
// and actors 12): a machine's `work: w` entry names w(s S)
// Option[machines.Work[E, R]]. The runner calls Start after the commit
// that opens the entry, before observers see the state, and interrupts it
// when the entry ends. Start gets send, the entry's send: it gives the
// machine a signal of this entry (one of an ended entry is dropped), and
// it is the one value that starts a child of the entry (actor.Child). The
// work's capability row R is charged to the machine. Do and Attempt build a
// Work from a function that runs once; a work that sends as it goes, a
// listener, writes Start. An interruption sends nothing, and a defect ends
// the actor. Work is an ordinary record: the machine's work entry takes
// any record of its shape, one field func(send entry func(e E)) needs R.
// It lives here, not in the prelude, so a program may still declare a
// function or a let named Work.
type Work[E, R] { Start func(send entry func(e E)) needs R }

// Do is the work that runs run once and sends its result, a signal of the
// entry (effect-machine's .task with the result as the event).
func Do[E, R](run own func() E needs R) Work[E, R] {
	Work[E, R]{Start: func(send entry func(e E)) needs R {
		send(run())
	}}
}

// Attempt is the work that runs run once and sends a signal of its outcome:
// onSuccess of its result, or onFailure of its typed failure
// (effect-machine's .task(state, run, {onSuccess, onFailure})). An
// interruption is not a failure (rows.md, Catch 6): the entry's end sends
// nothing, and a defect ends the actor.
func Attempt[T, E, F, R](run own func() T fails F needs R, onSuccess own func(t T) E needs R, onFailure own func(f F) E needs R) Work[E, R] {
	Work[E, R]{Start: func(send entry func(e E)) needs R {
		let e = outcome(run, onSuccess) catch {
		case err:
			onFailure(err)
		}
		send(e)
	}}
}

// outcome is onSuccess of run's result; a failure of run is its own.
func outcome[T, E, F, R](run func() T fails F needs R, onSuccess func(t T) E needs R) E fails F needs R {
	onSuccess(try run())
}

// Every is a state's timer whose signal is made from the time it fires
// (runtime.md, Machines and actors 9; FKG1): a machine's `after: g` entry
// may name g(s S) Option[machines.Every[E]] instead of
// Option[Timeout[E]]. When an entry of the state lasts In, the runner
// reads time.Clock and gives the machine Signal(at), at the reading. So
// the step gets the clock's reading as signal data and needs no clock of
// its own: a test of it passes the time it wants. The runner reads the
// clock, so a machine with an Every timer charges time.Clock to its
// runner's row W (actor.StartMachine), never to its step's R: Run and
// From fire no timer and need no clock. A declared machine's value is
// still a Machine: its After gives a Timeout whose Signal, outside a
// firing, is Signal of the zero time. Every lives here, not in the
// prelude, because the prelude cannot name time.Time. Elm's Time.every
// interval Tick and Foldkit's Stream.tick give the same reading.
type Every[E] { In duration, Signal func(at time.Time) E }

// firingOn sets the runner's firing mark on the calling task, and
// firingOff clears it: a declared machine's After, called between them,
// gives an Every timer's signal at time.Clock's reading now (Every).
// RunTimed and the actor's runner call a state's After so when its timer
// fires, and plainly when the entry opens, where only In is read.
extern go ergo.local/prototype/runtime/v1.MachineFiringOn func firingOn()

extern go ergo.local/prototype/runtime/v1.MachineFiringOff func firingOff()

// Finished is a run that the step ended with Done: the state the step saw
// last, Done's output, and the outputs of the run's Emits and Tells
// before it, in order.
type Finished[S, O] {
	State   S,
	Output  O,
	Emitted []O,
}

// Running is a run that used every signal with no Done: the machine's
// state after the last one, and the outputs of the run's Emits and Tells,
// in order.
type Running[S, O] {
	State   S,
	Emitted []O,
}

// Outcome is how a run ended.
type Outcome[S, O] = Finished[S, O] | Running[S, O]

// LastState is the state a run ended in: the State of a Finished run (the
// state its step saw last) or of a Running one (after its last signal).
// A machine of no output, Outcome[S, Never], is only ever Running, and a
// match on it writes that one arm; LastState reads either.
func LastState[S, O](o Outcome[S, O]) S {
	match o {
	case Finished[S, O] as f:
		f.State
	case Running[S, O] as r:
		r.State
	}
}

// Rejected is the failure of a run whose step answered Reject to a signal:
// At is the index of the rejected signal, and the state is the one before
// it.
type Rejected { At int }

// Timed is a signal from outside the machine at the time At of a timed run
// (RunTimed): At is the time since the run's start, by time.Clock.
type Timed[E] {
	At     duration,
	Signal E,
}

// UntimedRunsAsRun: with no timer, a timed run is the run over its
// signals, at any times. It runs on a testing.VirtualClock, so it takes
// no wall time.
law UntimedRunsAsRun(signals []int, gaps []int) {
	let mut trace = []Timed[int]{}
	let mut at = 0s
	for i, e in signals {
		if i < gaps.Len() {
			at = at + duration(int64(gaps[i]%1000))
		}
		trace = trace.Append(Timed[int]{At: at, Signal: e})
	}
	let c = testing.NewVirtualClock(0)
	let timed = with context { time.Scheduler: c, time.Clock: c } { timedTally(trace, at) }
	from(0, signals, 0, []int{}) == timed
}

// timedTally is the text of the timed run of tally over trace until end.
func timedTally(trace []Timed[int], end duration) string needs time.Clock | time.Scheduler {
	let o = RunTimed(tally(), trace, end) catch {
	case Rejected as r:
		return "rejected \(r.At)"
	}
	told(o, []int{})
}

// StayAndTellKeepTheTimer: pokes that Stay or Tell before the ring do not
// move it: it rings 10s after the start, before the poke at 10.5s, and a
// Tell gives each poke's output.
law StayAndTellKeepTheTimer(pokes int) {
	let k = ((pokes % 10) + 10) % 10
	let (stayed, quiet) = rung(1, pokes)
	let (told, outs) = rung(3, pokes)
	stayed == k && quiet.Len() == 0 && told == k && outs == count(k)
}

// Bell is bell's state: the pokes counted, and the decision of a poke.
type Bell { Count int, Kind int }

// bellStep: a signal 0 is the ring; any other is a poke.
func bellStep(b Bell, e int) Decision[Bell, int] {
	if e == 0 {
		return Done[int]{Output: b.Count}
	}
	let n = Bell{Count: b.Count + 1, Kind: b.Kind}
	match b.Kind {
	case 0:
		Enter[Bell]{Next: n}
	case 1:
		Stay[Bell]{Next: n}
	case 2:
		Emit[Bell, int]{Next: n, Output: n.Count}
	case _:
		Tell[Bell, int]{Next: n, Output: n.Count}
	}
}

func bellTimer(b Bell) option.Option[Timeout[int]] { option.Some[Timeout[int]]{Value: Timeout[int]{In: 10s, Signal: 0}} }

func bellWork(b Bell) option.Option[func(send func(e int))] { option.None }

func bellExit(b Bell) option.Option[func()] { option.None }

// rung is the count when bell, deciding each poke by kind, rang, and its
// outputs, after pokes at 1s, 2s, … for the first pokes % 10 of them and
// one at 10.5s; a count of -1 when it did not ring.
func rung(kind int, pokes int) (int, []int) {
	let mut trace = []Timed[int]{}
	for i in 0..((pokes%10)+10)%10 {
		trace = trace.Append(Timed[int]{At: duration(int64(i+1) * int64(1s)), Signal: 1})
	}
	trace = trace.Append(Timed[int]{At: 10s + 500ms, Signal: 1})
	let m = Machine[Bell, int, int]{Initial: Bell{Count: 0, Kind: kind}, Step: bellStep, After: bellTimer, Work: bellWork, Exit: bellExit}
	let c = testing.NewVirtualClock(0)
	let o = with context { time.Scheduler: c, time.Clock: c } { RunTimed(m, trace, 60s) } catch {
	case Rejected:
		return (-1, []int{})
	}
	match o {
	case Finished[Bell, int] as f:
		(f.Output, f.Emitted)
	case Running[Bell, int]:
		(-1, []int{})
	}
}

// count is 1, 2, …, n.
func count(n int) []int {
	let mut out = []int{}
	for i in 1..n+1 {
		out = out.Append(i)
	}
	out
}

// EnterAndEmitRestartTheTimer: each poke that Enters or Emits opens a new
// entry, so the ring comes 10s after the last poke: after the one at
// 10.5s when an earlier poke moved it, before it when none did.
law EnterAndEmitRestartTheTimer(pokes int) {
	let k = ((pokes % 10) + 10) % 10
	let want = if k > 0 { k + 1 } else { 0 }
	let (entered, _) = rung(0, pokes)
	let (emitted, outs) = rung(2, pokes)
	entered == want && emitted == want && outs == count(want)
}

// Next is the state after the decision d in s: Enter, Stay, Emit and Tell
// take their Next; Ignore, Reject and Done keep s.
func Next[S, O](s S, d Decision[S, O]) S {
	match d {
	case Enter[S] as e:
		e.Next
	case Stay[S] as st:
		st.Next
	case Emit[S, O] as em:
		em.Next
	case Tell[S, O] as tl:
		tl.Next
	case Ignore:
		s
	case Reject:
		s
	case Done[O]:
		s
	}
}

// NextTakesItsState: Enter, Stay, Emit and Tell give their Next; Ignore,
// Reject and Done keep the state.
law NextTakesItsState(s int, n int) {
		Next[int, int](s, Enter[int]{Next: n}) == n && Next[int, int](s, Stay[int]{Next: n}) == n &&
		Next[int, int](s, Emit[int, int]{Next: n, Output: s}) == n && Next[int, int](s, Ignore) == s &&
		Next[int, int](s, Reject) == s && Next[int, int](s, Done[int]{Output: n}) == s &&
		Next[int, int](s, Tell[int, int]{Next: n, Output: s}) == n
}

// Can is whether step takes e in s: its decision is Enter, Stay, Emit,
// Tell or Done, not Ignore or Reject (MU10; runtime.md, Machines and actors 15).
// step is pure (no failure, no capability), so asking it acts on nothing
// and commits nothing: a screen greys a key whose signal the state cannot
// take. A step with a row is no Can's: its answer could act.
func Can[S, E, O](step func(s S, e E) Decision[S, O], s S, e E) bool {
	match step(s, e) {
	case Enter[S]:
		true
	case Stay[S]:
		true
	case Emit[S, O]:
		true
	case Tell[S, O]:
		true
	case Done[O]:
		true
	case Ignore:
		false
	case Reject:
		false
	}
}

// Start is the machine m started with input: its initial state is
// m.Start(input), computed for this call, and its step and timers are m's
// (runtime.md, Machines and actors 10). Run(Start(m, input), signals) runs
// a machine with an input.
func Start[I, S, E, O, F, R, W](m InputMachine[I, S, E, O, F, R, W], input I) Machine[S, E, O, F, R, W] {
	Machine[S, E, O, F, R, W]{Initial: m.Start(input), Step: m.Step, After: m.After, Work: m.Work, Exit: m.Exit}
}

// Initial is m's initial state.
func Initial[S, E, O, F, R, W](m Machine[S, E, O, F, R, W]) S { m.Initial }

// Run steps m from its initial state over signals, in order, one at a
// time: it ends at the first Done (Finished) or after the last signal
// (Running), and fails Rejected at the first Reject. Each Emit's and
// Tell's output is kept, in order. A failure of the step ends the run with that failure.
// Run has no clock: m's timers never fire (RunTimed runs them). Run runs no
// work, so it needs the step's row R and not the work's W.
func Run[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], signals []E) Outcome[S, O] fails Rejected | F needs R {
	try From(m, m.Initial, signals)
}

// RunSplits: a run over a ++ b is the run over b from the state after a,
// when the run over a used every signal (Running), with a's outputs first.
law RunSplits(a []int, b []int) {
	let mut whole = a
	for e in b {
		whole = whole.Append(e)
	}
	let first = Run(tally(), a) catch {
	case Rejected:
		return true
	}
	match first {
	case Running[int, int] as r:
		from(0, whole, 0, []int{}) == from(r.State, b, a.Len(), r.Emitted)
	case Finished[int, int]:
		true
	}
}

// tallyStep: a signal e moves the count s by its rest modulo 7: 0 enters
// s + e, 1 stays at s + 1, 2 is ignored, 3 is rejected, 4 emits s and
// moves to s - 1, 5 is done with s, 6 tells -s and moves to s + 2.
func tallyStep(s int, e int) Decision[int, int] {
	match ((e % 7) + 7) % 7 {
	case 0:
		Enter[int]{Next: s + e}
	case 1:
		Stay[int]{Next: s + 1}
	case 2:
		Ignore
	case 3:
		Reject
	case 4:
		Emit[int, int]{Next: s - 1, Output: s}
	case 6:
		Tell[int, int]{Next: s + 2, Output: -s}
	case _:
		Done[int]{Output: s}
	}
}

// untimed gives no state a timer.
func untimed(s int) option.Option[Timeout[int]] { option.None }

func unworked(s int) option.Option[func(send func(e int))] { option.None }

func unexited(s int) option.Option[func()] { option.None }

func tally() Machine[int, int, int] { Machine[int, int, int]{Initial: 0, Step: tallyStep, After: untimed, Work: unworked, Exit: unexited} }

// ints is the text of xs.
func ints(xs []int) string {
	let mut t = "["
	for i, x in xs {
		if i > 0 {
			t = t + " "
		}
		t = t + "\(x)"
	}
	t + "]"
}

// cat is a ++ b.
func cat(a []int, b []int) []int {
	let mut all = a
	for x in b {
		all = all.Append(x)
	}
	all
}

// told is the text of the outcome o of a run, after the outputs before,
// or of its rejection at the index first + r.At.
func told(o Outcome[int, int], before []int) string {
	match o {
	case Finished[int, int] as f:
		"finished \(f.State) \(f.Output) \(ints(cat(before, f.Emitted)))"
	case Running[int, int] as r:
		"running \(r.State) \(ints(cat(before, r.Emitted)))"
	}
}

// from is the text of a run of tally from s over signals, whose first
// signal has the index first in the whole run, after the outputs before.
func from(s int, signals []int, first int, before []int) string {
	let o = From(tally(), s, signals) catch {
	case Rejected as r:
		return "rejected \(r.At + first)"
	}
	told(o, before)
}

// From is Run from the state s instead of m's initial state: Run(m, a ++ b)
// is From(m, s, b) when Run(m, a) is Running with state s, its outputs
// before From's.
func From[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], s S, signals []E) Outcome[S, O] fails Rejected | F needs R {
	let mut at = s
	let mut out = []O{}
	for i, e in signals {
		let d = try m.Step(at, e)
		match d {
		case Done[O] as done:
			return Finished[S, O]{State: at, Output: done.Output, Emitted: out}
		case Reject:
			return Rejected{At: i}
		case Emit[S, O] as em:
			out = out.Append(em.Output)
			at = em.Next
		case Enter[S] as en:
			at = en.Next
		case Stay[S] as st:
			at = st.Next
		case Tell[S, O] as tl:
			out = out.Append(tl.Output)
			at = tl.Next
		case Ignore:
		}
	}
	Running[S, O]{State: at, Emitted: out}
}

// armed is the timer of a run's open entry: it fires at At, and the entry
// opened in State; its signal is made when it fires (fired).
type armed[S] {
	At    duration,
	State S,
}

// arm is the timer of the entry that opened in s at now: None when
// m.After(s) is None. An entry has one timer, and an entry that ends
// takes its timer with it, so a run holds at most one timer, that of the
// open entry, and the next entry's timer replaces it. A timer whose In is
// not positive is a defect (runtime.md, Machines and actors 9; fs2): it
// would fire at once, and a state whose timer re-enters it would never
// let time pass. A declared machine's After raises it first, naming the
// machine and the state; a Machine built from parts raises it here.
func arm[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], s S, now duration) option.Option[armed[S]] {
	match m.After(s) {
	case option.Some[Timeout[E]] as t:
		if t.Value.In <= 0s {
			notPositive(now, t.Value.In)
		}
		option.Some[armed[S]]{Value: armed[S]{At: now + t.Value.In, State: s}}
	case option.None:
		option.None
	}
}

// AfterFiring is m's After of the state at, as its timer fires: After
// under the runner's firing mark, so an Every timer's signal carries
// time.Clock's reading now. A runner calls it when a timer fires (RunTimed,
// std actor), and plain After when an entry opens, where only In is read.
// It is the one owner of the firing mark.
func AfterFiring[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], at S) option.Option[Timeout[E]] {
	firingOn()
	let timer = m.After(at)
	firingOff()
	timer
}

// notPositive raises the defect of a timer armed at now whose In is not
// positive (arm).
extern go ergo.local/prototype/runtime/v1.MachineTimerNotPositiveAt func notPositive(now duration, wait duration)

// due is timer when it fires before the time limit (at or before it when
// closed), else None.
func due[S](timer option.Option[armed[S]], limit duration, closed bool) option.Option[armed[S]] {
	match timer {
	case option.Some[armed[S]] as t:
		if t.Value.At < limit || closed && t.Value.At == limit {
			return timer
		}
		option.None
	case option.None:
		option.None
	}
}

// until waits on Scheduler until the time since start, by time.Clock, is
// at least at, and gives that time: a time at or before now returns it at
// once, since the clock does not go back.
func until(start time.Time, at duration) duration needs time.Clock | time.Scheduler {
	let passed = time.Clock.Now().Sub(start)
	if at <= passed {
		return passed
	}
	time.Scheduler.Sleep(at - passed)
	time.Clock.Now().Sub(start)
}

// RunTimed steps m from its initial state over trace on the clock in the
// context, from the time it is called (0) until end, as the live runner
// does (runtime.md, Machines and actors 9). Each signal of trace
// comes at its At: the run waits on Scheduler until time.Clock reads it,
// and takes the time it reads as the signal's (never before the last:
// the clock does not go back). Each entry has the timer m.After of its
// state, armed when the entry opens (the first state at 0, an Enter or an
// Emit at the time of its signal): it gives its Signal In after that,
// made when it fires, so an Every timer's carries the clock's reading. A
// Stay and a Tell keep the entry and its timer (a Tell gives its output,
// as an Emit does); an entry that ends takes its timer
// with it: a timer of an ended entry is dropped, never stepped, so the
// run holds one timer at most, the open entry's. A timer
// fires before a signal that comes later than it and after one that comes
// at the same time; after the last signal, every timer due by end fires,
// and a run with no Done waits until end. A Reject of a timer's signal
// keeps the state, as Ignore: no one asked. The run ends as Run's does,
// with Rejected's At the index of the rejected signal in trace. Under
// testing.VirtualClock or time.Manual the run takes no wall time, and a
// task that sleeps beside it wakes in step with its timers.
func RunTimed[S, E, O, F, R, W](m Machine[S, E, O, F, R, W], trace []Timed[E], end duration) Outcome[S, O] fails Rejected | F needs time.Clock | time.Scheduler | R {
	let start = time.Clock.Now()
	let mut at = m.Initial
	let mut out = []O{}
	let mut now = 0s
	let mut pending = arm(m, at, now)
	let mut i = 0
	for {
		let closed = i >= trace.Len()
		let mut limit = end
		if !closed {
			limit = trace[i].At
		}
		let next = due(pending, limit, closed)
		let timer = match next {
		case option.Some[armed[S]]:
			true
		case option.None:
			false
		}
		if !timer && closed {
			break
		}
		let ev = match next {
		case option.Some[armed[S]] as t:
			t.Value
		case option.None:
			armed[S]{At: trace[i].At, State: at}
		}
		if timer {
			pending = option.None
		} else {
			i = i + 1
		}
		now = until(start, ev.At)
		let sig = if timer {
			match AfterFiring(m, ev.State) {
			case option.Some[Timeout[E]] as t:
				t.Value.Signal
			case option.None:
				continue
			}
		} else {
			trace[i-1].Signal
		}
		let d = try m.Step(at, sig)
		match d {
		case Done[O] as done:
			return Finished[S, O]{State: at, Output: done.Output, Emitted: out}
		case Reject:
			if !timer {
				return Rejected{At: i - 1}
			}
		case Emit[S, O] as em:
			out = out.Append(em.Output)
			at = em.Next
			pending = arm(m, at, now)
		case Enter[S] as en:
			at = en.Next
			pending = arm(m, at, now)
		case Stay[S] as st:
			at = st.Next
		case Tell[S, O] as tl:
			out = out.Append(tl.Output)
			at = tl.Next
		case Ignore:
		}
	}
	let _ = until(start, end)
	Running[S, O]{State: at, Emitted: out}
}
