// The laws of machines run over tally, a machine built from parts whose
// step reaches every Decision variant by the signal's value.

import testing
import time

// tallyStep: a signal e moves the count s by its rest modulo 6: 0 enters
// s + e, 1 stays at s + 1, 2 is ignored, 3 is rejected, 4 emits s and
// moves to s - 1, 5 is done with s.
func tallyStep(s int, e int) Decision[int, int] {
	match ((e % 6) + 6) % 6 {
	case 0:
		Enter[int]{Next: s + e}
	case 1:
		Stay[int]{Next: s + 1}
	case 2:
		Ignore
	case 3:
		Reject
	case 4:
		Emit[int, int]{Next: s - 1, Output: s}
	case _:
		Done[int]{Output: s}
	}
}

// untimed gives no state a timer.
func untimed(s int) Option[Timeout[int]] { None }

func unworked(s int) Option[func(send func(e int))] { None }

func tally() Machine[int, int, int] { Machine[int, int, int]{Initial: 0, Step: tallyStep, After: untimed, Work: unworked} }

// ints is the text of xs.
func ints(xs []int) string {
	let mut t = "["
	for i, x in xs {
		if i > 0 {
			t = t + " "
		}
		t = t + "\(x)"
	}
	t + "]"
}

// cat is a ++ b.
func cat(a []int, b []int) []int {
	let mut all = a
	for x in b {
		all = all.Append(x)
	}
	all
}

// told is the text of the outcome o of a run, after the outputs before,
// or of its rejection at the index first + r.At.
func told(o Outcome[int, int], before []int) string {
	match o {
	case Finished[int, int] as f:
		"finished \(f.State) \(f.Output) \(ints(cat(before, f.Emitted)))"
	case Running[int, int] as r:
		"running \(r.State) \(ints(cat(before, r.Emitted)))"
	}
}

// from is the text of a run of tally from s over signals, whose first
// signal has the index first in the whole run, after the outputs before.
func from(s int, signals []int, first int, before []int) string {
	let o = From(tally(), s, signals) catch {
	case Rejected as r:
		return "rejected \(r.At + first)"
	}
	told(o, before)
}

// RunSplits: a run over a ++ b is the run over b from the state after a,
// when the run over a used every signal (Running), with a's outputs first.
law RunSplits(a []int, b []int) {
	let mut whole = a
	for e in b {
		whole = whole.Append(e)
	}
	let first = Run(tally(), a) catch {
	case Rejected:
		return true
	}
	match first {
	case Running[int, int] as r:
		from(0, whole, 0, []int{}) == from(r.State, b, len(a), r.Emitted)
	case Finished[int, int]:
		true
	}
}

// NextTakesItsState: Enter, Stay and Emit give their Next; Ignore, Reject
// and Done keep the state.
law NextTakesItsState(s int, n int) {
	Next[int, int](s, Enter[int]{Next: n}) == n && Next[int, int](s, Stay[int]{Next: n}) == n &&
		Next[int, int](s, Emit[int, int]{Next: n, Output: s}) == n && Next[int, int](s, Ignore) == s &&
		Next[int, int](s, Reject) == s && Next[int, int](s, Done[int]{Output: n}) == s
}

// UntimedRunsAsRun: with no timer, a timed run is the run over its
// signals, at any times. It runs on a testing.VirtualClock, so it takes
// no wall time.
law UntimedRunsAsRun(signals []int, gaps []int) {
	let mut trace = []Timed[int]{}
	let mut at = 0s
	for i, e in signals {
		if i < len(gaps) {
			at = at + duration(int64(gaps[i] % 1000))
		}
		trace = trace.Append(Timed[int]{At: at, Signal: e})
	}
	let c = testing.NewVirtualClock(0)
	let timed = with context { Scheduler: c, time.Clock: c } { timedTally(trace, at) }
	from(0, signals, 0, []int{}) == timed
}

// timedTally is the text of the timed run of tally over trace until end.
func timedTally(trace []Timed[int], end duration) string needs time.Clock | Scheduler {
	let o = RunTimed(tally(), trace, end) catch {
	case Rejected as r:
		return "rejected \(r.At)"
	}
	told(o, []int{})
}

// Beats is a metronome: the reading its entry opened at, the beats it was
// given, and how many of them carried a reading other than the opening
// reading plus Beat, the time the timer waits.
type Beats { Opened time.Time, Count int, Wrong int }

// Pulse is what a metronome takes: its own beat at the reading it fired
// at, and a nudge at the reading it came at, which opens a new entry.
type Pulse = Beat{At time.Time} | Nudge{At time.Time}

// Tempo is how long a metronome's entry waits for its beat.
let Tempo = 7ms

// opened is a metronome opened at the reading at.
func opened(at time.Time) Beats { Beats{Opened: at, Count: 0, Wrong: 0} }

// pulse is the metronome's step: a beat or a nudge opens a new entry at
// its reading, which arms the next beat; a beat counts, and counts as
// wrong when its reading is not the entry's opening reading plus Tempo.
func pulse(b Beats, p Pulse) Decision[Beats, Never] {
	match p {
	case Beat as t:
		let wrong = if t.At.Equal(b.Opened.Add(Tempo)) { b.Wrong } else { b.Wrong + 1 }
		Enter[Beats]{Next: Beats{Opened: t.At, Count: b.Count + 1, Wrong: wrong}}
	case Nudge as n:
		Enter[Beats]{Next: Beats{Opened: n.At, Count: b.Count, Wrong: b.Wrong}}
	}
}

// beat is every entry's timer: Beat at the reading it fires at, Tempo
// after the entry opened.
func beat(b Beats) Option[Every[Pulse]] { Some{Every[Pulse]{In: Tempo, Signal: beatAt}} }

func beatAt(at time.Time) Pulse { Beat{At: at} }

// Metronome is the metronome as a machine, opened at its input's reading.
type Metronome machine[Beats, Pulse] { initial: opened, step: pulse, after: beat }

// EveryCarriesTheReading: an Every timer's signal carries the reading of
// the clock provider when the timer fires (FKG1). On a
// testing.VirtualClock a timer fires at its entry's opening reading plus
// its In, so every beat's reading is that sum, whatever nudges reopen the
// entries before it (a nudge at a beat's own time comes first, and the
// beat of the entry it ended is dropped); and the run ends with one beat
// per Tempo after the last nudge.
law EveryCarriesTheReading(gaps []int) {
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		let mut trace = []Timed[Pulse]{}
		let mut at = 0s
		for g in gaps {
			at = at + time.Times(1ms, ((g % 20) + 20) % 20)
			trace = trace.Append(Timed[Pulse]{At: at, Signal: Nudge{At: start.Add(at)}})
		}
		let o = RunTimed(Start(Metronome{}, start), trace, at + time.Times(Tempo, 3)) catch {
		case Rejected:
			return false
		}
		let b = LastState(o)
		b.Wrong == 0 && b.Count >= 3 && b.Opened.Equal(start.Add(at + time.Times(Tempo, 3)))
	}
}
