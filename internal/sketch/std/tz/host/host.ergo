// Package host is the tz.Zones provider over the host's zone files: the
// zones the operating system holds (/usr/share/zoneinfo and the
// directories of Go's own search, after a $ZONEINFO directory). It is the
// explicit choice of a program that must follow the host's zone rules;
// std's default is tz/iana's own copy. Accepted consequences, as with
// Go's LoadLocation: two hosts can hold different releases, so one name
// can have different rules on each; and a file of the zone directory that
// is not a zone name (posixrules, localtime) loads when it is a TZif file.

import tz
import tz/iana

// Zones is the provider of tz.Zones over the host's zone files. Its field
// gives this package the construction authority, so only New makes one.
type Zones { live hostOnly } implements tz.Zones

// hostOnly is the zero-size type of Zones's field.
type hostOnly {}

// New is the provider of tz.Zones over the host's zone files. It needs
// Ambient: only code whose row holds the authority to choose the host
// makes one (docs/spec/stdlib.md, Host packages).
func New() Zones needs Ambient { Zones{live: hostOnly} }

// Load is the zone of the host's zone file name, or UnknownZone when no
// zone directory holds a TZif file of that name. A name with a ..
// element, an absolute path or a backslash is UnknownZone without a read.
func Load(_ Zones, name string) tz.Zone fails tz.UnknownZone {
	let data = hostZone(name)
	if len(data) == 0 {
		return tz.UnknownZone{Name: name}
	}
	tz.FromTZif(name, data) catch {
	case tz.BadData:
		return tz.UnknownZone{Name: name}
	}
}

extern go ergo.local/prototype/runtime/v1.TzHostZone func hostZone(name string) string

// Local is the provider of tz.Local over the host: the zone TZ names, or
// when TZ is unset the zone /etc/localtime names (tz.FromTZ), loaded from
// the database it was built with.
type Local { zones tz.Zones } implements tz.Local

// NewLocal is the provider of tz.Local over the host, loading names from
// zones: `tz.Local: host.NewLocal(iana.New())` has the host choose the
// name and std's copy the rules. Like New, it needs Ambient.
func NewLocal(zones tz.Zones) Local needs Ambient { Local{zones: zones} }

// Zone is the host's own zone.
func Zone(l Local) tz.Zone fails tz.UnknownZone {
	let (set, value) = hostEnv()
	let (name, data) = hostLocal()
	try tz.FromTZ(l.zones, set, value, name, data)
}

// Named is a provider of tz.Local that is always the zone Name of Zones:
// for a test, or a program that keeps its zone in its own configuration.
type Named { Name string, Zones tz.Zones } implements tz.Local

// Zone is the zone n names.
func Zone(n Named) tz.Zone fails tz.UnknownZone { try n.Zones.Load(n.Name) }

// onStdZones and namedUTC are the contexts tz.Local's laws run Local and
// Named under, over std's copy of the database (types.md, Laws 10).
let onStdZones = context { tz.Local: Local{zones: iana.New()} }

let namedUTC = context { tz.Local: Named{Name: "UTC", Zones: iana.New()} }

extern go ergo.local/prototype/runtime/v1.TzEnv func hostEnv() (bool, string)
extern go ergo.local/prototype/runtime/v1.TzHostLocal func hostLocal() (string, string)
