import maps
import option
import slices
import strings

// Model is the memory Checker the laws of plans and apply run over: a
// small language whose checker, formatter and lowered code are a few
// functions, so a law can draw a workspace, change it and check the
// result without the Go checker (the product Checker is SEM4b's, behind
// the same operation type).
//
// The language. A file's package is its folder. A line that starts with
// `func NAME` or `type NAME` declares NAME; the lines after it, to the
// next declaration, are its body, and its extent ends after its last line
// that is not blank. A body's words are its runs of text between spaces:
//
//   - a declared name of the file's package is a site of it (call for a
//     func, typeuse for a type), and `q.NAME` a site of NAME in the
//     package whose last path element is q, or the diagnostic M3 when
//     that package does not declare NAME;
//   - `?x` is the diagnostic M1, whose fix writes x in its place;
//   - `!x` is the diagnostic M2, whose fix writes the whole line as `x`;
//   - any other word names nothing;
//   - a line `sig WORDS` is the declaration's signature, `(WORDS)`, and
//     `needs WORDS` its needs row: an exported func's contract (api.ergo)
//     is its name, signature and row.
//
// A second declaration of a name in one package is the diagnostic M4 and
// has no row. The lowered code is the declarations' handles and words,
// so a change of white space alone keeps it. Format is canonical text:
// each line without trailing white space, a body line indented by one
// tab, no blank line first or last, never two together, and one newline
// at the end.
type Model {} implements Checker

func Check(_ Model, sources []Source) Report fails CheckFailed { modelCheck(sources) }

func Format(_ Model, text string) string fails CheckFailed { modelFormat(text) }

// NewModel is the Model; seed only names the provider for a law run.
func NewModel(seed int) Model { Model }

// mdecl is a declaration the model found, with its extent and its body
// lines.
type mdecl {
	Name   string,
	Kind   string,
	File   string,
	Pkg    string,
	Line   int,
	Start  int,
	End    int,
	Lines  []mline,
	Header bool,
}

// mline is one body line: its number, the offset of its first byte and
// its text without the newline.
type mline {
	Line int,
	At   int,
	Text string,
}

// packageOf is the folder of a file path.
func packageOf(file string) string {
	let at = strings.LastIndex(file, "/")
	if at < 0 { "" } else { strings.Slice(file, 0, at) }
}

// declLine is the kind and name a line declares, or ("", "").
func declLine(text string) (string, string) {
	for kind in []string{"func", "type"} {
		if strings.HasPrefix(text, kind+" ") {
			let rest = strings.Slice(text, kind.Len()+1, text.Len())
			let name = firstWord(rest)
			if name != "" {
				return (kind, name)
			}
		}
	}
	("", "")
}

// firstWord is the text before the first space, without trailing white
// space.
func firstWord(s string) string {
	let at = strings.Index(s, " ")
	let w = if at < 0 { s } else { strings.Slice(s, 0, at) }
	strings.TrimSpace(w)
}

// parsed is the declarations of one file, in order.
func parsed(src Source) []mdecl {
	let lines = strings.Split(src.Text, "\n")
	let mut out = []mdecl{}
	let mut at = 0
	let mut cur = mdecl{Name: "", Kind: "", File: src.File, Pkg: packageOf(src.File), Line: 0, Start: 0, End: 0, Lines: []mline{}, Header: true}
	for i, text in lines {
		let (kind, name) = declLine(text)
		let end = if i == lines.Len()-1 { at + text.Len() } else { at + text.Len() + 1 }
		if kind != "" {
			if !cur.Header {
				out = out.Append(cur)
			}
			cur = mdecl{Name: name, Kind: kind, File: src.File, Pkg: packageOf(src.File), Line: i + 1, Start: at, End: end, Lines: []mline{}, Header: false}
		} else if !cur.Header {
			cur.Lines = cur.Lines.Append(mline{Line: i + 1, At: at, Text: text})
			if strings.TrimSpace(text) != "" {
				cur.End = end
			}
		}
		at = end
	}
	if !cur.Header {
		out = out.Append(cur)
	}
	out
}

// lastElement is the last element of a package path.
func lastElement(path string) string {
	let at = strings.LastIndex(path, "/")
	if at < 0 { path } else { strings.Slice(path, at+1, path.Len()) }
}

// modelCheck is Model's Check.
func modelCheck(sources []Source) Report {
	let mut decls = []mdecl{}
	let mut diags = []Diagnostic{}
	let mut pkgs = []string{}
	// declared is each package's names: the kind, by name; a type's
	// members and methods are named `T.n`.
	let mut declared = Map[string, Map[string, string]]{}
	// aliases is each file's imports: the package, by alias.
	let mut aliases = Map[string, Map[string, string]]{}
	for src in sources {
		let pkg = packageOf(src.File)
		if !has(pkgs, pkg) {
			pkgs = pkgs.Append(pkg)
			declared[pkg] = Map[string, string]{}
		}
		aliases[src.File] = importsOf(src.Text)
		for d in parsed(src) {
			let names = maps.GetOr(declared, pkg, Map[string, string]{})
			match names.Get(d.Name) {
			case option.Some[string]:
				diags = diags.Append(Diagnostic{Code: "M4", Message: "\(d.Name) is declared twice", File: d.File, Line: d.Line, Column: 6, Fix: []Edit{}})
			case option.None:
				let mut next = names
				next[d.Name] = d.Kind
				if d.Kind == "type" {
					for l in d.Lines {
						let ws = wordsOf(beforeComment(l.Text), l.At)
						if ws.Len() >= 2 && (ws[0].Text == "field" || ws[0].Text == "op") {
							let key = d.Name + "." + ws[1].Text
							match next.Get(key) {
							case option.Some[string]:
								diags = diags.Append(Diagnostic{Code: "M4", Message: "\(key) is declared twice", File: d.File, Line: l.Line, Column: ws[1].Column, Fix: []Edit{}})
							case option.None:
								next[key] = if ws[0].Text == "field" { "field" } else { "operation" }
							}
						}
					}
				}
				declared[pkg] = next
				decls = decls.Append(d)
			}
		}
	}
	// byElement is the package each last path element names (the first).
	let mut byElement = Map[string, string]{}
	for p in pkgs {
		match byElement.Get(lastElement(p)) {
		case option.Some[string]:
		case option.None:
			byElement[lastElement(p)] = p
		}
	}
	let mut packages = []Package{}
	let mut extents = []Extent{}
	let mut binds = []Bind{}
	let mut workspace = []string{}
	let mut code = ""
	for p in pkgs {
		if !strings.HasPrefix(p, "dep/") {
			workspace = workspace.Append(p)
		}
		let names = maps.GetOr(declared, p, Map[string, string]{})
		let mut pd = []Decl{}
		let mut ps = []Site{}
		let mut cs = []Contract{}
		let mut errs = 0
		for d in decls {
			if d.Pkg != p {
				continue
			}
			let handle = p + "." + d.Name
			let col = d.Kind.Len() + 2
			let owner = match strings.Cut(d.Name, ".") {
			case option.Some[strings.Halves] as h:
				h.Value.Before
			case option.None:
				""
			}
			let name = if owner == "" { d.Name } else { strings.Slice(d.Name, owner.Len()+1, d.Name.Len()) }
			let at = if owner == "" { col } else { col + owner.Len() + 1 }
			pd = pd.Append(Decl{Handle: handle, Kind: d.Kind, Name: name, Package: p, Exported: exportedName(name), File: d.File, Line: d.Line, Column: at})
			ps = ps.Append(Site{Symbol: handle, Kind: "def", Package: p, File: d.File, Line: d.Line, Column: at, In: handle})
			if owner != "" {
				if maps.GetOr(names, owner, "") == "type" {
					ps = ps.Append(Site{Symbol: p + "." + owner, Kind: "typeuse", Package: p, File: d.File, Line: d.Line, Column: col, In: handle})
				} else {
					diags = diags.Append(Diagnostic{Code: "M3", Message: "\(owner) is not a type", File: d.File, Line: d.Line, Column: col, Fix: []Edit{}})
					errs = errs + 1
				}
			}
			extents = extents.Append(Extent{Handle: handle, File: d.File, Start: d.Start, End: d.End})
			code = code + handle + ":"
			let files = maps.GetOr(aliases, d.File, Map[string, string]{})
			let mut locals = []string{}
			let mut sig = "()"
			let mut row = ""
			for l in d.Lines {
				let ws = wordsOf(beforeComment(l.Text), l.At)
				if ws.Len() == 0 {
					continue
				}
				for w in ws {
					code = code + " " + w.Text
				}
				let first = ws[0].Text
				if d.Kind == "type" && ws.Len() >= 2 && (first == "field" || first == "op") {
					let mh = handle + "." + ws[1].Text
					let mk = if first == "field" { "field" } else { "operation" }
					pd = pd.Append(Decl{Handle: mh, Kind: mk, Name: ws[1].Text, Package: p, Exported: exportedName(ws[1].Text), File: d.File, Line: l.Line, Column: ws[1].Column})
					ps = ps.Append(Site{Symbol: mh, Kind: "def", Package: p, File: d.File, Line: l.Line, Column: ws[1].Column, In: handle})
					continue
				}
				if d.Kind == "type" && ws.Len() >= 2 && first == "provides" {
					let w = ws[1]
					let (q, n, c) = match strings.Cut(w.Text, ".") {
					case option.Some[strings.Halves] as h:
						(maps.GetOr(files, h.Value.Before, maps.GetOr(byElement, h.Value.Before, "")), h.Value.After, w.Column + h.Value.Before.Len() + 1)
					case option.None:
						(p, w.Text, w.Column)
					}
					let theirs = maps.GetOr(declared, q, Map[string, string]{})
					if q == "" || maps.GetOr(theirs, n, "") != "type" {
						diags = diags.Append(Diagnostic{Code: "M3", Message: "\(w.Text) is not a type", File: d.File, Line: l.Line, Column: w.Column, Fix: []Edit{}})
						errs = errs + 1
						continue
					}
					ps = ps.Append(Site{Symbol: q + "." + n, Kind: "provides", Package: p, File: d.File, Line: l.Line, Column: c, In: handle})
					binds = binds.Append(Bind{Op: q + "." + n, By: handle})
					for key in slices.Sorted(maps.Keys(theirs)) {
						if strings.HasPrefix(key, n+".") && maps.GetOr(theirs, key, "") == "operation" {
							let op = strings.Slice(key, n.Len()+1, key.Len())
							if maps.GetOr(names, d.Name+"."+op, "") != "func" {
								diags = diags.Append(Diagnostic{Code: "M6", Message: "\(d.Name) provides \(n) but has no \(op)", File: d.File, Line: l.Line, Column: w.Column, Fix: []Edit{}})
								errs = errs + 1
							}
						}
					}
					continue
				}
				if first == "let" && ws.Len() >= 2 {
					locals = locals.Append(ws[1].Text)
					continue
				}
				if first == "sig" || first == "needs" {
					let mut rest = []string{}
					for w in slices.Slice(ws, 1, ws.Len()) {
						rest = rest.Append(w.Text)
					}
					if first == "sig" {
						sig = "(" + strings.Join(rest, " ") + ")"
					} else {
						row = strings.Join(rest, " | ")
					}
					continue
				}
				for w in ws {
					let word = w.Text
					let column = w.Column
					if strings.HasPrefix(word, "?") && word.Len() > 1 {
						diags = diags.Append(Diagnostic{Code: "M1", Message: "\(word) is not declared", File: d.File, Line: l.Line, Column: column, Fix: []Edit{Edit{File: d.File, Start: w.At, End: w.At + word.Len(), Text: strings.Slice(word, 1, word.Len())}}})
						errs = errs + 1
						continue
					}
					if strings.HasPrefix(word, "!") && word.Len() > 1 {
						diags = diags.Append(Diagnostic{Code: "M2", Message: "\(word) shouts", File: d.File, Line: l.Line, Column: column, Fix: []Edit{Edit{File: d.File, Start: l.At, End: l.At + l.Text.Len(), Text: "\t" + strings.Slice(word, 1, word.Len())}}})
						errs = errs + 1
						continue
					}
					if has(locals, word) {
						continue
					}
					match strings.Cut(word, "{") {
					case option.Some[strings.Halves] as h:
						let t = h.Value.Before
						let f = strings.TrimSuffix(h.Value.After, "}")
						if maps.GetOr(names, t, "") != "type" {
							diags = diags.Append(Diagnostic{Code: "M3", Message: "\(t) is not a type", File: d.File, Line: l.Line, Column: column, Fix: []Edit{}})
							errs = errs + 1
							continue
						}
						ps = ps.Append(Site{Symbol: p + "." + t, Kind: "construct", Package: p, File: d.File, Line: l.Line, Column: column, In: handle})
						if maps.GetOr(names, t+"."+f, "") == "field" {
							ps = ps.Append(Site{Symbol: p + "." + t + "." + f, Kind: "write", Package: p, File: d.File, Line: l.Line, Column: column + t.Len() + 1, In: handle})
						} else {
							diags = diags.Append(Diagnostic{Code: "M5", Message: "\(t) has no field \(f)", File: d.File, Line: l.Line, Column: column + t.Len() + 1, Fix: []Edit{}})
							errs = errs + 1
						}
						continue
					case option.None:
					}
					match strings.Cut(word, ".") {
					case option.Some[strings.Halves] as h:
						let before = h.Value.Before
						if maps.GetOr(names, before, "") == "type" {
							match names.Get(word) {
							case option.Some[string] as k:
								ps = ps.Append(Site{Symbol: p + "." + before, Kind: "typeuse", Package: p, File: d.File, Line: l.Line, Column: column, In: handle})
								ps = ps.Append(Site{Symbol: p + "." + word, Kind: siteKindOf(k.Value), Package: p, File: d.File, Line: l.Line, Column: column + before.Len() + 1, In: handle})
							case option.None:
								diags = diags.Append(Diagnostic{Code: "M3", Message: "\(word) is not declared", File: d.File, Line: l.Line, Column: column, Fix: []Edit{}})
								errs = errs + 1
							}
							continue
						}
						let q = maps.GetOr(files, before, maps.GetOr(byElement, before, ""))
						if q == "" {
							continue
						}
						match maps.GetOr(declared, q, Map[string, string]{}).Get(h.Value.After) {
						case option.Some[string] as k:
							ps = ps.Append(Site{Symbol: q + "." + h.Value.After, Kind: siteKindOf(k.Value), Package: p, File: d.File, Line: l.Line, Column: column + before.Len() + 1, In: handle})
						case option.None:
							diags = diags.Append(Diagnostic{Code: "M3", Message: "\(word) is not declared", File: d.File, Line: l.Line, Column: column, Fix: []Edit{}})
							errs = errs + 1
						}
					case option.None:
						match names.Get(word) {
						case option.Some[string] as k:
							ps = ps.Append(Site{Symbol: p + "." + word, Kind: siteKindOf(k.Value), Package: p, File: d.File, Line: l.Line, Column: column, In: handle})
						case option.None:
						}
					}
				}
			}
			code = code + "\n"
			if d.Kind == "func" && owner == "" && exportedName(name) {
				cs = cs.Append(Contract{Name: name, Signature: sig, TypeParameters: []string{}, Fails: "", Needs: row, Takes: []string{}, TakesParameters: []int{}, TakesSelf: false, TakesInferred: false, Own: []string{}})
			}
		}
		for x in diags {
			if packageOf(x.File) == p && x.Code == "M4" {
				errs = errs + 1
			}
		}
		let mut calls = []Call{}
		for s in ps {
			if s.Kind == "call" {
				calls = calls.Append(Call{From: s.In, To: s.Symbol, File: s.File, Line: s.Line, Column: s.Column, Brings: []string{}, Discharged: []string{}, Bound: []Binding{}, Raises: []string{}, Caught: []string{}})
			}
		}
		packages = packages.Append(Package{Path: p, Complete: errs == 0, Diagnostics: errs, Decls: pd, Sites: ps, Contracts: cs, Calls: calls, Needs: []Need{}, Fails: []Failing{}, Machines: []MachineGraph{}})
	}
	Report{Tables: Tables{Revision: revisionOf(sources), Root: if pkgs.Len() > 0 { pkgs[pkgs.Len()-1] } else { "" }, Packages: packages}, Extents: extents, Diagnostics: diags, Code: revision(code), Binds: binds, Workspace: workspace}
}

// siteKindOf is the kind of a site that names a declaration of kind k.
func siteKindOf(k string) string {
	match k {
	case "type":
		"typeuse"
	case "field":
		"read"
	case _:
		"call"
	}
}

// mword is one word of a body line: its text, its column and its offset
// in the file.
type mword {
	Text   string,
	Column int,
	At     int,
}

// wordsOf is the words of a line that starts at offset at.
func wordsOf(text string, at int) []mword {
	let mut out = []mword{}
	let mut col0 = 1
	for w in strings.Split(text, " ") {
		let word = strings.TrimSpace(w)
		let lead = w.Len() - trimLeft(w).Len()
		let column = col0 + lead
		col0 = col0 + w.Len() + 1
		if word != "" {
			out = out.Append(mword{Text: word, Column: column, At: at + column - 1})
		}
	}
	out
}

// beforeComment is a line up to its comment, `//` to its end.
func beforeComment(text string) string {
	let at = strings.Index(text, "//")
	if at < 0 { text } else { strings.Slice(text, 0, at) }
}

// importsOf is the imports a file's header declares, `import PATH as
// ALIAS`: the package, by alias.
func importsOf(text string) Map[string, string] {
	let mut out = Map[string, string]{}
	for line in strings.Split(text, "\n") {
		let (kind, _) = declLine(line)
		if kind != "" {
			return out
		}
		let ws = wordsOf(line, 0)
		if ws.Len() == 4 && ws[0].Text == "import" && ws[2].Text == "as" {
			out[ws[3].Text] = ws[1].Text
		}
	}
	out
}

// exportedName is whether a name starts with a capital letter.
func exportedName(name string) bool {
	let first = strings.Slice(name, 0, 1)
	first != strings.ToLower(first)
}

// modelFormat is Model's Format.
func modelFormat(text string) string {
	let mut out = []string{}
	let mut blank = false
	for line in strings.Split(text, "\n") {
		let t = trimRight(line)
		if t == "" {
			blank = out.Len() > 0
			continue
		}
		if blank {
			out = out.Append("")
			blank = false
		}
		let (kind, _) = declLine(t)
		out = out.Append(if kind != "" { t } else { "\t" + trimLeft(t) })
	}
	if out.Len() == 0 { "" } else { strings.Join(out, "\n") + "\n" }
}

// Sample is a workspace drawn from seed, for the law runs of plans and
// apply: two or three packages of one or two files, each file one to
// three declarations whose bodies name declarations of their own package
// and of another; a short name declared in two packages; some bodies
// not canonical (extra spaces, a body not indented by a tab, two blank
// lines); and, when seed picks it, the fixable diagnostics M1 and M2, an
// M2 on the line of an M1 (their fixes overlap), and an M3.
func Sample(seed int) []Source {
	let pool = []string{"Run", "Parse", "Token", "Load", "Emit", "Walk"}
	let packages = 2 + roll(seed, 1, 2)
	// names[i] are package i's declarations, in file order; at[i] is the
	// file and place of each.
	let mut names = [][]string{}
	let mut files = []int{}
	for i in 0..packages {
		let mut mine = []string{}
		let n = 1 + roll(seed, 10+i, 2)
		files = files.Append(n)
		for f in 0..n {
			for k in 0..1+roll(seed, 20+i*7+f, 3) {
				let mut name = pool[roll(seed, 100+i*31+f*11+k*3, pool.Len())]
				if has(mine, name) {
					name = name + "\(i)\(f)\(k)"
				}
				mine = mine.Append(name)
			}
		}
		names = names.Append(mine)
	}
	let mut out = []Source{}
	for i in 0..packages {
		let path = "gen/p\(i)"
		let o = (i + 1) % packages
		let mut seen = 0
		for f in 0..files[i] {
			let mut text = "// file \(f) of \(path)\n"
			for k in 0..1+roll(seed, 20+i*7+f, 3) {
				let salt = 100 + i*31 + f*11 + k*3
				let name = names[i][seen]
				let kind = if roll(seed, salt+1, 3) == 0 { "type" } else { "func" }
				let ugly = roll(seed, salt+2, 4) == 0
				let indent = if ugly { "  " } else { "\t" }
				text = text + "\n\(kind) \(name)\n"
				for j in 0..seen {
					if roll(seed, salt+5+j, 2) == 0 {
						text = text + indent + "use \(names[i][j])  \n"
					}
				}
				let theirs = names[o][roll(seed, salt+3, names[o].Len())]
				text = text + indent + "call p\(o).\(theirs)\n"
				if roll(seed, salt+4, 5) == 0 {
					text = text + "\tfix ?\(name)\n"
				}
				if roll(seed, salt+6, 7) == 0 {
					text = text + "\tshout !\(name) ?it\n"
				}
				if roll(seed, salt+7, 11) == 0 {
					text = text + "\tcall p\(o).Nothing\n"
				}
				if ugly {
					text = text + "\n"
				}
				seen = seen + 1
			}
			out = out.Append(Source{File: path + "/f\(f).ergo", Text: text})
		}
	}
	out
}

// isBlank is whether c, one byte of text, is a space or a tab.
func isBlank(c string) bool { c == " " || c == "\t" }

// trimLeft is s without its leading spaces and tabs.
func trimLeft(s string) string {
	let mut i = 0
	for i < s.Len() && isBlank(strings.Slice(s, i, i+1)) {
		i = i + 1
	}
	strings.Slice(s, i, s.Len())
}

// trimRight is s without its trailing spaces and tabs.
func trimRight(s string) string {
	let mut j = s.Len()
	for j > 0 && isBlank(strings.Slice(s, j-1, j)) {
		j = j - 1
	}
	strings.Slice(s, 0, j)
}

// prog is a Model workspace as a tree, for the rename laws: its files,
// and each symbol's name, kind and owner (the type a field, an operation
// or a method belongs to), by the symbol's id. An id is the symbol's
// handle in Program's names, so a rename of the tree is a change of
// Names alone, and render writes the renamed text: the reference a
// plan's rename is held to.
type prog {
	Files  []pfile,
	Names  Map[string, string],
	Kinds  Map[string, string],
	Owners Map[string, string],
	Binds  []Bind,
}

// pfile is one file: its path, its imports (`PATH as ALIAS`) and its
// declarations.
type pfile {
	Path    string,
	Imports []string,
	Decls   []pdecl,
}

// pdecl is a declaration: its symbol and its body lines.
type pdecl {
	Symbol string,
	Lines  [][]tok,
}

// tok is one word of a body line: a word that names no symbol, a symbol
// by its name, a symbol of another package under a qualifier, a member
// (`T.n`), or a record literal's key (`T{n}`).
type tok =
	| tword{Text string}
	| tuse{Symbol string}
	| tqual{Prefix string, Symbol string}
	| tmember{Symbol string}
	| tkey{Symbol string}

// Program is a workspace drawn from seed: a dependency `dep/lib` with an
// operation type; package gen/p0 with an operation type and its
// provider, record types with fields and, when seed picks it, a type
// that provides the dependency's operation type; package gen/p1 with a
// type that provides gen/p0's, imported under an alias when seed picks
// it; and functions whose bodies name functions, fields (read and in
// record literals), operations and methods, declare a local, use a word
// that names nothing, and carry comments that name symbols.
func Program(seed int) prog {
	let mut kinds = Map[string, string]{}
	for id in []string{"dep/lib.Store", "gen/p0.Files", "gen/p0.Mem", "gen/p0.Disk", "gen/p1.Fake", "gen/p1.Node"} {
		kinds[id] = "type"
	}
	for id in []string{"dep/lib.Store.Get", "dep/lib.Store.Put", "gen/p0.Files.Read", "gen/p0.Files.Write"} {
		kinds[id] = "operation"
	}
	for id in []string{"gen/p0.Mem.Path", "gen/p0.Disk.Path", "gen/p1.Node.Kind"} {
		kinds[id] = "field"
	}
	for id in []string{"dep/lib.Helper", "gen/p0.Mem.Read", "gen/p0.Mem.Write", "gen/p1.Fake.Read", "gen/p1.Fake.Write"} {
		kinds[id] = "func"
	}
	let mut binds = []Bind{Bind{Op: "gen/p0.Files", By: "gen/p0.Mem"}, Bind{Op: "gen/p0.Files", By: "gen/p1.Fake"}}
	let sized = roll(seed, 1, 2) == 0
	if sized {
		kinds["gen/p0.Disk.Size"] = "field"
	}
	let cached = roll(seed, 2, 2) == 0
	if cached {
		kinds["gen/p0.Cache"] = "type"
		kinds["gen/p0.Cache.Get"] = "func"
		kinds["gen/p0.Cache.Put"] = "func"
		binds = binds.Append(Bind{Op: "dep/lib.Store", By: "gen/p0.Cache"})
	}
	let aliased = roll(seed, 3, 2) == 0
	let pre = if aliased { "zero" } else { "p0" }
	let pool0 = []string{"Run", "Parse", "Load", "Emit"}
	let pool1 = []string{"Run", "Walk", "Load"}
	let mut f0 = []string{}
	for k in 0..2+roll(seed, 4, 2) {
		let id = "gen/p0." + pool0[k]
		kinds[id] = "func"
		f0 = f0.Append(id)
	}
	let mut f1 = []string{}
	for k in 0..1+roll(seed, 5, 3) {
		let id = "gen/p1." + pool1[k]
		kinds[id] = "func"
		f1 = f1.Append(id)
	}
	let mut names = Map[string, string]{}
	let mut owners = Map[string, string]{}
	for id in maps.Keys(kinds) {
		let dot = strings.Index(id, ".")
		let rest = strings.Slice(id, dot+1, id.Len())
		let last = strings.LastIndex(id, ".")
		names[id] = strings.Slice(id, last+1, id.Len())
		if strings.Contains(rest, ".") {
			owners[id] = strings.Slice(id, 0, last)
		}
	}
	let op = func(id string) []tok { []tok{tword{Text: "op"}, tuse{Symbol: id}} }
	let field = func(id string) []tok { []tok{tword{Text: "field"}, tuse{Symbol: id}} }
	let keep = [][]tok{[]tok{tword{Text: "keep"}}}
	let lib = pfile{Path: "dep/lib/lib.ergo", Imports: []string{}, Decls: []pdecl{
		pdecl{Symbol: "dep/lib.Store", Lines: [][]tok{op("dep/lib.Store.Get"), op("dep/lib.Store.Put")}},
		pdecl{Symbol: "dep/lib.Helper", Lines: keep},
	}}
	let mut types0 = []pdecl{
		pdecl{Symbol: "gen/p0.Files", Lines: [][]tok{op("gen/p0.Files.Read"), op("gen/p0.Files.Write")}},
		pdecl{Symbol: "gen/p0.Mem", Lines: [][]tok{field("gen/p0.Mem.Path"), []tok{tword{Text: "provides"}, tuse{Symbol: "gen/p0.Files"}}}},
		pdecl{Symbol: "gen/p0.Mem.Read", Lines: [][]tok{[]tok{tword{Text: "get"}, tmember{Symbol: "gen/p0.Mem.Path"}}}},
		pdecl{Symbol: "gen/p0.Mem.Write", Lines: keep},
		pdecl{Symbol: "gen/p0.Disk", Lines: if sized { [][]tok{field("gen/p0.Disk.Path"), field("gen/p0.Disk.Size")} } else { [][]tok{field("gen/p0.Disk.Path")} }},
	}
	if cached {
		types0 = types0.Append(pdecl{Symbol: "gen/p0.Cache", Lines: [][]tok{[]tok{tword{Text: "provides"}, tqual{Prefix: "lib", Symbol: "dep/lib.Store"}}}})
		types0 = types0.Append(pdecl{Symbol: "gen/p0.Cache.Get", Lines: keep})
		types0 = types0.Append(pdecl{Symbol: "gen/p0.Cache.Put", Lines: [][]tok{[]tok{tword{Text: "call"}, tqual{Prefix: "lib", Symbol: "dep/lib.Helper"}}}})
	}
	let mut funcs0 = []pdecl{}
	for k, id in f0 {
		funcs0 = funcs0.Append(pdecl{Symbol: id, Lines: bodyOf(seed, 100+k*17, f0, k, "p1", f1, []string{"gen/p0.Disk.Path", "gen/p0.Files.Read", "gen/p0.Mem.Write"}, "gen/p0.Disk.Path", names)})
	}
	let types1 = []pdecl{
		pdecl{Symbol: "gen/p1.Fake", Lines: [][]tok{[]tok{tword{Text: "provides"}, tqual{Prefix: pre, Symbol: "gen/p0.Files"}}}},
		pdecl{Symbol: "gen/p1.Fake.Read", Lines: keep},
		pdecl{Symbol: "gen/p1.Fake.Write", Lines: [][]tok{[]tok{tword{Text: "get"}, tmember{Symbol: "gen/p1.Node.Kind"}}}},
		pdecl{Symbol: "gen/p1.Node", Lines: [][]tok{field("gen/p1.Node.Kind")}},
	}
	let mut funcs1 = []pdecl{}
	for k, id in f1 {
		funcs1 = funcs1.Append(pdecl{Symbol: id, Lines: bodyOf(seed, 300+k*17, f1, k, pre, f0, []string{"gen/p1.Node.Kind", "gen/p1.Fake.Read"}, "gen/p1.Node.Kind", names)})
	}
	// The order of declarations in a file is drawn too.
	let files = []pfile{
		lib,
		pfile{Path: "gen/p0/types.ergo", Imports: []string{}, Decls: types0},
		pfile{Path: "gen/p0/funcs.ergo", Imports: []string{}, Decls: if roll(seed, 6, 2) == 0 { funcs0 } else { slices.Reverse(funcs0) }},
		pfile{Path: "gen/p1/p1.ergo", Imports: if aliased { []string{"gen/p0 as zero"} } else { []string{} }, Decls: if roll(seed, 7, 2) == 0 { slices.Concat(types1, funcs1) } else { slices.Concat(funcs1, types1) }},
	}
	prog{Files: files, Names: names, Kinds: kinds, Owners: owners, Binds: binds}
}

// bodyOf is the body of function k of mine, drawn from seed and salt: a
// local first when drawn, uses of the functions before it (some with a
// comment that names them), a call of a function of the other package
// under the qualifier theirs, member uses, a record literal of key, the
// local used, a word that names nothing, a comment line, and a call of
// the dependency.
func bodyOf(seed int, salt int, mine []string, k int, theirs string, other []string, members []string, key string, names Map[string, string]) [][]tok {
	let mut lines = [][]tok{}
	let local = roll(seed, salt, 3) == 0
	if local {
		lines = lines.Append([]tok{tword{Text: "let"}, tword{Text: "Tmp"}})
	}
	for j in 0..mine.Len() {
		if j != k && roll(seed, salt+1+j, 2) == 0 {
			let mut line = []tok{tword{Text: "use"}, tuse{Symbol: mine[j]}}
			if roll(seed, salt+5+j, 2) == 0 {
				line = line.Append(tword{Text: "// " + maps.GetOr(names, mine[j], "") + " runs first"})
			}
			lines = lines.Append(line)
		}
	}
	if other.Len() > 0 {
		let id = other[roll(seed, salt+9, other.Len())]
		let mut line = []tok{tword{Text: "call"}, tqual{Prefix: theirs, Symbol: id}}
		if roll(seed, salt+10, 3) == 0 {
			line = line.Append(tword{Text: "// see \(theirs).\(maps.GetOr(names, id, ""))"})
		}
		lines = lines.Append(line)
	}
	for j, m in members {
		if roll(seed, salt+11+j, 2) == 0 {
			lines = lines.Append([]tok{tword{Text: "get"}, tmember{Symbol: m}})
		}
	}
	if roll(seed, salt+14, 2) == 0 {
		lines = lines.Append([]tok{tword{Text: "make"}, tkey{Symbol: key}})
	}
	if local {
		lines = lines.Append([]tok{tword{Text: "use"}, tword{Text: "Tmp"}})
	}
	if roll(seed, salt+15, 3) == 0 {
		lines = lines.Append([]tok{tword{Text: "note"}, tword{Text: "Zap"}})
	}
	if roll(seed, salt+16, 3) == 0 {
		lines = lines.Append([]tok{tword{Text: "// Run, Path and Read are names here"}})
	}
	if roll(seed, salt+17, 3) == 0 {
		lines = lines.Append([]tok{tword{Text: "call"}, tqual{Prefix: "lib", Symbol: "dep/lib.Helper"}})
	}
	if lines.Len() == 0 {
		lines = lines.Append([]tok{tword{Text: "keep"}})
	}
	lines
}
