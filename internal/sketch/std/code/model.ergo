import maps
import strings

// Model is the memory Checker the laws of plans and apply run over: a
// small language whose checker, formatter and lowered code are a few
// functions, so a law can draw a workspace, change it and check the
// result without the Go checker (the product Checker is SEM4b's, behind
// the same operation type).
//
// The language. A file's package is its folder. A line that starts with
// `func NAME` or `type NAME` declares NAME; the lines after it, to the
// next declaration, are its body, and its extent ends after its last line
// that is not blank. A body's words are its runs of text between spaces:
//
//   - a declared name of the file's package is a site of it (call for a
//     func, typeuse for a type), and `q.NAME` a site of NAME in the
//     package whose last path element is q, or the diagnostic M3 when
//     that package does not declare NAME;
//   - `?x` is the diagnostic M1, whose fix writes x in its place;
//   - `!x` is the diagnostic M2, whose fix writes the whole line as `x`;
//   - any other word names nothing.
//
// A second declaration of a name in one package is the diagnostic M4 and
// has no row. The lowered code is the declarations' handles and words,
// so a change of white space alone keeps it. Format is canonical text:
// each line without trailing white space, a body line indented by one
// tab, no blank line first or last, never two together, and one newline
// at the end.
type Model {}

func Check(_ Model, sources []Source) Report fails CheckFailed { modelCheck(sources) }

func Format(_ Model, text string) string fails CheckFailed { modelFormat(text) }

// NewModel is the Model; seed only names the provider for a law run.
func NewModel(seed int) Model { Model }

// mdecl is a declaration the model found, with its extent and its body
// lines.
type mdecl {
	Name   string,
	Kind   string,
	File   string,
	Pkg    string,
	Line   int,
	Start  int,
	End    int,
	Lines  []mline,
	Header bool,
}

// mline is one body line: its number, the offset of its first byte and
// its text without the newline.
type mline {
	Line int,
	At   int,
	Text string,
}

// packageOf is the folder of a file path.
func packageOf(file string) string {
	let at = strings.LastIndex(file, "/")
	if at < 0 { "" } else { strings.Slice(file, 0, at) }
}

// declLine is the kind and name a line declares, or ("", "").
func declLine(text string) (string, string) {
	for kind in []string{"func", "type"} {
		if strings.HasPrefix(text, kind + " ") {
			let rest = strings.Slice(text, len(kind) + 1, len(text))
			let name = firstWord(rest)
			if name != "" {
				return (kind, name)
			}
		}
	}
	("", "")
}

// firstWord is the text before the first space, without trailing white
// space.
func firstWord(s string) string {
	let at = strings.Index(s, " ")
	let w = if at < 0 { s } else { strings.Slice(s, 0, at) }
	strings.TrimSpace(w)
}

// parsed is the declarations of one file, in order.
func parsed(src Source) []mdecl {
	let lines = strings.Split(src.Text, "\n")
	let mut out = []mdecl{}
	let mut at = 0
	let mut cur = mdecl{Name: "", Kind: "", File: src.File, Pkg: packageOf(src.File), Line: 0, Start: 0, End: 0, Lines: []mline{}, Header: true}
	for i, text in lines {
		let (kind, name) = declLine(text)
		let end = if i == len(lines) - 1 { at + len(text) } else { at + len(text) + 1 }
		if kind != "" {
			if !cur.Header {
				out = out.Append(cur)
			}
			cur = mdecl{Name: name, Kind: kind, File: src.File, Pkg: packageOf(src.File), Line: i + 1, Start: at, End: end, Lines: []mline{}, Header: false}
		} else if !cur.Header {
			cur.Lines = cur.Lines.Append(mline{Line: i + 1, At: at, Text: text})
			if strings.TrimSpace(text) != "" {
				cur.End = end
			}
		}
		at = end
	}
	if !cur.Header {
		out = out.Append(cur)
	}
	out
}

// lastElement is the last element of a package path.
func lastElement(path string) string {
	let at = strings.LastIndex(path, "/")
	if at < 0 { path } else { strings.Slice(path, at + 1, len(path)) }
}

// modelCheck is Model's Check.
func modelCheck(sources []Source) Report {
	let mut decls = []mdecl{}
	let mut diags = []Diagnostic{}
	let mut pkgs = []string{}
	// declared is each package's names: the handle's kind, by name.
	let mut declared = Map[string, Map[string, string]]{}
	for src in sources {
		let pkg = packageOf(src.File)
		if !has(pkgs, pkg) {
			pkgs = pkgs.Append(pkg)
			declared[pkg] = Map[string, string]{}
		}
		for d in parsed(src) {
			let names = maps.GetOr(declared, pkg, Map[string, string]{})
			match names.Get(d.Name) {
			case Some[string]:
				diags = diags.Append(Diagnostic{Code: "M4", Message: "\(d.Name) is declared twice", File: d.File, Line: d.Line, Column: 6, Fix: None})
			case None:
				let mut next = names
				next[d.Name] = d.Kind
				declared[pkg] = next
				decls = decls.Append(d)
			}
		}
	}
	// byElement is the package each last path element names (the first).
	let mut byElement = Map[string, string]{}
	for p in pkgs {
		match byElement.Get(lastElement(p)) {
		case Some[string]:
		case None:
			byElement[lastElement(p)] = p
		}
	}
	let mut packages = []Package{}
	let mut extents = []Extent{}
	let mut code = ""
	for p in pkgs {
		let mut pd = []Decl{}
		let mut ps = []Site{}
		let mut errs = 0
		for d in decls {
			if d.Pkg != p {
				continue
			}
			let handle = p + "." + d.Name
			let col = len(d.Kind) + 2
			pd = pd.Append(Decl{Handle: handle, Kind: d.Kind, Name: d.Name, Package: p, Exported: exportedName(d.Name), File: d.File, Line: d.Line, Column: col})
			ps = ps.Append(Site{Symbol: handle, Kind: "def", Package: p, File: d.File, Line: d.Line, Column: col, In: handle})
			extents = extents.Append(Extent{Handle: handle, File: d.File, Start: d.Start, End: d.End})
			code = code + handle + ":"
			for l in d.Lines {
				let mut col0 = 1
				for w in strings.Split(l.Text, " ") {
					let word = strings.TrimSpace(w)
					let lead = len(w) - len(trimLeft(w))
					let at = l.At + col0 - 1 + lead
					let column = col0 + lead
					col0 = col0 + len(w) + 1
					if word == "" {
						continue
					}
					code = code + " " + word
					if strings.HasPrefix(word, "?") && len(word) > 1 {
						diags = diags.Append(Diagnostic{Code: "M1", Message: "\(word) is not declared", File: d.File, Line: l.Line, Column: column, Fix: Some[Edit]{Value: Edit{File: d.File, Start: at, End: at + len(word), Text: strings.Slice(word, 1, len(word))}}})
						errs = errs + 1
						continue
					}
					if strings.HasPrefix(word, "!") && len(word) > 1 {
						diags = diags.Append(Diagnostic{Code: "M2", Message: "\(word) shouts", File: d.File, Line: l.Line, Column: column, Fix: Some[Edit]{Value: Edit{File: d.File, Start: l.At, End: l.At + len(l.Text), Text: "\t" + strings.Slice(word, 1, len(word))}}})
						errs = errs + 1
						continue
					}
					let names = maps.GetOr(declared, p, Map[string, string]{})
					match names.Get(word) {
					case Some[string] as k:
						ps = ps.Append(Site{Symbol: p + "." + word, Kind: siteKindOf(k.Value), Package: p, File: d.File, Line: l.Line, Column: column, In: handle})
					case None:
						match strings.Cut(word, ".") {
						case Some[strings.Halves] as h:
							match byElement.Get(h.Value.Before) {
							case Some[string] as q:
								match maps.GetOr(declared, q.Value, Map[string, string]{}).Get(h.Value.After) {
								case Some[string] as k:
									ps = ps.Append(Site{Symbol: q.Value + "." + h.Value.After, Kind: siteKindOf(k.Value), Package: p, File: d.File, Line: l.Line, Column: column + len(h.Value.Before) + 1, In: handle})
								case None:
									diags = diags.Append(Diagnostic{Code: "M3", Message: "\(word) is not declared", File: d.File, Line: l.Line, Column: column, Fix: None})
									errs = errs + 1
								}
							case None:
							}
						case None:
						}
					}
				}
			}
			code = code + "\n"
		}
		for x in diags {
			if packageOf(x.File) == p && x.Code == "M4" {
				errs = errs + 1
			}
		}
		packages = packages.Append(Package{Path: p, Complete: errs == 0, Diagnostics: errs, Decls: pd, Sites: ps})
	}
	Report{Tables: Tables{Revision: revisionOf(sources), Packages: packages}, Extents: extents, Diagnostics: diags, Code: revision(code)}
}

func siteKindOf(declKind string) string { if declKind == "func" { "call" } else { "typeuse" } }

// exportedName is whether a name starts with a capital letter.
func exportedName(name string) bool {
	let first = strings.Slice(name, 0, 1)
	first != strings.ToLower(first)
}

// modelFormat is Model's Format.
func modelFormat(text string) string {
	let mut out = []string{}
	let mut blank = false
	for line in strings.Split(text, "\n") {
		let t = trimRight(line)
		if t == "" {
			blank = len(out) > 0
			continue
		}
		if blank {
			out = out.Append("")
			blank = false
		}
		let (kind, _) = declLine(t)
		out = out.Append(if kind != "" { t } else { "\t" + trimLeft(t) })
	}
	if len(out) == 0 { "" } else { strings.Join(out, "\n") + "\n" }
}

// Sample is a workspace drawn from seed, for the law runs of plans and
// apply: two or three packages of one or two files, each file one to
// three declarations whose bodies name declarations of their own package
// and of another; a short name declared in two packages; some bodies
// not canonical (extra spaces, a body not indented by a tab, two blank
// lines); and, when seed picks it, the fixable diagnostics M1 and M2, an
// M2 on the line of an M1 (their fixes overlap), and an M3.
func Sample(seed int) []Source {
	let pool = []string{"Run", "Parse", "Token", "Load", "Emit", "Walk"}
	let packages = 2 + roll(seed, 1, 2)
	// names[i] are package i's declarations, in file order; at[i] is the
	// file and place of each.
	let mut names = [][]string{}
	let mut files = []int{}
	for i in 0..packages {
		let mut mine = []string{}
		let n = 1 + roll(seed, 10 + i, 2)
		files = files.Append(n)
		for f in 0..n {
			for k in 0..1 + roll(seed, 20 + i*7 + f, 3) {
				let mut name = pool[roll(seed, 100 + i*31 + f*11 + k*3, len(pool))]
				if has(mine, name) {
					name = name + "\(i)\(f)\(k)"
				}
				mine = mine.Append(name)
			}
		}
		names = names.Append(mine)
	}
	let mut out = []Source{}
	for i in 0..packages {
		let path = "gen/p\(i)"
		let o = (i + 1) % packages
		let mut seen = 0
		for f in 0..files[i] {
			let mut text = "// file \(f) of \(path)\n"
			for k in 0..1 + roll(seed, 20 + i*7 + f, 3) {
				let salt = 100 + i*31 + f*11 + k*3
				let name = names[i][seen]
				let kind = if roll(seed, salt + 1, 3) == 0 { "type" } else { "func" }
				let ugly = roll(seed, salt + 2, 4) == 0
				let indent = if ugly { "  " } else { "\t" }
				text = text + "\n\(kind) \(name)\n"
				for j in 0..seen {
					if roll(seed, salt + 5 + j, 2) == 0 {
						text = text + indent + "use \(names[i][j])  \n"
					}
				}
				let theirs = names[o][roll(seed, salt + 3, len(names[o]))]
				text = text + indent + "call p\(o).\(theirs)\n"
				if roll(seed, salt + 4, 5) == 0 {
					text = text + "\tfix ?\(name)\n"
				}
				if roll(seed, salt + 6, 7) == 0 {
					text = text + "\tshout !\(name) ?it\n"
				}
				if roll(seed, salt + 7, 11) == 0 {
					text = text + "\tcall p\(o).Nothing\n"
				}
				if ugly {
					text = text + "\n"
				}
				seen = seen + 1
			}
			out = out.Append(Source{File: path + "/f\(f).ergo", Text: text})
		}
	}
	out
}

// isBlank is whether c, one byte of text, is a space or a tab.
func isBlank(c string) bool { c == " " || c == "\t" }

// trimLeft is s without its leading spaces and tabs.
func trimLeft(s string) string {
	let mut i = 0
	for i < len(s) && isBlank(strings.Slice(s, i, i + 1)) {
		i = i + 1
	}
	strings.Slice(s, i, len(s))
}

// trimRight is s without its trailing spaces and tabs.
func trimRight(s string) string {
	let mut j = len(s)
	for j > 0 && isBlank(strings.Slice(s, j - 1, j)) {
		j = j - 1
	}
	strings.Slice(s, 0, j)
}
