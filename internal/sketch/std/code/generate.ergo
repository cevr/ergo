import strings

// Generated is a workspace's tables drawn from seed, for the law runs of
// a reader: one to three packages, a short name declared in more than one
// of them (an Ambiguous address), member handles (Type.Member), a local
// named by its position, sites of every kind that name declarations of
// their own package and of another, positions that two sites share, and
// a package that does not check, contracts of exported functions, and
// calls between functions, laws and locals (cycles and calls to self
// included), each charging capabilities (types of the tables, and Console,
// which none declares) that it brings or a with discharges, and rows that
// hold what the calls bring and sometimes more; and machine graphs with
// arms of any pair, partial arms, edges of every decision (to any state,
// or of unknown kind), timers, work and unsure states.
// The same seed gives the same tables.
func Generated(seed int) Tables {
	let names = []string{"Run", "Parse", "Token", "Token.Kind", "Token.Text", "Load", "Check#law", "Light"}
	let kinds = []string{"func", "func", "type", "field", "field", "func", "law", "machine"}
	let siteKinds = []string{"def", "read", "write", "call", "typeuse", "construct", "match", "import", "needs", "fails", "provides", "binds", "handles"}
	let packages = 1 + roll(seed, 1, 3)
	let mut out = []Package{}
	let mut handles = []string{}
	for i in 0..packages {
		let path = "gen/p\(i)"
		let mut decls = []Decl{}
		for j, name in names {
			if roll(seed, 100+i*10+j, 4) != 0 {
				let d = Decl{Handle: path + "." + name, Kind: kinds[j], Name: lastPart(name), Package: path, Exported: roll(seed, 200+i*10+j, 2) == 0, File: path + "/a.ergo", Line: 1 + j, Column: 1}
				decls = decls.Append(d)
				handles = handles.Append(d.Handle)
			}
		}
		// A local with no handle is named by its position.
		let local = Decl{Handle: positionOf(path+"/a.ergo", 20+i, 5), Kind: "local", Name: "v", Package: path, Exported: false, File: path + "/a.ergo", Line: 20 + i, Column: 5}
		decls = decls.Append(local)
		handles = handles.Append(local.Handle)
		let complete = roll(seed, 300+i, 5) != 0
		out = out.Append(Package{Path: path, Complete: complete, Diagnostics: if complete { 0 } else { 1 + roll(seed, 400+i, 3) }, Decls: decls, Sites: []Site{}, Contracts: []Contract{}, Calls: []Call{}, Needs: []Need{}, Fails: []Failing{}, Machines: []MachineGraph{}})
	}
	// The types are capabilities and failures by turns, each list with a
	// name no package declares; the functions are providers.
	let mut capabilities = []string{"Console"}
	let mut failures = []string{"Fault"}
	let mut providers = []string{}
	for p in out {
		for d in p.Decls {
			if d.Kind == "type" {
				if (capabilities.Len()+failures.Len())%2 == 0 {
					capabilities = capabilities.Append(d.Handle)
				} else {
					failures = failures.Append(d.Handle)
				}
			}
			if d.Kind == "func" {
				providers = providers.Append(d.Handle)
			}
		}
	}
	let mut filled = []Package{}
	for i, p in out {
		let mut sites = []Site{}
		for j in 0..roll(seed, 500+i, 12) {
			let salt = 1000 + i*100 + j*5
			let h = handles[roll(seed, salt, handles.Len())]
			let kind = siteKinds[roll(seed, salt+1, siteKinds.Len())]
			// Lines 30..34 and columns 1..3: some sites share a position.
			sites = sites.Append(Site{Symbol: h, Kind: kind, Package: p.Path, File: p.Path + "/a.ergo", Line: 30 + roll(seed, salt+2, 5), Column: 1 + roll(seed, salt+3, 3), In: ""})
		}
		let mut calls = []Call{}
		let mut callers = []string{}
		for d in p.Decls {
			if d.Kind == "func" || d.Kind == "law" {
				callers = callers.Append(d.Handle)
			}
		}
		if callers.Len() > 0 {
			for j in 0..roll(seed, 700+i, 9) {
				let salt = 2000 + i*100 + j*3
				let (brings, discharged) = charged(seed, salt+2, capabilities)
				let (raised, caught) = charged(seed, 90000+salt, failures)
				// Now and then a catch takes only some values of a failure:
				// the call raises it too.
				let mut raises = raised
				for k, f in caught {
					if roll(seed, 93000+salt*7+k, 3) == 0 {
						raises = raises.Append(f)
					}
				}
				let mut bound = []Binding{}
				for k, c in discharged {
					if providers.Len() > 0 && roll(seed, 95000+salt*7+k, 2) == 0 {
						bound = bound.Append(Binding{Capability: c, Provider: providers[roll(seed, 97000+salt*7+k, providers.Len())]})
					}
				}
				calls = calls.Append(Call{From: callers[roll(seed, salt, callers.Len())], To: handles[roll(seed, salt+1, handles.Len())], File: p.Path + "/a.ergo", Line: 40 + j, Column: 2, Brings: brings, Discharged: discharged, Bound: bound, Raises: raises, Caught: caught})
			}
		}
		filled = filled.Append(Package{Path: p.Path, Complete: p.Complete, Diagnostics: p.Diagnostics, Decls: p.Decls, Sites: sites, Contracts: contractsOf(seed, i, p.Decls), Calls: calls, Needs: needsIn(calls, callers, seed, i, capabilities), Fails: failsIn(calls, callers, seed, i, failures), Machines: machinesIn(seed, i, p)})
	}
	Tables{Revision: "gen-\(seed)", Root: "gen/p\(packages - 1)", Packages: filled}
}

// roll is a number in 0..n-1 that seed and salt pick: a hash, enough to
// draw tables, not a source of randomness.
func roll(seed int, salt int, n int) int {
	let mut h = (seed*1000003 + salt*7919 + 12345) % 2147483647
	if h < 0 {
		h = -h
	}
	h = (h * 48271) % 2147483647
	(h / 7) % n
}

// lastPart is the part of a dotted name after its last dot.
func lastPart(name string) string {
	let at = strings.LastIndex(name, ".")
	if at < 0 { name } else { strings.Slice(name, at+1, name.Len()) }
}

// contractsOf is a contract for each exported function of decls, drawn
// from seed and salt: a signature, type parameters, rows, takes (written
// or inferred, "self" too) and copy sites.
func contractsOf(seed int, salt int, decls []Decl) []Contract {
	let sigs = []string{"()", "(s string) int", "(xs []T) T fails Empty", "(r *Reader) bool needs Console"}
	let mut out = []Contract{}
	for j, d in decls {
		if d.Kind != "func" || !d.Exported {
			continue
		}
		let k = 3000 + salt*50 + j*7
		let generic = roll(seed, k, 3) == 0
		let taking = roll(seed, k+1, 3)
		let self = roll(seed, k+2, 4) == 0
		let mut names = []string{}
		let mut indexes = []int{}
		if self {
			names = names.Append("self")
		}
		for t in 0..taking {
			names = names.Append("p\(t)")
			indexes = indexes.Append(t)
		}
		let own = if generic && roll(seed, k+3, 2) == 0 { []string{"T"} } else { []string{} }
		out = out.Append(Contract{Name: d.Name, Signature: sigs[roll(seed, k+6, sigs.Len())], TypeParameters: if generic { []string{"T"} } else { []string{} }, Fails: "", Needs: "", Takes: names, TakesParameters: indexes, TakesSelf: self, TakesInferred: roll(seed, k+7, 2) == 0, Own: own})
	}
	out
}

// charged is a call's capabilities: each of caps it brings or a with
// discharges, or neither.
func charged(seed int, salt int, caps []string) ([]string, []string) {
	let mut brings = []string{}
	let mut discharged = []string{}
	for k, c in caps {
		match roll(seed, salt*7+k, 4) {
		case 0:
			brings = brings.Append(c)
		case 1:
			discharged = discharged.Append(c)
		case _:
		}
	}
	(brings, discharged)
}

// needsIn is the rows of a package's callers: what their calls bring, and
// now and then a capability no call brings (a written row).
func needsIn(calls []Call, callers []string, seed int, i int, caps []string) []Need {
	let mut out = []Need{}
	for j, f in callers {
		let mut row = []string{}
		for c in calls {
			if c.From == f {
				for k in c.Brings {
					if !has(row, k) {
						row = row.Append(k)
					}
				}
			}
		}
		if caps.Len() > 0 && roll(seed, 2700+i*10+j, 3) == 0 {
			let k = caps[roll(seed, 2800+i*10+j, caps.Len())]
			if !has(row, k) {
				row = row.Append(k)
			}
		}
		for k in row {
			out = out.Append(Need{Of: f, Capability: k})
		}
	}
	out
}

// failsIn is the fails rows of a package's callers: what their calls
// raise, and now and then a failure no call raises (one the function
// fails with itself).
func failsIn(calls []Call, callers []string, seed int, i int, failures []string) []Failing {
	let mut out = []Failing{}
	for j, f in callers {
		let mut row = []string{}
		for c in calls {
			if c.From == f {
				for k in c.Raises {
					if !has(row, k) {
						row = row.Append(k)
					}
				}
			}
		}
		if failures.Len() > 0 && roll(seed, 3700+i*10+j, 3) == 0 {
			let k = failures[roll(seed, 3800+i*10+j, failures.Len())]
			if !has(row, k) {
				row = row.Append(k)
			}
		}
		for k in row {
			out = out.Append(Failing{Of: f, Failure: k})
		}
	}
	out
}

// machinesIn is the graph of each machine declaration of p.
func machinesIn(seed int, i int, p Package) []MachineGraph {
	let decisions = []string{"Enter", "Stay", "Emit", "Tell", "Ignore", "Reject", "Done", "?"}
	let mut out = []MachineGraph{}
	for d in p.Decls {
		if d.Kind != "machine" {
			continue
		}
		let salt = 3000 + i*200
		let mut states = []string{}
		for k in 0..1+roll(seed, salt, 4) {
			states = states.Append("S\(k)")
		}
		let mut signals = []string{}
		for k in 0..1+roll(seed, salt+1, 3) {
			signals = signals.Append("E\(k)")
		}
		let at = func(line int) Place { Place{What: "", File: p.Path + "/m.ergo", Line: line} }
		let mut arms = []Arm{}
		for a in 0..roll(seed, salt+2, 6) {
			let r = salt + 10 + a*10
			let anyState = roll(seed, r, 4) == 0
			let anySignal = roll(seed, r+1, 3) == 0
			let mut edges = []Transition{}
			for e in 0..roll(seed, r+2, 3) {
				let kind = decisions[roll(seed, r+3+e, decisions.Len())]
				let to = if kind == "Ignore" || kind == "Reject" || kind == "Done" { "" } else if roll(seed, r+6+e, 5) == 0 { "*" } else { states[roll(seed, r+8+e, states.Len())] }
				edges = edges.Append(Transition{Decision: kind, To: to, At: at(100 + a*10 + e)})
			}
			// One arm in four is a case of two tuple patterns, (A, X), (B, Y):
			// its States and Signals are both patterns' and Alts each one's.
			let mut alts = []Alt{}
			if !anyState && !anySignal && roll(seed, r+9, 4) == 0 {
				for k in 0..2 {
					alts = alts.Append(Alt{States: []string{states[roll(seed, r+4+k*20, states.Len())]}, AnyState: false, Signals: []string{signals[roll(seed, r+5+k*20, signals.Len())]}, AnySignal: false, Partial: roll(seed, r+7+k*20, 3) == 0})
				}
			}
			let mut armStates = []string{}
			let mut armSignals = []string{}
			if alts.Len() == 0 {
				if !anyState {
					armStates = []string{states[roll(seed, r+4, states.Len())]}
				}
				if !anySignal {
					armSignals = []string{signals[roll(seed, r+5, signals.Len())]}
				}
			}
			for x in alts {
				if !has(armStates, x.States[0]) {
					armStates = armStates.Append(x.States[0])
				}
				if !has(armSignals, x.Signals[0]) {
					armSignals = armSignals.Append(x.Signals[0])
				}
			}
			let partial = if alts.Len() == 0 { roll(seed, r+7, 3) == 0 } else { alts[0].Partial || alts[1].Partial }
			arms = arms.Append(Arm{At: at(100 + a*10), States: armStates, AnyState: anyState, Signals: armSignals, AnySignal: anySignal, Partial: partial, Edges: edges, Alts: alts})
		}
		let mut timers = []Timer{}
		let mut work = []Place{}
		let mut exit = []Place{}
		let mut unsure = []string{}
		for k, s in states {
			if roll(seed, salt+140+k, 3) == 0 {
				exit = exit.Append(Place{What: s, File: p.Path + "/m.ergo", Line: 240 + k})
			}
			match roll(seed, salt+100+k, 5) {
			case 0:
				timers = timers.Append(Timer{State: s, Signal: signals[roll(seed, salt+120+k, signals.Len())], At: at(200 + k)})
			case 1:
				work = work.Append(Place{What: s, File: p.Path + "/m.ergo", Line: 220 + k})
			case 2:
				unsure = unsure.Append(s)
			case _:
			}
		}
		let initial = if roll(seed, salt+3, 5) == 0 { "*" } else { states[roll(seed, salt+4, states.Len())] }
		out = out.Append(MachineGraph{Handle: d.Handle, Name: d.Name, States: states, Signals: signals, Initial: initial, Arms: arms, Timers: timers, Work: work, Exit: exit, Unsure: unsure, Computed: []string{}})
	}
	out
}
