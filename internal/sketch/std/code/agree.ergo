import strings

// IndexIsScan: on generated tables, the indexed reader and the reference
// reader give equal answers to every question: Describe; Symbols by name,
// prefix, part, kind and package, a page at a time; Symbol and References
// at every handle, every short name (an Ambiguous one included), every
// position of a site, and addresses that name nothing.
law IndexIsScan(seed int, size int) { indexIsScan(seed, size) }

func indexIsScan(seed int, size int) bool {
	let t = Generated(seed)
	let indexed = with context { Reader: IndexOf(t) } { answers(t, size) }
	let scanned = with context { Reader: ScanOf(t) } { answers(t, size) }
	indexed == scanned
}

// Outcome is the answer to one question: a declaration, a page of sites
// or of declarations, a summary, or the failure's name and candidates.
type Outcome {
	Question   string,
	Decl       Option[Decl],
	Sites      Option[SitePage],
	Decls      Option[SymbolPage],
	Summary    Option[Summary],
	Failure    string,
	Candidates []string,
}

// answers is the reader's answer to each question about the tables t,
// with pages of 1 + size mod 7 rows.
func answers(t Tables, size int) []Outcome needs Reader {
	let step = 1 + slot(size, 7)
	let mut out = []Outcome{Outcome{Question: "describe", Decl: None, Sites: None, Decls: None, Summary: Some[Summary]{Value: Reader.Describe()}, Failure: "", Candidates: []string{}}}
	let mut addresses = []string{"nosuch", "gen/p9.Run", "gen/p0/a.ergo:99:9", "Token.Nothing"}
	for p in t.Packages {
		for d in p.Decls {
			addresses = addresses.Append(d.Handle)
			addresses = addresses.Append(strings.TrimPrefix(d.Handle, d.Package + "."))
			let q = SymbolQuery{Name: Some[string]{Value: head(d.Name, 2)}, Match: Some[string]{Value: "prefix"}, Kind: Some[string]{Value: d.Kind}, Package: None, Offset: None, Limit: Some[int]{Value: step}}
			out = out.Append(listed("prefix " + d.Handle, q))
			out = out.Append(listed("part " + d.Handle, SymbolQuery{Name: Some[string]{Value: tail(d.Name, 1)}, Match: Some[string]{Value: "part"}, Kind: None, Package: Some[string]{Value: d.Package}, Offset: Some[int]{Value: 1}, Limit: Some[int]{Value: step}}))
			out = out.Append(listed("exact " + d.Handle, SymbolQuery{Name: Some[string]{Value: d.Name}, Match: None, Kind: None, Package: None, Offset: None, Limit: None}))
		}
		for s in p.Sites {
			addresses = addresses.Append(positionOf(s.File, s.Line, s.Column))
		}
	}
	for a in addresses {
		out = out.Append(declAt(a))
		out = out.Append(sitesAt(a, []string{}, step))
		out = out.Append(sitesAt(a, []string{"call", "read", "def"}, step))
	}
	out
}

// head is the first n bytes of s, or s when it is shorter.
func head(s string, n int) string { if len(s) < n { s } else { strings.Slice(s, 0, n) } }

// tail is s without its first n bytes, or "" when it is shorter.
func tail(s string, n int) string { if len(s) < n { "" } else { strings.Slice(s, n, len(s)) } }

func listed(question string, q SymbolQuery) Outcome needs Reader {
	Outcome{Question: question, Decl: None, Sites: None, Decls: Some[SymbolPage]{Value: Reader.Symbols(q)}, Summary: None, Failure: "", Candidates: []string{}}
}

func declAt(a string) Outcome needs Reader {
	let d = Reader.Symbol(a) catch {
	case NoSymbol:
		return Outcome{Question: "symbol " + a, Decl: None, Sites: None, Decls: None, Summary: None, Failure: "NoSymbol", Candidates: []string{}}
	case Ambiguous as m:
		return Outcome{Question: "symbol " + a, Decl: None, Sites: None, Decls: None, Summary: None, Failure: "Ambiguous", Candidates: m.Candidates}
	}
	Outcome{Question: "symbol " + a, Decl: Some[Decl]{Value: d}, Sites: None, Decls: None, Summary: None, Failure: "", Candidates: []string{}}
}

func sitesAt(a string, kinds []string, step int) Outcome needs Reader {
	let page = All(a, kinds, step) catch {
	case NoSymbol:
		return Outcome{Question: "references " + a, Decl: None, Sites: None, Decls: None, Summary: None, Failure: "NoSymbol", Candidates: []string{}}
	case Ambiguous as m:
		return Outcome{Question: "references " + a, Decl: None, Sites: None, Decls: None, Summary: None, Failure: "Ambiguous", Candidates: m.Candidates}
	}
	Outcome{Question: "references " + a, Decl: None, Sites: Some[SitePage]{Value: page}, Decls: None, Summary: None, Failure: "", Candidates: []string{}}
}
