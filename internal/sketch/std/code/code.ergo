// Package code answers questions about a workspace's code from its fact
// tables: the declarations of its packages and the sites that name each
// one, as the checker resolved them (docs/spec/code.md; SEMTOOLS SEM1).
// Reader is the contract. `ergo code` is its command line, generated from
// it by `ergo gen cli`; the MCP tools and the HTTP endpoint will be
// generated from it too. A tool that needs only Reader cannot write: its
// row says so.
//
// A declaration is named by its handle, the printable name its package
// path and its name make: `examples/calc/ast.Parse`, `ast.Token.Kind` (a
// field, an operation, a member law), `ast.Parse.src` (a parameter). An
// Address is a handle, a position (`file:line:column`) or a short name
// (`Parse`, `Token.Kind`). A short name that fits two declarations fails
// Ambiguous with the candidates: the reader never picks one.
//
// The providers: Index (package code; the tables, indexed by handle) and
// Scan (package code; the same rows, read by a full scan for every
// question: slow and plainly right, the reference the laws hold Index to).
//
// Prior art: Gleam's compiler records kinded references while it checks
// and its language server reads them; gopls serves symbol references to
// agents by name ("lib.T.M"); SCIP names symbols by printable strings.

import option
import strconv
import strings
import slices

// NoSymbol is the failure of an address that names no declaration.
type NoSymbol { Address string }

// Ambiguous is the failure of a short name that fits several
// declarations; Candidates are their handles, in table order.
type Ambiguous { Address string, Candidates []string }

// Decl is a declaration: its handle, its kind (func, type, variant, field,
// operation, machine, law, test, context, let, param, typeparam, local,
// package), its name, its package, whether its package exports it, and
// the position of its name. A local whose declaration binds its name more
// than once has no handle; its Handle is its position, the one address it
// has.
type Decl {
	Handle   string,
	Kind     string,
	Name     string,
	Package  string,
	Exported bool,
	File     string,
	Line     int,
	Column   int,
}

// Site is one place that names a declaration: the declaration's handle,
// the site's kind (def, read, write, call, typeuse, construct, match,
// import, needs, fails, provides, binds, handles), where it is, and the
// handle of the declaration it is in ("" at the top of a file).
type Site {
	Symbol  string,
	Kind    string,
	Package string,
	File    string,
	Line    int,
	Column  int,
	In      string,
}

// Package is one package's tables, as the checker wrote them: its
// declarations and its sites, each in table order, the contracts of its
// exported functions (api.ergo; none when it does not check), and its
// calls, one per call site, in table order (calls.ergo).
// Complete is false when the package does not check: its rows are the
// ones the checker resolved, and Diagnostics counts its errors.
type Package {
	Path        string,
	Complete    bool,
	Diagnostics int,
	Decls       []Decl,
	Sites       []Site,
	Contracts   []Contract,
	Calls       []Call,
	Needs       []Need,
	Fails       []Failing,
	Machines    []MachineGraph,
}

// Tables are a workspace's fact tables at one revision. Root is the path
// of the program's own package, the one a question about "the program"
// means.
type Tables {
	Revision string,
	Root     string,
	Packages []Package,
}

// Summary describes the tables a reader answers from: the revision, the
// packages, whether every package checks, and how many errors, symbols
// and sites they hold.
type Summary {
	Revision    string,
	Packages    []string,
	Complete    bool,
	Diagnostics int,
	Symbols     int,
	Sites       int,
}

// SymbolQuery asks for declarations by name: exactly (Match "exact", the
// default), by prefix ("prefix") or by a part of the name ("part"); of one
// kind or any; in one package or any. With no Name it asks for every
// declaration. Offset and Limit page the answer (Limit is 100 by default,
// at most 1000). Each field is optional, so each is a flag a command line
// may leave out.
type SymbolQuery {
	Name    option.Option[string],
	Match   option.Option[string],
	Kind    option.Option[string],
	Package option.Option[string],
	Offset  option.Option[int],
	Limit   option.Option[int],
}

// SymbolPage is a page of declarations in table order. Total counts every
// declaration the query fits; Next is the offset of the next page, or -1
// after the last.
type SymbolPage {
	Revision string,
	Decls    []Decl,
	Total    int,
	Next     int,
}

// RefQuery asks for the sites of the declaration at Of, of the kinds in
// Kinds (every kind when it is empty), a page at a time.
type RefQuery {
	Of     string,
	Kinds  []string,
	Offset option.Option[int],
	Limit  option.Option[int],
}

// SitePage is a page of sites in table order (by package, then file
// order). Complete is false when a package of the tables does not check.
type SitePage {
	Revision string,
	Complete bool,
	Sites    []Site,
	Total    int,
	Next     int,
}

// Reader answers questions about the code from the fact tables.
type Reader {
	// Describe is the revision and the extent of the tables.
	Describe() Summary,
	// Symbols is a page of the declarations q asks for.
	Symbols(q SymbolQuery) SymbolPage,
	// Symbol is the declaration at the address a.
	Symbol(a string) Decl fails NoSymbol | Ambiguous,
	// References is a page of the sites of the declaration at q.Of.
	References(q RefQuery) SitePage fails NoSymbol | Ambiguous,
	// Calls is a page of the calls out of the declaration at q.Of, or
	// into it, to a depth.
	Calls(q CallQuery) CallPage fails NoSymbol | Ambiguous | NotCallable,
	// Api is the contracts of a package's exported functions.
	Api(q ApiQuery) ApiView fails NoPackage,
	// Reach is a page of the functions whose row holds a capability, each
	// with a chain of calls that brings it, and where withs discharge it.
	Reach(q ReachQuery) ReachPage fails NoSymbol | Ambiguous,
	// MachineOf is the graph of the machine declaration at a, and the pairs
	// a run of it can step.
	MachineOf(a string) MachineView fails NoSymbol | Ambiguous | NotMachine,

	// HandleRoundTrips: the declaration at a declaration's handle is that
	// declaration, so a handle printed by one answer addresses it in the
	// next.
	law HandleRoundTrips(pick int) { handleRoundTrips(pick) },
	// ReferencesAreSound: each site of an answer names the declaration
	// asked for, with a kind asked for.
	law ReferencesAreSound(pick int, kinds []string) { referencesAreSound(pick, kinds) },
	// ReferencesAreComplete: the sites of every declaration, counted, are
	// every site of the tables.
	law ReferencesAreComplete() { referencesAreComplete() },
	// PagesPartition: the pages of an answer, read in order at any size,
	// hold each of its rows once, in the order of one page that holds all.
	law PagesPartition(pick int, size int) { pagesPartition(pick, size) },
	// CallsAreSteps: a calls answer one step deeper begins with the answer
	// before and adds only hops of the new depth; at depth 1 each hop is a
	// call of (or, in, to) the declaration asked about.
	law CallsAreSteps(pick int, depth int, inbound bool) { callsAreSteps(pick, depth, inbound) },
	// ReachChainsAreCalls: a reach answer's chains are chains of calls
	// that each bring the capability, from the function to a declaration
	// that brings it no further; a discharge does not bring a capability.
	law ReachChainsAreCalls(pick int) { reachChainsAreCalls(pick) },
	// MachineArmsStopAtAWholeArm: the arms of each reachable pair take
	// it, in match order, and each but the last is partial.
	law MachineArmsStopAtAWholeArm(pick int) { machineArmsStopAtAWholeArm(pick) },
}

// CallsAreSteps: a calls answer at depth n+1 begins with the answer at
// depth n, and the hops it adds are at depth n+1; at depth 1 out of a
// declaration, they are exactly the calls it makes.
func callsAreSteps(pick int, depth int, inbound bool) bool needs Reader {
	let n = 1 + slot(depth, 3)
	match picked(pick) {
	case option.None:
		true
	case option.Some[Decl] as d:
		if !callable(d.Value.Kind) {
			return true
		}
		let dir = option.Some[string]{Value: if inbound { "in" } else { "out" }}
		let short = Reader.Calls(CallQuery{Of: d.Value.Handle, Direction: dir, Depth: option.Some[int]{Value: n}, Offset: option.None, Limit: option.Some[int]{Value: MaxLimit}}) catch {
		case _:
			return false
		}
		let long = Reader.Calls(CallQuery{Of: d.Value.Handle, Direction: dir, Depth: option.Some[int]{Value: n + 1}, Offset: option.None, Limit: option.Some[int]{Value: MaxLimit}}) catch {
		case _:
			return false
		}
		let mut ok = long.Hops.Len() >= short.Hops.Len()
		for i, h in long.Hops {
			ok = ok && (if i < short.Hops.Len() { h == short.Hops[i] } else { h.Depth == n+1 })
		}
		if n == 1 {
			for h in short.Hops {
				ok = ok && (if inbound { h.Call.To } else { h.Call.From }) == d.Value.Handle
			}
		}
		ok
	}
}

// MachineArmsStopAtAWholeArm: in a machine view, the arms of each pair
// all take it, each but the last is partial, and they are in match order.
func machineArmsStopAtAWholeArm(pick int) bool needs Reader {
	match picked(pick) {
	case option.None:
		true
	case option.Some[Decl] as d:
		let v = Reader.MachineOf(d.Value.Handle) catch {
		case NotMachine:
			return d.Value.Kind != "machine"
		case _:
			return false
		}
		let mut ok = true
		for p in v.Reachable {
			let mut last = -1
			for k, at in p.Arms {
				let i = slices.IndexFunc(v.Graph.Arms, func(a Arm) bool { a.At == at })
				ok = ok && i > last && takesIt(v.Graph.Arms[i], p.State, p.Signal) && (k == p.Arms.Len()-1 || partialAt(v.Graph.Arms[i], p.State, p.Signal))
				last = i
			}
		}
		ok
	}
}

// ReachChainsAreCalls: each function of a reach answer is a declaration of
// the reader, and its chain is a chain of calls that each bring what was
// asked about, from the function to a declaration whose own calls bring
// it no further, or back to a declaration of the chain; no discharge
// brings a capability (a failure a catch takes only some values of is
// both caught and raised at its call, and a chain may pass it).
func reachChainsAreCalls(pick int) bool needs Reader {
	match picked(pick) {
	case option.None:
		true
	case option.Some[Decl] as d:
		let page = Reader.Reach(ReachQuery{Of: d.Value.Handle, Offset: option.None, Limit: option.Some[int]{Value: MaxLimit}}) catch {
		case _:
			return false
		}
		let mut ok = true
		for r in page.Reached {
			let _ = Reader.Symbol(r.Function) catch {
			case _:
				return false
			}
			let mut at = r.Function
			let mut on = []string{}
			for c in r.Chain {
				ok = ok && c.From == at && carries(c, page.Of)
				on = on.Append(at)
				at = c.To
			}
			if r.Chain.Len() > 0 {
				ok = ok && (!bringsFurther(at, page.Of) || has(on, at))
			}
		}
		for c in page.Discharges {
			ok = ok && stops(c, page.Of) && !has(c.Brings, page.Of)
		}
		ok
	}
}

// bringsFurther is whether a call of the declaration at h brings x.
func bringsFurther(h string, x string) bool needs Reader {
	let page = Reader.Calls(CallQuery{Of: h, Direction: option.None, Depth: option.None, Offset: option.None, Limit: option.Some[int]{Value: MaxLimit}}) catch {
	case _:
		return false
	}
	for hop in page.Hops {
		if carries(hop.Call, x) {
			return true
		}
	}
	false
}

// DefaultLimit is a page's size when a query sets none; MaxLimit is the
// largest page.
let DefaultLimit = 100
let MaxLimit = 1000

// Every is every declaration of the reader's tables, in table order, read
// a page at a time.
func Every() []Decl needs Reader {
	let mut out = []Decl{}
	let mut at = 0
	for at >= 0 {
		let page = Reader.Symbols(SymbolQuery{Name: option.None, Match: option.None, Kind: option.None, Package: option.None, Offset: option.Some[int]{Value: at}, Limit: option.Some[int]{Value: MaxLimit}})
		for d in page.Decls {
			out = out.Append(d)
		}
		at = page.Next
	}
	out
}

// All is every site of the declaration at a, of the kinds in kinds (every
// kind when it is empty), read a page of size at a time.
func All(a string, kinds []string, size int) SitePage fails NoSymbol | Ambiguous needs Reader {
	let mut out = []Site{}
	let mut at = 0
	let mut last = SitePage{Revision: "", Complete: true, Sites: []Site{}, Total: 0, Next: -1}
	for at >= 0 {
		last = try Reader.References(RefQuery{Of: a, Kinds: kinds, Offset: option.Some[int]{Value: at}, Limit: option.Some[int]{Value: size}})
		for s in last.Sites {
			out = out.Append(s)
		}
		at = last.Next
	}
	SitePage{Revision: last.Revision, Complete: last.Complete, Sites: out, Total: last.Total, Next: -1}
}

// picked is the declaration of the reader that pick picks, if it has any.
func picked(pick int) option.Option[Decl] needs Reader {
	let all = Every()
	if all.Len() == 0 {
		return option.None
	}
	option.Some[Decl]{Value: all[slot(pick, all.Len())]}
}

func handleRoundTrips(pick int) bool needs Reader {
	match picked(pick) {
	case option.None:
		true
	case option.Some[Decl] as d:
		let back = Reader.Symbol(d.Value.Handle) catch {
		case NoSymbol:
			return false
		case Ambiguous:
			return false
		}
		back == d.Value
	}
}

func referencesAreSound(pick int, kinds []string) bool needs Reader {
	match picked(pick) {
	case option.None:
		true
	case option.Some[Decl] as d:
		let page = All(d.Value.Handle, kinds, MaxLimit) catch {
		case NoSymbol:
			return false
		case Ambiguous:
			return false
		}
		let mut ok = true
		for s in page.Sites {
			ok = ok && s.Symbol == d.Value.Handle && (kinds.Len() == 0 || has(kinds, s.Kind))
		}
		ok
	}
}

func referencesAreComplete() bool needs Reader {
	let mut n = 0
	for d in Every() {
		let page = All(d.Handle, []string{}, MaxLimit) catch {
		case NoSymbol:
			return false
		case Ambiguous:
			return false
		}
		n = n + page.Sites.Len()
	}
	n == Reader.Describe().Sites
}

func pagesPartition(pick int, size int) bool needs Reader {
	match picked(pick) {
	case option.None:
		true
	case option.Some[Decl] as d:
		let whole = Reader.References(RefQuery{Of: d.Value.Handle, Kinds: []string{}, Offset: option.None, Limit: option.Some[int]{Value: MaxLimit}}) catch {
		case NoSymbol:
			return false
		case Ambiguous:
			return false
		}
		let paged = All(d.Value.Handle, []string{}, 1+slot(size, 7)) catch {
		case NoSymbol:
			return false
		case Ambiguous:
			return false
		}
		paged.Sites == whole.Sites && whole.Total == whole.Sites.Len()
	}
}

// slot is a place in 0..n-1 that any int picks.
func slot(pick int, n int) int { ((pick % n) + n) % n }

// has is whether xs holds x.
func has(xs []string, x string) bool {
	for y in xs {
		if y == x {
			return true
		}
	}
	false
}

// or is the value of o, or d when it has none.
func or(o option.Option[int], d int) int {
	match o {
	case option.Some[int] as v:
		v.Value
	case option.None:
		d
	}
}

// text is the value of o, or "" when it has none.
func text(o option.Option[string]) string {
	match o {
	case option.Some[string] as v:
		v.Value
	case option.None:
		""
	}
}

// window is the window of n rows that offset and limit ask for: its start,
// its end and the next page's offset (-1 after the last). No limit, or one
// of 0 or less, is DefaultLimit, and none is more than MaxLimit.
func window(n int, offset option.Option[int], limit option.Option[int]) (int, int, int) {
	let l = or(limit, DefaultLimit)
	let o = or(offset, 0)
	let size = if l <= 0 { DefaultLimit } else if l > MaxLimit { MaxLimit } else { l }
	let start = if o < 0 { 0 } else if o > n { n } else { o }
	let end = if start+size > n { n } else { start + size }
	(start, end, if end < n { end } else { -1 })
}

// fits is whether the declaration d fits the query q.
func fits(q SymbolQuery, d Decl) bool {
	let kind = text(q.Kind)
	if kind != "" && d.Kind != kind {
		return false
	}
	let pkg = text(q.Package)
	if pkg != "" && d.Package != pkg {
		return false
	}
	let name = text(q.Name)
	if name == "" {
		return true
	}
	match text(q.Match) {
	case "prefix":
		strings.HasPrefix(d.Name, name)
	case "part":
		strings.Contains(d.Name, name)
	case _:
		d.Name == name
	}
}

// isPosition is whether the address a is a position, file:line:column.
func isPosition(a string) bool {
	let parts = strings.Split(a, ":")
	if parts.Len() < 3 {
		return false
	}
	isNumber(parts[parts.Len()-1]) && isNumber(parts[parts.Len()-2])
}

// isNumber is whether s is a decimal number.
func isNumber(s string) bool {
	let _ = strconv.Atoi(s) catch {
	case strconv.Malformed:
		return false
	case strconv.OutOfRange:
		return false
	}
	true
}

// positionOf is the position text of a file, a line and a column.
func positionOf(file string, line int, column int) string { "\(file):\(line):\(column)" }

// shortFits is whether the short name a names the declaration d: d's
// handle is its package's path, a dot and a.
func shortFits(a string, d Decl) bool { d.Handle == d.Package+"."+a }
