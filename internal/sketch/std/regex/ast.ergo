import content

let kindEmpty = 0
let kindBytes = 1
let kindConcat = 2
let kindAlt = 3
let kindRepeat = 4
let kindCapture = 5

let maxPatternNodes = 4096

type byteSet {
	w0 uint64,
	w1 uint64,
	w2 uint64,
	w3 uint64,
}

type astNode {
	kind  int,
	set   byteSet,
	kids  []int,
	min   int,
	max   int,
	name  string,
	tag   int,
	start uint32,
	end   uint32,
}

type regexAST {
	nodes []astNode,
	root  int,
	diags []content.MapperDiag,
}

func emptySet() byteSet {
	byteSet{w0: uint64(0), w1: uint64(0), w2: uint64(0), w3: uint64(0)}
}

func fullSet() byteSet {
	let all = ^uint64(0)
	byteSet{w0: all, w1: all, w2: all, w3: all}
}

func setBit(s byteSet, b byte) byteSet {
	let idx = int(b) / 64
	let bit = uint64(1) << uint64(int(b)&63)
	if idx == 0 {
		return byteSet{w0: s.w0 | bit, w1: s.w1, w2: s.w2, w3: s.w3}
	}
	if idx == 1 {
		return byteSet{w0: s.w0, w1: s.w1 | bit, w2: s.w2, w3: s.w3}
	}
	if idx == 2 {
		return byteSet{w0: s.w0, w1: s.w1, w2: s.w2 | bit, w3: s.w3}
	}
	byteSet{w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3 | bit}
}

func singleByteSet(b byte) byteSet {
	setBit(emptySet(), b)
}

func setRange(s byteSet, lo byte, hi byte) byteSet {
	let mut out = s
	let mut v = int(lo)
	let end = int(hi)
	for v <= end {
		out = setBit(out, byte(v))
		v = v + 1
	}
	out
}

func unionSet(a byteSet, b byteSet) byteSet {
	byteSet{w0: a.w0 | b.w0, w1: a.w1 | b.w1, w2: a.w2 | b.w2, w3: a.w3 | b.w3}
}

func complementSet(s byteSet) byteSet {
	byteSet{w0: ^s.w0, w1: ^s.w1, w2: ^s.w2, w3: ^s.w3}
}

func digitSet() byteSet {
	setRange(emptySet(), byte('0'), byte('9'))
}

func wordSet() byteSet {
	let mut s = setRange(emptySet(), byte('0'), byte('9'))
	s = setRange(s, byte('A'), byte('Z'))
	s = setBit(s, byte('_'))
	setRange(s, byte('a'), byte('z'))
}

func spaceSet() byteSet {
	let mut s = setBit(emptySet(), byte('\t'))
	s = setBit(s, byte('\n'))
	s = setBit(s, byte('\f'))
	s = setBit(s, byte('\r'))
	setBit(s, byte(' '))
}

func dotSet() byteSet {
	complementSet(singleByteSet(byte('\n')))
}

func isASCIIDigit(b byte) bool {
	b >= byte('0') && b <= byte('9')
}

func isASCIIIdentStart(b byte) bool {
	(b >= byte('A') && b <= byte('Z')) || (b >= byte('a') && b <= byte('z')) || b == byte('_')
}

func isASCIIIdentCont(b byte) bool {
	isASCIIIdentStart(b) || isASCIIDigit(b)
}

func isValidIdent(s string) bool {
	let bs = s.Bytes()
	if bs.Len() == 0 || !isASCIIIdentStart(bs[0]) {
		return false
	}
	for i in 1..bs.Len() {
		if !isASCIIIdentCont(bs[i]) {
			return false
		}
	}
	!isErgoKeyword(s)
}

func isErgoKeyword(s string) bool {
	s == "break" || s == "case" || s == "catch" || s == "continue" || s == "default" ||
		s == "else" || s == "fails" || s == "false" || s == "for" || s == "func" ||
		s == "go" || s == "if" || s == "import" || s == "in" || s == "interface" ||
		s == "law" || s == "let" || s == "machine" || s == "match" || s == "mut" ||
		s == "needs" || s == "null" || s == "own" || s == "return" || s == "test" ||
		s == "true" || s == "try" || s == "type" || s == "where" || s == "with"
}

func hexVal(b byte) int {
	if b >= byte('0') && b <= byte('9') {
		return int(b - byte('0'))
	}
	if b >= byte('a') && b <= byte('f') {
		return int(b-byte('a')) + 10
	}
	if b >= byte('A') && b <= byte('F') {
		return int(b-byte('A')) + 10
	}
	-1
}

func utf8SeqLen(first byte) int {
	if first < byte(0x80) {
		return 1
	}
	if first >= byte(0xC2) && first <= byte(0xDF) {
		return 2
	}
	if first >= byte(0xE0) && first <= byte(0xEF) {
		return 3
	}
	if first >= byte(0xF0) && first <= byte(0xF4) {
		return 4
	}
	-1
}

func validUTF8(src []byte) (int, bool) {
	let n = src.Len()
	let mut i = 0
	for i < n {
		let b0 = src[i]
		if b0 < byte(0x80) {
			i = i + 1
			continue
		}
		let l = utf8SeqLen(b0)
		if l < 2 || i+l > n {
			return (i, false)
		}
		let b1 = src[i+1]
		if (b1 & byte(0xC0)) != byte(0x80) {
			return (i, false)
		}
		if b0 == byte(0xE0) && b1 < byte(0xA0) {
			return (i, false)
		}
		if b0 == byte(0xED) && b1 > byte(0x9F) {
			return (i, false)
		}
		if b0 == byte(0xF0) && b1 < byte(0x90) {
			return (i, false)
		}
		if b0 == byte(0xF4) && b1 > byte(0x8F) {
			return (i, false)
		}
		if l >= 3 && (src[i+2]&byte(0xC0)) != byte(0x80) {
			return (i, false)
		}
		if l == 4 && (src[i+3]&byte(0xC0)) != byte(0x80) {
			return (i, false)
		}
		i = i + l
	}
	(n, true)
}

type parserState {
	src   []byte,
	pos   int,
	nodes []astNode,
	diags []content.MapperDiag,
}

func makeNode(kind int, set byteSet, kids []int, min int, max int, name string, start uint32, end uint32) astNode {
	astNode{kind: kind, set: set, kids: kids, min: min, max: max, name: name, tag: 0, start: start, end: end}
}

func addNode(p parserState, n astNode) (parserState, int) {
	if p.nodes.Len() >= maxPatternNodes {
		let d = content.ErrorDiag(n.start, n.end, "R005", "pattern exceeds node limit", "simplify the pattern")
		return (parserState{src: p.src, pos: p.pos, nodes: p.nodes, diags: p.diags.Append(d)}, -1)
	}
	let id = p.nodes.Len()
	(parserState{src: p.src, pos: p.pos, nodes: p.nodes.Append(n), diags: p.diags}, id)
}

func failAt(p parserState, start int, end int, code string, msg string, hint string) parserState {
	let mut s = start
	let mut e = end
	let lim = p.src.Len()
	if s < 0 {
		s = 0
	}
	if s > lim {
		s = lim
	}
	if e < s {
		e = s
	}
	if e > lim {
		e = lim
	}
	let d = content.ErrorDiag(uint32(s), uint32(e), code, msg, hint)
	parserState{src: p.src, pos: p.pos, nodes: p.nodes, diags: p.diags.Append(d)}
}

func parseRegexAST(src []byte) regexAST {
	let (badOff, okUTF8) = validUTF8(src)
	if !okUTF8 {
		let mut end = badOff + 1
		if end > src.Len() {
			end = src.Len()
		}
		return regexAST{
			nodes: []astNode{},
			root:  -1,
			diags: []content.MapperDiag{content.ErrorDiag(uint32(badOff), uint32(end), "R001", "pattern contains invalid UTF-8 bytes", "use \\xHH byte escapes in the pattern")},
		}
	}
	let mut p = parserState{src: src, pos: 0, nodes: []astNode{}, diags: []content.MapperDiag{}}
	let (p1, root) = parseAlt(p)
	p = p1
	if p.diags.Len() == 0 && p.pos < p.src.Len() {
		if p.src[p.pos] == byte(')') {
			p = failAt(p, p.pos, p.pos+1, "R001", "unmatched ')' in pattern", "remove the extra ')' or escape it as \\)")
		} else {
			p = failAt(p, p.pos, p.pos+1, "R001", "unexpected trailing syntax in pattern", "")
		}
	}
	regexAST{nodes: p.nodes, root: root, diags: p.diags}
}

func parseAlt(p parserState) (parserState, int) {
	let startPos = p.pos
	let mut cur = p
	let mut branches = []int{}
	let (p1, first) = parseConcat(cur)
	cur = p1
	if cur.diags.Len() > 0 {
		return (cur, -1)
	}
	branches = branches.Append(first)
	for cur.pos < cur.src.Len() && cur.src[cur.pos] == byte('|') {
		cur = parserState{src: cur.src, pos: cur.pos + 1, nodes: cur.nodes, diags: cur.diags}
		let (pNext, branch) = parseConcat(cur)
		cur = pNext
		if cur.diags.Len() > 0 {
			return (cur, -1)
		}
		branches = branches.Append(branch)
	}
	if branches.Len() == 1 {
		return (cur, branches[0])
	}
	addNode(cur, makeNode(kindAlt, emptySet(), branches, 0, 0, "", uint32(startPos), uint32(cur.pos)))
}

func parseConcat(p parserState) (parserState, int) {
	let startPos = p.pos
	let mut cur = p
	let mut items = []int{}
	for cur.pos < cur.src.Len() {
		let c = cur.src[cur.pos]
		if c == byte('|') || c == byte(')') {
			break
		}
		let (p1, item) = parseRepeat(cur)
		cur = p1
		if cur.diags.Len() > 0 {
			return (cur, -1)
		}
		items = items.Append(item)
	}
	if items.Len() == 0 {
		return addNode(cur, makeNode(kindEmpty, emptySet(), []int{}, 0, 0, "", uint32(startPos), uint32(cur.pos)))
	}
	if items.Len() == 1 {
		return (cur, items[0])
	}
	addNode(cur, makeNode(kindConcat, emptySet(), items, 0, 0, "", uint32(startPos), uint32(cur.pos)))
}

func parseRepeat(p parserState) (parserState, int) {
	let startPos = p.pos
	let (p1, firstAtom) = parseAtom(p)
	let mut cur = p1
	let mut atom = firstAtom
	if cur.diags.Len() > 0 {
		return (cur, -1)
	}
	for cur.pos < cur.src.Len() {
		let c = cur.src[cur.pos]
		if c == byte('*') {
			let repStart = cur.pos
			cur = parserState{src: cur.src, pos: cur.pos + 1, nodes: cur.nodes, diags: cur.diags}
			if cur.pos < cur.src.Len() && (cur.src[cur.pos] == byte('?') || cur.src[cur.pos] == byte('+')) {
				return (failAt(cur, repStart, cur.pos+1, "R001", "lazy and possessive quantifiers are outside the pattern subset", "use greedy *"), -1)
			}
			let (p2, id) = addNode(cur, makeNode(kindRepeat, emptySet(), []int{atom}, 0, -1, "", uint32(startPos), uint32(cur.pos)))
			cur = p2
			if cur.diags.Len() > 0 {
				return (cur, -1)
			}
			atom = id
			continue
		}
		if c == byte('+') {
			let repStart = cur.pos
			cur = parserState{src: cur.src, pos: cur.pos + 1, nodes: cur.nodes, diags: cur.diags}
			if cur.pos < cur.src.Len() && (cur.src[cur.pos] == byte('?') || cur.src[cur.pos] == byte('+')) {
				return (failAt(cur, repStart, cur.pos+1, "R001", "lazy and possessive quantifiers are outside the pattern subset", "use greedy +"), -1)
			}
			let (p2, id) = addNode(cur, makeNode(kindRepeat, emptySet(), []int{atom}, 1, -1, "", uint32(startPos), uint32(cur.pos)))
			cur = p2
			if cur.diags.Len() > 0 {
				return (cur, -1)
			}
			atom = id
			continue
		}
		if c == byte('?') {
			let repStart = cur.pos
			cur = parserState{src: cur.src, pos: cur.pos + 1, nodes: cur.nodes, diags: cur.diags}
			if cur.pos < cur.src.Len() && (cur.src[cur.pos] == byte('?') || cur.src[cur.pos] == byte('+')) {
				return (failAt(cur, repStart, cur.pos+1, "R001", "lazy and possessive quantifiers are outside the pattern subset", "use greedy ?"), -1)
			}
			let (p2, id) = addNode(cur, makeNode(kindRepeat, emptySet(), []int{atom}, 0, 1, "", uint32(startPos), uint32(cur.pos)))
			cur = p2
			if cur.diags.Len() > 0 {
				return (cur, -1)
			}
			atom = id
			continue
		}
		if c == byte('{') {
			let repStart = cur.pos
			let (p2, minVal, maxVal) = parseBracedQuantifier(cur)
			cur = p2
			if cur.diags.Len() > 0 {
				return (cur, -1)
			}
			if cur.pos < cur.src.Len() && (cur.src[cur.pos] == byte('?') || cur.src[cur.pos] == byte('+')) {
				return (failAt(cur, repStart, cur.pos+1, "R001", "lazy and possessive quantifiers are outside the pattern subset", "drop the trailing qualifier"), -1)
			}
			let (p3, id) = addNode(cur, makeNode(kindRepeat, emptySet(), []int{atom}, minVal, maxVal, "", uint32(startPos), uint32(cur.pos)))
			cur = p3
			if cur.diags.Len() > 0 {
				return (cur, -1)
			}
			atom = id
			continue
		}
		break
	}
	(cur, atom)
}

func parseCount(src []byte, pos int) (int, int, bool) {
	let n = src.Len()
	let mut i = pos
	let mut val = 0
	let mut anyDigit = false
	for i < n && isASCIIDigit(src[i]) {
		anyDigit = true
		val = val*10 + int(src[i]-byte('0'))
		if val > 1000 {
			return (i, val, false)
		}
		i = i + 1
	}
	(i, val, anyDigit)
}

func parseBracedQuantifier(p parserState) (parserState, int, int) {
	let start = p.pos
	let n = p.src.Len()
	let mut i = start + 1
	let (i1, lo, hasLo) = parseCount(p.src, i)
	if !hasLo {
		let mut end = i1 + 1
		if end > n {
			end = n
		}
		return (failAt(p, start, end, "R001", "invalid repetition count", "use {n}, {m,}, or {m,n} with count <= 1000, or escape \\{"), 0, 0)
	}
	i = i1
	if i >= n {
		return (failAt(p, start, n, "R001", "unclosed repetition quantifier", "add closing '}' or escape \\{"), 0, 0)
	}
	if p.src[i] == byte('}') {
		return (parserState{src: p.src, pos: i + 1, nodes: p.nodes, diags: p.diags}, lo, lo)
	}
	if p.src[i] != byte(',') {
		return (failAt(p, start, i+1, "R001", "malformed repetition quantifier", "use {n}, {m,}, or {m,n}"), 0, 0)
	}
	i = i + 1
	if i >= n {
		return (failAt(p, start, n, "R001", "unclosed repetition quantifier", "add closing '}'"), 0, 0)
	}
	if p.src[i] == byte('}') {
		return (parserState{src: p.src, pos: i + 1, nodes: p.nodes, diags: p.diags}, lo, -1)
	}
	let (i2, hi, hasHi) = parseCount(p.src, i)
	if !hasHi || i2 >= n || p.src[i2] != byte('}') {
		let mut end = i2 + 1
		if end > n {
			end = n
		}
		return (failAt(p, start, end, "R001", "invalid repetition upper bound", "use {m,n} with count <= 1000"), 0, 0)
	}
	if hi < lo {
		return (failAt(p, start, i2+1, "R001", "invalid repetition range where max < min", "ensure the upper bound is at least the lower bound"), 0, 0)
	}
	(parserState{src: p.src, pos: i2 + 1, nodes: p.nodes, diags: p.diags}, lo, hi)
}

func parseAtom(p parserState) (parserState, int) {
	if p.pos >= p.src.Len() {
		return (failAt(p, p.pos, p.pos, "R001", "unexpected end of pattern", ""), -1)
	}
	let c = p.src[p.pos]
	if c == byte('^') {
		return (failAt(p, p.pos, p.pos+1, "R001", "drop ^: patterns already match the whole string", "remove '^' or escape \\^ for a literal byte"), -1)
	}
	if c == byte('$') {
		return (failAt(p, p.pos, p.pos+1, "R001", "drop $: patterns already match the whole string", "remove '$' or escape \\$ for a literal byte"), -1)
	}
	if c == byte('*') || c == byte('+') || c == byte('?') || c == byte('{') {
		return (failAt(p, p.pos, p.pos+1, "R001", "nothing to repeat before quantifier", "escape the character or place an atom before it"), -1)
	}
	if c == byte('.') {
		let cur = parserState{src: p.src, pos: p.pos + 1, nodes: p.nodes, diags: p.diags}
		return addNode(cur, makeNode(kindBytes, dotSet(), []int{}, 0, 0, "", uint32(p.pos), uint32(p.pos+1)))
	}
	if c == byte('(') {
		return parseGroup(p)
	}
	if c == byte('[') {
		return parseCharClass(p)
	}
	if c == byte('\\') {
		return parseEscapeNode(p)
	}
	let l = utf8SeqLen(c)
	let start = p.pos
	let end = start + l
	let mut cur = parserState{src: p.src, pos: end, nodes: p.nodes, diags: p.diags}
	if l == 1 {
		return addNode(cur, makeNode(kindBytes, singleByteSet(c), []int{}, 0, 0, "", uint32(start), uint32(end)))
	}
	let mut kids = []int{}
	for k in start..end {
		let (pNext, bid) = addNode(cur, makeNode(kindBytes, singleByteSet(p.src[k]), []int{}, 0, 0, "", uint32(k), uint32(k+1)))
		cur = pNext
		if cur.diags.Len() > 0 {
			return (cur, -1)
		}
		kids = kids.Append(bid)
	}
	addNode(cur, makeNode(kindConcat, emptySet(), kids, 0, 0, "", uint32(start), uint32(end)))
}

func parseGroup(p parserState) (parserState, int) {
	let start = p.pos
	let n = p.src.Len()
	if start+1 < n && p.src[start+1] == byte('?') {
		if start+2 >= n {
			return (failAt(p, start, n, "R001", "incomplete group opener '(?'", "use (?<Name>...) for named capture or (...) for grouping"), -1)
		}
		let kind = p.src[start+2]
		if kind == byte('P') && start+3 < n && p.src[start+3] == byte('<') {
			return (failAt(p, start, start+4, "R001", "use (?<Name>...) instead of Python-style (?P<Name>...)", "replace '(?P<' with '(?<'"), -1)
		}
		if kind == byte(':') {
			return (failAt(p, start, start+3, "R001", "use ( ... ) instead of (?: ... ) for plain grouping", "remove '?:'"), -1)
		}
		if kind == byte('=') || kind == byte('!') {
			return (failAt(p, start, start+3, "R001", "lookahead assertions are outside the pattern subset", ""), -1)
		}
		if kind == byte('<') && start+3 < n && (p.src[start+3] == byte('=') || p.src[start+3] == byte('!')) {
			return (failAt(p, start, start+4, "R001", "lookbehind assertions are outside the pattern subset", ""), -1)
		}
		if kind != byte('<') {
			return (failAt(p, start, start+3, "R001", "unsupported group flag syntax '(?'", "use (?<Name>...) for named capture or (...) for grouping"), -1)
		}
		let nameStart = start + 3
		let mut i = nameStart
		for i < n && p.src[i] != byte('>') {
			i = i + 1
		}
		if i >= n {
			return (failAt(p, start, n, "R001", "unclosed capture group name", "close the capture name with '>'"), -1)
		}
		let capName = p.src[nameStart:i].Text()
		if !isValidIdent(capName) {
			return (failAt(p, nameStart, i, "R001", "invalid capture group name '"+capName+"'", "capture names must be non-empty Ergo identifiers"), -1)
		}
		let mut cur = parserState{src: p.src, pos: i + 1, nodes: p.nodes, diags: p.diags}
		let (pBody, body) = parseAlt(cur)
		cur = pBody
		if cur.diags.Len() > 0 {
			return (cur, -1)
		}
		if cur.pos >= cur.src.Len() || cur.src[cur.pos] != byte(')') {
			return (failAt(cur, start, cur.pos, "R001", "unclosed capture group '(?<"+capName+">...'", "add closing ')'"), -1)
		}
		let endPos = cur.pos + 1
		cur = parserState{src: cur.src, pos: endPos, nodes: cur.nodes, diags: cur.diags}
		return addNode(cur, makeNode(kindCapture, emptySet(), []int{body}, 0, 0, capName, uint32(start), uint32(endPos)))
	}
	let mut cur = parserState{src: p.src, pos: start + 1, nodes: p.nodes, diags: p.diags}
	let (pBody, body) = parseAlt(cur)
	cur = pBody
	if cur.diags.Len() > 0 {
		return (cur, -1)
	}
	if cur.pos >= cur.src.Len() || cur.src[cur.pos] != byte(')') {
		return (failAt(cur, start, cur.pos, "R001", "unclosed '(' group", "add closing ')'"), -1)
	}
	(parserState{src: cur.src, pos: cur.pos + 1, nodes: cur.nodes, diags: cur.diags}, body)
}

func parseEscapeItem(p parserState, inClass bool) (parserState, bool, byte, byteSet) {
	let start = p.pos
	let n = p.src.Len()
	if start+1 >= n {
		return (failAt(p, start, n, "R001", "trailing backslash in pattern", "remove the trailing '\\' or escape it as \\\\"), false, byte(0), emptySet())
	}
	let esc = p.src[start+1]
	if esc == byte('d') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, false, byte(0), digitSet())
	}
	if esc == byte('D') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, false, byte(0), complementSet(digitSet()))
	}
	if esc == byte('w') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, false, byte(0), wordSet())
	}
	if esc == byte('W') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, false, byte(0), complementSet(wordSet()))
	}
	if esc == byte('s') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, false, byte(0), spaceSet())
	}
	if esc == byte('S') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, false, byte(0), complementSet(spaceSet()))
	}
	if esc == byte('n') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, true, byte('\n'), singleByteSet(byte('\n')))
	}
	if esc == byte('r') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, true, byte('\r'), singleByteSet(byte('\r')))
	}
	if esc == byte('t') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, true, byte('\t'), singleByteSet(byte('\t')))
	}
	if esc == byte('f') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, true, byte('\f'), singleByteSet(byte('\f')))
	}
	if esc == byte('v') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, true, byte(11), singleByteSet(byte(11)))
	}
	if esc == byte('a') {
		return (parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, true, byte(7), singleByteSet(byte(7)))
	}
	if esc == byte('x') {
		if start+3 >= n {
			return (failAt(p, start, n, "R001", "incomplete \\xHH hex byte escape", "provide two hex digits after \\x"), false, byte(0), emptySet())
		}
		let hi = hexVal(p.src[start+2])
		let lo = hexVal(p.src[start+3])
		if hi < 0 || lo < 0 {
			return (failAt(p, start, start+4, "R001", "invalid \\xHH hex byte escape", "use two hexadecimal digits 0-9 or a-f"), false, byte(0), emptySet())
		}
		let b = byte(hi*16 + lo)
		return (parserState{src: p.src, pos: start + 4, nodes: p.nodes, diags: p.diags}, true, b, singleByteSet(b))
	}
	if !inClass && (esc == byte('b') || esc == byte('B')) {
		return (failAt(p, start, start+2, "R001", "word boundaries \\b and \\B are outside the pattern subset", ""), false, byte(0), emptySet())
	}
	if esc == byte('p') || esc == byte('P') {
		return (failAt(p, start, start+2, "R001", "Unicode character properties \\p and \\P are outside the pattern subset", ""), false, byte(0), emptySet())
	}
	if esc >= byte('0') && esc <= byte('9') {
		return (failAt(p, start, start+2, "R001", "backreferences and octal escapes are outside the pattern subset", "use \\xHH for literal byte values"), false, byte(0), emptySet())
	}
	if isASCIIIdentStart(esc) {
		return (failAt(p, start, start+2, "R001", "unsupported escape \\"+[]byte{esc}.Text(), ""), false, byte(0), emptySet())
	}
	(parserState{src: p.src, pos: start + 2, nodes: p.nodes, diags: p.diags}, true, esc, singleByteSet(esc))
}

func parseEscapeNode(p parserState) (parserState, int) {
	let start = p.pos
	let (p1, _, _, s) = parseEscapeItem(p, false)
	if p1.diags.Len() > 0 {
		return (p1, -1)
	}
	addNode(p1, makeNode(kindBytes, s, []int{}, 0, 0, "", uint32(start), uint32(p1.pos)))
}

func parseCharClass(p parserState) (parserState, int) {
	let start = p.pos
	let n = p.src.Len()
	let mut i = start + 1
	let mut neg = false
	if i < n && p.src[i] == byte('^') {
		neg = true
		i = i + 1
	}
	let mut cur = parserState{src: p.src, pos: i, nodes: p.nodes, diags: p.diags}
	let mut set = emptySet()
	let mut first = true
	for cur.pos < n {
		let c = cur.src[cur.pos]
		if c == byte(']') && !first {
			let endPos = cur.pos + 1
			if neg {
				set = complementSet(set)
			}
			let out = parserState{src: cur.src, pos: endPos, nodes: cur.nodes, diags: cur.diags}
			return addNode(out, makeNode(kindBytes, set, []int{}, 0, 0, "", uint32(start), uint32(endPos)))
		}
		first = false
		let itemStart = cur.pos
		let mut single = false
		let mut ch = byte(0)
		let mut itemSet = emptySet()
		if c == byte('\\') {
			let (pNext, okSingle, bVal, sVal) = parseEscapeItem(cur, true)
			cur = pNext
			if cur.diags.Len() > 0 {
				return (cur, -1)
			}
			single = okSingle
			ch = bVal
			itemSet = sVal
		} else {
			if c >= byte(0x80) {
				let l = utf8SeqLen(c)
				return (failAt(cur, cur.pos, cur.pos+l, "R001", "character classes [...] operate on single ASCII bytes", "move multi-byte UTF-8 alternatives outside [...] as (a|b)"), -1)
			}
			single = true
			ch = c
			itemSet = singleByteSet(c)
			cur = parserState{src: cur.src, pos: cur.pos + 1, nodes: cur.nodes, diags: cur.diags}
		}
		if cur.pos+1 < n && cur.src[cur.pos] == byte('-') && cur.src[cur.pos+1] != byte(']') {
			if !single {
				return (failAt(cur, itemStart, cur.pos+1, "R001", "character class escape cannot start a range", ""), -1)
			}
			let dashCur = parserState{src: cur.src, pos: cur.pos + 1, nodes: cur.nodes, diags: cur.diags}
			let mut hiSingle = false
			let mut hiByte = byte(0)
			if dashCur.src[dashCur.pos] == byte('\\') {
				let (pNext, okSingle, bVal, _) = parseEscapeItem(dashCur, true)
				cur = pNext
				if cur.diags.Len() > 0 {
					return (cur, -1)
				}
				hiSingle = okSingle
				hiByte = bVal
			} else {
				let hc = dashCur.src[dashCur.pos]
				if hc >= byte(0x80) {
					let l = utf8SeqLen(hc)
					return (failAt(dashCur, dashCur.pos, dashCur.pos+l, "R001", "character class ranges require ASCII bytes", ""), -1)
				}
				hiSingle = true
				hiByte = hc
				cur = parserState{src: dashCur.src, pos: dashCur.pos + 1, nodes: dashCur.nodes, diags: dashCur.diags}
			}
			if !hiSingle {
				return (failAt(cur, itemStart, cur.pos, "R001", "character class escape cannot end a range", ""), -1)
			}
			if hiByte < ch {
				return (failAt(cur, itemStart, cur.pos, "R001", "invalid byte range in character class where end < start", "swap the range endpoints"), -1)
			}
			set = setRange(set, ch, hiByte)
		} else {
			set = unionSet(set, itemSet)
		}
	}
	(failAt(cur, start, n, "R001", "unclosed character class '['", "add closing ']'"), -1)
}
