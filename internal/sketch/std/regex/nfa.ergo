import content

let opAccept = 0
let opByte = 1
let opSplit = 2
let opTag = 3
let opStart = 4
let opEnd = 5

let maxNFAInsts = 65536

type compiledNFA {
	code  []int,
	sets  []uint64,
	start int,
	diags []content.MapperDiag,
}

type nfaBuilder {
	code     []int,
	sets     []uint64,
	overflow bool,
}

func emitInst(b nfaBuilder, op int, x int, y int) (nfaBuilder, int) {
	let count = b.code.Len() / 3
	if count >= maxNFAInsts {
		return (nfaBuilder{code: b.code, sets: b.sets, overflow: true}, 0)
	}
	let mut c = b.code.Append(op)
	c = c.Append(x)
	c = c.Append(y)
	(nfaBuilder{code: c, sets: b.sets, overflow: b.overflow}, count)
}

func addByteSet(b nfaBuilder, s byteSet) (nfaBuilder, int) {
	let n = b.sets.Len() / 4
	for i in 0..n {
		let base = i * 4
		if b.sets[base] == s.w0 && b.sets[base+1] == s.w1 && b.sets[base+2] == s.w2 && b.sets[base+3] == s.w3 {
			return (b, i)
		}
	}
	let mut words = b.sets.Append(s.w0)
	words = words.Append(s.w1)
	words = words.Append(s.w2)
	words = words.Append(s.w3)
	(nfaBuilder{code: b.code, sets: words, overflow: b.overflow}, n)
}

func capCost(a int, b int) int {
	let sum = a + b
	if sum > maxNFAInsts {
		return maxNFAInsts + 1
	}
	sum
}

func estimateNodeInsts(ast regexAST, tags []int, id int) int {
	if id < 0 || id >= ast.nodes.Len() {
		return 0
	}
	let n = ast.nodes[id]
	if n.kind == kindEmpty {
		return 0
	}
	if n.kind == kindBytes || n.kind == kindStart || n.kind == kindEnd {
		return 1
	}
	if n.kind == kindConcat {
		let mut tot = 0
		for kid in n.kids {
			tot = capCost(tot, estimateNodeInsts(ast, tags, kid))
			if tot > maxNFAInsts {
				return tot
			}
		}
		return tot
	}
	if n.kind == kindAlt {
		let mut tot = if n.kids.Len() > 1 { n.kids.Len() - 1 } else { 0 }
		for kid in n.kids {
			tot = capCost(tot, estimateNodeInsts(ast, tags, kid))
			if tot > maxNFAInsts {
				return tot
			}
		}
		return tot
	}
	if n.kind == kindCapture {
		let c = estimateNodeInsts(ast, tags, n.kids[0])
		if tags[id] != 0 {
			return capCost(c, 2)
		}
		return c
	}
	if n.kind == kindRepeat {
		let c = estimateNodeInsts(ast, tags, n.kids[0])
		let mut copies = n.min
		let mut splits = 0
		if n.max == -1 {
			copies = copies + 1
			splits = 1
		} else {
			copies = n.max
			splits = n.max - n.min
		}
		let mut tot = splits
		for _ in 0..copies {
			tot = capCost(tot, c)
			if tot > maxNFAInsts {
				return tot
			}
		}
		return tot
	}
	1
}

func compileASTToNFA(ast regexAST, tags []int) compiledNFA {
	let est = estimateNodeInsts(ast, tags, ast.root) + 1
	if est > maxNFAInsts {
		let rn = ast.nodes[ast.root]
		return compiledNFA{
			code:  []int{},
			sets:  []uint64{},
			start: 0,
			diags: []content.MapperDiag{content.ErrorDiag(rn.start, rn.end, "R005", "compiled NFA exceeds instruction limit", "simplify repeated quantifiers or pattern size")},
		}
	}
	let mut b = nfaBuilder{code: []int{}, sets: []uint64{}, overflow: false}
	let (b1, acceptPC) = emitInst(b, opAccept, 0, 0)
	b = b1
	let (b2, startPC) = compileNode(ast, tags, b, ast.root, acceptPC)
	b = b2
	if b.overflow {
		let rn = ast.nodes[ast.root]
		return compiledNFA{
			code:  []int{},
			sets:  []uint64{},
			start: 0,
			diags: []content.MapperDiag{content.ErrorDiag(rn.start, rn.end, "R005", "compiled NFA exceeds instruction limit", "simplify repeated quantifiers or pattern size")},
		}
	}
	compiledNFA{code: b.code, sets: b.sets, start: startPC, diags: []content.MapperDiag{}}
}

func compileNode(ast regexAST, tags []int, b nfaBuilder, id int, next int) (nfaBuilder, int) {
	if b.overflow {
		return (b, 0)
	}
	let n = ast.nodes[id]
	if n.kind == kindEmpty {
		return (b, next)
	}
	if n.kind == kindStart {
		return emitInst(b, opStart, next, 0)
	}
	if n.kind == kindEnd {
		return emitInst(b, opEnd, next, 0)
	}
	if n.kind == kindBytes {
		let (b1, si) = addByteSet(b, n.set)
		return emitInst(b1, opByte, next, si)
	}
	if n.kind == kindConcat {
		let mut cur = next
		let mut mutB = b
		let mut idx = n.kids.Len() - 1
		for idx >= 0 {
			let (b1, pc) = compileNode(ast, tags, mutB, n.kids[idx], cur)
			mutB = b1
			cur = pc
			if mutB.overflow {
				return (mutB, 0)
			}
			idx = idx - 1
		}
		return (mutB, cur)
	}
	if n.kind == kindAlt {
		let mut idx = n.kids.Len() - 1
		let (b0, lastPC) = compileNode(ast, tags, b, n.kids[idx], next)
		let mut mutB = b0
		let mut cur = lastPC
		idx = idx - 1
		for idx >= 0 {
			let (b1, leftPC) = compileNode(ast, tags, mutB, n.kids[idx], next)
			let (b2, splitPC) = emitInst(b1, opSplit, leftPC, cur)
			mutB = b2
			cur = splitPC
			if mutB.overflow {
				return (mutB, 0)
			}
			idx = idx - 1
		}
		return (mutB, cur)
	}
	if n.kind == kindCapture {
		let tag = tags[id]
		if tag == 0 {
			return compileNode(ast, tags, b, n.kids[0], next)
		}
		let (b1, closePC) = emitInst(b, opTag, next, -tag)
		let (b2, innerPC) = compileNode(ast, tags, b1, n.kids[0], closePC)
		return emitInst(b2, opTag, innerPC, tag)
	}
	if n.kind == kindRepeat {
		let mut cur = next
		let mut mutB = b
		if n.max == -1 {
			let (b1, splitPC) = emitInst(mutB, opSplit, 0, 0)
			let (b2, bodyPC) = compileNode(ast, tags, b1, n.kids[0], splitPC)
			if b2.overflow {
				return (b2, 0)
			}
			let mut patched = b2.code
			if n.lazy {
				patched[splitPC*3+1] = next
				patched[splitPC*3+2] = bodyPC
			} else {
				patched[splitPC*3+1] = bodyPC
				patched[splitPC*3+2] = next
			}
			mutB = nfaBuilder{code: patched, sets: b2.sets, overflow: false}
			cur = splitPC
		} else {
			let mut k = n.min
			for k < n.max {
				let (b1, bodyPC) = compileNode(ast, tags, mutB, n.kids[0], cur)
				let left = if n.lazy { next } else { bodyPC }
				let right = if n.lazy { bodyPC } else { next }
				let (b2, splitPC) = emitInst(b1, opSplit, left, right)
				mutB = b2
				cur = splitPC
				if mutB.overflow {
					return (mutB, 0)
				}
				k = k + 1
			}
		}
		let mut m = 0
		for m < n.min {
			let (b1, pc) = compileNode(ast, tags, mutB, n.kids[0], cur)
			mutB = b1
			cur = pc
			if mutB.overflow {
				return (mutB, 0)
			}
			m = m + 1
		}
		return (mutB, cur)
	}
	(b, next)
}

func analyzeNFAStart(code []int, sets []uint64, startPC int) (bool, bool, byteSet) {
	let instCount = code.Len() / 3
	let mut seen = []bool{}
	for _ in 0..instCount {
		seen = seen.Append(false)
	}
	let mut first = emptySet()
	let mut canEmpty = false
	let mut stk = []int{startPC}
	for stk.Len() > 0 {
		let top = stk.Len() - 1
		let pc = stk[top]
		stk = stk[0:top]
		if seen[pc] {
			continue
		}
		seen[pc] = true
		let base = pc * 3
		let op = code[base]
		if op == opAccept {
			canEmpty = true
		} else if op == opSplit {
			stk = stk.Append(code[base+2])
			stk = stk.Append(code[base+1])
		} else if op == opTag || op == opStart || op == opEnd {
			stk = stk.Append(code[base+1])
		} else if op == opByte {
			let si = code[base+2] * 4
			first = unionSet(first, byteSet{w0: sets[si], w1: sets[si+1], w2: sets[si+2], w3: sets[si+3]})
		}
	}
	let mut seenNoStart = []bool{}
	for _ in 0..instCount {
		seenNoStart = seenNoStart.Append(false)
	}
	let mut unanchoredReach = false
	let mut stk2 = []int{startPC}
	for stk2.Len() > 0 {
		let top = stk2.Len() - 1
		let pc = stk2[top]
		stk2 = stk2[0:top]
		if seenNoStart[pc] {
			continue
		}
		seenNoStart[pc] = true
		let base = pc * 3
		let op = code[base]
		if op == opAccept || op == opByte || op == opEnd {
			unanchoredReach = true
			break
		}
		if op == opSplit {
			stk2 = stk2.Append(code[base+2])
			stk2 = stk2.Append(code[base+1])
		} else if op == opTag {
			stk2 = stk2.Append(code[base+1])
		}
	}
	(!unanchoredReach, canEmpty, first)
}

func runNFA(code []int, sets []uint64, startPC int, s string, anchored bool, from int) (bool, int, int, []int, []int, int) {
	let n = s.Len()
	let instCount = code.Len() / 3
	if !anchored && (from < 0 || from > n) {
		return (false, 0, 0, []int{}, []int{}, 0)
	}
	let (onlyStartAnchored, canEmpty, firstBytes) = analyzeNFAStart(code, sets, startPC)
	if !anchored && onlyStartAnchored && from > 0 {
		return (false, 0, 0, []int{}, []int{}, 0)
	}
	let startFrom = if anchored { 0 } else { from }
	let mut seenStamp = []int{}
	for _ in 0..instCount {
		seenStamp = seenStamp.Append(0)
	}
	let mut histTag = []int{}
	let mut histPos = []int{}
	let mut histPrev = []int{}
	let mut curPC = []int{}
	let mut curStart = []int{}
	let mut curHist = []int{}
	if anchored {
		curPC = curPC.Append(startPC)
		curStart = curStart.Append(0)
		curHist = curHist.Append(-1)
	}
	let mut bestOK = false
	let mut bestStart = 0
	let mut bestEnd = 0
	let mut bestHist = -1
	let mut stamp = 0
	let mut failAt = 0
	let mut stkPC = []int{}
	let mut stkStart = []int{}
	let mut stkHist = []int{}
	let mut readyPC = []int{}
	let mut readyStart = []int{}
	let mut readyHist = []int{}
	let mut nextPC = []int{}
	let mut nextStart = []int{}
	let mut nextHist = []int{}
	let mut pos = startFrom
	for pos <= n {
		if !anchored && curPC.Len() == 0 && !bestOK && !canEmpty {
			if onlyStartAnchored && pos > 0 {
				break
			}
			for pos < n && !setContainsByte(firstBytes, s[pos]) {
				pos = pos + 1
			}
			if pos == n {
				break
			}
		}
		if !anchored && !bestOK && (!onlyStartAnchored || pos == 0) {
			curPC = curPC.Append(startPC)
			curStart = curStart.Append(pos)
			curHist = curHist.Append(-1)
		}
		if !anchored && curPC.Len() == 0 && (bestOK || (onlyStartAnchored && pos > 0)) {
			break
		}
		stamp = stamp + 1
		readyPC = readyPC[0:0]
		readyStart = readyStart[0:0]
		readyHist = readyHist[0:0]
		for ci in 0..curPC.Len() {
			stkPC = stkPC[0:0]
			stkStart = stkStart[0:0]
			stkHist = stkHist[0:0]
			stkPC = stkPC.Append(curPC[ci])
			stkStart = stkStart.Append(curStart[ci])
			stkHist = stkHist.Append(curHist[ci])
			for stkPC.Len() > 0 {
				let top = stkPC.Len() - 1
				let pc = stkPC[top]
				let ts = stkStart[top]
				let th = stkHist[top]
				stkPC = stkPC[0:top]
				stkStart = stkStart[0:top]
				stkHist = stkHist[0:top]
				if seenStamp[pc] == stamp {
					continue
				}
				seenStamp[pc] = stamp
				let base = pc * 3
				let op = code[base]
				if op == opSplit {
					let left = code[base+1]
					let right = code[base+2]
					stkPC = stkPC.Append(right)
					stkStart = stkStart.Append(ts)
					stkHist = stkHist.Append(th)
					stkPC = stkPC.Append(left)
					stkStart = stkStart.Append(ts)
					stkHist = stkHist.Append(th)
					continue
				}
				if op == opStart {
					if pos == 0 {
						stkPC = stkPC.Append(code[base+1])
						stkStart = stkStart.Append(ts)
						stkHist = stkHist.Append(th)
					}
					continue
				}
				if op == opEnd {
					if pos == n {
						stkPC = stkPC.Append(code[base+1])
						stkStart = stkStart.Append(ts)
						stkHist = stkHist.Append(th)
					}
					continue
				}
				if op == opTag {
					let nxt = code[base+1]
					let tv = code[base+2]
					let nh = histTag.Len()
					histTag = histTag.Append(tv)
					histPos = histPos.Append(pos)
					histPrev = histPrev.Append(th)
					stkPC = stkPC.Append(nxt)
					stkStart = stkStart.Append(ts)
					stkHist = stkHist.Append(nh)
					continue
				}
				readyPC = readyPC.Append(pc)
				readyStart = readyStart.Append(ts)
				readyHist = readyHist.Append(th)
			}
		}
		if anchored && pos == n {
			let mut matched = false
			for ri in 0..readyPC.Len() {
				if code[readyPC[ri]*3] == opAccept {
					bestOK = true
					bestStart = readyStart[ri]
					bestEnd = n
					bestHist = readyHist[ri]
					matched = true
					break
				}
			}
			if !matched {
				failAt = pos
			}
			break
		}
		nextPC = nextPC[0:0]
		nextStart = nextStart[0:0]
		nextHist = nextHist[0:0]
		for ri in 0..readyPC.Len() {
			let pc = readyPC[ri]
			let base = pc * 3
			let op = code[base]
			if !anchored && op == opAccept {
				if !bestOK || readyStart[ri] <= bestStart {
					bestOK = true
					bestStart = readyStart[ri]
					bestEnd = pos
					bestHist = readyHist[ri]
				}
				break
			}
			if op == opByte && pos < n {
				let b = s[pos]
				let si = code[base+2]
				let w = sets[si*4+int(b)/64]
				if (w & (uint64(1) << uint64(int(b)&63))) != uint64(0) {
					nextPC = nextPC.Append(code[base+1])
					nextStart = nextStart.Append(readyStart[ri])
					nextHist = nextHist.Append(readyHist[ri])
				}
			}
		}
		if anchored {
			if nextPC.Len() == 0 {
				failAt = pos
				break
			}
		} else {
			if pos == n || (nextPC.Len() == 0 && bestOK) {
				break
			}
		}
		let tmpPC = curPC
		let tmpStart = curStart
		let tmpHist = curHist
		curPC = nextPC
		curStart = nextStart
		curHist = nextHist
		nextPC = tmpPC
		nextStart = tmpStart
		nextHist = tmpHist
		pos = pos + 1
	}
	if !bestOK {
		return (false, 0, 0, []int{}, []int{}, failAt)
	}
	let mut revTag = []int{}
	let mut revPos = []int{}
	let mut idx = bestHist
	for idx >= 0 {
		revTag = revTag.Append(histTag[idx])
		revPos = revPos.Append(histPos[idx])
		idx = histPrev[idx]
	}
	let count = revTag.Len()
	let mut evTag = []int{}
	let mut evPos = []int{}
	let mut k = count - 1
	for k >= 0 {
		evTag = evTag.Append(revTag[k])
		evPos = evPos.Append(revPos[k])
		k = k - 1
	}
	(true, bestStart, bestEnd, evTag, evPos, bestEnd)
}
