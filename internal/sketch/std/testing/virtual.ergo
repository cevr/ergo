// Package testing holds the providers a test binds in place of the host
// (docs/spec/stdlib.md, Testing; #209). VirtualClock is the first: a test
// time.Clock and Scheduler whose time moves on its own when every task of
// the test waits. The rest of the package (T, Discard, Idle) is #209's.

import queue
import task
import time

// VirtualClock is a test provider of time.Clock and Scheduler. Its time
// moves only when every task of its domain waits and none can run: then
// it moves to the earliest deadline of a Sleep and wakes every task asleep
// until that deadline. Its domain is the task that called NewVirtualClock,
// from that call on, and every task started below a task of the domain.
// The waits it sees are a Sleep on it, a queue's Push and Pop, a Task's
// Wait and Stop, timeout.After, and an actor's inbox, Send, Ask, State,
// Changes, ExitOf and Host.Get. A wait on anything else (the host's
// input, a file, the host clock, a time.Manual) keeps the time still until
// it ends. So a test sleeps for hours in no wall time and needs no loop on
// Sleepers. Every copy of a VirtualClock shares one time. Bind one value
// for both capabilities: `let c = testing.NewVirtualClock(0)` then
// `context { time.Clock: c, Scheduler: c }`. Effect's TestClock moves
// only on adjust; this clock follows Go's testing/synctest and Tokio's
// paused time.
type VirtualClock { line time.Timeline }

// NewVirtualClock is a VirtualClock whose time is sec seconds after
// January 1, 1970 UTC. The calling task joins its domain, and leaves the
// domain of any VirtualClock it made before.
func NewVirtualClock(sec int64) VirtualClock { VirtualClock{line: newLine(sec, 0)} }

// Now is the clock's time.
func Now(c VirtualClock) time.Time {
	let r = c.line.Read()
	time.Unix(r.Sec, r.Nsec)
}

// Sleep suspends the calling task until the clock's time is d past now.
// A d of zero or less returns at once; a stop of the task ends the sleep.
func Sleep(c VirtualClock, d duration) { c.line.Wait(d) }

extern go ergo.local/prototype/runtime/v1.NewVirtualTimeline func newLine(sec int64, nsec int64) time.Timeline

// span is a duration of 1ns up to about 18 minutes, drawn from n.
func span(n int64) duration { duration(1 + (n%1099511627775+1099511627775)%1099511627775) }

// SleepAdvancesExactly: a lone Sleep(d) moves the clock by exactly d.
law SleepAdvancesExactly(n int64) {
	let c = NewVirtualClock(0)
	let d = span(n)
	with context { Scheduler: c, time.Clock: c } {
		let before = time.Clock.Now()
		Scheduler.Sleep(d)
		time.Clock.Now().Sub(before) == d
	}
}

// IdleOnlyAdvance: the clock does not move while a task can run. A task
// that pushes k values while its parent sleeps reads the start time after
// the last push; the parent then wakes at its deadline, with no time
// passed for the pushes. The queue is never closed, so a Closed gives a
// time the check refuses.
law IdleOnlyAdvance(n int64, k int) {
	let c = NewVirtualClock(0)
	let d = span(n)
	let count = 1 + (k%50+50)%50
	with context { Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		let q = queue.New[int](count)
		let t = task.Go() {
			for i in 0..count {
				try q.Push(i)
			}
			time.Clock.Now()
		}
		Scheduler.Sleep(d)
		let seen = t.Wait() catch {
		case queue.Closed:
			time.Unix(1, 0)
		}
		seen.Equal(start) && time.Clock.Now().Sub(start) == d && q.Len() == count
	}
}
