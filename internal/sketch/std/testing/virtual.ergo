// Package testing holds the providers a test binds in place of the host
// (docs/spec/stdlib.md, Testing; #209). VirtualClock is the first: a test
// time.Clock and Scheduler whose time moves on its own when every task of
// the test waits. The rest of the package (T, Discard, Idle) is #209's.

import queue
import scope
import task
import time

// VirtualClock is a test provider of time.Clock and Scheduler. Its time
// moves only when every task of its domain waits and none can run: then
// it moves to the earliest deadline of a Sleep and wakes every task asleep
// until that deadline. Its domain is the task that called NewVirtualClock,
// from that call on, and every task started below a task of the domain.
// The waits it sees are a Sleep on it, a queue's Push and Pop, a Task's
// Wait and Stop, timeout.After, an actor's inbox, Send, Ask, State,
// Changes, ExitOf and Host.Get, and a call through rpc.Loopback. A wait on anything else (the host's
// input, a file, the host clock, a time.Manual) keeps the time still until
// it ends. So a test sleeps for hours in no wall time and needs no loop on
// Sleepers. Every copy of a VirtualClock shares one time. Bind one value
// for both capabilities: `let c = testing.NewVirtualClock(0)` then
// `context { time.Clock: c, Scheduler: c }`. Effect's TestClock moves
// only on adjust; this clock follows Go's testing/synctest and Tokio's
// paused time.
type VirtualClock { line time.Timeline } implements time.Scheduler, time.Clock

// NewVirtualClock is a VirtualClock whose time is sec seconds after
// January 1, 1970 UTC. The calling task joins its domain, and leaves the
// domain of any VirtualClock it made before.
func NewVirtualClock(sec int64) VirtualClock { VirtualClock{line: newLine(sec, 0)} }

// Now is the clock's time.
func Now(c VirtualClock) time.Time {
	let r = c.line.Read()
	time.Unix(r.Sec, r.Nsec)
}

// Elapsed is the time passed since t on the clock: c.Now().Sub(t).
func Elapsed(c VirtualClock, t time.Time) duration { c.Now().Sub(t) }

// Sleep suspends the calling task until the clock's time is d past now.
// A d of zero or less returns at once; a stop of the task ends the sleep.
func Sleep(c VirtualClock, d duration) { c.line.Wait(d) }

// Sleepers is the number of deadlines armed on the clock: the tasks asleep
// on it and the alarms of its AlarmClock, as time.Manual's Sleepers.
func Sleepers(c VirtualClock) int { c.line.Sleepers() }

// Alarms is the clock's time as the runtime's waits use it: an alarm's
// deadline is one the clock moves to when its domain waits.
func Alarms(c VirtualClock) time.AlarmClock { c.line.Alarms() }

extern go ergo.local/prototype/runtime/v1.NewVirtualTimeline func newLine(sec int64, nsec int64) time.Timeline

// span is a duration of 1ns up to about 18 minutes, drawn from n.
func span(n int64) duration { duration(1 + (n%1099511627775+1099511627775)%1099511627775) }

// SleepAdvancesExactly: a lone Sleep(d) moves the clock by exactly d.
law SleepAdvancesExactly(n int64) {
	let c = NewVirtualClock(0)
	let d = span(n)
	with context { time.Scheduler: c, time.Clock: c } {
		let before = time.Clock.Now()
		time.Scheduler.Sleep(d)
		time.Clock.Now().Sub(before) == d
	}
}

// IdleOnlyAdvance: the clock does not move while a task can run. A task
// that pushes k values while its parent sleeps reads the start time after
// the last push; the parent then wakes at its deadline, with no time
// passed for the pushes. The queue is never closed, so a Closed gives a
// time the check refuses.
law IdleOnlyAdvance(n int64, k int) {
	let c = NewVirtualClock(0)
	let d = span(n)
	let count = 1 + (k%50+50)%50
	with context { time.Scheduler: c, time.Clock: c } {
		let start = time.Clock.Now()
		let q = queue.New[int](count)
		let t = task.Go() {
			for i in 0..count {
				try q.Push(i)
			}
			time.Clock.Now()
		}
		time.Scheduler.Sleep(d)
		let seen = t.Wait() catch {
		case queue.Closed:
			time.Unix(1, 0)
		}
		seen.Equal(start) && time.Clock.Now().Sub(start) == d && q.Len() == count
	}
}

// StopAfterStopsAtD: a task that registers k exit actions, then sleeps w
// ms and returns 1, under task.StopAfter(t, d ms), is Done with its value
// when w <= d and Stopped when w > d, with its exit actions run in both;
// on a time.Manual and on a VirtualClock (manual) alike, by one text. The
// tie is exact: at w == d it is Done whichever of the two was armed first
// (alarmFirst), because the alarm acts after every other event of its
// instant, so the sleep wakes first and the block returns before its next
// wait. The alarm has fired when the clock passed d, so Cancel then
// reports false, on an ended task too. It is here, beside VirtualClock,
// because task cannot import testing.
law StopAfterStopsAtD(w int, d int, alarmFirst bool, k int, manual bool) {
	let wait = 1 + ((w%6)+6)%6
	let limit = 1 + ((d%6)+6)%6
	let n = ((k % 4) + 4) % 4
	if manual {
		let m = time.NewManual(0)
		with context { time.Scheduler: m } {
			stopsAtD(n, wait, limit, alarmFirst, func() int { m.Sleepers() }, func() {
				for _ in 0..7 {
					m.Advance(1ms)
				}
			})
		}
	} else {
		let c = NewVirtualClock(0)
		with context { time.Scheduler: c } {
			stopsAtD(n, wait, limit, alarmFirst, func() int { c.Sleepers() }, func() { time.Scheduler.Sleep(7ms) })
		}
	}
}

// stopsAtD is StopAfterStopsAtD on the bound Scheduler, whose deadlines
// sleepers counts and whose time pass moves by 7 ms.
func stopsAtD(n int, wait int, limit int, alarmFirst bool, sleepers func() int, pass func() needs time.Scheduler) bool needs time.Scheduler {
	let marks = queue.New[int](4)
	let gate = queue.New[int](1)
	let t = task.Go() { try stopSlept(n, marks, gate, time.Times(1ms, wait)) }
	let a = stopArmed(t, gate, sleepers, alarmFirst, time.Times(1ms, limit)) catch {
	case queue.Closed:
		return false
	}
	pass()
	let ended = match task.ExitOf(t) {
	case task.Done[int] as v:
		wait <= limit && v.Value == 1
	case task.Stopped:
		wait > limit
	case _:
		false
	}
	ended && marks.Len() == n && !a.Cancel()
}

// stopSlept is the block of StopAfterStopsAtD: n exit actions, each
// pushing its mark, then one value from gate, a sleep of wait, and 1.
func stopSlept(n int, marks queue.Queue[int], gate queue.Queue[int], wait duration) int fails queue.Closed needs time.Scheduler {
	for i in 0..n {
		scope.OnExit() {
			marks.Push(i) catch {
			case queue.Closed:
			}
		}
	}
	try gate.Pop()
	time.Scheduler.Sleep(wait)
	1
}

// stopArmed arms task.StopAfter(t, d) before t sleeps (first) or once it
// sleeps (sleepers counts its deadline): the two arming orders of the
// alarm and t's sleep.
func stopArmed(t task.Task[int, queue.Closed], gate queue.Queue[int], sleepers func() int, first bool, d duration) task.Alarm fails queue.Closed needs time.Scheduler {
	if first {
		let a = task.StopAfter(t, d)
		try gate.Push(0)
		return a
	}
	try gate.Push(0)
	for sleepers() == 0 {
	}
	task.StopAfter(t, d)
}
