// Stage E3a sweep (196l): a property that fails names the case, the seed
// and the arguments, shrunk (L10), and stops at its first failing case.
func abs(n int) int {
	if n < 0 {
		return 0 - n
	}
	n
}

test NonNegative(n int) {
	assert abs(n) >= 0
}

test Small(n int, label string) {
	assert n < 5 || len(label) > 100
}

func main() needs Console {
	Console.Println("\(abs(-7))")
}

// run> 7
// test> ok NonNegative (100 cases)
// test> FAIL Small (case 3 of 100, seed 1, size 0: n = 5, label = ""; shrunk from: n = 2147483647, label = ""): assert failed at main.ergo:15:2: n < 5 || len(label) > 100
// test> FAIL (1 of 2 tests)
// test exit 1
