// Stage E3b sweep (196l), program 10: a type with laws and no operations.
// Its laws see the package names only.
func square(n int) int {
	n * n
}

type Arithmetic {
	law SquareNonNegative(n int) { square(n) >= 0 },
	law AddCommutes(a int, b int) { a + b == b + a },
}

func main() needs Console {
	Console.Println("\(square(10))")
}

