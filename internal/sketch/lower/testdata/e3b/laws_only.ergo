// Stage E3b sweep (196l), program 10: laws about plain functions. Since
// law-top they are top-level laws, quantified over their parameters; they
// see the package names only. A type with laws and no operations is S108.
func square(n int) int {
	n * n
}

law SquareNonNegative(n int) { square(n) >= 0 }

law AddCommutes(a int, b int) { a + b == b + a }

func main() needs Console {
	Console.Println("\(square(10))")
}

// run> 100
