import content
import regex

// Derived types (patterns.md, Derivation 1): derive is a contextual word.
type Date derive regex.Pattern(`(?<Year>[0-9]{4})-(?<Month>[0-9]{2})(-(?<Day>[0-9]{2}))?`)

type Ticket derive Fixed("TK", 6)

type Port int where 1 <= it && it <= 65535

// A type over a type named derive, at the end of its line.
type Alias derive

type derive int

func Fixed(prefix string, width int) content.Plan {
	regex.Pattern("\(prefix)-(?<Num>[0-9]{\(width)})")
}
