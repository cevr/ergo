string("// record-update acceptance: T{..base, Field: value} copies base and\n// replaces the named fields. The base is evaluated once, before the field\n// values, which run in source order; the base itself is unchanged.\ntype Walk { At int, Tide int, Turn int, Shells int, Left string }\n\ntype Inner { X int, Y int }\n\ntype Outer { Name string, In Inner }\n\ntype Box[T] { V T, N int }\n\ntype Playing { W Walk }\n\ntype Won { W Walk }\n\ntype Game = Playing | Won\n\ntype Bad { Why string }\n\nfunc turn(w Walk) Walk {\n\tWalk{..w, Turn: w.Turn + 1}\n}\n\nfunc collect(w Walk, k int) Walk {\n\tWalk{..w, Shells: w.Shells + 1, Left: w.Left[0:k] + \".\" + w.Left[k+1:]}\n}\n\nfunc step(g Game) Game {\n\tmatch g {\n\tcase Playing as p:\n\t\tPlaying{..p, W: turn(p.W)}\n\tcase Won:\n\t\tg\n\t}\n}\n\nfunc mk() Walk needs Console {\n\tConsole.Println(\"base\")\n\tWalk{At: 1, Tide: 2, Turn: 3, Shells: 4, Left: \"abc\"}\n}\n\nfunc val(n int) int needs Console {\n\tConsole.Println(\"value \\(n)\")\n\tn\n}\n\nfunc parse(s string) int fails Bad {\n\tif s == \"\" {\n\t\treturn Bad{Why: \"empty\"}\n\t}\n\tlen(s)\n}\n\nfunc tried(w Walk, s string) Walk fails Bad {\n\tWalk{..w, Tide: try parse(s)}\n}\n\nfunc show(w Walk) string {\n\t\"\\(w.At) \\(w.Tide) \\(w.Turn) \\(w.Shells) \\(w.Left)\"\n}\n\nfunc main() needs Console {\n\tlet w = Walk{At: 1, Tide: 2, Turn: 3, Shells: 4, Left: \"abc\"}\n\tlet t = turn(w)\n\tConsole.Println(show(t) + \" | \" + show(w))\n\tConsole.Println(show(collect(w, 1)))\n\tlet o = Outer{Name: \"o\", In: Inner{X: 1, Y: 2}}\n\tlet o2 = Outer{..o, In: Inner{..o.In, Y: 9}}\n\tConsole.Println(\"\\(o2.Name) \\(o2.In.X) \\(o2.In.Y) | \\(o.In.Y)\")\n\tlet b = Box[string]{V: \"a\", N: 1}\n\tlet b2 = Box[string]{..b, V: \"z\"}\n\tConsole.Println(\"\\(b2.V) \\(b2.N) | \\(b.V)\")\n\tmatch step(Playing{W: w}) {\n\tcase Playing as p:\n\t\tConsole.Println(\"playing \" + show(p.W))\n\tcase Won:\n\t\tConsole.Println(\"won\")\n\t}\n\tlet e = Walk{..mk(), Turn: val(7), Shells: val(8)}\n\tConsole.Println(show(e))\n\tlet ok = tried(w, \"xyz\") catch {\n\tcase Bad as x:\n\t\tWalk{..w, Left: x.Why}\n\t}\n\tlet bad = tried(w, \"\") catch {\n\tcase Bad as x:\n\t\tWalk{..w, Left: x.Why}\n\t}\n\tConsole.Println(show(ok) + \" | \" + show(bad))\n}\n")
