let Base = context needs Clock {
	Accounts: MemoryAccounts{},
}

// A header's failure row stands where a signature's does, before needs
// (CTX-ROWS-1b).
// expect: "let Opened = context fails Missing | Closed needs Clock {"
let Opened = context fails Missing | Closed needs Clock {
	Accounts: MemoryAccounts{},
}

let Test = context {
	Base,
	replace Accounts: FakeAccounts{},
	Ledger, Audit: Recorder{},
}

func main() needs Console {
	with context { Console: Quiet{} } { Console.Println("x") }
	let local = context { Clock: Fixed{} }
	// expect: "let failing = context fails Missing { Clock: Fixed{} }"
	let failing = context fails Missing { Clock: Fixed{} }
	with Test, local {
		Console.Println("y")
	}
}
