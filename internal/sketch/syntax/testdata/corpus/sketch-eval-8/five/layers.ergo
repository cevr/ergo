// Capability identity is the interface name, so these three stay distinct.
type Store { Label() string }
type Account { Label() string }
type Invoice { Label() string }

type Memory { Text string }

func Label(m Memory) string { return m.Text }

type AccountLive { Store Store } // capability field: filled by context

func Label(a AccountLive) string { return a.Store.Label() }

type InvoiceLive { Store Store }

func Label(i InvoiceLive) string { return i.Store.Label() }

let Shared = context {
	Store: Memory{Text: "live"},
}

let Accounts = context {
	Account: AccountLive,
	Shared,
}

let Invoices = context {
	Invoice: InvoiceLive,
	Shared,
}

let App = context provides Account | Invoice { // exposes two; Store stays hidden, built once
	Accounts,
	Invoices,
}

let Fixture = context {
	replace Store: Memory{Text: "fixture"},
	App,
}

func labels() string needs Account | Invoice {
	return Account.Label() + ":" + Invoice.Label()
}

func main() string {
	return with Fixture { labels() }
}
