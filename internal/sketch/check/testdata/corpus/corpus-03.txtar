// The timeout module.
import timeout

// Ticker reads the time.
type Ticker {
	// Now is the time.
	Now() int64,
}

// Fixed is a clock.
type Fixed {
	// t is the time.
	t int64,
}

// Now reads f.
func Now(f Fixed) int64 { return f.t }

// fail is one.
func fail() int { return 1 }

// W provides Ticker.
let W = context {
	// The fixed clock.
	Ticker: Fixed{t: 1},
}

// n is one.
let n = 1

// f reads W.
func f() int64 { return with W { Ticker.Now() } + int64(n) + int64(fail()) }
func g() timeout.Expired { return timeout.Expired }
func main() {}
