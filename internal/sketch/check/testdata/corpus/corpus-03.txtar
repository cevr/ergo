type P { X int, Y int }
func g(p *P) int { return p.X }
func f(xs []int, m Map[string, int]) int {
	let mut p = P{X: 1, Y: 2}
	p.X = -(g(&p) + 1)
	let q = P{..p, Y: 3}
	let ys = xs[1:2:3]
	let zs = xs[:1]
	let n = ys[0] + len(m) + len(zs)
	if n > 0 && !(n == 3) {
		return n
	} else if n < 0 {
		return 0
	}
	for x in xs {
		if x > 1 {
			break
		}
		continue
	}
	g(&p)
	return len(ys) + q.Y
}
func main() {}
