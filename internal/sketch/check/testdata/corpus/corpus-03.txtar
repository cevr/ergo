type Closed {}
type Open {}
type State = Closed | Open
type Trip {}
type Signal = Trip
func step(s State, sig Signal) Decision[State, string] {
	match s {
	case Closed:
		return Enter{Open}
	case Open:
		return Done{"open"}
	}
}
type Breaker machine[State, Signal] {
	// The breaker starts closed.
	initial: Closed,
	// step decides each signal.
	step:    step,
}
func main() {}
-- 01782.ergo --

type Closed {}
type Open {}
type State = Closed | Open
type Trip {}
type Signal = Trip
func step(s State, sig Signal) Decision[State, string] {
	match s {
	case Closed:
		return Emit{Open, "tripped"}
	case Open:
		return Done{"open"}
	}
}
func timer(s State) Option[Timeout[Signal]] {
	match s {
	case Closed:
		return None
	case Open:
		return Some{Timeout{5s, Trip}}
	}
}
type Breaker machine[State, Signal] {
	initial: Closed,
	step:    step,
	after:   timer,
}
func main() {}
