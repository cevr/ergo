type Closed {}
type Open {}
type State = Closed | Open
type Trip {}
type Signal = Trip
func step(s State, sig Signal) Decision[State, string] {
	match s {
	case Closed:
		return Enter{Open}
	case Open:
		return Done{"open"}
	}
}
type Breaker machine[State, Signal] {
	initial: Closed,
	step:    step,
}
