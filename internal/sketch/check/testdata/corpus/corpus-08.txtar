type Bad { At int }
type Oops { At int }
type Other {}
type Fail = Bad | Oops
func f(n int) int fails Fail | Other {
	if n == 1 {
		return Other
	}
	if n == 2 {
		return Bad{At: 2}
	}
	n
}
func only(n int) int fails Bad {
	if n == 1 {
		return Bad{At: 1}
	}
	n
}
func describe(x Fail) int {
	match x {
	case Bad{At: a}:
		a
	case Oops{At: a}:
		-a
	}
}
