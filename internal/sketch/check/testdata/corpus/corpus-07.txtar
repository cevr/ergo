type Store { Get() string }
type Mem { V string }

func Get(m Mem) string { return m.V }

func Id[T](x T) T {
	return x
}

func NewStore(v string) Store { return Mem{V: v} }

func use(s Store, m Mem, xs []int8) int {
	let n = Id(xs)
	let mut total = len(n) + 2 * 3
	for i, x in xs {
		let y = int(x) + i
		s.Get()
		m.Get()
		total += y
	}
	for k in 0..total {
		total += k
	}
	return total
}
