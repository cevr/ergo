type Pair[A, B] { First A, Second B }

func Swap[A, B](p Pair[A, B]) Pair[B, A] {
	Pair[B, A]{First: p.Second, Second: p.First}
}

func Map2[A, B, C](p Pair[A, B], f func(a A) C) Pair[C, B] {
	Pair[C, B]{First: f(p.First), Second: p.Second}
}

func f[T](xs []T, x T) []T {
	xs.Append(x)
}

