	let ys = xs.Append(1)
	let o = m.Get("a")
	let m2 = m.Delete("a")
	let q = p.Swap()
	let r = p.Map2(func(a int) int64 { int64(a) })
	_ = o
	_ = q
	_ = r
	len(ys) + len(m2)
}
