func Check(c Card, n int) bool { n > 0 }

func Check[T](b Box[T], n int) bool { true }

func All[T Valid](x T) bool { x.Check(1) }

func F() bool { All(Card{Number: "1"}) && All(Box[string]{V: "s"}) }
func F() int {
	let f func(int) int = func(x) { x + 1 }
