type Cap { M() }
type Box[T] { M(T) }
func BoxOf[T](x T) Box[T] { BoxOf(x) }
func Choose[T](x T,y T) needs Cap { Cap.M() }
func a() {_ = b;Choose(BoxOf(a),BoxOf(d))} // want S108
func b() {Choose(BoxOf(c),BoxOf(a))} // want S108
func c() {Choose(BoxOf(a),BoxOf(d))} // want S108
func d() {Choose(BoxOf(c),BoxOf(a))} // want S108

