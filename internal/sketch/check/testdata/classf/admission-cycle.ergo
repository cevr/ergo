type Bang {}
type Box[T] { M(T) }
func BoxOf[T](x T) Box[T] { BoxOf(x) }
func Choose[T](x T,y T) fails Bang { return Bang }
func a() {_ = b;return Choose(BoxOf(a),BoxOf(d))} // want S108
func b() {return Choose(BoxOf(c),BoxOf(a))} // want S108
func c() {return Choose(BoxOf(a),BoxOf(d))} // want S108
func d() {return Choose(BoxOf(c),BoxOf(a))} // want S108

