type Bang {}
type Box[T] {M(T)}
func BoxOf[T](x T) Box[T] { BoxOf(x) }
func Choose[T](x T,y T) fails Bang { return Bang }
func a(){return Choose(BoxOf(func(){return b()}),BoxOf(func(){return a()}))} // want S108
func b(){return Choose(BoxOf(func(){return a()}),BoxOf(func(){return b()}))} // want S108

