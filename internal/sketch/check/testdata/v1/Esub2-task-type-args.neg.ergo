// Stage E2 (state.md:315, 944-945; plan open point 1): a type argument,
// written or inferred, holds no Task (S108, "a Task leaves its function
// only by return"). #197 designs aggregate ownership.
type Fault {}
type A {}
type Box[T] { V T }

type U = A | Box[Task[int, Fault]] // want S108

func keep[T](x T) []T {
	[]T{x}
}

func id[T](x T) T {
	x
}

func later() Option[Task[int, Fault]] { // want S108
	None
}

func launder(t Task[int, Fault]) int {
	len(keep(t)) // want S108
}

func pass(t Task[int, Fault]) Task[int, Fault] {
	id(t) // want S108
}
