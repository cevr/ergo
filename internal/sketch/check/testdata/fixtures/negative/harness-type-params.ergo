// A harness has no type parameters (check harness.go, rule 1).
type Coin {
	Flip() bool,
	test Toss, // want S108 "Toss has type parameters"
}

type Run { Name string, Seed uint64, Site string, Source string }

type Failed { Message string }

type always {} implements Coin

func Flip(a always) bool { true }

func Toss[T](run Run, x T, body func() fails Failed needs Coin) fails Failed {
	with context { Coin: always } { body() } catch {
	case Failed as f:
		return f
	}
}
