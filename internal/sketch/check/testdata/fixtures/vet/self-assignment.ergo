type Point { X int, Y int }

type Off {}
type On {}
type Switch = Off | On

func moves(s Switch, xs []int) int {
	let mut n = 0
	let mut p = Point{X: 1, Y: 2}
	let mut ys = xs
	match s {
	case Off:
		n = n // want S110 "n = n assigns n its own value, so it does nothing"
	case On:
	}
	p.X = p.X // want S110 "p.X = p.X assigns"
	p.Y = p.X
	ys[0] = ys[0] // want S110 "ys[0] = ys[0] assigns"
	ys[0] = ys[1]
	n = n + 1
	n + p.Y + len(ys)
}
