type Person {
	Age int "json:\"age,omitempty\"", // want S108 "the key \"json:\\\"age,omitempty\\\"\" holds a quote, as a Go struct tag does; a field's string is its wire key itself, for every format: write \"age\""
	Nick string "\"nick\"", // want S108 "holds a quote, as a Go struct tag does"
	Lang string "xml:lang",
	Name string "json:name",
	City string "city",
	Spaced string "full name",
}

