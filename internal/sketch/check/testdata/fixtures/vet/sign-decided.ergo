func checks(u uint, xs []int, n int) int {
	let mut k = 0
	if u >= 0 { // want S108 "this comparison is always true: a value of type uint is never negative"
		k = k + 1
	}
	if len(xs) < 0 { // want S108 "this comparison is always false: a length is never negative"
		k = k + 1
	}
	if 0 > u { // want S108 "always false"
		k = k + 1
	}
	if len(xs) == -1 { // want S108 "always false"
		k = k + 1
	}
	if len(xs) > 0 && u > 0 && n >= 0 && len(xs) != 1 {
		k = k + 1
	}
	if len(xs) <= 0 {
		k = k + 1
	}
	k
}
