// out: handled
import timeout
type Fault {}
func fail() fails Fault { return Fault }
func main() needs Console | Ambient {
	with context { Scheduler: NewLiveScheduler() } {
		timeout.After(1s) {
			with context { Scheduler: NewLiveScheduler() } {
				try timeout.After(1s) {
					try fail()
					Console.Println("wrong")
				}
			}
		} catch {
		case Fault:
			Console.Println("handled")
		case timeout.Expired:
			Console.Println("late")
		}
	}
}
