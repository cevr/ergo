import compiler/check/store
import compiler/syntax
import dense
import sha256
import strings

// The fingerprints of a declaration (C0/plan.md §3, the Decl rows' fp
// and ifp): a SHA-256 prefix over the declaration's tokens, each its kind
// and its text, so positions, layout and comments do not count. A
// semicolon counts by its kind alone: one the scanner inserts at a newline
// and one written are the same token. The interface print cuts what an
// importer cannot see, the body of a function with no type parameters and
// the body of a test, and writes one cut token in its place.

// printsOf is the prints of the top-level declaration row d.
func printsOf(p syntax.Parsed, d dense.ID[syntax.Node]) store.Prints {
	let lo = syntax.NodePos(p, d)
	let hi = syntax.NodeEnd(p, d)
	let (cutLo, cutHi) = cutOf(p, d)
	let first = firstToken(p, lo)
	// A token writes its text and five bytes; twice the span's bytes is
	// room for the usual run, so the builder rarely grows.
	let fp = printOf(tokensIn(p, first, hi, 0, 0, 2*(hi-lo)+16))
	if cutHi <= cutLo {
		return store.Prints{Fp: fp, Ifp: fp}
	}
	store.Prints{Fp: fp, Ifp: printOf(tokensIn(p, first, hi, cutLo, cutHi, 2*(hi-lo)+16))}
}

// tokensIn is the tokens from from up to offset hi, written by writeToken;
// those starting in cutLo..cutHi (when not empty) are one cut token.
func tokensIn(p syntax.Parsed, from int, hi int, cutLo int, cutHi int, room int) string {
	let mut b = strings.NewBuilder()
	b.Grow(room)
	let mut cut = false
	let mut j = from
	for j >= 0 && syntax.TokPos(p, j) < hi {
		let at = syntax.TokPos(p, j)
		if at >= cutLo && at < cutHi {
			if !cut {
				b.WriteString("cut;")
				cut = true
			}
		} else {
			let k = syntax.TokKind(p, j)
			writeToken(&b, k, if k == syntax.Semicolon { "" } else { syntax.TokText(p, j) })
		}
		j = j + 1
	}
	b.String()
}

// firstToken is the first token at or after offset at (a node starts at
// a token, so this is that token).
func firstToken(p syntax.Parsed, at int) int { syntax.TokStartingAt(p, at) }

// writeToken writes a token as its kind, its text's length (four bytes,
// low first) and its text, so no two token runs write the same bytes.
func writeToken(b *strings.Builder, k uint8, t string) {
	let n = len(t)
	b.WriteByte(byte(k))
	b.WriteByte(byte(n & 255))
	b.WriteByte(byte((n >> 8) & 255))
	b.WriteByte(byte((n >> 16) & 255))
	b.WriteByte(byte((n >> 24) & 255))
	b.WriteString(t)
}

// cutOf is the span an importer cannot see in row d, or an empty span.
func cutOf(p syntax.Parsed, d dense.ID[syntax.Node]) (int, int) {
	match syntax.ViewOf(p.Tree, d) {
	case syntax.FuncDecl as fd:
		if dense.Unpack(fd.TypeParams) != None {
			return (0, 0)
		}
		match dense.Unpack(fd.Body) {
		case Some[dense.ID[syntax.Node]] as body:
			(syntax.NodePos(p, body.Value), syntax.NodeEnd(p, body.Value))
		case None:
			(0, 0)
		}
	case syntax.TestDecl as td:
		(syntax.NodePos(p, td.Body), syntax.NodeEnd(p, td.Body))
	case _:
		(0, 0)
	}
}

// printOf is the first 16 bytes of text's SHA-256, as two big-endian words.
func printOf(text string) store.Print {
	let sum = sha256.Sum(text)
	let mut hi = uint64(0)
	let mut lo = uint64(0)
	for i in 0..8 {
		hi = hi<<8 | uint64(sum[i])
		lo = lo<<8 | uint64(sum[i+8])
	}
	store.Print{Hi: hi, Lo: lo}
}

// setPrints gives the declarations from index from on, all of top-level
// row d, d's prints.
func setPrints(s *store.Store, p syntax.Parsed, d dense.ID[syntax.Node], from int) {
	if store.NumDecls(*s) == from {
		return
	}
	let pr = printsOf(p, d)
	for i in from..store.NumDecls(*s) {
		store.SetPrints(s, store.DeclAt(*s, i), pr)
	}
}
