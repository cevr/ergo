// Calls, composite literals and selectors.

import compiler/check/bind
import compiler/check/infer
import compiler/check/store
import compiler/check/types
import compiler/syntax
import dense
import option
import slices
import strings

func isSome[T](o option.Option[T]) bool {
	match o {
	case option.Some[T]:
		true
	case option.None:
		false
	}
}

func unparen(tr syntax.Tree, x dense.ID[syntax.Node]) dense.ID[syntax.Node] {
	if syntax.KindOf(tr, x) == syntax.KParenExpr { unparen(tr, syntax.ParenExprOf(tr, x).X) } else { x }
}

// isCallSite is whether t is the prelude's CallSite.
func isCallSite(s store.Store, k Pkg, t dense.ID[store.TKey]) bool {
	if store.KindOfType(s, t) != store.KForeign {
		return false
	}
	let f = k.Foreign[store.ArgOf(s, t)]
	f.Name == "CallSite" && f.Path == "prelude"
}

// sigParts is a signature's parameters, as many as a call of n arguments
// passes (a final CallSite parameter the call leaves out is its site,
// call.go siteless), and its result.
func sigParts(s store.Store, k Pkg, sig dense.ID[store.TKey], n int) ([]dense.ID[store.TKey], dense.ID[store.TKey]) {
	let ops = store.OperandsOf(s, sig)
	let mut np = ops.Len() - 3
	if np > 0 && n == np-1 && isCallSite(s, k, ops[np-1]) {
		np = np - 1
	}
	(ops[0:np], ops[ops.Len()-3])
}

// dropsSite is whether a call of n arguments leaves sig's final CallSite
// out: the callee's type the Go checker records is then the signature
// without it, which the pool does not build, so it is not recorded.
func dropsSite(s store.Store, k Pkg, sig dense.ID[store.TKey], n int) bool {
	let ops = store.OperandsOf(s, sig)
	let np = ops.Len() - 3
	np > 0 && n == np-1 && isCallSite(s, k, ops[np-1])
}

// funcArg is whether a type argument is a function type: a parameter
// written own T keeps its own mark in the Go checker's instance when T is
// a function type, which the pool's signature, resolved with T a
// parameter, no longer holds, so such an instance is not recorded.
func funcArg(s store.Store, targs []dense.ID[store.TKey]) bool {
	for a in targs {
		if store.KindOfType(s, infer.Unmarked(s, a)) == store.KSig {
			return true
		}
	}
	false
}

// hasWired is whether t holds wired[P]: an instance's wired[T] of a
// concrete T is the codec rows of what T reaches (wirecall.go wireRow),
// which this pass does not expand, so such a type is not recorded.
func hasWired(s store.Store, t dense.ID[store.TKey]) bool {
	let kind = store.KindOfType(s, t)
	if kind == store.KWired || kind == store.KWiredNeeds {
		return true
	}
	for o in store.OperandsOf(s, t) {
		if hasWired(s, o) {
			return true
		}
	}
	false
}

// resultOf is a call's type from its signature's result: no value (the
// empty tuple) when it has none, as the Go checker's NoValue.
func resultOf(s store.Store, r dense.ID[store.TKey]) option.Option[dense.ID[store.TKey]] { some(r) }

// derivesParse is whether the name x is a refined type's parse function's
// (ParsePort, parsePort), which bind declares at the type's name: the
// type's own name there is a conversion.
func derivesParse(k Pkg, t Typer, x dense.ID[syntax.Node]) bool {
	let text = types.NameText(k.Parsed[t.file], x)
	strings.HasPrefix(text, "Parse") || strings.HasPrefix(text, "parse")
}

// args types a call's arguments against params (Unsure past them).
func args(s mut store.Store, k Pkg, t mut Typer, c syntax.CallExpr, params []dense.ID[store.TKey]) {
	let tr = tree(k, t.file)
	for i in 0..syntax.Len(c.Args) {
		let a = syntax.Item(tr, c.Args, i)
		if i < params.Len() && syntax.Len(c.Args) == params.Len() {
			let prevWhat = t.what
			t.what = "argument"
			expr(s, k, t, a, Exactly{T: infer.Unmarked(*s, params[i])})
			t.what = prevWhat
		} else {
			expr(s, k, t, a, Unsure)
		}
	}
}

// call types a call: to a function of the package by name (a generic one
// through inference), or to a value of a function type.
func call(s mut store.Store, k Pkg, t mut Typer, x dense.ID[syntax.Node], c syntax.CallExpr) option.Option[dense.ID[store.TKey]] {
	let tr = tree(k, t.file)
	let n = syntax.Len(c.Args)
	let mut fun = unparen(tr, c.Fun)
	let mut written = []dense.ID[syntax.Node]{}
	let mut indexed = false
	if syntax.KindOf(tr, fun) == syntax.KIndexExpr {
		let ix = syntax.IndexExprOf(tr, fun)
		let base = unparen(tr, ix.X)
		if syntax.KindOf(tr, base) == syntax.KIdent || syntax.KindOf(tr, base) == syntax.KSelectorExpr {
			fun = unparen(tr, ix.X)
			indexed = true
			for j in 0..syntax.Len(ix.Indices) {
				written = written.Append(syntax.Item(tr, ix.Indices, j))
			}
		}
	}
	if t.fn >= 0 && syntax.KindOf(tr, fun) == syntax.KIdent && c.Trailing == dense.NoID[syntax.Node]() {
		match dense.Unpack(k.Fns[t.fn].SelfRole) {
		case option.Some{Value: op}:
			if !shadowsMember(k, *t, fun) {
				let name = nameAt(k, *t, fun)
				match roleMember(s, k, op, name, true) {
				case option.Some{Value: selected}:
					if selected.NeedsReceiver {
						t.BareSelfCalls = t.BareSelfCalls.Append(BareSelfCall{File: t.file, At: fun, Name: name})
						return option.None
					}
					let recv = store.TSelf(s, store.OperandsOf(*s, op))
					return callMember(s, k, t, x, c, c.Fun, written, recv, op, selected.Member)
				case option.None:
				}
			}
		case option.None:
		}
	}
	if c.Trailing == dense.NoID[syntax.Node]() && indexed && n == 1 && written.Len() == 1 && isBuiltin(k, *t, fun, "decode") {
		decodeCall(s, k, t, x, written[0])
	}
	if c.Trailing == dense.NoID[syntax.Node]() && !indexed && n == 1 {
		let arg = syntax.Item(tr, c.Args, 0)
		if isBuiltin(k, *t, fun, "len") {
			return lenCall(s, k, t, arg)
		}
		if isBuiltin(k, *t, fun, "hash") {
			expr(s, k, t, arg, Free)
			return some(store.TBasic(s, bUint64))
		}
	}
	// The callee: a function of the package, or of an import (pkg.F).
	let callee = if syntax.KindOf(tr, fun) == syntax.KIdent {
		match bind.ResolutionOf(k.U, k.Ps, pnode(k, t.file, fun)) {
		case bind.Declared as d:
			if isSome(dense.Unpack(dense.Of(t.defs, d.At))) {
				option.None
			} else {
				let i = fnOf(k, t, d.At)
				if i >= 0 { option.Some[Fn]{Value: k.Fns[i]} } else if derivesParse(k, *t, fun) { parseFn(k, d.At) } else { option.None }
			}
		case _:
			option.None
		}
	} else {
		importedFn(s, k, t, selOf(tr, fun))
	}
	match callee {
	case option.Some[Fn] as cf:
		t.Calls = t.Calls.Append(CallTo{Call: pnode(k, t.file, x), Callee: cf.Value, Recv: false})
	case option.None:
	}
	if c.Trailing == dense.NoID[syntax.Node]() && !isSome(callee) && syntax.KindOf(tr, fun) == syntax.KSelectorExpr {
		match valueCall(s, k, t, x, c, fun, written) {
		case option.Some{Value: vr}:
			return option.Some{Value: vr}
		case option.None:
			if !c.TrailingFunc && !indexed {
				match conversionTarget(s, k, *t, unparen(tr, c.Fun)) {
				case option.Some{Value: targetT}:
					if n == 1 {
						let arg = syntax.Item(tr, c.Args, 0)
						let ak = syntax.KindOf(tr, unparen(tr, arg))
						let argW = if ak == syntax.KTupleExpr || (ak == syntax.KCompositeLit && syntax.CompositeLitOf(tr, unparen(tr, arg)).Type == dense.NoID[syntax.Node]()) {
							Exactly{T: targetT}
						} else {
							Free
						}
						let gotT = expr(s, k, t, arg, argW)
						checkConversion(s, k, t, x, targetT, arg, gotT)
					} else {
						args(s, k, t, c, []dense.ID[store.TKey]{})
					}
					return option.None
				case option.None:
				}
			}
			return option.None
		}
	}
	if c.Trailing == dense.NoID[syntax.Node]() && !c.TrailingFunc && !isSome(callee) {
		match conversionTarget(s, k, *t, unparen(tr, c.Fun)) {
		case option.Some{Value: targetT}:
			if n == 1 {
				let arg = syntax.Item(tr, c.Args, 0)
				let ak = syntax.KindOf(tr, unparen(tr, arg))
				let argW = if ak == syntax.KTupleExpr || (ak == syntax.KCompositeLit && syntax.CompositeLitOf(tr, unparen(tr, arg)).Type == dense.NoID[syntax.Node]()) {
					Exactly{T: targetT}
				} else {
					Free
				}
				let gotT = expr(s, k, t, arg, argW)
				checkConversion(s, k, t, x, targetT, arg, gotT)
			} else {
				args(s, k, t, c, []dense.ID[store.TKey]{})
			}
			return option.None
		case option.None:
		}
	}
	if c.Trailing != dense.NoID[syntax.Node]() || !isSome(callee) {
		if c.Trailing == dense.NoID[syntax.Node]() && !indexed {
			match expr(s, k, t, c.Fun, Free) {
			case option.Some[dense.ID[store.TKey]] as ft:
				let f = infer.Unmarked(*s, ft.Value)
				if store.KindOfType(*s, f) == store.KSig {
					let (params, r) = sigParts(*s, k, f, n)
					arity(k, t, x, n, params.Len())
					args(s, k, t, c, params)
					return resultOf(*s, r)
				}
			case option.None:
			}
		}
		args(s, k, t, c, []dense.ID[store.TKey]{})
		// A trailing block's body is walked; the call is not typed.
		match dense.Unpack(c.Trailing) {
		case option.Some[dense.ID[syntax.Node]] as b:
			expr(s, k, t, b.Value, Unsure)
		case option.None:
		}
		return option.None
	}
	let f = match callee {
	case option.Some[Fn] as cf:
		cf.Value
	case option.None:
		return option.None
	}
	if f.Params.Len() == 0 {
		if indexed {
			args(s, k, t, c, []dense.ID[store.TKey]{})
			return option.None
		}
		if !dropsSite(*s, k, f.Sig, n) {
			note(k, t, c.Fun, f.Sig)
		}
		let (params, r) = sigParts(*s, k, f.Sig, n)
		arity(k, t, x, n, params.Len())
		args(s, k, t, c, params)
		return resultOf(*s, r)
	}
	generic(s, k, t, x, c, fun, written, f, option.None)
}

// lenCall types len(a): an int, of a string, a slice, an array or a Map
// (the builtin's callee has no type of its own).
func lenCall(s mut store.Store, k Pkg, t mut Typer, a dense.ID[syntax.Node]) option.Option[dense.ID[store.TKey]] {
	match expr(s, k, t, a, Free) {
	case option.Some[dense.ID[store.TKey]] as at:
		let u = infer.Unmarked(*s, at.Value)
		let kind = store.KindOfType(*s, u)
		if kind == store.KSlice || kind == store.KArray || kind == store.KMap || basic(s, u) == bString {
			some(store.TBasic(s, bInt))
		} else {
			option.None
		}
	case option.None:
		option.None
	}
}

// valueCall types x.f(…) on a value x: a call of the field f when x's
// type has one, else of the function f on x's type (methods.ergo).
func valueCall(s mut store.Store, k Pkg, t mut Typer, x dense.ID[syntax.Node], c syntax.CallExpr, fun dense.ID[syntax.Node], written []dense.ID[syntax.Node]) option.Option[dense.ID[store.TKey]] {
	let tr = tree(k, t.file)
	let n = syntax.Len(c.Args)
	let se = match syntax.ViewOf(tr, fun) {
	case syntax.SelectorExpr as v:
		v
	case _:
		return option.None
	}
	let name = types.NameText(k.Parsed[t.file], se.Sel)
	let mut isOpRecv = false
	let xt = match opReceiver(s, k, t, unparen(tr, se.X)) {
	case option.Some[dense.ID[store.TKey]] as o:
		isOpRecv = true
		note(k, t, se.X, o.Value)
		t.Caps = t.Caps.Append(CapCall{Call: pnode(k, t.file, x), T: o.Value})
		o.Value
	case option.None:
		match expr(s, k, t, se.X, Free) {
		case option.Some[dense.ID[store.TKey]] as v:
			v.Value
		case option.None:
			args(s, k, t, c, []dense.ID[store.TKey]{})
			return option.None
		}
	}
	match roleOf(s, k, *t, xt) {
	case option.Some{Value: op}:
		return roleCall(s, k, t, x, c, fun, written, xt, op, name)
	case option.None:
	}
	if written.Len() != 0 {
		args(s, k, t, c, []dense.ID[store.TKey]{})
		return option.None
	}
	match fieldType(s, k, xt, name, -1) {
	case option.Some[dense.ID[store.TKey]] as ft:
		note(k, t, fun, ft.Value)
		let f = infer.Unmarked(*s, ft.Value)
		if store.KindOfType(*s, f) == store.KSig {
			let (params, r) = sigParts(*s, k, f, n)
			arity(k, t, x, n, params.Len())
			args(s, k, t, c, params)
			return resultOf(*s, r)
		}
		args(s, k, t, c, []dense.ID[store.TKey]{})
		return option.None
	case option.None:
	}
	match methodOf(s, k, t, xt, name) {
	case option.Some[Fn] as mf:
		callMethodFn(s, k, t, x, c, fun, xt, mf.Value)
	case option.None:
		match claimLookup(s, k, *t, xt, name) {
		case ClaimFound as cf:
			if cf.UsedImport != "" {
				t.UsedImports = t.UsedImports.Append(UsedImport{File: t.file, Name: cf.UsedImport})
			}
			callMethodFn(s, k, t, x, c, fun, xt, cf.Fn)
		case ClaimAmbiguous as ca:
			for u in ca.UsedImports {
				t.UsedImports = t.UsedImports.Append(UsedImport{File: t.file, Name: u})
			}
			t.LookupDiags = t.LookupDiags.Append(LookupDiag{File: t.file, At: se.Sel, Code: "S108", Message: ambiguousMethodMessage(*s, k, *t, xt, name, ca.Labels)})
			args(s, k, t, c, []dense.ID[store.TKey]{})
			option.None
		case ClaimNone:
			if !isOpRecv {
				match unknownMethodDiag(*s, k, *t, xt, name) {
				case option.Some{Value: msg}:
					t.LookupDiags = t.LookupDiags.Append(LookupDiag{File: t.file, At: se.Sel, Code: "S104", Message: msg})
				case option.None:
				}
			}
			args(s, k, t, c, []dense.ID[store.TKey]{})
			option.None
		}
	}
}

func callMethodFn(s mut store.Store, k Pkg, t mut Typer, x dense.ID[syntax.Node], c syntax.CallExpr, fun dense.ID[syntax.Node], xt dense.ID[store.TKey], f Fn) option.Option[dense.ID[store.TKey]] {
	let n = syntax.Len(c.Args)
	t.Calls = t.Calls.Append(CallTo{Call: pnode(k, t.file, x), Callee: f, Recv: true})
	if f.Params.Len() > 0 {
		let mut recvT = xt
		let rb = receiverBase(*s, xt)
		let ops = store.OperandsOf(*s, f.Sig)
		if store.KindOfType(*s, rb) == store.KArray && ops.Len() > 3 && store.KindOfType(*s, receiverBase(*s, ops[0])) == store.KSlice {
			recvT = store.TSlice(s, store.OperandsOf(*s, rb)[0])
		}
		return generic(s, k, t, x, c, fun, []dense.ID[syntax.Node]{}, f, some(recvT))
	}
	if !dropsSite(*s, k, f.Sig, n+1) {
		note(k, t, fun, withoutFirst(s, f.Sig))
	}
	let (params, r) = sigParts(*s, k, f.Sig, n+1)
	arity(k, t, x, n+1, params.Len())
	args(s, k, t, c, params[1:params.Len()])
	resultOf(*s, r)
}

func roleOf(s mut store.Store, k Pkg, t Typer, recv dense.ID[store.TKey]) option.Option[dense.ID[store.TKey]] {
	let kind = store.KindOfType(*s, recv)
	if kind == store.KReapplied {
		let ops = store.OperandsOf(*s, recv)
		return option.Some{Value: store.TInstance(s, store.OriginOfType(*s, ops[1]), ops[2:ops.Len()])}
	}
	if t.fn >= 0 {
		let fn = k.Fns[t.fn]
		if kind == store.KParam {
			let at = store.ArgOf(*s, recv)
			if at < fn.SelfBounds.Len() {
				return dense.Unpack(fn.SelfBounds[at].Op)
			}
		}
		if kind == store.KSelf {
			match dense.Unpack(fn.SelfRole) {
			case option.Some{Value: op}:
				let args = store.OperandsOf(*s, recv)
				return option.Some{Value: if args.Len() == 0 { op } else { store.TInstance(s, store.OriginOfType(*s, op), args) }}
			case option.None:
			}
		}
	}
	option.None
}

type RoleSelection { Member types.RoleMember, NeedsReceiver bool }

// roleMember resolves both dot calls and member-law calls through the
// same flattened nominal role. Only the bare spelling can lack a receiver.
func roleMember(s mut store.Store, k Pkg, op dense.ID[store.TKey], name string, bare bool) option.Option[RoleSelection] {
	match types.ReadRole(s, k.Ifaces, k.Foreign, k.Roles, op) {
	case option.Some{Value: role}:
		for m in role.Members {
			if m.Name == name {
				return option.Some{Value: RoleSelection{Member: m, NeedsReceiver: bare && types.ConstraintOnlyRole(role)}}
			}
		}
	case option.None:
	}
	option.None
}

// shadowsMember is whether a local is nearer than the owner's operation
// scope. The binder's directly declared operation is itself marked local;
// only a field of an operation type can be that operation declaration.
func shadowsMember(k Pkg, t Typer, name dense.ID[syntax.Node]) bool {
	match bind.ResolutionOf(k.U, k.Ps, pnode(k, t.file, name)) {
	case bind.Declared as d:
		match bind.DefOf(k.U, d.At) {
		case bind.Local:
			match dense.Unpack(bind.ParentOf(k.Ps, d.At)) {
			case option.Some{Value: decl}:
				match dense.Unpack(bind.ParentOf(k.Ps, decl)) {
				case option.Some{Value: owner}:
					let (file, row) = bind.RowOf(k.Ps, owner)
					let tr = tree(k, file)
					return syntax.KindOf(tr, syntax.NodeAt(tr, row)) != syntax.KInterfaceType
				case option.None:
				}
			case option.None:
			}
			true
		case _:
			false
		}
	case _:
		false
	}
}

func rowSlot(s store.Store, typ dense.ID[store.TKey], slot int) bool {
	let row = store.KindOfType(s, typ) == store.KRow
	for o in store.OperandsOf(s, typ) {
		if row && store.KindOfType(s, o) == store.KParam && store.ArgOf(s, o) == slot || rowSlot(s, o, slot) {
			return true
		}
	}
	false
}

func roleCall(s mut store.Store, k Pkg, t mut Typer, x dense.ID[syntax.Node], c syntax.CallExpr, fun dense.ID[syntax.Node], written []dense.ID[syntax.Node], recv dense.ID[store.TKey], op dense.ID[store.TKey], name string) option.Option[dense.ID[store.TKey]] {
	match roleMember(s, k, op, name, false) {
	case option.Some{Value: selected}:
		callMember(s, k, t, x, c, fun, written, recv, op, selected.Member)
	case option.None:
		args(s, k, t, c, []dense.ID[store.TKey]{})
		option.None
	}
}

func callMember(s mut store.Store, k Pkg, t mut Typer, x dense.ID[syntax.Node], c syntax.CallExpr, fun dense.ID[syntax.Node], written []dense.ID[syntax.Node], recv dense.ID[store.TKey], op dense.ID[store.TKey], m types.RoleMember) option.Option[dense.ID[store.TKey]] {
	let n = syntax.Len(c.Args)
	let tr = tree(k, t.file)
	let actual = store.OperandsOf(*s, op)
	let base = ownParams(k, *t).Len()
	let mut subst = slices.Clone(actual)
	let mut rows = []bool{}
	for i in 0..m.Own.Len() {
		subst = subst.Append(store.TParam(s, base+i))
		rows = rows.Append(rowSlot(*s, m.Sig, actual.Len()+i))
	}
	let sig = store.ReadAbstractSelf(s, m.Sig, subst, recv, op, m.Positions)
	let (params, result) = sigParts(*s, k, sig, n)
	arity(k, t, x, n, params.Len())
	if m.Own.Len() == 0 {
		note(k, t, fun, sig)
		args(s, k, t, c, params)
		return some(result)
	}
	let mut ins = []infer.Arg{}
	for i in 0..n {
		let a = syntax.Item(tr, c.Args, i)
		match expr(s, k, t, a, Free) {
		case option.Some{Value: v}:
			ins = ins.Append(infer.Typed{T: v})
		case option.None:
			ins = ins.Append(infer.Unknown)
		}
	}
	let mut explicit = []dense.ID[store.TKey]{}
	let env = envOf(*s, k, *t)
	for node in written {
		explicit = explicit.Append(types.Resolve(s, env, node))
	}
	match infer.Infer(s, &t.frame, k.Unions, infer.Callee{Params: params, Rows: rows, Base: base}, explicit, ins) {
	case option.Some{Value: bindings}:
		let mut binding = []dense.ID[store.TKey]{}
		for i in 0..base {
			binding = binding.Append(store.TParam(s, i))
		}
		return some(store.TSubst(s, result, binding.Concat(bindings)))
	case option.None:
		return option.None
	}
}

// generic infers a call's type arguments from its typed arguments, then
// types its constant arguments with the instantiated parameters. A call
// x.f(…) of a function on x's type passes recv, x's type, as the first
// argument; the selector's type is then the instance without its first
// parameter.
func generic(s mut store.Store, k Pkg, t mut Typer, x dense.ID[syntax.Node], c syntax.CallExpr, fun dense.ID[syntax.Node], written []dense.ID[syntax.Node], f Fn, recv option.Option[dense.ID[store.TKey]]) option.Option[dense.ID[store.TKey]] {
	let tr = tree(k, t.file)
	let n = syntax.Len(c.Args)
	let m = if isSome(recv) { 1 } else { 0 }
	let (params, r) = sigParts(*s, k, f.Sig, n+m)
	arity(k, t, x, n+m, params.Len())
	let mine = ownParams(k, *t)
	let base = mine.Len()
	let mut rename = []dense.ID[store.TKey]{}
	for i in 0..f.Params.Len() {
		rename = rename.Append(store.TParam(s, base+i))
	}
	let mut renamed = []dense.ID[store.TKey]{}
	for p in params {
		renamed = renamed.Append(store.TSubst(s, p, rename))
	}
	let env = types.NewEnv(*s, k.Parsed, k.Parsed[t.file], mine, k.Kinds, k.Ext, k.Foreign, k.Ifaces)
	let frame = infer.Begin(&t.frame, f.Rows, base)
	let all = written.Len() == f.Rows.Len()
	let mut ok = n+m == params.Len() && written.Len() <= f.Rows.Len()
	if ok {
		for i, w in written {
			infer.Bind(&t.frame, frame, i, types.Resolve(s, env, w))
		}
	}
	let mut ins = []infer.Arg{}
	let mut argOk = []bool{}
	let mut argTypes = []dense.ID[store.TKey]{}
	let mut deferredLits = []int{}
	match recv {
	case option.Some[dense.ID[store.TKey]] as rt:
		argTypes = argTypes.Append(rt.Value)
		if ok {
			let p0 = if store.KindOfType(*s, renamed[0]) == store.KPointer || store.KindOfType(*s, rt.Value) == store.KPointer { receiverBase(*s, renamed[0]) } else { renamed[0] }
			let a0 = if store.KindOfType(*s, renamed[0]) == store.KPointer || store.KindOfType(*s, rt.Value) == store.KPointer { receiverBase(*s, rt.Value) } else { rt.Value }
			ok = infer.Argument(s, &t.frame, k.Unions, frame, p0, a0, all)
		}
		ins = ins.Append(infer.Unknown)
	case option.None:
	}
	for i in 0..n {
		let a = syntax.Item(tr, c.Args, i)
		if isConst(k, t.file, a) {
			match constType(s, k, *t, a, Free) {
			case option.Some[dense.ID[store.TKey]] as d:
				ins = ins.Append(infer.Literal{Default: d.Value})
				argOk = argOk.Append(true)
			case option.None:
				ins = ins.Append(infer.Unknown)
				argOk = argOk.Append(false)
				ok = false
			}
			continue
		}
		let want = if ok {
			match infer.Expected(s, t.frame, frame, renamed[i+m]) {
			case option.Some{Value: p}:
				Exactly{T: infer.Unmarked(*s, p)}
			case option.None:
				Free
			}
		} else {
			Free
		}
		let prevWhat = t.what
		t.what = "argument"
		let isLitArg = hasOmittedFuncParams(tr, unparen(tr, a)) && isFree(want)
		let prevDefer = t.deferLitDiag
		if isLitArg {
			t.deferLitDiag = true
		}
		let atRes = expr(s, k, t, a, want)
		t.deferLitDiag = prevDefer
		t.what = prevWhat
		match atRes {
		case option.Some[dense.ID[store.TKey]] as at:
			argOk = argOk.Append(true)
			argTypes = argTypes.Append(at.Value)
			if ok {
				ok = infer.Argument(s, &t.frame, k.Unions, frame, renamed[i+m], at.Value, all)
			}
		case option.None:
			if isLitArg {
				argOk = argOk.Append(true)
				deferredLits = deferredLits.Append(i)
			} else {
				argOk = argOk.Append(false)
				ok = false
			}
		}
		ins = ins.Append(infer.Unknown)
	}
	let mut unbound = -1
	let inferred = if ok { infer.Finish(s, &t.frame, frame, renamed, ins, all, &unbound) } else { option.None }
	infer.End(&t.frame, frame)
	match inferred {
	case option.Some[[]dense.ID[store.TKey]] as targs:
		checkCallConstraints(s, k, t, unparen(tr, c.Fun), f, targs.Value)
		// An import's function is named by its selector's name.
		let named = match syntax.ViewOf(tr, fun) {
		case syntax.SelectorExpr as se:
			se.Sel
		case _:
			fun
		}
		t.Insts = t.Insts.Append(Inst{At: pnode(k, t.file, named), Args: targs.Value, Fn: t.fn, Call: pnode(k, t.file, x), Callee: f})
		let inst = store.TSubst(s, f.Sig, targs.Value)
		// The callee records the instance: the name when inferred, the
		// index expression when written.
		if !dropsSite(*s, k, f.Sig, n+m) && !hasWired(*s, inst) && !funcArg(*s, targs.Value) {
			let shown = if m == 1 { withoutFirst(s, inst) } else { inst }
			note(k, t, if written.Len() > 0 { unparen(tr, c.Fun) } else { fun }, shown)
		}
		for li in deferredLits {
			if li+m < params.Len() {
				let a = syntax.Item(tr, c.Args, li)
				let p = store.TSubst(s, params[li+m], targs.Value)
				let prevWhat = t.what
				t.what = "argument"
				expr(s, k, t, a, Exactly{T: infer.Unmarked(*s, p)})
				t.what = prevWhat
			}
		}
		for i in 0..n {
			let a = syntax.Item(tr, c.Args, i)
			if isConst(k, t.file, a) && i+m < params.Len() {
				// The substitution writes the pool, so it runs before the
				// store is read: read after, the store is not copied.
				let p = store.TSubst(s, params[i+m], targs.Value)
				let prevWhat = t.what
				t.what = "argument"
				expr(s, k, t, a, Exactly{T: infer.Unmarked(*s, p)})
				t.what = prevWhat
			}
		}
		let res = store.TSubst(s, r, targs.Value)
		resultOf(*s, res)
	case option.None:
		if unbound < 0 {
			let prevDefer = t.deferLitDiag
			t.deferLitDiag = true
			for li in deferredLits {
				expr(s, k, t, syntax.Item(tr, c.Args, li), Free)
			}
			t.deferLitDiag = prevDefer
			if ok {
				let conflictSlot = litConflictSlot(*s, renamed, ins, base)
				if conflictSlot >= 0 {
					checkInferFailure(s, k, t, x, c, fun, written, f, conflictSlot, ins, argOk, argTypes)
				}
			}
		}
		if unbound >= 0 && unbound < f.SelfBounds.Len() && f.SelfBounds[unbound].Arity >= 0 {
			let p = k.Parsed[t.file]
			let mut placeholders = []string{}
			for _ in f.Params {
				placeholders = placeholders.Append("int")
			}
			let name = types.NameText(p, fun)
			t.SelfInference = t.SelfInference.Append(SelfInference{File: t.file, At: x, Param: f.Params[unbound], Example: "\(name)[\(strings.Join(placeholders, ", "))](…)"})
		} else if unbound >= 0 {
			checkInferFailure(s, k, t, x, c, fun, written, f, unbound, ins, argOk, argTypes)
		}
		for i in 0..n {
			let a = syntax.Item(tr, c.Args, i)
			if isConst(k, t.file, a) {
				expr(s, k, t, a, Unsure)
			}
		}
		option.None
	}
}

// recordOf is the record a type names, with its type arguments: a local
// record, generic or not.
func recordOf(s store.Store, k Pkg, ty dense.ID[store.TKey]) (int, []dense.ID[store.TKey]) {
	let kind = store.KindOfType(s, ty)
	if kind == store.KNamed {
		return (recOf(s, k, store.TypeNameText(s, store.ArgOf(s, ty))), []dense.ID[store.TKey]{})
	}
	if kind == store.KInstance {
		let o = store.OriginOfType(s, ty)
		if int(o.Import) == 0 {
			return (recOf(s, k, store.DeclText(s, int(o.Decl))), store.OperandsOf(s, ty))
		}
	}
	(-1, []dense.ID[store.TKey]{})
}

func fieldType(s mut store.Store, k Pkg, ty dense.ID[store.TKey], name string, at int) option.Option[dense.ID[store.TKey]] {
	// A field of *T is T's (Go's selector dereferences).
	if store.KindOfType(*s, ty) == store.KPointer {
		return fieldType(s, k, store.OperandsOf(*s, ty)[0], name, at)
	}
	let (r, targs) = recordOf(*s, k, ty)
	if r < 0 {
		return importedField(s, k, ty, name, at)
	}
	if targs.Len() != k.Recs[r].Params.Len() {
		return option.None
	}
	for j, fd in k.Recs[r].Fields {
		if at < 0 && fd.Name == name || j == at {
			return some(store.TSubst(s, fd.T, targs))
		}
	}
	option.None
}

// elided is the type of the bare generic name x where w expects a type
// (types.Elided), or none.
func elided(s mut store.Store, k Pkg, t Typer, x dense.ID[syntax.Node], w Want) option.Option[dense.ID[store.TKey]] {
	match w {
	case Exactly as e:
		elidedIn(s, k, t, x, e.T)
	case _:
		option.None
	}
}

// elidedIn is the type of the bare generic name x in the context ctx: a
// literal's expected type or a pattern's subject.
func elidedIn(s mut store.Store, k Pkg, t Typer, x dense.ID[syntax.Node], ctx dense.ID[store.TKey]) option.Option[dense.ID[store.TKey]] {
	let kd = syntax.KindOf(tree(k, t.file), x)
	if kd != syntax.KIdent && kd != syntax.KSelectorExpr {
		return option.None
	}
	match types.Elided(s, envOf(*s, k, t), x, infer.Unmarked(*s, ctx)) {
	case option.Some{Value: r}:
		if valid(*s, r) { some(r) } else { option.None }
	case option.None:
		option.None
	}
}

// BareLit is a generic literal written without its type arguments: the type
// it names, and its elements' values with their fields' types in terms
// of its type parameters.
type BareLit { b types.Bare, values []dense.ID[syntax.Node], fields []dense.ID[store.TKey] }

// inferable is the literal cl of the bare generic name tx when its
// elements' values can bind its type arguments: each element keys a
// field of the type by name. It types nothing.
func inferable(s mut store.Store, k Pkg, t Typer, cl syntax.CompositeLit, tx dense.ID[syntax.Node]) option.Option[BareLit] {
	let tr = tree(k, t.file)
	let kd = syntax.KindOf(tr, tx)
	if kd != syntax.KIdent && kd != syntax.KSelectorExpr {
		return option.None
	}
	let b = match types.BareOf(*s, envOf(*s, k, t), tx) {
	case option.Some{Value: b}:
		b
	case option.None:
		return option.None
	}
	let mut params = []dense.ID[store.TKey]{}
	for i in 0..b.Rows.Len() {
		params = params.Append(store.TParam(s, i))
	}
	let gen = store.TInstance(s, b.Ref, params)
	let p = k.Parsed[t.file]
	let names = match fieldNames(*s, k, gen) {
	case option.Some{Value: ns}:
		ns
	case option.None:
		return option.None
	}
	let mut values = []dense.ID[syntax.Node]{}
	let mut fields = []dense.ID[store.TKey]{}
	for i in 0..syntax.Len(cl.Elts) {
		let el = syntax.Item(tr, cl.Elts, i)
		// A keyed element names its field; a positional one is the
		// field at its place.
		let (name, value) = match syntax.ViewOf(tr, el) {
		case syntax.KeyValueExpr as kv:
			if syntax.KindOf(tr, kv.Key) != syntax.KIdent {
				return option.None
			}
			(types.NameText(p, kv.Key), kv.Value)
		case _:
			if i >= names.Len() {
				return option.None
			}
			(names[i], el)
		}
		match fieldType(s, k, gen, name, -1) {
		case option.Some{Value: ft}:
			values = values.Append(value)
			fields = fields.Append(ft)
		case option.None:
			return option.None
		}
	}
	option.Some{Value: BareLit{b: b, values: values, fields: fields}}
}

// inferred types the bare generic literal g where no expected type fixes
// its type arguments: its values bind them as a call's arguments bind a
// generic function's (infer.Infer; the Go checker's literal inference,
// 196u rule 6). It types each value once, as generic does a call's.
func inferred(s mut store.Store, k Pkg, t mut Typer, g BareLit) option.Option[dense.ID[store.TKey]] {
	let base = k.Fns[t.fn].Params.Len()
	let mut rename = []dense.ID[store.TKey]{}
	for i in 0..g.b.Rows.Len() {
		rename = rename.Append(store.TParam(s, base+i))
	}
	let mut renamed = []dense.ID[store.TKey]{}
	for f in g.fields {
		renamed = renamed.Append(store.TSubst(s, f, rename))
	}
	let mut ins = []infer.Arg{}
	for v in g.values {
		if isConst(k, t.file, v) {
			match constType(s, k, *t, v, Free) {
			case option.Some{Value: d}:
				ins = ins.Append(infer.Literal{Default: d})
			case option.None:
				ins = ins.Append(infer.Unknown)
			}
			continue
		}
		match expr(s, k, t, v, Free) {
		case option.Some{Value: vt}:
			ins = ins.Append(infer.Typed{T: vt})
		case option.None:
			ins = ins.Append(infer.Unknown)
		}
	}
	match infer.Infer(s, &t.frame, k.Unions, infer.Callee{Params: renamed, Rows: g.b.Rows, Base: base}, []dense.ID[store.TKey]{}, ins) {
	case option.Some{Value: targs}:
		for i, v in g.values {
			if isConst(k, t.file, v) {
				let ft = store.TSubst(s, g.fields[i], targs)
				expr(s, k, t, v, Exactly{T: infer.Unmarked(*s, ft)})
			}
		}
		let r = store.TInstance(s, g.b.Ref, targs)
		if valid(*s, r) { some(r) } else { option.None }
	case option.None:
		for v in g.values {
			if isConst(k, t.file, v) {
				expr(s, k, t, v, Unsure)
			}
		}
		option.None
	}
}

// composite types T{…}: T as written, or, for a generic record or
// variant written without its type arguments, the type its expected type
// fixes (types.Elided); a record's fields, a slice's elements and a map's
// entries take their types.
func composite(s mut store.Store, k Pkg, t mut Typer, cl syntax.CompositeLit, w Want) option.Option[dense.ID[store.TKey]] {
	let tr = tree(k, t.file)
	let p = k.Parsed[t.file]
	match dense.Unpack(cl.Base) {
	case option.Some[dense.ID[syntax.Node]] as b:
		expr(s, k, t, b.Value, Free)
	case option.None:
	}
	let ty = match dense.Unpack(cl.Type) {
	case option.Some{Value: tx}:
		let r = types.Resolve(s, envOf(*s, k, *t), tx)
		if valid(*s, r) {
			some(r)
		} else {
			match elided(s, k, *t, tx, w) {
			case option.Some{Value: e}:
				some(e)
			case option.None:
				// Only where nothing is expected: an expectation the typer
				// does not read (Unsure) would fix the arguments instead.
				match w {
				case Free:
					match inferable(s, k, *t, cl, tx) {
					case option.Some{Value: g}:
						return inferred(s, k, t, g)
					case option.None:
					}
				case _:
				}
				option.None
			}
		}
	case option.None:
		option.None
	}
	for i in 0..syntax.Len(cl.Elts) {
		let e = syntax.Item(tr, cl.Elts, i)
		let mut done = false
		match ty {
		case option.Some[dense.ID[store.TKey]] as rt:
			let kind = store.KindOfType(*s, rt.Value)
			match syntax.ViewOf(tr, e) {
			case syntax.KeyValueExpr as kv:
				if kind == store.KMap {
					let ops = store.OperandsOf(*s, rt.Value)
					let prevWhat = t.what
					t.what = "map key"
					expr(s, k, t, kv.Key, Exactly{T: ops[0]})
					t.what = "map value"
					expr(s, k, t, kv.Value, Exactly{T: ops[1]})
					t.what = prevWhat
					done = true
				} else if syntax.KindOf(tr, kv.Key) == syntax.KIdent {
					match fieldType(s, k, rt.Value, types.NameText(p, kv.Key), -1) {
					case option.Some[dense.ID[store.TKey]] as ft:
						let prevWhat = t.what
						t.what = "field " + types.NameText(p, kv.Key)
						expr(s, k, t, kv.Value, Exactly{T: infer.Unmarked(*s, ft.Value)})
						t.what = prevWhat
						done = true
					case option.None:
						unread(*s, k, t, rt.Value, kv.Value)
					}
				}
			case _:
				if kind == store.KSlice || kind == store.KArray {
					let ops = store.OperandsOf(*s, rt.Value)
					let prevWhat = t.what
					t.what = "element"
					expr(s, k, t, e, Exactly{T: ops[ops.Len()-1]})
					t.what = prevWhat
					done = true
				} else {
					// A record's values written in order take its fields'
					// types (Some{v}).
					match fieldType(s, k, rt.Value, "", i) {
					case option.Some{Value: ft}:
						let prevWhat = t.what
						t.what = "field"
						expr(s, k, t, e, Exactly{T: infer.Unmarked(*s, ft)})
						t.what = prevWhat
						done = true
					case option.None:
						unread(*s, k, t, rt.Value, e)
					}
				}
			}
		case option.None:
		}
		if !done {
			let prevLit = t.deferLitDiag
			match ty {
			case option.Some{Value: ct}:
				if outsideRec(*s, k, ct) || hasInvalidT(*s, ct, 0) {
					t.deferLitDiag = true
				}
			case option.None:
				t.deferLitDiag = true
			}
			match syntax.ViewOf(tr, e) {
			case syntax.KeyValueExpr as kv:
				expr(s, k, t, kv.Value, Unsure)
			case _:
				expr(s, k, t, e, Unsure)
			}
			t.deferLitDiag = prevLit
		}
	}
	ty
}

// unread records the value x of a literal of the record type ty when ty
// is an outside import's, whose field types the typer cannot read.
func unread(s store.Store, k Pkg, t mut Typer, ty dense.ID[store.TKey], x dense.ID[syntax.Node]) {
	if outsideRec(s, k, ty) {
		t.Outside = t.Outside.Append(pnode(k, t.file, x))
	}
}

// selOf is the name of the selector x, or none when x is no selector.
func selOf(tr syntax.Tree, x dense.ID[syntax.Node]) dense.Opt[syntax.Node] {
	if syntax.KindOf(tr, x) == syntax.KSelectorExpr { dense.OptOf(syntax.SelectorExprOf(tr, x).Sel) } else { dense.NoID[syntax.Node]() }
}

// selector types x.F: a function of an import, or a field of a record of
// the package or of an import.
func selector(s mut store.Store, k Pkg, t mut Typer, se syntax.SelectorExpr) option.Option[dense.ID[store.TKey]] {
	match importedFn(s, k, t, dense.OptOf(se.Sel)) {
	case option.Some[Fn] as f:
		return if f.Value.Params.Len() == 0 { some(f.Value.Sig) } else { option.None }
	case option.None:
	}
	match importedBare(s, k, t, se.Sel) {
	case option.Some[dense.ID[store.TKey]] as b:
		return some(b.Value)
	case option.None:
	}
	match expr(s, k, t, se.X, Free) {
	case option.Some[dense.ID[store.TKey]] as xt:
		fieldType(s, k, xt.Value, types.NameText(k.Parsed[t.file], se.Sel), -1)
	case option.None:
		option.None
	}
}
