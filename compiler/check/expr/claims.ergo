// Implements clauses, resolved at the claimant's own parameters.
import compiler/check/store
import compiler/check/types
import compiler/syntax
import dense

type Claim { File int, At dense.ID[syntax.Node], T dense.ID[store.TKey] }

func bracketList(p syntax.Parsed, l dense.Opt[syntax.Node]) []string {
	let mut out = []string{}
	for b in types.Brackets(p, l) {
		out = out.Append(b.Name)
	}
	out
}

func claimsOf(s mut store.Store, parsed []syntax.Parsed, kinds types.Kinds, ext []types.Ext, foreign []types.Foreign, deps []types.Iface, roles []types.Role) []Claim {
	let mut claims = []Claim{}
	for file, p in parsed {
		if p.Failed { continue }
		match syntax.ViewOf(p.Tree, syntax.Root(p.Tree)) {
		case syntax.File as root:
			for i in 0..syntax.Len(root.Decls) {
				match syntax.ViewOf(p.Tree, syntax.Item(p.Tree, root.Decls, i)) {
				case syntax.TypeDecl as td:
					if syntax.Len(td.Implements) == 0 { continue }
					let params = bracketList(p, td.TypeParams)
					let env = types.NewEnv(*s, parsed, p, params, kinds, ext, foreign, deps)
					for j in 0..syntax.Len(td.Implements) {
						let x = syntax.Item(p.Tree, td.Implements, j)
						let op = types.Resolve(s, env, x)
						claims = claims.Append(Claim{File: file, At: x, T: op})
						match store.Lookup(*s, types.NameText(p, td.Name)) {
						case Some{Value: decl}:
							let claimant = store.XRef{Import: uint32(0), Decl: uint32(dense.Index(decl))}
							for lay in types.LayoutsOf(s, roles, deps, foreign, op, len(params)) {
								store.AddClaimLayout(s, claimant, lay)
							}
						case None:
						}
					}
				case _:
				}
			}
		case _:
		}
	}
	claims
}
