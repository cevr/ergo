// Members of the package's imports (S3d2): a function or a record field
// another package of the program declares, typed from that package's own
// store and signatures, then ported into this package's pool.

import compiler/check/bind
import compiler/check/store
import compiler/check/types
import compiler/syntax
import dense
import option

// Dep is an imported package as typing reads it: its import path, its
// bound store (whose interface the importer's binding read, frozen) and
// what Load made of it, its functions' signatures and its records' fields
// in its own pool.
type Dep { Path string, S store.Store, K Pkg }

// WithDeps is k reading deps, the program's imported packages, by path:
// an import the list does not hold has no members to type.
func WithDeps(k Pkg, deps []Dep) Pkg { Pkg{..k, Deps: deps} }

// depOf is the index in k.Deps of the package at path, -1 when none is.
func depOf(k Pkg, path string) int {
	for i, d in k.Deps {
		if d.Path == path {
			return i
		}
	}
	-1
}

// foreignAt is the index in k's foreign table of the type name declares
// in the package at path (the prelude, the universe or a Go import), -1
// when the table does not hold it.
func foreignAt(k Pkg, path string, name string) int {
	for i, f in k.Foreign {
		if f.Path == path && f.Name == name {
			return i
		}
	}
	-1
}

// imported is the type of s's pool that names the type name of the
// package at path, with args: for an Ergo import of k's, an instance
// whose origin is k's reference into its interface (types.ImportRef);
// for the prelude, k's foreign type of the name (the prelude's types are
// the foreign table's, as the Go side writes them). None when k can name
// no such type.
func imported(s mut store.Store, k Pkg, path string, name string, args []dense.ID[store.TKey]) option.Option[dense.ID[store.TKey]] {
	match types.ImportRef(*s, k.Ifaces, path, name) {
	case option.Some[store.XRef] as ref:
		return some(store.TInstance(s, ref.Value, args))
	case option.None:
	}
	if args.Len() > 0 {
		let f = foreignAt(k, path, name)
		return if f >= 0 { some(store.TInstance(s, store.XRef{Import: uint32(store.ForeignBit), Decl: uint32(f)}, args)) } else { option.None }
	}
	let f = foreignAt(k, path, name)
	if f >= 0 { some(store.TForeign(s, f)) } else { option.None }
}

// port is the type dt of the dependency d's pool as a type of s's pool:
// a type d declares, or reads from one of its Ergo imports, is k's
// reference into that package's interface (imported); one d reads from
// its foreign table is k's foreign type of the same package and name. It
// is none when k cannot name such a type, or dt holds a form a signature
// of k's own cannot (a wired or row value): the member is then left
// untyped.
func port(s mut store.Store, k Pkg, d Dep, dt dense.ID[store.TKey]) option.Option[dense.ID[store.TKey]] {
	types.Port(s, k.Ifaces, k.Foreign, d.S, d.Path, func(ref store.XRef) option.Option[types.DeclIdentity] { types.DepIdentity(d.K.Ifaces, ref) }, d.K.Foreign, dt)
}

// importedFn is the function the selector's name sel names in an import,
// its signature ported into s's pool; none when sel names no function of
// a package k.Deps holds, or its signature does not port.
func importedFn(s mut store.Store, k Pkg, t mut Typer, name dense.Opt[syntax.Node]) option.Option[Fn] {
	let sel = match dense.Unpack(name) {
	case option.Some[dense.ID[syntax.Node]] as n:
		n.Value
	case option.None:
		return option.None
	}
	if k.Deps.Len() == 0 {
		return option.None
	}
	match bind.ResolutionOf(k.U, k.Ps, pnode(k, t.file, sel)) {
	case bind.Imported as im:
		let i = int(im.Ref.Import) - 1
		let paths = store.ImportPaths(*s)
		if i < 0 || i >= paths.Len() {
			return option.None
		}
		let di = depOf(k, paths[i])
		if di < 0 {
			return option.None
		}
		let d = k.Deps[di]
		let decl = store.DeclOf(d.S, store.DeclAt(d.S, int(im.Ref.Decl)))
		t.steps = t.steps + 1
		let at = bind.PNodeOf(d.K.Ps, int(decl.File), syntax.NodeAt(d.K.Parsed[int(decl.File)].Tree, int(decl.Node)))
		let f = FnAt(d.K, at)
		let fn = if f >= 0 {
			d.K.Fns[f]
		} else if store.KindName(int(decl.Kind)) == "func" {
			// A refined type's parse function (config.ParsePort).
			match parseFn(d.K, at) {
			case option.Some[Fn] as pf:
				pf.Value
			case option.None:
				return option.None
			}
		} else {
			return option.None
		}
		match port(s, k, d, fn.Sig) {
		case option.Some[dense.ID[store.TKey]] as sig:
			let mut out = fn
			out.Sig = sig.Value
			out.fromDep = di
			let mut bounds = []types.SelfBound{}
			for bound in fn.SelfBounds {
				match dense.Unpack(bound.Op) {
				case option.Some{Value: op}:
					match port(s, k, d, op) {
					case option.Some{Value: rebased}:
						bounds = bounds.Append(types.SelfBound{..bound, Op: dense.OptOf(rebased)})
					case option.None:
						return option.None
					}
				case option.None:
					bounds = bounds.Append(bound)
				}
			}
			out.SelfBounds = bounds
			option.Some[Fn]{Value: out}
		case option.None:
			option.None
		}
	case _:
		option.None
	}
}

// fieldNames is the field names, in order, of the record ty instantiates:
// of the package or of an import; none when ty is no record either knows.
func fieldNames(s store.Store, k Pkg, ty dense.ID[store.TKey]) option.Option[[]string] {
	let (r, _) = recordOf(s, k, ty)
	if r >= 0 {
		return option.Some{Value: namesOf(k.Recs[r].Fields)}
	}
	let kind = store.KindOfType(s, ty)
	let f = if kind == store.KInstance && int(store.OriginOfType(s, ty).Import) == store.ForeignBit { int(store.OriginOfType(s, ty).Decl) } else { -1 }
	if f < 0 || f >= k.Foreign.Len() {
		return option.None
	}
	let di = depOf(k, k.Foreign[f].Path)
	if di < 0 {
		return option.None
	}
	let d = k.Deps[di]
	let dr = recOf(d.S, d.K, k.Foreign[f].Name)
	if dr < 0 {
		return option.None
	}
	option.Some{Value: namesOf(d.K.Recs[dr].Fields)}
}

func namesOf(fs []Field) []string {
	let mut out = []string{}
	for f in fs {
		out = out.Append(f.Name)
	}
	out
}

// importedRec is the import path, name and type arguments of the type
// ty an import declares (an XRef into its interface, generic or not; or
// a prelude type of the foreign table); an empty name for any other type.
func importedRec(s store.Store, k Pkg, ty dense.ID[store.TKey]) (string, string, []dense.ID[store.TKey]) {
	let kind = store.KindOfType(s, ty)
	let o = store.OriginOfType(s, ty)
	if kind == store.KForeign && store.ArgOf(s, ty) < k.Foreign.Len() {
		let f = k.Foreign[store.ArgOf(s, ty)]
		(f.Path, f.Name, []dense.ID[store.TKey]{})
	} else if kind == store.KInstance && int(o.Import) == store.ForeignBit && int(o.Decl) < k.Foreign.Len() {
		let f = k.Foreign[int(o.Decl)]
		(f.Path, f.Name, store.OperandsOf(s, ty))
	} else if kind == store.KInstance && int(o.Import) > 0 && int(o.Import) <= k.Ifaces.Len() {
		let dep = k.Ifaces[int(o.Import)-1]
		(dep.Path, dep.Decls[int(o.Decl)].Name, store.OperandsOf(s, ty))
	} else {
		("", "", []dense.ID[store.TKey]{})
	}
}

// ImportedRec is importedRec for the passes after typing (diag's
// resources of an imported type).
func ImportedRec(s store.Store, k Pkg, ty dense.ID[store.TKey]) (string, string, []dense.ID[store.TKey]) { importedRec(s, k, ty) }

// outsideRec is whether ty is a type of an import k holds only as its
// interface (a package outside the run, whose fields it cannot read).
func outsideRec(s store.Store, k Pkg, ty dense.ID[store.TKey]) bool {
	let (path, rec, _) = importedRec(s, k, ty)
	rec != "" && depOf(k, path) < 0
}

// importedField is the type of field name (the at-th field when at is
// not negative) of the record type ty an import declares (importedRec)
// ported into s's pool with ty's type arguments in place; none when no
// package of k.Deps declares it.
func importedField(s mut store.Store, k Pkg, ty dense.ID[store.TKey], name string, at int) option.Option[dense.ID[store.TKey]] {
	let (path, rec, targs) = importedRec(*s, k, ty)
	if rec == "" {
		return option.None
	}
	let di = depOf(k, path)
	if di < 0 {
		return option.None
	}
	let d = k.Deps[di]
	let r = recOf(d.S, d.K, rec)
	if r < 0 || targs.Len() != d.K.Recs[r].Params.Len() {
		return option.None
	}
	for j, fd in d.K.Recs[r].Fields {
		if at < 0 && fd.Name == name || j == at {
			return match port(s, k, d, fd.T) {
			case option.Some[dense.ID[store.TKey]] as p:
				let u = store.TSubst(s, p.Value, targs)
				some(u)
			case option.None:
				option.None
			}
		}
	}
	option.None
}
