// Package types resolves the type expressions of one package's
// declarations on its store (capstone S3t; selfhost/S3t/plan.md). This
// file solves the kinds of the bracket parameters of the package's generic
// type declarations, as the Go checker's solveDeclKinds (kinds.go) does:
// a parameter's kind follows its positions, and a parameter that is the
// argument of a local generic type has that type's parameter's kind, so
// the kinds of all the declarations are one system of equalities, solved
// by union-find.

import compiler/check/bind
import compiler/check/store
import compiler/syntax
import dense
import option
import slices
import strings

// The kinds, as bits of a position set.
let kindType = 1
let kindErrors = 2
let kindUses = 4

// KindConflict is the solved kind of a parameter whose positions disagree
// (S108 where the declaration resolves).
let KindConflict = 8

// Ext is the parameter kinds of a generic type that is not the package's
// own, a prelude type (Option) or an imported one (task.Task), by its head
// as written. It stands in for the frozen interfaces of S3c.
type Ext { Head string, Kinds []int }

// gen is one generic type declaration of the package, in collect order:
// its file, its name row, its bracket parameter names, whether its body is
// an operation type, and the first variable of the system it owns.
type gen { file int, name dense.ID[syntax.Node], body dense.ID[syntax.Node], params []string, typed []bool, ops bool, base int }

// solver is the union-find of the kind system: a variable per bracket
// parameter, the positions seen at each root, and the steps its finds
// took (the counted guard KindSolveWorkIsNearLinear reads).
type solver { parent []int, seen []int, steps int }

// find is v's root, halving the path it walks.
func find(s mut solver, v int) int {
	let mut r = v
	for s.parent[r] != r {
		s.parent[r] = s.parent[s.parent[r]]
		r = s.parent[r]
		s.steps = s.steps + 1
	}
	r
}

func observe(s mut solver, v int, k int) {
	let r = find(s, v)
	s.seen[r] = s.seen[r] | k
}

func union(s mut solver, a int, b int) {
	let ra = find(s, a)
	let rb = find(s, b)
	if ra == rb {
		return
	}
	s.parent[ra] = rb
	s.seen[rb] = s.seen[rb] | s.seen[ra]
	s.seen[ra] = 0
}

// solve is the state of one package's solve, or of one function's (fn):
// a function's parameters link to no declaration's, they take the slot
// kinds local holds (kindBracketParams).
// genAt indexes gens by declaration (genSide).
type solve { s store.Store, gens []gen, genAt dense.Side[store.Decl, int], ext []Ext, sv solver, ownMap bool, fn bool, local Kinds }

// walker names the variables a walk observes: names[i] is variable
// vars[i] in file p.
type walker { p syntax.Parsed, names []string, vars []int }

func nameText(p syntax.Parsed, id dense.ID[syntax.Node]) string {
	if syntax.KindOf(p.Tree, id) == syntax.KIdent { syntax.TokText(p, syntax.NameOf(p.Tree, id).Tok) } else { "" }
}

// self is the variable a bare name x stands for in w, or -1.
func self(w walker, x dense.ID[syntax.Node]) int {
	let t = nameText(w.p, unparen(w.p, x))
	if t == "" {
		return -1
	}
	for i, n in w.names {
		if n == t {
			return w.vars[i]
		}
	}
	-1
}

func unparen(p syntax.Parsed, x dense.ID[syntax.Node]) dense.ID[syntax.Node] {
	if syntax.KindOf(p.Tree, x) == syntax.KParenExpr { unparen(p, syntax.ParenExprOf(p.Tree, x).X) } else { x }
}

// localGen is the index in gens of the package's own generic type the
// head x names, or -1. A head is a bare name the package scope gives a
// type declaration; a selector names another package's.
func localGen(st solve, p syntax.Parsed, x dense.ID[syntax.Node]) int {
	let t = nameText(p, x)
	if t == "" {
		return -1
	}
	match store.Lookup(st.s, t) {
	case option.Some[dense.ID[store.Decl]] as d:
		let row = store.DeclOf(st.s, d.Value)
		if store.KindName(int(row.Kind)) != "type" {
			return -1
		}
		dense.SideOf(st.genAt, d.Value)
	case option.None:
		-1
	}
}

// slotKinds is the parameter kinds of a generic type the head x names
// that is not the package's own: from ext, by the head's text. A name the
// package scope holds is the package's (a local type has no entry here).
func slotKinds(st solve, p syntax.Parsed, x dense.ID[syntax.Node]) []int {
	let mut head = ""
	let kind = syntax.KindOf(p.Tree, x)
	if kind == syntax.KIdent {
		let t = syntax.TokText(p, syntax.NameOf(p.Tree, x).Tok)
		match store.Lookup(st.s, t) {
		case option.Some[dense.ID[store.Decl]]:
			// A function reads a local type's kinds as solved, before the
			// constraints (slotKinds reads declKinds), a conflict as a
			// type.
			if st.fn {
				let mut out = []int{}
				for k in rawKinds(st.s, st.local, t) {
					out = out.Append(if k == KindConflict { kindType } else { k })
				}
				return out
			}
			return []int{}
		case option.None:
			head = t
		}
	} else if kind == syntax.KSelectorExpr {
		let se = syntax.SelectorExprOf(p.Tree, x)
		let q = nameText(p, se.X)
		match store.Lookup(st.s, q) {
		case option.Some[dense.ID[store.Decl]] as d:
			if store.KindName(int(store.DeclOf(st.s, d.Value).Kind)) != "pkg" {
				return []int{}
			}
		case option.None:
			return []int{}
		}
		head = q + "." + nameText(p, se.Sel)
	} else {
		return []int{}
	}
	for e in st.ext {
		if e.Head == head {
			return e.Kinds
		}
	}
	[]int{}
}

// orLeaves is the operands of a row argument written as a union, at any
// nesting; any other expression is its own leaf.
func orLeaves(p syntax.Parsed, x dense.ID[syntax.Node]) []dense.ID[syntax.Node] {
	let u = unparen(p, x)
	if syntax.KindOf(p.Tree, u) == syntax.KBinaryExpr {
		let b = syntax.BinaryExprOf(p.Tree, u)
		if syntax.TokText(p, b.Op) == "|" {
			let mut out = orLeaves(p, b.X)
			for y in orLeaves(p, b.Y) {
				out = out.Append(y)
			}
			return out
		}
	}
	[]dense.ID[syntax.Node]{x}
}

// linkHead takes over an index expression whose head is the package's
// own generic type: each argument that is a variable of w unifies with
// the head's parameter; a lone other argument is walked as a type. It
// reports whether it took the expression.
func linkHead(st mut solve, w walker, head dense.ID[syntax.Node], indices []dense.ID[syntax.Node]) bool {
	// A function's solve has no declarations: it takes no head.
	let g = localGen(*st, w.p, head)
	if g < 0 {
		return false
	}
	walk(st, w, head, kindType)
	for i, a in indices {
		if i >= st.gens[g].params.Len() {
			walk(st, w, a, kindType)
			continue
		}
		let slot = st.gens[g].base + i
		let args = orLeaves(w.p, a)
		for arg in args {
			let v = self(w, arg)
			if v >= 0 {
				union(&st.sv, v, slot)
			} else if args.Len() == 1 {
				walk(st, w, arg, kindType)
			}
		}
	}
	true
}

func listIDs(p syntax.Parsed, l syntax.List) []dense.ID[syntax.Node] {
	let n = syntax.Len(l)
	let mut out = slices.WithCapacity[dense.ID[syntax.Node]](n)
	for i in 0..n {
		out = out.Append(syntax.Item(p.Tree, l, i))
	}
	out
}

// index walks an index expression head[indices], or lets linkHead take
// it.
func index(st mut solve, w walker, head dense.ID[syntax.Node], indices []dense.ID[syntax.Node]) {
	if linkHead(st, w, head, indices) {
		return
	}
	walk(st, w, head, kindType)
	let kinds = slotKinds(*st, w.p, head)
	if st.fn {
		// A parameter passed to a local declaration's conflicted
		// parameter takes no kind from it (the conflict is reported at
		// the declaration): it resolves to nothing.
		let raw = rawKinds(st.s, st.local, nameText(w.p, head))
		for i, x in indices {
			let v = self(w, x)
			if i < raw.Len() && raw[i] == KindConflict && v >= 0 {
				observe(&st.sv, v, KindConflict)
			}
		}
	}
	for i, x in indices {
		walk(st, w, x, if i < kinds.Len() { kinds[i] } else { kindType })
	}
}

// fields walks the types of a field list.
func fields(st mut solve, w walker, l dense.ID[syntax.Node]) {
	if syntax.KindOf(w.p.Tree, l) != syntax.KFieldList {
		return
	}
	let fl = syntax.FieldListOf(w.p.Tree, l).List
	for i in 0..syntax.Len(fl) {
		let f = syntax.Item(w.p.Tree, fl, i)
		if syntax.KindOf(w.p.Tree, f) != syntax.KField {
			continue
		}
		match dense.Unpack(syntax.FieldOf(w.p.Tree, f).Type) {
		case option.Some[dense.ID[syntax.Node]] as t:
			walk(st, w, t.Value, kindType)
		case option.None:
		}
	}
}

// walk observes the names in type positions of x with the kind of their
// position (decl.go typeWalker).
func walk(st mut solve, w walker, x dense.ID[syntax.Node], k int) {
	let kind = syntax.KindOf(w.p.Tree, x)
	if kind == syntax.KIdent {
		let v = self(w, x)
		if v >= 0 {
			observe(&st.sv, v, k)
		}
	} else if kind == syntax.KParenExpr {
		walk(st, w, syntax.ParenExprOf(w.p.Tree, x).X, k)
	} else if kind == syntax.KBinaryExpr {
		let b = syntax.BinaryExprOf(w.p.Tree, x)
		walk(st, w, b.X, k)
		walk(st, w, b.Y, k)
	} else if kind == syntax.KIndexExpr {
		let ix = syntax.IndexExprOf(w.p.Tree, x)
		index(st, w, ix.X, listIDs(w.p, ix.Indices))
	} else if kind == syntax.KArrayType {
		walk(st, w, syntax.ArrayTypeOf(w.p.Tree, x).Elt, kindType)
	} else if kind == syntax.KMapType {
		let m = syntax.MapTypeOf(w.p.Tree, x)
		if st.ownMap {
			// The package declares its own Map: Map[K, V] is its instance
			// (bindings.go mapAsDeclared).
			index(st, w, m.X, []dense.ID[syntax.Node]{m.Key, m.Value})
		} else {
			walk(st, w, m.Key, kindType)
			walk(st, w, m.Value, kindType)
		}
	} else if kind == syntax.KStarExpr {
		walk(st, w, syntax.StarExprOf(w.p.Tree, x).X, kindType)
	} else if kind == syntax.KFuncType {
		let ft = syntax.FuncTypeOf(w.p.Tree, x)
		fields(st, w, ft.Params)
		match dense.Unpack(ft.Results) {
		case option.Some[dense.ID[syntax.Node]] as r:
			fields(st, w, r.Value)
		case option.None:
		}
		match dense.Unpack(ft.Needs) {
		case option.Some[dense.ID[syntax.Node]] as n:
			if syntax.KindOf(w.p.Tree, n.Value) == syntax.KNeedsClause {
				let names = syntax.NeedsClauseOf(w.p.Tree, n.Value).Names
				for i in 0..syntax.Len(names) {
					walk(st, w, syntax.Item(w.p.Tree, names, i), kindUses)
				}
			}
		case option.None:
		}
	} else if kind == syntax.KErrorRow {
		let types = syntax.ErrorRowOf(w.p.Tree, x).Types
		for i in 0..syntax.Len(types) {
			walk(st, w, syntax.Item(w.p.Tree, types, i), kindErrors)
		}
	} else if kind == syntax.KStructType {
		fields(st, w, syntax.StructTypeOf(w.p.Tree, x).Fields)
	} else if kind == syntax.KInterfaceType {
		// Operations and union members are type positions; an include, a
		// law and an inline variant are not (typeWalker).
		let members = syntax.InterfaceTypeOf(w.p.Tree, x).Members
		for i in 0..syntax.Len(members) {
			let m = syntax.Item(w.p.Tree, members, i)
			let mk = syntax.KindOf(w.p.Tree, m)
			if mk == syntax.KField {
				let fd = syntax.FieldOf(w.p.Tree, m)
				if fd.Dots < 0 {
					match dense.Unpack(fd.Type) {
					case option.Some[dense.ID[syntax.Node]] as t:
						walk(st, w, t.Value, kindType)
					case option.None:
					}
				}
			} else if mk != syntax.KLawDecl && mk != syntax.KTestDecl && mk != syntax.KVariantSpec {
				walk(st, w, m, kindType)
			}
		}
	} else if kind == syntax.KMachineType {
		let mt = syntax.MachineTypeOf(w.p.Tree, x)
		walk(st, w, mt.State, kindType)
		walk(st, w, mt.Signal, kindType)
	}
}

// BracketNames is the parameter names of the bracket field list l, in
// order (a top-level law's type parameters).
func BracketNames(p syntax.Parsed, l dense.ID[syntax.Node]) []string {
	let (names, _) = bracketNames(p, l)
	names
}

// bracketNames is the parameter names of a bracket field list, in order,
// and whether each is constrained by a type other than `error`.
func bracketNames(p syntax.Parsed, l dense.ID[syntax.Node]) ([]string, []bool) {
	let mut names = []string{}
	let mut typed = []bool{}
	match syntax.ViewOf(p.Tree, l) {
	case syntax.FieldList as fl:
		for f in listIDs(p, fl.List) {
			match syntax.ViewOf(p.Tree, f) {
			case syntax.Field as fd:
				let mut constrained = false
				match dense.Unpack(fd.Type) {
				case option.Some[dense.ID[syntax.Node]] as t:
					constrained = nameText(p, t.Value) != "error"
				case option.None:
				}
				for n in listIDs(p, fd.Names) {
					names = names.Append(nameText(p, n))
					typed = typed.Append(constrained)
				}
			case _:
			}
		}
	case _:
	}
	(names, typed)
}

// Kinds is the solved parameter kinds of each generic type declaration
// of the package, in collect order, with its name: kindType, kindErrors,
// kindUses or KindConflict per parameter. Raw is the kinds the positions
// give, before a constraint makes its parameter a type.
// at indexes them by declaration (genSide).
type Kinds { Names []string, Of [][]int, Raw [][]int, Steps int, at dense.Side[store.Decl, int] }

// NoKinds is an empty kind table.
func NoKinds() Kinds { Kinds{Names: []string{}, Of: [][]int{}, Raw: [][]int{}, Steps: 0, at: dense.NewSide[store.Decl, int](-1)} }

// rawKinds is the kinds the positions give the parameters of the local
// generic type name.
func rawKinds(s store.Store, k Kinds, name string) []int {
	match store.Lookup(s, name) {
	case option.Some[dense.ID[store.Decl]] as d:
		let i = dense.SideOf(k.at, d.Value)
		if i < 0 { []int{} } else { k.Raw[i] }
	case option.None:
		[]int{}
	}
}

// genSide indexes gens by declaration: the gen whose file and name row are
// the declaration's (localGen and the kinds lookups read it in place of a
// scan of every generic type).
func genSide(s store.Store, files []syntax.Parsed, gens []gen) dense.Side[store.Decl, int] {
	let mut side = dense.NewSide[store.Decl, int](-1)
	for i, g in gens {
		match store.Lookup(s, nameText(files[g.file], g.name)) {
		case option.Some[dense.ID[store.Decl]] as d:
			let row = store.DeclOf(s, d.Value)
			if int(row.File) == g.file && int(row.Node) == dense.Index(g.name) && dense.SideOf(side, d.Value) < 0 {
				dense.SideSet(&side, d.Value, i)
			}
		case option.None:
		}
	}
	side
}

// class is a parameter's kind from the positions seen.
func class(seen int) int {
	// An error row in a type position names its value type.
	let s = if seen == kindType|kindErrors { kindErrors } else { seen }
	if s == 0 { kindType } else if s == kindType || s == kindErrors || s == kindUses { s } else { KindConflict }
}

// gensOf is the package's generic type declarations in collect order,
// each inline variant of a generic union after its union, with the place
// of its first parameter among all of them (gen.base).
func gensOf(files []syntax.Parsed) []gen {
	let mut gens = []gen{}
	let mut next = 0
	for f, p in files {
		if p.Failed {
			continue
		}
		for d in topDecls(p) {
			match syntax.ViewOf(p.Tree, d) {
			case syntax.TypeDecl as td:
				match dense.Unpack(td.TypeParams) {
				case option.Some[dense.ID[syntax.Node]] as tp:
					let (names, typed) = bracketNames(p, tp.Value)
					let base = next
					next = next + names.Len()
					let mut ops = false
					match dense.Unpack(td.Spec) {
					case option.Some[dense.ID[syntax.Node]] as sp:
						match syntax.ViewOf(p.Tree, sp.Value) {
						case syntax.InterfaceType:
							ops = true
						case _:
						}
					case option.None:
					}
					let spec = match dense.Unpack(td.Spec) {
					case option.Some[dense.ID[syntax.Node]] as sp:
						sp.Value
					case option.None:
						continue
					}
					gens = gens.Append(gen{file: f, name: td.Name, body: spec, params: names, typed: typed, ops: ops, base: base})
					// An inline variant of a union is a record with the
					// union's parameters its fields mention, in the union's
					// order (shapes.go variantParams).
					match syntax.ViewOf(p.Tree, spec) {
					case syntax.InterfaceType as it:
						for m in listIDs(p, it.Members) {
							match syntax.ViewOf(p.Tree, m) {
							case syntax.VariantSpec as vs:
								let used = mentioned(p, vs.Fields)
								let vbase = next
								let mut vnames = []string{}
								let mut vtyped = []bool{}
								for i, n in names {
									if contains(used, n) {
										vnames = vnames.Append(n)
										vtyped = vtyped.Append(typed[i])
									}
								}
								next = next + vnames.Len()
								if vnames.Len() > 0 {
									gens = gens.Append(gen{file: f, name: vs.Name, body: vs.Fields, params: vnames, typed: vtyped, ops: false, base: vbase})
								}
							case _:
							}
						}
					case _:
					}
				case option.None:
				}
			case _:
			}
		}
	}
	gens
}

// SolveKinds solves the kinds of the generic type declarations of the
// package whose store bind.Collect built from files.
func SolveKinds(s store.Store, files []syntax.Parsed, ext []Ext) Kinds {
	let mut st = solve{s: s, gens: []gen{}, genAt: dense.NewSide[store.Decl, int](-1), ext: ext, sv: solver{parent: []int{}, seen: []int{}, steps: 0}, ownMap: false, fn: false, local: Kinds{Names: []string{}, Of: [][]int{}, Raw: [][]int{}, Steps: 0, at: dense.NewSide[store.Decl, int](-1)}}
	match store.Lookup(s, "Map") {
	case option.Some[dense.ID[store.Decl]] as d:
		st.ownMap = store.KindName(int(store.DeclOf(s, d.Value).Kind)) == "type"
	case option.None:
	}
	// The variables: one per bracket parameter, in collect order.
	st.gens = gensOf(files)
	st.genAt = genSide(s, files, st.gens)
	for g in st.gens {
		for i, _ in g.params {
			st.sv.parent = st.sv.parent.Append(g.base + i)
			st.sv.seen = st.sv.seen.Append(if g.typed[i] { kindType } else { 0 })
		}
	}
	// Each declaration's body.
	for g in st.gens {
		let p = files[g.file]
		let mut vars = []int{}
		for i, _ in g.params {
			vars = vars.Append(g.base + i)
		}
		let w = walker{p: p, names: g.params, vars: vars}
		match syntax.ViewOf(p.Tree, g.body) {
		case syntax.FieldList:
			fields(&st, w, g.body)
		case _:
			walk(&st, w, g.body, kindType)
		}
	}
	// A function whose first parameter is a local generic type binds that
	// type's parameters by position, and its signature constrains them
	// (196m; round-3 M3). An operation type's functions are not its
	// methods.
	for p in files {
		if p.Failed {
			continue
		}
		for d in topDecls(p) {
			match syntax.ViewOf(p.Tree, d) {
			case syntax.FuncDecl as fd:
				receiverKinds(&st, p, fd)
			case _:
			}
		}
	}
	let mut out = Kinds{Names: []string{}, Of: [][]int{}, Raw: [][]int{}, Steps: 0, at: st.genAt}
	for g in st.gens {
		let mut ks = []int{}
		let mut raw = []int{}
		for i, _ in g.params {
			let k = class(st.sv.seen[find(&st.sv, g.base+i)])
			raw = raw.Append(k)
			// A constrained parameter is a type, whatever its positions
			// (decl.go resolveNamed: the constraint wins over the solve).
			ks = ks.Append(if g.typed[i] { kindType } else { k })
		}
		out.Names = out.Names.Append(nameText(files[g.file], g.name))
		out.Of = out.Of.Append(ks)
		out.Raw = out.Raw.Append(raw)
	}
	out.Steps = st.sv.steps
	out
}

// mentioned is the names in type positions of a variant's field list,
// at any depth (walkTypePositions).
func mentioned(p syntax.Parsed, l dense.ID[syntax.Node]) []string {
	let mut out = []string{}
	match syntax.ViewOf(p.Tree, l) {
	case syntax.FieldList as fl:
		for f in listIDs(p, fl.List) {
			match syntax.ViewOf(p.Tree, f) {
			case syntax.Field as fd:
				match dense.Unpack(fd.Type) {
				case option.Some[dense.ID[syntax.Node]] as t:
					names(p, t.Value, &out)
				case option.None:
				}
			case _:
			}
		}
	case _:
	}
	out
}

// names appends each name in a type position of x to out.
func names(p syntax.Parsed, x dense.ID[syntax.Node], out mut []string) {
	match syntax.ViewOf(p.Tree, x) {
	case syntax.Name:
		*out = (*out).Append(nameText(p, x))
	case syntax.ParenExpr as pe:
		names(p, pe.X, out)
	case syntax.BinaryExpr as b:
		names(p, b.X, out)
		names(p, b.Y, out)
	case syntax.IndexExpr as ix:
		names(p, ix.X, out)
		for i in listIDs(p, ix.Indices) {
			names(p, i, out)
		}
	case syntax.ArrayType as a:
		names(p, a.Elt, out)
	case syntax.MapType as m:
		names(p, m.Key, out)
		names(p, m.Value, out)
	case syntax.StarExpr as s:
		names(p, s.X, out)
	case syntax.FuncType as ft:
		fieldNames(p, ft.Params, out)
		match dense.Unpack(ft.Results) {
		case option.Some[dense.ID[syntax.Node]] as r:
			fieldNames(p, r.Value, out)
		case option.None:
		}
		match dense.Unpack(ft.Needs) {
		case option.Some[dense.ID[syntax.Node]] as n:
			match syntax.ViewOf(p.Tree, n.Value) {
			case syntax.NeedsClause as nc:
				for name in listIDs(p, nc.Names) {
					names(p, name, out)
				}
			case _:
			}
		case option.None:
		}
	case syntax.ErrorRow as er:
		for t in listIDs(p, er.Types) {
			names(p, t, out)
		}
	case syntax.StructType as s:
		fieldNames(p, s.Fields, out)
	case syntax.MachineType as mt:
		names(p, mt.State, out)
		names(p, mt.Signal, out)
	case _:
	}
}

func fieldNames(p syntax.Parsed, l dense.ID[syntax.Node], out mut []string) {
	match syntax.ViewOf(p.Tree, l) {
	case syntax.FieldList as fl:
		for f in listIDs(p, fl.List) {
			match syntax.ViewOf(p.Tree, f) {
			case syntax.Field as fd:
				match dense.Unpack(fd.Type) {
				case option.Some[dense.ID[syntax.Node]] as t:
					names(p, t.Value, out)
				case option.None:
				}
			case _:
			}
		}
	case _:
	}
}

func contains(xs []string, x string) bool {
	for y in xs {
		if y == x {
			return true
		}
	}
	false
}

func topDecls(p syntax.Parsed) []dense.ID[syntax.Node] {
	match syntax.ViewOf(p.Tree, syntax.Root(p.Tree)) {
	case syntax.File as root:
		listIDs(p, root.Decls)
	case _:
		[]dense.ID[syntax.Node]{}
	}
}

// receiverKinds applies the receiver rule to one function declaration.
func receiverKinds(st mut solve, p syntax.Parsed, fd syntax.FuncDecl) {
	let own = match dense.Unpack(fd.TypeParams) {
	case option.Some[dense.ID[syntax.Node]] as tp:
		let (names, _) = bracketNames(p, tp.Value)
		names
	case option.None:
		return
	}
	if nameText(p, fd.Name) == "main" {
		return
	}
	let mut first = dense.NoID[syntax.Node]()
	match syntax.ViewOf(p.Tree, fd.Type) {
	case syntax.FuncType as ft:
		match syntax.ViewOf(p.Tree, ft.Params) {
		case syntax.FieldList as fl:
			if syntax.Len(fl.List) == 0 {
				return
			}
			match syntax.ViewOf(p.Tree, syntax.Item(p.Tree, fl.List, 0)) {
			case syntax.Field as f0:
				first = f0.Type
			case _:
			}
		case _:
		}
	case _:
	}
	let rt0 = match dense.Unpack(first) {
	case option.Some[dense.ID[syntax.Node]] as t:
		unparen(p, t.Value)
	case option.None:
		return
	}
	let rt = match syntax.ViewOf(p.Tree, rt0) {
	case syntax.StarExpr as s:
		unparen(p, s.X)
	case _:
		rt0
	}
	let mut head = dense.NoID[syntax.Node]()
	let mut indices = []dense.ID[syntax.Node]{}
	match syntax.ViewOf(p.Tree, rt) {
	case syntax.IndexExpr as ix:
		head = dense.OptOf(ix.X)
		indices = listIDs(p, ix.Indices)
	case syntax.MapType as m:
		if st.ownMap {
			head = dense.OptOf(m.X)
			indices = []dense.ID[syntax.Node]{m.Key, m.Value}
		}
	case _:
	}
	let h = match dense.Unpack(head) {
	case option.Some[dense.ID[syntax.Node]] as x:
		x.Value
	case option.None:
		return
	}
	let g = localGen(*st, p, h)
	if g < 0 || st.gens[g].ops {
		return
	}
	let mut names = []string{}
	let mut vars = []int{}
	for i, a in indices {
		let t = nameText(p, unparen(p, a))
		if t == "" || t == "_" || !contains(own, t) || i >= st.gens[g].params.Len() {
			continue
		}
		// A name written twice unifies its positions when the receiver's
		// type is walked (linkHead), so the position it binds here does not
		// change a kind; kinds.go keeps the last.
		names = names.Append(t)
		vars = vars.Append(st.gens[g].base + i)
	}
	walk(st, walker{p: p, names: names, vars: vars}, fd.Type, kindType)
}

// FuncKinds is the kinds of one function declaration's bracket
// parameters (none for a function with no brackets): its file, its
// declaration row, its name, its parameter names and their kinds.
type FuncKinds { File int, Decl dense.ID[syntax.Node], Name string, Params []string, Kinds []int }

// SolveFuncKinds gives each bracket parameter of each package function
// declaration the kind of its positions in the signature: after fails an
// error row, after needs a capability row, elsewhere a type (decl.go
// kindBracketParams); a constrained one is a type. A function's
// parameters link to no other declaration's: a local generic type gives
// them its solved kinds, decls.
func SolveFuncKinds(s store.Store, files []syntax.Parsed, ext []Ext, decls Kinds) []FuncKinds {
	let (out, _) = solveFuncs(s, files, ext, decls)
	out
}

// solveFuncs is SolveFuncKinds and the number of solves it set up: one,
// shared by every function, which resets only its variables, so its
// setup does not copy the package once per function.
func solveFuncs(s store.Store, files []syntax.Parsed, ext []Ext, decls Kinds) ([]FuncKinds, int) {
	let mut out = []FuncKinds{}
	let mut ownMap = false
	match store.Lookup(s, "Map") {
	case option.Some[dense.ID[store.Decl]] as d:
		ownMap = store.KindName(int(store.DeclOf(s, d.Value).Kind)) == "type"
	case option.None:
	}
	let mut st = solve{s: s, gens: []gen{}, genAt: dense.NewSide[store.Decl, int](-1), ext: ext, sv: solver{parent: []int{}, seen: []int{}, steps: 0}, ownMap: ownMap, fn: true, local: decls}
	let mut setups = 0
	setups = setups + 1
	for f, p in files {
		if p.Failed {
			continue
		}
		for d in topDecls(p) {
			match syntax.ViewOf(p.Tree, d) {
			case syntax.FuncDecl as fd:
				match dense.Unpack(fd.Recv) {
				case option.Some[dense.ID[syntax.Node]]:
					continue
				case option.None:
				}
				let (names, typed) = match dense.Unpack(fd.TypeParams) {
				case option.Some[dense.ID[syntax.Node]] as tp:
					bracketNames(p, tp.Value)
				case option.None:
					([]string{}, []bool{})
				}
				// A function's solve: the shared one, its variables reset.
				st.sv = solver{parent: []int{}, seen: []int{}, steps: 0}
				let mut vars = []int{}
				for i, _ in names {
					st.sv.parent = st.sv.parent.Append(i)
					st.sv.seen = st.sv.seen.Append(0)
					vars = vars.Append(i)
				}
				walk(&st, walker{p: p, names: names, vars: vars}, fd.Type, kindType)
				let mut ks = []int{}
				for i, _ in names {
					ks = ks.Append(if typed[i] { kindType } else { class(st.sv.seen[i]) })
				}
				out = out.Append(FuncKinds{File: f, Decl: d, Name: nameText(p, fd.Name), Params: names, Kinds: ks})
			case _:
			}
		}
	}
	(out, setups)
}

// chain is a package of n generic records, each passing its parameter
// to the next, the last putting it in an error row: one equivalence class
// of n variables, the deepest path union-find can build.
func chain(n int) string {
	let mut b = strings.NewBuilder()
	for i in 0..n {
		if i == n-1 {
			b.WriteString("type G\(i)[A] { f func() int fails A }\n")
		} else {
			b.WriteString("type G\(i)[A] { f G\(i + 1)[A] }\n")
		}
	}
	b.String()
}

// solveChain is the solved kinds of chain(n).
func solveChain(n int) Kinds {
	let p = syntax.Parse(chain(n))
	let s = bind.Collect("main", []bind.File{bind.File{Name: "a.ergo", Parsed: p}})
	SolveKinds(s, []syntax.Parsed{p}, []Ext{})
}

// KindSolveWorkIsNearLinear: the union-find steps of a chain of 2n
// declarations are at most twice those of n plus 2n (n log n passes;
// a find without path compression is quadratic and does not), and every
// parameter of the chain takes the error row's kind.
law KindSolveWorkIsNearLinear(xs []int) {
	let n = 8 + xs.Len()%24
	let a = solveChain(n)
	let b = solveChain(2 * n)
	let mut ok = b.Steps <= 2*a.Steps+2*n
	for ks in b.Of {
		ok = ok && ks.Len() == 1 && ks[0] == kindErrors
	}
	ok
}

// funcs is a package of a generic record and n functions taking it,
// each passing its parameter on and naming it in an error row.
func funcs(n int) string {
	let mut b = strings.NewBuilder()
	b.WriteString("type G[A] { f A }\n")
	for i in 0..n {
		b.WriteString("func f\(i)[X](g G[X]) int fails X { 0 }\n")
	}
	b.String()
}

// solveFuncsOf is the function kinds of funcs(n) and the solves set up.
func solveFuncsOf(n int) ([]FuncKinds, int) {
	let p = syntax.Parse(funcs(n))
	let files = []syntax.Parsed{p}
	let s = bind.Collect("main", []bind.File{bind.File{Name: "a.ergo", Parsed: p}})
	solveFuncs(s, files, []Ext{}, SolveKinds(s, files, []Ext{}))
}

// FuncKindSetupIsShared: the function kinds of n and of 2n functions set
// up one solve each (a solve per function copies the package once per
// function: quadratic setup), and every function's parameter is an error
// row.
law FuncKindSetupIsShared(xs []int) {
	let n = 4 + xs.Len()%12
	let (a, sa) = solveFuncsOf(n)
	let (b, sb) = solveFuncsOf(2 * n)
	let mut ok = sa == 1 && sb == 1 && a.Len() == n && b.Len() == 2*n
	for fk in b {
		ok = ok && fk.Kinds.Len() == 1 && fk.Kinds[0] == kindErrors
	}
	ok
}
