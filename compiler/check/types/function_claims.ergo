import compiler/check/store
import compiler/syntax
import dense

type ClaimIssue { File int, At dense.ID[syntax.Node], Code string, Message string }

type functionHead {
	file int,
	node dense.ID[syntax.Node],
	at dense.ID[syntax.Node],
	name string,
	params []Bracket,
	sig dense.ID[store.TKey],
	claim store.ClaimHead,
}

type functionGroup { head functionHead, members []functionHead }

// HasFunctionClaims keeps the interface's ordinary path from resolving
// function signatures a second time.
func HasFunctionClaims(files []syntax.Parsed) bool {
	for p in files {
		if p.Failed { continue }
		for d in topDecls(p) {
			if syntax.KindOf(p.Tree, d) == syntax.KFuncDecl {
				if syntax.FuncDeclOf(p.Tree, d).ImplementsPos >= 0 { return true }
			}
		}
	}
	false
}

// ImportFunctionClaims rebases the types only once and keeps the provider
// members as references to their declarations in their original package.
func ImportFunctionClaims(s mut store.Store, deps []Iface, foreign []Foreign) {
	for i, dep in deps {
		let source = dep.Types
		let lookup = func(ref store.XRef) Option[DeclIdentity] { roleRef(dep.Refs, ref) }
		for j in 0..store.FunctionClaimCount(source) {
			let g = store.FunctionClaimAt(source, j)
			if !namedInStore(source, g.Role) { continue }
			let role = match Port(s, deps, foreign, source, dep.Path, lookup, dep.Foreign, g.Role) {
			case Some{Value: t}:
				t
			case None:
				continue
			}
			let recv = match Port(s, deps, foreign, source, dep.Path, lookup, dep.Foreign, g.Receiver) {
			case Some{Value: t}:
				t
			case None:
				continue
			}
			let mut members = []store.FunctionMember{}
			for m in g.Members {
				let mut imp = uint32(i + 1)
				if m.Import > uint32(0) {
					let paths = store.ImportPaths(source)
					if int(m.Import) <= len(paths) {
						let path = paths[int(m.Import)-1]
						imp = uint32(0)
						for k, dst in deps {
							if dst.Path == path { imp = uint32(k + 1); break }
						}
					}
				}
				members = members.Append(store.FunctionMember{..m, Import: imp})
			}
			match Nominal(*s, role) {
			case Some{Value: ref}:
				store.AddFunctionClaim(s, ref, store.ClaimHead{..g, Role: role, Receiver: recv, Members: members})
			case None:
			}
		}
	}
}

func localClaimIssue(h functionHead, code string, msg string) ClaimIssue {
	ClaimIssue{File: h.file, At: h.at, Code: code, Message: msg}
}

func namedInStore(s store.Store, t dense.ID[store.TKey]) bool {
	match Nominal(s, t) {
	case Some{Value: n}:
		n.Import == uint32(0)
	case None:
		false
	}
}

func claimsMember(role Role, name string) Option[RoleMember] {
	for m in role.Members {
		if m.Name == name { return Some{Value: m} }
	}
	None
}

func claimantType(s store.Store, receiver dense.ID[store.TKey]) dense.ID[store.TKey] {
	let k = store.KindOfType(s, receiver)
	if k == store.KOwn || k == store.KPointer { return claimantType(s, store.OperandsOf(s, receiver)[0]) }
	receiver
}

func claimNames(e Env, h functionHead) Names {
	Names{Params: roleNames(h.params), Foreign: e.foreign, Pkg: "", Deps: e.deps}
}

func containsUnbound(s store.Store, t dense.ID[store.TKey], binds []bool) bool {
	if store.KindOfType(s, t) == store.KParam {
		let i = store.ArgOf(s, t)
		return i >= len(binds) || !binds[i]
	}
	for a in store.OperandsOf(s, t) {
		if containsUnbound(s, a, binds) { return true }
	}
	false
}

func claimPositions(s store.Store, args []dense.ID[store.TKey], binds []bool) Option[[]int] {
	match Positions(s, args, len(binds)) {
	case Some{Value: slots}:
		for i in slots {
			if !binds[i] { return None }
		}
		Some{Value: slots}
	case None:
		None
	}
}

func claimProjection(s store.Store, e Env, h functionHead, role Role) string {
	let args = store.OperandsOf(s, h.claim.Role)
	let mut used = []int{}
	for a in args {
		if containsUnbound(s, a, h.claim.Binds) {
			return "a function claim argument can name only parameters bound by the receiver"
		}
		if role.Self != 2 { continue }
		let i = DeclSlot(s, a)
		if i < 0 || i >= len(h.claim.Binds) || !h.claim.Binds[i] {
			return "\(role.Name) re-applies Self, and \(Text(s, claimNames(e, h), a)) is not a type parameter bound by the receiver"
		}
		for previous in used {
			if previous == i {
				return "\(role.Name) re-applies Self, and \(h.params[i].Name) is named more than once in the claim"
			}
		}
		used = used.Append(i)
	}
	""
}

func sameFunctionGroup(s mut store.Store, a functionHead, b functionHead) bool {
	let args = match store.ShapeBindings(s, a.claim, b.claim.Receiver) {
	case Some{Value: a}:
		a
	case None:
		return false
	}
	let n = store.TSubst(s, a.claim.Role, args)
	if n != b.claim.Role { return false }
	let mut other = []int{}
	for i, on in a.claim.Binds {
		if !on { continue }
		let j = DeclSlot(*s, args[i])
		if j < 0 || j >= len(b.claim.Binds) || !b.claim.Binds[j] || a.params[i].Cons != b.params[j].Cons { return false }
		for seen in other {
			if seen == j { return false }
		}
		other = other.Append(j)
	}
	let mut count = 0
	for on in b.claim.Binds { if on { count = count + 1 } }
	count == len(other)
}

func functionOverlap(s mut store.Store, a functionHead, b functionHead) bool {
	match store.ShapeBindings(s, a.claim, b.claim.Receiver) {
	case Some{Value: args}:
		if store.TSubst(s, a.claim.Role, args) == b.claim.Role { return true }
	case None:
	}
	match store.ShapeBindings(s, b.claim, a.claim.Receiver) {
	case Some{Value: args}:
		store.TSubst(s, b.claim.Role, args) == a.claim.Role
	case None:
		false
	}
}

func overlapIssue(s store.Store, e Env, h functionHead, prev functionHead) ClaimIssue {
	let p = e.files[prev.file]
	let pos = syntax.PositionOf(syntax.LinesOf(syntax.SourceOf(p)), syntax.NodePos(p, prev.at))
	let n = claimNames(e, h)
	localClaimIssue(h, "S106", "function claim of \(Text(s, n, h.claim.Role)) for \(Text(s, n, h.claim.Receiver)) overlaps the clause at \(pos.Line):\(pos.Column)")
}

// FunctionClaimFacts collects checked heads after signatures and before
// the bodies. A frozen interface carries the same receiver and slot facts.
func FunctionClaimFacts(s mut store.Store, e Env, roles []Role, fns []FuncKinds) []ClaimIssue {
	let mut out = []ClaimIssue{}
	let mut groups = []functionGroup{}
	for f in fns {
		let p = e.files[f.File]
		let fd = syntax.FuncDeclOf(p.Tree, f.Decl)
		let at = match dense.Unpack(fd.Implements) {
		case Some{Value: x}:
			x
		case None:
			continue
		}
		let env = Env{..e, p: p, params: f.Params}
		let sig = Resolve(s, env, fd.Type)
		let op = Resolve(s, env, at)
		let parts = store.OperandsOf(*s, sig)
		let head = store.ClaimHead{Role: op, Receiver: if len(parts) > 3 { parts[0] } else { store.TBasic(s, 0) }, Binds: []bool{}, Positions: []int{}, Members: []store.FunctionMember{}}
		let mut h = functionHead{file: f.File, node: f.Decl, at: at, name: f.Name, params: Brackets(p, fd.TypeParams), sig: sig, claim: head}
		if len(parts) <= 3 {
			out = out.Append(localClaimIssue(h, "S108", "a function claim needs its receiver as the first parameter"))
			continue
		}
		if store.KindOfType(*s, op) == store.KBasic && store.ArgOf(*s, op) == 0 { continue }
		let role = match ReadRole(s, e.deps, e.foreign, roles, op) {
		case Some{Value: r}:
			r
		case None:
			out = out.Append(localClaimIssue(h, "S108", "a function claim names an operation type"))
			continue
		}
		if !namedInStore(*s, op) {
			out = out.Append(localClaimIssue(h, "S108", "a function claim is written in the contract's package"))
			continue
		}
		let base = claimantType(*s, head.Receiver)
		if namedInStore(*s, base) {
			out = out.Append(localClaimIssue(h, "S108", "a function claim for a type of this package is written on the type"))
			continue
		}
		if store.KindOfType(*s, base) == store.KParam {
			out = out.Append(localClaimIssue(h, "S108", "a function claim needs a concrete receiver shape in its first parameter"))
			continue
		}
		let receiver = if store.KindOfType(*s, head.Receiver) == store.KOwn { store.OperandsOf(*s, head.Receiver)[0] } else { head.Receiver }
		let binds = store.ReceiverBinders(*s, receiver, len(f.Params))
		let positions = match claimPositions(*s, store.OperandsOf(*s, op), binds) {
		case Some{Value: ps}:
			ps
		case None:
			[]int{}
		}
		h.claim = store.ClaimHead{..head, Receiver: receiver, Binds: binds, Positions: positions}
		match claimsMember(role, f.Name) {
		case None:
			out = out.Append(localClaimIssue(h, "S106", "\(role.Name) has no operation named \(f.Name)"))
			continue
		case Some:
		}
		let why = claimProjection(*s, e, h, role)
		if why != "" {
			out = out.Append(localClaimIssue(h, "S106", why))
			continue
		}
		let mut merged = false
		for i, g in groups {
			if !sameFunctionGroup(s, g.head, h) { continue }
			let mut duplicate = false
			for previous in g.members {
				if h.name == previous.name {
					out = out.Append(overlapIssue(*s, e, h, previous))
					duplicate = true
					break
				}
			}
			if !duplicate { groups[i] = functionGroup{..g, members: g.members.Append(h)} }
			merged = true
			break
		}
		if !merged { groups = groups.Append(functionGroup{head: h, members: []functionHead{h}}) }
	}

	for i, g in groups {
		let h = g.head
		let mut overlap = false
		for j in 0..i {
			let old = groups[j].head
			if functionOverlap(s, old, h) {
				out = out.Append(overlapIssue(*s, e, h, old))
				overlap = true
				break
			}
		}
		if overlap { continue }
		out = out.Concat(publishFunctionGroup(s, e, roles, g, groups))
	}
	out
}

func publishFunctionGroup(s mut store.Store, e Env, roles []Role, g functionGroup, groups []functionGroup) []ClaimIssue {
	let h = g.head
	let op = h.claim.Role
	let mut out = []ClaimIssue{}
	let role = match ReadRole(s, e.deps, e.foreign, roles, op) {
	case Some{Value: role}:
		role
	case None:
		return out
	}
	let args = store.OperandsOf(*s, op)
	let mut includes = []dense.ID[store.TKey]{}
	let mut foreign = []store.ClaimHead{}
	for inc in role.Includes {
		let at = store.TSubst(s, inc, args)
		includes = includes.Append(at)
		match Nominal(*s, at) {
		case Some{Value: ref}:
			if ref.Import == uint32(0) { continue }
			match store.FunctionClaimBindings(s, at, ref, h.claim.Receiver) {
			case Some{Value: binding}:
				foreign = foreign.Append(binding)
			case None:
				let n = claimNames(e, h)
				let name = Text(*s, n, at)
				let recv = Text(*s, n, h.claim.Receiver)
				out = out.Append(localClaimIssue(h, "S106", "included \(name) has no function claim for \(recv) in its declaring package; add one there or stop including \(name)"))
			}
		case None:
		}
	}
	if len(out) > 0 { return out }
	let mut members = []store.FunctionMember{}
	let mut names = []string{}
	for m in role.Members {
		match groupMember(s, g, includes, groups, m.Name) {
		case Some{Value: f}:
			members = members.Append(store.FunctionMember{Import: uint32(0), File: uint32(f.file), Decl: uint32(dense.Index(f.node))})
			names = names.Append(m.Name)
		case None:
			let mut fed = false
			for other in foreign {
				match ReadRole(s, e.deps, e.foreign, roles, other.Role) {
				case Some{Value: r}:
					for j, slot in r.Members {
						if slot.Name == m.Name && j < len(other.Members) {
							members = members.Append(other.Members[j])
							names = names.Append(m.Name)
							fed = true
							break
						}
					}
				case None:
				}
				if fed { break }
			}
			if !fed {
				let n = claimNames(e, h)
				out = out.Append(localClaimIssue(h, "S106", "\(Text(*s, n, h.claim.Receiver)) claims \(Text(*s, n, op)), but no function provides \(m.Name)"))
			}
		}
	}
	if len(out) > 0 { return out }
	match Nominal(*s, op) {
	case Some{Value: ref}:
		store.AddFunctionClaim(s, ref, store.ClaimHead{..h.claim, Members: members})
	case None:
	}
	for at in includes {
		match Nominal(*s, at) {
		case Some{Value: ref}:
			if ref.Import != uint32(0) { continue }
			match ReadRole(s, e.deps, e.foreign, roles, at) {
			case Some{Value: r}:
				let mut selected = []store.FunctionMember{}
				for slot in r.Members {
					for j, n in names {
						if n == slot.Name { selected = selected.Append(members[j]); break }
					}
				}
				let positions = match claimPositions(*s, store.OperandsOf(*s, at), h.claim.Binds) {
				case Some{Value: ps}:
					ps
				case None:
					[]int{}
				}
				store.AddFunctionClaim(s, ref, store.ClaimHead{..h.claim, Role: at, Positions: positions, Members: selected})
			case None:
			}
		case None:
		}
	}
	out
}

func groupMember(s mut store.Store, g functionGroup, includes []dense.ID[store.TKey], groups []functionGroup, name string) Option[functionHead] {
	for h in g.members {
		if h.name == name { return Some{Value: h} }
	}
	for op in includes {
		for other in groups {
			let shape = functionHead{..g.head, claim: store.ClaimHead{..g.head.claim, Role: op}}
			if !sameFunctionGroup(s, other.head, shape) { continue }
			for h in other.members {
				if h.name == name { return Some{Value: h} }
			}
		}
	}
	None
}
