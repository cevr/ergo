// S108's test-harness shape (PROPERTY-TESTING P1b; runtime.md, Tests:
// harnesses; the Go checker's harness.go planHarness): an operation type
// D declares one harness `test H`, a function of the package of the shape
// func H(run R, body func() fails F needs D) fails F, with R a record
// {Name string, Seed uint64, Site string, Source string} and F a record {Message
// string} of the package. This part reads the declarations as written;
// the Go checker reads their types, which agree on every written shape.
// A test body that runs under the harness is the rows' (S3-ROWS), which
// read no test body yet.

import compiler/check/expr
import compiler/check/types
import compiler/syntax
import dense

// Harnesses is S108 for each harness member whose function is not of the
// shape, and for each second harness of one type, in the Go checker's
// order.
func Harnesses(k expr.Pkg) []Diag {
	let mut out = []Diag{}
	for f, p in k.Parsed {
		if p.Failed {
			continue
		}
		for d in topDecls(p) {
			match syntax.ViewOf(p.Tree, d) {
			case syntax.TypeDecl as td:
				match dense.Unpack(td.Spec) {
				case Some[dense.ID[syntax.Node]] as sp:
					if syntax.KindOf(p.Tree, sp.Value) == syntax.KInterfaceType {
						out = harnessMembers(k, p, f, td, sp.Value, out)
					}
				case None:
				}
			case _:
			}
		}
	}
	Sorted(out)
}

// harnessMembers adds the diagnostics of the harness members of the
// operation type td, whose body is it, to out.
func harnessMembers(k expr.Pkg, p syntax.Parsed, f int, td syntax.TypeDecl, it dense.ID[syntax.Node], out0 []Diag) []Diag {
	let mut out = out0
	let tname = textAt(p, td.Name)
	let members = syntax.InterfaceTypeOf(p.Tree, it).Members
	let mut n = 0
	for j in 0..syntax.Len(members) {
		let m = syntax.Item(p.Tree, members, j)
		if syntax.KindOf(p.Tree, m) != syntax.KTestDecl {
			continue
		}
		let hname = textAt(p, syntax.TestDeclOf(p.Tree, m).Name)
		let msg = if n > 0 {
			"\(tname) declares a second test harness \(hname); an operation type has one"
		} else {
			let why = types.HarnessWhy(k.Parsed, tname, isSome(dense.Unpack(td.TypeParams)), hname)
			if why == "" { "" } else { "test harness \(hname) of \(tname) must have the shape func \(hname)(run R, body func() fails F needs \(tname)) fails F, with R a record {Name string, Seed uint64, Site string, Source string} and F a record {Message string}, both of this package; \(why)" }
		}
		n = n + 1
		if msg != "" {
			let at = syntax.NodePos(p, m)
			out = out.Append(Diag{File: f, Offset: at, Length: syntax.NodeEnd(p, m) - at, Code: CodeType, Message: msg})
		}
	}
	out
}
