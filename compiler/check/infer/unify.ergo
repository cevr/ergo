// Unification of a parameter type with an argument type, after the Go
// checker's unify.go (internal/sketch/check), on the pool's ids: a type is
// its interned id, so identity is id equality and a row is a sorted run of
// ids.
//
// S3d1 covers unify.go's structural rules: a parameter of the call binds,
// or its binding matches; named types and instances match by origin and
// arguments; slices, arrays, maps, pointers, tuples and signatures match
// part by part; rows bind by the row-union rule (unifyRow); a result
// parameter matched against no result binds to no value. The rules that
// read a type's declaration (a union and its variants, an interface's
// methods, a machine's view) are S3d2's, and the agreement leaves the
// calls that reach them out (internal/selfhostcheck, inferComparable).
// Without them the modes (assign, exact) decide nothing, so there are none.

import compiler/check/store
import dense

// depthLimit stops unification on a recursive type, as unify.go's
// unifyDepthLimit does.
let depthLimit = 50

// NoValue is the binding of a result parameter matched against a function
// with no result: the empty tuple, a signature's absent result.
func NoValue(s mut store.Store) dense.ID[store.TKey] { store.TTuple(s, []dense.ID[store.TKey]{}) }

// Unmarked is t without an own or entry mark: the Go checker's signature
// unification reads a parameter's type with its marks ignored.
func Unmarked(s store.Store, t dense.ID[store.TKey]) dense.ID[store.TKey] {
	let k = store.KindOfType(s, t)
	if k == store.KOwn || k == store.KEntry { store.OperandsOf(s, t)[0] } else { t }
}

// Unify matches the parameter type p against the argument type a,
// binding c's free parameters, and reports whether they match.
func Unify(s mut store.Store, f mut Frame, c Call, p dense.ID[store.TKey], a dense.ID[store.TKey]) bool { nify(s, f, c, p, a, 0) }

func nify(s mut store.Store, f mut Frame, c Call, x0 dense.ID[store.TKey], y0 dense.ID[store.TKey], depth int) bool {
	f.steps = f.steps + 1
	let x = Unmarked(*s, x0)
	let y = Unmarked(*s, y0)
	let k = slotOf(*s, c, x)
	if x == y && !(k >= 0 && !f.slots[c.at+k].row && free(*f, c, k)) {
		return true
	}
	if store.KindOfType(*s, x) == store.KBasic && store.ArgOf(*s, x) == 0 || store.KindOfType(*s, y) == store.KBasic && store.ArgOf(*s, y) == 0 {
		// An invalid type is reported elsewhere: no cascade.
		return true
	}
	if depth > depthLimit {
		return false
	}
	let d = depth + 1
	if k >= 0 {
		if f.slots[c.at+k].row {
			// A row parameter in a type position. The Go checker accepts
			// it (rows bind in unifyRow), but it arises only where the
			// kinds of a generic type's parameters disagree with its uses
			// (S3t's kinds read Async[T, F]'s F as a type where the Go
			// checker reads a row), so the binding would be the empty row
			// where Go's is the argument: the call is left uninferred.
			return false
		}
		match Binding(*f, c, k) {
		case None:
			Bind(f, c, k, y)
			return true
		case Some[dense.ID[store.TKey]] as b:
			let none = NoValue(s)
			if b.Value == none || y == none {
				return b.Value == y
			}
			return nify(s, f, c, b.Value, y, d)
		}
	}
	let kx = store.KindOfType(*s, x)
	let ky = store.KindOfType(*s, y)
	if kx == store.KInstance {
		if ky != store.KInstance || store.OriginOfType(*s, x) != store.OriginOfType(*s, y) {
			return false
		}
		let xs = store.OperandsOf(*s, x)
		let ys = store.OperandsOf(*s, y)
		if len(xs) != len(ys) {
			return false
		}
		for i in 0..len(xs) {
			if store.KindOfType(*s, xs[i]) == store.KRow {
				if store.KindOfType(*s, ys[i]) != store.KRow {
					return false
				}
				unifyRow(s, f, c, xs[i], ys[i])
				continue
			}
			if !nify(s, f, c, xs[i], ys[i], d) {
				return false
			}
		}
		return true
	}
	if kx == store.KRow {
		if ky != store.KRow {
			return false
		}
		unifyRow(s, f, c, x, y)
		return true
	}
	if kx == store.KSig {
		return ky == store.KSig && nifySig(s, f, c, x, y, d)
	}
	if kx == store.KSlice || kx == store.KMap || kx == store.KPointer || kx == store.KArray || kx == store.KTuple {
		if kx != ky {
			return false
		}
		let xs = store.OperandsOf(*s, x)
		let ys = store.OperandsOf(*s, y)
		if len(xs) != len(ys) {
			return false
		}
		// An array's first operand is its length: equal lengths are one id.
		for i in 0..len(xs) {
			if !nify(s, f, c, xs[i], ys[i], d) {
				return false
			}
		}
		return true
	}
	// A basic, named or foreign type: identity.
	x == y
}

// results is the count of results a signature's result operand stands
// for: none for the empty tuple, a tuple's length, else one.
func results(s store.Store, r dense.ID[store.TKey]) int {
	if store.KindOfType(s, r) == store.KTuple { len(store.OperandsOf(s, r)) } else { 1 }
}

// nifySig unifies two signatures: parameters and results, then the rows by
// the row rule. A result parameter matched against no result binds to no
// value (unify.go nifySig).
func nifySig(s mut store.Store, f mut Frame, c Call, x dense.ID[store.TKey], y dense.ID[store.TKey], d int) bool {
	let xs = store.OperandsOf(*s, x)
	let ys = store.OperandsOf(*s, y)
	if len(xs) != len(ys) {
		return false
	}
	let n = len(xs) - 3
	for i in 0..n {
		if !nify(s, f, c, xs[i], ys[i], d) {
			return false
		}
	}
	let xr = xs[n]
	let yr = ys[n]
	let rx = results(*s, xr)
	let ry = results(*s, yr)
	if rx == ry {
		if rx > 0 && !nify(s, f, c, xr, yr, d) {
			return false
		}
	} else if rx == 1 && ry == 0 {
		let k = slotOf(*s, c, xr)
		if k < 0 || !free(*f, c, k) {
			return false
		}
		Bind(f, c, k, NoValue(s))
	} else {
		return false
	}
	unifyRow(s, f, c, xs[n+1], ys[n+1])
	unifyRow(s, f, c, xs[n+2], ys[n+2])
	true
}

// unifyRow binds the free row parameter of the row p to the elements of
// the row a that p's other elements do not cover. A row parameter an
// earlier argument joined is widened to cover a as well: rows are sets
// ordered by inclusion, so the least binding that admits every argument
// is the union. A written type argument is never widened (call.go
// unifyRow).
func unifyRow(s mut store.Store, f mut Frame, c Call, p dense.ID[store.TKey], a dense.ID[store.TKey]) {
	f.steps = f.steps + 1
	if store.KindOfType(*s, p) != store.KRow || store.KindOfType(*s, a) != store.KRow {
		return
	}
	let mut firstFree = -1
	let mut frees = 0
	let mut firstJoined = -1
	let mut rest = []dense.ID[store.TKey]{}
	for e in store.OperandsOf(*s, p) {
		let k = slotOf(*s, c, e)
		if k >= 0 {
			match Binding(*f, c, k) {
			case None:
				if firstFree < 0 {
					firstFree = k
				}
				frees = frees + 1
				continue
			case Some[dense.ID[store.TKey]] as b:
				if store.KindOfType(*s, b.Value) == store.KRow {
					if f.slots[c.at+k].joined && firstJoined < 0 {
						firstJoined = k
					}
					rest = union(*s, rest, store.OperandsOf(*s, b.Value))
					continue
				}
			}
		}
		rest = union(*s, rest, []dense.ID[store.TKey]{e})
	}
	let extra = minus(*s, store.OperandsOf(*s, a), rest)
	if frees > 0 {
		let empty = store.TRow(s, []dense.ID[store.TKey]{})
		for e in store.OperandsOf(*s, p) {
			let k = slotOf(*s, c, e)
			if k >= 0 && free(*f, c, k) {
				Bind(f, c, k, if k == firstFree { store.TRow(s, extra) } else { empty })
				f.slots[c.at+k].joined = true
			}
		}
	} else if firstJoined >= 0 && len(extra) > 0 {
		match Binding(*f, c, firstJoined) {
		case Some[dense.ID[store.TKey]] as b:
			Bind(f, c, firstJoined, store.TRow(s, union(*s, store.OperandsOf(*s, b.Value), extra)))
		case None:
		}
	}
}

// union is the sorted union of two sorted runs of ids.
func union(s store.Store, a []dense.ID[store.TKey], b []dense.ID[store.TKey]) []dense.ID[store.TKey] {
	let mut out = []dense.ID[store.TKey]{}
	let mut i = 0
	let mut j = 0
	for i < len(a) || j < len(b) {
		if j >= len(b) || i < len(a) && dense.Index(a[i]) < dense.Index(b[j]) {
			out = out.Append(a[i])
			i = i + 1
		} else if i >= len(a) || dense.Index(b[j]) < dense.Index(a[i]) {
			out = out.Append(b[j])
			j = j + 1
		} else {
			out = out.Append(a[i])
			i = i + 1
			j = j + 1
		}
	}
	out
}

// minus is the ids of the sorted run a that the sorted run b lacks.
func minus(s store.Store, a []dense.ID[store.TKey], b []dense.ID[store.TKey]) []dense.ID[store.TKey] {
	let mut out = []dense.ID[store.TKey]{}
	let mut j = 0
	for x in a {
		for j < len(b) && dense.Index(b[j]) < dense.Index(x) {
			j = j + 1
		}
		if j < len(b) && b[j] == x {
			continue
		}
		out = out.Append(x)
	}
	out
}

// mentions is whether t mentions a parameter of c, bound or free (go/types
// isParameterized).
func mentions(s store.Store, f Frame, c Call, t dense.ID[store.TKey]) bool { walk(s, f, c, t, false) }

// hasFree is whether t mentions an unbound parameter of c.
func hasFree(s store.Store, f Frame, c Call, t dense.ID[store.TKey]) bool { walk(s, f, c, t, true) }

func walk(s store.Store, f Frame, c Call, t dense.ID[store.TKey], onlyFree bool) bool {
	let k = slotOf(s, c, t)
	if k >= 0 {
		return !onlyFree || free(f, c, k)
	}
	let kind = store.KindOfType(s, t)
	if kind == store.KBasic || kind == store.KNamed || kind == store.KParam || kind == store.KForeign {
		return false
	}
	for o in store.OperandsOf(s, t) {
		if walk(s, f, c, o, onlyFree) {
			return true
		}
	}
	false
}
