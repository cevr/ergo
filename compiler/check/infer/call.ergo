// The inference of one call, after the Go checker's callGeneric (call.go):
// the typed arguments unify in source order, then a parameter that only
// literals bind takes their common default (196u rule 6), then a row
// parameter nothing bound is the empty row.

import compiler/check/store
import dense

// Arg is what inference reads of one argument: its type, or a literal's
// default type (a literal binds a parameter only when no typed argument
// does), or nothing known (the call is not inferred).
type Arg = Typed | Literal | Unknown

// Typed is an argument of a known type.
type Typed { T dense.ID[store.TKey] }

// Literal is a constant literal argument and its default type.
type Literal { Default dense.ID[store.TKey] }

// Unknown is an argument whose type inference cannot read.
type Unknown {}

// Callee is a generic function as a call sees it: its parameter types in
// the caller's pool with its type parameters renamed to Base, Base+1, …,
// and whether each type parameter is a row parameter.
type Callee { Params []dense.ID[store.TKey], Rows []bool, Base int }

// Infer is the type arguments of a call to callee with the written type
// arguments explicit (a prefix of the callee's) and the arguments args, one
// per parameter, or none when the call is not inferred: an argument does
// not match, an unknown argument, two literals with different defaults
// for one parameter, or a type parameter nothing binds. The frame is
// begun on f and cut before Infer returns.
func Infer(s mut store.Store, f mut Frame, u Unions, callee Callee, explicit []dense.ID[store.TKey], args []Arg) Option[[]dense.ID[store.TKey]] {
	let (got, _) = InferAt(s, f, u, callee, explicit, args)
	got
}

// InferAt also returns the first unbound slot when argument matching
// succeeded but could not bind all the type parameters; -1 otherwise.
func InferAt(s mut store.Store, f mut Frame, u Unions, callee Callee, explicit []dense.ID[store.TKey], args []Arg) (Option[[]dense.ID[store.TKey]], int) {
	if len(args) != len(callee.Params) || len(explicit) > len(callee.Rows) {
		return (None, -1)
	}
	let c = Begin(f, callee.Rows, callee.Base)
	let mut unbound = -1
	let out = inferIn(s, f, u, c, callee, explicit, args, &unbound)
	End(f, c)
	(out, unbound)
}

// InferRecoversBindings: arguments made by substituting bindings into the
// callee's parameter types infer those bindings, T and U always, F when a
// parameter names it (else the empty row), whatever the caller's own
// parameter count; and the frame is cut after (C0/plan.md §2.6).
law InferRecoversBindings(picks []int) {
	let mut s = store.New("p", []string{})
	let mut f = NewFrame()
	let k = caseOf(&s, &f, picks)
	let empty = store.TRow(&s, []dense.ID[store.TKey]{})
	match Infer(&s, &f, NoUnions(), k.callee, []dense.ID[store.TKey]{}, k.args) {
	case Some[[]dense.ID[store.TKey]] as got:
		let wantF = if k.rowed { k.f } else { empty }
		len(got.Value) == 3 && got.Value[0] == k.t && got.Value[1] == k.u && got.Value[2] == wantF && Depth(f) == 0
	case None:
		false
	}
}

func at(xs []int, i int) int {
	if len(xs) == 0 {
		return i
	}
	let x = xs[i%len(xs)]
	let r = x % 1000003
	if r < 0 { r + 1000003 } else { r }
}

// form is a parameter type over T (slot 0), U (slot 1) and F (slot 2).
func form(s mut store.Store, c Call, k int) dense.ID[store.TKey] {
	let t = Param(s, c, 0)
	let u = Param(s, c, 1)
	let f = Param(s, c, 2)
	let none = store.TRow(s, []dense.ID[store.TKey]{})
	let k8 = k % 9
	if k8 == 0 {
		t
	} else if k8 == 1 {
		store.TSlice(s, t)
	} else if k8 == 2 {
		store.TMap(s, store.TBasic(s, 2), t)
	} else if k8 == 3 {
		store.TPointer(s, store.TArray(s, 3, t))
	} else if k8 == 4 {
		store.TTuple(s, []dense.ID[store.TKey]{t, u})
	} else if k8 == 5 {
		store.TSig(s, []dense.ID[store.TKey]{store.TOwn(s, t)}, u, store.TRow(s, []dense.ID[store.TKey]{f}), none)
	} else if k8 == 6 {
		// F beside a fixed element: F binds to what the argument adds.
		store.TSig(s, []dense.ID[store.TKey]{}, t, store.TRow(s, []dense.ID[store.TKey]{f, store.TBasic(s, 40)}), none)
	} else if k8 == 7 {
		store.TInstance(s, store.XRef{Import: uint32(0), Decl: uint32(7)}, []dense.ID[store.TKey]{t, store.TRow(s, []dense.ID[store.TKey]{f})})
	} else {
		store.TSig(s, []dense.ID[store.TKey]{u}, t, none, store.TRow(s, []dense.ID[store.TKey]{f}))
	}
}

// leaf is a closed type, or the caller's own first parameter.
func leaf(s mut store.Store, k int) dense.ID[store.TKey] {
	let k6 = k % 6
	if k6 == 0 {
		store.TBasic(s, 3)
	} else if k6 == 1 {
		store.TBasic(s, 2)
	} else if k6 == 2 {
		store.TSlice(s, store.TBasic(s, 15))
	} else if k6 == 3 {
		store.TMap(s, store.TBasic(s, 2), store.TBasic(s, 1))
	} else if k6 == 4 {
		store.TInstance(s, store.XRef{Import: uint32(1), Decl: uint32(2)}, []dense.ID[store.TKey]{store.TBasic(s, 6)})
	} else {
		store.TParam(s, 0)
	}
}

// row is a closed row of stand-in error types (never the fixed one, 40).
func row(s mut store.Store, k int) dense.ID[store.TKey] {
	let mut es = []dense.ID[store.TKey]{store.TBasic(s, 30+k%3)}
	if k%2 == 1 {
		es = es.Append(store.TBasic(s, 34))
	}
	store.TRow(s, es)
}

// Case is a callee of two parameters, the second always a tuple of T and
// U so both are bound, and the bindings an argument of each was made
// with.
type Case { callee Callee, args []Arg, t dense.ID[store.TKey], u dense.ID[store.TKey], f dense.ID[store.TKey], rowed bool }

func caseOf(s mut store.Store, f mut Frame, picks []int) Case {
	let base = 1 + at(picks, 0)%3
	let c = Begin(f, []bool{false, false, true}, base)
	let p0 = form(s, c, at(picks, 1))
	let p1 = store.TTuple(s, []dense.ID[store.TKey]{Param(s, c, 0), Param(s, c, 1)})
	End(f, c)
	let bt = leaf(s, at(picks, 2))
	let bu = leaf(s, at(picks, 3))
	let bf = row(s, at(picks, 4))
	let mut subst = []dense.ID[store.TKey]{}
	for i in 0..base {
		subst = subst.Append(store.TParam(s, i))
	}
	subst = subst.Append(bt).Append(bu).Append(bf)
	let rowed = at(picks, 1)%9 >= 5
	// A row binding substitutes as an element of the row it stands in: the
	// argument's row is the binding's elements, so flatten them.
	let a0 = flatten(s, store.TSubst(s, p0, subst))
	let a1 = store.TSubst(s, p1, subst)
	Case{callee: Callee{Params: []dense.ID[store.TKey]{p0, p1}, Rows: []bool{false, false, true}, Base: base}, args: []Arg{Typed{T: a0}, Typed{T: a1}}, t: bt, u: bu, f: bf, rowed: rowed}
}

// flatten is t with each row's row elements spliced into it.
func flatten(s mut store.Store, t dense.ID[store.TKey]) dense.ID[store.TKey] {
	let k = store.KindOfType(*s, t)
	if k == store.KBasic || k == store.KNamed || k == store.KParam || k == store.KForeign {
		return t
	}
	let mut ts = []dense.ID[store.TKey]{}
	for o in store.OperandsOf(*s, t) {
		let x = flatten(s, o)
		if k == store.KRow && store.KindOfType(*s, x) == store.KRow {
			for e in store.OperandsOf(*s, x) {
				ts = ts.Append(e)
			}
		} else {
			ts = ts.Append(x)
		}
	}
	if k == store.KRow {
		return store.TRow(s, ts)
	}
	if k == store.KInstance {
		return store.TInstance(s, store.OriginOfType(*s, t), ts)
	}
	rebuild(s, t, ts)
}

// rebuild is a type of t's kind over the operands ts.
func rebuild(s mut store.Store, t dense.ID[store.TKey], ts []dense.ID[store.TKey]) dense.ID[store.TKey] {
	let k = store.KindOfType(*s, t)
	if k == store.KSlice {
		store.TSlice(s, ts[0])
	} else if k == store.KMap {
		store.TMap(s, ts[0], ts[1])
	} else if k == store.KPointer {
		store.TPointer(s, ts[0])
	} else if k == store.KArray {
		store.TArray(s, store.ArrayLen(*s, t), ts[1])
	} else if k == store.KTuple {
		store.TTuple(s, ts)
	} else if k == store.KOwn {
		store.TOwn(s, ts[0])
	} else if k == store.KSig {
		let n = len(ts) - 3
		store.TSigWith(s, ts[0:n], ts[n], ts[n+1], ts[n+2], store.SigDefects(*s, t))
	} else {
		t
	}
}

// InferRejectsMismatches: a call infers nothing when an argument has
// another shape than its parameter (a tuple of another length; a pointer
// where the parameter is a slice), when an argument conflicts with what an
// earlier one bound, or when a type parameter no argument names stays
// unbound.
law InferRejectsMismatches(picks []int) {
	let mut s = store.New("p", []string{})
	let mut f = NewFrame()
	let k = caseOf(&s, &f, picks)
	let none = []dense.ID[store.TKey]{}
	let wrong = store.TTuple(&s, []dense.ID[store.TKey]{k.t, k.u, k.t})
	let bad = Infer(&s, &f, NoUnions(), k.callee, none, []Arg{k.args[0], Typed{T: wrong}})
	let c = Begin(&f, []bool{false, false, true}, k.callee.Base)
	let t = Param(&s, c, 0)
	let slice = store.TSlice(&s, t)
	let pair = store.TTuple(&s, []dense.ID[store.TKey]{t, Param(&s, c, 1)})
	End(&f, c)
	let b = store.TBasic(&s, 2+at(picks, 5)%14)
	let other = store.TBasic(&s, 16)
	let shape = Infer(&s, &f, NoUnions(), Callee{Params: []dense.ID[store.TKey]{slice, pair}, Rows: k.callee.Rows, Base: k.callee.Base}, none, []Arg{Typed{T: store.TPointer(&s, b)}, Typed{T: store.TTuple(&s, []dense.ID[store.TKey]{b, b})}})
	let conflict = Infer(&s, &f, NoUnions(), Callee{Params: []dense.ID[store.TKey]{t, pair}, Rows: k.callee.Rows, Base: k.callee.Base}, none, []Arg{Typed{T: b}, Typed{T: store.TTuple(&s, []dense.ID[store.TKey]{other, b})}})
	let unbound = Infer(&s, &f, NoUnions(), Callee{Params: []dense.ID[store.TKey]{slice}, Rows: k.callee.Rows, Base: k.callee.Base}, none, []Arg{Typed{T: store.TSlice(&s, b)}})
	isNone(bad) && isNone(shape) && isNone(conflict) && isNone(unbound) && Depth(f) == 0
}

func isNone[T](o Option[T]) bool {
	match o {
	case Some[T]:
		false
	case None:
		true
	}
}

// InferStepsPerCallAreConstant: inferring n calls and 2n calls of one
// callee takes twice the steps (the counted guard of C0/plan.md §2.6:
// no call's work grows with the calls before it).
law InferStepsPerCallAreConstant(picks []int, n int) {
	let m = 1 + at([]int{n}, 0)%16
	let mut s = store.New("p", []string{})
	let mut f = NewFrame()
	let k = caseOf(&s, &f, picks)
	for _ in 0..m {
		Infer(&s, &f, NoUnions(), k.callee, []dense.ID[store.TKey]{}, k.args)
	}
	let one = Steps(f)
	for _ in 0..m {
		Infer(&s, &f, NoUnions(), k.callee, []dense.ID[store.TKey]{}, k.args)
	}
	one > 0 && Steps(f) == 2*one && Depth(f) == 0
}

func inferIn(s mut store.Store, f mut Frame, u Unions, c Call, callee Callee, explicit []dense.ID[store.TKey], args []Arg, unbound mut int) Option[[]dense.ID[store.TKey]] {
	for i, t in explicit {
		Bind(f, c, i, t)
	}
	let all = len(explicit) == c.n
	for i, a in args {
		match a {
		case Unknown:
			return None
		case Literal:
		case Typed as ta:
			if !Argument(s, f, u, c, callee.Params[i], ta.T, all) {
				return None
			}
		}
	}
	Finish(s, f, c, callee.Params, args, all, unbound)
}

// Argument unifies a typed argument in source order. A fully written
// instantiation, or a parameter with no variables of this call, needs
// assignment only and binds nothing.
func Argument(s mut store.Store, f mut Frame, u Unions, c Call, param dense.ID[store.TKey], arg dense.ID[store.TKey], all bool) bool {
	all || !mentions(*s, *f, c, param) || Unify(s, f, u, c, param, arg)
}

// Expected is the instantiated parameter type when its type arguments
// are all known at this argument's turn. The caller's own variables stay
// intact: they are below the slots of this call.
func Expected(s mut store.Store, f Frame, c Call, param dense.ID[store.TKey]) Option[dense.ID[store.TKey]] {
	if !mentions(*s, f, c, param) {
		return Some{Value: param}
	}
	if hasFree(*s, f, c, param) {
		return None
	}
	let mut bindings = []dense.ID[store.TKey]{}
	for i in 0..c.base {
		bindings = bindings.Append(store.TParam(s, i))
	}
	for i in 0..c.n {
		match Binding(f, c, i) {
		case Some{Value: b}:
			bindings = bindings.Append(b)
		case None:
			bindings = bindings.Append(Param(s, c, i))
		}
	}
	Some{Value: store.TSubst(s, param, bindings)}
}

// Finish applies the deferred literal defaults after the typed arguments,
// then reads the type arguments (unbound row variables are empty).
func Finish(s mut store.Store, f mut Frame, c Call, params []dense.ID[store.TKey], args []Arg, all bool, unbound mut int) Option[[]dense.ID[store.TKey]] {
	if !all {
		// A parameter that only literals bind takes their common default;
		// two different defaults name no type (S108).
		for i, a in args {
			match a {
			case Literal as l:
				let k = slotOf(*s, c, params[i])
				if k < 0 {
					continue
				}
				match Binding(*f, c, k) {
				case None:
					Bind(f, c, k, l.Default)
					// A default, not a unification: a later literal compares.
					f.slots[c.at+k].joined = true
				case Some{Value: b}:
					if f.slots[c.at+k].joined && b != l.Default {
						return None
					}
				}
			case _:
			}
		}
	}
	let mut targs = []dense.ID[store.TKey]{}
	for i in 0..c.n {
		match Binding(*f, c, i) {
		case Some{Value: b}:
			targs = targs.Append(b)
		case None:
			if !f.slots[c.at+i].row {
				// Outside the inferred subset: write the type arguments.
				*unbound = i
				return None
			}
			targs = targs.Append(store.TRow(s, []dense.ID[store.TKey]{}))
		}
	}
	Some{Value: targs}
}
