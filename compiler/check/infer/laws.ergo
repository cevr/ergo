// The laws of package infer, over callees whose parameter types the
// seeded picks build from every form unification walks, in a pool of
// their own: T and U are the callee's type parameters, F its row
// parameter, at positions base, base+1 and base+2 past the caller's own.

import compiler/check/store
import dense

func isNone[T](o Option[T]) bool {
	match o {
	case Some[T]:
		false
	case None:
		true
	}
}

func at(xs []int, i int) int {
	if len(xs) == 0 {
		return i
	}
	let x = xs[i%len(xs)]
	let r = x % 1000003
	if r < 0 { r + 1000003 } else { r }
}

// form is a parameter type over T (slot 0), U (slot 1) and F (slot 2).
func form(s *store.Store, c Call, k int) dense.ID[store.TKey] {
	let t = Param(s, c, 0)
	let u = Param(s, c, 1)
	let f = Param(s, c, 2)
	let none = store.TRow(s, []dense.ID[store.TKey]{})
	let k8 = k % 9
	if k8 == 0 {
		t
	} else if k8 == 1 {
		store.TSlice(s, t)
	} else if k8 == 2 {
		store.TMap(s, store.TBasic(s, 2), t)
	} else if k8 == 3 {
		store.TPointer(s, store.TArray(s, 3, t))
	} else if k8 == 4 {
		store.TTuple(s, []dense.ID[store.TKey]{t, u})
	} else if k8 == 5 {
		store.TSig(s, []dense.ID[store.TKey]{store.TOwn(s, t)}, u, store.TRow(s, []dense.ID[store.TKey]{f}), none)
	} else if k8 == 6 {
		// F beside a fixed element: F binds to what the argument adds.
		store.TSig(s, []dense.ID[store.TKey]{}, t, store.TRow(s, []dense.ID[store.TKey]{f, store.TBasic(s, 40)}), none)
	} else if k8 == 7 {
		store.TInstance(s, store.XRef{Import: uint32(0), Decl: uint32(7)}, []dense.ID[store.TKey]{t, store.TRow(s, []dense.ID[store.TKey]{f})})
	} else {
		store.TSig(s, []dense.ID[store.TKey]{u}, t, none, store.TRow(s, []dense.ID[store.TKey]{f}))
	}
}

// leaf is a closed type, or the caller's own first parameter.
func leaf(s *store.Store, k int) dense.ID[store.TKey] {
	let k6 = k % 6
	if k6 == 0 {
		store.TBasic(s, 3)
	} else if k6 == 1 {
		store.TBasic(s, 2)
	} else if k6 == 2 {
		store.TSlice(s, store.TBasic(s, 15))
	} else if k6 == 3 {
		store.TMap(s, store.TBasic(s, 2), store.TBasic(s, 1))
	} else if k6 == 4 {
		store.TInstance(s, store.XRef{Import: uint32(1), Decl: uint32(2)}, []dense.ID[store.TKey]{store.TBasic(s, 6)})
	} else {
		store.TParam(s, 0)
	}
}

// row is a closed row of stand-in error types (never the fixed one, 40).
func row(s *store.Store, k int) dense.ID[store.TKey] {
	let mut es = []dense.ID[store.TKey]{store.TBasic(s, 30+k%3)}
	if k%2 == 1 {
		es = es.Append(store.TBasic(s, 34))
	}
	store.TRow(s, es)
}

// Case is a callee of two parameters, the second always a tuple of T and
// U so both are bound, and the bindings an argument of each was made
// with.
type Case { callee Callee, args []Arg, t dense.ID[store.TKey], u dense.ID[store.TKey], f dense.ID[store.TKey], rowed bool }

func caseOf(s *store.Store, f *Frame, picks []int) Case {
	let base = 1 + at(picks, 0)%3
	let c = Begin(f, []bool{false, false, true}, base)
	let p0 = form(s, c, at(picks, 1))
	let p1 = store.TTuple(s, []dense.ID[store.TKey]{Param(s, c, 0), Param(s, c, 1)})
	End(f, c)
	let bt = leaf(s, at(picks, 2))
	let bu = leaf(s, at(picks, 3))
	let bf = row(s, at(picks, 4))
	let mut subst = []dense.ID[store.TKey]{}
	for i in 0..base {
		subst = subst.Append(store.TParam(s, i))
	}
	subst = subst.Append(bt).Append(bu).Append(bf)
	let rowed = at(picks, 1)%9 >= 5
	// A row binding substitutes as an element of the row it stands in: the
	// argument's row is the binding's elements, so flatten them.
	let a0 = flatten(s, store.TSubst(s, p0, subst))
	let a1 = store.TSubst(s, p1, subst)
	Case{callee: Callee{Params: []dense.ID[store.TKey]{p0, p1}, Rows: []bool{false, false, true}, Base: base}, args: []Arg{Typed{T: a0}, Typed{T: a1}}, t: bt, u: bu, f: bf, rowed: rowed}
}

// flatten is t with each row's row elements spliced into it.
func flatten(s *store.Store, t dense.ID[store.TKey]) dense.ID[store.TKey] {
	let k = store.KindOfType(*s, t)
	if k == store.KBasic || k == store.KNamed || k == store.KParam || k == store.KForeign {
		return t
	}
	let mut ts = []dense.ID[store.TKey]{}
	for o in store.OperandsOf(*s, t) {
		let x = flatten(s, o)
		if k == store.KRow && store.KindOfType(*s, x) == store.KRow {
			for e in store.OperandsOf(*s, x) {
				ts = ts.Append(e)
			}
		} else {
			ts = ts.Append(x)
		}
	}
	if k == store.KRow {
		return store.TRow(s, ts)
	}
	if k == store.KInstance {
		return store.TInstance(s, store.OriginOfType(*s, t), ts)
	}
	rebuild(s, t, ts)
}

// rebuild is a type of t's kind over the operands ts.
func rebuild(s *store.Store, t dense.ID[store.TKey], ts []dense.ID[store.TKey]) dense.ID[store.TKey] {
	let k = store.KindOfType(*s, t)
	if k == store.KSlice {
		store.TSlice(s, ts[0])
	} else if k == store.KMap {
		store.TMap(s, ts[0], ts[1])
	} else if k == store.KPointer {
		store.TPointer(s, ts[0])
	} else if k == store.KArray {
		store.TArray(s, store.ArrayLen(*s, t), ts[1])
	} else if k == store.KTuple {
		store.TTuple(s, ts)
	} else if k == store.KOwn {
		store.TOwn(s, ts[0])
	} else if k == store.KSig {
		let n = len(ts) - 3
		store.TSig(s, ts[0:n], ts[n], ts[n+1], ts[n+2])
	} else {
		t
	}
}

// InferRecoversBindings: arguments made by substituting bindings into the
// callee's parameter types infer those bindings, T and U always, F when a
// parameter names it (else the empty row), whatever the caller's own
// parameter count; and the frame is cut after (C0/plan.md §2.6).
law InferRecoversBindings(picks []int) {
	let mut s = store.New("p", []string{})
	let mut f = NewFrame()
	let k = caseOf(&s, &f, picks)
	let empty = store.TRow(&s, []dense.ID[store.TKey]{})
	match Infer(&s, &f, k.callee, []dense.ID[store.TKey]{}, k.args) {
	case Some[[]dense.ID[store.TKey]] as got:
		let wantF = if k.rowed { k.f } else { empty }
		len(got.Value) == 3 && got.Value[0] == k.t && got.Value[1] == k.u && got.Value[2] == wantF && Depth(f) == 0
	case None:
		false
	}
}

// InferRejectsMismatches: a call infers nothing when an argument has
// another shape than its parameter (a tuple of another length; a pointer
// where the parameter is a slice), when an argument conflicts with what an
// earlier one bound, or when a type parameter no argument names stays
// unbound.
law InferRejectsMismatches(picks []int) {
	let mut s = store.New("p", []string{})
	let mut f = NewFrame()
	let k = caseOf(&s, &f, picks)
	let none = []dense.ID[store.TKey]{}
	let wrong = store.TTuple(&s, []dense.ID[store.TKey]{k.t, k.u, k.t})
	let bad = Infer(&s, &f, k.callee, none, []Arg{k.args[0], Typed{T: wrong}})
	let c = Begin(&f, []bool{false, false, true}, k.callee.Base)
	let t = Param(&s, c, 0)
	let slice = store.TSlice(&s, t)
	let pair = store.TTuple(&s, []dense.ID[store.TKey]{t, Param(&s, c, 1)})
	End(&f, c)
	let b = store.TBasic(&s, 2+at(picks, 5)%14)
	let other = store.TBasic(&s, 16)
	let shape = Infer(&s, &f, Callee{Params: []dense.ID[store.TKey]{slice, pair}, Rows: k.callee.Rows, Base: k.callee.Base}, none, []Arg{Typed{T: store.TPointer(&s, b)}, Typed{T: store.TTuple(&s, []dense.ID[store.TKey]{b, b})}})
	let conflict = Infer(&s, &f, Callee{Params: []dense.ID[store.TKey]{t, pair}, Rows: k.callee.Rows, Base: k.callee.Base}, none, []Arg{Typed{T: b}, Typed{T: store.TTuple(&s, []dense.ID[store.TKey]{other, b})}})
	let unbound = Infer(&s, &f, Callee{Params: []dense.ID[store.TKey]{slice}, Rows: k.callee.Rows, Base: k.callee.Base}, none, []Arg{Typed{T: store.TSlice(&s, b)}})
	isNone(bad) && isNone(shape) && isNone(conflict) && isNone(unbound) && Depth(f) == 0
}

// FramesNest: an inference begun inside another, as a call's argument's
// own call is, leaves the outer frame's bindings as they were, and the
// outer frame's end cuts the stack to where it began.
law FramesNest(picks []int) {
	let mut s = store.New("p", []string{})
	let mut f = NewFrame()
	let outer = Begin(&f, []bool{false, true}, 5)
	Bind(&f, outer, 0, store.TBasic(&s, 3))
	let k = caseOf(&s, &f, picks)
	let inner = Infer(&s, &f, k.callee, []dense.ID[store.TKey]{}, k.args)
	let kept = match Binding(f, outer, 0) {
	case Some[dense.ID[store.TKey]] as b:
		b.Value == store.TBasic(&s, 3)
	case None:
		false
	}
	let unbound = isNone(Binding(f, outer, 1))
	let depth = Depth(f)
	End(&f, outer)
	!isNone(inner) && kept && unbound && depth == 2 && Depth(f) == 0
}

// InferStepsPerCallAreConstant: inferring n calls and 2n calls of one
// callee takes twice the steps (the counted guard of C0/plan.md §2.6:
// no call's work grows with the calls before it).
law InferStepsPerCallAreConstant(picks []int, n int) {
	let m = 1 + at([]int{n}, 0)%16
	let mut s = store.New("p", []string{})
	let mut f = NewFrame()
	let k = caseOf(&s, &f, picks)
	for _ in 0..m {
		Infer(&s, &f, k.callee, []dense.ID[store.TKey]{}, k.args)
	}
	let one = Steps(f)
	for _ in 0..m {
		Infer(&s, &f, k.callee, []dense.ID[store.TKey]{}, k.args)
	}
	one > 0 && Steps(f) == 2*one && Depth(f) == 0
}
