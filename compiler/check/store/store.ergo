import dense
import slices
import strings

// Store is one package's tables, owned by its package task (C0/plan.md
// §2): its names, its scope, its declarations, its objects and its type
// pool, with the package path and the sorted import paths an XRef's
// import index reads.
type Store {
	path    string,
	imports []string,
	names   dense.Strings,
	scope   dense.Col[dense.Str, dense.Opt[Decl]],
	decls   dense.Table[Decl],
	objects Objects,
	pool    Pool,
}

// New is the empty store of the package at path, which imports the
// packages at imports (sorted by the caller's load step).
func New(path string, imports []string) Store {
	Store{
		path:    path,
		imports: imports,
		names:   dense.NewStrings(),
		scope:   dense.NewCol[dense.Str, dense.Opt[Decl]](),
		decls:   dense.New[Decl](),
		objects: NewObjects(),
		pool:    NewPool(),
	}
}

// Name is the id of text, with a slot in the scope column (C0b's name).
func Name(s *Store, text string) dense.ID[dense.Str] {
	let id = dense.InternText(&s.names, text)
	for !dense.In(s.scope, id) {
		dense.Push(&s.scope, dense.NoID[Decl]())
	}
	id
}

// Text is the text of a name id.
func Text(s Store, n dense.ID[dense.Str]) string { dense.Text(s.names, n) }

// Declare puts a package-level declaration of name n (from Name), of
// object o, whose row names n too, and binds the name in the package
// scope. Bind refuses a second declaration of a name before it calls
// Declare.
func Declare(s *Store, n dense.ID[dense.Str], file int, node int, o Object) dense.ID[Decl] {
	let r = Add(&s.objects, o)
	let d = dense.Put(&s.decls, Decl{Kind: uint8(KindOf(r)), Name: n, File: uint32(file), Node: uint32(node), Obj: r})
	dense.SetOf(&s.scope, n, dense.OptOf(d))
	d
}

// Lookup is the package-level declaration of text, if any.
func Lookup(s Store, text string) Option[dense.ID[Decl]] {
	match dense.FindText(s.names, text) {
	case Some[dense.ID[dense.Str]] as n:
		dense.Unpack(dense.Of(s.scope, n.Value))
	case None:
		None
	}
}

// DeclOf is the row of d.
func DeclOf(s Store, d dense.ID[Decl]) Decl { dense.At(s.decls, d) }

// Frozen is a package's store after its check: immutable, moved into the
// value every importer task shares with no lock (C0/plan.md §4, Decided
// 10: the interface is the store, not an export copy).
type Frozen { s Store }

// Freeze ends the package's writes: the store moves into its interface.
func Freeze(s Store) Frozen { Frozen{s: s} }

// Of is the store a frozen interface reads.
func Of(f Frozen) Store { f.s }

// Canon is t's canonical key: the same text for the same type in any
// package's pool (C0/plan.md §2.4 ruling). A named type and an instance's
// origin are named by package path and declaration name, through deps,
// the frozen interfaces of s's imports in s's import order; a row's
// elements are in their keys' order, since local ids order them
// differently in each pool.
func Canon(s Store, deps []Frozen, t dense.ID[TKey]) string {
	let k = Key(s.pool, t)
	let kind = int(k.k)
	if kind == tBasic {
		return "B\(k.a)"
	}
	if kind == tParam {
		return "P\(k.a)"
	}
	if kind == tNamed {
		let row = dense.Rows(s.objects.typeNames)[int(k.a)]
		return "N(\(s.path).\(Text(s, row.Name)))"
	}
	let mut parts = []string{}
	for o in Operands(s.pool, t) {
		parts = parts.Append(Canon(s, deps, o))
	}
	if kind == tRow {
		return "R(" + strings.Join(slices.Sort(parts), ",") + ")"
	}
	if kind == tInstance {
		return "I(" + declName(s, deps, OriginOf(s.pool, t)) + ";" + strings.Join(parts, ",") + ")"
	}
	let tag = if kind == tSlice { "S" } else if kind == tMap { "M" } else if kind == tFunc { "F" } else if kind == tRecord { "C" } else { "U" }
	tag + "(" + strings.Join(parts, ",") + ")"
}

// declName is "path.name" of the declaration x names.
func declName(s Store, deps []Frozen, x XRef) string {
	if x.Import == uint32(0) {
		return "\(s.path).\(Text(s, dense.Rows(s.decls)[int(x.Decl)].Name))"
	}
	let d = Of(deps[int(x.Import)-1])
	"\(d.path).\(Text(d, dense.Rows(d.decls)[int(x.Decl)].Name))"
}

// InstanceIdentityIsKey (C0/plan.md §2.4 ruling): program xs built in
// package a and program ys in package b, whose pool was given other types
// first, give types with equal canonical keys exactly when the model's
// texts are equal. So two packages' instances of one origin at equal
// arguments are one type, though their local ids differ, and a named type
// of a is never one of b. (S3c runs the same law across 1 and 8 threads.)
law InstanceIdentityIsKey(xs []int, ys []int) {
	let deps = []Frozen{lib()}
	let (a0, an) = setup("a", false)
	let (b0, bn) = setup("b", true)
	let mut a = a0
	let mut b = b0
	let ta = build(&a, an, xs)
	let tb = build(&b, bn, ys)
	let ma = model("a", xs, []string{})
	let mb = model("b", ys, []string{})
	let mut ok = true
	for i, t in ta {
		ok = ok && Canon(a, deps, t) == ma[i]
		for j, u in tb {
			ok = ok && (Canon(a, deps, t) == Canon(b, deps, u)) == (ma[i] == mb[j])
		}
	}
	ok
}
