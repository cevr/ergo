	LawParamNames  []uint32,
	LawParamTypes  []uint32,
	ParseTypeNames []uint32,
	ParseFnNames   []uint32,
	ParseSigs      []uint32,
	// Cross-package function claim table sorted canonically.
	FClaimRoleImp   []uint32,
	FClaimRoleName  []uint32,
	FClaimReceiver  []uint32,
	FClaimBindStart []uint32,
	FClaimPosStart  []uint32,
	FClaimMemStart  []uint32,
	FClaimBinds     []uint32,
	FClaimPositions []uint32,
	FClaimMemNames  []uint32,
	FClaimMemTypes  []uint32,
}

// LowerSection stores cross-package lowering hints and ABI tables separate from CheckSection.
type LowerSection {
	// Syms holds strings referenced exclusively by lowering tables.
	Syms SymPool,
	// Types holds lowering-specific physical field and capability type trees.
	Types TypePool,
	// Tokens holds position-free inline body templates for eligible functions.
	Tokens TokenPool,
	// ImportPaths lists sorted import path symbol IDs whose lowering assumptions matter.
	ImportPaths []uint32,
	// ImportLower lists expected LowerDigest per import.
	ImportLower []Digest,
	// Exported function lowering hints sorted by function name.
	FnNames      []uint32,
	FnFlags      []uint32,
	FnInlineCost []uint32,
	FnCapStarts  []uint32,
	FnAbiStarts  []uint32,
	FnTokStarts  []uint32,
	FnTokEnds    []uint32,
	FnCaps       []uint32,
	FnParamAbis  []uint8,
	// Exported type physical ABI and full record field representations.
	TyNames           []uint32,
	TyValueAbi        []uint8,
	TyRuntimeGo       []uint32,
	TyPhysFieldStarts []uint32,
	PhysFieldNames    []uint32,
	PhysFieldTypes    []uint32,
	PhysFieldFlags    []uint32,
}

// Summary pairs canonical CheckSection and LowerSection facts under verified digests.
type Summary {
	// Header holds package identity, flags, and SHA-256 digests.
	Header Header,
	// Check holds the canonical type-check interface and semantic facts.
	Check CheckSection,
	// Lower holds the canonical lowering hints, caps, and physical value representations.
	Lower LowerSection,
}

// ZeroDigest returns the all-zero 256-bit digest sentinel.
func ZeroDigest() Digest {
	Digest{W0: uint64(0), W1: uint64(0), W2: uint64(0), W3: uint64(0)}
}

// IsZeroDigest reports whether d equals the zero sentinel digest.
func IsZeroDigest(d Digest) bool {
	d.W0 == uint64(0) && d.W1 == uint64(0) && d.W2 == uint64(0) && d.W3 == uint64(0)
}

// DigestHex formats d as a 64-character lowercase hexadecimal string.
func DigestHex(d Digest) string {
	let mut bs = slices.WithCapacity[byte](32)
	bs = appendU64LE(bs, d.W0)
	bs = appendU64LE(bs, d.W1)
	bs = appendU64LE(bs, d.W2)
	bs = appendU64LE(bs, d.W3)
	hex.Encode(bs.Text())
}

// DigestFromRaw packs 32 raw SHA-256 bytes into a Digest.
func DigestFromRaw(raw string) option.Option[Digest] {
	let bs = strings.Bytes(raw)
	if bs.Len() != 32 {
		return option.None
	}
	let d = Digest{
		W0: readU64LE(bs, 0),
		W1: readU64LE(bs, 8),
		W2: readU64LE(bs, 16),
		W3: readU64LE(bs, 24),
	}
	option.Some{Value: d}
}

func appendU64LE(dst []byte, v uint64) []byte {
	let mut out = dst
	out = out.Append(byte(v & uint64(255)))
	out = out.Append(byte((v >> uint64(8)) & uint64(255)))
	out = out.Append(byte((v >> uint64(16)) & uint64(255)))
	out = out.Append(byte((v >> uint64(24)) & uint64(255)))
	out = out.Append(byte((v >> uint64(32)) & uint64(255)))
	out = out.Append(byte((v >> uint64(40)) & uint64(255)))
	out = out.Append(byte((v >> uint64(48)) & uint64(255)))
	out = out.Append(byte((v >> uint64(56)) & uint64(255)))
	out
}

func readU64LE(bs []byte, at int) uint64 {
	let b0 = uint64(bs[at])
	let b1 = uint64(bs[at+1]) << uint64(8)
	let b2 = uint64(bs[at+2]) << uint64(16)
	let b3 = uint64(bs[at+3]) << uint64(24)
	let b4 = uint64(bs[at+4]) << uint64(32)
	let b5 = uint64(bs[at+5]) << uint64(40)
	let b6 = uint64(bs[at+6]) << uint64(48)
	let b7 = uint64(bs[at+7]) << uint64(56)
	b0 | b1 | b2 | b3 | b4 | b5 | b6 | b7
}

// NewSymPool initializes an empty string pool.
func NewSymPool() SymPool {
	SymPool{
		Bytes:   []byte{},
		Offs:    []uint32{uint32(0)},
		Buckets: makeZeroBuckets(16),
	}
}

func makeZeroBuckets(n int) []uint32 {
	let mut bs = slices.WithCapacity[uint32](n)
	for i in 0..n {
		let _ = i
		bs = bs.Append(uint32(0))
	}
	bs
}

func hashStrBytes(s string) uint32 {
	let bs = strings.Bytes(s)
	let mut h = uint32(2166136261)
	for i in 0..bs.Len() {
		h = (h ^ uint32(bs[i])) * uint32(16777619)
	}
	h
}

// SymCount returns the number of interned strings in p.
func SymCount(p SymPool) int {
	if p.Offs.Len() == 0 {
		return 0
	}
	p.Offs.Len() - 1
}

// SymText returns the string stored at SymPool index id.
func SymText(p SymPool, id uint32) string {
	if id == NoIdx || int(id)+1 >= p.Offs.Len() {
		return ""
	}
	let lo = int(p.Offs[int(id)])
	let hi = int(p.Offs[int(id)+1])
	p.Bytes.Slice(lo, hi).Text()
}

// InternSym inserts s into p if absent and returns its unsigned uint32 ID.
func InternSym(p mut SymPool, s string) uint32 {
	if p.Offs.Len() == 0 {
		*p = NewSymPool()
	}
	let count = SymCount(*p)
	if (count+1)*2 > p.Buckets.Len() {
		rehashSymPool(p, p.Buckets.Len()*2)
	}
	let mask = uint32(p.Buckets.Len() - 1)
	let mut slot = hashStrBytes(s) & mask
	for {
		let entry = p.Buckets[int(slot)]
		if entry == uint32(0) {
			let id = uint32(SymCount(*p))
			p.Bytes = p.Bytes.AppendString(s)
			p.Offs = p.Offs.Append(uint32(p.Bytes.Len()))
			p.Buckets[int(slot)] = id + uint32(1)
			return id
		}
		let id = entry - uint32(1)
		if SymText(*p, id) == s {
			return id
		}
		slot = (slot + uint32(1)) & mask
	}
}

func rehashSymPool(p mut SymPool, capN int) {
	let mut bs = makeZeroBuckets(capN)
	let mask = uint32(capN - 1)
	let n = SymCount(*p)
	for i in 0..n {
		let s = SymText(*p, uint32(i))
		let mut slot = hashStrBytes(s) & mask
		for bs[int(slot)] != uint32(0) {
			slot = (slot + uint32(1)) & mask
		}
		bs[int(slot)] = uint32(i) + uint32(1)
	}
	p.Buckets = bs
}

// FindSym looks up s in p and returns its uint32 ID or NoIdx if absent.
func FindSym(p SymPool, s string) uint32 {
	if p.Buckets.Len() == 0 {
		return NoIdx
	}
	let mask = uint32(p.Buckets.Len() - 1)
	let mut slot = hashStrBytes(s) & mask
	for {
		let entry = p.Buckets[int(slot)]
		if entry == uint32(0) {
			return NoIdx
		}
		let id = entry - uint32(1)
		if SymText(p, id) == s {
			return id
		}
		slot = (slot + uint32(1)) & mask
	}
}

// NewTokenPool creates an empty position-free TokenPool.
func NewTokenPool() TokenPool {
	TokenPool{Kinds: []uint8{}, Texts: []uint32{}}
}

