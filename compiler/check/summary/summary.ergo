import hex
import option
import slices
import strings

// FormatVersion identifies the canonical binary summary wire format.
let FormatVersion = uint32(1)

// NoIdx is the unsigned 32-bit sentinel representing an absent index or ID.
let NoIdx = uint32(4294967295)

// Header and capability flags carried in a package summary.
let FlagPrelude = uint32(1)
let FlagHasGeneric = uint32(2)
let FlagParseFailed = uint32(4)

// Declaration kind discriminants stored in CheckSection.
let DeclFunc = uint8(1)
let DeclType = uint8(2)
let DeclVar = uint8(3)
let DeclConst = uint8(4)
let DeclContext = uint8(5)
let DeclLaw = uint8(6)
let DeclParse = uint8(7)

// Type declaration subkinds stored in CheckSection.
let TyAlias = uint8(1)
let TyDefined = uint8(2)
let TyRefined = uint8(3)
let TyStruct = uint8(4)
let TyUnion = uint8(5)
let TyOp = uint8(6)
let TyMachine = uint8(7)

// Function parameter passing modes.
let ParamVal = uint8(0)
let ParamTakes = uint8(1)
let ParamMut = uint8(2)
let ParamOwn = uint8(3)
let ParamEntry = uint8(4)

// Function fact clause kinds matching syntax fact clauses.
let FactGiven = uint8(0)
let FactGives = uint8(1)
let FactKeeps = uint8(2)

// Check-section function flags.
let FnFlagClose = uint32(1)
let FnFlagGeneric = uint32(2)
let FnFlagEntry = uint32(4)
let FnFlagExtern = uint32(8)
let FnFlagPure = uint32(16)
let FnFlagHasSelfRole = uint32(32)

// Check-section type flags.
let TyFlagCloser = uint32(1)
let TyFlagHoldsResource = uint32(2)
let TyFlagIsError = uint32(4)
let TyFlagHasUnexportedFields = uint32(8)
let TyFlagConstraintOnly = uint32(16)

// Type parameter flags.
let TParamFlagOwn = uint32(1)
let TParamFlagRow = uint32(2)

// Variable declaration flags.
let VarFlagMut = uint32(1)
let VarFlagReassigned = uint32(2)
let VarFlagPattern = uint32(4)

// Law declaration flags.
let LawFlagRewrite = uint32(1)
let LawFlagEquation = uint32(2)
let LawFlagQuant = uint32(4)
let LawFlagReach = uint32(8)

// Lowering-section function property flags.
let LowerPure = uint32(1)
let LowerAllocFree = uint32(2)
let LowerInlineCandidate = uint32(4)
let LowerStayDirect = uint32(8)
let LowerSmallAcyclic = uint32(16)
let LowerRecursive = uint32(32)
let LowerTabulate = uint32(64)
let LowerDies = uint32(128)
let LowerOpaque = uint32(256)
let LowerUnproved = uint32(512)

// Lowering-section parameter ABI encodings.
let ParamAbiCopy = uint8(0)
let ParamAbiTakes = uint8(1)
let ParamAbiBorrow = uint8(2)
let ParamAbiMutCell = uint8(3)

// Lowering-section type value representations.
let ValueAbiScalar = uint8(1)
let ValueAbiRecord = uint8(2)
let ValueAbiUnion = uint8(3)
let ValueAbiOpBox = uint8(4)
let ValueAbiMachine = uint8(5)
let ValueAbiExternAlias = uint8(6)

// Machine entry discriminants stored inside CheckSection.
let MachineState = uint8(1)
let MachineSignal = uint8(2)
let MachineInvariant = uint8(3)
let MachineHandle = uint8(4)

// Refinement bound endpoint discriminants.
let NumBelow = uint8(0)
let NumAt = uint8(1)
let NumAbove = uint8(2)

// Digest holds a 256-bit SHA-256 checksum split into four little-endian words.
type Digest {
	// W0 through W3 store bytes [0:8), [8:16), [16:24), and [24:32) in little-endian order.
	W0 uint64,
	W1 uint64,
	W2 uint64,
	W3 uint64,
}

// ImportAssumption names an imported package and the digests expected when this package was built.
type ImportAssumption {
	// Path is the canonical import path string.
	Path string,
	// CheckDigest is the expected check-section digest of the imported package.
	CheckDigest Digest,
	// LowerDigest is the expected lower-section digest of the imported package, or zero if unchecked.
	LowerDigest Digest,
}

// Header carries the package identity, import assumptions, and canonical section digests.
type Header {
	// Version identifies the binary encoding format.
	Version uint32,
	// Flags holds package-level capability bits such as FlagPrelude and FlagHasGeneric.
	Flags uint32,
	// PkgPath is the symbol index of the package import path.
	PkgPath uint32,
	// PkgName is the symbol index of the declared package identifier.
	PkgName uint32,
	// CheckDigest is the SHA-256 digest over the canonical check header and section.
	CheckDigest Digest,
	// LowerDigest is the SHA-256 digest over the canonical lower header and section.
	LowerDigest Digest,
}

// Mismatch describes a failed verification against a resolved dependency summary set.
type Mismatch =
	| MissingImport{Path string}
	| CheckDigestMismatch{Path string, Expected Digest, Actual Digest}
	| LowerDigestMismatch{Path string, Expected Digest, Actual Digest}

// Malformed describes a corrupt, truncated, or non-canonical summary byte payload.
type Malformed =
	| BadMagic{}
	| UnsupportedVersion{Got uint32}
	| Truncated{}
	| TrailingBytes{}
	| OutOfBounds{Section string}
	| UnsortedOrDuplicate{Section string}
	| CorruptDigest{Section string, Expected Digest, Actual Digest}

// LoadError classifies failures returned by verified summary decoding.
type LoadError =
	| FormatError{Detail Malformed}
	| MismatchError{Detail Mismatch}

// SymPool stores unique UTF-8 strings packed into a flat byte slab with uint32 offsets.
type SymPool {
	// Bytes concatenates all interned string payloads.
	Bytes []byte,
	// Offs holds Len+1 byte offsets so string i occupies Bytes[Offs[i]:Offs[i+1]].
	Offs []uint32,
	// Buckets holds an open-addressed FNV-1a index table storing id+1 (0 means empty).
	Buckets []uint32,
}

// TokenPool holds position-free structural AST token streams for generic bodies, laws, and expressions.
type TokenPool {
	// Kinds stores the token kind byte (including structural open/close markers).
	Kinds []uint8,
	// Texts stores SymPool string IDs (or NoIdx for non-textual punctuation/markers).
	Texts []uint32,
}

// CheckSection stores exported type-check and semantic facts in flat SoA uint32-indexed columns.
type CheckSection {
	// Syms holds strings referenced by exported declarations, imports, types, claims, and laws.
	Syms SymPool,
	// Types holds the canonical position-free TypePool using (importPath, namePath) object identity.
	Types TypePool,
	// Tokens holds position-free token streams for generic bodies, laws, and fact predicates.
	Tokens TokenPool,
	// ImportPaths lists sorted import path symbol IDs matching the package imports.
	ImportPaths []uint32,
	// ImportCheck lists expected CheckDigest per import.
	ImportCheck []Digest,
	// DeclKinds through DeclDirectives store exported declarations sorted by (Kind, Name).
	DeclKinds      []uint8,
	DeclNames      []uint32,
	DeclSubs       []uint32,
	DeclDirectives []uint32,
	// Exported function tables and child SoA columns.
	FnNames           []uint32,
	FnFlags           []uint32,
	FnTParamStarts    []uint32,
	FnParamStarts     []uint32,
	FnResults         []uint32,
	FnFailStarts      []uint32,
	FnNeedStarts      []uint32,
	FnDefectStarts    []uint32,
	FnRefineStarts    []uint32,
	FnSelfBoundStarts []uint32,
	FnSelfArity       []uint32,
	FnSelfRole        []uint32,
	FnFactStarts      []uint32,
	FnBodyTokStarts   []uint32,
	FnBodyTokEnds     []uint32,
	// Flattened function type parameters.
	FnTPNames    []uint32,
	FnTPCons     []uint32,
	FnTPConsText []uint32,
	FnTPFlags    []uint32,
	// Flattened function value parameters.
	FnParamNames []uint32,
	FnParamTypes []uint32,
	FnParamModes []uint8,
	// Flattened function error, capability, and defect row entries.
	FnFailTypes   []uint32,
	FnNeedTypes   []uint32,
	FnDefectTypes []uint32,
	// Flattened function parameter refinement assignments.
	FnRefParamIdx []uint32,
	FnRefIdx      []uint32,
	// Flattened SelfBound pairs on functions.
	FnSelfBoundOps   []uint32,
	FnSelfBoundArity []uint32,
	// Flattened given/gives/keeps clauses.
	FnFactKinds      []uint8,
	FnFactCondStarts []uint32,
	FnFactCondEnds   []uint32,
	FnFactWhenStarts []uint32,
	FnFactWhenEnds   []uint32,
	// Exported type declaration columns.
	TyNames        []uint32,
	TySubkinds     []uint8,
	TyFlags        []uint32,
	TyTParamStarts []uint32,
	TyUnderlyings  []uint32,
	TyExternPaths  []uint32,
	TyRefineIdx    []uint32,
	TyFieldStarts  []uint32,
	TyVarStarts    []uint32,
	TyRoleIdx      []uint32,
	TyClaimStarts  []uint32,
	TyMachineStart []uint32,
	// Flattened type declaration bracket parameters.
	TyTPNames []uint32,
	TyTPCons  []uint32,
	TyTPFlags []uint32,
	// Flattened exported struct and variant fields.
	FieldNames []uint32,
	FieldTypes []uint32,
	FieldFlags []uint32,
	// Flattened union variants sorted by variant name.
	UnionVarNames       []uint32,
	UnionVarTypes       []uint32,
	UnionVarFieldStarts []uint32,
	UnionVarFieldEnds   []uint32,
	UnionVarFieldNames  []uint32,
	UnionVarFieldTypes  []uint32,
	UnionVarFieldFlags  []uint32,
	// Operation type definitions and flattened members/laws.
	RoleSelfSites     []uint8,
	RoleHarness       []uint32,
	RoleIncludeStarts []uint32,
	RoleMemberStarts  []uint32,
	RoleLawStarts     []uint32,
	RoleIncludes      []uint32,
	// Operation type members.
	RoleMemNames     []uint32,
	RoleMemFlags     []uint32,
	RoleMemSigs      []uint32,
	RoleMemOwnStarts []uint32,
	RoleMemPosStarts []uint32,
	RoleMemOwnNames  []uint32,
	RoleMemOwnCons   []uint32,
	RoleMemPositions []uint32,
	// Canonical position-free operation laws.
	RoleLawNames     []uint32,
	RoleLawTokStarts []uint32,
	RoleLawTokEnds   []uint32,
	// Type-level implements claims.
	ClaimRoleImp     []uint32,
	ClaimRoleName    []uint32,
	ClaimArgStarts   []uint32,
	ClaimLayStarts   []uint32,
	ClaimArgs        []uint32,
	ClaimLayoutSlots []uint32,
	// Machine exported items.
	MachKinds  []uint8,
	MachNames  []uint32,
	MachStarts []uint32,
	MachEnds   []uint32,
	// Refinement metadata and span endpoints.
	RefIsLen      []bool,
	RefParseNames []uint32,
	RefSpanStarts []uint32,
	SpanLoKind    []uint8,
	SpanLoNeg     []uint8,
	SpanLoMag     []uint64,
	SpanHiKind    []uint8,
	SpanHiNeg     []uint8,
	SpanHiMag     []uint64,
	// Exported variables, constants, contexts, top-level laws, and parse helpers.
	TopVarNames    []uint32,
	TopVarTypes    []uint32,
	TopVarFlags    []uint32,
	ConstNames     []uint32,
	ConstTypes     []uint32,
	ConstValues    []uint32,
	ConstTokStarts []uint32,
	ConstTokEnds   []uint32,
	CtxNames       []uint32,
	CtxProvides    []uint32,
	CtxFailStarts  []uint32,
	CtxNeedStarts  []uint32,
	CtxFailTypes   []uint32,
	CtxNeedTypes   []uint32,
	LawNames       []uint32,
