		CtxFailStarts:       []uint32{uint32(0)},
		CtxNeedStarts:       []uint32{uint32(0)},
		CtxFailTypes:        []uint32{},
		CtxNeedTypes:        []uint32{},
		LawNames:            []uint32{},
		LawTParamStart:      []uint32{uint32(0)},
		LawParamStart:       []uint32{uint32(0)},
		LawFlags:            []uint32{},
		LawTokStarts:        []uint32{},
		LawTokEnds:          []uint32{},
		LawTPNames:          []uint32{},
		LawTPCons:           []uint32{},
		LawParamNames:       []uint32{},
		LawParamTypes:       []uint32{},
		ParseTypeNames:      []uint32{},
		ParseFnNames:        []uint32{},
		ParseSigs:           []uint32{},
		FClaimRoleImp:       []uint32{},
		FClaimRoleName:      []uint32{},
		FClaimReceiver:      []uint32{},
		FClaimBindStart:     []uint32{uint32(0)},
		FClaimPosStart:      []uint32{uint32(0)},
		FClaimMemStart:      []uint32{uint32(0)},
		FClaimBinds:         []uint32{},
		FClaimPositions:     []uint32{},
		FClaimMemNames:      []uint32{},
		FClaimMemTypes:      []uint32{},
	}
}

// EmptyLowerSection initializes empty canonical LowerSection columns.
func EmptyLowerSection() LowerSection {
	LowerSection{
		Syms:              NewSymPool(),
		Types:             NewTypePool(),
		Tokens:            NewTokenPool(),
		ImportPaths:       []uint32{},
		ImportLower:       []Digest{},
		FnNames:           []uint32{},
		FnFlags:           []uint32{},
		FnInlineCost:      []uint32{},
		FnCapStarts:       []uint32{uint32(0)},
		FnAbiStarts:       []uint32{uint32(0)},
		FnTokStarts:       []uint32{},
		FnTokEnds:         []uint32{},
		FnCaps:            []uint32{},
		FnParamAbis:       []uint8{},
		TyNames:           []uint32{},
		TyValueAbi:        []uint8{},
		TyRuntimeGo:       []uint32{},
		TyPhysFieldStarts: []uint32{uint32(0)},
		PhysFieldNames:    []uint32{},
		PhysFieldTypes:    []uint32{},
		PhysFieldFlags:    []uint32{},
	}
}

// EmptySummary constructs a minimal valid Summary for pkgPath and pkgName.
func EmptySummary(pkgPath string, pkgName string) Summary {
	let mut c = EmptyCheckSection()
	let pID = InternSym(&c.Syms, pkgPath)
	let nID = InternSym(&c.Syms, pkgName)
	let l = EmptyLowerSection()
	let mut s = Summary{
		Header: Header{
			Version:     FormatVersion,
			Flags:       uint32(0),
			PkgPath:     pID,
			PkgName:     nID,
			CheckDigest: ZeroDigest(),
			LowerDigest: ZeroDigest(),
		},
		Check: c,
		Lower: l,
	}
	RefreshDigests(&s)
	s
}

// ObjectRef identifies an exported item across package boundaries without global IDs.
type ObjectRef {
	// ImportPath is the defining package import path.
	ImportPath string,
	// NamePath is the declaration or nested member/variant name within ImportPath.
	NamePath string,
}

// ResolvedDecl describes one found exported declaration in CheckSection.
type ResolvedDecl {
	// Kind is one of the Decl* constants.
	Kind uint8,
	// Index is the subtable index from DeclSubs.
	Index uint32,
}

// PackagePath returns the package's import path string.
func PackagePath(s Summary) string {
	SymText(s.Check.Syms, s.Header.PkgPath)
}

// PackageName returns the package's declared identifier string.
func PackageName(s Summary) string {
	SymText(s.Check.Syms, s.Header.PkgName)
}

// LookupExported looks up an exported declaration by kind and name using binary search on sorted Decls.
func LookupExported(s Summary, kind uint8, name string) option.Option[ResolvedDecl] {
	let n = s.Check.DeclNames.Len()
	let mut lo = 0
	let mut hi = n
	for lo < hi {
		let mid = (lo + hi) / 2
		let mk = s.Check.DeclKinds[mid]
		let mn = SymText(s.Check.Syms, s.Check.DeclNames[mid])
		if mk < kind || (mk == kind && mn < name) {
			lo = mid + 1
		} else if mk > kind || (mk == kind && mn > name) {
			hi = mid
		} else {
			return option.Some{Value: ResolvedDecl{Kind: mk, Index: s.Check.DeclSubs[mid]}}
		}
	}
	option.None
}

// LookupObject resolves a cross-package ObjectRef inside s when ImportPath matches PackagePath(s).
func LookupObject(s Summary, ref ObjectRef) option.Option[ResolvedDecl] {
	if ref.ImportPath != PackagePath(s) {
		return option.None
	}
	let kinds = []uint8{DeclFunc, DeclType, DeclVar, DeclConst, DeclContext, DeclLaw, DeclParse}
	for i in 0..kinds.Len() {
		match LookupExported(s, kinds[i], ref.NamePath) {
		case option.Some{Value: d}:
			return option.Some{Value: d}
		case option.None:
		}
	}
	option.None
}

// HeaderImports returns all import assumptions sorted by import path.
func HeaderImports(s Summary) []ImportAssumption {
	let n = s.Check.ImportPaths.Len()
	let mut out = slices.WithCapacity[ImportAssumption](n)
	for i in 0..n {
		let path = SymText(s.Check.Syms, s.Check.ImportPaths[i])
		let lowerD = findLowerImportDigest(s.Lower, path)
		out = out.Append(ImportAssumption{
			Path:        path,
			CheckDigest: s.Check.ImportCheck[i],
			LowerDigest: lowerD,
		})
	}
	out
}

func findLowerImportDigest(l LowerSection, path string) Digest {
	let n = l.ImportPaths.Len()
	let mut lo = 0
	let mut hi = n
	for lo < hi {
		let mid = (lo + hi) / 2
		let mp = SymText(l.Syms, l.ImportPaths[mid])
		if mp < path {
			lo = mid + 1
		} else if mp > path {
			hi = mid
		} else {
			return l.ImportLower[mid]
		}
	}
	ZeroDigest()
}

// VerifyCheckAssumptions refuses any check-time import assumption mismatch against resolved dependencies.
func VerifyCheckAssumptions(s Summary, resolved []ImportAssumption) fails Mismatch {
	let sorted = sortAssumptions(resolved)
	let n = s.Check.ImportPaths.Len()
	for i in 0..n {
		let path = SymText(s.Check.Syms, s.Check.ImportPaths[i])
		let expected = s.Check.ImportCheck[i]
		match findAssumption(sorted, path) {
		case option.None:
			return MissingImport{Path: path}
		case option.Some{Value: got}:
			if got.CheckDigest != expected {
				return CheckDigestMismatch{Path: path, Expected: expected, Actual: got.CheckDigest}
			}
		}
	}
}

// VerifyAssumptions verifies both check-time and lower-time import assumptions in s.
func VerifyAssumptions(s Summary, resolved []ImportAssumption) fails Mismatch {
	let sorted = sortAssumptions(resolved)
	let cn = s.Check.ImportPaths.Len()
	for i in 0..cn {
		let path = SymText(s.Check.Syms, s.Check.ImportPaths[i])
		let expected = s.Check.ImportCheck[i]
		match findAssumption(sorted, path) {
		case option.None:
			return MissingImport{Path: path}
		case option.Some{Value: got}:
			if got.CheckDigest != expected {
				return CheckDigestMismatch{Path: path, Expected: expected, Actual: got.CheckDigest}
			}
		}
	}
	let ln = s.Lower.ImportPaths.Len()
	for i in 0..ln {
		let path = SymText(s.Lower.Syms, s.Lower.ImportPaths[i])
		let expected = s.Lower.ImportLower[i]
		if IsZeroDigest(expected) {
			continue
		}
		match findAssumption(sorted, path) {
		case option.None:
			return MissingImport{Path: path}
		case option.Some{Value: got}:
			if got.LowerDigest != expected {
				return LowerDigestMismatch{Path: path, Expected: expected, Actual: got.LowerDigest}
			}
		}
	}
}

func sortAssumptions(items []ImportAssumption) []ImportAssumption {
	slices.SortFunc(items, func(a ImportAssumption, b ImportAssumption) int {
		strings.Compare(a.Path, b.Path)
	})
}

func findAssumption(sorted []ImportAssumption, path string) option.Option[ImportAssumption] {
	let mut lo = 0
	let mut hi = sorted.Len()
	for lo < hi {
		let mid = (lo + hi) / 2
		let mp = sorted[mid].Path
		if mp < path {
			lo = mid + 1
		} else if mp > path {
			hi = mid
		} else {
			return option.Some{Value: sorted[mid]}
		}
	}
	option.None
}

test SummaryHeaderVerifyRefusesMismatch {
	let mut s = EmptySummary("pkg/app", "app")
	let depA = InternSym(&s.Check.Syms, "pkg/dep")
	s.Check.ImportPaths = []uint32{depA}
	let d1 = Digest{W0: uint64(11), W1: uint64(22), W2: uint64(33), W3: uint64(44)}
	let d2 = Digest{W0: uint64(55), W1: uint64(66), W2: uint64(77), W3: uint64(88)}
	s.Check.ImportCheck = []Digest{d1}
	let depAL = InternSym(&s.Lower.Syms, "pkg/dep")
	s.Lower.ImportPaths = []uint32{depAL}
	s.Lower.ImportLower = []Digest{d2}
	RefreshDigests(&s)

	let okRes = []ImportAssumption{ImportAssumption{Path: "pkg/dep", CheckDigest: d1, LowerDigest: d2}}
	let mut failed = false
	VerifyAssumptions(s, okRes) catch {
	case _:
		failed = true
	}
	assert !failed

	let badRes = []ImportAssumption{ImportAssumption{Path: "pkg/dep", CheckDigest: Digest{W0: uint64(99), W1: uint64(0), W2: uint64(0), W3: uint64(0)}, LowerDigest: d2}}
	let mut sawCheckMismatch = false
	VerifyAssumptions(s, badRes) catch {
	case CheckDigestMismatch as m:
		sawCheckMismatch = m.Path == "pkg/dep" && m.Expected == d1
	case _:
	}
	assert sawCheckMismatch
}
