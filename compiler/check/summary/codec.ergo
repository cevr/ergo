	writeU32Slice(w, c.TyClaimStarts)
	writeU32Slice(w, c.TyMachineStart)
	writeU32Slice(w, c.TyTPNames)
	writeU32Slice(w, c.TyTPCons)
	writeU32Slice(w, c.TyTPFlags)
	writeU32Slice(w, c.FieldNames)
	writeU32Slice(w, c.FieldTypes)
	writeU32Slice(w, c.FieldFlags)
	writeU32Slice(w, c.UnionVarNames)
	writeU32Slice(w, c.UnionVarTypes)
	writeU32Slice(w, c.UnionVarFieldStarts)
	writeU32Slice(w, c.UnionVarFieldEnds)
	writeU32Slice(w, c.UnionVarFieldNames)
	writeU32Slice(w, c.UnionVarFieldTypes)
	writeU32Slice(w, c.UnionVarFieldFlags)
	writeU8Slice(w, c.RoleSelfSites)
	writeU32Slice(w, c.RoleHarness)
	writeU32Slice(w, c.RoleIncludeStarts)
	writeU32Slice(w, c.RoleMemberStarts)
	writeU32Slice(w, c.RoleLawStarts)
	writeU32Slice(w, c.RoleIncludes)
	writeU32Slice(w, c.RoleMemNames)
	writeU32Slice(w, c.RoleMemFlags)
	writeU32Slice(w, c.RoleMemSigs)
	writeU32Slice(w, c.RoleMemOwnStarts)
	writeU32Slice(w, c.RoleMemPosStarts)
	writeU32Slice(w, c.RoleMemOwnNames)
	writeU32Slice(w, c.RoleMemOwnCons)
	writeU32Slice(w, c.RoleMemPositions)
	writeU32Slice(w, c.RoleLawNames)
	writeU32Slice(w, c.RoleLawTokStarts)
	writeU32Slice(w, c.RoleLawTokEnds)
	writeU32Slice(w, c.ClaimRoleImp)
	writeU32Slice(w, c.ClaimRoleName)
	writeU32Slice(w, c.ClaimArgStarts)
	writeU32Slice(w, c.ClaimLayStarts)
	writeU32Slice(w, c.ClaimArgs)
	writeU32Slice(w, c.ClaimLayoutSlots)
	writeU8Slice(w, c.MachKinds)
	writeU32Slice(w, c.MachNames)
	writeU32Slice(w, c.MachStarts)
	writeU32Slice(w, c.MachEnds)
