import option
import sha256
import slices
import strings

type byteWriter { buf []byte }

type byteReader { data []byte, pos int }

func newByteWriter(capN int) byteWriter {
	byteWriter{buf: slices.WithCapacity[byte](capN)}
}

func writeU8(w mut byteWriter, v uint8) {
	w.buf = w.buf.Append(byte(v))
}

func writeBool(w mut byteWriter, v bool) {
	writeU8(w, if v { uint8(1) } else { uint8(0) })
}

func writeU32(w mut byteWriter, v uint32) {
	w.buf = w.buf.Append(byte(v & uint32(255)))
	w.buf = w.buf.Append(byte((v >> uint32(8)) & uint32(255)))
	w.buf = w.buf.Append(byte((v >> uint32(16)) & uint32(255)))
	w.buf = w.buf.Append(byte((v >> uint32(24)) & uint32(255)))
}

func writeU64(w mut byteWriter, v uint64) {
	w.buf = appendU64LE(w.buf, v)
}

func writeDigest(w mut byteWriter, d Digest) {
	writeU64(w, d.W0)
	writeU64(w, d.W1)
	writeU64(w, d.W2)
	writeU64(w, d.W3)
}

func writeRawBytes(w mut byteWriter, bs []byte) {
	writeU32(w, uint32(bs.Len()))
	w.buf = w.buf.AppendBytes(bs)
}

func writeU8Slice(w mut byteWriter, xs []uint8) {
	writeU32(w, uint32(xs.Len()))
	for i in 0..xs.Len() {
		writeU8(w, xs[i])
	}
}

func writeBoolSlice(w mut byteWriter, xs []bool) {
	writeU32(w, uint32(xs.Len()))
	for i in 0..xs.Len() {
		writeBool(w, xs[i])
	}
}

func writeU32Slice(w mut byteWriter, xs []uint32) {
	writeU32(w, uint32(xs.Len()))
	for i in 0..xs.Len() {
		writeU32(w, xs[i])
	}
}

func writeU64Slice(w mut byteWriter, xs []uint64) {
	writeU32(w, uint32(xs.Len()))
	for i in 0..xs.Len() {
		writeU64(w, xs[i])
	}
}

func writeDigestSlice(w mut byteWriter, xs []Digest) {
	writeU32(w, uint32(xs.Len()))
	for i in 0..xs.Len() {
		writeDigest(w, xs[i])
	}
}

func writeSymPool(w mut byteWriter, p SymPool) {
	writeRawBytes(w, p.Bytes)
	writeU32Slice(w, p.Offs)
}

func writeTypePool(w mut byteWriter, tp TypePool) {
	writeU8Slice(w, tp.Kind)
	writeU32Slice(w, tp.A)
	writeU32Slice(w, tp.B)
	writeU32Slice(w, tp.Extra)
}

func writeTokenPool(w mut byteWriter, tk TokenPool) {
	writeU8Slice(w, tk.Kinds)
	writeU32Slice(w, tk.Texts)
}

func encodeCheckFuncs(w mut byteWriter, c CheckSection) {
	writeU32Slice(w, c.FnNames)
	writeU32Slice(w, c.FnFlags)
	writeU32Slice(w, c.FnTParamStarts)
	writeU32Slice(w, c.FnParamStarts)
	writeU32Slice(w, c.FnResults)
	writeU32Slice(w, c.FnFailStarts)
	writeU32Slice(w, c.FnNeedStarts)
	writeU32Slice(w, c.FnDefectStarts)
	writeU32Slice(w, c.FnRefineStarts)
	writeU32Slice(w, c.FnSelfBoundStarts)
	writeU32Slice(w, c.FnSelfArity)
	writeU32Slice(w, c.FnSelfRole)
	writeU32Slice(w, c.FnFactStarts)
	writeU32Slice(w, c.FnBodyTokStarts)
	writeU32Slice(w, c.FnBodyTokEnds)
	writeU32Slice(w, c.FnTPNames)
	writeU32Slice(w, c.FnTPCons)
	writeU32Slice(w, c.FnTPConsText)
	writeU32Slice(w, c.FnTPFlags)
	writeU32Slice(w, c.FnParamNames)
	writeU32Slice(w, c.FnParamTypes)
	writeU8Slice(w, c.FnParamModes)
	writeU32Slice(w, c.FnFailTypes)
	writeU32Slice(w, c.FnNeedTypes)
	writeU32Slice(w, c.FnDefectTypes)
	writeU32Slice(w, c.FnRefParamIdx)
	writeU32Slice(w, c.FnRefIdx)
	writeU32Slice(w, c.FnSelfBoundOps)
	writeU32Slice(w, c.FnSelfBoundArity)
	writeU8Slice(w, c.FnFactKinds)
	writeU32Slice(w, c.FnFactCondStarts)
	writeU32Slice(w, c.FnFactCondEnds)
	writeU32Slice(w, c.FnFactWhenStarts)
	writeU32Slice(w, c.FnFactWhenEnds)
}

