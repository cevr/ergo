import compiler/format
import dense
import hex
import sha256
import strings

let cBindPlatforms = "darwin/amd64 darwin/arm64 linux/amd64 linux/arm64"

func ergoTypeSpelling(b Binding, typeID uint32) string {
	let tid = TypeAt(b.M.Types, typeID)
	let kind = dense.Of(b.M.Types.Kind, tid)
	if kind == TypeScalar {
		return GoScalarName(dense.Of(b.M.Types.Scalar, tid))
	}
	if kind == TypeArray {
		return "[" + FormatUint64(dense.Of(b.M.Types.Len, tid)) + "]" + ergoTypeSpelling(b, dense.Of(b.M.Types.Elem, tid))
	}
	if kind == TypePointer {
		let elem = dense.Of(b.M.Types.Elem, tid)
		if dense.Of(b.M.Types.LenExpr, tid) == 0 && kIsHandleType(b.K, elem) {
			let eID = TypeAt(b.M.Types, elem)
			let dIdx = kDeclIdx(b.K, StrText(b.M.Strings, dense.Of(b.M.Types.Name, eID)))
			return "*" + b.GoTypes[int(dIdx)]
		}
		return "?"
	}
	if kind == TypeNamed {
		let dIdx = kDeclIdx(b.K, StrText(b.M.Strings, dense.Of(b.M.Types.Name, tid)))
		if dIdx != NoID {
			return b.GoTypes[int(dIdx)]
		}
	}
	"?"
}

func recordHeaderFor(b Binding, declIdx uint32) (bool, uint32) {
	if b.KindLen[int(declIdx)] > 0 {
		return (true, declIdx)
	}
	let did = dense.IDAt(b.M.Decls.Ids, int(declIdx))
	let fLen = dense.Of(b.M.Decls.FieldsLen, did)
	if fLen > 0 {
		let f0 = dense.IDAt(b.M.Fields.Ids, int(dense.Of(b.M.Decls.FieldsStart, did)))
		let f0ID = TypeAt(b.M.Types, dense.Of(b.M.Fields.Type, f0))
		if dense.Of(b.M.Types.Kind, f0ID) == TypeNamed {
			let hName = StrText(b.M.Strings, dense.Of(b.M.Types.Name, f0ID))
			let hIdx = kDeclIdx(b.K, hName)
			if hIdx != NoID {
				let ks = b.KindStart[int(hIdx)]
				let kl = b.KindLen[int(hIdx)]
				let mut ki uint32 = 0
				for ki < kl {
					if b.KindPool[int(ks+ki)] == declIdx {
						return (true, hIdx)
					}
					ki = ki + 1
				}
			}
		}
	}
	(false, 0)
}

func formatErgoCallbackType(b Binding, bc BoundCallback, paramName string, isCallScope bool) (string, []string) {
	let pr = cbFuncRange(b.K, bc.DeclIdx)
	let mut posIdx = []uint32{}
	let mut k0 uint32 = 0
	for k0 < pr.pLen {
		posIdx = posIdx.Append(NoID)
		k0 = k0 + 1
	}
	let mut pi = 0
	for pi < bc.Positions.Len() {
		posIdx[int(bc.Positions[pi].Param)] = uint32(pi)
		pi = pi + 1
	}
	let mut sa = NewScopeArena()
	let sc = NewErgoFuncScope(&sa, NoID)
	let mut cparams = []string{}
	let mut scoped = []string{}
	for cp in bc.Sig.Params {
		let q = bc.Positions[int(posIdx[int(cp.C)])]
		let ct = prParamType(b.K, pr, cp.C)
		let ctID = TypeAt(b.M.Types, ct)
		let cname = ScopeAlloc(&sa, sc, cp.Name, "callback parameter "+cp.Name)
		let mut et = ""
		if q.Class == ClassValue {
			let elem = dense.Of(b.M.Types.Elem, ctID)
			et = ergoTypeSpelling(b, elem)
			if dense.Of(b.M.Types.LenExpr, ctID) != 0 {
				et = "[" + FormatUint64(dense.Of(b.M.Types.Len, ctID)) + "]" + et
			}
		} else if q.Class == ClassInBuffer {
			let elem = dense.Of(b.M.Types.Elem, ctID)
			et = "[]" + ergoTypeSpelling(b, elem)
			if et == "[]uint8" {
				et = "[]byte"
			}
			scoped = scoped.Append(paramName + "." + cname)
		} else {
			et = ergoTypeSpelling(b, ct)
		}
		cparams = cparams.Append(cname + " " + et)
	}
	let mut cres = []string{}
	for cr in bc.Sig.Results {
		if cr.IsRet {
			cres = cres.Append(ergoTypeSpelling(b, pr.res))
			continue
		}
		let q = bc.Positions[int(posIdx[int(cr.C)])]
		let elem = dense.Of(b.M.Types.Elem, TypeAt(b.M.Types, prParamType(b.K, pr, cr.C)))
		if q.Class == ClassOutArray {
			cres = cres.Append("[" + FormatUint64(uint64(q.Array)) + "]" + ergoTypeSpelling(b, elem))
			continue
		}
		cres = cres.Append(ergoTypeSpelling(b, elem))
	}
	let mut resText = ""
	if cres.Len() == 1 {
		resText = " " + cres[0]
	} else if cres.Len() > 1 {
		resText = " (" + strings.Join(cres, ", ") + ")"
	}
	if isCallScope {
		return ("func(" + strings.Join(cparams, ", ") + ")" + resText + " fails CE needs CR", scoped)
	}
	("own func(" + strings.Join(cparams, ", ") + ")" + resText, scoped)
}

func emitErgoRaw(b Binding) string {
	let mut w = strings.NewBuilder()
	let ip = StrText(b.C.Strings, b.C.GoImportPath)
	strings.WriteString(&w, "// Code generated by ergo bind c (internal/bindc); DO NOT EDIT.\n")
	strings.WriteString(&w, "// ergo:bind c "+ip+" "+b.HeaderSHA256+" "+b.ContractSHA256+" "+cBindPlatforms+"\n\n")
	strings.WriteString(&w, "extern go "+ip+".Load func Load(path string) fails go.Error needs go.Foreign\n")
	let mut hasBoundCbs = false
	for cb in b.Callbacks {
		if cb.Bound {
			hasBoundCbs = true
			break
		}
	}
	if hasBoundCbs {
		strings.WriteString(&w, "extern go "+ip+".LiveCallbacks func LiveCallbacks() int needs go.Foreign\n")
	}
	strings.WriteByte(&w, '\n')

	for cIdx in b.Constants {
		let cid = dense.IDAt(b.M.Consts.Ids, int(cIdx))
		let cName = StrText(b.M.Strings, dense.Of(b.M.Consts.Name, cid))
		let cScalar = dense.Of(b.M.Consts.Scalar, cid)
		strings.WriteString(&w, "extern go "+ip+"."+cName+" let "+cName+" "+GoScalarName(cScalar)+"\n")
	}
	if b.Constants.Len() > 0 {
		strings.WriteByte(&w, '\n')
	}

	let stType = StrText(b.C.Strings, b.C.StatusType)
	let stDecl = kDeclIdx(b.K, stType)
	let stScalar = dense.Of(b.M.Decls.Scalar, dense.IDAt(b.M.Decls.Ids, int(stDecl)))
	strings.WriteString(&w, "extern go "+ip+".Status type Status "+GoScalarName(stScalar)+"\n")
	strings.WriteString(&w, "extern go "+ip+".Status.Error func (s Status) Error() string needs go.Foreign\n")
	for xIdx in b.Codes {
		let gn = CodeGoName(b, xIdx)
		strings.WriteString(&w, "extern go "+ip+"."+gn+" let "+gn+" Status\n")
	}
	strings.WriteString(&w, "extern go "+ip+".ErrNotLoaded let ErrNotLoaded go.Error\n")
	strings.WriteString(&w, "extern go "+ip+".ErrDestroyed let ErrDestroyed go.Error\n")
	strings.WriteString(&w, "extern go "+ip+".ErrTooLong let ErrTooLong go.Error\n\n")

	let nDecls = dense.Total(b.M.Decls.Ids)
	let mut wroteScalar = false
	let mut di = 0
	for di < nDecls {
		let did = dense.IDAt(b.M.Decls.Ids, di)
		let dk = dense.Of(b.M.Decls.Kind, did)
		let dName = StrText(b.M.Strings, dense.Of(b.M.Decls.Name, did))
		if dk == DeclScalar && dName != stType {
			let gn = b.GoTypes[di]
			strings.WriteString(&w, "extern go "+ip+"."+gn+" type "+gn+" "+GoScalarName(dense.Of(b.M.Decls.Scalar, did))+"\n")
			wroteScalar = true
		}
		di = di + 1
	}
	if wroteScalar {
		strings.WriteByte(&w, '\n')
	}

	di = 0
	for di < nDecls {
		let did = dense.IDAt(b.M.Decls.Ids, di)
		if dense.Of(b.M.Decls.Kind, did) != DeclOpaque {
			di = di + 1
			continue
		}
		let dName = StrText(b.M.Strings, dense.Of(b.M.Decls.Name, did))
		let hIdx = kHandleIdxForType(b.K, dName)
		if hIdx == NoID {
			di = di + 1
			continue
		}
		let gn = b.GoTypes[di]
		let hDestroy = StrText(b.C.Strings, dense.Of(b.C.Handles.Destroy, dense.IDAt(b.C.Handles.Ids, int(hIdx))))
		if hDestroy != "" {
			strings.WriteString(&w, "extern go "+ip+"."+gn+" type "+gn+" {} implements Closer\n")
			strings.WriteString(&w, "extern go "+ip+"."+gn+".Close func (h own *"+gn+") Close() fails go.Error needs go.Foreign\n\n")
		} else {
			strings.WriteString(&w, "extern go "+ip+"."+gn+" type "+gn+" {}\n\n")
		}
		di = di + 1
	}

	di = 0
	for di < nDecls {
		let did = dense.IDAt(b.M.Decls.Ids, di)
		if dense.Of(b.M.Decls.Kind, did) != DeclStruct || !b.RecordFlags[di] {
			di = di + 1
			continue
		}
		let gn = b.GoTypes[di]
		strings.WriteString(&w, "// ergo:cdata\nextern go "+ip+"."+gn+" type "+gn+" {\n")
		let fStart = dense.Of(b.M.Decls.FieldsStart, did)
		let fLen = dense.Of(b.M.Decls.FieldsLen, did)
		let mut fi uint32 = 0
		for fi < fLen {
			let fid = dense.IDAt(b.M.Fields.Ids, int(fStart+fi))
			let fNameID = dense.Of(b.M.Fields.Name, fid)
			if b.Autofill[int(fNameID)] != 0 {
				fi = fi + 1
				continue
			}
			let fnStr = b.FieldNamePool[int(b.FieldNameStart[di]+fi)]
			strings.WriteString(&w, "\t"+fnStr+" "+ergoTypeSpelling(b, dense.Of(b.M.Fields.Type, fid))+",\n")
			fi = fi + 1
		}
		strings.WriteString(&w, "}\n")
		let (hasHdr, hIdx) = recordHeaderFor(b, uint32(di))
		if hasHdr && b.UnionFlags[int(hIdx)] {
			let rt = b.GoTypes[int(hIdx)] + "Record"
			strings.WriteString(&w, "extern go "+ip+"."+gn+".Is"+rt+" func (s "+gn+") Is"+rt+"() needs go.Foreign\n")
		}
		strings.WriteByte(&w, '\n')
		di = di + 1
	}

	di = 0
	for di < nDecls {
		if b.UnionFlags[di] {
			let rt = b.GoTypes[di] + "Record"
			strings.WriteString(&w, "extern go "+ip+"."+rt+" type "+rt+" {\n\tIs"+rt+"() needs go.Foreign,\n}\n\n")
		}
		di = di + 1
	}

	for bf in b.Funcs {
		let why = ErgoUnboundReason(bf)
		if why != "" {
			strings.WriteString(&w, "// not bound: "+bf.Name+" ("+why+")\n")
			continue
		}
		let pr = funcRange(b.K, bf.FuncIdx)
		let mut posIdx = []uint32{}
		let mut k0 uint32 = 0
		for k0 < pr.pLen {
			posIdx = posIdx.Append(NoID)
			k0 = k0 + 1
		}
		let mut pi = 0
		for pi < bf.Positions.Len() {
			let q = bf.Positions[pi]
			if !q.IsRes {
				posIdx[int(q.Param)] = uint32(pi)
			}
			pi = pi + 1
		}
		let mut params = []string{}
		let mut reads = []string{}
		let mut scoped = []string{}
		let mut cbTypes = []string{}
		let mut hasCallScopeCb = false
		let mut writesParam = ""
		let mut writesType = ""
		let mut i = 0
		for i < bf.Sig.Params.Len() {
			let gp = bf.Sig.Params[i]
			let pt = prParamType(b.K, pr, gp.C)
			let ptID = TypeAt(b.M.Types, pt)
			let pname = bf.ErgoParams[i]
			let mut et = ""
			if gp.Class == ClassHandle {
				let eID = TypeAt(b.M.Types, dense.Of(b.M.Types.Elem, ptID))
				let eDecl = kDeclIdx(b.K, StrText(b.M.Strings, dense.Of(b.M.Types.Name, eID)))
				if bf.HasDestroy {
					et = "own *" + b.GoTypes[int(eDecl)]
				} else {
					et = "*" + b.GoTypes[int(eDecl)]
				}
			} else if gp.Class == ClassValue {
				let elem = dense.Of(b.M.Types.Elem, ptID)
				let eID = TypeAt(b.M.Types, elem)
				et = ergoTypeSpelling(b, elem)
				if dense.Of(b.M.Types.LenExpr, ptID) != 0 {
					et = "[" + FormatUint64(dense.Of(b.M.Types.Len, ptID)) + "]" + et
				} else if dense.Of(b.M.Types.Kind, eID) == TypeNamed {
					let eDecl = kDeclIdx(b.K, StrText(b.M.Strings, dense.Of(b.M.Types.Name, eID)))
					if eDecl != NoID && b.UnionFlags[int(eDecl)] {
						et = b.GoTypes[int(eDecl)] + "Record"
					}
				}
			} else if gp.Class == ClassOptional {
				et = "Option[go.Ref[" + ergoTypeSpelling(b, dense.Of(b.M.Types.Elem, ptID)) + "]]"
			} else if gp.Class == ClassInBuffer {
				et = "[]" + ergoTypeSpelling(b, dense.Of(b.M.Types.Elem, ptID))
				if et == "[]uint8" {
					et = "[]byte"
				}
				reads = reads.Append(pname)
			} else if gp.Class == ClassOutBuffer {
				et = "[]" + ergoTypeSpelling(b, dense.Of(b.M.Types.Elem, ptID))
				if et == "[]uint8" {
					et = "[]byte"
				}
				if writesParam == "" {
					writesParam = pname
					writesType = et
				}
			} else if gp.Class == ClassCallback {
				let cbName = StrText(b.M.Strings, dense.Of(b.M.Types.Name, ptID))
				let sid = FindStr(b.M.Strings, cbName)
				let bc = b.Callbacks[int(b.K.CbByType[int(sid)])]
				let rid = dense.IDAt(b.C.Callbacks.Ids, int(bc.RuleIdx))
				let isCall = StrText(b.C.Strings, dense.Of(b.C.Callbacks.Scope, rid)) == "call"
				if isCall {
					hasCallScopeCb = true
				}
				let (cbType, cbScoped) = formatErgoCallbackType(b, bc, pname, isCall)
				et = cbType
				for s in cbScoped {
					scoped = scoped.Append(s)
				}
				cbTypes = cbTypes.Append(pname + " " + bc.GoName)
			} else {
				et = ergoTypeSpelling(b, pt)
			}
			params = params.Append(pname + " " + et)
			i = i + 1
		}
		let mut res = []string{}
		if writesType != "" {
			res = res.Append(writesType)
		}
		for gr in bf.Sig.Results {
			if gr.IsRet {
				res = res.Append(ergoTypeSpelling(b, pr.res))
				continue
			}
			let pt = prParamType(b.K, pr, gr.C)
			let ptID = TypeAt(b.M.Types, pt)
			let q = bf.Positions[int(posIdx[int(gr.C)])]
			if q.By == RuleCreate {
				let eID = TypeAt(b.M.Types, dense.Of(b.M.Types.Elem, ptID))
				let eeID = TypeAt(b.M.Types, dense.Of(b.M.Types.Elem, eID))
				let eeDecl = kDeclIdx(b.K, StrText(b.M.Strings, dense.Of(b.M.Types.Name, eeID)))
				res = res.Append("go.Ref[" + b.GoTypes[int(eeDecl)] + "]")
				continue
			}
			res = res.Append(ergoTypeSpelling(b, dense.Of(b.M.Types.Elem, ptID)))
		}
		let mut resultStr = ""
		if res.Len() == 1 {
			resultStr = " " + res[0]
		} else if res.Len() > 1 {
			resultStr = " (" + strings.Join(res, ", ") + ")"
		}
		for ct in cbTypes {
			strings.WriteString(&w, "// ergo:cbtype "+ct+"\n")
		}
		if scoped.Len() > 0 {
			strings.WriteString(&w, "// ergo:scoped "+strings.Join(scoped, " ")+"\n")
		}
		if reads.Len() > 0 {
			strings.WriteString(&w, "// ergo:reads "+strings.Join(reads, " ")+"\n")
		}
		if writesParam != "" {
			strings.WriteString(&w, "// ergo:writes "+writesParam+"\n")
		}
		let tparams = if hasCallScopeCb { "[CE, CR]" } else { "" }
		let failsRow = if hasCallScopeCb { " fails CE | go.Error" } else { " fails go.Error" }
		let foreignRow = if hasCallScopeCb { " needs CR | go.Foreign" } else { " needs go.Foreign" }
		strings.WriteString(&w, "extern go "+ip+"."+bf.GoName+" func "+bf.GoName+tparams+"("+strings.Join(params, ", ")+")"+resultStr+failsRow+foreignRow+"\n")
	}
	strings.String(w)
}

// ErgoText emits formatted checked Ergo C bindings for b.
func ErgoText(b Binding) string fails BindingFailure {
	let raw = emitErgoRaw(b)
	let out = format.Source(raw, 0) catch {
	case format.SyntaxFailure as e:
		return BindingFailure{Msg: "bindc: the generated Ergo does not format: " + e.Message}
	case format.OutputLimit:
		return BindingFailure{Msg: "bindc: the generated Ergo exceeded format output limit"}
	}
	out
}

// BindAndEmitRoundTrips checks Parse -> Bind -> Report + ErgoText on a complete mini header with handles, structs, callbacks, and buffers.
law BindAndEmitRoundTrips(n uint8) {
	let valStr = FormatUint64(uint64(n%10 + 1))
	let hdr = "#ifndef T_H\n#define T_H\n#include <stdint.h>\n#define ABI_V 1\n#define ERR_OK 0\n#define ERR_BAD 1\ntypedef int32_t t_status;\ntypedef struct t_ctx t_ctx;\ntypedef struct { uint32_t size; uint32_t v; } t_opt;\nuint32_t t_abi(void);\nt_status t_create(t_ctx **out_ctx);\nvoid t_destroy(t_ctx *ctx);\nt_status t_use(t_ctx *ctx, const t_opt *opt, const uint8_t *buf, uint32_t buf_len);\n#endif\n"
	let m = Parse("t.h", hdr) catch {
	case ParseFailure:
		return false
	}
	let hsha = hex.Encode(sha256.Sum(hdr))
	let contract = "{\"header\":\"t.h\",\"header_sha256\":\"" + hsha + "\",\"go\":{\"package\":\"tlib\",\"import_path\":\"example.com/tlib\"},\"prefixes\":{\"function\":\"t_\",\"macro\":\"T_\",\"type\":\"t_\"},\"status\":{\"type\":\"t_status\",\"macro_prefix\":\"ERR_\",\"success\":\"ERR_OK\",\"exclude\":[]},\"abi\":{\"function\":\"t_abi\",\"macro\":\"ABI_V\"},\"handles\":[{\"type\":\"t_ctx\",\"create\":\"t_create\",\"out\":\"out_ctx\",\"destroy\":\"t_destroy\",\"thread\":\"owner\"}],\"autofill\":[{\"field\":\"size\",\"value\":\"size\"}],\"buffers\":{\"length_names\":[\"{name}_len\"],\"byte_length_names\":[],\"capacity_names\":[],\"count_names\":[],\"out_prefix\":\"out_\"},\"callbacks\":[],\"exceptions\":[],\"skips\":[]}"
	let b = Bind(m, hdr, contract) catch {
	case ContractFailure, BindingFailure:
		return false
	}
	let rep = Report(b)
	let ergo = ErgoText(b) catch {
	case BindingFailure:
		return false
	}
	strings.Contains(rep, "typed functions (4):") && strings.Contains(ergo, "extern go example.com/tlib.Use func Use") && strings.Contains(ergo, "// ergo:reads buf") && valStr != ""
}
