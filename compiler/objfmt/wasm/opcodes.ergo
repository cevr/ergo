// CodeBufTracksNestingAndBulkFlags proves structured block balance and bulk-memory detection.
law CodeBufTracksNestingAndBulkFlags(depth int) {
	let n = (depth%5+5)%5 + 1
	let mut cb = NewCodeBuf()
	for _ in 0..n {
		cb.Block(BlockEmpty)
	}
	cb.If(ValI32)
	cb.I32Const(int32(1))
	cb.Else()
	cb.I32Const(int32(2))
	cb.End()
	for _ in 0..n {
		cb.End()
	}
	let bal = cb.CodeBalanced() && !cb.UsesBulk
	cb.MemoryCopy()
	bal && cb.UsesBulk && !cb.UsesData
}

test CodeBufDetectsUnbalancedAndInvalidElse {
	let mut unclosed = NewCodeBuf()
	unclosed.Loop(BlockEmpty)
	assert !unclosed.CodeBalanced()
	unclosed.End()
	assert unclosed.CodeBalanced()

	let mut extraEnd = NewCodeBuf()
	extraEnd.End()
	assert !extraEnd.CodeBalanced()

	let mut badElse = NewCodeBuf()
	badElse.Block(BlockEmpty)
	badElse.Else()
	badElse.End()
	assert !badElse.CodeBalanced()
}
