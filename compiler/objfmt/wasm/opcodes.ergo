// SecCustom is WebAssembly section ID 0 (custom section).
let SecCustom = byte(0)

// SecType is WebAssembly section ID 1 (type section).
let SecType = byte(1)

// SecImport is WebAssembly section ID 2 (import section).
let SecImport = byte(2)

// SecFunction is WebAssembly section ID 3 (function section).
let SecFunction = byte(3)

// SecTable is WebAssembly section ID 4 (table section).
let SecTable = byte(4)

// SecMemory is WebAssembly section ID 5 (memory section).
let SecMemory = byte(5)

// SecGlobal is WebAssembly section ID 6 (global section).
let SecGlobal = byte(6)

// SecExport is WebAssembly section ID 7 (export section).
let SecExport = byte(7)

// SecStart is WebAssembly section ID 8 (start section).
let SecStart = byte(8)

// SecElement is WebAssembly section ID 9 (element section).
let SecElement = byte(9)

// SecCode is WebAssembly section ID 10 (code section).
let SecCode = byte(10)

// SecData is WebAssembly section ID 11 (data section).
let SecData = byte(11)

// SecDataCount is WebAssembly section ID 12 (bulk-memory data count section).
let SecDataCount = byte(12)

// ValI32 is the 32-bit integer value type encoding (0x7f).
let ValI32 = byte(0x7f)

// ValI64 is the 64-bit integer value type encoding (0x7e).
let ValI64 = byte(0x7e)

// ValF32 is the 32-bit IEEE-754 float value type encoding (0x7d).
let ValF32 = byte(0x7d)

// ValF64 is the 64-bit IEEE-754 float value type encoding (0x7c).
let ValF64 = byte(0x7c)

// ValFuncRef is the function reference value type encoding (0x70).
let ValFuncRef = byte(0x70)

// ValExternRef is the external reference value type encoding (0x6f).
let ValExternRef = byte(0x6f)

// BlockEmpty is the empty block type encoding (0x40).
let BlockEmpty = byte(0x40)

// FuncTypeTag is the function signature type constructor byte (0x60).
let FuncTypeTag = byte(0x60)

// LimitMin is the limits header byte when only minimum is specified (0x00).
let LimitMin = byte(0x00)

// LimitMinMax is the limits header byte when both minimum and maximum are specified (0x01).
let LimitMinMax = byte(0x01)

// MutConst is the immutable global mutability byte (0x00).
let MutConst = byte(0x00)

// MutVar is the mutable global mutability byte (0x01).
let MutVar = byte(0x01)

// KindFunc is the external import/export descriptor kind for functions (0x00).
