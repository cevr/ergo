// MemorySize emits memory.size for memory 0.
func MemorySize(c mut CodeBuf) {
	c.Buf.U8(OpMemorySize)
	c.Buf.U8(byte(0x00))
}

// MemoryGrow emits memory.grow for memory 0.
func MemoryGrow(c mut CodeBuf) {
	c.Buf.U8(OpMemoryGrow)
	c.Buf.U8(byte(0x00))
}

// MemoryInit emits bulk-memory memory.init for passive segment dataIdx into memory 0.
func MemoryInit(c mut CodeBuf, dataIdx uint32) {
	c.UsesBulk = true
	c.UsesData = true
	c.Buf.U8(OpPrefixFC)
	c.Buf.ULEB32(BulkMemoryInit)
	c.Buf.ULEB32(dataIdx)
	c.Buf.U8(byte(0x00))
}

// DataDrop emits bulk-memory data.drop for data segment dataIdx.
func DataDrop(c mut CodeBuf, dataIdx uint32) {
	c.UsesBulk = true
	c.UsesData = true
	c.Buf.U8(OpPrefixFC)
	c.Buf.ULEB32(BulkDataDrop)
	c.Buf.ULEB32(dataIdx)
}

// MemoryCopy emits bulk-memory memory.copy between memory 0 and memory 0.
func MemoryCopy(c mut CodeBuf) {
	c.UsesBulk = true
	c.Buf.U8(OpPrefixFC)
	c.Buf.ULEB32(BulkMemoryCopy)
	c.Buf.U8(byte(0x00))
	c.Buf.U8(byte(0x00))
}

// MemoryFill emits bulk-memory memory.fill for memory 0.
func MemoryFill(c mut CodeBuf) {
	c.UsesBulk = true
	c.Buf.U8(OpPrefixFC)
	c.Buf.ULEB32(BulkMemoryFill)
	c.Buf.U8(byte(0x00))
}

