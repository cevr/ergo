// IsValidValType reports whether b is a valid WebAssembly 1.0 value type byte.
func IsValidValType(b byte) bool {
	b == ValI32 || b == ValI64 || b == ValF32 || b == ValF64 || b == ValFuncRef || b == ValExternRef
}

// CodeBuf accumulates WebAssembly function body instructions with structured block tracking.
type CodeBuf {
	Buf       Buf,
	IfStack   []uint8,
	UsesBulk  bool,
	UsesData  bool,
	Underflow bool,
	BadElse   bool,
}

// NewCodeBuf creates an empty instruction builder.
func NewCodeBuf() CodeBuf {
	CodeBuf{Buf: NewBuf(), IfStack: []uint8{}, UsesBulk: false, UsesData: false, Underflow: false, BadElse: false}
}

// CodeLen returns the encoded instruction byte count without the trailing 0x0b body terminator.
func CodeLen(c CodeBuf) uint32 {
	c.Buf.BufLen()
}

// CodeBytes returns the encoded instruction bytes currently in c.
func CodeBytes(c CodeBuf) []byte {
	c.Buf.BufBytes()
}

// CodeBalanced reports whether all opened structured control blocks are properly closed.
func CodeBalanced(c CodeBuf) bool {
	!c.Underflow && !c.BadElse && c.IfStack.Len() == 0
}

// Unreachable emits the unreachable instruction.
func Unreachable(c mut CodeBuf) { c.Buf.U8(OpUnreachable) }

// Nop emits the nop instruction.
func Nop(c mut CodeBuf) { c.Buf.U8(OpNop) }

func openBlock(c mut CodeBuf, op byte, bt byte, tag uint8) {
	c.Buf.U8(op)
	c.Buf.U8(bt)
	c.IfStack = c.IfStack.Append(tag)
}

func openBlockType(c mut CodeBuf, op byte, typeIdx uint32, tag uint8) {
	c.Buf.U8(op)
	c.Buf.SLEB64(int64(typeIdx))
	c.IfStack = c.IfStack.Append(tag)
}

// Block opens a structured block with a value or empty blocktype.
func Block(c mut CodeBuf, bt byte) {
	c.openBlock(OpBlock, bt, uint8(0))
}

// BlockType opens a structured block referencing a function type signature index.
func BlockType(c mut CodeBuf, typeIdx uint32) {
	c.openBlockType(OpBlock, typeIdx, uint8(0))
}

// Loop opens a structured loop with a value or empty blocktype.
func Loop(c mut CodeBuf, bt byte) {
	c.openBlock(OpLoop, bt, uint8(0))
}

// LoopType opens a structured loop referencing a function type signature index.
func LoopType(c mut CodeBuf, typeIdx uint32) {
	c.openBlockType(OpLoop, typeIdx, uint8(0))
}

// If opens a structured conditional block with a value or empty blocktype.
func If(c mut CodeBuf, bt byte) {
	c.openBlock(OpIf, bt, uint8(1))
}

// IfType opens a structured conditional block referencing a function type signature index.
func IfType(c mut CodeBuf, typeIdx uint32) {
	c.openBlockType(OpIf, typeIdx, uint8(1))
}

// Else emits the else branch marker for the innermost open If block.
func Else(c mut CodeBuf) {
	let n = c.IfStack.Len()
	if n == 0 || c.IfStack[n-1] != uint8(1) {
		c.BadElse = true
	} else {
		c.IfStack[n-1] = uint8(2)
	}
	c.Buf.U8(OpElse)
}

// End closes the innermost open Block, Loop, or If block.
func End(c mut CodeBuf) {
	let n = c.IfStack.Len()
	if n == 0 {
		c.Underflow = true
	} else {
		c.IfStack = c.IfStack.Slice(0, n-1)
	}
	c.Buf.U8(OpEnd)
}

// Br emits an unconditional branch to label depth l.
func Br(c mut CodeBuf, l uint32) {
	c.Buf.U8(OpBr)
	c.Buf.ULEB32(l)
}

// BrIf emits a conditional branch to label depth l.
func BrIf(c mut CodeBuf, l uint32) {
	c.Buf.U8(OpBrIf)
	c.Buf.ULEB32(l)
}

// BrTable emits a jump-table branch over labels with fallback defaultLabel.
func BrTable(c mut CodeBuf, labels []uint32, defaultLabel uint32) {
	c.Buf.U8(OpBrTable)
	c.Buf.ULEB32(uint32(labels.Len()))
	for l in labels {
		c.Buf.ULEB32(l)
	}
	c.Buf.ULEB32(defaultLabel)
}

