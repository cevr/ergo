import slices
import strconv
import strings
import utf8

// BadRegex reports an invalid regular expression pattern.
type BadRegex {
	// Pattern is the pattern text that failed to compile.
	Pattern string,
	// Reason describes the syntax error.
	Reason string,
}

let reAccept = uint8(1)
let reSplit = uint8(2)
let reStart = uint8(3)
let reEnd = uint8(4)
let reAny = uint8(5)
let reRune = uint8(6)
let reClass = uint8(7)

type classRange {
	lo uint32,
	hi uint32,
}

// Regex is a compiled NFA regular expression stored in flat SoA instruction arrays.
type Regex {
	// Pattern is the original pattern string.
	Pattern string,
	// StartPC is the entry instruction index in Op/X/Y.
	StartPC uint32,
	// Op holds each NFA instruction opcode.
	Op []uint8,
	// X holds the first operand (next state, split left, rune, or class ID).
	X []uint32,
	// Y holds the second operand (split right).
	Y []uint32,
	// ClassNeg holds whether each character class is negated.
	ClassNeg []bool,
	// ClassStart holds the start offset in ClassLo/ClassHi per class ID.
	ClassStart []uint32,
	// ClassLen holds the number of inclusive rune ranges per class ID.
	ClassLen []uint32,
	// ClassLo holds inclusive lower codepoint bounds across all classes.
	ClassLo []uint32,
	// ClassHi holds inclusive upper codepoint bounds across all classes.
	ClassHi []uint32,
}

type nfaBuilder {
	op         []uint8,
	x          []uint32,
	y          []uint32,
	classNeg   []bool,
	classStart []uint32,
	classLen   []uint32,
	classLo    []uint32,
	classHi    []uint32,
}

type frag {
	start uint32,
	outs  []uint32,
	outY  []bool,
}

type regexParser {
	pat string,
	pos int,
	b   nfaBuilder,
}

func emitInst(b mut nfaBuilder, op uint8, x uint32, y uint32) uint32 {
	let pc = uint32(b.op.Len())
	b.op = b.op.Append(op)
	b.x = b.x.Append(x)
	b.y = b.y.Append(y)
	pc
}

func addClass(b mut nfaBuilder, neg bool, ranges []classRange) uint32 {
	let cid = uint32(b.classNeg.Len())
	let start = uint32(b.classLo.Len())
	b.classNeg = b.classNeg.Append(neg)
	b.classStart = b.classStart.Append(start)
	b.classLen = b.classLen.Append(uint32(ranges.Len()))
	for r in ranges {
		b.classLo = b.classLo.Append(r.lo)
		b.classHi = b.classHi.Append(r.hi)
	}
	cid
}

func patchFrag(b mut nfaBuilder, f frag, target uint32) {
	for i in 0..f.outs.Len() {
		let pc = int(f.outs[i])
		if f.outY[i] {
			b.y[pc] = target
		} else {
			b.x[pc] = target
		}
	}
}

func emptyFrag(b mut nfaBuilder) frag {
	let pc = emitInst(b, reSplit, uint32(0), uint32(0))
	frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
}

func appendFrag(b mut nfaBuilder, a frag, next frag) frag {
	patchFrag(b, a, next.start)
	frag{start: a.start, outs: next.outs, outY: next.outY}
}

func altFrags(b mut nfaBuilder, a frag, other frag) frag {
	let pc = emitInst(b, reSplit, a.start, other.start)
	let outs = slices.AppendAll(slices.Clone(a.outs), other.outs)
	let outY = slices.AppendAll(slices.Clone(a.outY), other.outY)
	frag{start: pc, outs: outs, outY: outY}
}

func cloneRange(b mut nfaBuilder, pc uint32, clones mut []uint32) uint32 {
	if int(pc) < (*clones).Len() && (*clones)[int(pc)] != uint32(0xffffffff) {
		return (*clones)[int(pc)]
	}
	let op = b.op[int(pc)]
	let origX = b.x[int(pc)]
	let origY = b.y[int(pc)]
	let npc = emitInst(b, op, origX, origY)
	for (*clones).Len() <= int(pc) {
		*clones = (*clones).Append(uint32(0xffffffff))
	}
	(*clones)[int(pc)] = npc
	if op == reSplit {
		if origX != uint32(0xffffffff) {
			b.x[int(npc)] = cloneRange(b, origX, clones)
		}
		if origY != uint32(0xffffffff) {
			b.y[int(npc)] = cloneRange(b, origY, clones)
		}
	} else if op != reAccept && origX != uint32(0xffffffff) {
		b.x[int(npc)] = cloneRange(b, origX, clones)
	}
	npc
}

func cloneFrag(b mut nfaBuilder, f frag) frag {
	let mut clones = []uint32{}
	for _ in 0..b.op.Len() {
		clones = clones.Append(uint32(0xffffffff))
	}
	for i in 0..f.outs.Len() {
		let pc = int(f.outs[i])
		if f.outY[i] {
			b.y[pc] = uint32(0xffffffff)
		} else {
			b.x[pc] = uint32(0xffffffff)
		}
	}
	let nStart = cloneRange(b, f.start, &clones)
	let mut nOuts = []uint32{}
	let mut nOutY = []bool{}
	for i in 0..f.outs.Len() {
		let origPC = int(f.outs[i])
		let clonedPC = clones[origPC]
		nOuts = nOuts.Append(clonedPC)
		nOutY = nOutY.Append(f.outY[i])
	}
	frag{start: nStart, outs: nOuts, outY: nOutY}
}

func peekRune(p regexParser) (uint32, int) {
	if p.pos >= p.pat.Len() {
		return (uint32(0), 0)
	}
	let d = utf8.DecodeRuneInString(p.pat[p.pos:p.pat.Len()])
	(uint32(d.Rune), d.Size)
}

func escapeRanges(ch byte) (bool, []classRange) {
	if ch == 'd' {
		return (true, []classRange{classRange{lo: uint32('0'), hi: uint32('9')}})
	}
	if ch == 'D' {
		return (true, []classRange{
			classRange{lo: uint32(0), hi: uint32('0') - uint32(1)},
			classRange{lo: uint32('9') + uint32(1), hi: uint32(0x10ffff)},
		})
	}
	if ch == 's' {
		return (true, []classRange{
			classRange{lo: uint32('\t'), hi: uint32('\r')},
			classRange{lo: uint32(' '), hi: uint32(' ')},
		})
	}
	if ch == 'S' {
		return (true, []classRange{
			classRange{lo: uint32(0), hi: uint32('\t') - uint32(1)},
			classRange{lo: uint32('\r') + uint32(1), hi: uint32(' ') - uint32(1)},
			classRange{lo: uint32(' ') + uint32(1), hi: uint32(0x10ffff)},
		})
	}
	if ch == 'w' {
		return (true, []classRange{
			classRange{lo: uint32('0'), hi: uint32('9')},
			classRange{lo: uint32('A'), hi: uint32('Z')},
			classRange{lo: uint32('_'), hi: uint32('_')},
			classRange{lo: uint32('a'), hi: uint32('z')},
		})
	}
	if ch == 'W' {
		return (true, []classRange{
			classRange{lo: uint32(0), hi: uint32('0') - uint32(1)},
			classRange{lo: uint32('9') + uint32(1), hi: uint32('A') - uint32(1)},
			classRange{lo: uint32('Z') + uint32(1), hi: uint32('_') - uint32(1)},
			classRange{lo: uint32('_') + uint32(1), hi: uint32('a') - uint32(1)},
			classRange{lo: uint32('z') + uint32(1), hi: uint32(0x10ffff)},
		})
	}
	(false, []classRange{})
}

func escapeLiteral(ch byte) uint32 {
	if ch == 'n' {
		return uint32('\n')
	}
	if ch == 't' {
		return uint32('\t')
	}
	if ch == 'r' {
		return uint32('\r')
	}
	if ch == 'f' {
		return uint32('\f')
	}
	if ch == 'v' {
		return uint32('\v')
	}
	uint32(ch)
}

func parseClassAtom(p mut regexParser) (bool, uint32, []classRange) fails BadRegex {
	if p.pos >= p.pat.Len() {
		return BadRegex{Pattern: p.pat, Reason: "unclosed character class"}
	}
	let (r, w) = peekRune(*p)
	p.pos = p.pos + w
	if r == uint32('\\') {
		if p.pos >= p.pat.Len() {
			return BadRegex{Pattern: p.pat, Reason: "trailing backslash in class"}
		}
		let (esc, ew) = peekRune(*p)
		p.pos = p.pos + ew
		if ew == 1 {
			let (isCls, rs) = escapeRanges(byte(esc))
			if isCls {
				return (true, uint32(0), rs)
			}
			return (false, escapeLiteral(byte(esc)), []classRange{})
		}
		return (false, esc, []classRange{})
	}
	(false, r, []classRange{})
}

func parseClass(p mut regexParser) frag fails BadRegex {
	p.pos = p.pos + 1
	let mut neg = false
	if p.pos < p.pat.Len() && p.pat[p.pos] == '^' {
		neg = true
		p.pos = p.pos + 1
	}
	let mut ranges = []classRange{}
	let mut first = true
	for p.pos < p.pat.Len() {
		if !first && p.pat[p.pos] == ']' {
			p.pos = p.pos + 1
			let cid = addClass(&p.b, neg, ranges)
			let pc = emitInst(&p.b, reClass, uint32(0), cid)
			return frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
		}
		first = false
		let (isMulti, lo, multiRs) = try parseClassAtom(p)
		if isMulti {
			ranges = slices.AppendAll(ranges, multiRs)
			continue
		}
		if p.pos+1 < p.pat.Len() && p.pat[p.pos] == '-' && p.pat[p.pos+1] != ']' {
			p.pos = p.pos + 1
			let (isMultiHi, hi, _) = try parseClassAtom(p)
			if isMultiHi {
				return BadRegex{Pattern: p.pat, Reason: "invalid character class range"}
			}
			if hi < lo {
				return BadRegex{Pattern: p.pat, Reason: "invalid character class range"}
			}
			ranges = ranges.Append(classRange{lo: lo, hi: hi})
		} else {
			ranges = ranges.Append(classRange{lo: lo, hi: lo})
		}
	}
	BadRegex{Pattern: p.pat, Reason: "missing closing ]"}
}

func parseRepeatBounds(p mut regexParser) (int, int) fails BadRegex {
	p.pos = p.pos + 1
	let mut minStr = ""
	for p.pos < p.pat.Len() && p.pat[p.pos] >= '0' && p.pat[p.pos] <= '9' {
		minStr = minStr + p.pat[p.pos:p.pos+1]
		p.pos = p.pos + 1
	}
	if minStr == "" {
		return BadRegex{Pattern: p.pat, Reason: "invalid repeat quantifier"}
	}
	let minCount = strconv.Atoi(minStr) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return BadRegex{Pattern: p.pat, Reason: "invalid repeat count"}
	}
	if p.pos < p.pat.Len() && p.pat[p.pos] == '}' {
		p.pos = p.pos + 1
		return (minCount, minCount)
	}
	if p.pos >= p.pat.Len() || p.pat[p.pos] != ',' {
		return BadRegex{Pattern: p.pat, Reason: "invalid repeat quantifier"}
	}
	p.pos = p.pos + 1
	if p.pos < p.pat.Len() && p.pat[p.pos] == '}' {
		p.pos = p.pos + 1
		return (minCount, -1)
	}
	let mut maxStr = ""
	for p.pos < p.pat.Len() && p.pat[p.pos] >= '0' && p.pat[p.pos] <= '9' {
		maxStr = maxStr + p.pat[p.pos:p.pos+1]
		p.pos = p.pos + 1
	}
	if maxStr == "" || p.pos >= p.pat.Len() || p.pat[p.pos] != '}' {
		return BadRegex{Pattern: p.pat, Reason: "invalid repeat quantifier"}
	}
	p.pos = p.pos + 1
	let maxCount = strconv.Atoi(maxStr) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return BadRegex{Pattern: p.pat, Reason: "invalid repeat count"}
	}
	if maxCount < minCount {
		return BadRegex{Pattern: p.pat, Reason: "invalid repeat range"}
	}
	(minCount, maxCount)
}

func parseAtom(p mut regexParser) frag fails BadRegex {
	let (r, w) = peekRune(*p)
	if r == uint32('(') {
		p.pos = p.pos + 1
		if p.pos+1 < p.pat.Len() && p.pat[p.pos] == '?' && p.pat[p.pos+1] == ':' {
			p.pos = p.pos + 2
		}
		let inner = try parseAlt(p)
		if p.pos >= p.pat.Len() || p.pat[p.pos] != ')' {
			return BadRegex{Pattern: p.pat, Reason: "missing closing )"}
		}
		p.pos = p.pos + 1
		return inner
	}
	if r == uint32('[') {
		return parseClass(p)
	}
	if r == uint32('^') {
		p.pos = p.pos + 1
		let pc = emitInst(&p.b, reStart, uint32(0), uint32(0))
		return frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
	}
	if r == uint32('$') {
		p.pos = p.pos + 1
		let pc = emitInst(&p.b, reEnd, uint32(0), uint32(0))
		return frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
	}
	if r == uint32('.') {
		p.pos = p.pos + 1
		let pc = emitInst(&p.b, reAny, uint32(0), uint32(0))
		return frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
	}
	if r == uint32('*') || r == uint32('+') || r == uint32('?') {
		return BadRegex{Pattern: p.pat, Reason: "missing argument to repetition operator"}
	}
	if r == uint32('\\') {
		p.pos = p.pos + 1
		if p.pos >= p.pat.Len() {
			return BadRegex{Pattern: p.pat, Reason: "trailing backslash"}
		}
		let (esc, ew) = peekRune(*p)
		p.pos = p.pos + ew
		if ew == 1 {
			let (isCls, rs) = escapeRanges(byte(esc))
			if isCls {
				let cid = addClass(&p.b, false, rs)
				let pc = emitInst(&p.b, reClass, uint32(0), cid)
				return frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
			}
			let pc = emitInst(&p.b, reRune, uint32(0), escapeLiteral(byte(esc)))
			return frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
		}
		let pc = emitInst(&p.b, reRune, uint32(0), esc)
		return frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
	}
	p.pos = p.pos + w
	let pc = emitInst(&p.b, reRune, uint32(0), r)
	frag{start: pc, outs: []uint32{pc}, outY: []bool{false}}
}

func applyRepeat(p mut regexParser, base frag, minCount int, maxCount int) frag {
	let mut acc = emptyFrag(&p.b)
	let mut hasAcc = false
	for _ in 0..minCount {
		let copy = cloneFrag(&p.b, base)
		if !hasAcc {
			acc = copy
			hasAcc = true
		} else {
			acc = appendFrag(&p.b, acc, copy)
		}
	}
	if maxCount < 0 {
		let tail = cloneFrag(&p.b, base)
		let split = emitInst(&p.b, reSplit, tail.start, uint32(0))
		patchFrag(&p.b, tail, split)
		let star = frag{start: split, outs: []uint32{split}, outY: []bool{true}}
		if !hasAcc {
			return star
		}
		return appendFrag(&p.b, acc, star)
	}
	for _ in minCount..maxCount {
		let optCopy = cloneFrag(&p.b, base)
		let split = emitInst(&p.b, reSplit, optCopy.start, uint32(0))
		let optFrag = frag{
			start: split,
			outs:  optCopy.outs.Append(split),
			outY:  optCopy.outY.Append(true),
		}
		if !hasAcc {
			acc = optFrag
			hasAcc = true
		} else {
			acc = appendFrag(&p.b, acc, optFrag)
		}
	}
	acc
}

func parsePiece(p mut regexParser) frag fails BadRegex {
	let mut f = try parseAtom(p)
	for p.pos < p.pat.Len() {
		let ch = p.pat[p.pos]
		if ch == '*' {
			p.pos = p.pos + 1
			if p.pos < p.pat.Len() && p.pat[p.pos] == '?' {
				p.pos = p.pos + 1
			}
			let split = emitInst(&p.b, reSplit, f.start, uint32(0))
			patchFrag(&p.b, f, split)
			f = frag{start: split, outs: []uint32{split}, outY: []bool{true}}
		} else if ch == '+' {
			p.pos = p.pos + 1
			if p.pos < p.pat.Len() && p.pat[p.pos] == '?' {
				p.pos = p.pos + 1
			}
			let split = emitInst(&p.b, reSplit, f.start, uint32(0))
			patchFrag(&p.b, f, split)
			f = frag{start: f.start, outs: []uint32{split}, outY: []bool{true}}
		} else if ch == '?' {
			p.pos = p.pos + 1
			if p.pos < p.pat.Len() && p.pat[p.pos] == '?' {
				p.pos = p.pos + 1
			}
			let split = emitInst(&p.b, reSplit, f.start, uint32(0))
			f = frag{start: split, outs: f.outs.Append(split), outY: f.outY.Append(true)}
		} else if ch == '{' {
			let (lo, hi) = try parseRepeatBounds(p)
			if p.pos < p.pat.Len() && p.pat[p.pos] == '?' {
				p.pos = p.pos + 1
			}
			f = applyRepeat(p, f, lo, hi)
		} else {
			break
		}
	}
	f
}

func parseConcat(p mut regexParser) frag fails BadRegex {
	let mut has = false
	let mut acc = frag{start: uint32(0), outs: []uint32{}, outY: []bool{}}
	for p.pos < p.pat.Len() {
		let ch = p.pat[p.pos]
		if ch == '|' || ch == ')' {
			break
		}
		let piece = try parsePiece(p)
		if !has {
			acc = piece
			has = true
		} else {
			acc = appendFrag(&p.b, acc, piece)
		}
	}
	if !has {
		return emptyFrag(&p.b)
	}
	acc
}

func parseAlt(p mut regexParser) frag fails BadRegex {
	let mut left = try parseConcat(p)
	for p.pos < p.pat.Len() && p.pat[p.pos] == '|' {
		p.pos = p.pos + 1
		let right = try parseConcat(p)
		left = altFrags(&p.b, left, right)
	}
	left
}

// CompileRegex parses and compiles a regular expression pattern into a flat NFA Regex.
func CompileRegex(pattern string) Regex fails BadRegex {
	let mut p = regexParser{
		pat: pattern,
		pos: 0,
		b:   nfaBuilder{
			op:         []uint8{},
			x:          []uint32{},
			y:          []uint32{},
			classNeg:   []bool{},
			classStart: []uint32{},
			classLen:   []uint32{},
			classLo:    []uint32{},
			classHi:    []uint32{},
		},
	}
	let root = try parseAlt(&p)
	if p.pos != pattern.Len() {
		return BadRegex{Pattern: pattern, Reason: "unexpected character at offset \(p.pos)"}
	}
	let acceptPC = emitInst(&p.b, reAccept, uint32(0), uint32(0))
	patchFrag(&p.b, root, acceptPC)
	Regex{
		Pattern:    pattern,
		StartPC:    root.start,
		Op:         p.b.op,
		X:          p.b.x,
		Y:          p.b.y,
		ClassNeg:   p.b.classNeg,
		ClassStart: p.b.classStart,
		ClassLen:   p.b.classLen,
		ClassLo:    p.b.classLo,
		ClassHi:    p.b.classHi,
	}
}

func classMatches(re Regex, cid uint32, r uint32) bool {
	let start = int(re.ClassStart[int(cid)])
	let n = int(re.ClassLen[int(cid)])
	let mut hit = false
	for i in 0..n {
		if r >= re.ClassLo[start+i] && r <= re.ClassHi[start+i] {
			hit = true
			break
		}
	}
	if re.ClassNeg[int(cid)] { !hit } else { hit }
}

func addClosureState(re Regex, pc uint32, atStart bool, atEnd bool, list mut []uint32, gen mut []uint32, curGen uint32) bool {
	let mut stack = []uint32{pc}
	let mut matched = false
	for stack.Len() > 0 {
		let cur = stack[stack.Len()-1]
		stack = stack[0 : stack.Len()-1]
		let i = int(cur)
		if (*gen)[i] == curGen {
			continue
		}
		(*gen)[i] = curGen
		let op = re.Op[i]
		if op == reAccept {
			matched = true
		} else if op == reSplit {
			stack = stack.Append(re.Y[i])
			stack = stack.Append(re.X[i])
		} else if op == reStart {
			if atStart {
				stack = stack.Append(re.X[i])
			}
		} else if op == reEnd {
			if atEnd {
				stack = stack.Append(re.X[i])
			}
		} else {
			*list = (*list).Append(cur)
		}
	}
	matched
}

// MatchString reports whether re matches any substring of text (honoring ^ and $ anchors).
func MatchString(re Regex, text string) bool {
	let nStates = re.Op.Len()
	let mut gen = slices.WithCapacity[uint32](nStates)
	for _ in 0..nStates {
		gen = gen.Append(uint32(0))
	}
	let mut cur = []uint32{}
	let mut next = []uint32{}
	let mut curGen = uint32(1)
	if addClosureState(re, re.StartPC, true, text.Len() == 0, &cur, &gen, curGen) {
		return true
	}
	let mut pos = 0
	for pos < text.Len() {
		let d = utf8.DecodeRuneInString(text[pos:text.Len()])
		let r = uint32(d.Rune)
		pos = pos + d.Size
		let atEnd = pos == text.Len()
		curGen = curGen + uint32(1)
		next = next[0:0]
		for pc in cur {
			let i = int(pc)
			let op = re.Op[i]
			let hit = if op == reAny {
				r != uint32('\n')
			} else if op == reRune {
				r == re.Y[i]
			} else if op == reClass {
				classMatches(re, re.Y[i], r)
			} else {
				false
			}
			if hit {
				if addClosureState(re, re.X[i], false, atEnd, &next, &gen, curGen) {
					return true
				}
			}
		}
		if addClosureState(re, re.StartPC, false, atEnd, &next, &gen, curGen) {
			return true
		}
		cur = slices.Clone(next)
	}
	false
}

// RegexLiteralMatchesSelf guarantees any escaped literal pattern matches its source text.
law RegexLiteralMatchesSelf(s string) {
	let mut pat = strings.NewBuilder()
	pat.WriteByte('^')
	for i in 0..s.Len() {
		let c = s[i]
		if c == '.' || c == '[' || c == ']' || c == '(' || c == ')' || c == '{' || c == '}' || c == '*' || c == '+' || c == '?' || c == '^' || c == '$' || c == '|' || c == '\\' {
			pat.WriteByte('\\')
		}
		pat.WriteByte(c)
	}
	pat.WriteByte('$')
	let re = try CompileRegex(pat.String())
	MatchString(re, s)
}

test RegexMatchesBudgetFacts {
	let patterns = []string{
		"^time\\.Time\\.(String|Format|GoString)$",
		"^ergo\\.local/prototype/runtime/v1\\.(RegisterMachine|RegisteredGraph)\\[",
		"^main\\.init\\.[1-9]",
		"^crypto/",
		"^strings\\.ToUpper$",
	}
	for p in patterns {
		let _ = try CompileRegex(p)
	}
	let rTime = try CompileRegex("^time\\.Time\\.(String|Format|GoString)$")
	assert MatchString(rTime, "time.Time.String")
	assert !MatchString(rTime, "time.Time.String2")

	let rReg = try CompileRegex("^ergo\\.local/prototype/runtime/v1\\.(RegisterMachine|RegisteredGraph)\\[")
	assert MatchString(rReg, "ergo.local/prototype/runtime/v1.RegisterMachine[go.shape.struct {}]")
	assert !MatchString(rReg, "ergo.local/prototype/runtime/v1.VariantOf[go.shape.struct {}]")

	let rInit = try CompileRegex("^main\\.init\\.[1-9]")
	assert MatchString(rInit, "main.init.1")
	assert !MatchString(rInit, "main.init.0")

	let mut bad = false
	let _ = CompileRegex("[z-a]") catch {
	case BadRegex:
		bad = true
		try CompileRegex("a")
	}
	assert bad
}
