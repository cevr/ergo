import strings

// FixtureSpec names a size-budgeted fixture and its source folder relative to the repository root.
type FixtureSpec {
	// Name is the fixture's short identifier in budgets.json.
	Name string,
	// Dir is the slash-separated directory relative to the module root.
	Dir string,
}

// DefaultFixtures returns the fixtures held by internal/sizes/budgets.json.
func DefaultFixtures() []FixtureSpec {
	[]FixtureSpec{
		FixtureSpec{Name: "hello", Dir: "internal/sizes/testdata/hello"},
		FixtureSpec{Name: "pure", Dir: "internal/sizes/testdata/pure"},
		FixtureSpec{Name: "unused", Dir: "internal/sizes/testdata/unused"},
		FixtureSpec{Name: "relay", Dir: "examples/relay/cmd/relay"},
		FixtureSpec{Name: "kvstore", Dir: "examples/kvstore/cmd/kvstore"},
		FixtureSpec{Name: "deploys", Dir: "examples/deploys/cmd/deploys"},
		FixtureSpec{Name: "pairing", Dir: "examples/pairing/cmd/pairing"},
	}
}

// ControlDir returns the relative directory of the Go hello control package.
func ControlDir() string { "internal/sizes/testdata/gohello" }

// DefectDir returns the relative directory of the defect-report parity fixture.
func DefectDir() string { "internal/sizes/testdata/defect" }

// DefectMemoryBytes returns the memory bound enforced when running the defect parity fixture.
func DefectMemoryBytes() uint64 { uint64(256) << 20 }

// CountGoListDeps counts the Go package names printed by `go list -deps`.
func CountGoListDeps(output string) int { strings.Fields(output).Len() }

func bytesContainsSubslice(hay []byte, needle []byte) bool {
	if needle.Len() == 0 {
		return true
	}
	if needle.Len() > hay.Len() {
		return false
	}
	let limit = hay.Len() - needle.Len()
	for i in 0..limit+1 {
		let mut ok = true
		for j in 0..needle.Len() {
			if hay[i+j] != needle[j] {
				ok = false
				break
			}
		}
		if ok {
			return true
		}
	}
	false
}

func findNamedBytes(names []string, bodies [][]byte, target string) (bool, []byte) {
	for i in 0..names.Len() {
		if names[i] == target {
			return (true, bodies[i])
		}
	}
	(false, []byte{})
}

// CheckReproducible verifies that no binary leaks root and that unused matches hello byte-for-byte.
func CheckReproducible(root string, names []string, bodies [][]byte) []string {
	let mut problems = []string{}
	let rootBytes = root.Bytes()
	let limit = if names.Len() < bodies.Len() { names.Len() } else { bodies.Len() }
	for i in 0..limit {
		if rootBytes.Len() > 0 && bytesContainsSubslice(bodies[i], rootBytes) {
			problems = problems.Append("\(names[i]) holds the checkout's path \(root)")
		}
	}
	let (hasUnused, unusedBytes) = findNamedBytes(names, bodies, "unused")
	let (hasHello, helloBytes) = findNamedBytes(names, bodies, "hello")
	if hasUnused && hasHello && unusedBytes != helloBytes {
		problems = problems.Append("unused (\(unusedBytes.Len()) bytes) differs from hello (\(helloBytes.Len()) bytes): a declaration main never reaches reached the binary")
	}
	let (hasUnusedS, unusedSBytes) = findNamedBytes(names, bodies, "unused.stripped")
	let (hasHelloS, helloSBytes) = findNamedBytes(names, bodies, "hello.stripped")
	if hasUnusedS && hasHelloS && unusedSBytes != helloSBytes {
		problems = problems.Append("unused.stripped (\(unusedSBytes.Len()) bytes) differs from hello.stripped (\(helloSBytes.Len()) bytes): a declaration main never reaches reached the binary")
	}
	problems
}

// CheckDefectOutput verifies that the debug and stripped builds produce identical defect output
// containing the expected source position line.
func CheckDefectOutput(debugExit int, debugOut string, strippedExit int, strippedOut string) string {
	let run0 = "exit \(debugExit)\n\(debugOut)"
	let run1 = "exit \(strippedExit)\n\(strippedOut)"
	if run0 != run1 || !strings.Contains(run0, "\tpick at main.ergo:2\n") {
		return "the defect report differs between the --debug and the default build:\n--debug:\n\(run0)\ndefault:\n\(run1)"
	}
	""
}

// ReproducibleRejectsLeakedRoot checks that root path bytes embedded in a binary are reported.
law ReproducibleRejectsLeakedRoot(name string) {
	let n = if name == "" { "hello" } else { name }
	let body = "/workspaces/ergo".Bytes()
	let probs = CheckReproducible("/workspaces/ergo", []string{n}, [][]byte{body})
	probs.Len() == 1
}

test CmdChecksVerifyReproAndDefectParity {
	assert DefaultFixtures().Len() == 7
	assert ControlDir() == "internal/sizes/testdata/gohello"
	assert DefectDir() == "internal/sizes/testdata/defect"
	assert DefectMemoryBytes() == uint64(268435456)
	assert CountGoListDeps("fmt\nos\nmain\n") == 3
	assert CheckReproducible("/r", []string{"hello", "unused", "hello.stripped", "unused.stripped"}, [][]byte{[]byte{byte(1)}, []byte{byte(1)}, []byte{byte(2)}, []byte{byte(2)}}).Len() == 0
	assert CheckReproducible("/r", []string{"hello", "unused"}, [][]byte{[]byte{byte(1)}, []byte{byte(1), byte(2)}}).Len() == 1
	assert CheckDefectOutput(1, "\tpick at main.ergo:2\n", 1, "\tpick at main.ergo:2\n") == ""
	assert CheckDefectOutput(1, "\tpick at main.ergo:2\n", 1, "changed") != ""
}
