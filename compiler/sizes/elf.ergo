import fs
import option
import slices
import utf8

// ELFError reports an unreadable or malformed ELF file during binary size measurement.
type ELFError {
	// Path identifies the binary being measured, or "(bytes)" when parsed in memory.
	Path string,
	// Reason describes the ELF format or I/O problem.
	Reason string,
}

// Binary is what one build pair of a program measures: the build with its
// symbol table and the stripped build, plus ELF sections, package text bytes,
// main symbol count, Go package count, and symbol names.
type Binary {
	// Size is the unstripped build's file size in bytes.
	Size uint64,
	// Stripped is the stripped build's file size in bytes.
	Stripped uint64,
	// SectionNames holds ELF section names in SoA alignment with SectionSizes.
	SectionNames []string,
	// SectionSizes holds summed ELF section sizes aligned with SectionNames.
	SectionSizes []uint64,
	// TextPkgs holds Go package names for executable text symbols.
	TextPkgs []string,
	// TextBytes holds summed executable symbol bytes aligned with TextPkgs.
	TextBytes []uint64,
	// MainSymbols counts the executable symbols belonging to package main.
	MainSymbols int,
	// GoPackages counts the Go packages linked by the binary.
	GoPackages int,
	// Symbols holds all symbol names from SHT_SYMTAB in table order.
	Symbols []string,
}

// BinaryTable stores a collection of Binary measurements in SoA columns.
type BinaryTable {
	// Paths holds the label or path for each stored Binary.
	Paths []string,
	// Sizes holds default build sizes aligned with Paths.
	Sizes []uint64,
	// StrippedSizes holds stripped build sizes aligned with Paths.
	StrippedSizes []uint64,
	// MainSymbolCounts holds MainSymbols aligned with Paths.
	MainSymbolCounts []int,
	// GoPackageCounts holds GoPackages aligned with Paths.
	GoPackageCounts []int,
	// Binaries holds the full Binary records aligned with Paths.
	Binaries []Binary,
}

// NewBinaryTable returns an empty BinaryTable.
func NewBinaryTable() BinaryTable {
	BinaryTable{
		Paths:            []string{},
		Sizes:            []uint64{},
		StrippedSizes:    []uint64{},
		MainSymbolCounts: []int{},
		GoPackageCounts:  []int{},
		Binaries:         []Binary{},
	}
}

// AddBinary appends a measured Binary under path and returns its row index.
func AddBinary(t mut BinaryTable, path string, b Binary) uint32 {
	let idx = uint32(t.Paths.Len())
	t.Paths = t.Paths.Append(path)
	t.Sizes = t.Sizes.Append(b.Size)
	t.StrippedSizes = t.StrippedSizes.Append(b.Stripped)
	t.MainSymbolCounts = t.MainSymbolCounts.Append(b.MainSymbols)
	t.GoPackageCounts = t.GoPackageCounts.Append(b.GoPackages)
	t.Binaries = t.Binaries.Append(b)
	idx
}

// SectionSize returns the summed size of ELF section name if present in b.
func SectionSize(b Binary, name string) option.Option[uint64] {
	for i in 0..b.SectionNames.Len() {
		if b.SectionNames[i] == name {
			return option.Some[uint64]{Value: b.SectionSizes[i]}
		}
	}
	option.None
}

// TextSize returns the executable text bytes attributed to pkg, or 0 if absent.
func TextSize(b Binary, pkg string) uint64 {
	for i in 0..b.TextPkgs.Len() {
		if b.TextPkgs[i] == pkg {
			return b.TextBytes[i]
		}
	}
	uint64(0)
}

let elfClass32 = uint8(1)
let elfClass64 = uint8(2)
let elfDataLSB = uint8(1)
let elfDataMSB = uint8(2)
let shtSymTab = uint32(2)
let shtNoBits = uint32(8)
let shtSymTabShndx = uint32(18)
let shnXIndex = uint32(0xffff)
let shfExecInstr = uint64(4)
let shfCompressed = uint64(0x800)

func readU16(data []byte, off int, big bool) uint16 {
	if big {
		return (uint16(data[off]) << 8) | uint16(data[off+1])
	}
	uint16(data[off]) | (uint16(data[off+1]) << 8)
}

func readU32(data []byte, off int, big bool) uint32 {
	if big {
		return (uint32(data[off]) << 24) | (uint32(data[off+1]) << 16) | (uint32(data[off+2]) << 8) | uint32(data[off+3])
	}
	uint32(data[off]) | (uint32(data[off+1]) << 8) | (uint32(data[off+2]) << 16) | (uint32(data[off+3]) << 24)
}

func readU64(data []byte, off int, big bool) uint64 {
	let lo = uint64(readU32(data, off, big))
	let hi = uint64(readU32(data, off+4, big))
	if big {
		return (lo << 32) | hi
	}
	lo | (hi << 32)
}

func checkRange(dataLen int, off uint64, size uint64) bool {
	let limit = uint64(dataLen)
	if off > limit || size > limit {
		return false
	}
	off <= limit-size
}

func readCString(tab []byte, start uint32) (string, bool) {
	let idx = int(start)
	if idx < 0 || idx >= tab.Len() {
		return ("", false)
	}
	let mut end = idx
	for end < tab.Len() && tab[end] != byte(0) {
		end = end + 1
	}
	(utf8.String(tab[idx:end]), true)
}

// MeasureELFBytes parses an unstripped ELF binary in memory and combines it with
// strippedSize (the stripped build size) into a Binary measurement.
func MeasureELFBytes(path string, elfData []byte, strippedSize uint64) Binary fails ELFError {
	if elfData.Len() < 16 {
		return ELFError{Path: path, Reason: "file too short for ELF header"}
	}
	if elfData[0] != byte(0x7f) || elfData[1] != byte('E') || elfData[2] != byte('L') || elfData[3] != byte('F') {
		return ELFError{Path: path, Reason: "bad magic number"}
	}
	let class = elfData[4]
	let encoding = elfData[5]
	if class != elfClass32 && class != elfClass64 {
		return ELFError{Path: path, Reason: "unsupported ELF class"}
	}
	if encoding != elfDataLSB && encoding != elfDataMSB {
		return ELFError{Path: path, Reason: "unsupported ELF data encoding"}
	}
	let big = encoding == elfDataMSB
	let is64 = class == elfClass64
	let hdrMin = if is64 { 64 } else { 52 }
	if elfData.Len() < hdrMin {
		return ELFError{Path: path, Reason: "truncated ELF header"}
	}
	let shoff = if is64 { readU64(elfData, 40, big) } else { uint64(readU32(elfData, 32, big)) }
	let shentsize = if is64 { int(readU16(elfData, 58, big)) } else { int(readU16(elfData, 46, big)) }
	let mut shnum = if is64 { int(readU16(elfData, 60, big)) } else { int(readU16(elfData, 48, big)) }
	let mut shstrndx = if is64 { int(readU16(elfData, 62, big)) } else { int(readU16(elfData, 50, big)) }
	let minEnt = if is64 { 64 } else { 40 }
	if shoff == uint64(0) || (shnum == 0 && shentsize == 0) {
		return ELFError{Path: path, Reason: "no ELF section header table"}
	}
	if shentsize < minEnt {
		return ELFError{Path: path, Reason: "invalid ELF section header size"}
	}
	if shnum == 0 {
		if !checkRange(elfData.Len(), shoff, uint64(shentsize)) {
			return ELFError{Path: path, Reason: "section 0 header out of bounds"}
		}
		let off0 = int(shoff)
		let sz0 = if is64 { readU64(elfData, off0+32, big) } else { uint64(readU32(elfData, off0+20, big)) }
		shnum = int(sz0)
	}
	if shstrndx == int(shnXIndex) && shnum > 0 {
		if !checkRange(elfData.Len(), shoff, uint64(shentsize)) {
			return ELFError{Path: path, Reason: "section 0 header out of bounds"}
		}
		let off0 = int(shoff)
		shstrndx = if is64 { int(readU32(elfData, off0+40, big)) } else { int(readU32(elfData, off0+24, big)) }
	}
	if shnum < 0 || !checkRange(elfData.Len(), shoff, uint64(shnum)*uint64(shentsize)) {
		return ELFError{Path: path, Reason: "section headers out of bounds"}
	}
	if shstrndx < 0 || shstrndx >= shnum {
		return ELFError{Path: path, Reason: "invalid shstrndx"}
	}
	let mut shNameOff = slices.WithCapacity[uint32](shnum)
	let mut shType = slices.WithCapacity[uint32](shnum)
	let mut shFlags = slices.WithCapacity[uint64](shnum)
	let mut shOffset = slices.WithCapacity[uint64](shnum)
	let mut shSize = slices.WithCapacity[uint64](shnum)
	let mut shLink = slices.WithCapacity[uint32](shnum)
	for i in 0..shnum {
		let off = int(shoff) + i*shentsize
		if is64 {
			shNameOff = shNameOff.Append(readU32(elfData, off, big))
			shType = shType.Append(readU32(elfData, off+4, big))
			shFlags = shFlags.Append(readU64(elfData, off+8, big))
			shOffset = shOffset.Append(readU64(elfData, off+24, big))
			shSize = shSize.Append(readU64(elfData, off+32, big))
			shLink = shLink.Append(readU32(elfData, off+40, big))
		} else {
			shNameOff = shNameOff.Append(readU32(elfData, off, big))
			shType = shType.Append(readU32(elfData, off+4, big))
			shFlags = shFlags.Append(uint64(readU32(elfData, off+8, big)))
			shOffset = shOffset.Append(uint64(readU32(elfData, off+16, big)))
			shSize = shSize.Append(uint64(readU32(elfData, off+20, big)))
			shLink = shLink.Append(readU32(elfData, off+24, big))
		}
	}
	let strOff = shOffset[shstrndx]
	let strSz = shSize[shstrndx]
	if !checkRange(elfData.Len(), strOff, strSz) {
		return ELFError{Path: path, Reason: "shstrtab out of bounds"}
	}
	let shstrtab = elfData[int(strOff):int(strOff+strSz)]
	let mut secNames = []string{}
	let mut secSizes = []uint64{}
	let mut secMap = Map[string, uint32]{}
	let mut symTabIdx = -1
	for i in 0..shnum {
		let (sname, _) = readCString(shstrtab, shNameOff[i])
		let mut effSize = shSize[i]
		if (shFlags[i]&shfCompressed) != uint64(0) && shType[i] != shtNoBits {
			if is64 && checkRange(elfData.Len(), shOffset[i], uint64(24)) {
				effSize = readU64(elfData, int(shOffset[i])+8, big)
			} else if !is64 && checkRange(elfData.Len(), shOffset[i], uint64(12)) {
				effSize = uint64(readU32(elfData, int(shOffset[i])+4, big))
			}
		}
		if sname != "" {
			match secMap.Get(sname) {
			case option.Some{Value: idx}:
				secSizes[int(idx)] = secSizes[int(idx)] + effSize
			case option.None:
				let idx = uint32(secNames.Len())
				secMap[sname] = idx
				secNames = secNames.Append(sname)
				secSizes = secSizes.Append(effSize)
			}
		}
		if shType[i] == shtSymTab && symTabIdx < 0 {
			symTabIdx = i
		}
	}
	if symTabIdx < 0 {
		return ELFError{Path: path, Reason: "no symbol section (a stripped file has no symbols to measure)"}
	}
	let symOff = shOffset[symTabIdx]
	let symSize = shSize[symTabIdx]
	let symStrIdx = int(shLink[symTabIdx])
	if symStrIdx < 0 || symStrIdx >= shnum {
		return ELFError{Path: path, Reason: "symbol string section out of range"}
	}
	if !checkRange(elfData.Len(), symOff, symSize) {
		return ELFError{Path: path, Reason: "symbol table out of bounds"}
	}
	let symStrOff = shOffset[symStrIdx]
	let symStrSize = shSize[symStrIdx]
	if !checkRange(elfData.Len(), symStrOff, symStrSize) {
		return ELFError{Path: path, Reason: "symbol string table out of bounds"}
	}
	let symBytes = elfData[int(symOff):int(symOff+symSize)]
	let symStrTab = elfData[int(symStrOff):int(symStrOff+symStrSize)]
	let mut shndxTab = []byte{}
	let mut hasShndxTab = false
	for i in 0..shnum {
		if shType[i] == shtSymTabShndx && int(shLink[i]) == symTabIdx {
			if checkRange(elfData.Len(), shOffset[i], shSize[i]) {
				shndxTab = elfData[int(shOffset[i]):int(shOffset[i]+shSize[i])]
				hasShndxTab = true
			}
			break
		}
	}
	let symEntSize = if is64 { 24 } else { 16 }
	let symCount = symBytes.Len() / symEntSize
	let mut textPkgs = []string{}
	let mut textBytes = []uint64{}
	let mut textMap = Map[string, uint32]{}
	let mut mainSymbols = 0
	let mut symbols = if symCount > 1 { slices.WithCapacity[string](symCount - 1) } else { []string{} }
	for si in 1..symCount {
		let off = si * symEntSize
		let stName = readU32(symBytes, off, big)
		let (name, ok) = readCString(symStrTab, stName)
		if !ok {
			return ELFError{Path: path, Reason: "invalid symbol name index"}
		}
		let rawShndx = if is64 { uint32(readU16(symBytes, off+6, big)) } else { uint32(readU16(symBytes, off+14, big)) }
		let mut secIdx = rawShndx
		if rawShndx == shnXIndex && hasShndxTab && si*4+4 <= shndxTab.Len() {
			secIdx = readU32(shndxTab, si*4, big)
		}
		let stSize = if is64 { readU64(symBytes, off+16, big) } else { uint64(readU32(symBytes, off+8, big)) }
		symbols = symbols.Append(name)
		if secIdx < uint32(1) || int(secIdx) >= shnum {
			continue
		}
		if (shFlags[int(secIdx)] & shfExecInstr) == uint64(0) {
			continue
		}
		let pkg = Package(name)
		match textMap.Get(pkg) {
		case option.Some{Value: idx}:
			textBytes[int(idx)] = textBytes[int(idx)] + stSize
		case option.None:
			let idx = uint32(textPkgs.Len())
			textMap[pkg] = idx
			textPkgs = textPkgs.Append(pkg)
			textBytes = textBytes.Append(stSize)
		}
		if pkg == "main" {
			mainSymbols = mainSymbols + 1
		}
	}
	Binary{
		Size:         uint64(elfData.Len()),
		Stripped:     strippedSize,
		SectionNames: secNames,
		SectionSizes: secSizes,
		TextPkgs:     textPkgs,
		TextBytes:    textBytes,
		MainSymbols:  mainSymbols,
		GoPackages:   0,
		Symbols:      symbols,
	}
}

// MeasureBinary reads defaultPath and strippedPath through files and measures
// their Binary metrics.
func MeasureBinary(files fs.Files, defaultPath string, strippedPath string) Binary fails ELFError {
	let defText = files.ReadFile(defaultPath) catch {
	case _:
		return ELFError{Path: defaultPath, Reason: "read default binary"}
	}
	let strippedStat = files.Stat(strippedPath) catch {
	case _:
		return ELFError{Path: strippedPath, Reason: "stat stripped binary"}
	}
	MeasureELFBytes(defaultPath, defText.Bytes(), uint64(strippedStat.Size))
}

func measureFails(path string, data []byte) bool {
	let _ = MeasureELFBytes(path, data, uint64(0)) catch {
	case ELFError:
		return true
	}
	false
}

// ELFReaderRejectsTruncatedAndStripped verifies that truncated inputs, bad magic bytes,
// and stripped ELF binaries without SHT_SYMTAB are rejected deterministically.
law ELFReaderRejectsTruncatedAndStripped(pad uint8) {
	let short = []byte{byte(0x7f), byte('E'), byte('L'), pad}
	let shortErr = measureFails("short", short)
	let badMagic = []byte{pad, byte('X'), byte('Y'), byte('Z'), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0)}
	let magicErr = measureFails("bad", badMagic)
	shortErr && (magicErr || pad == byte(0x7f))
}

func appendU16LE(out []byte, v uint16) []byte {
	out.Append(byte(v & uint16(0xff))).Append(byte((v >> 8) & uint16(0xff)))
}

func appendU32LE(out []byte, v uint32) []byte {
	let mut b = out
	b = b.Append(byte(v & uint32(0xff)))
	b = b.Append(byte((v >> 8) & uint32(0xff)))
	b = b.Append(byte((v >> 16) & uint32(0xff)))
	b.Append(byte((v >> 24) & uint32(0xff)))
}

func appendU64LE(out []byte, v uint64) []byte {
	let lo = uint32(v & uint64(0xffffffff))
	let hi = uint32((v >> 32) & uint64(0xffffffff))
	appendU32LE(appendU32LE(out, lo), hi)
}

func appendShdr64LE(out []byte, nameOff uint32, typ uint32, flags uint64, offset uint64, size uint64, link uint32) []byte {
	let mut b = appendU32LE(out, nameOff)
	b = appendU32LE(b, typ)
	b = appendU64LE(b, flags)
	b = appendU64LE(b, uint64(0))
	b = appendU64LE(b, offset)
	b = appendU64LE(b, size)
	b = appendU32LE(b, link)
	b = appendU32LE(b, uint32(0))
	b = appendU64LE(b, uint64(1))
	appendU64LE(b, uint64(0))
}

func appendSym64LE(out []byte, nameOff uint32, shndx uint16, size uint64) []byte {
	let mut b = appendU32LE(out, nameOff)
	b = b.Append(byte(2))
	b = b.Append(byte(0))
	b = appendU16LE(b, shndx)
	b = appendU64LE(b, uint64(0x1000))
	appendU64LE(b, size)
}

test SyntheticELF64MeasuresTextSectionsAndSymbols {
	let shstr = []byte{
		byte(0),
		byte('.'), byte('t'), byte('e'), byte('x'), byte('t'), byte(0),
		byte('.'), byte('r'), byte('o'), byte('d'), byte('a'), byte('t'), byte('a'), byte(0),
		byte('.'), byte('s'), byte('h'), byte('s'), byte('t'), byte('r'), byte('t'), byte('a'), byte('b'), byte(0),
		byte('.'), byte('s'), byte('y'), byte('m'), byte('t'), byte('a'), byte('b'), byte(0),
		byte('.'), byte('s'), byte('t'), byte('r'), byte('t'), byte('a'), byte('b'), byte(0),
	}
	let strtab = []byte{
		byte(0),
		byte('m'), byte('a'), byte('i'), byte('n'), byte('.'), byte('f'), byte('o'), byte('o'), byte(0),
		byte('r'), byte('u'), byte('n'), byte('t'), byte('i'), byte('m'), byte('e'), byte('.'), byte('g'), byte('o'), byte(0),
		byte('m'), byte('a'), byte('i'), byte('n'), byte('.'), byte('r'), byte('o'), byte('d'), byte('a'), byte('t'), byte('a'), byte(0),
	}
	let mut symtab = []byte{}
	symtab = appendSym64LE(symtab, uint32(0), uint16(0), uint64(0))
	symtab = appendSym64LE(symtab, uint32(1), uint16(1), uint64(120))
	symtab = appendSym64LE(symtab, uint32(10), uint16(1), uint64(80))
	symtab = appendSym64LE(symtab, uint32(21), uint16(2), uint64(44))

	let mut img = []byte{
		byte(0x7f), byte('E'), byte('L'), byte('F'),
		byte(2), byte(1), byte(1), byte(0),
		byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0), byte(0),
	}
	img = appendU16LE(img, uint16(2))
	img = appendU16LE(img, uint16(62))
	img = appendU32LE(img, uint32(1))
	img = appendU64LE(img, uint64(0))
	img = appendU64LE(img, uint64(0))
	let mut shoffPos = 0
	for img.Len() < 40 {
		img = img.Append(byte(0))
	}
	shoffPos = img.Len()
	let shdrOff = uint64(64 + shstr.Len() + strtab.Len() + symtab.Len())
	img = appendU64LE(img, shdrOff)
	img = appendU32LE(img, uint32(0))
	img = appendU16LE(img, uint16(64))
	img = appendU16LE(img, uint16(0))
	img = appendU16LE(img, uint16(0))
	img = appendU16LE(img, uint16(64))
	img = appendU16LE(img, uint16(6))
	img = appendU16LE(img, uint16(3))
	assert shoffPos == 40
	assert img.Len() == 64

	let shstrOff = uint64(img.Len())
	img = slices.AppendAll(img, shstr)
	let strOff = uint64(img.Len())
	img = slices.AppendAll(img, strtab)
	let symOff = uint64(img.Len())
	img = slices.AppendAll(img, symtab)
	assert uint64(img.Len()) == shdrOff

	img = appendShdr64LE(img, uint32(0), uint32(0), uint64(0), uint64(0), uint64(0), uint32(0))
	img = appendShdr64LE(img, uint32(1), uint32(1), shfExecInstr, uint64(0), uint64(512), uint32(0))
	img = appendShdr64LE(img, uint32(7), uint32(1), uint64(2), uint64(0), uint64(128), uint32(0))
	img = appendShdr64LE(img, uint32(15), uint32(3), uint64(0), shstrOff, uint64(shstr.Len()), uint32(0))
	img = appendShdr64LE(img, uint32(25), shtSymTab, uint64(0), symOff, uint64(symtab.Len()), uint32(5))
	img = appendShdr64LE(img, uint32(33), uint32(3), uint64(0), strOff, uint64(strtab.Len()), uint32(0))

	let mut tbl = NewBinaryTable()
	let b = MeasureELFBytes("synth", img, uint64(999)) catch {
	case ELFError as e:
		assert e.Reason == ""
		return
	}
	let row = AddBinary(&tbl, "synth", b)
	assert row == uint32(0)
	assert b.Size == uint64(img.Len())
	assert b.Stripped == uint64(999)
	assert b.MainSymbols == 1
	assert TextSize(b, "main") == uint64(120)
	assert TextSize(b, "runtime") == uint64(80)
	assert b.Symbols.Len() == 3
	match SectionSize(b, ".text") {
	case option.Some{Value: sz}:
		assert sz == uint64(512)
	case option.None:
		assert false
	}
}
