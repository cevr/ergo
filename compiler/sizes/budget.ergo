import json
import option
import slices
import strconv
import strings
import utf8

// BudgetError reports an invalid budget JSON payload, malformed receipt, or broken raise ledger.
type BudgetError {
	// Reason describes the budget or receipt validation failure.
	Reason string,
}

// Ceilings holds the three ceilings of a fixture or the amounts a raise adds to them.
type Ceilings {
	// ErgoOnlyBits stores the signed int64 ErgoOnly ceiling in two's-complement bit form.
	ErgoOnlyBits uint64,
	// ErgoOnlyStrippedBits stores the signed int64 ErgoOnlyStripped ceiling in two's-complement bit form.
	ErgoOnlyStrippedBits uint64,
	// GoPackages is the maximum number of linked Go packages permitted.
	GoPackages int,
}

// MakeCeilings constructs Ceilings from signed 64-bit byte counts and Go package count.
func MakeCeilings(ergoOnly int64, ergoOnlyStripped int64, goPackages int) Ceilings {
	Ceilings{
		ErgoOnlyBits:         uint64(ergoOnly),
		ErgoOnlyStrippedBits: uint64(ergoOnlyStripped),
		GoPackages:           goPackages,
	}
}

// CeilingErgoOnly returns c's signed ErgoOnly byte ceiling.
func CeilingErgoOnly(c Ceilings) int64 { int64(c.ErgoOnlyBits) }

// CeilingErgoOnlyStripped returns c's signed ErgoOnlyStripped byte ceiling.
func CeilingErgoOnlyStripped(c Ceilings) int64 { int64(c.ErgoOnlyStrippedBits) }

// Owner records the share of a ceiling raise owned by one guarantee or feature.
type Owner {
	// Owner names the guarantee or feature owning the raise share.
	Owner string,
	// BytesBits stores the signed int64 byte delta in two's-complement bit form.
	BytesBits uint64,
	// Symbols lists the largest symbols attributed to this owner.
	Symbols []string,
}

// MakeOwner constructs an Owner from owner name, signed 64-bit byte delta, and symbols.
func MakeOwner(owner string, bytes int64, symbols []string) Owner {
	Owner{
		Owner:     owner,
		BytesBits: uint64(bytes),
		Symbols:   symbols,
	}
}

// OwnerBytes returns o's signed byte contribution.
func OwnerBytes(o Owner) int64 { int64(o.BytesBits) }

// Raise records one justified increase of a fixture's size or package ceilings.
type Raise {
	// Unit names the work unit responsible for the raise.
	Unit string,
	// Ceilings holds the byte and package deltas added by this raise.
	Ceilings Ceilings,
	// From identifies the baseline commit or measurement.
	From string,
	// To identifies the post-change commit or measurement.
	To string,
	// Owners attributes the symbol byte changes to named guarantees.
	Owners []Owner,
	// Packages lists the newly added Go packages when GoPackages > 0.
	Packages []string,
}

// Fixture defines the size ceilings, forbidden symbol regexes, allowed packages, and raise ledger of one fixture.
type Fixture {
	// Ceilings holds the active ceilings for the fixture.
	Ceilings Ceilings,
	// Forbid lists regular expressions that no linked symbol may match.
	Forbid []string,
	// Packages, when non-empty, restricts linked Go packages to this allowlist.
	Packages []string,
	// Base holds the initial ceilings before recorded raises.
	Base Ceilings,
	// Raises records each justified raise above Base.
	Raises []Raise,
}

// Budget stores a checked-in binary size budget with fixture names and definitions in SoA arrays.
type Budget {
	// Reason explains the purpose of the budget file.
	Reason string,
	// Names lists fixture names aligned with Fixtures.
	Names []string,
	// Fixtures lists fixture definitions aligned with Names.
	Fixtures []Fixture,
}

// Receipt pairs a fixture's measured Binary with the Go hello Control Binary.
type Receipt {
	// Fixture names the measured fixture.
	Fixture string,
	// Main holds the fixture's measured Binary.
	Main Binary,
	// Control holds the Go hello control Binary.
	Control Binary,
}

// ErgoOnly returns r.Main.Size minus r.Control.Size as a signed 64-bit integer.
func ErgoOnly(r Receipt) int64 { int64(r.Main.Size) - int64(r.Control.Size) }

// ErgoOnlyStripped returns r.Main.Stripped minus r.Control.Stripped as a signed 64-bit integer.
func ErgoOnlyStripped(r Receipt) int64 { int64(r.Main.Stripped) - int64(r.Control.Stripped) }

func uintText(v uint64) string {
	utf8.String(strconv.AppendUint([]byte{}, v, 10))
}

func int64Text(v int64) string {
	strconv.FormatInt(v, 10)
}

func parseUint64Text(s string) uint64 fails BudgetError {
	if s.Len() == 0 {
		return BudgetError{Reason: "empty integer"}
	}
	let maxU64 uint64 = 0xffffffffffffffff
	let mut acc = uint64(0)
	for i in 0..s.Len() {
		let ch = s[i]
		if ch < '0' || ch > '9' {
			return BudgetError{Reason: "invalid uint64 \(s)"}
		}
		let d = uint64(ch - '0')
		if acc > (maxU64-d)/uint64(10) {
			return BudgetError{Reason: "uint64 overflow \(s)"}
		}
		acc = acc*uint64(10) + d
	}
	acc
}

func valueNumText(v json.Value) string fails BudgetError {
	let c = json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}
	match v {
	case json.Num:
		return json.Encode(c, v)
	case _:
		return BudgetError{Reason: "expected JSON number"}
	}
}

func decodeValueInt64(v json.Value) int64 fails BudgetError {
	let s = try valueNumText(v)
	let n = strconv.ParseInt(s, 10, 64) catch {
	case _:
		return BudgetError{Reason: "bad int64 \(s)"}
	}
	n
}

func decodeValueUint64(v json.Value) uint64 fails BudgetError {
	let s = try valueNumText(v)
	parseUint64Text(s)
}

func decodeValueInt(v json.Value) int fails BudgetError {
	let n = try decodeValueInt64(v)
	int(n)
}

func decodeValueString(v json.Value) string fails BudgetError {
	match v {
	case json.Str as s:
		s.Value
	case _:
		return BudgetError{Reason: "expected JSON string"}
	}
}

func decodeValueStringSlice(v json.Value) []string fails BudgetError {
	match v {
	case json.Null:
		[]string{}
	case json.Array as arr:
		let mut out = slices.WithCapacity[string](arr.Items.Len())
		for item in arr.Items {
			out = out.Append(try decodeValueString(item))
		}
		out
	case _:
		return BudgetError{Reason: "expected JSON string array"}
	}
}

func decodeValueObject(v json.Value) []json.Member fails BudgetError {
	match v {
	case json.Object as obj:
		obj.Members
	case _:
		return BudgetError{Reason: "expected JSON object"}
	}
}

func decodeCeilingsMembers(members []json.Member) Ceilings fails BudgetError {
	let mut ergoOnly = int64(0)
	let mut ergoStripped = int64(0)
	let mut goPkgs = 0
	for m in members {
		if m.Key == "ergoOnly" {
			ergoOnly = try decodeValueInt64(m.Value)
		} else if m.Key == "ergoOnlyStripped" {
			ergoStripped = try decodeValueInt64(m.Value)
		} else if m.Key == "goPackages" {
			goPkgs = try decodeValueInt(m.Value)
		}
	}
	MakeCeilings(ergoOnly, ergoStripped, goPkgs)
}

func decodeOwnerValue(v json.Value) Owner fails BudgetError {
	let members = try decodeValueObject(v)
	let mut owner = ""
	let mut bytes = int64(0)
	let mut symbols = []string{}
	for m in members {
		if m.Key == "owner" {
			owner = try decodeValueString(m.Value)
		} else if m.Key == "bytes" {
			bytes = try decodeValueInt64(m.Value)
		} else if m.Key == "symbols" {
			symbols = try decodeValueStringSlice(m.Value)
		}
	}
	MakeOwner(owner, bytes, symbols)
}

func decodeRaiseValue(v json.Value) Raise fails BudgetError {
	let members = try decodeValueObject(v)
	let ceil = try decodeCeilingsMembers(members)
	let mut unit = ""
	let mut from = ""
	let mut to = ""
	let mut owners = []Owner{}
	let mut packages = []string{}
	for m in members {
		if m.Key == "unit" {
			unit = try decodeValueString(m.Value)
		} else if m.Key == "from" {
			from = try decodeValueString(m.Value)
		} else if m.Key == "to" {
			to = try decodeValueString(m.Value)
		} else if m.Key == "owners" {
			match m.Value {
			case json.Null:
				owners = []Owner{}
			case json.Array as arr:
				for item in arr.Items {
					owners = owners.Append(try decodeOwnerValue(item))
				}
			case _:
				return BudgetError{Reason: "expected owners array"}
			}
		} else if m.Key == "packages" {
			packages = try decodeValueStringSlice(m.Value)
		}
	}
	Raise{
		Unit:     unit,
		Ceilings: ceil,
		From:     from,
		To:       to,
		Owners:   owners,
		Packages: packages,
	}
}

func decodeFixtureValue(v json.Value) Fixture fails BudgetError {
	let members = try decodeValueObject(v)
	let ceil = try decodeCeilingsMembers(members)
	let mut forbid = []string{}
	let mut packages = []string{}
	let mut base = MakeCeilings(int64(0), int64(0), 0)
	let mut raises = []Raise{}
	for m in members {
		if m.Key == "forbid" {
			forbid = try decodeValueStringSlice(m.Value)
		} else if m.Key == "packages" {
			packages = try decodeValueStringSlice(m.Value)
		} else if m.Key == "base" {
			let bm = try decodeValueObject(m.Value)
			base = try decodeCeilingsMembers(bm)
		} else if m.Key == "raises" {
			match m.Value {
			case json.Null:
				raises = []Raise{}
			case json.Array as arr:
				for item in arr.Items {
					raises = raises.Append(try decodeRaiseValue(item))
				}
			case _:
				return BudgetError{Reason: "expected raises array"}
			}
		}
	}
	Fixture{
		Ceilings: ceil,
		Forbid:   forbid,
		Packages: packages,
		Base:     base,
		Raises:   raises,
	}
}

func decodeJSONValue(text string) json.Value fails BudgetError {
	let c = json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}
	json.Decode(c, text) catch {
	case json.Malformed as m:
		return BudgetError{Reason: "json malformed at \(m.Offset): \(m.Reason)"}
	case WireWrongKind as e:
		return BudgetError{Reason: "json wrong kind at \(e.Path): want \(e.Want)"}
	case WireMissingField as e:
		return BudgetError{Reason: "json missing field at \(e.Path).\(e.Field)"}
	case WireUnknownTag as e:
		return BudgetError{Reason: "json unknown tag at \(e.Path): \(e.Tag)"}
	}
}

// ParseBudgetJSON parses a budgets.json document into a Budget without running ledger checks.
func ParseBudgetJSON(text string) Budget fails BudgetError {
	let rootVal = try decodeJSONValue(text)
	let members = try decodeValueObject(rootVal)
	let mut reason = ""
	let mut names = []string{}
	let mut fixtures = []Fixture{}
	for m in members {
		if m.Key == "reason" {
			reason = try decodeValueString(m.Value)
		} else if m.Key == "fixtures" {
			match m.Value {
			case json.Null:
				names = []string{}
				fixtures = []Fixture{}
			case json.Object as fobj:
				let mut fmap = Map[string, uint32]{}
				for fm in fobj.Members {
					let f = try decodeFixtureValue(fm.Value)
					match fmap.Get(fm.Key) {
					case option.Some{Value: idx}:
						fixtures[int(idx)] = f
					case option.None:
						let idx = uint32(names.Len())
						fmap[fm.Key] = idx
						names = names.Append(fm.Key)
						fixtures = fixtures.Append(f)
					}
				}
			case _:
				return BudgetError{Reason: "expected fixtures object"}
			}
		}
	}
	Budget{Reason: reason, Names: names, Fixtures: fixtures}
}

// ValidateFixtureLedger reports the first way f's ceilings are not accounted
// for by its base and raises. Returns "" when valid.
func ValidateFixtureLedger(f Fixture) string {
	let mut topErgo = CeilingErgoOnly(f.Base)
	let mut topStripped = CeilingErgoOnlyStripped(f.Base)
	let mut topPkgs = f.Base.GoPackages
	for i in 0..f.Raises.Len() {
		let r = f.Raises[i]
		if r.Unit == "" || r.From == "" || r.To == "" || r.Owners.Len() == 0 {
			return "raise \(i + 1) names no unit, builds or owners"
		}
		if r.Packages.Len() < r.Ceilings.GoPackages {
			return "raise \(i + 1) (\(r.Unit)) adds \(r.Ceilings.GoPackages) Go packages but names \(r.Packages.Len())"
		}
		for o in r.Owners {
			if o.Owner == "" || OwnerBytes(o) == int64(0) || o.Symbols.Len() == 0 {
				return "raise \(i + 1) (\(r.Unit)): an owner names no bytes or symbols"
			}
		}
		topErgo = topErgo + CeilingErgoOnly(r.Ceilings)
		topStripped = topStripped + CeilingErgoOnlyStripped(r.Ceilings)
		topPkgs = topPkgs + r.Ceilings.GoPackages
	}
	let cErgo = CeilingErgoOnly(f.Ceilings)
	let cStripped = CeilingErgoOnlyStripped(f.Ceilings)
	if cErgo > topErgo {
		return "ceiling ergoOnly \(int64Text(cErgo)) is above base and raises, \(int64Text(topErgo)): a raise must name its bytes"
	}
	if cStripped > topStripped {
		return "ceiling ergoOnlyStripped \(int64Text(cStripped)) is above base and raises, \(int64Text(topStripped)): a raise must name its bytes"
	}
	if f.Ceilings.GoPackages > topPkgs {
		return "ceiling goPackages \(f.Ceilings.GoPackages) is above base and raises, \(topPkgs): a raise must name its packages"
	}
	""
}

// ValidateBudget checks every fixture ledger in deterministic name order.
func ValidateBudget(b Budget) fails BudgetError {
	let sortedNames = slices.Sort(slices.Clone(b.Names))
	let mut idxMap = Map[string, uint32]{}
	for i in 0..b.Names.Len() {
		idxMap[b.Names[i]] = uint32(i)
	}
	for name in sortedNames {
		match idxMap.Get(name) {
		case option.Some{Value: idx}:
			let msg = ValidateFixtureLedger(b.Fixtures[int(idx)])
			if msg != "" {
				return BudgetError{Reason: "budgets.json: \(name): \(msg)"}
			}
		case option.None:
			return BudgetError{Reason: "internal budget index missing \(name)"}
		}
	}
}

// ParseCheckedBudgetJSON parses a budgets.json document and validates all fixture ledgers.
func ParseCheckedBudgetJSON(text string) Budget fails BudgetError {
	let b = try ParseBudgetJSON(text)
	try ValidateBudget(b)
	b
}

func decodeUintMapMembers(v json.Value) ([]string, []uint64) fails BudgetError {
	match v {
	case json.Null:
		return ([]string{}, []uint64{})
	case json.Object as obj:
		let mut keys = []string{}
		let mut vals = []uint64{}
		let mut kmap = Map[string, uint32]{}
		for m in obj.Members {
			let n = try decodeValueUint64(m.Value)
			match kmap.Get(m.Key) {
			case option.Some{Value: idx}:
				vals[int(idx)] = n
			case option.None:
				let idx = uint32(keys.Len())
				kmap[m.Key] = idx
				keys = keys.Append(m.Key)
				vals = vals.Append(n)
			}
		}
		return (keys, vals)
	case _:
		return BudgetError{Reason: "expected uint64 map object"}
	}
}

func decodeBinaryMembers(members []json.Member) Binary fails BudgetError {
	let mut size = uint64(0)
	let mut stripped = uint64(0)
	let mut secNames = []string{}
	let mut secSizes = []uint64{}
	let mut textPkgs = []string{}
	let mut textBytes = []uint64{}
	let mut mainSymbols = 0
	let mut goPackages = 0
	let mut symbols = []string{}
	for m in members {
		if m.Key == "size" {
			size = try decodeValueUint64(m.Value)
		} else if m.Key == "stripped" {
			stripped = try decodeValueUint64(m.Value)
		} else if m.Key == "sections" {
			let (ks, vs) = try decodeUintMapMembers(m.Value)
			secNames = ks
			secSizes = vs
		} else if m.Key == "text" {
			let (ks, vs) = try decodeUintMapMembers(m.Value)
			textPkgs = ks
			textBytes = vs
		} else if m.Key == "mainSymbols" {
			mainSymbols = try decodeValueInt(m.Value)
		} else if m.Key == "goPackages" {
			goPackages = try decodeValueInt(m.Value)
		} else if m.Key == "symbols" {
			symbols = try decodeValueStringSlice(m.Value)
		}
	}
	Binary{
		Size:         size,
		Stripped:     stripped,
		SectionNames: secNames,
		SectionSizes: secSizes,
		TextPkgs:     textPkgs,
		TextBytes:    textBytes,
		MainSymbols:  mainSymbols,
		GoPackages:   goPackages,
		Symbols:      symbols,
	}
}

// DecodeReceiptJSON parses a single JSON receipt object (with optional test-only symbols field).
func DecodeReceiptJSON(text string) Receipt fails BudgetError {
	let rootVal = try decodeJSONValue(text)
	let members = try decodeValueObject(rootVal)
	let mainBin = try decodeBinaryMembers(members)
	let mut fixture = ""
	let mut control = Binary{
		Size:         uint64(0),
		Stripped:     uint64(0),
		SectionNames: []string{},
		SectionSizes: []uint64{},
		TextPkgs:     []string{},
		TextBytes:    []uint64{},
		MainSymbols:  0,
		GoPackages:   0,
		Symbols:      []string{},
	}
	for m in members {
		if m.Key == "fixture" {
			fixture = try decodeValueString(m.Value)
		} else if m.Key == "control" {
			let cm = try decodeValueObject(m.Value)
			control = try decodeBinaryMembers(cm)
		}
	}
	Receipt{Fixture: fixture, Main: mainBin, Control: control}
}

func jsonUIntNum(v uint64) json.Value fails BudgetError {
	let c = json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}
	json.Decode(c, uintText(v)) catch {
	case _:
		return BudgetError{Reason: "internal uint encode"}
	}
}

func jsonSIntNum(v int64) json.Value fails BudgetError {
	let c = json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}
	json.Decode(c, int64Text(v)) catch {
	case _:
		return BudgetError{Reason: "internal int64 encode"}
	}
}

func sortedUintObject(keys []string, vals []uint64) json.Value fails BudgetError {
	let mut keyMap = Map[string, uint32]{}
	for i in 0..keys.Len() {
		keyMap[keys[i]] = uint32(i)
	}
	let sortedKeys = slices.Sort(slices.Clone(keys))
	let mut members = slices.WithCapacity[json.Member](sortedKeys.Len())
	for k in sortedKeys {
		match keyMap.Get(k) {
		case option.Some{Value: idx}:
			members = members.Append(json.Member{Key: k, Value: try jsonUIntNum(vals[int(idx)])})
		case option.None:
		}
	}
	json.Object{Members: members}
}

func binaryMembers(b Binary) []json.Member fails BudgetError {
	[]json.Member{
		json.Member{Key: "size", Value: try jsonUIntNum(b.Size)},
		json.Member{Key: "stripped", Value: try jsonUIntNum(b.Stripped)},
		json.Member{Key: "sections", Value: try sortedUintObject(b.SectionNames, b.SectionSizes)},
		json.Member{Key: "text", Value: try sortedUintObject(b.TextPkgs, b.TextBytes)},
		json.Member{Key: "mainSymbols", Value: json.IntNumber(int64(b.MainSymbols))},
		json.Member{Key: "goPackages", Value: json.IntNumber(int64(b.GoPackages))},
	}
}

// MarshalReceiptJSON encodes r to JSON matching internal/sizes.Receipt.MarshalJSON.
func MarshalReceiptJSON(r Receipt) string fails BudgetError {
	let mut members = []json.Member{
		json.Member{Key: "fixture", Value: json.Str{Value: r.Fixture}},
	}
	members = slices.AppendAll(members, try binaryMembers(r.Main))
	members = members.Append(json.Member{Key: "control", Value: json.Object{Members: try binaryMembers(r.Control)}})
	members = members.Append(json.Member{Key: "ergoOnly", Value: try jsonSIntNum(ErgoOnly(r))})
	members = members.Append(json.Member{Key: "ergoOnlyStripped", Value: try jsonSIntNum(ErgoOnlyStripped(r))})
	let c = json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}
	json.Encode(c, json.Object{Members: members})
}

// Differences formats the n packages whose executable text grew most over Control.
func Differences(r Receipt, n int) string {
	let mut ctrlMap = Map[string, uint32]{}
	for i in 0..r.Control.TextPkgs.Len() {
		ctrlMap[r.Control.TextPkgs[i]] = uint32(i)
	}
	let mut diffPkgs = []string{}
	let mut diffBytesBits = []uint64{}
	for i in 0..r.Main.TextPkgs.Len() {
		let pkg = r.Main.TextPkgs[i]
		let size = r.Main.TextBytes[i]
		let ctrlSize = match ctrlMap.Get(pkg) {
		case option.Some{Value: ci}:
			r.Control.TextBytes[int(ci)]
		case option.None:
			uint64(0)
		}
		if size > ctrlSize {
			let d = int64(size) - int64(ctrlSize)
			diffPkgs = diffPkgs.Append(pkg)
			diffBytesBits = diffBytesBits.Append(uint64(d))
		}
	}
	let mut order = slices.WithCapacity[int](diffPkgs.Len())
	for i in 0..diffPkgs.Len() {
		order = order.Append(i)
	}
	order = slices.SortFunc(order, func(a int, b int) int {
		let da = int64(diffBytesBits[a])
		let db = int64(diffBytesBits[b])
		if da != db {
			return if db < da { -1 } else { 1 }
		}
		if diffPkgs[a] < diffPkgs[b] {
			return -1
		}
		if diffPkgs[a] > diffPkgs[b] {
			return 1
		}
		0
	})
	let limit = if n < order.Len() { n } else { order.Len() }
	let mut parts = slices.WithCapacity[string](limit)
	for i in 0..limit {
		let idx = order[i]
		parts = parts.Append("\(diffPkgs[idx]) +\(int64Text(int64(diffBytesBits[idx])))")
	}
	strings.Join(parts, ", ")
}

// CheckBudget checks receipts against b and returns every violation in deterministic order.
func CheckBudget(b Budget, receipts []Receipt) []string {
	let mut problems = []string{}
	let mut seen = Map[string, bool]{}
	let mut fixIdx = Map[string, uint32]{}
	for i in 0..b.Names.Len() {
		fixIdx[b.Names[i]] = uint32(i)
	}
	for r in receipts {
		seen[r.Fixture] = true
		let fiOpt = fixIdx.Get(r.Fixture)
		let f = match fiOpt {
		case option.Some{Value: fi}:
			b.Fixtures[int(fi)]
		case option.None:
			problems = problems.Append("\(r.Fixture): no budget in budgets.json")
			continue
		}
		let eo = ErgoOnly(r)
		let fEo = CeilingErgoOnly(f.Ceilings)
		if eo > fEo {
			problems = problems.Append("\(r.Fixture): Ergo-only bytes \(int64Text(eo)) (file \(uintText(r.Main.Size)), Go hello \(uintText(r.Control.Size))) over the ceiling \(int64Text(fEo)); largest package text differences: \(Differences(r, 5))")
		}
		let eos = ErgoOnlyStripped(r)
		let fEos = CeilingErgoOnlyStripped(f.Ceilings)
		if eos > fEos {
			problems = problems.Append("\(r.Fixture): stripped Ergo-only bytes \(int64Text(eos)) (file \(uintText(r.Main.Stripped)), Go hello \(uintText(r.Control.Stripped))) over the ceiling \(int64Text(fEos)); largest package text differences: \(Differences(r, 5))")
		}
		if r.Main.GoPackages > f.Ceilings.GoPackages {
			problems = problems.Append("\(r.Fixture): \(r.Main.GoPackages) Go packages linked, over the ceiling \(f.Ceilings.GoPackages)")
		}
		if f.Packages.Len() > 0 {
			let mut textMap = Map[string, uint32]{}
			for i in 0..r.Main.TextPkgs.Len() {
				textMap[r.Main.TextPkgs[i]] = uint32(i)
			}
			let sortedPkgs = slices.Sort(slices.Clone(r.Main.TextPkgs))
			for pkg in sortedPkgs {
				if LinkedPackage(pkg) && !slices.Contains(f.Packages, pkg) {
					match textMap.Get(pkg) {
					case option.Some{Value: ti}:
						problems = problems.Append("\(r.Fixture): links package \(pkg) (\(uintText(r.Main.TextBytes[int(ti)])) text bytes), which its budget's packages do not name")
					case option.None:
					}
				}
			}
		}
		for pattern in f.Forbid {
			let re = CompileRegex(pattern) catch {
			case BadRegex as err:
				problems = problems.Append("\(r.Fixture): fact \(strconv.Quote(pattern)): \(err.Reason)")
				continue
			}
			let mut matched = []string{}
			for s in r.Main.Symbols {
				if MatchString(re, s) {
					matched = matched.Append(s)
				}
			}
			if matched.Len() > 0 {
				problems = problems.Append("\(r.Fixture): fact \(strconv.Quote(pattern)): \(matched.Len()) linked symbols match, first \(matched[0])")
			}
		}
	}
	let sortedFixtures = slices.Sort(slices.Clone(b.Names))
	for name in sortedFixtures {
		let wasSeen = match seen.Get(name) {
		case option.Some{Value: v}:
			v
		case option.None:
			false
		}
		if !wasSeen {
			problems = problems.Append("\(name): budgeted in budgets.json, but no receipt")
		}
	}
	problems
}

func makeTestBinary(sz uint64, stripped uint64, goPkgs int, syms []string, textPkgs []string, textBytes []uint64) Binary {
	Binary{
		Size:         sz,
		Stripped:     stripped,
		SectionNames: []string{},
		SectionSizes: []uint64{},
		TextPkgs:     textPkgs,
		TextBytes:    textBytes,
		MainSymbols:  0,
		GoPackages:   goPkgs,
		Symbols:      syms,
	}
}

// ReceiptSubtractionPreservesSignedDelta checks that ErgoOnly and ErgoOnlyStripped
// preserve signed subtraction when fixture sizes vary around control sizes.
law ReceiptSubtractionPreservesSignedDelta(delta int, sdelta int) {
	let base = uint64(2000000)
	let ctrl = makeTestBinary(base, uint64(1000000), 1, []string{}, []string{}, []uint64{})
	let d = if delta < -1000000 { -1000000 } else if delta > 1000000 { 1000000 } else { delta }
	let sd = if sdelta < -500000 { -500000 } else if sdelta > 500000 { 500000 } else { sdelta }
	let mainB = makeTestBinary(uint64(int64(base)+int64(d)), uint64(int64(1000000)+int64(sd)), 1, []string{}, []string{}, []uint64{})
	let r = Receipt{Fixture: "p", Main: mainB, Control: ctrl}
	ErgoOnly(r) == int64(d) && ErgoOnlyStripped(r) == int64(sd)
}

test CheckBudgetDetectsCeilingsForbidPackagesAndMissing {
	let raw = "{\"reason\":\"test\",\"fixtures\":{\"hello\":{\"ergoOnly\":1000,\"ergoOnlyStripped\":500,\"goPackages\":5,\"forbid\":[\"^fmt\\\\.\"],\"packages\":[\"main\",\"runtime\"],\"base\":{\"ergoOnly\":1000,\"ergoOnlyStripped\":500,\"goPackages\":5}},\"other\":{\"ergoOnly\":100,\"ergoOnlyStripped\":100,\"goPackages\":3,\"forbid\":[],\"base\":{\"ergoOnly\":100,\"ergoOnlyStripped\":100,\"goPackages\":3}}}}"
	let b = ParseCheckedBudgetJSON(raw) catch {
	case BudgetError as e:
		assert e.Reason == ""
		return
	}
	let ctrl = makeTestBinary(uint64(100), uint64(50), 2, []string{}, []string{"runtime"}, []uint64{uint64(20)})
	let mainOk = makeTestBinary(uint64(1100), uint64(550), 5, []string{"main.a"}, []string{"main", "runtime", "(asm)", "type:.eq"}, []uint64{uint64(10), uint64(20), uint64(5), uint64(5)})
	let rOk = Receipt{Fixture: "hello", Main: mainOk, Control: ctrl}
	let rOther = Receipt{Fixture: "other", Main: ctrl, Control: ctrl}
	assert CheckBudget(b, []Receipt{rOk, rOther}).Len() == 0

	let mainBad = makeTestBinary(uint64(1200), uint64(700), 7, []string{"fmt.Println"}, []string{"fmt", "runtime"}, []uint64{uint64(900), uint64(50)})
	let probs = CheckBudget(b, []Receipt{Receipt{Fixture: "hello", Main: mainBad, Control: ctrl}})
	assert probs.Len() == 6
	assert strings.Contains(probs[0], "hello: Ergo-only bytes 1100")
	assert strings.Contains(probs[0], "fmt +900")
	assert strings.Contains(probs[1], "hello: stripped Ergo-only bytes 650")
	assert strings.Contains(probs[2], "hello: 7 Go packages linked")
	assert strings.Contains(probs[3], "hello: links package fmt")
	assert strings.Contains(probs[4], "fact \"^fmt\\\\.\": 1 linked symbols match, first fmt.Println")
	assert probs[5] == "other: budgeted in budgets.json, but no receipt"
}

test LedgerValidationSupportsNegativeOwnerBytes {
	let raw = "{\"reason\":\"neg\",\"fixtures\":{\"hello\":{\"ergoOnly\":900,\"ergoOnlyStripped\":450,\"goPackages\":4,\"forbid\":[],\"base\":{\"ergoOnly\":1000,\"ergoOnlyStripped\":500,\"goPackages\":4},\"raises\":[{\"unit\":\"U1\",\"ergoOnly\":-100,\"ergoOnlyStripped\":-50,\"goPackages\":0,\"from\":\"aaa\",\"to\":\"bbb\",\"owners\":[{\"owner\":\"shrink\",\"bytes\":-2059,\"symbols\":[\"fmt.Println -2059\"]}]}]}}}"
	let b = ParseCheckedBudgetJSON(raw) catch {
	case BudgetError as e:
		assert e.Reason == ""
		return
	}
	assert b.Names == []string{"hello"}

	let bad = "{\"reason\":\"bad\",\"fixtures\":{\"hello\":{\"ergoOnly\":1001,\"ergoOnlyStripped\":450,\"goPackages\":4,\"forbid\":[],\"base\":{\"ergoOnly\":1000,\"ergoOnlyStripped\":500,\"goPackages\":4}}}}"
	let _ = ParseCheckedBudgetJSON(bad) catch {
	case BudgetError:
		return
	}
	assert false
}

test ReceiptJSONRoundTrips {
	let ctrl = makeTestBinary(uint64(1000), uint64(500), 2, []string{}, []string{"runtime"}, []uint64{uint64(10)})
	let mainB = makeTestBinary(uint64(1400), uint64(620), 4, []string{}, []string{"main"}, []uint64{uint64(42)})
	let encoded = MarshalReceiptJSON(Receipt{Fixture: "hello", Main: mainB, Control: ctrl}) catch {
	case BudgetError as e:
		assert e.Reason == ""
		return
	}
	assert strings.Contains(encoded, "\"ergoOnly\":400")
	assert strings.Contains(encoded, "\"ergoOnlyStripped\":120")
	let decoded = DecodeReceiptJSON(encoded) catch {
	case BudgetError as e:
		assert e.Reason == ""
		return
	}
	assert decoded.Fixture == "hello"
	assert ErgoOnly(decoded) == int64(400)
	assert ErgoOnlyStripped(decoded) == int64(120)
}
