// exprdump types one package's expressions with compiler/check/expr and
// prints one line per typed expression, or with -calls one per inferred
// generic call, unsorted:
//
//	exprdump [-std DIR] EXT FOREIGN FILE... [-- EXT FOREIGN FILE...]...          "FILE START END TYPE"
//	exprdump [-std DIR] -calls EXT FOREIGN FILE... [-- EXT FOREIGN FILE...]...   "FILE OFFSET T1 ; T2 …"
//	exprdump [-std DIR] -corpus MANIFEST
//
// -std DIR loads the Ergo packages the run's packages import and do not
// hold, transitively, as typedump does (compiler/check/load); only their
// interfaces are computed, against the tables of the package that
// imports them.
//
// Each group after a "--" is an imported package (its path is its
// FOREIGN's @pkg line): it is bound and loaded on its own, and the package
// binds against its frozen store and types the import's functions and
// record fields from its signatures (S3d2); its types are XRefs into the
// import's interface (types.Iface), computed in import order (S3d12).
//
// START and END are the expression's byte offsets (END the byte after
// it); OFFSET is the callee name's. Types print as the Go checker's
// Type.String (compiler/check/types Text), no value as "no value". EXT and
// FOREIGN are typedump's: the Go side writes them, for the prelude's, the
// universe's and the Go imports' types.
//
// With -corpus, each package's "O FILE OFFSET LENGTH CODE MESSAGE" lines
// are compiler/check/diag's own-mark diagnostics (MODES-OWN-CHECK).
//
// "L FILE START END TYPE" lines give each package let's name its type
// (CHECK-VALUE-TYPES), in both forms.
//
// It is the Ergo side of S3d's expression agreement
// (internal/selfhostcheck's TestCompilerExprAgreesWithChecker) and of the
// own-mark agreement (TestCompilerOwnMarksAgreeWithChecker).

import compiler/check/bind
import compiler/check/diag
import compiler/check/expr
import compiler/check/infer
import compiler/check/load
import compiler/check/store
import compiler/check/task
import compiler/check/types
import compiler/syntax
import dense
import fs
import io
import os
import strconv
import strings

func base(path string) string {
	let i = strings.LastIndex(path, "/")
	if i < 0 { path } else { path[i+1 : len(path)] }
}

func bit(w string) int {
	if w == "type" { 1 } else if w == "errors" { 2 } else if w == "uses" { 4 } else { 8 }
}

func read(path string) string fails os.Exit needs fs.Files {
	fs.Files.ReadFile(path) catch {
	case fs.NotFound:
		return os.Exit{Code: 1, Message: "exprdump: no file \(path)"}
	case fs.Denied:
		return os.Exit{Code: 1, Message: "exprdump: cannot read \(path)"}
	case fs.Failed as e:
		return os.Exit{Code: 1, Message: "exprdump: cannot read \(path): \(e.Reason)"}
	}
}

// Tables is what EXT and FOREIGN hold (typedump reads them alike).
type Tables { ext []types.Ext, foreign []types.Foreign, pkgName string, pkgPath string }

func tables(extText string, foreignText string) Tables {
	let mut ext = []types.Ext{}
	for line in strings.Split(extText, "\n") {
		let parts = strings.Fields(line)
		if len(parts) != 2 {
			continue
		}
		let mut ks = []int{}
		for w in strings.Split(parts[1], ",") {
			ks = ks.Append(bit(w))
		}
		ext = ext.Append(types.Ext{Head: parts[0], Kinds: ks})
	}
	let mut foreign = []types.Foreign{}
	let mut pkgName = "main"
	let mut pkgPath = "main"
	for line in strings.Split(foreignText, "\n") {
		let parts = strings.Fields(line)
		if len(parts) == 4 && parts[0] == "@pkg" {
			pkgName = if parts[3] == "1" { parts[1] } else { "" }
			pkgPath = parts[2]
			continue
		}
		if len(parts) != 6 {
			continue
		}
		let n = strconv.Atoi(parts[2]) catch {
		case _:
			0
		}
		foreign = foreign.Append(types.Foreign{Qual: parts[0], Name: parts[1], Arity: n, Path: parts[3], Print: strings.ReplaceAll(parts[4], "^", " "), Key: parts[5], Variants: []int{}})
	}
	Tables{ext: ext, foreign: types.WithUnions(foreign, foreignText), pkgName: pkgName, pkgPath: pkgPath}
}

func parseAll(paths []string) ([]bind.File, []string) fails os.Exit needs fs.Files {
	let mut files = []bind.File{}
	let mut srcs = []string{}
	for path in paths {
		let src = try read(path)
		files = files.Append(bind.File{Name: base(path), Parsed: syntax.Parse(src)})
		srcs = srcs.Append(src)
	}
	(files, srcs)
}

// Unit is one package of the run: its tables, files, import path,
// folder and each file's source.
type Unit { tab Tables, files []bind.File, path string, dir string, srcs []string }

func unitOf(g []string) Unit fails os.Exit needs fs.Files {
	if len(g) < 2 {
		return os.Exit{Code: 2, Message: "exprdump: a package needs EXT FOREIGN FILE..."}
	}
	let tab = tables(try read(g[0]), try read(g[1]))
	let (files, srcs) = try parseAll(g[2:len(g)])
	Unit{tab: tab, files: files, path: tab.pkgPath, dir: if len(g) > 2 { load.Dir(g[2]) } else { "." }, srcs: srcs}
}

// Typed is one package typed: its store, what Load made of it and the
// typer's result.
type Typed { s store.Store, k expr.Pkg, t expr.Typer }

func isSome[T](o Option[T]) bool {
	match o {
	case Some[T]:
		true
	case None:
		false
	}
}

// outside is the interfaces of the packages the units import and do not
// hold, loaded from std, transitively: each unit's, against its tables.
func outside(units []Unit, std string) []types.Iface needs fs.Files {
	let mut held = []string{}
	for u in units {
		held = held.Append(u.path)
	}
	let mut have = []types.Iface{}
	for u in units {
		let pkgs = load.Imported(bind.Imports(u.files), held, load.ModuleOf(u.dir), std)
		for p in pkgs {
			held = held.Append(p.Path)
		}
		have = load.Interfaces(pkgs, u.tab.ext, u.tab.foreign, have)
	}
	have
}

// loadAll binds the units as package tasks in import waves (check/task:
// each binds against its imports' frozen stores) and loads each once, its
// imports' interfaces (types.Iface) done first (those of have, the
// imports outside the run) (S3d3, S3d12).
func loadAll(units []Unit, have0 []types.Iface) []expr.Dep {
	let mut pkgs = []task.Package{}
	for u in units {
		pkgs = pkgs.Append(task.Package{Path: u.path, Files: u.files})
	}
	let checked = task.Check(pkgs, 4)
	let mut stores = []store.Store{}
	let mut have = have0
	let mut done = []bool{}
	let mut ks = []Option[expr.Pkg]{}
	for i, c in checked {
		// Its importers reach it by its path; its own types are named
		// by the path its tables give (main for a checked root).
		let mut s = store.Of(c.Store)
		store.SetPath(&s, units[i].tab.pkgPath)
		stores = stores.Append(s)
		done = done.Append(false)
		ks = ks.Append(None)
	}
	// A pass loads the units whose imports in the program are all
	// loaded; when none is ready (an import cycle), the first one left
	// loads against what is done.
	let mut left = len(units)
	for left > 0 {
		let mut progress = false
		for pass in 0..2 {
			if progress {
				break
			}
			for i, c in checked {
				if isSome(ks[i]) || (pass == 1 && progress) {
					continue
				}
				let mut ready = true
				for path in store.ImportPaths(stores[i]) {
					for j, u in units {
						if u.path == path && j != i && !done[j] {
							ready = false
						}
					}
				}
				if pass == 0 && !ready {
					continue
				}
				let deps = load.Deps(stores[i], have)
				let mut s = stores[i]
				let k = expr.Load(&s, units[i].files, c.Uses, c.Parents, units[i].tab.ext, units[i].tab.foreign, deps, units[i].tab.pkgName == "")
				// Its importers read it by its import path, which its
				// types print with (a checked root's own path is main).
				let mut at = s
				store.SetPath(&at, units[i].path)
				have = have.Append(types.Interface(at, k.Parsed, k.Kinds, k.Ext, units[i].tab.foreign, deps))
				done[i] = true
				stores[i] = s
				ks[i] = Some[expr.Pkg]{Value: k}
				left = left - 1
				progress = true
			}
		}
	}
	let mut loaded = []expr.Dep{}
	for i, c in checked {
		match ks[i] {
		case Some[expr.Pkg] as k:
			loaded = loaded.Append(expr.Dep{Path: c.Path, S: stores[i], K: k.Value})
		case None:
		}
	}
	loaded
}

// typeOne types the loaded package i with its imports' loaded packages
// as its deps. Each typed package holds a copy of its deps, so a corpus
// types and writes one at a time.
func typeOne(loaded []expr.Dep, i int) Typed {
	// The prelude is every package's: its Append, Get, Put and Delete
	// are functions on slices and Maps (types.md, Methods 7).
	let mut deps = []expr.Dep{}
	for j in 0..len(loaded) {
		if loaded[j].Path == "prelude" && loaded[i].Path != "prelude" {
			deps = deps.Append(loaded[j])
			break
		}
	}
	for path in store.ImportPaths(loaded[i].S) {
		for j in 0..len(loaded) {
			if loaded[j].Path == path {
				deps = deps.Append(loaded[j])
				break
			}
		}
	}
	let mut s = loaded[i].S
	let k = expr.WithDeps(loaded[i].K, deps)
	let t = expr.Check(&s, k)
	Typed{s: s, k: k, t: t}
}

// write prints one typed package's lines: its expressions' types, or
// with calls its inferred calls; each line after prefix.
func write(b mut strings.Builder, u Unit, d Typed, calls bool, prefix string) {
	let mut s = d.s
	let none = infer.NoValue(&s)
	if calls {
		for c in d.t.Insts {
			let (f, row) = bind.RowOf(d.k.Ps, c.At)
			let p = u.files[f].Parsed
			let mut ts = []string{}
			for a in c.Args {
				ts = ts.Append(typeText(s, d.k, u, none, a, c.Fn))
			}
			b.WriteString("\(prefix)\(u.files[f].Name) \(syntax.NodePos(p, syntax.NodeAt(p.Tree, row))) \(strings.Join(ts, " ; "))\n")
		}
	} else {
		for e in d.t.Entries {
			let (f, row) = bind.RowOf(d.k.Ps, e.At)
			let p = u.files[f].Parsed
			let id = syntax.NodeAt(p.Tree, row)
			b.WriteString("\(prefix)\(u.files[f].Name) \(syntax.NodePos(p, id)) \(syntax.NodeEnd(p, id)) \(typeText(s, d.k, u, none, e.T, e.Fn))\n")
		}
	}
}

// typeText is the Go checker's text of ty, a type of the function fn of
// the package k; "no value" for none. A function, not a closure over k:
// a closure would own the package and copy it, its imports with it, per
// call.
// A package let's value is of no function (fn -1).
func typeText(s store.Store, k expr.Pkg, u Unit, none dense.ID[store.TKey], ty dense.ID[store.TKey], fn int) string {
	if ty == none { "no value" } else { types.Text(s, types.Names{Params: if fn >= 0 { k.Fns[fn].Params } else { []string{} }, Foreign: k.Foreign, Pkg: u.tab.pkgName, Deps: k.Ifaces}, ty) }
}

// writeLets prints the type of each package let's name the typer gives
// one, "FILE START END TYPE" after prefix (CHECK-VALUE-TYPES).
// writeOutside prints the values of a record literal of an import
// outside the run, which the typer types with no expected type.
func writeOutside(b mut strings.Builder, u Unit, d Typed, prefix string) {
	for at in d.t.Outside {
		let (f, row) = bind.RowOf(d.k.Ps, at)
		let p = u.files[f].Parsed
		let id = syntax.NodeAt(p.Tree, row)
		b.WriteString("\(prefix)\(u.files[f].Name) \(syntax.NodePos(p, id)) \(syntax.NodeEnd(p, id))\n")
	}
}

func writeLets(b mut strings.Builder, u Unit, d Typed, prefix string) {
	let mut s = d.s
	let none = infer.NoValue(&s)
	for f in 0..len(u.files) {
		let p = u.files[f].Parsed
		if p.Failed {
			continue
		}
		let decls = syntax.FileOf(p.Tree, syntax.Root(p.Tree)).Decls
		for i in 0..syntax.Len(decls) {
			let dc = syntax.Item(p.Tree, decls, i)
			if syntax.KindOf(p.Tree, dc) != syntax.KVarDecl {
				continue
			}
			let spec = syntax.VarDeclOf(p.Tree, dc).Spec
			if syntax.KindOf(p.Tree, spec) != syntax.KVarSpec {
				continue
			}
			let names = syntax.VarSpecOf(p.Tree, spec).Names
			for j in 0..syntax.Len(names) {
				let id = syntax.Item(p.Tree, names, j)
				match expr.DefType(d.t, bind.PNodeOf(d.k.Ps, f, id)) {
				case Some[dense.ID[store.TKey]] as ty:
					b.WriteString("\(prefix)\(u.files[f].Name) \(syntax.NodePos(p, id)) \(syntax.NodeEnd(p, id)) \(typeText(s, d.k, u, none, ty.Value, -1))\n")
				case None:
				}
			}
		}
	}
}

// writeOwn prints the own-mark diagnostics of one typed package, "FILE
// OFFSET LENGTH CODE MESSAGE" after prefix, in the Go checker's order.
func writeOwn(b mut strings.Builder, u Unit, d Typed, prefix string) {
	for g in diag.OwnMarks(d.s, d.k, d.t) {
		b.WriteString("\(prefix)\(u.files[g.File].Name) \(g.Offset) \(g.Length) \(g.Code) \(g.Message)\n")
	}
}

// writeFlow prints the ownership flow's diagnostics of one typed package,
// "FILE OFFSET LENGTH CODE MESSAGE" after prefix, in the Go checker's
// order (OWN-WALK).
func writeFlow(b mut strings.Builder, u Unit, d Typed, prefix string) {
	for g in diag.Flow(d.s, d.k, d.t, u.srcs) {
		b.WriteString("\(prefix)\(u.files[g.File].Name) \(g.Offset) \(g.Length) \(g.Code) \(g.Message)\n")
	}
}

// writeDiags prints the typer's diagnostics, "D FILE START END" after
// prefix, one per line (S3d5).
func writeDiags(b mut strings.Builder, u Unit, d Typed, prefix string) {
	for g in expr.Diags(d.t) {
		let (f, row) = bind.RowOf(d.k.Ps, g.At)
		let p = u.files[f].Parsed
		let id = syntax.NodeAt(p.Tree, row)
		b.WriteString("\(prefix)\(u.files[f].Name) \(syntax.NodePos(p, id)) \(syntax.NodeEnd(p, id))\n")
	}
}

func run(argv0 []string) fails os.Exit needs fs.Files | io.Stdout {
	let mut b = strings.NewBuilder()
	let mut std = ""
	let mut argv = argv0
	if len(argv) > 1 && argv[0] == "-std" {
		std = argv[1]
		argv = argv[2:len(argv)]
	}
	if len(argv) == 2 && argv[0] == "-corpus" {
		// One package per line of the manifest, "PATH EXT FOREIGN
		// FILE...": its import path (a checked root's @pkg path is main),
		// its tables and files. Each package's lines are "E …" (types),
		// "C …" (calls), "D …" (diagnostics) and "O …" (own marks) after
		// its "@pkg I" line.
		let mut units = []Unit{}
		for line in strings.Split(try read(argv[1]), "\n") {
			let g = strings.Fields(line)
			if len(g) > 0 {
				let mut u = try unitOf(g[1:len(g)])
				u.path = g[0]
				units = units.Append(u)
			}
		}
		let loaded = loadAll(units, outside(units, std))
		// By index: a loop's element binding would copy each package.
		for i in 0..len(loaded) {
			let d = typeOne(loaded, i)
			b.WriteString("@pkg \(i)\n")
			write(&b, units[i], d, false, "E ")
			write(&b, units[i], d, true, "C ")
			writeDiags(&b, units[i], d, "D ")
			writeOwn(&b, units[i], d, "O ")
			writeFlow(&b, units[i], d, "W ")
			writeLets(&b, units[i], d, "L ")
			writeOutside(&b, units[i], d, "X ")
		}
		io.Stdout.Print(b.String())
		return
	}
	let calls = len(argv) > 0 && argv[0] == "-calls"
	let args = if calls { argv[1:len(argv)] } else { argv }
	if len(args) < 2 {
		return os.Exit{Code: 2, Message: "usage: exprdump [-std DIR] [-calls] EXT FOREIGN FILE... [-- EXT FOREIGN FILE...]... | exprdump [-std DIR] -corpus MANIFEST"}
	}
	let mut groups = [][]string{[]string{}}
	for a in args {
		if a == "--" {
			groups = groups.Append([]string{})
		} else {
			groups[len(groups)-1] = groups[len(groups)-1].Append(a)
		}
	}
	let mut units = []Unit{}
	for g in groups {
		units = units.Append(try unitOf(g))
	}
	let d = typeOne(loadAll(units, outside(units, std)), 0)
	write(&b, units[0], d, calls, "")
	if !calls {
		writeDiags(&b, units[0], d, "D ")
		writeLets(&b, units[0], d, "L ")
	}
	io.Stdout.Print(b.String())
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}
