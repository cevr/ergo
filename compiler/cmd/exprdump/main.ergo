// exprdump types one package's expressions with compiler/check/expr and
// prints one line per typed expression, or with -calls one per inferred
// generic call, unsorted:
//
//	exprdump [-std DIR] EXT FOREIGN FILE... [-- EXT FOREIGN FILE...]...          "FILE START END TYPE"
//	exprdump [-std DIR] -calls EXT FOREIGN FILE... [-- EXT FOREIGN FILE...]...   "FILE OFFSET T1 ; T2 …"
//	exprdump [-std DIR] -corpus MANIFEST
//
// -std DIR loads the Ergo packages the run's packages import and do not
// hold, transitively, as typedump does (compiler/check/load); only their
// interfaces are computed, against the tables of the package that
// imports them.
//
// Each group after a "--" is an imported package (its path is its
// FOREIGN's @pkg line): it is bound and loaded on its own, and the package
// binds against its frozen store and types the import's functions and
// record fields from its signatures (S3d2); its types are XRefs into the
// import's interface (types.Iface), computed in import order (S3d12).
//
// START and END are the expression's byte offsets (END the byte after
// it); OFFSET is the callee name's. Types print as the Go checker's
// Type.String (compiler/check/types Text), no value as "no value". EXT and
// FOREIGN are typedump's: the Go side writes them, for the prelude's, the
// universe's and the Go imports' types.
//
// With -corpus, each package's "O FILE OFFSET LENGTH CODE MESSAGE" lines
// are compiler/check/diag's own-mark diagnostics (MODES-OWN-CHECK).
//
// It is the Ergo side of S3d's expression agreement
// (internal/selfhostcheck's TestCompilerExprAgreesWithChecker) and of the
// own-mark agreement (TestCompilerOwnMarksAgreeWithChecker).

import compiler/check/bind
import compiler/check/diag
import compiler/check/expr
import compiler/check/infer
import compiler/check/load
import compiler/check/store
import compiler/check/types
import compiler/syntax
import dense
import fs
import io
import os
import strings

func base(path string) string {
	let i = strings.LastIndex(path, "/")
	if i < 0 { path } else { path[i+1 : len(path)] }
}

func read(path string) string fails os.Exit needs fs.Files {
	fs.Files.ReadFile(path) catch {
	case fs.NotFound:
		return os.Exit{Code: 1, Message: "exprdump: no file \(path)"}
	case fs.Denied:
		return os.Exit{Code: 1, Message: "exprdump: cannot read \(path)"}
	case fs.Failed as e:
		return os.Exit{Code: 1, Message: "exprdump: cannot read \(path): \(e.Reason)"}
	}
}

func unitOf(g []string) load.Unit fails os.Exit needs fs.Files {
	if len(g) < 2 {
		return os.Exit{Code: 2, Message: "exprdump: a package needs EXT FOREIGN FILE..."}
	}
	let tab = load.TablesOf(try read(g[0]), try read(g[1]))
	let paths = g[2:len(g)]
	let mut files = []bind.File{}
	for path in paths {
		files = files.Append(bind.File{Name: base(path), Parsed: syntax.Parse(try read(path))})
	}
	load.UnitOf(tab, files, paths)
}

// typeAll binds, loads and types the units (compiler/check/load), each
// loaded package's typing and its unit.
func typeAll(units []load.Unit, std string) ([]load.Typed, []int) needs fs.Files {
	let p = load.LoadAll(units, load.Outside(units, std))
	let mut out = []load.Typed{}
	for i in 0..len(p.Loaded) {
		out = out.Append(load.TypeAt(p, i))
	}
	(out, p.Units)
}

// write prints one typed package's lines: its expressions' types, or
// with calls its inferred calls; each line after prefix.
func write(b mut strings.Builder, u load.Unit, d load.Typed, calls bool, prefix string) {
	let mut s0 = d.S
	let none = infer.NoValue(&s0)
	let s = s0
	let k = d.K
	let text = func(ty dense.ID[store.TKey], fn int) string {
		if ty == none { "no value" } else { types.Text(s, types.Names{Params: k.Fns[fn].Params, Foreign: k.Foreign, Pkg: u.Tab.PkgName, Deps: k.Ifaces}, ty) }
	}
	if calls {
		for c in d.T.Insts {
			let (f, row) = bind.RowOf(k.Ps, c.At)
			let p = u.Files[f].Parsed
			let mut ts = []string{}
			for a in c.Args {
				ts = ts.Append(text(a, c.Fn))
			}
			b.WriteString("\(prefix)\(u.Files[f].Name) \(syntax.NodePos(p, syntax.NodeAt(p.Tree, row))) \(strings.Join(ts, " ; "))\n")
		}
	} else {
		for e in d.T.Entries {
			let (f, row) = bind.RowOf(k.Ps, e.At)
			let p = u.Files[f].Parsed
			let id = syntax.NodeAt(p.Tree, row)
			b.WriteString("\(prefix)\(u.Files[f].Name) \(syntax.NodePos(p, id)) \(syntax.NodeEnd(p, id)) \(text(e.T, e.Fn))\n")
		}
	}
}

// writeOwn prints the own-mark diagnostics of one typed package, "FILE
// OFFSET LENGTH CODE MESSAGE" after prefix, in the Go checker's order.
func writeOwn(b mut strings.Builder, u load.Unit, d load.Typed, prefix string) {
	for g in diag.OwnMarks(d.S, d.K, d.T) {
		b.WriteString("\(prefix)\(u.Files[g.File].Name) \(g.Offset) \(g.Length) \(g.Code) \(g.Message)\n")
	}
}

// writeDiags prints the typer's diagnostics, "D FILE START END" after
// prefix, one per line (S3d5).
func writeDiags(b mut strings.Builder, u load.Unit, d load.Typed, prefix string) {
	for g in expr.Diags(d.T) {
		let (f, row) = bind.RowOf(d.K.Ps, g.At)
		let p = u.Files[f].Parsed
		let id = syntax.NodeAt(p.Tree, row)
		b.WriteString("\(prefix)\(u.Files[f].Name) \(syntax.NodePos(p, id)) \(syntax.NodeEnd(p, id))\n")
	}
}

func run(argv0 []string) fails os.Exit needs fs.Files | io.Stdout {
	let mut b = strings.NewBuilder()
	let mut std = ""
	let mut argv = argv0
	if len(argv) > 1 && argv[0] == "-std" {
		std = argv[1]
		argv = argv[2:len(argv)]
	}
	if len(argv) == 2 && argv[0] == "-corpus" {
		// One package per line of the manifest, "PATH EXT FOREIGN
		// FILE...": its import path (a checked root's @pkg path is main),
		// its tables and files. Each package's lines are "E …" (types),
		// "C …" (calls), "D …" (diagnostics) and "O …" (own marks) after
		// its "@pkg I" line.
		let mut units = []load.Unit{}
		for line in strings.Split(try read(argv[1]), "\n") {
			let g = strings.Fields(line)
			if len(g) > 0 {
				let mut u = try unitOf(g[1:len(g)])
				u.Path = g[0]
				units = units.Append(u)
			}
		}
		let (typed, of) = typeAll(units, std)
		for i, d in typed {
			let u = units[of[i]]
			b.WriteString("@pkg \(i)\n")
			write(&b, u, d, false, "E ")
			write(&b, u, d, true, "C ")
			writeDiags(&b, u, d, "D ")
			writeOwn(&b, u, d, "O ")
		}
		io.Stdout.Print(b.String())
		return
	}
	let calls = len(argv) > 0 && argv[0] == "-calls"
	let args = if calls { argv[1:len(argv)] } else { argv }
	if len(args) < 2 {
		return os.Exit{Code: 2, Message: "usage: exprdump [-std DIR] [-calls] EXT FOREIGN FILE... [-- EXT FOREIGN FILE...]... | exprdump [-std DIR] -corpus MANIFEST"}
	}
	let mut groups = [][]string{[]string{}}
	for a in args {
		if a == "--" {
			groups = groups.Append([]string{})
		} else {
			groups[len(groups)-1] = groups[len(groups)-1].Append(a)
		}
	}
	let mut units = []load.Unit{}
	for g in groups {
		units = units.Append(try unitOf(g))
	}
	let (typed, _) = typeAll(units, std)
	write(&b, units[0], typed[0], calls, "")
	if !calls {
		writeDiags(&b, units[0], typed[0], "D ")
	}
	io.Stdout.Print(b.String())
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}
