import compiler/cases
import compiler/ergoversion
import compiler/stage
import compiler/testinputs
import exec
import filepath
import fs
import fstest
import hex
import io
import json
import option
import os
import slices
import strconv
import strings

func main() fails os.Exit needs os.Ambient {
	let proc = os.NewHost()
	let files = fs.NewHost()
	let execHost = exec.NewHost()
	let out = io.NewHost()
	let err = io.NewErrors()
	let inp = io.NewStdin()
	let args = proc.Args()
	with context {
		os.Process:  proc,
		fs.Files:    files,
		fs.Entries:  files,
		fs.Writes:   files,
		exec.Runner: execHost,
		io.Stdout:   out,
		io.Stderr:   err,
		io.Stdin:    inp,
	} {
		try Run(args)
	}
}

// Run dispatches the parity-dump CLI subcommands against the active
// capability providers.
func Run(args []string) fails os.Exit needs os.Process | fs.Files | fs.Entries | fs.Writes | exec.Runner | io.Stdout | io.Stderr | io.Stdin {
	if args.Len() < 1 {
		return exitErr("usage: casesdump <ergoversion|stage|cases|testinputs> ...")
	}
	let cmd = args[0]
	let rest = slices.Slice(args, 1, args.Len())
	if cmd == "ergoversion" {
		return runErgoversion(rest)
	}
	if cmd == "stage" {
		return runStage(rest)
	}
	if cmd == "cases" {
		return runCases(rest)
	}
	if cmd == "testinputs" {
		return runTestinputs(rest)
	}
	exitErr("unknown subcommand: " + cmd)
}

func runErgoversion(args []string) fails os.Exit needs io.Stdout | io.Stderr {
	if args.Len() < 1 {
		return exitErr("usage: casesdump ergoversion <of|check> ...")
	}
	if args[0] == "of" {
		let mainVer = if args.Len() >= 2 { args[1] } else { "" }
		let mut settings = []ergoversion.BuildSetting{}
		for i in 2..args.Len() {
			match strings.Cut(args[i], "=") {
			case option.Some{Value: h}:
				settings = settings.Append(ergoversion.BuildSetting{Key: h.Before, Value: h.After})
			case option.None:
			}
		}
		let v = ergoversion.Of(ergoversion.BuildInfo{MainVersion: mainVer, Settings: settings})
		let t = json.NewText()
		t.BeginObject(3)
		t.Key("version")
		t.String(v)
		t.Key("valid")
		t.String(ergoversion.Valid(v))
		t.Key("install")
		t.String(ergoversion.InstallCommand(v))
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "check" && args.Len() >= 3 {
		let a = args[1]
		let b = args[2]
		let t = json.NewText()
		t.BeginObject(4)
		t.Key("validA")
		t.String(ergoversion.Valid(a))
		t.Key("validB")
		t.String(ergoversion.Valid(b))
		t.Key("cmp")
		t.Int(int64(ergoversion.Compare(a, b)))
		t.Key("satisfies")
		t.Bool(ergoversion.Satisfies(a, b))
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	exitErr("invalid ergoversion arguments")
}

func runStage(args []string) fails os.Exit needs io.Stdout | io.Stderr {
	if args.Len() < 1 {
		return exitErr("usage: casesdump stage <names|report> ...")
	}
	if args[0] == "names" {
		let all = stage.Names()
		let t = json.NewText()
		t.BeginList(all.Len())
		for _, n in all {
			t.String(n)
		}
		t.EndList()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "report" && args.Len() >= 4 {
		let sp = parseU64Arg(args[1]) catch {
		case badNum as e:
			return exitErr(e.Msg)
		}
		let sc = parseU64Arg(args[2]) catch {
		case badNum as e:
			return exitErr(e.Msg)
		}
		let sd = parseU64Arg(args[3]) catch {
		case badNum as e:
			return exitErr(e.Msg)
		}
		let mut tbl = stage.NewTable()
		for i in 4..args.Len() {
			match strings.Cut(args[i], "=") {
			case option.Some{Value: h}:
				let id = stage.CounterID(h.Before)
				if id == stage.NoCounter {
					return exitErr("unknown counter: " + h.Before)
				}
				let delta = parseU64Arg(h.After) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
				stage.Add(&tbl, id, delta)
			case option.None:
				return exitErr("bad counter assignment: " + args[i])
			}
		}
		let rep = stage.StageReport(tbl, stage.StdWork{
			FilesParsed:     sp,
			PackagesChecked: sc,
			PackagesDecoded: sd,
		})
		let body = stage.FormatReportJSON(rep) catch {
		case json.Malformed as e:
			return exitErr(e.Reason)
		}
		io.Stdout.Print(body)
		return
	}
	exitErr("invalid stage arguments")
}

func runCases(args []string) fails os.Exit needs os.Process | fs.Files | fs.Entries | fs.Writes | exec.Runner | io.Stdout | io.Stderr | io.Stdin {
	if args.Len() < 1 {
		return exitErr("usage: casesdump cases <load|diff|judge|run> ...")
	}
	if args[0] == "load" && args.Len() >= 2 {
		let dir = args[1]
		let record = args.Len() >= 3 && args[2] == "1"
		let (tbl, probs) = cases.Load(dir, record)
		let views = cases.Views(tbl)
		let t = json.NewText()
		t.BeginObject(2)
		t.Key("cases")
		t.BeginList(views.Len())
		for _, c in views {
			t.BeginObject(8)
			t.Key("name")
			t.String(c.Name)
			t.Key("dir")
			t.String(c.Dir)
			t.Key("args")
			t.BeginList(c.Args.Len())
			for _, a in c.Args {
				t.String(a)
			}
			t.EndList()
			t.Key("env")
			t.BeginList(c.Env.Len())
			for _, e in c.Env {
				t.String(e)
			}
			t.EndList()
			t.Key("stdin")
			t.String(c.Stdin)
			t.Key("setup")
			t.Bool(c.Setup)
			t.Key("hasOut")
			t.Bool(c.HasOut)
			t.Key("out")
			t.String(c.Out)
			t.Key("err")
			t.String(c.Err)
			t.Key("status")
			t.Uint(uint64(c.Status))
			t.EndObject()
		}
		t.EndList()
		t.Key("problems")
		t.BeginList(probs.Len())
		for _, p in probs {
			t.String(p)
		}
		t.EndList()
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "diff" {
		if args.Len() >= 3 {
			let want = readHostFile(args[1]) catch {
			case badNum as e:
				return exitErr(e.Msg)
			}
			let got = readHostFile(args[2]) catch {
			case badNum as e:
				return exitErr(e.Msg)
			}
			io.Stdout.Print(cases.Diff(want, got))
			return
		}
		let raw = io.Stdin.ReadAll() catch {
		case io.ReadFailed as e:
			return exitErr(e.Reason)
		}
		match strings.Cut(raw, "\x00") {
		case option.Some{Value: h}:
			io.Stdout.Print(cases.Diff(h.Before, h.After))
		case option.None:
			return exitErr("diff stdin expects want\\x00got")
		}
		return
	}
	if args[0] == "judge" {
		let raw = io.Stdin.ReadAll() catch {
		case io.ReadFailed as e:
			return exitErr(e.Reason)
		}
		let r = json.Open(raw, 0, 0) catch {
		case json.Malformed as e:
			return exitErr(e.Reason)
		}
		r.BeginObject() catch {
		case WireWrongKind as e:
			return exitErr(e.Path)
		}
		let mut wantOut = ""
		let mut wantErr = ""
		let mut hasOut = true
		let mut wantStatus = uint32(0)
		let mut gotOut = ""
		let mut gotErr = ""
		let mut gotStatus = 0
		let mut outOver = false
		let mut errOver = false
		let mut timedOut = false
		let mut program = ""
		let mut memory = uint64(0)
		for r.More() {
			let k = r.Key()
			if k == "wantOut" {
				wantOut = rStr(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "wantErr" {
				wantErr = rStr(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "hasOut" {
				hasOut = rBool(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "wantStatus" {
				wantStatus = uint32(rUint(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				})
			} else if k == "gotOut" {
				gotOut = rStr(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "gotErr" {
				gotErr = rStr(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "gotStatus" {
				gotStatus = int(rInt(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				})
			} else if k == "outOver" {
				outOver = rBool(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "errOver" {
				errOver = rBool(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "timedOut" {
				timedOut = rBool(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "program" {
				program = rStr(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "memory" {
				memory = rUint(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else {
				r.Skip()
			}
		}
		r.End()
		let c = cases.CaseView{
			ID:     uint32(0),
			Name:   "case",
			Dir:    "",
			Args:   []string{},
			Env:    []string{},
			Stdin:  "",
			Setup:  false,
			Out:    wantOut,
			HasOut: hasOut,
			Err:    wantErr,
			Status: wantStatus,
		}
		let mut o = cases.ClassifyOutcome(gotOut, gotErr, gotStatus, timedOut, memory)
		if outOver {
			o = cases.Outcome{..o, StdoutOver: true}
		}
		if errOver {
			o = cases.Outcome{..o, StderrOver: true}
		}
		let v = cases.Judge(c, o, program, memory, "0s")
		let t = json.NewText()
		t.BeginObject(6)
		t.Key("passed")
		t.Bool(cases.VerdictPassed(v))
		t.Key("fatal")
		t.String(v.Fatal)
		t.Key("limited")
		t.Bool(o.Limited)
		t.Key("cause")
		t.Uint(uint64(cases.CauseOf(gotErr)))
		t.Key("what")
		t.BeginList(v.What.Len())
		for _, w in v.What {
			t.String(w)
		}
		t.EndList()
		t.Key("diff")
		t.String(cases.FormatVerdictDiff(v, c, o))
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "run" && args.Len() >= 4 {
		let dir = args[1]
		let binary = args[2]
		let mem = parseU64Arg(args[3]) catch {
		case badNum as e:
			return exitErr(e.Msg)
		}
		let (tbl, probs) = cases.Load(dir, false)
		let (probText, probCode) = cases.FormatProblems(probs)
		if probCode != uint32(0) {
			io.Stdout.Print(probText)
			return os.Exit{Code: 1, Message: ""}
		}
		let (rep, code) = cases.Run(binary, tbl, mem)
		io.Stdout.Print(rep)
		if code != uint32(0) {
			return os.Exit{Code: 1, Message: ""}
		}
		return
	}
	exitErr("invalid cases arguments")
}

func runTestinputs(args []string) fails os.Exit needs io.Stdout | io.Stderr | io.Stdin {
	if args.Len() < 1 {
		return exitErr("usage: casesdump testinputs <testenv|genprogram|testlog|recordjson|mountverdict|seccomp|decode> ...")
	}
	if args[0] == "testenv" {
		let raw = io.Stdin.ReadAll() catch {
		case io.ReadFailed as e:
			return exitErr(e.Reason)
		}
		let lines = if raw == "" { []string{} } else { strings.Split(strings.TrimSuffix(raw, "\n"), "\n") }
		let kept = testinputs.Environment(lines)
		let names = testinputs.Names()
		let t = json.NewText()
		t.BeginObject(2)
		t.Key("names")
		t.BeginList(names.Len())
		for _, n in names {
			t.String(n)
		}
		t.EndList()
		t.Key("kept")
		t.BeginList(kept.Len())
		for _, k in kept {
			t.String(k)
		}
		t.EndList()
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "genprogram" && args.Len() >= 4 {
		let seed = parseU64Arg(args[1]) catch {
		case badNum as e:
			return exitErr(e.Msg)
		}
		let n = int(parseU64Arg(args[2]) catch {
		case badNum as e:
			return exitErr(e.Msg)
		})
		let groups = int(parseU64Arg(args[3]) catch {
		case badNum as e:
			return exitErr(e.Msg)
		})
		let prog = testinputs.GenerateProgram(seed, n, groups)
		let t = json.NewText()
		t.BeginObject(3)
		t.Key("module")
		t.String(prog.Module)
		t.Key("packages")
		t.BeginList(prog.Packages.Len())
		for _, p in prog.Packages {
			t.String(p)
		}
		t.EndList()
		t.Key("files")
		t.BeginList(prog.Files.Len())
		for _, f in prog.Files {
			t.BeginObject(2)
			t.Key("path")
			t.String(f.Path)
			t.Key("content")
			t.String(f.Content)
			t.EndObject()
		}
		t.EndList()
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "testlog" {
		let rest = slices.Slice(args, 1, args.Len())
		let flag = testinputs.TestLogFlag(rest)
		let t = json.NewText()
		t.BeginObject(1)
		t.Key("log")
		t.String(flag)
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "recordjson" {
		let raw = io.Stdin.ReadAll() catch {
		case io.ReadFailed as e:
			return exitErr(e.Reason)
		}
		let rec = testinputs.DecodeRecordJSON(raw) catch {
		case testinputs.RecordError as e:
			return exitErr(e.Reason)
		}
		let encoded = testinputs.EncodeRecordJSON(rec) catch {
		case json.Malformed as e:
			return exitErr(e.Reason)
		}
		io.Stdout.Println(encoded)
		return
	}
	if args[0] == "mountverdict" {
		let raw = io.Stdin.ReadAll() catch {
		case io.ReadFailed as e:
			return exitErr(e.Reason)
		}
		let r = json.Open(raw, 0, 0) catch {
		case json.Malformed as e:
			return exitErr(e.Reason)
		}
		r.BeginObject() catch {
		case WireWrongKind as e:
			return exitErr(e.Path)
		}
		let mut start = ""
		let mut end = ""
		let mut watched = []string{}
		let mut visited = []string{}
		for r.More() {
			let k = r.Key()
			if k == "start" {
				start = rStr(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "end" {
				end = rStr(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "watched" {
				watched = rStrList(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else if k == "visited" {
				visited = rStrList(r) catch {
				case badNum as e:
					return exitErr(e.Msg)
				}
			} else {
				r.Skip()
			}
		}
		r.End()
		let v = testinputs.MountVerdict(start, end, watched, visited)
		let t = json.NewText()
		t.BeginObject(1)
		t.Key("verdict")
		t.String(v)
		t.EndObject()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "seccomp" && args.Len() >= 3 {
		let arch = if args[1] == "arm64" { testinputs.ArchARM64 } else { testinputs.ArchAMD64 }
		let target = args[2] == "1"
		let filter = testinputs.BuildFilter(arch, target)
		let t = json.NewText()
		t.BeginList(filter.Len())
		for _, ins in filter {
			t.BeginObject(4)
			t.Key("code")
			t.Uint(uint64(ins.Code))
			t.Key("jt")
			t.Uint(uint64(ins.JT))
			t.Key("jf")
			t.Uint(uint64(ins.JF))
			t.Key("k")
			t.Uint(uint64(ins.K))
			t.EndObject()
		}
		t.EndList()
		io.Stdout.Println(t.Written())
		return
	}
	if args[0] == "decode" && args.Len() >= 2 {
		let raw = io.Stdin.ReadAll() catch {
		case io.ReadFailed as e:
			return exitErr(e.Reason)
		}
		let bytesStr = hex.Decode(strings.TrimSpace(raw)) catch {
		case hex.Malformed as e:
			return exitErr("bad hex at " + strconv.Itoa(e.Offset))
		}
		let b = bytesStr.Bytes()
		let t = json.NewText()
		if args[1] == "sockpath" {
			t.BeginObject(1)
			t.Key("path")
			t.String(testinputs.DecodeSockaddrPath(b))
			t.EndObject()
			io.Stdout.Println(t.Written())
			return
		}
		if args[1] == "sockpeer" {
			let p = testinputs.DecodeSockaddrPeer(b)
			t.BeginObject(4)
			t.Key("family")
			t.Uint(uint64(p.Family))
			t.Key("name")
			t.String(p.Name)
			t.Key("addr")
			t.String(p.Addr)
			t.Key("port")
			t.Uint(uint64(p.Port))
			t.EndObject()
			io.Stdout.Println(t.Written())
			return
		}
		if args[1] == "inotify" {
			let (evs, errStr) = testinputs.ParseInotifyEvents(b)
			t.BeginObject(2)
			t.Key("error")
			t.String(errStr)
			t.Key("events")
			t.BeginList(evs.Len())
			for _, ev in evs {
				t.BeginObject(4)
				t.Key("wd")
				t.Uint(uint64(ev.Wd))
				t.Key("mask")
				t.Uint(uint64(ev.Mask))
				t.Key("cookie")
				t.Uint(uint64(ev.Cookie))
				t.Key("name")
				t.String(ev.Name)
				t.EndObject()
			}
			t.EndList()
			t.EndObject()
			io.Stdout.Println(t.Written())
			return
		}
	}
	exitErr("invalid testinputs arguments")
}

type badNum {
	Msg string,
}

func readHostFile(path string) string fails badNum needs fs.Files {
	fs.Files.ReadFile(path) catch {
	case fs.NotFound as e:
		return badNum{Msg: e.Path + ": not found"}
	case fs.Denied as e:
		return badNum{Msg: e.Path + ": permission denied"}
	case fs.Failed as e:
		return badNum{Msg: e.Reason}
	}
}

func rStr(r json.Reader) string fails badNum {
	r.String() catch {
	case WireWrongKind as e:
		return badNum{Msg: e.Path}
	}
}

func rBool(r json.Reader) bool fails badNum {
	r.Bool() catch {
	case WireWrongKind as e:
		return badNum{Msg: e.Path}
	}
}

func rUint(r json.Reader) uint64 fails badNum {
	r.Uint() catch {
	case WireWrongKind as e:
		return badNum{Msg: e.Path}
	}
}

func rInt(r json.Reader) int64 fails badNum {
	r.Int() catch {
	case WireWrongKind as e:
		return badNum{Msg: e.Path}
	}
}

func rStrList(r json.Reader) []string fails badNum {
	r.BeginList() catch {
	case WireWrongKind as e:
		return badNum{Msg: e.Path}
	}
	let mut out = []string{}
	for r.More() {
		let s = rStr(r) catch {
		case badNum as e:
			return e
		}
		out = out.Append(s)
	}
	r.End()
	out
}

func parseU64Arg(s string) uint64 fails badNum {
	let b = s.Bytes()
	if b.Len() == 0 {
		return badNum{Msg: "empty integer"}
	}
	let mut acc = uint64(0)
	let maxDiv10 = uint64(1844674407370955161)
	for _, c in b {
		if c < '0' || c > '9' {
			return badNum{Msg: "invalid integer: " + s}
		}
		let d = uint64(c - '0')
		if acc > maxDiv10 || (acc == maxDiv10 && d > uint64(5)) {
			return badNum{Msg: "overflow: " + s}
		}
		acc = acc*uint64(10) + d
	}
	acc
}

func exitErr(msg string) os.Exit needs io.Stderr {
	io.Stderr.Eprintln(msg)
	os.Exit{Code: 1, Message: ""}
}

type stubProcess { env Map[string, string], cwd string } implements os.Process

func Args(_ stubProcess) []string {
	[]string{}
}

func Getenv(p stubProcess, key string) option.Option[string] {
	p.env.Get(key)
}

func Environ(p stubProcess) Map[string, string] {
	p.env
}

func Getwd(p stubProcess) string fails os.NoWorkdir {
	if p.cwd == "" || !filepath.IsAbs(p.cwd) {
		return os.NoWorkdir{Message: "unset"}
	}
	p.cwd
}

test CasesdumpSubcommandsSmoke {
	let mem = fstest.NewMemory()
	let proc = stubProcess{env: Map[string, string]{}, cwd: ""}
	let rec = io.NewRecorder()
	let errRec = io.NewRecorder()
	with context {
		os.Process:  proc,
		fs.Files:    mem,
		fs.Entries:  mem,
		fs.Writes:   mem,
		exec.Runner: exec.Script{Results: Map[string, exec.Result]{}},
		io.Stdout:   rec,
		io.Stderr:   errRec,
		io.Stdin:    io.NewInput(""),
	} {
		Run([]string{"ergoversion", "of", "v1.2.3"}) catch {
		case os.Exit:
			assert false
			return
		}
		Run([]string{"stage", "report", "2", "1", "3", "files_read=5"}) catch {
		case os.Exit:
			assert false
			return
		}
		Run([]string{"testinputs", "genprogram", "7", "2", "2"}) catch {
		case os.Exit:
			assert false
			return
		}
		Run([]string{"testinputs", "seccomp", "amd64", "0"}) catch {
		case os.Exit:
			assert false
			return
		}
	}
	let outText = io.Text(rec)
	assert strings.Contains(outText, "\"version\":\"v1.2.3\"")
	assert strings.Contains(outText, "\"files_read\": 5")
	assert strings.Contains(outText, "\"module\":\"gen2\"")
	assert strings.Contains(outText, "\"code\":32")
}
