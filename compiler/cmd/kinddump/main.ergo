// kinddump solves the bracket parameter kinds of one package's generic
// type declarations with compiler/check/types and prints them, one line
// per declaration, and those of its generic functions:
//
//	kinddump EXT FILE...   "NAME KIND,KIND,…", "func NAME KIND,KIND,…"
//
// EXT is a file of the kinds of the generic types the package names that
// are not its own, one line "HEAD KIND,KIND,…" (the Go side writes it; it
// stands in for the frozen interfaces). KIND is type, errors, uses or
// conflict. It is the Ergo side of S3t's kinds agreement.

import compiler/check/bind
import compiler/check/types
import compiler/syntax
import fs
import io
import os
import strings

func base(path string) string {
	let i = strings.LastIndex(path, "/")
	if i < 0 { path } else { path[i+1 : len(path)] }
}

func word(k int) string {
	if k == 1 { "type" } else if k == 2 { "errors" } else if k == 4 { "uses" } else { "conflict" }
}

func bit(w string) int {
	if w == "type" { 1 } else if w == "errors" { 2 } else if w == "uses" { 4 } else { 8 }
}

func read(path string) string fails os.Exit needs fs.Files {
	fs.Files.ReadFile(path) catch {
	case fs.NotFound:
		return os.Exit{Code: 1, Message: "kinddump: no file \(path)"}
	case fs.Denied:
		return os.Exit{Code: 1, Message: "kinddump: cannot read \(path)"}
	case fs.Failed as e:
		return os.Exit{Code: 1, Message: "kinddump: cannot read \(path): \(e.Reason)"}
	}
}

func run(args []string) fails os.Exit needs fs.Files | io.Stdout {
	if len(args) < 1 {
		return os.Exit{Code: 2, Message: "usage: kinddump EXT FILE..."}
	}
	let mut ext = []types.Ext{}
	for line in strings.Split(try read(args[0]), "\n") {
		let parts = strings.Fields(line)
		if len(parts) != 2 {
			continue
		}
		let mut ks = []int{}
		for w in strings.Split(parts[1], ",") {
			ks = ks.Append(bit(w))
		}
		ext = ext.Append(types.Ext{Head: parts[0], Kinds: ks})
	}
	let mut files = []bind.File{}
	let mut parsed = []syntax.Parsed{}
	for path in args[1:len(args)] {
		let p = syntax.Parse(try read(path))
		files = files.Append(bind.File{Name: base(path), Parsed: p})
		parsed = parsed.Append(p)
	}
	let s = bind.Collect("main", files)
	let k = types.SolveKinds(s, parsed, ext)
	let mut b = strings.NewBuilder()
	for i, name in k.Names {
		let mut ws = []string{}
		for x in k.Of[i] {
			ws = ws.Append(word(x))
		}
		b.WriteString("\(name) \(strings.Join(ws, ","))\n")
	}
	for f in types.SolveFuncKinds(s, parsed, ext, k) {
		if len(f.Kinds) == 0 {
			continue
		}
		let mut ws = []string{}
		for x in f.Kinds {
			ws = ws.Append(word(x))
		}
		b.WriteString("func \(f.Name) \(strings.Join(ws, ","))\n")
	}
	io.Stdout.Print(b.String())
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}
