let execrtPath = "ergo.local/native/execrt"

func parseStdCfgMap(stdCfg string) Map[string, string] {
	let mut m = Map[string, string]{}
	for line in strings.Split(stdCfg, "\n") {
		let l = strings.TrimSpace(line)
		if !strings.HasPrefix(l, "packagefile ") {
			continue
		}
		let rest = l[12:l.Len()]
		let eq = strings.Index(rest, "=")
		if eq <= 0 {
			continue
		}
		m = m.Put(rest[0:eq], rest[eq+1:rest.Len()])
	}
	m
}

func stockExportAt(exports Map[string, string], pkgPath string) nativeobj.ExportInfo fails os.Exit needs fs.Files {
	let archivePath = match exports.Get(pkgPath) {
	case option.Some as p:
		p.Value
	case option.None:
		return fail("missing std export for \(pkgPath)")
	}
	let raw = try read(archivePath)
	nativeobj.ReadStockExport(raw) catch {
	case nativeobj.Bad as b:
		return fail("\(pkgPath) stock export: " + b.Why)
	}
}

func ePos(line int) ir.Pos {
	ir.Pos{File: 0, Line: uint32(line), Col: 1}
}

