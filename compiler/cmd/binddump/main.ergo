// binddump collects one package with compiler/check/bind and prints its
// package-level declarations, one per line, unsorted:
//
//	binddump FILE...          "FILE OFFSET KIND NAME" per declaration
//	binddump -uses FILE...    "FILE OFFSET -> FILE OFFSET" or "-> outside NAME" per use
//	binddump -locals FILE...  the declarations, then "FILE OFFSET local|law NAME" per Def
//	binddump -names FILE...   "FILE OFFSET ID NAME" per local: its name's id and text
//
// -threads N (first) binds the bodies as up to N tasks at once (default 1).
//
// It is the Ergo side of S3b's collect agreement; godefs (run-dir probe)
// prints the Go checker's.

import compiler/check/bind
import compiler/check/store
import compiler/syntax
import dense
import fs
import io
import os
import strings

func base(path string) string {
	let i = strings.LastIndex(path, "/")
	if i < 0 { path } else { path[i+1 : len(path)] }
}

func run(args []string) fails os.Exit needs fs.Files | io.Stdout {
	let mut files = []bind.File{}
	let mut threads = 1
	let mut rest = args
	if len(rest) > 1 && rest[0] == "-threads" {
		threads = 0
		for i in 0..len(rest[1]) {
			threads = threads*10 + int(rest[1][i]) - 48
		}
		if threads < 1 {
			return os.Exit{Code: 2, Message: "binddump: -threads takes a count of 1 or more"}
		}
		rest = rest[2:len(rest)]
	}
	let uses = len(rest) > 0 && rest[0] == "-uses"
	let locals = len(rest) > 0 && rest[0] == "-locals"
	let names = len(rest) > 0 && rest[0] == "-names"
	let paths = if uses || locals || names { rest[1:len(rest)] } else { rest }
	for path in paths {
		let src = fs.Files.ReadFile(path) catch {
		case fs.NotFound:
			return os.Exit{Code: 1, Message: "binddump: no file \(path)"}
		case fs.Denied:
			return os.Exit{Code: 1, Message: "binddump: cannot read \(path)"}
		case fs.Failed as e:
			return os.Exit{Code: 1, Message: "binddump: cannot read \(path): \(e.Reason)"}
		}
		files = files.Append(bind.File{Name: base(path), Parsed: syntax.Parse(src)})
	}
	let s = bind.Collect("main", files)
	let mut b = strings.NewBuilder()
	if names {
		let ps = bind.BuildParents(files)
		let (bound, u) = bind.Bind(s, ps, files, threads)
		for f, file in files {
			let p = file.Parsed
			if p.Failed {
				continue
			}
			for i in 0..syntax.NumNodes(p.Tree) {
				let id = syntax.NodeAt(p.Tree, i)
				match bind.LocalName(u, bind.PNodeOf(ps, f, id)) {
				case Some[dense.ID[dense.Str]] as n:
					b.WriteString("\(file.Name) \(syntax.NodePos(p, id)) \(dense.Index(n.Value)) \(store.Text(bound, n.Value))\n")
				case None:
				}
			}
		}
		io.Stdout.Print(b.String())
		return
	}
	if uses {
		let ps = bind.BuildParents(files)
		let (_, u) = bind.Bind(s, ps, files, threads)
		for f, file in files {
			let p = file.Parsed
			if p.Failed {
				continue
			}
			for i in 0..syntax.NumNodes(p.Tree) {
				let id = syntax.NodeAt(p.Tree, i)
				let at = syntax.NodePos(p, id)
				match bind.ResolutionOf(u, ps, bind.PNodeOf(ps, f, id)) {
				case bind.NotUse:
				case bind.Outside:
					b.WriteString("\(file.Name) \(at) -> outside \(syntax.TokText(p, syntax.TokStartingAt(p, at)))\n")
				case bind.Declared as d:
					let (df, dn) = bind.RowOf(ps, d.At)
					let dp = files[df].Parsed
					b.WriteString("\(file.Name) \(at) -> \(files[df].Name) \(syntax.NodePos(dp, syntax.NodeAt(dp.Tree, dn)))\n")
				}
			}
		}
		io.Stdout.Print(b.String())
		return
	}
	if locals {
		let ps = bind.BuildParents(files)
		let (_, u) = bind.Bind(s, ps, files, threads)
		for f, file in files {
			let p = file.Parsed
			if p.Failed {
				continue
			}
			for i in 0..syntax.NumNodes(p.Tree) {
				let id = syntax.NodeAt(p.Tree, i)
				let kind = match bind.DefOf(u, bind.PNodeOf(ps, f, id)) {
				case bind.NoDef:
					""
				case bind.Local:
					"local"
				case bind.Law:
					"law"
				}
				if kind != "" {
					let at = syntax.NodePos(p, id)
					b.WriteString("\(file.Name) \(at) \(kind) \(syntax.TokText(p, syntax.TokStartingAt(p, at)))\n")
				}
			}
		}
	}
	for d in store.Decls(s) {
		if store.KindName(int(d.Kind)) == "pkg" {
			continue
		}
		let p = files[int(d.File)].Parsed
		let at = syntax.NodePos(p, syntax.NodeAt(p.Tree, int(d.Node)))
		b.WriteString("\(files[int(d.File)].Name) \(at) \(store.KindName(int(d.Kind))) \(store.Text(s, d.Name))\n")
	}
	io.Stdout.Print(b.String())
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}
