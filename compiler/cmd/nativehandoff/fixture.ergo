import compiler/ir
import compiler/ir/handoff
import slices
import strconv
import strings

type ExportData { Fingerprint string, HasInit bool }

type ArchiveBad { Why string }

func readArchiveExport(ar string) ExportData fails ArchiveBad {
	if !strings.HasPrefix(ar, "!<arch>\n") {
		return ArchiveBad{Why: "missing ar magic"}
	}
	let mut at = 8
	for at+60 <= len(ar) {
		let name = strings.TrimSpace(ar[at : at+16])
		let sizeStr = strings.TrimSpace(ar[at+48 : at+58])
		let size = strconv.Atoi(sizeStr) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return ArchiveBad{Why: "bad ar member size"}
		}
		let start = at + 60
		let end = start + size
		if end > len(ar) {
			return ArchiveBad{Why: "truncated ar member"}
		}
		if name == "__.PKGDEF" || name == "__.PKGDEF/" {
			let body = ar[start:end]
			let marker = "\n$$\n"
			let idx = strings.LastIndex(body, marker)
			if idx < 8 {
				return ArchiveBad{Why: "missing export $$ marker"}
			}
			let fp = body[idx-8 : idx]
			return ExportData{Fingerprint: fp, HasInit: true}
		}
		at = end
		if at%2 == 1 {
			at = at + 1
		}
	}
	ArchiveBad{Why: "missing __.PKGDEF member"}
}

func colsPack(width int, rows [][]uint32) []uint32 {
	let mut out = []uint32{}
	for c in 0..width {
		for row in rows {
			out = out.Append(row[c])
		}
	}
	out
}

func le32(s string, off int) uint32 {
	let b0 = uint32(s[off])
	let b1 = uint32(s[off+1])
	let b2 = uint32(s[off+2])
	let b3 = uint32(s[off+3])
	b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

func seedConstants(seed int) (uint32, uint32) {
	let s = uint32(seed)
	let k1 = uint32(101) + (s*uint32(37))%uint32(997)
	let k2 = uint32(257) + (s*uint32(73))%uint32(991)
	(k1, k2)
}

func buildTinyEIR(seed int, goos string, goarch string, pin string, depFP string) handoff.Image fails handoff.Malformed {
	let (k1, k2) = seedConstants(seed)
	let names = slices.Sort([]string{
		"Bump", "Compute", "Gen", "Pair", "Pair.A", "Pair.B", "Record",
		"RoundTripPair", "State", "a/dep", "d.GenInt", "d.GenPair", "dep",
		goarch, goos, "init.0", "init.1", "init0", "init1", "main.ergo",
		pin, "plain", "tiny", "z/tiny",
	})
	let mut uniq = []string{}
	for n in names {
		if len(uniq) == 0 || uniq[len(uniq)-1] != n {
			uniq = uniq.Append(n)
		}
	}
	let nameID = func(want string) uint32 {
		for i, n in uniq {
			if n == want {
				return uint32(i + 1)
			}
		}
		uint32(0)
	}
	let mut ends = []uint32{}
	let mut off = uint32(0)
	for n in uniq {
		off = off + uint32(len(n))
		ends = ends.Append(off)
	}

	let symBump = uint32(1)
	let symCompute = uint32(2)
	let symPair = uint32(3)
	let symPairA = uint32(4)
	let symPairB = uint32(5)
	let symRoundTripPair = uint32(6)
	let symState = uint32(7)
	let symDictInt = uint32(8)
	let symDictPair = uint32(9)
	let symInit0 = uint32(10)
	let symInit1 = uint32(11)
	let symDepGen = uint32(12)
	let symDepRecord = uint32(13)

	let tInt = uint32(1)
	let tStr = uint32(2)
	let tAny = uint32(3)
	let tSigVoid = uint32(4)
	let tSigRecord = uint32(5)
	let tSigIntToInt = uint32(6)
	let tSigCompute = uint32(7)
	let tRecordPair = uint32(8)
	let tNamedPair = uint32(9)
	let tSigPairToPair = uint32(10)
	let tParamGen = uint32(11)
	let tSigGenPoly = uint32(12)
	let tGenFunc = uint32(13)

	let mut operands = []uint32{}
	let pushOps = func(xs []uint32) (uint32, uint32) {
		let lo = uint32(len(operands))
		for x in xs {
			operands = operands.Append(x)
		}
		(lo, uint32(len(xs)))
	}

	let mut typeRows = [][]uint32{}
	typeRows = typeRows.Append([]uint32{ir.HTBasic, ir.HBasicInt, 0, 0})
	typeRows = typeRows.Append([]uint32{ir.HTBasic, uint32(17), 0, 0})
	typeRows = typeRows.Append([]uint32{ir.HTBasic, ir.HBasicAny, 0, 0})
	let (loVoid, nVoid) = pushOps([]uint32{})
	typeRows = typeRows.Append([]uint32{ir.HTSignature, 0, loVoid, nVoid})
	let (loRec, nRec) = pushOps([]uint32{tStr})
	typeRows = typeRows.Append([]uint32{ir.HTSignature, 1, loRec, nRec})
	let (loI2I, nI2I) = pushOps([]uint32{tInt, tInt})
	typeRows = typeRows.Append([]uint32{ir.HTSignature, 1, loI2I, nI2I})
	let (loComp, nComp) = pushOps([]uint32{tInt, tSigIntToInt, tInt})
	typeRows = typeRows.Append([]uint32{ir.HTSignature, 2, loComp, nComp})
	let (loPairRec, nPairRec) = pushOps([]uint32{symPairA, symPairB})
	typeRows = typeRows.Append([]uint32{ir.HTRecord, 0, loPairRec, nPairRec})
	let (loNamedPair, nNamedPair) = pushOps([]uint32{tRecordPair})
	typeRows = typeRows.Append([]uint32{ir.HTNamed, symPair, loNamedPair, nNamedPair})
	let (loP2P, nP2P) = pushOps([]uint32{tNamedPair, tNamedPair})
	typeRows = typeRows.Append([]uint32{ir.HTSignature, 1, loP2P, nP2P})
	let (loParam, nParam) = pushOps([]uint32{tAny})
	typeRows = typeRows.Append([]uint32{ir.HTParameter, symDepGen, loParam, nParam})
	let (loGenSig, nGenSig) = pushOps([]uint32{tParamGen, tParamGen})
	typeRows = typeRows.Append([]uint32{ir.HTSignature, 1, loGenSig, nGenSig})
	let (loGen, nGen) = pushOps([]uint32{tParamGen})
	typeRows = typeRows.Append([]uint32{ir.HTGeneric, tSigGenPoly, loGen, nGen})

	let symRows = [][]uint32{
		[]uint32{0, nameID("Bump"), ir.HSFunc, tSigIntToInt, 3},
		[]uint32{0, nameID("Compute"), ir.HSFunc, tSigCompute, 1},
		[]uint32{0, nameID("Pair"), ir.HSType, tNamedPair, 1},
		[]uint32{0, nameID("Pair.A"), ir.HSField, tInt, 1},
		[]uint32{0, nameID("Pair.B"), ir.HSField, tInt, 1},
		[]uint32{0, nameID("RoundTripPair"), ir.HSFunc, tSigPairToPair, 2},
		[]uint32{0, nameID("State"), ir.HSVar, tInt, 1},
		[]uint32{0, nameID("d.GenInt"), ir.HSDictionary, tSigIntToInt, 1},
		[]uint32{0, nameID("d.GenPair"), ir.HSDictionary, tSigPairToPair, 2},
		[]uint32{0, nameID("init.0"), ir.HSFunc, tSigVoid, 4},
		[]uint32{0, nameID("init.1"), ir.HSFunc, tSigVoid, 3},
		[]uint32{1, nameID("Gen"), ir.HSFunc, tGenFunc, 0},
		[]uint32{1, nameID("Record"), ir.HSFunc, tSigRecord, 0},
	}

	let mut slots = []uint32{}
	let mut opRows = [][]uint32{}
	let mut bodyRows = [][]uint32{}

	let addOp = func(code uint32, span uint32, args []uint32) {
		let (lo, n) = pushOps(args)
		opRows = opRows.Append([]uint32{code, span, lo, n})
	}
	let startBody = func(funcSym uint32, bodySlots []uint32) (uint32, uint32, uint32, uint32) {
		let sl0 = uint32(len(slots))
		for s in bodySlots {
			slots = slots.Append(s)
		}
		(funcSym, sl0, uint32(len(bodySlots)), uint32(len(opRows)))
	}
	let finishBody = func(hdr (uint32, uint32, uint32, uint32)) {
		let (fs, sl0, nsl, op0) = hdr
		bodyRows = bodyRows.Append([]uint32{fs, sl0, nsl, op0, uint32(len(opRows)) - op0})
	}

	let bBump = startBody(symBump, []uint32{tInt, tInt, tInt})
	addOp(ir.HOConst, 3, []uint32{2, k1, 0})
	addOp(ir.HOAdd, 3, []uint32{3, 1, 2})
	addOp(ir.HOReturn, 3, []uint32{3})
	finishBody(bBump)

	let bComp = startBody(symCompute, []uint32{tInt, tSigIntToInt, tInt, tInt, tInt, tInt, tInt, tInt})
	addOp(ir.HOCallInstance, 1, []uint32{1, 1, 3, 1})
	addOp(ir.HOCallClosure, 2, []uint32{2, 1, 4, 3})
	addOp(ir.HOGetGlobal, 1, []uint32{5, symState})
	addOp(ir.HOConst, 1, []uint32{6, k2, 0})
	addOp(ir.HOAdd, 2, []uint32{7, 4, 5})
	addOp(ir.HOXor, 2, []uint32{7, 7, 6})
	addOp(ir.HOConst, 2, []uint32{8, 0, 0})
	addOp(ir.HOBranch, 2, []uint32{ir.HCLess, 7, 8, 9, 10})
	addOp(ir.HOAdd, 2, []uint32{7, 7, 6})
	addOp(ir.HOSetGlobal, 2, []uint32{symState, 7})
	addOp(ir.HOReturn, 2, []uint32{7})
	finishBody(bComp)

	let bPair = startBody(symRoundTripPair, []uint32{tNamedPair, tNamedPair})
	addOp(ir.HOCallInstance, 2, []uint32{2, 1, 2, 1})
	addOp(ir.HOReturn, 2, []uint32{2})
	finishBody(bPair)

	let bInit0 = startBody(symInit0, []uint32{tStr, tInt, tInt, tInt})
	addOp(ir.HOConst, 4, []uint32{1, nameID("init0"), 0})
	addOp(ir.HOCall, 4, []uint32{symDepRecord, 0, 1})
	addOp(ir.HOGetGlobal, 4, []uint32{2, symState})
	addOp(ir.HOConst, 4, []uint32{3, 3, 0})
	addOp(ir.HOMul, 4, []uint32{2, 2, 3})
	addOp(ir.HOConst, 4, []uint32{4, 7, 0})
	addOp(ir.HOAdd, 4, []uint32{2, 2, 4})
	addOp(ir.HOSetGlobal, 4, []uint32{symState, 2})
	addOp(ir.HOReturn, 4, []uint32{})
	finishBody(bInit0)

	let bInit1 = startBody(symInit1, []uint32{tStr, tInt})
	addOp(ir.HOConst, 3, []uint32{1, nameID("init1"), 0})
	addOp(ir.HOCall, 3, []uint32{symDepRecord, 0, 1})
	addOp(ir.HOConst, 3, []uint32{2, 10, 0})
	addOp(ir.HOSetGlobal, 3, []uint32{symState, 2})
	addOp(ir.HOReturn, 3, []uint32{})
	finishBody(bInit1)

	let (loInstInt, nInstInt) = pushOps([]uint32{tInt})
	let (loInstPair, nInstPair) = pushOps([]uint32{tNamedPair})
	let instRows = [][]uint32{
		[]uint32{symDepGen, tSigIntToInt, symDictInt, loInstInt, nInstInt},
		[]uint32{symDepGen, tSigPairToPair, symDictPair, loInstPair, nInstPair},
	}

	let fpLo = le32(depFP, 0)
	let fpHi = le32(depFP, 4)
	let draft = handoff.Draft{
		Text:    strings.Join(uniq, ""),
		Columns: [][]uint32{
			[]uint32{nameID("z/tiny"), nameID("tiny"), nameID(goos), nameID(goarch), nameID(pin), nameID("plain")},
			ends,
			[]uint32{nameID("a/dep"), nameID("dep"), 1, fpLo, fpHi},
			[]uint32{nameID("main.ergo"), 200, 0, 5, 0x12345678, 0, 0, 0, 0, 0, 0, 0},
			[]uint32{0, 30, 60, 90, 120},
			colsPack(3, [][]uint32{
				[]uint32{1, 2, 10},
				[]uint32{1, 34, 42},
				[]uint32{1, 66, 74},
				[]uint32{1, 98, 106},
			}),
			colsPack(4, typeRows),
			colsPack(5, symRows),
			colsPack(5, bodyRows),
			slots,
			colsPack(4, opRows),
			colsPack(5, instRows),
			[]uint32{},
			[]uint32{symInit1, symInit0},
			operands,
		},
	}
	try handoff.Pack(draft)
}

func depGoSource() string {
	"package dep\n\nvar Trace string\n\nfunc init() { Trace = \"dep\" }\n\nfunc Record(s string) {\n\tif Trace != \"\" {\n\t\tTrace += \",\"\n\t}\n\tTrace += s\n}\n\nfunc Gen[T any](x T) T { return x }\n\nfunc ApplyTwice(x int, f func(int) int) int { return f(f(x)) }\n"
}

func refTinyGoSource(seed int) string {
	let (k1, k2) = seedConstants(seed)
	"package tiny\n\nimport \"a/dep\"\n\ntype Pair struct {\n\tA int\n\tB int\n}\n\nvar State int\n\nfunc init() {\n\tdep.Record(\"init1\")\n\tState = 10\n}\n\nfunc init() {\n\tdep.Record(\"init0\")\n\tState = State*3 + 7\n}\n\nfunc Bump(x int) int {\n\treturn x + \(k1)\n}\n\nfunc Compute(x int, cb func(int) int) int {\n\tg := dep.Gen[int](x)\n\tc := cb(g)\n\tsum := (c + State) ^ \(k2)\n\tif sum < 0 {\n\t\tsum = sum + \(k2)\n\t}\n\tState = sum\n\treturn sum\n}\n\nfunc RoundTripPair(p Pair) Pair {\n\treturn dep.Gen[Pair](p)\n}\n"
}

func mainGoSource(seed int) string {
	"package main\n\nimport (\n\t\"a/dep\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"z/tiny\"\n)\n\nfunc main() {\n\tseed := \(seed)\n\tmode := os.Args[1]\n\tfmt.Printf(\"trace=%s initState=%d\\n\", dep.Trace, tiny.State)\n\tcallerOK := false\n\tr := tiny.Compute(seed, func(v int) int {\n\t\t_, file, line, ok := runtime.Caller(1)\n\t\tbase := filepath.Base(file)\n\t\tif ok && ((mode == \"ergo\" && base == \"main.ergo\" && line == 2) || (mode == \"stock\" && base == \"tinyref.go\" && line > 1)) {\n\t\t\tcallerOK = true\n\t\t}\n\t\treturn v*2 + 5\n\t})\n\tfmt.Printf(\"compute=%d postState=%d callerOK=%v\\n\", r, tiny.State, callerOK)\n\tb := dep.ApplyTwice(seed, tiny.Bump)\n\tp := tiny.RoundTripPair(tiny.Pair{A: seed + 1, B: seed + 2})\n\tfmt.Printf(\"twice=%d pair=(%d,%d)\\n\", b, p.A, p.B)\n}\n"
}

test TinyFixtureRoundTrips {
	let fp = "\x01\x02\x03\x04\x05\x06\x07\x08"
	let img = try buildTinyEIR(17, "linux", "amd64", "go1.27.4", fp)
	let encoded = handoff.Encode(img)
	let dec = try handoff.Decode(encoded)
	assert handoff.Digest(dec) == handoff.Digest(img)
	assert handoff.Rows(dec, ir.HInit) == 2
	assert handoff.Rows(dec, ir.HInstances) == 2
}
