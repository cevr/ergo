import compiler/check/expr
import compiler/check/load
import compiler/check/store
import compiler/syntax
import option
import slices
import strings

// exactLoadedUnits indexes only unambiguous loaded units. Equal paths
// (even of equal file lists) do not prove equal declaration rows.
func exactLoadedUnits(p load.Program) Map[string, int] {
	let mut byPath = Map[string, int]{}
	for i, dep in p.Loaded {
		let at = if byPath.Get(dep.Path) == option.None { i } else { -1 }
		byPath = byPath.Put(dep.Path, at)
	}
	byPath
}

func exactLoadedUnit(exact Map[string, int], path string) int {
	match exact.Get(path) {
	case option.Some[int] as at:
		at.Value
	case option.None:
		-1
	}
}

// shapeLoadedUnits selects the very first loaded store, as load.TypeAt
// does, for repeated presentations of the same checked package. Prove
// they are repeats with the full ordered source inputs and both tables,
// not just a path or file list. Conflicting inputs prove no store.
func shapeLoadedUnits(p load.Program, units []load.Unit, inputs []InputTables) Map[string, int] {
	let mut byPath = Map[string, int]{}
	for i, dep in p.Loaded {
		match byPath.Get(dep.Path) {
		case option.Some[int] as first:
			if first.Value >= 0 && !sameShapeInputs(units, inputs, p.Units[first.Value], p.Units[i]) {
				byPath = byPath.Put(dep.Path, -1)
			}
		case option.None:
			byPath = byPath.Put(dep.Path, i)
		}
	}
	byPath
}

func sameShapeInputs(units []load.Unit, inputs []InputTables, a int, b int) bool {
	if inputs[a].Ext != inputs[b].Ext || inputs[a].Foreign != inputs[b].Foreign || !slices.Equal(units[a].Paths, units[b].Paths) {
		return false
	}
	for i, file in units[a].Files {
		if syntax.SourceOf(file.Parsed) != syntax.SourceOf(units[b].Files[i].Parsed) {
			return false
		}
	}
	true
}

// importUnits indexes the loaded stores by import path, preserving
// LoadAll's order. A corpus can list the same source package twice, but a
// path with two different source sets cannot prove a root's inventory.
func importUnits(p load.Program, units []load.Unit) Map[string, int] {
	let mut byPath = Map[string, int]{}
	for i, dep in p.Loaded {
		match byPath.Get(dep.Path) {
		case option.Some[int] as previous:
			if previous.Value >= 0 && !slices.Equal(units[p.Units[i]].Paths, units[p.Units[previous.Value]].Paths) {
				byPath = byPath.Put(dep.Path, -1)
			}
		case option.None:
			byPath = byPath.Put(dep.Path, i)
		}
	}
	byPath
}

func hasSources(dep expr.Dep) bool {
	if dep.K.Parsed.Len() == 0 {
		return false
	}
	for parsed in dep.K.Parsed {
		if parsed.Failed {
			return false
		}
	}
	true
}

// Program is the program a package is lowered with
// (lower.PackageInProgram): every other package of it and its root's
// import path, "" when the package is the root.
type Program { Imports option.Option[[]expr.Dep], Root string }

// StdProgram names the program the Go builder lowers std with: a root of
// no declarations that reaches every std body, std its only packages.
let StdProgram = "/ergo-std-program"

type rootClosure { at int, key string, closure option.Option[[]int] }

func loadedAt(available Map[string, int], path string) int {
	match available.Get(path) {
	case option.Some[int] as at:
		at.Value
	case option.None:
		-1
	}
}

func underStd(u load.Unit, std string) bool {
	std != "" && u.Paths.Len() > 0 && strings.HasPrefix(u.Paths[0], std+"/")
}

// rootClosures is each root's import closure, keyed in the order the Go
// builder's agreement corpus takes its programs: production roots before
// test builds, each by its folder.
func rootClosures(p load.Program, units []load.Unit, roots []string, tests []string, available Map[string, int]) []rootClosure {
	let mut out = []rootClosure{}
	for i in 0..p.Loaded.Len() {
		let path = p.Loaded[i].Path
		if !slices.Contains(roots, path) {
			continue
		}
		let u = units[p.Units[i]]
		let rank = if slices.Contains(tests, path) { "1" } else { "0" }
		let first = if u.Paths.Len() > 0 { u.Paths[0] } else { "" }
		out = out.Append(rootClosure{at: i, key: rank + first, closure: closureOf(p, i, available)})
	}
	out
}

// programOf is the program a non-root unit is lowered with: a std unit
// with the rest of std (StdProgram), any other with the first root whose
// closure holds it, its root among its imports. A unit no root reaches,
// or a std unit beside an unproved std package, has none.
func programOf(p load.Program, units []load.Unit, at int, std string, closures []rootClosure, available Map[string, int]) Program {
	let path = p.Loaded[at].Path
	if underStd(units[p.Units[at]], std) {
		let mut deps = []expr.Dep{}
		for i in 0..p.Loaded.Len() {
			let other = p.Loaded[i].Path
			if i == at || other == path || !underStd(units[p.Units[i]], std) {
				continue
			}
			if loadedAt(available, other) != i || !hasSources(p.Loaded[i]) {
				return Program{Imports: option.None, Root: ""}
			}
			deps = deps.Append(p.Loaded[i])
		}
		return Program{Imports: option.Some[[]expr.Dep]{Value: deps}, Root: StdProgram}
	}
	if loadedAt(available, path) != at {
		return Program{Imports: option.None, Root: ""}
	}
	let mut best = -1
	for j, c in closures {
		match c.closure {
		case option.Some[[]int] as ats:
			if slices.Contains(ats.Value, at) && (best < 0 || c.key < closures[best].key) {
				best = j
			}
		case option.None:
		}
	}
	if best < 0 {
		return Program{Imports: option.None, Root: ""}
	}
	let c = closures[best]
	let mut deps = []expr.Dep{p.Loaded[c.at]}
	match c.closure {
	case option.Some[[]int] as ats:
		for i in ats.Value {
			if p.Loaded[i].Path != path {
				deps = deps.Append(p.Loaded[i])
			}
		}
	case option.None:
	}
	Program{Imports: option.Some[[]expr.Dep]{Value: deps}, Root: p.Loaded[c.at].Path}
}

// shapeImports is the declaration inventory of a unit, including a
// non-root. Follow exact loaded edges only: a missing, ambiguous or
// unparsed unit proves neither its own declarations nor its imports.
// An unavailable edge does not invalidate the other reachable stores.
func shapeImports(p load.Program, unit int, exact Map[string, int]) Map[string, expr.Dep] {
	let source = p.Loaded[unit]
	let mut deps = Map[string, expr.Dep]{}
	if !hasSources(source) {
		return deps
	}
	let mut paths = store.ImportPaths(source.S)
	if source.Path != "prelude" {
		paths = paths.Append("prelude")
	}
	let mut i = 0
	for i < paths.Len() {
		let path = paths[i]
		i = i + 1
		if path == source.Path || deps.Get(path) != option.None {
			continue
		}
		let at = exactLoadedUnit(exact, path)
		if at < 0 || !hasSources(p.Loaded[at]) {
			continue
		}
		let dep = p.Loaded[at]
		deps = deps.Put(dep.Path, dep)
		for imported in store.ImportPaths(dep.S) {
			paths = paths.Append(imported)
		}
	}
	deps
}

// rootImports is the root's read-only import closure. ImportPaths is
// sorted and LoadAll rejoins in input order, so neither the closure's
// contents nor its order depend on task width. An interface without
// sources cannot certify that the package has no private declarations.
func rootImports(p load.Program, root int, available Map[string, int]) option.Option[[]expr.Dep] {
	match closureOf(p, root, available) {
	case option.Some[[]int] as ats:
		let mut deps = slices.WithCapacity[expr.Dep](ats.Value.Len())
		for i in ats.Value {
			deps = deps.Append(p.Loaded[i])
		}
		option.Some[[]expr.Dep]{Value: deps}
	case option.None:
		option.None
	}
}

// closureOf is rootImports by loaded index: the closure's packages, in
// its order, without a copy of their stores.
func closureOf(p load.Program, root int, available Map[string, int]) option.Option[[]int] {
	let first = p.Loaded[root]
	if !hasSources(first) {
		return option.None
	}
	let mut paths = []string{"prelude"}
	for path in store.ImportPaths(first.S) {
		paths = paths.Append(path)
	}
	let mut seen = Map[string, bool]{first.Path: true}
	let mut ats = []int{}
	let mut i = 0
	for i < paths.Len() {
		let path = paths[i]
		i = i + 1
		if seen.Get(path) != option.None {
			continue
		}
		seen = seen.Put(path, true)
		let at = loadedAt(available, path)
		if at < 0 || !hasSources(p.Loaded[at]) {
			return option.None
		}
		ats = ats.Append(at)
		for imported in store.ImportPaths(p.Loaded[at].S) {
			paths = paths.Append(imported)
		}
	}
	option.Some[[]int]{Value: ats}
}
