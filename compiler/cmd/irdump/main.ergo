// irdump builds the IR of each package of a corpus with compiler/lower
// (capstone S4) and prints, after each package's "@pkg I" line:
//
//	P INDEX PATH        the IR file's Files, in order
//	F PATH OFFSET JSON  a function lower built: its declaration's file and
//	                    offset, and its IR (ir.WriteFunc; positions index
//	                    the P lines)
//	S PATH OFFSET CAUSE a function lower stopped at, and why
//
//	irdump [-std DIR] -corpus MANIFEST
//
// The manifest and the typing are exprdump's (one package per line, "PATH
// EXT FOREIGN FILE..."; the packages bound in import waves and typed with
// their imports' loaded packages as deps). It is the Ergo side of
// internal/selfhostcheck's TestCompilerIRAgreesWithBuilder.

import compiler/check/bind
import compiler/check/expr
import compiler/check/load
import compiler/check/store
import compiler/check/task
import compiler/check/types
import compiler/ir
import compiler/lower
import compiler/syntax
import fs
import io
import os
import strconv
import strings

func base(path string) string {
	let i = strings.LastIndex(path, "/")
	if i < 0 { path } else { path[i+1 : len(path)] }
}

func bit(w string) int {
	if w == "type" { 1 } else if w == "errors" { 2 } else if w == "uses" { 4 } else { 8 }
}

func read(path string) string fails os.Exit needs fs.Files {
	fs.Files.ReadFile(path) catch {
	case fs.NotFound:
		return os.Exit{Code: 1, Message: "irdump: no file \(path)"}
	case fs.Denied:
		return os.Exit{Code: 1, Message: "irdump: cannot read \(path)"}
	case fs.Failed as e:
		return os.Exit{Code: 1, Message: "irdump: cannot read \(path): \(e.Reason)"}
	}
}

// Tables is what EXT and FOREIGN hold (typedump reads them alike).
type Tables { ext []types.Ext, foreign []types.Foreign, pkgName string, pkgPath string }

func tables(extText string, foreignText string) Tables {
	let mut ext = []types.Ext{}
	for line in strings.Split(extText, "\n") {
		let parts = strings.Fields(line)
		if len(parts) != 2 {
			continue
		}
		let mut ks = []int{}
		for w in strings.Split(parts[1], ",") {
			ks = ks.Append(bit(w))
		}
		ext = ext.Append(types.Ext{Head: parts[0], Kinds: ks})
	}
	let mut foreign = []types.Foreign{}
	let mut pkgName = "main"
	let mut pkgPath = "main"
	for line in strings.Split(foreignText, "\n") {
		let parts = strings.Fields(line)
		if len(parts) == 4 && parts[0] == "@pkg" {
			pkgName = if parts[3] == "1" { parts[1] } else { "" }
			pkgPath = parts[2]
			continue
		}
		if len(parts) != 6 {
			continue
		}
		let n = strconv.Atoi(parts[2]) catch {
		case _:
			0
		}
		foreign = foreign.Append(types.Foreign{Qual: parts[0], Name: parts[1], Arity: n, Path: parts[3], Print: strings.ReplaceAll(parts[4], "^", " "), Key: parts[5], Variants: []int{}})
	}
	Tables{ext: ext, foreign: types.WithUnions(foreign, foreignText), pkgName: pkgName, pkgPath: pkgPath}
}

func parseAll(paths []string) []bind.File fails os.Exit needs fs.Files {
	let mut files = []bind.File{}
	for path in paths {
		files = files.Append(bind.File{Name: base(path), Parsed: syntax.Parse(try read(path))})
	}
	files
}

// Unit is one package of the run: its tables, files, import path and
// folder.
type Unit { tab Tables, files []bind.File, paths []string, path string, dir string }

func unitOf(g []string) Unit fails os.Exit needs fs.Files {
	if len(g) < 2 {
		return os.Exit{Code: 2, Message: "irdump: a package needs EXT FOREIGN FILE..."}
	}
	let tab = tables(try read(g[0]), try read(g[1]))
	Unit{tab: tab, files: try parseAll(g[2:len(g)]), paths: g[2:len(g)], path: tab.pkgPath, dir: if len(g) > 2 { load.Dir(g[2]) } else { "." }}
}

// Typed is one package typed: its store, what Load made of it and the
// typer's result.
type Typed { s store.Store, k expr.Pkg, t expr.Typer }

func isSome[T](o Option[T]) bool {
	match o {
	case Some[T]:
		true
	case None:
		false
	}
}

// outside is the interfaces of the packages the units import and do not
// hold, loaded from std, transitively: each unit's, against its tables.
func outside(units []Unit, std string) []types.Iface needs fs.Files {
	let mut held = []string{}
	for u in units {
		held = held.Append(u.path)
	}
	let mut have = []types.Iface{}
	for u in units {
		let pkgs = load.Imported(bind.Imports(u.files), held, load.ModuleOf(u.dir), std)
		for p in pkgs {
			held = held.Append(p.Path)
		}
		have = load.Interfaces(pkgs, u.tab.ext, u.tab.foreign, have)
	}
	have
}

// typeAll binds the units as package tasks in import waves (check/task:
// each binds against its imports' frozen stores), loads each once, its
// imports' interfaces (types.Iface) done first (those of have, the
// imports outside the run), then types each with its imports' loaded
// packages as its deps (S3d3, S3d12), and writes each typed package's
// lines as it is typed: a package typed is dropped before the next, so
// the run holds one package's typing at a time.
func typeAll(b mut strings.Builder, units []Unit, have0 []types.Iface) {
	let mut pkgs = []task.Package{}
	for u in units {
		pkgs = pkgs.Append(task.Package{Path: u.path, Files: u.files})
	}
	let checked = task.Check(pkgs, 4)
	let mut stores = []store.Store{}
	let mut have = have0
	let mut done = []bool{}
	let mut ks = []Option[expr.Pkg]{}
	for i, c in checked {
		// Its importers reach it by its path; its own types are named
		// by the path its tables give (main for a checked root).
		let mut s = store.Of(c.Store)
		store.SetPath(&s, units[i].tab.pkgPath)
		stores = stores.Append(s)
		done = done.Append(false)
		ks = ks.Append(None)
	}
	// A pass loads the units whose imports in the program are all
	// loaded; when none is ready (an import cycle), the first one left
	// loads against what is done.
	let mut left = len(units)
	for left > 0 {
		let mut progress = false
		for pass in 0..2 {
			if progress {
				break
			}
			for i, c in checked {
				if isSome(ks[i]) || (pass == 1 && progress) {
					continue
				}
				let mut ready = true
				for path in store.ImportPaths(stores[i]) {
					for j, u in units {
						if u.path == path && j != i && !done[j] {
							ready = false
						}
					}
				}
				if pass == 0 && !ready {
					continue
				}
				let deps = load.Deps(stores[i], have)
				let mut s = stores[i]
				let k = expr.Load(&s, units[i].files, c.Uses, c.Parents, units[i].tab.ext, units[i].tab.foreign, deps, units[i].tab.pkgName == "")
				// Its importers read it by its import path, which its
				// types print with (a checked root's own path is main).
				let mut at = s
				store.SetPath(&at, units[i].path)
				have = have.Append(types.Interface(at, k.Parsed, k.Kinds, k.Ext, units[i].tab.foreign, deps))
				done[i] = true
				stores[i] = s
				ks[i] = Some[expr.Pkg]{Value: k}
				left = left - 1
				progress = true
			}
		}
	}
	let mut loaded = []expr.Dep{}
	let mut unitOfLoaded = []int{}
	for i, c in checked {
		match ks[i] {
		case Some[expr.Pkg] as k:
			loaded = loaded.Append(expr.Dep{Path: c.Path, S: stores[i], K: k.Value})
			unitOfLoaded = unitOfLoaded.Append(i)
		case None:
		}
	}
	for li, d in loaded {
		// The prelude is every package's: its Append, Get, Put and Delete
		// are functions on slices and Maps (types.md, Methods 7).
		let mut deps = []expr.Dep{}
		for e in loaded {
			if e.Path == "prelude" && d.Path != "prelude" {
				deps = deps.Append(e)
				break
			}
		}
		for path in store.ImportPaths(d.S) {
			for e in loaded {
				if e.Path == path {
					deps = deps.Append(e)
					break
				}
			}
		}
		let mut s = d.S
		let k = expr.WithDeps(d.K, deps)
		let t = expr.Check(&s, k)
		let ui = unitOfLoaded[li]
		b.WriteString("@pkg \(ui)\n")
		write(b, units[ui], Typed{s: s, k: k, t: t})
	}
}

// write prints one typed package's IR lines after its "@pkg I" line.
func write(b mut strings.Builder, u Unit, d Typed) {
	let out = lower.Package(d.s, d.k, d.t, u.paths)
	for i, path in out.File.Files {
		b.WriteString("P \(i) \(path)\n")
	}
	for i, site in out.Sites {
		let text = ir.WriteFunc(out.File, i) catch {
		case ir.Malformed as m:
			"malformed: " + m.Why
		}
		b.WriteString("F \(u.paths[site.File]) \(site.At) \(text)\n")
	}
	for s in out.Stops {
		b.WriteString("S \(u.paths[s.File]) \(s.At) \(s.Cause)\n")
	}
}

func run(argv0 []string) fails os.Exit needs fs.Files | io.Stdout {
	let mut b = strings.NewBuilder()
	let mut std = ""
	let mut argv = argv0
	if len(argv) > 1 && argv[0] == "-std" {
		std = argv[1]
		argv = argv[2:len(argv)]
	}
	if len(argv) != 2 || argv[0] != "-corpus" {
		return os.Exit{Code: 2, Message: "usage: irdump [-std DIR] -corpus MANIFEST"}
	}
	let mut units = []Unit{}
	for line in strings.Split(try read(argv[1]), "\n") {
		let g = strings.Fields(line)
		if len(g) > 0 {
			let mut u = try unitOf(g[1:len(g)])
			u.path = g[0]
			units = units.Append(u)
		}
	}
	typeAll(&b, units, outside(units, std))
	io.Stdout.Print(b.String())
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}
