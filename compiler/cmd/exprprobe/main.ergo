// exprprobe is the self-hosted side of the checker's floor probe
// (scripts/checkfloor; capstone S3d4): `exprprobe N MODE` writes a
// package of N functions of one shape (checkfloor's shape, byte for
// byte), then by MODE stops after writing it (gen), parsing it (parse),
// binding and loading it (setup), or typing every body (check). It prints
// `fns=F typed=E` (check), or what it reached. `check-bad` checks the
// package with a type error in its last function (q != 1, checkfloor's
// bad package): a package with a type error prints its count and exits 1.

import compiler/check/bind
import compiler/check/expr
import compiler/check/store
import compiler/check/types
import compiler/syntax
import io
import os
import strings

// source is the package of n shaped functions; bad, the last one compares
// its string parameter with an int.
func source(n int, bad bool) string {
	let mut b = strings.NewBuilder()
	b.WriteString("func id[T](x T) T { x }\n")
	for i in 0..n {
		let cmp = if bad && i == n-1 { "1" } else { "\"x\"" }
		b.WriteString("\nfunc f\(i)(p int, q string, xs []int) int {\n\tlet mut acc = p + 1\n\tlet a = id(p)\n\tlet c = xs[0] * 2\n\tfor j, e in xs {\n\t\tacc = acc + e - j\n\t}\n\tif acc > 3 && q != \(cmp) {\n\t\tacc = acc + len(q)\n\t}\n\tacc + a + c\n}\n")
	}
	b.String()
}

func run(args []string) fails os.Exit needs io.Stdout {
	if len(args) != 2 {
		return os.Exit{Code: 2, Message: "usage: exprprobe N gen|parse|setup|check|check-bad"}
	}
	let mut n = 0
	let w = args[0]
	for i in 0..len(w) {
		n = n*10 + int(w[i]) - 48
	}
	let mode = args[1]
	let src = source(n, mode == "check-bad")
	if mode == "gen" {
		io.Stdout.Println("bytes=\(len(src))")
		return
	}
	let p = syntax.Parse(src)
	if mode == "parse" {
		io.Stdout.Println("nodes=\(syntax.NumNodes(p.Tree))")
		return
	}
	let files = []bind.File{bind.File{Name: "p.ergo", Parsed: p}}
	let ps = bind.BuildParents(files)
	let (bound, u) = bind.Bind(bind.Collect("p", files), []store.Frozen{}, ps, files, 1)
	let mut s = bound
	let k = expr.Load(&s, files, u, ps, []types.Ext{}, []types.Foreign{}, false)
	if mode == "setup" {
		io.Stdout.Println("fns=\(len(k.Fns))")
		return
	}
	let t = expr.Check(&s, k)
	let bad = len(expr.Diags(t))
	if bad > 0 {
		return os.Exit{Code: 1, Message: "rejected: \(bad) type errors"}
	}
	io.Stdout.Println("fns=\(len(k.Fns)) typed=\(len(t.Entries))")
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}
