import compiler/cachekey
import slices
import strconv

// FileDigest pairs a normalized package-relative source path with its content digest.
type FileDigest {
	Path          string,
	ContentDigest string,
}

// ActionInput describes all inputs that invalidate a package check or build action key.
type ActionInput {
	Compiler    string,
	Target      string,
	PkgPath     string,
	Files       []FileDigest,
	DepKeys     []string,
	Flags       []string,
	Environ     []string,
	Experiments []string,
}

// CacheKeys holds computed action, warm-answer, and directory listing digests for a unit.
type CacheKeys {
	PackageKey string,
	WarmKey    string,
	ListingKey string,
}

// PackageActionKey computes a deterministic build/check action key using compiler/cachekey.
func PackageActionKey(input ActionInput) string {
	let sortedFiles = sortFileDigests(input.Files)
	let mut fileParts = []string{}
	for fd in sortedFiles {
		fileParts = fileParts.Append(cachekey.Framed([]string{fd.Path, fd.ContentDigest}))
	}
	let sortedDeps = slices.Sort(input.DepKeys)
	let sortedFlags = slices.Sort(input.Flags)
	let sortedExps = slices.Sort(input.Experiments)
	let filteredEnv = cachekey.Environ(input.Environ, "")
	let fields = []cachekey.Field{
		cachekey.Field{Name: "compiler", Value: input.Compiler},
		cachekey.Field{Name: "target", Value: input.Target},
		cachekey.Field{Name: "pkg", Value: input.PkgPath},
		cachekey.Field{Name: "files", Value: cachekey.Framed(fileParts)},
		cachekey.Field{Name: "deps", Value: cachekey.Framed(sortedDeps)},
		cachekey.Field{Name: "flags", Value: cachekey.Framed(sortedFlags)},
		cachekey.Field{Name: "env", Value: cachekey.Framed(filteredEnv)},
		cachekey.Field{Name: "exp", Value: cachekey.Framed(sortedExps)},
	}
	cachekey.BuildID(cachekey.Fields(fields), sortedDeps.Len()+sortedFiles.Len()+1)
}

func sortFileDigests(xs []FileDigest) []FileDigest {
	slices.SortFunc(xs, func(a FileDigest, b FileDigest) int {
		if a.Path < b.Path {
			return -1
		}
		if a.Path > b.Path {
			return 1
		}
		if a.ContentDigest < b.ContentDigest {
			return -1
		}
		if a.ContentDigest > b.ContentDigest {
			return 1
		}
		0
	})
}

// WorkspaceWarmKey computes the workspace warm-answer cache key via cachekey.WarmKey.
func WorkspaceWarmKey(compiler string, parts []string, environ []string, experiments []string) string {
	cachekey.WarmKey(compiler, parts, environ, experiments)
}

// DirListingDigest summarizes directory entry names and directory flags via cachekey.ListingDigest.
func DirListingDigest(names []string, isDir []bool) string {
	let n = names.Len()
	let mut entries = []cachekey.Entry{}
	for i in 0..n {
		let mode = if i < isDir.Len() && isDir[i] { 1 } else { 0 }
		entries = entries.Append(cachekey.Entry{Name: names[i], Type: mode})
	}
	cachekey.ListingDigest(entries)
}

// ActionKeysForPackage combines action key, warm key, and directory listing digest for one package unit.
func ActionKeysForPackage(input ActionInput, dirNames []string, isDir []bool) CacheKeys {
	let pkgKey = PackageActionKey(input)
	let listing = DirListingDigest(dirNames, isDir)
	let warm = WorkspaceWarmKey(input.Compiler, []string{input.PkgPath, pkgKey, listing, strconv.Itoa(input.Files.Len())}, input.Environ, input.Experiments)
	CacheKeys{
		PackageKey: pkgKey,
		WarmKey:    warm,
		ListingKey: listing,
	}
}

// ActionKeySensitiveToFileEdit: changing any file content digest changes PackageActionKey.
law ActionKeySensitiveToFileEdit(a string, b string) {
	if a == b {
		return true
	}
	let inA = ActionInput{
		Compiler:    "ergo 1",
		Target:      "native",
		PkgPath:     "app/main",
		Files:       []FileDigest{FileDigest{Path: "main.ergo", ContentDigest: a}},
		DepKeys:     []string{},
		Flags:       []string{},
		Environ:     []string{},
		Experiments: []string{},
	}
	let inB = ActionInput{
		Compiler:    "ergo 1",
		Target:      "native",
		PkgPath:     "app/main",
		Files:       []FileDigest{FileDigest{Path: "main.ergo", ContentDigest: b}},
		DepKeys:     []string{},
		Flags:       []string{},
		Environ:     []string{},
		Experiments: []string{},
	}
	PackageActionKey(inA) != PackageActionKey(inB)
}

// ActionKeyIgnoresFileInputOrder: PackageActionKey produces identical keys regardless of file slice order.
law ActionKeyIgnoresFileInputOrder(d1 string, d2 string) {
	let f1 = FileDigest{Path: "a.ergo", ContentDigest: d1}
	let f2 = FileDigest{Path: "b.ergo", ContentDigest: d2}
	let in1 = ActionInput{
		Compiler:    "ergo 1",
		Target:      "native",
		PkgPath:     "app/main",
		Files:       []FileDigest{f1, f2},
		DepKeys:     []string{"k2", "k1"},
		Flags:       []string{"--strict"},
		Environ:     []string{"CI=1"},
		Experiments: []string{},
	}
	let in2 = ActionInput{
		Compiler:    "ergo 1",
		Target:      "native",
		PkgPath:     "app/main",
		Files:       []FileDigest{f2, f1},
		DepKeys:     []string{"k1", "k2"},
		Flags:       []string{"--strict"},
		Environ:     []string{"CI=1"},
		Experiments: []string{},
	}
	PackageActionKey(in1) == PackageActionKey(in2)
}

test CacheKeyDeterminismAndWarmParity {
	let in1 = ActionInput{
		Compiler:    "ergo 1",
		Target:      "native",
		PkgPath:     "compiler/driver",
		Files:       []FileDigest{FileDigest{Path: "cache.ergo", ContentDigest: "h1"}},
		DepKeys:     []string{"dep0"},
		Flags:       []string{"--strict"},
		Environ:     []string{"HOME=/tmp", "ERGO_FALLBACK=off"},
		Experiments: []string{"s6"},
	}
	let keys = ActionKeysForPackage(in1, []string{"cache.ergo", "testdata"}, []bool{false, true})
	assert keys.PackageKey != ""
	assert keys.ListingKey == DirListingDigest([]string{"testdata", "cache.ergo"}, []bool{true, false})
	assert keys.WarmKey == cachekey.WarmKey("ergo 1", []string{"compiler/driver", keys.PackageKey, keys.ListingKey, "1"}, in1.Environ, in1.Experiments)
	let uncached = WorkspaceWarmKey("", []string{"part"}, []string{}, []string{})
	assert uncached == ""

	let ti = TestActionInput{
		Action:     in1,
		Seed:       uint64(42),
		States:     128,
		Filter:     "Parse",
		Skip:       "Slow",
		Law:        "",
		SkipLaw:    "",
		ShardIndex: 1,
		ShardTotal: 2,
	}
	let tk = TestActionKey(ti)
	assert tk != ""
	assert tk == TestActionKey(ti)
	assert tk != TestActionKey(TestActionInput{..ti, ShardIndex: 2})

	let bi = BuildActionInput{
		Action:   in1,
		Mode:     ModeLib,
		LibName:  "sample",
		Platform: "linux/amd64",
		Locked:   true,
		Debug:    false,
		Release:  true,
	}
	let bk = BuildActionKey(bi)
	assert bk != ""
	assert bk != BuildActionKey(BuildActionInput{..bi, Mode: ModeBuild})
}

// TargetMode selects which artifact a driver build or test action produces.
type TargetMode =
	| ModeBuild{}
	| ModeRun{}
	| ModeTest{}
	| ModeLib{}

// TargetModeLabel returns the canonical cache-key label for m.
func TargetModeLabel(m TargetMode) string {
	match m {
	case ModeBuild:
		"build"
	case ModeRun:
		"run"
	case ModeTest:
		"test"
	case ModeLib:
		"lib"
	}
}

// TestActionInput describes all inputs that determine a cached test execution key.
type TestActionInput {
	Action     ActionInput,
	Seed       uint64,
	States     int,
	Filter     string,
	Skip       string,
	Law        string,
	SkipLaw    string,
	ShardIndex int,
	ShardTotal int,
}

// BuildActionInput describes all inputs that determine a build, run, or library action key.
type BuildActionInput {
	Action   ActionInput,
	Mode     TargetMode,
	LibName  string,
	Platform string,
	Locked   bool,
	Debug    bool,
	Release  bool,
}

func formatUint64Dec(v uint64) string {
	let zero = uint64(0)
	let ten = uint64(10)
	if v == zero {
		return "0"
	}
	let mut cur = v
	let mut out = ""
	for cur > zero {
		let d = cur % ten
		out = strconv.Itoa(int(d)) + out
		cur = cur / ten
	}
	out
}

func boolKeyFlag(b bool) string {
	if b { "1" } else { "0" }
}

// TestActionKey computes a deterministic action key for a test package run.
func TestActionKey(input TestActionInput) string {
	let baseInput = ActionInput{..input.Action, Target: "test"}
	let baseKey = PackageActionKey(baseInput)
	let shardTag = strconv.Itoa(input.ShardIndex) + "/" + strconv.Itoa(input.ShardTotal)
	cachekey.Fields([]cachekey.Field{
		cachekey.Field{Name: "mode", Value: "test"},
		cachekey.Field{Name: "base", Value: baseKey},
		cachekey.Field{Name: "seed", Value: formatUint64Dec(input.Seed)},
		cachekey.Field{Name: "states", Value: strconv.Itoa(input.States)},
		cachekey.Field{Name: "filter", Value: input.Filter},
		cachekey.Field{Name: "skip", Value: input.Skip},
		cachekey.Field{Name: "law", Value: input.Law},
		cachekey.Field{Name: "skip_law", Value: input.SkipLaw},
		cachekey.Field{Name: "shard", Value: shardTag},
	})
}

// BuildActionKey computes a deterministic action key for a build, run, or library emission action.
func BuildActionKey(input BuildActionInput) string {
	let label = TargetModeLabel(input.Mode)
	let baseInput = ActionInput{..input.Action, Target: label}
	let baseKey = PackageActionKey(baseInput)
	cachekey.Fields([]cachekey.Field{
		cachekey.Field{Name: "mode", Value: label},
		cachekey.Field{Name: "base", Value: baseKey},
		cachekey.Field{Name: "lib", Value: input.LibName},
		cachekey.Field{Name: "platform", Value: input.Platform},
		cachekey.Field{Name: "locked", Value: boolKeyFlag(input.Locked)},
		cachekey.Field{Name: "debug", Value: boolKeyFlag(input.Debug)},
		cachekey.Field{Name: "release", Value: boolKeyFlag(input.Release)},
	})
}

// TestActionKeySensitiveToSeedAndFilter: changing the seed or filter produces a distinct TestActionKey.
law TestActionKeySensitiveToSeedAndFilter(s1 uint64, s2 uint64, f1 string, f2 string) {
	if s1 == s2 && f1 == f2 {
		return true
	}
	let base = ActionInput{
		Compiler:    "ergo 1",
		Target:      "test",
		PkgPath:     "app/pkg",
		Files:       []FileDigest{FileDigest{Path: "pkg.ergo", ContentDigest: "digest"}},
		DepKeys:     []string{},
		Flags:       []string{},
		Environ:     []string{},
		Experiments: []string{},
	}
	let a = TestActionInput{Action: base, Seed: s1, States: 10, Filter: f1, Skip: "", Law: "", SkipLaw: "", ShardIndex: 0, ShardTotal: 1}
	let b = TestActionInput{Action: base, Seed: s2, States: 10, Filter: f2, Skip: "", Law: "", SkipLaw: "", ShardIndex: 0, ShardTotal: 1}
	TestActionKey(a) != TestActionKey(b)
}

// BuildActionKeySensitiveToModeAndPlatform: changing build flags or platform invalidates BuildActionKey.
law BuildActionKeySensitiveToModeAndPlatform(p1 string, p2 string, debug bool, release bool) {
	let base = ActionInput{
		Compiler:    "ergo 1",
		Target:      "build",
		PkgPath:     "app/cmd",
		Files:       []FileDigest{FileDigest{Path: "main.ergo", ContentDigest: "digest"}},
		DepKeys:     []string{},
		Flags:       []string{},
		Environ:     []string{},
		Experiments: []string{},
	}
	let a = BuildActionInput{Action: base, Mode: ModeBuild, LibName: "", Platform: p1, Locked: false, Debug: debug, Release: release}
	let b = BuildActionInput{Action: base, Mode: ModeBuild, LibName: "", Platform: p2, Locked: false, Debug: !debug, Release: release}
	(p1 != p2 && BuildActionKey(a) != BuildActionKey(BuildActionInput{..a, Platform: p2})) || (p1 == p2 && BuildActionKey(a) != BuildActionKey(b))
}
