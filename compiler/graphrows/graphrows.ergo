import slices
import strconv
import strings

// Version is the graphrows schema version matching std/codegraph.
let Version = 2

// NoNode is the dense uint32 sentinel representing an absent node reference.
let NoNode = uint32(4294967295)

// NoStr is the dense uint32 sentinel representing an absent string reference.
let NoStr = uint32(4294967295)

// KindModule tags a module root node.
let KindModule = uint8(1)

// KindPackage tags a package node.
let KindPackage = uint8(2)

// KindFile tags a source file node.
let KindFile = uint8(3)

// KindDecl tags a declaration node.
let KindDecl = uint8(4)

// KindVar tags a local or package variable node.
let KindVar = uint8(5)

// KindSpec tags a type or field specification node.
let KindSpec = uint8(6)

// KindTask tags a verification or build task node.
let KindTask = uint8(7)

// SubNone tags nodes without a specialization sub-kind.
let SubNone = uint8(0)

// SubFunc tags a function declaration.
let SubFunc = uint8(1)

// SubType tags a type declaration.
let SubType = uint8(2)

// SubConst tags an immutable constant/let declaration.
let SubConst = uint8(3)

// SubVar tags a mutable variable declaration.
let SubVar = uint8(4)

// SubContext tags a context declaration.
let SubContext = uint8(5)

// SubTest tags a test declaration.
let SubTest = uint8(6)

// SubLaw tags a law declaration.
let SubLaw = uint8(7)

// SubField tags a record or interface field declaration.
let SubField = uint8(8)

// SubTaskTestRun tags a test execution task node.
let SubTaskTestRun = uint8(9)

// SubTaskTestCover tags a test coverage task node.
let SubTaskTestCover = uint8(10)

// SubTaskTestExec tags a test binary execution task node.
let SubTaskTestExec = uint8(11)

// SubTaskLawRun tags a property law execution task node.
let SubTaskLawRun = uint8(12)

// SubTaskLawRunMachine tags a stateful machine law task node.
let SubTaskLawRunMachine = uint8(13)

// EdgeContains tags structural ownership edges (module->package->file->decl).
let EdgeContains = uint8(1)

// EdgeUses tags cross-declaration or cross-package usage edges.
let EdgeUses = uint8(2)

// EdgeImports tags file or package import dependency edges.
let EdgeImports = uint8(3)

// EdgeCalls tags direct function or method invocation edges.
let EdgeCalls = uint8(4)

// EdgeMutates tags mutation edges.
let EdgeMutates = uint8(5)

// EdgeReads tags read access edges.
let EdgeReads = uint8(6)

// EdgeOwns tags ownership transfer edges.
let EdgeOwns = uint8(7)

// EdgeRefers tags type or symbol reference edges.
let EdgeRefers = uint8(8)

// EdgeRequires tags task-to-subject verification edges.
let EdgeRequires = uint8(9)

// Pos locates a graph row within a file node and source coordinates.
type Pos {
	File   uint32,
	Offset int,
	Line   int,
	Column int,
}

// Node is one materialized row of a graphrows Table.
type Node {
	ID      uint32,
	Kind    uint8,
	Sub     uint8,
	Parent  uint32,
	Name    uint32,
	Digest  uint32,
	Subject uint32,
	Lines   int,
	Pos     Pos,
}

// Edge is one materialized dependency edge of a graphrows Table.
type Edge {
	Kind uint8,
	How  uint32,
	From uint32,
	To   uint32,
	Pos  Pos,
}

// Table stores build-graph nodes, edges, and deduplicated strings across flat
// SoA columns indexed by dense uint32 IDs.
type Table {
	Version     int,
	Strings     []string,
	StrBuckets  []uint32,
	NodeKind    []uint8,
	NodeSub     []uint8,
	NodeParent  []uint32,
	NodeName    []uint32,
	NodeDigest  []uint32,
	NodeSubject []uint32,
	NodeLines   []int,
	NodeFile    []uint32,
	NodeOffset  []int,
	NodeLine    []int,
	NodeColumn  []int,
	EdgeKind    []uint8,
	EdgeHow     []uint32,
	EdgeFrom    []uint32,
	EdgeTo      []uint32,
	EdgeFile    []uint32,
	EdgeOffset  []int,
	EdgeLine    []int,
	EdgeColumn  []int,
}

// NoPos returns an empty source position with NoNode as File.
func NoPos() Pos {
	Pos{File: NoNode, Offset: 0, Line: 0, Column: 0}
}

// NewTable allocates an empty version-2 SoA graph table.
func NewTable() Table {
	Table{
		Version:     Version,
		Strings:     []string{""},
		StrBuckets:  seedEmptyBucket(64),
		NodeKind:    []uint8{},
		NodeSub:     []uint8{},
		NodeParent:  []uint32{},
		NodeName:    []uint32{},
		NodeDigest:  []uint32{},
		NodeSubject: []uint32{},
		NodeLines:   []int{},
		NodeFile:    []uint32{},
		NodeOffset:  []int{},
		NodeLine:    []int{},
		NodeColumn:  []int{},
		EdgeKind:    []uint8{},
		EdgeHow:     []uint32{},
		EdgeFrom:    []uint32{},
		EdgeTo:      []uint32{},
		EdgeFile:    []uint32{},
		EdgeOffset:  []int{},
		EdgeLine:    []int{},
		EdgeColumn:  []int{},
	}
}

// Intern adds s to t's string pool if not already present and returns its dense ID.
func Intern(t mut Table, s string) uint32 {
	if s == "" {
		return uint32(0)
	}
	if t.StrBuckets.Len() == 0 {
		t.StrBuckets = seedEmptyBucket(64)
	}
	let mask = uint32(t.StrBuckets.Len() - 1)
	let mut slot = hashStr(s) & mask
	for _ in 0..t.StrBuckets.Len() {
		let v = t.StrBuckets[int(slot)]
		if v == uint32(0) {
			break
		}
		let id = v - uint32(1)
		if t.Strings[int(id)] == s {
			return id
		}
		slot = (slot + uint32(1)) & mask
	}
	let newID = uint32(t.Strings.Len())
	t.Strings = t.Strings.Append(s)
	if t.Strings.Len()*2 >= t.StrBuckets.Len() {
		rehashStrings(t)
	} else {
		placeStrBucket(t, s, newID)
	}
	newID
}

// Str returns the interned string for id or "" for NoStr/out-of-range IDs.
func Str(t Table, id uint32) string {
	if id == NoStr || int(id) >= t.Strings.Len() {
		return ""
	}
	t.Strings[int(id)]
}

// AddNode appends one node to t and returns its dense uint32 ID.
func AddNode(t mut Table, n Node) uint32 {
	let id = uint32(t.NodeKind.Len())
	t.NodeKind = t.NodeKind.Append(n.Kind)
	t.NodeSub = t.NodeSub.Append(n.Sub)
	t.NodeParent = t.NodeParent.Append(n.Parent)
	t.NodeName = t.NodeName.Append(n.Name)
	t.NodeDigest = t.NodeDigest.Append(n.Digest)
	t.NodeSubject = t.NodeSubject.Append(n.Subject)
	t.NodeLines = t.NodeLines.Append(n.Lines)
	t.NodeFile = t.NodeFile.Append(n.Pos.File)
	t.NodeOffset = t.NodeOffset.Append(n.Pos.Offset)
	t.NodeLine = t.NodeLine.Append(n.Pos.Line)
	t.NodeColumn = t.NodeColumn.Append(n.Pos.Column)
	id
}

// NodeCount returns the number of node rows in t.
func NodeCount(t Table) int {
	t.NodeKind.Len()
}

// NodeAt materializes the Node row at dense index id.
func NodeAt(t Table, id uint32) Node {
	let i = int(id)
	Node{
		ID:      id,
		Kind:    t.NodeKind[i],
		Sub:     t.NodeSub[i],
		Parent:  t.NodeParent[i],
		Name:    t.NodeName[i],
		Digest:  t.NodeDigest[i],
		Subject: t.NodeSubject[i],
		Lines:   t.NodeLines[i],
		Pos:     Pos{
			File:   t.NodeFile[i],
			Offset: t.NodeOffset[i],
			Line:   t.NodeLine[i],
			Column: t.NodeColumn[i],
		},
	}
}

// AddEdge appends one edge to t.
func AddEdge(t mut Table, e Edge) {
	t.EdgeKind = t.EdgeKind.Append(e.Kind)
	t.EdgeHow = t.EdgeHow.Append(e.How)
	t.EdgeFrom = t.EdgeFrom.Append(e.From)
	t.EdgeTo = t.EdgeTo.Append(e.To)
	t.EdgeFile = t.EdgeFile.Append(e.Pos.File)
	t.EdgeOffset = t.EdgeOffset.Append(e.Pos.Offset)
	t.EdgeLine = t.EdgeLine.Append(e.Pos.Line)
	t.EdgeColumn = t.EdgeColumn.Append(e.Pos.Column)
}

// EdgeCount returns the number of edge rows in t.
func EdgeCount(t Table) int {
	t.EdgeKind.Len()
}

// EdgeAt materializes the Edge row at index i.
func EdgeAt(t Table, i int) Edge {
	Edge{
		Kind: t.EdgeKind[i],
		How:  t.EdgeHow[i],
		From: t.EdgeFrom[i],
		To:   t.EdgeTo[i],
		Pos:  Pos{
			File:   t.EdgeFile[i],
			Offset: t.EdgeOffset[i],
			Line:   t.EdgeLine[i],
			Column: t.EdgeColumn[i],
		},
	}
}

// NodeKindName returns the wire string name of node kind k.
func NodeKindName(k uint8) string {
	if k == KindModule {
		return "module"
	}
	if k == KindPackage {
		return "package"
	}
	if k == KindFile {
		return "file"
	}
	if k == KindDecl {
		return "decl"
	}
	if k == KindVar {
		return "var"
	}
	if k == KindSpec {
		return "spec"
	}
	if k == KindTask {
		return "task"
	}
	"unknown"
}

// ParseNodeKind parses a wire node kind name to its uint8 discriminant.
func ParseNodeKind(s string) (uint8, bool) {
	if s == "module" {
		return (KindModule, true)
	}
	if s == "package" {
		return (KindPackage, true)
	}
	if s == "file" {
		return (KindFile, true)
	}
	if s == "decl" {
		return (KindDecl, true)
	}
	if s == "var" {
		return (KindVar, true)
	}
	if s == "spec" {
		return (KindSpec, true)
	}
	if s == "task" {
		return (KindTask, true)
	}
	(uint8(0), false)
}

// SubKindName returns the wire string name of specialization sub-kind s.
func SubKindName(s uint8) string {
	if s == SubNone {
		return ""
	}
	if s == SubFunc {
		return "func"
	}
	if s == SubType {
		return "type"
	}
	if s == SubConst {
		return "const"
	}
	if s == SubVar {
		return "var"
	}
	if s == SubContext {
		return "context"
	}
	if s == SubTest {
		return "test"
	}
	if s == SubLaw {
		return "law"
	}
	if s == SubField {
		return "field"
	}
	if s == SubTaskTestRun {
		return "test_run"
	}
	if s == SubTaskTestCover {
		return "test_cover"
	}
	if s == SubTaskTestExec {
		return "test_exec"
	}
	if s == SubTaskLawRun {
		return "law_run"
	}
	if s == SubTaskLawRunMachine {
		return "law_run_machine"
	}
