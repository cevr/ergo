}

// ParseSubKind parses a wire specialization name to its uint8 discriminant.
func ParseSubKind(s string) (uint8, bool) {
	if s == "" {
		return (SubNone, true)
	}
	if s == "func" {
		return (SubFunc, true)
	}
	if s == "type" {
		return (SubType, true)
	}
	if s == "const" {
		return (SubConst, true)
	}
	if s == "var" {
		return (SubVar, true)
	}
	if s == "context" {
		return (SubContext, true)
	}
	if s == "test" {
		return (SubTest, true)
	}
	if s == "law" {
		return (SubLaw, true)
	}
	if s == "field" {
		return (SubField, true)
	}
	if s == "test_run" {
		return (SubTaskTestRun, true)
	}
	if s == "test_cover" {
		return (SubTaskTestCover, true)
	}
	if s == "test_exec" {
		return (SubTaskTestExec, true)
	}
	if s == "law_run" {
		return (SubTaskLawRun, true)
