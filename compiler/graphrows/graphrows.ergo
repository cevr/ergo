// Sorted returns a canonical copy of t with nodes ordered deterministically,
// all node references remapped, and edges sorted and deduplicated.
func Sorted(t Table) Table {
	let nn = NodeCount(t)
	let mut order = slices.WithCapacity[uint32](nn)
	for i in 0..nn {
		order = order.Append(uint32(i))
	}
	let keys = slices.WithCapacity[string](nn)
	let mut keyCols = keys
	for i in 0..nn {
		let id = uint32(i)
		let pathKey = parentChainKey(t, id)
		keyCols = keyCols.Append(pathKey + "\x00" + NodeKindName(t.NodeKind[i]) + "\x00" + SubKindName(t.NodeSub[i]) + "\x00" + Str(t, t.NodeName[i]) + "\x00" + padInt(t.NodeLine[i]) + "\x00" + padInt(t.NodeColumn[i]) + "\x00" + padInt(t.NodeOffset[i]) + "\x00" + Str(t, t.NodeDigest[i]))
	}
	order = slices.SortFunc(order, func(a uint32, b uint32) int {
		let ka = keyCols[int(a)]
		let kb = keyCols[int(b)]
		let c = strings.Compare(ka, kb)
		if c != 0 {
			return c
		}
		if a < b {
			return -1
		}
		if a > b {
			return 1
		}
		0
	})
	let mut remap = slices.WithCapacity[uint32](nn)
	for _ in 0..nn {
		remap = remap.Append(NoNode)
	}
	for newIdx in 0..nn {
		remap[int(order[newIdx])] = uint32(newIdx)
	}
	let mut out = NewTable()
	for newIdx in 0..nn {
		let oldID = order[newIdx]
		let n = NodeAt(t, oldID)
		let _ = AddNode(&out, Node{
			ID:      uint32(newIdx),
			Kind:    n.Kind,
			Sub:     n.Sub,
			Parent:  remapID(remap, n.Parent),
			Name:    Intern(&out, Str(t, n.Name)),
			Digest:  Intern(&out, Str(t, n.Digest)),
			Subject: remapID(remap, n.Subject),
			Lines:   n.Lines,
			Pos:     Pos{
				File:   remapID(remap, n.Pos.File),
				Offset: n.Pos.Offset,
				Line:   n.Pos.Line,
				Column: n.Pos.Column,
			},
		})
	}
	let ne = EdgeCount(t)
	let mut edges = slices.WithCapacity[Edge](ne)
	for i in 0..ne {
		let e = EdgeAt(t, i)
		edges = edges.Append(Edge{
			Kind: e.Kind,
			How:  Intern(&out, Str(t, e.How)),
			From: remapID(remap, e.From),
			To:   remapID(remap, e.To),
			Pos:  Pos{
				File:   remapID(remap, e.Pos.File),
				Offset: e.Pos.Offset,
				Line:   e.Pos.Line,
				Column: e.Pos.Column,
			},
		})
	}
	edges = slices.SortFunc(edges, func(a Edge, b Edge) int {
		compareEdges(out, a, b)
	})
	for i in 0..edges.Len() {
		if i > 0 && compareEdges(out, edges[i-1], edges[i]) == 0 {
			continue
		}
		AddEdge(&out, edges[i])
	}
	out
}

// AppendColumns appends one formatted line per node and edge in t to out.
func AppendColumns(t Table, out []string) []string {
	let mut res = out
	for i in 0..NodeCount(t) {
		let n = NodeAt(t, uint32(i))
		res = res.Append("node\t" + strconv.Itoa(int(n.ID)) + "\t" + NodeKindName(n.Kind) + "\t" + SubKindName(n.Sub) + "\t" + nodeIDText(n.Parent) + "\t" + Str(t, n.Name) + "\t" + Str(t, n.Digest) + "\t" + nodeIDText(n.Subject) + "\t" + strconv.Itoa(n.Lines) + "\t" + nodeIDText(n.Pos.File) + "\t" + strconv.Itoa(n.Pos.Offset) + "\t" + strconv.Itoa(n.Pos.Line) + "\t" + strconv.Itoa(n.Pos.Column))
	}
	for i in 0..EdgeCount(t) {
		let e = EdgeAt(t, i)
		res = res.Append("edge\t" + EdgeKindName(e.Kind) + "\t" + Str(t, e.How) + "\t" + nodeIDText(e.From) + "\t" + nodeIDText(e.To) + "\t" + nodeIDText(e.Pos.File) + "\t" + strconv.Itoa(e.Pos.Offset) + "\t" + strconv.Itoa(e.Pos.Line) + "\t" + strconv.Itoa(e.Pos.Column))
	}
	res
}

// FormatText returns the canonical newline-terminated columnar representation of t.
func FormatText(t Table) string {
	let lines = AppendColumns(t, []string{})
	let mut b = strings.NewBuilder()
	for i in 0..lines.Len() {
		b.WriteString(lines[i])
		b.WriteByte('\n')
	}
	b.String()
}

func nodeIDText(id uint32) string {
	if id == NoNode {
		return "-1"
	}
	strconv.Itoa(int(id))
}

func remapID(remap []uint32, id uint32) uint32 {
	if id == NoNode || int(id) >= remap.Len() {
		return NoNode
	}
	remap[int(id)]
}

func parentChainKey(t Table, id uint32) string {
	let mut chain = []string{}
	let mut cur = id
	for _ in 0..NodeCount(t) {
		if cur == NoNode || int(cur) >= NodeCount(t) {
			break
		}
		chain = chain.Append(NodeKindName(t.NodeKind[int(cur)]) + ":" + Str(t, t.NodeName[int(cur)]))
		cur = t.NodeParent[int(cur)]
	}
	let mut b = strings.NewBuilder()
	for i in 0..chain.Len() {
		if i > 0 {
			b.WriteByte('/')
		}
		b.WriteString(chain[chain.Len()-1-i])
	}
	b.String()
}

func padInt(v int) string {
	let s = strconv.Itoa(v)
	let mut out = ""
	for _ in s.Len()..10 {
		out = out + "0"
	}
	out + s
}

func compareEdges(t Table, a Edge, b Edge) int {
	if a.Kind != b.Kind {
		return if a.Kind < b.Kind { -1 } else { 1 }
	}
	if a.From != b.From {
		return if a.From < b.From { -1 } else { 1 }
	}
	if a.To != b.To {
		return if a.To < b.To { -1 } else { 1 }
	}
	let hc = strings.Compare(Str(t, a.How), Str(t, b.How))
	if hc != 0 {
		return hc
	}
	if a.Pos.File != b.Pos.File {
		return if a.Pos.File < b.Pos.File { -1 } else { 1 }
	}
	if a.Pos.Offset != b.Pos.Offset {
		return if a.Pos.Offset < b.Pos.Offset { -1 } else { 1 }
	}
	if a.Pos.Line != b.Pos.Line {
		return if a.Pos.Line < b.Pos.Line { -1 } else { 1 }
	}
	if a.Pos.Column != b.Pos.Column {
		return if a.Pos.Column < b.Pos.Column { -1 } else { 1 }
	}
	0
}

func seedEmptyBucket(n int) []uint32 {
	let mut out = slices.WithCapacity[uint32](n)
	for _ in 0..n {
		out = out.Append(uint32(0))
	}
	out
}

func hashStr(s string) uint32 {
	let mut h = uint32(2166136261)
	for i in 0..s.Len() {
		h = (h ^ uint32(s[i])) * uint32(16777619)
	}
	h
}

func rehashStrings(t mut Table) {
	let newCap = if t.StrBuckets.Len() < 64 { 64 } else { t.StrBuckets.Len() * 2 }
	t.StrBuckets = seedEmptyBucket(newCap)
	for i in 0..t.Strings.Len() {
		if t.Strings[i] != "" {
			placeStrBucket(t, t.Strings[i], uint32(i))
		}
	}
}

func placeStrBucket(t mut Table, s string, id uint32) {
	let mask = uint32(t.StrBuckets.Len() - 1)
	let mut slot = hashStr(s) & mask
	for _ in 0..t.StrBuckets.Len() {
		if t.StrBuckets[int(slot)] == uint32(0) {
			t.StrBuckets[int(slot)] = id + uint32(1)
			return
		}
		slot = (slot + uint32(1)) & mask
	}
}

// SortedOrderInvariance checks that inserting nodes and edges in reversed
// order yields identical canonical Sorted tables and columnar text.
law SortedOrderInvariance(modName string, pkgName string, fnA string, fnB string) {
	let nMod = if modName == "" { "mod" } else { modName }
	let nPkg = if pkgName == "" { "app" } else { pkgName }
	let aName = if fnA == "" { "Alpha" } else { fnA }
	let bName = if fnB == "" || fnB == aName { aName + "Next" } else { fnB }

	let mut t1 = NewTable()
	let m1 = AddNode(&t1, Node{ID: uint32(0), Kind: KindModule, Sub: SubNone, Parent: NoNode, Name: Intern(&t1, nMod), Digest: uint32(0), Subject: NoNode, Lines: 0, Pos: NoPos()})
	let p1 = AddNode(&t1, Node{ID: uint32(0), Kind: KindPackage, Sub: SubNone, Parent: m1, Name: Intern(&t1, nPkg), Digest: uint32(0), Subject: NoNode, Lines: 0, Pos: NoPos()})
	let fa1 = AddNode(&t1, Node{ID: uint32(0), Kind: KindDecl, Sub: SubFunc, Parent: p1, Name: Intern(&t1, aName), Digest: uint32(0), Subject: NoNode, Lines: 4, Pos: Pos{File: NoNode, Offset: 0, Line: 1, Column: 1}})
	let fb1 = AddNode(&t1, Node{ID: uint32(0), Kind: KindDecl, Sub: SubFunc, Parent: p1, Name: Intern(&t1, bName), Digest: uint32(0), Subject: NoNode, Lines: 4, Pos: Pos{File: NoNode, Offset: 30, Line: 6, Column: 1}})
	AddEdge(&t1, Edge{Kind: EdgeContains, How: uint32(0), From: m1, To: p1, Pos: NoPos()})
	AddEdge(&t1, Edge{Kind: EdgeContains, How: uint32(0), From: p1, To: fa1, Pos: NoPos()})
	AddEdge(&t1, Edge{Kind: EdgeContains, How: uint32(0), From: p1, To: fb1, Pos: NoPos()})
