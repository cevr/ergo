// Comments: each is printed before the first token after it, by
// structure, not by its source column.

import compiler/syntax
import strings

func flushComments(p mut Printer, at int) {
	if at <= p.NextComment {
		return
	}
	p.flushCommentsSlow(at)
}

func flushCommentsSlow(p mut Printer, at int) {
	for p.NextComment < at {
		p.comment(at)
	}
}

func flushClauseComments(p mut Printer, at int) {
	if at <= p.NextComment {
		return
	}
	for p.NextComment < at {
		let slash = p.NextComment
		if p.LastEnd >= 0 && p.ln(slash)-p.LastEndLine >= 2 {
			return
		}
		p.comment(at)
	}
}

func commentRawText(src string, slash int, end int) (string, bool) {
	let raw = strings.Slice(src, slash, end)
	let isLine = strings.HasPrefix(raw, "//")
	if strings.IndexByte(raw, '\r') < 0 {
		return (if isLine { trimLineEnd(raw) } else { raw }, isLine)
	}
	let cleaned = if isLine { trimCR(raw) } else { strings.ReplaceAll(raw, "\r", "") }
	(if isLine { trimLineEnd(cleaned) } else { cleaned }, isLine)
}

func comment(p mut Printer, limit int) {
	let ci = p.Ci
	let slash = p.NextComment
	let end = syntax.CommentEndAt(p.P, ci)
	let nextCi = ci + 1
	let nxt = if nextCi < p.Nc { syntax.CommentStartAt(p.P, nextCi) } else { p.EOF + 2 }
	let mut next = limit
	if nxt < limit {
		next = nxt
	}
	p.Ci = nextCi
	p.NextComment = nxt
	let (text, isLine) = commentRawText(p.Src, slash, end)
	let trailing = p.LastEnd >= 0 && p.ln(slash) == p.LastEndLine
	if trailing && p.L.PendingNL > 0 {
		let nl = p.L.PendingNL
		let noBlank = p.L.NoBlank
		p.L.PendingNL = 0
		p.L.PendingSpace = false
		p.emit(slash)
		p.L.sep()
		p.L.put(text)
		p.L.PendingNL = nl
		p.L.NoBlank = noBlank
	} else if trailing {
		p.space()
		p.emit(slash)
		p.L.put(text)
		if isLine {
			p.newline()
		} else {
			p.space()
		}
	} else {
		if p.LastEnd >= 0 {
			p.newline()
		}
		p.emit(slash)
		p.write(text)
		if isLine || p.ln(next) > p.ln(end) {
			p.newline()
		} else {
			p.space()
		}
	}
	p.LastEnd = end
	p.LastEndLine = p.ln(end)
}
