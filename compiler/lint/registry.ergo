		ruleDef("long-parameter-list", "L141", SeverityWarning, "group the parameters that travel together into a record and pass it", false, true),
		ruleDef("mode-parameter", "L123", SeverityWarning, "split the function into one per mode, and let each caller call the one it means", false, false),
