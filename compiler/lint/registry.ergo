import option

// RuleMeta describes a single built-in lint rule.
type RuleMeta {
	// Name is the kebab-case rule identifier.
	Name string,
	// Code is the stable diagnostic code such as L172.
	Code string,
	// Doc describes what the rule checks.
	Doc string,
	// Instead describes what to write or do instead.
	Instead string,
	// Default is the rule's default severity rank when enabled without explicit severity.
	Default uint8,
	// SafeFix reports whether fixes from this rule are safe for ergo fix --lint.
	SafeFix bool,
	// HasOptions reports whether this rule accepts configuration options.
	HasOptions bool,
	// HasPrecision reports whether this rule carries a published precision measurement.
	HasPrecision bool,
	// Precision is the published precision in hundredths when HasPrecision is true.
	Precision int,
}

func ruleDef(name string, code string, def uint8, instead string, safeFix bool, hasOpts bool) RuleMeta {
	let (prec, hasPrec) = PrecisionOf(name)
	RuleMeta{
		Name:         name,
		Code:         code,
		Doc:          "",
		Instead:      instead,
		Default:      def,
		SafeFix:      safeFix,
		HasOptions:   hasOpts,
		HasPrecision: hasPrec,
		Precision:    prec,
	}
}

// PrecisionOf returns the published precision in hundredths for a built-in rule.
func PrecisionOf(rule string) (int, bool) {
	if rule == "banned-words" {
		return (33, true)
	}
	if rule == "cognitive-complexity" {
		return (64, true)
	}
	if rule == "cyclomatic-complexity" {
		return (25, true)
	}
	if rule == "halstead-difficulty" {
		return (0, true)
	}
	if rule == "known-value-widening" {
		return (95, true)
	}
	if rule == "silent-catch" {
		return (16, true)
	}
	if rule == "unbounded-collect" {
		return (0, true)
	}
	(0, false)
}

// BuiltinRules returns all 71 built-in rules ordered by rule name.
func BuiltinRules() []RuleMeta {
	[]RuleMeta{
		ruleDef("added-clone", "L130", SeverityWarning, "call the existing function", false, false),
		ruleDef("banned-words", "L111", SeverityWarning, "name what the thing is, or what the function does to what", false, true),
		ruleDef("capability-outside-owner", "L133", SeverityWarning, "call a function of the owner package that runs the operation, and keep the capability's operations in the packages the owners option names", false, true),
		ruleDef("cause-dropped", "L136", SeverityWarning, "name the failures the arm expects, or bind the failure and carry what the caller needs of it into the new failure's fields", false, false),
		ruleDef("cognitive-complexity", "L107", SeverityWarning, "split it into functions that each do one thing", false, true),
		ruleDef("commented-code", "L143", SeverityHint, "delete it; the history keeps it", false, false),
		ruleDef("concat-in-loop", "L147", SeverityHint, "append the parts to a []string and strings.Join them after the loop, or write them to a strings.Builder", false, false),
		ruleDef("concept-file-names", "L113", SeverityWarning, "name it for what it holds (AGENTS.md, Go layout)", false, true),
		ruleDef("console-outside-entry", "L134", SeverityWarning, "return the text to the caller and print it in the entry or a host package", false, false),
		ruleDef("constant-argument", "L140", SeverityWarning, "drop the parameter and use the constant inside the function", false, false),
		ruleDef("constant-restated", "L153", SeverityHint, "assert what a function computes from the constant, or delete the assert", false, false),
		ruleDef("cyclomatic-complexity", "L108", SeverityWarning, "split it into functions that each do one thing", false, true),
		ruleDef("declaration-tangle", "L171", SeverityHint, "co-locate inseparable declarations in one file, or extract a one-way mediator for distinct responsibilities", false, true),
		ruleDef("default-on-failure", "L126", SeverityWarning, "catch the failures you expect by name and let the others propagate, or record the failure before you give the default", false, false),
		ruleDef("deprecated", "L104", SeverityWarning, "use what its Deprecated: paragraph names", false, false),
		ruleDef("derived-field", "L149", SeverityHint, "drop the field and compute it from the others with a function where it is read", false, false),
		ruleDef("domain-imports-implementation", "L157", SeverityWarning, "need the operation type, and bind the implementation in the binary's main", false, false),
		ruleDef("duplicate-shape", "L118", SeverityWarning, "keep one", false, false),
		ruleDef("duplicate-test", "L117", SeverityWarning, "delete one", false, false),
		ruleDef("eta-method-value", "L162", SeverityHint, "write the method value r.f", true, false),
		ruleDef("failure-as-variant", "L137", SeverityWarning, "fail with it: move the type from the result union into the function's fails row", false, false),
		ruleDef("file-cycle", "L155", SeverityHint, "move the declarations the two files share into one of them, or into a file both use", false, false),
		ruleDef("file-name-case", "L172", SeverityWarning, "rename the file or directory to match the configured case style", false, true),
		ruleDef("foreign-error-public", "L102", SeverityWarning, "map it to a closed union of error types at this boundary (docs/spec/interop.md)", false, false),
		ruleDef("foreign-outside-adapter", "L132", SeverityWarning, "move the code that uses the Go package into an adapter package named after it, which implements the operation type, and bind it at the entry", false, false),
		ruleDef("foreign-record-field-write", "L167", SeverityHint, "expose a behavioral update on the owning package where the invariant belongs, or make the record an all-public data type", false, false),
		ruleDef("foreign-where-std", "L103", SeverityWarning, "import the std package that covers it (docs/spec/stdlib.md)", false, false),
		ruleDef("forwarding-func", "L121", SeverityWarning, "call the function it forwards to directly, and delete it", false, false),
		ruleDef("guard-the-type-proves", "L128", SeverityWarning, "delete the guard and the branch it cannot take; the type already promises it", false, false),
		ruleDef("halstead-difficulty", "L109", SeverityWarning, "split it into functions that each do one thing", false, true),
		ruleDef("hidden-dependency", "L158", SeverityWarning, "name the declaration itself and import its package", false, false),
		ruleDef("identical-arms", "L119", SeverityWarning, "list their patterns in one arm", false, false),
		ruleDef("independent-waits", "L152", SeverityHint, "start the first with task.Go and wait for it after the second, if their order does not matter", false, false),
		ruleDef("known-value-widening", "L110", SeverityWarning, "write no type, so the binding keeps the variant", false, false),
		ruleDef("large-value-copy", "L148", SeverityHint, "loop over the indices and read the fields you need through the collection, or keep the large part behind a handle", false, true),
		ruleDef("layer", "L156", SeverityWarning, "move what the lower package needs from the upper one down, or pass it in", false, true),
		ruleDef("lone-provider", "L122", SeverityWarning, "use the provider directly, or state the operation type's laws so a second provider is held to them", false, false),
