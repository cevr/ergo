		ruleDef("no-comments", "L163", SeverityError, "say it in the code: a name, a function or type that carries it, a refinement or a law that makes it true; ergo fix removes the comment", true, false),
		ruleDef("option-fields-follow-variant", "L150", SeverityHint, "move the field into that variant's record and drop the Option", false, false),
		ruleDef("parameter-clump", "L139", SeverityWarning, "name the group as a record and pass it, or pass the record that already holds these fields", false, false),
		ruleDef("production-uses-test-support", "L168", SeverityHint, "move the fixture use into a test or law, or pass a capability provider bound at entry", false, true),
		ruleDef("quadratic-scan", "L146", SeverityHint, "build a map (or a set) from the collection once, before the loop, and look each value up in it", false, false),
		ruleDef("race-for-timeout", "L106", SeverityHint, "write timeout.After(d, block) and catch timeout.Expired with the fallback", false, false),
		ruleDef("repeated-case", "L154", SeverityHint, "delete the repeat, or assert the case it was meant to be", false, false),
		ruleDef("repeated-guard", "L129", SeverityWarning, "declare a refined type (type T base where …) for the values the guard accepts, and take it as the parameter's type", false, false),
		ruleDef("repeated-pure-call", "L127", SeverityWarning, "bind the first call's value with let and read the name", false, false),
		ruleDef("repeated-traversal", "L145", SeverityHint, "do the second loop's work in the first, in one pass", false, false),
		ruleDef("scattered-edit", "L131", SeverityWarning, "write it once in a package they all import", false, false),
		ruleDef("seam-entrypoints", "L169", SeverityHint, "import an allowed entry package of the seam instead of its internal package", false, true),
		ruleDef("self-assignment", "L159", SeverityWarning, "delete it; an arm with nothing to do has no statements (case X:)", false, false),
		ruleDef("sibling-folder-cycle", "L170", SeverityHint, "move shared policy into a dependency both folders can import, or compose them from a layer above", false, false),
		ruleDef("sign-decided-comparison", "L160", SeverityWarning, "compare with a value it can take, or delete the comparison", false, false),
		ruleDef("silent-catch", "L101", SeverityWarning, "handle it, or say why with // ergo-lint-disable-next-line silent-catch -- REASON", false, false),
		ruleDef("snapshot-argument", "L144", SeverityHint, "bind the later argument with let before the call, then pass *s", false, false),
		ruleDef("stringly-state", "L124", SeverityWarning, "declare a union with one variant per value, and match on it", false, false),
		ruleDef("take-one-by-law", "L151", SeverityHint, "call the function the law names, which gives the element without building the whole result", false, false),
		ruleDef("test-reads-unexported", "L135", SeverityWarning, "test the behaviour through the package's exported functions, or state the internal's property as a law beside it", false, false),
		ruleDef("test-waits-on-time", "L125", SeverityWarning, "wait on the event itself: the task's Wait, a deferred, a latch, a queue the work fills, or the scheduler's idle (Advance(0s), a Stage's Settle)", false, false),
		ruleDef("unbounded-collect", "L105", SeverityWarning, "loop over it and handle each value, or say why with // ergo-lint-disable-next-line unbounded-collect -- REASON", false, false),
		ruleDef("unbuilt-variant", "L120", SeverityWarning, "delete it, or build it where the domain reaches that state", false, false),
		ruleDef("unused-declaration", "L114", SeverityWarning, "delete it", false, false),
		ruleDef("unused-type-parameter", "L116", SeverityWarning, "delete it", false, false),
		ruleDef("vacuous-test", "L138", SeverityWarning, "assert on what the code under test returns, or delete the test", false, false),
		ruleDef("wide-directory", "L166", SeverityHint, "split the directory into coherent concept subpackages rather than moving files arbitrarily", false, true),
		ruleDef("wide-observed-interface", "L164", SeverityHint, "put the entries clients use together behind one operation with a real contract, or split the package by responsibility", false, true),
		ruleDef("wire-key-quote", "L161", SeverityWarning, "write the key alone: \"name\"", false, false),
		ruleDef("with-at-entry", "L112", SeverityWarning, "bind it in cmd/NAME/main.ergo, or in a test file for the tests", false, true),
	}
}

let allRulesList = BuiltinRules()

func makeRuleMap() Map[string, int] {
	let mut m = Map[string, int]{}
	for i, r in allRulesList {
		m[r.Name] = i
	}
	m
}

let ruleIndexByName = makeRuleMap()

// RuleIndex returns the dense index of a built-in rule name if registered.
func RuleIndex(name string) option.Option[int] {
	ruleIndexByName.Get(name)
}

// RuleByName returns metadata for a built-in rule name.
func RuleByName(name string) (RuleMeta, bool) {
	match ruleIndexByName.Get(name) {
	case option.Some{Value: i}:
		(allRulesList[i], true)
	case option.None:
		(allRulesList[0], false)
	}
}

// IsReservedRuleName reports whether name is reserved for runner or suppression diagnostics.
func IsReservedRuleName(name string) bool {
	name == "lint-runner" || name == "invalid-suppression"
}

let builtinPresetMap = Map[string, []string]{
	Recommended: []string{},
	Justifiers:  []string{
		"silent-catch", "foreign-error-public", "foreign-where-std",
		"deprecated", "unbounded-collect", "race-for-timeout",
	},
	Strict: []string{
		"cognitive-complexity", "cyclomatic-complexity", "halstead-difficulty",
		"known-value-widening", "banned-words",
		"unused-declaration", "unused-type-parameter", "duplicate-test",
		"duplicate-shape", "identical-arms", "unbuilt-variant",
		"forwarding-func", "lone-provider", "mode-parameter", "stringly-state",
		"eta-method-value", "test-waits-on-time",
		"default-on-failure", "repeated-pure-call", "guard-the-type-proves",
		"repeated-guard",
		"cause-dropped", "failure-as-variant", "vacuous-test", "parameter-clump",
		"constant-argument", "long-parameter-list",
		"derived-field", "option-fields-follow-variant", "constant-restated",
		"repeated-case",
		"self-assignment", "sign-decided-comparison", "wire-key-quote",
	},
	Layout: []string{
		"with-at-entry", "concept-file-names", "file-name-case",
		"foreign-outside-adapter", "capability-outside-owner",
		"console-outside-entry", "test-reads-unexported",
		"layer", "domain-imports-implementation", "hidden-dependency",
		"wide-observed-interface", "long-file", "wide-directory",
		"foreign-record-field-write", "production-uses-test-support",
		"seam-entrypoints", "sibling-folder-cycle", "declaration-tangle",
	},
	Advisory: []string{"narration-comment", "commented-code"},
	Speed:    []string{
		"snapshot-argument", "repeated-traversal", "quadratic-scan",
		"concat-in-loop", "large-value-copy", "take-one-by-law", "independent-waits",
	},
	Change: []string{"added-clone", "scattered-edit"},
}

// PresetRuleNames returns the rule names belonging to a built-in preset.
func PresetRuleNames(name string) ([]string, bool) {
	match builtinPresetMap.Get(name) {
	case option.Some{Value: rs}:
		(rs, true)
	case option.None:
		([]string{}, false)
	}
}

test RegistryHasAll71BuiltinsAnd7Presets {
	assert allRulesList.Len() == 71
	let mut codes = Map[string, bool]{}
	for r in allRulesList {
		assert ValidKebabName(r.Name)
		assert r.Instead != ""
		match codes.Get(r.Code) {
		case option.Some:
			assert false
		case option.None:
			codes[r.Code] = true
		}
	}
	for pn in []string{Recommended, Justifiers, Strict, Layout, Advisory, Speed, Change} {
		let (rs, ok) = PresetRuleNames(pn)
		assert ok
		for rn in rs {
			let (_, found) = RuleByName(rn)
			assert found
		}
	}
}
