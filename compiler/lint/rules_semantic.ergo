func sigHasEmptyUses(s store.Store, sig dense.ID[store.TKey]) bool {
	if store.KindOfType(s, sig) != store.KSig {
		return false
	}
	let ops = store.OperandsOf(s, sig)
	if ops.Len() < 1 {
		return false
	}
	let usesRow = ops[ops.Len()-1]
	store.OperandsOf(s, usesRow).Len() == 0
}

func sigHasFuncParam(s store.Store, sig dense.ID[store.TKey]) bool {
	if store.KindOfType(s, sig) != store.KSig {
		return false
	}
	let ops = store.OperandsOf(s, sig)
	let nParams = if ops.Len() > 3 { ops.Len() - 3 } else { 0 }
	for i in 0..nParams {
		let k = store.KindOfType(s, ops[i])
		if k == store.KSig || k == store.KOwn || k == store.KEntry {
			return true
		}
	}
	false
}

func catchArmReadsFailure(p syntax.Parsed, fIdx int, typed load.Typed, arm syntax.CatchArm) bool {
	let t = p.Tree
	let mut bound = []int{}
	let mut stack = slices.WithCapacity[uint32](8)
	let mut kids = slices.WithCapacity[uint32](8)
	for ti in 0..syntax.Len(arm.Types) {
		stack = stack.Append(uint32(dense.Index(syntax.Item(t, arm.Types, ti))))
	}
	for stack.Len() > 0 {
		let cur = syntax.NodeAt(t, int(stack[stack.Len()-1]))
		stack = stack[:stack.Len()-1]
		if syntax.KindOf(t, cur) == syntax.KAsPattern {
			let ap = syntax.AsPatternOf(t, cur)
			let pi = dense.Index(bind.PNodeOf(typed.K.Ps, fIdx, ap.Name))
			if pi >= 0 {
				bound = bound.Append(pi)
			}
		}
		kids = syntax.Children(t, cur, kids[:0])
		for c in kids {
			stack = stack.Append(c)
		}
	}
	if bound.Len() == 0 {
		return false
	}
	for si in 0..syntax.Len(arm.Body) {
		stack = stack.Append(uint32(dense.Index(syntax.Item(t, arm.Body, si))))
	}
	for stack.Len() > 0 {
		let cur = syntax.NodeAt(t, int(stack[stack.Len()-1]))
		stack = stack[:stack.Len()-1]
		if syntax.KindOf(t, cur) == syntax.KIdent {
			match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, cur)) {
			case bind.Declared as dec:
				let di = dense.Index(dec.At)
				if slices.Contains(bound, di) {
					return true
				}
			case _:
			}
		}
		kids = syntax.Children(t, cur, kids[:0])
		for c in kids {
			stack = stack.Append(c)
		}
	}
	false
}

func assignRootIdent(t syntax.Tree, exprNode dense.ID[syntax.Node]) dense.Opt[syntax.Node] {
	let mut cur = exprNode
	for {
		let k = syntax.KindOf(t, cur)
		if k == syntax.KIdent {
			return dense.OptOf(cur)
		}
		if k == syntax.KSelectorExpr {
			cur = syntax.SelectorExprOf(t, cur).X
			continue
		}
		if k == syntax.KIndexExpr {
			cur = syntax.IndexExprOf(t, cur).X
			continue
		}
		if k == syntax.KParenExpr {
			cur = syntax.ParenExprOf(t, cur).X
			continue
		}
		return dense.NoID[syntax.Node]()
	}
	dense.NoID[syntax.Node]()
}

func externTargetShortName(p syntax.Parsed, extNode dense.ID[syntax.Node]) string {
	let t = p.Tree
	let es = syntax.ExternSpecOf(t, extNode)
	let tk = syntax.KindOf(t, es.Target)
	if tk == syntax.KSelectorExpr {
		return NodeText(p, syntax.SelectorExprOf(t, es.Target).Sel)
	}
	if tk == syntax.KIdent {
		return NodeText(p, es.Target)
	}
	""
}

func unwrapCallFun(t syntax.Tree, n dense.ID[syntax.Node]) dense.ID[syntax.Node] {
	let mut cur = n
	for {
		let k = syntax.KindOf(t, cur)
		if k == syntax.KParenExpr {
			cur = syntax.ParenExprOf(t, cur).X
			continue
		}
		if k == syntax.KIndexExpr {
			cur = syntax.IndexExprOf(t, cur).X
			continue
		}
		return cur
	}
	cur
}

func isGoEffectPkg(path string) bool {
	match path {
	case "ergo.local/prototype/runtime/v1/hostfs", "time", "sync/atomic", "runtime", "os", "math/rand/v2", "io/fs":
		true
	case _:
		false
	}
}

type silentCtx {
	inp           Input,
	unitByPkg     Map[string, int],
	opTypes       Map[string, bool],
	unitBuilt     []bool,
	unitTypes     [][]dense.Opt[store.TKey],
	unitCalls     [][]int,
	unitCaps      [][]dense.Opt[store.TKey],
	unitTypeNodes [][]bool,
	unitAliases   [][]Map[string, string],
	unitGoAliases [][]Map[string, string],
	fnPureState   [][]uint8,
}

func unitFileGoAliases(p syntax.Parsed, fi FileIndex) Map[string, string] {
	let mut out = Map[string, string]{}
	let t = p.Tree
	for dr in fi.Decls {
		if dr.Kind != syntax.KImportDecl {
			continue
		}
		let sp = syntax.ImportSpecOf(t, syntax.ImportDeclOf(t, syntax.NodeAt(t, int(dr.Node))).Spec)
		let (impPath, isGo) = importSpecInfo(p, sp)
		if !isGo {
			continue
		}
		let alias = match dense.Unpack(sp.Name) {
		case option.Some{Value: nm}:
			NodeText(p, nm)
		case option.None:
			SlashBase(impPath)
		}
		out[alias] = impPath
	}
	out
}

func ensureSilentUnit(sc mut silentCtx, g ProgramGraph, uIdx int) {
	if (*sc).unitBuilt[uIdx] {
		return
	}
	(*sc).unitBuilt[uIdx] = true
	let u = (*sc).inp.Units[uIdx]
	match u.Typed {
	case option.Some{Value: td}:
		let (ts, cs, cps) = buildUnitTypedCols(td)
		(*sc).unitTypes[uIdx] = ts
		(*sc).unitCalls[uIdx] = cs
		(*sc).unitCaps[uIdx] = cps
		let pTotal = bind.Written(td.K.Ps) + 1
		let mut typeNodes = slices.Repeat([]bool{false}, pTotal)
		let mut aliases = slices.WithCapacity[Map[string, string]](u.Files.Len())
		let mut goAliases = slices.WithCapacity[Map[string, string]](u.Files.Len())
		for fIdx, f in u.Files {
			if f.Parsed.Failed {
				aliases = aliases.Append(Map[string, string]{})
				goAliases = goAliases.Append(Map[string, string]{})
				continue
			}
			let fi = g.FileIndexes[uIdx][fIdx]
			aliases = aliases.Append(unitFileImportAliases(f.Parsed, fi))
			goAliases = goAliases.Append(unitFileGoAliases(f.Parsed, fi))
			markFileTypeNodes(f, fIdx, td, pTotal, &typeNodes)
		}
		(*sc).unitTypeNodes[uIdx] = typeNodes
		(*sc).unitAliases[uIdx] = aliases
		(*sc).unitGoAliases[uIdx] = goAliases
		(*sc).fnPureState[uIdx] = slices.Repeat([]uint8{uint8(0)}, td.K.Fns.Len())
	case option.None:
	}
}

func isBuiltinConversionIdent(name string) bool {
	match name {
	case "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr", "float32", "float64", "string", "bool", "byte", "rune":
		true
	case _:
		false
	}
}

func isSilentConversionCall(sc silentCtx, uIdx int, fIdx int, typed load.Typed, p syntax.Parsed, fun dense.ID[syntax.Node]) bool {
	let fk = syntax.KindOf(p.Tree, fun)
	if fk == syntax.KIdent {
		let nm = NodeText(p, fun)
		if isBuiltinConversionIdent(nm) {
			return true
		}
		match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, fun)) {
		case bind.Declared as dec:
			let di = dense.Index(dec.At)
			return di >= 0 && di < sc.unitTypeNodes[uIdx].Len() && sc.unitTypeNodes[uIdx][di]
		case _:
			return false
		}
	}
	if fk == syntax.KSelectorExpr {
		let se = syntax.SelectorExprOf(p.Tree, fun)
		match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, se.Sel)) {
		case bind.Imported as im:
			if int(im.Ref.Import) > 0 && int(im.Ref.Import) <= typed.K.Ifaces.Len() {
				let ifc = typed.K.Ifaces[int(im.Ref.Import)-1]
				if int(im.Ref.Decl) >= 0 && int(im.Ref.Decl) < ifc.Decls.Len() && ifc.Decls[int(im.Ref.Decl)].Type {
					return true
				}
			}
		case _:
		}
	}
	false
}

func findMatchingUnitFn(
	ttd load.Typed,
	tuPath string,
	fnName string,
	sigOpt option.Option[dense.ID[store.TKey]],
	isRecv bool,
	knownRecv bool,
	recvType string,
	sameUnit bool,
) int {
	let mut candIdx = -1
	for tfi, tfn in ttd.K.Fns {
		if tfn.File < 0 || tfn.File >= ttd.K.Parsed.Len() {
			continue
		}
		let tfp = ttd.K.Parsed[tfn.File]
		if tfp.Failed || !validTreeNode(tfp, tfn.Name) || !validTreeNode(tfp, tfn.Decl) {
			continue
		}
		if NodeText(tfp, tfn.Name) != fnName {
			continue
		}
		if syntax.KindOf(tfp.Tree, tfn.Decl) != syntax.KFuncDecl {
			continue
		}
		if sameUnit {
			match sigOpt {
			case option.Some{Value: sig}:
				if tfn.Sig == sig {
					return tfi
				}
			case option.None:
			}
		}
		let tfd = syntax.FuncDeclOf(tfp.Tree, tfn.Decl)
		let tRecv = dense.Unpack(tfd.Recv) != option.None
		if knownRecv && tRecv != isRecv {
			continue
		}
		if knownRecv && isRecv && recvType != "" {
			let ops = store.OperandsOf(ttd.S, tfn.Sig)
			if ops.Len() < 4 {
				continue
			}
			let (_, rName, _) = nominalTypeOwner(ttd, tuPath, ops[0])
			if rName != recvType {
				continue
			}
		}
		if candIdx < 0 {
			candIdx = tfi
		}
	}
	candIdx
}

func unitFnImpureMemo(sc mut silentCtx, g ProgramGraph, uIdx int, fnIdx int) bool {
	ensureSilentUnit(sc, g, uIdx)
	if fnIdx < 0 || fnIdx >= (*sc).fnPureState[uIdx].Len() {
		return true
	}
	let prev = (*sc).fnPureState[uIdx][fnIdx]
	if prev == uint8(2) {
		return false
	}
	if prev == uint8(3) {
		return true
	}
	if prev == uint8(1) {
		return false
	}
	(*sc).fnPureState[uIdx][fnIdx] = uint8(1)
	let u = (*sc).inp.Units[uIdx]
	let typed = match u.Typed {
	case option.Some{Value: td}:
		td
	case option.None:
		(*sc).fnPureState[uIdx][fnIdx] = uint8(3)
		return true
	}
	let fn = typed.K.Fns[fnIdx]
	if fn.File < 0 || fn.File >= typed.K.Parsed.Len() {
		(*sc).fnPureState[uIdx][fnIdx] = uint8(2)
		return false
	}
	let fp = typed.K.Parsed[fn.File]
	if fp.Failed || !validTreeNode(fp, fn.Decl) || syntax.KindOf(fp.Tree, fn.Decl) != syntax.KFuncDecl {
		(*sc).fnPureState[uIdx][fnIdx] = uint8(2)
		return false
	}
	let fd = syntax.FuncDeclOf(fp.Tree, fn.Decl)
	match dense.Unpack(fd.Extern) {
	case option.Some{Value: extNode}:
		let target = externTargetShortName(fp, extNode)
		let imp = !(target != "" && IsStdRuntimePureOrInert(target))
		(*sc).fnPureState[uIdx][fnIdx] = if imp { uint8(3) } else { uint8(2) }
		return imp
	case option.None:
	}
	let body = match dense.Unpack(fd.Body) {
	case option.Some{Value: b}:
		b
	case option.None:
		(*sc).fnPureState[uIdx][fnIdx] = uint8(3)
		return true
	}
	if !sigHasEmptyUses(typed.S, fn.Sig) {
		(*sc).fnPureState[uIdx][fnIdx] = uint8(3)
		return true
	}
	let t = fp.Tree
	let mut stack = []uint32{uint32(dense.Index(body))}
	let mut kids = slices.WithCapacity[uint32](8)
	for stack.Len() > 0 {
		let cur = syntax.NodeAt(t, int(stack[stack.Len()-1]))
		stack = stack[:stack.Len()-1]
		let k = syntax.KindOf(t, cur)
		if k == syntax.KFuncLit {
			continue
		}
		if k == syntax.KCallExpr {
			if catchCallLeavesTrace(sc, g, uIdx, fn.File, fp, cur) {
				(*sc).fnPureState[uIdx][fnIdx] = uint8(3)
				return true
			}
			let ce = syntax.CallExprOf(t, cur)
			stack = stack.Append(uint32(dense.Index(ce.Fun)))
			for ai in 0..syntax.Len(ce.Args) {
				stack = stack.Append(uint32(dense.Index(syntax.Item(t, ce.Args, ai))))
			}
			if syntax.KindOf(t, Unparen(t, ce.Fun)) == syntax.KIdent && NodeText(fp, Unparen(t, ce.Fun)) == "with" {
				match dense.Unpack(ce.Trailing) {
				case option.Some{Value: tr}:
					stack = stack.Append(uint32(dense.Index(tr)))
				case option.None:
				}
			}
			continue
		}
		kids = syntax.Children(t, cur, kids[:0])
		for c in kids {
			stack = stack.Append(c)
		}
	}
	(*sc).fnPureState[uIdx][fnIdx] = uint8(2)
	false
}

func resolveSilentNodeTKey(
	sc mut silentCtx,
	g ProgramGraph,
	uIdx int,
	fIdx int,
	typed load.Typed,
	node dense.ID[syntax.Node],
	depth int,
) (load.Typed, string, dense.Opt[store.TKey]) {
	let uPath = unitPkgPath((*sc).inp.Units[uIdx])
	if depth >= 8 || fIdx < 0 || fIdx >= typed.K.Parsed.Len() || !validTreeNode(typed.K.Parsed[fIdx], node) {
		return (typed, uPath, dense.NoID[store.TKey]())
	}
	ensureSilentUnit(sc, g, uIdx)
	let pnodeTypes = (*sc).unitTypes[uIdx]
	let pnodeCalls = (*sc).unitCalls[uIdx]
	let pn = bind.PNodeOf(typed.K.Ps, fIdx, node)
	let pi = dense.Index(pn)
	if pi >= 0 && pi < pnodeTypes.Len() {
		match dense.Unpack(pnodeTypes[pi]) {
		case option.Some:
			return (typed, uPath, pnodeTypes[pi])
		case option.None:
		}
	}
	let p = typed.K.Parsed[fIdx]
	let t = p.Tree
	let k = syntax.KindOf(t, node)
	if k == syntax.KParenExpr {
		return resolveSilentNodeTKey(sc, g, uIdx, fIdx, typed, syntax.ParenExprOf(t, node).X, depth+1)
	}
	if k == syntax.KTryExpr {
		return resolveSilentNodeTKey(sc, g, uIdx, fIdx, typed, syntax.TryExprOf(t, node).X, depth+1)
	}
	if k == syntax.KIdent {
		match bind.ResolutionOf(typed.K.U, typed.K.Ps, pn) {
		case bind.Declared as dec:
			let di = dense.Index(dec.At)
			if di >= 0 && di < pnodeTypes.Len() {
				match dense.Unpack(pnodeTypes[di]) {
				case option.Some:
					return (typed, uPath, pnodeTypes[di])
				case option.None:
				}
			}
			match dense.Unpack(bind.ParentOf(typed.K.Ps, dec.At)) {
			case option.Some{Value: parPN}:
				let (parFile, parRow) = bind.RowOf(typed.K.Ps, parPN)
				if parFile >= 0 && parFile < typed.K.Parsed.Len() && !typed.K.Parsed[parFile].Failed {
					let pt = typed.K.Parsed[parFile].Tree
					let parNode = syntax.NodeAt(pt, parRow)
					if syntax.KindOf(pt, parNode) == syntax.KVarSpec {
						let vs = syntax.VarSpecOf(pt, parNode)
						if syntax.Len(vs.Names) == 1 {
							match dense.Unpack(vs.Value) {
							case option.Some{Value: v}:
								return resolveSilentNodeTKey(sc, g, uIdx, parFile, typed, v, depth+1)
							case option.None:
							}
						}
					}
				}
			case option.None:
			}
		case _:
		}
		return (typed, uPath, dense.NoID[store.TKey]())
	}
	if k == syntax.KCallExpr {
		if pi >= 0 && pi < pnodeCalls.Len() {
			let cIdx = pnodeCalls[pi]
			if cIdx >= 0 && cIdx < typed.T.Calls.Len() {
				match sigResultType(typed.S, typed.T.Calls[cIdx].Callee.Sig) {
				case option.Some{Value: rt}:
					return (typed, uPath, dense.OptOf(rt))
				case option.None:
				}
			}
		}
		let ce = syntax.CallExprOf(t, node)
		let fun = unwrapCallFun(t, ce.Fun)
		if syntax.KindOf(t, fun) == syntax.KSelectorExpr {
			let se = syntax.SelectorExprOf(t, fun)
			if syntax.KindOf(t, se.X) == syntax.KIdent {
				let aliases = (*sc).unitAliases[uIdx][fIdx]
				match aliases.Get(NodeText(p, se.X)) {
				case option.Some{Value: path}:
					match (*sc).unitByPkg.Get(path) {
					case option.Some{Value: tuIdx}:
						match (*sc).inp.Units[tuIdx].Typed {
						case option.Some{Value: ttd}:
							let fnName = NodeText(p, se.Sel)
							for tfn in ttd.K.Fns {
								if tfn.File >= 0 && tfn.File < ttd.K.Parsed.Len() && !ttd.K.Parsed[tfn.File].Failed && validTreeNode(ttd.K.Parsed[tfn.File], tfn.Name) && NodeText(ttd.K.Parsed[tfn.File], tfn.Name) == fnName {
									match sigResultType(ttd.S, tfn.Sig) {
									case option.Some{Value: rt}:
										return (ttd, unitPkgPath((*sc).inp.Units[tuIdx]), dense.OptOf(rt))
									case option.None:
									}
								}
							}
						case option.None:
						}
					case option.None:
					}
				case option.None:
				}
			}
		}
		return (typed, uPath, dense.NoID[store.TKey]())
	}
	if k == syntax.KSelectorExpr {
		let se = syntax.SelectorExprOf(t, node)
		let (xTyped, xuPath, xOpt) = resolveSilentNodeTKey(sc, g, uIdx, fIdx, typed, se.X, depth+1)
		match dense.Unpack(xOpt) {
		case option.Some{Value: xt}:
			let (ownerPath, ownerType, _) = nominalTypeOwner(xTyped, xuPath, xt)
			if ownerPath != "" && ownerType != "" {
				match (*sc).unitByPkg.Get(ownerPath) {
				case option.Some{Value: ouIdx}:
					match (*sc).inp.Units[ouIdx].Typed {
					case option.Some{Value: otd}:
						let selName = NodeText(p, se.Sel)
						for rec in otd.K.Recs {
							if rec.Name == ownerType {
								for fld in rec.Fields {
									if fld.Name == selName {
										if store.KindOfType(otd.S, fld.T) == store.KParam {
											let mut base = xt
											for {
												let bk = store.KindOfType(xTyped.S, base)
												if bk == store.KPointer || bk == store.KOwn {
													let ops = store.OperandsOf(xTyped.S, base)
													if ops.Len() > 0 {
														base = ops[0]
														continue
													}
												}
												break
											}
											if store.KindOfType(xTyped.S, base) == store.KInstance {
												let args = store.OperandsOf(xTyped.S, base)
												let pIdx = store.ArgOf(otd.S, fld.T)
												if pIdx >= 0 && pIdx < args.Len() {
													return (xTyped, xuPath, dense.OptOf(args[pIdx]))
												}
											}
										}
										return (otd, unitPkgPath((*sc).inp.Units[ouIdx]), dense.OptOf(fld.T))
									}
								}
								break
							}
						}
					case option.None:
					}
				case option.None:
				}
			}
		case option.None:
		}
	}
	(typed, uPath, dense.NoID[store.TKey]())
}

func goArgsHaveFuncValue(
	sc mut silentCtx,
	g ProgramGraph,
	uIdx int,
	fIdx int,
	typed load.Typed,
	t syntax.Tree,
	ce syntax.CallExpr,
) bool {
	for ai in 0..syntax.Len(ce.Args) {
		let arg = syntax.Item(t, ce.Args, ai)
		if syntax.KindOf(t, arg) == syntax.KFuncLit {
			return true
		}
		let (atTyped, _, argOpt) = resolveSilentNodeTKey(sc, g, uIdx, fIdx, typed, arg, 0)
		match dense.Unpack(argOpt) {
		case option.Some{Value: at}:
			let ak = store.KindOfType(atTyped.S, at)
			if ak == store.KSig || ak == store.KOwn || ak == store.KEntry {
				return true
			}
		case option.None:
		}
	}
	false
}

func catchCallLeavesTrace(
	sc mut silentCtx,
	g ProgramGraph,
	uIdx int,
	fIdx int,
	p syntax.Parsed,
	cNode dense.ID[syntax.Node],
) bool {
	ensureSilentUnit(sc, g, uIdx)
	let u = (*sc).inp.Units[uIdx]
	let typed = match u.Typed {
	case option.Some{Value: td}:
		td
	case option.None:
		return false
	}
	let pnodeTypes = (*sc).unitTypes[uIdx]
	let pnodeCalls = (*sc).unitCalls[uIdx]
	let pnodeCaps = (*sc).unitCaps[uIdx]
	let aliases = (*sc).unitAliases[uIdx][fIdx]
	let goAliases = (*sc).unitGoAliases[uIdx][fIdx]
	let t = p.Tree
	let ce = syntax.CallExprOf(t, cNode)
	let fun = unwrapCallFun(t, ce.Fun)
	let fk = syntax.KindOf(t, fun)
	if fk == syntax.KIdent {
		let fname = NodeText(p, fun)
		if fname == "with" {
			return true
		}
		if fname == "Unreachable" {
			match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, fun)) {
			case bind.Outside:
				return true
			case _:
			}
		}
	}
	let pn = bind.PNodeOf(typed.K.Ps, fIdx, cNode)
	let pi = dense.Index(pn)
	if pi >= 0 && pi < pnodeCaps.Len() && dense.Unpack(pnodeCaps[pi]) != option.None {
		return true
	}
	if isSilentConversionCall(*sc, uIdx, fIdx, typed, p, fun) {
		return false
	}
	let cIdx = if pi >= 0 && pi < pnodeCalls.Len() { pnodeCalls[pi] } else { -1 }
	let mut pkgPath = ""
	let mut fnName = ""
	let mut recvType = ""
	let mut sigOpt option.Option[dense.ID[store.TKey]] = option.None
	let mut isRecv = false
	let mut knownRecv = false
	if cIdx < 0 {
		if fk == syntax.KFuncLit {
			return false
		}
		if fk == syntax.KIdent {
			match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, fun)) {
			case bind.Declared as dec:
				let fnIdx = expr.FnAt(typed.K, dec.At)
				if fnIdx >= 0 && fnIdx < typed.K.Fns.Len() {
					return unitFnImpureMemo(sc, g, uIdx, fnIdx)
				}
				return true
			case _:
				return false
			}
		}
		if fk == syntax.KSelectorExpr {
			let se = syntax.SelectorExprOf(t, fun)
			let sel = NodeText(p, se.Sel)
			fnName = sel
			if syntax.KindOf(t, se.X) == syntax.KIdent {
				let xname = NodeText(p, se.X)
				match goAliases.Get(xname) {
				case option.Some{Value: goPath}:
					let fpi = dense.Index(bind.PNodeOf(typed.K.Ps, fIdx, fun))
					if fpi >= 0 && fpi < pnodeTypes.Len() {
						match dense.Unpack(pnodeTypes[fpi]) {
						case option.Some{Value: ft}:
							if store.KindOfType(typed.S, ft) == store.KSig {
								return isGoEffectPkg(goPath) || !sigHasEmptyUses(typed.S, ft) || sigHasFuncParam(typed.S, ft)
							}
						case option.None:
						}
					}
					return isGoEffectPkg(goPath) || goArgsHaveFuncValue(sc, g, uIdx, fIdx, typed, t, ce)
				case option.None:
				}
				match aliases.Get(xname) {
				case option.Some{Value: path}:
					pkgPath = path
					knownRecv = true
					isRecv = false
				case option.None:
				}
			}
			if pkgPath == "" {
				let (xTyped, xuPath, xOpt) = resolveSilentNodeTKey(sc, g, uIdx, fIdx, typed, se.X, 0)
				match dense.Unpack(xOpt) {
				case option.Some{Value: xt}:
					let (ownerPath, ownerType, _) = nominalTypeOwner(xTyped, xuPath, xt)
					if ownerType != "" && (*sc).opTypes.Get(ownerPath+"\x00"+ownerType) != option.None {
						return true
					}
					let xk = store.KindOfType(xTyped.S, xt)
					if xk == store.KSlice || xk == store.KMap || xk == store.KBasic {
						return false
					}
					pkgPath = ownerPath
					recvType = ownerType
					if pkgPath != "" {
						knownRecv = true
						isRecv = true
					}
				case option.None:
				}
			}
			if sel == "Len" || sel == "Append" || sel == "Get" || sel == "Put" || sel == "Delete" || sel == "Slice" || sel == "Clone" || sel == "Contains" || sel == "Concat" {
				return false
			}
			if pkgPath == "" {
				match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, se.Sel)) {
				case bind.Imported as im:
					let imps = store.ImportPaths(typed.S)
					if im.Ref.Import > uint32(0) && int(im.Ref.Import) <= imps.Len() {
						pkgPath = imps[int(im.Ref.Import)-1]
					}
				case _:
				}
			}
		}
		if pkgPath == "" || fnName == "" {
			return false
		}
	} else {
		let callTo = typed.T.Calls[cIdx]
		sigOpt = option.Some[dense.ID[store.TKey]]{Value: callTo.Callee.Sig}
		isRecv = callTo.Recv
		knownRecv = true
		let localFn = resolveLocalCalledFnIdx(typed, cIdx)
		if localFn >= 0 {
			return unitFnImpureMemo(sc, g, uIdx, localFn)
		}
		if !callTo.Recv && fk == syntax.KSelectorExpr {
			let se = syntax.SelectorExprOf(t, fun)
			fnName = NodeText(p, se.Sel)
			if syntax.KindOf(t, se.X) == syntax.KIdent {
				let xname = NodeText(p, se.X)
				match goAliases.Get(xname) {
				case option.Some{Value: goPath}:
					return isGoEffectPkg(goPath) || !sigHasEmptyUses(typed.S, callTo.Callee.Sig) || sigHasFuncParam(typed.S, callTo.Callee.Sig)
				case option.None:
				}
				match aliases.Get(xname) {
				case option.Some{Value: path}:
					pkgPath = path
				case option.None:
				}
			}
		} else if callTo.Recv && fk == syntax.KSelectorExpr {
			let se = syntax.SelectorExprOf(t, fun)
			fnName = NodeText(p, se.Sel)
			let (xTyped, xuPath, xOpt) = resolveSilentNodeTKey(sc, g, uIdx, fIdx, typed, se.X, 0)
			match dense.Unpack(xOpt) {
			case option.Some{Value: xt}:
				let (ownerPath, ownerType, _) = nominalTypeOwner(xTyped, xuPath, xt)
				if ownerType != "" && (*sc).opTypes.Get(ownerPath+"\x00"+ownerType) != option.None {
					return true
				}
				pkgPath = ownerPath
				recvType = ownerType
			case option.None:
			}
		}
	}
	if pkgPath != "" && fnName != "" {
		match (*sc).unitByPkg.Get(pkgPath) {
		case option.Some{Value: tuIdx}:
			match (*sc).inp.Units[tuIdx].Typed {
			case option.Some{Value: ttd}:
				let candIdx = findMatchingUnitFn(ttd, unitPkgPath((*sc).inp.Units[tuIdx]), fnName, sigOpt, isRecv, knownRecv, recvType, tuIdx == uIdx)
				if candIdx >= 0 {
					return unitFnImpureMemo(sc, g, tuIdx, candIdx)
				}
			case option.None:
			}
		case option.None:
		}
		if impureStdNoNeedsMap.Get(pkgPath+"."+fnName) != option.None {
			return true
		}
		if isStdPkgPath(pkgPath) {
			match sigOpt {
			case option.Some{Value: sig}:
				if !sigHasEmptyUses(typed.S, sig) {
					return true
				}
			case option.None:
			}
			return false
		}
		match sigOpt {
		case option.Some{Value: sig}:
			if !sigHasEmptyUses(typed.S, sig) || sigHasFuncParam(typed.S, sig) {
				return true
			}
		case option.None:
		}
		return false
	}
	match sigOpt {
	case option.Some{Value: sig}:
		if !sigHasEmptyUses(typed.S, sig) {
			return true
		}
	case option.None:
	}
	false
}

func catchArmLeavesTrace(
	sc mut silentCtx,
	g ProgramGraph,
	uIdx int,
	fIdx int,
	typed load.Typed,
	p syntax.Parsed,
	arm syntax.CatchArm,
) bool {
	let t = p.Tree
	let mut ownDefs = Map[int, bool]{}
	let mut stack = slices.WithCapacity[uint32](16)
	let mut kids = slices.WithCapacity[uint32](8)
	for si in 0..syntax.Len(arm.Body) {
		stack = stack.Append(uint32(dense.Index(syntax.Item(t, arm.Body, si))))
	}
	for stack.Len() > 0 {
		let cur = syntax.NodeAt(t, int(stack[stack.Len()-1]))
		stack = stack[:stack.Len()-1]
		let k = syntax.KindOf(t, cur)
		if k == syntax.KVarSpec {
			let vs = syntax.VarSpecOf(t, cur)
			for j in 0..syntax.Len(vs.Names) {
				ownDefs[dense.Index(bind.PNodeOf(typed.K.Ps, fIdx, syntax.Item(t, vs.Names, j)))] = true
			}
		} else if k == syntax.KAsPattern {
			ownDefs[dense.Index(bind.PNodeOf(typed.K.Ps, fIdx, syntax.AsPatternOf(t, cur).Name))] = true
		} else if k == syntax.KRangeStmt {
			let rs = syntax.RangeStmtOf(t, cur)
			match dense.Unpack(rs.Key) {
			case option.Some{Value: kn}:
				if syntax.KindOf(t, kn) == syntax.KIdent {
					ownDefs[dense.Index(bind.PNodeOf(typed.K.Ps, fIdx, kn))] = true
				}
			case option.None:
			}
			if syntax.KindOf(t, rs.Value) == syntax.KIdent {
				ownDefs[dense.Index(bind.PNodeOf(typed.K.Ps, fIdx, rs.Value))] = true
			}
		}
		kids = syntax.Children(t, cur, kids[:0])
		for c in kids {
			stack = stack.Append(c)
		}
	}
	for si in 0..syntax.Len(arm.Body) {
		stack = stack.Append(uint32(dense.Index(syntax.Item(t, arm.Body, si))))
	}
	for stack.Len() > 0 {
		let cur = syntax.NodeAt(t, int(stack[stack.Len()-1]))
		stack = stack[:stack.Len()-1]
		let k = syntax.KindOf(t, cur)
		if k == syntax.KFuncLit {
			continue
		}
		if k == syntax.KReturnStmt || k == syntax.KTryExpr || k == syntax.KAssertStmt {
			return true
		}
		if k == syntax.KAssignStmt {
			let asgn = syntax.AssignStmtOf(t, cur)
			let lhs = Unparen(t, asgn.Lhs)
			if syntax.KindOf(t, lhs) == syntax.KTupleExpr {
				let te = syntax.TupleExprOf(t, lhs)
				for i in 0..syntax.Len(te.Elts) {
					match dense.Unpack(assignRootIdent(t, syntax.Item(t, te.Elts, i))) {
					case option.Some{Value: rid}:
						match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, rid)) {
						case bind.Declared as dec:
							if ownDefs.Get(dense.Index(dec.At)) == option.None {
								return true
							}
						case _:
						}
					case option.None:
					}
				}
			} else {
				match dense.Unpack(assignRootIdent(t, lhs)) {
				case option.Some{Value: rid}:
					match bind.ResolutionOf(typed.K.U, typed.K.Ps, bind.PNodeOf(typed.K.Ps, fIdx, rid)) {
					case bind.Declared as dec:
						if ownDefs.Get(dense.Index(dec.At)) == option.None {
							return true
						}
					case _:
					}
				case option.None:
				}
			}
		}
		if k == syntax.KCallExpr {
			if catchCallLeavesTrace(sc, g, uIdx, fIdx, p, cur) {
				return true
			}
			let ce = syntax.CallExprOf(t, cur)
			stack = stack.Append(uint32(dense.Index(ce.Fun)))
			for ai in 0..syntax.Len(ce.Args) {
				stack = stack.Append(uint32(dense.Index(syntax.Item(t, ce.Args, ai))))
			}
			if syntax.KindOf(t, Unparen(t, ce.Fun)) == syntax.KIdent && NodeText(p, Unparen(t, ce.Fun)) == "with" {
				match dense.Unpack(ce.Trailing) {
				case option.Some{Value: tr}:
					stack = stack.Append(uint32(dense.Index(tr)))
				case option.None:
				}
			}
			continue
		}
		kids = syntax.Children(t, cur, kids[:0])
		for c in kids {
			stack = stack.Append(c)
		}
	}
	false
}

func collectSilentOpTypes(inp Input) Map[string, bool] {
	let mut out = Map[string, bool]{}
	for u in inp.Units {
		let up = unitPkgPath(u)
		let short = stdShortPath(up)
		match u.Typed {
		case option.Some{Value: td}:
			for ifc in td.K.Ifaces {
				for r in ifc.Roles {
					if r.Members.Len() > 0 {
						out[ifc.Path+"\x00"+r.Name] = true
						let rs = stdShortPath(ifc.Path)
						if rs != "" {
							out[rs+"\x00"+r.Name] = true
						}
					}
				}
			}
		case option.None:
		}
		for f in u.Files {
			if f.Parsed.Failed {
				continue
			}
			let t = f.Parsed.Tree
			let fl = syntax.FileOf(t, syntax.Root(t))
			for i in 0..syntax.Len(fl.Decls) {
				let d = syntax.Item(t, fl.Decls, i)
				if syntax.KindOf(t, d) != syntax.KTypeDecl {
					continue
				}
				let td = syntax.TypeDeclOf(t, d)
				match dense.Unpack(td.Spec) {
				case option.Some{Value: sp}:
					if syntax.KindOf(t, sp) == syntax.KInterfaceType {
						let it = syntax.InterfaceTypeOf(t, sp)
						let mut hasOp = false
						for mi in 0..syntax.Len(it.Members) {
							if syntax.KindOf(t, syntax.Item(t, it.Members, mi)) == syntax.KField {
								hasOp = true
								break
							}
						}
						if hasOp {
							let tn = NodeText(f.Parsed, td.Name)
							out[up+"\x00"+tn] = true
							if short != "" {
								out[short+"\x00"+tn] = true
							}
							match dense.Unpack(td.Extern) {
							case option.Some{Value: extNode}:
								let es = syntax.ExternSpecOf(t, extNode)
								if syntax.KindOf(t, es.Target) == syntax.KSelectorExpr {
									let se = syntax.SelectorExprOf(t, es.Target)
									out[NodeText(f.Parsed, se.X)+"\x00"+NodeText(f.Parsed, se.Sel)] = true
								}
							case option.None:
							}
						}
					}
				case option.None:
				}
			}
		}
	}
	out
}

// CheckSilentCatch emits silent-catch (L101) findings for catch arms ignoring failures without action.
func CheckSilentCatch(inp Input, g ProgramGraph, sev uint8, out mut []Finding) {
	if sev == SeverityOff {
		return
	}
	let nUnits = inp.Units.Len()
	let mut unitByPkg = Map[string, int]{}
	for uIdx, u in inp.Units {
		let up = unitPkgPath(u)
		if up != "" {
			unitByPkg[up] = uIdx
			let short = stdShortPath(up)
			if short != "" {
				unitByPkg[short] = uIdx
			}
		}
	}
	let mut sc = silentCtx{
		inp:           inp,
		unitByPkg:     unitByPkg,
		opTypes:       collectSilentOpTypes(inp),
		unitBuilt:     slices.Repeat([]bool{false}, nUnits),
		unitTypes:     slices.Repeat([][]dense.Opt[store.TKey]{[]dense.Opt[store.TKey]{}}, nUnits),
		unitCalls:     slices.Repeat([][]int{[]int{}}, nUnits),
		unitCaps:      slices.Repeat([][]dense.Opt[store.TKey]{[]dense.Opt[store.TKey]{}}, nUnits),
		unitTypeNodes: slices.Repeat([][]bool{[]bool{}}, nUnits),
		unitAliases:   slices.Repeat([][]Map[string, string]{[]Map[string, string]{}}, nUnits),
		unitGoAliases: slices.Repeat([][]Map[string, string]{[]Map[string, string]{}}, nUnits),
		fnPureState:   slices.Repeat([][]uint8{[]uint8{}}, nUnits),
	}
	for uIdx, u in inp.Units {
		if u.Dependency {
			continue
		}
		let typed = match u.Typed {
		case option.Some{Value: td}:
			td
		case option.None:
			continue
		}
		ensureSilentUnit(&sc, g, uIdx)
		for fIdx, f in u.Files {
			let fi = g.FileIndexes[uIdx][fIdx]
			if f.Parsed.Failed {
				continue
			}
			let t = f.Parsed.Tree
			for cRow in fi.Catches {
				let cNode = syntax.NodeAt(t, int(cRow))
				let ce = syntax.CatchExprOf(t, cNode)
				for ai in 0..syntax.Len(ce.Arms) {
					let armNode = syntax.Item(t, ce.Arms, ai)
					if syntax.KindOf(t, armNode) != syntax.KCatchArm {
						continue
					}
					let arm = syntax.CatchArmOf(t, armNode)
					if catchArmReadsFailure(f.Parsed, fIdx, typed, arm) {
						continue
					}
					if catchArmLeavesTrace(&sc, g, uIdx, fIdx, typed, f.Parsed, arm) {
						continue
					}
					let off = syntax.TokPos(f.Parsed, arm.Case)
					let endOff = syntax.TokEnd(f.Parsed, arm.Colon)
					let spanLen = if endOff >= off { endOff - off } else { 1 }
					*out = (*out).Append(semFinding("silent-catch", sev, f.Rel, fi, off, spanLen, "this arm drops the failure: it does not read it, return, fail, or call anything with an effect", []Related{}))
				}
			}
		}
	}
}

// RunSemanticRules executes the checked semantic, boundary, style, and vet rules configured on conf.
func RunSemanticRules(conf Configuration, inp Input, g ProgramGraph, out mut []Finding) {
	match RuleIndex("self-assignment") {
	case option.Some{Value: idx}:
		CheckSelfAssignment(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("wire-key-quote") {
	case option.Some{Value: idx}:
		CheckWireKeyQuote(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("long-parameter-list") {
	case option.Some{Value: idx}:
		let maxP = match conf.Options[idx] {
		case OptMax as m:
			int(m.V.Max)
		case _:
			5
		}
		CheckLongParameterList(inp, g, conf.Severities[idx], maxP, out)
	case option.None:
	}
	match RuleIndex("banned-words") {
	case option.Some{Value: idx}:
		let opts = match conf.Options[idx] {
		case OptWords as w:
			w.V
		case _:
			WordOptions{Words: []string{"shape"}, Verbs: DefaultGenericVerbs(), Glossary: "", Avoid: []AvoidTerm{}}
		}
		CheckBannedWords(inp, g, conf.Severities[idx], opts, out)
	case option.None:
	}
	match RuleIndex("deprecated") {
	case option.Some{Value: idx}:
		CheckDeprecated(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("foreign-where-std") {
	case option.Some{Value: idx}:
		CheckForeignWhereStd(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("foreign-outside-adapter") {
	case option.Some{Value: idx}:
		CheckForeignOutsideAdapter(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("console-outside-entry") {
	case option.Some{Value: idx}:
		CheckConsoleOutsideEntry(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("foreign-error-public") {
	case option.Some{Value: idx}:
		CheckForeignErrorPublic(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("with-at-entry") {
	case option.Some{Value: idx}:
		let opts = match conf.Options[idx] {
		case OptFunctions as fn:
			fn.V
		case _:
			FunctionOptions{Functions: []string{}}
		}
		CheckWithAtEntry(inp, g, conf.Severities[idx], opts, out)
	case option.None:
	}
	match RuleIndex("capability-outside-owner") {
	case option.Some{Value: idx}:
		let opts = match conf.Options[idx] {
		case OptOwners as ow:
			ow.V
		case _:
			OwnerOptions{Owners: Map[string, []string]{}}
		}
		CheckCapabilityOutsideOwner(inp, g, conf.Severities[idx], opts, out)
	case option.None:
	}
	match RuleIndex("test-reads-unexported") {
	case option.Some{Value: idx}:
		CheckTestReadsUnexported(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("unused-declaration") {
	case option.Some{Value: idx}:
		CheckUnusedDeclaration(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("unused-type-parameter") {
	case option.Some{Value: idx}:
		CheckUnusedTypeParameter(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("vacuous-test") {
	case option.Some{Value: idx}:
		CheckVacuousTest(inp, g, conf.Severities[idx], out)
	case option.None:
	}
	match RuleIndex("silent-catch") {
	case option.Some{Value: idx}:
		CheckSilentCatch(inp, g, conf.Severities[idx], out)
	case option.None:
	}
}

test SemanticRulesCatchSelfAssignLongParamForeignStdAndVacuousTest {
	let src = "import go strings\nfunc F(a int, b int, c int, d int, e int, f int) int {\n\tlet mut x = a\n\tx = x\n\tx\n}\nfunc BadTp[T](n int) int { n }\ntest Empty {\n\tlet v = 1\n\tlet _ = v\n}\n"
	let p = syntax.Parse(src)
	assert !p.Failed
	let inp = Input{
		Checked:    false,
		Closed:     false,
		ModuleDirs: Map[string, string]{},
		Glossaries: Map[string, string]{},
		Units:      []UnitInput{UnitInput{
			Module:     "m", Path: "m/p", Dir: "p", Name: "p",
			Dependency: false, HasEntry: false,
			Files:      []FileInput{FileInput{Rel: "p/a.ergo", Src: src, Parsed: p}},
			BindFiles:  []bind.File{}, Typed: option.None,
		}},
	}
	let g = BuildProgramGraph(inp)
	let mut out = []Finding{}
	CheckSelfAssignment(inp, g, SeverityWarning, &out)
	CheckLongParameterList(inp, g, SeverityWarning, 5, &out)
	CheckForeignWhereStd(inp, g, SeverityWarning, &out)
	CheckUnusedTypeParameter(inp, g, SeverityWarning, &out)
	CheckVacuousTest(inp, g, SeverityWarning, &out)
	let mut c159 = false
	let mut c141 = false
	let mut c103 = false
	let mut c116 = false
	let mut c138 = false
	for fn in out {
		if fn.Code == "L159" {
			c159 = true
		}
		if fn.Code == "L141" {
			c141 = true
		}
		if fn.Code == "L103" {
			c103 = true
		}
		if fn.Code == "L116" {
			c116 = true
		}
		if fn.Code == "L138" {
			c138 = true
		}
	}
	assert c159 && c141 && c103 && c116 && c138
}
