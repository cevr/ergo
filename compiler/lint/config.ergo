	if maxT < 0 {
		return BadConfig{Message: "maxTangleMembers is \(maxT); it is a positive number of declarations, or absent for cross-file tangles only"}
	}
	OptTangle{V: TangleOptions{MaxTangleMembers: maxT}}
}

func decodeTestSupportOptions(v JVal) RuleOptions fails BadConfig {
	let mut pkgs = []string{}
	let mut seams = Map[string, []string]{}
	for m in try membersOf(v) {
		if m.Key == "packages" {
			pkgs = try jsonStringSlice(m.Value, "packages")
		} else if m.Key == "seams" {
			seams = try jsonStringMapSlice(m.Value, "seams")
		} else {
			return BadConfig{Message: "unknown option \(strconv.Quote(m.Key)) for production-uses-test-support"}
		}
	}
	for p in pkgs {
		if p == "" {
			return BadConfig{Message: "packages holds an empty package path"}
		}
	}
	for sn, spkgs in seams {
		if sn == "" {
			return BadConfig{Message: "seams holds an empty seam name"}
		}
		for p in spkgs {
			if p == "" {
				return BadConfig{Message: "seams[\(strconv.Quote(sn))] holds an empty package path"}
			}
		}
	}
	OptTestSupport{V: TestSupportOptions{Packages: pkgs, Seams: seams}}
}

func inSeamAreaPkg(pkg string, s SeamConfig) bool {
	if slices.Contains(s.Packages, pkg) {
		return true
	}
	s.Root != "" && (pkg == s.Root || strings.HasPrefix(pkg, s.Root+"/"))
}

func decodeOneSeam(i int, v JVal) SeamConfig fails BadConfig {
	let obj = match v {
	case JObj as o:
		o
	case _:
		return BadConfig{Message: "seams[\(i)] must be an object"}
	}
	let mut s = SeamConfig{Root: "", Packages: []string{}, Entries: []string{}, TestSupport: []string{}, TestThroughEntries: false}
	for m in obj.Members {
		if m.Key == "root" {
			s.Root = try jsonString(m.Value, "root")
		} else if m.Key == "packages" {
			s.Packages = try jsonStringSlice(m.Value, "packages")
		} else if m.Key == "entries" {
			s.Entries = try jsonStringSlice(m.Value, "entries")
		} else if m.Key == "testSupport" {
			s.TestSupport = try jsonStringSlice(m.Value, "testSupport")
		} else if m.Key == "testThroughEntries" {
			s.TestThroughEntries = try jsonBool(m.Value, "testThroughEntries")
		} else {
			return BadConfig{Message: "unknown field \(strconv.Quote(m.Key)) in seams[\(i)]"}
		}
	}
	if s.Root == "" && s.Packages.Len() == 0 {
		return BadConfig{Message: "seams[\(i)] needs root or packages"}
	}
	for p in s.Packages {
		if p == "" {
			return BadConfig{Message: "seams[\(i)].packages holds an empty package path"}
		}
	}
	if s.Entries.Len() == 0 {
		return BadConfig{Message: "seams[\(i)] needs at least one entry package"}
	}
	for e in s.Entries {
		if e == "" {
			return BadConfig{Message: "seams[\(i)].entries holds an empty package path"}
		}
		if !inSeamAreaPkg(e, s) {
			return BadConfig{Message: "seams[\(i)]: entry \(strconv.Quote(e)) is outside the seam area"}
		}
	}
	for ts in s.TestSupport {
		if ts == "" {
			return BadConfig{Message: "seams[\(i)].testSupport holds an empty package path"}
		}
		if !inSeamAreaPkg(ts, s) {
			return BadConfig{Message: "seams[\(i)]: testSupport \(strconv.Quote(ts)) is outside the seam area"}
		}
	}
	s
}

func decodeSeamOptions(v JVal) RuleOptions fails BadConfig {
	let mut seams = []SeamConfig{}
	for m in try membersOf(v) {
		if m.Key == "seams" {
			match m.Value {
			case JNull:
			case JArr as a:
				for i, item in a.Items {
					seams = seams.Append(try decodeOneSeam(i, item))
				}
			case _:
				return BadConfig{Message: "seams must be an array"}
			}
		} else {
			return BadConfig{Message: "unknown option \(strconv.Quote(m.Key)) for seam-entrypoints"}
		}
	}
	OptSeams{V: SeamOptions{Seams: seams}}
}

func decodeRuleOptions(name string, v JVal) RuleOptions fails BadConfig {
	if name == "cognitive-complexity" || name == "cyclomatic-complexity" || name == "halstead-difficulty" || name == "long-parameter-list" || name == "large-value-copy" {
		return try decodeMaxOptions(name, v)
	}
	if name == "banned-words" {
		return try decodeWordOptions(v)
	}
	if name == "concept-file-names" {
		return try decodeSuffixOptions(v)
	}
	if name == "with-at-entry" {
		return try decodeFunctionOptions(v)
	}
	if name == "capability-outside-owner" {
		return try decodeOwnerOptions(v)
	}
	if name == "layer" {
		return try decodeLayerOptions(v)
	}
	if name == "file-name-case" {
		return try decodeFileNameCaseOptions(v)
	}
	if name == "long-file" {
		return try decodeLongFileOptions(v)
	}
	if name == "wide-directory" {
		return try decodeWideDirOptions(v)
	}
	if name == "wide-observed-interface" {
		return try decodeWideInterfaceOptions(v)
	}
	if name == "declaration-tangle" {
		return try decodeTangleOptions(v)
	}
	if name == "production-uses-test-support" {
		return try decodeTestSupportOptions(v)
	}
	if name == "seam-entrypoints" {
		return try decodeSeamOptions(v)
	}
	OptNone
}

func applySetting(sevs mut []uint8, opts mut []RuleOptions, name string, s Setting) fails BadConfig {
	let idx = match RuleIndex(name) {
	case option.Some{Value: i}:
		i
	case option.None:
		return BadConfig{Message: "unknown rule \(name)"}
	}
	let meta = allRulesList[idx]
	if s.HasOptions {
		if !meta.HasOptions {
			return BadConfig{Message: "rule \(name) takes no options"}
		}
		(*opts)[idx] = decodeRuleOptions(name, s.Options) catch {
		case BadConfig as e:
			return BadConfig{Message: "rule \(name): invalid options: \(e.Message)"}
		}
	}
	if s.HasSeverity {
		(*sevs)[idx] = s.Severity
	} else if (*sevs)[idx] == SeverityOff {
		(*sevs)[idx] = meta.Default
	}
}

func defaultRuleOption(meta RuleMeta) RuleOptions {
	if !meta.HasOptions {
		return OptNone
	}
	decodeRuleOptions(meta.Name, JNull) catch {
	case _:
		OptNone
	}
}

func validateTopPresetAndRuleNames(doc Config, presets []string) fails BadConfig {
	if doc.Version != ConfigVersion {
		return BadConfig{Message: "lint configuration version \(doc.Version) is not supported; write \"version\": \(ConfigVersion)"}
	}
	if doc.Packs.Len() > 0 {
		return BadConfig{Message: "the configuration selects rule packs that were not loaded"}
	}
	for p in doc.Extends {
		if strings.Contains(p, "/") {
			return BadConfig{Message: "preset \(p) names no selected rule pack"}
		}
	}
	for p in presets {
		if strings.Contains(p, "/") {
			return BadConfig{Message: "preset \(p) names no selected rule pack"}
		}
	}
	for name, _ in doc.Rules {
		if strings.Contains(name, "/") {
			return BadConfig{Message: "lint rule \(name) names no selected rule pack"}
		}
	}
}

// Configure resolves effective severities and validated options over BuiltinRules.
func Configure(doc Config, presets []string, glossaries Map[string, string]) Configuration fails BadConfig {
	try validateTopPresetAndRuleNames(doc, presets)
	let n = allRulesList.Len()
	let mut sevs = slices.Repeat([]uint8{SeverityOff}, n)
	let mut opts = slices.WithCapacity[RuleOptions](n)
	for meta in allRulesList {
		opts = opts.Append(defaultRuleOption(meta))
	}
	let emptySet = Setting{Severity: SeverityOff, HasSeverity: false, HasOptions: false, Options: JNull}
	let mut layers = []string{Recommended}
	for e in doc.Extends {
		layers = layers.Append(e)
	}
	for p in presets {
		layers = layers.Append(p)
	}
	let mut seenPresets = Map[string, bool]{}
	for layerName in layers {
		let (pRules, ok) = PresetRuleNames(layerName)
		if !ok {
			return BadConfig{Message: "unknown preset \(layerName)"}
		}
		match seenPresets.Get(layerName) {
		case option.Some:
			return BadConfig{Message: "preset \(layerName) is applied twice"}
		case option.None:
			seenPresets[layerName] = true
		}
		for rn in pRules {
			try applySetting(&sevs, &opts, rn, emptySet)
		}
	}
	let mut ruleNames = []string{}
	for k, _ in doc.Rules {
		ruleNames = ruleNames.Append(k)
	}
	let sortedNames = slices.Sort(ruleNames)
	for name in sortedNames {
		if IsReservedRuleName(name) {
			return BadConfig{Message: "\(name) is the runner's and has a fixed severity"}
		}
		match doc.Rules.Get(name) {
		case option.Some{Value: s}:
			try applySetting(&sevs, &opts, name, s)
		case option.None:
		}
	}
	match RuleIndex("banned-words") {
	case option.Some{Value: bi}:
		if sevs[bi] != SeverityOff {
			match opts[bi] {
			case OptWords as w:
				if w.V.Glossary != "" {
					let path = if strings.HasPrefix(w.V.Glossary, "/") || doc.Dir == "" {
						w.V.Glossary
					} else {
						CleanSlashPath(doc.Dir + "/" + w.V.Glossary)
					}
					match glossaries.Get(path) {
					case option.Some{Value: gText}:
						opts[bi] = OptWords{V: WordOptions{..w.V, Avoid: ParseGlossary(gText)}}
					case option.None:
						return BadConfig{Message: "rule banned-words: glossary \(path) not found"}
					}
				}
			case _:
			}
		}
	case option.None:
	}
	let mut fnCase = FileNameCaseOptions{Case: "", Dirs: false}
	let mut fnActive = false
	match RuleIndex("file-name-case") {
	case option.Some{Value: fi}:
		if sevs[fi] != SeverityOff {
			match opts[fi] {
			case OptFileNameCase as fnc:
				if fnc.V.Case != "" {
					fnCase = fnc.V
					fnActive = true
				}
			case _:
			}
		}
	case option.None:
	}
	Configuration{
		Severities:         sevs,
		Options:            opts,
		FileNameCaseOpts:   fnCase,
		FileNameCaseActive: fnActive,
	}
}

// ConfigStatuses returns the initial RuleStatus slice for every rule in Configuration.
func ConfigStatuses(c Configuration) []RuleStatus {
	let mut out = slices.WithCapacity[RuleStatus](allRulesList.Len())
	for i, meta in allRulesList {
		let sev = c.Severities[i]
		let st = if sev == SeverityOff { StatusOff } else { StatusNotEvaluated }
		out = out.Append(RuleStatus{
			Rule:     meta.Name,
			Code:     meta.Code,
			Severity: SeverityName(sev),
			Status:   st,
			Reason:   "",
		})
	}
	out
}

test ConfigParsingAndLayering {
	let cfg = ParseConfig(`{"version":1,"extends":["layout"],"rules":{"file-name-case":{"severity":"error","options":{"case":"snake_case","dirs":true}},"long-file":{"options":{"maxFileLines":500}}}}`) catch {
	case _:
		assert false
		return
	}
	let emptyG = Map[string, string]{}
	let conf = Configure(cfg, []string{"strict"}, emptyG) catch {
	case _:
		assert false
		return
	}
	assert conf.FileNameCaseActive
	assert conf.FileNameCaseOpts.Case == CaseSnake
	assert conf.FileNameCaseOpts.Dirs
	match RuleIndex("long-file") {
	case option.Some{Value: i}:
		assert conf.Severities[i] == SeverityHint
		match conf.Options[i] {
		case OptLongFile as lf:
			assert lf.V.MaxFileLines == 500
		case _:
			assert false
		}
	case option.None:
		assert false
	}
	let mut dupFailed = false
	let dupPreset = Configure(cfg, []string{"layout"}, emptyG) catch {
	case BadConfig as e:
		dupFailed = true
		assert strings.Contains(e.Message, "applied twice")
		Configuration{Severities: []uint8{}, Options: []RuleOptions{}, FileNameCaseOpts: FileNameCaseOptions{Case: "", Dirs: false}, FileNameCaseActive: false}
	}
	assert dupFailed
	let _ = dupPreset
}
