func decodeFileNameCaseOptions(v JVal) RuleOptions fails BadConfig {
	let mut style = ""
	let mut dirs = false
	for m in try membersOf(v) {
		if m.Key == "case" {
			style = try jsonString(m.Value, "case")
		} else if m.Key == "dirs" {
			dirs = try jsonBool(m.Value, "dirs")
		} else {
			return BadConfig{Message: "unknown option \(strconv.Quote(m.Key)) for file-name-case"}
		}
	}
	let o = FileNameCaseOptions{Case: style, Dirs: dirs}
	try ValidateFileNameCaseOptions(o)
	OptFileNameCase{V: o}
}

func decodeLongFileOptions(v JVal) RuleOptions fails BadConfig {
	let mut maxLines = 0
	for m in try membersOf(v) {
		if m.Key == "maxFileLines" {
			maxLines = try jsonInt(m.Value, "maxFileLines")
		} else {
			return BadConfig{Message: "unknown option \(strconv.Quote(m.Key)) for long-file"}
		}
	}
	if maxLines < 0 {
		return BadConfig{Message: "maxFileLines is \(maxLines); it is a positive number of lines, or absent for no finding"}
	}
	OptLongFile{V: LongFileOptions{MaxFileLines: maxLines}}
}

func decodeWideDirOptions(v JVal) RuleOptions fails BadConfig {
