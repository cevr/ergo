import compiler/syntax
import option

// ByteLower marks lowercase ASCII letters a..z.
let ByteLower = uint8(1)

// ByteUpper marks uppercase ASCII letters A..Z.
let ByteUpper = uint8(2)

// ByteDigit marks ASCII decimal digits 0..9.
let ByteDigit = uint8(4)

// ByteUnderscore marks the ASCII underscore byte.
let ByteUnderscore = uint8(8)

// ByteBlank marks ASCII space, tab, carriage return, and newline.
let ByteBlank = uint8(16)

// ByteHex marks ASCII hexadecimal digits.
let ByteHex = uint8(32)

// ByteHyphen marks the ASCII hyphen-minus byte.
let ByteHyphen = uint8(64)

// ByteJSONPunct marks JSON structural punctuation bytes.
let ByteJSONPunct = uint8(128)

// ByteMask returns the compiled byte-class bitmask for ASCII byte b.
func ByteMask(b byte) uint8 { byte(asciiByteTable[int(b)]) }

// NodeIdxIdent marks KIdent rows collected into FileIndex.
let NodeIdxIdent = uint8(1)

// NodeIdxCall marks KCallExpr rows collected into FileIndex.
let NodeIdxCall = uint8(2)

// NodeIdxSelector marks KSelectorExpr rows collected into FileIndex.
let NodeIdxSelector = uint8(4)

// NodeIdxDeclStmt marks KDeclStmt rows collected into FileIndex.
let NodeIdxDeclStmt = uint8(8)

// NodeIdxSwitch marks switch, match, and catch rows collected into FileIndex.
let NodeIdxSwitch = uint8(16)

// NodeIdxAssign marks KAssignStmt rows collected into FileIndex.
let NodeIdxAssign = uint8(32)

// NodeIdxBinary marks KBinaryExpr rows collected into FileIndex.
let NodeIdxBinary = uint8(64)

// NodeIdxField marks KField rows collected into FileIndex.
let NodeIdxField = uint8(128)

// NodeRoleTestLaw marks test and law declarations.
let NodeRoleTestLaw = uint8(1)

// NodeRoleFuncLit marks function literal expressions.
let NodeRoleFuncLit = uint8(2)

// NodeRoleCatch marks catch expressions.
let NodeRoleCatch = uint8(4)

// NodeRoleLoop marks for and range loop statements.
let NodeRoleLoop = uint8(8)

// NodeRoleBranchDecision marks cyclomatic decision nodes.
let NodeRoleBranchDecision = uint8(16)

// NodeRoleTypeSwitch marks union match statements.
let NodeRoleTypeSwitch = uint8(32)

// NodeRoleTopDecl marks top-level file declarations.
let NodeRoleTopDecl = uint8(64)

// NodeRoleHalsteadOp marks nodes that contribute a fixed Halstead operator.
let NodeRoleHalsteadOp = uint8(128)

// NodeIdxMask returns the collection bitmask for a syntax node kind.
func NodeIdxMask(k uint8) uint8 {
	let i = int(k)
	if i >= nodeIdxTable.Len() {
		return uint8(0)
	}
	byte(nodeIdxTable[i])
}

// NodeRoleMask returns the role bitmask for a syntax node kind.
func NodeRoleMask(k uint8) uint8 {
	let i = int(k)
	if i >= nodeRoleTable.Len() {
		return uint8(0)
	}
	byte(nodeRoleTable[i])
}

// HalsteadFixedOp returns the fixed Halstead operator index for a syntax node kind, or 0 for none.
func HalsteadFixedOp(k uint8) uint8 {
	let i = int(k)
	if i >= halsteadNodeTable.Len() {
		return uint8(0)
	}
	byte(halsteadNodeTable[i])
}

// StdCoveredBy returns the std package covering a Go standard-library import path.
func StdCoveredBy(goPath string) (string, bool) {
	match stdCoverageMap.Get(goPath) {
	case option.Some{Value: v}:
		(v, true)
	case option.None:
		("", false)
	}
}

