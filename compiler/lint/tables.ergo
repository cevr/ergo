// IsStdRuntimePureOrInert reports whether a runtime/v1 body name adds no footprint.
func IsStdRuntimePureOrInert(name string) bool {
	match pureRuntimeBodyMap.Get(name) {
	case option.Some{Value: v}:
		v
	case option.None:
		false
	}
}

func byteClassOK(b byte) bool {
	let m = ByteMask(b)
	let lower = b >= 'a' && b <= 'z'
	let upper = b >= 'A' && b <= 'Z'
	let digit = b >= '0' && b <= '9'
	let under = b == '_'
	let blank = b == ' ' || b == '\t' || b == '\r' || b == '\n'
	let hex = digit || (b >= 'a' && b <= 'f') || (b >= 'A' && b <= 'F')
	let hyphen = b == '-'
	let punct = b == '{' || b == '}' || b == '[' || b == ']' || b == ':' || b == ','
		(m&ByteLower != 0) == lower &&
		(m&ByteUpper != 0) == upper &&
		(m&ByteDigit != 0) == digit &&
		(m&ByteUnderscore != 0) == under &&
		(m&ByteBlank != 0) == blank &&
		(m&ByteHex != 0) == hex &&
		(m&ByteHyphen != 0) == hyphen &&
		(m&ByteJSONPunct != 0) == punct
}

law ByteTableMatchesPredicates(n int) {
	let mut ok = true
	for i in 0..256 {
		let b = byte(((n+i)%256 + 256) % 256)
		ok = ok && byteClassOK(b)
	}
	ok
}

law NodeTablesMatchKinds(n int) {
	let k = uint8(((n % 72) + 72) % 72)
	let idx = NodeIdxMask(k)
	let role = NodeRoleMask(k)
	let h = HalsteadFixedOp(k)
	let idxOK = (idx&NodeIdxCall != 0) == (k == syntax.KCallExpr) &&
		(idx&NodeIdxIdent != 0) == (k == syntax.KIdent) &&
		(idx&NodeIdxSelector != 0) == (k == syntax.KSelectorExpr) &&
		(idx&NodeIdxDeclStmt != 0) == (k == syntax.KDeclStmt) &&
		(idx&NodeIdxAssign != 0) == (k == syntax.KAssignStmt) &&
		(idx&NodeIdxBinary != 0) == (k == syntax.KBinaryExpr) &&
		(idx&NodeIdxField != 0) == (k == syntax.KField) &&
		(idx&NodeIdxSwitch != 0) == (k == syntax.KSwitchStmt || k == syntax.KTypeSwitchStmt || k == syntax.KCatchExpr)
	let roleOK = (role&NodeRoleTypeSwitch != 0) == (k == syntax.KTypeSwitchStmt) &&
		(role&NodeRoleFuncLit != 0) == (k == syntax.KFuncLit) &&
		(role&NodeRoleCatch != 0) == (k == syntax.KCatchExpr) &&
		(role&NodeRoleLoop != 0) == (k == syntax.KForStmt || k == syntax.KRangeStmt) &&
		(role&NodeRoleHalsteadOp != 0) == (h != uint8(0))
	idxOK && roleOK
}
