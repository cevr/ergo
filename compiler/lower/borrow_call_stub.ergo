import compiler/check/bind
import compiler/check/expr
import compiler/check/store
import compiler/syntax
import dense
import option
import strings

// The unit caller has just this statement. A checked fixed receiver
// address is its only operand; target and transform decisions are made
// before CONTROL opens the IR body.
func planBorrowInvoke(st fnb, x dense.ID[syntax.Node], ce syntax.CallExpr, formals int) option.Option[borrowInvoke] fails Unported {
	if dense.Unpack(ce.Trailing) != option.None || syntax.Len(ce.Args) != 0 {
		return option.None
	}
	let p = st.p
	let sel = match syntax.ViewOf(p.Tree, ce.Fun) {
	case syntax.SelectorExpr as s:
		s
	case _:
		return option.None
	}
	let site = dense.SideOf(st.callAt, bind.PNodeOf(st.k.Ps, st.file, x))
	if site == 0 || !st.calls[site-1].Recv {
		return option.None
	}
	let target = st.calls[site-1].Callee
	let i = expr.FnAt(st.k, bind.PNodeOf(st.k.Ps, target.File, target.Name))
	if i < 0 {
		return stop("borrow call: no local checked target")
	}
	let recv = try planBorrowField(st, sel.X, formals)
	let name = try borrowedUnitName(st, st.k.Fns[i], recv.t)
	option.Some[borrowInvoke]{Value: borrowInvoke{recv: recv, recvAt: syntax.NodePos(p, sel.X), callAt: syntax.NodePos(p, x), name: name}}
}

func borrowedUnitName(st fnb, target expr.Fn, record dense.ID[store.TKey]) string fails Unported {
	let p = st.k.Parsed[target.File]
	let name = nameText(p, target.Name)
	if name == "main" || name == "Close" || target.Close || declCount(st, name) != 1 {
		return stop("borrow call: reserved or overloaded name")
	}
	let d = match syntax.ViewOf(p.Tree, target.Decl) {
	case syntax.FuncDecl as f:
		f
	case _:
		return stop("borrow call: no ordinary declaration")
	}
	if dense.Unpack(d.Extern) != option.None || dense.Unpack(d.Recv) != option.None || dense.Unpack(d.TypeParams) != option.None {
		return stop("borrow call: not an ordinary receiver declaration")
	}
	let ops = store.OperandsOf(st.s, target.Sig)
	if store.KindOfType(st.s, target.Sig) != store.KSig || ops.Len() != 4 || target.Names.Len() != 1 || target.Takes.Len() != 1 || target.Takes[0] {
		return stop("borrow call: receiver ABI")
	}
	if store.KindOfType(st.s, ops[1]) != store.KTuple || store.OperandsOf(st.s, ops[1]).Len() != 0 || !emptyRow(st, ops[2]) || !emptyRow(st, ops[3]) {
		return stop("borrow call: result or row")
	}
	match borrowParamBase(st, ops[0]) {
	case option.Some{Value: base}:
		if base != record {
			return stop("borrow call: receiver type")
		}
	case option.None:
		return stop("borrow call: receiver is not borrowed")
	}
	if !strings.Contains(try goName(st, name, option.Some{Value: record}), ".") {
		return stop("borrow call: does not lower as a method")
	}
	try borrowedUnitBody(st, target, p)
	try borrowedCallRewrite(st, name)
	name
}

// A sole scalar store opens no frame and has no calls; the leaf never
// passes inlineRule for a nonboxed result. A unit method has no result
// to discard, no table domain, and a method call does not merge.
func borrowedUnitBody(st fnb, target expr.Fn, p syntax.Parsed) fails Unported {
	let body = match dense.Unpack(target.Body) {
	case option.Some{Value: b}:
		b
	case option.None:
		return stop("borrow call: no body")
	}
	let block = match syntax.ViewOf(p.Tree, body) {
	case syntax.BlockStmt as b:
		b
	case _:
		return stop("borrow call: no block")
	}
	if syntax.Len(block.List) != 1 {
		return stop("borrow call: expected a sole scalar store")
	}
	let node = syntax.Item(p.Tree, block.List, 0)
	let write = match syntax.ViewOf(p.Tree, node) {
	case syntax.AssignStmt as a:
		a
	case _:
		return stop("borrow call: expected a store")
	}
	let formal = match dense.Unpack(target.Names[0]) {
	case option.Some{Value: at}:
		bind.PNodeOf(st.k.Ps, target.File, at)
	case option.None:
		return stop("borrow call: unnamed receiver")
	}
	let mut at = st
	at.p = p
	at.file = target.File
	at.params = []dense.ID[store.PNode]{formal}
	at.locals = []int{0}
	let _ = try planBorrowWrite(at, node, write, 1)
	try check(at, write.Rhs)
}

func borrowedCallRewrite(st fnb, name string) fails Unported {
	if lawOver(st, name) {
		return stop("borrow call: rewrite law")
	}
	match st.rootImports {
	case option.Some[[]expr.Dep] as deps:
		for dep in deps.Value {
			let mut other = st
			other.k = dep.K
			if lawOver(other, name) {
				return stop("borrow call: imported rewrite law")
			}
		}
	case option.None:
		return stop("borrow call: rewrite scope not known")
	}
}
