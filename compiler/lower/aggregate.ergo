import compiler/check/bind
import compiler/check/expr
import compiler/check/store
import compiler/ir
import compiler/syntax
import dense
import option

type aggregate {
	typ    string,
	record int,
	keys   []string,
	values []dense.ID[syntax.Node],
}

// aggregateLiteral resolves the literal's operands in source order. A
// new slice has no seeded capacity in an immutable binding or tail; an
// ordinary record with every field set has no default or slot adapter.
func aggregateLiteral(st fnb, binds localBinds, x dense.ID[syntax.Node], cl syntax.CompositeLit) aggregate fails Unported {
	let t = try typeOf(st, x, "CompositeLit")
	let gt = shapeGo(st, t)
	let checked = dense.Unpack(cl.Type) != option.None
	if store.KindOfType(st.s, t) == store.KSlice {
		if gt == "" || !checked || dense.Unpack(cl.Base) != option.None {
			return stop("slice literal of unsupported shape")
		}
		let elem = store.OperandsOf(st.s, t)[0]
		let mut values = []dense.ID[syntax.Node]{}
		for i in 0..syntax.Len(cl.Elts) {
			let e = syntax.Item(st.p.Tree, cl.Elts, i)
			if syntax.KindOf(st.p.Tree, e) == syntax.KKeyValueExpr || (try typeOf(st, e, "slice element")) != elem {
				return stop("slice literal with an adapted element")
			}
			values = values.Append(e)
		}
		return aggregate{typ: gt, record: -1, keys: []string{}, values: values}
	}
	let r = ordinaryRecord(st, t)
	if gt == "" || !checked {
		return stop("literal of no plain record")
	}
	let (okOpt, optElem) = optionKind(st, t)
	let fields = if r >= 0 {
		st.k.Recs[r].Fields
	} else if okOpt == "Some" {
		[]expr.Field{expr.Field{Name: "Value", T: optElem}}
	} else {
		match importedFields(st, t) {
		case option.Some{Value: fields}:
			fields
		case option.None:
			if store.KindOfType(st.s, t) == store.KNamed {
				let vname = store.TypeNameText(st.s, store.ArgOf(st.s, t))
				match unionDeclParent(st, vname) {
				case option.Some{Value: parent}:
					let (vp, v, _) = parent
					match syntax.ViewOf(vp.Tree, v) {
					case syntax.VariantSpec as variant:
						if dense.Unpack(variant.TypeArgs) != option.None {
							return stop("literal of no plain record")
						}
						match unionRecordFields(st, vname) {
						case option.Some{Value: vfs}:
							vfs
						case option.None:
							return stop("literal of no plain record")
						}
					case _:
						return stop("literal of no plain record")
					}
				case option.None:
					return stop("literal of no plain record")
				}
			} else {
				return stop("literal of no plain record")
			}
		}
	}
	let n = syntax.Len(cl.Elts)
	match dense.Unpack(cl.Base) {
	case option.Some{Value: base}:
		if r < 0 || holdsValue(st, t) {
			return stop("record update of a non-basic shape")
		}
		if syntax.KindOf(st.p.Tree, base) != syntax.KIdent {
			return stop("record update of a computed base")
		}
		if (try typeOf(st, base, "update base")) != t {
			return stop("record update of another type")
		}
		let _ = try paramLocal(st, binds, base)
	case option.None:
		if n != fields.Len() {
			return stop("record literal without every field")
		}
	}
	let mut keys = []string{}
	let mut values = []dense.ID[syntax.Node]{}
	for i in 0..n {
		let e = syntax.Item(st.p.Tree, cl.Elts, i)
		let (j, v) = match syntax.ViewOf(st.p.Tree, e) {
		case syntax.KeyValueExpr as kv:
			(fieldIndex(fields, nameText(st.p, kv.Key)), kv.Value)
		case _:
			(i, e)
		}
		if j < 0 || j >= fields.Len() {
			return stop("record key")
		}
		let f = fields[j]
		if has(keys, f.Name) || (try typeOf(st, v, "field value")) != f.T {
			return stop("record literal with a duplicate or adapted field")
		}
		keys = keys.Append(f.Name)
		values = values.Append(v)
	}
	aggregate{typ: gt, record: r, keys: keys, values: values}
}

func fieldIndex(fields []expr.Field, name string) int {
	for i, f in fields {
		if f.Name == name {
			return i
		}
	}
	-1
}

func emitAggregate(st fnb, binds localBinds, b mut ir.Builder, x dense.ID[syntax.Node], cl syntax.CompositeLit, at ir.Pos) uint32 fails Unported | ir.Malformed {
	let a = try aggregateLiteral(st, binds, x, cl)
	let base = match dense.Unpack(cl.Base) {
	case option.Some{Value: bx}:
		try value(st, binds, b, bx)
	case option.None:
		uint32(0)
	}
	let mut elems = []uint32{}
	for e in a.values {
		elems = elems.Append(try value(st, binds, b, e))
	}
	let mut names = a.keys
	if base != 0 {
		for f in st.k.Recs[a.record].Fields {
			if !has(a.keys, f.Name) {
				names = names.Append(f.Name)
				elems = elems.Append(try ir.Row(b, ir.KindCode(ir.TExpr, "field"), at, []uint32{base, ir.Text(b, f.Name)}))
			}
		}
	}
	let mut keyIDs = []uint32{}
	for name in names {
		keyIDs = keyIDs.Append(ir.Text(b, name))
	}
	try ir.Row(b, ir.KindCode(ir.TExpr, "lit"), at, []uint32{ir.Text(b, a.typ), ir.List(b, elems), ir.List(b, keyIDs)})
}

// field selects a checked field, not a method value or a package member.
func field(st fnb, binds localBinds, x dense.ID[syntax.Node], se syntax.SelectorExpr) string fails Unported {
	let t = try typeOf(st, se.X, "selector operand")
	if ordinaryRecord(st, t) < 0 {
		let (okOpt, optElem) = optionKind(st, t)
		if okOpt == "Some" {
			let name = nameText(st.p, se.Sel)
			if name == "Value" && (try typeOf(st, x, "SelectorExpr")) == optElem {
				return name
			}
			return stop("selector that is no imported field")
		}
		match importedFields(st, t) {
		case option.Some{Value: fields}:
			// The selector's type is checked in the consumer's pool.
			let name = nameText(st.p, se.Sel)
			let i = fieldIndex(fields, name)
			if i < 0 || fields[i].T != (try typeOf(st, x, "SelectorExpr")) {
				return stop("selector that is no imported field")
			}
			return name
		case option.None:
		}
		if store.KindOfType(st.s, t) == store.KNamed && shapeGo(st, t) != "" {
			let vname = store.TypeNameText(st.s, store.ArgOf(st.s, t))
			match unionDeclParent(st, vname) {
			case option.Some{Value: parent}:
				let (vp, v, _) = parent
				if syntax.KindOf(vp.Tree, v) == syntax.KVariantSpec {
					match unionRecordFields(st, vname) {
					case option.Some{Value: fs}:
						let name = nameText(st.p, se.Sel)
						let i = fieldIndex(fs, name)
						if i >= 0 && fs[i].T == (try typeOf(st, x, "SelectorExpr")) && ordinaryFieldName(name) {
							return name
						}
					case option.None:
					}
				}
			case option.None:
			}
		}
		return try unionField(st, x, se)
	}
	try fieldOn(st, x, se, t)
}

// fieldOn also serves a place whose caller has checked and peeled one
// borrow marker. It only resolves the member; it does not admit the place
// or say how to read or write it.
func fieldOn(st fnb, x dense.ID[syntax.Node], se syntax.SelectorExpr, recordType dense.ID[store.TKey]) string fails Unported {
	let r = ordinaryRecord(st, recordType)
	if r < 0 || shapeGo(st, recordType) == "" {
		return stop("selector on no plain record")
	}
	let t = try typeOf(st, x, "SelectorExpr")
	let name = nameText(st.p, se.Sel)
	let fs = st.k.Recs[r].Fields
	let i = fieldIndex(fs, name)
	if i < 0 || fs[i].T != t {
		return stop("selector that is no field")
	}
	name
}

// readPlace admits immutable local roots and nested record fields, never
// a borrow, computed receiver or a place passed to an operation that writes.
func readPlace(st fnb, binds localBinds, x dense.ID[syntax.Node]) fails Unported {
	match syntax.ViewOf(st.p.Tree, x) {
	case syntax.Name:
		let _ = try paramLocal(st, binds, x)
	case syntax.SelectorExpr as se:
		let _ = try field(st, binds, x, se)
		try readPlace(st, binds, se.X)
	case syntax.ParenExpr as pe:
		try readPlace(st, binds, pe.X)
	case _:
		return stop("read of a computed place")
	}
}

// sliceIndex admits Go's checked read. This straight-line profile has
// no dominating comparisons from which the oracle can prove bounds.
func sliceIndex(st fnb, x dense.ID[syntax.Node], ie syntax.IndexExpr) dense.ID[syntax.Node] fails Unported {
	let t = try typeOf(st, ie.X, "index operand")
	if store.KindOfType(st.s, t) != store.KSlice || shapeGo(st, t) == "" || syntax.Len(ie.Indices) != 1 {
		return stop("index of no admitted slice")
	}
	if (try typeOf(st, x, "IndexExpr")) != store.OperandsOf(st.s, t)[0] {
		return stop("slice read with an adapted element")
	}
	syntax.Item(st.p.Tree, ie.Indices, 0)
}

func sliceCut(st fnb, x dense.ID[syntax.Node], sx syntax.SliceExpr) ([]dense.Opt[syntax.Node], dense.ID[store.TKey]) fails Unported {
	let t = try typeOf(st, sx.X, "slice operand")
	if store.KindOfType(st.s, t) != store.KSlice || shapeGo(st, t) == "" {
		return stop("slice cut of non-slice")
	}
	if (try typeOf(st, x, "SliceExpr")) != t {
		return stop("slice cut type mismatch")
	}
	if !directExpr(st, sx.X) {
		return stop("slice cut operand with statements")
	}
	let mut idx = []dense.Opt[syntax.Node]{sx.Low, sx.High}
	if sx.Slice3 {
		idx = idx.Append(sx.Max)
	}
	for opt in idx {
		match dense.Unpack(opt) {
		case option.Some{Value: e}:
			if basicGo(st, try typeOf(st, e, "slice bound")) != "int" {
				return stop("slice bound of non-int")
			}
			if !directExpr(st, e) {
				return stop("slice bound with statements")
			}
		case option.None:
		}
	}
	(idx, t)
}

func bareEmptyRecord(st fnb, x dense.ID[syntax.Node]) string {
	let t = typeOf(st, x, "bare record") catch {
	case Unported:
		return ""
	}
	let gt = shapeGo(st, t)
	if gt == "" {
		return ""
	}
	match syntax.ViewOf(st.p.Tree, x) {
	case syntax.Name:
		let (okOpt, _) = optionKind(st, t)
		if okOpt == "None" {
			return gt
		}
		let r = ordinaryRecord(st, t)
		let vname = if r >= 0 {
			if st.k.Recs[r].Fields.Len() != 0 {
				return ""
			}
			st.k.Recs[r].Name
		} else if store.KindOfType(st.s, t) == store.KNamed {
			let vn = store.TypeNameText(st.s, store.ArgOf(st.s, t))
			let isSpec = match unionDeclParent(st, vn) {
			case option.Some{Value: parent}:
				let (vp, v, _) = parent
				syntax.KindOf(vp.Tree, v) == syntax.KVariantSpec
			case option.None:
				false
			}
			if !isSpec {
				return ""
			}
			match unionRecordFields(st, vn) {
			case option.Some{Value: fs}:
				if fs.Len() != 0 {
					return ""
				}
			case option.None:
				return ""
			}
			vn
		} else {
			return ""
		}
		let d = match store.Lookup(st.s, vname) {
		case option.Some{Value: id}:
			store.DeclOf(st.s, id)
		case option.None:
			return ""
		}
		let declAt = bind.PNodeOf(st.k.Ps, int(d.File), syntax.NodeAt(st.k.Parsed[int(d.File)].Tree, int(d.Node)))
		match bind.ResolutionOf(st.k.U, st.k.Ps, bind.PNodeOf(st.k.Ps, st.file, x)) {
		case bind.Declared as res:
			if res.At == declAt { gt } else { "" }
		case _:
			""
		}
	case syntax.SelectorExpr as se:
		let (okOpt, _) = optionKind(st, t)
		if okOpt == "None" {
			return gt
		}
		match bind.ResolutionOf(st.k.U, st.k.Ps, bind.PNodeOf(st.k.Ps, st.file, se.Sel)) {
		case bind.Imported:
		case _:
			return ""
		}
		match importedFields(st, t) {
		case option.Some{Value: fields}:
			if fields.Len() == 0 { gt } else { "" }
		case option.None:
			""
		}
	case _:
		""
	}
}
