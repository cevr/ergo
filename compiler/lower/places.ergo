import compiler/check/expr
import compiler/check/store
import compiler/ir
import compiler/syntax
import dense
import option

// borrowParamBase is the admitted pointee of a checked mut parameter.
// Frame naming still decides whether the pointee can be a Go receiver.
func borrowParamBase(st fnb, t dense.ID[store.TKey]) option.Option[dense.ID[store.TKey]] {
	if store.KindOfType(st.s, t) != store.KPointer {
		return option.None
	}
	let elem = store.OperandsOf(st.s, t)[0]
	if scalarBasicGo(st, elem) == "" && ordinaryRecord(st, elem) < 0 && recordFieldsOf(st, elem) == option.None && store.KindOfType(st.s, elem) != store.KSlice {
		return option.None
	}
	if shapeGo(st, elem) == "" {
		return option.None
	}
	option.Some[dense.ID[store.TKey]]{Value: elem}
}

func borrowParamGo(st fnb, t dense.ID[store.TKey]) string {
	match borrowParamBase(st, t) {
	case option.Some{Value: elem}:
		"*" + shapeGo(st, elem)
	case option.None:
		""
	}
}

// Unit uses the ordinary row-free frame whenever a proven borrow enters
// and no formal is taken. CONTROL still validates the entire body before
// Begin; an address or value use it cannot lower stops the function.
func controlUnitAdmitted(st fnb, f expr.Fn, _ dense.ID[syntax.Node]) bool {
	let ops = store.OperandsOf(st.s, f.Sig)
	let formals = f.Names.Len()
	if formals == 0 || ops.Len() != formals+3 || f.Takes.Len() != formals {
		return false
	}
	let mut borrowed = false
	for i in 0..formals {
		if f.Takes[i] {
			return false
		}
		borrowed = borrowed || borrowParamBase(st, ops[i]) != option.None
	}
	borrowed
}

// fixedBorrowField is a checked path of selectors or a dereference
// through one fixed formal slot. The plan retains the leaf's syntax id:
// positions and Go member spellings are read from the same path at
// emission, without allocating a second node for each step.
type fixedBorrowField { slot int, leaf dense.ID[syntax.Node], t dense.ID[store.TKey] }

func planBorrowField(st fnb, binds localBinds, x dense.ID[syntax.Node], formals int) fixedBorrowField fails Unported {
	let leaf = unparen(st, x)
	let kind = syntax.KindOf(st.p.Tree, leaf)
	if kind != syntax.KSelectorExpr && kind != syntax.KStarExpr {
		return stop("borrow place: expected field or dereference")
	}
	let slot = try borrowPath(st, binds, leaf, formals)
	fixedBorrowField{slot: slot, leaf: leaf, t: try typeOf(st, leaf, "borrow place")}
}

func borrowPath(st fnb, binds localBinds, x dense.ID[syntax.Node], formals int) int fails Unported {
	let p = st.p
	let q = unparen(st, x)
	match syntax.ViewOf(p.Tree, q) {
	case syntax.Name:
		let slot = try paramLocal(st, binds, q)
		if slot < 0 || slot >= formals {
			return stop("borrow place: root is not a formal slot")
		}
		if borrowParamBase(st, try typeOf(st, q, "borrow root")) == option.None {
			return stop("borrow place: root is not an admitted borrow")
		}
		slot
	case syntax.StarExpr as star:
		if syntax.KindOf(p.Tree, unparen(st, star.X)) != syntax.KIdent {
			return stop("borrow place: dereference of a computed root")
		}
		let t = try typeOf(st, star.X, "borrow pointer")
		match borrowParamBase(st, t) {
		case option.Some{Value: elem}:
			if elem != (try typeOf(st, q, "borrow dereference")) {
				return stop("borrow place: dereference type mismatch")
			}
		case option.None:
			return stop("borrow place: dereference of a non-borrow")
		}
		try borrowPath(st, binds, star.X, formals)
	case syntax.SelectorExpr as se:
		let t = try typeOf(st, se.X, "borrow selector operand")
		let rec = match borrowParamBase(st, t) {
		case option.Some{Value: elem}:
			if syntax.KindOf(p.Tree, unparen(st, se.X)) != syntax.KIdent {
				return stop("borrow place: indirect field of a computed pointer")
			}
			elem
		case option.None:
			t
		}
		let _ = try fieldOn(st, q, se, rec)
		try borrowPath(st, binds, se.X, formals)
	case _:
		stop("borrow place: computed root")
	}
}

// Read only scalar endpoints: the oracle has no aggregate copy, held
// temporary, or field-hoist decision for these paths through a pointer.
func fixedBorrowScalar(st fnb, binds localBinds, x dense.ID[syntax.Node]) option.Option[fixedBorrowField] {
	if st.frame.env >= 0 || st.frame.fallible != option.None {
		return option.None
	}
	let place = planBorrowField(st, binds, x, st.frame.slots) catch {
	case Unported:
		return option.None
	}
	if scalarBasicGo(st, place.t) == "" {
		return option.None
	}
	option.Some[fixedBorrowField]{Value: place}
}

type borrowWrite { place fixedBorrowField, at int, op string, round string }

// planBorrowWrite checks the store's proof domain in addition to
// CONTROL's ordinary RHS check. An admitted RHS has no operand prelude,
// so the oracle has no old-value temp or address operands to fix.
func planBorrowWrite(st fnb, binds localBinds, node dense.ID[syntax.Node], a syntax.AssignStmt, formals int) borrowWrite fails Unported {
	let place = try planBorrowField(st, binds, a.Lhs, formals)
	let sb = scalarBasicGo(st, place.t)
	if sb == "" {
		return stop("borrow store: non-scalar field")
	}
	let text = syntax.TokText(st.p, a.Tok)
	let op = if text == "=" { "" } else { text[:text.Len()-1] }
	if op != "" && !isIROp(op) {
		return stop("borrow store: operator")
	}
	if callsIn(st.p, a.Rhs) {
		return stop("borrow store: RHS call decision")
	}
	let round = if op == "*" && (sb == "float32" || sb == "float64") { shapeGo(st, place.t) } else { "" }
	borrowWrite{place: place, at: syntax.NodePos(st.p, node), op: op, round: round}
}

func emitBorrowField(st fnb, b mut ir.Builder, fieldPlace fixedBorrowField) uint32 fails ir.Malformed {
	try emitBorrowPath(st, b, fieldPlace.slot, fieldPlace.leaf)
}

func emitBorrowPath(st fnb, b mut ir.Builder, slot int, x dense.ID[syntax.Node]) uint32 fails ir.Malformed {
	let p = st.p
	let q = unparen(st, x)
	let at = pos(st, syntax.NodePos(p, q))
	match syntax.ViewOf(p.Tree, q) {
	case syntax.Name:
		try ir.Row(b, ir.KindCode(ir.TExpr, "local"), at, []uint32{uint32(slot)})
	case syntax.StarExpr as star:
		let root = try emitBorrowPath(st, b, slot, star.X)
		try ir.Row(b, ir.KindCode(ir.TExpr, "deref"), at, []uint32{root})
	case syntax.SelectorExpr as se:
		let root = try emitBorrowPath(st, b, slot, se.X)
		let member = nameText(p, se.Sel)
		try ir.Row(b, ir.KindCode(ir.TExpr, "field"), pos(st, syntax.NodePos(p, se.Sel)), []uint32{root, ir.Text(b, member)})
	case _:
		ir.Malformed{At: syntax.NodePos(p, q), Why: "unprepared borrow path"}
	}
}

func emitBorrowWrite(st fnb, binds localBinds, b mut ir.Builder, w borrowWrite, rhs dense.ID[syntax.Node]) uint32 fails Unported | ir.Malformed {
	let to = try emitBorrowField(st, b, w.place)
	let x = try value(st, binds, b, rhs)
	if w.round != "" {
		let at = pos(st, w.at)
		let old = try emitBorrowField(st, b, w.place)
		let product = try ir.Row(b, ir.KindCode(ir.TExpr, "bin"), at, []uint32{ir.Text(b, w.op), old, x})
		let rounded = try ir.Row(b, ir.KindCode(ir.TExpr, "conv"), at, []uint32{ir.Text(b, w.round), product})
		return try ir.Row(b, ir.KindCode(ir.TStmt, "store"), at, []uint32{to, 0, rounded})
	}
	try ir.Row(b, ir.KindCode(ir.TStmt, "store"), pos(st, w.at), []uint32{to, ir.Text(b, w.op), x})
}

// borrowInvoke is a resolved unit method on a fixed record field. CALLS
// proves the target and the absence of call transforms before storing it.
type borrowInvoke { recv fixedBorrowField, recvAt int, callAt int, name string }

func emitBorrowInvoke(st fnb, b mut ir.Builder, call borrowInvoke) uint32 fails ir.Malformed {
	let place = try emitBorrowField(st, b, call.recv)
	let recv = try ir.Row(b, ir.KindCode(ir.TExpr, "addr"), pos(st, call.recvAt), []uint32{place})
	let at = pos(st, call.callAt)
	let e = try ir.Row(b, ir.KindCode(ir.TExpr, "mcall"), at, []uint32{recv, ir.Text(b, call.name), 0})
	try ir.Row(b, ir.KindCode(ir.TStmt, "expr"), at, []uint32{e})
}
