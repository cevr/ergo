import compiler/check/expr
import compiler/check/store
import compiler/ir
import compiler/syntax
import dense
import option
import strconv
import strings

func testFrame() framePlan {
	framePlan{env: 0, slots: 1, pure: false, fallible: option.None, pollEntry: false, op: option.None}
}

func testParamFrame(n int) framePlan {
	if n == 0 {
		return testFrame()
	}
	framePlan{env: 0, slots: n + 1, pure: false, fallible: option.None, pollEntry: false, op: option.None}
}

func testFunction(st0 fnb, b mut ir.Builder, f expr.Fn, td syntax.TestDecl, planned GeneratedBody, path string) bool fails Unported | ir.Malformed {
	if planned.Symbol == "" {
		return stop("test name taken (name_N)")
	}
	if lawHasAdmission(st0.p, td.Params) {
		return stop("test: admission clause")
	}
	let ops = store.OperandsOf(st0.s, f.Sig)
	if store.KindOfType(st0.s, f.Sig) != store.KSig || ops.Len() < 3 {
		return stop("signature")
	}
	let n = ops.Len() - 3
	if !emptyRow(st0, ops[n+1]) || !emptyRow(st0, ops[n+2]) {
		return stop("test: effect or failure row")
	}
	if f.Names.Len() != n {
		return stop("parameter names")
	}
	for i in 0..n {
		if i < f.Takes.Len() && f.Takes[i] {
			return stop("test: owned parameter")
		}
		if !admittedLawParam(st0, ops[i]) {
			return stop("test: parameter " + typeCause(st0, ops[i]))
		}
	}
	let body = match dense.Unpack(td.Body) {
	case option.Some[dense.ID[syntax.Node]] as x:
		x.Value
	case option.None:
		return stop("no body")
	}
	let p = st0.p
	let (list, rbrace) = match syntax.ViewOf(p.Tree, body) {
	case syntax.BlockStmt as bl:
		(bl.List, bl.Rbrace)
	case _:
		return stop("body that is no block")
	}
	let frame = testParamFrame(n)
	let st = fnb{..st0, frame: frame}
	let binds = parameterSlots(st, f)
	let prepared = try statementsTest(st, binds, body, list, f.Names, frame.slots, ops[n])
	let st2 = fnb{..st, fileIx: ir.FileOf(b, path)}
	let fp = pos(st2, syntax.TokPos(p, td.Test))
	let end = pos(st2, syntax.TokPos(p, rbrace))
	try ir.Begin(b, planned.Symbol, fp, end)
	let roots = try controlEmit(st2, b, prepared, end)
	let rows = if roots.Len() == 0 { uint32(0) } else { ir.List(b, roots) }
	try ir.End(b, rows)
	true
}

func isCompareOp(op string) bool {
	op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
}

func assertShownCheck(st fnb, x dense.ID[syntax.Node]) bool {
	let y = unparen(st, x)
	match syntax.ViewOf(st.p.Tree, y) {
	case syntax.BinaryExpr as be:
		isCompareOp(syntax.TokText(st.p, be.Op)) && !(isConst(st, be.X) && isConst(st, be.Y))
	case _:
		false
	}
}

func assertSiteText(st fnb, offset int) string {
	let q = syntax.PositionOf(st.lines, offset)
	let i = strings.LastIndex(st.filePath, "/")
	let file = if i < 0 { st.filePath } else { st.filePath[i+1 : st.filePath.Len()] }
	file + ":" + strconv.Itoa(q.Line) + ":" + strconv.Itoa(q.Column)
}

func assertSourceText(st fnb, x dense.ID[syntax.Node]) string fails Unported {
	let src = syntax.SourceOf(st.p)
	let lo = syntax.NodePos(st.p, x)
	let hi = syntax.NodeEnd(st.p, x)
	if lo < 0 || hi < lo || hi > src.Len() {
		return stop("test: assert text span")
	}
	src[lo:hi]
}

func skipReason(st fnb, sk syntax.SkipStmt) string fails Unported {
	if sk.Reason < 0 {
		return stop("test: skip reason")
	}
	strconv.Unquote(syntax.TokText(st.p, sk.Reason)) catch {
	case _:
		return stop("test: skip reason")
	}
}

func emitAssertStmt(b mut ir.Builder, at ir.Pos, condRow uint32, site string, text string) uint32 fails ir.Malformed {
	let notCond = try ir.Row(b, ir.KindCode(ir.TExpr, "un"), at, []uint32{ir.Text(b, "!"), condRow})
	let siteExpr = try constRow(b, at, "string", site)
	let textExpr = try constRow(b, at, "string", text)
	let failCall = try ir.Row(b, ir.KindCode(ir.TExpr, "call"), at, []uint32{ir.Text(b, ""), ir.Text(b, HelperSpelling("ergoAssertFail")), ir.List(b, []uint32{siteExpr, textExpr})})
	let failStmt = try ir.Row(b, ir.KindCode(ir.TStmt, "expr"), at, []uint32{failCall})
	try ir.Row(b, ir.KindCode(ir.TStmt, "if"), at, []uint32{notCond, ir.List(b, []uint32{failStmt}), ir.List(b, []uint32{}), ir.PosAt(b, at), 0, 0})
}

func emitSkipStmt(b mut ir.Builder, at ir.Pos, reason string) uint32 fails ir.Malformed {
	let arg = try constRow(b, at, "string", reason)
	let call = try ir.Row(b, ir.KindCode(ir.TExpr, "call"), at, []uint32{ir.Text(b, ""), ir.Text(b, HelperSpelling("ergoSkipNow")), ir.List(b, []uint32{arg})})
	try ir.Row(b, ir.KindCode(ir.TStmt, "expr"), at, []uint32{call})
}
