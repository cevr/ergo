import compiler/check/expr
import compiler/check/store
import compiler/ir
import compiler/syntax
import dense

// The limited unit tail is wired, but no unit profile is admitted until
// BORROW supplies its checked frame decision.
func controlUnitAdmitted(_ fnb, _ expr.Fn, _ dense.ID[syntax.Node]) bool { false }

type fixedBorrowField { slot int, rootAt int, fieldAt int, member string, t dense.ID[store.TKey] }
type borrowWrite { place fixedBorrowField, at int, op string }
type borrowInvoke { recv fixedBorrowField, recvAt int, callAt int, name string }

func planBorrowWrite(_ fnb, _ dense.ID[syntax.Node], _ syntax.AssignStmt, _ int) borrowWrite fails Unported {
	stop("control: assignment place")
}

func emitBorrowWrite(_ fnb, _ mut ir.Builder, _ borrowWrite, _ dense.ID[syntax.Node]) uint32 fails Unported | ir.Malformed {
	stop("control: assignment place")
}

func emitBorrowInvoke(_ fnb, _ mut ir.Builder, _ borrowInvoke) uint32 fails ir.Malformed {
	ir.Malformed{At: 0, Why: "unprepared borrowed invocation"}
}
