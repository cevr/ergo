import compiler/check/bind
import compiler/check/store
import compiler/ir
import compiler/syntax
import dense
import strconv

// The ordered arms live next to CONTROL's flat statement spans. An arm
// with one `T as x` binds a checked local at the case token, not at x.
type matchArm {
	at      int,
	tags    []int,
	binding int,
	variant string,
	payload bool,
	span    controlSpan,
}

func matchPrepare(st mut fnb, p mut controlPlan, m syntax.TypeSwitchStmt, row controlStmt, tail bool, loops int) (controlStmt, []matchArm) fails Unported {
	if loops != 0 || syntax.KindOf(st.p.Tree, m.Subject) != syntax.KIdent {
		return stop("match: subject is not a plain parameter")
	}
	let src = try paramLocal(*st, m.Subject)
	if src >= p.formals {
		// Locals can take the oracle's scalar tag-and-slots in place.
		return stop("match: local subject's scalar form")
	}
	let t = try typeOf(*st, m.Subject, "match subject")
	let shape = match unionNamed(*st, t) {
	case Some{Value: s}:
		s
	case None:
		return stop("match: unsupported union layout")
	}
	if !unionFlat(*st, shape) {
		return stop("match: unproved union layout")
	}
	let start = syntax.TokPos(st.p, m.Switch)
	let subject = try matchTemp(*st, p, shape.typ, start)
	let mut s = row
	s.offset = start
	s.end = syntax.TokPos(st.p, m.Rbrace)
	s.slot = subject
	// For a match these otherwise unused column words hold the checked
	// source slot and its operand position, not an else block.
	s.elseAt = src
	s.elseEnd = syntax.NodePos(st.p, m.Subject)
	s.assign = if tail { "return" } else { "" }
	p.extended = true
	p.reads = p.reads.Append(src)
	s.readHi = len(p.reads)
	let mut arms = []matchArm{}
	let mut seen = []bool{}
	for _ in shape.variants {
		seen = seen.Append(false)
	}
	let mut complete = true
	let mut fallback = false
	for i in 0..syntax.Len(m.Clauses) {
		let clause = syntax.CaseClauseOf(st.p.Tree, syntax.Item(st.p.Tree, m.Clauses, i))
		let at = syntax.TokPos(st.p, clause.Case)
		let count = syntax.Len(clause.List)
		if fallback {
			return stop("match: case after wildcard")
		}
		fallback = count == 0
		let mut a = matchArm{at: at, tags: []int{}, binding: -1, variant: "", payload: false, span: controlEmpty(len(p.stmts))}
		for j in 0..count {
			let item = syntax.Item(st.p.Tree, clause.List, j)
			let (tested, name) = match syntax.ViewOf(st.p.Tree, item) {
			case syntax.AsPattern as ap:
				if count != 1 {
					return stop("match: binding among alternatives")
				}
				(ap.X, dense.OptOf(ap.Name))
			case syntax.Name:
				(item, dense.NoID[syntax.Node]())
			case _:
				return stop("match: not a type test")
			}
			let tag = unionTagOfName(*st, shape, tested)
			if tag < 0 || seen[tag] {
				return stop("match: foreign or repeated case")
			}
			seen[tag] = true
			a.tags = a.tags.Append(tag)
			match dense.Unpack(name) {
			case Some{Value: binder}:
				let v = shape.variants[tag]
				let slot = try controlBind(st, p, binder, nameText(st.p, binder), v.typ, false)
				p.locals[slot-p.formals].at = at
				a.binding = slot
				a.variant = v.typ
				a.payload = v.field != None
			case None:
			}
		}
		for j in 0..syntax.Len(clause.Body) {
			if !matchArmSupported(st.p, syntax.Item(st.p.Tree, clause.Body, j)) {
				return stop("match: loop or break in case")
			}
		}
		let lo = len(p.reads)
		a.span = try controlList(st, p, clause.Body, tail, 0)
		if a.binding >= 0 {
			let mut uses = 0
			for j in lo..len(p.reads) {
				if p.reads[j] == a.binding {
					uses += 1
				}
			}
			if uses > 1 {
				return stop("match: repeated read of a payload binding")
			}
		}
		complete = complete && a.span.terminates
		arms = arms.Append(a)
	}
	if !fallback {
		for handled in seen {
			if !handled {
				return stop("match: not exhaustive")
			}
		}
	}
	s.second.terminates = complete && (tail || fallback)
	(s, arms)
}

func matchArmSupported(p syntax.Parsed, x dense.ID[syntax.Node]) bool {
	let k = syntax.KindOf(p.Tree, x)
	if k == syntax.KForStmt || k == syntax.KRangeStmt || k == syntax.KBranchStmt {
		return false
	}
	for child in syntax.Children(p.Tree, x, []uint32{}) {
		if !matchArmSupported(p, syntax.NodeAt(p.Tree, int(child))) {
			return false
		}
	}
	true
}

func matchTemp(st fnb, p mut controlPlan, typ string, at int) int fails Unported {
	let slot = p.formals + len(p.locals)
	let name = "s" + strconv.Itoa(slot)
	if !p.scannedNames {
		p.sourceNames = controlNames(st.p, p.body, []string{})
		p.scannedNames = true
	}
	if has(p.sourceNames, name) || has(p.taken, name) || has(st.prelude, name) || pkgDecl(st, name) {
		return stop("match: temporary name is taken")
	}
	p.taken = p.taken.Append(name)
	p.locals = p.locals.Append(controlLocal{name: name, typ: typ, at: at, mutable: false})
	slot
}

func matchTerminates(s controlStmt) bool { s.second.terminates }

// Check the selector's root against its lexical `as` declaration. The
// source name alone cannot establish the binding or its field.
func unionField(st fnb, x dense.ID[syntax.Node], se syntax.SelectorExpr) string fails Unported {
	let d = match bind.ResolutionOf(st.k.U, st.k.Ps, bind.PNodeOf(st.k.Ps, st.file, se.X)) {
	case bind.Declared as local:
		local.At
	case _:
		return stop("selector on no plain record")
	}
	let parent = match dense.Unpack(bind.ParentOf(st.k.Ps, d)) {
	case Some{Value: at}:
		at
	case None:
		return stop("selector on no plain record")
	}
	let (f, row) = bind.RowOf(st.k.Ps, parent)
	if f != st.file || syntax.KindOf(st.p.Tree, syntax.NodeAt(st.p.Tree, row)) != syntax.KAsPattern {
		return stop("selector on no plain record")
	}
	let t = try typeOf(st, se.X, "variant selector operand")
	if store.KindOfType(st.s, t) != store.KNamed {
		return stop("selector on no plain record")
	}
	let name = nameText(st.p, se.Sel)
	let fieldType = try typeOf(st, x, "variant selector")
	let typeName = store.TypeNameText(st.s, store.ArgOf(st.s, t))
	let (vp, v, _) = match unionDeclParent(st, typeName) {
	case Some{Value: decl}:
		decl
	case None:
		return stop("selector on no plain record")
	}
	if syntax.KindOf(vp.Tree, v) != syntax.KVariantSpec {
		return stop("selector on no plain record")
	}
	match unionRecordFields(st, typeName) {
	case Some{Value: fields}:
		if len(fields) == 1 && fields[0].Name == name && fields[0].T == fieldType && basicGo(st, fieldType) != "" && ordinaryFieldName(name) {
			return name
		}
	case None:
	}
	stop("selector on no plain record")
}

func matchBoundField(st fnb, x dense.ID[syntax.Node], se syntax.SelectorExpr) bool {
	let name = unionField(st, x, se) catch {
	case Unported:
		return false
	}
	name != ""
}

func matchEmit(st fnb, b mut ir.Builder, p controlPlan, s controlStmt, arms []matchArm, read []bool) []uint32 fails Unported | ir.Malformed {
	let at = pos(st, s.offset)
	let end = pos(st, s.end)
	let slot = uint32(s.slot)
	let src = try ir.Row(b, ir.KindCode(ir.TExpr, "local"), pos(st, s.elseEnd), []uint32{uint32(s.elseAt)})
	let subject = try ir.Row(b, ir.KindCode(ir.TStmt, "def"), at, []uint32{slot, src})
	let use = try ir.Row(b, ir.KindCode(ir.TExpr, "local"), at, []uint32{slot})
	let tag = try ir.Row(b, ir.KindCode(ir.TExpr, "field"), at, []uint32{use, ir.Text(b, "tag")})
	let mut cases = []uint32{}
	let mut hasDefault = false
	for arm in arms {
		let cp = pos(st, arm.at)
		let mut vals = []uint32{}
		for k in arm.tags {
			vals = vals.Append(try constRow(b, cp, "uint8", strconv.Itoa(k)))
		}
		let mut body = []uint32{}
		if arm.binding >= 0 {
			let i = uint32(arm.binding)
			let narrowed = if arm.payload {
				let rec = try ir.Row(b, ir.KindCode(ir.TExpr, "local"), cp, []uint32{slot})
				try ir.Row(b, ir.KindCode(ir.TExpr, "mcall"), cp, []uint32{rec, ir.Text(b, "as" + strconv.Itoa(arm.tags[0])), 0})
			} else {
				try ir.Row(b, ir.KindCode(ir.TExpr, "zero"), cp, []uint32{ir.Text(b, arm.variant)})
			}
			body = body.Append(try ir.Row(b, ir.KindCode(ir.TStmt, "def"), cp, []uint32{i, narrowed}))
			if !read[arm.binding] {
				body = body.Append(try controlDiscard(b, cp, i))
			}
		}
		let bodyRows = try controlEmitSpan(st, b, p, arm.span, read)
		for child in bodyRows {
			body = body.Append(child)
		}
		let def = len(vals) == 0
		hasDefault = hasDefault || def
		cases = cases.Append(try ir.Row(b, ir.KindCode(ir.TCase, ""), cp, []uint32{0, ir.List(b, body), ir.List(b, vals), if def { uint32(1) } else { uint32(0) }}))
	}
	let mut fallback = []uint32{}
	if !hasDefault && s.assign == "return" {
		let where = syntax.PositionOf(st.lines, s.offset)
		let label = strconv.Itoa(where.Line) + ":" + strconv.Itoa(where.Column)
		let msg = try constRow(b, end, "string", "ergo: defect: no case of the match at " + label + " matched")
		fallback = fallback.Append(try ir.Row(b, ir.KindCode(ir.TStmt, "panic"), end, []uint32{msg}))
	}
	let endAt = ir.PosAt(b, end)
	let epos = if hasDefault { uint32(0) } else { endAt }
	let branch = try ir.Row(b, ir.KindCode(ir.TStmt, "switch"), at, []uint32{tag, ir.List(b, fallback), endAt, epos, ir.List(b, cases)})
	[]uint32{subject, branch}
}
