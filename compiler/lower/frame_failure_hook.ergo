import compiler/syntax
import dense
import option

// FRAME may prove a checked failure value and return its scalar operand
// nodes for liveness. None keeps ordinary return preparation.
func frameFailureOperands(st fnb, x dense.ID[syntax.Node]) option.Option[[]dense.ID[syntax.Node]] fails Unported {
	match st.frame.fallible {
	case option.Some{Value: plan}:
		for exit in plan.exits {
			if exit.at == x {
				return option.Some[[]dense.ID[syntax.Node]]{Value: exit.operands}
			}
		}
	case option.None:
	}
	option.None
}
