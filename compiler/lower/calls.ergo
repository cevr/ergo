import compiler/check/bind
import compiler/check/expr
import compiler/check/store
import compiler/syntax
import dense
import slices

type ordinaryCallee { body dense.ID[syntax.Node], receiver bool }

let noCallFact = uint8(0)
let pureCallFact = uint8(1)
let directCallFact = uint8(2)
let unprovedCallFact = uint8(3)

func importedCallFact(imports []ImportCallFacts, path string, i int) uint8 {
	for dep in imports {
		if dep.Path == path && i >= 0 && i < len(dep.Facts.flags) {
			return dep.Facts.flags[i]
		}
	}
	noCallFact
}

func requireImportedDirect(imports []ImportCallFacts, path string, i int) fails Unported {
	let flag = importedCallFact(imports, path, i)
	if flag == noCallFact {
		return stop("callee: imported purity facts")
	}
	if flag == unprovedCallFact {
		return stop("callee: imported body outside purity profile")
	}
	if flag != directCallFact {
		return stop("call of a pure imported nonleaf (inline or tabulation decision)")
	}
}

type callRange { start int, end int }
type inspectedCall { valid bool, body callBody, next []int }

func inspectCall(st fnb, i int, imports []ImportCallFacts) inspectedCall fails Unported {
	let f = st.k.Fns[i]
	let name = nameText(st.k.Parsed[f.File], f.Name)
	// Overloaded Go names are a call-site decision, not a purity fact.
	let h = try callHeader(st, i, name, false)
	if h.receiver {
		return stop("callee: receiver purity facts")
	}
	let (body, edges) = try scanScalarBody(st, i, h.body, imports)
	inspectedCall{valid: true, body: body, next: edges}
}

// summarizeCalls checks each candidate body once. Its flat edges support
// propagation from non-candidates to callers, then cycle marking among
// the remaining pure candidates. A non-inline verdict is independent
// from purity: an imported inline candidate can still prove an edge pure.
func summarizeCalls(st fnb, imports []ImportCallFacts) CallFacts {
	let n = len(st.k.Fns)
	let mut flags = slices.Repeat[uint8]([]uint8{noCallFact}, n)
	let mut next = []int{}
	let mut spans = slices.WithCapacity[callRange](n)
	let mut bodies = slices.WithCapacity[callBody](n)
	let mut rejected = []int{}
	for i in 0..n {
		let start = len(next)
		let inspected = inspectCall(st, i, imports) catch {
		case Unported:
			inspectedCall{valid: false, body: callBody{edges: 0, loop: false, decision: false, sizeFloor: 0}, next: []int{}}
		}
		for edge in inspected.next {
			next = next.Append(edge)
		}
		if inspected.valid {
			flags[i] = pureCallFact
		} else {
			rejected = rejected.Append(i)
		}
		spans = spans.Append(callRange{start: start, end: len(next)})
		bodies = bodies.Append(inspected.body)
	}
	let reverse = callReverse(spans, next)
	let mut head = 0
	for head < len(rejected) {
		let rejectedFn = rejected[head]
		head = head + 1
		for caller in callersOf(reverse, rejectedFn) {
			if flags[caller] == pureCallFact {
				flags[caller] = noCallFact
				rejected = rejected.Append(caller)
			}
		}
	}
	let cycles = callCycles(spans, next, reverse, flags)
	for i, body in bodies {
		if flags[i] != pureCallFact {
			flags[i] = unprovedCallFact
			continue
		}
		let direct = directWithoutCopy(st, st.k.Fns[i], body, cycles[i])
		if direct == "" {
			flags[i] = directCallFact
		}
	}
	CallFacts{flags: flags}
}

type callReverseRows { starts []int, callers []int }

func callReverse(spans []callRange, next []int) callReverseRows {
	let mut starts = slices.Repeat[int]([]int{0}, len(spans)+1)
	for to in next {
		starts[to+1] = starts[to+1] + 1
	}
	for i in 0..len(spans) {
		starts[i+1] = starts[i+1] + starts[i]
	}
	let mut cursor = slices.WithCapacity[int](len(spans))
	for i in 0..len(spans) {
		cursor = cursor.Append(starts[i])
	}
	let mut callers = slices.Repeat[int]([]int{0}, len(next))
	for i, out in spans {
		for edge in out.start..out.end {
			let to = next[edge]
			callers[cursor[to]] = i
			cursor[to] = cursor[to] + 1
		}
	}
	callReverseRows{starts: starts, callers: callers}
}

func callersOf(rev callReverseRows, i int) []int {
	rev.callers[rev.starts[i]:rev.starts[i+1]]
}

type callVisit { f int, edge int }

// Finish the forward graph, then take components in reverse finish order
// through the caller table. A singleton needs a real self-edge to be a
// cycle; an upstream function that merely reaches a cycle is not recursive.
func callCycles(spans []callRange, next []int, rev callReverseRows, flags []uint8) []bool {
	let n = len(flags)
	let mut seen = slices.Repeat[bool]([]bool{false}, n)
	let mut order = slices.WithCapacity[int](n)
	let mut stack = []callVisit{}
	for i, flag in flags {
		if flag == noCallFact || seen[i] {
			continue
		}
		stack = stack.Append(callVisit{f: i, edge: spans[i].start})
		seen[i] = true
		for len(stack) > 0 {
			let top = len(stack) - 1
			let visit = stack[top]
			if visit.edge == spans[visit.f].end {
				order = order.Append(visit.f)
				stack = stack[:top]
			} else {
				let to = next[visit.edge]
				stack[top].edge = visit.edge + 1
				if !seen[to] {
					seen[to] = true
					stack = stack.Append(callVisit{f: to, edge: spans[to].start})
				}
			}
		}
	}
	let mut walked = slices.Repeat[bool]([]bool{false}, n)
	let mut cycles = slices.Repeat[bool]([]bool{false}, n)
	let mut component = slices.Repeat[int]([]int{0}, n)
	for j in 0..len(order) {
		let f = order[len(order)-1-j]
		if walked[f] {
			continue
		}
		walked[f] = true
		component[0] = f
		let mut end = 1
		let mut head = 0
		for head < end {
			let g = component[head]
			head = head + 1
			for caller in callersOf(rev, g) {
				if caller == g {
					cycles[g] = true
				} else if flags[caller] != noCallFact && !walked[caller] {
					walked[caller] = true
					component[end] = caller
					end = end + 1
				}
			}
		}
		if end > 1 {
			for i in 0..end {
				cycles[component[i]] = true
			}
		}
	}
	cycles
}

// callClosure is the worklist for pure.go restricted to checked local
// scalar functions. A row is queued once by its package declaration ID.
// A cycle is pure if every member and every outgoing edge is eligible.
type callClosure {
	queue     []int,
	seen      dense.Side[store.PNode, bool],
	start     int,
	recursive bool,
}

type callBody { edges int, loop bool, decision bool, sizeFloor int }
type callWalk { pending []uint32, targets []int, facts callBody }

func directCallee(st fnb, i int, target ordinaryCallee, imports []ImportCallFacts) fails Unported {
	if target.receiver {
		return stop("callee: receiver purity facts")
	}
	let f = st.k.Fns[i]
	let mut graph = callClosure{queue: []int{i}, seen: dense.NewSide[store.PNode, bool](false), start: i, recursive: false}
	dense.SideSet(&graph.seen, bind.PNodeOf(st.k.Ps, f.File, f.Decl), true)
	let root = try scanCallBody(st, i, target.body, imports, &graph)
	let mut head = 1
	for head < len(graph.queue) {
		let next = graph.queue[head]
		head = head + 1
		let dep = st.k.Fns[next]
		let header = try callHeader(st, next, nameText(st.k.Parsed[dep.File], dep.Name), true)
		if header.receiver {
			return stop("callee: receiver purity facts")
		}
		let _ = try scanCallBody(st, next, header.body, imports, &graph)
	}
	try keepDirectCall(st, f, root, graph.recursive)
}

func scanCallBody(st fnb, i int, body dense.ID[syntax.Node], imports []ImportCallFacts, graph mut callClosure) callBody fails Unported {
	let (facts, targets) = try scanScalarBody(st, i, body, imports)
	for next in targets {
		graph.recursive = graph.recursive || next == graph.start
		let dep = st.k.Fns[next]
		let at = bind.PNodeOf(st.k.Ps, dep.File, dep.Decl)
		if !dense.SideOf(graph.seen, at) {
			dense.SideSet(&graph.seen, at, true)
			graph.queue = graph.queue.Append(next)
		}
	}
	facts
}

func scanScalarBody(st fnb, i int, body dense.ID[syntax.Node], imports []ImportCallFacts) (callBody, []int) fails Unported {
	let mut at = st
	at.file = st.k.Fns[i].File
	at.p = st.k.Parsed[at.file]
	let mut walk = callWalk{pending: []uint32{uint32(dense.Index(body))}, targets: []int{}, facts: callBody{edges: 0, loop: false, decision: false, sizeFloor: 0}}
	let mut head = 0
	for head < len(walk.pending) {
		let x = syntax.NodeAt(at.p.Tree, int(walk.pending[head]))
		head = head + 1
		try scanPureNode(at, x, imports, &walk)
	}
	(walk.facts, walk.targets)
}

// Without a footprint side table, prove a subdomain in which a footprint
// cannot arise. All values read or written are typed scalars; unknown
// expressions, implicit adapters, indirect calls, and resource forms do
// not count as pure merely because the declaration's rows are empty.
func scanPureNode(st fnb, x dense.ID[syntax.Node], imports []ImportCallFacts, walk mut callWalk) fails Unported {
	let p = st.p
	match syntax.ViewOf(p.Tree, x) {
	case syntax.Name, syntax.BasicLit, syntax.ParenExpr:
		try pureScalar(st, x)
		// These each contribute exactly one Go syntax node; other
		// nodes may also contribute, so this is a lower bound.
		walk.facts.sizeFloor = walk.facts.sizeFloor + 1
	case syntax.UnaryExpr as u:
		let op = syntax.TokText(p, u.Op)
		if op != "!" && op != "-" && op != "+" && op != "^" {
			return stop("callee: unary form (purity)")
		}
		try pureScalar(st, x)
		walk.facts.sizeFloor = walk.facts.sizeFloor + 1
	case syntax.BinaryExpr as v:
		if !isIROp(syntax.TokText(p, v.Op)) {
			return stop("callee: binary form (purity)")
		}
		try pureScalar(st, x)
		walk.facts.sizeFloor = walk.facts.sizeFloor + 1
	case syntax.CallExpr as ce:
		try pureScalar(st, x)
		let next = try pureEdge(st, x, ce, imports)
		if next != builtinEdge {
			walk.facts.edges = walk.facts.edges + 1
		}
		if next >= 0 {
			walk.targets = walk.targets.Append(next)
		}
		walk.facts.sizeFloor = walk.facts.sizeFloor + 1
		for j in 0..syntax.Len(ce.Args) {
			walk.pending = walk.pending.Append(uint32(dense.Index(syntax.Item(p.Tree, ce.Args, j))))
		}
		return
	case syntax.ForStmt:
		walk.facts.loop = true
	case syntax.RangeStmt as r:
		let bound = try compactBound(st, r)
		walk.facts.loop = true
		walk.pending = walk.pending.Append(uint32(dense.Index(bound)))
		walk.pending = walk.pending.Append(uint32(dense.Index(r.Body)))
		return
	case syntax.IfStmt:
		walk.facts.decision = true
	case syntax.BlockStmt, syntax.ExprStmt, syntax.ReturnStmt, syntax.DeclStmt, syntax.BranchStmt, syntax.AssignStmt:
	case syntax.VarDecl as d:
		if dense.Unpack(d.Extern) != None {
			return stop("callee: local extern")
		}
	case syntax.VarSpec as s:
		if dense.Unpack(s.Pattern) != None || syntax.Len(s.Names) != 1 || dense.Unpack(s.Type) != None {
			return stop("callee: local shape (purity)")
		}
		match dense.Unpack(s.Value) {
		case Some{Value: v}:
			walk.pending = walk.pending.Append(uint32(dense.Index(v)))
			return
		case None:
			return stop("callee: local without initializer (purity)")
		}
	case _:
		return stop("callee: body form (purity)")
	}
	walk.pending = syntax.Children(p.Tree, x, walk.pending)
}

func pureScalar(st fnb, node dense.ID[syntax.Node]) fails Unported {
	if basicGo(st, try typeOf(st, node, "callee value")) == "" {
		return stop("callee: non-scalar value (purity)")
	}
}

let builtinEdge = -1
let importEdge = -2

// A local edge names its target index. A checked imported edge contributes
// to Go's nonleaf rule but cannot form a cycle back into this package.
func pureEdge(st fnb, x dense.ID[syntax.Node], ce syntax.CallExpr, imports []ImportCallFacts) int fails Unported {
	if dense.Unpack(ce.Trailing) != None {
		return stop("callee: trailing block (purity)")
	}
	let ix = dense.SideOf(st.callAt, bind.PNodeOf(st.k.Ps, st.file, x))
	if ix == 0 {
		match try builtinOf(st, x, ce) {
		case Some[aBuiltin]:
			return builtinEdge
		case None:
			return stop("callee: unresolved call (purity)")
		}
	}
	let to = st.calls[ix-1]
	if to.Recv {
		return stop("callee: nonlocal or method edge (purity)")
	}
	match syntax.ViewOf(st.p.Tree, ce.Fun) {
	case syntax.SelectorExpr as sel:
		let (other, path) = try depOf(st, sel.Sel)
		let at = bind.PNodeOf(other.k.Ps, to.Callee.File, to.Callee.Name)
		let flag = importedCallFact(imports, path, expr.FnAt(other.k, at))
		if flag != pureCallFact && flag != directCallFact {
			return stop("callee: imported purity facts")
		}
		return importEdge
	case syntax.Name:
	case _:
		return stop("callee: nonlocal or method edge (purity)")
	}
	let declared = match bind.ResolutionOf(st.k.U, st.k.Ps, bind.PNodeOf(st.k.Ps, st.file, ce.Fun)) {
	case bind.Declared as d:
		d.At
	case _:
		return stop("callee: nonlocal edge (purity)")
	}
	let name = bind.PNodeOf(st.k.Ps, to.Callee.File, to.Callee.Name)
	let next = expr.FnAt(st.k, declared)
	if name != declared || next < 0 {
		return stop("callee: unresolved target (purity)")
	}
	next
}

// Go's closed query cannot call-fold an operand that reads a local.
func callReadsLocal(st fnb, x dense.ID[syntax.Node]) bool {
	match syntax.ViewOf(st.p.Tree, x) {
	case syntax.Name:
		let local = paramLocal(st, x) catch {
		case Unported:
			-1
		}
		return local >= 0
	case syntax.ParenExpr as pe:
		callReadsLocal(st, pe.X)
	case syntax.UnaryExpr as u:
		callReadsLocal(st, u.X)
	case syntax.BinaryExpr as b:
		callReadsLocal(st, b.X) || callReadsLocal(st, b.Y)
	case syntax.SelectorExpr as se:
		callReadsLocal(st, se.X)
	case syntax.IndexExpr as ie:
		callReadsLocal(st, ie.X)
	case _:
		false
	}
}

func noImportedRewrite(st fnb, name string) fails Unported {
	match st.rootImports {
	case Some[[]expr.Dep] as deps:
		for dep in deps.Value {
			let mut other = st
			other.k = dep.K
			if lawOver(other, name) {
				return stop("call under an imported rewrite law")
			}
		}
	case None:
		return stop("call: rewrite scope not known")
	}
}
