import compiler/check/expr
import compiler/check/store
import dense
import option

// The original scalar S4c10 leaf has no calls and a nonboxed result.
// A proved scalar body calling only builtins is the same Go leaf.
// For a nonleaf, the positive-budget inlineRule cannot mark a recursive
// body, a loop body, or a body above 120 syntax nodes. No marked site
// means the later pays/splice/return decisions cannot change this call.
// A small acyclic nonleaf is not assumed to be a direct call.
func keepDirectCall(st fnb, f expr.Fn, body callBody, recursive bool) fails Unported {
	let cause = directWithoutCopy(st, f, body, recursive)
	if cause != "" {
		return stop(cause)
	}
}

func directWithoutCopy(st fnb, f expr.Fn, body callBody, recursive bool) string {
	if body.edges > 0 && !body.loop && !recursive && body.sizeFloor <= 120 {
		return "call of a pure nonleaf (inline decision)"
	}
	// findTab can turn a decision with only finite scalar parameters
	// into a table read. A non-finite formal proves it cannot.
	if body.decision && tabDomain(st, f) {
		return "call of a pure decision (tabulation)"
	}
	""
}

func tabDomain(st fnb, f expr.Fn) bool {
	let ops = store.OperandsOf(st.s, f.Sig)
	let n = ops.Len() - 3
	let mut size = 1
	for i in 0..n {
		let card = tabParamSize(st, ops[i])
		if card == 0 {
			return false
		}
		size = size * card
		if size > 4096 {
			return false
		}
	}
	n > 0
}

func tabParamSize(st fnb, t dense.ID[store.TKey]) int {
	let basic = basicGo(st, t)
	if basic == "bool" {
		return 2
	}
	if basic == "uint8" {
		return 256
	}
	if store.KindOfType(st.s, t) == store.KNamed {
		let vs = unionVarsIn(st.idx, t)
		if vs.Len() >= 2 && vs.Len() <= 256 {
			for v in vs {
				if store.KindOfType(st.s, v) != store.KNamed {
					return 0
				}
				match unionRecordFields(st, store.TypeNameText(st.s, store.ArgOf(st.s, v))) {
				case option.Some{Value: fs}:
					if fs.Len() != 0 {
						return 0
					}
				case option.None:
					return 0
				}
			}
			return vs.Len()
		}
	}
	0
}
