import compiler/check/expr
import compiler/check/store
import dense
import option

// admittedBorrowParam accepts only a row-free, non-taking pointer formal
// whose checked borrow profile supplies its Go spelling.
func admittedBorrowParam(st fnb, f expr.Fn, i int, t dense.ID[store.TKey], rowless bool) bool {
	rowless && i < f.Takes.Len() && !f.Takes[i] && store.KindOfType(st.s, t) == store.KPointer && borrowParamGo(st, t) != ""
}

// frameName treats an admitted slot-zero borrow's checked base like a
// value receiver for naming. Field-name collisions still stay functions.
func frameName(st fnb, f expr.Fn, name string, params []dense.ID[store.TKey], rowless bool) string fails Unported {
	if params.Len() == 0 {
		return try goName(st, name, option.None)
	}
	let t = params[0]
	if admittedBorrowParam(st, f, 0, t, rowless) {
		return try goName(st, name, borrowParamBase(st, t))
	}
	try goName(st, name, option.Some[dense.ID[store.TKey]]{Value: t})
}
