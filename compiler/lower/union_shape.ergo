import compiler/check/bind
import compiler/check/expr
import compiler/check/infer
import compiler/check/store
import compiler/ir
import compiler/syntax
import dense
import strconv

type unionVariant {
	t     dense.ID[store.TKey],
	decl  dense.ID[store.PNode],
	name  string,
	typ   string,
	field Option[expr.Field],
}

// The variants are indexed by the checked declaration order. The small
// flat profile has one byte tag and at most one scalar shared slot.
type unionShape {
	name     string,
	typ      string,
	variants []unionVariant,
}

func unionGo(st fnb, t dense.ID[store.TKey]) string {
	match unionNamed(st, t) {
	case Some{Value: shape}:
		shape.typ
	case None:
		unionInstanceGo(st, t)
	}
}

// This is type spelling only. The same nominal type names a native
// generic union whether it has shared slots or a sealed interface.
// Host/niche/row arguments do not acquire a Go type here.
func unionInstanceGo(st fnb, t dense.ID[store.TKey]) string {
	if store.KindOfType(st.s, t) != store.KInstance {
		return ""
	}
	let o = store.OriginOfType(st.s, t)
	let i = int(o.Decl)
	let args = store.OperandsOf(st.s, t)
	if int(o.Import) != store.ForeignBit || i >= len(st.k.Foreign) || len(args) == 0 {
		return ""
	}
	let f = st.k.Foreign[i]
	let isPrelude = f.Path == "prelude" && has(st.prelude, f.Name)
	let isOption = f.Path == "option" && f.Name == "Option"
	if f.Qual != "-" || (!isPrelude && !isOption) || len(f.Variants) == 0 || f.Arity != len(args) {
		return ""
	}
	let head = if isOption { pkgAlias(f.Path) + "__" + f.Name } else { f.Name }
	let mut name = head + "["
	for j, arg in args {
		let gt = basicGo(st, arg)
		if gt == "" {
			return ""
		}
		name += (if j == 0 { "" } else { ", " }) + gt
	}
	name + "]"
}

func unionNamed(st fnb, t dense.ID[store.TKey]) Option[unionShape] {
	if store.KindOfType(st.s, t) != store.KNamed {
		return None
	}
	// VariantsOf on a local non-instance only reads the checked table.
	let mut s = st.s
	let vs = infer.VariantsOf(&s, st.k.Unions, t)
	if len(vs) < 2 || len(vs) > 255 {
		return None
	}
	let name = store.TypeNameText(st.s, store.ArgOf(st.s, t))
	let (p, parent, at) = match unionDeclParent(st, name) {
	case Some{Value: d}:
		d
	case None:
		return None
	}
	let list = match syntax.ViewOf(p.Tree, parent) {
	case syntax.TypeDecl as td:
		if td.Name != at || dense.Unpack(td.Extern) != None || dense.Unpack(td.TypeParams) != None || dense.Unpack(td.Where) != None || dense.Unpack(td.Derive) != None || syntax.Len(td.Implements) != 0 {
			return None
		}
		match dense.Unpack(td.Spec) {
		case Some{Value: spec}:
			match syntax.ViewOf(p.Tree, spec) {
			case syntax.InterfaceType as it:
				it.Members
			case _:
				return None
			}
		case None:
			return None
		}
	case _:
		return None
	}
	if syntax.Len(list) != len(vs) {
		return None
	}
	let gt = declName(st, name) catch {
	case Unported:
		return None
	}
	let mut variants = []unionVariant{}
	let mut payload = false
	for tag, v in vs {
		let node = syntax.Item(p.Tree, list, tag)
		let vn = match syntax.ViewOf(p.Tree, node) {
		case syntax.VariantSpec as variant:
			if dense.Unpack(variant.TypeArgs) != None {
				return None
			}
			nameText(p, variant.Name)
		case _:
			return None
		}
		if store.KindOfType(st.s, v) != store.KNamed || store.TypeNameText(st.s, store.ArgOf(st.s, v)) != vn {
			return None
		}
		let decl = match store.Lookup(st.s, vn) {
		case Some{Value: d}:
			store.DeclOf(st.s, d)
		case None:
			return None
		}
		let vp = st.k.Parsed[int(decl.File)]
		let id = bind.PNodeOf(st.k.Ps, int(decl.File), syntax.NodeAt(vp.Tree, int(decl.Node)))
		let fields = match unionRecordFields(st, vn) {
		case Some{Value: fs}:
			fs
		case None:
			return None
		}
		let mut field Option[expr.Field] = None
		if len(fields) != 0 {
			if payload || len(fields) != 1 || basicGo(st, fields[0].T) == "" || !ordinaryFieldName(fields[0].Name) {
				return None
			}
			payload = true
			field = Some{Value: fields[0]}
		}
		let vt = declName(st, vn) catch {
		case Unported:
			return None
		}
		variants = variants.Append(unionVariant{t: v, decl: id, name: vn, typ: vt, field: field})
	}
	Some{Value: unionShape{name: name, typ: gt, variants: variants}}
}

func unionRecordFields(st fnb, name string) Option[[]expr.Field] {
	for r in st.k.Recs {
		if r.Name == name && !r.Op && len(r.Params) == 0 {
			return Some{Value: r.Fields}
		}
	}
	None
}

func unionDeclParent(st fnb, name string) Option[(syntax.Parsed, dense.ID[syntax.Node], dense.ID[syntax.Node])] {
	let d = match store.Lookup(st.s, name) {
	case Some{Value: d}:
		store.DeclOf(st.s, d)
	case None:
		return None
	}
	let f = int(d.File)
	let p = st.k.Parsed[f]
	let at = syntax.NodeAt(p.Tree, int(d.Node))
	match dense.Unpack(bind.ParentOf(st.k.Ps, bind.PNodeOf(st.k.Ps, f, at))) {
	case Some{Value: id}:
		let (_, row) = bind.RowOf(st.k.Ps, id)
		Some{Value: (p, syntax.NodeAt(p.Tree, row), at)}
	case None:
		None
	}
}

// Layout-sensitive nodes require a root-local declaration: a consumer
// of a library may name it in an extern or charge its variants to a
// failure row. Root dependencies cannot refer back to the root's types.
// Reject an extern or a wire form rather than predicting a restarted
// interface layout. The admitted scalar slots fit the register profile.
func unionFlat(st fnb, shape unionShape) bool {
	if st.rootImports == None || st.alias != "" {
		return false
	}
	for p in st.k.Parsed {
		for i in 0..syntax.NumNodes(p.Tree) {
			let n = syntax.NodeAt(p.Tree, i)
			let k = syntax.KindOf(p.Tree, n)
			if k == syntax.KExternSpec || k == syntax.KIdent && nameText(p, n) == "WireForm" {
				return false
			}
			match syntax.ViewOf(p.Tree, n) {
			case syntax.TypeDecl as td:
				// Another declaration can hide a row head behind an
				// alias, or use this union in a different wire shape.
				if nameText(p, td.Name) != shape.name && unionNames(p, n, shape) {
					return false
				}
			case syntax.IndexExpr as ix:
				// A written generic row argument also charges its
				// members as error types (collectRowArgs).
				for j in 0..syntax.Len(ix.Indices) {
					if unionNames(p, syntax.Item(p.Tree, ix.Indices, j), shape) {
						return false
					}
				}
			case _:
			}
			if k == syntax.KErrorRow || k == syntax.KCaseClause || k == syntax.KCatchArm {
				let list = match syntax.ViewOf(p.Tree, n) {
				case syntax.ErrorRow as r:
					r.Types
				case syntax.CaseClause as c:
					c.List
				case syntax.CatchArm as c:
					c.Types
				case _:
					continue
				}
				for j in 0..syntax.Len(list) {
					let site = syntax.Item(p.Tree, list, j)
					// A case on the union's own name is not a variant
					// test. A dynamic narrowing or a row needs its proof.
					if names(p, site, shape.name) {
						return false
					}
					if k != syntax.KCaseClause && unionNames(p, site, shape) {
						return false
					}
				}
			}
		}
	}
	true
}

func unionNames(p syntax.Parsed, site dense.ID[syntax.Node], shape unionShape) bool {
	if names(p, site, shape.name) {
		return true
	}
	for v in shape.variants {
		if names(p, site, v.name) {
			return true
		}
	}
	false
}

func unionTagOfType(shape unionShape, t dense.ID[store.TKey]) int {
	for i, v in shape.variants {
		if v.t == t {
			return i
		}
	}
	-1
}

func unionTagOfName(st fnb, shape unionShape, n dense.ID[syntax.Node]) int {
	if syntax.KindOf(st.p.Tree, n) != syntax.KIdent {
		return -1
	}
	match bind.ResolutionOf(st.k.U, st.k.Ps, bind.PNodeOf(st.k.Ps, st.file, n)) {
	case bind.Declared as d:
		for i, v in shape.variants {
			if v.decl == d.At {
				return i
			}
		}
	case _:
	}
	-1
}

type unionInjection {
	typ     string,
	variant string,
	tag     int,
	at      int,
	field   string,
	operand dense.Opt[syntax.Node],
}

func unionReturn(st mut fnb, p mut controlPlan, x dense.ID[syntax.Node], result dense.ID[store.TKey]) Option[unionInjection] fails Unported {
	if unionGo(*st, result) == "" {
		return None
	}
	let v = unparen(*st, x)
	let t = try typeOf(*st, v, "union result")
	if t == result {
		return None
	}
	let shape = match unionNamed(*st, result) {
	case Some{Value: s}:
		s
	case None:
		return stop("union: generic injection layout")
	}
	let tag = unionTagOfType(shape, t)
	if tag < 0 || !unionFlat(*st, shape) {
		return stop("union: unproved injection layout")
	}
	let variant = shape.variants[tag]
	let at = syntax.NodePos(st.p, v)
	let mut j = unionInjection{typ: shape.typ, variant: variant.typ, tag: tag, at: at, field: "", operand: dense.NoID[syntax.Node]()}
	match syntax.ViewOf(st.p.Tree, v) {
	case syntax.Name:
		if variant.field != None || unionTagOfName(*st, shape, v) != tag {
			return stop("union: result is not a bare empty variant")
		}
	case syntax.CompositeLit as cl:
		let f = match variant.field {
		case Some{Value: f}:
			f
		case None:
			return stop("union: explicit empty literal")
		}
		if dense.Unpack(cl.Base) != None || syntax.Len(cl.Elts) != 1 {
			return stop("union: payload literal shape")
		}
		let e = syntax.Item(st.p.Tree, cl.Elts, 0)
		let operand = match syntax.ViewOf(st.p.Tree, e) {
		case syntax.KeyValueExpr as kv:
			if nameText(st.p, kv.Key) != f.Name {
				return stop("union: payload key")
			}
			kv.Value
		case _:
			e
		}
		if (try typeOf(*st, operand, "union payload")) != f.T || callsIn(st.p, operand) {
			return stop("union: adapted payload")
		}
		try controlOperand(*st, p, operand)
		j.field = f.Name
		j.operand = dense.OptOf(operand)
	case _:
		return stop("union: injection operand")
	}
	Some{Value: j}
}

func unionEmitReturn(st fnb, b mut ir.Builder, j unionInjection, at ir.Pos) uint32 fails Unported | ir.Malformed {
	let p = pos(st, j.at)
	let variant = match dense.Unpack(j.operand) {
	case Some{Value: x}:
		let payload = try value(st, b, x)
		try ir.Row(b, ir.KindCode(ir.TExpr, "lit"), p, []uint32{ir.Text(b, j.variant), ir.List(b, []uint32{payload}), ir.List(b, []uint32{ir.Text(b, j.field)})})
	case None:
		try ir.Row(b, ir.KindCode(ir.TExpr, "zero"), p, []uint32{ir.Text(b, j.variant)})
	}
	let receiver = try ir.Row(b, ir.KindCode(ir.TExpr, "zero"), p, []uint32{ir.Text(b, j.typ)})
	let method = "of" + strconv.Itoa(j.tag)
	let injected = try ir.Row(b, ir.KindCode(ir.TExpr, "mcall"), p, []uint32{receiver, ir.Text(b, method), ir.List(b, []uint32{variant})})
	try ir.Row(b, ir.KindCode(ir.TStmt, "ret"), at, []uint32{injected})
}
