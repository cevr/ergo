import compiler/check/bind
import compiler/check/expr
import compiler/check/store
import compiler/check/types
import compiler/ir
import compiler/syntax
import dense
import option
import strconv

type unionVariant {
	t       dense.Opt[store.TKey],
	decl    dense.Opt[store.PNode],
	impPath string,
	name    string,
	typ     string,
	fields  []expr.Field,
	holds   bool,
}

type unionLayout =
	| UnionFlat{}
	| UnionSealed{}
	| UnionUnproved{Why string}

// The variants are indexed by the checked declaration order. The small
// flat profile holds one byte tag and SSA-fitting shared slots; sealed
// interfaces handle all-error and above-128B unions.
type unionShape {
	name     string,
	typ      string,
	layout   unionLayout,
	flat     bool,
	variants []unionVariant,
}

func unionGo(st fnb, t dense.ID[store.TKey]) string {
	unionGoWithin(st, t, shapeTrail{seen: []shapeVisit{}, deps: shapeDeps(st)})
}

func unionGoWithin(st fnb, t dense.ID[store.TKey], trail shapeTrail) string {
	match unionNamedWithin(st, t, trail) {
	case option.Some{Value: shape}:
		shape.typ
	case option.None:
		unionInstanceShape(st, t, trail)
	}
}

func unionPlainDecl(st fnb, name string) bool {
	let site = match syntaxTypeDecl(st, name) {
	case option.Some{Value: s}:
		s
	case option.None:
		return false
	}
	if dense.Unpack(site.td.Extern) != option.None || dense.Unpack(site.td.Where) != option.None || dense.Unpack(site.td.Derive) != option.None || syntax.Len(site.td.Implements) != 0 {
		return false
	}
	let p = st.k.Parsed[site.file]
	match dense.Unpack(site.td.Spec) {
	case option.Some{Value: spec}:
		syntax.KindOf(p.Tree, spec) == syntax.KInterfaceType
	case option.None:
		false
	}
}

// This is type spelling only. The same nominal type names a native
// generic union whether it has shared slots or a sealed interface.
// Host/niche/row arguments do not acquire a Go type here.
func unionInstanceGo(st fnb, t dense.ID[store.TKey]) string {
	unionInstanceShape(st, t, shapeTrail{seen: []shapeVisit{}, deps: shapeDeps(st)})
}

func unionInstanceShape(st fnb, t dense.ID[store.TKey], trail shapeTrail) string {
	let (okOpt, optElem) = optionKind(st, t)
	if okOpt == "Option" {
		let eg = shapeWithin(st, optElem, trail)
		if eg == "" {
			return ""
		}
		let head = if st.alias == "option" { "Option" } else { pkgAlias("option") + "__Option" }
		return head + "[" + eg + "]"
	}
	if store.KindOfType(st.s, t) != store.KInstance {
		return ""
	}
	let o = store.OriginOfType(st.s, t)
	let i = int(o.Decl)
	let args = store.OperandsOf(st.s, t)
	if args.Len() == 0 {
		return ""
	}
	let head = if int(o.Import) == store.ForeignBit {
		if i >= st.k.Foreign.Len() {
			return ""
		}
		let f = st.k.Foreign[i]
		let isPrelude = f.Path == "prelude" && has(st.prelude, f.Name)
		let isOption = f.Path == "option" && f.Name == "Option"
		if (!isPrelude && !isOption) || (isPrelude && f.Qual != "-") || f.Variants.Len() == 0 || f.Arity != args.Len() {
			return ""
		}
		if isOption { pkgAlias(f.Path) + "__" + f.Name } else { f.Name }
	} else if int(o.Import) == 0 {
		let name = store.DeclText(st.s, i)
		if !unionPlainDecl(st, name) || !localAllTypeParams(st, name, args.Len()) {
			return ""
		}
		let d = match store.Lookup(st.s, name) {
		case option.Some{Value: id}:
			id
		case option.None:
			return ""
		}
		let nt = match namedKeyIn(st.idx, d) {
		case option.Some{Value: k}:
			k
		case option.None:
			return ""
		}
		if unionVarsIn(st.idx, nt).Len() < 2 {
			return ""
		}
		declName(st, name) catch {
		case Unported:
			return ""
		}
	} else if int(o.Import) <= st.k.Ifaces.Len() {
		let imp = st.k.Ifaces[int(o.Import)-1]
		if i < 0 || i >= imp.Decls.Len() {
			return ""
		}
		let idecl = imp.Decls[i]
		if !idecl.Type || idecl.Alias || idecl.Variants.Len() < 2 || !allKindType(idecl.Kinds, args.Len()) {
			return ""
		}
		let dep = match trail.deps.Get(imp.Path) {
		case option.Some{Value: d}:
			d
		case option.None:
			return ""
		}
		let owner = fnb{..st, k: dep.K, s: dep.S, alias: pkgAlias(dep.Path), pkgPath: dep.Path, idx: depIdxOf(st.cache, dep.Path)}
		if !unionPlainDecl(owner, idecl.Name) {
			return ""
		}
		declName(owner, idecl.Name) catch {
		case Unported:
			return ""
		}
	} else {
		return ""
	}
	let mut name = head + "["
	for j, arg in args {
		let gt = shapeWithin(st, arg, trail)
		if gt == "" {
			return ""
		}
		name += (if j == 0 { "" } else { ", " }) + gt
	}
	name + "]"
}

func optionKind(st fnb, t dense.ID[store.TKey]) (string, dense.ID[store.TKey]) {
	let kind = store.KindOfType(st.s, t)
	if kind == store.KForeign {
		let arg = store.ArgOf(st.s, t)
		if arg < st.k.Foreign.Len() && st.k.Foreign[arg].Path == "option" && st.k.Foreign[arg].Name == "None" {
			return ("None", t)
		}
		return ("", t)
	}
	if kind == store.KInstance {
		let o = store.OriginOfType(st.s, t)
		let ops = store.OperandsOf(st.s, t)
		let di = int(o.Decl)
		if int(o.Import) == store.ForeignBit {
			if di < st.k.Foreign.Len() && st.k.Foreign[di].Path == "option" {
				let nm = st.k.Foreign[di].Name
				if nm == "None" && ops.Len() == 0 {
					return ("None", t)
				}
				if (nm == "Some" || nm == "Option") && ops.Len() == 1 {
					return (nm, ops[0])
				}
			}
		} else if int(o.Import) == 0 {
			if st.alias == "option" {
				let nm = store.DeclText(st.s, di)
				if nm == "None" && ops.Len() == 0 {
					return ("None", t)
				}
				if (nm == "Some" || nm == "Option") && ops.Len() == 1 {
					return (nm, ops[0])
				}
			}
		} else if int(o.Import) <= st.k.Ifaces.Len() {
			let imp = st.k.Ifaces[int(o.Import)-1]
			if imp.Path == "option" && di >= 0 && di < imp.Decls.Len() {
				let nm = imp.Decls[di].Name
				if nm == "None" && ops.Len() == 0 {
					return ("None", t)
				}
				if (nm == "Some" || nm == "Option") && ops.Len() == 1 {
					return (nm, ops[0])
				}
			}
		}
		return ("", t)
	}
	if kind == store.KNamed && st.alias == "option" && store.TypeNameText(st.s, store.ArgOf(st.s, t)) == "None" {
		return ("None", t)
	}
	("", t)
}

func optionVariantGo(st fnb, t dense.ID[store.TKey], trail shapeTrail) string {
	let (ok, elem) = optionKind(st, t)
	if ok == "None" {
		return if st.alias == "option" { "None" } else { pkgAlias("option") + "__None" }
	}
	if ok == "Some" {
		let eg = shapeWithin(st, elem, trail)
		if eg == "" {
			return ""
		}
		let head = if st.alias == "option" { "Some" } else { pkgAlias("option") + "__Some" }
		return head + "[" + eg + "]"
	}
	""
}

func unionVariantRecordGo(st fnb, t dense.ID[store.TKey], trail shapeTrail) string {
	if store.KindOfType(st.s, t) != store.KNamed {
		return ""
	}
	let name = store.TypeNameText(st.s, store.ArgOf(st.s, t))
	let (vp, v, _) = match unionDeclParent(st, name) {
	case option.Some{Value: d}:
		d
	case option.None:
		return ""
	}
	match syntax.ViewOf(vp.Tree, v) {
	case syntax.VariantSpec as variant:
		if dense.Unpack(variant.TypeArgs) != option.None {
			return ""
		}
	case _:
		return ""
	}
	let fields = match unionRecordFields(st, name) {
	case option.Some{Value: fs}:
		fs
	case option.None:
		return ""
	}
	let gt = declName(st, name) catch {
	case Unported:
		return ""
	}
	recordShape(st, t, fields, gt, trail)
}

func unionNamed(st fnb, t dense.ID[store.TKey]) option.Option[unionShape] {
	let mut out = match unionNamedWithin(st, t, shapeTrail{seen: []shapeVisit{}, deps: shapeDeps(st)}) {
	case option.Some{Value: shape}:
		shape
	case option.None:
		return option.None
	}
	out.layout = classifyUnionLayout(st, out, t)
	out.flat = match out.layout {
	case UnionFlat:
		true
	case _:
		false
	}
	option.Some{Value: out}
}

func unionNamedWithin(st fnb, t dense.ID[store.TKey], trail shapeTrail) option.Option[unionShape] {
	if store.KindOfType(st.s, t) != store.KNamed {
		return option.None
	}
	let vs = unionVarsIn(st.idx, t)
	if vs.Len() < 2 || vs.Len() > 255 {
		return option.None
	}
	let name = store.TypeNameText(st.s, store.ArgOf(st.s, t))
	let (p, parent, at) = match unionDeclParent(st, name) {
	case option.Some{Value: d}:
		d
	case option.None:
		return option.None
	}
	let list = match syntax.ViewOf(p.Tree, parent) {
	case syntax.TypeDecl as td:
		if td.Name != at || dense.Unpack(td.Extern) != option.None || dense.Unpack(td.TypeParams) != option.None || dense.Unpack(td.Where) != option.None || dense.Unpack(td.Derive) != option.None || syntax.Len(td.Implements) != 0 {
			return option.None
		}
		match dense.Unpack(td.Spec) {
		case option.Some{Value: spec}:
			match syntax.ViewOf(p.Tree, spec) {
			case syntax.InterfaceType as it:
				it.Members
			case _:
				return option.None
			}
		case option.None:
			return option.None
		}
	case _:
		return option.None
	}
	if syntax.Len(list) != vs.Len() {
		return option.None
	}
	let gt = declName(st, name) catch {
	case Unported:
		return option.None
	}
	let visit = shapeVisit{owner: st.alias, t: t}
	for id in trail.seen {
		if id.owner == visit.owner && id.t == visit.t {
			return option.Some{Value: unionShape{name: name, typ: gt, layout: UnionUnproved{Why: "unclassified"}, flat: false, variants: []unionVariant{}}}
		}
	}
	let path = shapeTrail{..trail, seen: trail.seen.Append(visit)}
	let mut variants = []unionVariant{}
	for tag, v in vs {
		let node = syntax.Item(p.Tree, list, tag)
		let (vn, isRef) = match syntax.ViewOf(p.Tree, node) {
		case syntax.VariantSpec as variant:
			if dense.Unpack(variant.TypeArgs) != option.None {
				return option.None
			}
			(nameText(p, variant.Name), false)
		case syntax.Name:
			(nameText(p, node), true)
		case _:
			return option.None
		}
		if isRef && !structDecl(st, vn) {
			return option.None
		}
		if store.KindOfType(st.s, v) != store.KNamed || store.TypeNameText(st.s, store.ArgOf(st.s, v)) != vn {
			return option.None
		}
		let decl = match store.Lookup(st.s, vn) {
		case option.Some{Value: d}:
			store.DeclOf(st.s, d)
		case option.None:
			return option.None
		}
		let vp = st.k.Parsed[int(decl.File)]
		let id = bind.PNodeOf(st.k.Ps, int(decl.File), syntax.NodeAt(vp.Tree, int(decl.Node)))
		let fields = match unionRecordFields(st, vn) {
		case option.Some{Value: fs}:
			fs
		case option.None:
			return option.None
		}
		for f in fields {
			if !ordinaryFieldName(f.Name) || shapeWithin(st, f.T, path) == "" {
				return option.None
			}
		}
		let vt = declName(st, vn) catch {
		case Unported:
			return option.None
		}
		variants = variants.Append(unionVariant{t: dense.OptOf(v), decl: dense.OptOf(id), impPath: "", name: vn, typ: vt, fields: fields, holds: holdsValue(st, v)})
	}
	option.Some{Value: unionShape{name: name, typ: gt, layout: UnionUnproved{Why: "unclassified"}, flat: false, variants: variants}}
}

func unionRecordFields(st fnb, name string) option.Option[[]expr.Field] {
	if st.idx.valid {
		return match st.idx.unionRecs.Get(name) {
		case option.Some{Value: r}:
			option.Some{Value: st.k.Recs[r].Fields}
		case option.None:
			option.None
		}
	}
	for r in st.k.Recs {
		if r.Name == name && !r.Op && r.Params.Len() == 0 {
			return option.Some{Value: r.Fields}
		}
	}
	option.None
}

func unionDeclParent(st fnb, name string) option.Option[(syntax.Parsed, dense.ID[syntax.Node], dense.ID[syntax.Node])] {
	let d = match store.Lookup(st.s, name) {
	case option.Some{Value: d}:
		store.DeclOf(st.s, d)
	case option.None:
		return option.None
	}
	let f = int(d.File)
	let p = st.k.Parsed[f]
	let at = syntax.NodeAt(p.Tree, int(d.Node))
	match dense.Unpack(bind.ParentOf(st.k.Ps, bind.PNodeOf(st.k.Ps, f, at))) {
	case option.Some{Value: id}:
		let (_, row) = bind.RowOf(st.k.Ps, id)
		option.Some{Value: (p, syntax.NodeAt(p.Tree, row), at)}
	case option.None:
		option.None
	}
}

type goLayout {
	size       int,
	align      int,
	ssa        bool,
	known      bool,
	minHit     int,
	hostOpaque bool,
}

func knownGoLayout(size int, align int, ssa bool) goLayout {
	goLayout{size: size, align: align, ssa: ssa, known: true, minHit: -1, hostOpaque: false}
}

func maxInt(a int, b int) int { if a > b { a } else { b } }

func minHitMerge(a int, b int) int {
	if a < 0 {
		return b
	}
	if b < 0 {
		return a
	}
	if a < b { a } else { b }
}

func roundUp(n int, align int) int {
	if align <= 1 {
		return n
	}
	(n + align - 1) / align * align
}

func structLayout(fields []goLayout) goLayout {
	let mut off = 0
	let mut align = 1
	let mut ssa = fields.Len() <= 4
	let mut known = true
	let mut minHit = -1
	let mut hostOpaque = false
	for f in fields {
		if !f.known {
			known = false
			minHit = minHitMerge(minHit, f.minHit)
			hostOpaque = hostOpaque || f.hostOpaque
			continue
		}
		off = roundUp(off, f.align) + f.size
		align = maxInt(align, f.align)
		ssa = ssa && f.ssa
	}
	if !known {
		return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: minHit, hostOpaque: hostOpaque}
	}
	let size = roundUp(off, align)
	knownGoLayout(size, align, ssa && size <= 32)
}

func goBasicSize(bt string) (int, int) {
	if bt == "bool" || bt == "int8" || bt == "uint8" {
		return (1, 1)
	}
	if bt == "int16" || bt == "uint16" {
		return (2, 2)
	}
	if bt == "int32" || bt == "uint32" || bt == "float32" {
		return (4, 4)
	}
	if bt == "string" {
		return (16, 8)
	}
	(8, 8)
}

func goLayoutNestedUnion(st fnb, shape unionShape, t dense.ID[store.TKey], next []shapeVisit, selfIdx int) goLayout {
	let nlay = unionSharedLayout(st, shape, next)
	if !nlay.known && nlay.minHit >= 0 && nlay.minHit < selfIdx {
		return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: nlay.minHit, hostOpaque: nlay.hostOpaque}
	}
	let isAllErr = if st.cache.active && st.cache.unionEnv.ready {
		cacheAllErrorUnion(st, shape)
	} else {
		let (ae, _) = collectErrorTypeCheck(st, shape)
		ae
	}
	if isAllErr || (!nlay.known && (nlay.minHit == selfIdx || nlay.hostOpaque)) {
		return knownGoLayout(16, 8, true)
	}
	if st.cache.active && st.cache.unionEnv.ready {
		match classifyUnionLayoutSeen(st, shape, t, next) {
		case UnionFlat:
			return goLayout{..nlay, minHit: -1, hostOpaque: false}
		case UnionSealed:
			return knownGoLayout(16, 8, true)
		case UnionUnproved:
			return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: false}
		}
	}
	goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: false}
}

func goLayoutOf(st fnb, t dense.ID[store.TKey], seen []shapeVisit) goLayout {
	let sb = scalarBasicGo(st, t)
	if sb != "" {
		let (sz, al) = goBasicSize(sb)
		return knownGoLayout(sz, al, true)
	}
	let kind = store.KindOfType(st.s, t)
	if kind == store.KBasic && store.ArgOf(st.s, t) == 18 {
		return knownGoLayout(8, 8, true)
	}
	if kind == store.KSlice {
		return knownGoLayout(24, 8, true)
	}
	if kind == store.KMap || kind == store.KPointer || kind == store.KSig {
		return knownGoLayout(8, 8, true)
	}
	let visit = shapeVisit{owner: st.alias, t: t}
	for idx, id in seen {
		if id.owner == visit.owner && id.t == visit.t {
			return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: idx, hostOpaque: false}
		}
	}
	if seen.Len() >= 32 {
		return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: false}
	}
	let selfIdx = seen.Len()
	let next = seen.Append(visit)
	if kind == store.KArray {
		let ops = store.OperandsOf(st.s, t)
		if ops.Len() < 2 {
			return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: false}
		}
		let n = store.ArrayLen(st.s, t)
		let el = goLayoutOf(st, ops[1], next)
		if !el.known {
			return el
		}
		return knownGoLayout(el.size*n, el.align, n == 0 || n == 1 && el.ssa)
	}
	if kind == store.KTuple {
		let mut fs = []goLayout{}
		for op in store.OperandsOf(st.s, t) {
			fs = fs.Append(goLayoutOf(st, op, next))
		}
		return structLayout(fs)
	}
	let (okOpt, optElem) = optionKind(st, t)
	if okOpt == "Option" {
		let el = goLayoutOf(st, optElem, next)
		return structLayout([]goLayout{knownGoLayout(1, 1, true), el})
	}
	if kind == store.KForeign {
		if hostShapeWithin(st, t, shapeTrail{seen: next, deps: shapeDeps(st)}) != "" {
			return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: true}
		}
	}
	if kind == store.KInstance && store.OperandsOf(st.s, t).Len() > 0 {
		let o = store.OriginOfType(st.s, t)
		if int(o.Import) == store.ForeignBit && int(o.Decl) < st.k.Foreign.Len() {
			let fk = st.k.Foreign[int(o.Decl)]
			if fk.Qual == "go" && fk.Name == "Ref" {
				return knownGoLayout(8, 8, true)
			}
		}
		if int(o.Import) > 0 && int(o.Import) <= st.k.Ifaces.Len() && int(o.Decl) >= 0 && int(o.Decl) < st.k.Ifaces[int(o.Import)-1].Decls.Len() {
			let imp = st.k.Ifaces[int(o.Import)-1]
			match shapeDeps(st).Get(imp.Path) {
			case option.Some{Value: dep}:
				let owner = fnb{..st, k: dep.K, s: dep.S, alias: pkgAlias(dep.Path), pkgPath: dep.Path, idx: depIdxOf(st.cache, dep.Path)}
				if isRuntimeOpsType(owner, imp.Decls[int(o.Decl)].Name) {
					return knownGoLayout(8, 8, true)
				}
			case option.None:
			}
		}
		if int(o.Import) == 0 && isRuntimeOpsType(st, store.DeclText(st.s, int(o.Decl))) {
			return knownGoLayout(8, 8, true)
		}
		match unionGenericDescriptorStore(st, t) {
		case option.Some{Value: got}:
			let (gs, gshape) = got
			if !gshape.flat {
				return knownGoLayout(16, 8, true)
			}
			return unionSharedLayout(fnb{..st, s: gs}, gshape, next)
		case option.None:
		}
		match recordFieldsOfStore(st, t) {
		case option.Some{Value: got}:
			let (rs, rfs) = got
			let mut fs = []goLayout{}
			let rst = fnb{..st, s: rs}
			for f in rfs {
				fs = fs.Append(goLayoutOf(rst, f.T, next))
			}
			return structLayout(fs)
		case option.None:
		}
	}
	let r = ordinaryRecord(st, t)
	if r >= 0 {
		let mut fs = []goLayout{}
		for f in st.k.Recs[r].Fields {
			fs = fs.Append(goLayoutOf(st, f.T, next))
		}
		return structLayout(fs)
	}
	match importedShapeOf(st, t, shapeDeps(st)) {
	case option.Some{Value: imported}:
		let owner = fnb{..st, k: imported.dep.K, s: imported.dep.S, alias: pkgAlias(imported.dep.Path), pkgPath: imported.dep.Path, idx: depIdxOf(st.cache, imported.dep.Path)}
		let named = match namedKeyIn(owner.idx, imported.decl) {
		case option.Some{Value: k}:
			k
		case option.None:
			return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: false}
		}
		match importedRecord(owner, named) {
		case option.Some{Value: rec}:
			let mut fs = []goLayout{}
			for f in rec.fields {
				fs = fs.Append(goLayoutOf(owner, f.T, next))
			}
			return structLayout(fs)
		case option.None:
			if scalarBasicGo(owner, named) != "" {
				let (sz, al) = goBasicSize(scalarBasicGo(owner, named))
				return knownGoLayout(sz, al, true)
			}
			let impName = store.TypeNameText(owner.s, store.ArgOf(owner.s, named))
			if isRuntimeOpsType(owner, impName) {
				return knownGoLayout(8, 8, true)
			}
			let mut local = owner.s
			match aliasTargetNamed(owner, impName, &local) {
			case option.Some{Value: resolved}:
				let (nextOwner, tt) = resolved
				return goLayoutOf(nextOwner, tt, next)
			case option.None:
			}
			match unionNamedWithin(owner, named, shapeTrail{seen: next, deps: shapeDeps(owner)}) {
			case option.Some{Value: nested}:
				return goLayoutNestedUnion(owner, nested, named, next, selfIdx)
			case option.None:
			}
			return goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: false}
		}
	case option.None:
	}
	if kind == store.KNamed {
		let name = store.TypeNameText(st.s, store.ArgOf(st.s, t))
		if isRuntimeOpsType(st, name) {
			return knownGoLayout(8, 8, true)
		}
		let mut local = st.s
		match aliasTargetNamed(st, name, &local) {
		case option.Some{Value: resolved}:
			let (nextOwner, tt) = resolved
			return goLayoutOf(nextOwner, tt, next)
		case option.None:
		}
		match unionDeclParent(st, name) {
		case option.Some{Value: parent}:
			let (vp, v, _) = parent
			if syntax.KindOf(vp.Tree, v) == syntax.KVariantSpec {
				match unionRecordFields(st, name) {
				case option.Some{Value: fields}:
					let mut fs = []goLayout{}
					for f in fields {
						fs = fs.Append(goLayoutOf(st, f.T, next))
					}
					return structLayout(fs)
				case option.None:
				}
			}
		case option.None:
		}
		if unionVarsIn(st.idx, t).Len() >= 2 {
			match unionNamedWithin(st, t, shapeTrail{seen: next, deps: shapeDeps(st)}) {
			case option.Some{Value: nested}:
				return goLayoutNestedUnion(st, nested, t, next, selfIdx)
			case option.None:
			}
		}
	}
	goLayout{size: 0, align: 1, ssa: false, known: false, minHit: -1, hostOpaque: false}
}

func unionSlotKey(st fnb, t dense.ID[store.TKey]) string {
	let kind = store.KindOfType(st.s, t)
	if kind == store.KTuple || kind == store.KSig {
		return ""
	}
	if kind == store.KParam {
		return "param:" + strconv.Itoa(store.ArgOf(st.s, t))
	}
	if kind == store.KSlice {
		let ops = store.OperandsOf(st.s, t)
		if ops.Len() < 1 {
			return ""
		}
		let ek = unionSlotKey(st, ops[0])
		return if ek == "" { "" } else { "[]" + ek }
	}
	if kind == store.KArray {
		let ops = store.OperandsOf(st.s, t)
		if ops.Len() < 2 {
			return ""
		}
		let ek = unionSlotKey(st, ops[1])
		return if ek == "" { "" } else { "[" + strconv.Itoa(store.ArrayLen(st.s, t)) + "]" + ek }
	}
	if kind == store.KMap {
		let kv = store.OperandsOf(st.s, t)
		if kv.Len() < 2 {
			return ""
		}
		let kk = unionSlotKey(st, kv[0])
		let vk = unionSlotKey(st, kv[1])
		return if kk == "" || vk == "" { "" } else { "map[" + kk + "]" + vk }
	}
	if kind == store.KBasic {
		if store.ArgOf(st.s, t) == 18 {
			return "time.Duration"
		}
		return basicGo(st, t)
	}
	if kind == store.KNamed {
		return shapeGo(st, t)
	}
	if kind == store.KForeign {
		let fi = store.ArgOf(st.s, t)
		if fi < st.k.Foreign.Len() && st.k.Foreign[fi].Arity == 0 {
			return shapeGo(st, t)
		}
	}
	if kind == store.KInstance && store.OperandsOf(st.s, t).Len() == 0 {
		return shapeGo(st, t)
	}
	""
}

func unionSharedLayout(st fnb, shape unionShape, seen []shapeVisit) goLayout {
	let mut slotKeys = []string{}
	let mut slotLayouts = []goLayout{}
	for v in shape.variants {
		let mut used = []bool{}
		for _ in 0..slotKeys.Len() {
			used = used.Append(false)
		}
		for f in v.fields {
			let key = unionSlotKey(st, f.T)
			let mut matched = -1
			if key != "" {
				for j, kj in slotKeys {
					if kj == key && !used[j] {
						matched = j
						used[j] = true
						break
					}
				}
			}
			if matched < 0 {
				slotKeys = slotKeys.Append(key)
				used = used.Append(true)
				slotLayouts = slotLayouts.Append(goLayoutOf(st, f.T, seen))
			}
		}
	}
	let mut allFields = []goLayout{knownGoLayout(1, 1, true)}
	for fl in slotLayouts {
		allFields = allFields.Append(fl)
	}
	structLayout(allFields)
}

func collectErrorTypeCheck(st fnb, shape unionShape) (bool, bool) {
	let mut variantErr = []bool{}
	for _ in shape.variants {
		variantErr = variantErr.Append(false)
	}
	let mut anyUnionNameInRow = false
	let markPkg = func(pkg fnb) {
		for f in pkg.k.Fns {
			let ops = store.OperandsOf(pkg.s, f.Sig)
			if store.KindOfType(pkg.s, f.Sig) == store.KSig && ops.Len() >= 3 {
				let row = ops[ops.Len()-2]
				if store.KindOfType(pkg.s, row) == store.KRow {
					for m in store.OperandsOf(pkg.s, row) {
						if store.KindOfType(pkg.s, m) == store.KNamed {
							let mn = store.TypeNameText(pkg.s, store.ArgOf(pkg.s, m))
							for vi, v in shape.variants {
								if mn == v.name && pkg.alias == st.alias {
									variantErr[vi] = true
								}
							}
						} else {
							let (mp, mn, ma) = expr.ImportedRec(pkg.s, pkg.k, m)
							if mp != "" && ma.Len() == 0 && pkgAlias(mp) == st.alias {
								for vi, v in shape.variants {
									if mn == v.name {
										variantErr[vi] = true
									}
								}
							}
						}
					}
				}
			}
		}
		for fi, p in pkg.k.Parsed {
			for i in 0..syntax.NumNodes(p.Tree) {
				let n = syntax.NodeAt(p.Tree, i)
				match syntax.ViewOf(p.Tree, n) {
				case syntax.ErrorRow as r:
					for j in 0..syntax.Len(r.Types) {
						let item = syntax.Item(p.Tree, r.Types, j)
						let samePkg = match syntax.ViewOf(p.Tree, item) {
						case syntax.Name:
							pkg.alias == st.alias
						case syntax.SelectorExpr as se:
							match bind.ResolutionOf(pkg.k.U, pkg.k.Ps, bind.PNodeOf(pkg.k.Ps, fi, se.Sel)) {
							case bind.Imported as im:
								let ix = int(im.Ref.Import) - 1
								let paths = store.ImportPaths(pkg.s)
								ix >= 0 && ix < paths.Len() && pkgAlias(paths[ix]) == st.alias
							case _:
								false
							}
						case _:
							false
						}
						if samePkg && names(p, item, shape.name) {
							anyUnionNameInRow = true
						}
						if samePkg {
							for vi, v in shape.variants {
								if names(p, item, v.name) {
									variantErr[vi] = true
								}
							}
						}
					}
				case _:
				}
			}
		}
	}
	markPkg(st)
	match st.rootImports {
	case option.Some[[]expr.Dep] as deps:
		for dep in deps.Value {
			markPkg(fnb{..st, k: dep.K, s: dep.S, alias: pkgAlias(dep.Path)})
		}
	case option.None:
	}
	if anyUnionNameInRow {
		return (true, true)
	}
	let mut all = true
	let mut any = false
	for ve in variantErr {
		all = all && ve
		any = any || ve
	}
	(all, any)
}

func isMachineUnion(st fnb, shape unionShape) bool {
	let checkPkg = func(pkg fnb) bool {
		for p in pkg.k.Parsed {
			for i in 0..syntax.NumNodes(p.Tree) {
				let n = syntax.NodeAt(p.Tree, i)
				match syntax.ViewOf(p.Tree, n) {
				case syntax.MachineType as mt:
					if names(p, mt.State, shape.name) || names(p, mt.Signal, shape.name) {
						return true
					}
				case _:
				}
			}
		}
		false
	}
	if checkPkg(st) {
		return true
	}
	match st.rootImports {
	case option.Some[[]expr.Dep] as deps:
		for dep in deps.Value {
			if checkPkg(fnb{..st, k: dep.K, s: dep.S, alias: pkgAlias(dep.Path)}) {
				return true
			}
		}
	case option.None:
	}
	false
}

func hasRootExternOrWire(st fnb) bool {
	for p in st.k.Parsed {
		for i in 0..syntax.NumNodes(p.Tree) {
			let n = syntax.NodeAt(p.Tree, i)
			let k = syntax.KindOf(p.Tree, n)
			if k == syntax.KExternSpec || k == syntax.KIdent && nameText(p, n) == "WireForm" {
				return true
			}
		}
	}
	false
}

func cacheAllErrorUnion(st fnb, shape unionShape) bool {
	if st.cache.unionEnv.errKey.Get(st.alias+"\x00"+shape.name) != option.None {
		return true
	}
	let mut allErr = true
	for v in shape.variants {
		let ve = st.cache.unionEnv.errKey.Get(st.alias+"\x00"+v.name) != option.None
		allErr = allErr && ve
	}
	allErr
}

func classifyUnionLayoutSeen(st fnb, shape unionShape, t dense.ID[store.TKey], seen []shapeVisit) unionLayout {
	let allErr = if st.cache.active && st.cache.unionEnv.ready {
		cacheAllErrorUnion(st, shape)
	} else {
		let (ae, _) = collectErrorTypeCheck(st, shape)
		ae
	}
	if allErr {
		return UnionSealed
	}
	let lay = unionSharedLayout(st, shape, seen)
	if !lay.known && (lay.minHit >= 0 || lay.hostOpaque) {
		return UnionSealed
	}
	if st.cache.active {
		if !st.cache.unionEnv.ready || st.cache.unionEnv.hasWireForm {
			return UnionUnproved{Why: "union pass not ready or WireForm"}
		}
		if st.cache.unionEnv.extKey.Get(st.alias+"\x00"+shape.name) != option.None {
			return UnionSealed
		}
		if lay.ssa {
			return UnionFlat
		}
		if st.cache.unionEnv.machKey.Get(st.alias+"\x00"+shape.name) != option.None {
			return UnionFlat
		}
		if !lay.known {
			return UnionUnproved{Why: "layout unknown"}
		}
		if lay.size > 128 {
			return UnionSealed
		}
		if st.cache.unionEnv.carriedKey.Get(st.alias+"\x00"+shape.name) != option.None {
			return UnionSealed
		}
		return UnionFlat
	}
	if st.rootImports == option.None || st.alias != "" {
		return UnionUnproved{Why: "no program context"}
	}
	if hasRootExternOrWire(st) {
		return UnionUnproved{Why: "root extern or WireForm"}
	}
	if lay.ssa {
		return UnionFlat
	}
	if !lay.known {
		return UnionUnproved{Why: "layout unknown"}
	}
	if isMachineUnion(st, shape) {
		return UnionFlat
	}
	if lay.size > 128 {
		return UnionSealed
	}
	UnionUnproved{Why: "flat by use unproved"}
}

func classifyUnionLayout(st fnb, shape unionShape, t dense.ID[store.TKey]) unionLayout {
	classifyUnionLayoutSeen(st, shape, t, []shapeVisit{shapeVisit{owner: st.alias, t: t}})
}

func genericTypeCycles(st fnb, root dense.ID[store.TKey], cur dense.ID[store.TKey], seen mut []uint32) bool {
	let kind = store.KindOfType(st.s, cur)
	if kind == store.KSlice || kind == store.KMap || kind == store.KPointer || kind == store.KSig || kind == store.KParam || kind == store.KBasic {
		return false
	}
	if kind == store.KInstance {
		let o = store.OriginOfType(st.s, cur)
		let rootName = store.TypeNameText(st.s, store.ArgOf(st.s, root))
		if int(o.Import) == 0 && store.DeclText(st.s, int(o.Decl)) == rootName {
			return true
		}
		let ci = uint32(dense.Index(cur))
		for id in *seen {
			if id == ci {
				return false
			}
		}
		*seen = (*seen).Append(ci)
		let (okOpt, optElem) = optionKind(st, cur)
		if okOpt == "Option" {
			return genericTypeCycles(st, root, optElem, seen)
		}
		if int(o.Import) == 0 {
			let cname = store.DeclText(st.s, int(o.Decl))
			for rec in st.k.Recs {
				if rec.Name == cname && !rec.Op && rec.Params.Len() == store.OperandsOf(st.s, cur).Len() {
					let mut local = st.s
					let cargs = store.OperandsOf(st.s, cur)
					for f in rec.Fields {
						let sub = store.TSubst(&local, f.T, cargs)
						if genericTypeCycles(fnb{..st, s: local}, root, sub, seen) {
							return true
						}
					}
					return false
				}
			}
		}
		for op in store.OperandsOf(st.s, cur) {
			if genericTypeCycles(st, root, op, seen) {
				return true
			}
		}
		return false
	}
	let ci = uint32(dense.Index(cur))
	for id in *seen {
		if id == ci {
			return false
		}
	}
	*seen = (*seen).Append(ci)
	if kind == store.KTuple {
		for op in store.OperandsOf(st.s, cur) {
			if genericTypeCycles(st, root, op, seen) {
				return true
			}
		}
		return false
	}
	if kind == store.KArray {
		let ops = store.OperandsOf(st.s, cur)
		return ops.Len() >= 2 && genericTypeCycles(st, root, ops[1], seen)
	}
	if kind == store.KNamed {
		let r = ordinaryRecord(st, cur)
		if r >= 0 {
			for f in st.k.Recs[r].Fields {
				if genericTypeCycles(st, root, f.T, seen) {
					return true
				}
			}
			return false
		}
		let nm = store.TypeNameText(st.s, store.ArgOf(st.s, cur))
		match unionRecordFields(st, nm) {
		case option.Some{Value: fs}:
			for f in fs {
				if genericTypeCycles(st, root, f.T, seen) {
					return true
				}
			}
			return false
		case option.None:
		}
	}
	false
}

func makeGenericMemberType(st fnb, owner fnb, impPath string, vn string, vargs []dense.ID[store.TKey]) dense.Opt[store.TKey] {
	let mut s = st.s
	if impPath == "" {
		match store.Lookup(s, vn) {
		case option.Some{Value: d}:
			if vargs.Len() == 0 {
				return dense.OptOf(store.TNamed(&s, d))
			}
			return dense.OptOf(store.TInstance(&s, store.XRef{Import: uint32(0), Decl: uint32(dense.Index(d))}, vargs))
		case option.None:
			return dense.NoID[store.TKey]()
		}
	}
	if impPath == "prelude" {
		let fi = foreignIdxFor(st.k, "prelude", vn)
		if fi >= 0 {
			if vargs.Len() == 0 && st.k.Foreign[fi].Arity == 0 {
				return dense.OptOf(store.TForeign(&s, fi))
			}
			return dense.OptOf(store.TInstance(&s, store.XRef{Import: uint32(store.ForeignBit), Decl: uint32(fi)}, vargs))
		}
		return dense.NoID[store.TKey]()
	}
	for i in 0..st.k.Ifaces.Len() {
		let imp = st.k.Ifaces[i]
		if imp.Path == impPath {
			for di, d in imp.Decls {
				if d.Name == vn {
					return dense.OptOf(store.TInstance(&s, store.XRef{Import: uint32(i + 1), Decl: uint32(di)}, vargs))
				}
			}
		}
	}
	dense.NoID[store.TKey]()
}

func unionGenericDescriptor(st fnb, t dense.ID[store.TKey]) option.Option[unionShape] {
	match unionGenericDescriptorStore(st, t) {
	case option.Some{Value: got}:
		let (_, sh) = got
		option.Some{Value: sh}
	case option.None:
		option.None
	}
}

func unionGenericDescriptorStore(st fnb, t dense.ID[store.TKey]) option.Option[(store.Store, unionShape)] {
	if store.KindOfType(st.s, t) != store.KInstance {
		return option.None
	}
	let args = store.OperandsOf(st.s, t)
	if args.Len() == 0 {
		return option.None
	}
	let o = store.OriginOfType(st.s, t)
	let di = int(o.Decl)
	let (owner, name, impPath) = if int(o.Import) == store.ForeignBit {
		if di < 0 || di >= st.k.Foreign.Len() {
			return option.None
		}
		let fk = st.k.Foreign[di]
		if fk.Path != "prelude" || !has(st.prelude, fk.Name) || fk.Qual != "-" || fk.Variants.Len() < 2 || fk.Arity != args.Len() {
			return option.None
		}
		let dep = match shapeDeps(st).Get("prelude") {
		case option.Some{Value: d}:
			d
		case option.None:
			return option.None
		}
		(fnb{..st, k: dep.K, s: dep.S, alias: "", pkgPath: "prelude", idx: depIdxOf(st.cache, "prelude")}, fk.Name, "prelude")
	} else if int(o.Import) == 0 {
		(st, store.DeclText(st.s, di), "")
	} else if int(o.Import) > 0 && int(o.Import) <= st.k.Ifaces.Len() {
		let imp = st.k.Ifaces[int(o.Import)-1]
		if di < 0 || di >= imp.Decls.Len() {
			return option.None
		}
		let idecl = imp.Decls[di]
		if !idecl.Type || idecl.Alias || idecl.Variants.Len() < 2 || !allKindType(idecl.Kinds, args.Len()) {
			return option.None
		}
		let dep = match shapeDeps(st).Get(imp.Path) {
		case option.Some{Value: d}:
			d
		case option.None:
			return option.None
		}
		(fnb{..st, k: dep.K, s: dep.S, alias: pkgAlias(dep.Path), pkgPath: dep.Path, idx: depIdxOf(st.cache, dep.Path)}, idecl.Name, dep.Path)
	} else {
		return option.None
	}
	if !unionPlainDecl(owner, name) || !localAllTypeParams(owner, name, args.Len()) {
		return option.None
	}
	let ug = unionInstanceGo(st, t)
	if ug == "" {
		return option.None
	}
	let declId = match store.Lookup(owner.s, name) {
	case option.Some{Value: id}:
		id
	case option.None:
		return option.None
	}
	let ownerU = match namedKeyIn(owner.idx, declId) {
	case option.Some{Value: k}:
		k
	case option.None:
		return option.None
	}
	let vs = unionVarsIn(owner.idx, ownerU)
	if vs.Len() < 2 || vs.Len() > 255 {
		return option.None
	}
	let (p, parent, _) = match unionDeclParent(owner, name) {
	case option.Some{Value: d}:
		d
	case option.None:
		return option.None
	}
	let list = match syntax.ViewOf(p.Tree, parent) {
	case syntax.TypeDecl as td:
		match dense.Unpack(td.Spec) {
		case option.Some{Value: spec}:
			match syntax.ViewOf(p.Tree, spec) {
			case syntax.InterfaceType as it:
				it.Members
			case _:
				return option.None
			}
		case option.None:
			return option.None
		}
	case _:
		return option.None
	}
	if syntax.Len(list) != vs.Len() {
		return option.None
	}
	let mut seenVNames = []string{}
	let mut variants = []unionVariant{}
	let mut isCyclic = false
	let mut local = st.s
	for tag, vT in vs {
		let node = syntax.Item(p.Tree, list, tag)
		let vn = match syntax.ViewOf(p.Tree, node) {
		case syntax.VariantSpec as variant:
			nameText(p, variant.Name)
		case syntax.Name:
			nameText(p, node)
		case syntax.IndexExpr as ix:
			match syntax.ViewOf(p.Tree, ix.X) {
			case syntax.Name:
				nameText(p, ix.X)
			case _:
				return option.None
			}
		case _:
			return option.None
		}
		if has(seenVNames, vn) {
			return option.None
		}
		seenVNames = seenVNames.Append(vn)
		let mut rFound = -1
		for r, rec in owner.k.Recs {
			if rec.Name == vn && !rec.Op {
				rFound = r
				break
			}
		}
		if rFound < 0 {
			return option.None
		}
		let vRec = owner.k.Recs[rFound]
		let rawOps = if store.KindOfType(owner.s, vT) == store.KInstance {
			store.OperandsOf(owner.s, vT)
		} else {
			[]dense.ID[store.TKey]{}
		}
		if rawOps.Len() != vRec.Params.Len() {
			return option.None
		}
		let mut vargs = []dense.ID[store.TKey]{}
		for op in rawOps {
			let portedOp = if impPath == "" {
				op
			} else {
				match types.Port(&local, st.k.Ifaces, st.k.Foreign, owner.s, impPath, func(ref store.XRef) option.Option[types.DeclIdentity] { types.DepIdentity(owner.k.Ifaces, ref) }, owner.k.Foreign, op) {
				case option.Some{Value: pt}:
					pt
				case option.None:
					return option.None
				}
			}
			vargs = vargs.Append(store.TSubst(&local, portedOp, args))
		}
		let vHead = declName(owner, vn) catch {
		case Unported:
			return option.None
		}
		let mut vtGo = vHead
		if vargs.Len() > 0 {
			let mut vArgSpell = ""
			for ai, va in vargs {
				let gs = shapeGo(fnb{..st, s: local}, va)
				if gs == "" {
					return option.None
				}
				vArgSpell += (if ai == 0 { "" } else { ", " }) + gs
			}
			vtGo = vHead + "[" + vArgSpell + "]"
		}
		let mut fields = []expr.Field{}
		let mut holds = false
		for fld in vRec.Fields {
			if !ordinaryFieldName(fld.Name) {
				return option.None
			}
			let mut seenCyc = []uint32{}
			if genericTypeCycles(owner, ownerU, fld.T, &seenCyc) {
				isCyclic = true
			}
			let portedF = if impPath == "" {
				fld.T
			} else {
				match types.Port(&local, st.k.Ifaces, st.k.Foreign, owner.s, impPath, func(ref store.XRef) option.Option[types.DeclIdentity] { types.DepIdentity(owner.k.Ifaces, ref) }, owner.k.Foreign, fld.T) {
				case option.Some{Value: pt}:
					pt
				case option.None:
					return option.None
				}
			}
			let subF = store.TSubst(&local, portedF, vargs)
			let localSt = fnb{..st, s: local}
			if shapeGo(localSt, subF) == "" {
				return option.None
			}
			if holdsValue(localSt, subF) {
				holds = true
			}
			fields = fields.Append(expr.Field{Name: fld.Name, T: subF})
		}
		let declPN = if impPath == "" {
			match store.Lookup(owner.s, vn) {
			case option.Some{Value: vd}:
				let vdecl = store.DeclOf(owner.s, vd)
				let vp = owner.k.Parsed[int(vdecl.File)]
				dense.OptOf(bind.PNodeOf(owner.k.Ps, int(vdecl.File), syntax.NodeAt(vp.Tree, int(vdecl.Node))))
			case option.None:
				dense.NoID[store.PNode]()
			}
		} else {
			dense.NoID[store.PNode]()
		}
		let memT = makeGenericMemberType(fnb{..st, s: local}, owner, impPath, vn, vargs)
		variants = variants.Append(unionVariant{t: memT, decl: declPN, impPath: impPath, name: vn, typ: vtGo, fields: fields, holds: holds})
	}
	let gshape = unionShape{name: name, typ: ug, layout: UnionFlat, flat: true, variants: variants}
	let isErrSealed = if st.cache.active && st.cache.unionEnv.ready {
		cacheAllErrorUnion(owner, gshape)
	} else {
		let (ae, _) = collectErrorTypeCheck(owner, gshape)
		ae
	}
	let isExt = st.cache.active && st.cache.unionEnv.ready && st.cache.unionEnv.extKey.Get(owner.alias+"\x00"+name) != option.None
	let layout = if isCyclic || isErrSealed || isExt { UnionSealed } else { UnionFlat }
	let isFlat = match layout {
	case UnionFlat:
		true
	case _:
		false
	}
	option.Some{Value: (local, unionShape{name: name, typ: ug, layout: layout, flat: isFlat, variants: variants})}
}

func unionDescriptor(st fnb, t dense.ID[store.TKey]) option.Option[unionShape] {
	let (okOpt, optElem) = optionKind(st, t)
	if okOpt == "Option" {
		let eg = shapeGo(st, optElem)
		let ug = unionInstanceGo(st, t)
		if eg == "" || ug == "" {
			return option.None
		}
		let someT = makeOptionMemberType(st.s, st.k, st.alias, "Some", []dense.ID[store.TKey]{optElem})
		let noneT = makeOptionMemberType(st.s, st.k, st.alias, "None", []dense.ID[store.TKey]{})
		match (someT, noneT) {
		case (option.Some{Value: stype}, option.Some{Value: ntype}):
			let someHead = if st.alias == "option" { "Some" } else { pkgAlias("option") + "__Some" }
			let noneTyp = if st.alias == "option" { "None" } else { pkgAlias("option") + "__None" }
			let someTyp = someHead + "[" + eg + "]"
			let variants = []unionVariant{
				unionVariant{t: dense.OptOf(stype), decl: dense.NoID[store.PNode](), impPath: "option", name: "Some", typ: someTyp, fields: []expr.Field{expr.Field{Name: "Value", T: optElem}}, holds: holdsValue(st, optElem)},
				unionVariant{t: dense.OptOf(ntype), decl: dense.NoID[store.PNode](), impPath: "option", name: "None", typ: noneTyp, fields: []expr.Field{}, holds: false},
			}
			return option.Some{Value: unionShape{name: "Option", typ: ug, layout: UnionFlat, flat: true, variants: variants}}
		case _:
			return option.None
		}
	}
	match unionGenericDescriptor(st, t) {
	case option.Some{Value: gsh}:
		return option.Some{Value: gsh}
	case option.None:
	}
	match unionNamed(st, t) {
	case option.Some{Value: sh}:
		return option.Some{Value: sh}
	case option.None:
	}
	match importedShapeOf(st, t, shapeDeps(st)) {
	case option.Some{Value: imp}:
		let owner = fnb{..st, k: imp.dep.K, s: imp.dep.S, alias: pkgAlias(imp.dep.Path), pkgPath: imp.dep.Path, idx: depIdxOf(st.cache, imp.dep.Path)}
		let named = match namedKeyIn(owner.idx, imp.decl) {
		case option.Some{Value: k}:
			k
		case option.None:
			return option.None
		}
		match unionNamed(owner, named) {
		case option.Some{Value: sh}:
			let mut vs = []unionVariant{}
			for v in sh.variants {
				vs = vs.Append(unionVariant{..v, t: dense.NoID[store.TKey](), decl: dense.NoID[store.PNode](), impPath: imp.dep.Path})
			}
			return option.Some{Value: unionShape{..sh, variants: vs}}
		case option.None:
		}
	case option.None:
	}
	option.None
}

func makeOptionMemberType(s0 store.Store, k expr.Pkg, alias string, name string, args []dense.ID[store.TKey]) option.Option[dense.ID[store.TKey]] {
	let mut s = s0
	if alias == "option" {
		match store.Lookup(s, name) {
		case option.Some{Value: d}:
			if args.Len() == 0 {
				return option.Some{Value: store.TNamed(&s, d)}
			}
			return option.Some{Value: store.TInstance(&s, store.XRef{Import: uint32(0), Decl: uint32(dense.Index(d))}, args)}
		case option.None:
			return option.None
		}
	}
	for i in 0..k.Ifaces.Len() {
		let imp = k.Ifaces[i]
		if imp.Path == "option" {
			for di, d in imp.Decls {
				if d.Name == name {
					return option.Some{Value: store.TInstance(&s, store.XRef{Import: uint32(i + 1), Decl: uint32(di)}, args)}
				}
			}
		}
	}
	for fi, f in k.Foreign {
		if f.Path == "option" && f.Name == name {
			if args.Len() == 0 && f.Arity == 0 {
				return option.Some{Value: store.TForeign(&s, fi)}
			}
			return option.Some{Value: store.TInstance(&s, store.XRef{Import: uint32(store.ForeignBit), Decl: uint32(fi)}, args)}
		}
	}
	option.None
}

func unionFlat(st fnb, shape unionShape) bool { shape.flat }

func unionTagOfType(shape unionShape, t dense.ID[store.TKey]) int {
	for i, v in shape.variants {
		match dense.Unpack(v.t) {
		case option.Some{Value: vt}:
			if vt == t {
				return i
			}
		case option.None:
		}
	}
	-1
}

func unionTagOfTypeOrOption(st fnb, shape unionShape, t dense.ID[store.TKey]) int {
	let tag = unionTagOfType(shape, t)
	if tag >= 0 {
		return tag
	}
	let (okT, elemT) = optionKind(st, t)
	if okT != "" {
		for i, v in shape.variants {
			match dense.Unpack(v.t) {
			case option.Some{Value: vt}:
				let (okV, elemV) = optionKind(st, vt)
				if okT == okV && (okT == "None" || elemT == elemV) {
					return i
				}
			case option.None:
			}
		}
	}
	let (mp, mn, ma) = expr.ImportedRec(st.s, st.k, t)
	if mp != "" && ma.Len() == 0 {
		for i, v in shape.variants {
			if v.impPath == mp && v.name == mn {
				return i
			}
		}
	}
	-1
}

func unionTagOfName(st fnb, shape unionShape, n dense.ID[syntax.Node]) int {
	let q = match syntax.ViewOf(st.p.Tree, n) {
	case syntax.IndexExpr as ix:
		ix.X
	case _:
		n
	}
	match syntax.ViewOf(st.p.Tree, q) {
	case syntax.Name:
		match bind.ResolutionOf(st.k.U, st.k.Ps, bind.PNodeOf(st.k.Ps, st.file, q)) {
		case bind.Declared as d:
			for i, v in shape.variants {
				match dense.Unpack(v.decl) {
				case option.Some{Value: vd}:
					if vd == d.At {
						return i
					}
				case option.None:
				}
			}
		case bind.Outside:
			let vn = nameText(st.p, q)
			for i, v in shape.variants {
				if v.impPath == "prelude" && v.name == vn {
					return i
				}
			}
		case bind.Imported as im:
			let ix = int(im.Ref.Import) - 1
			let paths = store.ImportPaths(st.s)
			if ix >= 0 && ix < paths.Len() {
				let vn = nameText(st.p, q)
				for i, v in shape.variants {
					if v.impPath == paths[ix] && v.name == vn {
						return i
					}
				}
			}
		case _:
		}
	case syntax.SelectorExpr as se:
		match bind.ResolutionOf(st.k.U, st.k.Ps, bind.PNodeOf(st.k.Ps, st.file, se.Sel)) {
		case bind.Imported as im:
			let ix = int(im.Ref.Import) - 1
			let paths = store.ImportPaths(st.s)
			if ix >= 0 && ix < paths.Len() {
				let vn = nameText(st.p, se.Sel)
				for i, v in shape.variants {
					if v.impPath == paths[ix] && v.name == vn {
						return i
					}
				}
			}
		case _:
		}
	case _:
	}
	-1
}

type unionInjection {
	flat     bool,
	typ      string,
	variant  string,
	tag      int,
	at       int,
	keys     []string,
	operands []dense.ID[syntax.Node],
}

func unionReturn(st fnb, binds localBinds, p mut controlPlan, x dense.ID[syntax.Node], result dense.ID[store.TKey]) option.Option[unionInjection] fails Unported {
	let shape = match unionDescriptor(st, result) {
	case option.Some{Value: s}:
		s
	case option.None:
		if unionGo(st, result) != "" {
			return stop("union: generic injection layout")
		}
		return option.None
	}
	let v = unparen(st, x)
	let t = try typeOf(st, v, "union result")
	if t == result {
		return option.None
	}
	let tag = unionTagOfTypeOrOption(st, shape, t)
	if tag < 0 {
		return stop("union: unproved injection layout")
	}
	let flat = match shape.layout {
	case UnionFlat:
		true
	case UnionSealed:
		false
	case UnionUnproved as u:
		return stop("union: unproved injection layout: " + u.Why)
	}
	let variant = shape.variants[tag]
	let at = syntax.NodePos(st.p, v)
	let mut j = unionInjection{flat: flat, typ: shape.typ, variant: variant.typ, tag: tag, at: at, keys: []string{}, operands: []dense.ID[syntax.Node]{}}
	match syntax.ViewOf(st.p.Tree, v) {
	case syntax.Name, syntax.SelectorExpr:
		if variant.fields.Len() != 0 || unionTagOfName(st, shape, v) != tag {
			return stop("union: result is not a bare empty variant")
		}
	case syntax.CompositeLit as cl:
		if variant.fields.Len() == 0 {
			return stop("union: explicit empty literal")
		}
		if dense.Unpack(cl.Base) != option.None || syntax.Len(cl.Elts) != variant.fields.Len() {
			return stop("union: payload literal shape")
		}
		let n = syntax.Len(cl.Elts)
		for k in 0..n {
			let e = syntax.Item(st.p.Tree, cl.Elts, k)
			let (fi, operand) = match syntax.ViewOf(st.p.Tree, e) {
			case syntax.KeyValueExpr as kv:
				(fieldIndex(variant.fields, nameText(st.p, kv.Key)), kv.Value)
			case _:
				(k, e)
			}
			if fi < 0 || fi >= variant.fields.Len() {
				return stop("union: payload key")
			}
			let f = variant.fields[fi]
			if has(j.keys, f.Name) || (try typeOf(st, operand, "union payload")) != f.T || callsIn(st.p, operand) || holdsValue(st, f.T) {
				return stop("union: adapted payload")
			}
			try controlOperand(st, binds, p, operand)
			j.keys = j.keys.Append(f.Name)
			j.operands = j.operands.Append(operand)
		}
	case _:
		return stop("union: injection operand")
	}
	option.Some{Value: j}
}

func unionEmitValue(st fnb, binds localBinds, b mut ir.Builder, j unionInjection) uint32 fails Unported | ir.Malformed {
	let p = pos(st, j.at)
	let variant = if j.operands.Len() > 0 {
		let mut elems = []uint32{}
		let mut keyIDs = []uint32{}
		for operand in j.operands {
			elems = elems.Append(try value(st, binds, b, operand))
		}
		for key in j.keys {
			keyIDs = keyIDs.Append(ir.Text(b, key))
		}
		try ir.Row(b, ir.KindCode(ir.TExpr, "lit"), p, []uint32{ir.Text(b, j.variant), ir.List(b, elems), ir.List(b, keyIDs)})
	} else {
		try ir.Row(b, ir.KindCode(ir.TExpr, "zero"), p, []uint32{ir.Text(b, j.variant)})
	}
	if !j.flat {
		return try ir.Row(b, ir.KindCode(ir.TExpr, "toiface"), p, []uint32{ir.Text(b, j.typ), variant})
	}
	let receiver = try ir.Row(b, ir.KindCode(ir.TExpr, "zero"), p, []uint32{ir.Text(b, j.typ)})
	let method = "of" + strconv.Itoa(j.tag)
	try ir.Row(b, ir.KindCode(ir.TExpr, "mcall"), p, []uint32{receiver, ir.Text(b, method), ir.List(b, []uint32{variant})})
}

func unionEmitReturn(st fnb, binds localBinds, b mut ir.Builder, j unionInjection, at ir.Pos) uint32 fails Unported | ir.Malformed {
	let injected = try unionEmitValue(st, binds, b, j)
	try ir.Row(b, ir.KindCode(ir.TStmt, "ret"), at, []uint32{injected})
}

func unionEmitYield(st fnb, binds localBinds, b mut ir.Builder, j unionInjection, at ir.Pos, slot uint32) uint32 fails Unported | ir.Malformed {
	let injected = try unionEmitValue(st, binds, b, j)
	try ir.Row(b, ir.KindCode(ir.TStmt, "set"), at, []uint32{slot, injected, 0})
}
