import option
import slices
import strings
import zlib

// DefaultMaxProfileBytes caps the decompressed protobuf payload size accepted by ParseProfile.
let DefaultMaxProfileBytes = 128 * 1024 * 1024

// EmptyInput reports an empty pprof byte slice.
type EmptyInput {}

// InvalidGzip reports an invalid gzip header or trailer.
type InvalidGzip {
	// Reason describes the gzip validation error.
	Reason string,
}

// CorruptGzip reports a truncated, checksum-mismatched, or oversized gzip stream.
type CorruptGzip {
	// Reason describes the gzip stream failure.
	Reason string,
}

// EmptyPayload reports a valid gzip stream wrapping zero protobuf bytes.
type EmptyPayload {}

// NoSampleTypes reports a decoded profile lacking any sample_type descriptors.
type NoSampleTypes {}

// MissingHeapSampleTypes reports a profile lacking alloc_space and inuse_space sample types.
type MissingHeapSampleTypes {}

// MalformedProto reports a truncated or invalid protobuf wire encoding.
type MalformedProto {
	// Reason describes the protobuf wire error.
	Reason string,
}

// StringIndexOutOfRange reports an out-of-bounds string_table reference.
type StringIndexOutOfRange {
	// Index is the requested string_table index.
	Index int,
	// Length is the decoded string_table length.
	Length int,
}

// ProfileError is the closed failure union for profile decoding and validation.
type ProfileError =
	| EmptyInput
	| InvalidGzip
	| CorruptGzip
	| EmptyPayload
	| NoSampleTypes
	| MissingHeapSampleTypes
	| MalformedProto
	| StringIndexOutOfRange

// ProfileErrorMessage formats e as a concise human-readable diagnostic.
func ProfileErrorMessage(e ProfileError) string {
	match e {
	case EmptyInput:
		"profmd: empty profile input"
	case InvalidGzip as g:
		"profmd: invalid gzip profile: " + g.Reason
	case CorruptGzip as g:
		"profmd: corrupt gzip stream: " + g.Reason
	case EmptyPayload:
		"profmd: empty protobuf payload"
	case NoSampleTypes:
		"profmd: profile has no sample types"
	case MissingHeapSampleTypes:
		"profmd: heap profile missing alloc_space and inuse_space sample types"
	case MalformedProto as m:
		"profmd: " + m.Reason
	case StringIndexOutOfRange as s:
		"profmd: string_table index \(s.Index) out of range [0, \(s.Length))"
	}
}

// ValueType describes one sample value dimension (such as cpu/nanoseconds).
type ValueType {
	// Type names the sample dimension.
	Type string,
	// Unit names the dimension's unit.
	Unit string,
}

// Profile holds a decoded pprof profile in flat Structure-of-Arrays columns with O(1) ID indices.
type Profile {
	// StringTable holds all interned strings decoded from field 6.
	StringTable []string,
	// SampleTypeNames holds the type name per sample_type entry.
	SampleTypeNames []string,
	// SampleTypeUnits holds the unit name per sample_type entry.
	SampleTypeUnits []string,
	// SampleLocStart holds the start offset into SampleLocIDs per sample.
	SampleLocStart []uint32,
	// SampleLocLen holds the count of locations per sample.
	SampleLocLen []uint32,
	// SampleLocIDs holds flat leaf-first location IDs across all samples.
	SampleLocIDs []uint64,
	// SampleValStart holds the start offset into SampleValBits per sample.
	SampleValStart []uint32,
	// SampleValLen holds the count of values per sample.
	SampleValLen []uint32,
	// SampleValBits holds raw 64-bit two's-complement sample values across all samples.
	SampleValBits []uint64,
	// LocID holds each location's numeric ID.
	LocID []uint64,
	// LocMappingID holds each location's mapping ID.
	LocMappingID []uint64,
	// LocAddress holds each location's instruction address.
	LocAddress []uint64,
	// LocLineStart holds the start offset into LineFuncID/LineNumBits per location.
	LocLineStart []uint32,
	// LocLineLen holds the number of inlined lines per location.
	LocLineLen []uint32,
	// LineFuncID holds function IDs across all location lines.
	LineFuncID []uint64,
	// LineNumBits holds raw 64-bit two's-complement line numbers across all location lines.
	LineNumBits []uint64,
	// FuncID holds each function's numeric ID.
	FuncID []uint64,
	// FuncName holds each function's primary name.
	FuncName []string,
	// FuncSysName holds each function's system name.
	FuncSysName []string,
	// FuncFilename holds each function's source filename.
	FuncFilename []string,
	// FuncStartLineBits holds raw 64-bit two's-complement start line per function.
	FuncStartLineBits []uint64,
	// TimeNanosBits holds raw 64-bit time_nanos.
	TimeNanosBits uint64,
	// DurationNanosBits holds raw 64-bit duration_nanos.
	DurationNanosBits uint64,
	// PeriodType holds the decoded sampling period_type.
	PeriodType ValueType,
	// PeriodBits holds raw 64-bit sampling period.
	PeriodBits uint64,
	// LocHashKeys holds the open-addressed uint64 key slots for LocID lookup.
	LocHashKeys []uint64,
	// LocHashVals holds 1-based location row indices (0 indicates an empty slot).
	LocHashVals []uint32,
	// LocHashUsed counts occupied slots in LocHashKeys.
	LocHashUsed int,
	// FuncHashKeys holds the open-addressed uint64 key slots for FuncID lookup.
	FuncHashKeys []uint64,
	// FuncHashVals holds 1-based function row indices (0 indicates an empty slot).
	FuncHashVals []uint32,
	// FuncHashUsed counts occupied slots in FuncHashKeys.
	FuncHashUsed int,
}

type rawValueType {
	typeIdx uint64,
	unitIdx uint64,
}

type rawFunction {
	id         uint64,
	nameIdx    uint64,
	sysNameIdx uint64,
	fileIdx    uint64,
	startLine  uint64,
}

type protoReader {
	data []byte,
	pos  int,
}

let wireVarint = uint64(0)
let wireFixed64 = uint64(1)
let wireBytes = uint64(2)
let wireFixed32 = uint64(5)

func emptyProfile() Profile {
	Profile{
		StringTable:       []string{},
		SampleTypeNames:   []string{},
		SampleTypeUnits:   []string{},
		SampleLocStart:    []uint32{},
		SampleLocLen:      []uint32{},
		SampleLocIDs:      []uint64{},
		SampleValStart:    []uint32{},
		SampleValLen:      []uint32{},
		SampleValBits:     []uint64{},
		LocID:             []uint64{},
		LocMappingID:      []uint64{},
		LocAddress:        []uint64{},
		LocLineStart:      []uint32{},
		LocLineLen:        []uint32{},
		LineFuncID:        []uint64{},
		LineNumBits:       []uint64{},
		FuncID:            []uint64{},
		FuncName:          []string{},
		FuncSysName:       []string{},
		FuncFilename:      []string{},
		FuncStartLineBits: []uint64{},
		TimeNanosBits:     uint64(0),
		DurationNanosBits: uint64(0),
		PeriodType:        ValueType{Type: "", Unit: ""},
		PeriodBits:        uint64(0),
		LocHashKeys:       []uint64{},
		LocHashVals:       []uint32{},
		LocHashUsed:       0,
		FuncHashKeys:      []uint64{},
		FuncHashVals:      []uint32{},
		FuncHashUsed:      0,
	}
}

func hashU64(k uint64) uint64 {
	let mul uint64 = 0xff51afd7ed558ccd
	let mut h = k ^ (k >> uint64(33))
	h = h * mul
	h = h ^ (h >> uint64(33))
	h
}

func growHash(keys mut []uint64, vals mut []uint32) {
	let oldLen = (*vals).Len()
	let newLen = if oldLen < 16 { 16 } else { oldLen * 2 }
	let mut nk = slices.WithCapacity[uint64](newLen)
	let mut nv = slices.WithCapacity[uint32](newLen)
	for _ in 0..newLen {
		nk = nk.Append(uint64(0))
		nv = nv.Append(uint32(0))
	}
	let mask = newLen - 1
	for i in 0..oldLen {
		let v = (*vals)[i]
		if v == uint32(0) {
			continue
		}
		let k = (*keys)[i]
		let mut at = int(hashU64(k)) & mask
		for nv[at] != uint32(0) {
			at = (at + 1) & mask
		}
		nk[at] = k
		nv[at] = v
	}
	*keys = nk
	*vals = nv
}

func putHash(keys mut []uint64, vals mut []uint32, used mut int, k uint64, rowIdx uint32) {
	if (*used+1)*4 > (*vals).Len()*3 {
		growHash(keys, vals)
	}
	let mask = (*vals).Len() - 1
	let mut at = int(hashU64(k)) & mask
	for (*vals)[at] != uint32(0) {
		if (*keys)[at] == k {
			(*vals)[at] = rowIdx + uint32(1)
			return
		}
		at = (at + 1) & mask
	}
	(*keys)[at] = k
	(*vals)[at] = rowIdx + uint32(1)
	*used = *used + 1
}

func lookupHash(keys []uint64, vals []uint32, k uint64) option.Option[uint32] {
	if vals.Len() == 0 {
		return option.None
	}
	let mask = vals.Len() - 1
	let mut at = int(hashU64(k)) & mask
	for vals[at] != uint32(0) {
		if keys[at] == k {
			return option.Some[uint32]{Value: vals[at] - uint32(1)}
		}
		at = (at + 1) & mask
	}
	option.None
}

// LookupLocation returns the dense row index of location id in p, or None if absent.
func LookupLocation(p Profile, id uint64) option.Option[uint32] {
	lookupHash(p.LocHashKeys, p.LocHashVals, id)
}

// LookupFunction returns the dense row index of function id in p, or None if absent.
func LookupFunction(p Profile, id uint64) option.Option[uint32] {
	lookupHash(p.FuncHashKeys, p.FuncHashVals, id)
}

func readVarint(r mut protoReader) uint64 fails MalformedProto {
	let mut v = uint64(0)
	for shift in 0..10 {
		if r.pos >= r.data.Len() {
			return MalformedProto{Reason: "truncated varint"}
		}
		let b = r.data[r.pos]
		r.pos = r.pos + 1
		if shift == 9 && b > byte(1) {
			return MalformedProto{Reason: "varint overflow"}
		}
		v = v | (uint64(b&byte(0x7f)) << uint64(shift*7))
		if b < byte(0x80) {
			return v
		}
	}
	MalformedProto{Reason: "varint overflow"}
}

func readTag(r mut protoReader) (uint64, uint64) fails MalformedProto {
	let tag = try readVarint(r)
	let fieldNum = tag >> uint64(3)
	let wireType = tag & uint64(7)
	if fieldNum == uint64(0) {
		return MalformedProto{Reason: "invalid protobuf field number 0"}
	}
	(fieldNum, wireType)
}

func readVarintField(r mut protoReader, wireType uint64) uint64 fails MalformedProto {
	if wireType != wireVarint {
		return MalformedProto{Reason: "expected varint wire type 0, got \(wireType)"}
	}
	readVarint(r)
}

func readBytes(r mut protoReader, wireType uint64) []byte fails MalformedProto {
	if wireType != wireBytes {
		return MalformedProto{Reason: "expected length-delimited wire type 2, got \(wireType)"}
	}
	let n = try readVarint(r)
	let rem = uint64(r.data.Len() - r.pos)
	if n > rem {
		return MalformedProto{Reason: "length-delimited field truncated: need \(n) bytes, have \(rem)"}
	}
	let out = r.data[r.pos : r.pos+int(n)]
	r.pos = r.pos + int(n)
	out
}

func skipField(r mut protoReader, wireType uint64) fails MalformedProto {
	if wireType == wireVarint {
		let _ = try readVarint(r)
		return
	}
	if wireType == wireFixed64 {
		if r.data.Len()-r.pos < 8 {
			return MalformedProto{Reason: "truncated fixed64"}
		}
		r.pos = r.pos + 8
		return
	}
	if wireType == wireBytes {
		let _ = try readBytes(r, wireBytes)
		return
	}
	if wireType == wireFixed32 {
		if r.data.Len()-r.pos < 4 {
			return MalformedProto{Reason: "truncated fixed32"}
		}
		r.pos = r.pos + 4
		return
	}
	MalformedProto{Reason: "unsupported protobuf wire type \(wireType)"}
}

func decodeRawValueType(data []byte) rawValueType fails MalformedProto {
	let mut r = protoReader{data: data, pos: 0}
	let mut vt = rawValueType{typeIdx: uint64(0), unitIdx: uint64(0)}
	for r.pos < r.data.Len() {
		let (fieldNum, wireType) = try readTag(&r)
		if fieldNum == uint64(1) {
			vt.typeIdx = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(2) {
			vt.unitIdx = try readVarintField(&r, wireType)
		} else {
			try skipField(&r, wireType)
		}
	}
	vt
}

func decodeSampleInto(p mut Profile, data []byte) fails MalformedProto {
	let mut r = protoReader{data: data, pos: 0}
	let mut locs = []uint64{}
	let mut vals = []uint64{}
	for r.pos < r.data.Len() {
		let (fieldNum, wireType) = try readTag(&r)
		if fieldNum == uint64(1) {
			if wireType == wireBytes {
				let sub = try readBytes(&r, wireType)
				let mut pr = protoReader{data: sub, pos: 0}
				for pr.pos < pr.data.Len() {
					let v = try readVarint(&pr)
					locs = locs.Append(v)
				}
			} else {
				let v = try readVarintField(&r, wireType)
				locs = locs.Append(v)
			}
		} else if fieldNum == uint64(2) {
			if wireType == wireBytes {
				let sub = try readBytes(&r, wireType)
				let mut pr = protoReader{data: sub, pos: 0}
				for pr.pos < pr.data.Len() {
					let v = try readVarint(&pr)
					vals = vals.Append(v)
				}
			} else {
				let v = try readVarintField(&r, wireType)
				vals = vals.Append(v)
			}
		} else {
			try skipField(&r, wireType)
		}
	}
	p.SampleLocStart = p.SampleLocStart.Append(uint32(p.SampleLocIDs.Len()))
	p.SampleLocLen = p.SampleLocLen.Append(uint32(locs.Len()))
	p.SampleLocIDs = slices.AppendAll(p.SampleLocIDs, locs)
	p.SampleValStart = p.SampleValStart.Append(uint32(p.SampleValBits.Len()))
	p.SampleValLen = p.SampleValLen.Append(uint32(vals.Len()))
	p.SampleValBits = slices.AppendAll(p.SampleValBits, vals)
}

func decodeLine(data []byte) (uint64, uint64) fails MalformedProto {
	let mut r = protoReader{data: data, pos: 0}
	let mut fnID = uint64(0)
	let mut lineBits = uint64(0)
	for r.pos < r.data.Len() {
		let (fieldNum, wireType) = try readTag(&r)
		if fieldNum == uint64(1) {
			fnID = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(2) {
			lineBits = try readVarintField(&r, wireType)
		} else {
			try skipField(&r, wireType)
		}
	}
	(fnID, lineBits)
}

func decodeLocationInto(p mut Profile, data []byte) fails MalformedProto {
	let mut r = protoReader{data: data, pos: 0}
	let mut locID = uint64(0)
	let mut mappingID = uint64(0)
	let mut address = uint64(0)
	let lineStart = uint32(p.LineFuncID.Len())
	let mut lineLen = uint32(0)
	for r.pos < r.data.Len() {
		let (fieldNum, wireType) = try readTag(&r)
		if fieldNum == uint64(1) {
			locID = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(2) {
			mappingID = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(3) {
			address = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(4) {
			let sub = try readBytes(&r, wireType)
			let (fnID, lnBits) = try decodeLine(sub)
			p.LineFuncID = p.LineFuncID.Append(fnID)
			p.LineNumBits = p.LineNumBits.Append(lnBits)
			lineLen = lineLen + uint32(1)
		} else {
			try skipField(&r, wireType)
		}
	}
	let rowIdx = uint32(p.LocID.Len())
	p.LocID = p.LocID.Append(locID)
	p.LocMappingID = p.LocMappingID.Append(mappingID)
	p.LocAddress = p.LocAddress.Append(address)
	p.LocLineStart = p.LocLineStart.Append(lineStart)
	p.LocLineLen = p.LocLineLen.Append(lineLen)
	putHash(&p.LocHashKeys, &p.LocHashVals, &p.LocHashUsed, locID, rowIdx)
}

func decodeRawFunction(data []byte) rawFunction fails MalformedProto {
	let mut r = protoReader{data: data, pos: 0}
	let mut fn = rawFunction{id: uint64(0), nameIdx: uint64(0), sysNameIdx: uint64(0), fileIdx: uint64(0), startLine: uint64(0)}
	for r.pos < r.data.Len() {
		let (fieldNum, wireType) = try readTag(&r)
		if fieldNum == uint64(1) {
			fn.id = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(2) {
			fn.nameIdx = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(3) {
			fn.sysNameIdx = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(4) {
			fn.fileIdx = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(5) {
			fn.startLine = try readVarintField(&r, wireType)
		} else {
			try skipField(&r, wireType)
		}
	}
	fn
}

func strAt(table []string, idxBits uint64) string fails StringIndexOutOfRange {
	let idx = int64(idxBits)
	if idx < int64(0) || idx >= int64(table.Len()) {
		return StringIndexOutOfRange{Index: int(idx), Length: table.Len()}
	}
	table[int(idx)]
}

func decodeProfileProto(data []byte) Profile fails ProfileError {
	let mut r = protoReader{data: data, pos: 0}
	let mut p = emptyProfile()
	let mut rawTypes = []rawValueType{}
	let mut rawPeriod = rawValueType{typeIdx: uint64(0), unitIdx: uint64(0)}
	let mut hasPeriodType = false
	let mut rawFuncs = []rawFunction{}

	for r.pos < r.data.Len() {
		let (fieldNum, wireType) = try readTag(&r)
		if fieldNum == uint64(1) {
			let sub = try readBytes(&r, wireType)
			let vt = try decodeRawValueType(sub)
			rawTypes = rawTypes.Append(vt)
		} else if fieldNum == uint64(2) {
			let sub = try readBytes(&r, wireType)
			try decodeSampleInto(&p, sub)
		} else if fieldNum == uint64(4) {
			let sub = try readBytes(&r, wireType)
			try decodeLocationInto(&p, sub)
		} else if fieldNum == uint64(5) {
			let sub = try readBytes(&r, wireType)
			let rf = try decodeRawFunction(sub)
			rawFuncs = rawFuncs.Append(rf)
		} else if fieldNum == uint64(6) {
			let sub = try readBytes(&r, wireType)
			p.StringTable = p.StringTable.Append(strings.FromBytes(sub))
		} else if fieldNum == uint64(9) {
			p.TimeNanosBits = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(10) {
			p.DurationNanosBits = try readVarintField(&r, wireType)
		} else if fieldNum == uint64(11) {
			let sub = try readBytes(&r, wireType)
			rawPeriod = try decodeRawValueType(sub)
			hasPeriodType = true
		} else if fieldNum == uint64(12) {
			p.PeriodBits = try readVarintField(&r, wireType)
		} else {
			try skipField(&r, wireType)
		}
	}

	p.SampleTypeNames = slices.WithCapacity[string](rawTypes.Len())
	p.SampleTypeUnits = slices.WithCapacity[string](rawTypes.Len())
	for rt in rawTypes {
		let t = try strAt(p.StringTable, rt.typeIdx)
		let u = try strAt(p.StringTable, rt.unitIdx)
		p.SampleTypeNames = p.SampleTypeNames.Append(t)
		p.SampleTypeUnits = p.SampleTypeUnits.Append(u)
	}

	if hasPeriodType {
		let t = try strAt(p.StringTable, rawPeriod.typeIdx)
		let u = try strAt(p.StringTable, rawPeriod.unitIdx)
		p.PeriodType = ValueType{Type: t, Unit: u}
	}

	p.FuncID = slices.WithCapacity[uint64](rawFuncs.Len())
	p.FuncName = slices.WithCapacity[string](rawFuncs.Len())
	p.FuncSysName = slices.WithCapacity[string](rawFuncs.Len())
	p.FuncFilename = slices.WithCapacity[string](rawFuncs.Len())
	p.FuncStartLineBits = slices.WithCapacity[uint64](rawFuncs.Len())
	for rf in rawFuncs {
		let name = try strAt(p.StringTable, rf.nameIdx)
		let sysName = try strAt(p.StringTable, rf.sysNameIdx)
		let file = try strAt(p.StringTable, rf.fileIdx)
		let rowIdx = uint32(p.FuncID.Len())
		p.FuncID = p.FuncID.Append(rf.id)
		p.FuncName = p.FuncName.Append(name)
		p.FuncSysName = p.FuncSysName.Append(sysName)
		p.FuncFilename = p.FuncFilename.Append(file)
		p.FuncStartLineBits = p.FuncStartLineBits.Append(rf.startLine)
		putHash(&p.FuncHashKeys, &p.FuncHashVals, &p.FuncHashUsed, rf.id, rowIdx)
	}

	if p.SampleTypeNames.Len() == 0 {
		return NoSampleTypes
	}
	p
}

// ParseProfileLimit decompresses and decodes a gzip-encoded pprof protobuf bounded by maxBytes.
func ParseProfileLimit(pprofBytes []byte, maxBytes int) Profile fails ProfileError {
	if pprofBytes.Len() == 0 {
		return EmptyInput
	}
	let raw = zlib.Gunzip(pprofBytes, maxBytes) catch {
	case zlib.BadGzip as g:
		return InvalidGzip{Reason: g.Reason}
	case zlib.Truncated:
		return CorruptGzip{Reason: "truncated gzip stream"}
	case zlib.BadChecksum as c:
		return CorruptGzip{Reason: "checksum mismatch \(c.Actual) != \(c.Expected)"}
	case zlib.BadBlock:
		return CorruptGzip{Reason: "bad deflate block"}
	case zlib.BadDistance:
		return CorruptGzip{Reason: "bad deflate distance"}
	case zlib.BadHuffman as h:
		return CorruptGzip{Reason: "bad huffman table: " + h.Reason}
	case zlib.LimitExceeded as l:
		return CorruptGzip{Reason: "profile exceeds limit \(l.Limit) bytes"}
	}
	if raw.Len() == 0 {
		return EmptyPayload
	}
	decodeProfileProto(raw)
}

// ParseProfile decompresses and decodes a gzip-encoded pprof protobuf using DefaultMaxProfileBytes.
func ParseProfile(pprofBytes []byte) Profile fails ProfileError {
	ParseProfileLimit(pprofBytes, DefaultMaxProfileBytes)
}

func appendProtoVarintBytes(dst []byte, v uint64) []byte {
	let mut out = dst
	let mut x = v
	for x >= uint64(0x80) {
		out = out.Append(byte((x & uint64(0x7f)) | uint64(0x80)))
		x = x >> uint64(7)
	}
	out.Append(byte(x))
}

func appendProtoVarintField(dst []byte, fieldNum uint64, v uint64) []byte {
	let withTag = appendProtoVarintBytes(dst, (fieldNum<<uint64(3))|wireVarint)
	appendProtoVarintBytes(withTag, v)
}

func appendProtoBytesField(dst []byte, fieldNum uint64, b []byte) []byte {
	let withTag = appendProtoVarintBytes(dst, (fieldNum<<uint64(3))|wireBytes)
	let withLen = appendProtoVarintBytes(withTag, uint64(b.Len()))
	slices.AppendAll(withLen, b)
}

// HashIndexRoundTrips verifies open-addressed uint64->uint32 indexing including key 0 and overwrites.
law HashIndexRoundTrips(keys []uint64) {
	let mut hk = []uint64{}
	let mut hv = []uint32{}
	let mut used = 0
	putHash(&hk, &hv, &used, uint64(0), uint32(7))
	putHash(&hk, &hv, &used, uint64(0), uint32(9))
	let mut ok = lookupHash(hk, hv, uint64(0)) == option.Some[uint32]{Value: uint32(9)}
	for i, k in keys {
		let row = uint32(i + 10)
		putHash(&hk, &hv, &used, k, row)
		match lookupHash(hk, hv, k) {
		case option.Some{Value: got}:
			ok = ok && got == row
		case option.None:
			ok = false
		}
	}
	ok
}

// SignedBitsRoundTrip verifies int64<->uint64 two's-complement conversion is lossless.
law SignedBitsRoundTrip(x int64) {
	int64(uint64(x)) == x
}

test ParseProfileRejectsInvalidInputs {
	let mut emptyErr = false
	let _ = ParseProfile([]byte{}) catch {
	case EmptyInput:
		emptyErr = true
		emptyProfile()
	case _:
		emptyProfile()
	}
	assert emptyErr

	let mut badGzipErr = false
	let _ = ParseProfile("not a gzip profile".Bytes()) catch {
	case InvalidGzip:
		badGzipErr = true
		emptyProfile()
	case _:
		emptyProfile()
	}
	assert badGzipErr

	let emptyPayload = zlib.Gzip([]byte{})
	let mut emptyPayloadErr = false
	let _ = ParseProfile(emptyPayload) catch {
	case EmptyPayload:
		emptyPayloadErr = true
		emptyProfile()
	case _:
		emptyProfile()
	}
	assert emptyPayloadErr

	let truncInside = zlib.Gzip([]byte{byte(0x0a), byte(0x10), byte(0x08)})
	let mut truncErr = false
	let _ = ParseProfile(truncInside) catch {
	case MalformedProto:
		truncErr = true
		emptyProfile()
	case _:
		emptyProfile()
	}
	assert truncErr
}
