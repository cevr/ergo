import compiler/source
import strings

// SourceAdmit is compiler/source's decision for a node a Go host stated
// (regular or not) holding content, read under limit, in
// ReadRegularFile's order: "ok\n" and the text, or "fail " and the
// failure's text and "\n". The agreement property TestSourceAgreesWithErgo
// (internal/source) compares it with ReadRegularFile on real files: a
// regular file, a FIFO and a folder.
func SourceAdmit(regular bool, limit int, content string) string {
	source.CheckLimit(limit) catch {
	case source.NegativeLimit:
		return "fail " + source.NegativeLimitText + "\n"
	}
	source.Admit(source.Node{Regular: regular, Size: content.Len()}) catch {
	case source.NotRegular:
		return "fail " + source.NotRegularText + "\n"
	}
	let cap = source.ReadLimit(limit)
	let read = if cap > 0 && content.Len() > cap { strings.Slice(content, 0, cap) } else { content }
	let text = source.Fit(read, limit) catch {
	case source.TooLarge:
		return "fail " + source.TooLargeText + "\n"
	}
	"ok\n" + text
}
