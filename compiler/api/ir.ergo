import compiler/ir

// IRWrite builds an IR file with ir.Builder from the steps a Go host
// sends, and writes it with ir.Write (capstone S4): "ok\n" and the IR
// file's text, or "malformed <at> <why>\n". The agreement property of
// internal/selfhostcheck (TestIRWriteAgreesWithGo) compares the text with
// the Go IR builder's encoding/json output. The host sends the nodes it
// read from that output; this seam is deleted when compiler/ir's builder
// reads the checked program itself.
//
// The words are 3 (the layout), V's low and high halves, then steps; a
// step is an op and its words, and a step that makes a word pushes it on
// a stack (texts are indices of strs):
//
//	1 text i             push ir.Text(strs[i])
//	2 word w             push w
//	3 pos f l c          push ir.PosAt
//	4 list n             pop n words, push ir.List of them
//	5 row k f l c        pop the kind's slot count, push ir.Row's id
//	6 func i f l c f l c ir.Begin
//	7 local i j f l c    ir.AddLocal
//	8 end                pop the roots, ir.End
//	9 file i             ir.FileOf(strs[i])
//	10 shared i          ir.Share
//	11 nofiles, 12 nofuncs
func IRWrite(words []uint32, strs []string) string {
	let file = replay(words, strs) catch {
	case ir.Malformed as m:
		return "malformed \(m.At) " + m.Why + "\n"
	}
	let text = ir.Write(file) catch {
	case ir.Malformed as m:
		return "malformed \(m.At) " + m.Why + "\n"
	}
	"ok\n" + text
}

// IRKinds is ir.Table: the kinds and their slots, for the host that packs.
func IRKinds() string { ir.Table() }

type reader { words []uint32, at int, strs []string, stack []uint32 }

func next(r mut reader) uint32 fails ir.Malformed {
	if r.at >= r.words.Len() {
		return ir.Malformed{At: r.at, Why: "past the end"}
	}
	let v = r.words[r.at]
	r.at += 1
	v
}

func str(r mut reader) string fails ir.Malformed {
	let i = int(try next(r))
	if i >= r.strs.Len() {
		return ir.Malformed{At: r.at - 1, Why: "no text"}
	}
	r.strs[i]
}

func position(r mut reader) ir.Pos fails ir.Malformed {
	let a = try next(r)
	let b = try next(r)
	let c = try next(r)
	ir.Pos{File: a, Line: b, Col: c}
}

// pop is the top n words of the stack, bottom first, taken off it.
func pop(r mut reader, n int) []uint32 fails ir.Malformed {
	if n < 0 || n > r.stack.Len() {
		return ir.Malformed{At: r.at, Why: "the stack holds fewer words"}
	}
	let top = r.stack.Len() - n
	let out = r.stack[top:].Clone()
	r.stack = r.stack[:top]
	out
}

func replay(words []uint32, strs []string) ir.File fails ir.Malformed {
	let mut r = reader{words: words, at: 0, strs: strs, stack: []uint32{}}
	let layout = try next(&r)
	if layout != 3 {
		return ir.Malformed{At: 0, Why: "layout " + "\(layout)"}
	}
	let lo = try next(&r)
	let hi = try next(&r)
	let mut b = ir.NewBuilder(int64(uint64(lo) | uint64(hi)<<uint64(32)))
	for r.at < r.words.Len() {
		let op = try next(&r)
		match op {
		case 1:
			let s = try str(&r)
			r.stack = r.stack.Append(ir.Text(&b, s))
		case 2:
			let w = try next(&r)
			r.stack = r.stack.Append(w)
		case 3:
			let p = try position(&r)
			r.stack = r.stack.Append(ir.PosAt(&b, p))
		case 4:
			let n = int(try next(&r))
			let xs = try pop(&r, n)
			r.stack = r.stack.Append(ir.List(&b, xs))
		case 5:
			let k = try next(&r)
			let at = try position(&r)
			if k == 0 || int(k) >= ir.NumKinds() {
				return ir.Malformed{At: r.at, Why: "kind \(k)"}
			}
			let slots = try pop(&r, ir.KindOf(uint8(k)).Slots.Len())
			let id = try ir.Row(&b, uint8(k), at, slots)
			r.stack = r.stack.Append(id)
		case 6:
			let name = try str(&r)
			let p = try position(&r)
			let e = try position(&r)
			try ir.Begin(&b, name, p, e)
		case 7:
			let name = try str(&r)
			let typ = try str(&r)
			let p = try position(&r)
			try ir.AddLocal(&b, name, typ, p)
		case 8:
			let roots = try pop(&r, 1)
			try ir.End(&b, roots[0])
		case 9:
			let path = try str(&r)
			ir.FileOf(&b, path)
		case 10:
			let s = try str(&r)
			ir.Share(&b, s)
		case 11:
			ir.NoFiles(&b)
		case 12:
			ir.NoFuncs(&b)
		case _:
			return ir.Malformed{At: r.at - 1, Why: "op \(op)"}
		}
	}
	if r.stack.Len() != 0 {
		return ir.Malformed{At: r.at, Why: "words left on the stack"}
	}
	try ir.Finish(b)
}
