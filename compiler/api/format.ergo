// Package api is the root of the compiler's linked package
// (internal/linked/format): Go calls its exported functions. Every entry
// is pure. Go parses and encodes (internal/hostsyntax), and an entry
// decodes the tree, runs the formatter and turns its typed outcome into
// text a Go caller reads. It makes no layout decision.
//
// Project is the tracer of the parser boundary (SH0). FormatTree, Laws
// and Steps run the formatter (SH1).

import compiler/format
import compiler/tree
import strings

// Project decodes the adapter's encoding into the Ergo tree and returns
// the tree's projection (tree.Project), or the parser's failure
// (tree.ProjectFailure). An encoding Ergo cannot read is the text
// "badencoding" with its reason, and a node type the adapter does not
// carry "unsupported" with its name: the Go side never projects either,
// so a comparison names them.
func Project(encoding string) string {
	let t = tree.Decode(encoding) catch {
	case tree.SyntaxFailure as f:
		return tree.ProjectFailure(f)
	case tree.Unsupported as u:
		return "unsupported \(u.Family)\n"
	case tree.BadEncoding as b:
		return "badencoding \(b.Reason) at \(b.At)\n"
	}
	tree.Project(t)
}

func syntaxOutcome(f tree.SyntaxFailure) string {
	"syntax \(f.Code) \(len(f.Message)):" + f.Message + " \(f.Offset) \(f.Length) \(f.Line) \(f.Column)\n"
}

// FormatTree lays out a tree given as the adapter's encoding: "ok\n" and
// the text, "syntax <code> <len>:<message> <offset> <length> <line>
// <column>\n" for an encoded syntax failure, "limit <n>\n", or
// "invalid <node> <reason>\n".
func FormatTree(encoding string, limit int) string {
	let t = format.Decoded(encoding) catch {
	case tree.SyntaxFailure as f:
		return syntaxOutcome(f)
	case format.InvalidTree as i:
		return "invalid \(i.Node) \(i.Reason)\n"
	}
	let r = format.Print(t, limit) catch {
	case format.OutputLimit as o:
		return "limit \(o.Limit)\n"
	case format.InvalidTree as i:
		return "invalid \(i.Node) \(i.Reason)\n"
	}
	"ok\n" + r.Text
}

// Laws is format.CheckLaws on src, "ok\n" or the broken laws, over the
// two trees Go parsed: srcTree, the encoding of src, and outTree, the
// encoding of out, the text FormatTree gave for srcTree. The laws parse
// no other text; one that did would find an invalid tree and break.
func Laws(src string, srcTree string, out string, outTree string) string {
	format.CheckLaws(src, func(text string) tree.Tree fails tree.SyntaxFailure | format.InvalidTree {
		if text == src {
			return try format.Decoded(srcTree)
		}
		if text == out {
			return try format.Decoded(outTree)
		}
		return format.InvalidTree{Node: -1, Reason: "Laws was given no tree of this text"}
	})
}

// Steps drives the layout state by an encoded command list and renders it:
// "ok <built>\n" and the text, "limit <n> built <bytes>\n", or "bad <offset>\n"
// for a list it cannot read. Each command is one letter: s Space,
// n Newline, b NoBlank, e0 or e1 Emit (with the source's blank line),
// w<len>:<text> Write, p<len>:<text> Put, | Separator, i<n>; Indent,
// t<n>; SetIndent, l EndLine.
func Steps(commands string, limit int) string {
	let list = readCommands(commands) catch {
	case BadCommand as b:
		return "bad \(b.At)\n"
	}
	let r = format.Steps(list, limit) catch {
	case format.OutputLimit as o:
		return "limit \(o.Limit) built \(o.Built)\n"
	}
	"ok \(r.Built)\n" + r.Text
}

// BadCommand is a command list Steps cannot read, at a byte.
type BadCommand { At int }

func readCommands(w string) []format.Command fails BadCommand {
	let mut out = []format.Command{}
	let mut at = 0
	for at < len(w) {
		let c = w[at]
		match c {
		case 's':
			out = out.Append(format.Space)
			at += 1
		case 'n':
			out = out.Append(format.Newline)
			at += 1
		case 'b':
			out = out.Append(format.NoBlank)
			at += 1
		case '|':
			out = out.Append(format.Separator)
			at += 1
		case 'l':
			out = out.Append(format.EndLine)
			at += 1
		case 'e':
			if at+1 >= len(w) || w[at+1] != '0' && w[at+1] != '1' {
				return BadCommand{At: at}
			}
			out = out.Append(format.Emit{Blank: w[at+1] == '1'})
			at += 2
		case 'w', 'p':
			let (n, start) = try decimalAt(w, at+1, ':')
			if n < 0 || n > len(w)-start {
				return BadCommand{At: at}
			}
			let text = strings.Slice(w, start, start+n)
			out = out.Append(if c == 'w' { format.Write{Text: text} } else { format.Put{Text: text} })
			at = start + n
		case 'i', 't':
			let (n, next) = try decimalAt(w, at+1, ';')
			out = out.Append(if c == 'i' { format.Indent{By: n} } else { format.SetIndent{To: n} })
			at = next
		case _:
			return BadCommand{At: at}
		}
	}
	out
}

// decimalAt reads an optionally negative decimal at at, ended by stop: its
// value and the offset after stop.
func decimalAt(w string, at int, stop byte) (int, int) fails BadCommand {
	let mut i = at
	let negative = i < len(w) && w[i] == '-'
	if negative {
		i += 1
	}
	let digits = i
	let mut n = 0
	for i < len(w) && w[i] >= '0' && w[i] <= '9' {
		n = n*10 + int(w[i]-'0')
		i += 1
	}
	if i == digits || i >= len(w) || w[i] != stop {
		return BadCommand{At: at}
	}
	(if negative { -n } else { n }, i + 1)
}
