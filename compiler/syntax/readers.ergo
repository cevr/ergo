// TestDeclOf reads a row of kind KTestDecl.
func TestDeclOf(t Tree, id dense.ID[Node]) TestDecl {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	TestDecl{Doc: otok(fixed(t, i, 4, 0)), Test: int(tok), Name: nid(t, fixed(t, i, 4, 1)), Params: onid(t, fixed(t, i, 4, 2)), Body: onid(t, fixed(t, i, 4, 3))}
}

// LawDeclOf reads a row of kind KLawDecl.
func LawDeclOf(t Tree, id dense.ID[Node]) LawDecl {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	return LawDecl{
		Doc:        otok(fixed(t, i, 9, 0)),
		Law:        int(tok),
		Name:       nid(t, fixed(t, i, 9, 1)),
		TypeParams: onid(t, fixed(t, i, 9, 2)),
		Params:     onid(t, fixed(t, i, 9, 3)),
		Body:       onid(t, fixed(t, i, 9, 4)),
		Reach:      onid(t, fixed(t, i, 9, 5)),
		Rewrite:    flag(fixed(t, i, 9, 6)),
		Equation:   fixed(t, i, 9, 6) == uint32(2),
		When:       otok(fixed(t, i, 9, 7)),
		Eq:         otok(fixed(t, i, 9, 8)),
	}
}

// LawReachOf reads a row of kind KLawReach.
func LawReachOf(t Tree, id dense.ID[Node]) LawReach {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	LawReach{Never: otok(fixed(t, i, 6, 0)), Word: int(tok), Path: flag(fixed(t, i, 6, 1)), Lbrack: otok(fixed(t, i, 6, 2)), Targets: listAt(t, i, 0, items(t, i, 6)), Rbrack: otok(fixed(t, i, 6, 3)), Invariant: flag(fixed(t, i, 6, 4)), Pred: onid(t, fixed(t, i, 6, 5))}
}

// FileOf reads the file, the last row.
func FileOf(t Tree, id dense.ID[Node]) File {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	File{Decls: listAt(t, i, 0, items(t, i, 0)), EOF: int(tok)}
}
