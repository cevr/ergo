	VarSpec{Names: listAt(t, i, 0, items(t, i, 4)), Pattern: onid(t, fixed(t, i, 4, 0)), Type: onid(t, fixed(t, i, 4, 1)), Assign: otok(fixed(t, i, 4, 2)), Value: onid(t, fixed(t, i, 4, 3))}
