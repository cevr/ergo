	RangeStmt{For: int(tok), Key: onid(t, fixed(t, i, 5, 0)), Value: nid(t, fixed(t, i, 5, 1)), Range: int(fixed(t, i, 5, 2)), X: nid(t, fixed(t, i, 5, 3)), Body: nid(t, fixed(t, i, 5, 4))}
}

// CaseClauseOf reads a row of kind KCaseClause.
func CaseClauseOf(t Tree, id dense.ID[Node]) CaseClause {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	let nl = int(fixed(t, i, 2, 0))
	return CaseClause{Case: int(tok), List: listAt(t, i, 0, nl), Colon: int(fixed(t, i, 2, 1)), Body: listAt(t, i, nl, items(t, i, 2)-nl)}
}

