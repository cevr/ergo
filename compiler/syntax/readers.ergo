// TypeDeclOf reads a row of kind KTypeDecl.
func TypeDeclOf(t Tree, id dense.ID[Node]) TypeDecl {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	return TypeDecl{
		Doc:           otok(fixed(t, i, 10, 0)),
		Extern:        onid(t, fixed(t, i, 10, 1)),
		Type:          int(tok),
		Name:          nid(t, fixed(t, i, 10, 2)),
		TypeParams:    onid(t, fixed(t, i, 10, 3)),
		Spec:          onid(t, fixed(t, i, 10, 4)),
		WherePos:      otok(fixed(t, i, 10, 5)),
		Where:         onid(t, fixed(t, i, 10, 6)),
		DerivePos:     otok(fixed(t, i, 10, 7)),
		Derive:        onid(t, fixed(t, i, 10, 8)),
		ImplementsPos: otok(fixed(t, i, 10, 9)),
		Implements:    listAt(t, i, 0, items(t, i, 10)),
	}
}

