		Func:       int(tok),
		Recv:       onid(t, fixed(t, i, 7, 2)),
		Name:       nid(t, fixed(t, i, 7, 3)),
		TypeParams: onid(t, fixed(t, i, 7, 4)),
		Type:       nid(t, fixed(t, i, 7, 5)),
		Body:       onid(t, fixed(t, i, 7, 6)),
	}
}

