import dense

// The readers: one per variant of View, the row id read as that variant
// (ViewOf is the reader its kind names). A reader returns the variant's
// record, no union, so a walk that reads KindOf first and then the reader
// of that kind boxes no View. A reader of another kind than id's reads the
// row's words as its own: the caller checks the kind.

// NameOf reads a row of kind KIdent.
func NameOf(t Tree, id dense.ID[Node]) Name {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	Name{Tok: int(tok)}
}

// BasicLitOf reads a row of kind KBasicLit.
func BasicLitOf(t Tree, id dense.ID[Node]) BasicLit {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	BasicLit{Tok: int(tok)}
}

// SelectorExprOf reads a row of kind KSelectorExpr.
func SelectorExprOf(t Tree, id dense.ID[Node]) SelectorExpr {
	let i = uint32(dense.Index(id))
	let a = t.a[int(i)]
	let b = t.b[int(i)]
	SelectorExpr{X: nid(t, a), Sel: nid(t, b)}
}

// CallExprOf reads a row of kind KCallExpr.
func CallExprOf(t Tree, id dense.ID[Node]) CallExpr {
	let i = uint32(dense.Index(id))
	CallExpr{Fun: nid(t, fixed(t, i, 5, 0)), Lparen: otok(fixed(t, i, 5, 1)), Args: listAt(t, i, 0, items(t, i, 5)), Rparen: otok(fixed(t, i, 5, 2)), Trailing: onid(t, fixed(t, i, 5, 3)), TrailingFunc: flag(fixed(t, i, 5, 4))}
}

// BinaryExprOf reads a row of kind KBinaryExpr.
func BinaryExprOf(t Tree, id dense.ID[Node]) BinaryExpr {
	let i = uint32(dense.Index(id))
	let tok = t.tok[int(i)]
	let a = t.a[int(i)]
	let b = t.b[int(i)]
	BinaryExpr{X: nid(t, a), Op: int(tok), Y: nid(t, b)}
}

