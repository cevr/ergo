	pushW(t, tparams)
	pushW(t, params)
	pushW(t, body)
	pushW(t, reach)
	pushW(t, rewrite)
	pushW(t, when)
	pushW(t, eq)
	pushW(t, quant)
	rec(t, KLawDecl, uint32(lawW), m)
}

