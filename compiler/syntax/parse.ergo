import slices
import strings
import tasks

// noNode is what a parse function returns when the parse failed before it
// built its node: no row has this index, and every reader of a row treats
// it as a node of no kind.
let noNode = uint32(4294967295)

// Parsed is the parse of one source file: its scan, the tree, the comment
// groups, and the first syntax error when the parse failed (Failed; the
// tree is then not to be read). The tokens hold, after a failed scan, an
// ILLEGAL and an EOF where the scan stopped, as the Go scanner's do.
type Parsed {
	Tree    Tree,
	Failed  bool,
	Code    string,
	Message string,
	Offset  int,
	Length  int,
	Line    int,
	Column  int,
	src     string,
	kinds   []uint8,
	starts  []uint32,
	ends    []uint32,
	nreal   int,
	vend    int,
	cmts    Comments,
	gFirst  []int,
	gLast   []int,
}

// parser is the state of one parse: the token columns, the position in
// them, the header and nesting state of the Go parser, the first error and
// the tree being built. A failure is sticky: after it the current token
// reads as EOF and no token is consumed, so every loop ends and the parse
// returns along its normal paths (the Go parser's bailout panic).
type parser {
	src         string,
	kinds       []uint8,
	starts      []uint32,
	ends        []uint32,
	nreal       int,
	vend        int,
	ntok        int,
	cmts        Comments,
	scanFailed  bool,
	scanOffset  int,
	scanLength  int,
	scanMessage string,
	i           int,
	tk          uint8,
	exprLev     int,
	orAllowed   bool,
	nest        int,
	peak        int,
	failed      bool,
	lexical     bool,
	code        string,
	msg         string,
	eoff        int,
	elen        int,
	gFirst      []int,
	gLast       []int,
	gOwn        []bool,
	t           Tree,
	litErr      bool,
	litPos      int,
	litLen      int,
	asFields    bool,
	ents        []entry,
	entTop      int,
	quiet       int,
	gHint       int,
}

// Parse parses one source file (the Go parser's Parse, the derived
// declarations and the expansion of or-patterns left out: the tree is the
// tree as written).
func Parse(src string) Parsed {
	let s = Scan(src)
	let n = NumToks(s.Toks)
	// The parser reads the scan's columns in place: they have room for
	// the two tokens a failed scan adds.
	let mut kinds = s.Toks.kind
	let mut starts = s.Toks.start
	let mut ends = s.Toks.end
	let mut ntok = n
	let mut vend = 0
	if s.Failed {
		// The ILLEGAL and EOF of the Go scanner's fail: at the failure, or
		// at the end of the last token when that is past it.
		let mut at = s.Offset
		let mut end = s.Offset + s.Length
		if n > 0 {
			let last = int(ends[n-1])
			if last > at {
				at = last
				end = last
			}
		}
		kinds[n] = Illegal
		starts[n] = uint32(at)
		ends[n] = uint32(end)
		kinds[n+1] = EOF
		starts[n+1] = uint32(end)
		ends[n+1] = uint32(end)
		vend = end
		ntok = n + 2
	}
	kinds = kinds[:ntok]
	starts = starts[:ntok]
	ends = ends[:ntok]
	let mut p = parser{
		src:         src,
		kinds:       kinds,
		starts:      starts,
		ends:        ends,
		nreal:       n,
		vend:        vend,
		ntok:        ntok,
		cmts:        s.Comments,
		scanFailed:  s.Failed,
		scanOffset:  s.Offset,
		scanLength:  s.Length,
		scanMessage: s.Message,
		i:           0,
		tk:          kinds[0],
		exprLev:     0,
		orAllowed:   false,
		nest:        0,
		peak:        0,
		failed:      false,
		lexical:     false,
		code:        "",
		msg:         "",
		eoff:        0,
		elen:        0,
		gFirst:      []int{},
		gLast:       []int{},
		gOwn:        []bool{},
		// Room for a row per token and two words per token: the corpus has
		// 0.9 rows and 0.6 words per token, the parsebench workload 0.85
		// rows and 1.6 words. Sized by the file's length instead (7 bytes a
		// row, 4 a word) the per-file bench grew small files' columns and
		// its GC share rose (S2b profile.md).
		t:        NewTree(ntok, 2*ntok),
		litErr:   false,
		litPos:   0,
		litLen:   0,
		asFields: false,
		ents:     []entry{},
		entTop:   0,
		quiet:    0,
		gHint:    0,
	}
	groupComments(&p)
	parseFile(&p)
	// A failure reports its line and column, from a line table built for it
	// alone; a parse that succeeds builds none.
	let pos = if p.failed { PositionOf(LinesOf(src), p.eoff) } else { Position{Line: 0, Column: 0} }
	Parsed{
		Tree:    p.t,
		Failed:  p.failed,
		Code:    p.code,
		Message: p.msg,
		Offset:  p.eoff,
		Length:  p.elen,
		Line:    pos.Line,
		Column:  pos.Column,
		src:     src,
		kinds:   p.kinds,
		starts:  p.starts,
		ends:    p.ends,
		nreal:   p.nreal,
		vend:    p.vend,
		cmts:    p.cmts,
		gFirst:  p.gFirst,
		gLast:   p.gLast,
	}
}

// ParseAll is the parse of each source, in the order of srcs, on at most
// workers tasks at once (capstone S2e, CAP-par). A parse shares nothing
// with another: it reads its own source and builds its own columns and
// tree, and its task hands them back whole, so the join is the results in
// file order and no parse writes a table of another (there is no
// interner: names stay offsets into the source). A workers below 1 is a
// defect, as Transform's limit.
func ParseAll(srcs []string, workers int) []Parsed {
	let parts = tasks.Transform(Chunks(len(srcs), workers), workers, func(c Chunk) []Parsed {
		let mut out = slices.WithCapacity[Parsed](c.To - c.From)
		for i in c.From..c.To {
			out = out.Append(Parse(srcs[i]))
		}
		out
	})
	let mut all = slices.WithCapacity[Parsed](len(srcs))
	for part in parts {
		all = slices.AppendAll(all, part)
	}
	all
}

// Chunk is the files [From, To) one task parses, in order.
type Chunk { From int, To int }

// Chunks splits n files into at most workers runs of adjacent files, in
// order, as even in count as they can be. A task parses a run, not one
// file: a parse's task starts with a small stack and the recursive descent
// grows it, so a task per file pays the growth once per file (about a
// third of the parse's instructions, measured in S2e), and a task per run
// once per worker.
func Chunks(n int, workers int) []Chunk {
	let k = if workers < 1 { 1 } else if workers > n { n } else { workers }
	let mut out = slices.WithCapacity[Chunk](k)
	let mut from = 0
	for j in 0..k {
		let to = from + (n-from)/(k-j)
		out = out.Append(Chunk{From: from, To: to})
		from = to
	}
	out
}

// ChunksTile: the runs cover 0..n in order with no gap and no overlap, no
// run is empty, and there are at most workers of them.
law ChunksTile(n int, workers int) {
	let m = (n%500 + 500) % 500
	let w = (workers%20+20)%20 + 1
	let cs = Chunks(m, w)
	let mut ok = len(cs) <= w
	let mut at = 0
	for c in cs {
		ok = ok && c.From == at && c.To > c.From
		at = c.To
	}
	ok && at == m
}

// ParseAllIsEachParse: the parses on tasks are each file's own parse, in
// file order, at one task and at several: the rows, the extra words, the
// tokens, the comments and the failure are the same bytes.
law ParseAllIsEachParse(picks []int) {
	let srcs = sourcesOf(picks)
	let one = ParseAll(srcs, 1)
	let many = ParseAll(srcs, 8)
	let mut ok = len(one) == len(srcs) && len(many) == len(srcs)
	for i in 0..len(srcs) {
		let own = Columns(Parse(srcs[i]))
		ok = ok && slices.Equal(Columns(one[i]), own) && slices.Equal(Columns(many[i]), own) && one[i].Message == many[i].Message
	}
	ok
}

// sourcesOf is a few sources from picks: programs of its rotations, and a
// source that fails, so a failed parse sits among parses that succeed.
func sourcesOf(picks []int) []string {
	let mut srcs = []string{}
	let n = len(picks)
	for k in 0..n%6+2 {
		let mut rot = []int{}
		for j in 0..n {
			rot = rot.Append(picks[(j+k)%n])
		}
		srcs = srcs.Append(program(rot))
		if k == 1 {
			srcs = srcs.Append("func f( {\n")
		}
	}
	srcs
}

// ---------------------------------------------------------------- tokens

// next advances to the next token. It stops at EOF and at the ILLEGAL
// token of a lexical error, and after a failure.
func next(p *parser) {
	if p.tk != EOF && p.tk != Illegal {
		p.i = p.i + 1
		p.tk = p.kinds[p.i]
	}
}

// peek is the kind of the token n past the current one, or of the final
// EOF past the end.
func peek(p *parser, n int) uint8 {
	let j = p.i + n
	if j < p.ntok {
		return p.kinds[j]
	}
	p.kinds[p.ntok-1]
}

// tpos is the offset of token j.
func tpos(p *parser, j int) int { int(p.starts[j]) }

// tend is the end of token j.
func tend(p *parser, j int) int {
	if j >= p.nreal {
		return p.vend
	}
	int(p.ends[j])
}

// pos and end are the current token's.
func pos(p *parser) int { int(p.starts[p.i]) }

func tokLen(p *parser) int { tend(p, p.i) - int(p.starts[p.i]) }

// lit is the source text of token j (a raw string without its carriage
// returns, as the Go scanner's literal).
func lit(p *parser, j int) string {
	let s = p.src[tpos(p, j):tend(p, j)]
	if p.kinds[j] == String && len(s) > 0 && s[0] == '`' {
		return dropCR(s)
	}
	s
}

func dropCR(s string) string {
	let mut out = ""
	let mut from = 0
	for k in 0..len(s) {
		if s[k] == '\r' {
			out = out + s[from:k]
			from = k + 1
		}
	}
	out + s[from:]
}

// isWord reports the current token an identifier spelled w.
func isWord(p *parser, w string) bool {
	if p.tk != Ident {
		return false
	}
	let at = int(p.starts[p.i])
	at+len(w) <= len(p.src) && p.src[at:at+len(w)] == w && identEnd(p.src, at) == at+len(w)
}

// wordAt reports token j an identifier spelled w.
func wordAt(p *parser, j int, w string) bool {
	if j >= p.ntok || p.kinds[j] != Ident {
		return false
	}
	let at = int(p.starts[j])
	at+len(w) <= len(p.src) && p.src[at:at+len(w)] == w && identEnd(p.src, at) == at+len(w)
}

// inserted reports an inserted semicolon (a newline's).
func inserted(p *parser, j int) bool {
	p.kinds[j] == Semicolon && !(int(p.starts[j]) < len(p.src) && p.src[int(p.starts[j])] == ';')
}

// atLineEnd reports whether the current token is an inserted semicolon.
func atLineEnd(p *parser) bool { p.tk == Semicolon && inserted(p, p.i) }

func backtrack(p *parser, j int) {
	p.i = j
	p.tk = p.kinds[j]
}

// want consumes a token of kind k and returns its index.
func want(p *parser, k uint8) int {
	if p.tk != k {
		if loud(p) {
			expected(p, "expected "+quote(tokenName(k))+", found ")
		} else {
			errorf(p, "")
		}
	}
	let j = p.i
	next(p)
	j
}

func got(p *parser, k uint8) bool {
	if p.tk == k {
		next(p)
		return true
	}
	false
}

// opensCollection reports whether the token n past the current one opens
// a slice or array type, `[]` or `[N]`.
func opensCollection(p *parser, n int) bool {
	if peek(p, n) != LBrack {
		return false
	}
	let k = peek(p, n+1)
	k == RBrack || ((k == Int || k == Ellipsis) && peek(p, n+2) == RBrack)
}

// found describes the current token for a message.
func found(p *parser) string {
	let k = p.tk
	if k == Semicolon {
		return if inserted(p, p.i) { "newline" } else { "\";\"" }
	}
	if k == EOF {
		return "end of file"
	}
	if k == Ident || k == Int || k == Float || k == Duration || k == String || k == Rune || k == Path || k == StringHead {
		return quote(lit(p, p.i))
	}
	quote(tokenName(k))
}

// ---------------------------------------------------------------- errors

// errorCode records the first error; a lexical error at or before pos wins,
// since the tokens past it are not the source's.
func errorCode(p *parser, code string, at int, length int, message string) {
	if p.failed {
		return
	}
	p.failed = true
	p.tk = EOF
	if p.scanFailed && at >= p.scanOffset {
		p.lexical = true
		p.code = CodeSyntax
		p.msg = p.scanMessage
		p.eoff = p.scanOffset
		p.elen = p.scanLength
		return
	}
	p.lexical = false
	p.code = code
	p.msg = message
	let n = len(p.src)
	let offset = if at > n { n } else { at }
	let mut l = if offset+length > n { n - offset } else { length }
	if l < 0 {
		l = 0
	}
	for l > 0 && offset+l < n && (p.src[offset+l]&0xC0) == 0x80 {
		l = l + 1
	}
	p.eoff = offset
	p.elen = l
}

func errorAt(p *parser, at int, length int, message string) { errorCode(p, CodeSyntax, at, length, message) }

// loud reports whether an error now would keep its message: no error yet
// and no attempt under way. A message that loud does not keep is never
// built (an attempt that fails allocates nothing).
func loud(p *parser) bool { !p.failed && p.quiet == 0 }

// expected reports prefix and the token found at the current token.
func expected(p *parser, prefix string) {
	if loud(p) {
		errorf(p, prefix+found(p))
	} else {
		errorf(p, "")
	}
}

// errorf reports an error at the current token; a Go token Ergo does not
// use gets its habit message instead.
func errorf(p *parser, message string) {
	if p.failed {
		return
	}
	let h = tokenHabit(p.tk)
	if h >= 0 {
		habit(p, pos(p), tokLen(p), h)
		return
	}
	errorAt(p, pos(p), tokLen(p), message)
}

func habit(p *parser, at int, length int, h int) { errorAt(p, at, length, habitMessages[h]) }

// ---------------------------------------------------------------- nesting

func enter(p *parser) {
	p.nest = p.nest + 1
	if p.nest > p.peak {
		p.peak = p.nest
	}
	if p.nest > MaxNesting {
		tooDeep(p)
	}
}

func leave(p *parser) { p.nest = p.nest - 1 }

func tooDeep(p *parser) { errorAt(p, pos(p), tokLen(p), "nesting deeper than "+itoa(MaxNesting)+" levels") }

func measure(p *parser) int {
	let saved = p.peak
	p.peak = p.nest
	saved
}

func height(p *parser, saved int) int {
	let h = p.peak - p.nest
	if saved > p.peak {
		p.peak = saved
	}
	h
}

func maxInt(a int, b int) int { if a > b { a } else { b } }

func reach(p *parser, top int) {
	if top > p.peak {
		p.peak = top
	}
}

// Mark is the parser state an attempt restores: the token, the nesting
// and header state and the tree's lengths.
type state {
	i       int,
	nest    int,
	peak    int,
	exprLev int,
	tree    Checkpoint,
}

func save(p *parser) state { state{i: p.i, nest: p.nest, peak: p.peak, exprLev: p.exprLev, tree: checkpoint(p.t)} }

// failedAttempt ends an attempt: when it failed on an error that is not
// the lexical one, the parser goes back to m and the attempt reports
// false; the lexical error stays (the Go parser's attempt).
func attemptFailed(p *parser, m state) bool {
	if !p.failed {
		return false
	}
	if p.lexical {
		return true
	}
	backtrack(p, m.i)
	p.nest = m.nest
	p.peak = m.peak
	p.exprLev = m.exprLev
	rewind(&p.t, m.tree)
	p.failed = false
	p.litErr = false
	true
}

// ---------------------------------------------------------------- comments

// oneLineApart reports exactly one newline in src[a:b]: b is on the line
// after a's. It reads no further than the second newline.
func oneLineApart(p *parser, a int, b int) bool {
	let k = strings.IndexByte(p.src[a:b], '\n')
	k >= 0 && strings.IndexByte(p.src[a+k+1:b], '\n') < 0
}

// newlines is the number of newlines in src[a:b], counted up to 2: how
// many lines further b is than a (0 on the same line, 1 the next, 2 or
// more). It reads no further than the second newline.
func newlines(p *parser, a int, b int) int {
	let k = strings.IndexByte(p.src[a:b], '\n')
	if k < 0 {
		return 0
	}
	if strings.IndexByte(p.src[a+k+1:b], '\n') < 0 { 1 } else { 2 }
}

func cmtStart(p *parser, c int) int { CommentStart(p.cmts, CommentAt(p.cmts, c)) }

func cmtEnd(p *parser, c int) int { CommentEnd(p.cmts, CommentAt(p.cmts, c)) }

// groupComments forms comment groups as go/parser does: comments with no
// token and no blank line between them; a comment on the line of a token
// before it starts its own (trailing) group.
func groupComments(p *parser) {
	let nc = NumComments(p.cmts)
	if nc == 0 {
		return
	}
	let mut ti = 0
	let mut lastTok = -1
	let mut cur = -1
	let mut curOwn = false
	let mut curLast = 0
	let mut curTokens = -1
	for c in 0..nc {
		let slash = cmtStart(p, c)
		// The first token at or after the comment, by a galloping search of the
		// tokens after the last comment's; the last real token is found
		// walking back from it over inserted semicolons.
		let from = ti
		let mut step = 1
		let mut hi = ti
		for hi < p.ntok && int(p.starts[hi]) < slash {
			ti = hi + 1
			hi = hi + step
			step = step * 2
		}
		if hi > p.ntok {
			hi = p.ntok
		}
		for ti < hi {
			let mid = (ti + hi) / 2
			if int(p.starts[mid]) < slash {
				ti = mid + 1
			} else {
				hi = mid
			}
		}
		let mut j = ti - 1
		for j >= from && (inserted(p, j) || p.kinds[j] == EOF) {
			j = j - 1
		}
		if j >= from {
			lastTok = j
		}
		// Own line: a newline lies between the last token and the comment.
		let own = lastTok < 0 || newlines(p, tend(p, lastTok), slash) > 0
		if cur >= 0 && curTokens == ti {
			// The comment is on the group's last line or the next one.
			let apart = newlines(p, cmtEnd(p, curLast), slash)
			if apart <= 1 && (curOwn || apart == 0) {
				p.gLast[cur] = c
				curLast = c
				continue
			}
		}
		p.gFirst = p.gFirst.Append(c)
		p.gLast = p.gLast.Append(c)
		p.gOwn = p.gOwn.Append(own)
		cur = len(p.gFirst) - 1
		curOwn = own
		curLast = c
		curTokens = ti
	}
}

// leadComment is the comment group that documents a node starting at the
// current token, as a word (its index+1, 0 for none): an own-line group
// that ends on the line just above it, with no token in between.
func leadComment(p *parser) uint32 {
	let ng = len(p.gFirst)
	if ng == 0 {
		return uint32(0)
	}
	let at = pos(p)
	// The first group that ends after at, walked to from the last one asked
	// for: the parser asks in source order but for a backtrack.
	let mut lo = p.gHint
	for lo > 0 && cmtEnd(p, p.gLast[lo-1]) > at {
		lo = lo - 1
	}
	for lo < ng && cmtEnd(p, p.gLast[lo]) <= at {
		lo = lo + 1
	}
	p.gHint = lo
	let g = lo - 1
	if g < 0 || !p.gOwn[g] {
		return uint32(0)
	}
	if !oneLineApart(p, cmtEnd(p, p.gLast[g]), at) {
		return uint32(0)
	}
	let gpos = cmtStart(p, p.gFirst[g])
	let mut j = p.i - 1
	for j >= 0 {
		if !inserted(p, j) {
			if tend(p, j) > gpos {
				return uint32(0)
			}
			break
		}
		j = j - 1
	}
	uint32(g + 1)
}

// ---------------------------------------------------------------- rows

// kindAt is the kind of row x, 0 for noNode or a row past the end.
func kindAt(p *parser, x uint32) uint8 {
	if x >= uint32(p.t.n) {
		return uint8(0)
	}
	p.t.kind[int(x)]
}

// ident appends the Ident row of token j.
func identRow(p *parser, j int) uint32 { row(&p.t, KIdent, uint32(j), uint32(0), uint32(0)) }

// identIs reports row x an Ident spelled w.
func identIs(p *parser, x uint32, w string) bool { kindAt(p, x) == KIdent && wordAt(p, int(p.t.tok[int(x)]), w) }

// some is the word of a present optional node or token index.
func some(x uint32) uint32 { x + uint32(1) }

func someTok(j int) uint32 { uint32(j + 1) }

let none = uint32(0)

// nodePos and nodeEnd are row x's span (the Go node's Pos and End).
func nodePos(p *parser, x uint32) int { posOf(p.t, toks(p), x) }

func nodeEnd(p *parser, x uint32) int { endOf(p.t, toks(p), x) }

// toks is the parser's tokens, to read spans from.
func toks(p *parser) tokens {
	let c0 = if NumComments(p.cmts) > 0 { cmtStart(p, 0) } else { -1 }
	tokens{src: p.src, kinds: p.kinds, starts: p.starts, ends: p.ends, nreal: p.nreal, vend: p.vend, cmt0: c0}
}

// errorNode reports message at the span of row x.
func errorNode(p *parser, x uint32, message string) {
	if p.failed {
		return
	}
	let a = nodePos(p, x)
	errorAt(p, a, nodeEnd(p, x)-a, message)
}
