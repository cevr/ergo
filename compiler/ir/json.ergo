import strconv
import strings
import utf8

// Write is the IR file of file as the Go IR builder writes it:
// encoding/json's Marshal of the builder's irFile, byte for byte. IR it
// cannot read fails Malformed at the first row or word that is wrong.
func Write(file File) string fails Malformed {
	if file.Strs.Len() == 0 || file.Strs[0].Len() != 0 {
		return Malformed{At: 0, Why: "Strs[0] is not \"\""}
	}
	let mut b = strings.NewBuilder()
	b.Grow(file.Funcs.Len()*256 + file.Files.Len()*32 + 64)
	b.WriteString("{\"v\":")
	writeInt64(&b, file.V)
	b.WriteString(",\"files\":")
	if file.FilesNil {
		b.WriteString("null")
	} else {
		b.WriteByte('[')
		for i in 0..file.Files.Len() {
			if i > 0 {
				b.WriteByte(',')
			}
			writeQuoted(&b, file.Files[i])
		}
		b.WriteByte(']')
	}
	b.WriteString(",\"funcs\":")
	if file.FuncsNil {
		b.WriteString("null")
	} else {
		b.WriteByte('[')
		for i in 0..file.Funcs.Len() {
			if i > 0 {
				b.WriteByte(',')
			}
			try function(file, &b, i)
		}
		b.WriteByte(']')
	}
	if file.Shared.Len() > 0 {
		b.WriteString(",\"shared\":[")
		for i in 0..file.Shared.Len() {
			if i > 0 {
				b.WriteByte(',')
			}
			writeQuoted(&b, file.Shared[i])
		}
		b.WriteByte(']')
	}
	b.WriteByte('}')
	b.String()
}

// WriteFunc is Funcs[fi] as Write writes it inside the file's text.
func WriteFunc(file File, fi int) string fails Malformed {
	if fi < 0 || fi >= file.Funcs.Len() {
		return Malformed{At: fi, Why: "no function"}
	}
	let mut b = strings.NewBuilder()
	b.Grow(file.Funcs[fi].Body.Kind.Len()*32 + 64)
	try function(file, &b, fi)
	b.String()
}

func writeUint(b mut strings.Builder, v uint32) {
	if v < uint32(10) {
		b.WriteByte(byte('0') + byte(v))
		return
	}
	writeUint(b, v/uint32(10))
	b.WriteByte(byte('0') + byte(v%uint32(10)))
}

func writeUint64(b mut strings.Builder, v uint64) {
	if v < uint64(10) {
		b.WriteByte(byte('0') + byte(v))
		return
	}
	writeUint64(b, v/uint64(10))
	b.WriteByte(byte('0') + byte(v%uint64(10)))
}

func writeInt64(b mut strings.Builder, v int64) {
	if v < int64(0) {
		b.WriteByte('-')
		let q = -(v / int64(10))
		let r = -(v % int64(10))
		if q > int64(0) {
			writeUint64(b, uint64(q))
		}
		b.WriteByte(byte('0') + byte(r))
		return
	}
	writeUint64(b, uint64(v))
}

func text(file File, id uint32) string fails Malformed {
	if int(id) >= file.Strs.Len() {
		return Malformed{At: int(id), Why: "no text " + strconv.Itoa(int(id))}
	}
	file.Strs[int(id)]
}

func pos(b mut strings.Builder, a uint32, c uint32, d uint32) {
	b.WriteByte('[')
	writeUint(b, a)
	b.WriteByte(',')
	writeUint(b, c)
	b.WriteByte(',')
	writeUint(b, d)
	b.WriteByte(']')
}

func function(file File, b mut strings.Builder, fi int) fails Malformed {
	b.WriteString("{\"name\":")
	let name = try text(file, file.Funcs[fi].Name)
	writeQuoted(b, name)
	b.WriteString(",\"pos\":")
	let p = file.Funcs[fi].Pos
	pos(b, p.File, p.Line, p.Col)
	b.WriteString(",\"end\":")
	let e = file.Funcs[fi].End
	pos(b, e.File, e.Line, e.Col)
	let nl = file.Funcs[fi].Locals.Len()
	if nl > 0 {
		b.WriteString(",\"locals\":[")
		for i in 0..nl {
			if i > 0 {
				b.WriteByte(',')
			}
			let l = file.Funcs[fi].Locals[i]
			let ln = try text(file, l.Name)
			let lt = try text(file, l.Type)
			b.WriteString("{\"name\":")
			writeQuoted(b, ln)
			b.WriteString(",\"type\":")
			writeQuoted(b, lt)
			b.WriteString(",\"pos\":")
			pos(b, l.Pos.File, l.Pos.Line, l.Pos.Col)
			b.WriteByte('}')
		}
		b.WriteByte(']')
	}
	b.WriteString(",\"body\":")
	let roots = file.Funcs[fi].Body.Roots
	if roots == 0 {
		b.WriteString("null")
	} else {
		try rows(file, b, fi, roots, TStmt)
	}
	b.WriteByte('}')
}

func extra(file File, fi int, at int) uint32 fails Malformed {
	if at <= 0 || at >= file.Funcs[fi].Body.Extra.Len() {
		return Malformed{At: at, Why: "past the extra pool"}
	}
	file.Funcs[fi].Body.Extra[at]
}

func rows(file File, b mut strings.Builder, fi int, q uint32, t uint8) fails Malformed {
	let n = int(try extra(file, fi, int(q)))
	b.WriteByte('[')
	for i in 0..n {
		if i > 0 {
			b.WriteByte(',')
		}
		let id = try extra(file, fi, int(q)+1+i)
		if id == 0 {
			b.WriteString("null")
		} else {
			try row(file, b, fi, int(id), t)
		}
	}
	b.WriteByte(']')
}

func row(file File, b mut strings.Builder, fi int, id int, t uint8) fails Malformed {
	if id <= 0 || id > file.Funcs[fi].Body.Kind.Len() {
		return Malformed{At: id, Why: "no row"}
	}
	let c = file.Funcs[fi].Body.Kind[id-1]
	if int(c) >= NumKinds() || c == 0 {
		return Malformed{At: id, Why: "kind " + strconv.Itoa(int(c))}
	}
	let kd = KindOf(c)
	if kd.Class != t {
		return Malformed{At: id, Why: "kind " + kd.Name + " where its struct type is not the field's"}
	}
	let fs = Fields(t)
	let ns = kd.Slots.Len()
	let mut si = 0
	let mut next = byte('{')
	for j in 0..fs.Len() {
		let fd = fs[j]
		let mut v = uint32(0)
		if si < ns && int(kd.Slots[si]) == j {
			v = try slotAt(file.Funcs[fi].Body, id, si, ns)
			si += 1
		}
		if fd.Omit {
			let none = try empty(file, fi, fd.Kind, v)
			if none {
				continue
			}
		}
		b.WriteByte(next)
		next = byte(',')
		b.WriteString(fd.Key)
		try value(file, b, fi, id, fd, kd, v)
	}
	b.WriteByte('}')
}

func empty(file File, fi int, k uint8, v uint32) bool fails Malformed {
	if v == 0 {
		return true
	}
	match k {
	case 1:
		let s = try text(file, v)
		s.Len() == 0
	case 8, 9, 10:
		let n = try extra(file, fi, int(v))
		n == 0
	case _:
		false
	}
}

func value(file File, b mut strings.Builder, fi int, id int, fd Field, kd Kind, v uint32) fails Malformed {
	match fd.Kind {
	case 11:
		b.WriteString(kd.Quoted)
	case 12:
		pos(b, file.Funcs[fi].Body.File[id-1], file.Funcs[fi].Body.Line[id-1], file.Funcs[fi].Body.Col[id-1])
	case 1:
		let s = try text(file, v)
		writeQuoted(b, s)
	case 2:
		writeInt64(b, int64(int32(v)))
	case 5:
		if v == 0 {
			b.WriteString("null")
		} else {
			writeUint(b, v-uint32(1))
		}
	case 3:
		if v != 0 {
			b.WriteString("true")
		} else {
			b.WriteString("false")
		}
	case 4, 6:
		if v == 0 {
			if fd.Kind == FPos {
				b.WriteString("[0,0,0]")
			} else {
				b.WriteString("null")
			}
		} else {
			let a = try extra(file, fi, int(v))
			let c = try extra(file, fi, int(v)+1)
			let d = try extra(file, fi, int(v)+2)
			pos(b, a, c, d)
		}
	case 7:
		if v == 0 {
			b.WriteString("null")
		} else {
			try row(file, b, fi, int(v), fd.Of)
		}
	case 8:
		if v == 0 {
			b.WriteString("null")
		} else {
			try rows(file, b, fi, v, fd.Of)
		}
	case _:
		if v == 0 {
			b.WriteString("null")
		} else {
			try list(file, b, fi, fd.Kind, v)
		}
	}
}

func list(file File, b mut strings.Builder, fi int, k uint8, q uint32) fails Malformed {
	let n = int(try extra(file, fi, int(q)))
	b.WriteByte('[')
	for i in 0..n {
		if i > 0 {
			b.WriteByte(',')
		}
		let e = try extra(file, fi, int(q)+1+i)
		if k == FStrs {
			let s = try text(file, e)
			writeQuoted(b, s)
		} else {
			writeInt64(b, int64(int32(e)))
		}
	}
	b.WriteByte(']')
}

let hexDigits = "0123456789abcdef"

// Quote is s as encoding/json writes a string with HTML escaping on (Go's
// default) since Go 1.25's jsonv2 (internal/jsonwire.AppendQuote, the
// default of the pinned Go 1.27): between double quotes; \" and \\; \b,
// \f, \n, \r and \t; any other byte below 0x20 and <, > and & as \u00xx;
// each byte of an invalid UTF-8 sequence as the bytes of U+FFFD (Go's v1
// encoder wrote the escape \ufffd); U+2028 and U+2029 as \u2028 and
// \u2029. Every other byte is copied.
func Quote(s string) string {
	let mut b = strings.NewBuilder()
	b.Grow(s.Len() + 2)
	writeQuoted(&b, s)
	b.String()
}

func writeQuoted(b mut strings.Builder, s string) {
	b.WriteByte('"')
	let mut start = 0
	let mut i = 0
	let n = s.Len()
	for i < n {
		let c = s[i]
		if c < 0x80 {
			if c >= 0x20 && c != '"' && c != '\\' && c != '<' && c != '>' && c != '&' {
				i += 1
				continue
			}
			b.WriteString(strings.Slice(s, start, i))
			match c {
			case '"', '\\':
				b.WriteByte('\\')
				b.WriteByte(c)
			case 0x08:
				b.WriteString("\\b")
			case 0x0C:
				b.WriteString("\\f")
			case '\n':
				b.WriteString("\\n")
			case '\r':
				b.WriteString("\\r")
			case '\t':
				b.WriteString("\\t")
			case _:
				b.WriteString("\\u00")
				b.WriteByte(hexDigits[int(c>>4)])
				b.WriteByte(hexDigits[int(c&0xF)])
			}
			i += 1
			start = i
			continue
		}
		let end = if i+4 < n { i + 4 } else { n }
		let d = utf8.DecodeRuneInString(strings.Slice(s, i, end))
		if d.Rune == 0xFFFD && d.Size == 1 {
			b.WriteString(strings.Slice(s, start, i))
			b.WriteByte(0xEF)
			b.WriteByte(0xBF)
			b.WriteByte(0xBD)
			i += 1
			start = i
			continue
		}
		if d.Rune == 0x2028 || d.Rune == 0x2029 {
			b.WriteString(strings.Slice(s, start, i))
			b.WriteString("\\u202")
			b.WriteByte(hexDigits[int(d.Rune&0xF)])
			i += d.Size
			start = i
			continue
		}
		i += d.Size
	}
	b.WriteString(strings.Slice(s, start, n))
	b.WriteByte('"')
}

// QuoteCopiesSafeText: a text of letters, digits, spaces and the other
// printable ASCII bytes but " \ < > & is copied between double quotes.
law QuoteCopiesSafeText(s string) {
	let mut safe = strings.NewBuilder()
	for i in 0..s.Len() {
		let c = s[i]
		if c >= 0x20 && c < 0x7F && c != '"' && c != '\\' && c != '<' && c != '>' && c != '&' {
			safe.WriteByte(c)
		}
	}
	let t = safe.String()
	Quote(t) == "\""+t+"\""
}

// QuoteIsSafe: the quoted text of any s is valid UTF-8, starts and ends
// with a double quote, and holds no byte below 0x20, no <, > or & and no
// double quote but an escaped one.
law QuoteIsSafe(s string) {
	let q = Quote(s)
	let mut ok = utf8.ValidString(q) && q.Len() >= 2 && q[0] == '"' && q[q.Len()-1] == '"'
	let mut i = 1
	for i < q.Len()-1 {
		let c = q[i]
		if c == '\\' {
			i += 2
			continue
		}
		ok = ok && c >= 0x20 && c != '"' && c != '<' && c != '>' && c != '&'
		i += 1
	}
	ok && i == q.Len()-1
}

// WriteZeroesUnslottedFields: a statement of a kind with no slots is
// written with its kind, its position and the three positions that are
// not omitempty as Go's zero, and nothing else; a file of no functions
// writes Go's nil and empty lists apart.
law WriteZeroesUnslottedFields(line uint32) {
	let mut body = Body{
		Kind:  []uint8{0},
		A:     []uint32{0},
		B:     []uint32{0},
		File:  []uint32{0},
		Line:  []uint32{line},
		Col:   []uint32{3},
		Extra: []uint32{0, 1, 1},
		Roots: 1,
	}
	let mut cont = 0
	for c in 1..NumKinds() {
		if KindOf(uint8(c)).Name == "continue" {
			cont = c
		}
	}
	body.Kind[0] = uint8(cont)
	let fn = Func{Name: 0, Pos: Pos{File: 0, Line: 1, Col: 1}, End: Pos{File: 0, Line: 2, Col: 1}, Locals: []Local{}, Body: body}
	let file = File{V: 1, Files: []string{}, FilesNil: false, Funcs: []Func{fn}, FuncsNil: false, Shared: []string{}, Strs: []string{""}}
	let empty = File{V: 0, Files: []string{}, FilesNil: true, Funcs: []Func{}, FuncsNil: false, Shared: []string{}, Strs: []string{""}}
	let a = Write(file) catch {
	case Malformed:
		return false
	}
	let b = Write(empty) catch {
	case Malformed:
		return false
	}
	let stmt = "{\"k\":\"continue\",\"pos\":[0," + strconv.Itoa(int(line)) + ",3],\"end\":[0,0,0],\"epos\":[0,0,0],\"eend\":[0,0,0]}"
	a == "{\"v\":1,\"files\":[],\"funcs\":[{\"name\":\"\",\"pos\":[0,1,1],\"end\":[0,2,1],\"body\":["+stmt+"]}]}" && b == "{\"v\":0,\"files\":null,\"funcs\":[]}"
}
