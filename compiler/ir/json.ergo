import strconv
import strings
import utf8

// writer is the state of one Write: the file it reads and the text so far.
type writer { file File, b strings.Builder }

// Write is the IR file of f as the Go IR builder writes it: encoding/json's
// Marshal of the builder's irFile, byte for byte. A pool it cannot read
// fails Malformed at the first word that is wrong.
func Write(file File) string fails Malformed {
	if len(file.Words) < 2 {
		return Malformed{At: 0, Why: "no header"}
	}
	if file.Words[0] != Version {
		return Malformed{At: 0, Why: "version " + strconv.Itoa(int(file.Words[0]))}
	}
	let mut w = writer{file: file, b: strings.NewBuilder()}
	w.b.Grow(8 * len(file.Words))
	try node(&w, int(file.Words[1]), TFile)
	w.b.String()
}

// word is Words[i], or Malformed past the end.
func word(w *writer, i int) uint32 fails Malformed {
	if i < 0 || i >= len(w.file.Words) {
		return Malformed{At: i, Why: "past the end"}
	}
	w.file.Words[i]
}

// node writes the record at o, of struct type t, as encoding/json writes a
// struct: the fields in order, each that omitempty does not drop, between
// braces.
func node(w *writer, o int, t uint8) fails Malformed {
	let have = try word(w, o)
	if have != uint32(t) {
		return Malformed{At: o, Why: "type " + strconv.Itoa(int(have)) + ", want " + strconv.Itoa(int(t))}
	}
	let mask = try word(w, o+1)
	let fs = Fields(t)
	if len(fs) < 32 && mask>>uint32(len(fs)) != 0 {
		return Malformed{At: o + 1, Why: "a bit past the fields"}
	}
	let mut p = o + 2
	let mut next = byte('{')
	for j in 0..len(fs) {
		let fd = fs[j]
		let set = mask&(uint32(1)<<uint32(j)) != 0
		let at = p
		if set {
			p += Width(fd.Kind)
		}
		if fd.Omit {
			if !set {
				continue
			}
			let none = try empty(w, fd.Kind, at)
			if none {
				continue
			}
		}
		w.b.WriteByte(next)
		next = byte(',')
		w.b.WriteString(fd.Key)
		try value(w, fd, set, at)
	}
	if next == byte('{') {
		w.b.WriteString("{}")
	} else {
		w.b.WriteByte('}')
	}
}

// empty reports whether the set field of kind k at word at holds what
// omitempty drops: "", 0, false or an empty list. A pointer is never empty.
func empty(w *writer, k uint8, at int) bool fails Malformed {
	match k {
	case 1:
		let s = try text(w, at)
		len(s) == 0
	case 2:
		let lo = try word(w, at)
		let hi = try word(w, at+1)
		lo == 0 && hi == 0
	case 3:
		false
	case 8, 9, 10:
		let q = try word(w, at)
		let n = try word(w, int(q))
		n == 0
	case _:
		false
	}
}

// text is the string whose index is the word at at.
func text(w *writer, at int) string fails Malformed {
	let id = try word(w, at)
	if int(id) >= len(w.file.Strs) {
		return Malformed{At: at, Why: "no text " + strconv.Itoa(int(id))}
	}
	w.file.Strs[int(id)]
}

// integer is the int64 whose halves are the two words at at.
func integer(w *writer, at int) int64 fails Malformed {
	let lo = try word(w, at)
	let hi = try word(w, at+1)
	int64(uint64(lo) | uint64(hi)<<uint64(32))
}

// pos writes the three words at at as a JSON array, as Go writes [3]int.
func pos(w *writer, at int) fails Malformed {
	let a = try word(w, at)
	let b = try word(w, at+1)
	let c = try word(w, at+2)
	w.b.WriteByte('[')
	w.b.WriteString(strconv.Itoa(int(a)))
	w.b.WriteByte(',')
	w.b.WriteString(strconv.Itoa(int(b)))
	w.b.WriteByte(',')
	w.b.WriteString(strconv.Itoa(int(c)))
	w.b.WriteByte(']')
}

// value writes field fd, set or not, whose words start at at.
func value(w *writer, fd Field, set bool, at int) fails Malformed {
	match fd.Kind {
	case 1:
		if set {
			let s = try text(w, at)
			w.b.WriteString(Quote(s))
		} else {
			w.b.WriteString("\"\"")
		}
	case 2, 5:
		if set {
			let n = try integer(w, at)
			w.b.WriteString(strconv.FormatInt(n, 10))
		} else if fd.Kind == FIntPtr {
			w.b.WriteString("null")
		} else {
			w.b.WriteByte('0')
		}
	case 3:
		if set {
			w.b.WriteString("true")
		} else {
			w.b.WriteString("false")
		}
	case 4, 6:
		if set {
			try pos(w, at)
		} else if fd.Kind == FPosPtr {
			w.b.WriteString("null")
		} else {
			w.b.WriteString("[0,0,0]")
		}
	case 7:
		if set {
			let o = try word(w, at)
			try node(w, int(o), fd.Of)
		} else {
			w.b.WriteString("null")
		}
	case _:
		if set {
			try list(w, fd, at)
		} else {
			w.b.WriteString("null")
		}
	}
}

// list writes the list field fd whose offset is the word at at.
func list(w *writer, fd Field, at int) fails Malformed {
	let q = int(try word(w, at))
	let n = int(try word(w, q))
	w.b.WriteByte('[')
	for i in 0..n {
		if i > 0 {
			w.b.WriteByte(',')
		}
		match fd.Kind {
		case 8:
			let o = try word(w, q+1+i)
			if o == 0 {
				w.b.WriteString("null")
			} else {
				try node(w, int(o), fd.Of)
			}
		case 9:
			let s = try text(w, q+1+i)
			w.b.WriteString(Quote(s))
		case _:
			let v = try integer(w, q+1+2*i)
			w.b.WriteString(strconv.FormatInt(v, 10))
		}
	}
	w.b.WriteByte(']')
}

let hexDigits = "0123456789abcdef"

// Quote is s as encoding/json writes a string with HTML escaping on (Go's
// default) since Go 1.25's jsonv2 (internal/jsonwire.AppendQuote, the
// default of the pinned Go 1.27): between double quotes; \" and \\; \b,
// \f, \n, \r and \t; any other byte below 0x20 and <, > and & as \u00xx;
// each byte of an invalid UTF-8 sequence as the bytes of U+FFFD (Go's v1
// encoder wrote the escape \ufffd); U+2028 and U+2029 as \u2028 and
// \u2029. Every other byte is copied.
func Quote(s string) string {
	let mut b = strings.NewBuilder()
	b.Grow(len(s) + 2)
	b.WriteByte('"')
	let mut start = 0
	let mut i = 0
	let n = len(s)
	for i < n {
		let c = s[i]
		if c < 0x80 {
			if c >= 0x20 && c != '"' && c != '\\' && c != '<' && c != '>' && c != '&' {
				i += 1
				continue
			}
			b.WriteString(strings.Slice(s, start, i))
			match c {
			case '"', '\\':
				b.WriteByte('\\')
				b.WriteByte(c)
			case 0x08:
				b.WriteString("\\b")
			case 0x0C:
				b.WriteString("\\f")
			case '\n':
				b.WriteString("\\n")
			case '\r':
				b.WriteString("\\r")
			case '\t':
				b.WriteString("\\t")
			case _:
				b.WriteString("\\u00")
				b.WriteByte(hexDigits[int(c>>4)])
				b.WriteByte(hexDigits[int(c&0xF)])
			}
			i += 1
			start = i
			continue
		}
		let end = if i+4 < n { i + 4 } else { n }
		let d = utf8.DecodeRuneInString(strings.Slice(s, i, end))
		if d.Rune == 0xFFFD && d.Size == 1 {
			b.WriteString(strings.Slice(s, start, i))
			b.WriteByte(0xEF)
			b.WriteByte(0xBF)
			b.WriteByte(0xBD)
			i += 1
			start = i
			continue
		}
		if d.Rune == 0x2028 || d.Rune == 0x2029 {
			b.WriteString(strings.Slice(s, start, i))
			b.WriteString("\\u202")
			b.WriteByte(hexDigits[int(d.Rune&0xF)])
			i += d.Size
			start = i
			continue
		}
		i += d.Size
	}
	b.WriteString(strings.Slice(s, start, n))
	b.WriteByte('"')
	b.String()
}

// QuoteCopiesSafeText: a text of letters, digits, spaces and the other
// printable ASCII bytes but " \ < > & is copied between double quotes.
law QuoteCopiesSafeText(s string) {
	let mut safe = strings.NewBuilder()
	for i in 0..len(s) {
		let c = s[i]
		if c >= 0x20 && c < 0x7F && c != '"' && c != '\\' && c != '<' && c != '>' && c != '&' {
			safe.WriteByte(c)
		}
	}
	let t = safe.String()
	Quote(t) == "\""+t+"\""
}

// QuoteIsSafe: the quoted text of any s is valid UTF-8, starts and ends
// with a double quote, and holds no byte below 0x20, no <, > or & and no
// double quote but an escaped one.
law QuoteIsSafe(s string) {
	let q = Quote(s)
	let mut ok = utf8.ValidString(q) && len(q) >= 2 && q[0] == '"' && q[len(q)-1] == '"'
	let mut i = 1
	for i < len(q)-1 {
		let c = q[i]
		if c == '\\' {
			i += 2
			continue
		}
		ok = ok && c >= 0x20 && c != '"' && c != '<' && c != '>' && c != '&'
		i += 1
	}
	ok && i == len(q)-1
}

// WriteDropsOnlyOmitEmpty: a file record with no bit set is written as Go
// writes a zero irFile, and with every bit set over zero values (an empty
// shared list, version 0) only shared, the omitempty field, is dropped,
// while the lists that are not omitempty are written empty.
law WriteDropsOnlyOmitEmpty(v uint32) {
	let zero = File{Words: []uint32{Version, 2, uint32(TFile), 0}, Strs: []string{}}
	let all = File{Words: []uint32{Version, 2, uint32(TFile), 15, v, 0, 9, 9, 9, 0}, Strs: []string{}}
	let a = Write(zero) catch {
	case Malformed:
		return false
	}
	let b = Write(all) catch {
	case Malformed:
		return false
	}
	a == "{\"v\":0,\"files\":null,\"funcs\":null}" && b == "{\"v\":"+strconv.Itoa(int(v))+",\"files\":[],\"funcs\":[]}"
}
