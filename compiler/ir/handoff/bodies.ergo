import compiler/ir

type body { slots uint32, nslots uint32, ops uint32, nops uint32, sig uint32 }
type op { k uint32, lo uint32, n uint32 }

func arg(p Image, o op, j uint32) uint32 { operand(p, o.lo, j) }

func slot(b body, s uint32) bool { s > 0 && s <= b.nslots }

func slotType(p Image, b body, s uint32) uint32 { word(p, ir.HSlots, int(b.slots+s)-1, 0) }

func signatureType(p Image, sig uint32, j uint32) uint32 {
	operand(p, word(p, ir.HTypes, int(sig)-1, 2), j)
}

func matchesSlot(p Image, b body, s uint32, t uint32) bool {
	slot(b, s) && slotType(p, b, s) == t
}

func call(p Image, b body, o op) bool {
	if o.n < 2 {
		return false
	}
	let target = arg(p, o, 0)
	let t = if o.k == ir.HOCall {
		if !symKind(p, target, ir.HSFunc) { return false }
		let t = word(p, ir.HSymbols, int(target)-1, 3)
		if typeKind(p, t) == ir.HTGeneric { return false }
		t
	} else if o.k == ir.HOCallClosure {
		if !slot(b, target) { return false }
		slotType(p, b, target)
	} else {
		if !ref(p, ir.HInstances, target) { return false }
		let t = word(p, ir.HInstances, int(target)-1, 1)
		if !ref(p, ir.HTypes, t) { return false }
		t
	}
	let sig = signature(p, t)
	if sig == 0 {
		return false
	}
	let (nparam, nresult) = signatureSize(p, sig)
	if arg(p, o, 1) != nresult || o.n-2 != nparam+nresult {
		return false
	}
	for i in 0..int(nparam) {
		let j = uint32(i)
		if !matchesSlot(p, b, arg(p, o, 2+nresult+j), signatureType(p, sig, j)) {
			return false
		}
	}
	for i in 0..int(nresult) {
		let j = uint32(i)
		if !matchesSlot(p, b, arg(p, o, 2+j), signatureType(p, sig, nparam+j)) {
			return false
		}
	}
	true
}

func isIntBasic(p Image, t uint32) bool {
	typeKind(p, t) == ir.HTBasic && BasicIsInt(word(p, ir.HTypes, int(t)-1, 1))
}

func isStringBasic(p Image, t uint32) bool {
	typeKind(p, t) == ir.HTBasic && word(p, ir.HTypes, int(t)-1, 1) == HBasicString
}

func isBoolBasic(p Image, t uint32) bool {
	typeKind(p, t) == ir.HTBasic && word(p, ir.HTypes, int(t)-1, 1) == HBasicBool
}

func isUint8Basic(p Image, t uint32) bool {
	typeKind(p, t) == ir.HTBasic && word(p, ir.HTypes, int(t)-1, 1) == HBasicUint8
}

func unwrapIface(p Image, t uint32) uint32 {
	let mut cur = t
	if typeKind(p, cur) == ir.HTNamed {
		cur = operand(p, word(p, ir.HTypes, int(cur)-1, 2), 0)
	}
	if typeKind(p, cur) == ir.HTInterface { cur } else { uint32(0) }
}

func isIfaceOrAny(p Image, t uint32) bool {
	if typeKind(p, t) == ir.HTBasic && word(p, ir.HTypes, int(t)-1, 1) == ir.HBasicAny {
		return true
	}
	unwrapIface(p, t) != 0
}

func unwrapStructPtr(p Image, t uint32) uint32 {
	if typeKind(p, t) != ir.HTPointer {
		return uint32(0)
	}
	unwrapNamedRecord(p, operand(p, word(p, ir.HTypes, int(t)-1, 2), 0))
}

func hasUintptrHead(p Image, rec uint32) bool {
	if rec == 0 || word(p, ir.HTypes, int(rec)-1, 3) == 0 {
		return false
	}
	let fsym = operand(p, word(p, ir.HTypes, int(rec)-1, 2), 0)
	let ft = word(p, ir.HSymbols, int(fsym)-1, 3)
	typeKind(p, ft) == ir.HTBasic && word(p, ir.HTypes, int(ft)-1, 1) == HBasicUintptr
}

func callIfaceValid(p Image, b body, o op) bool {
	if o.n < 3 {
		return false
	}
	let ifaceSlot = arg(p, o, 0)
	let mIdx = arg(p, o, 1)
	let nres = arg(p, o, 2)
	if !slot(b, ifaceSlot) {
		return false
	}
	let ifaceT = unwrapIface(p, slotType(p, b, ifaceSlot))
	if ifaceT == 0 {
		return false
	}
	let nmeth = word(p, ir.HTypes, int(ifaceT)-1, 3)
	if mIdx >= nmeth {
		return false
	}
	let msym = operand(p, word(p, ir.HTypes, int(ifaceT)-1, 2), mIdx)
	if !symKind(p, msym, ir.HSMethod) {
		return false
	}
	let sig = signature(p, word(p, ir.HSymbols, int(msym)-1, 3))
	if sig == 0 {
		return false
	}
	let (nparam, sigRes) = signatureSize(p, sig)
	if nres != sigRes || o.n-3 != nparam+nres {
		return false
	}
	for i in 0..int(nparam) {
		let j = uint32(i)
		if !matchesSlot(p, b, arg(p, o, 3+nres+j), signatureType(p, sig, j)) {
			return false
		}
	}
	for i in 0..int(nres) {
		let j = uint32(i)
		if !matchesSlot(p, b, arg(p, o, 3+j), signatureType(p, sig, nparam+j)) {
			return false
		}
	}
	true
}

func unwrapNamedRecord(p Image, t uint32) uint32 {
	let mut cur = t
	if typeKind(p, cur) == ir.HTNamed {
		cur = operand(p, word(p, ir.HTypes, int(cur)-1, 2), 0)
	}
	if typeKind(p, cur) == ir.HTRecord { cur } else { uint32(0) }
}

func unwrapRecordOrPtr(p Image, t uint32) uint32 {
	if typeKind(p, t) == ir.HTPointer {
		let elem = operand(p, word(p, ir.HTypes, int(t)-1, 2), 0)
		return unwrapNamedRecord(p, elem)
	}
	unwrapNamedRecord(p, t)
}

func recordHasField(p Image, rec uint32, fsym uint32) bool {
	if rec == 0 || !symKind(p, fsym, ir.HSField) {
		return false
	}
	let i = int(rec) - 1
	let lo = word(p, ir.HTypes, i, 2)
	let n = word(p, ir.HTypes, i, 3)
	for j in 0..int(n) {
		if operand(p, lo, uint32(j)) == fsym {
			return true
		}
	}
	false
}

func validConst(p Image, t uint32, lo uint32, hi uint32) bool {
	let k = typeKind(p, t)
	if k != ir.HTBasic {
		return lo == 0 && hi == 0
	}
	let aux = word(p, ir.HTypes, int(t)-1, 1)
	if aux == HBasicBool {
		return hi == 0 && lo <= 1
	}
	if aux == HBasicString {
		return hi == 0 && (lo == 0 || ref(p, ir.HNames, lo))
	}
	if BasicIsInt(aux) {
		return true
	}
	lo == 0 && hi == 0
}

func validConvert(p Image, dt uint32, st uint32) bool {
	if dt == st && (isIntBasic(p, dt) || isBoolBasic(p, dt) || isStringBasic(p, dt)) {
		return true
	}
	isIntBasic(p, dt) && isIntBasic(p, st)
}

// Checked refs first, then exact type identities for calls, results and
// globals. These are shape checks, not a replacement for the source
// checker or the backend's own capability and proof checks.
func opValid(p Image, b body, o op) bool {
	let k = o.k
	if k == ir.HOConst {
		return o.n == 3 && slot(b, arg(p, o, 0)) && validConst(p, slotType(p, b, arg(p, o, 0)), arg(p, o, 1), arg(p, o, 2))
	}
	if k == ir.HOAdd || k == ir.HOSub || k == ir.HOMul || k == ir.HOXor || k == HODiv || k == HORem || k == HOBitAnd || k == HOBitOr || k == HOBitAndNot {
		if o.n != 3 || !slot(b, arg(p, o, 0)) {
			return false
		}
		let t = slotType(p, b, arg(p, o, 0))
		let okType = isIntBasic(p, t) || (k == ir.HOAdd && isStringBasic(p, t))
		return okType && matchesSlot(p, b, arg(p, o, 1), t) && matchesSlot(p, b, arg(p, o, 2), t)
	}
	if k == HOShl || k == HOShr {
		if o.n != 3 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 2)) {
			return false
		}
		let t = slotType(p, b, arg(p, o, 0))
		return isIntBasic(p, t) && matchesSlot(p, b, arg(p, o, 1), t) && isIntBasic(p, slotType(p, b, arg(p, o, 2)))
	}
	if k == ir.HOLoad {
		if o.n != 2 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) {
			return false
		}
		let pt = slotType(p, b, arg(p, o, 1))
		return typeKind(p, pt) == ir.HTPointer && operand(p, word(p, ir.HTypes, int(pt)-1, 2), 0) == slotType(p, b, arg(p, o, 0))
	}
	if k == ir.HOStore {
		if o.n != 2 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) {
			return false
		}
		let pt = slotType(p, b, arg(p, o, 0))
		return typeKind(p, pt) == ir.HTPointer && operand(p, word(p, ir.HTypes, int(pt)-1, 2), 0) == slotType(p, b, arg(p, o, 1))
	}
	if k == ir.HOAddrOf {
		if o.n != 2 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) {
			return false
		}
		let pt = slotType(p, b, arg(p, o, 0))
		return typeKind(p, pt) == ir.HTPointer && operand(p, word(p, ir.HTypes, int(pt)-1, 2), 0) == slotType(p, b, arg(p, o, 1))
	}
	if k == ir.HOConvert {
		return o.n == 2 && slot(b, arg(p, o, 0)) && slot(b, arg(p, o, 1)) &&
			validConvert(p, slotType(p, b, arg(p, o, 0)), slotType(p, b, arg(p, o, 1)))
	}
	if k == HOLen {
		if o.n != 2 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) {
			return false
		}
		let dt = slotType(p, b, arg(p, o, 0))
		let st = slotType(p, b, arg(p, o, 1))
		return typeKind(p, dt) == ir.HTBasic && word(p, ir.HTypes, int(dt)-1, 1) == ir.HBasicInt &&
			(isStringBasic(p, st) || typeKind(p, st) == ir.HTSlice)
	}
	if k == HOFieldGet {
		if o.n != 3 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) {
			return false
		}
		let rec = unwrapRecordOrPtr(p, slotType(p, b, arg(p, o, 1)))
		let fsym = arg(p, o, 2)
		return recordHasField(p, rec, fsym) && slotType(p, b, arg(p, o, 0)) == word(p, ir.HSymbols, int(fsym)-1, 3)
	}
	if k == HOFieldSet {
		if o.n != 3 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 2)) {
			return false
		}
		let pt = slotType(p, b, arg(p, o, 0))
		if typeKind(p, pt) != ir.HTPointer {
			return false
		}
		let rec = unwrapNamedRecord(p, operand(p, word(p, ir.HTypes, int(pt)-1, 2), 0))
		let fsym = arg(p, o, 1)
		return recordHasField(p, rec, fsym) && slotType(p, b, arg(p, o, 2)) == word(p, ir.HSymbols, int(fsym)-1, 3)
	}
	if k == HORecordLit {
		if o.n < 1 || !slot(b, arg(p, o, 0)) {
			return false
		}
		let rec = unwrapNamedRecord(p, slotType(p, b, arg(p, o, 0)))
		if rec == 0 {
			return false
		}
		let lo = word(p, ir.HTypes, int(rec)-1, 2)
		let nf = word(p, ir.HTypes, int(rec)-1, 3)
		if o.n-1 != nf {
			return false
		}
		for j in 0..int(nf) {
			let fsym = operand(p, lo, uint32(j))
			if !matchesSlot(p, b, arg(p, o, uint32(j+1)), word(p, ir.HSymbols, int(fsym)-1, 3)) {
				return false
			}
		}
		return true
	}
	if k == HOIndex {
		if o.n != 3 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) || !slot(b, arg(p, o, 2)) {
			return false
		}
		let st = slotType(p, b, arg(p, o, 1))
		if typeKind(p, st) != ir.HTSlice {
			return false
		}
		let elem = operand(p, word(p, ir.HTypes, int(st)-1, 2), 0)
		return matchesSlot(p, b, arg(p, o, 0), elem) && isIntBasic(p, slotType(p, b, arg(p, o, 2)))
	}
	if k == HOSliceLit {
		if o.n < 1 || !slot(b, arg(p, o, 0)) {
			return false
		}
		let st = slotType(p, b, arg(p, o, 0))
		if typeKind(p, st) != ir.HTSlice {
			return false
		}
		let elem = operand(p, word(p, ir.HTypes, int(st)-1, 2), 0)
		for j in 1..int(o.n) {
			if !matchesSlot(p, b, arg(p, o, uint32(j)), elem) {
				return false
			}
		}
		return true
	}
	if k == ir.HOGetGlobal || k == ir.HOSetGlobal {
		if o.n != 2 { return false }
		let load = o.k == ir.HOGetGlobal
		let sym = arg(p, o, if load { 1 } else { 0 })
		let s = arg(p, o, if load { 0 } else { 1 })
		return symKind(p, sym, ir.HSVar) && matchesSlot(p, b, s, word(p, ir.HSymbols, int(sym)-1, 3))
	}
	if k == ir.HOCall || k == ir.HOCallClosure || k == ir.HOCallInstance {
		return call(p, b, o)
	}
	if k == ir.HOJump {
		return o.n == 1 && arg(p, o, 0) > 0 && arg(p, o, 0) <= b.nops
	}
	if k == HOAlloc {
		return o.n == 1 && slot(b, arg(p, o, 0)) && typeKind(p, slotType(p, b, arg(p, o, 0))) == ir.HTPointer
	}
	if k == HOMakeClosure {
		if o.n != 2 && o.n != 3 {
			return false
		}
		let dst = arg(p, o, 0)
		let fnSym = arg(p, o, 1)
		if !slot(b, dst) || !symKind(p, fnSym, ir.HSFunc) || word(p, ir.HSymbols, int(fnSym)-1, 0) != 0 {
			return false
		}
		let dt = slotType(p, b, dst)
		let dSig = signature(p, dt)
		let fSig = signature(p, word(p, ir.HSymbols, int(fnSym)-1, 3))
		if typeKind(p, dt) != ir.HTSignature || dSig == 0 || dSig != fSig {
			return false
		}
		if o.n == 2 {
			return true
		}
		let envSlot = arg(p, o, 2)
		if !slot(b, envSlot) {
			return false
		}
		return hasUintptrHead(p, unwrapStructPtr(p, slotType(p, b, envSlot)))
	}
	if k == HOClosureEnv {
		if o.n != 1 || !slot(b, arg(p, o, 0)) {
			return false
		}
		return hasUintptrHead(p, unwrapStructPtr(p, slotType(p, b, arg(p, o, 0))))
	}
	if k == HOAppend {
		if o.n != 3 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) || !slot(b, arg(p, o, 2)) {
			return false
		}
		let st = slotType(p, b, arg(p, o, 1))
		if typeKind(p, st) != ir.HTSlice || slotType(p, b, arg(p, o, 0)) != st {
			return false
		}
		let elem = operand(p, word(p, ir.HTypes, int(st)-1, 2), 0)
		return matchesSlot(p, b, arg(p, o, 2), elem)
	}
	if k == HOSlice {
		if o.n != 4 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) || !slot(b, arg(p, o, 2)) || !slot(b, arg(p, o, 3)) {
			return false
		}
		let st = slotType(p, b, arg(p, o, 1))
		if slotType(p, b, arg(p, o, 0)) != st || (typeKind(p, st) != ir.HTSlice && !isStringBasic(p, st)) {
			return false
		}
		return isIntBasic(p, slotType(p, b, arg(p, o, 2))) && isIntBasic(p, slotType(p, b, arg(p, o, 3)))
	}
	if k == HOStringIndex {
		if o.n != 3 || !slot(b, arg(p, o, 0)) || !slot(b, arg(p, o, 1)) || !slot(b, arg(p, o, 2)) {
			return false
		}
		return isUint8Basic(p, slotType(p, b, arg(p, o, 0))) && isStringBasic(p, slotType(p, b, arg(p, o, 1))) && isIntBasic(p, slotType(p, b, arg(p, o, 2)))
	}
	if k == HOMakeIface {
		return o.n == 2 && slot(b, arg(p, o, 0)) && slot(b, arg(p, o, 1)) && isIfaceOrAny(p, slotType(p, b, arg(p, o, 0)))
	}
	if k == HOIfaceIs {
		return o.n == 3 && slot(b, arg(p, o, 0)) && slot(b, arg(p, o, 1)) && isBoolBasic(p, slotType(p, b, arg(p, o, 0))) &&
			isIfaceOrAny(p, slotType(p, b, arg(p, o, 1))) && ref(p, ir.HTypes, arg(p, o, 2))
	}
	if k == HOIfaceData {
		return o.n == 2 && slot(b, arg(p, o, 0)) && slot(b, arg(p, o, 1)) && isIfaceOrAny(p, slotType(p, b, arg(p, o, 1)))
	}
	if k == HOCallIface {
		return callIfaceValid(p, b, o)
	}
	if k == ir.HOBranch {
		if o.n != 5 || arg(p, o, 0) < ir.HCLess || arg(p, o, 0) > ir.HCAtLeast ||
			!slot(b, arg(p, o, 1)) || !matchesSlot(p, b, arg(p, o, 2), slotType(p, b, arg(p, o, 1))) ||
			arg(p, o, 3) == 0 || arg(p, o, 3) > b.nops || arg(p, o, 4) == 0 || arg(p, o, 4) > b.nops {
			return false
		}
		let c = arg(p, o, 0)
		let t = slotType(p, b, arg(p, o, 1))
		if isIntBasic(p, t) || isStringBasic(p, t) {
			return true
		}
		if isIfaceOrAny(p, t) || typeKind(p, t) == ir.HTSignature {
			return c == ir.HCEqual || c == ir.HCNotEqual
		}
		return (c == ir.HCEqual || c == ir.HCNotEqual) && (isBoolBasic(p, t) || typeKind(p, t) == ir.HTPointer)
	}
	let (nparam, nresult) = signatureSize(p, b.sig)
	if k != ir.HOReturn || o.n != nresult { return false }
	for i in 0..int(nresult) {
		let j = uint32(i)
		if !matchesSlot(p, b, arg(p, o, j), signatureType(p, b.sig, nparam+j)) {
			return false
		}
	}
	true
}

func facts(p Image, b body, first int) int fails Malformed {
	let mut i = first
	let mut last = uint32(0)
	let mut kind = uint32(0)
	for i < Rows(p, ir.HFacts) {
		let x = word(p, ir.HFacts, i, 0)
		let k = word(p, ir.HFacts, i, 1)
		if x > b.ops+b.nops {
			return i
		}
		let proof = word(p, ir.HFacts, i, 4)
		if x <= b.ops || x < last || (x == last && k <= kind) || k != ir.HFBounds ||
			!slot(b, word(p, ir.HFacts, i, 2)) || !slot(b, word(p, ir.HFacts, i, 3)) || proof <= b.ops || proof >= x {
			return bad(ir.HFacts, i, "fact identity, scope, or proof reference")
		}
		last = x
		kind = k
		i = i + 1
	}
	i
}

func bodies(p Image, start uint32) uint32 fails Malformed {
	let mut sl = uint32(0)
	let mut row = uint32(0)
	let mut w = start
	let mut bi = 0
	let mut f = 0
	for si in 0..Rows(p, ir.HSymbols) {
		if word(p, ir.HSymbols, si, 0) != 0 || word(p, ir.HSymbols, si, 2) != ir.HSFunc {
			continue
		}
		if bi >= Rows(p, ir.HBodies) || word(p, ir.HBodies, bi, 0) != uint32(si+1) {
			return bad(ir.HBodies, bi, "each local function must own exactly one body")
		}
		let sig = signature(p, word(p, ir.HSymbols, si, 3))
		let b = body{sig: sig, slots: word(p, ir.HBodies, bi, 1), nslots: word(p, ir.HBodies, bi, 2),
			ops: word(p, ir.HBodies, bi, 3), nops: word(p, ir.HBodies, bi, 4)}
		if b.sig == 0 || b.nops == 0 || !run(p, ir.HSlots, sl, b.slots, b.nslots) || !run(p, ir.HOps, row, b.ops, b.nops) {
			return bad(ir.HBodies, bi, "function signature or body run")
		}
		let (nparam, _) = signatureSize(p, sig)
		if nparam > b.nslots {
			return bad(ir.HBodies, bi, "missing parameter slots")
		}
		for j in 0..int(b.nslots) {
			let t = slotType(p, b, uint32(j)+1)
			if !ref(p, ir.HTypes, t) || (uint32(j) < nparam && t != signatureType(p, sig, uint32(j))) {
				return bad(ir.HSlots, int(sl)+j, "slot type")
			}
		}
		for j in int(row)..int(row+b.nops) {
			let o = op{k: word(p, ir.HOps, j, 0), lo: word(p, ir.HOps, j, 2), n: word(p, ir.HOps, j, 3)}
			if !ref(p, ir.HSpans, word(p, ir.HOps, j, 1)) || !run(p, ir.HOperands, w, o.lo, o.n) || !opValid(p, b, o) || (o.k == HOClosureEnv && j != int(row)) {
				return bad(ir.HOps, j, "opcode, span or operands")
			}
			w = o.lo + o.n
		}
		f = try facts(p, b, f)
		sl = sl + b.nslots
		row = row + b.nops
		bi = bi + 1
	}
	if bi != Rows(p, ir.HBodies) || f != Rows(p, ir.HFacts) || sl != uint32(Rows(p, ir.HSlots)) || row != uint32(Rows(p, ir.HOps)) {
		return bad(ir.HBodies, -1, "unowned body, slot, op or fact")
	}
	w
}
