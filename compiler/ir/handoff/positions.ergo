import compiler/ir
import dense
import option

// Position resolves a span to its .ergo path, half-open byte range, and
// one-based line and byte column. The line table needs no source reread.
type Position { Path string, Start uint32, End uint32, Line int, Column uint32 }

func PositionOf(p Image, span uint32) option.Option[Position] {
	if !ref(p, ir.HSpans, span) {
		return option.None
	}
	let i = int(span) - 1
	let start = word(p, ir.HSpans, i, 1)
	let file = int(word(p, ir.HSpans, i, 0)) - 1
	let base = int(word(p, ir.HFiles, file, 2))
	let mut left = base
	let mut right = base + int(word(p, ir.HFiles, file, 3))
	for left+1 < right {
		let middle = left + (right-left)/2
		if word(p, ir.HLines, middle, 0) <= start {
			left = middle
		} else {
			right = middle
		}
	}
	option.Some[Position]{Value: Position{Path: name(p, ir.HFiles, file, 0), Start: start, End: word(p, ir.HSpans, i, 2),
		Line: left - base + 1, Column: start - word(p, ir.HLines, left, 0) + 1}}
}

// SpanAt is the typed projection for the compiler's own span table.
func SpanAt(p Image, span ir.HandoffRef[ir.HandoffSpan]) option.Option[Position] { PositionOf(p, ir.HandoffWord(span)) }

law PositionsKeepSourceBytes(seed uint32) {
	let p = sample(seed) catch {
	case Malformed:
		return false
	}
	let mut c = dense.NewCount[ir.HandoffSpan]()
	let _ = c.Next()
	let second = ir.HandoffID(c.Next())
		SpanAt(p, second) == option.Some[Position]{Value: Position{Path: "main.ergo", Start: 40, End: 43, Line: 2, Column: 11}} &&
		PositionOf(p, 3) == option.None
}
