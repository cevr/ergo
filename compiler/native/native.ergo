	let lb0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(7), []uint32{0})
	let fVal = try ir.Row(&b, ir.KindCode(ir.TExpr, "field"), samplePos(7), []uint32{lb0, ir.Text(&b, "Val")})
	let rBox = try ir.Row(&b, ir.KindCode(ir.TStmt, "ret"), samplePos(7), []uint32{fVal})
	try ir.End(&b, ir.List(&b, []uint32{rBox}))

	try ir.Begin(&b, "(*MyErr).Error", samplePos(10), samplePos(12))
	try ir.AddLocal(&b, "e", "*MyErr", samplePos(10))
	let le0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(11), []uint32{0})
	let fMsg = try ir.Row(&b, ir.KindCode(ir.TExpr, "field"), samplePos(11), []uint32{le0, ir.Text(&b, "Msg")})
	let rErr = try ir.Row(&b, ir.KindCode(ir.TStmt, "ret"), samplePos(11), []uint32{fMsg})
	try ir.End(&b, ir.List(&b, []uint32{rErr}))

	try ir.Begin(&b, "tryWork", samplePos(14), samplePos(40))
