	let dep = nativeobj.SampleDep()
	let mut b = ir.NewBuilder(2)
	let _ = ir.FileOf(&b, "exec.ergo")

	try ir.Begin(&b, "init.0", samplePos(1), samplePos(4))
	let gLabel = try ir.Row(&b, ir.KindCode(ir.TExpr, "global"), samplePos(2), []uint32{ir.Text(&b, "bootMsg")})
	let cReady = try ir.Row(&b, ir.KindCode(ir.TExpr, "const"), samplePos(2), []uint32{ir.Text(&b, "string"), ir.Text(&b, "ready"), 0})
	let stGlob = try ir.Row(&b, ir.KindCode(ir.TStmt, "store"), samplePos(2), []uint32{gLabel, 0, cReady})
	try ir.End(&b, ir.List(&b, []uint32{stGlob}))

	try ir.Begin(&b, "(*Box).Get", samplePos(6), samplePos(8))
