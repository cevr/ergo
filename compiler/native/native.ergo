	let boxLit = try ir.Row(&b, ir.KindCode(ir.TExpr, "lit"), samplePos(20), []uint32{ir.Text(&b, "Box"), ir.List(&b, []uint32{lresB}), ir.List(&b, []uint32{ir.Text(&b, "Val")})})
	let defBx = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(20), []uint32{8, boxLit})
