	let lxC = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(16), []uint32{4})
	let lBiasC = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(16), []uint32{1})
	let addC = try ir.Row(&b, ir.KindCode(ir.TExpr, "bin"), samplePos(16), []uint32{ir.Text(&b, "+"), lxC, lBiasC})
	let retC = try ir.Row(&b, ir.KindCode(ir.TStmt, "ret"), samplePos(16), []uint32{addC})
	let cloExpr = try ir.Row(&b, ir.KindCode(ir.TExpr, "func"), samplePos(16), []uint32{ir.Text(&b, "func(int) int"), ir.List(&b, []uint32{4}), ir.List(&b, []uint32{retC}), 0})
	let defFn = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(16), []uint32{3, cloExpr})

	let ln0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(17), []uint32{0})
	let lfn = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(17), []uint32{3})
	let vc = try ir.Row(&b, ir.KindCode(ir.TExpr, "vcall"), samplePos(17), []uint32{lfn, ir.List(&b, []uint32{ln0})})
	let defRes = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(17), []uint32{5, vc})

	let ckVal = try ir.Row(&b, ir.KindCode(ir.TExpr, "const"), samplePos(18), []uint32{ir.Text(&b, "int"), ir.Text(&b, strconv.Itoa(k)), 0})
	let slInit = try ir.Row(&b, ir.KindCode(ir.TExpr, "lit"), samplePos(18), []uint32{ir.Text(&b, "[]int"), ir.List(&b, []uint32{ckVal}), 0})
