	let defSub = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(21), []uint32{9, strSub})
	let lsub0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(22), []uint32{9})
	let strIdx = try ir.Row(&b, ir.KindCode(ir.TExpr, "index"), samplePos(22), []uint32{lsub0, c0})
	let defCh = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(22), []uint32{10, strIdx})

	let lch0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(23), []uint32{10})
	let chInt = try ir.Row(&b, ir.KindCode(ir.TExpr, "conv"), samplePos(23), []uint32{ir.Text(&b, "int"), lch0})
	let toAny = try ir.Row(&b, ir.KindCode(ir.TExpr, "toiface"), samplePos(23), []uint32{ir.Text(&b, "any"), chInt})
	let defAny = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(23), []uint32{11, toAny})
	let lany0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(24), []uint32{11})
	let asrt = try ir.Row(&b, ir.KindCode(ir.TExpr, "assert"), samplePos(24), []uint32{ir.Text(&b, "int"), lany0})
	let defAsrt = try ir.Row(&b, ir.KindCode(ir.TStmt, "def2"), samplePos(24), []uint32{12, 14, asrt})

	let lctr0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(26), []uint32{7})
	let ifaceCall = try ir.Row(&b, ir.KindCode(ir.TExpr, "mcall"), samplePos(26), []uint32{lctr0, ir.Text(&b, "Get"), 0})
	let lxs0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(26), []uint32{6})
	let xsAt0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "index"), samplePos(26), []uint32{lxs0, c0})
	let lex0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(26), []uint32{12})
	let sum1 = try ir.Row(&b, ir.KindCode(ir.TExpr, "bin"), samplePos(26), []uint32{ir.Text(&b, "+"), ifaceCall, xsAt0})
	let sum2 = try ir.Row(&b, ir.KindCode(ir.TExpr, "bin"), samplePos(26), []uint32{ir.Text(&b, "+"), sum1, lex0})

	let ln1 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(28), []uint32{0})
	let condFail = try ir.Row(&b, ir.KindCode(ir.TExpr, "bin"), samplePos(28), []uint32{ir.Text(&b, "<"), ln1, c0})
	let msgStr = try ir.Row(&b, ir.KindCode(ir.TExpr, "const"), samplePos(29), []uint32{ir.Text(&b, "string"), ir.Text(&b, "neg"), 0})
	let errLit = try ir.Row(&b, ir.KindCode(ir.TExpr, "lit"), samplePos(29), []uint32{ir.Text(&b, "MyErr"), ir.List(&b, []uint32{msgStr}), ir.List(&b, []uint32{ir.Text(&b, "Msg")})})
	let defErrLit = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(29), []uint32{14, try ir.Row(&b, ir.KindCode(ir.TExpr, "addr"), samplePos(29), []uint32{errLit})})
	let failStmt = try ir.Row(&b, ir.KindCode(ir.TStmt, "fail"), samplePos(30), []uint32{try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(30), []uint32{14})})
	let ifFail = try ir.Row(&b, ir.KindCode(ir.TStmt, "if"), samplePos(28), []uint32{condFail, ir.List(&b, []uint32{defErrLit, failStmt}), 0, ir.PosAt(&b, samplePos(31)), 0, 0})

	let retOk = try ir.Row(&b, ir.KindCode(ir.TStmt, "ret"), samplePos(33), []uint32{sum2})
	try ir.End(&b, ir.List(&b, []uint32{defFn, defRes, defXs, defBx, defCtr, defSub, defCh, defAny, defAsrt, ifFail, retOk}))

	try ir.Begin(&b, "main", samplePos(42), samplePos(55))
	try ir.AddLocal(&b, "v", "int", samplePos(43))
	try ir.AddLocal(&b, "e", "error", samplePos(43))
	let c5 = try ir.Row(&b, ir.KindCode(ir.TExpr, "const"), samplePos(43), []uint32{ir.Text(&b, "int"), ir.Text(&b, "5"), 0})
	let c2 = try ir.Row(&b, ir.KindCode(ir.TExpr, "const"), samplePos(43), []uint32{ir.Text(&b, "int"), ir.Text(&b, "2"), 0})
	let gBoot = try ir.Row(&b, ir.KindCode(ir.TExpr, "global"), samplePos(43), []uint32{ir.Text(&b, "bootMsg")})
	let callTry = try ir.Row(&b, ir.KindCode(ir.TExpr, "call"), samplePos(43), []uint32{0, ir.Text(&b, "tryWork"), ir.List(&b, []uint32{c5, c2, gBoot})})
	let defTry = try ir.Row(&b, ir.KindCode(ir.TStmt, "def2"), samplePos(43), []uint32{0, 2, callTry})
	let lv0 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(44), []uint32{0})
	let callItoa = try ir.Row(&b, ir.KindCode(ir.TExpr, "pcall"), samplePos(44), []uint32{ir.Text(&b, "strconv"), 0, 0, ir.Text(&b, "Itoa"), ir.List(&b, []uint32{lv0})})
	let itoaStmt = try ir.Row(&b, ir.KindCode(ir.TStmt, "discard"), samplePos(44), []uint32{callItoa})
	let le1 = try ir.Row(&b, ir.KindCode(ir.TExpr, "local"), samplePos(44), []uint32{1})
	let nilE = try ir.Row(&b, ir.KindCode(ir.TExpr, "nil"), samplePos(44), []uint32{ir.Text(&b, "error")})
	let errNeNil = try ir.Row(&b, ir.KindCode(ir.TExpr, "bin"), samplePos(44), []uint32{ir.Text(&b, "!="), le1, nilE})
	let callExit = try ir.Row(&b, ir.KindCode(ir.TExpr, "pcall"), samplePos(45), []uint32{ir.Text(&b, "os"), 0, 0, ir.Text(&b, "Exit"), ir.List(&b, []uint32{c2})})
	let exitStmt = try ir.Row(&b, ir.KindCode(ir.TStmt, "expr"), samplePos(45), []uint32{callExit})
	let ifErr = try ir.Row(&b, ir.KindCode(ir.TStmt, "if"), samplePos(44), []uint32{errNeNil, ir.List(&b, []uint32{exitStmt}), 0, ir.PosAt(&b, samplePos(46)), 0, 0})
	let retMain = try ir.Row(&b, ir.KindCode(ir.TStmt, "ret"), samplePos(47), []uint32{0})
	try ir.End(&b, ir.List(&b, []uint32{defTry, itoaStmt, ifErr, retMain}))

	Unit{
		Path: "main",
		Name: "main",
		File: "exec.ergo",
		IR:   try ir.Finish(b),
		Sigs: []Sig{
			Sig{Params: []string{}, Results: []string{}},
			Sig{Params: []string{"*Box"}, Results: []string{"int"}},
			Sig{Params: []string{"*MyErr"}, Results: []string{"string"}},
			Sig{Params: []string{"int", "int", "string"}, Results: []string{"int", "error"}},
			Sig{Params: []string{}, Results: []string{}},
		},
		Records: []RecordDecl{
			RecordDecl{Name: "Box", PkgPath: "", Exported: true, Fields: []FieldDecl{FieldDecl{Name: "Val", Type: "int", Exported: true}}},
			RecordDecl{Name: "MyErr", PkgPath: "", Exported: true, Fields: []FieldDecl{FieldDecl{Name: "Msg", Type: "string", Exported: true}}},
		},
		Interfaces: []IfaceDecl{
			IfaceDecl{Name: "Counter", PkgPath: "", Exported: true, Methods: []MethodDecl{MethodDecl{Name: "Get", Sig: Sig{Params: []string{}, Results: []string{"int"}}, Exported: true}}},
		},
		Globals: []GlobalDecl{
			GlobalDecl{Name: "bootMsg", PkgPath: "", Type: "string"},
		},
		Inits:   []string{"init.0"},
		Imports: []ImportUnit{
			ImportUnit{
				Path:        "strconv",
				Name:        "strconv",
				Fingerprint: dep.Fingerprint,
				HasInit:     false,
				Records:     []RecordDecl{},
				Interfaces:  []IfaceDecl{},
				Globals:     []GlobalDecl{},
				Funcs:       []ImportFunc{ImportFunc{Name: "Itoa", Sig: Sig{Params: []string{"int"}, Results: []string{"string"}}}},
			},
			ImportUnit{
				Path:        "os",
				Name:        "os",
				Fingerprint: dep.Fingerprint,
				HasInit:     true,
				Records:     []RecordDecl{},
				Interfaces:  []IfaceDecl{},
				Globals:     []GlobalDecl{},
				Funcs:       []ImportFunc{ImportFunc{Name: "Exit", Sig: Sig{Params: []string{"int"}, Results: []string{}}}},
			},
		},
	}
}

// ExecRoundTrips verifies standalone main/init IR packages with closures,
// failures, append/slice/string-index, interfaces, and globals compile through EIR v1 cleanly.
law ExecRoundTrips(k int) {
	let s = ((k % 1000) + 1000) % 1000
	let u = execUnit(s) catch {
	case ir.Malformed:
		return false
	}
	let p = FromIR(u) catch {
	case nativeobj.Refused, nativeobj.Malformed:
		return false
	}
	let decoded = roundTripHandoff(u) catch {
	case handoff.Malformed, handoff.UnknownVersion, handoff.WrongTarget, handoff.StaleImport, nativeobj.Refused, nativeobj.Malformed:
		return false
	}
	let built = Archive(u, nativeobj.SampleHeader) catch {
	case nativeobj.Refused, nativeobj.Malformed, handoff.Malformed, handoff.UnknownVersion, handoff.WrongTarget, handoff.StaleImport, nativeobj.Undefined:
		return false
	}
	p.Inits.Len() == 1 && decoded.Inits.Len() == 1 && nativeobj.Verify(p, nativeobj.SampleHeader, built.Archive).Len() == 0
}
