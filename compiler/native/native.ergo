	let boxToCtr = try ir.Row(&b, ir.KindCode(ir.TExpr, "toiface"), samplePos(20), []uint32{ir.Text(&b, "Counter"), lbxPtr})
	let defCtr = try ir.Row(&b, ir.KindCode(ir.TStmt, "def"), samplePos(20), []uint32{7, boxToCtr})

