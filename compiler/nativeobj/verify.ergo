import option
import slices
import strings

// Metadata verification checks over independent binary decoders for nativeobj archives.

// FuncView is one function as decoded from _go_.o.
type FuncView {
	Name     string,
	Code     string,
	Ins      []Ins,
	Relocs   []DReloc,
	Args     int,
	File     int,
	Line     int,
	ArgMaps  [][]bool,
	ArgBits  int,
	Locals   [][]bool,
	LocBits  int,
	Sp       []PcVal,
	Pcfile   []PcVal,
	Unsafe   []PcVal,
	Smi      []PcVal,
	NPcdata  int,
	NFuncdat int,
}

func readMaps(data string) (int, [][]bool) fails Bad {
	let n = try le(data, 0, 4)
	let nbit = try le(data, 4, 4)
	let per = (nbit + 7) / 8
	if data.Len() != 8+n*per {
		return Bad{Why: "a stack map of \(data.Len()) bytes for \(n) maps of \(nbit) bits"}
	}
	let mut maps = [][]bool{}
	for m in 0..n {
		let mut bits = []bool{}
		for b in 0..nbit {
			let x = int(data[8+m*per+b/8])
			bits = bits.Append((x>>(b%8))&1 == 1)
		}
		maps = maps.Append(bits)
	}
	(nbit, maps)
}

func table(data string) []PcVal fails Bad {
	DecodeTable(data) catch {
	case Short as s:
		return short(s)
	}
}

// ViewOf reads definition j of d's object as a function.
func ViewOf(d Decoded, j int) FuncView fails Bad {
	let o = d.Obj
	let mut fds = []string{}
	let mut pcd = []string{}
	let mut info = ""
	let mut sp = ""
	let mut pcfile = ""
	for a in o.Aux[j] {
		if a.Def < 0 || a.Def >= o.Data.Len() {
			return Bad{Why: "\(o.Defs[j].Name): aux names definition \(a.Def)"}
		}
		let data = o.Data[a.Def]
		if a.Type == AuxFuncInfo {
			info = data
		} else if a.Type == AuxFuncdata {
			fds = fds.Append(data)
		} else if a.Type == AuxPcdata {
			pcd = pcd.Append(data)
		} else if a.Type == AuxPcsp {
			sp = data
		} else if a.Type == AuxPcfile {
			pcfile = data
		}
	}
	if info == "" || fds.Len() != 2 || pcd.Len() != 2 || sp == "" {
		return Bad{Why: "\(o.Defs[j].Name): FuncInfo, both stack maps, pcsp and both pcdata tables are not all there"}
	}
	let (abits, amaps) = try readMaps(fds[FuncdataArgsPointerMaps])
	let (lbits, lmaps) = try readMaps(fds[FuncdataLocalsPointerMaps])
	let fileIdx = if info.Len() >= 24 { try le(info, 20, 4) } else { 0 }
	FuncView{Name: o.Defs[j].Name, Code: o.Data[j], Ins: try Disasm(o.Data[j]), Relocs: o.Relocs[j], Args: try le(info, 0, 4), File: fileIdx,
		Line:    try le(info, 12, 4), ArgMaps: amaps, ArgBits: abits, Locals: lmaps, LocBits: lbits, Sp: try table(sp),
		Pcfile:  try table(pcfile), Unsafe: try table(pcd[PcdataUnsafePoint]), Smi: try table(pcd[PcdataStackMapIndex]),
		NPcdata: pcd.Len(), NFuncdat: fds.Len()}
}

func symOf(p Package, i int) string { FuncSym(p, i) }

func defNamed(o DObj, name string) int {
	for j, s in o.Defs {
		if s.Name == name {
			return j
		}
	}
	-1
}

func relocAt(rs []DReloc, off int) option.Option[DReloc] {
	for r in rs {
		if r.Off == off {
			return option.Some{r}
		}
	}
	option.None
}

func frameOf(v FuncView) int {
	let mut m = 0
	for pv in v.Sp {
		if pv.V > m {
			m = pv.V
		}
	}
	m
}

func slotDisp(size int, j int) int { size - 8 - 8*(j+1) }

func isMov(ins Ins, op int, reg int, base int, disp int) bool {
	ins.Op == op && ins.Mem && !ins.Rip && ins.R == reg && ins.B == base && ins.Disp == disp
}

func isStoreW(ins Ins, reg int, base int, disp int, w int) bool {
	let wantOp = if w == 1 { 0x88 } else { 0x89 }
	ins.Op == wantOp && ins.Mem && !ins.Rip && ins.R == reg && ins.B == base && ins.Disp == disp && ins.Width == w
}

func isLoadW(ins Ins, reg int, base int, disp int, w int, signed bool) bool {
	let wantOp = if w == 8 { 0x8B } else if w == 4 { if signed { 0x63 } else { 0x8B } } else if w == 2 { if signed { 0x0FBF } else { 0x0FB7 } } else { if signed { 0x0FBE } else { 0x0FB6 } }
	ins.Op == wantOp && ins.Mem && !ins.Rip && ins.R == reg && ins.B == base && ins.Disp == disp && ins.Width == w
}

func isRuntimeSafeCall(target string) bool {
	target == RuntimeMakeslice || target == RuntimeConcatstring2 || target == RuntimeCmpstring || target == RuntimeMemequal || target == RuntimeNewobject || target == RuntimeGrowslice
}

func isColdPanic(target string) bool {
		target == RuntimePanicIndex || target == RuntimePanicIndexU || target == RuntimePanicDivide ||
		target == RuntimePanicSliceAlen || target == RuntimePanicSliceAlenU ||
		target == RuntimePanicSliceAcap || target == RuntimePanicSliceAcapU ||
		target == RuntimePanicSliceB || target == RuntimePanicSliceBU
}

func goCall(v FuncView, ins Ins) bool {
	if ins.Op == 0xFF && ins.R == 2 {
		return true
	}
	if ins.Op != 0xE8 {
		return false
	}
	match relocAt(v.Relocs, ins.Pc+1) {
	case option.Some as r:
		return !strings.HasPrefix(r.Value.Target, "runtime.") || isRuntimeSafeCall(r.Value.Target)
	case option.None:
		return true
	}
}

func callTo(v FuncView, ins Ins, target string) bool {
	if ins.Op != 0xE8 {
		return false
	}
	match relocAt(v.Relocs, ins.Pc+1) {
	case option.Some as r:
		return r.Value.Target == target
	case option.None:
		return false
	}
}

func safeCallOps(p Package, f Func) []int {
	let mut out = []int{}
	for i, op in f.Ops {
		if IsCallOp(p, f, op) {
			out = out.Append(i)
		}
	}
	out
}

func coldOpsCount(f Func) int {
	let mut n = 0
	for op in f.Ops {
		match op {
		case Index, StringIndex:
			n = n + 1
		case SliceOp:
			n = n + 2
		case Arith as a:
			if a.Kind == ADiv || a.Kind == ARem {
				n = n + 1
			}
		case _:
		}
	}
	n
}

func copyChunkCount(size int) int {
	let mut n = 0
	let mut off = 0
	for off+8 <= size {
		n = n + 1
		off = off + 8
	}
	for off+4 <= size {
		n = n + 1
		off = off + 4
	}
	for off+2 <= size {
		n = n + 1
		off = off + 2
	}
	for off < size {
		n = n + 1
		off = off + 1
	}
	n
}

func funcViews(p Package, d Decoded) []FuncView fails Bad {
	let mut out = []FuncView{}
	for i in 0..p.Funcs.Len() {
		let j = defNamed(d.Obj, symOf(p, i))
		if j < 0 {
			return Bad{Why: "no definition \(symOf(p, i))"}
		}
		if d.Obj.Defs[j].Kind != SText || d.Obj.Defs[j].ABI != ABIInternal {
			return Bad{Why: "\(symOf(p, i)) is not an ABIInternal text symbol"}
		}
		out = out.Append(try ViewOf(d, j))
	}
	out
}

// CheckMembers: the archive is __.PKGDEF then _go_.o, each opening with
// the stock header line, and the object records p's source file list.
func CheckMembers(pFiles []string, d Decoded, header string) []string {
	let mut out = []string{}
	if d.Members != []string{"__.PKGDEF", "_go_.o"} {
		out = out.Append("members are not __.PKGDEF then _go_.o")
	}
	if d.PkgHeader != header || d.ObjHeader != header {
		out = out.Append("a member header is not the stock header line")
	}
	if d.Obj.Files != pFiles {
		out = out.Append("object files do not match package files")
	}
	out
}

// CheckFingerprints checks SHA-256 export digest and autolib metadata.
func CheckFingerprints(p Package, d Decoded) []string {
	let mut out = []string{}
	if d.Export.Version != ExportVersion {
		out = out.Append("export data version \(d.Export.Version)")
	}
	if d.Export.Fingerprint != d.Export.Digest {
		out = out.Append("export fingerprint is not the digest of the export data")
	}
	if d.Obj.Fingerprint != d.Export.Fingerprint {
		out = out.Append("object fingerprint differs from the export data's")
	}
	if d.Export.Path != p.Path {
		out = out.Append("export data names package \(d.Export.Path)")
	}
	if d.Obj.Autolib.Len() != p.Imports.Len() {
		out = out.Append("object lists \(d.Obj.Autolib.Len()) imports of \(p.Imports.Len())")
	} else {
		for k, imp in p.Imports {
			if d.Obj.Autolib[k].Path != imp.Path || d.Obj.Autolib[k].Fingerprint != imp.Fingerprint {
				out = out.Append("import \(imp.Path) recorded with another path or fingerprint")
			}
		}
	}
	out
}

func hasNameDot(s string) bool {
	for i in 0..s.Len() {
		if s[i] == byte('.') {
			return true
		}
	}
	false
}

// CheckExports verifies exported functions, exported named types, and ABIInternal code alignment.
func CheckExports(p Package, d Decoded) []string {
	let mut out = []string{}
	let mut n = 0
	for i, f in p.Funcs {
		if hasNameDot(f.Name) || !Exported(f.Name) {
			continue
		}
		n = n + 1
		let mut found = false
		for o in d.Export.Objs {
			if o.Name == f.Name && o.Code == ObjFunc {
				found = true
				if !o.HasExt || o.ABI != ABIInternal {
					out = out.Append("\(f.Name): exported without an ABIInternal function extension")
				} else if o.SymIdx < 0 || o.SymIdx >= d.Obj.Defs.Len() || d.Obj.Defs[o.SymIdx].Name != symOf(p, i) {
					out = out.Append("\(f.Name): export index \(o.SymIdx) does not name \(symOf(p, i))")
				}
			}
		}
		if !found {
			out = out.Append("\(f.Name): not exported")
		}
	}
	for td in p.Types {
		if (td.Kind != KStruct && td.Kind != KIface) || td.Name == "" || (td.PkgPath != "" && td.PkgPath != p.Path) || !td.Exported {
			continue
		}
		n = n + 1
		let mut found = false
		let wantT = "type:" + p.Path + "." + td.Name
		let wantP = "type:*" + p.Path + "." + td.Name
		for o in d.Export.Objs {
			if o.Name == td.Name && o.Code == ObjType {
				found = true
				if !o.HasExt || o.SymIdx < 0 || o.SymIdx >= d.Obj.Defs.Len() || d.Obj.Defs[o.SymIdx].Name != wantT ||
					o.PtrSymIdx < 0 || o.PtrSymIdx >= d.Obj.Defs.Len() || d.Obj.Defs[o.PtrSymIdx].Name != wantP {
					out = out.Append("\(td.Name): exported type indices do not match \(wantT) / \(wantP)")
				}
			}
		}
		if !found {
			out = out.Append("\(td.Name): exported type missing")
		}
	}
	if d.Export.Objs.Len() != n {
		out = out.Append("export data holds \(d.Export.Objs.Len()) objects for \(n) exported declarations")
	}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return out.Append(b.Why)
	}
	let layouts = ComputeLayouts(p)
	for i, f in p.Funcs {
		out = out.Concat(abiOf(p, layouts, f, views[i]))
	}
	out
}

func abiOf(p Package, layouts LayoutTable, f Func, v FuncView) []string {
	let mut out = []string{}
	let size = frameOf(v)
	if size == 0 {
		return out
	}
	let plan = PlanSigABI(layouts, f.Params, f.Results, f.Slots)
	let fr = Frame{Size: size, Slots: plan.TotalSlotWords, Out: 0}
	let ins = v.Ins
	let mut at = -1
	for k, x in ins {
		if at < 0 && x.Op == 0x81 && x.R == 5 && x.B == RSP && !x.Mem {
			at = k + 1
		}
	}
	if at < 0 {
		return out.Append("\(f.Name): no frame set-up")
	}
	for k, pt in f.Params {
		if plan.ParamIsReg[k] {
			let dstOff = SlotBaseOff(fr, plan, k)
			let plo = int(layouts.PieceLo[pt])
			let phi = int(layouts.PieceHi[pt])
			let r0 = plan.ParamRegStart[k]
			for j in plo..phi {
				let pc = layouts.Pieces[j]
				if at >= ins.Len() || !isStoreW(ins[at], IntRegs[r0+(j-plo)], RSP, dstOff+int(pc.Off), int(pc.Size)) {
					out = out.Append("\(f.Name): parameter \(k) piece not stored from \(IntRegs[r0+(j-plo)])")
				}
				at = at + 1
			}
		}
	}
	for k, pt in f.Params {
		if !plan.ParamIsReg[k] {
			at = at + 2*copyChunkCount(int(layouts.Sizes[pt]))
		}
	}
	let calls = safeCallOps(p, f)
	let mut m = 0
	for q, x in ins {
		if goCall(v, x) {
			if m >= calls.Len() {
				return out.Append("\(f.Name): more calls in the code than in the input")
			}
			match f.Ops[calls[m]] {
			case Call as c:
				let ti = targetOfInPkg(p, c.Target)
				let (pts, rts) = if ti >= 0 { (p.Funcs[ti].Params, p.Funcs[ti].Results) } else { (slotTypes(f, c.Args), slotTypes(f, c.Dsts)) }
				out = out.Concat(checkCallSiteABI(f, layouts, fr, plan, ins, q, false, c.Args, c.Dsts, pts, rts, -1, m))
			case CallClosure as c:
				let ft = p.Types[f.Slots[c.Fn]]
				out = out.Concat(checkCallSiteABI(f, layouts, fr, plan, ins, q, true, c.Args, c.Dsts, ft.Params, ft.Results, c.Fn, m))
			case CallIface as ci:
				let it = p.Types[f.Slots[ci.Iface]]
				let mt = p.Types[it.Methods[ci.Method].Type]
				out = out.Concat(checkIfaceCallSiteABI(f, layouts, fr, plan, ins, q, ci.Iface, ci.Args, ci.Dsts, mt.Params, mt.Results, m))
			case _:
			}
			m = m + 1
		}
		if x.Op == 0xC3 {
			let mut vals = []int{}
			let mut seen = 0
			for op in f.Ops {
				match op {
				case Return as r:
					if seen == countRets(ins, q) {
						vals = r.Vals
					}
					seen = seen + 1
				case _:
				}
			}
			let mut pieceTotal = 0
			for k in 0..vals.Len() {
				if plan.ResultIsReg[k] {
					let rt = f.Results[k]
					pieceTotal = pieceTotal + int(layouts.PieceHi[rt]-layouts.PieceLo[rt])
				}
			}
			let mut cur = q - 2 - pieceTotal
			for k, s in vals {
				if plan.ResultIsReg[k] {
					let rt = f.Results[k]
					let rlo = int(layouts.PieceLo[rt])
					let rhi = int(layouts.PieceHi[rt])
					let r0 = plan.ResultRegStart[k]
					let srcOff = SlotBaseOff(fr, plan, s)
					for j in rlo..rhi {
						let pc = layouts.Pieces[j]
						if cur < 0 || !isLoadW(ins[cur], IntRegs[r0+(j-rlo)], RSP, srcOff+int(pc.Off), int(pc.Size), pc.Signed) {
							out = out.Append("\(f.Name): result \(k) not returned in \(IntRegs[r0+(j-rlo)])")
						}
						cur = cur + 1
					}
				}
			}
		}
		let hasEnv = FuncHasClosureEnv(f)
		if callTo(v, x, if hasEnv { RuntimeMorestack } else { MorestackNoctxt }) {
			for r in 0..plan.InRegCount {
				let before = q - plan.InRegCount + r
				if before < 0 || !isMov(ins[before], 0x89, IntRegs[r], RSP, 8+plan.StackEnd+8*r) || q+1+r >= ins.Len() || !isMov(ins[q+1+r], 0x8B, IntRegs[r], RSP, 8+plan.StackEnd+8*r) {
					out = out.Append("\(f.Name): reg arg \(r) not spilled and reloaded around morestack")
				}
			}
		}
	}
	if m != calls.Len() {
		out = out.Append("\(f.Name): \(m) calls in the code for \(calls.Len()) in the input")
	}
	out
}

func targetOfInPkg(p Package, name string) int {
	for i, f in p.Funcs {
		if f.Name != "init" && SymName(p, f.Name) == name {
			return i
		}
	}
	-1
}

func checkCallSiteABI(f Func, layouts LayoutTable, fr Frame, plan FuncAbiPlan, ins []Ins, q int, closure bool, args []int, dsts []int, pts []int, rts []int, closureSlot int, m int) []string {
	let mut out = []string{}
	let cp = PlanSigABI(layouts, pts, rts, []int{})
	let pre = if closure { 2 } else { 0 }
	if closure && (q < 2 || !isMov(ins[q-2], 0x8B, RDX, RSP, SlotBaseOff(fr, plan, closureSlot)) || !isMov(ins[q-1], 0x8B, R12, RDX, 0) || ins[q].B != R12) {
		out = out.Append("\(f.Name): closure call \(m) does not take its context in RDX and its code from 0(RDX)")
	}
	let mut argPieces = 0
	for k in 0..args.Len() {
		if cp.ParamIsReg[k] {
			argPieces = argPieces + int(layouts.PieceHi[pts[k]]-layouts.PieceLo[pts[k]])
		}
	}
	let mut cur = q - pre - argPieces
	for k, s in args {
		if cp.ParamIsReg[k] {
			let pt = pts[k]
			let plo = int(layouts.PieceLo[pt])
			let phi = int(layouts.PieceHi[pt])
			let r0 = cp.ParamRegStart[k]
			let srcOff = SlotBaseOff(fr, plan, s)
			for j in plo..phi {
				let pc = layouts.Pieces[j]
				if cur < 0 || !isLoadW(ins[cur], IntRegs[r0+(j-plo)], RSP, srcOff+int(pc.Off), int(pc.Size), pc.Signed) {
					out = out.Append("\(f.Name): call \(m) argument \(k) not loaded into \(IntRegs[r0+(j-plo)])")
				}
				cur = cur + 1
			}
		}
	}
	let mut rx = q + 1
	for k, d in dsts {
		if cp.ResultIsReg[k] {
			let rt = rts[k]
			let rlo = int(layouts.PieceLo[rt])
			let rhi = int(layouts.PieceHi[rt])
			let r0 = cp.ResultRegStart[k]
			let dstOff = SlotBaseOff(fr, plan, d)
			for j in rlo..rhi {
				let pc = layouts.Pieces[j]
				if rx >= ins.Len() || !isStoreW(ins[rx], IntRegs[r0+(j-rlo)], RSP, dstOff+int(pc.Off), int(pc.Size)) {
					out = out.Append("\(f.Name): call \(m) result \(k) not taken from \(IntRegs[r0+(j-rlo)])")
				}
				rx = rx + 1
			}
		}
	}
	out
}

func checkIfaceCallSiteABI(f Func, layouts LayoutTable, fr Frame, plan FuncAbiPlan, ins []Ins, q int, ifaceSlot int, args []int, dsts []int, pts []int, rts []int, m int) []string {
	let mut out = []string{}
	let cp = PlanIfaceMethodABI(layouts, pts, rts)
	if q < 1 || !isMov(ins[q-1], 0x8B, RAX, RSP, SlotBaseOff(fr, plan, ifaceSlot)+8) || ins[q].Op != 0xFF || ins[q].B != R12 {
		return out.Append("\(f.Name): iface call \(m) does not load receiver into RAX and call R12")
	}
	let mut argPieces = 0
	for k in 0..args.Len() {
		if cp.ParamIsReg[k] {
			argPieces = argPieces + int(layouts.PieceHi[pts[k]]-layouts.PieceLo[pts[k]])
		}
	}
	let mut cur = q - 1 - argPieces
	for k, s in args {
		if cp.ParamIsReg[k] {
			let pt = pts[k]
			let plo = int(layouts.PieceLo[pt])
			let phi = int(layouts.PieceHi[pt])
			let r0 = cp.ParamRegStart[k]
			let srcOff = SlotBaseOff(fr, plan, s)
			for j in plo..phi {
				let pc = layouts.Pieces[j]
				if cur < 0 || !isLoadW(ins[cur], IntRegs[r0+(j-plo)], RSP, srcOff+int(pc.Off), int(pc.Size), pc.Signed) {
					out = out.Append("\(f.Name): iface call \(m) argument \(k) not loaded into \(IntRegs[r0+(j-plo)])")
				}
				cur = cur + 1
			}
		}
	}
	let mut rx = q + 1
	for k, d in dsts {
		if cp.ResultIsReg[k] {
			let rt = rts[k]
			let rlo = int(layouts.PieceLo[rt])
			let rhi = int(layouts.PieceHi[rt])
			let r0 = cp.ResultRegStart[k]
			let dstOff = SlotBaseOff(fr, plan, d)
			for j in rlo..rhi {
				let pc = layouts.Pieces[j]
				if rx >= ins.Len() || !isStoreW(ins[rx], IntRegs[r0+(j-rlo)], RSP, dstOff+int(pc.Off), int(pc.Size)) {
					out = out.Append("\(f.Name): iface call \(m) result \(k) not taken from \(IntRegs[r0+(j-rlo)])")
				}
				rx = rx + 1
			}
		}
	}
	out
}

func countRets(ins []Ins, q int) int {
	let mut n = 0
	for k in 0..q {
		if ins[k].Op == 0xC3 {
			n = n + 1
		}
	}
	n
}

// CheckSafePoints verifies GC safe points, call stack-map indices, and unsafe spans.
func CheckSafePoints(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	for i, f in p.Funcs {
		let v = views[i]
		let calls = safeCallOps(p, f)
		let ncolds = coldOpsCount(f)
		let wantMaps = calls.Len() + 1 + ncolds
		if v.Locals.Len() != wantMaps || v.ArgMaps.Len() != wantMaps {
			out = out.Append("\(f.Name): \(v.Locals.Len()) locals and \(v.ArgMaps.Len()) args maps for \(wantMaps)")
		}
		let hasEnv = FuncHasClosureEnv(f)
		let mut m = 0
		for x in v.Ins {
			let ret = x.Pc + x.Size
			if goCall(v, x) {
				m = m + 1
				if ValueAt(v.Smi, ret-1) != m {
					out = out.Append("\(f.Name): call \(m) returns to stack map \(ValueAt(v.Smi, ret-1))")
				}
				if ValueAt(v.Unsafe, x.Pc) == UnsafeUnsafe {
					out = out.Append("\(f.Name): call \(m) is an unsafe point")
				}
			}
			if x.Op == 0xE8 {
				match relocAt(v.Relocs, x.Pc+1) {
				case option.Some as r:
					if isColdPanic(r.Value.Target) {
						if ValueAt(v.Smi, ret-1) <= calls.Len() {
							out = out.Append("\(f.Name): cold panic call uses call map \(ValueAt(v.Smi, ret-1))")
						}
						if ValueAt(v.Smi, ret) <= calls.Len() || (frameOf(v) > 0 && ValueAt(v.Sp, ret) != frameOf(v)) {
							out = out.Append("\(f.Name): cold panic return pc \(ret) leaves frame or cold stack map")
						}
					}
				case option.None:
				}
			}
			if callTo(v, x, if hasEnv { RuntimeMorestack } else { MorestackNoctxt }) && (ValueAt(v.Smi, ret-1) != -1 || ValueAt(v.Unsafe, x.Pc) != UnsafeUnsafe) {
				out = out.Append("\(f.Name): the morestack call is not at map -1 in an unsafe span")
			}
		}
		if frameOf(v) > 0 && ValueAt(v.Unsafe, 0) != UnsafeUnsafe {
			out = out.Append("\(f.Name): the stack check is preemptible")
		}
	}
	out
}

func wordHasPtr(layouts LayoutTable, t int, w int) bool {
	let lo = int(layouts.PtrWordLo[t])
	let hi = int(layouts.PtrWordHi[t])
	for i in lo..hi {
		if int(layouts.PtrWords[i]) == w {
			return true
		}
	}
	false
}

func wantEntryArgBits(layouts LayoutTable, plan FuncAbiPlan, params []int) []bool {
	let mut bits = slices.Repeat[bool]([]bool{false}, plan.ArgBits)
	for k, pt in params {
		if plan.ParamIsReg[k] {
			let r0 = plan.ParamRegStart[k]
			let plo = int(layouts.PieceLo[pt])
			let phi = int(layouts.PieceHi[pt])
			for j in plo..phi {
				if layouts.Pieces[j].IsPtr {
					let b = plan.StackEnd/8 + r0 + (j - plo)
					if b < bits.Len() {
						bits[b] = true
					}
				}
			}
		} else {
			let baseWord = plan.ParamStackOff[k] / 8
			let wlo = int(layouts.PtrWordLo[pt])
			let whi = int(layouts.PtrWordHi[pt])
			for wi in wlo..whi {
				let b = baseWord + int(layouts.PtrWords[wi])
				if b < bits.Len() {
					bits[b] = true
				}
			}
		}
	}
	bits
}

// CheckLiveSlots verifies entry arg bitmaps and call-site locals pointer bitmaps.
func CheckLiveSlots(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	let layouts = ComputeLayouts(p)
	for i, f in p.Funcs {
		let v = views[i]
		let size = frameOf(v)
		let calls = safeCallOps(p, f)
		let ncolds = coldOpsCount(f)
		let plan = PlanSigABI(layouts, f.Params, f.Results, f.Slots)
		if v.Args != plan.ArgsBytes || v.ArgBits != plan.ArgBits {
			out = out.Append("\(f.Name): args size \(v.Args) and \(v.ArgBits) arg bits for \(plan.ArgsBytes) bytes")
		}
		if size > 0 && v.LocBits != plan.TotalSlotWords {
			out = out.Append("\(f.Name): \(v.LocBits) locals bits for \(plan.TotalSlotWords) slot words")
		}
		let wantMaps = calls.Len() + 1 + ncolds
		if v.Locals.Len() != wantMaps || v.ArgMaps.Len() != wantMaps {
			continue
		}
		let wantEntry = wantEntryArgBits(layouts, plan, f.Params)
		for k in 0..plan.ArgBits {
			if v.ArgMaps[0][k] != wantEntry[k] {
				out = out.Append("\(f.Name): entry args bit \(k) wrong")
			}
		}
		for m in 0..calls.Len()+1 {
			let want = if m == 0 { []int{} } else { ModelAcross(p, f, calls[m-1]) }
			for j in 0..f.Slots.Len() {
				let st = f.Slots[j]
				for w in 0..plan.SlotWordCount[j] {
					let b = plan.TotalSlotWords - (plan.SlotWordStart[j] + plan.SlotWordCount[j]) + w
					let wantBit = has(want, j) && wordHasPtr(layouts, st, w)
					if b < 0 || b >= v.Locals[m].Len() {
						out = out.Append("\(f.Name): slot \(j) word \(w) has no bit")
					} else if v.Locals[m][b] != wantBit {
						out = out.Append("\(f.Name): map \(m) slot \(j) word \(w) wrong")
					}
				}
			}
			if m > 0 {
				for k in 0..v.ArgMaps[m].Len() {
					if v.ArgMaps[m][k] {
						out = out.Append("\(f.Name): map \(m) marks arg word \(k)")
					}
				}
			}
		}
	}
	out
}

func ptrWordCount(layouts LayoutTable, t int) int {
	int(layouts.PtrWordHi[t] - layouts.PtrWordLo[t])
}

func expectedBarrierCount(p Package, layouts LayoutTable, f Func) int {
	let mut n = 0
	for op in f.Ops {
		match op {
		case StorePtr as s:
			n = n + ptrWordCount(layouts, p.Types[f.Slots[s.Ptr]].Elem)
		case FieldSet as s:
			let st = p.Types[f.Slots[s.Ptr]].Elem
			let ft = p.Types[st].Fields[s.Field].Type
			n = n + ptrWordCount(layouts, ft)
		case SliceLit as sl:
			let elem = p.Types[f.Slots[sl.Dst]].Elem
			n = n + sl.Elems.Len()*ptrWordCount(layouts, elem)
		case Append as ap:
			let elem = p.Types[f.Slots[ap.Dst]].Elem
			n = n + ptrWordCount(layouts, elem)
		case MakeIface as mi:
			let st = f.Slots[mi.Src]
			if p.Types[st].Kind != KPtr && !TypeIsZeroSize(p, st) {
				n = n + ptrWordCount(layouts, st)
			}
		case SetGlobal as g:
			n = n + ptrWordCount(layouts, p.Globals[g.Global].Type)
		case _:
		}
	}
	n
}

// CheckBarriers checks write barriers on every heap pointer-word write.
func CheckBarriers(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	let layouts = ComputeLayouts(p)
	for i, f in p.Funcs {
		let v = views[i]
		let ins = v.Ins
		let mut n = 0
		for q, x in ins {
			if !callTo(v, x, GCWriteBarrier2) {
				continue
			}
			n = n + 1
			if q < 2 || q+4 >= ins.Len() {
				out = out.Append("\(f.Name): barrier call \(n) out of place")
				continue
			}
			let cmp = ins[q-2]
			let jeq = ins[q-1]
			let ok = cmp.Op == 0x83 && cmp.R == 7 && cmp.Rip && cmp.Imm == 0
			let flag = match relocAt(v.Relocs, cmp.Pc+2) {
			case option.Some as r:
				r.Value.Target == WriteBarrierFlag && r.Value.Type == RPcrel && r.Value.Add == -1
			case option.None:
				false
			}
			let store = ins[q+4]
			let lands = jeq.Op == 0x0F84 && jeq.Pc+jeq.Size+jeq.Imm == store.Pc
			let oldLoad = ins[q+2]
			let disp = oldLoad.Disp
			let buf = isMov(ins[q+1], 0x89, RSI, R11, 0) && isMov(oldLoad, 0x8B, R12, RDI, disp) && disp >= 0 && isMov(ins[q+3], 0x89, R12, R11, 8)
			if !(ok && flag && lands && buf && isMov(store, 0x89, RSI, RDI, disp)) {
				out = out.Append("\(f.Name): barrier \(n) is not the flag test, the buffered pair and the store")
			}
			for k in q-2..q+5 {
				if ValueAt(v.Unsafe, ins[k].Pc) != UnsafeUnsafe {
					out = out.Append("\(f.Name): barrier \(n) instruction at \(ins[k].Pc) is preemptible")
				}
			}
		}
		let wantN = expectedBarrierCount(p, layouts, f)
		if n != wantN {
			out = out.Append("\(f.Name): \(n) barriers for \(wantN) pointer word writes")
		}
	}
	out
}

func wantRef(o DObj, name string, abi int) bool {
	for r in o.Refs {
		if r.Name == name {
			return r.ABI == abi
		}
	}
	true
}

func internCheckStr(strs mut []string, s string) int {
	for i, x in *strs {
		if x == s {
			return i
		}
	}
	let i = (*strs).Len()
	*strs = (*strs).Append(s)
	i
}

func appendBarrierRelocs(want mut []string, count int) {
	for _ in 0..count {
		*want = (*want).Append(WriteBarrierFlag)
		*want = (*want).Append(GCWriteBarrier2)
	}
}

// CheckRelocs verifies all PC-relative, call, and external symbol ABIs plus file pc-table indices.
func CheckRelocs(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	let layouts = ComputeLayouts(p)
	let mut strs = CollectStrs(p)
	for i, f in p.Funcs {
		let v = views[i]
		if v.File != f.File {
			out = out.Append("\(f.Name): FuncInfo file \(v.File) != \(f.File)")
		}
		if v.Code.Len() > 0 && ValueAt(v.Pcfile, 0) != f.File {
			out = out.Append("\(f.Name): Pcfile entry \(ValueAt(v.Pcfile, 0)) != \(f.File)")
		}
		let mut want = []string{}
		let mut wantCold = []string{}
		for op in f.Ops {
			match op {
			case ConstStr as c:
				if c.V != "" {
					let sid = internCheckStr(&strs, c.V)
					want = want.Append(StrLiteralSym(p, sid))
				}
			case Arith as a:
				if a.Kind == AAdd && p.Types[f.Slots[a.Dst]].Kind == KString {
					want = want.Append(RuntimeConcatstring2)
				} else if a.Kind == ADiv || a.Kind == ARem {
					wantCold = wantCold.Append(RuntimePanicDivide)
				}
			case Call as c:
				want = want.Append(c.Target)
			case StorePtr as s:
				appendBarrierRelocs(&want, ptrWordCount(layouts, p.Types[f.Slots[s.Ptr]].Elem))
			case FieldSet as s:
				let st = p.Types[f.Slots[s.Ptr]].Elem
				let ft = p.Types[st].Fields[s.Field].Type
				appendBarrierRelocs(&want, ptrWordCount(layouts, ft))
			case Index as ix:
				let idxSigned = KindIsSigned(p.Types[f.Slots[ix.Idx]].Kind)
				wantCold = wantCold.Append(if idxSigned { RuntimePanicIndex } else { RuntimePanicIndexU })
			case SliceLit as sl:
				if sl.Elems.Len() == 0 {
					want = want.Append(RuntimeZerobase)
				} else {
					let elem = p.Types[f.Slots[sl.Dst]].Elem
					want = want.Append(TypeDescSym(p, elem))
					want = want.Append(RuntimeMakeslice)
					appendBarrierRelocs(&want, sl.Elems.Len()*ptrWordCount(layouts, elem))
				}
			case JumpIf as j:
				if p.Types[f.Slots[j.A]].Kind == KString {
					if j.Cond == CEq || j.Cond == CNe {
						want = want.Append(RuntimeMemequal)
					} else {
						want = want.Append(RuntimeCmpstring)
					}
				}
			case Alloc as al:
				let elem = p.Types[f.Slots[al.Dst]].Elem
				want = want.Append(TypeDescSym(p, elem))
				want = want.Append(RuntimeNewobject)
			case MakeClosure as mc:
				want = want.Append(if mc.Env < 0 { mc.Target + ClosureSuffix } else { mc.Target })
			case Append as ap:
				let elem = p.Types[f.Slots[ap.Dst]].Elem
				want = want.Append(TypeDescSym(p, elem))
				want = want.Append(RuntimeGrowslice)
				appendBarrierRelocs(&want, ptrWordCount(layouts, elem))
			case SliceOp as sl:
				let sk = p.Types[f.Slots[sl.Src]].Kind
				let hiSigned = KindIsSigned(p.Types[f.Slots[sl.Hi]].Kind)
				let loSigned = KindIsSigned(p.Types[f.Slots[sl.Lo]].Kind)
				wantCold = wantCold.Append(if sk == KString {
					if hiSigned { RuntimePanicSliceAlen } else { RuntimePanicSliceAlenU }
				} else {
					if hiSigned { RuntimePanicSliceAcap } else { RuntimePanicSliceAcapU }
				})
				wantCold = wantCold.Append(if loSigned { RuntimePanicSliceB } else { RuntimePanicSliceBU })
			case StringIndex as sx:
				let idxSigned = KindIsSigned(p.Types[f.Slots[sx.Idx]].Kind)
				wantCold = wantCold.Append(if idxSigned { RuntimePanicIndex } else { RuntimePanicIndexU })
			case MakeIface as mi:
				let dstT = f.Slots[mi.Dst]
				let srcT = f.Slots[mi.Src]
				let tabSym = if p.Types[dstT].Methods.Len() == 0 { TypeDescSym(p, srcT) } else { ItabSym(p, srcT, dstT) }
				if p.Types[srcT].Kind == KPtr {
					want = want.Append(tabSym)
				} else if TypeIsZeroSize(p, srcT) {
					want = want.Append(tabSym)
					want = want.Append(RuntimeZerobase)
				} else {
					want = want.Append(TypeDescSym(p, srcT))
					want = want.Append(RuntimeNewobject)
					appendBarrierRelocs(&want, ptrWordCount(layouts, srcT))
					want = want.Append(tabSym)
				}
			case IfaceIs as ii:
				want = want.Append(TypeDescSym(p, ii.ConcreteType))
			case GetGlobal as g:
				want = want.Append(GlobalSym(p, p.Globals[g.Global]))
			case SetGlobal as g:
				let gl = p.Globals[g.Global]
				want = want.Append(GlobalSym(p, gl))
				appendBarrierRelocs(&want, ptrWordCount(layouts, gl.Type))
			case _:
			}
		}
		for cs in wantCold {
			want = want.Append(cs)
		}
		let hasEnv = FuncHasClosureEnv(f)
		if frameOf(v) > 0 {
			want = want.Append(if hasEnv { RuntimeMorestack } else { MorestackNoctxt })
		}
		let mut got = []string{}
		let mut used = 0
		for x in v.Ins {
			let off = if x.Op == 0xE8 { x.Pc + 1 } else if x.Rip && x.Op == 0x83 { x.Pc + 2 } else if x.Rip { x.Pc + x.Size - 4 } else { -1 }
			if off < 0 {
				if x.Op == 0xFF {
					used = used + 1
				}
				continue
			}
			match relocAt(v.Relocs, off) {
			case option.Some as r:
				let t = if x.Op == 0xE8 { RCall } else { RPcrel }
				if r.Value.Type != t || r.Value.Size != 4 {
					out = out.Append("\(f.Name): relocation at \(off) of type \(r.Value.Type) size \(r.Value.Size)")
				}
				got = got.Append(r.Value.Target)
				used = used + 1
			case option.None:
				out = out.Append("\(f.Name): no relocation at \(off)")
			}
		}
		if got != want {
			out = out.Append("\(f.Name): relocations name \(strings.Join(got, ",")), the input \(strings.Join(want, ","))")
		}
		if used != v.Relocs.Len() {
			out = out.Append("\(f.Name): \(v.Relocs.Len() - used) relocations patch no instruction")
		}
	}
	let o = d.Obj
	if !wantRef(o, MorestackNoctxt, ABI0) || !wantRef(o, RuntimeMorestack, ABI0) || !wantRef(o, WriteBarrierFlag, ABI0) || !wantRef(o, GCWriteBarrier2, ABIInternal) ||
		!wantRef(o, RuntimeMakeslice, ABIInternal) || !wantRef(o, RuntimeConcatstring2, ABIInternal) ||
		!wantRef(o, RuntimeCmpstring, ABIInternal) || !wantRef(o, RuntimeMemequal, ABIInternal) ||
		!wantRef(o, RuntimeNewobject, ABIInternal) || !wantRef(o, RuntimeGrowslice, ABIInternal) ||
		!wantRef(o, RuntimePanicIndex, ABIInternal) || !wantRef(o, RuntimePanicIndexU, ABIInternal) ||
		!wantRef(o, RuntimePanicDivide, ABIInternal) || !wantRef(o, RuntimePanicSliceAlen, ABIInternal) ||
		!wantRef(o, RuntimePanicSliceAlenU, ABIInternal) || !wantRef(o, RuntimePanicSliceAcap, ABIInternal) ||
		!wantRef(o, RuntimePanicSliceAcapU, ABIInternal) || !wantRef(o, RuntimePanicSliceB, ABIInternal) ||
		!wantRef(o, RuntimePanicSliceBU, ABIInternal) || !wantRef(o, RuntimeZerobase, ABI0) {
		out = out.Append("a runtime reference carries the wrong ABI")
	}
	for f in p.Funcs {
		for op in f.Ops {
			match op {
			case Call as c:
				if !wantRef(o, c.Target, ABIInternal) {
					out = out.Append("\(c.Target) referenced with an ABI other than ABIInternal")
				}
			case _:
			}
		}
	}
	out
}

// CheckInitTask verifies package inittask data, relocations, and init ordering.
func CheckInitTask(p Package, d Decoded) []string {
	let mut out = []string{}
	let o = d.Obj
	let t = defNamed(o, p.Path+"..inittask")
	if !NeedInitTask(p) {
		if t >= 0 {
			out = out.Append("an inittask without init functions")
		}
		return out
	}
	if t < 0 {
		return out.Append("no inittask")
	}
	if d.Export.HasInit != true {
		out = out.Append("export data does not announce the inittask")
	}
	let data = o.Data[t]
	if o.Defs[t].Kind != SNoptrdata || data.Len() != 8+8*p.Inits.Len() {
		out = out.Append("inittask is not a no-pointer data symbol of \(8 + 8*p.Inits.Len()) bytes")
		return out
	}
	let nfns = LE(data, 4, 4)
	if LE(data, 0, 4) != 0 || nfns != p.Inits.Len() {
		out = out.Append("inittask state \(LE(data, 0, 4)) with \(nfns) functions for \(p.Inits.Len())")
	}
	let mut targets = []int{}
	let mut orders = []string{}
	for r in o.Relocs[t] {
		if r.Type == RAddr {
			if r.Off != 8+8*targets.Len() || r.Size != 8 || r.Own < 0 || has(targets, r.Own) {
				out = out.Append("inittask entry at \(r.Off) is not the next distinct init function")
			}
			targets = targets.Append(r.Own)
		} else if r.Type == RInitorder {
			orders = orders.Append(r.Target)
		} else {
			out = out.Append("inittask relocation of type \(r.Type)")
		}
	}
	for k, i in p.Inits {
		if k >= targets.Len() || o.Defs[targets[k]].Name != symOf(p, i) {
			out = out.Append("inittask entry \(k) is not \(symOf(p, i))")
		}
	}
	if targets.Len() != p.Inits.Len() {
		out = out.Append("inittask holds \(targets.Len()) entries for \(p.Inits.Len()) init functions")
	}
	let mut wantOrders = []string{}
	for imp in p.Imports {
		if imp.HasInit {
			wantOrders = wantOrders.Append(imp.Path + "..inittask")
		}
	}
	if orders != wantOrders {
		out = out.Append("inittask orders \(strings.Join(orders, ",")) before it, not \(strings.Join(wantOrders, ","))")
	}
	for j, s in o.Defs {
		if s.Flag2&FlagPkgInit != 0 && !has(targets, j) {
			out = out.Append("\(s.Name) is flagged as a package init outside the inittask")
		}
	}
	out
}

func objHasMainLine(ar string) bool {
	let ms = ReadAr(ar) catch {
	case Bad:
		return false
	}
	if ms.Len() < 2 || ms[1].Name != "_go_.o" {
		return false
	}
	let m = ms[1].Data
	let h = firstLine(m)
	for i in h.Len()-1..m.Len()-2 {
		if m[i:i+3] == "\n!\n" {
			for ln in strings.Split(m[h.Len():i], "\n") {
				if ln == "main" {
					return true
				}
			}
			return false
		}
	}
	false
}

// Verify decodes ar and runs every check against p and header.
func Verify(p Package, header string, ar string) []string {
	let d = Decode(ar) catch {
	case Bad as b:
		return []string{"undecodable: " + b.Why}
	}
	let mut errs = CheckMembers(PkgFiles(p), d, header).Concat(CheckFingerprints(p, d)).Concat(CheckExports(p, d)).Concat(CheckSafePoints(p, d)).Concat(CheckLiveSlots(p, d)).Concat(CheckBarriers(p, d)).Concat(CheckRelocs(p, d)).Concat(CheckInitTask(p, d))
	if p.Name == "main" && !objHasMainLine(ar) {
		errs = errs.Append("main package _go_.o misses main header line")
	}
	errs
}

func sample(k1 int, k2 int) (Package, Decoded) fails Bad {
	let p = Tiny(k1%1000000, k2%1000000, SampleDep())
	let b = Archive(p, SampleHeader) catch {
	case Refused as r:
		return Bad{Why: r.Why}
	case Malformed as m:
		return Bad{Why: m.Why}
	case Undefined as u:
		return Bad{Why: "label \(u.Label)"}
	}
	(p, try Decode(b.Archive))
}

law ArchiveMembers(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckMembers(PkgFiles(p), d, SampleHeader).Len() == 0
}

law FingerprintsAgree(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckFingerprints(p, d).Len() == 0
}

law ArgsInABIRegisters(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckExports(p, d).Len() == 0
}

law SafePointsIndexed(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckSafePoints(p, d).Len() == 0
}

law LiveSlotsMarked(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckLiveSlots(p, d).Len() == 0
}

law PointerStoresBarriered(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckBarriers(p, d).Len() == 0
}

law RelocsNameTargets(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckRelocs(p, d).Len() == 0
}

law InitTaskOnce(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	CheckInitTask(p, d).Len() == 0
}

// VerifyStop1 proves that multi-file Stop 1 packages with scalars, strings,
// named structs, slices, field stores, and stack arguments pass all checks.
law VerifyStop1(k int) {
	let p = Stop1Sample(k, SampleDep())
	let b = Archive(p, SampleHeader) catch {
	case Refused, Malformed, Undefined:
		return false
	}
	Verify(p, SampleHeader, b.Archive).Len() == 0
}

// VerifyExec proves that standalone main-package fixtures with closures,
// heap allocation, append/slice/string-index, interfaces, and foreign globals pass all checks.
law VerifyExec(k int) {
	let p = ExecSample(k, SampleDep())
	let b = Archive(p, SampleHeader) catch {
	case Refused, Malformed, Undefined:
		return false
	}
	Verify(p, SampleHeader, b.Archive).Len() == 0
}
