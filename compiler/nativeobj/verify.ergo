import strings

// The metadata checks: what the decoders (decode.ergo) read back from an
// archive, held against the checked input it was made from. Each check
// derives what the bytes must say from the input and the pin's contract
// (the frame layout, ABIInternal's registers, the runtime's tables), not
// from the writer's own records, and returns the broken relations, one
// line each; none is a pass. Verify runs them all; one law per check holds
// it at zero for the fixture over drawn constants, so each mutant of the
// writers in testdata/mutants.json breaks the law of its contract.

// FuncView is one function as the object holds it.
type FuncView {
	Name     string,
	Code     string,
	Ins      []Ins,
	Relocs   []DReloc,
	Args     int,
	Line     int,
	ArgMaps  [][]bool,
	ArgBits  int,
	Locals   [][]bool,
	LocBits  int,
	Sp       []PcVal,
	Unsafe   []PcVal,
	Smi      []PcVal,
	NPcdata  int,
	NFuncdat int,
}

func readMaps(data string) (int, [][]bool) fails Bad {
	let n = try le(data, 0, 4)
	let nbit = try le(data, 4, 4)
	let per = (nbit + 7) / 8
	if len(data) != 8+n*per {
		return Bad{Why: "a stack map of \(len(data)) bytes for \(n) maps of \(nbit) bits"}
	}
	let mut maps = [][]bool{}
	for m in 0..n {
		let mut bits = []bool{}
		for b in 0..nbit {
			let x = int(data[8+m*per+b/8])
			bits = bits.Append((x>>(b%8))&1 == 1)
		}
		maps = maps.Append(bits)
	}
	(nbit, maps)
}

func table(data string) []PcVal fails Bad {
	DecodeTable(data) catch {
	case Short as s:
		return short(s)
	}
}

// ViewOf reads definition j of d's object as a function.
func ViewOf(d Decoded, j int) FuncView fails Bad {
	let o = d.Obj
	let mut fds = []string{}
	let mut pcd = []string{}
	let mut info = ""
	let mut sp = ""
	for a in o.Aux[j] {
		if a.Def < 0 || a.Def >= len(o.Data) {
			return Bad{Why: "\(o.Defs[j].Name): aux names definition \(a.Def)"}
		}
		let data = o.Data[a.Def]
		if a.Type == AuxFuncInfo {
			info = data
		} else if a.Type == AuxFuncdata {
			fds = fds.Append(data)
		} else if a.Type == AuxPcdata {
			pcd = pcd.Append(data)
		} else if a.Type == AuxPcsp {
			sp = data
		}
	}
	if info == "" || len(fds) != 2 || len(pcd) != 2 || sp == "" {
		return Bad{Why: "\(o.Defs[j].Name): FuncInfo, both stack maps, pcsp and both pcdata tables are not all there"}
	}
	let (abits, amaps) = try readMaps(fds[FuncdataArgsPointerMaps])
	let (lbits, lmaps) = try readMaps(fds[FuncdataLocalsPointerMaps])
	FuncView{Name: o.Defs[j].Name, Code: o.Data[j], Ins: try Disasm(o.Data[j]), Relocs: o.Relocs[j], Args: try le(info, 0, 4), Line: try le(info, 12, 4),
		ArgMaps: amaps, ArgBits: abits, Locals: lmaps, LocBits: lbits, Sp: try table(sp), Unsafe: try table(pcd[PcdataUnsafePoint]),
		Smi:     try table(pcd[PcdataStackMapIndex]), NPcdata: len(pcd), NFuncdat: len(fds)}
}

// symOf is the linker name the checked input gives function i: the
// package path and its name; the k-th init function is init.k.
func symOf(p Package, i int) string {
	if p.Funcs[i].Name != "init" {
		return p.Path + "." + p.Funcs[i].Name
	}
	let mut k = 0
	for j in p.Inits {
		if j == i {
			return p.Path + ".init.\(k)"
		}
		k = k + 1
	}
	p.Path + ".init"
}

func defNamed(o DObj, name string) int {
	for j, s in o.Defs {
		if s.Name == name {
			return j
		}
	}
	-1
}

func relocAt(rs []DReloc, off int) Option[DReloc] {
	for r in rs {
		if r.Off == off {
			return Some{r}
		}
	}
	None
}

// frameOf is the frame size the code sets up: the pcsp value in the body.
func frameOf(v FuncView) int {
	let mut m = 0
	for pv in v.Sp {
		if pv.V > m {
			m = pv.V
		}
	}
	m
}

// slotDisp is slot j's displacement from SP in a frame of size: the slots
// sit below the saved BP (at SP+size-8), slot 0 first.
func slotDisp(size int, j int) int { size - 8 - 8*(j+1) }

func isMov(ins Ins, op int, reg int, base int, disp int) bool {
	ins.Op == op && ins.Mem && !ins.Rip && ins.R == reg && ins.B == base && ins.Disp == disp
}

// goCall says whether ins is a call into Go code: a direct call to a
// symbol outside the runtime, or an indirect one.
func goCall(v FuncView, ins Ins) bool {
	if ins.Op == 0xFF && ins.R == 2 {
		return true
	}
	if ins.Op != 0xE8 {
		return false
	}
	match relocAt(v.Relocs, ins.Pc+1) {
	case Some as r:
		return !strings.HasPrefix(r.Value.Target, "runtime.")
	case None:
		return true
	}
}

func callTo(v FuncView, ins Ins, target string) bool {
	if ins.Op != 0xE8 {
		return false
	}
	match relocAt(v.Relocs, ins.Pc+1) {
	case Some as r:
		return r.Value.Target == target
	case None:
		return false
	}
}

func callOps(f Func) []int {
	let mut out = []int{}
	for i, op in f.Ops {
		if IsCall(op) {
			out = out.Append(i)
		}
	}
	out
}

// funcViews pairs every function of p with its view, or names what is
// missing.
func funcViews(p Package, d Decoded) []FuncView fails Bad {
	let mut out = []FuncView{}
	for i in 0..len(p.Funcs) {
		let j = defNamed(d.Obj, symOf(p, i))
		if j < 0 {
			return Bad{Why: "no definition \(symOf(p, i))"}
		}
		if d.Obj.Defs[j].Kind != SText || d.Obj.Defs[j].ABI != ABIInternal {
			return Bad{Why: "\(symOf(p, i)) is not an ABIInternal text symbol"}
		}
		out = out.Append(try ViewOf(d, j))
	}
	out
}

// CheckMembers: the archive is __.PKGDEF then _go_.o, each opening with
// the stock header line.
func CheckMembers(d Decoded, header string) []string {
	let mut out = []string{}
	if d.Members != []string{"__.PKGDEF", "_go_.o"} {
		out = out.Append("members are not __.PKGDEF then _go_.o")
	}
	if d.PkgHeader != header || d.ObjHeader != header {
		out = out.Append("a member header is not the stock header line")
	}
	out
}

// CheckFingerprints: the export data ends with the first 8 bytes of its
// own SHA-256, and the object's header carries the same 8 bytes, so a
// stock importer's recorded fingerprint is the one the linker finds.
func CheckFingerprints(p Package, d Decoded) []string {
	let mut out = []string{}
	if d.Export.Version != ExportVersion {
		out = out.Append("export data version \(d.Export.Version)")
	}
	if d.Export.Fingerprint != d.Export.Digest {
		out = out.Append("export fingerprint is not the digest of the export data")
	}
	if d.Obj.Fingerprint != d.Export.Fingerprint {
		out = out.Append("object fingerprint differs from the export data's")
	}
	if d.Export.Path != p.Path {
		out = out.Append("export data names package \(d.Export.Path)")
	}
	if len(d.Obj.Autolib) != len(p.Imports) {
		out = out.Append("object lists \(len(d.Obj.Autolib)) imports of \(len(p.Imports))")
	} else {
		for k, imp in p.Imports {
			if d.Obj.Autolib[k].Path != imp.Path || d.Obj.Autolib[k].Fingerprint != imp.Fingerprint {
				out = out.Append("import \(imp.Path) recorded with another path or fingerprint")
			}
		}
	}
	out
}

// CheckExports: every exported function of p, and nothing else, is in
// the export data as a function whose extension names its definition by
// index, with ABIInternal; and every function's code takes its parameters
// from ABIInternal's registers in order, passes each call's arguments and
// takes its results in them, returns its results in them, and spills and
// reloads them around morestack at the caller's spill words.
func CheckExports(p Package, d Decoded) []string {
	let mut out = []string{}
	let mut n = 0
	for i, f in p.Funcs {
		if !Exported(f.Name) {
			continue
		}
		n = n + 1
		let mut found = false
		for o in d.Export.Objs {
			if o.Name == f.Name {
				found = true
				if o.Code != ObjFunc || !o.HasExt || o.ABI != ABIInternal {
					out = out.Append("\(f.Name): exported without an ABIInternal function extension")
				} else if o.SymIdx < 0 || o.SymIdx >= len(d.Obj.Defs) || d.Obj.Defs[o.SymIdx].Name != symOf(p, i) {
					out = out.Append("\(f.Name): export index \(o.SymIdx) does not name \(symOf(p, i))")
				}
			}
		}
		if !found {
			out = out.Append("\(f.Name): not exported")
		}
	}
	if len(d.Export.Objs) != n {
		out = out.Append("export data holds \(len(d.Export.Objs)) objects for \(n) exported functions")
	}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return out.Append(b.Why)
	}
	for i, f in p.Funcs {
		out = out.Concat(abiOf(p, f, views[i]))
	}
	out
}

func abiOf(p Package, f Func, v FuncView) []string {
	let mut out = []string{}
	let size = frameOf(v)
	if size == 0 {
		return out
	}
	let ins = v.Ins
	// The parameter stores follow the SUBQ that sets up the frame.
	let mut at = -1
	for k, x in ins {
		if at < 0 && x.Op == 0x81 && x.R == 5 && x.B == RSP && !x.Mem {
			at = k + 1
		}
	}
	if at < 0 {
		return out.Append("\(f.Name): no frame set-up")
	}
	for k in 0..len(f.Params) {
		if at+k >= len(ins) || !isMov(ins[at+k], 0x89, IntRegs[k], RSP, slotDisp(size, k)) {
			out = out.Append("\(f.Name): parameter \(k) not stored from \(IntRegs[k]) to its slot")
		}
	}
	let calls = callOps(f)
	let mut m = 0
	for q, x in ins {
		if goCall(v, x) {
			if m >= len(calls) {
				return out.Append("\(f.Name): more calls in the code than in the input")
			}
			let (args, dsts, closure) = match f.Ops[calls[m]] {
			case Call as c:
				(c.Args, c.Dsts, -1)
			case CallClosure as c:
				(c.Args, c.Dsts, c.Fn)
			case _:
				([]int{}, []int{}, -1)
			}
			let pre = if closure >= 0 { 2 } else { 0 }
			if closure >= 0 && (q < 2 || !isMov(ins[q-2], 0x8B, RDX, RSP, slotDisp(size, closure)) || !isMov(ins[q-1], 0x8B, R12, RDX, 0) || x.B != R12) {
				out = out.Append("\(f.Name): closure call \(m) does not take its context in RDX and its code from 0(RDX)")
			}
			for k, s in args {
				let at2 = q - pre - len(args) + k
				if at2 < 0 || !isMov(ins[at2], 0x8B, IntRegs[k], RSP, slotDisp(size, s)) {
					out = out.Append("\(f.Name): call \(m) argument \(k) not loaded into \(IntRegs[k])")
				}
			}
			for k, s in dsts {
				if q+1+k >= len(ins) || !isMov(ins[q+1+k], 0x89, IntRegs[k], RSP, slotDisp(size, s)) {
					out = out.Append("\(f.Name): call \(m) result \(k) not taken from \(IntRegs[k])")
				}
			}
			m = m + 1
		}
		if x.Op == 0xC3 {
			// Results are loaded before ADDQ and POPQ BP.
			let mut vals = []int{}
			let mut seen = 0
			for op in f.Ops {
				match op {
				case Return as r:
					if seen == countRets(ins, q) {
						vals = r.Vals
					}
					seen = seen + 1
				case _:
				}
			}
			for k, s in vals {
				let at2 = q - 2 - len(vals) + k
				if at2 < 0 || !isMov(ins[at2], 0x8B, IntRegs[k], RSP, slotDisp(size, s)) {
					out = out.Append("\(f.Name): result \(k) not returned in \(IntRegs[k])")
				}
			}
		}
		if callTo(v, x, MorestackNoctxt) {
			for k in 0..len(f.Params) {
				let before = q - len(f.Params) + k
				if before < 0 || !isMov(ins[before], 0x89, IntRegs[k], RSP, 8+8*k) || q+1+k >= len(ins) || !isMov(ins[q+1+k], 0x8B, IntRegs[k], RSP, 8+8*k) {
					out = out.Append("\(f.Name): parameter \(k) not spilled and reloaded around morestack at its spill word")
				}
			}
		}
	}
	if m != len(calls) {
		out = out.Append("\(f.Name): \(m) calls in the code for \(len(calls)) in the input")
	}
	out
}

// countRets is the number of RET instructions before instruction q.
func countRets(ins []Ins, q int) int {
	let mut n = 0
	for k in 0..q {
		if ins[k].Op == 0xC3 {
			n = n + 1
		}
	}
	n
}

// CheckSafePoints: the stack-map index at each call's return address
// minus one names that call's map (1, 2, ... in code order) and the call
// is not an unsafe point; the morestack call and the stack check run at
// index -1 (the runtime then reads map 0, the entry's) and are unsafe;
// each function has one map per call plus the entry's, in both tables.
func CheckSafePoints(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	for i, f in p.Funcs {
		let v = views[i]
		let calls = callOps(f)
		if len(v.Locals) != len(calls)+1 || len(v.ArgMaps) != len(calls)+1 {
			out = out.Append("\(f.Name): \(len(v.Locals)) locals and \(len(v.ArgMaps)) args maps for \(len(calls)) calls")
		}
		let mut m = 0
		for x in v.Ins {
			let ret = x.Pc + x.Size
			if goCall(v, x) {
				m = m + 1
				if ValueAt(v.Smi, ret-1) != m {
					out = out.Append("\(f.Name): call \(m) returns to stack map \(ValueAt(v.Smi, ret-1))")
				}
				if ValueAt(v.Unsafe, x.Pc) == UnsafeUnsafe {
					out = out.Append("\(f.Name): call \(m) is an unsafe point")
				}
			}
			if callTo(v, x, MorestackNoctxt) && (ValueAt(v.Smi, ret-1) != -1 || ValueAt(v.Unsafe, x.Pc) != UnsafeUnsafe) {
				out = out.Append("\(f.Name): the morestack call is not at map -1 in an unsafe span")
			}
		}
		if frameOf(v) > 0 && ValueAt(v.Unsafe, 0) != UnsafeUnsafe {
			out = out.Append("\(f.Name): the stack check is preemptible")
		}
	}
	out
}

// CheckLiveSlots: at each call, the locals map marks exactly the pointer
// slots the path model (LiveByPaths, with the address-taken pointer
// slots) finds live across it, each at its word below varp; the entry's
// args map marks the pointer parameters, every other args map nothing;
// the maps have a bit per slot and per parameter and result word.
func CheckLiveSlots(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	for i, f in p.Funcs {
		let v = views[i]
		let size = frameOf(v)
		let calls = callOps(f)
		let nargs = len(f.Params) + len(f.Results)
		if v.Args != 8*nargs || v.ArgBits != nargs {
			out = out.Append("\(f.Name): args size \(v.Args) and \(v.ArgBits) arg bits for \(nargs) words")
		}
		if size > 0 && v.LocBits != len(f.Slots) {
			out = out.Append("\(f.Name): \(v.LocBits) locals bits for \(len(f.Slots)) slots")
		}
		if len(v.Locals) != len(calls)+1 || len(v.ArgMaps) != len(calls)+1 {
			continue
		}
		for k, t in f.Params {
			if v.ArgMaps[0][k] != IsPointer(p, t) {
				out = out.Append("\(f.Name): entry args bit \(k) wrong")
			}
		}
		for m in 0..len(calls)+1 {
			let want = if m == 0 { []int{} } else { ModelAcross(p, f, calls[m-1]) }
			for j in 0..len(f.Slots) {
				// Slot j's word is at varp-8*(nbit-b): b = nbit - (varp-off)/8.
				let b = v.LocBits - (size-8-slotDisp(size, j))/8
				if b < 0 || b >= len(v.Locals[m]) {
					out = out.Append("\(f.Name): slot \(j) has no bit")
				} else if v.Locals[m][b] != has(want, j) {
					out = out.Append("\(f.Name): map \(m) slot \(j) is \(v.Locals[m][b]), the model says \(has(want, j))")
				}
			}
			if m > 0 {
				for k in 0..len(v.ArgMaps[m]) {
					if v.ArgMaps[m][k] {
						out = out.Append("\(f.Name): map \(m) marks arg word \(k), which no code reads after entry")
					}
				}
			}
		}
	}
	out
}

func storePtrs(f Func) int {
	let mut n = 0
	for op in f.Ops {
		match op {
		case StorePtr:
			n = n + 1
		case _:
		}
	}
	n
}

// CheckBarriers: every pointer store of the input is preceded by the
// write barrier: CMPL runtime.writeBarrier(SB), $0; JEQ to the store;
// CALL runtime.gcWriteBarrier2; the new value and the old one into the
// buffer at 0(R11) and 8(R11); and the whole sequence, store included, is
// one unsafe span, so no GC phase change falls between test and store.
func CheckBarriers(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	for i, f in p.Funcs {
		let v = views[i]
		let ins = v.Ins
		let mut n = 0
		for q, x in ins {
			if !callTo(v, x, GCWriteBarrier2) {
				continue
			}
			n = n + 1
			if q < 2 || q+4 >= len(ins) {
				out = out.Append("\(f.Name): barrier call \(n) out of place")
				continue
			}
			let cmp = ins[q-2]
			let jeq = ins[q-1]
			let ok = cmp.Op == 0x83 && cmp.R == 7 && cmp.Rip && cmp.Imm == 0
			let flag = match relocAt(v.Relocs, cmp.Pc+2) {
			case Some as r:
				r.Value.Target == WriteBarrierFlag && r.Value.Type == RPcrel && r.Value.Add == -1
			case None:
				false
			}
			let store = ins[q+4]
			let lands = jeq.Op == 0x0F84 && jeq.Pc+jeq.Size+jeq.Imm == store.Pc
			let buf = isMov(ins[q+1], 0x89, RSI, R11, 0) && isMov(ins[q+2], 0x8B, R12, RDI, 0) && isMov(ins[q+3], 0x89, R12, R11, 8)
			if !(ok && flag && lands && buf && isMov(store, 0x89, RSI, RDI, 0)) {
				out = out.Append("\(f.Name): barrier \(n) is not the flag test, the buffered pair and the store")
			}
			for k in q-2..q+5 {
				if ValueAt(v.Unsafe, ins[k].Pc) != UnsafeUnsafe {
					out = out.Append("\(f.Name): barrier \(n) instruction at \(ins[k].Pc) is preemptible")
				}
			}
		}
		if n != storePtrs(f) {
			out = out.Append("\(f.Name): \(n) barriers for \(storePtrs(f)) pointer stores")
		}
	}
	out
}

func wantRef(o DObj, name string, abi int) bool {
	for r in o.Refs {
		if r.Name == name {
			return r.ABI == abi
		}
	}
	true
}

// CheckRelocs: each call relocation patches the 4 bytes after its CALL
// and names, in code order, what the input calls there (or the runtime's
// barrier and morestack); each RIP-relative access names the variable
// its op reads or writes, the barrier flag's test with addend -1; no
// relocation is left over; and the runtime and foreign references carry
// the ABI their definitions have.
func CheckRelocs(p Package, d Decoded) []string {
	let mut out = []string{}
	let views = funcViews(p, d) catch {
	case Bad as b:
		return []string{b.Why}
	}
	for i, f in p.Funcs {
		let v = views[i]
		let mut want = []string{}
		for op in f.Ops {
			match op {
			case Call as c:
				want = want.Append(c.Target)
			case StorePtr:
				want = want.Append(WriteBarrierFlag)
				want = want.Append(GCWriteBarrier2)
			case GetGlobal as g:
				want = want.Append(p.Path + "." + p.Globals[g.Global].Name)
			case SetGlobal as g:
				want = want.Append(p.Path + "." + p.Globals[g.Global].Name)
			case _:
			}
		}
		if frameOf(v) > 0 {
			want = want.Append(MorestackNoctxt)
		}
		let mut got = []string{}
		let mut used = 0
		for x in v.Ins {
			let off = if x.Op == 0xE8 { x.Pc + 1 } else if x.Rip && x.Op == 0x83 { x.Pc + 2 } else if x.Rip { x.Pc + x.Size - 4 } else { -1 }
			if off < 0 {
				if x.Op == 0xFF {
					used = used + 1
				}
				continue
			}
			match relocAt(v.Relocs, off) {
			case Some as r:
				let t = if x.Op == 0xE8 { RCall } else { RPcrel }
				if r.Value.Type != t || r.Value.Size != 4 {
					out = out.Append("\(f.Name): relocation at \(off) of type \(r.Value.Type) size \(r.Value.Size)")
				}
				got = got.Append(r.Value.Target)
				used = used + 1
			case None:
				out = out.Append("\(f.Name): no relocation at \(off)")
			}
		}
		if got != want {
			out = out.Append("\(f.Name): relocations name \(strings.Join(got, ",")), the input \(strings.Join(want, ","))")
		}
		if used != len(v.Relocs) {
			out = out.Append("\(f.Name): \(len(v.Relocs) - used) relocations patch no instruction")
		}
	}
	let o = d.Obj
	if !wantRef(o, MorestackNoctxt, ABI0) || !wantRef(o, WriteBarrierFlag, ABI0) || !wantRef(o, GCWriteBarrier2, ABIInternal) {
		out = out.Append("a runtime reference carries the wrong ABI")
	}
	for f in p.Funcs {
		for op in f.Ops {
			match op {
			case Call as c:
				if !wantRef(o, c.Target, ABIInternal) {
					out = out.Append("\(c.Target) referenced with an ABI other than ABIInternal")
				}
			case _:
			}
		}
	}
	out
}

// CheckInitTask: the package's inittask exists exactly when it has init
// functions, holds state 0, their count and one address per init function
// (each a distinct init definition flagged as a package init), orders
// every imported package with an init before it, and no other definition
// is flagged as a package init.
func CheckInitTask(p Package, d Decoded) []string {
	let mut out = []string{}
	let o = d.Obj
	let t = defNamed(o, p.Path+"..inittask")
	if len(p.Inits) == 0 {
		if t >= 0 {
			out = out.Append("an inittask without init functions")
		}
		return out
	}
	if t < 0 {
		return out.Append("no inittask")
	}
	if d.Export.HasInit != true {
		out = out.Append("export data does not announce the inittask")
	}
	let data = o.Data[t]
	if o.Defs[t].Kind != SNoptrdata || len(data) != 8+8*len(p.Inits) {
		out = out.Append("inittask is not a no-pointer data symbol of \(8 + 8*len(p.Inits)) bytes")
		return out
	}
	let nfns = LE(data, 4, 4)
	if LE(data, 0, 4) != 0 || nfns != len(p.Inits) {
		out = out.Append("inittask state \(LE(data, 0, 4)) with \(nfns) functions for \(len(p.Inits))")
	}
	let mut targets = []int{}
	let mut orders = []string{}
	for r in o.Relocs[t] {
		if r.Type == RAddr {
			if r.Off != 8+8*len(targets) || r.Size != 8 || r.Own < 0 || has(targets, r.Own) {
				out = out.Append("inittask entry at \(r.Off) is not the next distinct init function")
			}
			targets = targets.Append(r.Own)
		} else if r.Type == RInitorder {
			orders = orders.Append(r.Target)
		} else {
			out = out.Append("inittask relocation of type \(r.Type)")
		}
	}
	for k, i in p.Inits {
		if k >= len(targets) || o.Defs[targets[k]].Name != symOf(p, i) {
			out = out.Append("inittask entry \(k) is not \(symOf(p, i))")
		}
	}
	if len(targets) != len(p.Inits) {
		out = out.Append("inittask holds \(len(targets)) entries for \(len(p.Inits)) init functions")
	}
	let mut wantOrders = []string{}
	for imp in p.Imports {
		if imp.HasInit {
			wantOrders = wantOrders.Append(imp.Path + "..inittask")
		}
	}
	if orders != wantOrders {
		out = out.Append("inittask orders \(strings.Join(orders, ",")) before it, not \(strings.Join(wantOrders, ","))")
	}
	for j, s in o.Defs {
		if s.Flag2&FlagPkgInit != 0 && !has(targets, j) {
			out = out.Append("\(s.Name) is flagged as a package init outside the inittask")
		}
	}
	out
}

// Verify decodes ar and runs every check against p and the stock header
// line, returning every broken relation.
func Verify(p Package, header string, ar string) []string {
	let d = Decode(ar) catch {
	case Bad as b:
		return []string{"undecodable: " + b.Why}
	}
	CheckMembers(d, header).Concat(CheckFingerprints(p, d)).Concat(CheckExports(p, d)).Concat(CheckSafePoints(p, d)).Concat(CheckLiveSlots(p, d)).Concat(CheckBarriers(p, d)).Concat(CheckRelocs(p, d)).Concat(CheckInitTask(p, d))
}

// sample builds the fixture for drawn constants and decodes its archive.
func sample(k1 int, k2 int) (Package, Decoded) fails Bad {
	let p = Tiny(k1%1000000, k2%1000000, SampleDep())
	let b = Archive(p, SampleHeader) catch {
	case Refused as r:
		return Bad{Why: r.Why}
	case Malformed as m:
		return Bad{Why: m.Why}
	case Undefined as u:
		return Bad{Why: "label \(u.Label)"}
	}
	(p, try Decode(b.Archive))
}

law ArchiveMembers(k1 int, k2 int) {
	let (_, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckMembers(d, SampleHeader)) == 0
}

law FingerprintsAgree(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckFingerprints(p, d)) == 0
}

law ArgsInABIRegisters(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckExports(p, d)) == 0
}

law SafePointsIndexed(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckSafePoints(p, d)) == 0
}

law LiveSlotsMarked(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckLiveSlots(p, d)) == 0
}

law PointerStoresBarriered(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckBarriers(p, d)) == 0
}

law RelocsNameTargets(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckRelocs(p, d)) == 0
}

law InitTaskOnce(k1 int, k2 int) {
	let (p, d) = sample(k1, k2) catch {
	case Bad:
		return false
	}
	len(CheckInitTask(p, d)) == 0
}
