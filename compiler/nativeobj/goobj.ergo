// The Go object file of the pin (cmd/internal/goobj, magic "\x00go120ld"):
// a header of block offsets, a string table, then the blocks.

import option
import slices
import strings

// Package index values of a symbol reference.
let PkgIdxNone = 2147483647
let PkgIdxSelf = 2147483643

// Block numbers (goobj.Blk*), and their count.
let BlkAutolib = 0
let BlkPkgIdx = 1
let BlkFile = 2
let BlkSymdef = 3
let BlkNonpkgref = 7
let BlkRelocIdx = 11
let BlkAuxIdx = 12
let BlkDataIdx = 13
let BlkReloc = 14
let BlkAux = 15
let BlkData = 16
let BlkRefName = 17
let BlkEnd = 18
let NBlk = 19

// Aux types (goobj.Aux*).
let AuxGotype = 0
let AuxFuncInfo = 1
let AuxFuncdata = 2
let AuxPcsp = 7
let AuxPcfile = 8
let AuxPcline = 9
let AuxPcdata = 11

// Symbol flags.
let FlagPkgInit = 8

// DWARF constants for subprogram DIEs.
let AuxDwarfInfo = 3
let SDwarfFcn = 14
let AbbrevFunction = 3
let OpCallFrameCFA = 0x9c
let RDwTxtAddrU1 = 103

// HeaderSize is the size of the object header: magic, fingerprint,
// flags and the block offsets.
let HeaderSize = 8 + 8 + 4 + 4*19

// SymRef names a symbol: a package index and an index in it.
type SymRef { Pkg int, Idx int }

// ObjReloc is a relocation with its target resolved to a SymRef.
type ObjReloc { Off int, Size int, Type int, Add int, Sym SymRef }

// ObjAux is an aux symbol of a definition.
type ObjAux { Type int, Sym SymRef }

// Def is one symbol the object defines.
type Def {
	Name   string,
	ABI    int,
	Kind   int,
	Flag   int,
	Flag2  int,
	Size   int,
	Align  int,
	Data   string,
	Relocs []ObjReloc,
	Aux    []ObjAux,
}

// Ref is one symbol the object refers to by name.
type Ref { Name string, ABI int }

// Object is everything the object file holds.
type Object {
	Fingerprint string,
	Autolib     []Import,
	Files       []string,
	Defs        []Def,
	Refs        []Ref,
}

type objBuilder { defs []Def, refs []Ref, own Map[string, int] }

type typeDescPlan {
	Sym       string,
	TypeIdx   int,
	IsPtrPair bool,
	Dupok     bool,
	Exported  bool,
}

func refTo(b mut objBuilder, name string, abi int) SymRef {
	match b.own.Get(name) {
	case option.Some as i:
		return SymRef{Pkg: PkgIdxSelf, Idx: i.Value}
	case option.None:
	}
	for i, r in b.refs {
		if r.Name == name && r.ABI == abi {
			return SymRef{Pkg: PkgIdxNone, Idx: i}
		}
	}
	b.refs = b.refs.Append(Ref{Name: name, ABI: abi})
	SymRef{Pkg: PkgIdxNone, Idx: b.refs.Len() - 1}
}

func addDef(b mut objBuilder, d Def) SymRef {
	b.defs = b.defs.Append(d)
	let idx = b.defs.Len() - 1
	if d.Name != "" {
		b.own[d.Name] = idx
	}
	SymRef{Pkg: PkgIdxSelf, Idx: idx}
}

func dataDef(kind int, align int, data string) Def {
	Def{Name: "", ABI: 0, Kind: kind, Flag: 0, Flag2: 0, Size: data.Len(), Align: align, Data: data, Relocs: []ObjReloc{}, Aux: []ObjAux{}}
}

// FuncInfo is the FuncInfo aux bytes of a function: Args, Locals,
// FuncID 0, FuncFlag 0, StartLine, the CU file it uses, no inline tree.
func FuncInfo(lf Lowered) string {
	let mut w = NewBuf()
	w.U32(lf.Args)
	w.U32(lf.Frame.Size)
	w.U8(0)
	w.U8(0)
	w.U8(0)
	w.U8(0)
	w.U32(lf.Line)
	w.U32(1)
	w.U32(lf.File)
	w.U32(0)
	w.Bytes()
}

// SubprogramDIEInFile emits a DWARF DW_TAG_subprogram DIE for file index file.
func SubprogramDIEInFile(name string, size int, file int, line int, external bool, fn SymRef, nfuncs int) (string, []ObjReloc) {
	let n = 2 * nfuncs
	let width = if n <= 127 { 1 } else if n <= 16383 { 2 } else if n <= 2097151 { 3 } else { 4 }
	let mut w = NewBuf()
	w.Uvarint(AbbrevFunction)
	w.Raw(name)
	w.U8(0)
	let at = w.Size()
	for _ in 0..width {
		w.U8(0)
	}
	w.Uvarint(size)
	w.U8(1)
	w.U8(OpCallFrameCFA)
	w.U32(file + 1)
	w.Uvarint(line)
	w.U8(if external { 1 } else { 0 })
	w.U8(0)
	(w.Bytes(), []ObjReloc{ObjReloc{Off: at, Size: width, Type: RDwTxtAddrU1 + width - 1, Add: 0, Sym: fn}})
}

// SubprogramDIE is a function's DW_TAG_subprogram DIE for file index 0.
func SubprogramDIE(name string, size int, line int, external bool, fn SymRef, nfuncs int) (string, []ObjReloc) {
	SubprogramDIEInFile(name, size, 0, line, external, fn, nfuncs)
}

// InitTask is the bytes of the package's inittask.
func InitTask(n int) string {
	let mut w = NewBuf()
	w.U32(0)
	w.U32(n)
	for _ in 0..n {
		w.U64(0)
	}
	w.Bytes()
}

func fnv32(s string) int {
	let mut h = 2166136261
	for i in 0..s.Len() {
		h = ((h ^ int(s[i])) * 16777619) & 0xffffffff
	}
	if h == 0 { 1 } else { h }
}

func abiKindCode(k int) int {
	if k == KBool {
		return 1
	}
	if k == KInt {
		return 2
	}
	if k >= KInt8 && k <= KInt64 {
		return 3 + (k - KInt8)
	}
	if k >= KUint && k <= KUintptr {
		return 7 + (k - KUint)
	}
	if k == KFunc {
		return 19
	}
	if k == KIface {
		return 20
	}
	if k == KPtr {
		return 22
	}
	if k == KSlice {
		return 23
	}
	if k == KString {
		return 24
	}
	if k == KStruct {
		return 25
	}
	0
}

let basicShortNames = []string{
	"int", "", "", "bool", "int8", "int16", "int32", "int64",
	"uint", "uint8", "uint16", "uint32", "uint64", "uintptr", "string", "", "",
}

func pkgShortOf(p Package, pkgPath string) string {
	if pkgPath == "" || pkgPath == p.Path {
		return p.Name
	}
	for imp in p.Imports {
		if imp.Path == pkgPath {
			return imp.Name
		}
	}
	pkgPath
}

func typeShortStr(p Package, t int) string {
	let td = p.Types[t]
	if td.Kind >= 0 && td.Kind < basicShortNames.Len() && basicShortNames[td.Kind] != "" {
		return basicShortNames[td.Kind]
	}
	if td.Kind == KPtr {
		return "*" + typeShortStr(p, td.Elem)
	}
	if td.Kind == KSlice {
		return "[]" + typeShortStr(p, td.Elem)
	}
	if td.Kind == KStruct {
		if td.Name != "" {
			return pkgShortOf(p, td.PkgPath) + "." + td.Name
		}
		return "struct{}"
	}
	if td.Kind == KIface {
		if td.Name != "" {
			if td.PkgPath == "" && td.Name == "error" {
				return "error"
			}
			return pkgShortOf(p, td.PkgPath) + "." + td.Name
		}
		if td.Methods.Len() == 0 {
			return "interface {}"
		}
		return "interface{}"
	}
	let mut s = "func("
	for i, pt in td.Params {
		if i > 0 {
			s = s + ", "
		}
		s = s + typeShortStr(p, pt)
	}
	s = s + ")"
	if td.Results.Len() == 1 {
		s = s + " " + typeShortStr(p, td.Results[0])
	} else if td.Results.Len() > 1 {
		s = s + " ("
		for i, rt in td.Results {
			if i > 0 {
				s = s + ", "
			}
			s = s + typeShortStr(p, rt)
		}
		s = s + ")"
	}
	s
}

func hexNib(v int) byte {
	if v < 10 { byte(48 + v) } else { byte(87 + v) }
}

func bytesHex(bs []byte) string {
	let mut out = slices.WithCapacity[byte](bs.Len() * 2)
	for b in bs {
		let v = int(b)
		out = out.Append(hexNib((v >> 4) & 15))
		out = out.Append(hexNib(v & 15))
	}
	out.Text()
}

func addNamedata(b mut objBuilder, name string, exported bool) SymRef {
	let sym = "type:.namedata." + name + (if exported { "." } else { "-" })
	match b.own.Get(sym) {
	case option.Some as i:
		return SymRef{Pkg: PkgIdxSelf, Idx: i.Value}
	case option.None:
	}
	let mut w = NewBuf()
	w.U8(if exported { 1 } else { 0 })
	w.Uvarint(name.Len())
	w.Raw(name)
	b.addDef(Def{Name: sym, ABI: ABI0, Kind: SRodata, Flag: FlagDupok, Flag2: 0, Size: w.Size(), Align: 1, Data: w.Bytes(), Relocs: []ObjReloc{}, Aux: []ObjAux{}})
}

func addImportpath(b mut objBuilder, pkgPath string) SymRef {
	let sym = "type:.importpath." + pkgPath + "."
	match b.own.Get(sym) {
	case option.Some as i:
		return SymRef{Pkg: PkgIdxSelf, Idx: i.Value}
	case option.None:
	}
	let mut w = NewBuf()
	w.U8(0)
	w.Uvarint(pkgPath.Len())
	w.Raw(pkgPath)
	b.addDef(Def{Name: sym, ABI: ABI0, Kind: SRodata, Flag: FlagDupok, Flag2: 0, Size: w.Size(), Align: 1, Data: w.Bytes(), Relocs: []ObjReloc{}, Aux: []ObjAux{}})
}

func addGcbits(p Package, b mut objBuilder, layouts LayoutTable, t int) SymRef {
	let pb = int(layouts.PtrBytes[t])
	if pb == 0 {
		let sym = SymName(p, "..gcbits_0")
		match b.own.Get(sym) {
		case option.Some as i:
			return SymRef{Pkg: PkgIdxSelf, Idx: i.Value}
		case option.None:
		}
		return b.addDef(Def{Name: sym, ABI: ABI0, Kind: SRodata, Flag: 0, Flag2: 0, Size: 0, Align: 8, Data: "", Relocs: []ObjReloc{}, Aux: []ObjAux{}})
	}
	let nbytes = (pb/8 + 7) / 8
	let padded = ((nbytes + 7) / 8) * 8
	let mut mask = slices.Repeat[byte]([]byte{byte(0)}, padded)
	let wlo = int(layouts.PtrWordLo[t])
	let whi = int(layouts.PtrWordHi[t])
	for wi in wlo..whi {
		let w = int(layouts.PtrWords[wi])
		let bi = w / 8
		if bi < padded {
			mask[bi] = byte(int(mask[bi]) | (1 << (w % 8)))
		}
	}
	let sym = SymName(p, "..gcbits_"+bytesHex(mask))
	match b.own.Get(sym) {
	case option.Some as i:
		return SymRef{Pkg: PkgIdxSelf, Idx: i.Value}
	case option.None:
	}
	b.addDef(Def{Name: sym, ABI: ABI0, Kind: SRodata, Flag: 0, Flag2: 0, Size: padded, Align: 8, Data: mask.Text(), Relocs: []ObjReloc{}, Aux: []ObjAux{}})
}

func reservePlan(plans mut []typeDescPlan, symToIdx mut Map[string, int], base int, pl typeDescPlan) int {
	match (*symToIdx).Get(pl.Sym) {
	case option.Some as i:
		return i.Value
	case option.None:
	}
	let idx = base + (*plans).Len()
	(*symToIdx)[pl.Sym] = idx
	*plans = (*plans).Append(pl)
	idx
}

func isLocalGlobal(p Package, g Global) bool {
	g.PkgPath == "" || g.PkgPath == p.Path
}

// PlanTypeSyms computes deterministic symbol definitions and object symbol
// indices for all Go type descriptors emitted for p.
func PlanTypeSyms(p Package) ([]typeDescPlan, []int, []int) {
	let nf = p.Funcs.Len()
	let mut ng = 0
	for g in p.Globals {
		if isLocalGlobal(p, g) {
			ng = ng + 1
		}
	}
	let hasInit = if NeedInitTask(p) { 1 } else { 0 }
	let base = nf + ng + hasInit
	let mut typeSyms = slices.Repeat[int]([]int{-1}, p.Types.Len())
	let mut ptrTypeSyms = slices.Repeat[int]([]int{-1}, p.Types.Len())
	let mut plans = []typeDescPlan{}
	let mut symToIdx = Map[string, int]{}
	for t, td in p.Types {
		if KindIsBasic(td.Kind) {
			continue
		}
		if td.Kind == KStruct {
			if td.PkgPath == "" || td.PkgPath == p.Path {
				if td.Name != "" {
					let s1 = "type:" + p.Path + "." + td.Name
					let s2 = "type:*" + p.Path + "." + td.Name
					typeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s1, TypeIdx: t, IsPtrPair: false, Dupok: false, Exported: td.Exported})
					ptrTypeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s2, TypeIdx: t, IsPtrPair: true, Dupok: false, Exported: td.Exported})
				} else {
					let s1 = TypeDescSym(p, t)
					typeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s1, TypeIdx: t, IsPtrPair: false, Dupok: true, Exported: false})
				}
			}
		} else if td.Kind == KIface {
			if td.Name == "error" && td.PkgPath == "" {
				continue
			}
			if td.PkgPath != "" && td.PkgPath != p.Path {
				continue
			}
			if td.Name != "" {
				let s1 = "type:" + p.Path + "." + td.Name
				let s2 = "type:*" + p.Path + "." + td.Name
				typeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s1, TypeIdx: t, IsPtrPair: false, Dupok: false, Exported: td.Exported})
				ptrTypeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s2, TypeIdx: t, IsPtrPair: true, Dupok: false, Exported: td.Exported})
			} else {
				let s = TypeDescSym(p, t)
				typeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s, TypeIdx: t, IsPtrPair: false, Dupok: true, Exported: false})
			}
		} else if td.Kind == KPtr {
			let etd = p.Types[td.Elem]
			if (etd.Kind == KStruct || (etd.Kind == KIface && etd.Name != "")) && etd.PkgPath != "" && etd.PkgPath != p.Path {
				continue
			}
			if (etd.Kind == KStruct || etd.Kind == KIface) && etd.Name != "" {
				let s2 = TypeDescSym(p, t)
				typeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s2, TypeIdx: td.Elem, IsPtrPair: true, Dupok: false, Exported: etd.Exported})
			} else {
				let s = TypeDescSym(p, t)
				typeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s, TypeIdx: t, IsPtrPair: false, Dupok: true, Exported: false})
			}
		} else {
			let s = TypeDescSym(p, t)
			typeSyms[t] = reservePlan(&plans, &symToIdx, base, typeDescPlan{Sym: s, TypeIdx: t, IsPtrPair: false, Dupok: true, Exported: false})
		}
	}
	(plans, typeSyms, ptrTypeSyms)
}

func emitCommonHeader(w mut Buf, rs mut []ObjReloc, size int, ptrBytes int, hash int, tflag int, align int, kind int, eqRef SymRef, hasEq bool, gcRef SymRef, strRef SymRef, ptrToRef SymRef, hasPtrTo bool) {
	w.U64(size)
	w.U64(ptrBytes)
	w.U32(hash)
	w.U8(tflag)
	w.U8(align)
	w.U8(align)
	w.U8(kind)
	w.U64(0)
	if hasEq {
		*rs = (*rs).Append(ObjReloc{Off: 24, Size: 8, Type: RAddr, Add: 0, Sym: eqRef})
	}
	w.U64(0)
	*rs = (*rs).Append(ObjReloc{Off: 32, Size: 8, Type: RAddr, Add: 0, Sym: gcRef})
	w.U32(0)
	*rs = (*rs).Append(ObjReloc{Off: 40, Size: 4, Type: RAddroff, Add: 0, Sym: strRef})
	w.U32(0)
	if hasPtrTo {
		*rs = (*rs).Append(ObjReloc{Off: 44, Size: 4, Type: RAddroff, Add: 0, Sym: ptrToRef})
	}
}

func ptrSymRef(b mut objBuilder, sym string) SymRef {
	match b.own.Get(sym) {
	case option.Some as i:
		return SymRef{Pkg: PkgIdxSelf, Idx: i.Value}
	case option.None:
	}
	b.refTo(sym, ABI0)
}

func fillTypeDesc(p Package, layouts LayoutTable, b mut objBuilder, selfIdx int, pl typeDescPlan) Def {
	if pl.IsPtrPair {
		let elemSym = "type:" + p.Path + "." + p.Types[pl.TypeIdx].Name
		let shortStr = "*" + p.Name + "." + p.Types[pl.TypeIdx].Name
		let strRef = b.addNamedata(shortStr, pl.Exported)
		let mut mask = slices.Repeat[byte]([]byte{byte(0)}, 8)
		mask[0] = byte(1)
		let gcSym = SymName(p, "..gcbits_"+bytesHex(mask))
		let gcRef = match b.own.Get(gcSym) {
		case option.Some as i:
			SymRef{Pkg: PkgIdxSelf, Idx: i.Value}
		case option.None:
			b.addDef(Def{Name: gcSym, ABI: ABI0, Kind: SRodata, Flag: 0, Flag2: 0, Size: 8, Align: 8, Data: mask.Text(), Relocs: []ObjReloc{}, Aux: []ObjAux{}})
		}
		let eqRef = b.refTo(RuntimeMemequal64F, ABI0)
		let elemRef = b.ptrSymRef(elemSym)
		let mut w = NewBuf()
		let mut rs = []ObjReloc{}
		emitCommonHeader(&w, &rs, 8, 8, fnv32(pl.Sym), 8|32, 8, abiKindCode(KPtr), eqRef, true, gcRef, strRef, SymRef{Pkg: 0, Idx: 0}, false)
		w.U64(0)
		rs = rs.Append(ObjReloc{Off: 48, Size: 8, Type: RAddr, Add: 0, Sym: elemRef})
		let flag = FlagGoType | FlagTypelink | (if pl.Dupok { FlagDupok } else { 0 })
		return Def{Name: pl.Sym, ABI: ABI0, Kind: SRodata, Flag: flag, Flag2: 0, Size: w.Size(), Align: 8, Data: w.Bytes(), Relocs: rs, Aux: []ObjAux{}}
	}
	let t = pl.TypeIdx
	let td = p.Types[t]
	let shortStr = typeShortStr(p, t)
	let mut tflag = 2
	let strText = if shortStr.Len() > 0 && shortStr[0] == byte('*') {
		tflag = tflag - 2
		shortStr
	} else {
		"*" + shortStr
	}
	let isNamedDecl = (td.Kind == KStruct || td.Kind == KIface) && td.Name != ""
	if isNamedDecl {
		tflag = tflag | 1 | 4
	}
	let isPtrOrFunc = td.Kind == KPtr || td.Kind == KFunc
	if isPtrOrFunc {
		tflag = tflag | 32
	}
	if td.Kind == KPtr {
		tflag = tflag | 8
	}
	let strExported = if isNamedDecl {
		td.Exported
	} else if td.Kind == KPtr && (p.Types[td.Elem].Kind == KStruct || p.Types[td.Elem].Kind == KIface) && p.Types[td.Elem].Name != "" {
		p.Types[td.Elem].Exported
	} else {
		false
	}
	let strRef = b.addNamedata(strText, strExported)
	let gcRef = addGcbits(p, b, layouts, t)
	let (eqRef, hasEq) = if td.Kind == KPtr {
		(b.refTo(RuntimeMemequal64F, ABI0), true)
	} else {
		(SymRef{Pkg: 0, Idx: 0}, false)
	}
	let ptrPairSym = if isNamedDecl { "type:*" + p.Path + "." + td.Name } else { "" }
	let (ptrToRef, hasPtrTo) = if ptrPairSym != "" {
		match b.own.Get(ptrPairSym) {
		case option.Some as pi:
			(SymRef{Pkg: PkgIdxSelf, Idx: pi.Value}, true)
		case option.None:
			(SymRef{Pkg: 0, Idx: 0}, false)
		}
	} else {
		(SymRef{Pkg: 0, Idx: 0}, false)
	}
	let mut w = NewBuf()
	let mut rs = []ObjReloc{}
	emitCommonHeader(&w, &rs, int(layouts.Sizes[t]), int(layouts.PtrBytes[t]), fnv32(pl.Sym), tflag, int(layouts.Aligns[t]), abiKindCode(td.Kind), eqRef, hasEq, gcRef, strRef, ptrToRef, hasPtrTo)
	if td.Kind == KPtr || td.Kind == KSlice {
		let elemRef = b.ptrSymRef(TypeDescSym(p, td.Elem))
		w.U64(0)
		rs = rs.Append(ObjReloc{Off: 48, Size: 8, Type: RAddr, Add: 0, Sym: elemRef})
		let flag = FlagGoType | FlagTypelink | (if pl.Dupok { FlagDupok } else { 0 })
		return Def{Name: pl.Sym, ABI: ABI0, Kind: SRodata, Flag: flag, Flag2: 0, Size: w.Size(), Align: 8, Data: w.Bytes(), Relocs: rs, Aux: []ObjAux{}}
	}
	if td.Kind == KFunc {
		w.U16(td.Params.Len())
		w.U16(td.Results.Len())
		w.U32(0)
		for pt in td.Params {
			let pOff = w.Size()
			w.U64(0)
			rs = rs.Append(ObjReloc{Off: pOff, Size: 8, Type: RAddr, Add: 0, Sym: b.ptrSymRef(TypeDescSym(p, pt))})
		}
		for rt in td.Results {
			let rOff = w.Size()
			w.U64(0)
			rs = rs.Append(ObjReloc{Off: rOff, Size: 8, Type: RAddr, Add: 0, Sym: b.ptrSymRef(TypeDescSym(p, rt))})
		}
		let flag = FlagGoType | FlagTypelink | (if pl.Dupok { FlagDupok } else { 0 })
		return Def{Name: pl.Sym, ABI: ABI0, Kind: SRodata, Flag: flag, Flag2: 0, Size: w.Size(), Align: 8, Data: w.Bytes(), Relocs: rs, Aux: []ObjAux{}}
	}
	if td.Kind == KIface {
		let named = td.Name != ""
		let pkgPathSym = if named {
			if td.PkgPath != "" { td.PkgPath } else { p.Path }
		} else {
			""
		}
		w.U64(0)
		if pkgPathSym != "" {
			let impRef = b.addImportpath(pkgPathSym)
			rs = rs.Append(ObjReloc{Off: 48, Size: 8, Type: RAddr, Add: 0, Sym: impRef})
		}
		let methsOff = if named { 96 } else { 80 }
		let nm = td.Methods.Len()
		w.U64(0)
		if nm > 0 {
			rs = rs.Append(ObjReloc{Off: 56, Size: 8, Type: RAddr, Add: methsOff, Sym: SymRef{Pkg: PkgIdxSelf, Idx: selfIdx}})
		}
		w.U64(nm)
		w.U64(nm)
		if named {
			let uPath = if td.PkgPath != "" { td.PkgPath } else { p.Path }
			let impRef = b.addImportpath(uPath)
			w.U32(0)
			rs = rs.Append(ObjReloc{Off: 80, Size: 4, Type: RAddroff, Add: 0, Sym: impRef})
			w.U16(0)
			w.U16(0)
			w.U32(16 + 8*nm)
			w.U32(0)
		}
		for md in td.Methods {
			let mBase = w.Size()
			let mnRef = b.addNamedata(md.Name, md.Exported)
			let mtRef = b.ptrSymRef(TypeDescSym(p, md.Type))
			w.U32(0)
			rs = rs.Append(ObjReloc{Off: mBase, Size: 4, Type: RAddroff, Add: 0, Sym: mnRef})
			w.U32(0)
			rs = rs.Append(ObjReloc{Off: mBase + 4, Size: 4, Type: RAddroff, Add: 0, Sym: mtRef})
		}
		let flag = FlagGoType | (if pl.Dupok { FlagDupok } else { 0 })
		return Def{Name: pl.Sym, ABI: ABI0, Kind: SRodata, Flag: flag, Flag2: 0, Size: w.Size(), Align: 8, Data: w.Bytes(), Relocs: rs, Aux: []ObjAux{}}
	}
	let mut hasUnexpField = false
	for fd in td.Fields {
		if !fd.Exported {
			hasUnexpField = true
		}
	}
	let pkgPathSym = if hasUnexpField {
		if td.PkgPath != "" { td.PkgPath } else { p.Path }
	} else {
		""
	}
	w.U64(0)
	if pkgPathSym != "" {
		let impRef = b.addImportpath(pkgPathSym)
		rs = rs.Append(ObjReloc{Off: 48, Size: 8, Type: RAddr, Add: 0, Sym: impRef})
	}
	let named = td.Name != ""
	let fieldsOff = if named { 96 } else { 80 }
	let nfld = td.Fields.Len()
	w.U64(0)
	if nfld > 0 {
		rs = rs.Append(ObjReloc{Off: 56, Size: 8, Type: RAddr, Add: fieldsOff, Sym: SymRef{Pkg: PkgIdxSelf, Idx: selfIdx}})
	}
	w.U64(nfld)
	w.U64(nfld)
	if named {
		let uPath = if td.PkgPath != "" { td.PkgPath } else { p.Path }
		let impRef = b.addImportpath(uPath)
		w.U32(0)
		rs = rs.Append(ObjReloc{Off: 80, Size: 4, Type: RAddroff, Add: 0, Sym: impRef})
		w.U16(0)
		w.U16(0)
		w.U32(16 + 24*nfld)
		w.U32(0)
	}
	let flo = int(layouts.FieldOffLo[t])
	for fi, fd in td.Fields {
		let fBase = w.Size()
		let fnRef = b.addNamedata(fd.Name, fd.Exported)
		let ftRef = b.ptrSymRef(TypeDescSym(p, fd.Type))
		w.U64(0)
		rs = rs.Append(ObjReloc{Off: fBase, Size: 8, Type: RAddr, Add: 0, Sym: fnRef})
		w.U64(0)
		rs = rs.Append(ObjReloc{Off: fBase + 8, Size: 8, Type: RAddr, Add: 0, Sym: ftRef})
		w.U64(int(layouts.FieldOffs[flo+fi]))
	}
	let flag = FlagGoType | (if pl.Dupok { FlagDupok } else { 0 })
	Def{Name: pl.Sym, ABI: ABI0, Kind: SRodata, Flag: flag, Flag2: 0, Size: w.Size(), Align: 8, Data: w.Bytes(), Relocs: rs, Aux: []ObjAux{}}
}

func resolveItabMethod(p Package, b mut objBuilder, baseTD TypeDef, methodName string, methodExported bool) (SymRef, bool) {
	if baseTD.Kind != KStruct || baseTD.Name == "" {
		return (SymRef{Pkg: 0, Idx: 0}, false)
	}
	if baseTD.PkgPath == "" || baseTD.PkgPath == p.Path {
		let ptrName = "(*" + baseTD.Name + ")." + methodName
		let valName = baseTD.Name + "." + methodName
		for fi, f in p.Funcs {
			if f.Name == ptrName {
				return (SymRef{Pkg: PkgIdxSelf, Idx: fi}, true)
			}
		}
		for fi, f in p.Funcs {
			if f.Name == valName {
				return (SymRef{Pkg: PkgIdxSelf, Idx: fi}, true)
			}
		}
		return (SymRef{Pkg: 0, Idx: 0}, false)
	}
	if methodExported {
		let sym = baseTD.PkgPath + ".(*" + baseTD.Name + ")." + methodName
		return (b.refTo(sym, ABIInternal), true)
	}
	(SymRef{Pkg: 0, Idx: 0}, false)
}

func emitStaticItab(p Package, b mut objBuilder, srcT int, dstT int) {
	let it = p.Types[dstT]
	if it.Kind != KIface || it.Methods.Len() == 0 {
		return
	}
	let itabSym = ItabSym(p, srcT, dstT)
	match b.own.Get(itabSym) {
	case option.Some:
		return
	case option.None:
	}
	let baseT = if p.Types[srcT].Kind == KPtr { p.Types[srcT].Elem } else { srcT }
	let baseTD = p.Types[baseT]
	let mut funRefs = slices.WithCapacity[SymRef](it.Methods.Len())
	for md in it.Methods {
		let (ref, ok) = resolveItabMethod(p, b, baseTD, md.Name, md.Exported)
		if !ok {
			return
		}
		funRefs = funRefs.Append(ref)
	}
	let ifaceSym = TypeDescSym(p, dstT)
	let srcSym = TypeDescSym(p, srcT)
	let mut w = NewBuf()
	let mut rs = []ObjReloc{}
	w.U64(0)
	rs = rs.Append(ObjReloc{Off: 0, Size: 8, Type: RAddr, Add: 0, Sym: b.ptrSymRef(ifaceSym)})
	w.U64(0)
	rs = rs.Append(ObjReloc{Off: 8, Size: 8, Type: RAddr, Add: 0, Sym: b.ptrSymRef(srcSym)})
	w.U32(fnv32(srcSym))
	w.U32(0)
	for fr in funRefs {
		let off = w.Size()
		w.U64(0)
		rs = rs.Append(ObjReloc{Off: off, Size: 8, Type: RAddr, Add: 0, Sym: fr})
	}
	b.addDef(Def{Name: itabSym, ABI: ABI0, Kind: SRodata, Flag: FlagDupok, Flag2: 0, Size: w.Size(), Align: 8, Data: w.Bytes(), Relocs: rs, Aux: []ObjAux{}})
}

// BuildObjectWithStrs lays out the Go object file of package p from lowered functions and string pool strs.
func BuildObjectWithStrs(p Package, layouts LayoutTable, lowered []Lowered, strs []string, fingerprint string) Object {
	let mut b = objBuilder{defs: []Def{}, refs: []Ref{}, own: Map[string, int]{}}
	for i, lf in lowered {
		let flag2 = if p.Funcs[i].Name == "init" || strings.HasPrefix(p.Funcs[i].Name, "init.") { FlagPkgInit } else { 0 }
		b.addDef(Def{Name: FuncSym(p, i), ABI: ABIInternal, Kind: SText, Flag: 0, Flag2: flag2, Size: lf.Code.Len(), Align: 0,
			Data: lf.Code, Relocs: []ObjReloc{}, Aux: []ObjAux{}})
	}
	let mut globalDefIdxs = slices.Repeat[int]([]int{-1}, p.Globals.Len())
	for k, g in p.Globals {
		if isLocalGlobal(p, g) {
			let kind = if HasPointers(p, g.Type) { SBss } else { SNoptrbss }
			let sz = int(layouts.Sizes[g.Type])
			let al = int(layouts.Aligns[g.Type])
			globalDefIdxs[k] = b.defs.Len()
			b.addDef(Def{Name: SymName(p, g.Name), ABI: ABI0, Kind: kind, Flag: 0, Flag2: 0, Size: sz, Align: al, Data: "", Relocs: []ObjReloc{}, Aux: []ObjAux{}})
		}
	}
	let inits = p.Inits
	let hasInit = NeedInitTask(p)
	let task = SymName(p, ".inittask")
	if hasInit {
		let mut rs = []ObjReloc{}
		for k, fi in inits {
			rs = rs.Append(ObjReloc{Off: 8 + 8*k, Size: 8, Type: RAddr, Add: 0, Sym: SymRef{Pkg: PkgIdxSelf, Idx: fi}})
		}
		for imp in p.Imports {
			if imp.HasInit {
				rs = rs.Append(ObjReloc{Off: 0, Size: 0, Type: RInitorder, Add: 0, Sym: b.refTo(imp.Path+"..inittask", ABI0)})
			}
		}
		let data = InitTask(inits.Len())
		b.addDef(Def{Name: task, ABI: ABI0, Kind: SNoptrdata, Flag: 0, Flag2: 0, Size: data.Len(), Align: 8, Data: data, Relocs: rs, Aux: []ObjAux{}})
	}
	let (plans, _, _) = PlanTypeSyms(p)
	let planBase = b.defs.Len()
	for pl in plans {
		b.addDef(Def{Name: pl.Sym, ABI: ABI0, Kind: SRodata, Flag: FlagGoType, Flag2: 0, Size: 0, Align: 8, Data: "", Relocs: []ObjReloc{}, Aux: []ObjAux{}})
	}
	for k, s in strs {
		let sym = StrLiteralSym(p, k)
		b.addDef(Def{Name: sym, ABI: ABI0, Kind: SRodata, Flag: 0, Flag2: 0, Size: s.Len(), Align: 1, Data: s, Relocs: []ObjReloc{}, Aux: []ObjAux{}})
	}
	for f in p.Funcs {
		for op in f.Ops {
			match op {
			case MakeClosure as mc:
				if mc.Env < 0 {
					let csym = mc.Target + ClosureSuffix
					let mut present = false
					match b.own.Get(csym) {
					case option.Some:
						present = true
					case option.None:
					}
					if !present {
						match b.own.Get(mc.Target) {
						case option.Some as ti:
							b.addDef(Def{Name: csym, ABI: ABI0, Kind: SRodata, Flag: FlagDupok, Flag2: 0, Size: 8, Align: 8,
								Data:   "\x00\x00\x00\x00\x00\x00\x00\x00",
								Relocs: []ObjReloc{ObjReloc{Off: 0, Size: 8, Type: RAddr, Add: 0, Sym: SymRef{Pkg: PkgIdxSelf, Idx: ti.Value}}},
								Aux:    []ObjAux{}})
						case option.None:
						}
					}
				}
			case MakeIface as mi:
				emitStaticItab(p, &b, f.Slots[mi.Src], f.Slots[mi.Dst])
			case _:
			}
		}
	}
	for k, g in p.Globals {
		let gi = globalDefIdxs[k]
		if gi >= 0 && HasPointers(p, g.Type) {
			let mut d = b.defs[gi]
			d.Aux = []ObjAux{ObjAux{Type: AuxGotype, Sym: b.ptrSymRef(TypeDescSym(p, g.Type))}}
			b.defs[gi] = d
		}
	}
	for i, lf in lowered {
		let mut rs = []ObjReloc{}
		for r in lf.Relocs {
			let target = if r.Sym == "" { SymRef{Pkg: 0, Idx: 0} } else { b.refTo(r.Sym, r.ABI) }
			rs = rs.Append(ObjReloc{Off: r.Off, Size: r.Size, Type: r.Type, Add: r.Add, Sym: target})
		}
		let info = b.addDef(dataDef(7, 0, FuncInfo(lf)))
		let args = b.addDef(dataDef(SRodata, 4, StackMap(lf.ArgMaps, lf.ArgBits)))
		let locals = b.addDef(dataDef(SRodata, 4, StackMap(lf.Locals, lf.Frame.Slots)))
		let pcsp = b.addDef(dataDef(SRodata, 1, lf.Pcsp))
		let pcfile = b.addDef(dataDef(SRodata, 1, lf.Pcfile))
		let pcline = b.addDef(dataDef(SRodata, 1, lf.Pcline))
		let unsafe = b.addDef(dataDef(SRodata, 1, lf.Unsafe))
		let smi = b.addDef(dataDef(SRodata, 1, lf.Smi))
		let (die, dieRelocs) = SubprogramDIEInFile(FuncSym(p, i), lf.Code.Len(), lf.File, lf.Line, Exported(p.Funcs[i].Name), SymRef{Pkg: PkgIdxSelf, Idx: i}, lowered.Len())
		let dwarf = b.addDef(Def{Name: "", ABI: 0, Kind: SDwarfFcn, Flag: 0, Flag2: 0, Size: die.Len(), Align: 1, Data: die, Relocs: dieRelocs, Aux: []ObjAux{}})
		let mut d = b.defs[i]
		d.Relocs = rs
		d.Aux = []ObjAux{
			ObjAux{Type: AuxFuncInfo, Sym: info},
			ObjAux{Type: AuxFuncdata, Sym: args},
			ObjAux{Type: AuxFuncdata, Sym: locals},
			ObjAux{Type: AuxDwarfInfo, Sym: dwarf},
			ObjAux{Type: AuxPcsp, Sym: pcsp},
			ObjAux{Type: AuxPcfile, Sym: pcfile},
			ObjAux{Type: AuxPcline, Sym: pcline},
			ObjAux{Type: AuxPcdata, Sym: unsafe},
			ObjAux{Type: AuxPcdata, Sym: smi},
		}
		b.defs[i] = d
	}
	for k, pl in plans {
		let idx = planBase + k
		b.defs[idx] = fillTypeDesc(p, layouts, &b, idx, pl)
	}
	Object{Fingerprint: fingerprint, Autolib: p.Imports, Files: PkgFiles(p), Defs: b.defs, Refs: b.refs}
}

// BuildObject lays out the object of package p from its lowered functions and fingerprint.
func BuildObject(p Package, lowered []Lowered, fingerprint string) Object {
	BuildObjectWithStrs(p, ComputeLayouts(p), lowered, []string{}, fingerprint)
}

type strtab { offs Map[string, int] }

func addStr(t mut strtab, w mut Buf, s string) {
	match t.offs.Get(s) {
	case option.Some:
		return
	case option.None:
	}
	t.offs[s] = w.b.Len()
	w.Raw(s)
}

func strRef(t strtab, w mut Buf, s string) {
	w.U32(s.Len())
	match t.offs.Get(s) {
	case option.Some as o:
		w.U32(o.Value)
	case option.None:
		w.U32(0)
	}
}

func symRef(w mut Buf, r SymRef) {
	w.U32(r.Pkg)
	w.U32(r.Idx)
}

func sym(t strtab, w mut Buf, name string, abi int, kind int, flag int, flag2 int, size int, align int) {
	t.strRef(w, name)
	w.U16(abi)
	w.U8(kind)
	w.U8(flag)
	w.U8(flag2)
	w.U32(size)
	w.U32(align)
}

// WriteObject is the bytes of o, from the magic on.
func WriteObject(o Object) string {
	let mut w = NewBuf()
	let mut t = strtab{offs: Map[string, int]{}}
	let mut offs = []int{}
	for _ in 0..NBlk {
		offs = offs.Append(0)
	}
	w.Raw(ObjMagic)
	w.Raw(o.Fingerprint)
	w.U32(0)
	for _ in 0..NBlk {
		w.U32(0)
	}
	t.addStr(&w, "")
	for imp in o.Autolib {
		t.addStr(&w, imp.Path)
	}
	for d in o.Defs {
		t.addStr(&w, d.Name)
	}
	for r in o.Refs {
		t.addStr(&w, r.Name)
	}
	for f in o.Files {
		t.addStr(&w, f)
	}
	offs[BlkAutolib] = w.Size()
	for imp in o.Autolib {
		t.strRef(&w, imp.Path)
		w.Raw(imp.Fingerprint)
	}
	offs[BlkPkgIdx] = w.Size()
	t.strRef(&w, "")
	offs[BlkFile] = w.Size()
	for f in o.Files {
		t.strRef(&w, f)
	}
	offs[BlkSymdef] = w.Size()
	for d in o.Defs {
		t.sym(&w, d.Name, d.ABI, d.Kind, d.Flag, d.Flag2, d.Size, d.Align)
	}
	offs[4] = w.Size()
	offs[5] = w.Size()
	offs[6] = w.Size()
	offs[BlkNonpkgref] = w.Size()
	for r in o.Refs {
		t.sym(&w, r.Name, r.ABI, 0, 0, 0, 0, 0)
	}
	offs[8] = w.Size()
	offs[9] = w.Size()
	offs[10] = w.Size()
	offs[BlkRelocIdx] = w.Size()
	let mut n = 0
	for d in o.Defs {
		w.U32(n)
		n = n + d.Relocs.Len()
	}
	w.U32(n)
	offs[BlkAuxIdx] = w.Size()
	n = 0
	for d in o.Defs {
		w.U32(n)
		n = n + d.Aux.Len()
	}
	w.U32(n)
	offs[BlkDataIdx] = w.Size()
	n = 0
	for d in o.Defs {
		w.U32(n)
		n = n + d.Data.Len()
	}
	w.U32(n)
	offs[BlkReloc] = w.Size()
	for d in o.Defs {
		for r in sortedRelocs(d.Relocs) {
			w.U32(r.Off)
			w.U8(r.Size)
			w.U16(r.Type)
			w.U64(r.Add)
			w.symRef(r.Sym)
		}
	}
	offs[BlkAux] = w.Size()
	for d in o.Defs {
		for a in d.Aux {
			w.U8(a.Type)
			w.symRef(a.Sym)
		}
	}
	offs[BlkData] = w.Size()
	for d in o.Defs {
		w.Raw(d.Data)
	}
	offs[BlkRefName] = w.Size()
	offs[BlkEnd] = w.Size()
	for i, x in offs {
		w.Put32(8+8+4+4*i, x)
	}
	w.Bytes()
}

func sortedRelocs(rs []ObjReloc) []ObjReloc {
	let mut out = rs
	for i in 1..out.Len() {
		let mut j = i
		for j > 0 && out[j-1].Off > out[j].Off {
			let x = out[j]
			out[j] = out[j-1]
			out[j-1] = x
			j = j - 1
		}
	}
	out
}
