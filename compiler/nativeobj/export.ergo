import option
import sha256
import strings

// Unified export data (internal/pkgbits version 5) written into __.PKGDEF
// without sync markers: ten sections of elements, where each element holds
// a (section, index) reference table followed by encoded payload bytes.

// Sections (pkgbits.Section*).
let SecString = 0
let SecMeta = 1
let SecPosBase = 2
let SecPkg = 3
let SecName = 4
let SecType = 5
let SecObj = 6
let SecObjExt = 7
let SecObjDict = 8
let SecBody = 9
let NumSections = 10

// Codes (pkgbits.Type*, pkgbits.Obj*) and types2 basic kinds.
let TypeBasic = 0
let TypeNamed = 1
let TypePointer = 2
let TypeSlice = 3
let TypeSignature = 7
let TypeStruct = 8
let TypeInterface = 9
let ObjType = 2
let ObjFunc = 3
let ObjStub = 5
let BasicInt = 2

// RefEntry is one section/index reference of an encoded element.
type RefEntry { Sec int, Idx int }

// Enc is one pkgbits element under construction.
type Enc { refs []RefEntry, data Buf }

func newEnc() Enc { Enc{refs: []RefEntry{}, data: NewBuf()} }

// ExportW collects all sections of a pkgbits bitstream.
type ExportW { elems [][]string, strs Map[string, int] }

func newExportW() ExportW {
	let mut e = [][]string{}
	for _ in 0..NumSections {
		e = e.Append([]string{})
	}
	ExportW{elems: e, strs: Map[string, int]{}}
}

func reserve(x mut ExportW, sec int) int {
	let idx = x.elems[sec].Len()
	let mut s = x.elems[sec]
	s = s.Append("")
	x.elems[sec] = s
	idx
}

func put(x mut ExportW, sec int, idx int, e Enc) {
	let mut h = NewBuf()
	h.Uvarint(e.refs.Len())
	for r in e.refs {
		h.Uvarint(r.Sec)
		h.Uvarint(r.Idx)
	}
	h.Raw(e.data.Bytes())
	let mut s = x.elems[sec]
	s[idx] = h.Bytes()
	x.elems[sec] = s
}

func strIdx(x mut ExportW, s string) int {
	match x.strs.Get(s) {
	case option.Some as i:
		return i.Value
	case option.None:
	}
	let i = x.reserve(SecString)
	let mut sec = x.elems[SecString]
	sec[i] = s
	x.elems[SecString] = sec
	x.strs[s] = i
	i
}

// Rel writes a reference to element idx of section sec.
func Rel(e mut Enc, sec int, idx int) {
	for i, r in e.refs {
		if r.Sec == sec && r.Idx == idx {
			e.data.Uvarint(i)
			return
		}
	}
	e.refs = e.refs.Append(RefEntry{Sec: sec, Idx: idx})
	e.data.Uvarint(e.refs.Len() - 1)
}

func Str(e mut Enc, x mut ExportW, s string) { e.Rel(SecString, x.strIdx(s)) }

func Bool(e mut Enc, b bool) { e.data.U8(if b { 1 } else { 0 }) }

func Len(e mut Enc, n int) { e.data.Uvarint(n) }

func Int(e mut Enc, n int) { e.data.Varint(n) }

func typ(e mut Enc, t int) {
	e.Bool(false)
	e.Rel(SecType, t)
}

func pos(e mut Enc, nfiles int, file int, line int, col int) {
	if nfiles == 0 {
		e.Bool(false)
		return
	}
	let f = if file >= 0 && file < nfiles { file } else { 0 }
	let ln = if line > 0 { line } else { 1 }
	let c = if col > 0 { col } else { 1 }
	e.Bool(true)
	e.Rel(SecPosBase, f)
	e.Len(ln)
	e.Len(c)
}

func selector(e mut Enc, x mut ExportW, pkgIdx int, name string) {
	e.Rel(SecPkg, pkgIdx)
	e.Str(x, name)
}

func param(e mut Enc, x mut ExportW, self int, t int) {
	e.Bool(false)
	e.Rel(SecPkg, self)
	e.Str(x, "")
	e.typ(t)
}

func params(e mut Enc, x mut ExportW, self int, ts []int) {
	e.Len(ts.Len())
	for t in ts {
		e.param(x, self, t)
	}
}

func signature(e mut Enc, x mut ExportW, self int, ps []int, rs []int) {
	e.params(x, self, ps)
	e.params(x, self, rs)
	e.Bool(false)
}

func emptyDict(x mut ExportW, o int) {
	let mut dict = newEnc()
	for _ in 0..8 {
		dict.Len(0)
	}
	x.put(SecObjDict, o, dict)
}

func writeStructBody(e mut Enc, x mut ExportW, self int, nfiles int, fields []FieldDef) {
	e.Len(TypeStruct)
	e.Len(fields.Len())
	for fd in fields {
		e.pos(nfiles, 0, 1, 1)
		e.selector(x, self, fd.Name)
		e.typ(fd.Type)
		e.Str(x, "")
		e.Bool(false)
	}
}

func writeIfaceBody(e mut Enc, p Package, x mut ExportW, self int, nfiles int, methods []MethodDef) {
	e.Len(TypeInterface)
	e.Len(methods.Len())
	e.Len(0)
	for md in methods {
		let sig = p.Types[md.Type]
		e.pos(nfiles, 0, 1, 1)
		e.selector(x, self, md.Name)
		e.signature(x, self, sig.Params, sig.Results)
	}
}

func hasDot(name string) bool {
	for i in 0..name.Len() {
		if name[i] == byte('.') {
			return true
		}
	}
	false
}

func methodNamePart(name string) string {
	for i in 0..name.Len() {
		let k = name.Len() - 1 - i
		if name[k] == byte('.') {
			return name[k+1 : name.Len()]
		}
	}
	""
}

func methodsForStruct(p Package, structName string) []int {
	let valPrefix = structName + "."
	let ptrPrefix = "(*" + structName + ")."
	let mut out = []int{}
	for i, f in p.Funcs {
		if (strings.HasPrefix(f.Name, valPrefix) || strings.HasPrefix(f.Name, ptrPrefix)) && f.Params.Len() > 0 && Exported(methodNamePart(f.Name)) {
			out = out.Append(i)
		}
	}
	out
}

func pkgIndexOf(p Package, pkgPath string) int {
	for i, imp in p.Imports {
		if imp.Path == pkgPath {
			return 1 + i
		}
	}
	0
}

// ExportBlobWithSyms writes the pkgbits export data of p using explicit
// object symbol indices for local named structs and returns (blob, fingerprint).
func ExportBlobWithSyms(p Package, typeSyms []int, ptrTypeSyms []int) (string, string) {
	let mut x = newExportW()
	let pub = x.reserve(SecMeta)
	let priv = x.reserve(SecMeta)
	let self = x.reserve(SecPkg)
	let mut impIdx = []int{}
	for imp in p.Imports {
		let i = x.reserve(SecPkg)
		let mut e = newEnc()
		e.Str(&x, imp.Path)
		e.Str(&x, imp.Name)
		e.Len(0)
		x.put(SecPkg, i, e)
		impIdx = impIdx.Append(i)
	}
	let mut pe = newEnc()
	pe.Str(&x, p.Path)
	pe.Str(&x, p.Name)
	pe.Len(impIdx.Len())
	for i in impIdx {
		pe.Rel(SecPkg, i)
	}
	x.put(SecPkg, self, pe)
	let files = PkgFiles(p)
	if files.Len() == 0 {
		let base = x.reserve(SecPosBase)
		let mut be = newEnc()
		be.Str(&x, p.File)
		be.Bool(true)
		x.put(SecPosBase, base, be)
	} else {
		for file in files {
			let base = x.reserve(SecPosBase)
			let mut be = newEnc()
			be.Str(&x, file)
			be.Bool(true)
			x.put(SecPosBase, base, be)
		}
	}
	let nfiles = if files.Len() == 0 { 1 } else { files.Len() }
	for _ in p.Types {
		x.reserve(SecType)
	}
	let mut objs = []int{}
	for t, d in p.Types {
		let mut e = newEnc()
		if KindIsBasic(d.Kind) {
			e.Len(TypeBasic)
			e.Len(KindExportBasic(d.Kind))
		} else if d.Kind == KPtr {
			e.Len(TypePointer)
			e.typ(d.Elem)
		} else if d.Kind == KSlice {
			e.Len(TypeSlice)
			e.typ(d.Elem)
		} else if d.Kind == KStruct && d.Name == "" {
			e.writeStructBody(&x, self, nfiles, d.Fields)
		} else if d.Kind == KStruct {
			let local = d.PkgPath == "" || d.PkgPath == p.Path
			let owner = if local { self } else { pkgIndexOf(p, d.PkgPath) }
			let o = x.reserve(SecObj)
			x.reserve(SecObjExt)
			x.reserve(SecName)
			x.reserve(SecObjDict)
			let u = x.reserve(SecType)
			let mut ue = newEnc()
			ue.writeStructBody(&x, owner, nfiles, d.Fields)
			x.put(SecType, u, ue)
			let meths = if local { methodsForStruct(p, d.Name) } else { []int{} }
			let mut w = newEnc()
			w.pos(nfiles, 0, 1, 1)
			w.typ(u)
			w.Len(meths.Len())
			for mi, fi in meths {
				let f = p.Funcs[fi]
				let mname = methodNamePart(f.Name)
				w.Len(mi)
				w.pos(nfiles, f.File, f.Line, f.Col)
				w.selector(&x, owner, mname)
				w.param(&x, owner, f.Params[0])
				w.signature(&x, owner, f.Params[1:f.Params.Len()], f.Results)
				w.pos(nfiles, f.File, f.Line, f.Col)
			}
			w.Len(0)
			x.put(SecObj, o, w)
			let mut ext = newEnc()
			ext.Int(0)
			ext.Int(if local { typeSyms[t] } else { -1 })
			ext.Int(if local { ptrTypeSyms[t] } else { -1 })
			for fi in meths {
				let f = p.Funcs[fi]
				ext.Int(0)
				ext.Int(fi)
				ext.Bool(true)
				ext.Len(ABIInternal)
				for _ in f.Params {
					ext.Str(&x, "")
				}
				ext.Bool(false)
			}
			x.put(SecObjExt, o, ext)
			let mut name = newEnc()
			name.Rel(SecPkg, owner)
			name.Str(&x, d.Name)
			name.Len(ObjType)
			x.put(SecName, o, name)
			emptyDict(&x, o)
			if local && d.Exported {
				objs = objs.Append(o)
			}
			e.Len(TypeNamed)
			e.Rel(SecObj, o)
			e.Len(0)
		} else if d.Kind == KIface && (d.Name == "" || (d.Name == "error" && d.PkgPath == "")) {
			e.writeIfaceBody(p, &x, self, nfiles, d.Methods)
		} else if d.Kind == KIface {
			let local = d.PkgPath == "" || d.PkgPath == p.Path
			let owner = if local { self } else { pkgIndexOf(p, d.PkgPath) }
			let o = x.reserve(SecObj)
			x.reserve(SecObjExt)
			x.reserve(SecName)
			x.reserve(SecObjDict)
			let u = x.reserve(SecType)
			let mut ue = newEnc()
			ue.writeIfaceBody(p, &x, owner, nfiles, d.Methods)
			x.put(SecType, u, ue)
			let mut w = newEnc()
			w.pos(nfiles, 0, 1, 1)
			w.typ(u)
			w.Len(0)
			w.Len(0)
			x.put(SecObj, o, w)
			let mut ext = newEnc()
			ext.Int(0)
			ext.Int(if local { typeSyms[t] } else { -1 })
			ext.Int(if local { ptrTypeSyms[t] } else { -1 })
			x.put(SecObjExt, o, ext)
			let mut name = newEnc()
			name.Rel(SecPkg, owner)
			name.Str(&x, d.Name)
			name.Len(ObjType)
			x.put(SecName, o, name)
			emptyDict(&x, o)
			if local && d.Exported {
				objs = objs.Append(o)
			}
			e.Len(TypeNamed)
			e.Rel(SecObj, o)
			e.Len(0)
		} else {
			e.Len(TypeSignature)
			e.signature(&x, self, d.Params, d.Results)
		}
		x.put(SecType, t, e)
	}
	for i, f in p.Funcs {
		if hasDot(f.Name) || !Exported(f.Name) {
			continue
		}
		let o = x.reserve(SecObj)
		x.reserve(SecObjExt)
		x.reserve(SecName)
		x.reserve(SecObjDict)
		let mut w = newEnc()
		w.pos(nfiles, f.File, f.Line, f.Col)
		w.Bool(false)
		w.signature(&x, self, f.Params, f.Results)
		w.pos(nfiles, f.File, f.Line, f.Col)
		x.put(SecObj, o, w)
		let mut ext = newEnc()
		ext.Int(0)
		ext.Int(i)
		ext.Bool(true)
		ext.Len(ABIInternal)
		for _ in f.Params {
			ext.Str(&x, "")
		}
		ext.Bool(false)
		x.put(SecObjExt, o, ext)
		let mut name = newEnc()
		name.Rel(SecPkg, self)
		name.Str(&x, f.Name)
		name.Len(ObjFunc)
		x.put(SecName, o, name)
		emptyDict(&x, o)
		objs = objs.Append(o)
	}
	let mut root = newEnc()
	root.Rel(SecPkg, self)
	root.Len(objs.Len())
	for o in objs {
		root.Rel(SecObj, o)
		root.Len(0)
	}
	x.put(SecMeta, pub, root)
	let mut proot = newEnc()
	proot.Bool(NeedInitTask(p))
	proot.Len(0)
	x.put(SecMeta, priv, proot)
	let mut w = NewBuf()
	w.U32(ExportVersion)
	w.U32(0)
	let mut sum = 0
	for s in x.elems {
		sum = sum + s.Len()
		w.U32(sum)
	}
	sum = 0
	for s in x.elems {
		for el in s {
			sum = sum + el.Len()
			w.U32(sum)
		}
	}
	for s in x.elems {
		for el in s {
			w.Raw(el)
		}
	}
	let body = w.Bytes()
	let fp = sha256.Sum(body)[0:8]
	(body + fp, fp)
}

// ExportBlob is the export data of p (what follows "$$B\nu"), with its
// fingerprint at the end, and that fingerprint.
func ExportBlob(p Package) (string, string) {
	let (_, typeSyms, ptrTypeSyms) = PlanTypeSyms(p)
	ExportBlobWithSyms(p, typeSyms, ptrTypeSyms)
}

// PkgDef is the __.PKGDEF member: the object header, a blank line, then
// the export data between "$$B\nu" and "\n$$\n".
func PkgDef(header string, blob string) string { header + "\n" + "\n$$B\n" + "u" + blob + "\n$$\n" }
