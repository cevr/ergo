import compiler/ir
import compiler/ir/handoff
import option
import slices
import strings

// PinProfile is the one compiler flag profile this backend serves.
let PinProfile = "plain"

// ForeignFunc describes one foreign function referenced by a package
// when encoding an EIR v1 handoff image.
type ForeignFunc {
	Import  int,
	Name    string,
	Params  []int,
	Results []int,
}

func hword(img handoff.Image, s int, i int, col int) uint32 fails Malformed {
	match handoff.Word(img, s, i, col) {
	case option.Some as w:
		w.Value
	case option.None:
		return Malformed{Why: "missing handoff word at section \(s) row \(i) col \(col)"}
	}
}

func hname(img handoff.Image, id uint32) string fails Malformed {
	match handoff.Name(img, id) {
	case option.Some as n:
		n.Value
	case option.None:
		return Malformed{Why: "missing handoff name \(id)"}
	}
}

func hpos(img handoff.Image, span uint32) handoff.Position fails Malformed {
	match handoff.PositionOf(img, span) {
	case option.Some as p:
		p.Value
	case option.None:
		return Malformed{Why: "missing handoff span \(span)"}
	}
}

func encodeConst(v int) (uint32, uint32) {
	(uint32(v & 0xffffffff), uint32((v >> 32) & 0xffffffff))
}

func decodeConst(lo uint32, hi uint32) int {
	let hiSigned = if hi >= uint32(0x80000000) { int(hi) - 4294967296 } else { int(hi) }
	(hiSigned << 32) | int(lo)
}

func u32PairBytes(lo uint32, hi uint32) string {
	let mut w = NewBuf()
	w.U32(int(lo))
	w.U32(int(hi))
	w.Bytes()
}

func fpWords(fp string) (uint32, uint32) fails handoff.Malformed {
	if fp.Len() != 8 {
		return handoff.Malformed{Section: ir.HImports, Row: -1, Why: "import fingerprint must be 8 bytes"}
	}
	let lo = uint32(fp[0]) | uint32(fp[1])<<8 | uint32(fp[2])<<16 | uint32(fp[3])<<24
	let hi = uint32(fp[4]) | uint32(fp[5])<<8 | uint32(fp[6])<<16 | uint32(fp[7])<<24
	(lo, hi)
}

func arithKind(opcode uint32) int fails Refused {
	if opcode == ir.HOAdd {
		return AAdd
	}
	if opcode == ir.HOSub {
		return ASub
	}
	if opcode == ir.HOMul {
		return AMul
	}
	if opcode == ir.HOXor {
		return AXor
	}
	if opcode == handoff.HODiv {
		return ADiv
	}
	if opcode == handoff.HORem {
		return ARem
	}
	if opcode == handoff.HOBitAnd {
		return AAnd
	}
	if opcode == handoff.HOBitOr {
		return AOr
	}
	if opcode == handoff.HOBitAndNot {
		return AAndNot
	}
	if opcode == handoff.HOShl {
		return AShl
	}
	if opcode == handoff.HOShr {
		return AShr
	}
	return Refused{Why: "unsupported arithmetic opcode \(opcode)"}
}

func arithOpcode(kind int) uint32 {
	if kind == AAdd { return ir.HOAdd }
	if kind == ASub { return ir.HOSub }
	if kind == AMul { return ir.HOMul }
	if kind == AXor { return ir.HOXor }
	if kind == ADiv { return handoff.HODiv }
	if kind == ARem { return handoff.HORem }
	if kind == AAnd { return handoff.HOBitAnd }
	if kind == AOr { return handoff.HOBitOr }
	if kind == AAndNot { return handoff.HOBitAndNot }
	if kind == AShl { return handoff.HOShl }
	handoff.HOShr
}

func basicKindFromHandoff(aux uint32) int fails Refused {
	if aux == handoff.HBasicBool { return KBool }
	if aux == ir.HBasicInt { return KInt }
	if aux == handoff.HBasicInt8 { return KInt8 }
	if aux == handoff.HBasicInt16 { return KInt16 }
	if aux == handoff.HBasicInt32 { return KInt32 }
	if aux == handoff.HBasicInt64 { return KInt64 }
	if aux == handoff.HBasicUint { return KUint }
	if aux == handoff.HBasicUint8 { return KUint8 }
	if aux == handoff.HBasicUint16 { return KUint16 }
	if aux == handoff.HBasicUint32 { return KUint32 }
	if aux == handoff.HBasicUint64 { return KUint64 }
	if aux == handoff.HBasicUintptr { return KUintptr }
	if aux == handoff.HBasicString { return KString }
	Refused{Why: "unsupported handoff scalar type \(aux)"}
}

func typeDefFromBasic(aux uint32) TypeDef fails Refused {
	if aux == ir.HBasicAny {
		return AnyType()
	}
	BasicType(try basicKindFromHandoff(aux))
}

func branchCond(cond uint32) int fails Malformed {
	if cond == ir.HCLess {
		return CLt
	}
	if cond == ir.HCNotEqual {
		return CNe
	}
	if cond == ir.HCEqual {
		return CEq
	}
	if cond == ir.HCAtLeast {
		return CGe
	}
	return Malformed{Why: "unknown branch condition \(cond)"}
}

func fieldShortName(s string) string {
	let mut dot = -1
	for i in 0..s.Len() {
		if int(s[i]) == 46 {
			dot = i
		}
	}
	if dot >= 0 { s[dot+1 : s.Len()] } else { s }
}

func translateTypes(img handoff.Image, imports []Import) ([]TypeDef, Map[int, int]) fails Refused | Malformed {
	let n = handoff.Rows(img, ir.HTypes)
	let mut out = slices.WithCapacity[TypeDef](n)
	let mut fieldToIdx = Map[int, int]{}
	for i in 0..n {
		let k = try hword(img, ir.HTypes, i, 0)
		let aux = try hword(img, ir.HTypes, i, 1)
		let lo = int(try hword(img, ir.HTypes, i, 2))
		let cnt = int(try hword(img, ir.HTypes, i, 3))
		if k == ir.HTBasic {
			out = out.Append(try typeDefFromBasic(aux))
		} else if k == ir.HTPointer {
			let elem = int(try hword(img, ir.HOperands, lo, 0)) - 1
			out = out.Append(PtrType(elem))
		} else if k == ir.HTSlice {
			let elem = int(try hword(img, ir.HOperands, lo, 0)) - 1
			out = out.Append(SliceType(elem))
		} else if k == ir.HTRecord {
			let mut fields = slices.WithCapacity[FieldDef](cnt)
			for j in 0..cnt {
				let fsym = int(try hword(img, ir.HOperands, lo+j, 0))
				let fIdx = fsym - 1
				let rawName = try hname(img, try hword(img, ir.HSymbols, fIdx, 1))
				let short = fieldShortName(rawName)
				let fty = int(try hword(img, ir.HSymbols, fIdx, 3)) - 1
				fieldToIdx[fsym] = j
				fields = fields.Append(FieldDef{Name: short, Type: fty, Exported: Exported(short)})
			}
			out = out.Append(StructType("", "", false, fields))
		} else if k == ir.HTInterface {
			let mut meths = slices.WithCapacity[MethodDef](cnt)
			for j in 0..cnt {
				let msym = int(try hword(img, ir.HOperands, lo+j, 0))
				let mIdx = msym - 1
				let rawName = try hname(img, try hword(img, ir.HSymbols, mIdx, 1))
				let short = fieldShortName(rawName)
				let mty = int(try hword(img, ir.HSymbols, mIdx, 3)) - 1
				meths = meths.Append(MethodDef{Name: short, Type: mty, Exported: Exported(short)})
			}
			out = out.Append(IfaceType("", "", false, meths))
		} else if k == ir.HTNamed {
			out = out.Append(StructType("", "", false, []FieldDef{}))
		} else if k == ir.HTSignature {
			let nParam = int(aux)
			let mut ps = slices.WithCapacity[int](nParam)
			for j in 0..nParam {
				ps = ps.Append(int(try hword(img, ir.HOperands, lo+j, 0)) - 1)
			}
			let mut rs = slices.WithCapacity[int](cnt - nParam)
			for j in nParam..cnt {
				rs = rs.Append(int(try hword(img, ir.HOperands, lo+j, 0)) - 1)
			}
			out = out.Append(FuncType(ps, rs))
		} else {
			return Refused{Why: "unsupported handoff type kind \(k) at row \(i)"}
		}
	}
	for i in 0..n {
		let k = try hword(img, ir.HTypes, i, 0)
		if k != ir.HTNamed {
			continue
		}
		let symIdx = int(try hword(img, ir.HTypes, i, 1)) - 1
		let lo = int(try hword(img, ir.HTypes, i, 2))
		let under = int(try hword(img, ir.HOperands, lo, 0)) - 1
		let imp = int(try hword(img, ir.HSymbols, symIdx, 0))
		let name = try hname(img, try hword(img, ir.HSymbols, symIdx, 1))
		let pkgPath = if imp > 0 { imports[imp-1].Path } else { "" }
		if out[under].Kind == KStruct {
			out[i] = StructType(name, pkgPath, Exported(name), out[under].Fields)
		} else if out[under].Kind == KIface {
			out[i] = IfaceType(name, pkgPath, Exported(name), out[under].Methods)
		} else {
			return Refused{Why: "unsupported named non-record type at row \(i)"}
		}
	}
	(out, fieldToIdx)
}

func fieldIndexOf(fieldToIdx Map[int, int], fsym int, fnName string) int fails Malformed {
	match fieldToIdx.Get(fsym) {
	case option.Some as fi:
		fi.Value
	case option.None:
		return Malformed{Why: "\(fnName): unknown field symbol \(fsym)"}
	}
}

func hasPtrTypes(types []TypeDef, t int) bool {
	let td = types[t]
	if td.Kind == KPtr || td.Kind == KFunc || td.Kind == KString || td.Kind == KSlice || td.Kind == KIface {
		return true
	}
	if td.Kind == KStruct {
		for fd in td.Fields {
			if hasPtrTypes(types, fd.Type) {
				return true
			}
		}
	}
	false
}

func translateBody(img handoff.Image, types []TypeDef, fieldToIdx Map[int, int], symToGlobal []int, symCallTarget []string, bi int, si int, fnName string, sig TypeDef) Func fails Refused | Malformed {
	let bodySym = try hword(img, ir.HBodies, bi, 0)
	if bodySym != uint32(si+1) {
		return Malformed{Why: "body \(bi) belongs to symbol \(bodySym), expected \(si + 1)"}
	}
	let declSpan = try hword(img, ir.HSymbols, si, 4)
	let declPos = try hpos(img, declSpan)
	let declFile = int(try hword(img, ir.HSpans, int(declSpan)-1, 0)) - 1
	let firstSlot = int(try hword(img, ir.HBodies, bi, 1))
	let nSlots = int(try hword(img, ir.HBodies, bi, 2))
	let firstOp = int(try hword(img, ir.HBodies, bi, 3))
	let nOps = int(try hword(img, ir.HBodies, bi, 4))
	let mut slots = slices.WithCapacity[int](nSlots)
	for k in 0..nSlots {
		slots = slots.Append(int(try hword(img, ir.HSlots, firstSlot+k, 0)) - 1)
	}
	let mut needLabel = slices.WithCapacity[bool](nOps)
	for _ in 0..nOps {
		needLabel = needLabel.Append(false)
	}
	for j in 0..nOps {
		let opcode = try hword(img, ir.HOps, firstOp+j, 0)
		let lo = int(try hword(img, ir.HOps, firstOp+j, 2))
		if opcode == ir.HOJump {
			let t = int(try hword(img, ir.HOperands, lo, 0)) - 1
			needLabel[t] = true
		} else if opcode == ir.HOBranch {
			let yesT = int(try hword(img, ir.HOperands, lo+3, 0)) - 1
			let noT = int(try hword(img, ir.HOperands, lo+4, 0)) - 1
			needLabel[yesT] = true
			if noT != j+1 {
				needLabel[noT] = true
			}
		}
	}
	let mut ops = []Op{}
	let mut lines = []int{}
	for j in 0..nOps {
		let opcode = try hword(img, ir.HOps, firstOp+j, 0)
		let span = try hword(img, ir.HOps, firstOp+j, 1)
		let lo = int(try hword(img, ir.HOps, firstOp+j, 2))
		let n = int(try hword(img, ir.HOps, firstOp+j, 3))
		let line = (try hpos(img, span)).Line
		if needLabel[j] {
			ops = ops.Append(Label{Id: j})
			lines = lines.Append(line)
		}
		if opcode == ir.HOConst {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let wlo = try hword(img, ir.HOperands, lo+1, 0)
			let whi = try hword(img, ir.HOperands, lo+2, 0)
			let dk = types[slots[dst]].Kind
			if dk == KString {
				let s = if wlo == uint32(0) { "" } else { try hname(img, wlo) }
				ops = ops.Append(ConstStr{Dst: dst, V: s})
			} else if dk == KBool || KindIsInt(dk) {
				ops = ops.Append(Const{Dst: dst, V: decodeConst(wlo, whi)})
			} else if wlo == uint32(0) && whi == uint32(0) {
				ops = ops.Append(Zero{Dst: dst})
			} else {
				return Refused{Why: "\(fnName): unsupported constant into slot \(dst)"}
			}
			lines = lines.Append(line)
		} else if opcode == ir.HOAdd || opcode == ir.HOSub || opcode == ir.HOMul || opcode == ir.HOXor ||
			opcode == handoff.HODiv || opcode == handoff.HORem || opcode == handoff.HOBitAnd ||
			opcode == handoff.HOBitOr || opcode == handoff.HOBitAndNot || opcode == handoff.HOShl || opcode == handoff.HOShr {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let lhs = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let rhs = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			let dk = types[slots[dst]].Kind
			if !KindIsInt(dk) && !(opcode == ir.HOAdd && dk == KString) {
				return Refused{Why: "\(fnName): unsupported arithmetic on slot \(dst)"}
			}
			ops = ops.Append(Arith{Dst: dst, Kind: try arithKind(opcode), A: lhs, B: rhs})
			lines = lines.Append(line)
		} else if opcode == ir.HOConvert {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let src = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			ops = ops.Append(Convert{Dst: dst, Src: src})
			lines = lines.Append(line)
		} else if opcode == handoff.HOLen {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let src = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			ops = ops.Append(Len{Dst: dst, Src: src})
			lines = lines.Append(line)
		} else if opcode == ir.HOLoad {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let ptr = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			if types[slots[ptr]].Kind != KPtr || types[slots[ptr]].Elem != slots[dst] {
				return Malformed{Why: "\(fnName): load through slot \(ptr) does not match slot \(dst)"}
			}
			ops = ops.Append(Load{Dst: dst, Ptr: ptr})
			lines = lines.Append(line)
		} else if opcode == ir.HOStore {
			let ptr = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let val = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			if types[slots[ptr]].Kind != KPtr || types[slots[ptr]].Elem != slots[val] {
				return Malformed{Why: "\(fnName): store through slot \(ptr) does not match slot \(val)"}
			}
			if hasPtrTypes(types, slots[val]) {
				ops = ops.Append(StorePtr{Ptr: ptr, Val: val})
			} else {
				ops = ops.Append(Store{Ptr: ptr, Val: val})
			}
			lines = lines.Append(line)
		} else if opcode == ir.HOAddrOf {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let src = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			if types[slots[dst]].Kind != KPtr || types[slots[dst]].Elem != slots[src] {
				return Malformed{Why: "\(fnName): addr-of slot \(src) does not match pointer slot \(dst)"}
			}
			ops = ops.Append(AddrOf{Dst: dst, Of: src})
			lines = lines.Append(line)
		} else if opcode == handoff.HOFieldGet {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let base = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let fsym = int(try hword(img, ir.HOperands, lo+2, 0))
			ops = ops.Append(FieldGet{Dst: dst, Base: base, Field: try fieldIndexOf(fieldToIdx, fsym, fnName)})
			lines = lines.Append(line)
		} else if opcode == handoff.HOFieldSet {
			let ptr = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let fsym = int(try hword(img, ir.HOperands, lo+1, 0))
			let val = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			ops = ops.Append(FieldSet{Ptr: ptr, Field: try fieldIndexOf(fieldToIdx, fsym, fnName), Val: val})
			lines = lines.Append(line)
		} else if opcode == handoff.HORecordLit {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let mut vals = slices.WithCapacity[int](n - 1)
			for k in 1..n {
				vals = vals.Append(int(try hword(img, ir.HOperands, lo+k, 0)) - 1)
			}
			ops = ops.Append(RecordLit{Dst: dst, Vals: vals})
			lines = lines.Append(line)
		} else if opcode == handoff.HOIndex {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let sl = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let ix = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			ops = ops.Append(Index{Dst: dst, Slice: sl, Idx: ix})
			lines = lines.Append(line)
		} else if opcode == handoff.HOSliceLit {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let mut elems = slices.WithCapacity[int](n - 1)
			for k in 1..n {
				elems = elems.Append(int(try hword(img, ir.HOperands, lo+k, 0)) - 1)
			}
			ops = ops.Append(SliceLit{Dst: dst, Elems: elems})
			lines = lines.Append(line)
		} else if opcode == ir.HOGetGlobal {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let symIdx = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let g = symToGlobal[symIdx]
			if g < 0 {
				return Refused{Why: "\(fnName): unsupported global symbol \(symIdx)"}
			}
			ops = ops.Append(GetGlobal{Dst: dst, Global: g})
			lines = lines.Append(line)
		} else if opcode == ir.HOSetGlobal {
			let symIdx = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let src = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let g = symToGlobal[symIdx]
			if g < 0 {
				return Refused{Why: "\(fnName): unsupported global symbol \(symIdx)"}
			}
			ops = ops.Append(SetGlobal{Global: g, Src: src})
			lines = lines.Append(line)
		} else if opcode == ir.HOCall {
			let symIdx = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let target = symCallTarget[symIdx]
			if target == "" {
				return Refused{Why: "\(fnName): call target symbol \(symIdx) is not callable"}
			}
			let nRes = int(try hword(img, ir.HOperands, lo+1, 0))
			let mut dsts = slices.WithCapacity[int](nRes)
			for r in 0..nRes {
				dsts = dsts.Append(int(try hword(img, ir.HOperands, lo+2+r, 0)) - 1)
			}
			let nArg = n - 2 - nRes
			let mut args = slices.WithCapacity[int](nArg)
			for a in 0..nArg {
				args = args.Append(int(try hword(img, ir.HOperands, lo+2+nRes+a, 0)) - 1)
			}
			ops = ops.Append(Call{Dsts: dsts, Target: target, Args: args})
			lines = lines.Append(line)
		} else if opcode == ir.HOCallClosure {
			let fnSlot = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let nRes = int(try hword(img, ir.HOperands, lo+1, 0))
			let mut dsts = slices.WithCapacity[int](nRes)
			for r in 0..nRes {
				dsts = dsts.Append(int(try hword(img, ir.HOperands, lo+2+r, 0)) - 1)
			}
			let nArg = n - 2 - nRes
			let mut args = slices.WithCapacity[int](nArg)
			for a in 0..nArg {
				args = args.Append(int(try hword(img, ir.HOperands, lo+2+nRes+a, 0)) - 1)
			}
			ops = ops.Append(CallClosure{Dsts: dsts, Fn: fnSlot, Args: args})
			lines = lines.Append(line)
		} else if opcode == handoff.HOAlloc {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			ops = ops.Append(Alloc{Dst: dst})
			lines = lines.Append(line)
		} else if opcode == handoff.HOMakeClosure {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let symIdx = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let target = symCallTarget[symIdx]
			if target == "" {
				return Refused{Why: "\(fnName): closure target symbol \(symIdx) is not callable"}
			}
			let env = if n >= 3 { int(try hword(img, ir.HOperands, lo+2, 0)) - 1 } else { -1 }
			ops = ops.Append(MakeClosure{Dst: dst, Target: target, Env: env})
			lines = lines.Append(line)
		} else if opcode == handoff.HOClosureEnv {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			ops = ops.Append(ClosureEnv{Dst: dst})
			lines = lines.Append(line)
		} else if opcode == handoff.HOAppend {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let sl = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let el = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			ops = ops.Append(Append{Dst: dst, Slice: sl, Elem: el})
			lines = lines.Append(line)
		} else if opcode == handoff.HOSlice {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let src = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let loIdx = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			let hiIdx = int(try hword(img, ir.HOperands, lo+3, 0)) - 1
			ops = ops.Append(SliceOp{Dst: dst, Src: src, Lo: loIdx, Hi: hiIdx})
			lines = lines.Append(line)
		} else if opcode == handoff.HOStringIndex {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let str = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let ix = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			ops = ops.Append(StringIndex{Dst: dst, Str: str, Idx: ix})
			lines = lines.Append(line)
		} else if opcode == handoff.HOMakeIface {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let src = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			ops = ops.Append(MakeIface{Dst: dst, Src: src})
			lines = lines.Append(line)
		} else if opcode == handoff.HOIfaceIs {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let iface = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let concrete = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			ops = ops.Append(IfaceIs{Dst: dst, Iface: iface, ConcreteType: concrete})
			lines = lines.Append(line)
		} else if opcode == handoff.HOIfaceData {
			let dst = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let iface = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			ops = ops.Append(IfaceData{Dst: dst, Iface: iface})
			lines = lines.Append(line)
		} else if opcode == handoff.HOCallIface {
			let iface = int(try hword(img, ir.HOperands, lo, 0)) - 1
			let methIdx = int(try hword(img, ir.HOperands, lo+1, 0))
			let nRes = int(try hword(img, ir.HOperands, lo+2, 0))
			let mut dsts = slices.WithCapacity[int](nRes)
			for r in 0..nRes {
				dsts = dsts.Append(int(try hword(img, ir.HOperands, lo+3+r, 0)) - 1)
			}
			let nArg = n - 3 - nRes
			let mut args = slices.WithCapacity[int](nArg)
			for a in 0..nArg {
				args = args.Append(int(try hword(img, ir.HOperands, lo+3+nRes+a, 0)) - 1)
			}
			ops = ops.Append(CallIface{Dsts: dsts, Iface: iface, Method: methIdx, Args: args})
			lines = lines.Append(line)
		} else if opcode == ir.HOJump {
			let t = int(try hword(img, ir.HOperands, lo, 0)) - 1
			ops = ops.Append(Jump{To: t})
			lines = lines.Append(line)
		} else if opcode == ir.HOBranch {
			let cond = try branchCond(try hword(img, ir.HOperands, lo, 0))
			let lhs = int(try hword(img, ir.HOperands, lo+1, 0)) - 1
			let rhs = int(try hword(img, ir.HOperands, lo+2, 0)) - 1
			let ak = types[slots[lhs]].Kind
			if !KindIsInt(ak) && ak != KString && !((cond == CEq || cond == CNe) && (ak == KBool || ak == KPtr || ak == KFunc || ak == KIface)) {
				return Refused{Why: "\(fnName): unsupported branch on slot \(lhs)"}
			}
			let yesT = int(try hword(img, ir.HOperands, lo+3, 0)) - 1
			let noT = int(try hword(img, ir.HOperands, lo+4, 0)) - 1
			ops = ops.Append(JumpIf{Cond: cond, A: lhs, B: rhs, To: yesT})
			lines = lines.Append(line)
			if noT != j+1 {
				ops = ops.Append(Jump{To: noT})
				lines = lines.Append(line)
			}
		} else if opcode == ir.HOReturn {
			let mut vals = slices.WithCapacity[int](n)
			for r in 0..n {
				vals = vals.Append(int(try hword(img, ir.HOperands, lo+r, 0)) - 1)
			}
			ops = ops.Append(Return{Vals: vals})
			lines = lines.Append(line)
		} else {
			return Refused{Why: "\(fnName): unsupported handoff opcode \(opcode)"}
		}
	}
	Func{Name: fnName, Params: sig.Params, Results: sig.Results, Slots: slots, Ops: ops, Lines: lines, Line: declPos.Line, Col: int(declPos.Column), File: declFile}
}

// FromHandoff decodes and admits a frozen EIR v1 binary wire image against
// want, then translates it into a validated nativeobj Package. Unsupported
// targets, stale imports, malformed wire images, or unsupported types,
// symbols, instances, and ops are refused fail-closed.
func FromHandoff(wire string, want handoff.Expect) Package fails handoff.UnknownVersion | handoff.Malformed | handoff.WrongTarget | handoff.StaleImport | Refused | Malformed {
	if want.Target.GOOS != PinGOOS || want.Target.GOARCH != PinGOARCH || want.Target.Pin != PinGo || want.Target.Profile != PinProfile {
		return Refused{Why: "unsupported target tuple \(want.Target.GOOS)/\(want.Target.GOARCH) \(want.Target.Pin) \(want.Target.Profile)"}
	}
	let img = try handoff.Decode(wire)
	try handoff.Admit(img, want)
	if handoff.Rows(img, ir.HInstances) > 0 {
		return Refused{Why: "generic specialization instances are not supported"}
	}
	let nFiles = handoff.Rows(img, ir.HFiles)
	if nFiles < 1 {
		return Malformed{Why: "nativeobj requires at least 1 source file"}
	}
	let pkgPath = try hname(img, try hword(img, ir.HPackage, 0, 0))
	let pkgName = try hname(img, try hword(img, ir.HPackage, 0, 1))
	let mut files = slices.WithCapacity[string](nFiles)
	for fi in 0..nFiles {
		files = files.Append(try hname(img, try hword(img, ir.HFiles, fi, 0)))
	}
	let nImps = handoff.Rows(img, ir.HImports)
	let mut imports = slices.WithCapacity[Import](nImps)
	for i in 0..nImps {
		let impPath = try hname(img, try hword(img, ir.HImports, i, 0))
		let impName = try hname(img, try hword(img, ir.HImports, i, 1))
		let hasInit = try hword(img, ir.HImports, i, 2) == uint32(1)
		let fp = u32PairBytes(try hword(img, ir.HImports, i, 3), try hword(img, ir.HImports, i, 4))
		imports = imports.Append(Import{Path: impPath, Name: impName, Fingerprint: fp, HasInit: hasInit})
	}
	let (types, fieldToIdx) = try translateTypes(img, imports)
	let nSyms = handoff.Rows(img, ir.HSymbols)
	let mut symToGlobal = slices.WithCapacity[int](nSyms)
	let mut symToLocalFunc = slices.WithCapacity[int](nSyms)
	let mut symCallTarget = slices.WithCapacity[string](nSyms)
	for _ in 0..nSyms {
		symToGlobal = symToGlobal.Append(-1)
		symToLocalFunc = symToLocalFunc.Append(-1)
		symCallTarget = symCallTarget.Append("")
	}
	let mut globals = []Global{}
	let mut localFuncSyms = []int{}
	let mut localFuncNames = []string{}
	let mut localFuncSigs = []TypeDef{}
	for si in 0..nSyms {
		let imp = try hword(img, ir.HSymbols, si, 0)
		let name = try hname(img, try hword(img, ir.HSymbols, si, 1))
		let kind = try hword(img, ir.HSymbols, si, 2)
		let ty = int(try hword(img, ir.HSymbols, si, 3)) - 1
		if kind == ir.HSType || kind == ir.HSField || kind == ir.HSMethod {
			continue
		} else if kind == ir.HSVar {
			let varPkg = if imp == uint32(0) { "" } else { imports[int(imp)-1].Path }
			symToGlobal[si] = globals.Len()
			globals = globals.Append(Global{PkgPath: varPkg, Name: name, Type: ty})
		} else if kind == ir.HSFunc {
			if types[ty].Kind != KFunc {
				return Refused{Why: "function \(name) has non-signature type"}
			}
			if imp == uint32(0) {
				let isInit = strings.HasPrefix(name, "init.")
				if !isInit && name == "init" {
					return Malformed{Why: "local function named init without init.N qualification"}
				}
				if !isInit {
					symCallTarget[si] = pkgPath + "." + name
				}
				symToLocalFunc[si] = localFuncSyms.Len()
				localFuncSyms = localFuncSyms.Append(si)
				localFuncNames = localFuncNames.Append(if isInit { "init" } else { name })
				localFuncSigs = localFuncSigs.Append(types[ty])
			} else {
				let impIdx = int(imp) - 1
				symCallTarget[si] = imports[impIdx].Path + "." + name
			}
		} else {
			return Refused{Why: "unsupported handoff symbol kind \(kind) for \(name)"}
		}
	}
	if handoff.Rows(img, ir.HBodies) != localFuncSyms.Len() {
		return Malformed{Why: "body count does not match local function count"}
	}
	let mut funcs = slices.WithCapacity[Func](localFuncSyms.Len())
	for bi, si in localFuncSyms {
		funcs = funcs.Append(try translateBody(img, types, fieldToIdx, symToGlobal, symCallTarget, bi, si, localFuncNames[bi], localFuncSigs[bi]))
	}
	let nInits = handoff.Rows(img, ir.HInit)
	let mut inits = slices.WithCapacity[int](nInits)
	for i in 0..nInits {
		let symIdx = int(try hword(img, ir.HInit, i, 0)) - 1
		let fnIdx = symToLocalFunc[symIdx]
		if fnIdx < 0 {
			return Malformed{Why: "init entry \(i) does not name a local function"}
		}
		inits = inits.Append(fnIdx)
	}
	let pkg = Package{Path: pkgPath, Name: pkgName, File: files[0], Files: files, Types: types, Imports: imports, Globals: globals, Funcs: funcs, Inits: inits}
	try Check(pkg)
	pkg
}

// ArchiveFromHandoff verifies the stock header line, decodes and admits
// the frozen EIR v1 wire image against want, translates it, and builds
// the Go package archive without invoking cmd/compile.
func ArchiveFromHandoff(wire string, want handoff.Expect, header string) Built fails handoff.UnknownVersion | handoff.Malformed | handoff.WrongTarget | handoff.StaleImport | Refused | Malformed | Undefined {
	try CheckHeader(header)
	let p = try FromHandoff(wire, want)
	try Archive(p, header)
}

type symEntry {
	imp       uint32,
	name      string,
	nameID    uint32,
	kind      uint32,
	typeID    uint32,
	spanID    uint32,
	localIdx  int,
	globalID  int,
	callKey   string,
	structIdx int,
	fieldIdx  int,
}

func sortUniqueStrings(xs []string) []string {
	let mut out = []string{}
	for x in xs {
		let mut seen = false
		for y in out {
			if y == x {
				seen = true
			}
		}
		if !seen {
			out = out.Append(x)
		}
	}
	for i in 1..out.Len() {
		let mut j = i
		for j > 0 && out[j-1] > out[j] {
			let tmp = out[j]
			out[j] = out[j-1]
			out[j-1] = tmp
			j = j - 1
		}
	}
	out
}

func findNameID(names []string, s string) uint32 fails handoff.Malformed {
	for i, x in names {
		if x == s {
			return uint32(i + 1)
		}
	}
	return handoff.Malformed{Section: ir.HNames, Row: -1, Why: "uninterned name \(s)"}
}

func findOrAddSig(types []TypeDef, ps []int, rs []int) ([]TypeDef, uint32) {
	for i, t in types {
		if t.Kind == KFunc && t.Params == ps && t.Results == rs {
			return (types, uint32(i + 1))
		}
	}
	let next = types.Append(FuncType(ps, rs))
	(next, uint32(next.Len()))
}

func columnMajor(rows [][]uint32, width int) []uint32 {
	let n = rows.Len()
	let mut out = slices.WithCapacity[uint32](n * width)
	for c in 0..width {
		for r in 0..n {
			out = out.Append(rows[r][c])
		}
	}
	out
}

func maxLineOf(p Package) int {
	let mut m = 1
	for f in p.Funcs {
		if f.Line > m {
			m = f.Line
		}
		for l in f.Lines {
			if l > m {
				m = l
			}
		}
	}
	m
}

func sortSyms(es []symEntry) []symEntry {
	let mut out = es
	for i in 1..out.Len() {
		let mut j = i
		for j > 0 && (out[j-1].imp > out[j].imp || (out[j-1].imp == out[j].imp && out[j-1].nameID > out[j].nameID)) {
			let tmp = out[j]
			out[j] = out[j-1]
			out[j-1] = tmp
			j = j - 1
		}
	}
	out
}

func encodePackageDraft(p Package, profile string, foreign []ForeignFunc, wireNames []string) handoff.Draft fails handoff.Malformed {
	let rawFiles = PkgFiles(p)
	let mut rawNames = []string{p.Path, p.Name, PinGOOS, PinGOARCH, PinGo, profile}
	for rf in rawFiles {
		rawNames = rawNames.Append(rf)
	}
	for imp in p.Imports {
		rawNames = rawNames.Append(imp.Path)
		rawNames = rawNames.Append(imp.Name)
	}
	for ti, td in p.Types {
		if td.Kind == KStruct {
			if td.Name != "" {
				rawNames = rawNames.Append(td.Name)
			}
			let prefix = if td.Name != "" { td.Name + "." } else { "anon\(ti)." }
			for fd in td.Fields {
				rawNames = rawNames.Append(prefix + fd.Name)
			}
		} else if td.Kind == KIface {
			if td.Name != "" {
				rawNames = rawNames.Append(td.Name)
			}
			let prefix = if td.Name != "" { td.Name + "." } else { "iface\(ti)." }
			for md in td.Methods {
				rawNames = rawNames.Append(prefix + md.Name)
			}
		}
	}
	for f in p.Funcs {
		for op in f.Ops {
			match op {
			case ConstStr as c:
				if c.V != "" {
					rawNames = rawNames.Append(c.V)
				}
			case _:
			}
		}
	}
	for g in p.Globals {
		rawNames = rawNames.Append(g.Name)
	}
	for n in wireNames {
		rawNames = rawNames.Append(n)
	}
	for ff in foreign {
		rawNames = rawNames.Append(ff.Name)
	}
	let names = sortUniqueStrings(rawNames)
	let mut nameEnds = []uint32{}
	let mut textB = strings.NewBuilder()
	for s in names {
		textB.WriteString(s)
		nameEnds = nameEnds.Append(uint32(textB.Len()))
	}
	let pkgRows = [][]uint32{[]uint32{
		try findNameID(names, p.Path),
		try findNameID(names, p.Name),
		try findNameID(names, PinGOOS),
		try findNameID(names, PinGOARCH),
		try findNameID(names, PinGo),
		try findNameID(names, profile),
	}}
	let mut impOrder = []int{}
	for i in 0..p.Imports.Len() {
		impOrder = impOrder.Append(i)
	}
	for i in 1..impOrder.Len() {
		let mut j = i
		for j > 0 && p.Imports[impOrder[j-1]].Path > p.Imports[impOrder[j]].Path {
			let tmp = impOrder[j]
			impOrder[j] = impOrder[j-1]
			impOrder[j-1] = tmp
			j = j - 1
		}
	}
	let mut impWireID = slices.WithCapacity[uint32](p.Imports.Len())
	for _ in 0..p.Imports.Len() {
		impWireID = impWireID.Append(0)
	}
	let mut impRows = [][]uint32{}
	for k, idx in impOrder {
		impWireID[idx] = uint32(k + 1)
		let imp = p.Imports[idx]
		let (fpLo, fpHi) = try fpWords(imp.Fingerprint)
		impRows = impRows.Append([]uint32{
			try findNameID(names, imp.Path),
			try findNameID(names, imp.Name),
			if imp.HasInit { uint32(1) } else { uint32(0) },
			fpLo,
			fpHi,
		})
	}
	let mut fileOrder = []int{}
	for i in 0..rawFiles.Len() {
		fileOrder = fileOrder.Append(i)
	}
	for i in 1..fileOrder.Len() {
		let mut j = i
		for j > 0 && rawFiles[fileOrder[j-1]] > rawFiles[fileOrder[j]] {
			let tmp = fileOrder[j]
			fileOrder[j] = fileOrder[j-1]
			fileOrder[j-1] = tmp
			j = j - 1
		}
	}
	let mut fileWireID = slices.Repeat[uint32]([]uint32{1}, rawFiles.Len())
	for k, idx in fileOrder {
		fileWireID[idx] = uint32(k + 1)
	}
	let maxL = maxLineOf(p)
	let lineStride = uint32(10)
	let fileSize = uint32(maxL+1) * lineStride
	let mut linesCol = []uint32{}
	let mut fileRows = [][]uint32{}
	for idx in fileOrder {
		let baseLo = uint32(linesCol.Len())
		for i in 0..maxL+1 {
			linesCol = linesCol.Append(uint32(i) * lineStride)
		}
		fileRows = fileRows.Append([]uint32{
			try findNameID(names, rawFiles[idx]),
			fileSize,
			baseLo,
			uint32(maxL + 1),
			uint32(1), uint32(2), uint32(3), uint32(4), uint32(5), uint32(6), uint32(7), uint32(8),
		})
	}
	let mut spanRows = [][]uint32{}
	let addSpan = func(fileIdx int, line int, col int) uint32 {
		let fid = if fileIdx >= 0 && fileIdx < fileWireID.Len() { fileWireID[fileIdx] } else { uint32(1) }
		let l = if line < 1 { 1 } else { line }
		let c = if col < 1 { 1 } else if col > 9 { 9 } else { col }
		let start = uint32(l-1)*lineStride + uint32(c-1)
		spanRows = spanRows.Append([]uint32{fid, start, start + 1})
		uint32(spanRows.Len())
	}
	let mut allTypes = p.Types
	let mut intTypeID = uint32(0)
	for i, t in allTypes {
		if t.Kind == KInt {
			intTypeID = uint32(i + 1)
		}
	}
	if intTypeID == uint32(0) {
		allTypes = allTypes.Append(IntType())
		intTypeID = uint32(allTypes.Len())
	}
	let mut entries = []symEntry{}
	for ti, td in p.Types {
		if td.Kind != KStruct && td.Kind != KIface {
			continue
		}
		let mut impWire = uint32(0)
		if td.PkgPath != "" && td.PkgPath != p.Path {
			for k, imp in p.Imports {
				if imp.Path == td.PkgPath {
					impWire = impWireID[k]
				}
			}
		}
		if td.Name != "" {
			let sp = if impWire == uint32(0) { addSpan(0, 1, 1) } else { uint32(0) }
			entries = entries.Append(symEntry{imp: impWire, name: td.Name, nameID: try findNameID(names, td.Name), kind: ir.HSType, typeID: uint32(ti + 1), spanID: sp, localIdx: -1, globalID: -1, callKey: "", structIdx: ti, fieldIdx: -1})
		}
		if td.Kind == KStruct {
			let prefix = if td.Name != "" { td.Name + "." } else { "anon\(ti)." }
			for fi, fd in td.Fields {
				let fname = prefix + fd.Name
				let sp = if impWire == uint32(0) { addSpan(0, 1, 1) } else { uint32(0) }
				entries = entries.Append(symEntry{imp: impWire, name: fname, nameID: try findNameID(names, fname), kind: ir.HSField, typeID: uint32(fd.Type + 1), spanID: sp, localIdx: -1, globalID: -1, callKey: "", structIdx: ti, fieldIdx: fi})
			}
		} else {
			let prefix = if td.Name != "" { td.Name + "." } else { "iface\(ti)." }
			for mi, md in td.Methods {
				let mname = prefix + md.Name
				let sp = if impWire == uint32(0) { addSpan(0, 1, 1) } else { uint32(0) }
				entries = entries.Append(symEntry{imp: impWire, name: mname, nameID: try findNameID(names, mname), kind: ir.HSMethod, typeID: uint32(md.Type + 1), spanID: sp, localIdx: -1, globalID: -1, callKey: "", structIdx: ti, fieldIdx: mi})
			}
		}
	}
	for gi, g in p.Globals {
		let mut impWire = uint32(0)
		if g.PkgPath != "" && g.PkgPath != p.Path {
			for k, imp in p.Imports {
				if imp.Path == g.PkgPath {
					impWire = impWireID[k]
				}
			}
		}
		let sp = if impWire == uint32(0) { addSpan(0, 1, 1) } else { uint32(0) }
		let gty = if g.Type >= 0 && g.Type < p.Types.Len() { uint32(g.Type + 1) } else { intTypeID }
		entries = entries.Append(symEntry{imp: impWire, name: g.Name, nameID: try findNameID(names, g.Name), kind: ir.HSVar, typeID: gty, spanID: sp, localIdx: -1, globalID: gi, callKey: "", structIdx: -1, fieldIdx: -1})
	}
	for fi, f in p.Funcs {
		let wn = wireNames[fi]
		let (nextTypes, sigID) = findOrAddSig(allTypes, f.Params, f.Results)
		allTypes = nextTypes
		let sp = addSpan(f.File, f.Line, f.Col)
		let ck = if strings.HasPrefix(wn, "init.") { "" } else { p.Path + "." + wn }
		entries = entries.Append(symEntry{imp: 0, name: wn, nameID: try findNameID(names, wn), kind: ir.HSFunc, typeID: sigID, spanID: sp, localIdx: fi, globalID: -1, callKey: ck, structIdx: -1, fieldIdx: -1})
	}
	for ff in foreign {
		let (nextTypes, sigID) = findOrAddSig(allTypes, ff.Params, ff.Results)
		allTypes = nextTypes
		let ck = p.Imports[ff.Import].Path + "." + ff.Name
		entries = entries.Append(symEntry{imp: impWireID[ff.Import], name: ff.Name, nameID: try findNameID(names, ff.Name), kind: ir.HSFunc, typeID: sigID, spanID: 0, localIdx: -1, globalID: -1, callKey: ck, structIdx: -1, fieldIdx: -1})
	}
	entries = sortSyms(entries)
	let mut symRows = [][]uint32{}
	let mut globalSymID = slices.Repeat[uint32]([]uint32{0}, p.Globals.Len())
	let mut localFuncSymID = slices.Repeat[uint32]([]uint32{0}, p.Funcs.Len())
	let mut typeSymID = slices.Repeat[uint32]([]uint32{0}, p.Types.Len())
	let mut fieldSymIDs = slices.WithCapacity[[]uint32](p.Types.Len())
	let mut methSymIDs = slices.WithCapacity[[]uint32](p.Types.Len())
	for t in p.Types {
		fieldSymIDs = fieldSymIDs.Append(slices.Repeat[uint32]([]uint32{0}, t.Fields.Len()))
		methSymIDs = methSymIDs.Append(slices.Repeat[uint32]([]uint32{0}, t.Methods.Len()))
	}
	let mut callSymMap = Map[string, uint32]{}
	for si, e in entries {
		let id = uint32(si + 1)
		symRows = symRows.Append([]uint32{e.imp, e.nameID, e.kind, e.typeID, e.spanID})
		if e.globalID >= 0 {
			globalSymID[e.globalID] = id
		}
		if e.localIdx >= 0 {
			localFuncSymID[e.localIdx] = id
		}
		if e.structIdx >= 0 {
			if e.kind == ir.HSType {
				typeSymID[e.structIdx] = id
			} else if e.kind == ir.HSField {
				let mut row = fieldSymIDs[e.structIdx]
				row[e.fieldIdx] = id
				fieldSymIDs[e.structIdx] = row
			} else if e.kind == ir.HSMethod {
				let mut row = methSymIDs[e.structIdx]
				row[e.fieldIdx] = id
				methSymIDs[e.structIdx] = row
			}
		}
		if e.callKey != "" {
			callSymMap[e.callKey] = id
		}
	}
	let nBaseTypes = allTypes.Len()
	let mut namedRecRow = slices.Repeat[uint32]([]uint32{0}, nBaseTypes)
	let mut recRows = []int{}
	for ti in 0..nBaseTypes {
		let tk = allTypes[ti].Kind
		if (tk == KStruct || tk == KIface) && allTypes[ti].Name != "" {
			namedRecRow[ti] = uint32(nBaseTypes + recRows.Len() + 1)
			recRows = recRows.Append(ti)
		}
	}
	let mut operands = []uint32{}
	let mut typeRows = [][]uint32{}
	for ti, t in allTypes {
		let lo = uint32(operands.Len())
		if KindIsBasic(t.Kind) {
			typeRows = typeRows.Append([]uint32{ir.HTBasic, uint32(KindExportBasic(t.Kind)), lo, 0})
		} else if t.Kind == KPtr {
			operands = operands.Append(uint32(t.Elem + 1))
			typeRows = typeRows.Append([]uint32{ir.HTPointer, 0, lo, 1})
		} else if t.Kind == KSlice {
			operands = operands.Append(uint32(t.Elem + 1))
			typeRows = typeRows.Append([]uint32{ir.HTSlice, 0, lo, 1})
		} else if t.Kind == KStruct && t.Name == "" {
			for fi in 0..t.Fields.Len() {
				operands = operands.Append(fieldSymIDs[ti][fi])
			}
			typeRows = typeRows.Append([]uint32{ir.HTRecord, 0, lo, uint32(t.Fields.Len())})
		} else if t.Kind == KIface && t.Name == "" {
			if t.Methods.Len() == 0 {
				typeRows = typeRows.Append([]uint32{ir.HTBasic, ir.HBasicAny, lo, 0})
			} else {
				for mi in 0..t.Methods.Len() {
					operands = operands.Append(methSymIDs[ti][mi])
				}
				typeRows = typeRows.Append([]uint32{ir.HTInterface, 0, lo, uint32(t.Methods.Len())})
			}
		} else if t.Kind == KStruct || t.Kind == KIface {
			operands = operands.Append(namedRecRow[ti])
			typeRows = typeRows.Append([]uint32{ir.HTNamed, typeSymID[ti], lo, 1})
		} else {
			for pt in t.Params {
				operands = operands.Append(uint32(pt + 1))
			}
			for rt in t.Results {
				operands = operands.Append(uint32(rt + 1))
			}
			typeRows = typeRows.Append([]uint32{ir.HTSignature, uint32(t.Params.Len()), lo, uint32(t.Params.Len() + t.Results.Len())})
		}
	}
	for ti in recRows {
		let t = allTypes[ti]
		let lo = uint32(operands.Len())
		if t.Kind == KStruct {
			for fi in 0..t.Fields.Len() {
				operands = operands.Append(fieldSymIDs[ti][fi])
			}
			typeRows = typeRows.Append([]uint32{ir.HTRecord, 0, lo, uint32(t.Fields.Len())})
		} else {
			for mi in 0..t.Methods.Len() {
				operands = operands.Append(methSymIDs[ti][mi])
			}
			typeRows = typeRows.Append([]uint32{ir.HTInterface, 0, lo, uint32(t.Methods.Len())})
		}
	}
	let mut bodyRows = [][]uint32{}
	let mut slotsCol = []uint32{}
	let mut opRows = [][]uint32{}
	for si, e in entries {
		if e.localIdx < 0 {
			continue
		}
		let f = p.Funcs[e.localIdx]
		let firstSlot = uint32(slotsCol.Len())
		for s in f.Slots {
			slotsCol = slotsCol.Append(uint32(s + 1))
		}
		let mut labelTarget = Map[int, int]{}
		let mut eirCount = 0
		for op in f.Ops {
			match op {
			case Label as l:
				labelTarget[l.Id] = eirCount
			case _:
				eirCount = eirCount + 1
			}
		}
		let firstOp = uint32(opRows.Len())
		let mut curEir = 0
		for k, op in f.Ops {
			match op {
			case Label:
				continue
			case _:
			}
			let sp = addSpan(f.File, f.Lines[k], 1)
			let lo = uint32(operands.Len())
			let mut opcode = uint32(0)
			match op {
			case Const as c:
				opcode = ir.HOConst
				let (wlo, whi) = encodeConst(c.V)
				operands = operands.Append(uint32(c.Dst + 1))
				operands = operands.Append(wlo)
				operands = operands.Append(whi)
			case ConstStr as c:
				opcode = ir.HOConst
				operands = operands.Append(uint32(c.Dst + 1))
				let nid = if c.V == "" { uint32(0) } else { try findNameID(names, c.V) }
				operands = operands.Append(nid)
				operands = operands.Append(uint32(0))
			case Zero as z:
				opcode = ir.HOConst
				operands = operands.Append(uint32(z.Dst + 1))
				operands = operands.Append(uint32(0))
				operands = operands.Append(uint32(0))
			case Arith as a:
				opcode = arithOpcode(a.Kind)
				operands = operands.Append(uint32(a.Dst + 1))
				operands = operands.Append(uint32(a.A + 1))
				operands = operands.Append(uint32(a.B + 1))
			case Convert as c:
				opcode = ir.HOConvert
				operands = operands.Append(uint32(c.Dst + 1))
				operands = operands.Append(uint32(c.Src + 1))
			case Len as l:
				opcode = handoff.HOLen
				operands = operands.Append(uint32(l.Dst + 1))
				operands = operands.Append(uint32(l.Src + 1))
			case Load as l:
				opcode = ir.HOLoad
				operands = operands.Append(uint32(l.Dst + 1))
				operands = operands.Append(uint32(l.Ptr + 1))
			case Store as s:
				opcode = ir.HOStore
				operands = operands.Append(uint32(s.Ptr + 1))
				operands = operands.Append(uint32(s.Val + 1))
			case StorePtr as s:
				opcode = ir.HOStore
				operands = operands.Append(uint32(s.Ptr + 1))
				operands = operands.Append(uint32(s.Val + 1))
			case AddrOf as a:
				opcode = ir.HOAddrOf
				operands = operands.Append(uint32(a.Dst + 1))
				operands = operands.Append(uint32(a.Of + 1))
			case FieldGet as g:
				opcode = handoff.HOFieldGet
				let bt = f.Slots[g.Base]
				let st = if p.Types[bt].Kind == KPtr { p.Types[bt].Elem } else { bt }
				operands = operands.Append(uint32(g.Dst + 1))
				operands = operands.Append(uint32(g.Base + 1))
				operands = operands.Append(fieldSymIDs[st][g.Field])
			case FieldSet as s:
				opcode = handoff.HOFieldSet
				let st = p.Types[f.Slots[s.Ptr]].Elem
				operands = operands.Append(uint32(s.Ptr + 1))
				operands = operands.Append(fieldSymIDs[st][s.Field])
				operands = operands.Append(uint32(s.Val + 1))
			case RecordLit as r:
				opcode = handoff.HORecordLit
				operands = operands.Append(uint32(r.Dst + 1))
				for v in r.Vals {
					operands = operands.Append(uint32(v + 1))
				}
			case Index as ix:
				opcode = handoff.HOIndex
				operands = operands.Append(uint32(ix.Dst + 1))
				operands = operands.Append(uint32(ix.Slice + 1))
				operands = operands.Append(uint32(ix.Idx + 1))
			case SliceLit as sl:
				opcode = handoff.HOSliceLit
				operands = operands.Append(uint32(sl.Dst + 1))
				for ev in sl.Elems {
					operands = operands.Append(uint32(ev + 1))
				}
			case GetGlobal as g:
				opcode = ir.HOGetGlobal
				operands = operands.Append(uint32(g.Dst + 1))
				operands = operands.Append(globalSymID[g.Global])
			case SetGlobal as g:
				opcode = ir.HOSetGlobal
				operands = operands.Append(globalSymID[g.Global])
				operands = operands.Append(uint32(g.Src + 1))
			case Call as c:
				opcode = ir.HOCall
				let targetID = match callSymMap.Get(c.Target) {
				case option.Some as id:
					id.Value
				case option.None:
					return handoff.Malformed{Section: ir.HOps, Row: opRows.Len(), Why: "unknown call target \(c.Target)"}
				}
				operands = operands.Append(targetID)
				operands = operands.Append(uint32(c.Dsts.Len()))
				for d in c.Dsts {
					operands = operands.Append(uint32(d + 1))
				}
				for a in c.Args {
					operands = operands.Append(uint32(a + 1))
				}
			case CallClosure as c:
				opcode = ir.HOCallClosure
				operands = operands.Append(uint32(c.Fn + 1))
				operands = operands.Append(uint32(c.Dsts.Len()))
				for d in c.Dsts {
					operands = operands.Append(uint32(d + 1))
				}
				for a in c.Args {
					operands = operands.Append(uint32(a + 1))
				}
			case Alloc as al:
				opcode = handoff.HOAlloc
				operands = operands.Append(uint32(al.Dst + 1))
			case MakeClosure as mc:
				opcode = handoff.HOMakeClosure
				let targetID = match callSymMap.Get(mc.Target) {
				case option.Some as id:
					id.Value
				case option.None:
					return handoff.Malformed{Section: ir.HOps, Row: opRows.Len(), Why: "unknown closure target \(mc.Target)"}
				}
				operands = operands.Append(uint32(mc.Dst + 1))
				operands = operands.Append(targetID)
				if mc.Env >= 0 {
					operands = operands.Append(uint32(mc.Env + 1))
				}
			case ClosureEnv as ce:
				opcode = handoff.HOClosureEnv
				operands = operands.Append(uint32(ce.Dst + 1))
			case Append as ap:
				opcode = handoff.HOAppend
				operands = operands.Append(uint32(ap.Dst + 1))
				operands = operands.Append(uint32(ap.Slice + 1))
				operands = operands.Append(uint32(ap.Elem + 1))
			case SliceOp as sl:
				opcode = handoff.HOSlice
				operands = operands.Append(uint32(sl.Dst + 1))
				operands = operands.Append(uint32(sl.Src + 1))
				operands = operands.Append(uint32(sl.Lo + 1))
				operands = operands.Append(uint32(sl.Hi + 1))
			case StringIndex as sx:
				opcode = handoff.HOStringIndex
				operands = operands.Append(uint32(sx.Dst + 1))
				operands = operands.Append(uint32(sx.Str + 1))
				operands = operands.Append(uint32(sx.Idx + 1))
			case MakeIface as mi:
				opcode = handoff.HOMakeIface
				operands = operands.Append(uint32(mi.Dst + 1))
				operands = operands.Append(uint32(mi.Src + 1))
			case IfaceIs as ii:
				opcode = handoff.HOIfaceIs
				operands = operands.Append(uint32(ii.Dst + 1))
				operands = operands.Append(uint32(ii.Iface + 1))
				operands = operands.Append(uint32(ii.ConcreteType + 1))
			case IfaceData as id:
				opcode = handoff.HOIfaceData
				operands = operands.Append(uint32(id.Dst + 1))
				operands = operands.Append(uint32(id.Iface + 1))
			case CallIface as ci:
				opcode = handoff.HOCallIface
				operands = operands.Append(uint32(ci.Iface + 1))
				operands = operands.Append(uint32(ci.Method))
				operands = operands.Append(uint32(ci.Dsts.Len()))
				for d in ci.Dsts {
					operands = operands.Append(uint32(d + 1))
				}
				for a in ci.Args {
					operands = operands.Append(uint32(a + 1))
				}
			case Jump as j:
				opcode = ir.HOJump
				let t = match labelTarget.Get(j.To) {
				case option.Some as idx:
					idx.Value
				case option.None:
					return handoff.Malformed{Section: ir.HOps, Row: opRows.Len(), Why: "unknown jump label \(j.To)"}
				}
				operands = operands.Append(uint32(t + 1))
			case JumpIf as j:
				opcode = ir.HOBranch
				let t = match labelTarget.Get(j.To) {
				case option.Some as idx:
					idx.Value
				case option.None:
					return handoff.Malformed{Section: ir.HOps, Row: opRows.Len(), Why: "unknown branch label \(j.To)"}
				}
				operands = operands.Append(uint32(j.Cond + 1))
				operands = operands.Append(uint32(j.A + 1))
				operands = operands.Append(uint32(j.B + 1))
				operands = operands.Append(uint32(t + 1))
				operands = operands.Append(uint32(curEir + 2))
			case Return as r:
				opcode = ir.HOReturn
				for v in r.Vals {
					operands = operands.Append(uint32(v + 1))
				}
			case Label:
			}
			opRows = opRows.Append([]uint32{opcode, sp, lo, uint32(operands.Len()) - lo})
			curEir = curEir + 1
		}
		bodyRows = bodyRows.Append([]uint32{uint32(si + 1), firstSlot, uint32(f.Slots.Len()), firstOp, uint32(curEir)})
	}
	let mut initCol = slices.WithCapacity[uint32](p.Inits.Len())
	for fi in p.Inits {
		initCol = initCol.Append(localFuncSymID[fi])
	}
	handoff.Draft{
		Columns: [][]uint32{
			columnMajor(pkgRows, 6),
			nameEnds,
			columnMajor(impRows, 5),
			columnMajor(fileRows, 12),
			linesCol,
			columnMajor(spanRows, 3),
			columnMajor(typeRows, 4),
			columnMajor(symRows, 5),
			columnMajor(bodyRows, 5),
			slotsCol,
			columnMajor(opRows, 4),
			[]uint32{},
			[]uint32{},
			initCol,
			operands,
		},
		Text: textB.String(),
	}
}

// EncodeHandoff encodes p as an EIR v1 draft under the pin's profile.
func EncodeHandoff(p Package, foreign []ForeignFunc) handoff.Draft fails handoff.Malformed {
	let mut names = slices.WithCapacity[string](p.Funcs.Len())
	for i in 0..p.Funcs.Len() {
		names = names.Append(strings.TrimPrefix(FuncSym(p, i), p.Path+"."))
	}
	try encodePackageDraft(p, PinProfile, foreign, names)
}

// TinyHandoffExpect builds the independent admission expectation for TinyHandoff.
func TinyHandoffExpect(dep Import) handoff.Expect {
	handoff.Expect{
		Target:  handoff.Target{Path: TinyPath, GOOS: PinGOOS, GOARCH: PinGOARCH, Pin: PinGo, Profile: PinProfile},
		Imports: []handoff.Import{
			handoff.Import{Path: dep.Path, Name: dep.Name, HasInit: dep.HasInit, Fingerprint: dep.Fingerprint},
		},
	}
}

func tinyHandoffSpec(k1 int, k2 int, dep Import) (Package, []ForeignFunc, []string) {
	let ty = []TypeDef{
		IntType(),
		PtrType(TInt),
		FuncType([]int{TInt}, []int{TInt}),
		PtrType(TPtrInt),
	}
	let i = TInt
	let funcs = []Func{
		fn("init", []int{}, []int{}, []int{i, i, i, i},
			[]Op{
				GetGlobal{Dst: 0, Global: 0},
				Call{Dsts: []int{1}, Target: DepPath + ".Inits", Args: []int{}},
				Arith{Dst: 0, Kind: AAdd, A: 0, B: 1},
				SetGlobal{Global: 0, Src: 0},
				GetGlobal{Dst: 0, Global: 3},
				Const{Dst: 2, V: 10},
				Const{Dst: 3, V: 1},
				Arith{Dst: 0, Kind: AMul, A: 0, B: 2},
				Arith{Dst: 0, Kind: AAdd, A: 0, B: 3},
				SetGlobal{Global: 3, Src: 0},
				Return{Vals: []int{}},
			}, 5),
		fn("init", []int{}, []int{}, []int{i, i, i},
			[]Op{
				GetGlobal{Dst: 0, Global: 3},
				Const{Dst: 1, V: 10},
				Const{Dst: 2, V: 2},
				Arith{Dst: 0, Kind: AMul, A: 0, B: 1},
				Arith{Dst: 0, Kind: AAdd, A: 0, B: 2},
				SetGlobal{Global: 3, Src: 0},
				Return{Vals: []int{}},
			}, 9),
		fn("Diff", []int{i, i}, []int{i}, []int{i, i, i, i},
			[]Op{Const{Dst: 3, V: k1}, Arith{Dst: 2, Kind: ASub, A: 0, B: 1}, Arith{Dst: 2, Kind: AAdd, A: 2, B: 3}, Return{Vals: []int{2}}}, 16),
		fn("Twice", []int{i}, []int{i}, []int{i, i, i},
			[]Op{Call{Dsts: []int{1}, Target: DepPath + ".Double", Args: []int{0}}, Const{Dst: 2, V: k2}, Arith{Dst: 1, Kind: AAdd, A: 1, B: 2}, Return{Vals: []int{1}}}, 22),
		fn("Apply", []int{TFunc, i}, []int{i}, []int{TFunc, i, i},
			[]Op{CallClosure{Dsts: []int{2}, Fn: 0, Args: []int{1}}, Return{Vals: []int{2}}}, 28),
		fn("Hold", []int{TPtrInt, TFunc}, []int{i}, []int{TPtrInt, TFunc, i, i, i},
			[]Op{Const{Dst: 2, V: 3}, CallClosure{Dsts: []int{3}, Fn: 1, Args: []int{2}}, Load{Dst: 4, Ptr: 0}, Arith{Dst: 4, Kind: AAdd, A: 4, B: 3}, Return{Vals: []int{4}}}, 32),
		fn("Anchor", []int{TFunc, i}, []int{i}, []int{TFunc, i, TPtrInt, i},
			[]Op{AddrOf{Dst: 2, Of: 1}, CallClosure{Dsts: []int{3}, Fn: 0, Args: []int{1}}, Store{Ptr: 2, Val: 3}, Return{Vals: []int{1}}}, 39),
		fn("Publish", []int{TPtrPtrInt, TPtrInt}, []int{}, []int{TPtrPtrInt, TPtrInt},
			[]Op{StorePtr{Ptr: 0, Val: 1}, Return{Vals: []int{}}}, 45),
		fn("Spin", []int{}, []int{i}, []int{i, i, i, i, i},
			[]Op{Const{Dst: 0, V: 0}, Const{Dst: 1, V: 0}, Const{Dst: 2, V: 1}, Const{Dst: 4, V: 0}, SetGlobal{Global: 2, Src: 2}, Label{Id: 0}, GetGlobal{Dst: 3, Global: 1},
				JumpIf{Cond: CNe, A: 3, B: 1, To: 1}, Arith{Dst: 0, Kind: AXor, A: 0, B: 4}, Arith{Dst: 4, Kind: AAdd, A: 4, B: 2}, Jump{To: 0},
				Label{Id: 1}, Return{Vals: []int{0}}}, 49),
		fn("Stop", []int{}, []int{}, []int{i},
			[]Op{Const{Dst: 0, V: 1}, SetGlobal{Global: 1, Src: 0}, Return{Vals: []int{}}}, 62),
		fn("InitRuns", []int{}, []int{i}, []int{i},
			[]Op{GetGlobal{Dst: 0, Global: 0}, Return{Vals: []int{0}}}, 66),
		fn("SpinStarted", []int{}, []int{i}, []int{i},
			[]Op{GetGlobal{Dst: 0, Global: 2}, Return{Vals: []int{0}}}, 72),
		fn("InitTrace", []int{}, []int{i}, []int{i},
			[]Op{GetGlobal{Dst: 0, Global: 3}, Return{Vals: []int{0}}}, 76),
		fn("step", []int{i}, []int{i}, []int{i, i, i},
			[]Op{Const{Dst: 1, V: 3}, Const{Dst: 2, V: 7}, Arith{Dst: 1, Kind: AMul, A: 0, B: 1}, Arith{Dst: 1, Kind: AAdd, A: 1, B: 2}, Return{Vals: []int{1}}}, 80),
		fn("Combine", []int{i, i}, []int{i}, []int{i, i, i, i, i},
			[]Op{
				Call{Dsts: []int{2}, Target: TinyPath + ".Diff", Args: []int{0, 1}},
				Call{Dsts: []int{3}, Target: TinyPath + ".step", Args: []int{2}},
				Call{Dsts: []int{4}, Target: TinyPath + ".Twice", Args: []int{1}},
				Arith{Dst: 3, Kind: AAdd, A: 3, B: 4},
				Return{Vals: []int{3}},
			}, 86),
	}
	let wireNames = []string{
		"init.1", "init.0", "Diff", "Twice", "Apply", "Hold", "Anchor", "Publish",
		"Spin", "Stop", "InitRuns", "SpinStarted", "InitTrace", "step", "Combine",
	}
	let foreign = []ForeignFunc{
		ForeignFunc{Import: 0, Name: "Inits", Params: []int{}, Results: []int{i}},
		ForeignFunc{Import: 0, Name: "Double", Params: []int{i}, Results: []int{i}},
	}
	let pkg = Package{
		Path:    TinyPath,
		Name:    "tiny",
		File:    "tiny.ergo",
		Files:   []string{"tiny.ergo"},
		Types:   ty,
		Imports: []Import{dep},
		Globals: []Global{LocalGlobal("initRuns", 0), LocalGlobal("stop", 0), LocalGlobal("started", 0), LocalGlobal("initTrace", 0)},
		Funcs:   funcs,
		Inits:   []int{0, 1},
	}
	(pkg, foreign, wireNames)
}

// TinyHandoff encodes the widened round-trip fixture package into EIR v1 bytes.
func TinyHandoff(k1 int, k2 int, dep Import) string fails handoff.Malformed {
	let (pkg, foreign, wireNames) = tinyHandoffSpec(k1, k2, dep)
	let draft = try encodePackageDraft(pkg, PinProfile, foreign, wireNames)
	handoff.Encode(try handoff.Pack(draft))
}

func tinyHandoffWithProfile(k1 int, k2 int, dep Import, profile string) string fails handoff.Malformed {
	let (pkg, foreign, wireNames) = tinyHandoffSpec(k1, k2, dep)
	let draft = try encodePackageDraft(pkg, profile, foreign, wireNames)
	handoff.Encode(try handoff.Pack(draft))
}

func unsupportedMapWire(dep Import) string fails handoff.Malformed {
	let pkg = Package{
		Path:    TinyPath,
		Name:    "tiny",
		File:    "tiny.ergo",
		Files:   []string{"tiny.ergo"},
		Types:   []TypeDef{IntType()},
		Imports: []Import{dep},
		Globals: []Global{},
		Funcs:   []Func{fn("Id", []int{0}, []int{0}, []int{0}, []Op{Return{Vals: []int{0}}}, 5)},
		Inits:   []int{},
	}
	let base = try encodePackageDraft(pkg, PinProfile, []ForeignFunc{}, []string{"Id"})
	let nTypes = base.Columns[ir.HTypes].Len() / 4
	let opsStart = base.Columns[ir.HOps]
	let mut typeOps = 0
	for i in 0..nTypes {
		typeOps = typeOps + int(base.Columns[ir.HTypes][3*nTypes+i])
	}
	let mut newTypes = slices.WithCapacity[uint32]((nTypes + 1) * 4)
	for c in 0..4 {
		for r in 0..nTypes {
			newTypes = newTypes.Append(base.Columns[ir.HTypes][c*nTypes+r])
		}
		let extra = if c == 0 { ir.HTMap } else if c == 1 { uint32(0) } else if c == 2 { uint32(typeOps) } else { uint32(2) }
		newTypes = newTypes.Append(extra)
	}
	let oldOperands = base.Columns[ir.HOperands]
	let mut newOperands = slices.WithCapacity[uint32](oldOperands.Len() + 2)
	for i in 0..typeOps {
		newOperands = newOperands.Append(oldOperands[i])
	}
	newOperands = newOperands.Append(uint32(1))
	newOperands = newOperands.Append(uint32(1))
	for i in typeOps..oldOperands.Len() {
		newOperands = newOperands.Append(oldOperands[i])
	}
	let nOps = opsStart.Len() / 4
	let mut newOps = slices.WithCapacity[uint32](opsStart.Len())
	for c in 0..4 {
		for r in 0..nOps {
			let v = opsStart[c*nOps+r]
			newOps = newOps.Append(if c == 2 { v + 2 } else { v })
		}
	}
	let mut cols = base.Columns
	cols[ir.HTypes] = newTypes
	cols[ir.HOps] = newOps
	cols[ir.HOperands] = newOperands
	handoff.Encode(try handoff.Pack(handoff.Draft{Columns: cols, Text: base.Text}))
}

func unsupportedNonIntGlobalWire(dep Import) string fails handoff.Malformed {
	let pkg = Package{
		Path:    TinyPath,
		Name:    "tiny",
		File:    "tiny.ergo",
		Files:   []string{"tiny.ergo"},
		Types:   []TypeDef{IntType()},
		Imports: []Import{dep},
		Globals: []Global{LocalGlobal("g", 0)},
		Funcs:   []Func{fn("Id", []int{0}, []int{0}, []int{0}, []Op{Return{Vals: []int{0}}}, 5)},
		Inits:   []int{},
	}
	let base = try encodePackageDraft(pkg, PinProfile, []ForeignFunc{}, []string{"Id"})
	let nTypes = base.Columns[ir.HTypes].Len() / 4
	let opsStart = base.Columns[ir.HOps]
	let mut typeOps = 0
	for i in 0..nTypes {
		typeOps = typeOps + int(base.Columns[ir.HTypes][3*nTypes+i])
	}
	let mut newTypes = slices.WithCapacity[uint32]((nTypes + 1) * 4)
	for c in 0..4 {
		for r in 0..nTypes {
			newTypes = newTypes.Append(base.Columns[ir.HTypes][c*nTypes+r])
		}
		let extra = if c == 0 { ir.HTMap } else if c == 1 { uint32(0) } else if c == 2 { uint32(typeOps) } else { uint32(2) }
		newTypes = newTypes.Append(extra)
	}
	let oldOperands = base.Columns[ir.HOperands]
	let mut newOperands = slices.WithCapacity[uint32](oldOperands.Len() + 2)
	for i in 0..typeOps {
		newOperands = newOperands.Append(oldOperands[i])
	}
	newOperands = newOperands.Append(uint32(1))
	newOperands = newOperands.Append(uint32(1))
	for i in typeOps..oldOperands.Len() {
		newOperands = newOperands.Append(oldOperands[i])
	}
	let nOps = opsStart.Len() / 4
	let mut newOps = slices.WithCapacity[uint32](opsStart.Len())
	for c in 0..4 {
		for r in 0..nOps {
			let v = opsStart[c*nOps+r]
			newOps = newOps.Append(if c == 2 { v + 2 } else { v })
		}
	}
	let mut syms = base.Columns[ir.HSymbols]
	let nSyms = syms.Len() / 5
	for i in 0..nSyms {
		if syms[2*nSyms+i] == ir.HSVar {
			syms[3*nSyms+i] = uint32(nTypes + 1)
		}
	}
	let mut cols = base.Columns
	cols[ir.HTypes] = newTypes
	cols[ir.HSymbols] = syms
	cols[ir.HOps] = newOps
	cols[ir.HOperands] = newOperands
	handoff.Encode(try handoff.Pack(handoff.Draft{Columns: cols, Text: base.Text}))
}

func archiveFailsWrongTarget(wire string, want handoff.Expect) bool {
	let _ = ArchiveFromHandoff(wire, want, SampleHeader) catch {
	case handoff.WrongTarget:
		return true
	case handoff.UnknownVersion, handoff.Malformed, handoff.StaleImport, Refused, Malformed, Undefined:
		return false
	}
	false
}

func archiveFailsStaleImport(wire string, want handoff.Expect) bool {
	let _ = ArchiveFromHandoff(wire, want, SampleHeader) catch {
	case handoff.StaleImport as e:
		return e.Path == DepPath
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, Refused, Malformed, Undefined:
		return false
	}
	false
}

func archiveFailsUnknownVersion(wire string, want handoff.Expect) bool {
	let _ = ArchiveFromHandoff(wire, want, SampleHeader) catch {
	case handoff.UnknownVersion:
		return true
	case handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed, Undefined:
		return false
	}
	false
}

func archiveFailsWireMalformed(wire string, want handoff.Expect) bool {
	let _ = ArchiveFromHandoff(wire, want, SampleHeader) catch {
	case handoff.Malformed:
		return true
	case handoff.UnknownVersion, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed, Undefined:
		return false
	}
	false
}

func archiveFailsRefused(wire string, want handoff.Expect) bool {
	let _ = ArchiveFromHandoff(wire, want, SampleHeader) catch {
	case Refused:
		return true
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Malformed, Undefined:
		return false
	}
	false
}

// HandoffConstRoundTrips holds that 64-bit signed constants survive the
// EIR v1 two-word encoding without truncation or sign corruption.
law HandoffConstRoundTrips(v int) {
	let samples = []int{v, -v, 0, 1, -1, 2147483647, -2147483648, -499983, 4294967296, -4294967296, 9223372036854775807, -9223372036854775808}
	for x in samples {
		let (lo, hi) = encodeConst(x)
		if decodeConst(lo, hi) != x {
			return false
		}
	}
	true
}

// HandoffArchiveVerifies proves that canonical EIR v1 bytes round-trip
// through Decode, Admit, FromHandoff, and ArchiveFromHandoff.
law HandoffArchiveVerifies(k1 int, k2 int) {
	let a = k1 % 1000000
	let b = k2 % 1000000
	let dep = SampleDep()
	let bytes = TinyHandoff(a, b, dep) catch {
	case handoff.Malformed:
		return false
	}
	let want = TinyHandoffExpect(dep)
	let pkg = FromHandoff(bytes, want) catch {
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed:
		return false
	}
	let built = ArchiveFromHandoff(bytes, want, SampleHeader) catch {
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed, Undefined:
		return false
	}
	if Verify(pkg, SampleHeader, built.Archive).Len() != 0 {
		return false
	}
	let pubIdx = FuncNamed(pkg, "Publish")
	if pubIdx < 0 || expectedBarrierCount(pkg, ComputeLayouts(pkg), pkg.Funcs[pubIdx]) != 1 {
		return false
	}
	let diffIdx = FuncNamed(pkg, "Diff")
	if diffIdx < 0 {
		return false
	}
	let gotK1 = match pkg.Funcs[diffIdx].Ops[0] {
	case Const as c:
		c.V
	case _:
		a + 1
	}
	if gotK1 != a {
		return false
	}
	let combIdx = FuncNamed(pkg, "Combine")
	if combIdx < 0 || pkg.Inits.Len() != 2 {
		return false
	}
	let firstInitOps = pkg.Funcs[pkg.Inits[0]].Ops.Len()
	let secondInitOps = pkg.Funcs[pkg.Inits[1]].Ops.Len()
	firstInitOps > secondInitOps
}

// Stop1HandoffVerifies proves that Stop 1 packages (multi-file, scalars,
// strings, named records, slices, and stack args) round-trip through EIR v1.
law Stop1HandoffVerifies(k int) {
	let dep = SampleDep()
	let p = Stop1Sample(k, dep)
	let foreign = []ForeignFunc{
		ForeignFunc{Import: 0, Name: "Double", Params: []int{0}, Results: []int{0}},
	}
	let draft = EncodeHandoff(p, foreign) catch {
	case handoff.Malformed:
		return false
	}
	let img = handoff.Pack(draft) catch {
	case handoff.Malformed:
		return false
	}
	let encoded = handoff.Encode(img)
	let want = handoff.Expect{
		Target:  handoff.Target{Path: p.Path, GOOS: PinGOOS, GOARCH: PinGOARCH, Pin: PinGo, Profile: PinProfile},
		Imports: []handoff.Import{handoff.Import{Path: dep.Path, Name: dep.Name, HasInit: dep.HasInit, Fingerprint: dep.Fingerprint}},
	}
	let rtPkg = FromHandoff(encoded, want) catch {
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed:
		return false
	}
	let built = ArchiveFromHandoff(encoded, want, SampleHeader) catch {
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed, Undefined:
		return false
	}
	Verify(rtPkg, SampleHeader, built.Archive).Len() == 0
}

// HandoffRefusesBadAdmission proves that ArchiveFromHandoff fails closed
// on tampered magic, unknown versions, truncated images, mismatched target
// tuples, stale import fingerprints, and unsupported EIR types or globals.
law HandoffRefusesBadAdmission(k1 int, k2 int) {
	let dep = SampleDep()
	let bytes = TinyHandoff(k1%1000000, k2%1000000, dep) catch {
	case handoff.Malformed:
		return false
	}
	let raceWire = tinyHandoffWithProfile(k1%1000000, k2%1000000, dep, "race") catch {
	case handoff.Malformed:
		return false
	}
	let mapWire = unsupportedMapWire(dep) catch {
	case handoff.Malformed:
		return false
	}
	let globalWire = unsupportedNonIntGlobalWire(dep) catch {
	case handoff.Malformed:
		return false
	}
	let want = TinyHandoffExpect(dep)
	let badMagic = "NOTERGO!" + bytes[8:bytes.Len()]
	let badVer = bytes[0:8] + "\x02\x00\x00\x00" + bytes[12:bytes.Len()]
	let truncated = bytes[0 : bytes.Len()-1]
	let staleFp = handoff.Expect{
		Target:  want.Target,
		Imports: []handoff.Import{handoff.Import{..want.Imports[0], Fingerprint: "\x01\x02\x03\x04\x05\x06\x07\x09"}},
	}
	let staleInit = handoff.Expect{
		Target:  want.Target,
		Imports: []handoff.Import{handoff.Import{..want.Imports[0], HasInit: false}},
	}
	let unsupportedWant = handoff.Expect{
		Target:  handoff.Target{..want.Target, Profile: "race"},
		Imports: want.Imports,
	}
		archiveFailsWireMalformed(badMagic, want) &&
		archiveFailsUnknownVersion(badVer, want) &&
		archiveFailsWireMalformed(truncated, want) &&
		archiveFailsWrongTarget(raceWire, want) &&
		archiveFailsStaleImport(bytes, staleFp) &&
		archiveFailsStaleImport(bytes, staleInit) &&
		archiveFailsRefused(bytes, unsupportedWant) &&
		archiveFailsRefused(mapWire, want) &&
		archiveFailsRefused(globalWire, want)
}

// ExecHandoffVerifies proves that the standalone main-package EIR v1 handoff
// encodes, admits, lowers to a verified archive, and round-trips every construct cleanly.
law ExecHandoffVerifies(k int) {
	let dep = SampleDep()
	let srcPkg = ExecSample(k, dep)
	let foreign = []ForeignFunc{ForeignFunc{Import: 1, Name: "Exit", Params: []int{0}, Results: []int{}}}
	let draft = EncodeHandoff(srcPkg, foreign) catch {
	case handoff.Malformed:
		return false
	}
	let packed = handoff.Pack(draft) catch {
	case handoff.Malformed:
		return false
	}
	let encoded = handoff.Encode(packed)
	let osImp = srcPkg.Imports[1]
	let want = handoff.Expect{
		Target:  handoff.Target{Path: "main", GOOS: PinGOOS, GOARCH: PinGOARCH, Pin: PinGo, Profile: PinProfile},
		Imports: []handoff.Import{
			handoff.Import{Path: dep.Path, Name: dep.Name, HasInit: dep.HasInit, Fingerprint: dep.Fingerprint},
			handoff.Import{Path: osImp.Path, Name: osImp.Name, HasInit: osImp.HasInit, Fingerprint: osImp.Fingerprint},
		},
	}
	let rtPkg = FromHandoff(encoded, want) catch {
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed:
		return false
	}
	let built = ArchiveFromHandoff(encoded, want, SampleHeader) catch {
	case handoff.UnknownVersion, handoff.Malformed, handoff.WrongTarget, handoff.StaleImport, Refused, Malformed, Undefined:
		return false
	}
	Verify(rtPkg, SampleHeader, built.Archive).Len() == 0
}
