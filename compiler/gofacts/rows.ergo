func addSyncCallbacks(tbl mut EffectTable) {
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.ContainsFunc", "", "bytes/bytes.go: calls IndexFunc synchronously; no callback is stored", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.FieldsFunc", "", "bytes/bytes.go: invokes f in its field-scanning loop; stores only byte spans", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.IndexFunc", "", "bytes/bytes.go: invokes f in its rune-scanning loop; no retained callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.LastIndexFunc", "", "bytes/bytes.go: invokes f in its reverse rune scan; no retained callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.Map", "", "bytes/bytes.go: invokes mapping per rune and returns bytes, not the callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.TrimFunc", "", "bytes/bytes.go: calls the two synchronous trim scans", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.TrimLeftFunc", "", "bytes/bytes.go: invokes f in a rune scan and keeps no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "bytes.TrimRightFunc", "", "bytes/bytes.go: invokes f in a reverse rune scan and keeps no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.ContainsFunc", "", "strings/strings.go: calls IndexFunc synchronously; no callback is stored", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.FieldsFunc", "", "strings/strings.go: invokes f in the field scan and stores only spans", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.IndexFunc", "", "strings/strings.go: invokes f in the rune scan and keeps no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.LastIndexFunc", "", "strings/strings.go: invokes f in the reverse rune scan and keeps no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.Map", "", "strings/strings.go: invokes mapping per rune and returns a string", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.TrimFunc", "", "strings/strings.go: calls the two synchronous trim scans", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.TrimLeftFunc", "", "strings/strings.go: invokes f in a rune scan and keeps no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "strings.TrimRightFunc", "", "strings/strings.go: invokes f in a reverse rune scan and keeps no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.BinarySearchFunc", "", "slices/sort.go: cmp runs only in the binary-search loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.CompactFunc", "", "slices/slices.go: eq runs only in the compaction loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.CompareFunc", "", "slices/slices.go: cmp runs only in the comparison loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.ContainsFunc", "", "slices/slices.go: calls the synchronous IndexFunc", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.DeleteFunc", "", "slices/slices.go: del runs only in the deletion loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.EqualFunc", "", "slices/slices.go: eq runs only in the equality loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.IndexFunc", "", "slices/slices.go: f runs only in the index scan", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.IsSortedFunc", "", "slices/sort.go: cmp runs only in the sortedness scan", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.MaxFunc", "", "slices/sort.go: cmp runs only in the extremum scan", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.MinFunc", "", "slices/sort.go: cmp runs only in the extremum scan", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.SortFunc", "", "slices/sort.go and zsortanyfunc.go: pdqsort calls cmp synchronously and stores no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "slices.SortStableFunc", "", "slices/sort.go and zsortanyfunc.go: stable sort calls cmp synchronously and stores no callback", "", 0, uint8(0))
