// Default vouched rows, effect/host rows, and reviewed runtime Go boundary
// clauses loaded into FactTable and EffectTable.

import dense
import option

func addReadsRows(tbl mut FactTable) {
	let _ = AddRow(tbl, Row{Target: "bytes.IndexByte", Fact: "reads", Param: "b", Reason: "its body is bytealg.IndexByte, assembly that only loads from b", Source: "9cb4c150b9d9", View: false})
	let _ = AddRow(tbl, Row{Target: "bytes.Index", Fact: "reads", Param: "s", Reason: "it reaches bytealg.Index, IndexByte and Equal, assembly that only loads, and a Rabin-Karp loop that only reads", Source: "711d86f96509", View: false})
	let _ = AddRow(tbl, Row{Target: "bytes.Index", Fact: "reads", Param: "sep", Reason: "it reaches bytealg.Index, IndexByte and Equal, assembly that only loads, and a Rabin-Karp loop that only reads", Source: "711d86f96509", View: false})
	let _ = AddRow(tbl, Row{Target: "bytes.Contains", Fact: "reads", Param: "b", Reason: "it is Index(b, subslice) != -1", Source: "cf60e3ee8bcf", View: false})
	let _ = AddRow(tbl, Row{Target: "bytes.Contains", Fact: "reads", Param: "subslice", Reason: "it is Index(b, subslice) != -1", Source: "cf60e3ee8bcf", View: false})
	let _ = AddRow(tbl, Row{Target: "bytes.Count", Fact: "reads", Param: "s", Reason: "it reaches bytealg.Count (assembly that only loads), utf8.RuneCount and Index", Source: "28a1ec4078dd", View: false})
	let _ = AddRow(tbl, Row{Target: "bytes.Count", Fact: "reads", Param: "sep", Reason: "it reads sep[0] for bytealg.Count, and passes sep to Index", Source: "28a1ec4078dd", View: false})
	let _ = AddRow(tbl, Row{Target: "crypto/sha256.Sum256", Fact: "reads", Param: "data", Reason: "Write copies data into the digest's buffer and the block function, assembly, only loads from it", Source: "d1bd973fda38", View: true})
	let _ = AddRow(tbl, Row{Target: "hash/crc32.ChecksumIEEE", Fact: "reads", Param: "data", Reason: "it calls the function variable updateIEEE, assembly or a table loop that only loads", Source: "0a577c2fb9b4", View: true})
	let _ = AddRow(tbl, Row{Target: "strings.Join", Fact: "reads", Param: "elems", Reason: "Go reports only that an element string flows to the result (leaking param: elems to result level=1): the slice's array is neither written nor kept, and a string is immutable", Source: "8aa66715ab45", View: false})
	let _ = AddRow(tbl, Row{Target: "path/filepath.Join", Fact: "reads", Param: "elem", Reason: "it is join(elem), which reslices elem and passes it to strings.Join (a reads row); Go's mutation verdict comes from the inlined Clean of the joined string, which is immutable", Source: "6fc7b1fadbe3", View: false})
	let _ = AddRow(tbl, Row{Target: "hash/crc32.Update", Fact: "reads", Param: "p", Reason: "it calls update, over the function variables updateIEEE and updateCastagnoli or a table loop, that only loads", Source: "fadaf3baa7c7", View: true})
	let _ = AddRow(tbl, Row{Target: "os.File.Write", Fact: "reads", Param: "b", Reason: "it passes b to poll.FD.Write, which hands each chunk of b to the write system call; the kernel only loads from it and nothing keeps it", Source: "623de74b5313", View: false})
	let _ = AddRow(tbl, Row{Target: "os.File.WriteAt", Fact: "reads", Param: "b", Reason: "it passes each rest of b to File.pwrite, poll.FD.Pwrite, which hands it to the pwrite system call; the kernel only loads from it and nothing keeps it", Source: "adab3799e15d", View: false})
}

func addFreshRows(tbl mut FactTable) {
	let _ = AddRow(tbl, Row{Target: "os.File.Readdirnames", Fact: "fresh", Param: "result", Reason: "File.readdir appends each name, a new string, to a nil slice (or returns a new empty one)", Source: "9564848e855e", View: false})
	let _ = AddRow(tbl, Row{Target: "strings.Split", Fact: "fresh", Param: "result", Reason: "genSplit makes the result with make and fills it with substrings of s", Source: "65e3a355768c", View: false})
	let _ = AddRow(tbl, Row{Target: "strings.SplitN", Fact: "fresh", Param: "result", Reason: "genSplit makes the result with make and fills it with substrings of s", Source: "ebc89999b4be", View: false})
	let _ = AddRow(tbl, Row{Target: "strings.SplitAfter", Fact: "fresh", Param: "result", Reason: "genSplit makes the result with make and fills it with substrings of s", Source: "3568d9599e11", View: false})
	let _ = AddRow(tbl, Row{Target: "strings.Fields", Fact: "fresh", Param: "result", Reason: "it makes the result with make (or calls FieldsFunc) and fills it with substrings of s", Source: "03cc79a67909", View: false})
	let _ = AddRow(tbl, Row{Target: "strings.FieldsFunc", Fact: "fresh", Param: "result", Reason: "it makes spans and the result with make and fills the result with substrings of s", Source: "e7015b80f1e8", View: false})
	let _ = AddRow(tbl, Row{Target: "regexp.Regexp.FindAllString", Fact: "fresh", Param: "result", Reason: "it is slices.Collect over allString, which appends each match's substring to a nil slice", Source: "e0b9bb9db7ad", View: false})
	let _ = AddRow(tbl, Row{Target: "regexp.Regexp.FindStringSubmatch", Fact: "fresh", Param: "result", Reason: "it makes the result with make from the match's indexes", Source: "d6982e2c79d9", View: false})
	let _ = AddRow(tbl, Row{Target: "regexp.Regexp.FindAllStringSubmatch", Fact: "fresh", Param: "result", Reason: "it is slices.Collect over allStringSubmatch, which makes each match's slice with make", Source: "670036968b42", View: false})
	let _ = AddRow(tbl, Row{Target: "regexp.Regexp.Split", Fact: "fresh", Param: "result", Reason: "it makes the result with make and appends substrings of s", Source: "f9bf7fc8970d", View: false})
}

// DefaultFactTable returns a FactTable seeded with all shipped vouched rows.
func DefaultFactTable() FactTable {
	let mut tbl = NewFactTable()
	addReadsRows(&tbl)
	addFreshRows(&tbl)
	tbl
}

