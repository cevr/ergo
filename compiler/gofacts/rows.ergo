	let _ = AddEffectEntry(tbl, KindSyncCallback, "maps.EqualFunc", "", "maps/maps.go: eq runs only in the equality loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "sort.Find", "", "sort/search.go: cmp runs only in the search loop and final comparison", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "sort.Search", "", "sort/search.go: f runs only in the search loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "math/rand.Shuffle", "", "math/rand/rand.go: delegates to Rand.Shuffle synchronously", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "math/rand.Rand.Shuffle", "", "math/rand/rand.go: swap runs only in the Fisher-Yates loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "math/rand/v2.Shuffle", "", "math/rand/v2/rand.go: delegates to Rand.Shuffle synchronously", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "math/rand/v2.Rand.Shuffle", "", "math/rand/v2/rand.go: swap runs only in the Fisher-Yates loop", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "os.Expand", "", "os/env.go: mapping runs only in the expansion scan; only the string result is stored", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "path/filepath.Walk", "", "path/filepath/path.go: recursive walk returns before Walk returns; no callback is stored", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "path/filepath.WalkDir", "", "path/filepath/path.go: recursive walkDir returns before WalkDir returns; no callback is stored", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "io/fs.WalkDir", "", "io/fs/walk.go: recursive walkDir returns before WalkDir returns; no callback is stored", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "regexp.Regexp.ReplaceAllFunc", "", "regexp/regexp.go: replacement callback runs only inside replaceAll", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "regexp.Regexp.ReplaceAllStringFunc", "", "regexp/regexp.go: replacement callback runs only inside replaceAll", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "flag.Visit", "", "flag/flag.go: delegates to CommandLine.Visit synchronously", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "flag.VisitAll", "", "flag/flag.go: delegates to CommandLine.VisitAll synchronously", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "flag.FlagSet.Visit", "", "flag/flag.go: invokes fn over the sorted actual flags and stores no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "flag.FlagSet.VisitAll", "", "flag/flag.go: invokes fn over the sorted formal flags and stores no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "go/ast.Inspect", "", "go/ast/walk.go: Walk calls the visitor synchronously over the syntax tree", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "expvar.Do", "", "expvar/expvar.go: invokes f over the variables under the call's lock and stores no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "log/slog.Record.Attrs", "", "log/slog/record.go: invokes f over the record's attributes and stores no callback", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindSyncCallback, "sync.Once.Do", "", "sync/once.go: doSlow runs f synchronously under the lock and retains only the done flag", "", 0, uint8(0))
}

func addPurityEntries(tbl mut EffectTable) {
	let purePkgs = []string{"strings", "strconv", "unicode", "unicode/utf8", "unicode/utf16", "slices", "sort", "math", "math/bits", "path/filepath", "encoding/hex", "encoding/base64", "crypto/sha256", "hash/crc32", "crypto/sha512", "crypto/sha1", "crypto/hmac", "net/url", "net/netip", "simd/archsimd"}
	for p in purePkgs {
		let _ = AddEffectEntry(tbl, KindPurePkg, p, "", "", "", 0, uint8(0))
	}
	for m in []string{"Abs", "EvalSymlinks", "Glob", "Walk", "WalkDir"} {
		let _ = AddEffectEntry(tbl, KindPureExcept, "path/filepath", m, "", "", 0, uint8(0))
	}
	let _ = AddEffectEntry(tbl, KindPureHostMember, "encoding/csv", "", "", "", 0, FlagNilMembers)
	for m in []string{"Now", "Since", "Until", "Sleep", "After", "AfterFunc", "Tick", "NewTicker", "NewTimer", "Local", "LoadLocation", "Parse"} {
		let _ = AddEffectEntry(tbl, KindPureHostMember, "time", m, "", "", 0, uint8(0))
	}
}

func addBoundaryClauses(tbl mut EffectTable) {
	let _ = AddEffectEntry(tbl, KindGoArgClause, "bufio.NewReader", "", "bufio/bufio.go: NewReaderSize stores rd in Reader.rd, and Reader has no Close", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoArgClause, "bufio.NewReaderSize", "", "bufio/bufio.go: stores rd in Reader.rd; later reads call it", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoArgClause, "bufio.NewWriter", "", "bufio/bufio.go: NewWriterSize stores w in Writer.wr; later Flush calls it", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoArgClause, "bufio.NewWriterSize", "", "bufio/bufio.go: stores w in Writer.wr; later Flush calls it", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoArgClause, "io.ReadAll", "", "io/io.go: reads in a loop, returns only collected bytes", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "io.ReadAtLeast", "", "io/io.go: reads in a loop and stores no reader", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "io.ReadFull", "", "io/io.go: returns ReadAtLeast's result and keeps no reader", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "io.WriteString", "", "io/io.go: one synchronous WriteString or Write call, no retained writer", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Name", "", "os/file.go: reads the file's name, retains no receiver", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.StartProcess", "", "os/exec_posix.go: startProcess copies attr's Dir, Env, Sys (ensurePidfd copies it when it changes it) and each file's Fd into a syscall.ProcAttr; it keeps no attr past its return (GBX5)", "", 2, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Read", "", "os/file.go: read and error conversion finish before return", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.ReadAt", "", "os/file.go: pread loop finishes before return", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Write", "", "os/file.go: write and error conversion finish before return", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.WriteAt", "", "os/file.go: pwrite loop finishes before return", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.WriteString", "", "os/file.go: calls Write synchronously and keeps no receiver", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Seek", "", "os/file.go: seek completes before return and retains no receiver", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Sync", "", "os/file_posix.go: fsync completes before return and retains no receiver", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Stat", "", "os/stat_*.go: fstat returns metadata, not a reference to the File", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Truncate", "", "os/file_posix.go: truncate completes before return and retains no receiver", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Readdir", "", "os/dir.go: returns file info values after the directory read", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.Readdirnames", "", "os/dir.go: returns names after the directory read", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "os.File.ReadDir", "", "os/dir.go: returns entries after the directory read", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "ergo.local/prototype/runtime/v1/hostfs.FileStat", "", "runtime/v1/hostfs: calls f.Stat once and copies its values; keeps no f", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "ergo.local/prototype/runtime/v1/hostfs.FileReadDir", "", "runtime/v1/hostfs: calls f.ReadDir once and copies its entries; keeps no f", "", 0, FlagLent)
	let _ = AddEffectEntry(tbl, KindGoArgClause, "ergo.local/prototype/runtime/v1/hostfs.FileReaddir", "", "runtime/v1/hostfs: calls f.Readdir once and copies its values; keeps no f", "", 0, FlagLent)

	let _ = AddEffectEntry(tbl, KindGoWrite, "os.File.Read", "", "os/file.go: f.read(b) fills b[:n] through poll.FD.Read, keeps no reference", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "os.File.ReadAt", "", "os/file.go: f.pread(b, off) fills b in a loop through poll.FD.Pread, keeps no reference", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "slices.Sort", "", "slices/sort.go: pdqsortOrdered sorts x's elements in place, keeps no reference", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "slices.SortFunc", "", "slices/sort.go: pdqsortCmpFunc sorts x's elements in place, keeps no reference", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "slices.SortStableFunc", "", "slices/sort.go: stableCmpFunc sorts x's elements in place, keeps no reference", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "slices.Reverse", "", "slices/slices.go: swaps s's elements in place, keeps no reference", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "sort.Ints", "", "sort/sort.go: slices.Sort(x)", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "sort.Float64s", "", "sort/sort.go: slices.Sort(x)", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoWrite, "sort.Strings", "", "sort/sort.go: slices.Sort(x)", "", 0, uint8(0))

	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "encoding/base64.StdEncoding", "", "encoding/base64/base64.go: = NewEncoding(…) at init; the package never assigns it", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "encoding/base64.URLEncoding", "", "encoding/base64/base64.go: = NewEncoding(…) at init; the package never assigns it", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "encoding/base64.RawStdEncoding", "", "encoding/base64/base64.go: = StdEncoding.WithPadding(NoPadding) at init; never assigned", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "encoding/base64.RawURLEncoding", "", "encoding/base64/base64.go: = URLEncoding.WithPadding(NoPadding) at init; never assigned", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "hash/crc32.IEEETable", "", "hash/crc32/crc32.go: = simpleMakeTable(IEEE) at init; the package reads it only", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "time.UTC", "", "time/zoneinfo.go: = &utcLoc; the package never assigns it", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "time.Local", "", "time/zoneinfo.go: = &localLoc; the package never assigns it (it fills localLoc lazily, behind a sync.Once)", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoReadOnlyVar, "os.Args", "", "os/proc.go: set once by the runtime's init (runtime_args); the package never assigns it", "", 0, uint8(0))

	let _ = AddEffectEntry(tbl, KindGoConcurrent, "sync/atomic.Bool", "", "sync/atomic/type.go: each method is one atomic operation on the value's word", "", 0, uint8(0))
	let _ = AddEffectEntry(tbl, KindGoConcurrent, "sync/atomic.Int64", "", "sync/atomic/type.go: each method is one atomic operation on the value's word", "", 0, uint8(0))
}

// DefaultEffectTable returns an EffectTable seeded with all shipped effect,
// host, sync-callback, purity, write, arg-clause, read-only var, and
// concurrent-type rows.
func DefaultEffectTable() EffectTable {
	let mut tbl = NewEffectTable()
	addEffectNone(&tbl)
	addEffectAmbient(&tbl)
	addSyncCallbacks(&tbl)
	addPurityEntries(&tbl)
	addBoundaryClauses(&tbl)
	tbl
}

// AllEffectsByKind returns all Effect views in tbl matching KindEffectNone or KindEffectAmbient.
func AllEffectsByKind(tbl EffectTable, kind uint8) []Effect {
	let n = NumEffects(tbl)
	let mut out = []Effect{}
	for i in 0..n {
		let id = EffectRowAt(tbl, i)
		if dense.Of(tbl.Kind, id) == kind {
			out = out.Append(Effect{
				Target: dense.Text(tbl.Strings, dense.Of(tbl.Target, id)),
				Reason: dense.Text(tbl.Strings, dense.Of(tbl.Reason, id)),
				Source: dense.Text(tbl.Strings, dense.Of(tbl.Source, id)),
			})
		}
	}
	out
}

// AllSyncTargets returns all synchronous-callback targets in insertion order.
func AllSyncTargets(tbl EffectTable) []string {
	let n = NumEffects(tbl)
	let mut out = []string{}
	for i in 0..n {
		let id = EffectRowAt(tbl, i)
		if dense.Of(tbl.Kind, id) == KindSyncCallback {
			out = out.Append(dense.Text(tbl.Strings, dense.Of(tbl.Target, id)))
		}
	}
	out
}

// AllPurePkgs returns all pure package paths in tbl in insertion order.
func AllPurePkgs(tbl EffectTable) []string {
	let n = NumEffects(tbl)
	let mut out = []string{}
	for i in 0..n {
		let id = EffectRowAt(tbl, i)
		if dense.Of(tbl.Kind, id) == KindPurePkg {
			out = out.Append(dense.Text(tbl.Strings, dense.Of(tbl.Target, id)))
		}
	}
	out
}

// AllTargetsOfKind returns all Target strings stored under kind in insertion order.
func AllTargetsOfKind(tbl EffectTable, kind uint8) []string {
	let n = NumEffects(tbl)
	let mut out = []string{}
	for i in 0..n {
		let id = EffectRowAt(tbl, i)
		if dense.Of(tbl.Kind, id) == kind {
			out = out.Append(dense.Text(tbl.Strings, dense.Of(tbl.Target, id)))
		}
	}
	out
}

// DefaultTablesCounts verifies exact counts of all shipped tables in DefaultFactTable and DefaultEffectTable.
test DefaultTablesCounts {
	let ft = DefaultFactTable()
	let et = DefaultEffectTable()
	assert NumRows(ft) == 24
	assert AllEffectsByKind(et, KindEffectNone).Len() == 30
	assert AllEffectsByKind(et, KindEffectAmbient).Len() == 46
	assert AllSyncTargets(et).Len() == 52
	assert AllPurePkgs(et).Len() == 20
	assert PureExcept(et, "path/filepath").Len() == 5
	match PureHostMembers(et, "encoding/csv") {
	case option.Some{Value: xs}:
		assert xs.Len() == 0
	case option.None:
		assert false
	}
	match PureHostMembers(et, "time") {
	case option.Some{Value: xs}:
		assert xs.Len() == 12
	case option.None:
		assert false
	}
	assert AllTargetsOfKind(et, KindGoWrite).Len() == 9
	assert AllTargetsOfKind(et, KindGoArgClause).Len() == 25
	assert AllTargetsOfKind(et, KindGoReadOnlyVar).Len() == 8
	assert AllTargetsOfKind(et, KindGoConcurrent).Len() == 2
	assert !GoArgLent(et, "bufio.NewReader", 0)
	assert GoArgLent(et, "os.StartProcess", 2)
}

// KnownRowDigestsMatchStd checks exact digest parity with shipped ergo.laws rows.
law KnownRowDigestsMatchStd() {
	let ft = DefaultFactTable()
	let et = DefaultEffectTable()
	let containsRows = FindRows(ft, "bytes.Contains")
	let shaRows = FindRows(ft, "crypto/sha256.Sum256")
	let statHost = HostOf(et, "ergo.local/prototype/runtime/v1/hostfs.Stat")
	let mut ok = containsRows.Len() == 2 && RowDigest(containsRows[0], DefaultToolchain) == "h1:cjBd+Wj68ykmOG/0VfhzAw9Y/6+aNOuA5w1pzzNWNwI="
	ok = ok && shaRows.Len() == 1 && RowDigest(shaRows[0], DefaultToolchain) == "h1:T7e2yd/DWHz2kDGtsKGHVxe7Lv8WKVODCneEqC755qE="
	ok = ok && PureDigest("crypto/hmac", []string{}, DefaultToolchain) == "h1:oBN88poGWu66ApKX/tn/5v+pwNFRz4ilsmpprnS7vKk="
	match SyncReason(et, "bytes.ContainsFunc") {
	case option.Some{Value: reason}:
		ok = ok && SyncDigest("bytes.ContainsFunc", reason, DefaultToolchain) == "h1:YyoKNgseXLR57iBUEfwJ2kErj3mb0B0FYGK81ko2V/A="
	case option.None:
		ok = false
	}
	match statHost {
	case option.Some{Value: eff}:
		ok = ok && HostDigest(eff, DefaultToolchain) == "h1:nFnSkH1a/C75WshEZGFkVNwBm5TWmNuFdglevEi+GGA="
	case option.None:
		ok = false
	}
	ok
}
