import dense
import option
import slices
import strings

// Scratch holds reusable scratch buffers shared across lawledger parsers and formatters.
type Scratch {
	Bytes   []byte,
	Strs    []string,
	Starts  []uint32,
	Ends    []uint32,
	Kinds   []uint8,
	Indices []uint32,
	Stack   []uint32,
}

// NewScratch allocates an empty Scratch with pre-sized buffer capacities.
func NewScratch() Scratch {
	Scratch{
		Bytes:   slices.WithCapacity[byte](256),
		Strs:    slices.WithCapacity[string](64),
		Starts:  slices.WithCapacity[uint32](64),
		Ends:    slices.WithCapacity[uint32](64),
		Kinds:   slices.WithCapacity[uint8](64),
		Indices: slices.WithCapacity[uint32](64),
		Stack:   slices.WithCapacity[uint32](32),
	}
}

// ResetScratch clears all scratch slice lengths while retaining backing capacity.
func ResetScratch(sc mut Scratch) {
	(*sc).Bytes = (*sc).Bytes[:0]
	(*sc).Strs = (*sc).Strs[:0]
	(*sc).Starts = (*sc).Starts[:0]
	(*sc).Ends = (*sc).Ends[:0]
	(*sc).Kinds = (*sc).Kinds[:0]
	(*sc).Indices = (*sc).Indices[:0]
	(*sc).Stack = (*sc).Stack[:0]
}

func internPoolStr(st mut dense.Strings, pool mut []string, s string) uint32 {
	let id = dense.InternText(st, s)
	let idx = dense.Index(id)
	for (*pool).Len() <= idx {
		*pool = (*pool).Append("")
	}
	(*pool)[idx] = s
	uint32(idx)
}

func findPoolStr(st dense.Strings, s string) option.Option[uint32] {
	match dense.FindText(st, s) {
	case option.Some[dense.ID[dense.Str]] as found:
		option.Some[uint32]{Value: uint32(dense.Index(found.Value))}
	case option.None:
		option.None
	}
}

func poolStrAt(pool []string, id uint32) string {
	let idx = int(id)
	if idx < 0 || idx >= pool.Len() {
		return ""
	}
	pool[idx]
}

type cutPair {
	ok     bool,
	before string,
	after  string,
}

func cutFirst(s string, sep string) cutPair {
	let idx = strings.Index(s, sep)
	if idx < 0 {
		return cutPair{ok: false, before: s, after: ""}
	}
	cutPair{ok: true, before: s[:idx], after: s[idx+sep.Len():]}
}

func isASCIIBlank(b byte) bool {
	b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == '\f'
}

// NormalizeWhitespace collapses ASCII whitespace runs into single spaces and trims ends.
func NormalizeWhitespace(s string, sc mut Scratch) string {
	let n = s.Len()
	let mut i = 0
	for i < n && isASCIIBlank(s[i]) {
		i = i + 1
	}
	if i == n {
		return ""
	}
	(*sc).Strs = (*sc).Strs[:0]
	for i < n {
		let start = i
		for i < n && !isASCIIBlank(s[i]) {
			i = i + 1
		}
		if start < i {
			(*sc).Strs = (*sc).Strs.Append(s[start:i])
		}
		for i < n && isASCIIBlank(s[i]) {
			i = i + 1
		}
	}
	strings.Join((*sc).Strs, " ")
}

// FormatUint64Hex formats v in lowercase hexadecimal without a 0x prefix.
func FormatUint64Hex(v uint64) string {
	if v == uint64(0) {
		return "0"
	}
	let digits = "0123456789abcdef"
	let mut buf = []string{}
	let mut x = v
	for x > uint64(0) {
		let nib = int(x & uint64(0x0f))
		buf = buf.Append(digits[nib : nib+1])
		x = x >> uint64(4)
	}
	let mut out = slices.WithCapacity[string](buf.Len())
	let mut j = buf.Len() - 1
	for j >= 0 {
		out = out.Append(buf[j])
		j = j - 1
	}
	strings.Join(out, "")
}

// ParseUint64Hex parses a non-empty hexadecimal uint64 string without 0x prefix.
func ParseUint64Hex(s string) option.Option[uint64] {
	let n = s.Len()
	if n == 0 || n > 16 {
		return option.None
	}
	let mut v = uint64(0)
	let mut i = 0
	for i < n {
		let c = s[i]
		let mut d = uint64(0)
		if c >= '0' && c <= '9' {
			d = uint64(c - '0')
		} else if c >= 'a' && c <= 'f' {
			d = uint64(c-'a') + uint64(10)
		} else if c >= 'A' && c <= 'F' {
			d = uint64(c-'A') + uint64(10)
		} else {
			return option.None
		}
		v = (v << uint64(4)) | d
		i = i + 1
	}
	option.Some[uint64]{Value: v}
}

// FormatUint64 formats v in base 10.
func FormatUint64(v uint64) string {
	if v == uint64(0) {
		return "0"
	}
	let digits = "0123456789"
	let mut rev = []string{}
	let mut x = v
	for x > uint64(0) {
		let d = int(x % uint64(10))
		rev = rev.Append(digits[d : d+1])
		x = x / uint64(10)
	}
	let mut out = slices.WithCapacity[string](rev.Len())
	let mut j = rev.Len() - 1
	for j >= 0 {
		out = out.Append(rev[j])
		j = j - 1
	}
	strings.Join(out, "")
}

// ParseUint64 parses an unsigned decimal integer, returning None if malformed or overflowing uint64.
func ParseUint64(s string) option.Option[uint64] {
	let n = s.Len()
	if n == 0 {
		return option.None
	}
	let maxDiv10 = uint64(1844674407370955161)
	let maxMod10 = uint64(5)
	let mut v = uint64(0)
	let mut i = 0
	for i < n {
		let c = s[i]
		if c < '0' || c > '9' {
			return option.None
		}
		let d = uint64(c - '0')
		if v > maxDiv10 || (v == maxDiv10 && d > maxMod10) {
			return option.None
		}
		v = v*uint64(10) + d
		i = i + 1
	}
	option.Some[uint64]{Value: v}
}

// FormatUint32 formats v in base 10.
func FormatUint32(v uint32) string {
	FormatUint64(uint64(v))
}

// ParseUint32 parses an unsigned 32-bit decimal integer, returning None on invalid input.
func ParseUint32(s string) option.Option[uint32] {
	match ParseUint64(s) {
	case option.Some[uint64] as u:
		if u.Value > uint64(4294967295) {
			return option.None
		}
		option.Some[uint32]{Value: uint32(u.Value)}
	case option.None:
		option.None
	}
}

// Uint64HexRoundTrips ensures ParseUint64Hex inverts FormatUint64Hex for every uint64.
law Uint64HexRoundTrips(v uint64) {
	match ParseUint64Hex(FormatUint64Hex(v)) {
	case option.Some[uint64] as got:
		got.Value == v
	case option.None:
		false
	}
}

// Uint64DecimalRoundTrips ensures ParseUint64 inverts FormatUint64 for every uint64.
law Uint64DecimalRoundTrips(v uint64) {
	match ParseUint64(FormatUint64(v)) {
	case option.Some[uint64] as got:
		got.Value == v
	case option.None:
		false
	}
}

// NormalizeWhitespaceIsIdempotent ensures normalizing whitespace twice yields the same text.
law NormalizeWhitespaceIsIdempotent(s string) {
	let mut sc = NewScratch()
	let a = NormalizeWhitespace(s, &sc)
	let b = NormalizeWhitespace(a, &sc)
	a == b
}

test TestScratchHelpers {
	let mut sc = NewScratch()
	assert NormalizeWhitespace("  a\t\nb\f\r c  ", &sc) == "a b c"
	assert NormalizeWhitespace("   \t\n ", &sc) == ""
	assert FormatUint64Hex(uint64(0)) == "0"
	assert FormatUint64Hex(uint64(0xdeadbeef)) == "deadbeef"
	assert ParseUint64Hex("0x10") == option.None
	let maxU64 uint64 = 18446744073709551615
	assert ParseUint64("18446744073709551615") == option.Some[uint64]{Value: maxU64}
	assert ParseUint64("18446744073709551616") == option.None
	assert ParseUint32("4294967295") == option.Some[uint32]{Value: uint32(4294967295)}
	assert ParseUint32("4294967296") == option.None
	ResetScratch(&sc)
	assert sc.Strs.Len() == 0
}
