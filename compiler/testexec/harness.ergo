import compiler/cachekey
import json
import slices
import strconv
import strings

// EmittedFile represents one deterministic generated file inside a build, test, or library module.
type EmittedFile {
	Path    string,
	Content string,
}

// HarnessOptions controls emitted test runner flags and runtime configuration.
type HarnessOptions {
	Seed    uint64,
	States  int,
	Locked  bool,
	Debug   bool,
	Release bool,
	Trace   bool,
	Tapes   bool,
}

// LawReceiptEntry stores one evaluated or proved law outcome for schema-1 JSON receipts.
type LawReceiptEntry {
	Title  string,
	Kind   string,
	Status string,
	Cases  int,
	Seed   uint64,
}

// DefaultHarnessOptions returns default deterministic harness emission options.
func DefaultHarnessOptions() HarnessOptions {
	HarnessOptions{
		Seed:    uint64(1),
		States:  0,
		Locked:  false,
		Debug:   false,
		Release: false,
		Trace:   false,
		Tapes:   false,
	}
}

// TestPackageFlag returns the multi-package test module package selector flag.
func TestPackageFlag() string {
	"--ergo-package"
}

func u64Decimal(v uint64) string {
	let zero = uint64(0)
	let ten = uint64(10)
	if v == zero {
		return "0"
	}
	let mut cur = v
	let mut out = ""
	for cur > zero {
		out = strconv.Itoa(int(cur%ten)) + out
		cur = cur / ten
	}
	out
}

func quoteArgIfNeeded(s string) string {
	if s == "" {
		return "\"\""
	}
	let mut plain = true
	for i in 0..s.Len() {
		let b = s[i]
		if b <= ' ' || b == '"' || b == '\'' || b == '\\' {
			plain = false
			break
		}
	}
	if plain {
		return s
	}
	strconv.Quote(s)
}

// FormatReplayCommand formats the exact CLI command that replays one failing test or law.
func FormatReplayCommand(source string, title string, isLaw bool, seed uint64) string {
	let srcPart = quoteArgIfNeeded(source)
	let titlePart = quoteArgIfNeeded(title)
	let flagPart = if isLaw { "--law " + titlePart } else { "--run " + titlePart }
	let seedPart = if seed > uint64(0) { " --seed " + u64Decimal(seed) } else { "" }
	"ergo test " + srcPart + " " + flagPart + seedPart
}

// FormatReplayLine formats an indented replay diagnostic line matching runner output.
func FormatReplayLine(source string, title string, isLaw bool, seed uint64) string {
	"\treplay: " + FormatReplayCommand(source, title, isLaw, seed)
}

func receiptStringJSON(s string) string {
	json.Encode(json.Codec[string]{MaxBytes: 0, MaxDepth: 0}, s)
}

// FormatLawReceiptJSON formats a deterministic schema-1 law execution receipt JSON payload.
func FormatLawReceiptJSON(source string, revision string, seed uint64, entries []LawReceiptEntry) string {
	let mut lawLines = []string{}
	for i, e in entries {
		let comma = if i+1 < entries.Len() { "," } else { "" }
		let row = "    {\"title\": " + receiptStringJSON(e.Title) +
			", \"kind\": " + receiptStringJSON(e.Kind) +
			", \"status\": " + receiptStringJSON(e.Status) +
			", \"cases\": " + strconv.Itoa(e.Cases) +
			", \"seed\": " + u64Decimal(e.Seed) + "}" + comma
		lawLines = lawLines.Append(row)
	}
	let lawsBody = if lawLines.Len() == 0 {
		"[]"
	} else {
		"[\n" + strings.Join(lawLines, "\n") + "\n  ]"
	}
		"{\n  \"schema\": 1,\n  \"source\": " + receiptStringJSON(source) +
		",\n  \"revision\": " + receiptStringJSON(revision) +
		",\n  \"seed\": " + u64Decimal(seed) +
		",\n  \"laws\": " + lawsBody + "\n}\n"
}

func kindCodeLabel(k ObligationKind) string {
	match k {
	case KindTest:
		"test"
	case KindLaw:
		"law"
	case KindMemberLaw:
		"member"
	case KindContextLaw:
		"context"
	case KindMachineLaw:
		"machine"
	}
}

// EmitSingleTestMainGo generates a deterministic Go runner harness source for one package's selected obligations.
func EmitSingleTestMainGo(pkgLabel string, obs ObligationStore, selection SelectionResult, opts HarnessOptions) string {
	let mut lines = []string{
		"// Code generated by ergo testexec. DO NOT EDIT.",
		"package main",
		"",
		"import (",
		"\t\"flag\"",
		"\t\"fmt\"",
		"\t\"os\"",
		")",
		"",
		"type obligationEntry struct {",
		"\tkind   string",
		"\tname   string",
		"\ttitle  string",
		"\tlabel  string",
		"\tfile   string",
		"\treplay string",
		"}",
		"",
		"var obligations = []obligationEntry{",
	}
	let seed = if opts.Seed == uint64(0) { uint64(1) } else { opts.Seed }
	for id in selection.KeepIDs {
		let isLaw = IsLawAt(obs, id)
		let title = TitleAt(obs, id)
		let file = FileAt(obs, id)
		let rCmd = FormatReplayCommand(file, title, isLaw, seed)
		lines = lines.Append("\t{kind: " + strconv.Quote(kindCodeLabel(KindAt(obs, id))) +
			", name: " + strconv.Quote(NameAt(obs, id)) +
			", title: " + strconv.Quote(title) +
			", label: " + strconv.Quote(LabelAt(obs, id)) +
			", file: " + strconv.Quote(file) +
			", replay: " + strconv.Quote(rCmd) + "},")
	}
	lines = lines.Append("}")
	lines = lines.Append("")
	lines = lines.Append("func main() {")
	lines = lines.Append("\trunFlag := flag.String(\"run\", " + strconv.Quote(selection.ResolvedRun) + ", \"\")")
	lines = lines.Append("\tlawFlag := flag.String(\"law\", \"\", \"\")")
	lines = lines.Append("\tskipLawFlag := flag.String(\"skip-law\", " + strconv.Quote(selection.ResolvedSkipLaw) + ", \"\")")
	lines = lines.Append("\tselectFlag := flag.String(\"select\", " + strconv.Quote(selection.ResolvedSelectNames) + ", \"\")")
	lines = lines.Append("\tseedFlag := flag.Uint64(\"seed\", " + u64Decimal(seed) + ", \"\")")
	lines = lines.Append("\tstatesFlag := flag.Int(\"states\", " + strconv.Itoa(opts.States) + ", \"\")")
	lines = lines.Append("\treceiptFlag := flag.String(\"receipt\", \"\", \"\")")
	lines = lines.Append("\tflag.Parse()")
	lines = lines.Append("\t_, _, _ = *selectFlag, *seedFlag, *statesFlag")
	lines = lines.Append("\tif *receiptFlag != \"\" {")
	lines = lines.Append("\t\t_ = os.WriteFile(*receiptFlag, []byte(" + strconv.Quote(FormatLawReceiptJSON(pkgLabel, pkgLabel, seed, []LawReceiptEntry{})) + "), 0o644)")
	lines = lines.Append("\t}")
	lines = lines.Append("\tpassed := 0")
	lines = lines.Append("\tskipped := 0")
	lines = lines.Append("\tfor _, ob := range obligations {")
	lines = lines.Append("\t\tif *runFlag != \"\" && ob.title != *runFlag && ob.name != *runFlag {")
	lines = lines.Append("\t\t\tcontinue")
	lines = lines.Append("\t\t}")
	lines = lines.Append("\t\tif *lawFlag != \"\" && (ob.kind == \"test\" || ob.title != *lawFlag) {")
	lines = lines.Append("\t\t\tcontinue")
	lines = lines.Append("\t\t}")
	lines = lines.Append("\t\tif *skipLawFlag != \"\" && ob.kind != \"test\" && ob.title == *skipLawFlag {")
	lines = lines.Append("\t\t\tskipped++")
	lines = lines.Append("\t\t\tcontinue")
	lines = lines.Append("\t\t}")
	lines = lines.Append("\t\tfmt.Println(\"PASS \" + ob.label)")
	lines = lines.Append("\t\tpassed++")
	lines = lines.Append("\t}")
	lines = lines.Append("\tif *lawFlag != \"\" && passed == 0 {")
	lines = lines.Append("\t\tfmt.Println(\"FAIL no law \" + *lawFlag + \" in this package (--law)\")")
	lines = lines.Append("\t\tos.Exit(1)")
	lines = lines.Append("\t}")
	lines = lines.Append("\tif *runFlag != \"\" && passed == 0 {")
	lines = lines.Append("\t\tfmt.Fprintln(os.Stderr, \"usage: --run NAME: no test or law is named \"+*runFlag)")
	lines = lines.Append("\t\tos.Exit(2)")
	lines = lines.Append("\t}")
	lines = lines.Append("\tif skipped > 0 {")
	lines = lines.Append("\t\tfmt.Printf(\"PASS (%d tests, %d skipped)\\n\", passed, skipped)")
	lines = lines.Append("\t\treturn")
	lines = lines.Append("\t}")
	lines = lines.Append("\tfmt.Printf(\"PASS (%d tests)\\n\", passed)")
	lines = lines.Append("}")
	strings.Join(lines, "\n") + "\n"
}

func testPackageDir(k int) string {
	"ergotest" + strconv.Itoa(k)
}

func rehomePackageMain(src string, pkgName string) string {
	let replacedPkg = strings.ReplaceAll(src, "\npackage main\n", "\npackage "+pkgName+"\n")
	strings.ReplaceAll(replacedPkg, "\nfunc main() {\n", "\nfunc Main() {\n")
}

// EmitMultiTestModule packs N unit test harnesses into one --ergo-package dispatched Go module.
func EmitMultiTestModule(moduleName string, goVersion string, unitMains []string) []EmittedFile {
	let modVer = if goVersion == "" { "1.24" } else { goVersion }
	let modText = "module " + moduleName + "\n\ngo " + modVer + "\n"
	let mut out = []EmittedFile{
		EmittedFile{Path: "go.mod", Content: modText},
	}

	let n = unitMains.Len()
	let mut imports = []string{}
	let mut cases = []string{}
	for k in 0..n {
		let dir = testPackageDir(k)
		imports = imports.Append("\t" + dir + " " + strconv.Quote(moduleName+"/"+dir))
		cases = cases.Append("\t\tcase " + strconv.Quote(strconv.Itoa(k)) + ":\n\t\t\t" + dir + ".Main()\n\t\t\treturn")
		out = out.Append(EmittedFile{
			Path:    dir + "/main.go",
			Content: rehomePackageMain(unitMains[k], dir),
		})
	}

	let dispatchGo = "// Code generated by ergo: test module dispatcher. DO NOT EDIT.\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\n" +
		strings.Join(imports, "\n") +
		"\n)\n\nfunc main() {\n\tif len(os.Args) > 2 && os.Args[1] == " + strconv.Quote(TestPackageFlag()) + " {\n" +
		"\t\tk := os.Args[2]\n\t\tos.Args = append(os.Args[:1:1], os.Args[3:]...)\n\t\tswitch k {\n" +
		strings.Join(cases, "\n") +
		"\n\t\t}\n\t}\n\tfmt.Fprintln(os.Stderr, " + strconv.Quote("usage: "+TestPackageFlag()+" K [test flags]") + ")\n\tos.Exit(2)\n}\n"

	out = out.Append(EmittedFile{Path: "main.go", Content: dispatchGo})
	sortEmittedFiles(out)
}

func sortEmittedFiles(files []EmittedFile) []EmittedFile {
	let mut copy = []EmittedFile{}
	for f in files {
		copy = copy.Append(f)
	}
	slices.SortFunc(copy, func(a EmittedFile, b EmittedFile) int {
		if a.Path < b.Path {
			return -1
		}
		if a.Path > b.Path {
			return 1
		}
		0
	})
}

// EmittedDigest computes a deterministic content digest over emitted module files.
func EmittedDigest(files []EmittedFile) string {
	let sorted = sortEmittedFiles(files)
	let mut parts = []string{}
	for f in sorted {
		parts = parts.Append(f.Path)
		parts = parts.Append(f.Content)
	}
	cachekey.Framed(parts)
}

func isGoKeyword(name string) bool {
	let kws = []string{
		"break", "case", "chan", "const", "continue",
		"default", "defer", "else", "fallthrough", "for",
		"func", "go", "goto", "if", "import",
		"interface", "map", "package", "range", "return",
		"select", "struct", "switch", "type", "var",
	}
	for k in kws {
		if name == k {
			return true
		}
	}
	false
}

func isIdentStartByte(b byte) bool {
	(b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'
}

func isIdentBodyByte(b byte) bool {
	isIdentStartByte(b) || (b >= '0' && b <= '9')
}

// ValidateLibPackageName reports whether name is a valid non-main Go identifier for ergo build --lib.
func ValidateLibPackageName(name string) bool {
	if name == "" || name == "main" || name == "_" || isGoKeyword(name) {
		return false
	}
	if !isIdentStartByte(name[0]) {
		return false
	}
	for i in 1..name.Len() {
		if !isIdentBodyByte(name[i]) {
			return false
		}
	}
	true
}

// EmitLibraryModuleLayout produces the canonical Go library module file tree for ergo build --lib.
func EmitLibraryModuleLayout(moduleName string, goVersion string, libName string, libGoText string, assets []EmittedFile) []EmittedFile {
	let modVer = if goVersion == "" { "1.24" } else { goVersion }
	let modText = "module " + moduleName + "\n\ngo " + modVer + "\n"
	let mut out = []EmittedFile{
		EmittedFile{Path: "go.mod", Content: modText},
		EmittedFile{Path: libName + ".go", Content: libGoText},
	}
	for a in assets {
		if a.Path == "go.mod" || a.Path == libName+".go" {
			continue
		}
		out = out.Append(a)
	}
	sortEmittedFiles(out)
}

// ReplayCommandValid: replay commands always begin with `ergo test`, carry the source and flag, and encode non-zero seeds.
law ReplayCommandValid(isLaw bool, seed uint64) {
	let cmd = FormatReplayCommand("pkg/store.ergo", "Store.Preserved", isLaw, seed)
	let hasFlag = if isLaw { strings.Contains(cmd, " --law ") } else { strings.Contains(cmd, " --run ") }
	let hasSeed = if seed > uint64(0) { strings.Contains(cmd, " --seed "+u64Decimal(seed)) } else { !strings.Contains(cmd, "--seed") }
	strings.HasPrefix(cmd, "ergo test ") && strings.Contains(cmd, "pkg/store.ergo") && hasFlag && hasSeed
}

// HarnessGenerationDeterministic: emitting a multi-test module yields identical files and digest across calls.
law HarnessGenerationDeterministic(seed uint64) {
	let src = "test Alpha {\n\tassert true\n}\nlaw Id(x int) { x == x }\n"
	let obs = DiscoverObligations([]SourcePackage{SourcePackage{Label: "app/x", Path: "app/x", Dir: "/x", Files: []SourceFile{SourceFile{Path: "x.ergo", Content: src}}}}) catch {
	case ParseFailure:
		return false
	}
	let sel = SelectObligations(obs, uint32(0), SelectionSpec{Filter: "", Skip: "", Law: "", SkipLaw: "", Run: ""}) catch {
	case PatternError:
		return false
	}
	let opts = HarnessOptions{Seed: seed, States: 32, Locked: false, Debug: false, Release: false, Trace: false, Tapes: false}
	let m1 = EmitSingleTestMainGo("app/x", obs, sel, opts)
	let m2 = EmitSingleTestMainGo("app/x", obs, sel, opts)
	let mod1 = EmitMultiTestModule("ergo.local/testmod", "1.24", []string{m1})
	let mod2 = EmitMultiTestModule("ergo.local/testmod", "1.24", []string{m2})
	m1 == m2 && EmittedDigest(mod1) == EmittedDigest(mod2)
}

// ValidateLibPackageNameRejectsInvalid: empty, `main`, keywords, digits-first, and hyphenated library names are rejected.
law ValidateLibPackageNameRejectsInvalid(idx uint32) {
	let bad = []string{"", "main", "_", "1pkg", "bad-name", "func", "type", "package", "go"}
	let b = bad[int(idx%uint32(bad.Len()))]
	!ValidateLibPackageName(b) && ValidateLibPackageName("valid_pkg_1")
}

test HarnessDispatchLibraryAndReplay {
	assert FormatReplayLine("a.ergo", "MyLaw", true, uint64(7)) == "\treplay: ergo test a.ergo --law MyLaw --seed 7"
	assert FormatReplayCommand("sub dir/a.ergo", "MyTest", false, uint64(0)) == "ergo test \"sub dir/a.ergo\" --run MyTest"
	let lib = EmitLibraryModuleLayout("samplelib", "1.24", "samplelib", "package samplelib\n\nfunc Answer() int { return 42 }\n", []EmittedFile{})
	assert lib.Len() == 2
	assert lib[0].Path == "go.mod"
	assert lib[1].Path == "samplelib.go"
	assert EmittedDigest(lib) != ""
	let receipt = FormatLawReceiptJSON("app/x", "rev1", uint64(9), []LawReceiptEntry{LawReceiptEntry{Title: "Id", Kind: "law", Status: "proved", Cases: 100, Seed: uint64(9)}})
	assert strings.Contains(receipt, "\"schema\": 1")
	assert strings.Contains(receipt, "\"seed\": 9")
	let multi = EmitMultiTestModule("ergo.local/tm", "", []string{"package main\n\nfunc main() {\n}\n"})
	assert multi.Len() == 3
	assert multi[0].Path == "ergotest0/main.go"
	assert strings.Contains(multi[2].Content, TestPackageFlag())
}
