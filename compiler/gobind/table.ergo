// Package gobind implements pure-Ergo Data-Oriented Design Go type/signature
// mapping, cross-platform merging, transitive closure, placeholder import
// rendering, escape/non-nil/totality fact derivation, and staleness checking.

import dense
import option
import slices

// Header is the required first line of every generated binding file.
let Header = "// Code generated by ergo bind go; DO NOT EDIT."

// ModuleLine prefixes the third line of a non-std module binding file.
let ModuleLine = "// ergo:module "

// HostFS is the runtime helper package supplying value-copied host metadata.
let HostFS = "ergo.local/prototype/runtime/v1/hostfs"

// Fact keys recorded inside FactsTable.
let FactNonNilResult = "(result)"
let FactTotal = "(total)"

// Kind constants for BindingDecl matching internal/gobind.Kind iota values.
let BindFunc = uint8(0)
let BindType = uint8(1)
let BindVar = uint8(2)
let BindConst = uint8(3)
let BindMethod = uint8(4)

// Type kind constants inside GoTypeTable.
let TKBasic = uint8(1)
let TKPointer = uint8(2)
let TKSlice = uint8(3)
let TKArray = uint8(4)
let TKMap = uint8(5)
let TKChan = uint8(6)
let TKNamed = uint8(7)
let TKAlias = uint8(8)
let TKStruct = uint8(9)
let TKInterface = uint8(10)
let TKSignature = uint8(11)
let TKTuple = uint8(12)
let TKTypeParam = uint8(13)
let TKUnion = uint8(14)

// Basic type kind constants aligned with go/types.BasicKind.
let BInvalid = uint8(0)
let BBool = uint8(1)
let BInt = uint8(2)
let BInt8 = uint8(3)
let BInt16 = uint8(4)
let BInt32 = uint8(5)
let BInt64 = uint8(6)
let BUint = uint8(7)
let BUint8 = uint8(8)
let BUint16 = uint8(9)
let BUint32 = uint8(10)
let BUint64 = uint8(11)
let BUintptr = uint8(12)
let BFloat32 = uint8(13)
let BFloat64 = uint8(14)
let BComplex64 = uint8(15)
let BComplex128 = uint8(16)
let BString = uint8(17)
let BUnsafePointer = uint8(18)
let BUntypedBool = uint8(19)
let BUntypedInt = uint8(20)
let BUntypedRune = uint8(21)
let BUntypedFloat = uint8(22)
let BUntypedComplex = uint8(23)
let BUntypedString = uint8(24)
let BUntypedNil = uint8(25)
let BByte = uint8(26)
let BRune = uint8(27)

// GoType flags stored in GoTypeTable.Flags.
let TFFlagExported = uint32(1)
let TFFlagAlias = uint32(2)
let TFFlagIfaceMethodSet = uint32(4)
let TFFlagVariadic = uint32(8)
let TFFlagHasTArgs = uint32(16)
let TFFlagIsError = uint32(32)
let TFFlagComparable = uint32(64)
let TFFlagPointerRecv = uint32(128)
let TFFlagBasicUnsigned = uint32(256)
let TFFlagBasicInteger = uint32(512)
let TFFlagBasicNumeric = uint32(1024)
let TFFlagBasicString = uint32(2048)
let TFFlagBasicUntyped = uint32(4096)
let TFFlagIfaceEmpty = uint32(8192)

// GoDecl kind and flag constants inside GoDeclTable.
let GKFunc = uint8(1)
let GKType = uint8(2)
let GKVar = uint8(3)
let GKConst = uint8(4)
let GKMethod = uint8(5)

let DFFlagExported = uint32(1)
let DFFlagAlias = uint32(2)
let DFFlagConstExactInt = uint32(4)
let DFFlagConstFitsFloat = uint32(8)
let DFFlagPromoted = uint32(16)

// Sentinel value denoting no type or no AST index in unsigned uint32 columns.
let NoIndex = uint32(4294967295)

// Binding flag constants inside BindingTable.
let BFFlagVariadic = uint8(1)
let BFFlagContext = uint8(2)
let BFFlagTotal = uint8(4)

// Field and method flags inside GoTypeTable child pools.
let MemberExported = uint8(1)
let MemberEmbedded = uint8(2)
let UnionTilde = uint8(1)

// Str is an interned string handle stored in dense.Strings.
type Str = dense.ID[dense.Str]

// GoTypeTag identifies a type entry inside GoTypeTable.
type GoTypeTag {}

// GoTypeID is a dense handle into GoTypeTable.
type GoTypeID = dense.ID[GoTypeTag]

// GoDeclTag identifies a declaration entry inside GoDeclTable.
type GoDeclTag {}

// GoDeclID is a dense handle into GoDeclTable.
type GoDeclID = dense.ID[GoDeclTag]

// BindingTag identifies a mapped binding row inside BindingTable.
type BindingTag {}

// BindingID is a dense handle into BindingTable.
type BindingID = dense.ID[BindingTag]

// Platform pairs GOOS and GOARCH for cross-platform binding convergence.
type Platform {
	GOOS   string,
	GOARCH string,
}

// PlatformText formats p as "GOOS/GOARCH".
func PlatformText(p Platform) string { p.GOOS + "/" + p.GOARCH }

// StandardPlatforms returns the default four binding target platforms.
func StandardPlatforms() []Platform {
	[]Platform{
		Platform{GOOS: "darwin", GOARCH: "amd64"},
		Platform{GOOS: "darwin", GOARCH: "arm64"},
		Platform{GOOS: "linux", GOARCH: "amd64"},
		Platform{GOOS: "linux", GOARCH: "arm64"},
	}
}

// PhonePlatforms returns the iOS/Android target descriptors backed by StandardPlatforms bindings.
func PhonePlatforms() []Platform {
	[]Platform{
		Platform{GOOS: "ios", GOARCH: "arm64"},
		Platform{GOOS: "android", GOARCH: "arm64"},
	}
}

// Vouch is a vouched reads parameter paired with its justification.
type Vouch {
	Param  string,
	Reason string,
}

// Line is a single mapped field or operation line of a struct or interface type.
type Line {
	Name string,
	Go   string,
	Text string,
	Refs []string,
}

// Member is a single refused field or method attached to a struct or interface Decl.
type Member {
	Name    string,
	Go      string,
	Refused string,
}

// Readable names a Go parameter/receiver paired with its Ergo binder.
type Readable {
	GoName   string,
	ErgoName string,
}

// Decl is the value view of one mapped Go declaration or refusal.
type Decl {
	Kind       uint8,
	Name       string,
	Go         string,
	Ergo       string,
	Via        string,
	Variadic   bool,
	Context    bool,
	Writes     string,
	Reads      []string,
	Vouched    []Vouch,
	Effect     string,
	EffectFrom string,
	Host       string,
	Total      bool,
	Refused    string,
	Members    []Member,
	Refs       []string,
	Lines      []Line,
	RefPkgs    []string,
	Readables  []Readable,
}

// DeclTarget computes the extern go target string for d under pkgPath.
func DeclTarget(d Decl, pkgPath string) string {
	if d.Via != "" {
		return d.Via
	}
	pkgPath + "." + d.Name
}

// GoFieldRec stores one struct field inside GoTypeTable.
type GoFieldRec {
	Name  Str,
	Type  uint32,
	Flags uint8,
}

// GoParamRec stores one signature parameter or result inside GoTypeTable.
type GoParamRec {
	Name Str,
	Type uint32,
}

// GoMethodRec stores one method entry on a named type or interface.
type GoMethodRec {
	Name     Str,
	PkgPath  Str,
	PkgName  Str,
	SigType  uint32,
	GoText   Str,
	OrigPkg  Str,
	OrigRecv Str,
	Flags    uint8,
	InValSet bool,
}

// GoUnionTermRec stores one term of a type-set union.
type GoUnionTermRec {
	Tilde bool,
	Type  uint32,
}

// GoTypeTable holds Go type descriptors as flat unsigned uint32 SoA columns.
type GoTypeTable {
	Strings     dense.Strings,
	Count       dense.Count[GoTypeTag],
	Kind        dense.Col[GoTypeTag, uint8],
	BasicKind   dense.Col[GoTypeTag, uint8],
	BasicName   dense.Col[GoTypeTag, Str],
	Name        dense.Col[GoTypeTag, Str],
	PkgPath     dense.Col[GoTypeTag, Str],
	PkgName     dense.Col[GoTypeTag, Str],
	TypeText    dense.Col[GoTypeTag, Str],
	ShortText   dense.Col[GoTypeTag, Str],
	Elem        dense.Col[GoTypeTag, uint32],
	Key         dense.Col[GoTypeTag, uint32],
	ArrLen      dense.Col[GoTypeTag, uint32],
	Underlying  dense.Col[GoTypeTag, uint32],
	RecvType    dense.Col[GoTypeTag, uint32],
	RecvName    dense.Col[GoTypeTag, Str],
	Flags       dense.Col[GoTypeTag, uint32],
	FieldsPool  dense.Pool[GoFieldRec],
	Fields      dense.Col[GoTypeTag, dense.Run[GoFieldRec]],
	ParamsPool  dense.Pool[GoParamRec],
	Params      dense.Col[GoTypeTag, dense.Run[GoParamRec]],
	Results     dense.Col[GoTypeTag, dense.Run[GoParamRec]],
	MethodsPool dense.Pool[GoMethodRec],
	Methods     dense.Col[GoTypeTag, dense.Run[GoMethodRec]],
	ValMethods  dense.Col[GoTypeTag, dense.Run[GoMethodRec]],
	U32Pool     dense.Pool[uint32],
	TypeParams  dense.Col[GoTypeTag, dense.Run[uint32]],
	TypeArgs    dense.Col[GoTypeTag, dense.Run[uint32]],
	TermsPool   dense.Pool[GoUnionTermRec],
	Terms       dense.Col[GoTypeTag, dense.Run[GoUnionTermRec]],
}

// NewGoTypeTable allocates an empty GoTypeTable.
func NewGoTypeTable() GoTypeTable {
	GoTypeTable{
		Strings:     dense.NewStrings(),
		Count:       dense.NewCount[GoTypeTag](),
		Kind:        dense.NewCol[GoTypeTag, uint8](),
		BasicKind:   dense.NewCol[GoTypeTag, uint8](),
		BasicName:   dense.NewCol[GoTypeTag, Str](),
		Name:        dense.NewCol[GoTypeTag, Str](),
		PkgPath:     dense.NewCol[GoTypeTag, Str](),
		PkgName:     dense.NewCol[GoTypeTag, Str](),
		TypeText:    dense.NewCol[GoTypeTag, Str](),
		ShortText:   dense.NewCol[GoTypeTag, Str](),
		Elem:        dense.NewCol[GoTypeTag, uint32](),
		Key:         dense.NewCol[GoTypeTag, uint32](),
		ArrLen:      dense.NewCol[GoTypeTag, uint32](),
		Underlying:  dense.NewCol[GoTypeTag, uint32](),
		RecvType:    dense.NewCol[GoTypeTag, uint32](),
		RecvName:    dense.NewCol[GoTypeTag, Str](),
		Flags:       dense.NewCol[GoTypeTag, uint32](),
		FieldsPool:  dense.NewPool[GoFieldRec](),
		Fields:      dense.NewCol[GoTypeTag, dense.Run[GoFieldRec]](),
		ParamsPool:  dense.NewPool[GoParamRec](),
		Params:      dense.NewCol[GoTypeTag, dense.Run[GoParamRec]](),
		Results:     dense.NewCol[GoTypeTag, dense.Run[GoParamRec]](),
		MethodsPool: dense.NewPool[GoMethodRec](),
		Methods:     dense.NewCol[GoTypeTag, dense.Run[GoMethodRec]](),
		ValMethods:  dense.NewCol[GoTypeTag, dense.Run[GoMethodRec]](),
		U32Pool:     dense.NewPool[uint32](),
		TypeParams:  dense.NewCol[GoTypeTag, dense.Run[uint32]](),
		TypeArgs:    dense.NewCol[GoTypeTag, dense.Run[uint32]](),
		TermsPool:   dense.NewPool[GoUnionTermRec](),
		Terms:       dense.NewCol[GoTypeTag, dense.Run[GoUnionTermRec]](),
	}
}

// TypeSpec provides input fields when appending a GoTypeTable entry.
type TypeSpec {
	Kind       uint8,
	BasicKind  uint8,
	BasicName  string,
	Name       string,
	PkgPath    string,
	PkgName    string,
	TypeText   string,
	ShortText  string,
	Elem       uint32,
	Key        uint32,
	ArrLen     uint32,
	Underlying uint32,
	RecvType   uint32,
	RecvName   string,
	Flags      uint32,
}

func emptyFieldRun(gt mut GoTypeTable) dense.Run[GoFieldRec] {
	dense.PutList(&gt.FieldsPool, []GoFieldRec{})
}

func emptyParamRun(gt mut GoTypeTable) dense.Run[GoParamRec] {
	dense.PutList(&gt.ParamsPool, []GoParamRec{})
}

func emptyMethodRun(gt mut GoTypeTable) dense.Run[GoMethodRec] {
	dense.PutList(&gt.MethodsPool, []GoMethodRec{})
}

func emptyU32Run(gt mut GoTypeTable) dense.Run[uint32] {
	dense.PutList(&gt.U32Pool, []uint32{})
}

func emptyTermRun(gt mut GoTypeTable) dense.Run[GoUnionTermRec] {
	dense.PutList(&gt.TermsPool, []GoUnionTermRec{})
}

// AddType appends a GoTypeTable slot and returns its uint32 index.
func AddType(gt mut GoTypeTable, spec TypeSpec) uint32 {
	let id = dense.Next(&gt.Count)
	dense.Push(&gt.Kind, spec.Kind)
	dense.Push(&gt.BasicKind, spec.BasicKind)
	dense.Push(&gt.BasicName, dense.InternText(&gt.Strings, spec.BasicName))
	dense.Push(&gt.Name, dense.InternText(&gt.Strings, spec.Name))
	dense.Push(&gt.PkgPath, dense.InternText(&gt.Strings, spec.PkgPath))
	dense.Push(&gt.PkgName, dense.InternText(&gt.Strings, spec.PkgName))
	dense.Push(&gt.TypeText, dense.InternText(&gt.Strings, spec.TypeText))
	dense.Push(&gt.ShortText, dense.InternText(&gt.Strings, spec.ShortText))
	dense.Push(&gt.Elem, spec.Elem)
	dense.Push(&gt.Key, spec.Key)
	dense.Push(&gt.ArrLen, spec.ArrLen)
	dense.Push(&gt.Underlying, spec.Underlying)
	dense.Push(&gt.RecvType, spec.RecvType)
	dense.Push(&gt.RecvName, dense.InternText(&gt.Strings, spec.RecvName))
	dense.Push(&gt.Flags, spec.Flags)
	let fRun = emptyFieldRun(gt)
	dense.Push(&gt.Fields, fRun)
	let pRun1 = emptyParamRun(gt)
	dense.Push(&gt.Params, pRun1)
	let pRun2 = emptyParamRun(gt)
	dense.Push(&gt.Results, pRun2)
	let mRun1 = emptyMethodRun(gt)
	dense.Push(&gt.Methods, mRun1)
	let mRun2 = emptyMethodRun(gt)
	dense.Push(&gt.ValMethods, mRun2)
	let uRun1 = emptyU32Run(gt)
	dense.Push(&gt.TypeParams, uRun1)
	let uRun2 = emptyU32Run(gt)
	dense.Push(&gt.TypeArgs, uRun2)
	let tRun = emptyTermRun(gt)
	dense.Push(&gt.Terms, tRun)
	uint32(dense.Index(id))
}

// TypeIDAt returns the dense GoTypeID for raw index idx.
func TypeIDAt(gt GoTypeTable, idx uint32) GoTypeID { dense.IDAt(gt.Count, int(idx)) }

// SetTypeFields sets struct fields for type slot idx.
func SetTypeFields(gt mut GoTypeTable, idx uint32, xs []GoFieldRec) {
	let r = dense.PutList(&gt.FieldsPool, xs)
	dense.SetOf(&gt.Fields, TypeIDAt(*gt, idx), r)
}

// SetTypeParams sets signature parameters for type slot idx.
func SetTypeParams(gt mut GoTypeTable, idx uint32, xs []GoParamRec) {
	let r = dense.PutList(&gt.ParamsPool, xs)
	dense.SetOf(&gt.Params, TypeIDAt(*gt, idx), r)
}

// SetTypeResults sets signature or tuple results for type slot idx.
func SetTypeResults(gt mut GoTypeTable, idx uint32, xs []GoParamRec) {
	let r = dense.PutList(&gt.ParamsPool, xs)
	dense.SetOf(&gt.Results, TypeIDAt(*gt, idx), r)
}

// SetTypeMethods sets pointer/interface methods for type slot idx.
func SetTypeMethods(gt mut GoTypeTable, idx uint32, xs []GoMethodRec) {
	let r = dense.PutList(&gt.MethodsPool, xs)
	dense.SetOf(&gt.Methods, TypeIDAt(*gt, idx), r)
}

// SetTypeValMethods sets value method set entries for named type slot idx.
func SetTypeValMethods(gt mut GoTypeTable, idx uint32, xs []GoMethodRec) {
	let r = dense.PutList(&gt.MethodsPool, xs)
	dense.SetOf(&gt.ValMethods, TypeIDAt(*gt, idx), r)
}

// SetTypeTypeParams sets type-parameter type IDs for named or signature slot idx.
func SetTypeTypeParams(gt mut GoTypeTable, idx uint32, xs []uint32) {
	let r = dense.PutList(&gt.U32Pool, xs)
	dense.SetOf(&gt.TypeParams, TypeIDAt(*gt, idx), r)
}

// SetTypeTypeArgs sets instantiated type-argument IDs for named type slot idx.
func SetTypeTypeArgs(gt mut GoTypeTable, idx uint32, xs []uint32) {
	let r = dense.PutList(&gt.U32Pool, xs)
	dense.SetOf(&gt.TypeArgs, TypeIDAt(*gt, idx), r)
}

// SetTypeTerms sets union terms for union type slot idx.
func SetTypeTerms(gt mut GoTypeTable, idx uint32, xs []GoUnionTermRec) {
	let r = dense.PutList(&gt.TermsPool, xs)
	dense.SetOf(&gt.Terms, TypeIDAt(*gt, idx), r)
}

// InternTypeStr interns text in gt.Strings and returns its Str handle.
func InternTypeStr(gt mut GoTypeTable, text string) Str {
	dense.InternText(&gt.Strings, text)
}

// GetTypeStr resolves s inside gt.Strings.
func GetTypeStr(gt GoTypeTable, s Str) string {
	dense.Text(gt.Strings, s)
}

// TypeStr resolves an interned Str inside gt.
func TypeStr(gt GoTypeTable, s Str) string { dense.Text(gt.Strings, s) }

// GoDeclTable holds package metadata and exported Go declarations in SoA columns.
type GoDeclTable {
	Strings    dense.Strings,
	Count      dense.Count[GoDeclTag],
	Kind       dense.Col[GoDeclTag, uint8],
	Name       dense.Col[GoDeclTag, Str],
	PkgPath    dense.Col[GoDeclTag, Str],
	PkgName    dense.Col[GoDeclTag, Str],
	DeclTarget dense.Col[GoDeclTag, Str],
	TypeID     dense.Col[GoDeclTag, uint32],
	GoText     dense.Col[GoDeclTag, Str],
	Flags      dense.Col[GoDeclTag, uint32],
	PkgHead    []uint32,
	PkgTail    []uint32,
	PkgNext    []uint32,
}

// NewGoDeclTable allocates an empty GoDeclTable.
func NewGoDeclTable() GoDeclTable {
	GoDeclTable{
		Strings:    dense.NewStrings(),
		Count:      dense.NewCount[GoDeclTag](),
		Kind:       dense.NewCol[GoDeclTag, uint8](),
		Name:       dense.NewCol[GoDeclTag, Str](),
		PkgPath:    dense.NewCol[GoDeclTag, Str](),
		PkgName:    dense.NewCol[GoDeclTag, Str](),
		DeclTarget: dense.NewCol[GoDeclTag, Str](),
		TypeID:     dense.NewCol[GoDeclTag, uint32](),
		GoText:     dense.NewCol[GoDeclTag, Str](),
		Flags:      dense.NewCol[GoDeclTag, uint32](),
		PkgHead:    []uint32{},
		PkgTail:    []uint32{},
		PkgNext:    []uint32{},
	}
}

func ensureU32Cap(xs mut []uint32, need int) {
	for (*xs).Len() <= need {
		*xs = (*xs).Append(uint32(0))
	}
}

// AddGoDecl appends an exported Go declaration record to gd and indexes it by pkgPath.
func AddGoDecl(gd mut GoDeclTable, kind uint8, pkgPath string, pkgName string, name string, typeID uint32, goText string, declTarget string, flags uint32) uint32 {
	let id = dense.Next(&gd.Count)
	let pid = dense.InternText(&gd.Strings, pkgPath)
	dense.Push(&gd.Kind, kind)
	dense.Push(&gd.Name, dense.InternText(&gd.Strings, name))
	dense.Push(&gd.PkgPath, pid)
	dense.Push(&gd.PkgName, dense.InternText(&gd.Strings, pkgName))
	dense.Push(&gd.DeclTarget, dense.InternText(&gd.Strings, declTarget))
	dense.Push(&gd.TypeID, typeID)
	dense.Push(&gd.GoText, dense.InternText(&gd.Strings, goText))
	dense.Push(&gd.Flags, flags)
	gd.PkgNext = gd.PkgNext.Append(uint32(0))
	let pi = dense.Index(pid)
	ensureU32Cap(&gd.PkgHead, pi)
	ensureU32Cap(&gd.PkgTail, pi)
	let slot = uint32(dense.Index(id)) + uint32(1)
	if gd.PkgHead[pi] == uint32(0) {
		gd.PkgHead[pi] = slot
		gd.PkgTail[pi] = slot
	} else {
		let prev = int(gd.PkgTail[pi] - uint32(1))
		gd.PkgNext[prev] = slot
		gd.PkgTail[pi] = slot
	}
	uint32(dense.Index(id))
}

// PkgDeclIDs returns all declaration indices registered under pkgPath in insertion order.
func PkgDeclIDs(gd GoDeclTable, pkgPath string) []uint32 {
	match dense.FindText(gd.Strings, pkgPath) {
	case option.None:
		[]uint32{}
	case option.Some{Value: pid}:
		let pi = dense.Index(pid)
		if pi >= gd.PkgHead.Len() {
			return []uint32{}
		}
		let mut out = []uint32{}
		let mut cur = gd.PkgHead[pi]
		for cur > uint32(0) {
			let idx = cur - uint32(1)
			out = out.Append(idx)
			cur = gd.PkgNext[int(idx)]
		}
		out
	}
}

// LookupGoDecl looks up the declaration index of name inside pkgPath.
func LookupGoDecl(gd GoDeclTable, pkgPath string, name string) option.Option[uint32] {
	for idx in PkgDeclIDs(gd, pkgPath) {
		let id = dense.IDAt(gd.Count, int(idx))
		if dense.Text(gd.Strings, dense.Of(gd.Name, id)) == name {
			return option.Some{Value: idx}
		}
	}
	option.None
}

// FactsTable stores derived foreign facts keyed by (target, factName) in flat
// unsigned uint32 linked chains without pointer-keyed maps.
type FactsTable {
	Strings    dense.Strings,
	Count      dense.Count[BindingTag],
	Target     dense.Col[BindingTag, Str],
	Key        dense.Col[BindingTag, Str],
	TargetHead []uint32,
	TargetNext []uint32,
}

// NewFactsTable creates an empty FactsTable.
func NewFactsTable() FactsTable {
	FactsTable{
		Strings:    dense.NewStrings(),
		Count:      dense.NewCount[BindingTag](),
		Target:     dense.NewCol[BindingTag, Str](),
		Key:        dense.NewCol[BindingTag, Str](),
		TargetHead: []uint32{},
		TargetNext: []uint32{},
	}
}

// AddFact records that target holds fact key (a parameter name, "(result)", or "(total)").
func AddFact(ft mut FactsTable, target string, key string) {
	if HasFact(*ft, target, key) {
		return
	}
	let id = dense.Next(&ft.Count)
	let tid = dense.InternText(&ft.Strings, target)
	let kid = dense.InternText(&ft.Strings, key)
	dense.Push(&ft.Target, tid)
	dense.Push(&ft.Key, kid)
	let ti = dense.Index(tid)
	ensureU32Cap(&ft.TargetHead, ti)
	ft.TargetNext = ft.TargetNext.Append(ft.TargetHead[ti])
	ft.TargetHead[ti] = uint32(dense.Index(id)) + uint32(1)
}

// HasFact reports whether ft contains (target, key).
func HasFact(ft FactsTable, target string, key string) bool {
	let tidOpt = dense.FindText(ft.Strings, target)
	let kidOpt = dense.FindText(ft.Strings, key)
	let tid = match tidOpt {
	case option.Some{Value: v}:
		v
	case option.None:
		return false
	}
	let kid = match kidOpt {
	case option.Some{Value: v}:
		v
	case option.None:
		return false
	}
	let ti = dense.Index(tid)
	if ti >= ft.TargetHead.Len() {
		return false
	}
	let mut cur = ft.TargetHead[ti]
	for cur > uint32(0) {
		let idx = int(cur - uint32(1))
		let id = dense.IDAt(ft.Count, idx)
		if dense.Index(dense.Of(ft.Key, id)) == dense.Index(kid) {
			return true
		}
		cur = ft.TargetNext[idx]
	}
	false
}

// AllFacts returns sorted unique "(target, key)" strings from ft.
func AllFacts(ft FactsTable) []string {
	let n = dense.Total(ft.Count)
	let mut out = slices.WithCapacity[string](n)
	for i in 0..n {
		let id = dense.IDAt(ft.Count, i)
		let t = dense.Text(ft.Strings, dense.Of(ft.Target, id))
		let k = dense.Text(ft.Strings, dense.Of(ft.Key, id))
		out = out.Append(t + "\t" + k)
	}
	slices.Sort(out)
}

// MeetFacts intersects derived facts across all platforms.
func MeetFacts(all []FactsTable) FactsTable {
	if all.Len() == 0 {
		return NewFactsTable()
	}
	let mut out = NewFactsTable()
	let first = all[0]
	let n = dense.Total(first.Count)
	for i in 0..n {
		let id = dense.IDAt(first.Count, i)
		let target = dense.Text(first.Strings, dense.Of(first.Target, id))
		let key = dense.Text(first.Strings, dense.Of(first.Key, id))
		let mut holds = true
		for j in 1..all.Len() {
			if !HasFact(all[j], target, key) {
				holds = false
				break
			}
		}
		if holds {
			AddFact(&out, target, key)
		}
	}
	out
}

// BindingTable stores mapped Decl rows in flat SoA columns with pooled slices.
type BindingTable {
	Strings    dense.Strings,
	Count      dense.Count[BindingTag],
	Kind       dense.Col[BindingTag, uint8],
	Name       dense.Col[BindingTag, Str],
	Go         dense.Col[BindingTag, Str],
	Ergo       dense.Col[BindingTag, Str],
	Via        dense.Col[BindingTag, Str],
	Writes     dense.Col[BindingTag, Str],
	Effect     dense.Col[BindingTag, Str],
	EffectFrom dense.Col[BindingTag, Str],
	Host       dense.Col[BindingTag, Str],
	Refused    dense.Col[BindingTag, Str],
	Flags      dense.Col[BindingTag, uint8],
	StrPool    dense.Pool[Str],
	Reads      dense.Col[BindingTag, dense.Run[Str]],
	Refs       dense.Col[BindingTag, dense.Run[Str]],
	RefPkgs    dense.Col[BindingTag, dense.Run[Str]],
}

// NewBindingTable creates an empty BindingTable.
func NewBindingTable() BindingTable {
	BindingTable{
		Strings:    dense.NewStrings(),
		Count:      dense.NewCount[BindingTag](),
		Kind:       dense.NewCol[BindingTag, uint8](),
		Name:       dense.NewCol[BindingTag, Str](),
		Go:         dense.NewCol[BindingTag, Str](),
		Ergo:       dense.NewCol[BindingTag, Str](),
		Via:        dense.NewCol[BindingTag, Str](),
		Writes:     dense.NewCol[BindingTag, Str](),
		Effect:     dense.NewCol[BindingTag, Str](),
		EffectFrom: dense.NewCol[BindingTag, Str](),
		Host:       dense.NewCol[BindingTag, Str](),
		Refused:    dense.NewCol[BindingTag, Str](),
		Flags:      dense.NewCol[BindingTag, uint8](),
		StrPool:    dense.NewPool[Str](),
		Reads:      dense.NewCol[BindingTag, dense.Run[Str]](),
		Refs:       dense.NewCol[BindingTag, dense.Run[Str]](),
		RefPkgs:    dense.NewCol[BindingTag, dense.Run[Str]](),
	}
}

func internStrRun(tbl mut BindingTable, xs []string) dense.Run[Str] {
	let mut ids = slices.WithCapacity[Str](xs.Len())
	for x in xs {
		ids = ids.Append(dense.InternText(&tbl.Strings, x))
	}
	dense.PutList(&tbl.StrPool, ids)
}

// AddDecl appends d into bt's flat SoA columns and returns its BindingID.
func AddDecl(bt mut BindingTable, d Decl) BindingID {
	let id = dense.Next(&bt.Count)
	dense.Push(&bt.Kind, d.Kind)
	dense.Push(&bt.Name, dense.InternText(&bt.Strings, d.Name))
	dense.Push(&bt.Go, dense.InternText(&bt.Strings, d.Go))
	dense.Push(&bt.Ergo, dense.InternText(&bt.Strings, d.Ergo))
	dense.Push(&bt.Via, dense.InternText(&bt.Strings, d.Via))
	dense.Push(&bt.Writes, dense.InternText(&bt.Strings, d.Writes))
	dense.Push(&bt.Effect, dense.InternText(&bt.Strings, d.Effect))
	dense.Push(&bt.EffectFrom, dense.InternText(&bt.Strings, d.EffectFrom))
	dense.Push(&bt.Host, dense.InternText(&bt.Strings, d.Host))
	dense.Push(&bt.Refused, dense.InternText(&bt.Strings, d.Refused))
	let mut fl = uint8(0)
	if d.Variadic {
		fl = fl | BFFlagVariadic
	}
	if d.Context {
		fl = fl | BFFlagContext
	}
	if d.Total {
		fl = fl | BFFlagTotal
	}
	dense.Push(&bt.Flags, fl)
	let rRun = internStrRun(bt, d.Reads)
	dense.Push(&bt.Reads, rRun)
	let refRun = internStrRun(bt, d.Refs)
	dense.Push(&bt.Refs, refRun)
	let rpRun = internStrRun(bt, d.RefPkgs)
	dense.Push(&bt.RefPkgs, rpRun)
	id
}

// NumBindings returns the row count of bt.
func NumBindings(bt BindingTable) int { dense.Total(bt.Count) }

func unpackStrRun(s dense.Strings, p dense.Pool[Str], r dense.Run[Str]) []string {
	let items = dense.List(p, r)
	let mut out = slices.WithCapacity[string](items.Len())
	for it in items {
		out = out.Append(dense.Text(s, it))
	}
	out
}

// GetDecl reads row id from bt into a Decl value view.
func GetDecl(bt BindingTable, id BindingID) Decl {
	let fl = dense.Of(bt.Flags, id)
	Decl{
		Kind:       dense.Of(bt.Kind, id),
		Name:       dense.Text(bt.Strings, dense.Of(bt.Name, id)),
		Go:         dense.Text(bt.Strings, dense.Of(bt.Go, id)),
		Ergo:       dense.Text(bt.Strings, dense.Of(bt.Ergo, id)),
		Via:        dense.Text(bt.Strings, dense.Of(bt.Via, id)),
		Variadic:   (fl & BFFlagVariadic) != uint8(0),
		Context:    (fl & BFFlagContext) != uint8(0),
		Writes:     dense.Text(bt.Strings, dense.Of(bt.Writes, id)),
		Reads:      unpackStrRun(bt.Strings, bt.StrPool, dense.Of(bt.Reads, id)),
		Vouched:    []Vouch{},
		Effect:     dense.Text(bt.Strings, dense.Of(bt.Effect, id)),
		EffectFrom: dense.Text(bt.Strings, dense.Of(bt.EffectFrom, id)),
		Host:       dense.Text(bt.Strings, dense.Of(bt.Host, id)),
		Total:      (fl & BFFlagTotal) != uint8(0),
		Refused:    dense.Text(bt.Strings, dense.Of(bt.Refused, id)),
		Members:    []Member{},
		Refs:       unpackStrRun(bt.Strings, bt.StrPool, dense.Of(bt.Refs, id)),
		Lines:      []Line{},
		RefPkgs:    unpackStrRun(bt.Strings, bt.StrPool, dense.Of(bt.RefPkgs, id)),
		Readables:  []Readable{},
	}
}

// Scratch holds reusable temporary buffers shared across gobind passes.
type Scratch {
	U32  dense.Stack[uint32],
	Strs dense.Stack[Str],
	Text []string,
}

// NewScratch allocates an empty Scratch with pre-sized backing buffers.
func NewScratch() Scratch {
	Scratch{
		U32:  dense.StackWithCap[uint32](32),
		Strs: dense.StackWithCap[Str](32),
		Text: slices.WithCapacity[string](16),
	}
}

// FactsMeetIntersection: MeetFacts keeps only facts present in every input table.
law FactsMeetIntersection(t1 string, k1 string, k2 string) {
	if k1 == k2 {
		return true
	}
	let mut a = NewFactsTable()
	AddFact(&a, t1, k1)
	AddFact(&a, t1, k2)
	let mut b = NewFactsTable()
	AddFact(&b, t1, k1)
	let m = MeetFacts([]FactsTable{a, b})
	HasFact(m, t1, k1) && !HasFact(m, t1, k2)
}

// TypeAndDeclTableRoundTrip verifies AddType, AddGoDecl, and AddDecl SoA round-trips.
test TypeAndDeclTableRoundTrip {
	let mut gt = NewGoTypeTable()
	let tid = AddType(&gt, TypeSpec{
		Kind:       TKBasic,
		BasicKind:  BInt,
		BasicName:  "int",
		Name:       "int",
		PkgPath:    "",
		PkgName:    "",
		TypeText:   "int",
		ShortText:  "int",
		Elem:       NoIndex,
		Key:        NoIndex,
		ArrLen:     uint32(0),
		Underlying: NoIndex,
		RecvType:   NoIndex,
		RecvName:   "",
		Flags:      TFFlagBasicInteger | TFFlagBasicNumeric,
	})
	let mut gd = NewGoDeclTable()
	let did = AddGoDecl(&gd, GKFunc, "example.com/p", "p", "F", tid, "func F() int", "example.com/p.F", DFFlagExported)
	assert PkgDeclIDs(gd, "example.com/p").Len() == 1
	match LookupGoDecl(gd, "example.com/p", "F") {
	case option.Some{Value: got}:
		assert got == did
	case option.None:
		assert false
	}
	let mut bt = NewBindingTable()
	let bid = AddDecl(&bt, Decl{
		Kind:       BindFunc,
		Name:       "F",
		Go:         "func F() int",
		Ergo:       "func F() int",
		Via:        "",
		Variadic:   false,
		Context:    false,
		Writes:     "",
		Reads:      []string{"x"},
		Vouched:    []Vouch{},
		Effect:     "",
		EffectFrom: "",
		Host:       "",
		Total:      true,
		Refused:    "",
		Members:    []Member{},
		Refs:       []string{},
		Lines:      []Line{},
		RefPkgs:    []string{},
		Readables:  []Readable{},
	})
	let view = GetDecl(bt, bid)
	assert view.Name == "F" && view.Total && view.Reads.Len() == 1 && view.Reads[0] == "x"
}
