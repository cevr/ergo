let NSCaseClause = uint8(38)
let NSCommClause = uint8(39)
let NSOtherStmt = uint8(40)

let NDTypeSpec = uint8(50)
let NDValueSpec = uint8(51)
let NDFuncDecl = uint8(52)
let NDFile = uint8(53)

