// Type-checked object classification constants inside GoAstTable.ObjKind.
let ObjNone = uint8(0)
let ObjVar = uint8(1)
let ObjConst = uint8(2)
let ObjFunc = uint8(3)
let ObjBuiltin = uint8(4)
let ObjTypeName = uint8(5)

// Bit flags stored in GoAstTable.Flags.
let AFFlagTvConst = uint32(1)
let AFFlagTvConstNonZero = uint32(2)
let AFFlagTvIsType = uint32(4)
let AFFlagObjPkgScope = uint32(8)
let AFFlagObjIsField = uint32(16)
let AFFlagEllipsis = uint32(32)
let AFFlagIsIntZero = uint32(64)
let AFFlagConcreteType = uint32(128)
let AFFlagTypeAlias = uint32(256)
let AFFlagHasTypeParams = uint32(512)
let AFFlagPtrRecv = uint32(1024)
let AFFlagIsDefault = uint32(2048)
let AFFlagHasNilType = uint32(4096)
let AFFlagBasicLitInt = uint32(8192)
let AFFlagHasRecv = uint32(16384)
let AFFlagTypeAssertNonNil = uint32(32768)
let AFFlagPredeclaredString = uint32(65536)

// AstTag identifies a node row in GoAstTable.
type AstTag {}

// AstID is a dense handle into GoAstTable.
type AstID = dense.ID[AstTag]

// ImportRec maps one file-local import alias to its canonical Go import path.
type ImportRec {
	Alias Str,
	Path  Str,
}

// GoAstTable holds Go AST nodes for one or more packages in flat unsigned uint32 columns.
type GoAstTable {
	Strings    dense.Strings,
	Count      dense.Count[AstTag],
	Kind       dense.Col[AstTag, uint8],
	Op         dense.Col[AstTag, uint8],
	ObjKind    dense.Col[AstTag, uint8],
	Flags      dense.Col[AstTag, uint32],
	Name       dense.Col[AstTag, Str],
	Target     dense.Col[AstTag, Str],
	TypeID     dense.Col[AstTag, uint32],
	RecvTypeID dense.Col[AstTag, uint32],
	FuncSym    dense.Col[AstTag, uint32],
	X          dense.Col[AstTag, uint32],
	Y          dense.Col[AstTag, uint32],
	Z          dense.Col[AstTag, uint32],
	W          dense.Col[AstTag, uint32],
	U32Pool    dense.Pool[uint32],
	Children   dense.Col[AstTag, dense.Run[uint32]],
	Lhs        dense.Col[AstTag, dense.Run[uint32]],
	Rhs        dense.Col[AstTag, dense.Run[uint32]],
	ImpPool    dense.Pool[ImportRec],
	Imports    dense.Col[AstTag, dense.Run[ImportRec]],
}

// NewGoAstTable allocates an empty GoAstTable.
func NewGoAstTable() GoAstTable {
	GoAstTable{
		Strings:    dense.NewStrings(),
		Count:      dense.NewCount[AstTag](),
		Kind:       dense.NewCol[AstTag, uint8](),
		Op:         dense.NewCol[AstTag, uint8](),
		ObjKind:    dense.NewCol[AstTag, uint8](),
		Flags:      dense.NewCol[AstTag, uint32](),
		Name:       dense.NewCol[AstTag, Str](),
		Target:     dense.NewCol[AstTag, Str](),
		TypeID:     dense.NewCol[AstTag, uint32](),
		RecvTypeID: dense.NewCol[AstTag, uint32](),
		FuncSym:    dense.NewCol[AstTag, uint32](),
		X:          dense.NewCol[AstTag, uint32](),
		Y:          dense.NewCol[AstTag, uint32](),
		Z:          dense.NewCol[AstTag, uint32](),
		W:          dense.NewCol[AstTag, uint32](),
		U32Pool:    dense.NewPool[uint32](),
		Children:   dense.NewCol[AstTag, dense.Run[uint32]](),
		Lhs:        dense.NewCol[AstTag, dense.Run[uint32]](),
		Rhs:        dense.NewCol[AstTag, dense.Run[uint32]](),
		ImpPool:    dense.NewPool[ImportRec](),
		Imports:    dense.NewCol[AstTag, dense.Run[ImportRec]](),
	}
}

// AstSpec specifies fixed fields when appending a GoAstTable node.
type AstSpec {
	Kind       uint8,
	Op         uint8,
	ObjKind    uint8,
	Flags      uint32,
	Name       string,
	Target     string,
	TypeID     uint32,
	RecvTypeID uint32,
	FuncSym    uint32,
	X          uint32,
	Y          uint32,
	Z          uint32,
	W          uint32,
}

// EmptyAstSpec returns a zeroed AstSpec of kind.
func EmptyAstSpec(kind uint8) AstSpec {
	AstSpec{
		Kind:       kind,
		Op:         OpNone,
		ObjKind:    ObjNone,
		Flags:      uint32(0),
		Name:       "",
		Target:     "",
		TypeID:     NoIndex,
		RecvTypeID: NoIndex,
		FuncSym:    NoIndex,
		X:          NoIndex,
		Y:          NoIndex,
		Z:          NoIndex,
		W:          NoIndex,
	}
}

// AddAst appends a node row to ga and returns its uint32 index.
func AddAst(ga mut GoAstTable, spec AstSpec) uint32 {
	let id = dense.Next(&ga.Count)
	dense.Push(&ga.Kind, spec.Kind)
	dense.Push(&ga.Op, spec.Op)
	dense.Push(&ga.ObjKind, spec.ObjKind)
	dense.Push(&ga.Flags, spec.Flags)
	dense.Push(&ga.Name, dense.InternText(&ga.Strings, spec.Name))
	dense.Push(&ga.Target, dense.InternText(&ga.Strings, spec.Target))
	dense.Push(&ga.TypeID, spec.TypeID)
	dense.Push(&ga.RecvTypeID, spec.RecvTypeID)
	dense.Push(&ga.FuncSym, spec.FuncSym)
	dense.Push(&ga.X, spec.X)
	dense.Push(&ga.Y, spec.Y)
	dense.Push(&ga.Z, spec.Z)
	dense.Push(&ga.W, spec.W)
	let r0 = dense.PutList(&ga.U32Pool, []uint32{})
	let r1 = dense.PutList(&ga.U32Pool, []uint32{})
	let r2 = dense.PutList(&ga.U32Pool, []uint32{})
	let ri = dense.PutList(&ga.ImpPool, []ImportRec{})
	dense.Push(&ga.Children, r0)
	dense.Push(&ga.Lhs, r1)
	dense.Push(&ga.Rhs, r2)
	dense.Push(&ga.Imports, ri)
	uint32(dense.Index(id))
}

// AstIDAt returns the dense AstID for raw index idx.
func AstIDAt(ga GoAstTable, idx uint32) AstID { dense.IDAt(ga.Count, int(idx)) }

// SetAstChildren attaches child node IDs to node idx.
func SetAstChildren(ga mut GoAstTable, idx uint32, xs []uint32) {
	let r = dense.PutList(&ga.U32Pool, xs)
	dense.SetOf(&ga.Children, AstIDAt(*ga, idx), r)
}

// SetAstLhs attaches LHS/list node IDs to node idx.
func SetAstLhs(ga mut GoAstTable, idx uint32, xs []uint32) {
	let r = dense.PutList(&ga.U32Pool, xs)
	dense.SetOf(&ga.Lhs, AstIDAt(*ga, idx), r)
}

// SetAstRhs attaches RHS/results node IDs to node idx.
func SetAstRhs(ga mut GoAstTable, idx uint32, xs []uint32) {
	let r = dense.PutList(&ga.U32Pool, xs)
	dense.SetOf(&ga.Rhs, AstIDAt(*ga, idx), r)
}

// SetAstImports attaches file import records to NDFile node idx.
func SetAstImports(ga mut GoAstTable, idx uint32, imps []ImportRec) {
	let r = dense.PutList(&ga.ImpPool, imps)
	dense.SetOf(&ga.Imports, AstIDAt(*ga, idx), r)
}

// InternAstStr interns s in ga.Strings and returns its Str handle.
func InternAstStr(ga mut GoAstTable, s string) Str { dense.InternText(&ga.Strings, s) }

func astKind(ga GoAstTable, idx uint32) uint8 {
	if idx == NoIndex {
		return uint8(0)
	}
	dense.Of(ga.Kind, AstIDAt(ga, idx))
}

func astOp(ga GoAstTable, idx uint32) uint8 {
	if idx == NoIndex {
		return OpNone
	}
	dense.Of(ga.Op, AstIDAt(ga, idx))
}

func astObjKind(ga GoAstTable, idx uint32) uint8 {
	if idx == NoIndex {
		return ObjNone
	}
	dense.Of(ga.ObjKind, AstIDAt(ga, idx))
}

func astFlags(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return uint32(0)
	}
	dense.Of(ga.Flags, AstIDAt(ga, idx))
}

func astName(ga GoAstTable, idx uint32) string {
	if idx == NoIndex {
		return ""
	}
	dense.Text(ga.Strings, dense.Of(ga.Name, AstIDAt(ga, idx)))
}

func astTarget(ga GoAstTable, idx uint32) string {
	if idx == NoIndex {
		return ""
	}
	dense.Text(ga.Strings, dense.Of(ga.Target, AstIDAt(ga, idx)))
}

func astType(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return NoIndex
	}
	dense.Of(ga.TypeID, AstIDAt(ga, idx))
}

func astRecvType(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return NoIndex
	}
	dense.Of(ga.RecvTypeID, AstIDAt(ga, idx))
}

func astFuncSym(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return NoIndex
	}
	dense.Of(ga.FuncSym, AstIDAt(ga, idx))
}

func astX(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return NoIndex
	}
	dense.Of(ga.X, AstIDAt(ga, idx))
}

func astY(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return NoIndex
	}
	dense.Of(ga.Y, AstIDAt(ga, idx))
}

func astZ(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return NoIndex
	}
	dense.Of(ga.Z, AstIDAt(ga, idx))
}

func astW(ga GoAstTable, idx uint32) uint32 {
	if idx == NoIndex {
		return NoIndex
	}
	dense.Of(ga.W, AstIDAt(ga, idx))
}

func astChildren(ga GoAstTable, idx uint32) []uint32 {
	if idx == NoIndex {
		return []uint32{}
	}
	dense.List(ga.U32Pool, dense.Of(ga.Children, AstIDAt(ga, idx)))
}

func astLhs(ga GoAstTable, idx uint32) []uint32 {
	if idx == NoIndex {
		return []uint32{}
	}
	dense.List(ga.U32Pool, dense.Of(ga.Lhs, AstIDAt(ga, idx)))
}

func astRhs(ga GoAstTable, idx uint32) []uint32 {
	if idx == NoIndex {
		return []uint32{}
	}
	dense.List(ga.U32Pool, dense.Of(ga.Rhs, AstIDAt(ga, idx)))
