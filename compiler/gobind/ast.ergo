// Pure-Ergo Data-Oriented Go AST SoA Arena representing Go files,
// declarations, statements, and expressions for total and non-nil derivation.

import dense
import slices

// AST node kind constants for GoAstTable.
let NAIdent = uint8(1)
let NABasicLit = uint8(2)
let NAParen = uint8(3)
let NASelector = uint8(4)
let NAUnary = uint8(5)
let NABinary = uint8(6)
let NACall = uint8(7)
let NACompLit = uint8(8)
let NATypeAssert = uint8(9)
let NAStar = uint8(10)
let NAFuncLit = uint8(11)
let NAEllipsis = uint8(12)
let NAArrayType = uint8(13)
let NAMapType = uint8(14)
let NAOtherType = uint8(15)
let NAField = uint8(16)
let NAOtherExpr = uint8(17)

let NSBlock = uint8(20)
let NSAssign = uint8(21)
let NSDecl = uint8(22)
let NSReturn = uint8(23)
let NSIf = uint8(24)
let NSFor = uint8(25)
let NSRange = uint8(26)
let NSSwitch = uint8(27)
