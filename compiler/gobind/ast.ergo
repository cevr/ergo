let OpLand = uint8(12)
let OpLor = uint8(13)
let OpEql = uint8(14)
let OpNeq = uint8(15)
let OpLss = uint8(16)
let OpLeq = uint8(17)
let OpGtr = uint8(18)
let OpGeq = uint8(19)
let OpNot = uint8(20)
let OpArrow = uint8(21)
let OpAssign = uint8(22)
let OpDefine = uint8(23)
let OpAddAssign = uint8(24)
let OpSubAssign = uint8(25)
let OpMulAssign = uint8(26)
let OpQuoAssign = uint8(27)
let OpRemAssign = uint8(28)
let OpAndAssign = uint8(29)
let OpOrAssign = uint8(30)
let OpXorAssign = uint8(31)
let OpShlAssign = uint8(32)
let OpShrAssign = uint8(33)
let OpAndNotAssign = uint8(34)
