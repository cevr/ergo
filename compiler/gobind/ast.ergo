func astImports(ga GoAstTable, idx uint32) []ImportRec {
	if idx == NoIndex {
		return []ImportRec{}
	}
	dense.List(ga.ImpPool, dense.Of(ga.Imports, AstIDAt(ga, idx)))
}

func unparenAst(ga GoAstTable, raw uint32) uint32 {
	let mut cur = raw
	let limit = dense.Total(ga.Count) + 1
	for _ in 0..limit {
		if cur == NoIndex || astKind(ga, cur) != NAParen {
			return cur
		}
		cur = astX(ga, cur)
	}
	cur
}

// AstPackage pairs one Go package path with its parsed NDFile node indices.
type AstPackage {
	Path  string,
	Files []uint32,
}

// IdenticalType reports structural/named Go type equality inside GoTypeTable.
func IdenticalType(gt GoTypeTable, a0 uint32, b0 uint32) bool {
	let mut pairs = slices.WithCapacity[uint32](16)
	identicalWithSeen(gt, a0, b0, &pairs)
}

func hasSeenPair(pairs []uint32, a uint32, b uint32) bool {
	let mut i = 0
	for i+1 < pairs.Len() {
		if pairs[i] == a && pairs[i+1] == b {
			return true
		}
		i = i + 2
	}
	false
}

func canonicalBasic(b uint8) uint8 {
	if b == BByte {
		return BUint8
	}
	if b == BRune {
		return BInt32
	}
	b
}

func identicalWithSeen(gt GoTypeTable, rawA uint32, rawB uint32, seen mut []uint32) bool {
	let a = unalias(gt, rawA)
	let b = unalias(gt, rawB)
	if a == b {
		return a != NoIndex
	}
	if a == NoIndex || b == NoIndex {
		return false
	}
	if hasSeenPair(*seen, a, b) {
		return true
	}
	*seen = (*seen).Append(a)
	*seen = (*seen).Append(b)
	let ka = typeKind(gt, a)
	let kb = typeKind(gt, b)
	if ka != kb {
		return false
	}
	if ka == TKBasic {
		return canonicalBasic(typeBasicKind(gt, a)) == canonicalBasic(typeBasicKind(gt, b))
	}
	if ka == TKPointer || ka == TKSlice {
		return identicalWithSeen(gt, typeElem(gt, a), typeElem(gt, b), seen)
	}
	if ka == TKArray {
		return typeArrLen(gt, a) == typeArrLen(gt, b) && identicalWithSeen(gt, typeElem(gt, a), typeElem(gt, b), seen)
	}
	if ka == TKMap {
		return identicalWithSeen(gt, typeKey(gt, a), typeKey(gt, b), seen) && identicalWithSeen(gt, typeElem(gt, a), typeElem(gt, b), seen)
	}
	if ka == TKNamed {
		return typePkgPath(gt, a) == typePkgPath(gt, b) && typeName(gt, a) == typeName(gt, b) && typeTArgs(gt, a).Len() == typeTArgs(gt, b).Len()
	}
	if ka == TKTypeParam {
		return typeName(gt, a) == typeName(gt, b) && typeShortText(gt, a) == typeShortText(gt, b)
	}
	typeText(gt, a) != "" && typeText(gt, a) == typeText(gt, b)
}

// AstRoundTripAndUnparen verifies GoAstTable children, flags, and IdenticalType behavior.
test AstRoundTripAndUnparen {
	let mut gt = NewGoTypeTable()
	let tByte = AddType(&gt, TypeSpec{Kind: TKBasic, BasicKind: BByte, BasicName: "byte", Name: "", PkgPath: "", PkgName: "", TypeText: "byte", ShortText: "byte", Elem: NoIndex, Key: NoIndex, ArrLen: uint32(0), Underlying: NoIndex, RecvType: NoIndex, RecvName: "", Flags: TFFlagBasicUnsigned | TFFlagBasicInteger | TFFlagBasicNumeric})
	let tU8 = AddType(&gt, TypeSpec{Kind: TKBasic, BasicKind: BUint8, BasicName: "uint8", Name: "", PkgPath: "", PkgName: "", TypeText: "uint8", ShortText: "uint8", Elem: NoIndex, Key: NoIndex, ArrLen: uint32(0), Underlying: NoIndex, RecvType: NoIndex, RecvName: "", Flags: TFFlagBasicUnsigned | TFFlagBasicInteger | TFFlagBasicNumeric})
	assert IdenticalType(gt, tByte, tU8)

	let mut ga = NewGoAstTable()
	let mut lit = EmptyAstSpec(NABasicLit)
	lit.Flags = AFFlagTvConst | AFFlagIsIntZero | AFFlagBasicLitInt
	let litID = AddAst(&ga, lit)
	let mut p = EmptyAstSpec(NAParen)
	p.X = litID
	let pID = AddAst(&ga, p)
	assert unparenAst(ga, pID) == litID
}
