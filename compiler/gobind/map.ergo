// Pure-Ergo Go-to-Ergo declaration, signature, and type mapper matching
// internal/gobind/map.go and Decls/ownTypeMethods semantics over SoA tables.

import compiler/gofacts
import dense
import option
import slices
import strconv
import strings

let rowFails = "CE"
let rowNeeds = "CR"

let posParam = uint8(0)
let posResult = uint8(1)
let posErrResult = uint8(2)
let posField = uint8(3)
let posInner = uint8(4)

// MapContext holds immutable read-only SoA tables needed to map Go declarations.
type MapContext {
	GT        GoTypeTable,
	GD        GoDeclTable,
	Facts     FactsTable,
	FT        gofacts.FactTable,
	ET        gofacts.EffectTable,
	Ledger    gofacts.LedgerTable,
	Toolchain string,
}

// DefaultMapContext builds a MapContext with default gofacts tables and empty facts.
func DefaultMapContext(gt GoTypeTable, gd GoDeclTable) MapContext {
	MapContext{
		GT:        gt,
		GD:        gd,
		Facts:     NewFactsTable(),
		FT:        gofacts.DefaultFactTable(),
		ET:        gofacts.DefaultEffectTable(),
		Ledger:    gofacts.NewLedgerTable(),
		Toolchain: gofacts.DefaultToolchain,
	}
}

// IsKeyword reports whether name is an Ergo keyword or reserved word.
func IsKeyword(name string) bool {
	match name {
	case "break", "case", "continue", "else", "for", "func", "if", "import", "return", "type", "try", "catch", "needs", "provides", "context", "machine", "let", "mut", "in", "match", "escaping", "fails", "test", "law", "assert", "extern", "with", "takes", "as", "chan", "const", "default", "defer", "fallthrough", "go", "goto", "interface", "map", "package", "range", "select", "struct", "switch", "var":
		true
	case _:
		false
	}
}

// IsPredeclared reports whether name is predeclared in the universe or prelude scope.
func IsPredeclared(name string) bool {
	if name == "_" || name == "error" || name == "uintptr" || name == "complex64" || name == "complex128" || name == "with" || name == "go" || name == "wire" {
		return false
	}
	match name {
	case "Map", "bool", "string", "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "float32", "float64", "duration", "byte", "rune", "comparable", "true", "false", "len", "hash", "encode", "decode", "embedded", "wired":
		true
	case "Option", "Some", "None", "Seq", "Ambient", "AlarmClock", "Alarms", "TestAmbient", "TestDirectory", "TestFolderHandle", "TestFolder", "TestLoopback", "Scheduler", "LiveScheduler", "NewLiveScheduler", "Random", "Unsatisfied", "NoMatch", "Writer", "Reader", "Console":
		true
	case "WireWrongKind", "WireNull", "WireBool", "WireNumber", "WireString", "WireList", "WireObject", "WireEnd", "WireKind", "WireMissingField", "WireUnknownTag", "WireOmittable", "WireNullable", "WireBare", "WireNumberText", "WireMembers":
		true
	case "Hashing", "Structural", "Hash", "Equal", "NormalForm", "NormalKey", "Get", "Put", "Delete", "Take", "Clone", "Len", "Using", "MakeMap", "Stored", "Range", "CallSite", "Context", "AsWritten":
		true
	case "Enter", "Stay", "Emit", "Ignore", "Reject", "Done", "Tell", "Decision", "Never", "Absurd", "Timeout", "Machine", "InputMachine", "Closer", "Keeping":
		true
	case "noMatch", "unsatisfied", "wireMissingField", "wireUnknownTag", "wireWrongKind", "liveOnly":
		true
	case _:
		false
	}
}

// IsBinder reports whether name is a valid Ergo parameter binder identifier.
func IsBinder(name string) bool {
	if name == "" || name == "_" || IsKeyword(name) || IsPredeclared(name) {
		return false
	}
	for i in 0..name.Len() {
		let c = name[i]
		let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
		let digit = i > 0 && c >= '0' && c <= '9'
		if !letter && !digit {
			return false
		}
	}
	true
}

// IsInternalPath reports whether path contains an "internal" or "vendor" segment.
func IsInternalPath(path string) bool {
	for e in strings.Split(path, "/") {
		if e == "internal" || e == "vendor" {
			return true
		}
	}
	false
}

// Placehold formats an import placeholder token matching internal/gobind rendering.
func Placehold(path string, name string) string {
	"\u27e6" + path + " " + name + "\u27e7"
}

func placeholdStd(pkg string) string {
	Placehold("ergo:"+pkg, pkg)
}

func typeKind(gt GoTypeTable, tid uint32) uint8 {
	if tid == NoIndex {
		return uint8(0)
	}
	dense.Of(gt.Kind, TypeIDAt(gt, tid))
}

func typeFlags(gt GoTypeTable, tid uint32) uint32 {
	if tid == NoIndex {
		return uint32(0)
	}
	dense.Of(gt.Flags, TypeIDAt(gt, tid))
}

func typeName(gt GoTypeTable, tid uint32) string {
	if tid == NoIndex {
		return ""
	}
	dense.Text(gt.Strings, dense.Of(gt.Name, TypeIDAt(gt, tid)))
}

func typePkgPath(gt GoTypeTable, tid uint32) string {
	if tid == NoIndex {
		return ""
	}
	dense.Text(gt.Strings, dense.Of(gt.PkgPath, TypeIDAt(gt, tid)))
}

func typePkgName(gt GoTypeTable, tid uint32) string {
	if tid == NoIndex {
		return ""
	}
	dense.Text(gt.Strings, dense.Of(gt.PkgName, TypeIDAt(gt, tid)))
}

func typeBasicKind(gt GoTypeTable, tid uint32) uint8 {
	if tid == NoIndex {
		return BInvalid
	}
	dense.Of(gt.BasicKind, TypeIDAt(gt, tid))
}

