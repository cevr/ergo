	if tid == NoIndex {
		return ""
	}
	dense.Text(gt.Strings, dense.Of(gt.ShortText, TypeIDAt(gt, tid)))
}

func typeElem(gt GoTypeTable, tid uint32) uint32 {
	if tid == NoIndex {
		return NoIndex
	}
	dense.Of(gt.Elem, TypeIDAt(gt, tid))
}

func typeKey(gt GoTypeTable, tid uint32) uint32 {
	if tid == NoIndex {
		return NoIndex
	}
	dense.Of(gt.Key, TypeIDAt(gt, tid))
}

func typeUnder(gt GoTypeTable, tid uint32) uint32 {
	if tid == NoIndex {
		return NoIndex
	}
	dense.Of(gt.Underlying, TypeIDAt(gt, tid))
}

func typeArrLen(gt GoTypeTable, tid uint32) uint32 {
	if tid == NoIndex {
		return uint32(0)
	}
	dense.Of(gt.ArrLen, TypeIDAt(gt, tid))
}

func typeRecvType(gt GoTypeTable, tid uint32) uint32 {
	if tid == NoIndex {
		return NoIndex
	}
	dense.Of(gt.RecvType, TypeIDAt(gt, tid))
}

func typeFields(gt GoTypeTable, tid uint32) []GoFieldRec {
	if tid == NoIndex {
		return []GoFieldRec{}
	}
	dense.List(gt.FieldsPool, dense.Of(gt.Fields, TypeIDAt(gt, tid)))
}

func typeParams(gt GoTypeTable, tid uint32) []GoParamRec {
	if tid == NoIndex {
		return []GoParamRec{}
	}
	dense.List(gt.ParamsPool, dense.Of(gt.Params, TypeIDAt(gt, tid)))
}

func typeResults(gt GoTypeTable, tid uint32) []GoParamRec {
	if tid == NoIndex {
		return []GoParamRec{}
	}
	dense.List(gt.ParamsPool, dense.Of(gt.Results, TypeIDAt(gt, tid)))
}

