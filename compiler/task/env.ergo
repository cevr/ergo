import filepath
import option
import slices
import strings

// GrantEnv names the core-lease environment variable passed to child processes.
let GrantEnv = "ERGO_BUDGET_GRANT"

// GoListTemplate is the Go text/template string passed to `go list -deps -f`.
let GoListTemplate = "{{if not .Standard}}P {{.Dir}}{{range .GoFiles}} {{.}}{{end}}{{range .CgoFiles}} {{.}}{{end}}{{range .SFiles}} {{.}}{{end}}{{range .HFiles}} {{.}}{{end}}{{range .EmbedFiles}} {{.}}{{end}}{{range .TestGoFiles}} {{.}}{{end}}{{range .XTestGoFiles}} {{.}}{{end}}{{range .TestEmbedFiles}} {{.}}{{end}}{{range .XTestEmbedFiles}} {{.}}{{end}}{{if .Module}}{{if .Module.GoMod}}\nM {{.Module.GoMod}}{{end}}{{end}}{{end}}"

// ChildEnv holds the filtered, sorted environment key=value entries and unset markers
// seen by runner child processes.
type ChildEnv {
	// Entries holds sorted KEY=VALUE entries followed by "\x00unset NAME" markers.
	Entries []string,
}

// GoGen describes a generator declared in ergo.work via `gen NAME COMMAND...` and `reads`.
type GoGen {
	// Name is the generator identifier.
	Name string,
	// Command is the argv words of the generator command.
	Command []string,
	// Reads lists slash-separated extra input paths declared for the generator.
	Reads []string,
}

func hasStrKey(m Map[string, string], k string) bool {
	match m.Get(k) {
	case option.Some:
		true
	case option.None:
		false
	}
}

// StatedFrom constructs a deterministic ChildEnv from host NAME=VALUE entries,
// preserving PATH, HOME, TMPDIR, any names requested, GO*, and CGO_* variables,
// then applying extra overrides.
func StatedFrom(host []string, names []string, extra []string) ChildEnv {
	let mut want = Map[string, bool]{
		"PATH":   true,
		"HOME":   true,
		"TMPDIR": true,
	}
	for n in names {
		want[n] = true
	}
	let mut vals = Map[string, string]{}
	let mut keys = []string{}
	for kv in host {
		match strings.Cut(kv, "=") {
		case option.Some{Value: h}:
			let isWanted = match want.Get(h.Before) {
			case option.Some{Value: v}:
				v
			case option.None:
				false
			}
			if isWanted || strings.HasPrefix(h.Before, "GO") || strings.HasPrefix(h.Before, "CGO_") {
				if !hasStrKey(vals, h.Before) {
					keys = keys.Append(h.Before)
				}
				vals[h.Before] = h.After
			}
		case option.None:
		}
	}
	for kv in extra {
		match strings.Cut(kv, "=") {
		case option.Some{Value: h}:
			if !hasStrKey(vals, h.Before) {
				keys = keys.Append(h.Before)
			}
			vals[h.Before] = h.After
		case option.None:
		}
	}
	let mut env = slices.WithCapacity[string](keys.Len() + names.Len())
	for k in keys {
		match vals.Get(k) {
		case option.Some{Value: v}:
			env = env.Append("\(k)=\(v)")
		case option.None:
		}
	}
	env = slices.Sort(env)
	for n in names {
		if !hasStrKey(vals, n) {
			env = env.Append("\x00unset \(n)")
		}
	}
	ChildEnv{Entries: env}
}

// EnvKey formats env into a newline-delimited cache key part, masking ERGO_BUDGET_GRANT's
// concrete lease value with "(lent grant)".
func EnvKey(env ChildEnv) string {
	let mut b = strings.NewBuilder()
	for kv0 in env.Entries {
		let mut kv = kv0
		match strings.Cut(kv, "=") {
		case option.Some{Value: h}:
			if h.Before == GrantEnv {
				kv = "\(h.Before)=(lent grant)"
			}
		case option.None:
		}
		b.WriteString(kv)
		b.WriteString("\n")
	}
	b.String()
}

// ChildEnviron returns the actual KEY=VALUE entries to pass to a child process,
// omitting any "\x00unset " markers.
func ChildEnviron(env ChildEnv) []string {
	let mut out = []string{}
	for kv in env.Entries {
		if !strings.HasPrefix(kv, "\x00") {
			out = out.Append(kv)
		}
	}
	out
}

// GoPackage validates g.Command as `go run PKG ...` or `go test ... PKG ...` and returns
// the local package path and whether the command invokes `go test`.
func GoPackage(g GoGen) (string, bool) fails TaskError {
	if g.Command.Len() < 3 || g.Command[0] != "go" || (g.Command[1] != "run" && g.Command[1] != "test") {
		return TaskError{Reason: "gen \(g.Name): the command is go run PKG ... or go test ... PKG ...; another command is a foreign task (WT2)"}
	}
	let mut pkg = ""
	for i in 2..g.Command.Len() {
		let w = g.Command[i]
		if w == "." || strings.HasPrefix(w, "./") {
			if pkg != "" {
				return TaskError{Reason: "gen \(g.Name): the command names two packages, \(pkg) and \(w); a gen builds one"}
			}
			pkg = w
		}
	}
	if pkg == "" {
		return TaskError{Reason: "gen \(g.Name): name the command's package as ./DIR"}
	}
	(pkg, g.Command[1] == "test")
}

// GoGenIdent returns the cache identifier encoding g's command and declared reads.
func GoGenIdent(g GoGen) string {
	"\(strings.Join(g.Command, "\x00"))\x01\(strings.Join(g.Reads, "\x00"))"
}

func relUnderRoot(root string, abs string) (string, bool) {
	let r = filepath.Rel(root, abs) catch {
	case filepath.NotRelative:
		return ("", false)
	}
	if r == "" || r == ".." || strings.HasPrefix(r, "../") || strings.HasPrefix(r, "/") {
		return ("", false)
	}
	(r, true)
}

// ParseGoListOutput parses the stdout of `go list -deps -f GoListTemplate` into Inputs
// relative to root, always including go.mod and go.sum.
func ParseGoListOutput(root string, out string) Inputs {
	let mut files = []string{}
	let mut dirs = []string{}
	for line in strings.Split(out, "\n") {
		let fields = strings.Fields(line)
		if fields.Len() < 2 {
			continue
		}
		if fields[0] == "M" {
			let (r, ok) = relUnderRoot(root, fields[1])
			if ok {
				files = files.Append(r)
				files = files.Append("\(strings.TrimSuffix(r, "go.mod"))go.sum")
			}
		} else if fields[0] == "P" {
			let (dir, ok) = relUnderRoot(root, fields[1])
			if !ok {
				continue
			}
			dirs = dirs.Append(dir)
			for i in 2..fields.Len() {
				let p = filepath.Join([]string{dir, fields[i]})
				files = files.Append(p)
				dirs = dirs.Append(ParentDir(p))
			}
		}
	}
	files = files.Append("go.mod")
	files = files.Append("go.sum")
	Inputs{Files: files, Dirs: dirs}
}

// EnvKeyMasksBudgetGrant verifies that ERGO_BUDGET_GRANT lease values never leak into EnvKey
// while ChildEnviron still forwards the exact lease value and strips unset markers.
law EnvKeyMasksBudgetGrant(grantVal string, missingVar string) {
	let v = if grantVal == "" || strings.Contains(grantVal, "\n") { "grant-1" } else { grantVal }
	let badMissing = missingVar == "" || missingVar == "PATH" || missingVar == "HOME" || missingVar == "TMPDIR" || missingVar == "GOMAXPROCS" || missingVar == "SECRET" || missingVar == GrantEnv || strings.HasPrefix(missingVar, "GO") || strings.HasPrefix(missingVar, "CGO_") || strings.Contains(missingVar, "=") || strings.Contains(missingVar, "\n")
	let m = if badMissing { "FOO_CUSTOM" } else { missingVar }
	let host = []string{"PATH=/usr/bin", "HOME=/h", "SECRET=hidden"}
	let env = StatedFrom(host, []string{m}, []string{"GOMAXPROCS=2", "\(GrantEnv)=\(v)"})
	let k = EnvKey(env)
	let ch = ChildEnviron(env)
	strings.Contains(k, "\(GrantEnv)=(lent grant)\n") && strings.Contains(k, "\x00unset \(m)\n") && !strings.Contains(k, "SECRET=") && slices.Contains(ch, "\(GrantEnv)=\(v)") && !slices.Contains(ch, "\x00unset \(m)")
}

test GoPackageIdentAndListOutputParse {
	let g = GoGen{Name: "linked", Command: []string{"go", "run", "./scripts/linked"}, Reads: []string{"compiler"}}
	let (pkg, isTest) = GoPackage(g) catch {
	case TaskError as e:
		assert e.Reason == ""
		return
	}
	assert pkg == "./scripts/linked" && !isTest
	assert GoGenIdent(g) == "go\x00run\x00./scripts/linked\x01compiler"

	let gBad = GoGen{Name: "foreign", Command: []string{"python3", "foo.py"}, Reads: []string{}}
	let mut failed = false
	let _ = GoPackage(gBad) catch {
	case TaskError:
		failed = true
		("./bad", false)
	}
	assert failed

	let listOut = "P /repo/cmd/ergo main.go helper.go\nM /repo/go.mod\nP /usr/local/go/src/fmt print.go\n"
	let inp = ParseGoListOutput("/repo", listOut)
	assert slices.Contains(inp.Dirs, "cmd/ergo")
	assert slices.Contains(inp.Files, "cmd/ergo/main.go")
	assert slices.Contains(inp.Files, "go.mod")
	assert slices.Contains(inp.Files, "go.sum")
	assert !slices.Contains(inp.Files, "/usr/local/go/src/fmt/print.go")
}
