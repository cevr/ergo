import hex
import compiler/lawcache
import option
import sha256
import slices
import strconv
import strings

// StoreIdentity is the lawcache compiler identity shared by task results across ergo rebuilds.
let StoreIdentity = "ergo-task/1"

// Missing is the digest or listing of a path that does not exist or is a directory when hashed as a file.
let Missing = "-"

// Derived identifies a generator or step whose key is computed solely by the toolchain.
let Derived = "derived"

// Vouched identifies a generator whose key includes declared reads lines from ergo.work.
let Vouched = "vouched: declared reads"

// ScratchPrefix names the temporary directory prefix used by Gen Check mode.
let ScratchPrefix = ".ergo-task-copy"

// Inputs holds the slash-separated file and directory paths read by a generator node.
type Inputs {
	// Files are read by file content digest (or Missing when absent).
	Files []string,
	// Dirs are read by directory entry listing digest.
	Dirs []string,
}

// OutputEntry holds one output file path and its content digest recorded from a run.
type OutputEntry {
	// Path is slash-separated relative to the workspace root.
	Path string,
	// Digest is the SHA-256 hex digest of Path after the run, or Missing if deleted.
	Digest string,
}

// TaskRecord is the serialized last-run or content-addressed cache entry for a generator node.
type TaskRecord {
	// Env is the serialized environment key of the generator run.
	Env string,
	// In holds the node inputs discovered after the run.
	In Inputs,
	// FileSums aligns with In.Files.
	FileSums []string,
	// DirSums aligns with In.Dirs.
	DirSums []string,
	// Outs records each observed output path and digest.
	Outs []OutputEntry,
}

// TreeEntry describes one child entry of a directory listing.
type TreeEntry {
	// Name is the entry's base name.
	Name string,
	// Dir is true when the entry is a directory.
	Dir bool,
}

// StatTable stores file stat cache metadata and content digests in SoA columns.
type StatTable {
	// Paths holds slash-separated relative paths.
	Paths []string,
	// SizeBits stores signed int64 byte sizes in two's-complement bit form.
	SizeBits []uint64,
	// MtimeBits stores signed int64 modification timestamps (Unix nanos).
	MtimeBits []uint64,
	// CtimeBits stores signed int64 status-change timestamps (Unix nanos).
	CtimeBits []uint64,
	// Inodes stores inode numbers.
	Inodes []uint64,
	// Modes stores Unix file mode bits.
	Modes []uint32,
	// Digests holds cached SHA-256 hex digests aligned with Paths.
	Digests []string,
}

// EmptyStatTable returns an empty StatTable.
func EmptyStatTable() StatTable {
	StatTable{
		Paths:     []string{},
		SizeBits:  []uint64{},
		MtimeBits: []uint64{},
		CtimeBits: []uint64{},
		Inodes:    []uint64{},
		Modes:     []uint32{},
		Digests:   []string{},
	}
}

// AppendStat adds a file stat row to t and returns its index.
func AppendStat(t mut StatTable, path string, size int64, mtime int64, ctime int64, ino uint64, mode uint32, digest string) uint32 {
	let idx = uint32(t.Paths.Len())
	t.Paths = t.Paths.Append(path)
	t.SizeBits = t.SizeBits.Append(uint64(size))
	t.MtimeBits = t.MtimeBits.Append(uint64(mtime))
	t.CtimeBits = t.CtimeBits.Append(uint64(ctime))
	t.Inodes = t.Inodes.Append(ino)
	t.Modes = t.Modes.Append(mode)
	t.Digests = t.Digests.Append(digest)
	idx
}

// SortedUnique returns s sorted lexicographically with adjacent duplicates removed.
func SortedUnique(s []string) []string {
	let sorted = slices.Sort(slices.Clone(s))
	let mut out = slices.WithCapacity[string](sorted.Len())
	for item in sorted {
		if out.Len() == 0 || out[out.Len()-1] != item {
			out = out.Append(item)
		}
	}
	out
}

// ListingDigest computes the SHA-256 hex digest of sorted directory entries.
func ListingDigest(entries []TreeEntry) string {
	let h = sha256.New()
	for e in entries {
		let mark = if e.Dir { "d" } else { "f" }
		h.Write(mark + e.Name + "\x00")
	}
	hex.Encode(h.Digest())
}

// EncodeRecord serializes r in the ergo-task/2 text format.
func EncodeRecord(r TaskRecord) string {
	let mut b = strings.NewBuilder()
	b.WriteString("ergo-task/2\n")
	b.WriteString("env \(strconv.Quote(r.Env))\n")
	for i in 0..r.In.Files.Len() {
		b.WriteString("in \(r.FileSums[i]) \(r.In.Files[i])\n")
	}
	for i in 0..r.In.Dirs.Len() {
		b.WriteString("dir \(r.DirSums[i]) \(r.In.Dirs[i])\n")
	}
	for o in r.Outs {
		b.WriteString("out \(o.Digest) \(o.Path)\n")
	}
	b.String()
}

// DecodeRecord parses an ergo-task/2 record string, returning (record, true) when valid.
func DecodeRecord(text string) (TaskRecord, bool) {
	let trimmed = strings.TrimSuffix(text, "\n")
	let lines = strings.Split(trimmed, "\n")
	let emptyRec = TaskRecord{
		Env:      "",
		In:       Inputs{Files: []string{}, Dirs: []string{}},
		FileSums: []string{},
		DirSums:  []string{},
		Outs:     []OutputEntry{},
	}
	if lines.Len() < 2 || lines[0] != "ergo-task/2" {
		return (emptyRec, false)
	}
	let mut env = ""
	let mut inFiles = []string{}
	let mut inDirs = []string{}
	let mut fileSums = []string{}
	let mut dirSums = []string{}
	let mut outs = []OutputEntry{}
	for i in 1..lines.Len() {
		let l = lines[i]
		let (key, rest) = match strings.Cut(l, " ") {
		case option.Some{Value: h}:
			(h.Before, h.After)
		case option.None:
			(l, "")
		}
		if key == "env" {
			if rest.Len() < 2 || rest[0] != '"' {
				return (emptyRec, false)
			}
			let unquoted = strconv.Unquote(rest) catch {
			case _:
				return (emptyRec, false)
			}
			env = unquoted
		} else if key == "in" || key == "dir" {
			match strings.Cut(rest, " ") {
			case option.Some{Value: h}:
				if key == "in" {
					inFiles = inFiles.Append(h.After)
					fileSums = fileSums.Append(h.Before)
				} else {
					inDirs = inDirs.Append(h.After)
					dirSums = dirSums.Append(h.Before)
				}
			case option.None:
				return (emptyRec, false)
			}
		} else if key == "out" {
			match strings.Cut(rest, " ") {
			case option.Some{Value: h}:
				outs = outs.Append(OutputEntry{Path: h.After, Digest: h.Before})
			case option.None:
				return (emptyRec, false)
			}
		} else {
			return (emptyRec, false)
		}
	}
	let rec = TaskRecord{
		Env:      env,
		In:       Inputs{Files: inFiles, Dirs: inDirs},
		FileSums: fileSums,
		DirSums:  dirSums,
		Outs:     outs,
	}
	(rec, true)
}

// LastKey returns the lawcache key for a node's last run in root.
func LastKey(root string, name string, ident string) string {
	lawcache.Key([]string{"task last", root, name, ident})
}

// StatKey returns the lawcache key for the stat cache of root.
func StatKey(root string) string {
	lawcache.Key([]string{"task stat", root})
}

func parseUint64Dec(s string) (uint64, bool) {
	if s.Len() == 0 {
		return (uint64(0), false)
	}
	let maxU64 uint64 = 0xffffffffffffffff
	let mut acc = uint64(0)
	for i in 0..s.Len() {
		let ch = s[i]
		if ch < '0' || ch > '9' {
			return (uint64(0), false)
		}
		let d = uint64(ch - '0')
		if acc > (maxU64-d)/uint64(10) {
			return (uint64(0), false)
		}
		acc = acc*uint64(10) + d
	}
	(acc, true)
}

// EncodeStatCache encodes settled stat rows of t in sorted path order.
func EncodeStatCache(t StatTable, racyNanos int64) string {
	let mut idxMap = Map[string, uint32]{}
	for i in 0..t.Paths.Len() {
		idxMap[t.Paths[i]] = uint32(i)
	}
	let keys = SortedUnique(t.Paths)
	let mut b = strings.NewBuilder()
	for rel in keys {
		match idxMap.Get(rel) {
		case option.Some{Value: idx}:
			let i = int(idx)
			let mtime = int64(t.MtimeBits[i])
			let ctime = int64(t.CtimeBits[i])
			if mtime < racyNanos && ctime < racyNanos {
				let sz = strconv.FormatInt(int64(t.SizeBits[i]), 10)
				let mt = strconv.FormatInt(mtime, 10)
				let ct = strconv.FormatInt(ctime, 10)
				let ino = strconv.AppendUint([]byte{}, t.Inodes[i], 10)
				let mode = strconv.AppendUint([]byte{}, uint64(t.Modes[i]), 10)
				b.WriteString(sz)
				b.WriteString(" ")
				b.WriteString(mt)
				b.WriteString(" ")
				b.WriteString(ct)
				b.WriteString(" ")
				b.WriteBytes(ino)
				b.WriteString(" ")
				b.WriteBytes(mode)
				b.WriteString(" ")
				b.WriteString(t.Digests[i])
				b.WriteString(" ")
				b.WriteString(rel)
				b.WriteString("\n")
			}
		case option.None:
		}
	}
	b.String()
}

// DecodeStatCache parses an encoded stat cache string into a StatTable.
func DecodeStatCache(text string) StatTable {
	let mut out = EmptyStatTable()
	for line in strings.Split(text, "\n") {
		let f = strings.SplitN(line, " ", 7)
		if f.Len() != 7 {
			continue
		}
		let sz = strconv.ParseInt(f[0], 10, 64) catch {
		case _:
			continue
		}
		let mt = strconv.ParseInt(f[1], 10, 64) catch {
		case _:
			continue
		}
		let ct = strconv.ParseInt(f[2], 10, 64) catch {
		case _:
			continue
		}
		let (ino, okIno) = parseUint64Dec(f[3])
		let (mode, okMode) = parseUint64Dec(f[4])
		if !okIno || !okMode || mode > uint64(0xffffffff) {
			continue
		}
		let _ = AppendStat(&out, f[6], sz, mt, ct, ino, uint32(mode), f[5])
	}
	out
}

// ChangedPaths returns the sorted unique paths whose stat differs between before and after.
func ChangedPaths(before StatTable, after StatTable) []string {
	let mut bMap = Map[string, uint32]{}
	for i in 0..before.Paths.Len() {
		bMap[before.Paths[i]] = uint32(i)
	}
	let mut aMap = Map[string, uint32]{}
	for i in 0..after.Paths.Len() {
		aMap[after.Paths[i]] = uint32(i)
	}
	let mut out = []string{}
	for i in 0..after.Paths.Len() {
		let p = after.Paths[i]
		match bMap.Get(p) {
		case option.Some{Value: bi}:
			let j = int(bi)
			if before.SizeBits[j] != after.SizeBits[i] ||
				before.MtimeBits[j] != after.MtimeBits[i] ||
				before.CtimeBits[j] != after.CtimeBits[i] ||
				before.Inodes[j] != after.Inodes[i] ||
				before.Modes[j] != after.Modes[i] {
				out = out.Append(p)
			}
		case option.None:
			out = out.Append(p)
		}
	}
	for p in before.Paths {
		let found = match aMap.Get(p) {
		case option.Some:
			true
		case option.None:
			false
		}
		if !found {
			out = out.Append(p)
		}
	}
	SortedUnique(out)
}

// FirstDiff returns the first line where a and b differ as "%q -> %q", or "(the same lines)".
func FirstDiff(a string, b string) string {
	let al = strings.Split(a, "\n")
	let bl = strings.Split(b, "\n")
	let n = if al.Len() > bl.Len() { al.Len() } else { bl.Len() }
	for i in 0..n {
		let x = if i < al.Len() { al[i] } else { "" }
		let y = if i < bl.Len() { bl[i] } else { "" }
		if x != y {
			return "\(strconv.Quote(x)) -> \(strconv.Quote(y))"
		}
	}
	"(the same lines)"
}

// SameOutputs reports whether fresh outputs match every path present in both stored and fresh.
func SameOutputs(stored []OutputEntry, fresh []OutputEntry) bool {
	let mut now = Map[string, uint32]{}
	for i in 0..fresh.Len() {
		now[fresh[i].Path] = uint32(i)
	}
	for o in stored {
		match now.Get(o.Path) {
		case option.Some{Value: idx}:
			if fresh[int(idx)].Digest != o.Digest {
				return false
			}
		case option.None:
		}
	}
	true
}

// Skipped reports whether a slash-separated tree walk leaves out rel (.git or scratch copy).
func Skipped(rel string) bool {
	let first = match strings.Cut(rel, "/") {
	case option.Some{Value: h}:
		h.Before
	case option.None:
		rel
	}
	first == ".git" || first == ScratchPrefix || strings.HasPrefix(first, ScratchPrefix)
}

// Under reports whether slash path p equals dir or lies beneath dir.
func Under(p string, dir string) bool {
	p == dir || strings.HasPrefix(p, dir+"/")
}

// ParentDir returns the slash folder enclosing p, or "." at root.
func ParentDir(p string) string {
	let mut s = p
	for s.Len() > 1 && s[s.Len()-1] == '/' {
		s = s[0 : s.Len()-1]
	}
	if s == "" || s == "." {
		return "."
	}
	let idx = strings.LastIndex(s, "/")
	if idx < 0 {
		return "."
	}
	if idx == 0 {
		return "/"
	}
	s[0:idx]
}

// RecordRoundTrips verifies EncodeRecord and DecodeRecord invert on structured task records.
law RecordRoundTrips(envText string, filePath string, outPath string) {
	let rec = TaskRecord{
		Env:      envText,
		In:       Inputs{Files: []string{filePath}, Dirs: []string{"dir"}},
		FileSums: []string{"sumf"},
		DirSums:  []string{"sumd"},
		Outs:     []OutputEntry{OutputEntry{Path: outPath, Digest: "sumo"}},
	}
	let fpValid = !strings.Contains(filePath, "\n") && filePath != ""
	let opValid = !strings.Contains(outPath, "\n") && outPath != ""
	let encoded = EncodeRecord(rec)
	let (decoded, ok) = DecodeRecord(encoded)
	if fpValid && opValid {
		return ok && decoded.Env == rec.Env && decoded.In.Files == rec.In.Files && decoded.In.Dirs == rec.In.Dirs && decoded.FileSums == rec.FileSums && decoded.DirSums == rec.DirSums && decoded.Outs == rec.Outs
	}
	true
}

// SortedUniqueIsIdempotent checks that SortedUnique produces strictly increasing elements.
law SortedUniqueIsIdempotent(items []string) {
	let u = SortedUnique(items)
	let u2 = SortedUnique(u)
	let mut strict = true
	for i in 1..u.Len() {
		if u[i-1] >= u[i] {
			strict = false
		}
	}
	strict && u == u2
}

test StatCacheChangedPathsAndDiffHelpers {
	let mut t1 = EmptyStatTable()
	let _ = AppendStat(&t1, "a.go", int64(10), int64(100), int64(100), uint64(1), uint32(0o644), "d1")
	let _ = AppendStat(&t1, "b.go", int64(20), int64(500), int64(500), uint64(2), uint32(0o644), "d2")
	let enc = EncodeStatCache(t1, int64(200))
	let dec = DecodeStatCache(enc)
	assert dec.Paths == []string{"a.go"}
	assert dec.Digests == []string{"d1"}

	let mut t2 = EmptyStatTable()
	let _ = AppendStat(&t2, "a.go", int64(10), int64(100), int64(100), uint64(1), uint32(0o644), "d1")
	let _ = AppendStat(&t2, "b.go", int64(21), int64(500), int64(500), uint64(2), uint32(0o644), "d2b")
	let _ = AppendStat(&t2, "c.go", int64(1), int64(10), int64(10), uint64(3), uint32(0o644), "d3")
	assert ChangedPaths(t1, t2) == []string{"b.go", "c.go"}
	assert FirstDiff("A=1\nB=2\n", "A=1\nB=3\n") == "\"B=2\" -> \"B=3\""
	assert FirstDiff("A=1", "A=1") == "(the same lines)"
	assert ParentDir("a/b/c.go") == "a/b"
	assert ParentDir("foo.go") == "."
	assert Skipped(".git/HEAD")
	assert Skipped(".ergo-task-copy123/x")
	assert !Skipped("cmd/ergo/main.go")
}
