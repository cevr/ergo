import compiler/lawcache
import option
import slices
import strings

// Verdict is the outcome reported for one task step execution or cache replay.
type Verdict = Pass{} | Fail{} | Flaky{} | Unaffected{}

// VerdictString returns the lowercase wire label for v.
func VerdictString(v Verdict) string {
	match v {
	case Pass:
		"pass"
	case Fail:
		"fail"
	case Flaky:
		"flaky"
	case Unaffected:
		"unaffected"
	}
}

// StepSpec describes one planned step inside a task execution graph.
type StepSpec {
	// Task is the task name for which the step was planned.
	Task string,
	// Verb is the action verb (e.g. "check", "test", "lint").
	Verb string,
	// Member is the target workspace member path (or "." for root).
	Member string,
	// Class is Derived or Vouched.
	Class string,
	// HasKey reports whether this step keeps and checks verdict keys in the store.
	HasKey bool,
	// Retry causes a failing run to be retried once (marking pass-on-retry as Flaky).
	Retry bool,
	// After lists prerequisite step indices that must pass before this step runs.
	After []uint32,
}

// KeyPart pairs one named input component with its digest.
type KeyPart {
	// Name identifies the input component.
	Name string,
	// Digest holds the component's content or metadata digest.
	Digest string,
}

// StepKey holds the ordered named key parts and affected-selection paths for a step.
type StepKey {
	// Parts lists ordered key parts so misses blame the first moved input.
	Parts []KeyPart,
	// Paths lists relative files, folders, "." or glob patterns covering the step.
	Paths []string,
}

// StepResult records the execution outcome, replay status, timing, log path, and seed for one step.
type StepResult {
	// Task is the task name.
	Task string,
	// Step is the step verb.
	Step string,
	// Member is the workspace member path.
	Member string,
	// Verdict is Pass, Fail, Flaky, or Unaffected.
	Verdict Verdict,
	// Replay is "hit", "miss", or "" for Unaffected/Blocked steps.
	Replay string,
	// Why explains a cache miss or "--fresh" re-run.
	Why string,
	// Class is Derived or Vouched.
	Class string,
	// MsBits holds the signed int64 duration in milliseconds in two's-complement bit form.
	MsBits uint64,
	// Log holds the persisted log file path, if any.
	Log string,
	// Seed holds the extracted failing seed for Fail or Flaky test outputs.
	Seed string,
	// Contradicted is true when --fresh invalidated a previously cached Pass.
	Contradicted bool,
	// BlockedBy names the failed prerequisite preventing this step from running.
	BlockedBy string,
}

// StepResultMs returns r's signed duration in milliseconds.
func StepResultMs(r StepResult) int64 { int64(r.MsBits) }

// StepRunOutcome holds the result of running a single step once.
type StepRunOutcome {
	// Pass is true when the step execution succeeded.
	Pass bool,
	// LogText holds the raw combined output produced by the execution.
	LogText string,
	// MsBits holds the measured execution time in milliseconds.
	MsBits uint64,
}

// VerdictMode configures Fresh and Affected filtering for RunVerdicts.
type VerdictMode {
	// Fresh ignores cached passes and treats flaky steps as failures.
	Fresh bool,
	// Changed lists relative paths changed against the base commit.
	Changed []string,
	// Affected enables --affected path filtering against Changed.
	Affected bool,
}

// VerdictReport holds the ordered step results of RunVerdicts.
type VerdictReport {
	// Steps lists one StepResult per input StepSpec.
	Steps []StepResult,
}

// VerdictHost provides step key computation, execution, log saving, and flaky noting.
type VerdictHost {
	// Key returns the current StepKey for stepIdx.
	Key(stepIdx int) StepKey fails TaskError,
	// Paths returns custom selection paths for stepIdx (empty when Key's Paths should be used).
	Paths(stepIdx int) []string fails TaskError,
	// HasCustomPaths reports whether stepIdx overrides Key's Paths for --affected filtering.
	HasCustomPaths(stepIdx int) bool,
	// Run executes stepIdx and returns its pass/fail outcome, log, and elapsed milliseconds.
	Run(stepIdx int) StepRunOutcome fails TaskError,
	// WriteLog stores logText for stepIdx under contentKey and returns the saved path (or "").
	WriteLog(stepIdx int, contentKey string, logText string) string,
	// NoteFlaky records a flaky step result.
	NoteFlaky(res StepResult),
}

// ReportVerdictsFailed reports whether rep fails under fresh mode (Fail, Contradicted, or Fresh && Flaky).
func ReportVerdictsFailed(rep VerdictReport, fresh bool) bool {
	for s in rep.Steps {
		let isFail = match s.Verdict {
		case Fail:
			true
		case Flaky:
			fresh
		case Pass, Unaffected:
			false
		}
		if isFail || s.Contradicted {
			return true
		}
	}
	false
}

// StepID returns the task-independent cache identifier for s ("Verb @ Member").
func StepID(s StepSpec) string { "\(s.Verb) @ \(s.Member)" }

func matchCharClass(pat string, pi int, ch byte) (int, bool, bool) {
	let n = pat.Len()
	let mut j = pi + 1
	let mut neg = false
	if j < n && pat[j] == '^' {
		neg = true
		j = j + 1
	}
	let mut matched = false
	let mut first = true
	for j < n {
		if pat[j] == ']' && !first {
			let hit = if neg { !matched } else { matched }
			return (j + 1, hit, true)
		}
		first = false
		let mut lo = pat[j]
		if lo == '\\' && j+1 < n {
			j = j + 1
			lo = pat[j]
		}
		j = j + 1
		if j+1 < n && pat[j] == '-' && pat[j+1] != ']' {
			j = j + 1
			let mut hi = pat[j]
			if hi == '\\' && j+1 < n {
				j = j + 1
				hi = pat[j]
			}
			j = j + 1
			if lo <= ch && ch <= hi {
				matched = true
			}
		} else if ch == lo {
			matched = true
		}
	}
	(pi, false, false)
}

func matchSegment(pat string, name string) (bool, bool) {
	let mut px = 0
	let mut nx = 0
	let mut starPx = -1
	let mut starNx = 0
	for nx < name.Len() {
		if px < pat.Len() && pat[px] == '*' {
			starPx = px
			starNx = nx
			px = px + 1
			continue
		}
		if px < pat.Len() && pat[px] == '?' {
			px = px + 1
			nx = nx + 1
			continue
		}
		if px < pat.Len() && pat[px] == '[' {
			let (nextPx, hit, valid) = matchCharClass(pat, px, name[nx])
			if !valid {
				return (false, false)
			}
			if hit {
				px = nextPx
				nx = nx + 1
				continue
			}
		} else if px < pat.Len() {
			let mut pc = pat[px]
			let mut step = 1
			if pc == '\\' {
				if px+1 >= pat.Len() {
					return (false, false)
				}
				pc = pat[px+1]
				step = 2
			}
			if pc == name[nx] {
				px = px + step
				nx = nx + 1
				continue
			}
		}
		if starPx >= 0 {
			starNx = starNx + 1
			nx = starNx
			px = starPx + 1
			continue
		}
		return (false, true)
	}
	for px < pat.Len() && pat[px] == '*' {
		px = px + 1
	}
	(px == pat.Len(), true)
}

func slashMatch(pat string, name string) bool {
	let pSegs = strings.Split(pat, "/")
	let nSegs = strings.Split(name, "/")
	if pSegs.Len() != nSegs.Len() {
		return false
	}
	for i in 0..pSegs.Len() {
		let (ok, valid) = matchSegment(pSegs[i], nSegs[i])
		if !valid || !ok {
			return false
		}
	}
	true
}

// Selected reports whether any step selection path matches or encloses any changed path,
// supporting "." wildcard, directory prefix matching, and glob patterns containing "*".
func Selected(paths []string, changed []string) bool {
	for p in paths {
		for c in changed {
			if p == "." || p == c || Under(c, p) {
				return true
			}
			if strings.Contains(p, "*") && slashMatch(p, c) {
				return true
			}
		}
	}
	false
}

// VerdictLastKey returns the lawcache key holding the last key parts run for s under root.
func VerdictLastKey(root string, s StepSpec) string {
	lawcache.Key([]string{"task verdict last", root, StepID(s)})
}

// VerdictKey returns the content-addressed lawcache key for s over k's ordered parts.
func VerdictKey(s StepSpec, k StepKey) string {
	let mut parts = slices.WithCapacity[string](2 + k.Parts.Len()*2)
	parts = parts.Append("task verdict/1")
	parts = parts.Append(StepID(s))
	for p in k.Parts {
		parts = parts.Append(p.Name)
		parts = parts.Append(p.Digest)
	}
	lawcache.Key(parts)
}

// EncodeParts serializes k's ordered key parts in ergo-verdict-last/1 format.
func EncodeParts(k StepKey) string {
	let mut b = strings.NewBuilder()
	b.WriteString("ergo-verdict-last/1\n")
	for p in k.Parts {
		b.WriteString("\(p.Digest) \(p.Name)\n")
	}
	b.String()
}

// VerdictWhy reports the first key part whose digest moved or changed presence since s's last run.
func VerdictWhy(store lawcache.Store, root string, s StepSpec, k StepKey) string {
	let text = match lawcache.Get(store, VerdictLastKey(root, s)) {
	case option.Some{Value: t}:
		t
	case option.None:
		return "no stored last run"
	}
	let prefix = "ergo-verdict-last/1\n"
	if !strings.HasPrefix(text, prefix) {
		return "no stored last run"
	}
	let body = strings.TrimSuffix(strings.TrimPrefix(text, prefix), "\n")
	let mut last = Map[string, string]{}
	let mut order = []string{}
	for l in strings.Split(body, "\n") {
		let (d, name) = match strings.Cut(l, " ") {
		case option.Some{Value: h}:
			(h.Before, h.After)
		case option.None:
			(l, "")
		}
		last[name] = d
		order = order.Append(name)
	}
	let mut now = Map[string, bool]{}
	for p in k.Parts {
		now[p.Name] = true
		match last.Get(p.Name) {
		case option.None:
			return "new input \(p.Name)"
		case option.Some{Value: d}:
			if d != p.Digest {
				return "input \(p.Name) changed"
			}
		}
	}
	for name in order {
		let stillPresent = match now.Get(name) {
		case option.Some{Value: v}:
			v
		case option.None:
			false
		}
		if !stillPresent {
			return "input \(name) is gone"
		}
	}
	"the last run did not pass"
}

// OnlyRunWrites reports whether now differs from was exclusively in parts listed in runWriteParts.
func OnlyRunWrites(was StepKey, now StepKey, runWriteParts []string) bool {
	if was.Parts.Len() != now.Parts.Len() {
		return false
	}
	let mut writeSet = Map[string, bool]{}
	for rw in runWriteParts {
		writeSet[rw] = true
	}
	let mut moved = false
	for i in 0..was.Parts.Len() {
		let p = was.Parts[i]
		let q = now.Parts[i]
		if p.Name != q.Name {
			return false
		}
		if p.Digest != q.Digest {
			let writable = match writeSet.Get(p.Name) {
			case option.Some{Value: v}:
				v
			case option.None:
				false
			}
			if !writable {
				return false
			}
			moved = true
		}
	}
	moved
}

// BlockedStep returns the failure message for the first prerequisite step index that failed
// (or was flaky under fresh), or "" if all prerequisites passed.
func BlockedStep(results []StepResult, indexes []uint32, fresh bool) string {
	for idx in indexes {
		let r = results[int(idx)]
		let failed = match r.Verdict {
		case Fail:
			true
		case Flaky:
			fresh
		case Pass, Unaffected:
			false
		}
		if failed || r.Contradicted {
			return "after \(r.Task): \(r.Step) at \(r.Member) did not pass"
		}
	}
	""
}

func isWordByte(ch byte) bool {
	(ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_'
}

func isSeedLetter(a byte, b byte) bool {
	a == b || (a >= 'A' && a <= 'Z' && byte(int(a)+32) == b)
}

// ExtractSeed extracts the numeric seed from test output matching `(?i)\bseed[ =:]+([0-9]+)`.
func ExtractSeed(logText string) string {
	let n = logText.Len()
	for i in 0..n {
		if i+5 >= n {
			break
		}
		if i > 0 && isWordByte(logText[i-1]) {
			continue
		}
		if !isSeedLetter(logText[i], 's') ||
			!isSeedLetter(logText[i+1], 'e') ||
			!isSeedLetter(logText[i+2], 'e') ||
			!isSeedLetter(logText[i+3], 'd') {
			continue
		}
		let mut p = i + 4
		let mut seps = 0
		for p < n && (logText[p] == ' ' || logText[p] == '=' || logText[p] == ':') {
			seps = seps + 1
			p = p + 1
		}
		if seps == 0 || p >= n {
			continue
		}
		let start = p
		for p < n && logText[p] >= '0' && logText[p] <= '9' {
			p = p + 1
		}
		if p > start {
			return logText[start:p]
		}
	}
	""
}

// SanitizeFileName replaces characters outside [A-Za-z0-9-.] with '_'.
func SanitizeFileName(s string) string {
	let mut out = s.Bytes()
	for i in 0..out.Len() {
		let c = out[i]
		let keep = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '.'
		if !keep {
			out[i] = byte('_')
		}
	}
	let mut b = strings.NewBuilder()
	b.WriteBytes(out)
	b.String()
}

func emptyStepKey() StepKey { StepKey{Parts: []KeyPart{}, Paths: []string{}} }

func runSingleVerdict(store lawcache.Store, root string, stepIdx int, s StepSpec, mode VerdictMode, host VerdictHost) (StepResult, StepKey, bool) fails TaskError {
	let mut res = StepResult{
		Task:         s.Task,
		Step:         s.Verb,
		Member:       s.Member,
		Verdict:      Fail,
		Replay:       "",
		Why:          "",
		Class:        s.Class,
		MsBits:       uint64(0),
		Log:          "",
		Seed:         "",
		Contradicted: false,
		BlockedBy:    "",
	}
	let mut stated = emptyStepKey()
	if s.HasKey {
		stated = try host.Key(stepIdx)
	}
	if mode.Affected {
		let paths = if host.HasCustomPaths(stepIdx) {
			try host.Paths(stepIdx)
		} else {
			stated.Paths
		}
		if !Selected(paths, mode.Changed) {
			res.Verdict = Unaffected
			return (res, emptyStepKey(), false)
		}
	}
	let mut content = ""
	let mut kept = false
	if s.HasKey {
		content = VerdictKey(s, stated)
		match lawcache.Get(store, content) {
		case option.Some{Value: text}:
			kept = true
			if !mode.Fresh {
				res.Verdict = Pass
				res.Replay = "hit"
				let trimmed = strings.TrimSuffix(text, "\n")
				res.Log = strings.TrimPrefix(trimmed, "pass ")
				return (res, emptyStepKey(), false)
			}
			res.Why = "--fresh"
		case option.None:
			kept = false
			res.Why = VerdictWhy(store, root, s, stated)
		}
	}
	res.Replay = "miss"
	let first = try host.Run(stepIdx)
	let mut pass = first.Pass
	let mut logText = first.LogText
	let mut totalMs = int64(first.MsBits)
	let mut gotFlaky = false
	if !pass && s.Retry {
		let second = try host.Run(stepIdx)
		pass = second.Pass
		logText = "\(logText)\n--- retry ---\n\(second.LogText)"
		totalMs = totalMs + int64(second.MsBits)
		if pass {
			gotFlaky = true
		}
	}
	res.MsBits = uint64(totalMs)
	res.Verdict = if gotFlaky {
		Flaky
	} else if pass {
		Pass
	} else {
		Fail
	}
	if !pass || gotFlaky {
		res.Seed = ExtractSeed(logText)
	}
	res.Log = host.WriteLog(stepIdx, content, logText)
	if s.HasKey {
		let postKey = try host.Key(stepIdx)
		stated = postKey
		content = VerdictKey(s, stated)
		lawcache.Put(store, VerdictLastKey(root, s), EncodeParts(stated))
	}
	let mut hasKeptKey = false
	match res.Verdict {
	case Pass:
		if s.HasKey {
			lawcache.Put(store, content, "pass \(res.Log)\n")
			hasKeptKey = true
		}
	case Flaky:
		host.NoteFlaky(res)
	case Fail, Unaffected:
		res.Contradicted = kept && mode.Fresh
	}
	(res, stated, hasKeptKey)
}

// RunVerdicts executes steps sequentially, deduplicating identical step IDs across tasks,
// enforcing prerequisite failure blocking, retrying flaky steps once, and settling runWriteParts.
func RunVerdicts(store lawcache.Store, root string, steps []StepSpec, mode VerdictMode, host VerdictHost, runWriteParts []string) VerdictReport fails TaskError {
	let mut results = slices.WithCapacity[StepResult](steps.Len())
	let mut keptSteps = []StepSpec{}
	let mut keptKeys = []StepKey{}
	let mut keptLogs = []string{}
	let mut done = Map[string, uint32]{}
	for i in 0..steps.Len() {
		let s = steps[i]
		let whyBlocked = BlockedStep(results, s.After, mode.Fresh)
		if whyBlocked != "" {
			results = results.Append(StepResult{
				Task:         s.Task,
				Step:         s.Verb,
				Member:       s.Member,
				Verdict:      Fail,
				Replay:       "",
				Why:          "",
				Class:        s.Class,
				MsBits:       uint64(0),
				Log:          "",
				Seed:         "",
				Contradicted: false,
				BlockedBy:    whyBlocked,
			})
			continue
		}
		let sid = StepID(s)
		match done.Get(sid) {
		case option.Some{Value: prevIdx}:
			let mut prev = results[int(prevIdx)]
			prev.Task = s.Task
			prev.MsBits = uint64(0)
			results = results.Append(prev)
			continue
		case option.None:
		}
		let (res, keptKey, hasKept) = runSingleVerdict(store, root, i, s, mode, host) catch {
		case TaskError as e:
			return TaskError{Reason: "\(s.Task) \(s.Verb) at \(s.Member): \(e.Reason)"}
		}
		if hasKept {
			keptSteps = keptSteps.Append(s)
			keptKeys = keptKeys.Append(keptKey)
			keptLogs = keptLogs.Append(res.Log)
		}
		done[sid] = uint32(results.Len())
		results = results.Append(res)
	}
	if runWriteParts.Len() > 0 {
		for ki in 0..keptSteps.Len() {
			let ks = keptSteps[ki]
			let mut stepIdx = -1
			for si in 0..steps.Len() {
				if StepID(steps[si]) == StepID(ks) {
					stepIdx = si
					break
				}
			}
			if stepIdx < 0 {
				continue
			}
			let nowKey = try host.Key(stepIdx)
			if !OnlyRunWrites(keptKeys[ki], nowKey, runWriteParts) {
				continue
			}
			lawcache.Put(store, VerdictKey(ks, nowKey), "pass \(keptLogs[ki])\n")
			lawcache.Put(store, VerdictLastKey(root, ks), EncodeParts(nowKey))
		}
	}
	VerdictReport{Steps: results}
}

// SelectedDotMatchesAnyChange checks that a step covering "." selects any non-empty changed path list.
law SelectedDotMatchesAnyChange(changed []string) {
	if changed.Len() == 0 {
		return !Selected([]string{"."}, changed)
	}
	Selected([]string{"."}, changed)
}

type fakeVerdictHost {
	store     lawcache.Store,
	runs      []bool,
	logs      []string,
	runCount  []int,
	digestVal []string,
} implements VerdictHost

func Key(h fakeVerdictHost, stepIdx int) StepKey fails TaskError {
	let dig = h.digestVal[0]
	StepKey{
		Parts: []KeyPart{KeyPart{Name: "src", Digest: dig}},
		Paths: []string{"pkg/*.ergo"},
	}
}

func Paths(h fakeVerdictHost, stepIdx int) []string fails TaskError { []string{} }
func HasCustomPaths(h fakeVerdictHost, stepIdx int) bool            { false }

func Run(h fakeVerdictHost, stepIdx int) StepRunOutcome fails TaskError {
	let idx = stepIdx
	let pass = if idx < h.runs.Len() { h.runs[idx] } else { true }
	let text = if idx < h.logs.Len() { h.logs[idx] } else { "" }
	StepRunOutcome{Pass: pass, LogText: text, MsBits: uint64(7)}
}

func WriteLog(h fakeVerdictHost, stepIdx int, contentKey string, logText string) string {
	"/logs/\(SanitizeFileName("step-\(stepIdx)")).log"
}

func NoteFlaky(h fakeVerdictHost, res StepResult) {}

test VerdictsSelectedSeedSanitizeAndReplay {
	assert Selected([]string{"compiler/*.ergo"}, []string{"compiler/foo.ergo"})
	assert !Selected([]string{"compiler/*.ergo"}, []string{"compiler/sub/foo.ergo"})
	assert Selected([]string{"compiler/sub"}, []string{"compiler/sub/foo.ergo"})
	assert ExtractSeed("FAIL law Foo (case 1, SEED: 4242, size 3)") == "4242"
	assert ExtractSeed("seedless text") == ""
	assert SanitizeFileName("fmt --check @ ./compiler") == "fmt_--check___._compiler"

	let store = lawcache.Memory(StoreIdentity)
	let steps = []StepSpec{
		StepSpec{Task: "t", Verb: "check", Member: "m", Class: Derived, HasKey: true, Retry: false, After: []uint32{}},
		StepSpec{Task: "t", Verb: "test", Member: "m", Class: Derived, HasKey: true, Retry: false, After: []uint32{uint32(0)}},
	}
	let h = fakeVerdictHost{
		store:     store,
		runs:      []bool{true, false},
		logs:      []string{"ok", "FAIL seed = 99"},
		runCount:  []int{},
		digestVal: []string{"d1"},
	}
	let rep1 = RunVerdicts(store, "/repo", steps, VerdictMode{Fresh: false, Changed: []string{}, Affected: false}, h, []string{}) catch {
	case TaskError as e:
		assert e.Reason == ""
		return
	}
	assert VerdictString(rep1.Steps[0].Verdict) == "pass" && rep1.Steps[0].Replay == "miss"
	assert VerdictString(rep1.Steps[1].Verdict) == "fail" && rep1.Steps[1].Seed == "99"
	assert ReportVerdictsFailed(rep1, false)

	let h2 = fakeVerdictHost{
		store:     store,
		runs:      []bool{false, true},
		logs:      []string{"should replay", "ok"},
		runCount:  []int{},
		digestVal: []string{"d1"},
	}
	let rep2 = RunVerdicts(store, "/repo", steps, VerdictMode{Fresh: false, Changed: []string{}, Affected: false}, h2, []string{}) catch {
	case TaskError as e:
		assert e.Reason == ""
		return
	}
	assert VerdictString(rep2.Steps[0].Verdict) == "pass" && rep2.Steps[0].Replay == "hit"
	assert VerdictString(rep2.Steps[1].Verdict) == "pass"
	assert !ReportVerdictsFailed(rep2, false)
}
