import compiler/lawcache
import option
import slices

// NodeSpec describes the static identity and provenance class of a task generator node.
type NodeSpec {
	// Name is the generator's declared name (or MEMBER:gen).
	Name string,
	// Class is Derived or Vouched.
	Class string,
	// Ident distinguishes declarations (command and reads) in the cache.
	Ident string,
}

// GenGraph stores the dependency edges, topological node order, and strongly connected
// cycles computed from stored generator runs in flat DoD SoA/CSR arrays.
type GenGraph {
	// Known reports whether each node index has a decoded last-run record in the store.
	Known []bool,
	// EdgeFrom lists source node indices of directed dependency edges (aligned with EdgeTo).
	EdgeFrom []uint32,
	// EdgeTo lists target node indices of directed dependency edges (aligned with EdgeFrom).
	EdgeTo []uint32,
	// Order holds node indices ordered topologically outside cycles, ties by declaration index.
	Order []uint32,
	// CycleStart holds the start offset inside CycleNodes for each multi-node cycle.
	CycleStart []uint32,
	// CycleLen holds the member count for each multi-node cycle aligned with CycleStart.
	CycleLen []uint32,
	// CycleNodes holds sorted node indices across all multi-node cycles in flat storage.
	CycleNodes []uint32,
}

// CycleCount returns the number of multi-node cycles in g.
func CycleCount(g GenGraph) int { g.CycleStart.Len() }

// CycleAt returns the node indices participating in cycle c in declaration order.
func CycleAt(g GenGraph, c int) []uint32 {
	let start = int(g.CycleStart[c])
	let n = int(g.CycleLen[c])
	slices.Clone(g.CycleNodes[start : start+n])
}

// EdgesOf computes sorted directed dependency edges (from, to) across nodes whose
// last-run records are known: a precedes b when a's output matches a file b read
// or lies inside a directory b listed.
func EdgesOf(known []bool, recs []TaskRecord) ([]uint32, []uint32) {
	let n = known.Len()
	let mut packed = []uint64{}
	for b in 0..n {
		if !known[b] {
			continue
		}
		let rb = recs[b]
		let mut files = Map[string, bool]{}
		for f in rb.In.Files {
			files[f] = true
		}
		let mut dirs = Map[string, bool]{}
		for d in rb.In.Dirs {
			dirs[d] = true
		}
		for a in 0..n {
			if a == b || !known[a] {
				continue
			}
			let ra = recs[a]
			let mut depends = false
			for o in ra.Outs {
				let inFile = match files.Get(o.Path) {
				case option.Some{Value: v}:
					v
				case option.None:
					false
				}
				let inDir = match dirs.Get(ParentDir(o.Path)) {
				case option.Some{Value: v}:
					v
				case option.None:
					false
				}
				if inFile || inDir {
					depends = true
					break
				}
			}
			if depends {
				packed = packed.Append((uint64(a) << 32) | uint64(b))
			}
		}
	}
	packed = slices.Sort(packed)
	let mut from = slices.WithCapacity[uint32](packed.Len())
	let mut to = slices.WithCapacity[uint32](packed.Len())
	for p in packed {
		from = from.Append(uint32(p >> 32))
		to = to.Append(uint32(p & uint64(0xffffffff)))
	}
	(from, to)
}

type tarjanState {
	head      []uint32,
	count     []uint32,
	adj       []uint32,
	index     []int,
	low       []int,
	onStack   []bool,
	comp      []uint32,
	stack     []uint32,
	counter   int,
	partStart []uint32,
	partLen   []uint32,
	partNodes []uint32,
}

func tarjanVisit(t mut tarjanState, v uint32) {
	let vi = int(v)
	t.index[vi] = t.counter
	t.low[vi] = t.counter
	t.counter = t.counter + 1
	t.stack = t.stack.Append(v)
	t.onStack[vi] = true

	let start = int(t.head[vi])
	let end = start + int(t.count[vi])
	for ei in start..end {
		let w = t.adj[ei]
		let wi = int(w)
		if t.index[wi] < 0 {
			tarjanVisit(t, w)
			if t.low[wi] < t.low[vi] {
				t.low[vi] = t.low[wi]
			}
		} else if t.onStack[wi] {
			if t.index[wi] < t.low[vi] {
				t.low[vi] = t.index[wi]
			}
		}
	}

	if t.low[vi] == t.index[vi] {
		let cid = uint32(t.partStart.Len())
		let mut part = []uint32{}
		for t.stack.Len() > 0 {
			let w = t.stack[t.stack.Len()-1]
			t.stack = t.stack[0 : t.stack.Len()-1]
			let wi = int(w)
			t.onStack[wi] = false
			t.comp[wi] = cid
			part = part.Append(w)
			if w == v {
				break
			}
		}
		part = slices.Sort(part)
		t.partStart = t.partStart.Append(uint32(t.partNodes.Len()))
		t.partLen = t.partLen.Append(uint32(part.Len()))
		t.partNodes = slices.AppendAll(t.partNodes, part)
	}
}

func buildAdjCSR(n int, from []uint32, to []uint32) ([]uint32, []uint32, []uint32) {
	let mut count = slices.WithCapacity[uint32](n)
	let mut head = slices.WithCapacity[uint32](n)
	let mut cursor = slices.WithCapacity[uint32](n)
	for _ in 0..n {
		count = count.Append(uint32(0))
		head = head.Append(uint32(0))
		cursor = cursor.Append(uint32(0))
	}
	for f in from {
		count[int(f)] = count[int(f)] + uint32(1)
	}
	let mut off = uint32(0)
	for i in 0..n {
		head[i] = off
		cursor[i] = off
		off = off + count[i]
	}
	let mut adj = slices.WithCapacity[uint32](to.Len())
	for _ in 0..to.Len() {
		adj = adj.Append(uint32(0))
	}
	for i in 0..from.Len() {
		let fi = int(from[i])
		adj[int(cursor[fi])] = to[i]
		cursor[fi] = cursor[fi] + uint32(1)
	}
	(head, count, adj)
}

// OrderOf runs Tarjan's SCC decomposition and Kahn's topological sort breaking ready
// ties by earliest declaration index, returning (Order, CycleStart, CycleLen, CycleNodes).
func OrderOf(nodeCount int, edgeFrom []uint32, edgeTo []uint32) ([]uint32, []uint32, []uint32, []uint32) {
	let (head, count, adj) = buildAdjCSR(nodeCount, edgeFrom, edgeTo)
	let mut idxArr = slices.WithCapacity[int](nodeCount)
	let mut lowArr = slices.WithCapacity[int](nodeCount)
	let mut onStk = slices.WithCapacity[bool](nodeCount)
	let mut compArr = slices.WithCapacity[uint32](nodeCount)
	for _ in 0..nodeCount {
		idxArr = idxArr.Append(-1)
		lowArr = lowArr.Append(0)
		onStk = onStk.Append(false)
		compArr = compArr.Append(uint32(0))
	}
	let mut ts = tarjanState{
		head:      head,
		count:     count,
		adj:       adj,
		index:     idxArr,
		low:       lowArr,
		onStack:   onStk,
		comp:      compArr,
		stack:     []uint32{},
		counter:   0,
		partStart: []uint32{},
		partLen:   []uint32{},
		partNodes: []uint32{},
	}
	for i in 0..nodeCount {
		if ts.index[i] < 0 {
			tarjanVisit(&ts, uint32(i))
		}
	}
	let nParts = ts.partStart.Len()
	let mut compPairs = []uint64{}
	for i in 0..edgeFrom.Len() {
		let a = ts.comp[int(edgeFrom[i])]
		let b = ts.comp[int(edgeTo[i])]
		if a != b {
			compPairs = compPairs.Append((uint64(a) << 32) | uint64(b))
		}
	}
	compPairs = slices.Sort(compPairs)
	let mut pFrom = []uint32{}
	let mut pTo = []uint32{}
	let mut indeg = slices.WithCapacity[uint32](nParts)
	for _ in 0..nParts {
		indeg = indeg.Append(uint32(0))
	}
	let mut prevPair = uint64(0)
	let mut hasPrev = false
	for pair in compPairs {
		if hasPrev && pair == prevPair {
			continue
		}
		hasPrev = true
		prevPair = pair
		let a = uint32(pair >> 32)
		let b = uint32(pair & uint64(0xffffffff))
		pFrom = pFrom.Append(a)
		pTo = pTo.Append(b)
		indeg[int(b)] = indeg[int(b)] + uint32(1)
	}
	let (pHead, pCount, pAdj) = buildAdjCSR(nParts, pFrom, pTo)
	let mut ready = []uint32{}
	for p in 0..nParts {
		if indeg[p] == uint32(0) {
			ready = ready.Append(uint32(p))
		}
	}
	let mut order = slices.WithCapacity[uint32](nodeCount)
	let mut cycleStart = []uint32{}
	let mut cycleLen = []uint32{}
	let mut cycleNodes = []uint32{}
	for ready.Len() > 0 {
		ready = slices.SortFunc(ready, func(x uint32, y uint32) int {
			let nx = ts.partNodes[int(ts.partStart[int(x)])]
			let ny = ts.partNodes[int(ts.partStart[int(y)])]
			if nx < ny {
				return -1
			}
			if nx > ny {
				return 1
			}
			0
		})
		let p = ready[0]
		ready = ready[1:ready.Len()]
		let pOff = int(ts.partStart[int(p)])
		let pN = int(ts.partLen[int(p)])
		let sliceNodes = ts.partNodes[pOff : pOff+pN]
		order = slices.AppendAll(order, sliceNodes)
		if pN > 1 {
			cycleStart = cycleStart.Append(uint32(cycleNodes.Len()))
			cycleLen = cycleLen.Append(uint32(pN))
			cycleNodes = slices.AppendAll(cycleNodes, sliceNodes)
		}
		let start = int(pHead[int(p)])
		let end = start + int(pCount[int(p)])
		for ei in start..end {
			let q = int(pAdj[ei])
			indeg[q] = indeg[q] - uint32(1)
			if indeg[q] == uint32(0) {
				ready = ready.Append(uint32(q))
			}
		}
	}
	(order, cycleStart, cycleLen, cycleNodes)
}

func emptyRecord() TaskRecord {
	TaskRecord{
		Env:      "",
		In:       Inputs{Files: []string{}, Dirs: []string{}},
		FileSums: []string{},
		DirSums:  []string{},
		Outs:     []OutputEntry{},
	}
}

// BuildGenGraph reads last-run records from store for nodes in root and computes GenGraph.
func BuildGenGraph(nodes []NodeSpec, root string, store lawcache.Store) GenGraph {
	let n = nodes.Len()
	let mut known = slices.WithCapacity[bool](n)
	let mut recs = slices.WithCapacity[TaskRecord](n)
	for node in nodes {
		let k = LastKey(root, node.Name, node.Ident)
		match lawcache.Get(store, k) {
		case option.Some{Value: text}:
			let (rec, ok) = DecodeRecord(text)
			if ok {
				known = known.Append(true)
				recs = recs.Append(rec)
			} else {
				known = known.Append(false)
				recs = recs.Append(emptyRecord())
			}
		case option.None:
			known = known.Append(false)
			recs = recs.Append(emptyRecord())
		}
	}
	let (edgeFrom, edgeTo) = EdgesOf(known, recs)
	let (order, cStart, cLen, cNodes) = OrderOf(n, edgeFrom, edgeTo)
	GenGraph{
		Known:      known,
		EdgeFrom:   edgeFrom,
		EdgeTo:     edgeTo,
		Order:      order,
		CycleStart: cStart,
		CycleLen:   cLen,
		CycleNodes: cNodes,
	}
}

// LastOutputs returns the output paths of node's stored last run, or empty if absent.
func LastOutputs(store lawcache.Store, root string, node NodeSpec) []string {
	match lawcache.Get(store, LastKey(root, node.Name, node.Ident)) {
	case option.Some{Value: text}:
		let (rec, ok) = DecodeRecord(text)
		if !ok {
			return []string{}
		}
		let mut out = slices.WithCapacity[string](rec.Outs.Len())
		for o in rec.Outs {
			out = out.Append(o.Path)
		}
		out
	case option.None:
		[]string{}
	}
}

// LastInputs returns the inputs of node's stored last run and whether a valid record was found.
func LastInputs(store lawcache.Store, root string, node NodeSpec) (Inputs, bool) {
	match lawcache.Get(store, LastKey(root, node.Name, node.Ident)) {
	case option.Some{Value: text}:
		let (rec, ok) = DecodeRecord(text)
		(rec.In, ok)
	case option.None:
		(Inputs{Files: []string{}, Dirs: []string{}}, false)
	}
}

// OrderOfCoversAllNodes checks that OrderOf outputs a permutation of 0..n without cycles
// when ordering any chain or DAG.
law OrderOfCoversAllNodes(count int) {
	let n = if count < 0 { 0 } else if count > 8 { 8 } else { count }
	let mut eFrom = []uint32{}
	let mut eTo = []uint32{}
	for i in 1..n {
		eFrom = eFrom.Append(uint32(i))
		eTo = eTo.Append(uint32(i - 1))
	}
	let (order, cStart, _, _) = OrderOf(n, eFrom, eTo)
	let mut seen = slices.WithCapacity[bool](n)
	for _ in 0..n {
		seen = seen.Append(false)
	}
	for idx in order {
		seen[int(idx)] = true
	}
	let mut allSeen = true
	for ok in seen {
		if !ok {
			allSeen = false
		}
	}
	order.Len() == n && cStart.Len() == 0 && allSeen
}

test GraphDetectsEdgesCyclesAndDeclarationTieBreaking {
	let store = lawcache.Memory(StoreIdentity)
	let n0 = NodeSpec{Name: "consumer", Class: Derived, Ident: "go run ./c"}
	let n1 = NodeSpec{Name: "producer", Class: Derived, Ident: "go run ./p"}
	let n2 = NodeSpec{Name: "cycleB", Class: Derived, Ident: "go run ./b"}
	let n3 = NodeSpec{Name: "cycleA", Class: Derived, Ident: "go run ./a"}

	let r0 = TaskRecord{
		Env:      "E",
		In:       Inputs{Files: []string{"gen/out.go"}, Dirs: []string{}},
		FileSums: []string{"h1"},
		DirSums:  []string{},
		Outs:     []OutputEntry{OutputEntry{Path: "c/res.go", Digest: "hc"}},
	}
	let r1 = TaskRecord{
		Env:      "E",
		In:       Inputs{Files: []string{"src.ergo"}, Dirs: []string{}},
		FileSums: []string{"hs"},
		DirSums:  []string{},
		Outs:     []OutputEntry{OutputEntry{Path: "gen/out.go", Digest: "h1"}},
	}
	let r2 = TaskRecord{
		Env:      "E",
		In:       Inputs{Files: []string{"a.out"}, Dirs: []string{}},
		FileSums: []string{"ha"},
		DirSums:  []string{},
		Outs:     []OutputEntry{OutputEntry{Path: "b.out", Digest: "hb"}},
	}
	let r3 = TaskRecord{
		Env:      "E",
		In:       Inputs{Files: []string{"b.out"}, Dirs: []string{}},
		FileSums: []string{"hb"},
		DirSums:  []string{},
		Outs:     []OutputEntry{OutputEntry{Path: "a.out", Digest: "ha"}},
	}
	lawcache.Put(store, LastKey("/repo", n0.Name, n0.Ident), EncodeRecord(r0))
	lawcache.Put(store, LastKey("/repo", n1.Name, n1.Ident), EncodeRecord(r1))
	lawcache.Put(store, LastKey("/repo", n2.Name, n2.Ident), EncodeRecord(r2))
	lawcache.Put(store, LastKey("/repo", n3.Name, n3.Ident), EncodeRecord(r3))

	let g = BuildGenGraph([]NodeSpec{n0, n1, n2, n3}, "/repo", store)
	assert g.Known == []bool{true, true, true, true}
	assert g.Order == []uint32{uint32(1), uint32(0), uint32(2), uint32(3)}
	assert CycleCount(g) == 1
	assert CycleAt(g, 0) == []uint32{uint32(2), uint32(3)}
	assert LastOutputs(store, "/repo", n0) == []string{"c/res.go"}
	let (li, ok) = LastInputs(store, "/repo", n1)
	assert ok && li.Files == []string{"src.ergo"}
}
