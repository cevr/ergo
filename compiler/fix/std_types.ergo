import compiler/check/bind
import compiler/check/store
import compiler/syntax
import dense
import option
import slices
import strings

// StdMapping maps an unqualified prelude identifier to its std package and exported symbol.
type StdMapping {
	Name   string,
	Pkg    string,
	Target string,
}

// QualifiedRewrite records one unqualified symbol rewrite to a std-qualified target.
type QualifiedRewrite {
	File   string,
	Line   int,
	Column int,
	Before string,
	After  string,
}

// PackageSource represents a file path and source text within a package fix run.
type PackageSource {
	Path string,
	Src  string,
}

// QualifiedPackageResult holds updated sources and rewrite records from a package pass.
type QualifiedPackageResult {
	Files    []PackageSource,
	Rewrites []QualifiedRewrite,
}

// StdTypesCatalog returns the Unit-8 prelude type mappings across core, codec, fstest, io, maps, os, rand, task, time, and cmp.
func StdTypesCatalog() []StdMapping {
	[]StdMapping{
		StdMapping{Name: "Hashing", Pkg: "maps", Target: "Hashing"},
		StdMapping{Name: "Structural", Pkg: "maps", Target: "Structural"},
		StdMapping{Name: "Task", Pkg: "task", Target: "Task"},
		StdMapping{Name: "ordered", Pkg: "cmp", Target: "Ordered"},
		StdMapping{Name: "number", Pkg: "cmp", Target: "Number"},
		StdMapping{Name: "Ambient", Pkg: "os", Target: "Ambient"},
		StdMapping{Name: "TestAmbient", Pkg: "fstest", Target: "TestAmbient"},
		StdMapping{Name: "TestDirectory", Pkg: "fstest", Target: "TestDirectory"},
		StdMapping{Name: "TestLoopback", Pkg: "fstest", Target: "TestLoopback"},
		StdMapping{Name: "Random", Pkg: "rand", Target: "Random"},
		StdMapping{Name: "Scheduler", Pkg: "time", Target: "Scheduler"},
		StdMapping{Name: "AlarmClock", Pkg: "time", Target: "AlarmClock"},
		StdMapping{Name: "LiveScheduler", Pkg: "time", Target: "LiveScheduler"},
		StdMapping{Name: "Writer", Pkg: "codec", Target: "Writer"},
		StdMapping{Name: "Reader", Pkg: "codec", Target: "Reader"},
		StdMapping{Name: "WireWrongKind", Pkg: "codec", Target: "WireWrongKind"},
		StdMapping{Name: "WireNull", Pkg: "codec", Target: "WireNull"},
		StdMapping{Name: "WireBool", Pkg: "codec", Target: "WireBool"},
		StdMapping{Name: "WireNumber", Pkg: "codec", Target: "WireNumber"},
		StdMapping{Name: "WireString", Pkg: "codec", Target: "WireString"},
		StdMapping{Name: "WireList", Pkg: "codec", Target: "WireList"},
		StdMapping{Name: "WireObject", Pkg: "codec", Target: "WireObject"},
		StdMapping{Name: "WireEnd", Pkg: "codec", Target: "WireEnd"},
		StdMapping{Name: "WireKind", Pkg: "codec", Target: "WireKind"},
		StdMapping{Name: "WireMissingField", Pkg: "codec", Target: "WireMissingField"},
		StdMapping{Name: "WireUnknownTag", Pkg: "codec", Target: "WireUnknownTag"},
		StdMapping{Name: "WireOmittable", Pkg: "codec", Target: "WireOmittable"},
		StdMapping{Name: "WireNullable", Pkg: "codec", Target: "WireNullable"},
		StdMapping{Name: "WireBare", Pkg: "codec", Target: "WireBare"},
