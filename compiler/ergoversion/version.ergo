import option
import strings
import time

// Devel is the version reported when the binary was built without release or
// VCS metadata.
let Devel string = "devel"

// Cgo is the environment assignment recorded alongside release installs.
let Cgo string = "CGO_ENABLED=0"

// BuildSetting is one key-value setting from Go build metadata.
type BuildSetting {
	Key   string,
	Value string,
}

// BuildInfo holds the subset of runtime build metadata used to derive the
// compiler version string.
type BuildInfo {
	MainVersion string,
	Settings    []BuildSetting,
}

// InstallCommand formats the go install invocation for a release version.
func InstallCommand(version string) string {
	Cgo + " go install github.com/cevr/ergo/cmd/ergo@" + version
}

// Of derives the canonical Ergo semantic version from build metadata, falling
// back to Devel when the metadata is incomplete or invalid.
func Of(info BuildInfo) string {
	if info.MainVersion != "" && info.MainVersion != "(devel)" && Valid(info.MainVersion) == "" {
		return info.MainVersion
	}
	let mut rev = ""
	let mut when = ""
	let mut modified = ""
	for _, s in info.Settings {
		match s.Key {
		case "vcs.revision":
			rev = s.Value
		case "vcs.time":
			when = s.Value
		case "vcs.modified":
			modified = s.Value
		case _:
		}
	}
	if rev.Len() < 12 {
		return Devel
	}
	let at = time.Parse(time.RFC3339, when) catch {
	case _:
		return Devel
	}
	let stamp = time.Format(at, time.Custom{Text: "20060102150405"})
	let dirty = if modified == "true" { "+dirty" } else { "" }
	let v = "v0.0.0-" + stamp + "-" + strings.Slice(rev, 0, 12) + dirty
	if Valid(v) != "" {
		return Devel
	}
	v
}

// Valid reports why v is not a semantic version with a leading v, or returns ""
// when v is valid.
func Valid(v string) string {
	if !strings.HasPrefix(v, "v") {
		return "it does not start with v"
	}
	let rest = strings.TrimPrefix(v, "v")
	let mut beforeBuild = rest
	let mut build = ""
	let mut hasBuild = false
	match strings.Cut(rest, "+") {
	case option.Some{Value: h}:
		beforeBuild = h.Before
		build = h.After
		hasBuild = true
	case option.None:
	}
	let mut core = beforeBuild
	let mut pre = ""
	let mut hasPre = false
	match strings.Cut(beforeBuild, "-") {
	case option.Some{Value: h}:
		core = h.Before
		pre = h.After
		hasPre = true
	case option.None:
	}
	let parts = strings.Split(core, ".")
	if parts.Len() != 3 {
		return "it is not vMAJOR.MINOR.PATCH"
	}
	for _, p in parts {
		if !isNumeral(p) {
			return "its numbers are not decimal numbers without leading zeros"
		}
	}
	if hasPre && !validIdentifiers(pre, true) {
		return "its pre-release is not dot-separated identifiers of letters, digits and -"
	}
	if hasBuild && !validIdentifiers(build, false) {
		return "its build metadata is not dot-separated identifiers of letters, digits and -"
	}
	""
}

// Compare orders two semantic versions, ignoring build metadata and treating a
// release without pre-release identifiers as newer than one with them.
func Compare(a string, b string) int {
	let at = stripBuild(strings.TrimPrefix(a, "v"))
	let bt = stripBuild(strings.TrimPrefix(b, "v"))
	let (ac, apre, aHas) = splitPre(at)
	let (bc, bpre, bHas) = splitPre(bt)
	let an = strings.Split(ac, ".")
	let bn = strings.Split(bc, ".")
	let maxCore = if an.Len() > bn.Len() { an.Len() } else { bn.Len() }
	for i in 0..maxCore {
		let x = if i < an.Len() { an[i] } else { "0" }
		let y = if i < bn.Len() { bn[i] } else { "0" }
		let c = compareNumbers(x, y)
		if c != 0 {
			return c
		}
	}
	if !aHas && !bHas {
		return 0
	}
	if !aHas {
		return 1
	}
	if !bHas {
		return -1
	}
	let ap = strings.Split(apre, ".")
	let bp = strings.Split(bpre, ".")
	let minPre = if ap.Len() < bp.Len() { ap.Len() } else { bp.Len() }
	for i in 0..minPre {
		let x = ap[i]
		let y = bp[i]
		let xNum = fitsUint64Digits(x)
		let yNum = fitsUint64Digits(y)
		if xNum && yNum {
			let c = compareNumbers(x, y)
			if c != 0 {
				return c
			}
		} else if xNum {
			return -1
		} else if yNum {
			return 1
		} else {
			let c = compareStrings(x, y)
			if c != 0 {
				return c
			}
		}
	}
	ap.Len() - bp.Len()
}

// Satisfies reports whether binary is a valid non-devel version greater than or
// equal to required.
func Satisfies(binary string, required string) bool {
	if binary == Devel || Valid(binary) != "" || Valid(required) != "" {
		return false
	}
	Compare(binary, required) >= 0
}

func isNumeral(s string) bool {
	let b = s.Bytes()
	if b.Len() == 0 {
		return false
	}
	if b.Len() > 1 && b[0] == '0' {
		return false
	}
	for _, c in b {
		if c < '0' || c > '9' {
			return false
		}
	}
	true
}

func validIdentifiers(s string, pre bool) bool {
	let parts = strings.Split(s, ".")
	for _, part in parts {
		let b = part.Bytes()
		if b.Len() == 0 {
			return false
		}
		let mut allDigits = true
		for _, c in b {
			let isDigit = c >= '0' && c <= '9'
			let isLower = c >= 'a' && c <= 'z'
			let isUpper = c >= 'A' && c <= 'Z'
			if !isDigit && !isLower && !isUpper && c != '-' {
				return false
			}
			if !isDigit {
				allDigits = false
			}
		}
		if pre && allDigits && b.Len() > 1 && b[0] == '0' {
			return false
		}
	}
	true
}

func stripBuild(s string) string {
	match strings.Cut(s, "+") {
	case option.Some{Value: h}:
		h.Before
	case option.None:
		s
	}
}

func splitPre(s string) (string, string, bool) {
	match strings.Cut(s, "-") {
	case option.Some{Value: h}:
		(h.Before, h.After, true)
	case option.None:
		(s, "", false)
	}
}

func compareNumbers(x string, y string) int {
	let ax = strings.TrimLeft(x, "0")
	let ay = strings.TrimLeft(y, "0")
	if ax.Len() != ay.Len() {
		return if ax.Len() < ay.Len() { -1 } else { 1 }
	}
	compareStrings(ax, ay)
}

func compareStrings(a string, b string) int {
	if a < b {
		return -1
	}
	if a > b {
		return 1
	}
	0
}

func fitsUint64Digits(s string) bool {
	let b = s.Bytes()
	if b.Len() == 0 || b.Len() > 20 {
		return false
	}
	for _, c in b {
		if c < '0' || c > '9' {
			return false
		}
	}
	if b.Len() < 20 {
		return true
	}
	s <= "18446744073709551615"
}

law ValidAcceptsVCS(dirty bool) {
	let mod = if dirty { "true" } else { "false" }
	let v = Of(BuildInfo{
		MainVersion: "",
		Settings:    []BuildSetting{
			BuildSetting{Key: "vcs.revision", Value: "abcdef1234567890"},
			BuildSetting{Key: "vcs.time", Value: "2026-04-02T14:05:06Z"},
			BuildSetting{Key: "vcs.modified", Value: mod},
		},
	})
	v != Devel && Valid(v) == ""
}

law CompareReflexive(major int, minor int, patch int) {
	if major < 0 || minor < 0 || patch < 0 {
		return true
	}
	let v = "v" + itoa(major) + "." + itoa(minor) + "." + itoa(patch)
	Compare(v, v) == 0
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	let digits = "0123456789".Bytes()
	let mut v = n
	let mut rev = []byte{}
	for v > 0 {
		rev = rev.Append(digits[v%10])
		v = v / 10
	}
	let mut out = []byte{}
	let mut i = rev.Len() - 1
	for i >= 0 {
		out = out.Append(rev[i])
		i = i - 1
	}
	out.Text()
}

test OfFormatsVCSAndMainVersion {
	let rel = Of(BuildInfo{MainVersion: "v1.2.3-rc.1+build.01", Settings: []BuildSetting{}})
	assert rel == "v1.2.3-rc.1+build.01"
	let vcs = Of(BuildInfo{
		MainVersion: "(devel)",
		Settings:    []BuildSetting{
			BuildSetting{Key: "vcs.revision", Value: "0123456789abcdef"},
			BuildSetting{Key: "vcs.time", Value: "2026-04-02T16:05:06+02:00"},
			BuildSetting{Key: "vcs.modified", Value: "true"},
		},
	})
	assert vcs == "v0.0.0-20260402140506-0123456789ab+dirty"
	let shortRev = Of(BuildInfo{
		MainVersion: "",
		Settings:    []BuildSetting{
			BuildSetting{Key: "vcs.revision", Value: "0123456789a"},
			BuildSetting{Key: "vcs.time", Value: "2026-04-02T14:05:06Z"},
		},
	})
	assert shortRev == Devel
	assert InstallCommand("v1.2.3") == "CGO_ENABLED=0 go install github.com/cevr/ergo/cmd/ergo@v1.2.3"
}

test ValidAndCompareFollowSemver {
	assert Valid("v1.0.0") == ""
	assert Valid("v0.0.0-alpha.01a+01") == ""
	assert Valid("1.0.0") == "it does not start with v"
	assert Valid("v1.0") == "it is not vMAJOR.MINOR.PATCH"
	assert Valid("v01.0.0") == "its numbers are not decimal numbers without leading zeros"
	assert Valid("v1.0.0-01") == "its pre-release is not dot-separated identifiers of letters, digits and -"
	assert Valid("v1.0.0+bad_char") == "its build metadata is not dot-separated identifiers of letters, digits and -"
	assert Compare("v1.0.0-alpha", "v1.0.0") < 0
	assert Compare("v1.0.0", "v1.0.0-alpha") > 0
	assert Compare("v1.0.0+build1", "v1.0.0+build2") == 0
	assert Compare("v1.0.0-1", "v1.0.0-beta") < 0
	assert Compare("v1.0.0-alpha", "v1.0.0-alpha.1") < 0
	assert Satisfies("v1.2.0", "v1.2.0-rc.1")
	assert !Satisfies(Devel, "v1.0.0")
}
