import cmp
import dense
import hex
import sha1
import sha256
import slices

// MachoMagic64 identifies a thin 64-bit little-endian Mach-O header.
let MachoMagic64 = uint32(0xfeedfacf)

// FatMagic identifies a 32-bit universal Mach-O header.
let FatMagic = uint32(0xcafebabe)

// FatMagic64 identifies a 64-bit universal Mach-O header.
let FatMagic64 = uint32(0xcafebabf)

// LCCodeSignature is Mach-O LC_CODE_SIGNATURE load command tag.
let LCCodeSignature = uint32(0x1d)

// CSMagicEmbedded identifies an embedded CodeSignature SuperBlob.
let CSMagicEmbedded = uint32(0xfade0cc0)

// CSMagicCodeDirectory identifies a CodeDirectory blob inside SuperBlob.
let CSMagicCodeDirectory = uint32(0xfade0c02)

// CSSlotCodeDirectory is the primary CodeDirectory slot index.
let CSSlotCodeDirectory = uint32(0)

// CSSlotAlternateFirst is the first alternate CodeDirectory slot index.
let CSSlotAlternateFirst = uint32(0x1000)

// CSSlotAlternateLast is the last alternate CodeDirectory slot index.
let CSSlotAlternateLast = uint32(0x1004)

// CSCodeDirectoryHeader is the minimum header byte length of a CodeDirectory blob.
let CSCodeDirectoryHeader = uint64(44)

// CSVersionScatter is the CodeDirectory version introducing scatter offset field.
let CSVersionScatter = uint32(0x20100)

// CSVersionCodeLimit64 is the CodeDirectory version introducing 64-bit codeLimit.
let CSVersionCodeLimit64 = uint32(0x20300)

// CDHashSize is the 20-byte truncated code directory hash length.
let CDHashSize = 20

// CSHashTypeSHA256 identifies SHA-256 page hashes in CodeDirectory byte 37.
let CSHashTypeSHA256 = uint8(2)

// VerifyErrUnverified names unverified or malformed Mach-O code signatures.
let VerifyErrUnverified = "unverified"

// VerifyErrUniversal names refused universal Mach-O fat binaries.
let VerifyErrUniversal = "universal"

// VerifyErrWeakDirectory names CodeDirectory blobs lacking full SHA-256 page hashes.
let VerifyErrWeakDirectory = "weak-directory"

// VerifyError reports why a Mach-O code signature verification failed.
type VerifyError {
	Kind string,
}

// DirectoryTag identifies a parsed CodeDirectory blob slot inside DirectoryTable.
type DirectoryTag {}

// DirectoryTable stores parsed SuperBlob CodeDirectory slots in dense SoA columns.
type DirectoryTable {
	Count  dense.Count[DirectoryTag],
	Slot   dense.Col[DirectoryTag, uint32],
	Offset dense.Col[DirectoryTag, uint32],
	Length dense.Col[DirectoryTag, uint32],
}

// NewDirectoryTable constructs an empty SoA DirectoryTable.
func NewDirectoryTable() DirectoryTable {
	DirectoryTable{
		Count:  dense.NewCount[DirectoryTag](),
		Slot:   dense.NewCol[DirectoryTag, uint32](),
		Offset: dense.NewCol[DirectoryTag, uint32](),
		Length: dense.NewCol[DirectoryTag, uint32](),
	}
}

// VerifyCodeSignature verifies a thin 64-bit Mach-O image against cdhash and returns authenticated code bytes.
func VerifyCodeSignature(image []byte, cdhash []byte) []byte fails VerifyError {
	if image.Len() >= 4 {
		let magic = readU32BE(image, 0)
		if magic == FatMagic || magic == FatMagic64 {
			return VerifyError{Kind: VerifyErrUniversal}
		}
	}
	if cdhash.Len() != CDHashSize || image.Len() < 32 || readU32LE(image, 0) != MachoMagic64 {
		return VerifyError{Kind: VerifyErrUnverified}
	}
	let (sigStart, sigLen, codeEnd, okSig) = locateCodeSignature(image)
	if !okSig {
		return VerifyError{Kind: VerifyErrUnverified}
	}
	let sig = image[sigStart : sigStart+sigLen]
	let dirs = parseCodeDirectories(sig)
	let mut weak = false
	for d in dirs {
		let (sum, okSum) = directoryHash(d)
		if !okSum || sum.Len() < CDHashSize || !bytesEqual(sum[0:CDHashSize], cdhash) {
			continue
		}
		if d[37] != CSHashTypeSHA256 || d[36] != uint8(32) {
			weak = true
			continue
		}
		if pagesMatch(image, d, codeEnd) {
			return image[0:int(codeEnd)]
		}
	}
	if weak {
		return VerifyError{Kind: VerifyErrWeakDirectory}
	}
	VerifyError{Kind: VerifyErrUnverified}
}

func locateCodeSignature(image []byte) (int, int, uint64, bool) {
	let commands = readU32LE(image, 16)
	let size = uint64(readU32LE(image, 20))
	if uint64(32)+size > uint64(image.Len()) {
		return (0, 0, uint64(0), false)
	}
	let mut off = 32
	let limit = 32 + int(size)
	for _ in uint32(0)..commands {
		if off+8 > limit {
			return (0, 0, uint64(0), false)
		}
		let cmd = readU32LE(image, off)
		let length = int(readU32LE(image, off+4))
		if length < 8 || off+length > limit {
			return (0, 0, uint64(0), false)
		}
		if cmd == LCCodeSignature {
			if length < 16 {
				return (0, 0, uint64(0), false)
			}
			let sigOff = uint64(readU32LE(image, off+8))
			let sigSize = uint64(readU32LE(image, off+12))
			if sigOff+sigSize > uint64(image.Len()) {
				return (0, 0, uint64(0), false)
			}
			return (int(sigOff), int(sigSize), sigOff, true)
		}
		off = off + length
	}
	(0, 0, uint64(0), false)
}

func parseCodeDirectories(signature []byte) [][]byte {
	if signature.Len() < 12 || readU32BE(signature, 0) != CSMagicEmbedded {
		return [][]byte{}
	}
	let length = uint64(readU32BE(signature, 4))
	let count = uint64(readU32BE(signature, 8))
	if length > uint64(signature.Len()) || uint64(12)+count*uint64(8) > length {
		return [][]byte{}
	}
	let mut tbl = NewDirectoryTable()
	let mut seen = []bool{false, false, false, false, false, false}
	for i in uint64(0)..count {
		let entryOff = 12 + int(i)*8
		let slot = readU32BE(signature, entryOff)
		let offset = uint64(readU32BE(signature, entryOff+4))
		let idx = if slot == CSSlotCodeDirectory {
			0
		} else if slot >= CSSlotAlternateFirst && slot <= CSSlotAlternateLast {
			int(uint32(1) + slot - CSSlotAlternateFirst)
		} else {
			-1
		}
		if idx < 0 {
			continue
		}
		if seen[idx] {
			return [][]byte{}
		}
		seen[idx] = true
		if offset+uint64(8) > length || readU32BE(signature, int(offset)) != CSMagicCodeDirectory {
			continue
		}
		let size = uint64(readU32BE(signature, int(offset)+4))
		if size < CSCodeDirectoryHeader || offset+size > length {
			continue
		}
		let _ = dense.Next(&tbl.Count)
		dense.Push(&tbl.Slot, slot)
		dense.Push(&tbl.Offset, uint32(offset))
		dense.Push(&tbl.Length, uint32(size))
	}
	let n = dense.Total(tbl.Count)
	let mut dirs = slices.WithCapacity[[]byte](n)
	for i in 0..n {
		let id = dense.IDAt(tbl.Count, i)
		let o = int(dense.Of(tbl.Offset, id))
		let l = int(dense.Of(tbl.Length, id))
		dirs = dirs.Append(signature[o : o+l])
	}
	dirs
}

func directoryHash(directory []byte) ([]byte, bool) {
	let kind = directory[37]
	let text = directory.Text()
	if kind == uint8(1) {
		return (sha1.Sum(text).Bytes(), true)
	}
	if kind == uint8(2) || kind == uint8(3) {
		return (sha256.Sum(text).Bytes(), true)
	}
	if kind == uint8(4) {
		return (sha384Bytes(directory), true)
	}
	([]byte{}, false)
}

func directoryHashSize(kind uint8) uint64 {
	if kind == uint8(1) {
		uint64(20)
	} else if kind == uint8(2) || kind == uint8(3) {
		uint64(32)
	} else if kind == uint8(4) {
		uint64(48)
	} else {
		uint64(0)
	}
}

func hashSlice(kind uint8, chunk []byte) []byte {
	let text = chunk.Text()
	if kind == uint8(1) {
		return sha1.Sum(text).Bytes()
	}
	if kind == uint8(2) || kind == uint8(3) {
		return sha256.Sum(text).Bytes()
	}
	if kind == uint8(4) {
		return sha384Bytes(chunk)
	}
	[]byte{}
}

func pagesMatch(image []byte, directory []byte, codeEnd uint64) bool {
	let version = readU32BE(directory, 8)
	let hashOffset = uint64(readU32BE(directory, 16))
	let slots = uint64(readU32BE(directory, 28))
	let mut limit = uint64(readU32BE(directory, 32))
	let hashSize = uint64(directory[36])
	let hashKind = directory[37]
	let pageBits = directory[39]
	if version >= CSVersionScatter && (directory.Len() < 48 || readU32BE(directory, 44) != uint32(0)) {
		return false
	}
	if version >= CSVersionCodeLimit64 && directory.Len() >= 64 {
		let wide = readU64BE(directory, 56)
		if wide != uint64(0) {
			limit = wide
		}
	}
	let fullLen = directoryHashSize(hashKind)
	if fullLen == uint64(0) || limit != codeEnd || hashSize == uint64(0) || hashSize > fullLen || pageBits >= uint8(32) {
		return false
	}
	let page = if pageBits != uint8(0) { uint64(1) << uint64(pageBits) } else { limit }
	if page == uint64(0) || slots != (limit+page-uint64(1))/page || hashOffset+slots*hashSize > uint64(directory.Len()) {
		return false
	}
	for i in uint64(0)..slots {
		let start = i * page
		let end = cmp.Min((i+uint64(1))*page, limit)
		let sum = hashSlice(hashKind, image[int(start):int(end)])
		let wantOff = int(hashOffset + i*hashSize)
		let want = directory[wantOff : wantOff+int(hashSize)]
		if !bytesEqual(sum[0:int(hashSize)], want) {
			return false
		}
	}
	true
}

func readU32BE(b []byte, off int) uint32 {
	(uint32(b[off]) << uint32(24)) | (uint32(b[off+1]) << uint32(16)) | (uint32(b[off+2]) << uint32(8)) | uint32(b[off+3])
}

func readU32LE(b []byte, off int) uint32 {
	uint32(b[off]) | (uint32(b[off+1]) << uint32(8)) | (uint32(b[off+2]) << uint32(16)) | (uint32(b[off+3]) << uint32(24))
}

func readU64BE(b []byte, off int) uint64 {
	(uint64(readU32BE(b, off)) << uint64(32)) | uint64(readU32BE(b, off+4))
}

func bytesEqual(a []byte, b []byte) bool {
	if a.Len() != b.Len() {
		return false
	}
	for i in 0..a.Len() {
		if a[i] != b[i] {
			return false
		}
	}
	true
}

