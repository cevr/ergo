	0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
	0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
	0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
}

func rotr64(x uint64, n uint64) uint64 {
	(x >> n) | (x << (uint64(64) - n))
}

func sha384Bytes(msg []byte) []byte {
	let mut h0 uint64 = 0xcbbb9d5dc1059ed8
	let mut h1 uint64 = 0x629a292a367cd507
	let mut h2 uint64 = 0x9159015a3070dd17
	let mut h3 uint64 = 0x152fecd8f70e5939
	let mut h4 uint64 = 0x67332667ffc00b31
	let mut h5 uint64 = 0x8eb44a8768581511
	let mut h6 uint64 = 0xdb0c2e0d64f98fa7
	let mut h7 uint64 = 0x47b5481dbefa4fa4

	let msgLen = uint64(msg.Len())
	let mut padded = slices.Clone(msg)
	padded = padded.Append(uint8(0x80))
	for padded.Len()%128 != 112 {
		padded = padded.Append(uint8(0))
	}
	let bitHi = msgLen >> uint64(61)
	let bitLo = msgLen << uint64(3)
	for shift in []uint64{uint64(56), uint64(48), uint64(40), uint64(32), uint64(24), uint64(16), uint64(8), uint64(0)} {
		padded = padded.Append(uint8(bitHi >> shift))
	}
	for shift in []uint64{uint64(56), uint64(48), uint64(40), uint64(32), uint64(24), uint64(16), uint64(8), uint64(0)} {
		padded = padded.Append(uint8(bitLo >> shift))
	}

	let mut w = slices.WithCapacity[uint64](80)
	for _ in 0..80 {
		w = w.Append(uint64(0))
	}
	let blocks = padded.Len() / 128
	for blk in 0..blocks {
		let base = blk * 128
		for i in 0..16 {
			w[i] = readU64BE(padded, base+i*8)
		}
		for i in 16..80 {
			let s0 = rotr64(w[i-15], uint64(1)) ^ rotr64(w[i-15], uint64(8)) ^ (w[i-15] >> uint64(7))
			let s1 = rotr64(w[i-2], uint64(19)) ^ rotr64(w[i-2], uint64(61)) ^ (w[i-2] >> uint64(6))
			w[i] = w[i-16] + s0 + w[i-7] + s1
		}
		let mut a = h0
		let mut b = h1
		let mut c = h2
		let mut d = h3
		let mut e = h4
		let mut f = h5
		let mut g = h6
		let mut h = h7
		for i in 0..80 {
			let s1 = rotr64(e, uint64(14)) ^ rotr64(e, uint64(18)) ^ rotr64(e, uint64(41))
			let ch = (e & f) ^ ((^e) & g)
			let temp1 = h + s1 + ch + sha512K[i] + w[i]
			let s0 = rotr64(a, uint64(28)) ^ rotr64(a, uint64(34)) ^ rotr64(a, uint64(39))
			let maj = (a & b) ^ (a & c) ^ (b & c)
			let temp2 = s0 + maj
			h = g
			g = f
			f = e
			e = d + temp1
			d = c
			c = b
			b = a
			a = temp1 + temp2
		}
		h0 = h0 + a
		h1 = h1 + b
		h2 = h2 + c
		h3 = h3 + d
		h4 = h4 + e
		h5 = h5 + f
		h6 = h6 + g
		h7 = h7 + h
	}
	let mut out = slices.WithCapacity[byte](48)
	for v in []uint64{h0, h1, h2, h3, h4, h5} {
		for shift in []uint64{uint64(56), uint64(48), uint64(40), uint64(32), uint64(24), uint64(16), uint64(8), uint64(0)} {
			out = out.Append(uint8(v >> shift))
		}
	}
	out
}

func appendU32BE(out []byte, v uint32) []byte {
	let r = out.Append(uint8(v >> uint32(24)))
	let r2 = r.Append(uint8(v >> uint32(16)))
	let r3 = r2.Append(uint8(v >> uint32(8)))
	r3.Append(uint8(v))
}

func appendU32LE(out []byte, v uint32) []byte {
	let r = out.Append(uint8(v))
	let r2 = r.Append(uint8(v >> uint32(8)))
	let r3 = r2.Append(uint8(v >> uint32(16)))
	r3.Append(uint8(v >> uint32(24)))
}

// SignAndVerifyCodeRoundTrip verifies SHA-384 empty digest parity and Mach-O signed code extraction.
law SignAndVerifyCodeRoundTrip(payload []byte) {
	let codeLen = cmp.Min(payload.Len(), 512)
	let code = if codeLen == 0 { []byte{uint8(0xc3)} } else { payload[0:codeLen] }
	let sigOff = 32 + 16 + code.Len()
	let sigLen = 20 + 44 + 32
	let mut img = []byte{}
	img = appendU32LE(img, MachoMagic64)
	img = appendU32LE(img, uint32(0))
	img = appendU32LE(img, uint32(0))
	img = appendU32LE(img, uint32(2))
	img = appendU32LE(img, uint32(1))
	img = appendU32LE(img, uint32(16))
	img = appendU32LE(img, uint32(0))
	img = appendU32LE(img, uint32(0))
	img = appendU32LE(img, LCCodeSignature)
	img = appendU32LE(img, uint32(16))
	img = appendU32LE(img, uint32(sigOff))
	img = appendU32LE(img, uint32(sigLen))
	img = img.AppendBytes(code)

	let realPageSum = sha256.Sum(img.Text()).Bytes()
	let mut dir = []byte{}
	dir = appendU32BE(dir, CSMagicCodeDirectory)
	dir = appendU32BE(dir, uint32(44+32))
	dir = appendU32BE(dir, uint32(0x20000))
	dir = appendU32BE(dir, uint32(0))
	dir = appendU32BE(dir, uint32(44))
	dir = appendU32BE(dir, uint32(44))
	dir = appendU32BE(dir, uint32(0))
	dir = appendU32BE(dir, uint32(1))
	dir = appendU32BE(dir, uint32(sigOff))
	let mut b36 = dir.Append(uint8(32))
	b36 = b36.Append(CSHashTypeSHA256)
	b36 = b36.Append(uint8(0))
	dir = b36.Append(uint8(0))
	dir = appendU32BE(dir, uint32(0))
	dir = dir.AppendBytes(realPageSum)

	let cdhash = sha256.Sum(dir.Text()).Bytes()[0:CDHashSize]

	let mut sig = []byte{}
	sig = appendU32BE(sig, CSMagicEmbedded)
	sig = appendU32BE(sig, uint32(sigLen))
	sig = appendU32BE(sig, uint32(1))
	sig = appendU32BE(sig, CSSlotCodeDirectory)
	sig = appendU32BE(sig, uint32(20))
	sig = sig.AppendBytes(dir)
	img = img.AppendBytes(sig)

	let got = VerifyCodeSignature(img, cdhash) catch {
	case VerifyError:
		return false
	}
	got.Len() == sigOff && bytesEqual(got[48:sigOff], code)
}

test TestSha384AndMachoVerifyErrorCases {
	let hEmpty = hex.Encode(sha384Bytes([]byte{}).Text())
	assert hEmpty == "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b"

	let mut fatErr = ""
	let _ = VerifyCodeSignature([]byte{uint8(0xca), uint8(0xfe), uint8(0xba), uint8(0xbe)}, []byte{uint8(0)}) catch {
	case VerifyError as e:
		fatErr = e.Kind
		[]byte{}
	}
	assert fatErr == VerifyErrUniversal
}
