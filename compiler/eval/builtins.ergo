// NatNone identifies no builtin native function.
let NatNone = uint32(0)

// NatLen implements len / Len on slices, arrays, maps, and strings.
let NatLen = uint32(1)

// NatAppend implements append / Append on slices.
let NatAppend = uint32(2)

// NatDelete implements delete / Delete on maps.
let NatDelete = uint32(3)

// NatMin implements builtin min.
let NatMin = uint32(4)

// NatMax implements builtin max.
let NatMax = uint32(5)

// NatMakeSlice implements MakeSlice and slices.WithCapacity.
let NatMakeSlice = uint32(6)

// NatAt implements core.At indexing on slices and arrays.
let NatAt = uint32(7)

// NatSlice implements Slice windowing on slices and strings.
let NatSlice = uint32(8)

// NatTakeAt implements TakeAt / slices.Take on slices.
let NatTakeAt = uint32(9)

// NatConcat implements Concat on slices.
let NatConcat = uint32(10)

// NatRepeat implements Repeat on slices and strings.
let NatRepeat = uint32(11)

// NatClone implements Clone on slices and maps.
let NatClone = uint32(12)

// NatReserve implements Reserve on slices.
let NatReserve = uint32(13)

// NatBytes implements string.Bytes() converting string to []byte.
let NatBytes = uint32(14)

// NatGet implements map.Get(k) returning option.Option[V].
let NatGet = uint32(15)

// NatPut implements map.Put(k, v).
let NatPut = uint32(16)

// NatTake implements map.Take(k) returning (option.Option[V], Map[K, V]).
let NatTake = uint32(17)

// NatSome implements prelude some(v) constructing option.Some.
let NatSome = uint32(18)

// NatRuneText implements RuneText / utf8.RuneText.
let NatRuneText = uint32(19)

// NatStringsJoin implements strings.Join / StringsJoin.
let NatStringsJoin = uint32(20)

// NatAppendString implements byte-slice AppendString.
let NatAppendString = uint32(21)

// NatAppendBytes implements byte-slice AppendBytes.
let NatAppendBytes = uint32(22)

