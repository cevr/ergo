// ResolveBuiltinName maps a predeclared or core function name to its NativeID.
func ResolveBuiltinName(name string) uint32 {
	if name == "len" || name == "Len" { return NatLen }
	if name == "append" || name == "Append" { return NatAppend }
	if name == "delete" || name == "Delete" { return NatDelete }
	if name == "min" { return NatMin }
	if name == "max" { return NatMax }
	if name == "MakeSlice" { return NatMakeSlice }
	if name == "At" { return NatAt }
	if name == "Slice" { return NatSlice }
	if name == "TakeAt" { return NatTakeAt }
	if name == "Concat" { return NatConcat }
	if name == "Repeat" { return NatRepeat }
	if name == "Clone" { return NatClone }
	if name == "Reserve" { return NatReserve }
	if name == "Bytes" { return NatBytes }
	if name == "Get" { return NatGet }
	if name == "Put" { return NatPut }
	if name == "Take" { return NatTake }
	if name == "some" { return NatSome }
	if name == "RuneText" { return NatRuneText }
	if name == "StringsJoin" { return NatStringsJoin }
	if name == "AppendString" { return NatAppendString }
	if name == "AppendBytes" { return NatAppendBytes }
	if name == "AppendFrom" { return NatAppendFrom }
	if name == "Grow" { return NatGrow }
	if name == "Text" { return NatText }
	if name == "mapGet" { return NatMapGetRaw }
	if name == "mapTake" { return NatMapTakeRaw }
	if name == "sliceWindow" { return NatSlice }
	if name == "sliceTakeAt" { return NatTakeAt }
	if name == "sliceConcat" { return NatConcat }
	if name == "sliceRepeat" { return NatRepeat }
	if name == "reserveSlice" { return NatReserve }
	if name == "mapPut" { return NatPut }
	if name == "mapClone" { return NatClone }
	if name == "appendString" || name == "appendText" { return NatStrBuilderAppend }
	if name == "appendByte" { return NatStrBuilderAppendByte }
	NatNone
}

// ResolveStdNativeID maps a standard library package path and symbol name to its NativeID.
func ResolveStdNativeID(pkgPath string, name string) uint32 {
	let basePkg = if strings.HasPrefix(pkgPath, "std/") { pkgPath[4:pkgPath.Len()] } else { pkgPath }
	let normPkg = if basePkg == "unicode/utf8" {
		"utf8"
	} else if basePkg == "math/bits" {
		"bits"
	} else if basePkg == "path/filepath" {
		"filepath"
	} else {
		basePkg
	}
	if normPkg == "" || normPkg == "prelude" || normPkg == "core" {
		return ResolveBuiltinName(name)
	}
	if normPkg == "option" {
		if name == "Map" { return NatCbOptionMap }
		if name == "Then" { return NatCbOptionThen }
		if name == "Fold" { return NatCbOptionFold }
		if name == "MapOr" { return NatCbOptionMapOr }
		if name == "OrFail" { return NatOptionOrFail }
		return NatNone
	}
	if pkgPath == "cmp" {
		if name == "Compare" { return NatCmpCompare }
		if name == "Less" { return NatCmpLess }
		if name == "Max" { return NatCmpMax }
		if name == "Min" { return NatCmpMin }
		return NatNone
	}
	if normPkg == "slices" {
		if name == "WithCapacity" { return NatSlicesWithCapacity }
		if name == "Take" { return NatTakeAt }
		if name == "Equal" { return NatSlicesEqual }
		if name == "Contains" { return NatSlicesContains }
		if name == "Index" { return NatSlicesIndex }
		if name == "Reverse" { return NatSlicesReverse }
		if name == "Sort" { return NatSlicesSort }
		if name == "Clone" { return NatClone }
		if name == "Max" { return NatSlicesMax }
		if name == "Min" { return NatSlicesMin }
		if name == "Insert" { return NatSlicesInsert }
		if name == "Delete" { return NatSlicesDelete }
		if name == "Replace" { return NatSlicesReplace }
		if name == "Transform" { return NatCbSlicesTransform }
		if name == "Filter" { return NatCbSlicesFilter }
		if name == "Fold" { return NatCbSlicesFold }
		if name == "IndexFunc" { return NatCbSlicesIndexFunc }
		if name == "SortFunc" { return NatCbSlicesSortFunc }
		if name == "SortStableFunc" { return NatCbSlicesSortStableFunc }
		return NatNone
	}
	if normPkg == "strings" {
		if name == "Split" { return NatStrSplit }
		if name == "SplitN" { return NatStrSplitN }
		if name == "Join" { return NatStringsJoin }
		if name == "HasPrefix" { return NatStrHasPrefix }
		if name == "HasSuffix" { return NatStrHasSuffix }
		if name == "TrimSpace" { return NatStrTrimSpace }
		if name == "TrimPrefix" { return NatStrTrimPrefix }
		if name == "TrimSuffix" { return NatStrTrimSuffix }
		if name == "TrimLeft" { return NatStrTrimLeft }
		if name == "TrimRight" { return NatStrTrimRight }
		if name == "Fields" { return NatStrFields }
		if name == "FieldsFunc" { return NatCbStrFieldsFunc }
		if name == "TrimFunc" { return NatCbStrTrimFunc }
		if name == "Repeat" { return NatStrRepeat }
		if name == "ToLower" { return NatStrToLower }
		if name == "ToUpper" { return NatStrToUpper }
		if name == "Index" { return NatStrIndex }
		if name == "IndexByte" { return NatStrIndexByte }
		if name == "IndexAny" { return NatStrIndexAny }
		if name == "LastIndex" { return NatStrLastIndex }
		if name == "LastIndexAny" { return NatStrLastIndexAny }
		if name == "Contains" { return NatStrContains }
		if name == "ContainsRune" { return NatStrContainsRune }
		if name == "ReplaceAll" { return NatStrReplaceAll }
		if name == "Count" { return NatStrCount }
		if name == "EqualFold" { return NatStrEqualFold }
		if name == "ToValidUTF8" { return NatStrToValidUTF8 }
		if name == "Slice" { return NatSlice }
		if name == "Cut" { return NatStrCut }
		if name == "NewBuilder" { return NatBuilderNew }
		if name == "WriteString" { return NatBuilderWriteString }
		if name == "WriteByte" { return NatBuilderWriteByte }
		if name == "WriteRune" { return NatBuilderWriteRune }
		if name == "String" { return NatBuilderString }
		if name == "Len" { return NatBuilderLen }
		if name == "Reset" { return NatBuilderReset }
		if name == "Grow" { return NatBuilderGrow }
		let sr2 = ResolveRound2PureNativeID("strings." + name)
		if sr2 != NatNone { return sr2 }
		return NatNone
	}
	if normPkg == "utf8" {
		if name == "RuneCount" || name == "RuneCountInString" { return NatUtf8RuneCount }
		if name == "DecodeRuneInString" { return NatUtf8DecodeRune }
		if name == "RuneText" { return NatRuneText }
		if name == "AppendRune" { return NatUtf8AppendRune }
		if name == "String" { return NatUtf8String }
		if name == "ValidString" { return NatUtf8ValidString }
		if name == "ValidRune" { return NatUtf8ValidRune }
		if name == "RuneLen" { return NatUtf8RuneLen }
		if name == "IsDigit" { return NatUtf8IsDigit }
		if name == "IsLetter" { return NatUtf8IsLetter }
		if name == "IsUpper" { return NatUtf8IsUpper }
		if name == "IsSpace" { return NatUtf8IsSpace }
		return NatNone
	}
	if normPkg == "strconv" {
		if name == "Itoa" { return NatStrconvItoa }
		if name == "FormatInt" { return NatStrconvFormatInt }
		if name == "Atoi" { return NatStrconvAtoi }
		if name == "ParseInt" { return NatStrconvParseInt }
		if name == "ParseFloat" { return NatStrconvParseFloat }
		if name == "ParseBool" { return NatStrconvParseBool }
		if name == "FormatBool" { return NatStrconvFormatBool }
		if name == "FormatFloat" { return NatStrconvFormatFloat }
		if name == "AppendInt" { return NatStrconvAppendInt }
		if name == "AppendUint" { return NatStrconvAppendUint }
		if name == "AppendFloat" { return NatStrconvAppendFloat }
		if name == "Quote" { return NatStrconvQuote }
		if name == "Unquote" { return NatStrconvUnquote }
		let r2 = ResolveRound2PureNativeID("strconv." + name)
		if r2 != NatNone { return r2 }
		return NatNone
	}
	if normPkg == "math" {
		if name == "Abs" { return NatMathAbs }
		if name == "Ceil" { return NatMathCeil }
		if name == "Floor" { return NatMathFloor }
		if name == "Trunc" { return NatMathTrunc }
		if name == "Round" { return NatMathRound }
		if name == "Sqrt" { return NatMathSqrt }
		if name == "Pow" { return NatMathPow }
		if name == "FMA" { return NatMathFMA }
		if name == "Mod" { return NatMathMod }
		if name == "Log" { return NatMathLog }
		if name == "Exp" { return NatMathExp }
		if name == "Sin" { return NatMathSin }
		if name == "Cos" { return NatMathCos }
		if name == "Tan" { return NatMathTan }
		if name == "Asin" { return NatMathAsin }
		if name == "Acos" { return NatMathAcos }
		if name == "Atan" { return NatMathAtan }
		if name == "Atan2" { return NatMathAtan2 }
		if name == "Hypot" { return NatMathHypot }
		if name == "Cbrt" { return NatMathCbrt }
		if name == "Log2" { return NatMathLog2 }
		if name == "Log10" { return NatMathLog10 }
		if name == "Inf" { return NatMathInf }
		if name == "NaN" { return NatMathNaN }
		if name == "IsNaN" { return NatMathIsNaN }
		if name == "IsInf" { return NatMathIsInf }
		if name == "MaxInt" { return NatMathMaxInt }
		if name == "MinInt" { return NatMathMinInt }
		if name == "MaxInt64" { return NatMathMaxInt64 }
		if name == "MinInt64" { return NatMathMinInt64 }
		if name == "ToInt" { return NatMathToInt }
		let mr2 = ResolveRound2PureNativeID("math." + name)
		if mr2 != NatNone { return mr2 }
		return NatNone
	}
	if normPkg == "bits" {
		if name == "OnesCount" { return NatBitsOnesCount }
		if name == "OnesCount64" { return NatBitsOnesCount64 }
		if name == "LeadingZeros" { return NatBitsLeadingZeros }
		if name == "LeadingZeros64" { return NatBitsLeadingZeros64 }
		if name == "TrailingZeros" { return NatBitsTrailingZeros }
		if name == "TrailingZeros64" { return NatBitsTrailingZeros64 }
		if name == "Len" { return NatBitsLen }
		if name == "Len64" { return NatBitsLen64 }
		if name == "RotateLeft32" { return NatBitsRotateLeft32 }
		if name == "RotateLeft64" { return NatBitsRotateLeft64 }
		if name == "Add64" { return NatBitsAdd64 }
		if name == "Sub64" { return NatBitsSub64 }
		if name == "Mul64" { return NatBitsMul64 }
		if name == "Div64" { return NatBitsDiv64 }
		return NatNone
	}
	if normPkg == "hex" {
		if name == "Encode" { return NatHexEncode }
		if name == "Decode" { return NatHexDecode }
		return NatNone
	}
	let r2 = ResolveRound2PureNativeID(basePkg + "." + name)
	if r2 != NatNone {
		return r2
	}
	ResolveRound2PureNativeID(normPkg + "." + name)
}

// ResolveMethodNativeID maps receiver value tag and method name to a NativeID when built-in.
func ResolveMethodNativeID(tag uint8, methodName string) uint32 {
	if tag == TagSlice || tag == TagArray {
		if methodName == "Len" { return NatLen }
		if methodName == "Append" { return NatAppend }
		if methodName == "At" { return NatAt }
		if methodName == "Slice" { return NatSlice }
		if methodName == "TakeAt" { return NatTakeAt }
		if methodName == "Concat" { return NatConcat }
		if methodName == "Repeat" { return NatRepeat }
		if methodName == "Clone" { return NatClone }
		if methodName == "Reserve" { return NatReserve }
		if methodName == "AppendString" { return NatAppendString }
		if methodName == "AppendBytes" { return NatAppendBytes }
		if methodName == "AppendFrom" { return NatAppendFrom }
		if methodName == "Grow" { return NatGrow }
		if methodName == "Text" { return NatText }
		return NatNone
	}
	if tag == TagMap {
		if methodName == "Len" { return NatLen }
		if methodName == "Get" { return NatGet }
		if methodName == "Put" { return NatPut }
		if methodName == "Delete" { return NatDelete }
		if methodName == "Take" { return NatTake }
		if methodName == "Clone" { return NatClone }
		return NatNone
	}
	if tag == TagStr {
		if methodName == "Len" { return NatLen }
		if methodName == "Slice" { return NatSlice }
		if methodName == "Bytes" { return NatBytes }
		return NatNone
	}
	if tag == TagInt || tag == TagUint {
		if methodName == "RuneText" { return NatRuneText }
		return NatNone
	}
	if tag == TagBuilder {
		if methodName == "WriteString" { return NatBuilderWriteString }
		if methodName == "WriteByte" { return NatBuilderWriteByte }
		if methodName == "WriteRune" { return NatBuilderWriteRune }
		if methodName == "String" { return NatBuilderString }
		if methodName == "Len" { return NatBuilderLen }
		if methodName == "Reset" { return NatBuilderReset }
		if methodName == "Grow" { return NatBuilderGrow }
		return NatNone
	}
	NatNone
}

func findPkgTypeByName(prog mut Program, pkgPath string, typeName string, targs []uint32) uint32 {
	let mut pkgNum = uint32(0)
	let mut foundPkg = false
	for i, p in prog.PkgPaths {
		if p == pkgPath {
			pkgNum = uint32(i)
			foundPkg = true
			break
		}
	}
	if !foundPkg {
		for i, p in prog.PkgPaths {
			if strings.HasSuffix(p, "/"+pkgPath) {
				pkgNum = uint32(i)
				foundPkg = true
				break
			}
		}
	}
	let key = LookupDeclKey(pkgNum, typeName, targs)
	let existing = LookupTypeByKey(prog.Types, key)
	if existing != TypeVoid {
		return existing
	}
	let baseKey = LookupDeclKey(pkgNum, typeName, []uint32{})
	let base = LookupTypeByKey(prog.Types, baseKey)
	if base != TypeVoid && targs.Len() > 0 {
		let inst = instantiateNamedType(prog, pkgNum, typeName, targs, base)
		prog.Types.DeclToType[key] = inst
		return inst
	}
	if base != TypeVoid {
		return base
	}
	let nt = AllocNamedType(&prog.Types, KindRecord, pkgNum, typeName, uint32(0))
	prog.Types.DeclToType[baseKey] = nt
	nt
}

func makeOptionSome(prog mut Program, elemType uint32, val Val) Val {
	let someT = findPkgTypeByName(prog, "option", "Some", []uint32{elemType})
	MakeRecordVal(&prog.Arena, someT, []Val{val})
}

func makeOptionNone(prog mut Program) Val {
	let noneT = findPkgTypeByName(prog, "option", "None", []uint32{})
	MakeRecordVal(&prog.Arena, noneT, []Val{})
}

func makeStdErr(prog mut Program, pkgPath string, errName string, fieldNames []string, fieldTypes []uint32, fields []Val) Val {
	let key = LookupDeclKey(uint32(0), pkgPath+"."+errName, []uint32{})
	let et = findPkgTypeByName(prog, pkgPath, errName, []uint32{})
	if int(et) < prog.Types.Count.Len() && prog.Types.Count[int(et)] == uint32(0) && fieldNames.Len() > 0 {
		SetRecordFields(&prog.Types, et, fieldNames, fieldTypes)
	}
	let _ = key
	MakeRecordVal(&prog.Arena, et, fields)
}

// ParseSignedIntBase parses a signed integer string in the given base and bit size without external Go ParseInt calls.
func ParseSignedIntBase(s string, base int, bitSize int) (int64, uint8) {
	if s.Len() == 0 {
		return (int64(0), uint8(1))
	}
	let bs = if bitSize == 0 { 64 } else { bitSize }
	if bs < 0 || bs > 64 {
		return (int64(0), uint8(2))
	}
	let mut i = 0
	let mut neg = false
	if s[0] == byte('-') || s[0] == byte('+') {
		neg = s[0] == byte('-')
		i = 1
	}
	if i >= s.Len() {
		return (int64(0), uint8(1))
	}
	let mut b = base
	let mut allowSep = false
	let mut sawDigit = false
	let mut prevSep = false
	if b == 0 {
		allowSep = true
		if s[i] == byte('0') {
			let rem = s.Len() - i
			if rem >= 2 && (s[i+1] == byte('x') || s[i+1] == byte('X')) {
				b = 16
				i = i + 2
			} else if rem >= 2 && (s[i+1] == byte('b') || s[i+1] == byte('B')) {
				b = 2
				i = i + 2
			} else if rem >= 2 && (s[i+1] == byte('o') || s[i+1] == byte('O')) {
				b = 8
				i = i + 2
			} else {
				b = 8
				i = i + 1
				sawDigit = true
			}
		} else {
			b = 10
		}
	} else if b < 2 || b > 36 {
		return (int64(0), uint8(1))
	}
	let maxNeg = uint64(1) << uint64(bs-1)
	let maxPos = maxNeg - uint64(1)
	let cutoff = if neg { maxNeg } else { maxPos }
	let uBase = uint64(b)
	let mut acc = uint64(0)
	let mut over = false
	for i < s.Len() {
		let c = s[i]
		i = i + 1
		if allowSep && c == byte('_') {
			if prevSep || (!sawDigit && b == 10) {
				return (int64(0), uint8(1))
			}
			prevSep = true
			continue
		}
		let d = if c >= byte('0') && c <= byte('9') {
			int(c - byte('0'))
		} else if c >= byte('a') && c <= byte('z') {
			int(c-byte('a')) + 10
		} else if c >= byte('A') && c <= byte('Z') {
			int(c-byte('A')) + 10
		} else {
			return (int64(0), uint8(1))
		}
		if d >= b {
			return (int64(0), uint8(1))
		}
		sawDigit = true
		prevSep = false
		let ud = uint64(d)
		if ud > cutoff || acc > (cutoff-ud)/uBase {
			over = true
		} else {
			acc = acc*uBase + ud
		}
	}
	if !sawDigit || prevSep {
		return (int64(0), uint8(1))
	}
	if over {
		let sat = if neg {
			if bs == 64 { Int64FromBits(maxNeg) } else { -int64(maxNeg) }
		} else {
			int64(maxPos)
		}
		return (sat, uint8(2))
	}
	if neg {
		if acc == (uint64(1) << uint64(63)) {
			return (Int64FromBits(acc), uint8(0))
		}
		return (-int64(acc), uint8(0))
	}
	(int64(acc), uint8(0))
}

// FormatUintBase formats an unsigned 64-bit integer in base 2..36 without external Go calls.
func FormatUintBase(v uint64, base int) string {
	if base < 2 || base > 36 {
		return ""
	}
	if v == uint64(0) {
		return "0"
	}
	let digits = "0123456789abcdefghijklmnopqrstuvwxyz"
	let mut rev = []byte{}
	let mut cur = v
	let ub = uint64(base)
	for cur > uint64(0) {
		rev = rev.Append(digits[int(cur%ub)])
		cur = cur / ub
	}
	let n = rev.Len()
	let mut out = slices.WithCapacity[byte](n)
	for i in 0..n {
		out = out.Append(rev[n-1-i])
	}
	strings.FromBytes(out)
}

// ParseUint64Dec parses a base-10 unsigned 64-bit integer string without external Go ParseUint calls.
func ParseUint64Dec(s string) (uint64, bool) {
	if s.Len() == 0 {
		return (uint64(0), false)
	}
	let uMax uint64 = 18446744073709551615
	let mut acc = uint64(0)
	for i in 0..s.Len() {
		let c = s[i]
		if c < byte('0') || c > byte('9') {
			return (uint64(0), false)
		}
		let d = uint64(c - byte('0'))
		if acc > (uMax-d)/uint64(10) {
			return (uint64(0), false)
		}
		acc = acc*uint64(10) + d
	}
	(acc, true)
}

func makeStrSliceVal(prog mut Program, xs []string) Val {
	let st = InternSlice(&prog.Types, TypeString)
	let mut elems = slices.WithCapacity[Val](xs.Len())
	for s in xs {
		elems = elems.Append(AllocStrVal(&prog.Arena, TypeString, s))
	}
	MakeSliceVal(&prog.Arena, st, elems, uint32(elems.Len()))
}

func readValStrings(arena ValArena, v Val) []string {
	let n = int(ReadSliceLen(arena, v))
	let mut out = slices.WithCapacity[string](n)
	for i in 0..n {
		out = out.Append(ReadStr(arena, ReadSliceElem(arena, v, uint32(i))))
	}
	out
}

func readValBytes(arena ValArena, v Val) []byte {
	let n = int(ReadSliceLen(arena, v))
	let mut out = slices.WithCapacity[byte](n)
	for i in 0..n {
		out = out.Append(byte(ReadSliceElem(arena, v, uint32(i)).Data & uint64(0xff)))
	}
	out
}

func makeBytesSliceVal(prog mut Program, bs []byte) Val {
	let mut elems = slices.WithCapacity[Val](bs.Len())
	for b in bs {
		elems = elems.Append(MakeIntVal(prog.Types, TypeUint8, uint64(b)))
	}
	MakeSliceVal(&prog.Arena, TypeBytes, elems, uint32(elems.Len()))
}

// InvokePureNativeWithEnv executes builtin/std native id using VM native object storage and fold state.
func InvokePureNativeWithEnv(prog mut Program, na mut NativeObjArena, inFold bool, id uint32, targs []uint32, args []Val) (Val, Val, string, uint64) {
	if id >= uint32(240) {
		return InvokeRound2PureNative(prog, na, inFold, id, args)
	}
	InvokePureNative(prog, id, targs, args)
}

// InvokePureNative executes pure builtin/std native function id and returns (result, errVal, defectMsg, extraWork).
func InvokePureNative(prog mut Program, id uint32, targs []uint32, args []Val) (Val, Val, string, uint64) {
	if id == NatLen {
		let v = args[0]
		if v.Tag == TagStr {
			return (MakeIntVal(prog.Types, TypeInt, uint64(ReadStr(prog.Arena, v).Len())), UnitVal(), "", uint64(1))
		}
		if v.Tag == TagSlice || v.Tag == TagArray {
			return (MakeIntVal(prog.Types, TypeInt, uint64(ReadSliceLen(prog.Arena, v))), UnitVal(), "", uint64(1))
		}
		if v.Tag == TagMap {
			return (MakeIntVal(prog.Types, TypeInt, uint64(ReadMapLen(prog.Arena, v))), UnitVal(), "", uint64(1))
		}
		return (MakeIntVal(prog.Types, TypeInt, uint64(0)), UnitVal(), "", uint64(1))
	}
	if id == NatAppend {
		let xs = args[0]
		let out = AppendSliceValCOW(&prog.Arena, xs, args[1])
		return (out, UnitVal(), "", uint64(2))
	}
	if id == NatClone {
		let v = args[0]
		if v.Tag == TagSlice || v.Tag == TagArray {
			let n = ReadSliceLen(prog.Arena, v)
			return (CloneSliceVal(&prog.Arena, v), UnitVal(), "", uint64(n) + uint64(1))
		}
		if v.Tag == TagMap {
			let n = ReadMapLen(prog.Arena, v)
			return (CloneMapVal(&prog.Arena, v), UnitVal(), "", uint64(n) + uint64(1))
		}
		return (v, UnitVal(), "", uint64(1))
	}
	if id == NatReserve {
		let xs = args[0]
		let extra = Int64FromBits(args[1].Data)
		if extra <= 0 {
			RetainVal(&prog.Arena, xs)
			return (xs, UnitVal(), "", uint64(1))
		}
		return (ReserveSliceVal(&prog.Arena, xs, uint32(extra)), UnitVal(), "", uint64(1))
	}
	if id == NatMakeSlice {
		let n = Int64FromBits(args[0].Data)
		if n < 0 {
			return (UnitVal(), UnitVal(), "runtime error: slice length or capacity out of range", uint64(1))
		}
		let st = if targs.Len() > 0 { InternSlice(&prog.Types, targs[0]) } else { InternSlice(&prog.Types, TypeInt) }
		return (MakeSliceVal(&prog.Arena, st, []Val{}, uint32(n)), UnitVal(), "", uint64(n) + uint64(1))
	}
	if id == NatAt {
		let xs = args[0]
		let idx = Int64FromBits(args[1].Data)
		let n = int64(ReadSliceLen(prog.Arena, xs))
		if idx < 0 || idx >= n {
			return (UnitVal(), UnitVal(), "runtime error: index out of range [\(idx)] with length \(n)", uint64(1))
		}
		let e = ReadSliceElem(prog.Arena, xs, uint32(idx))
		RetainVal(&prog.Arena, e)
		return (e, UnitVal(), "", uint64(1))
	}
	if id == NatSlice {
		let v = args[0]
		let lo = Int64FromBits(args[1].Data)
		let hi = Int64FromBits(args[2].Data)
		if v.Tag == TagStr {
			let s = ReadStr(prog.Arena, v)
			let n = int64(s.Len())
			if lo < 0 || hi < lo || hi > n {
				return (UnitVal(), UnitVal(), "runtime error: slice bounds out of range [\(lo):\(hi)]", uint64(1))
			}
			return (AllocStrVal(&prog.Arena, TypeString, s[int(lo):int(hi)]), UnitVal(), "", uint64(1))
		}
		let c = int64(ReadSliceCap(prog.Arena, v))
		if lo < 0 || hi < lo || hi > c {
			return (UnitVal(), UnitVal(), "runtime error: slice bounds out of range [\(lo):\(hi)]", uint64(1))
		}
		return (SubSliceVal(&prog.Arena, v, v.Type, uint32(lo), uint32(hi), uint32(0), false), UnitVal(), "", uint64(1))
	}
	if id == NatTakeAt {
		let xs = args[0]
		let idx = Int64FromBits(args[1].Data)
		let n = int64(ReadSliceLen(prog.Arena, xs))
		if idx < 0 || idx >= n {
			return (UnitVal(), UnitVal(), "runtime error: index out of range [\(idx)] with length \(n)", uint64(1))
		}
		let (picked, rest) = TakeAtSliceVal(&prog.Arena, xs, uint32(idx))
		let tt = InternTuple(&prog.Types, []uint32{picked.Type, xs.Type})
		return (MakeTupleVal(&prog.Arena, tt, []Val{picked, rest}), UnitVal(), "", uint64(n) + uint64(1))
	}
	if id == NatConcat {
		let a = args[0]
		let b = args[1]
		let na = int(ReadSliceLen(prog.Arena, a))
		let nb = int(ReadSliceLen(prog.Arena, b))
		let mut elems = slices.WithCapacity[Val](na + nb)
		for i in 0..na {
			elems = elems.Append(ReadSliceElem(prog.Arena, a, uint32(i)))
		}
		for i in 0..nb {
			elems = elems.Append(ReadSliceElem(prog.Arena, b, uint32(i)))
		}
		return (MakeSliceVal(&prog.Arena, a.Type, elems, uint32(elems.Len())), UnitVal(), "", uint64(na+nb) + uint64(1))
	}
	if id == NatRepeat {
		let xs = args[0]
		let count = Int64FromBits(args[1].Data)
		if count < 0 {
			return (UnitVal(), UnitVal(), "runtime error: negative Repeat count \(count)", uint64(1))
		}
		let nx = int(ReadSliceLen(prog.Arena, xs))
		let mut elems = slices.WithCapacity[Val](nx * int(count))
		for _ in 0..int(count) {
			for i in 0..nx {
				elems = elems.Append(ReadSliceElem(prog.Arena, xs, uint32(i)))
			}
		}
		return (MakeSliceVal(&prog.Arena, xs.Type, elems, uint32(elems.Len())), UnitVal(), "", uint64(nx*int(count)) + uint64(1))
	}
	if id == NatBytes {
		let s = ReadStr(prog.Arena, args[0])
		let mut elems = slices.WithCapacity[Val](s.Len())
		for i in 0..s.Len() {
			elems = elems.Append(MakeIntVal(prog.Types, TypeUint8, uint64(s[i])))
		}
		return (MakeSliceVal(&prog.Arena, TypeBytes, elems, uint32(elems.Len())), UnitVal(), "", uint64(s.Len()) + uint64(1))
	}
	if id == NatText {
		let bs = readValBytes(prog.Arena, args[0])
		let mut b = strings.NewBuilder()
		for bt in bs {
			b.WriteByte(bt)
		}
		return (AllocStrVal(&prog.Arena, TypeString, b.String()), UnitVal(), "", uint64(bs.Len()) + uint64(1))
	}
	if id == NatAppendString {
		let xs = args[0]
		let s = ReadStr(prog.Arena, args[1])
		let nx = int(ReadSliceLen(prog.Arena, xs))
		let mut elems = slices.WithCapacity[Val](nx + s.Len())
		for i in 0..nx {
			elems = elems.Append(ReadSliceElem(prog.Arena, xs, uint32(i)))
		}
		for i in 0..s.Len() {
			elems = elems.Append(MakeIntVal(prog.Types, TypeUint8, uint64(s[i])))
		}
		return (MakeSliceVal(&prog.Arena, TypeBytes, elems, uint32(elems.Len())), UnitVal(), "", uint64(s.Len()) + uint64(1))
	}
	if id == NatAppendBytes || id == NatAppendFrom {
		let a = args[0]
		let b = args[1]
		let na = int(ReadSliceLen(prog.Arena, a))
		let nb = int(ReadSliceLen(prog.Arena, b))
		let mut elems = slices.WithCapacity[Val](na + nb)
		for i in 0..na {
			elems = elems.Append(ReadSliceElem(prog.Arena, a, uint32(i)))
		}
		for i in 0..nb {
			elems = elems.Append(ReadSliceElem(prog.Arena, b, uint32(i)))
		}
		return (MakeSliceVal(&prog.Arena, a.Type, elems, uint32(elems.Len())), UnitVal(), "", uint64(nb) + uint64(1))
	}
	if id == NatGrow {
		let xs = args[0]
		let extra = Int64FromBits(args[1].Data)
		if extra < 0 {
			return (UnitVal(), UnitVal(), "runtime error: negative Grow count", uint64(1))
		}
		return (ReserveSliceVal(&prog.Arena, xs, uint32(extra)), UnitVal(), "", uint64(1))
	}
	if id == NatRuneText {
		let r = rune(Int64FromBits(args[0].Data))
		return (AllocStrVal(&prog.Arena, TypeString, utf8.RuneText(r)), UnitVal(), "", uint64(1))
	}
	if id == NatGet {
		let m = args[0]
		let (v, ok) = MapGetVal(prog.Types, prog.Arena, m, args[1])
		let mu = UnwrapType(prog.Types, m.Type)
		let valT = if int(mu) < prog.Types.Aux.Len() { prog.Types.Aux[int(mu)] } else { v.Type }
		if ok {
			return (makeOptionSome(prog, valT, v), UnitVal(), "", uint64(1))
		}
		return (makeOptionNone(prog), UnitVal(), "", uint64(1))
	}
	if id == NatMapGetRaw {
		let m = args[0]
		let (v, ok) = MapGetVal(prog.Types, prog.Arena, m, args[1])
		let mu = UnwrapType(prog.Types, m.Type)
		let valT = if int(mu) < prog.Types.Aux.Len() { prog.Types.Aux[int(mu)] } else { v.Type }
		let resV = if ok { v } else { ZeroVal(prog.Types, &prog.Arena, valT) }
		let tt = InternTuple(&prog.Types, []uint32{valT, TypeBool})
		return (MakeTupleVal(&prog.Arena, tt, []Val{resV, BoolVal(TypeBool, ok)}), UnitVal(), "", uint64(1))
	}
	if id == NatPut {
		return (MapPutValCOW(prog.Types, &prog.Arena, args[0], args[1], args[2]), UnitVal(), "", uint64(2))
	}
	if id == NatDelete {
		return (MapDeleteValCOW(prog.Types, &prog.Arena, args[0], args[1]), UnitVal(), "", uint64(2))
	}
	if id == NatTake {
		let m = args[0]
		let (v, ok, rest) = MapTakeValCOW(prog.Types, &prog.Arena, m, args[1])
		let mu = UnwrapType(prog.Types, m.Type)
		let valT = if int(mu) < prog.Types.Aux.Len() { prog.Types.Aux[int(mu)] } else { v.Type }
		let optV = if ok { makeOptionSome(prog, valT, v) } else { makeOptionNone(prog) }
		let tt = InternTuple(&prog.Types, []uint32{optV.Type, m.Type})
		return (MakeTupleVal(&prog.Arena, tt, []Val{optV, rest}), UnitVal(), "", uint64(2))
	}
	if id == NatMapTakeRaw {
		let m = args[0]
		let (v, ok, rest) = MapTakeValCOW(prog.Types, &prog.Arena, m, args[1])
		let mu = UnwrapType(prog.Types, m.Type)
		let valT = if int(mu) < prog.Types.Aux.Len() { prog.Types.Aux[int(mu)] } else { v.Type }
		let resV = if ok { v } else { ZeroVal(prog.Types, &prog.Arena, valT) }
		let tt = InternTuple(&prog.Types, []uint32{valT, TypeBool, m.Type})
		return (MakeTupleVal(&prog.Arena, tt, []Val{resV, BoolVal(TypeBool, ok), rest}), UnitVal(), "", uint64(2))
	}
	if id == NatSome {
		return (makeOptionSome(prog, args[0].Type, args[0]), UnitVal(), "", uint64(1))
	}
	if id == NatOptionOrFail {
		let o = args[0]
		let tn = prog.Types.Name[int(o.Type)]
		if tn == "Some" || strings.HasPrefix(tn, "Some[") {
			let v = ReadPackElem(prog.Arena, o, uint32(0))
			RetainVal(&prog.Arena, v)
			return (v, UnitVal(), "", uint64(1))
		}
		return (UnitVal(), args[1], "", uint64(1))
	}
	if id == NatMin || id == NatCmpMin {
		let mut best = args[0]
		for i in 1..args.Len() {
			let cur = args[i]
			if cur.Tag == TagFloat {
				let fc = Float64FromBits(cur.Data)
				let fb = Float64FromBits(best.Data)
				if math.IsNaN(fc) || math.IsNaN(fb) {
					return (MakeFloatVal(prog.Types, best.Type, math.NaN()), UnitVal(), "", uint64(1))
				}
				if fc < fb {
					best = cur
				}
			} else {
				let (c, _) = CompareVals(prog.Types, prog.Arena, cur, best)
				if c < 0 {
					best = cur
				}
			}
		}
		RetainVal(&prog.Arena, best)
		return (best, UnitVal(), "", uint64(1))
	}
