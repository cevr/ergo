	}
	if id == NatStrconvQuote {
		return (AllocStrVal(&prog.Arena, TypeString, strconv.Quote(ReadStr(prog.Arena, args[0]))), UnitVal(), "", uint64(1))
	}
	if id == NatStrconvUnquote {
		let s = ReadStr(prog.Arena, args[0])
		let uq = strconv.Unquote(s) catch {
		case strconv.Malformed as m:
			let e = makeStdErr(prog, "strconv", "Malformed", []string{"Text"}, []uint32{TypeString}, []Val{AllocStrVal(&prog.Arena, TypeString, m.Text)})
			return (UnitVal(), e, "", uint64(1))
		}
		return (AllocStrVal(&prog.Arena, TypeString, uq), UnitVal(), "", uint64(1))
	}
	if id >= NatMathAbs && id <= NatMathToInt {
		return invokeMathNative(prog, id, args)
	}
	if id >= NatBitsOnesCount && id <= NatBitsDiv64 {
		return invokeBitsNative(prog, id, args)
	}
	if id == NatHexEncode {
		return (AllocStrVal(&prog.Arena, TypeString, hex.Encode(ReadStr(prog.Arena, args[0]))), UnitVal(), "", uint64(1))
	}
	if id == NatHexDecode {
		let s = ReadStr(prog.Arena, args[0])
		let decoded = hex.Decode(s) catch {
		case hex.Malformed as m:
			let e = makeStdErr(prog, "hex", "Malformed", []string{"Offset"}, []uint32{TypeInt}, []Val{MakeIntVal(prog.Types, TypeInt, uint64(int64(m.Offset)))})
			return (UnitVal(), e, "", uint64(1))
		}
		return (AllocStrVal(&prog.Arena, TypeString, decoded), UnitVal(), "", uint64(1))
	}
	(UnitVal(), UnitVal(), "unsupported builtin native \(id)", uint64(1))
}

func invokeMathNative(prog mut Program, id uint32, args []Val) (Val, Val, string, uint64) {
	if id == NatMathInf {
		return (MakeFloatVal(prog.Types, TypeFloat64, math.Inf(int(Int64FromBits(args[0].Data)))), UnitVal(), "", uint64(1))
	}
	if id == NatMathNaN {
		return (MakeFloatVal(prog.Types, TypeFloat64, math.NaN()), UnitVal(), "", uint64(1))
	}
	if id == NatMathMaxInt {
		return (MakeIntVal(prog.Types, TypeInt, uint64(math.MaxInt())), UnitVal(), "", uint64(1))
	}
	if id == NatMathMinInt {
		return (MakeIntVal(prog.Types, TypeInt, uint64(math.MinInt())), UnitVal(), "", uint64(1))
	}
	if id == NatMathMaxInt64 {
		return (MakeIntVal(prog.Types, TypeInt64, uint64(math.MaxInt64())), UnitVal(), "", uint64(1))
	}
	if id == NatMathMinInt64 {
		return (MakeIntVal(prog.Types, TypeInt64, uint64(math.MinInt64())), UnitVal(), "", uint64(1))
	}
	let x = Float64FromBits(args[0].Data)
	if id == NatMathIsNaN {
		return (BoolVal(TypeBool, math.IsNaN(x)), UnitVal(), "", uint64(1))
	}
	if id == NatMathIsInf {
		return (BoolVal(TypeBool, math.IsInf(x, int(Int64FromBits(args[1].Data)))), UnitVal(), "", uint64(1))
	}
	if id == NatMathToInt {
		let n = math.ToInt(x) catch {
		case math.OutOfRange as o:
			let e = makeStdErr(prog, "math", "OutOfRange", []string{"Value"}, []uint32{TypeFloat64}, []Val{MakeFloatVal(prog.Types, TypeFloat64, o.Value)})
			return (UnitVal(), e, "", uint64(1))
		}
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(n))), UnitVal(), "", uint64(1))
	}
	let res = if id == NatMathAbs { math.Abs(x) } else if id == NatMathCeil { math.Ceil(x) } else if id == NatMathFloor { math.Floor(x) } else if id == NatMathTrunc { math.Trunc(x) } else if id == NatMathRound { math.Round(x) } else if id == NatMathSqrt { math.Sqrt(x) } else if id == NatMathPow { math.Pow(x, Float64FromBits(args[1].Data)) } else if id == NatMathFMA { math.FMA(x, Float64FromBits(args[1].Data), Float64FromBits(args[2].Data)) } else if id == NatMathMod { math.Mod(x, Float64FromBits(args[1].Data)) } else if id == NatMathLog { math.Log(x) } else if id == NatMathExp { math.Exp(x) } else if id == NatMathSin { math.Sin(x) } else if id == NatMathCos { math.Cos(x) } else if id == NatMathTan { math.Tan(x) } else if id == NatMathAsin { math.Asin(x) } else if id == NatMathAcos { math.Acos(x) } else if id == NatMathAtan { math.Atan(x) } else if id == NatMathAtan2 { math.Atan2(x, Float64FromBits(args[1].Data)) } else if id == NatMathHypot { math.Hypot(x, Float64FromBits(args[1].Data)) } else if id == NatMathCbrt { math.Cbrt(x) } else if id == NatMathLog2 { math.Log2(x) } else { math.Log10(x) }
	(MakeFloatVal(prog.Types, TypeFloat64, res), UnitVal(), "", uint64(1))
}

func invokeBitsNative(prog mut Program, id uint32, args []Val) (Val, Val, string, uint64) {
	if id == NatBitsOnesCount {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.OnesCount(uint(args[0].Data))))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsOnesCount64 {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.OnesCount64(args[0].Data)))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsLeadingZeros {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.LeadingZeros(uint(args[0].Data))))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsLeadingZeros64 {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.LeadingZeros64(args[0].Data)))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsTrailingZeros {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.TrailingZeros(uint(args[0].Data))))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsTrailingZeros64 {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.TrailingZeros64(args[0].Data)))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsLen {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.Len(uint(args[0].Data))))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsLen64 {
		return (MakeIntVal(prog.Types, TypeInt, uint64(int64(bits.Len64(args[0].Data)))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsRotateLeft32 {
		return (MakeIntVal(prog.Types, TypeUint32, uint64(bits.RotateLeft32(uint32(args[0].Data), int(Int64FromBits(args[1].Data))))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsRotateLeft64 {
		return (MakeIntVal(prog.Types, TypeUint64, bits.RotateLeft64(args[0].Data, int(Int64FromBits(args[1].Data)))), UnitVal(), "", uint64(1))
	}
	if id == NatBitsAdd64 {
		let (sum, carry) = bits.Add64(args[0].Data, args[1].Data, args[2].Data)
		let tt = InternTuple(&prog.Types, []uint32{TypeUint64, TypeUint64})
		return (MakeTupleVal(&prog.Arena, tt, []Val{MakeIntVal(prog.Types, TypeUint64, sum), MakeIntVal(prog.Types, TypeUint64, carry)}), UnitVal(), "", uint64(1))
	}
	if id == NatBitsSub64 {
		let (diff, borrow) = bits.Sub64(args[0].Data, args[1].Data, args[2].Data)
		let tt = InternTuple(&prog.Types, []uint32{TypeUint64, TypeUint64})
		return (MakeTupleVal(&prog.Arena, tt, []Val{MakeIntVal(prog.Types, TypeUint64, diff), MakeIntVal(prog.Types, TypeUint64, borrow)}), UnitVal(), "", uint64(1))
	}
	if id == NatBitsMul64 {
		let (hi, lo) = bits.Mul64(args[0].Data, args[1].Data)
		let tt = InternTuple(&prog.Types, []uint32{TypeUint64, TypeUint64})
		return (MakeTupleVal(&prog.Arena, tt, []Val{MakeIntVal(prog.Types, TypeUint64, hi), MakeIntVal(prog.Types, TypeUint64, lo)}), UnitVal(), "", uint64(1))
	}
	if id == NatBitsDiv64 {
		let hi = args[0].Data
		let lo = args[1].Data
		let y = args[2].Data
		if y == uint64(0) || y <= hi {
			return (UnitVal(), UnitVal(), "runtime error: integer divide error", uint64(1))
		}
		let (q, r) = bits.Div64(hi, lo, y)
		let tt = InternTuple(&prog.Types, []uint32{TypeUint64, TypeUint64})
		return (MakeTupleVal(&prog.Arena, tt, []Val{MakeIntVal(prog.Types, TypeUint64, q), MakeIntVal(prog.Types, TypeUint64, r)}), UnitVal(), "", uint64(1))
	}
	(UnitVal(), UnitVal(), "unsupported bits native", uint64(1))
}

law StdNativeLookupRecognizesCoreAndStdlib() {
	ResolveStdNativeID("strings", "Split") == NatStrSplit && ResolveStdNativeID("slices", "Sort") == NatSlicesSort && ResolveStdNativeID("math", "Sqrt") == NatMathSqrt && ResolveStdNativeID("strconv", "Atoi") == NatStrconvAtoi && ResolveStdNativeID("option", "Map") == NatCbOptionMap && ResolveStdNativeID("core", "Append") == NatAppend
}
