		0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
	}
	let mut padded = slices.WithCapacity[byte](msg.Len() + 144)
	for b in msg {
		padded = padded.Append(b)
	}
	padded = padded.Append(byte(0x80))
	for padded.Len()%128 != 112 {
		padded = padded.Append(byte(0))
	}
	for _ in 0..8 {
		padded = padded.Append(byte(0))
	}
	let bitLen = uint64(msg.Len()) * uint64(8)
	for sh in []int{56, 48, 40, 32, 24, 16, 8, 0} {
		padded = padded.Append(byte(bitLen >> sh))
	}
	let mut w = slices.WithCapacity[uint64](80)
	for _ in 0..80 {
		w = w.Append(uint64(0))
	}
	let mut off = 0
	for off < padded.Len() {
		for i in 0..16 {
			let j = off + i*8
			w[i] = (uint64(padded[j]) << 56) | (uint64(padded[j+1]) << 48) | (uint64(padded[j+2]) << 40) | (uint64(padded[j+3]) << 32) | (uint64(padded[j+4]) << 24) | (uint64(padded[j+5]) << 16) | (uint64(padded[j+6]) << 8) | uint64(padded[j+7])
		}
		for i in 16..80 {
			let s0 = rotr64(w[i-15], 1) ^ rotr64(w[i-15], 8) ^ (w[i-15] >> 7)
			let s1 = rotr64(w[i-2], 19) ^ rotr64(w[i-2], 61) ^ (w[i-2] >> 6)
			w[i] = w[i-16] + s0 + w[i-7] + s1
		}
		let mut a = h[0]
		let mut b = h[1]
		let mut c = h[2]
		let mut d = h[3]
		let mut e = h[4]
		let mut f = h[5]
		let mut g = h[6]
		let mut hh = h[7]
		for i in 0..80 {
			let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
			let ch = (e & f) ^ ((e ^ u64AllOnes) & g)
			let temp1 = hh + s1 + ch + ks[i] + w[i]
			let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
			let maj = (a & b) ^ (a & c) ^ (b & c)
			let temp2 = s0 + maj
			hh = g
			g = f
			f = e
			e = d + temp1
			d = c
			c = b
			b = a
			a = temp1 + temp2
		}
		h[0] = h[0] + a
		h[1] = h[1] + b
		h[2] = h[2] + c
		h[3] = h[3] + d
		h[4] = h[4] + e
		h[5] = h[5] + f
		h[6] = h[6] + g
		h[7] = h[7] + hh
		off = off + 128
	}
	let mut out = slices.WithCapacity[byte](64)
	for hv in h {
		for sh in []int{56, 48, 40, 32, 24, 16, 8, 0} {
			out = out.Append(byte(hv >> sh))
		}
	}
	out
}

func sha256SumBytes(msg []byte) []byte {
	let arr = sha256.Sum256(msg)
	let mut out = slices.WithCapacity[byte](32)
	for i in 0..32 {
		out = out.Append(arr[i])
	}
	out
}

func hashByAlg(alg int64, msg []byte) []byte {
	if alg == int64(256) {
		return sha256SumBytes(msg)
	}
	if alg == int64(512) {
		return sha512SumBytes(msg)
	}
	sha1SumBytes(msg)
}

func makePadBlock(alg int64, key string, blockSize int, pad byte) string {
	let mut k = key.Bytes()
	if k.Len() > blockSize {
		k = hashByAlg(alg, k)
	}
	let mut b = slices.WithCapacity[byte](blockSize)
	for i in 0..blockSize {
		let v = if i < k.Len() { pad ^ k[i] } else { pad }
		b = b.Append(v)
	}
	strings.FromBytes(b)
}

func computeKeyedPadsSum(alg int64, innerPad []byte, outerPad []byte, msg []byte) []byte {
	let mut inBuf = slices.WithCapacity[byte](innerPad.Len() + msg.Len())
	for b in innerPad { inBuf = inBuf.Append(b) }
	for b in msg { inBuf = inBuf.Append(b) }
	let innerSum = hashByAlg(alg, inBuf)
	let mut outBuf = slices.WithCapacity[byte](outerPad.Len() + innerSum.Len())
	for b in outerPad { outBuf = outBuf.Append(b) }
	for b in innerSum { outBuf = outBuf.Append(b) }
	hashByAlg(alg, outBuf)
}

func computeHmacWithHash(alg int64, key string, msg []byte) []byte {
	let block = if alg == int64(512) { 128 } else { 64 }
	let ip = strings.Bytes(makePadBlock(alg, key, block, byte(0x36)))
	let op = strings.Bytes(makePadBlock(alg, key, block, byte(0x5c)))
	computeKeyedPadsSum(alg, ip, op, msg)
}

func base64Alphabet(std bool) string {
	if std {
		return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	}
	"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
}

func base64EncodePure(std bool, padded bool, bs []byte) string {
	let alpha = base64Alphabet(std)
	let mut out = slices.WithCapacity[byte]((bs.Len() + 2) / 3 * 4)
	let mut i = 0
	for i < bs.Len() {
		let rem = bs.Len() - i
		let b0 = uint32(bs[i])
		let b1 = if rem > 1 { uint32(bs[i+1]) } else { uint32(0) }
		let b2 = if rem > 2 { uint32(bs[i+2]) } else { uint32(0) }
		let val = (b0 << 16) | (b1 << 8) | b2
		out = out.Append(alpha[int((val>>18)&uint32(63))])
		out = out.Append(alpha[int((val>>12)&uint32(63))])
		if rem > 1 {
			out = out.Append(alpha[int((val>>6)&uint32(63))])
		} else if padded {
			out = out.Append(byte('='))
		}
		if rem > 2 {
			out = out.Append(alpha[int(val&uint32(63))])
		} else if padded {
			out = out.Append(byte('='))
		}
		i = i + 3
	}
	strings.FromBytes(out)
}

func resolveBase64Marker(marker string) (bool, bool, bool) {
	if marker == "__govar__:encoding/base64.StdEncoding" {
		return (true, true, true)
	}
	if marker == "__govar__:encoding/base64.URLEncoding" {
		return (false, true, true)
	}
	if marker == "__govar__:encoding/base64.RawStdEncoding" {
		return (true, false, true)
	}
	if marker == "__govar__:encoding/base64.RawURLEncoding" {
		return (false, false, true)
	}
	(true, true, false)
}

func base64Lookup(alpha string, c byte) int {
	for i in 0..64 {
		if alpha[i] == c {
			return i
		}
	}
	-1
}

func base64DecodeChecked(prog mut Program, std bool, s string) (Val, Val) {
	let alpha = base64Alphabet(std)
	let mut toks = []int{}
	let mut eqOffs = []int{}
	let mut eqCount = 0
	for i in 0..s.Len() {
		let c = s[i]
		if c == byte('\r') || c == byte('\n') {
			continue
		}
		if c == byte('=') {
			eqOffs = eqOffs.Append(i)
			eqCount = eqCount + 1
			if eqCount > 2 {
				return (UnitVal(), makeStdRecordVal(prog, "Malformed", []string{"Offset"}, []Val{MakeIntVal(prog.Types, TypeInt, uint64(i))}))
			}
			continue
		}
		if eqCount > 0 {
			return (UnitVal(), makeStdRecordVal(prog, "Malformed", []string{"Offset"}, []Val{MakeIntVal(prog.Types, TypeInt, uint64(i))}))
		}
		let v = base64Lookup(alpha, c)
		if v < 0 {
			return (UnitVal(), makeStdRecordVal(prog, "Malformed", []string{"Offset"}, []Val{MakeIntVal(prog.Types, TypeInt, uint64(i))}))
		}
		toks = toks.Append(v)
	}
	if (toks.Len()+eqCount)%4 != 0 || toks.Len()%4 == 1 {
		let errAt = if eqOffs.Len() > 0 { eqOffs[0] } else { toks.Len() }
		return (UnitVal(), makeStdRecordVal(prog, "Malformed", []string{"Offset"}, []Val{MakeIntVal(prog.Types, TypeInt, uint64(errAt))}))
	}
	let mut out = []byte{}
	let mut idx = 0
	for idx < toks.Len() {
		let rem = toks.Len() - idx
		let v0 = toks[idx]
		let v1 = toks[idx+1]
		out = out.Append(byte((v0 << 2) | (v1 >> 4)))
		if rem > 2 {
			let v2 = toks[idx+2]
			out = out.Append(byte(((v1 & 15) << 4) | (v2 >> 2)))
			if rem > 3 {
				let v3 = toks[idx+3]
				out = out.Append(byte(((v2 & 3) << 6) | v3))
			}
		}
		idx = idx + 4
	}
	(AllocStrVal(&prog.Arena, TypeString, strings.FromBytes(out)), UnitVal())
}

// ResolveRound2PureNativeID maps Round 2 stdlib and pure Go native full names to Nat* IDs.
func ResolveRound2PureNativeID(fullName string) uint32 {
	if fullName == "math.ToInt8" { return NatMathToInt8 }
	if fullName == "math.ToInt16" { return NatMathToInt16 }
	if fullName == "math.ToInt32" { return NatMathToInt32 }
	if fullName == "math.ToInt64" { return NatMathToInt64 }
	if fullName == "math.ToUint" { return NatMathToUint }
	if fullName == "math.ToUint8" { return NatMathToUint8 }
	if fullName == "math.ToUint16" { return NatMathToUint16 }
	if fullName == "math.ToUint32" { return NatMathToUint32 }
	if fullName == "math.ToUint64" { return NatMathToUint64 }
	if fullName == "math.ToUintptr" { return NatMathToUintptr }
	if fullName == "math.Float64bits" { return NatMathFloat64bits }
	if fullName == "math.Float64frombits" { return NatMathFloat64frombits }
	if fullName == "math.Float32bits" { return NatMathFloat32bits }
	if fullName == "math.Float32frombits" { return NatMathFloat32frombits }
	if fullName == "strings.Compare" { return NatStrCompare }
	if fullName == "strings.stringsBytes" { return NatStrStringsBytes }
	if fullName == "strings.Hint" { return NatStrHint }
	if fullName == "strings.Borrow" { return NatStrBorrow }
	if fullName == "strings.Give" { return NatStrGive }
	if fullName == "strings.builderText" { return NatStrBuilderText }
	if fullName == "strings.builderAppend" { return NatStrBuilderAppend }
	if fullName == "strings.builderAppendByte" { return NatStrBuilderAppendByte }
	if fullName == "strings.builderAppendBytes" { return NatStrBuilderAppendBytes }
	if fullName == "strings.builderAppendFrom" { return NatStrBuilderAppendFrom }
	if fullName == "strings.builderGrow" { return NatStrBuilderGrow }
	if fullName == "strconv.QuoteRune" { return NatStrconvQuoteRune }
	if fullName == "slices.WithCapacity" { return NatSlicesWithCapacity }
	if fullName == "arena.grow" { return NatArenaGrow }
	if fullName == "fs.Clone" { return NatFsClone }
	if fullName == "fs.MapText" { return NatFsMapText }
	if fullName == "sha1.Sum" { return NatSha1Sum }
	if fullName == "sha512.Sum" { return NatSha512Sum }
	if fullName == "crypto/sha256.Sum256" { return NatSha256Sum256 }
	if fullName == "hmac.sum1" { return NatHmacSum1 }
	if fullName == "hmac.sum256" { return NatHmacSum256 }
	if fullName == "hmac.sum512" { return NatHmacSum512 }
	if fullName == "hmac.Equal" { return NatHmacEqual }
	if fullName == "hmac.keyState" { return NatHmacKeyState }
	if fullName == "hmac.keyedSum" { return NatHmacKeyedSum }
	if fullName == "totp.keyState" { return NatTotpKeyState }
	if fullName == "totp.hotpNumber" { return NatTotpHotpNumber }
	if fullName == "base64.decodeStd" { return NatBase64DecodeStd }
	if fullName == "base64.decodeURL" { return NatBase64DecodeURL }
	if fullName == "encoding/base64.Encoding.EncodeToString" { return NatBase64EncodeToString }
	if fullName == "hash/crc32.Update" { return NatCrc32Update }
	if fullName == "hash/crc32.ChecksumIEEE" { return NatCrc32ChecksumIEEE }
	if fullName == "filepath.Join" || fullName == "path/filepath.Join" { return NatFilepathJoin }
	if fullName == "filepath.Rel" || fullName == "path/filepath.Rel" { return NatFilepathRel }
	if fullName == "path/filepath.Split" || fullName == "filepath.Split" { return NatFilepathSplit }
	if fullName == "path/filepath.Base" || fullName == "filepath.Base" { return NatFilepathBase }
	if fullName == "path/filepath.Dir" || fullName == "filepath.Dir" { return NatFilepathDir }
	if fullName == "filepath.Ext" || fullName == "path/filepath.Ext" { return NatFilepathExt }
	if fullName == "path/filepath.Clean" || fullName == "filepath.Clean" { return NatFilepathClean }
	if fullName == "path/filepath.IsAbs" || fullName == "filepath.IsAbs" { return NatFilepathIsAbs }
	if fullName == "http.EncodeQuery" { return NatHttpEncodeQuery }
	if fullName == "time.DurationText" { return NatTimeDurationText }
	if fullName == "time.ParseDuration" { return NatTimeParseDuration }
	if fullName == "time.DurationISO" { return NatTimeDurationISO }
	if fullName == "time.ParseDurationISO" { return NatTimeParseDurationISO }
	if fullName == "time.truncate" { return NatTimeTruncate }
	if fullName == "time.round" { return NatTimeRound }
	if fullName == "time.appendUTC" { return NatTimeAppendUTC }
	if fullName == "time.format" { return NatTimeFormat }
	if fullName == "time.parse" { return NatTimeParse }
	if fullName == "civil.buffer" { return NatCivilBuffer }
	if fullName == "civil.bytesText" { return NatCivilBytesText }
	if fullName == "json.appendQuoted" { return NatJsonAppendQuoted }
	if fullName == "json.appendQuotedBytes" { return NatJsonAppendQuotedBytes }
	if fullName == "json.appendInt" { return NatJsonAppendInt }
	if fullName == "json.appendUint" { return NatJsonAppendUint }
	if fullName == "json.appendBool" { return NatJsonAppendBool }
	if fullName == "json.appendFloat" { return NatJsonAppendFloat }
	if fullName == "json.bytesText" { return NatJsonBytesText }
	if fullName == "json.isNumber" { return NatJsonIsNumber }
	if fullName == "json.open" { return NatJsonOpen }
	if fullName == "json.openChecked" { return NatJsonOpenChecked }
	if fullName == "json.settleText" { return NatJsonSettleText }
	if fullName == "toml.parse" { return NatTomlParse }
	if fullName == "csv.ReadAll" { return NatCsvReadAll }
	if fullName == "csv.Format" { return NatCsvFormat }
	if fullName == "csv.scan" { return NatCbCsvScan }
	if fullName == "build.InFold" { return NatBuildInFold }
	if fullName == "build.Known" { return NatBuildKnown }
	if fullName == "build.Hole" { return NatBuildHole }
	if fullName == "unicode.IsLetter" { return NatUnicodeIsLetter }
	if fullName == "unicode.IsDigit" { return NatUnicodeIsDigit }
	if fullName == "unicode.IsSpace" { return NatUnicodeIsSpace }
	if fullName == "unicode.IsUpper" { return NatUnicodeIsUpper }
	NatNone
}

func pow2Float64(exp int) float64 {
	let mut r = 1.0
	for i in 0..exp {
		let _ = i
		r = r * 2.0
	}
	r
}

func hmacEqualStrings(a string, b string) bool {
	if a.Len() != b.Len() {
		return false
	}
	let mut diff = byte(0)
	for i in 0..a.Len() {
		diff = diff | (a[i] ^ b[i])
	}
	diff == byte(0)
}

func queryEscapeStr(s string) string {
	let hexChars = "0123456789ABCDEF"
	let mut out = slices.WithCapacity[byte](s.Len())
	for i in 0..s.Len() {
		let c = s[i]
		let keep = (c >= byte('a') && c <= byte('z')) || (c >= byte('A') && c <= byte('Z')) || (c >= byte('0') && c <= byte('9')) || c == byte('-') || c == byte('_') || c == byte('.') || c == byte('~')
		if keep {
			out = out.Append(c)
		} else if c == byte(' ') {
			out = out.Append(byte('+'))
		} else {
			out = out.Append(byte('%'))
			out = out.Append(hexChars[int(c>>4)])
			out = out.Append(hexChars[int(c&15)])
		}
	}
	strings.FromBytes(out)
}

func mathConvChecked(prog mut Program, f float64, bits int, signed bool, targetType uint32) (Val, Val) {
	let lo = if signed { -pow2Float64(bits - 1) } else { 0.0 }
	let hi = if signed { pow2Float64(bits - 1) } else { pow2Float64(bits) }
	let tr = math.Trunc(f)
	if !math.IsNaN(f) && tr >= lo && tr < hi {
		let u = if signed { uint64(int64(tr)) } else { uint64(tr) }
		return (MakeIntVal(prog.Types, targetType, u), UnitVal())
	}
	(UnitVal(), makeStdRecordVal(prog, "OutOfRange", []string{"Value"}, []Val{MakeFloatVal(prog.Types, TypeFloat64, f)}))
}

// InvokeRound2PureNative dispatches Round 2 pure stdlib and Go natives cleanly.
func InvokeRound2PureNative(prog mut Program, na mut NativeObjArena, inFold bool, id uint32, args []Val) (Val, Val, string, uint64) {
	if id >= NatMathToInt8 && id <= NatMathToUintptr && args.Len() > 0 {
		let f = Float64FromBits(args[0].Data)
		let (bits, signed, tt) = if id == NatMathToInt8 {
			(8, true, TypeInt8)
		} else if id == NatMathToInt16 {
			(16, true, TypeInt16)
		} else if id == NatMathToInt32 {
			(32, true, TypeInt32)
		} else if id == NatMathToInt64 {
			(64, true, TypeInt64)
		} else if id == NatMathToUint8 {
			(8, false, TypeUint8)
		} else if id == NatMathToUint16 {
			(16, false, TypeUint16)
		} else if id == NatMathToUint32 {
			(32, false, TypeUint32)
		} else if id == NatMathToUint64 {
			(64, false, TypeUint64)
		} else {
			(64, false, TypeUint)
		}
		let (res, fl) = mathConvChecked(prog, f, bits, signed, tt)
		return (res, fl, "", uint64(1))
	}
	if id == NatMathFloat64bits {
		return (MakeIntVal(prog.Types, TypeUint64, args[0].Data), UnitVal(), "", uint64(1))
	}
	if id == NatMathFloat64frombits {
		return (Val{Tag: TagFloat, Type: TypeFloat64, Aux: uint32(0), Data: args[0].Data}, UnitVal(), "", uint64(1))
	}
	if id == NatMathFloat32bits {
		let f32 = float32(Float64FromBits(args[0].Data))
		return (MakeIntVal(prog.Types, TypeUint32, uint64(math.Float32bits(f32))), UnitVal(), "", uint64(1))
	}
	if id == NatMathFloat32frombits {
		let f32 = math.Float32frombits(uint32(args[0].Data))
		return (MakeFloatVal(prog.Types, TypeFloat32, float64(f32)), UnitVal(), "", uint64(1))
	}
	if id == NatUnicodeIsLetter {
		return (BoolVal(TypeBool, unicode.IsLetter(rune(args[0].Data))), UnitVal(), "", uint64(1))
	}
	if id == NatUnicodeIsDigit {
		return (BoolVal(TypeBool, unicode.IsDigit(rune(args[0].Data))), UnitVal(), "", uint64(1))
	}
	if id == NatUnicodeIsSpace {
		return (BoolVal(TypeBool, unicode.IsSpace(rune(args[0].Data))), UnitVal(), "", uint64(1))
	}
	if id == NatUnicodeIsUpper {
		return (BoolVal(TypeBool, unicode.IsUpper(rune(args[0].Data))), UnitVal(), "", uint64(1))
	}
	if id == NatStrconvQuoteRune {
		return (AllocStrVal(&prog.Arena, TypeString, strconv.QuoteRune(rune(args[0].Data))), UnitVal(), "", uint64(1))
	}
	if id == NatStrCompare {
		let a = ReadStr(prog.Arena, args[0])
		let b = ReadStr(prog.Arena, args[1])
		let c = if a < b { int64(-1) } else if a > b { int64(1) } else { int64(0) }
		return (MakeIntVal(prog.Types, TypeInt, uint64(c)), UnitVal(), "", uint64(1))
	}
	if id == NatStrStringsBytes {
		let s = ReadStr(prog.Arena, args[0])
		return (makeBytesSlice(prog, strings.Bytes(s)), UnitVal(), "", uint64(1 + s.Len()))
	}
	if id == NatStrHint {
		return (MakeIntVal(prog.Types, TypeInt, uint64(0)), UnitVal(), "", uint64(1))
	}
	if id == NatStrBorrow || id == NatCivilBuffer {
		return (MakeSliceVal(&prog.Arena, TypeBytes, []Val{}, uint32(0)), UnitVal(), "", uint64(1))
	}
	if id == NatStrGive {
		return (args[0], UnitVal(), "", uint64(1))
	}
	if id == NatStrBuilderText || id == NatJsonBytesText || id == NatCivilBytesText {
		let (_, txt, ok) = readBytesFromSlice(prog.Arena, args[0])
		if !ok {
			return (UnitVal(), UnitVal(), "bytes the evaluator does not hold", uint64(1))
		}
		return (AllocStrVal(&prog.Arena, TypeString, txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatStrBuilderGrow {
		let n = Int64FromBits(args[1].Data)
		if n < int64(0) {
			return (UnitVal(), UnitVal(), "strings.Builder.Grow: negative count", uint64(1))
		}
		return (args[0], UnitVal(), "", uint64(1))
	}
	if id == NatStrBuilderAppend {
		let txt = ReadStr(prog.Arena, args[1])
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatStrBuilderAppendByte {
		return (AppendSliceValCOW(&prog.Arena, args[0], MakeIntVal(prog.Types, TypeUint8, args[1].Data&uint64(0xff))), UnitVal(), "", uint64(1))
	}
	if id == NatStrBuilderAppendBytes {
		let (_, txt, ok) = readBytesFromSlice(prog.Arena, args[1])
		if !ok {
			return (UnitVal(), UnitVal(), "bytes the evaluator does not hold", uint64(1))
		}
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatStrBuilderAppendFrom {
		let (_, txt, ok) = readBytesFromSlice(prog.Arena, args[0])
		if !ok {
			return (UnitVal(), UnitVal(), "bytes the evaluator does not hold", uint64(1))
		}
		let start = Int64FromBits(args[1].Data)
		let count = Int64FromBits(args[2].Data)
		if start < int64(0) || count < int64(0) || start+count > int64(txt.Len()) {
			return (UnitVal(), UnitVal(), "runtime error: slice bounds out of range", uint64(1))
		}
		let seg = txt[int(start):int(start+count)]
		return (appendTextToBytesSlice(prog, args[0], seg), UnitVal(), "", uint64(1 + seg.Len()))
	}
	if id == NatSlicesWithCapacity {
		let n = Int64FromBits(args[0].Data)
		if n < int64(0) {
			return (UnitVal(), UnitVal(), "runtime error: makeslice: cap out of range", uint64(1))
		}
		return (MakeSliceVal(&prog.Arena, TypeVoid, []Val{}, uint32(0)), UnitVal(), "", uint64(1))
	}
	if id == NatArenaGrow {
		return (AppendSliceValCOW(&prog.Arena, args[0], args[1]), UnitVal(), "", uint64(1))
	}
	if id == NatFsClone {
		return (args[0], UnitVal(), "", uint64(1))
	}
	if id == NatFsMapText {
		let txt = ReadStr(prog.Arena, args[0])
		return (AllocFsMapped(na, TypeVoid, txt), UnitVal(), "", uint64(1))
	}
	if id == NatBuildInFold {
		return (BoolVal(TypeBool, inFold), UnitVal(), "", uint64(1))
	}
	if id == NatBuildKnown {
		return (BoolVal(TypeBool, inFold), UnitVal(), "", uint64(1))
	}
	if id == NatBuildHole {
		return (BoolVal(TypeBool, false), UnitVal(), "", uint64(1))
	}
	if id == NatSha1Sum {
		let s = ReadStr(prog.Arena, args[0])
		let sum = sha1SumBytes(strings.Bytes(s))
		return (AllocStrVal(&prog.Arena, TypeString, strings.FromBytes(sum)), UnitVal(), "", uint64(1 + s.Len()))
	}
	if id == NatSha512Sum {
		let s = ReadStr(prog.Arena, args[0])
		let sum = sha512SumBytes(strings.Bytes(s))
		return (AllocStrVal(&prog.Arena, TypeString, strings.FromBytes(sum)), UnitVal(), "", uint64(1 + s.Len()))
	}
	if id == NatSha256Sum256 {
		let (bs, _, ok) = readBytesFromSlice(prog.Arena, args[0])
		if !ok {
			return (UnitVal(), UnitVal(), "crypto/sha256.Sum256 of bytes the evaluator does not hold", uint64(1))
		}
		let arr = sha256.Sum256(bs)
		let mut elems = slices.WithCapacity[Val](32)
		for i in 0..32 {
			elems = elems.Append(MakeIntVal(prog.Types, TypeUint8, uint64(arr[i])))
		}
		return (MakeArrayVal(&prog.Arena, TypeBytes, elems), UnitVal(), "", uint64(1 + bs.Len()))
	}
	if id == NatHmacSum1 || id == NatHmacSum256 || id == NatHmacSum512 {
		let alg = if id == NatHmacSum256 { int64(256) } else if id == NatHmacSum512 { int64(512) } else { int64(1) }
		let k = ReadStr(prog.Arena, args[0])
		let m = ReadStr(prog.Arena, args[1])
		let out = computeHmacWithHash(alg, k, strings.Bytes(m))
		return (AllocStrVal(&prog.Arena, TypeString, strings.FromBytes(out)), UnitVal(), "", uint64(1 + k.Len() + m.Len()))
	}
	if id == NatHmacEqual {
		let a = ReadStr(prog.Arena, args[0])
		let b = ReadStr(prog.Arena, args[1])
		return (BoolVal(TypeBool, hmacEqualStrings(a, b)), UnitVal(), "", uint64(1 + a.Len()))
	}
	if id == NatHmacKeyState {
		let alg = Int64FromBits(args[0].Data)
		let key = ReadStr(prog.Arena, args[1])
		let block = if alg == int64(512) { 128 } else { 64 }
		let ipad = AllocStrVal(&prog.Arena, TypeString, makePadBlock(alg, key, block, byte(0x36)))
		let opad = AllocStrVal(&prog.Arena, TypeString, makePadBlock(alg, key, block, byte(0x5c)))
		return (MakeTupleVal(&prog.Arena, TypeVoid, []Val{ipad, opad}), UnitVal(), "", uint64(1 + key.Len()))
	}
	if id == NatHmacKeyedSum {
		let alg = Int64FromBits(args[0].Data)
		let ipad = ReadStr(prog.Arena, args[1])
		let opad = ReadStr(prog.Arena, args[2])
		let msg = ReadStr(prog.Arena, args[3])
		let out = computeKeyedPadsSum(alg, strings.Bytes(ipad), strings.Bytes(opad), strings.Bytes(msg))
		return (AllocStrVal(&prog.Arena, TypeString, strings.FromBytes(out)), UnitVal(), "", uint64(1 + msg.Len()))
	}
	if id == NatTotpKeyState {
		let key = ReadStr(prog.Arena, args[0])
		let ipad = makeBytesSlice(prog, strings.Bytes(makePadBlock(int64(1), key, 64, byte(0x36))))
		let opad = makeBytesSlice(prog, strings.Bytes(makePadBlock(int64(1), key, 64, byte(0x5c))))
		return (MakeTupleVal(&prog.Arena, TypeVoid, []Val{ipad, opad}), UnitVal(), "", uint64(1 + key.Len()))
	}
	if id == NatTotpHotpNumber {
		let (ip, _, ok1) = readBytesFromSlice(prog.Arena, args[0])
		let (op, _, ok2) = readBytesFromSlice(prog.Arena, args[1])
		if !ok1 || !ok2 {
			return (UnitVal(), UnitVal(), "totp: a key state that totp.KeyOf did not give", uint64(1))
		}
		let step = args[2].Data
		let msg = []byte{
			byte(step >> 56), byte(step >> 48), byte(step >> 40), byte(step >> 32),
			byte(step >> 24), byte(step >> 16), byte(step >> 8), byte(step),
		}
		let h = computeKeyedPadsSum(int64(1), ip, op, msg)
		let off = int(h[h.Len()-1] & byte(15))
		let code = ((uint32(h[off]) & uint32(0x7f)) << 24) | (uint32(h[off+1]) << 16) | (uint32(h[off+2]) << 8) | uint32(h[off+3])
		return (MakeIntVal(prog.Types, TypeInt, uint64(code)), UnitVal(), "", uint64(1))
	}
	if id == NatBase64DecodeStd {
		let s = ReadStr(prog.Arena, args[0])
		let (v, fl) = base64DecodeChecked(prog, true, s)
		return (v, fl, "", uint64(1 + s.Len()))
	}
	if id == NatBase64DecodeURL {
		let s = ReadStr(prog.Arena, args[0])
		let (v, fl) = base64DecodeChecked(prog, false, s)
		return (v, fl, "", uint64(1 + s.Len()))
	}
	if id == NatBase64EncodeToString {
		let marker = ReadStr(prog.Arena, args[0])
		let (isStd, padded, okE) = resolveBase64Marker(marker)
		let (bs, _, okB) = readBytesFromSlice(prog.Arena, args[1])
		if !okE || !okB {
			return (UnitVal(), UnitVal(), "unsupported base64 encoding or bytes", uint64(1))
		}
		return (AllocStrVal(&prog.Arena, TypeString, base64EncodePure(isStd, padded, bs)), UnitVal(), "", uint64(1 + bs.Len()))
	}
	if id == NatCrc32Update {
		let crc = uint32(args[0].Data)
		let (bs, _, ok) = readBytesFromSlice(prog.Arena, args[2])
		if !ok {
			return (UnitVal(), UnitVal(), "hash/crc32.Update of unsupported table or bytes", uint64(1))
		}
		let next = crc32.Update(crc, crc32.IEEETable, bs)
		return (MakeIntVal(prog.Types, TypeUint32, uint64(next)), UnitVal(), "", uint64(1 + bs.Len()))
	}
	if id == NatCrc32ChecksumIEEE {
		let (bs, _, ok) = readBytesFromSlice(prog.Arena, args[0])
		if !ok {
			return (UnitVal(), UnitVal(), "hash/crc32.ChecksumIEEE of unsupported bytes", uint64(1))
		}
		return (MakeIntVal(prog.Types, TypeUint32, uint64(crc32.ChecksumIEEE(bs))), UnitVal(), "", uint64(1 + bs.Len()))
	}
	if id == NatFilepathJoin {
		let n = int(ReadSliceLen(prog.Arena, args[0]))
		let mut parts = slices.WithCapacity[string](n)
		for i in 0..n {
			parts = parts.Append(ReadStr(prog.Arena, ReadSliceElem(prog.Arena, args[0], uint32(i))))
		}
		return (AllocStrVal(&prog.Arena, TypeString, filepath.Join(parts)), UnitVal(), "", uint64(1 + n))
	}
	if id == NatFilepathRel {
		let base = ReadStr(prog.Arena, args[0])
		let target = ReadStr(prog.Arena, args[1])
		let mut ok = true
		let rel = filepath.Rel(base, target) catch {
		case _:
			ok = false
			""
		}
		if !ok {
			return (UnitVal(), makeStdRecordVal(prog, "NotRelative", []string{"Base", "Target"}, []Val{args[0], args[1]}), "", uint64(1))
		}
		return (AllocStrVal(&prog.Arena, TypeString, rel), UnitVal(), "", uint64(1 + base.Len() + target.Len()))
	}
	if id == NatFilepathSplit {
		let p = ReadStr(prog.Arena, args[0])
		let sp = filepath.Split(p)
		let rec = makeStdRecordVal(prog, "Parts", []string{"Dir", "File"}, []Val{AllocStrVal(&prog.Arena, TypeString, sp.Dir), AllocStrVal(&prog.Arena, TypeString, sp.File)})
		return (rec, UnitVal(), "", uint64(1 + p.Len()))
	}
	if id == NatFilepathBase {
		let p = ReadStr(prog.Arena, args[0])
		return (AllocStrVal(&prog.Arena, TypeString, filepath.Base(p)), UnitVal(), "", uint64(1 + p.Len()))
	}
	if id == NatFilepathDir {
		let p = ReadStr(prog.Arena, args[0])
		return (AllocStrVal(&prog.Arena, TypeString, filepath.Dir(p)), UnitVal(), "", uint64(1 + p.Len()))
	}
	if id == NatFilepathExt {
		let p = ReadStr(prog.Arena, args[0])
		return (AllocStrVal(&prog.Arena, TypeString, filepath.Ext(p)), UnitVal(), "", uint64(1 + p.Len()))
	}
	if id == NatFilepathClean {
		let p = ReadStr(prog.Arena, args[0])
		return (AllocStrVal(&prog.Arena, TypeString, filepath.Clean(p)), UnitVal(), "", uint64(1 + p.Len()))
	}
	if id == NatFilepathIsAbs {
		let p = ReadStr(prog.Arena, args[0])
		return (BoolVal(TypeBool, filepath.IsAbs(p)), UnitVal(), "", uint64(1 + p.Len()))
	}
	if id == NatHttpEncodeQuery {
		let n = int(ReadSliceLen(prog.Arena, args[0]))
		let mut parts = slices.WithCapacity[string](n)
		for i in 0..n {
			let rec = ReadSliceElem(prog.Arena, args[0], uint32(i))
			let f0 = ReadStr(prog.Arena, ReadPackElem(prog.Arena, rec, uint32(0)))
			let f1 = ReadStr(prog.Arena, ReadPackElem(prog.Arena, rec, uint32(1)))
			parts = parts.Append(queryEscapeStr(f0) + "=" + queryEscapeStr(f1))
		}
		return (AllocStrVal(&prog.Arena, TypeString, strings.Join(parts, "&")), UnitVal(), "", uint64(1 + n))
	}
	if id == NatTimeDurationText {
		return (AllocStrVal(&prog.Arena, TypeString, DurationText(Int64FromBits(args[0].Data))), UnitVal(), "", uint64(1))
	}
	if id == NatTimeParseDuration {
		let s = ReadStr(prog.Arena, args[0])
		let (d, err) = ParseDurationText(s)
		if err != "" {
			return (UnitVal(), makeStdRecordVal(prog, "ParseError", []string{"Layout", "Value", "Message"}, []Val{AllocStrVal(&prog.Arena, TypeString, ""), args[0], AllocStrVal(&prog.Arena, TypeString, err)}), "", uint64(1 + s.Len()))
		}
		return (MakeIntVal(prog.Types, TypeDuration, uint64(d)), UnitVal(), "", uint64(1 + s.Len()))
	}
	if id == NatTimeDurationISO {
		return (AllocStrVal(&prog.Arena, TypeString, DurationISO(Int64FromBits(args[0].Data))), UnitVal(), "", uint64(1))
	}
	if id == NatTimeParseDurationISO {
		let s = ReadStr(prog.Arena, args[0])
		let (d, err) = ParseDurationISO(s)
		if err != "" {
			return (UnitVal(), makeStdRecordVal(prog, "ParseError", []string{"Layout", "Value", "Message"}, []Val{AllocStrVal(&prog.Arena, TypeString, "ISO 8601 duration"), args[0], AllocStrVal(&prog.Arena, TypeString, err)}), "", uint64(1 + s.Len()))
		}
		return (MakeIntVal(prog.Types, TypeDuration, uint64(d)), UnitVal(), "", uint64(1 + s.Len()))
	}
	if id == NatTimeTruncate || id == NatTimeRound {
		let s = Int64FromBits(args[0].Data)
		let ns = Int64FromBits(args[1].Data)
		let d = Int64FromBits(args[2].Data)
		let (os, ons) = if id == NatTimeTruncate { timeTruncateUTC(s, ns, d) } else { timeRoundUTC(s, ns, d) }
		let rec = makeStdRecordVal(prog, "Reading", []string{"Sec", "Nsec", "Mono"}, []Val{
			MakeIntVal(prog.Types, TypeInt64, uint64(os)),
			MakeIntVal(prog.Types, TypeInt64, uint64(ons)),
			MakeIntVal(prog.Types, TypeInt64, uint64(0)),
		})
		return (rec, UnitVal(), "", uint64(1))
	}
	if id == NatTimeAppendUTC {
		let s = Int64FromBits(args[1].Data)
		let ns = Int64FromBits(args[2].Data)
		let layout = ReadStr(prog.Arena, args[3])
		let txt = formatTimeUTC(s, ns, layout)
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatTimeFormat {
		let s = Int64FromBits(args[0].Data)
		let ns = Int64FromBits(args[1].Data)
		let layout = ReadStr(prog.Arena, args[2])
		return (AllocStrVal(&prog.Arena, TypeString, formatTimeUTC(s, ns, layout)), UnitVal(), "", uint64(1 + layout.Len()))
	}
	if id == NatTimeParse {
		let layout = ReadStr(prog.Arena, args[0])
		let value = ReadStr(prog.Arena, args[1])
		let (s, ns, msg) = parseTimeUTC(layout, value)
		if msg != "" {
			return (UnitVal(), makeStdRecordVal(prog, "ParseError", []string{"Layout", "Value", "Message"}, []Val{args[0], args[1], AllocStrVal(&prog.Arena, TypeString, msg)}), "", uint64(1 + value.Len()))
		}
		let rec = makeStdRecordVal(prog, "Reading", []string{"Sec", "Nsec", "Mono"}, []Val{
			MakeIntVal(prog.Types, TypeInt64, uint64(s)),
			MakeIntVal(prog.Types, TypeInt64, uint64(ns)),
			MakeIntVal(prog.Types, TypeInt64, uint64(0)),
		})
		return (rec, UnitVal(), "", uint64(1 + value.Len()))
	}
	if id == NatJsonAppendQuoted {
		let txt = JsonQuote(ReadStr(prog.Arena, args[1]), args[2].Data != uint64(0))
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonAppendQuotedBytes {
		let (_, bsText, ok) = readBytesFromSlice(prog.Arena, args[1])
		if !ok {
			return (UnitVal(), UnitVal(), "json.appendQuotedBytes on bytes the evaluator does not hold", uint64(1))
		}
		let txt = JsonQuote(bsText, args[2].Data != uint64(0))
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonAppendInt {
		let txt = strconv.FormatInt(Int64FromBits(args[1].Data), 10)
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonAppendUint {
		let txt = strconv.FormatUint(args[1].Data, 10)
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonAppendBool {
		let txt = if args[1].Data == uint64(0) { "false" } else { "true" }
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonAppendFloat {
		let txt = JsonFloat(Float64FromBits(args[1].Data))
		return (appendTextToBytesSlice(prog, args[0], txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonIsNumber {
		let txt = ReadStr(prog.Arena, args[0])
		let mut tmpNa = NewNativeObjArena()
		let (root, _, why) = JsonParse(&tmpNa, txt, int64(0), int64(0))
		let isNum = why == "" && tmpNa.JsonNodeKind[int(root)] == uint8(2) && strings.TrimSpace(txt) == txt
		return (BoolVal(TypeBool, isNum), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonOpen || id == NatJsonOpenChecked {
		let txt = ReadStr(prog.Arena, args[0])
		let maxB = if args.Len() > 1 { Int64FromBits(args[1].Data) } else { int64(0) }
		let maxD = if args.Len() > 2 { Int64FromBits(args[2].Data) } else { int64(0) }
		let (root, off, why) = JsonParse(na, txt, maxB, maxD)
		if why != "" {
			return (UnitVal(), makeStdRecordVal(prog, "Malformed", []string{"Offset", "Reason"}, []Val{MakeIntVal(prog.Types, TypeInt, uint64(off)), AllocStrVal(&prog.Arena, TypeString, why)}), "", uint64(1 + txt.Len()))
		}
		return (AllocJsonCursor(na, TypeVoid, root), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatJsonSettleText {
		return (UnitVal(), UnitVal(), "", uint64(1))
	}
	if id == NatTomlParse {
		let txt = ReadStr(prog.Arena, args[0])
		let maxB = if args.Len() > 1 { Int64FromBits(args[1].Data) } else { int64(0) }
		let maxD = if args.Len() > 2 { Int64FromBits(args[2].Data) } else { int64(0) }
		let (out, line, key, reason) = TomlParse(txt, maxB, maxD)
		if reason != "" {
			return (UnitVal(), makeStdRecordVal(prog, "Malformed", []string{"Line", "Key", "Reason"}, []Val{
				MakeIntVal(prog.Types, TypeInt, uint64(line)),
				AllocStrVal(&prog.Arena, TypeString, key),
				AllocStrVal(&prog.Arena, TypeString, reason),
			}), "", uint64(1 + txt.Len()))
		}
		return (AllocStrVal(&prog.Arena, TypeString, out), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatCsvReadAll {
		let txt = ReadStr(prog.Arena, args[0])
		let (res, line, col, reason, msg) = csvParseAll(txt)
		if msg != "" {
			return (UnitVal(), makeStdRecordVal(prog, "ParseError", []string{"Line", "Column", "Reason", "Message"}, []Val{
				MakeIntVal(prog.Types, TypeInt, uint64(line)),
				MakeIntVal(prog.Types, TypeInt, uint64(col)),
				AllocStrVal(&prog.Arena, TypeString, reason),
				AllocStrVal(&prog.Arena, TypeString, msg),
			}), "", uint64(1 + txt.Len()))
		}
		let strSliceT = InternSlice(&prog.Types, TypeString)
		let mut rows = slices.WithCapacity[Val](res.Fields.Len())
		for row in res.Fields {
			let mut fVals = slices.WithCapacity[Val](row.Len())
			for f in row {
				fVals = fVals.Append(AllocStrVal(&prog.Arena, TypeString, f))
			}
			rows = rows.Append(MakeSliceVal(&prog.Arena, strSliceT, fVals, uint32(fVals.Len())))
		}
		return (MakeSliceVal(&prog.Arena, InternSlice(&prog.Types, strSliceT), rows, uint32(rows.Len())), UnitVal(), "", uint64(1 + txt.Len()))
	}
	if id == NatCsvFormat {
		let n = int(ReadSliceLen(prog.Arena, args[0]))
		let mut rows = slices.WithCapacity[[]string](n)
		for i in 0..n {
			let rVal = ReadSliceElem(prog.Arena, args[0], uint32(i))
			let m = int(ReadSliceLen(prog.Arena, rVal))
			let mut row = slices.WithCapacity[string](m)
			for j in 0..m {
				row = row.Append(ReadStr(prog.Arena, ReadSliceElem(prog.Arena, rVal, uint32(j))))
			}
			rows = rows.Append(row)
		}
		let txt = csvFormatAll(rows)
		return (AllocStrVal(&prog.Arena, TypeString, txt), UnitVal(), "", uint64(1 + txt.Len()))
	}
	(UnitVal(), UnitVal(), "unsupported native", uint64(1))
}

law DurationISORoundtripsNonMin(d int64) {
	let minI64 = int64(-9223372036854775807) - int64(1)
	if d != minI64 {
		let iso = DurationISO(d)
		let (back, err) = ParseDurationISO(iso)
		assert err == ""
		assert back == d
	}
	true
}

test CsvAndTimeFormatParseRoundtrip {
	let (parsed, l, c, rsn, msg) = csvParseAll("a,b\n\"c,d\",e\n")
	assert msg == "" && rsn == "" && l == 0 && c == 0
	assert parsed.Fields.Len() == 2
	assert parsed.Fields[1][0] == "c,d"
	assert csvFormatAll([][]string{[]string{""}, []string{"a", "b,c"}}) == "\"\"\na,\"b,c\"\n"
	let formatted = formatTimeUTC(int64(1700000000), int64(123000000), "2006-01-02T15:04:05.999999999Z07:00")
	let (sec, ns, perr) = parseTimeUTC("2006-01-02T15:04:05.999999999Z07:00", formatted)
	assert perr == ""
	assert sec == int64(1700000000) && ns == int64(123000000)
}
