// GoReadOnlyVarVal creates a tagged string marker representing a supported Go stdlib read-only variable.
func GoReadOnlyVarVal(arena mut ValArena, fullName string) Val {
	AllocStrVal(arena, TypeString, "__govar__:"+fullName)
}

func makeStdRecordVal(prog mut Program, typeName string, fieldNames []string, fieldVals []Val) Val {
	let mut resolvedTid = TypeVoid
	let tnLen = prog.Types.Name.Len()
	for i in 0..tnLen {
		let n = prog.Types.Name[i]
		if (n == typeName || strings.HasSuffix(n, "."+typeName)) && i < prog.Types.Count.Len() {
			let fStart = int(prog.Types.Aux[i])
			let fCnt = int(prog.Types.Count[i])
			if fCnt == fieldNames.Len() {
				let mut allHit = true
				for fn in fieldNames {
					let mut found = false
					for k in 0..fCnt {
						if fStart+k < prog.Types.FieldName.Len() && prog.Types.FieldName[fStart+k] == fn {
							found = true
							break
						}
					}
					if !found {
						allHit = false
						break
					}
				}
				if allHit {
					resolvedTid = uint32(i)
					break
				}
			}
		}
	}
	if resolvedTid == TypeVoid {
		let tid = LookupTypeByKey(prog.Types, LookupDeclKey(uint32(0), typeName, []uint32{}))
		resolvedTid = tid
	}
	if resolvedTid == TypeVoid {
		for i, n in prog.Types.Name {
			if n == typeName || strings.HasSuffix(n, "."+typeName) {
				resolvedTid = uint32(i)
				break
			}
		}
	}
	if resolvedTid == TypeVoid || int(resolvedTid) >= prog.Types.Kind.Len() {
		let tid = AllocNamedType(&prog.Types, KindRecord, uint32(0), typeName, uint32(0))
		if fieldNames.Len() > 0 {
			let mut ftypes = slices.WithCapacity[uint32](fieldVals.Len())
			for fv in fieldVals {
				ftypes = ftypes.Append(if fv.Type != TypeVoid { fv.Type } else { TypeString })
			}
			SetRecordFields(&prog.Types, tid, fieldNames, ftypes)
			prog.Types.DeclToType[LookupDeclKey(uint32(0), typeName, []uint32{})] = tid
		}
		return MakeRecordVal(&prog.Arena, tid, fieldVals)
	}
	let fStart = int(prog.Types.Aux[int(resolvedTid)])
	let fCnt = int(prog.Types.Count[int(resolvedTid)])
	if fCnt == 0 {
		if fieldNames.Len() > 0 && prog.Types.Kind[int(resolvedTid)] == KindRecord {
			let mut ftypes = slices.WithCapacity[uint32](fieldVals.Len())
			for fv in fieldVals {
				ftypes = ftypes.Append(if fv.Type != TypeVoid { fv.Type } else { TypeString })
			}
			SetRecordFields(&prog.Types, resolvedTid, fieldNames, ftypes)
		}
		return MakeRecordVal(&prog.Arena, resolvedTid, fieldVals)
	}
	let mut ordered = slices.WithCapacity[Val](fCnt)
	for i in 0..fCnt {
		let fname = prog.Types.FieldName[fStart+i]
		let mut picked = ZeroVal(prog.Types, &prog.Arena, prog.Types.FieldType[fStart+i])
		for j in 0..fieldNames.Len() {
			if fieldNames[j] == fname {
				picked = fieldVals[j]
				break
			}
		}
		ordered = ordered.Append(picked)
	}
	MakeRecordVal(&prog.Arena, resolvedTid, ordered)
}

func readBytesFromSlice(arena ValArena, v Val) ([]byte, string, bool) {
	if v.Tag != TagSlice && v.Tag != TagArray {
		return ([]byte{}, "", false)
	}
	let n = int(ReadSliceLen(arena, v))
	let mut bs = slices.WithCapacity[byte](n)
	for i in 0..n {
		let ev = ReadSliceElem(arena, v, uint32(i))
		bs = bs.Append(byte(ev.Data))
	}
	(bs, strings.FromBytes(bs), true)
}

func makeBytesSlice(prog mut Program, bs []byte) Val {
	let mut elems = slices.WithCapacity[Val](bs.Len())
	for b in bs {
		elems = elems.Append(MakeIntVal(prog.Types, TypeUint8, uint64(b)))
	}
	MakeSliceVal(&prog.Arena, TypeBytes, elems, uint32(elems.Len()))
}

func appendTextToBytesSlice(prog mut Program, buf Val, text string) Val {
	let mut cur = buf
	for i in 0..text.Len() {
		cur = AppendSliceValCOW(&prog.Arena, cur, MakeIntVal(prog.Types, TypeUint8, uint64(text[i])))
	}
	cur
}

// DurationText formats duration nanoseconds identically to Go's time.Duration.String.
func DurationText(d int64) string {
	let minI64 = int64(-9223372036854775807) - int64(1)
	if d == int64(0) {
		return "0s"
	}
	let neg = d < int64(0)
	let u = if d == minI64 {
		uint64(1) << 63
	} else if neg {
		uint64(0) - uint64(d)
	} else {
		uint64(d)
	}
	let prefix = if neg { "-" } else { "" }
	if u < uint64(1000000000) {
		if u < uint64(1000) {
			return prefix + strconv.FormatUint(u, 10) + "ns"
		}
		let (unit, suffix) = if u < uint64(1000000) {
			(uint64(1000), "us")
		} else {
			(uint64(1000000), "ms")
		}
		let whole = u / unit
		let rem = u % unit
		if rem == uint64(0) {
			return prefix + strconv.FormatUint(whole, 10) + suffix
		}
		let frac = strings.TrimRight(strconv.FormatUint(rem+unit, 10)[1:], "0")
		return prefix + strconv.FormatUint(whole, 10) + "." + frac + suffix
	}
	let sec = u / uint64(1000000000)
	let ns = u % uint64(1000000000)
	let mins = sec / uint64(60)
	let s = sec % uint64(60)
	let h = mins / uint64(60)
	let m = mins % uint64(60)
	let mut out = prefix
	if h > uint64(0) {
		out = out + strconv.FormatUint(h, 10) + "h"
		out = out + strconv.FormatUint(m, 10) + "m"
	} else if m > uint64(0) {
		out = out + strconv.FormatUint(m, 10) + "m"
	}
	out = out + strconv.FormatUint(s, 10)
	if ns > uint64(0) {
		let frac = strings.TrimRight(strconv.FormatUint(ns+uint64(1000000000), 10)[1:], "0")
		out = out + "." + frac
	}
	out + "s"
}

// ParseDurationText parses a Go duration string such as "1h30m" or "-250ms".
func ParseDurationText(orig string) (int64, string) {
	if orig == "" || orig == "+" || orig == "-" {
		return (int64(0), "time: invalid duration \"" + orig + "\"")
	}
	let mut i = 0
	let mut neg = false
	if orig[0] == byte('-') || orig[0] == byte('+') {
		neg = orig[0] == byte('-')
		i = 1
	}
	if orig[i:] == "0" {
		return (int64(0), "")
	}
	if i == orig.Len() {
		return (int64(0), "time: invalid duration \"" + orig + "\"")
	}
	let limit = if neg { uint64(1) << 63 } else { uint64(0x7fffffffffffffff) }
	let mut total = uint64(0)
	for i < orig.Len() {
		let mut v = uint64(0)
		let mut f = uint64(0)
		let mut scale = float64(1)
		let mut overflow = false
		let hasLead = i < orig.Len() && orig[i] >= byte('0') && orig[i] <= byte('9')
		let mut hasFrac = false
		for i < orig.Len() && orig[i] >= byte('0') && orig[i] <= byte('9') {
			if v > limit/uint64(10) {
				overflow = true
			}
			v = v*uint64(10) + uint64(orig[i]-byte('0'))
			i = i + 1
		}
		if i < orig.Len() && orig[i] == byte('.') {
			i = i + 1
			for i < orig.Len() && orig[i] >= byte('0') && orig[i] <= byte('9') {
				hasFrac = true
				if !overflow {
					let nextF = f*uint64(10) + uint64(orig[i]-byte('0'))
					if nextF < f {
						overflow = true
					} else {
						f = nextF
						scale = scale * 10.0
					}
				}
				i = i + 1
			}
		}
		if !hasLead && !hasFrac {
			return (int64(0), "time: invalid duration \"" + orig + "\"")
		}
		if overflow {
			return (int64(0), "time: invalid duration \"" + orig + "\"")
		}
		let uStart = i
		for i < orig.Len() {
			let c = orig[i]
			if c == byte('.') || (c >= byte('0') && c <= byte('9')) {
				break
			}
			i = i + 1
		}
		let uStr = orig[uStart:i]
		let mut unit = uint64(0)
		if uStr == "ns" {
			unit = uint64(1)
		} else if uStr == "us" || uStr == "\u00b5s" || uStr == "\u03bcs" {
			unit = uint64(1000)
		} else if uStr == "ms" {
			unit = uint64(1000000)
		} else if uStr == "s" {
			unit = uint64(1000000000)
		} else if uStr == "m" {
			unit = uint64(60000000000)
		} else if uStr == "h" {
			unit = uint64(3600000000000)
		} else {
			return (int64(0), "time: unknown unit \"" + uStr + "\" in duration \"" + orig + "\"")
		}
		let (hi, part) = bits.Mul64(v, unit)
		if hi != uint64(0) || part > limit {
			return (int64(0), "time: invalid duration \"" + orig + "\"")
		}
		let mut addVal = part
		if f > uint64(0) {
			let fracAdd = uint64(float64(f) * (float64(unit) / scale))
			if fracAdd > limit-addVal {
				return (int64(0), "time: invalid duration \"" + orig + "\"")
			}
			addVal = addVal + fracAdd
		}
		if addVal > limit-total {
			return (int64(0), "time: invalid duration \"" + orig + "\"")
		}
		total = total + addVal
	}
	if neg {
		return (int64(uint64(0) - total), "")
	}
	(int64(total), "")
}

// DurationISO formats duration d in ISO 8601 PT... form matching durationISO in nativespure.go.
func DurationISO(d int64) string {
	let minI64 = int64(-9223372036854775807) - int64(1)
	if d == int64(0) {
		return "PT0S"
	}
	let neg = d < int64(0)
	let n = if d == minI64 {
		uint64(1) << 63
	} else if neg {
		uint64(0) - uint64(d)
	} else {
		uint64(d)
	}
	let mut out = if neg { "-PT" } else { "PT" }
	let sec = uint64(1000000000)
	let h = n / (uint64(3600) * sec)
	let rem1 = n % (uint64(3600) * sec)
	let m = rem1 / (uint64(60) * sec)
	let rem2 = rem1 % (uint64(60) * sec)
	let s = rem2 / sec
	let ns = rem2 % sec
	if h > uint64(0) {
		out = out + strconv.FormatUint(h, 10) + "H"
	}
	if m > uint64(0) {
		out = out + strconv.FormatUint(m, 10) + "M"
	}
	if s > uint64(0) || ns > uint64(0) {
		out = out + strconv.FormatUint(s, 10)
		if ns > uint64(0) {
			let frac = strings.TrimRight(strconv.FormatUint(ns+sec, 10)[1:], "0")
			out = out + "." + frac
		}
		out = out + "S"
	}
	out
}

// ParseDurationISO parses an ISO 8601 PT... duration matching parseDurationISO in nativespure.go.
func ParseDurationISO(s string) (int64, string) {
	let mut i = 0
	let mut neg = false
	if i < s.Len() && (s[i] == byte('+') || s[i] == byte('-')) {
		neg = s[i] == byte('-')
		i = i + 1
	}
	if !strings.HasPrefix(s[i:], "P") {
		return (int64(0), "want P")
	}
	if !strings.HasPrefix(s[(i+1):], "T") {
		return (int64(0), "want T: a duration of years, months, weeks or days has no fixed length; civil.ParsePeriod reads it")
	}
	i = i + 2
	if i == s.Len() {
		return (int64(0), "want a number after PT")
	}
	let limit = if neg { uint64(1) << 63 } else { uint64(0x7fffffffffffffff) }
	let mut total = uint64(0)
	let mut nextAllowed = "HMS"
	for i < s.Len() {
		let mut v = uint64(0)
		let mut k = 0
		let mut over = false
		for i < s.Len() && s[i] >= byte('0') && s[i] <= byte('9') {
			if v > limit/uint64(10) {
				over = true
				break
			}
			v = v*uint64(10) + uint64(s[i]-byte('0'))
			i = i + 1
			k = k + 1
		}
		if over {
			return (int64(0), "out of range")
		}
		if k == 0 {
			return (int64(0), "want a digit")
		}
		let mut frac = uint64(0)
		let fraction = i < s.Len() && (s[i] == byte('.') || s[i] == byte(','))
		if fraction {
			i = i + 1
			let start = i
			for i < s.Len() && s[i] >= byte('0') && s[i] <= byte('9') {
				if i-start == 9 {
					return (int64(0), "a fraction has at most nine digits")
				}
				frac = frac*uint64(10) + uint64(s[i]-byte('0'))
				i = i + 1
			}
			if i == start {
				return (int64(0), "want a digit after the point")
			}
			let mut remD = i - start
			for remD < 9 {
				frac = frac * uint64(10)
				remD = remD + 1
			}
		}
		if i == s.Len() {
			return (int64(0), "want H, M or S")
		}
		let at = strings.Index(nextAllowed, s[i:(i+1)])
		if at < 0 {
			return (int64(0), "want H, M or S, in that order, each once")
		}
		nextAllowed = nextAllowed[(at + 1):]
		if fraction && s[i] != byte('S') {
			return (int64(0), "only seconds take a fraction")
		}
		let unit = if s[i] == byte('H') {
			uint64(3600000000000)
		} else if s[i] == byte('M') {
			uint64(60000000000)
		} else {
			uint64(1000000000)
		}
		let (hi, part) = bits.Mul64(v, unit)
		if hi != uint64(0) || part > limit-total {
			return (int64(0), "out of range")
		}
		total = total + part
		if frac > limit-total {
			return (int64(0), "out of range")
		}
		total = total + frac
		i = i + 1
	}
	if neg {
		return (int64(uint64(0) - total), "")
	}
	(int64(total), "")
}

func normSecNsec(secIn int64, nsecIn int64) (int64, int64) {
	let mut sec = secIn + nsecIn/int64(1000000000)
	let mut nsec = nsecIn % int64(1000000000)
	if nsec < int64(0) {
		sec = sec - int64(1)
		nsec = nsec + int64(1000000000)
	}
	(sec, nsec)
}

func divModDurationUTC(sec int64, nsec int64, d int64) (int64, int64, int64, int64) {
	if d <= int64(0) {
		return (sec, nsec, int64(0), int64(0))
	}
	let dSec = d / int64(1000000000)
	let dNsec = d % int64(1000000000)
	if dNsec == int64(0) {
		let remS = if sec >= int64(0) { sec % dSec } else { ((sec % dSec) + dSec) % dSec }
		return (remS, nsec, dSec, int64(0))
	}
	if sec < int64(-9000000000) || sec > int64(9000000000) {
		return (int64(0), int64(0), dSec, dNsec)
	}
	let totalNs = sec*int64(1000000000) + nsec
	let mut r = totalNs % d
	if r < int64(0) {
		r = r + d
	}
	let (rs, rns) = normSecNsec(r/int64(1000000000), r%int64(1000000000))
	(rs, rns, dSec, dNsec)
}

func timeTruncateUTC(secIn int64, nsecIn int64, d int64) (int64, int64) {
	let (sec, nsec) = normSecNsec(secIn, nsecIn)
	if d <= int64(0) {
		return (sec, nsec)
	}
	let (rs, rns, _, _) = divModDurationUTC(sec, nsec, d)
	normSecNsec(sec-rs, nsec-rns)
}

func timeRoundUTC(secIn int64, nsecIn int64, d int64) (int64, int64) {
	let (sec, nsec) = normSecNsec(secIn, nsecIn)
	if d <= int64(0) {
		return (sec, nsec)
	}
	let (rs, rns, _, _) = divModDurationUTC(sec, nsec, d)
	let rTotal = rs*int64(1000000000) + rns
	if rTotal+rTotal >= d {
		let rem = d - rTotal
		return normSecNsec(sec+rem/int64(1000000000), nsec+rem%int64(1000000000))
	}
	normSecNsec(sec-rs, nsec-rns)
}

func civilFromEpochDays(zIn int64) (int64, int, int) {
	let z = zIn + int64(719468)
	let era = if z >= int64(0) { z / int64(146097) } else { (z - int64(146096)) / int64(146097) }
	let doe = z - era*int64(146097)
	let yoe = (doe - doe/int64(1460) + doe/int64(36524) - doe/int64(146096)) / int64(365)
	let y = yoe + era*int64(400)
	let doy = doe - (int64(365)*yoe + yoe/int64(4) - yoe/int64(100))
	let mp = (int64(5)*doy + int64(2)) / int64(153)
	let d = doy - (int64(153)*mp+int64(2))/int64(5) + int64(1)
	let m = mp + (if mp < int64(10) { int64(3) } else { int64(-9) })
	let yr = y + (if m <= int64(2) { int64(1) } else { int64(0) })
	(yr, int(m), int(d))
}

func epochDaysFromCivil(yIn int64, m int, d int) int64 {
	let y = yIn - (if m <= 2 { int64(1) } else { int64(0) })
	let era = if y >= int64(0) { y / int64(400) } else { (y - int64(399)) / int64(400) }
	let yoe = y - era*int64(400)
	let mp = m + (if m > 2 { -3 } else { 9 })
	let doy = (int64(153)*int64(mp)+int64(2))/int64(5) + int64(d) - int64(1)
	let doe = yoe*int64(365) + yoe/int64(4) - yoe/int64(100) + doy
	era*int64(146097) + doe - int64(719468)
}

func padDigits(val uint64, width int) string {
	let mut s = strconv.FormatUint(val, 10)
	for s.Len() < width {
		s = "0" + s
	}
	s
}

func expandedYearText(y int64) string {
	let neg = y < int64(0)
	let u = if neg { uint64(0) - uint64(y) } else { uint64(y) }
	let sign = if neg { "-" } else { "+" }
	sign + padDigits(u, 6)
}

func formatTimeUTC(secIn int64, nsecIn int64, layout string) string {
	let (sec, nsec) = normSecNsec(secIn, nsecIn)
	let mut days = sec / int64(86400)
	let mut rem = sec % int64(86400)
	if rem < int64(0) {
		days = days - int64(1)
		rem = rem + int64(86400)
	}
	let (yr, mo, dy) = civilFromEpochDays(days)
	let hr = int(rem / int64(3600))
	let mn = int((rem % int64(3600)) / int64(60))
	let sc = int(rem % int64(60))
	let yearStr = if yr >= int64(0) && yr <= int64(9999) {
		padDigits(uint64(yr), 4)
	} else {
		expandedYearText(yr)
	}
	let mut out = ""
	let mut i = 0
	for i < layout.Len() {
		if strings.HasPrefix(layout[i:], "2006") {
			out = out + yearStr
			i = i + 4
		} else if strings.HasPrefix(layout[i:], "01") {
			out = out + padDigits(uint64(mo), 2)
			i = i + 2
		} else if strings.HasPrefix(layout[i:], "02") {
			out = out + padDigits(uint64(dy), 2)
			i = i + 2
		} else if strings.HasPrefix(layout[i:], "15") {
			out = out + padDigits(uint64(hr), 2)
			i = i + 2
		} else if strings.HasPrefix(layout[i:], "04") {
			out = out + padDigits(uint64(mn), 2)
			i = i + 2
		} else if strings.HasPrefix(layout[i:], "05") {
			out = out + padDigits(uint64(sc), 2)
			i = i + 2
		} else if strings.HasPrefix(layout[i:], "Z07:00") || strings.HasPrefix(layout[i:], "Z0700") || strings.HasPrefix(layout[i:], "-07:00") {
			let step = if strings.HasPrefix(layout[i:], "Z0700") { 5 } else { 6 }
			out = out + (if strings.HasPrefix(layout[i:], "Z") { "Z" } else { "+00:00" })
			i = i + step
		} else if strings.HasPrefix(layout[i:], ".999999999") {
			if nsec > int64(0) {
				let frac = strings.TrimRight(padDigits(uint64(nsec), 9), "0")
				out = out + "." + frac
			}
			i = i + 10
		} else if strings.HasPrefix(layout[i:], ".000000000") {
			out = out + "." + padDigits(uint64(nsec), 9)
			i = i + 10
		} else if strings.HasPrefix(layout[i:], "MST") {
			out = out + "UTC"
			i = i + 3
		} else {
			out = out + layout[i:(i+1)]
			i = i + 1
		}
	}
	out
}

func parseTimeDigits(s string, pos mut int, n int) (int64, bool) {
	if *pos+n > s.Len() {
		return (int64(0), false)
	}
	let mut v = int64(0)
	for k in 0..n {
		let c = s[*pos+k]
		if c < byte('0') || c > byte('9') {
			return (int64(0), false)
		}
		v = v*int64(10) + int64(c-byte('0'))
	}
	*pos = *pos + n
	(v, true)
}

func parseTimeUTC(layout string, value string) (int64, int64, string) {
	let mut yr = int64(0)
	let mut mo = 1
	let mut dy = 1
	let mut hr = 0
	let mut mn = 0
	let mut sc = 0
	let mut ns = int64(0)
	let mut tzSec = int64(0)
	let mut li = 0
	let mut vi = 0
	for li < layout.Len() {
		if strings.HasPrefix(layout[li:], "2006") {
			if vi < value.Len() && (value[vi] == byte('+') || value[vi] == byte('-')) {
				let start = vi
				vi = vi + 1
				for vi < value.Len() && value[vi] >= byte('0') && value[vi] <= byte('9') {
					vi = vi + 1
				}
				let run = value[start:vi]
				if run.Len() < 7 || (run.Len() > 7 && run[1] == byte('0')) || run.Len() > 13 {
					return (int64(0), int64(0), "cannot parse expanded year")
				}
				let (py, st) = ParseSignedIntBase(run, 10, 64)
				yr = py
				if st != uint8(0) || (yr >= int64(0) && yr <= int64(9999)) {
					return (int64(0), int64(0), "cannot parse expanded year")
				}
			} else {
				let (v, ok) = parseTimeDigits(value, &vi, 4)
				if !ok {
					return (int64(0), int64(0), "cannot parse \"" + value[vi:] + "\" as \"2006\"")
				}
				yr = v
			}
			li = li + 4
		} else if strings.HasPrefix(layout[li:], "01") {
			let (v, ok) = parseTimeDigits(value, &vi, 2)
			if !ok || v < int64(1) || v > int64(12) {
				return (int64(0), int64(0), "month out of range")
			}
			mo = int(v)
			li = li + 2
		} else if strings.HasPrefix(layout[li:], "02") {
			let (v, ok) = parseTimeDigits(value, &vi, 2)
			if !ok || v < int64(1) || v > int64(31) {
				return (int64(0), int64(0), "day out of range")
			}
			dy = int(v)
			li = li + 2
		} else if strings.HasPrefix(layout[li:], "15") {
			let (v, ok) = parseTimeDigits(value, &vi, 2)
			if !ok || v > int64(23) {
				return (int64(0), int64(0), "hour out of range")
			}
			hr = int(v)
			li = li + 2
		} else if strings.HasPrefix(layout[li:], "04") {
			let (v, ok) = parseTimeDigits(value, &vi, 2)
			if !ok || v > int64(59) {
				return (int64(0), int64(0), "minute out of range")
			}
			mn = int(v)
			li = li + 2
		} else if strings.HasPrefix(layout[li:], "05") {
			let (v, ok) = parseTimeDigits(value, &vi, 2)
			if !ok || v > int64(59) {
				return (int64(0), int64(0), "second out of range")
			}
			sc = int(v)
			li = li + 2
		} else if strings.HasPrefix(layout[li:], ".999999999") || strings.HasPrefix(layout[li:], ".000000000") {
			if vi < value.Len() && value[vi] == byte('.') {
				vi = vi + 1
				let mut frac = int64(0)
				let mut digits = 0
				for vi < value.Len() && value[vi] >= byte('0') && value[vi] <= byte('9') && digits < 9 {
					frac = frac*int64(10) + int64(value[vi]-byte('0'))
					digits = digits + 1
					vi = vi + 1
				}
				for digits < 9 {
					frac = frac * int64(10)
					digits = digits + 1
				}
				ns = frac
			}
			li = li + 10
		} else if strings.HasPrefix(layout[li:], "Z07:00") || strings.HasPrefix(layout[li:], "-07:00") {
			if vi < value.Len() && (value[vi] == byte('Z') || value[vi] == byte('z')) {
				vi = vi + 1
			} else if vi+6 <= value.Len() && (value[vi] == byte('+') || value[vi] == byte('-')) && value[vi+3] == byte(':') {
				let tzNeg = value[vi] == byte('-')
				vi = vi + 1
				let (th, okH) = parseTimeDigits(value, &vi, 2)
				vi = vi + 1
				let (tm, okM) = parseTimeDigits(value, &vi, 2)
				if !okH || !okM || th > int64(23) || tm > int64(59) {
					return (int64(0), int64(0), "invalid timezone offset")
				}
				let off = th*int64(3600) + tm*int64(60)
				tzSec = if tzNeg { int64(0) - off } else { off }
			} else {
				return (int64(0), int64(0), "cannot parse timezone")
			}
			li = li + 6
		} else {
			if vi >= value.Len() || value[vi] != layout[li] {
				return (int64(0), int64(0), "parsing time \"" + value + "\" as \"" + layout + "\"")
			}
			vi = vi + 1
			li = li + 1
		}
	}
	if vi != value.Len() {
		return (int64(0), int64(0), "extra text: \"" + value[vi:] + "\"")
	}
	let days = epochDaysFromCivil(yr, mo, dy)
	let sec = days*int64(86400) + int64(hr)*int64(3600) + int64(mn)*int64(60) + int64(sc) - tzSec
	(sec, ns, "")
}

type csvRowPos {
	Fields [][]string,
	Lines  [][]int,
	Cols   [][]int,
}

func csvParseAll(text string) (csvRowPos, int, int, string, string) {
	let mut fields = [][]string{}
	let mut lines = [][]int{}
	let mut cols = [][]int{}
	let mut pos = 0
	let mut line = 1
	let mut col = 1
	let mut expectedCols = -1
	let s = strings.ReplaceAll(text, "\r\n", "\n")
	for pos < s.Len() {
		let mut row = []string{}
		let mut rLines = []int{}
		let mut rCols = []int{}
		for {
			rLines = rLines.Append(line)
			rCols = rCols.Append(col)
			if pos < s.Len() && s[pos] == byte('"') {
				pos = pos + 1
				col = col + 1
				let mut fieldBytes = []byte{}
				let mut closed = false
				for pos < s.Len() {
					let c = s[pos]
					if c == byte('"') {
						if pos+1 < s.Len() && s[pos+1] == byte('"') {
							fieldBytes = fieldBytes.Append(byte('"'))
							pos = pos + 2
							col = col + 2
						} else {
							pos = pos + 1
							col = col + 1
							closed = true
							break
						}
					} else {
						fieldBytes = fieldBytes.Append(c)
						if c == byte('\n') {
							line = line + 1
							col = 1
						} else {
							col = col + 1
						}
						pos = pos + 1
					}
				}
				if !closed {
					let msg = "parse error on line " + strconv.Itoa(line) + ", column " + strconv.Itoa(col) + ": extraneous or missing \" in quoted-field"
					return (csvRowPos{Fields: fields, Lines: lines, Cols: cols}, line, col, "extraneous or missing \" in quoted-field", msg)
				}
				if pos < s.Len() && s[pos] != byte(',') && s[pos] != byte('\n') {
					let msg = "parse error on line " + strconv.Itoa(line) + ", column " + strconv.Itoa(col) + ": extraneous or missing \" in quoted-field"
					return (csvRowPos{Fields: fields, Lines: lines, Cols: cols}, line, col, "extraneous or missing \" in quoted-field", msg)
				}
				row = row.Append(strings.FromBytes(fieldBytes))
			} else {
				let start = pos
				for pos < s.Len() && s[pos] != byte(',') && s[pos] != byte('\n') {
					if s[pos] == byte('"') {
						let msg = "parse error on line " + strconv.Itoa(line) + ", column " + strconv.Itoa(col) + ": bare \" in non-quoted-field"
						return (csvRowPos{Fields: fields, Lines: lines, Cols: cols}, line, col, "bare \" in non-quoted-field", msg)
					}
					pos = pos + 1
					col = col + 1
				}
				row = row.Append(s[start:pos])
			}
			if pos < s.Len() && s[pos] == byte(',') {
				pos = pos + 1
				col = col + 1
				continue
			}
			if pos < s.Len() && s[pos] == byte('\n') {
				pos = pos + 1
				line = line + 1
				col = 1
			}
			break
		}
		if expectedCols < 0 {
			expectedCols = row.Len()
		} else if row.Len() != expectedCols {
			let rline = rLines[0]
			let msg = "record on line " + strconv.Itoa(rline) + ": wrong number of fields"
			return (csvRowPos{Fields: fields, Lines: lines, Cols: cols}, rline, 0, "wrong number of fields", msg)
		}
		fields = fields.Append(row)
		lines = lines.Append(rLines)
		cols = cols.Append(rCols)
	}
	(csvRowPos{Fields: fields, Lines: lines, Cols: cols}, 0, 0, "", "")
}

func csvFormatField(s string) string {
	if !strings.Contains(s, ",") && !strings.Contains(s, "\"") && !strings.Contains(s, "\n") && !strings.Contains(s, "\r") {
		return s
	}
	"\"" + strings.ReplaceAll(s, "\"", "\"\"") + "\""
}

func csvFormatAll(rows [][]string) string {
	let mut out = ""
	for row in rows {
		if row.Len() == 1 && row[0] == "" {
			out = out + "\"\"\n"
			continue
		}
		let mut parts = slices.WithCapacity[string](row.Len())
		for f in row {
			parts = parts.Append(csvFormatField(f))
		}
		out = out + strings.Join(parts, ",") + "\n"
	}
	out
}

func sha1SumBytes(msg []byte) []byte {
	let mut padded = slices.WithCapacity[byte](msg.Len() + 72)
	for b in msg {
		padded = padded.Append(b)
	}
	padded = padded.Append(byte(0x80))
	for padded.Len()%64 != 56 {
		padded = padded.Append(byte(0))
	}
	let bitLen = uint64(msg.Len()) * uint64(8)
	for sh in []int{56, 48, 40, 32, 24, 16, 8, 0} {
		padded = padded.Append(byte(bitLen >> sh))
	}
	let mut h0 = uint32(0x67452301)
	let mut h1 = uint32(0xefcdab89)
	let mut h2 = uint32(0x98badcfe)
	let mut h3 = uint32(0x10325476)
	let mut h4 = uint32(0xc3d2e1f0)
	let mut w = slices.WithCapacity[uint32](80)
	for _ in 0..80 {
		w = w.Append(uint32(0))
	}
	let mut off = 0
	for off < padded.Len() {
		for i in 0..16 {
			let j = off + i*4
			w[i] = (uint32(padded[j]) << 24) | (uint32(padded[j+1]) << 16) | (uint32(padded[j+2]) << 8) | uint32(padded[j+3])
		}
		for i in 16..80 {
			w[i] = bits.RotateLeft32(w[i-3]^w[i-8]^w[i-14]^w[i-16], 1)
		}
		let mut a = h0
		let mut b = h1
		let mut c = h2
		let mut d = h3
		let mut e = h4
		for i in 0..80 {
			let (f, k) = if i < 20 {
				((b & c) | ((b ^ uint32(0xffffffff)) & d), uint32(0x5a827999))
			} else if i < 40 {
				(b ^ c ^ d, uint32(0x6ed9eba1))
			} else if i < 60 {
				((b & c) | (b & d) | (c & d), uint32(0x8f1bbcdc))
			} else {
				(b ^ c ^ d, uint32(0xca62c1d6))
			}
			let temp = bits.RotateLeft32(a, 5) + f + e + k + w[i]
			e = d
			d = c
			c = bits.RotateLeft32(b, 30)
			b = a
			a = temp
		}
		h0 = h0 + a
		h1 = h1 + b
		h2 = h2 + c
		h3 = h3 + d
		h4 = h4 + e
		off = off + 64
	}
	let mut out = slices.WithCapacity[byte](20)
	for hw in []uint32{h0, h1, h2, h3, h4} {
		out = out.Append(byte(hw >> 24))
		out = out.Append(byte(hw >> 16))
		out = out.Append(byte(hw >> 8))
		out = out.Append(byte(hw))
	}
	out
}

func rotr64(x uint64, n int) uint64 {
	bits.RotateLeft64(x, 64-n)
}

