	pushSimple(&t, uint32(265), KindUnobservable, NoArg, uint32(0), uint32(0), uint32(0), WriteNone, "open_by_handle_at")
	pushSimple(&t, uint32(263), KindUnobservable, NoArg, uint32(0), uint32(0), uint32(0), WriteNone, "fanotify_mark")
	pushSimple(&t, uint32(60), KindUnobservable, NoArg, uint32(0), uint32(0), uint32(0), WriteNone, "quotactl")
	pushSimple(&t, uint32(443), KindUnobservable, NoArg, uint32(0), uint32(0), uint32(0), WriteNone, "quotactl_fd")
	pushSimple(&t, uint32(280), KindUnobservable, NoArg, uint32(0), uint32(0), uint32(0), WriteNone, "bpf")
	pushSimple(&t, uint32(425), KindRefused, NoArg, uint32(0), uint32(0), uint32(0), WriteNone, "io_uring_setup")
	pushSimple(&t, uint32(220), KindNamespaceClone, NoArg, uint32(0), uint32(0), uint32(0), WriteNone, "clone")
	t
}

// LookupSyscall returns the dense row index for nr in tbl, or NoCall.
func LookupSyscall(tbl SyscallTable, nr uint32) uint32 {
	for i, c in tbl.Nr {
		if c == nr {
			return uint32(i)
		}
	}
	NoCall
}

// BuildFilter emits the exact classic seccomp cBPF instruction stream matching
// Go's observe_linux filter(target) for arch (ArchAMD64 or ArchARM64).
func BuildFilter(arch uint8, target bool) []SockFilter {
	let tbl = TableForArch(arch)
	let mut prog = []SockFilter{
		SockFilter{Code: BpfLdAbs, JT: uint8(0), JF: uint8(0), K: OffArc},
		SockFilter{Code: BpfJeqK, JT: uint8(1), JF: uint8(0), K: tbl.AuditArch},
		SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetUserNotif},
		SockFilter{Code: BpfLdAbs, JT: uint8(0), JF: uint8(0), K: OffNr},
	}
	if tbl.CheckX32 {
		prog = prog.Append(SockFilter{Code: BpfJgeK, JT: uint8(0), JF: uint8(1), K: tbl.X32SyscallBit})
		prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetUserNotif})
	}
	for i in 0..tbl.Nr.Len() {
		let nr = tbl.Nr[i]
		let kind = tbl.Kind[i]
		let pathArg = tbl.PathArg[i]
		if !target && kind == KindWriteFD {
			continue
		}
		if kind == KindRefused {
			prog = prog.Append(SockFilter{Code: BpfJeqK, JT: uint8(0), JF: uint8(1), K: nr})
			prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetErrno | Enosys})
		} else if kind == KindNamespaceClone {
			prog = prog.Append(SockFilter{Code: BpfJeqK, JT: uint8(0), JF: uint8(4), K: nr})
			prog = prog.Append(SockFilter{Code: BpfLdAbs, JT: uint8(0), JF: uint8(0), K: OffArg})
			prog = prog.Append(SockFilter{Code: BpfJsetK, JT: uint8(0), JF: uint8(1), K: NamespaceFlags})
			prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetUserNotif})
			prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetAllow})
		} else if kind == KindSocket {
			prog = prog.Append(SockFilter{Code: BpfJeqK, JT: uint8(0), JF: uint8(6), K: nr})
			prog = prog.Append(SockFilter{Code: BpfLdAbs, JT: uint8(0), JF: uint8(0), K: OffArg + pathArg*ArgLength})
			prog = prog.Append(SockFilter{Code: BpfJeqK, JT: uint8(0), JF: uint8(3), K: uint32(0)})
			prog = prog.Append(SockFilter{Code: BpfLdAbs, JT: uint8(0), JF: uint8(0), K: OffArg + pathArg*ArgLength + uint32(4)})
			prog = prog.Append(SockFilter{Code: BpfJeqK, JT: uint8(0), JF: uint8(1), K: uint32(0)})
			prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetAllow})
			prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetUserNotif})
		} else {
			prog = prog.Append(SockFilter{Code: BpfJeqK, JT: uint8(0), JF: uint8(1), K: nr})
			prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetUserNotif})
		}
	}
	prog = prog.Append(SockFilter{Code: BpfJgtK, JT: uint8(0), JF: uint8(1), K: HighestKnownCall})
	prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetUserNotif})
	prog = prog.Append(SockFilter{Code: BpfRetK, JT: uint8(0), JF: uint8(0), K: SeccompRetAllow})
	prog
}

law FilterAlwaysEndsWithAllow(arch uint8, target bool) {
	let prog = BuildFilter(arch, target)
	let last = slices.Last(prog)
	match last {
	case option.Some{Value: ins}:
		ins.Code == BpfRetK && ins.K == SeccompRetAllow
	case option.None:
		false
	}
}

test SyscallTablesAndBPFFilterLengths {
	let amd = TableForArch(ArchAMD64)
	let arm = TableForArch(ArchARM64)
	assert amd.Nr.Len() == 84
	assert arm.Nr.Len() == 64
	assert LookupSyscall(amd, uint32(257)) != NoCall
	assert LookupSyscall(arm, uint32(56)) != NoCall
	assert LookupSyscall(arm, uint32(999)) == NoCall

	let nonTarget = BuildFilter(ArchAMD64, false)
	let target = BuildFilter(ArchAMD64, true)
	assert target.Len() == nonTarget.Len()+10
}
