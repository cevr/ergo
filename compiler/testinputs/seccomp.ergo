import option
import slices

// ArchAMD64 selects Linux x86_64 seccomp syscall numbers and audit arch.
let ArchAMD64 uint8 = 1

// ArchARM64 selects Linux aarch64 seccomp syscall numbers and audit arch.
let ArchARM64 uint8 = 2

// NoArg marks an unused syscall argument slot.
let NoArg uint32 = 4294967295

// NoCall is the sentinel dense index returned when a syscall number is
// outside the filtered table.
let NoCall uint32 = 4294967295

// HighestKnownCall is the highest Linux 6.12 syscall number classified by the
// observer table (mseal).
let HighestKnownCall uint32 = 462

// KindOpen classifies file-opening syscalls (open, openat).
let KindOpen uint8 = 1

// KindOpenat2 classifies openat2 whose flags live in struct open_how.
let KindOpenat2 uint8 = 2

// KindStat classifies path metadata lookup syscalls.
let KindStat uint8 = 3

// KindWriteFD classifies descriptor-based write metadata syscalls.
let KindWriteFD uint8 = 4

// KindChdir classifies working-directory change syscalls.
let KindChdir uint8 = 5

// KindSocket classifies socket calls carrying sockaddr directly.
let KindSocket uint8 = 6

// KindSocketMsg classifies sendmsg carrying struct msghdr.
let KindSocketMsg uint8 = 7

// KindSocketMsgs classifies sendmmsg carrying struct mmsghdr arrays.
let KindSocketMsgs uint8 = 8

// KindExec classifies execve and execveat.
let KindExec uint8 = 9

// KindClone3 classifies clone3 whose namespace flags reside in user memory.
let KindClone3 uint8 = 10

// KindSeccomp classifies seccomp(2) invocations installing nested filters.
let KindSeccomp uint8 = 11

// KindNamespaceClone classifies clone(2) invocations gated on namespace bits.
let KindNamespaceClone uint8 = 12

// KindUnobservable classifies syscalls that escape path-based observation.
let KindUnobservable uint8 = 13

// KindRefused classifies syscalls rejected with ENOSYS directly in BPF.
let KindRefused uint8 = 14

// BpfLdAbs is BPF_LD | BPF_W | BPF_ABS.
let BpfLdAbs uint16 = 32

// BpfJeqK is BPF_JMP | BPF_JEQ | BPF_K.
let BpfJeqK uint16 = 21

// BpfJgtK is BPF_JMP | BPF_JGT | BPF_K.
let BpfJgtK uint16 = 37

// BpfJgeK is BPF_JMP | BPF_JGE | BPF_K.
let BpfJgeK uint16 = 53

// BpfJsetK is BPF_JMP | BPF_JSET | BPF_K.
let BpfJsetK uint16 = 69

// BpfRetK is BPF_RET | BPF_K.
let BpfRetK uint16 = 6

// OffNr is seccomp_data.nr offset.
let OffNr uint32 = 0

// OffArc is seccomp_data.arch offset.
let OffArc uint32 = 4

// OffArg is seccomp_data.args[0] offset.
let OffArg uint32 = 16

// ArgLength is the byte stride of each seccomp_data argument slot.
let ArgLength uint32 = 8

// SeccompRetAllow is SECCOMP_RET_ALLOW.
let SeccompRetAllow uint32 = 2147418112

// SeccompRetUserNotif is SECCOMP_RET_USER_NOTIF.
let SeccompRetUserNotif uint32 = 2143289344

// SeccompRetErrno is SECCOMP_RET_ERRNO base action.
let SeccompRetErrno uint32 = 327680

// Enosys is Linux ENOSYS errno value.
let Enosys uint32 = 38

// NamespaceFlags combines Linux CLONE_NEW* bits checked by BPF/clone3.
let NamespaceFlags uint32 = 2114060288

// SockFilter represents one classic cBPF instruction matching Linux
// struct sock_filter.
type SockFilter {
	Code uint16,
	JT   uint8,
	JF   uint8,
	K    uint32,
}

// SyscallTable stores per-architecture seccomp call descriptors as flat
// parallel SoA columns.
type SyscallTable {
	AuditArch         uint32,
	SysSeccomp        uint32,
	SysProcessVMReadv uint32,
	CheckX32          bool,
	X32SyscallBit     uint32,
	Nr                []uint32,
	Kind              []uint8,
	DirFD             []uint32,
	PathArg           []uint32,
	FlagsArg          []uint32,
	AtFlagsArg        []uint32,
	EnvArg            []uint32,
	HasSecond         []bool,
	DirFD2            []uint32,
	Path2Arg          []uint32,
	Name              []string,
	WriteRole         []uint8,
	WriteRole2        []uint8,
}

func emptyTable(auditArch uint32, sysSeccomp uint32, sysVMReadv uint32, checkX32 bool, x32Bit uint32) SyscallTable {
	SyscallTable{
		AuditArch:         auditArch,
		SysSeccomp:        sysSeccomp,
		SysProcessVMReadv: sysVMReadv,
		CheckX32:          checkX32,
		X32SyscallBit:     x32Bit,
		Nr:                []uint32{},
		Kind:              []uint8{},
		DirFD:             []uint32{},
		PathArg:           []uint32{},
		FlagsArg:          []uint32{},
		AtFlagsArg:        []uint32{},
		EnvArg:            []uint32{},
		HasSecond:         []bool{},
		DirFD2:            []uint32{},
		Path2Arg:          []uint32{},
		Name:              []string{},
		WriteRole:         []uint8{},
		WriteRole2:        []uint8{},
	}
}

func pushSimple(t mut SyscallTable, nr uint32, kind uint8, dirfd uint32, pathArg uint32, flagsArg uint32, atFlagsArg uint32, write uint8, name string) {
	pushFull(t, nr, kind, dirfd, pathArg, flagsArg, atFlagsArg, NoArg, false, NoArg, NoArg, write, WriteNone, name)
}

func pushFull(t mut SyscallTable, nr uint32, kind uint8, dirfd uint32, pathArg uint32, flagsArg uint32, atFlagsArg uint32, envArg uint32, second bool, dirfd2 uint32, path2Arg uint32, write uint8, write2 uint8, name string) {
	t.Nr = t.Nr.Append(nr)
	t.Kind = t.Kind.Append(kind)
	t.DirFD = t.DirFD.Append(dirfd)
	t.PathArg = t.PathArg.Append(pathArg)
	t.FlagsArg = t.FlagsArg.Append(flagsArg)
	t.AtFlagsArg = t.AtFlagsArg.Append(atFlagsArg)
	t.EnvArg = t.EnvArg.Append(envArg)
	t.HasSecond = t.HasSecond.Append(second)
	t.DirFD2 = t.DirFD2.Append(dirfd2)
	t.Path2Arg = t.Path2Arg.Append(path2Arg)
	t.Name = t.Name.Append(name)
	t.WriteRole = t.WriteRole.Append(write)
	t.WriteRole2 = t.WriteRole2.Append(write2)
}

// TableForArch builds the seccomp syscall table for ArchAMD64 or ArchARM64.
func TableForArch(arch uint8) SyscallTable {
	if arch == ArchARM64 {
		return arm64Table()
	}
	amd64Table()
}

