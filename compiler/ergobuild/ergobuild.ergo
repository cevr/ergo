import option
import os
import slices
import strings

// Cgo is the environment entry disabling cgo for every build of the ergo tool.
let Cgo = "CGO_ENABLED=0"

// BuildFlags returns the reproducible go build flags used for every build of the ergo tool.
func BuildFlags() []string {
	[]string{"-trimpath", "-buildvcs=false"}
}

// InstallCommand returns the cgo-free go install command string for the given version.
func InstallCommand(version string) string {
	Cgo + " go install github.com/cevr/ergo/cmd/ergo@" + version
}

// BuildCommand describes an exact reproducible go build invocation for the ergo tool.
type BuildCommand {
	// Program is the executable name ("go").
	Program string,
	// Out is the output binary path passed to -o.
	Out string,
	// Pkg is the package target passed to go build.
	Pkg string,
	// Args are the complete argv words passed to Program.
	Args []string,
	// Env is the child process environment with Cgo applied.
	Env []string,
}

// CommandTable stores build command manifests in flat Structure-of-Arrays columns indexed by uint32 IDs.
type CommandTable {
	// Count is the number of build commands stored in the table.
	Count uint32,
	// Program holds the executable name per command.
	Program []string,
	// Out holds the output path per command.
	Out []string,
	// Pkg holds the package path per command.
	Pkg []string,
	// ArgStart holds the start offset into ArgPool per command.
	ArgStart []uint32,
	// ArgLen holds the slice length in ArgPool per command.
	ArgLen []uint32,
	// ArgPool holds all argument strings across all commands.
	ArgPool []string,
	// EnvStart holds the start offset into EnvPool per command.
	EnvStart []uint32,
	// EnvLen holds the slice length in EnvPool per command.
	EnvLen []uint32,
	// EnvPool holds all environment entries across all commands.
	EnvPool []string,
}

// Env returns env with every CGO_ENABLED= entry replaced by a single trailing Cgo entry.
func Env(env []string) []string {
	let mut out = slices.WithCapacity[string](env.Len() + 1)
	for entry in env {
		if !strings.HasPrefix(entry, "CGO_ENABLED=") {
			out = out.Append(entry)
		}
	}
	out.Append(Cgo)
}

// BuildArgs constructs the go build argument slice with reproducible flags and optional extra flags.
func BuildArgs(out string, pkg string, flags []string) []string {
	let base = BuildFlags()
	let mut args = slices.WithCapacity[string](1 + base.Len() + flags.Len() + 3)
	args = args.Append("build")
	for f in base {
		args = args.Append(f)
	}
	for f in flags {
		args = args.Append(f)
	}
	args = args.Append("-o")
	args = args.Append(out)
	args.Append(pkg)
}

// Command constructs a pure reproducible BuildCommand from explicit out, pkg, flags, and env.
func Command(out string, pkg string, flags []string, env []string) BuildCommand {
	BuildCommand{
		Program: "go",
		Out:     out,
		Pkg:     pkg,
		Args:    BuildArgs(out, pkg, flags),
		Env:     Env(env),
	}
}

// HostEnv reads the host process environment and applies Cgo.
func HostEnv() []string needs os.Process {
	let envMap = os.Process.Environ()
	let mut keys = slices.WithCapacity[string](envMap.Len())
	for k, _ in envMap {
		keys = keys.Append(k)
	}
	let sorted = slices.Sort(keys)
	let mut raw = slices.WithCapacity[string](sorted.Len())
	for k in sorted {
		match envMap.Get(k) {
		case option.Some{Value: v}:
			raw = raw.Append(k + "=" + v)
		case option.None:
		}
	}
	Env(raw)
}

// HostCommand constructs a reproducible BuildCommand using the host process environment.
func HostCommand(out string, pkg string, flags []string) BuildCommand needs os.Process {
	BuildCommand{
		Program: "go",
		Out:     out,
		Pkg:     pkg,
		Args:    BuildArgs(out, pkg, flags),
		Env:     HostEnv(),
	}
}

// NewCommandTable allocates an empty CommandTable.
func NewCommandTable() CommandTable {
	CommandTable{
		Count:    uint32(0),
		Program:  []string{},
		Out:      []string{},
		Pkg:      []string{},
		ArgStart: []uint32{},
		ArgLen:   []uint32{},
		ArgPool:  []string{},
		EnvStart: []uint32{},
		EnvLen:   []uint32{},
		EnvPool:  []string{},
	}
}

// AddCommand appends cmd to t and returns its dense uint32 row index.
func AddCommand(t mut CommandTable, cmd BuildCommand) uint32 {
	let idx = t.Count
	let aStart = uint32(t.ArgPool.Len())
	let aLen = uint32(cmd.Args.Len())
	let eStart = uint32(t.EnvPool.Len())
	let eLen = uint32(cmd.Env.Len())
	t.Count = idx + uint32(1)
	t.Program = t.Program.Append(cmd.Program)
	t.Out = t.Out.Append(cmd.Out)
	t.Pkg = t.Pkg.Append(cmd.Pkg)
	t.ArgStart = t.ArgStart.Append(aStart)
	t.ArgLen = t.ArgLen.Append(aLen)
	t.ArgPool = slices.AppendAll(t.ArgPool, cmd.Args)
	t.EnvStart = t.EnvStart.Append(eStart)
	t.EnvLen = t.EnvLen.Append(eLen)
	t.EnvPool = slices.AppendAll(t.EnvPool, cmd.Env)
	idx
}

// CommandAt reads back the BuildCommand stored at dense row index idx.
func CommandAt(t CommandTable, idx uint32) BuildCommand {
	let i = int(idx)
	let aStart = int(t.ArgStart[i])
	let aEnd = aStart + int(t.ArgLen[i])
	let eStart = int(t.EnvStart[i])
	let eEnd = eStart + int(t.EnvLen[i])
	BuildCommand{
		Program: t.Program[i],
		Out:     t.Out[i],
		Pkg:     t.Pkg[i],
		Args:    t.ArgPool[aStart:aEnd],
		Env:     t.EnvPool[eStart:eEnd],
	}
}

// EnvSetsCgoOnce guarantees Env strips prior CGO_ENABLED entries and leaves one trailing Cgo entry.
law EnvSetsCgoOnce(env []string) {
	let normalized = Env(env)
	let mut cgoCount = 0
	for entry in normalized {
		if strings.HasPrefix(entry, "CGO_ENABLED=") {
			cgoCount = cgoCount + 1
		}
	}
	let mut nonCgo = []string{}
	for entry in env {
		if !strings.HasPrefix(entry, "CGO_ENABLED=") {
			nonCgo = nonCgo.Append(entry)
		}
	}
	cgoCount == 1 && normalized[normalized.Len()-1] == Cgo && slices.Equal(normalized[:normalized.Len()-1], nonCgo)
}

// BuildArgsAreReproducible guarantees BuildArgs includes -trimpath and -buildvcs=false before -o out pkg.
law BuildArgsAreReproducible(out string, pkg string, extra []string) {
	let args = BuildArgs(out, pkg, extra)
		args.Len() == 6+extra.Len() &&
		args[0] == "build" &&
		args[1] == "-trimpath" &&
		args[2] == "-buildvcs=false" &&
		args[args.Len()-3] == "-o" &&
		args[args.Len()-2] == out &&
		args[args.Len()-1] == pkg
}

// CommandTableRoundTrips guarantees CommandTable stores and reconstructs BuildCommand rows losslessly.
law CommandTableRoundTrips(out string, pkg string, extra []string, env []string) {
	let cmdA = Command(out, pkg, extra, env)
	let cmdB = Command(out+"2", pkg, []string{"-v"}, []string{"HOME=/tmp"})
	let mut tbl = NewCommandTable()
	let idA = AddCommand(&tbl, cmdA)
	let idB = AddCommand(&tbl, cmdB)
	let gotA = CommandAt(tbl, idA)
	let gotB = CommandAt(tbl, idB)
		idA == uint32(0) && idB == uint32(1) && tbl.Count == uint32(2) &&
		gotA.Out == cmdA.Out && gotA.Pkg == cmdA.Pkg &&
		slices.Equal(gotA.Args, cmdA.Args) && slices.Equal(gotA.Env, cmdA.Env) &&
		gotB.Out == cmdB.Out && slices.Equal(gotB.Args, cmdB.Args) && slices.Equal(gotB.Env, cmdB.Env)
}

test ErgoBuildBehavior {
	let env = Env([]string{"HOME=/work", "CGO_ENABLED=1", "PATH=/bin", "CGO_ENABLED=0"})
	assert slices.Equal(env, []string{"HOME=/work", "PATH=/bin", "CGO_ENABLED=0"})
	let cmd = Command("/tmp/ergo", "./cmd/ergo", []string{"-tags=dev"}, []string{"CGO_ENABLED=1", "USER=dev"})
	assert cmd.Program == "go"
	assert slices.Equal(cmd.Args, []string{"build", "-trimpath", "-buildvcs=false", "-tags=dev", "-o", "/tmp/ergo", "./cmd/ergo"})
	assert slices.Equal(cmd.Env, []string{"USER=dev", "CGO_ENABLED=0"})
	assert strings.HasPrefix(InstallCommand("v0.1.0"), Cgo+" ")
	assert strings.Contains(InstallCommand("v0.1.0"), "@v0.1.0")
}
