// The driver's tests: the script reader and a whole run worked by hand.
// `ergo test` runs the laws.

import forge/memory
import forge/forge

// ores is the ore table of iron and gold.
func ores() memory.Ores { memory.NewOres(Map[string, int]{"iron": 25, "gold": 100}) }

// reason is the reason a script does not read, or "ok".
func reason(text string) string {
	let _ = ParseScript(text) catch {
	case BadLine as b:
		return "line \(b.Line): \(b.Reason)"
	}
	"ok"
}

test ReadsAScript {
	let items = try ParseScript("# a forging\n1s ore gold\n\n2500ms ore iron  # late\n3s select A1\n1m end\n")
	assert len(items) == 4
	assert ItemAt(items[1]) == 2500ms && ItemAt(items[3]) == 60s
	match items[2] {
	case Key as k:
		assert k.Slot == "A1"
	case OreIn, CancelKey, DouseKey, KindleKey, Press, Break, Fix, End:
		assert false
	}
}

test RefusesBadLines {
	assert reason("1s ore") == "line 1: ore takes 1 word after it"
	assert reason("2s button\n1s button") == "line 2: the time goes back"
	assert reason("soon button") == "line 1: soon is not a time such as 12s or 1500ms"
	assert reason("1s dance") == "line 1: no word dance"
	assert reason("-1s button") == "line 1: -1s is not a time such as 12s or 1500ms"
	assert reason("1m30s button") == "line 1: 1m30s is not a time such as 12s or 1500ms"
}

test ShowsTimes {
	assert Show(12s) == "12s" && Show(1500ms) == "1500ms" && Show(0s) == "0s" && Show(2m) == "120s"
}

// script is the lines of text run from both machines switched on, with
// ores, and the summary at the end.
func script(text string) []string fails BadLine {
	let items = try ParseScript(text)
	let rack = []forge.Slot{forge.Slot{Name: "A1", Item: "sword", Cost: 125, Count: 1}}
	let end, lines = with context { forge.Assayer: ores() } { Run(Fresh(rack), items) }
	let mut out = []string{}
	for l in lines {
		out = out.Append(Text(l))
	}
	out.Append(Summary(end))
}

test ARunWorkedByHand {
	let out = try script("1s ore gold\n2s ore button\n5s ore iron\n6s select A1\n7s select A1\n10s ore iron\n35s button\n50s end\n60s button")
	assert len(out) == 12
	assert out[0] == "1s forge: took 100, credit 100"
	assert out[1] == "2s assay: slag button"
	assert out[2] == "5s forge: took 25, credit 125"
	assert out[3] == "6s forge: forged sword from A1 for 125, leftover 0"
	assert out[4] == "7s forge: refused: busy dropping"
	assert out[5] == "8s forge: A1 dropped into the tray"
	assert out[6] == "10s forge: took 25, credit 25"
	assert out[7] == "30s light: green"
	assert out[8] == "35s light: green, ends early"
	assert out[9] == "40s forge: returned 25 (timeout)"
	assert out[10] == "50s light: yellow"
	assert out[11] == "at 50s: forge idle, light yellow; in 150 = spent 125 + leftover 0 + returned 25 + credit 0"
}

test FaultFlashesUntilRepaired {
	let out = try script("10s fault\n40s button\n45s repair\n75s end")
	assert out[0] == "10s light: flashing red"
	assert out[1] == "40s light: ignored, still flashing"
	assert out[2] == "45s light: red"
	assert out[3] == "75s light: green"
	assert out[4] == "at 75s: forge idle, light green; in 0 = spent 0 + leftover 0 + returned 0 + credit 0"
}
