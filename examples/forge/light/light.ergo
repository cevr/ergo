// Package light is a traffic light at a crossing with a button for
// people on foot. Cars get red, green and yellow in turn; a press of the
// button ends a green early, but never before MinGreen. A fault makes the
// light flash red until a repair. Every phase ends at a time computed from
// when it began, never from when a tick came, so the phases do not drift.
// It is pure: the clock reaches it only as the time of each cue.

import core
import machines
import option

// Light is the colour the cars see and the time it began.
type Light = Red{Since duration} | Green{Since duration, Asked bool} | Yellow{Since duration} | Flashing{Since duration}

// ColoursFollow: from any light, every cue leads to a colour that may
// follow it: never green to red, never red to yellow.
law ColoursFollow(l Light, cues []Cue) {
	let mut now = l
	for c in cues {
		let next = machines.Next(now, Step(now, c))
		if !Follows(now, next) {
			return false
		}
		now = next
	}
	true
}

// PhasesDoNotDrift: a phase that a tick ends begins the next phase at its
// deadline, however late the tick came.
law PhasesDoNotDrift(l Light, at duration) {
	match Deadline(l) {
	case option.Some[duration] as d:
		let next = machines.Next(l, Step(l, Tick{At: at}))
		if at < d.Value {
			return Colour(next) == Colour(l) && SinceOf(next) == SinceOf(l)
		}
		SinceOf(next) == d.Value
	case option.None:
		true
	}
}

// Cue is what reaches the light: the clock, the button, a fault and a
// repair, each at a time since the light was switched on.
type Cue = Tick{At duration} | Button{At duration} | Fault{At duration} | Repair{At duration}

// ButtonShortensGreen: a press in green moves its end to MinGreen after
// it began, and never later.
law ButtonShortensGreen(since duration, at duration) {
	let g Light = Green{Since: since, Asked: false}
	let pressed = machines.Next(g, Step(g, Button{At: at}))
	Deadline(pressed) == option.Some[duration]{Value: since + MinGreen}
}

// OnlyRepairEndsFlashing: a flashing light stays flashing for every cue
// but a repair.
law OnlyRepairEndsFlashing(since duration, c Cue) {
	let f Light = Flashing{Since: since}
	let next = machines.Next(f, Step(f, c))
	match c {
	case Repair:
		Colour(next) == "red"
	case Tick:
		Colour(next) == "flashing"
	case Button:
		Colour(next) == "flashing"
	case Fault:
		Colour(next) == "flashing"
	}
}

// The length of each phase.
let RedFor = 30s
let MinGreen = 20s

// GreenLastsMinGreen: no cue ends a green before MinGreen, except a
// fault.
law GreenLastsMinGreen(since duration, asked bool, c Cue) {
	let g Light = Green{Since: since, Asked: asked}
	let next = machines.Next(g, Step(g, c))
	match next {
	case Yellow as y:
		y.Since >= since+MinGreen
	case Green:
		true
	case Flashing:
		true
	case Red:
		false
	}
}
let MaxGreen = 60s
let YellowFor = 4s

// Start is the light switched on: red.
func Start() Light { Red{Since: 0s} }

// Colour is the word for l.
func Colour(l Light) string {
	match l {
	case Red:
		"red"
	case Green:
		"green"
	case Yellow:
		"yellow"
	case Flashing:
		"flashing"
	}
}

// SinceOf is the time l began.
func SinceOf(l Light) duration {
	match l {
	case Red as r:
		r.Since
	case Green as g:
		g.Since
	case Yellow as y:
		y.Since
	case Flashing as f:
		f.Since
	}
}

// Deadline is the time l ends by itself: a green ends at MinGreen once
// the button asked, else at MaxGreen. A flashing light waits for a
// repair.
func Deadline(l Light) option.Option[duration] {
	match l {
	case Red as r:
		option.Some[duration]{Value: r.Since + RedFor}
	case Green as g:
		option.Some[duration]{Value: g.Since + (if g.Asked { MinGreen } else { MaxGreen })}
	case Yellow as y:
		option.Some[duration]{Value: y.Since + YellowFor}
	case Flashing:
		option.None
	}
}

// after is the light that follows l when its phase ends at the time end.
func after(l Light, end duration) Light {
	match l {
	case Red:
		Green{Since: end, Asked: false}
	case Green:
		Yellow{Since: end}
	case Yellow:
		Red{Since: end}
	case Flashing:
		l
	}
}

// Step is the light's transition. A tick at or after the deadline enters
// the next phase, which begins at the deadline. A press in green asks for
// an early end; a press in another phase, or a second press, is ignored.
// A fault flashes from any phase; only a repair ends it, at red. The
// light gives no output and never ends: its output is Never.
func Step(l Light, c Cue) machines.Decision[Light, core.Never] {
	match (l, c) {
	case (Flashing, Repair as r):
		machines.Enter[Light]{Next: Red{Since: r.At}}
	case (Flashing, _):
		machines.Ignore
	case (_, Fault as f):
		machines.Enter[Light]{Next: Flashing{Since: f.At}}
	case (_, Repair):
		machines.Ignore
	case (Green as g, Button):
		if g.Asked { machines.Ignore } else { machines.Stay[Light]{Next: Green{..g, Asked: true}} }
	case (_, Button):
		machines.Ignore
	case (_, Tick as t):
		match Deadline(l) {
		case option.Some[duration] as d:
			if t.At >= d.Value { machines.Enter[Light]{Next: after(l, d.Value)} } else { machines.Ignore }
		case option.None:
			machines.Ignore
		}
	}
}

// Crossing is the light as a machine.
type Crossing machine[Light, Cue] {
	initial: Start(),
	step:    Step,
}

// Follows reports whether the colour b may come right after a: the cycle
// red, green, yellow, red, and flashing in and out of any colour, out
// only to red.
func Follows(a Light, b Light) bool {
	match (a, b) {
	case (Red, Green):
		true
	case (Green, Yellow):
		true
	case (Yellow, Red):
		true
	case (Flashing, Red):
		true
	case (_, Flashing):
		true
	case (Red, Red):
		true
	case (Green, Green):
		true
	case (Yellow, Yellow):
		true
	case (_, _):
		false
	}
}
