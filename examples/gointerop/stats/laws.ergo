// The rules of a summary as laws over lists of small whole numbers, so
// no sum overflows and every rule can be checked to a relative 1e-9.

import math

// Small is xs as float64 values in -500 to 499, with one more value from
// extra, so the list is never empty.
func Small(xs []int, extra int) []float64 {
	let mut out = []float64{float64(extra % 500)}
	for x in xs {
		out = out.Append(float64(x % 500))
	}
	out
}

// MeanIsBetween: the mean lies between the least and the greatest value,
// and the deviation is not negative.
law MeanIsBetween(xs []int, extra int) {
	let s = Summarize(Small(xs, extra)) catch {
	case Empty:
		return false
	}
	s.Min <= s.Mean+1e-9 && s.Mean <= s.Max+1e-9 && s.StdDev >= 0
}

// ShiftKeepsSpread: adding c to every value adds c to the mean and keeps
// the deviation.
law ShiftKeepsSpread(xs []int, extra int, c int) {
	let base = Small(xs, extra)
	let shift = float64(c % 1000)
	let mut moved = []float64{}
	for x in base {
		moved = moved.Append(x + shift)
	}
	let a = Summarize(base) catch {
	case Empty:
		return false
	}
	let b = Summarize(moved) catch {
	case Empty:
		return false
	}
	Near(b.Mean, a.Mean+shift) && math.Abs(b.StdDev-a.StdDev) <= 1e-6
}

// GeoMeanAtMostMean: for positive values the geometric mean is at most
// the mean (AM-GM), and it is absent when a value is not positive.
law GeoMeanAtMostMean(xs []int, extra int) {
	let s = Summarize(Small(xs, extra)) catch {
	case Empty:
		return false
	}
	match s.GeoMean {
	case Some[float64] as g:
		s.Min > 0 && g.Value <= s.Mean*(1+1e-9)
	case None:
		s.Min <= 0
	}
}
