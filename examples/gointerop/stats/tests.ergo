// The summary's tests: examples (the laws run in laws.ergo).

test SummaryOfAKnownList {
	let s = try Summarize([]float64{2, 4, 4, 4, 5, 5, 7, 9})
	assert s.Count == 8 && s.Min == 2 && s.Max == 9 && s.Mean == 5 && s.StdDev == 2
	assert Lines(s) == []string{"count   8", "min     2", "max     9", "mean    5", "stddev  2", "geomean 4.603216"}
}

test NoNumbersIsEmpty {
	let n = Summarize([]float64{}) catch {
	case Empty:
		Summary{Count: -1, Min: 0, Max: 0, Mean: 0, StdDev: 0, GeoMean: None}
	}
	assert n.Count == -1
}

// readFailure names the failure of Read(text), or "".
func readFailure(text string) string {
	let _ = Read(text) catch {
	case NotANumber as n:
		return "not a number at \(n.Line): \(n.Text)"
	case TooLarge as t:
		return "too large at \(t.Line): \(t.Text)"
	}
	""
}

test ReadTypesGosErrors {
	assert try Read("1 2.5\n-3e2\n\n") == []float64{1, 2.5, -300}
	assert readFailure("1\n2 x3") == "not a number at 2: x3"
	assert readFailure("1e999") == "too large at 1: 1e999"
}

test TextTrims {
	assert Text(2.5) == "2.5" && Text(3) == "3" && Text(-0.125) == "-0.125" && Text(1.0/3.0) == "0.333333"
}

// Positive lists, so the geometric mean is present and the law's first
// arm runs (the generated ints are mostly of mixed sign).
test GeoMeanAtMostMeanOnPositives(xs []int) {
	let mut pos = []int{}
	for x in xs {
		pos = pos.Append(1 + (if x < 0 { -(x + 1) } else { x })%400)
	}
	let s = try Summarize(Small(pos, 7))
	match s.GeoMean {
	case Some[float64] as g:
		assert g.Value <= s.Mean*(1+1e-9)
	case None:
		assert false
	}
}
