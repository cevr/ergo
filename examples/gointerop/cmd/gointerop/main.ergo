// gointerop is a checksum and statistics tool that leans on Go where Ergo
// lets it (see README: most of Go is not reachable yet).
//
//	gointerop sum [FILE...]   print "DIGEST  NAME" per file, as sha256sum;
//	                          standard input is "-"
//	gointerop check LIST      check each "DIGEST  NAME" line of LIST
//	gointerop stats           summarize the numbers on standard input
//
// This binary is the only place that chooses the providers: the hash
// (gointerop/sha256), the host's files, input and arguments.

import fs
import gointerop/checksum
import gointerop/sha256
import gointerop/stats
import io
import os

// Usage is the text of a usage failure.
let Usage = "usage: gointerop sum [FILE...] | check LIST | stats"

// Command is what the arguments ask for.
type Command = Sum{Files []string} | Check{List string} | Stats{}

// Parse is the command of args.
func Parse(args []string) Command fails os.Exit {
	if len(args) == 0 {
		return os.Exit{Code: 2, Message: Usage}
	}
	let mut rest = []string{}
	for i, a in args {
		if i > 0 {
			rest = rest.Append(a)
		}
	}
	match (args[0], len(rest)) {
	case ("sum", _):
		Sum{Files: rest}
	case ("check", 1):
		Check{List: rest[0]}
	case ("stats", 0):
		Stats
	case (_, _):
		os.Exit{Code: 2, Message: Usage}
	}
}

// textOf is the text of a file, or None when it cannot be read.
func textOf(name string) Option[string] needs fs.Files | io.Stdin {
	if name == "-" {
		let text = io.Stdin.ReadAll() catch {
		case io.ReadFailed:
			return None
		}
		return Some{text}
	}
	let text = fs.Files.ReadFile(name) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return None
	}
	Some{text}
}

// SumAll prints the digest line of each file.
func SumAll(files []string) fails os.Exit needs Console | checksum.Hasher | fs.Files | io.Stdin {
	let names = if len(files) == 0 { []string{"-"} } else { files }
	for name in names {
		match textOf(name) {
		case Some[string] as t:
			Console.Println(checksum.Line(checksum.Entry{Digest: checksum.Hasher.Sum(t.Value), Name: name}))
		case None:
			return os.Exit{Code: 1, Message: "gointerop: \(name): cannot be read"}
		}
	}
}

// CheckAll checks each entry of the list file.
func CheckAll(list string) fails os.Exit needs Console | checksum.Hasher | fs.Files | io.Stdin {
	let text = match textOf(list) {
	case Some[string] as t:
		t.Value
	case None:
		return os.Exit{Code: 1, Message: "gointerop: \(list): cannot be read"}
	}
	let entries = checksum.Parse(text) catch {
	case checksum.BadLine as b:
		return os.Exit{Code: 1, Message: "gointerop: \(list): line \(b.Line) is not DIGEST  NAME"}
	}
	let mut failed = 0
	for e in entries {
		let v = checksum.Check(e, textOf(e.Name))
		Console.Println(checksum.Report(e, v))
		match v {
		case checksum.Matches:
		case checksum.Differs, checksum.Missing:
			failed += 1
		}
	}
	if failed > 0 {
		let s = if failed == 1 { "" } else { "s" }
		return os.Exit{Code: 1, Message: "gointerop: WARNING: \(failed) computed checksum\(s) did NOT match"}
	}
}

// StatsOf prints the summary of the numbers on standard input.
func StatsOf() fails os.Exit needs Console | io.Stdin {
	let text = io.Stdin.ReadAll() catch {
	case io.ReadFailed as r:
		return os.Exit{Code: 1, Message: "gointerop: \(r.Reason)"}
	}
	let xs = stats.Read(text) catch {
	case stats.NotANumber as n:
		return os.Exit{Code: 1, Message: "gointerop: line \(n.Line): \(n.Text) is not a number"}
	case stats.TooLarge as t:
		return os.Exit{Code: 1, Message: "gointerop: line \(t.Line): \(t.Text) is too large"}
	}
	let s = stats.Summarize(xs) catch {
	case stats.Empty:
		return os.Exit{Code: 1, Message: "gointerop: no numbers"}
	}
	for l in stats.Lines(s) {
		Console.Println(l)
	}
}

// run does what the arguments ask. It is apart from main because a
// return cannot leave main's with block (G-ex-d-10).
func run() fails os.Exit needs Console | os.Process | io.Stdin | fs.Files | checksum.Hasher {
	match try Parse(os.Process.Args()) {
	case Sum as s:
		try SumAll(s.Files)
	case Check as c:
		try CheckAll(c.List)
	case Stats:
		try StatsOf()
	}
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost(), io.Stdin: io.NewHost(), fs.Files: fs.NewHost(), checksum.Hasher: sha256.Hasher } {
		try run()
	}
}

test ParseReadsEachCommand {
	assert parsed([]string{"stats"}) == "stats" && parsed([]string{"check", "l"}) == "check l"
	assert parsed([]string{"sum", "a", "b"}) == "sum 2" && parsed([]string{"check"}) == "exit 2"
}

// parsed names the command of args. Command holds a slice, so it has no
// == (G-ex-d-5).
func parsed(args []string) string {
	let c = Parse(args) catch {
	case os.Exit as e:
		return "exit \(e.Code)"
	}
	match c {
	case Sum as s:
		"sum \(len(s.Files))"
	case Check as k:
		"check \(k.List)"
	case Stats:
		"stats"
	}
}

// disk is an in-memory fs.Files for the tests: std has none.
type disk { texts Map[string, string] }

func ReadFile(d disk, path string) string fails fs.NotFound | fs.Denied | fs.Failed {
	match d.texts.Get(path) {
	case Some[string] as t:
		t.Value
	case None:
		fs.NotFound{Path: path}
	}
}

func ReadDir(d disk, path string) []string fails fs.NotFound | fs.Denied | fs.Failed {
	fs.NotFound{Path: path}
}

func Stat(d disk, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed {
	let text = try d.ReadFile(path)
	fs.Info{Name: path, Size: len(text), Dir: false}
}

// world is two files: a.txt and a list that names it and a missing file.
let world = disk{texts: Map[string, string]{
	"a.txt": "abc",
	"list":  "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  a.txt\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855  gone.txt\n",
}}

// statusOf is the exit status of CheckAll(list): 0, or its os.Exit code.
func statusOf(list string) int needs Console | checksum.Hasher | fs.Files | io.Stdin {
	CheckAll(list) catch {
	case os.Exit as e:
		return e.Code
	}
	0
}

// checked is what CheckAll(list) prints and its exit status.
func checked(list string) (string, int) {
	let out = io.NewRecorder()
	with context { Console: out, fs.Files: world, io.Stdin: io.Input{Text: ""}, checksum.Hasher: sha256.Hasher } {
		let code = statusOf(list)
		(out.Text(), code)
	}
}

test CheckReportsEachEntry {
	let text, code = checked("list")
	assert text == "a.txt: OK\ngone.txt: FAILED open or read\n" && code == 1
}
