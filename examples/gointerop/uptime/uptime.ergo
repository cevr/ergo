// Package uptime computes elapsed nanoseconds between explicit instants.
// Its Go provider runs under the native law harness. Only cmd/uptime
// reads a live clock; the law needs no host clock.

import go time

// Elapsed computes a signed difference between two nanosecond readings
// from the same clock. It saturates at the ends of int64.
type Elapsed {
	Nanos(start int64, end int64) int64,

	law DifferenceOfReadings(start int64, end int64) {
		let max = int64(9223372036854775807)
		let min = -max - 1
		let elapsed = Nanos(start, end)
		if start < 0 && end > max+start {
			return elapsed == max
		}
		if start > 0 && end < min+start {
			return elapsed == min
		}
		elapsed == end-start
	},
}

// GoElapsed implements Elapsed with Go's time.Time.Sub.
type GoElapsed {} implements Elapsed

// Nanos uses the same origin for both readings; it does not read a clock.
func Nanos(_ GoElapsed, start int64, end int64) int64 needs go.Foreign {
	let earlier = time.Unix(0, start)
	let later = time.Unix(0, end)
	int64(later.Sub(earlier))
}
