// Package uptime is the time since a start, read from Go's monotonic
// clock with time.Now and time.Since. It is gointerop's deliberately
// Go-backed provider: its operations call Go, which needs go.Foreign, so
// the check-time evaluator cannot run its law. ergo test runs it natively:
// the test binary's law case holds go.Foreign and builds the provider with
// NewGoClock (docs/spec/types.md, Laws 10; owner q277). A program would
// use std's time.Clock instead; this package exists to keep that path
// under its laws.

import go time

// Elapsed is a clock that counts from its own start.
type Elapsed {
	// Nanos is the time since the start, in nanoseconds.
	Nanos() int64,

	// NeverBackwards: a reading is never negative and never less than an
	// earlier one. Go's time.Since reads the monotonic clock, so this
	// holds on every schedule and across wall-clock changes.
	law NeverBackwards() {
		let a = Nanos()
		let b = Nanos()
		a >= 0 && b >= a
	},
}

// GoClock is Elapsed over Go's time.Time of its start.
type GoClock { start time.Time } implements Elapsed

// NewGoClock is a clock started now: Go's time.Now, which carries the
// monotonic reading time.Since subtracts from.
func NewGoClock() GoClock needs go.Foreign { GoClock{start: time.Now()} }

// Nanos is Go's time.Since the start.
func Nanos(c GoClock) int64 needs go.Foreign { int64(time.Since(c.start)) }
