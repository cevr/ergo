// Package app is the program as one machine: the route the address
// names, and the People page's search, which a People route drives. The
// address and its history are the host's (std ui's Location).

import addressroutes/people
import addressroutes/route
import machines
import option

// Results is the People page's list: loading the search Query, or loaded
// with the people Found for it.
type Results = Loading{Query string} | Loaded{Query string, Found []people.Person}

// Page is the People page: the search field, the searches made (newest
// first), and the results.
type Page { Input string, History []string, Results Results }

// App is the route and the People page, which lives on while other
// routes show.
type App { Route route.Route, Page Page }

// Key is a navigation shortcut: G then H, P, F or N.
type Key = GH{} | GP{} | GF{} | GN{}

// ShortcutsNavigate: each shortcut asks the host to go to its route's
// path, from any address, and changes nothing itself.
law ShortcutsNavigate(k Key, from int) {
	let a = Open(addressOf(from))
	let want = match k {
	case GH:
		"/"
	case GP:
		"/people"
	case GF:
		"/files"
	case GN:
		"/nested/route/is/very/nested"
	}
	Step(a, Pressed{Key: k}) == machines.Emit[App, Go]{Next: a, Output: Go{Path: want}}
}

// Signal is what the program reads: the address changed (a push, a back,
// a typed address), a link followed (its path), a shortcut, the search
// field typed in, Search clicked, and the search's answer, which the
// Loading page's timer gives.
type Signal = Navigated{Path string} | Followed{Path string} | Pressed{Key Key} | Typed{Text string} | Submit{} | Fetched{}

// Go is the program's request to navigate: the host pushes Path on its
// history (ui.Location) and tells the machine Navigated.
type Go { Path string }

// SearchTakes is how long a search takes to answer.
let SearchTakes = 300ms

// Target is the route a shortcut goes to.
func Target(k Key) route.Route {
	match k {
	case GH:
		route.Home
	case GP:
		route.People{Search: option.None}
	case GF:
		route.FilesIndex
	case GN:
		route.Nested
	}
}

func searchOf(r route.Route) string {
	match r {
	case route.People as p:
		match p.Search {
		case option.Some[string] as s:
			s.Value
		case option.None:
			""
		}
	case route.Home, route.Nested, route.Person, route.FilesIndex, route.Files, route.NotFound:
		""
	}
}

// Open is the program at the address path: its route, and a People page
// searching the route's text (none but a People route's).
func Open(path string) App {
	let r = route.Parse(path)
	let s = searchOf(r)
	App{Route: r, Page: Page{Input: s, History: people.Remember([]string{}, s), Results: Loading{Query: s}}}
}

// NavigationSetsTheRoute: a new address sets the route it names. A People
// route also sets the field to its search, records it and searches it
// anew, a new entry; any other route keeps the page and the entry.
law NavigationSetsTheRoute(from int, to int, typed string) {
	let a0 = Open(addressOf(from))
	let a = App{..a0, Page: Page{..a0.Page, Input: typed}}
	let path = addressOf(to)
	let r = route.Parse(path)
	let d = Step(a, Navigated{Path: path})
	match r {
	case route.People as p:
		let s = match p.Search {
		case option.Some[string] as v:
			v.Value
		case option.None:
			""
		}
		d == machines.Enter[App]{Next: App{Route: r, Page: Page{Input: s, History: people.Remember(a.Page.History, s), Results: Loading{Query: s}}}}
	case route.Home, route.Nested, route.Person, route.FilesIndex, route.Files, route.NotFound:
		d == machines.Stay[App]{Next: App{..a, Route: r}}
	}
}

let addresses = []string{"/", "/people", "/people?searchText=dev", "/people?searchText=", "/people/3", "/people/x", "/files", "/files/photos/vacation", "/nested/route/is/very/nested", "/nowhere?searchText=dev"}

func addressOf(k int) string { addresses[((k%addresses.Len())+addresses.Len())%addresses.Len()] }

// TypingOnlyEdits: typing in the search field changes the field and
// nothing else: no search and no history.
law TypingOnlyEdits(from int, text string) {
	let a = Open(addressOf(from))
	Step(a, Typed{Text: text}) == machines.Stay[App]{Next: App{..a, Page: Page{..a.Page, Input: text}}}
}

// SearchGoesToItsAddress: Search asks the host for the People address of
// the field's text, none for an empty field, and the address parses back
// to that search.
law SearchGoesToItsAddress(from int, text string) {
	let a0 = Open(addressOf(from))
	let a = App{..a0, Page: Page{..a0.Page, Input: text}}
	let search = if text == "" { option.None } else { option.Some[string]{Value: text} }
	match Step(a, Submit) {
	case machines.Emit[App, Go] as e:
		e.Next == a && route.Parse(e.Output.Path) == route.People{Search: search}
	case machines.Enter[App], machines.Stay[App], machines.Tell[App, Go], machines.Ignore, machines.Reject, machines.Done[Go]:
		false
	}
}

// Step is the program's transition. A new address sets the route; a
// People route also sets the field to its search, records the search and
// searches again, a new entry, so the search's timer starts anew. Any
// other route keeps the entry, so a search under way still answers. A
// link, a shortcut and Search ask the host to navigate (an Emit); the
// address changes only when the host says so.
func Step(a App, sig Signal) machines.Decision[App, Go] {
	match sig {
	case Navigated as n:
		let r = route.Parse(n.Path)
		match r {
		case route.People:
			let s = searchOf(r)
			machines.Enter[App]{Next: App{Route: r, Page: Page{Input: s, History: people.Remember(a.Page.History, s), Results: Loading{Query: s}}}}
		case route.Home, route.Nested, route.Person, route.FilesIndex, route.Files, route.NotFound:
			machines.Stay[App]{Next: App{..a, Route: r}}
		}
	case Followed as l:
		machines.Emit[App, Go]{Next: a, Output: Go{Path: l.Path}}
	case Pressed as p:
		machines.Emit[App, Go]{Next: a, Output: Go{Path: route.Print(Target(p.Key))}}
	case Typed as t:
		machines.Stay[App]{Next: App{..a, Page: Page{..a.Page, Input: t.Text}}}
	case Submit:
		let search = if a.Page.Input == "" { option.None } else { option.Some[string]{Value: a.Page.Input} }
		machines.Emit[App, Go]{Next: a, Output: Go{Path: route.Print(route.People{Search: search})}}
	case Fetched:
		match a.Page.Results {
		case Loading as l:
			machines.Stay[App]{Next: App{..a, Page: Page{..a.Page, Results: Loaded{Query: l.Query, Found: people.Search(l.Query)}}}}
		case Loaded:
			machines.Ignore
		}
	}
}

// Timer is the search's: a Loading page answers Fetched after
// SearchTakes.
func Timer(a App) option.Option[machines.Timeout[Signal]] {
	match a.Page.Results {
	case Loading:
		option.Some[machines.Timeout[Signal]]{Value: machines.Timeout[Signal]{In: SearchTakes, Signal: Fetched}}
	case Loaded:
		option.None
	}
}

// Router is the program as a machine. Its input is the address it opens
// at.
type Router machine[App, Signal] {
	initial: Open,
	step:    Step,
	after:   Timer,
}
