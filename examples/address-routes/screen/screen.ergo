// Package screen is the program on a screen (stage b): the
// navigation's four links on every route, then the route's page. A link is a Semantic with the Link role whose press follows its
// path (app.Followed); the host pushes it and the address change comes
// back as app.Navigated, from OnURL.

import addressroutes/app
import addressroutes/files
import addressroutes/people
import addressroutes/route
import option
import strings
import ui

// SearchPlaceholder is the People page's search field.
let SearchPlaceholder = "Search by name or role..."

// Screen is the program: the navigation and the route's page.
func Screen(f mut ui.Frame[app.Signal], a app.App) {
	ui.OnURL(f, func(u ui.URL) option.Option[app.Signal] { option.Some[app.Signal]{Value: app.Navigated{Path: ui.Href(u)}} })
	ui.Column(f, ui.Plain()) {
		ui.Semantic(f, named(ui.List, "Navigation", option.None), option.None, ui.Plain()) {
			link(f, "Home", route.Print(route.Home))
			link(f, "People", route.Print(route.People{Search: option.None}))
			link(f, "Files", route.Print(route.FilesIndex))
			link(f, "Nested", route.Print(route.Nested))
		}
		page(f, a)
	}
}

// page is the route's page.
func page(f mut ui.Frame[app.Signal], a app.App) {
	match a.Route {
	case route.Home:
		heading(f, "Welcome Home", 1)
		ui.Text(f, "This is a routing example built with Ergo. Navigate using the links above to see different routes in action.")
	case route.Nested:
		heading(f, "Very Nested Route!", 1)
		ui.Text(f, "You found the deeply nested route at \(route.NestedPath)")
	case route.People:
		peoplePage(f, a.Page)
	case route.Person as p:
		person(f, p.ID)
	case route.FilesIndex:
		heading(f, "Files", 1)
		ui.Text(f, "Every path under /files parses into a single route that captures the remaining segments with rest.")
		entries(f, []string{}, files.Tree)
	case route.Files as x:
		filesPage(f, x.Path)
	case route.NotFound as n:
		heading(f, "404 - Page Not Found", 1)
		ui.Text(f, "The path \"\(n.Path)\" was not found.")
		link(f, "← Go Home", route.Print(route.Home))
	}
}

// peoplePage is the search, the recent searches, the status and the list.
func peoplePage(f mut ui.Frame[app.Signal], p app.Page) {
	heading(f, "People", 1)
	ui.Input(f, p.Input, SearchPlaceholder, func(t string) app.Signal { app.Typed{Text: t} })
	ui.Pressable(f, "Search", app.Submit) {
		ui.Text(f, "Search")
	}
	if p.History.Len() > 0 {
		ui.Text(f, "Recent searches: \(strings.Join(p.History, ", "))")
	}
	ui.Text(f, Status(p.Results))
	match p.Results {
	case app.Loaded as l:
		ui.Semantic(f, named(ui.List, "People", option.None), option.None, ui.Plain()) {
			ui.Each(f, l.Found, func(q people.Person) ui.Key { ui.ByInt(q.ID) }) func(q people.Person) {
				link(f, q.Name, route.Print(route.Person{ID: q.ID}))
				ui.Text(f, q.Role)
			}
		}
	case app.Loading:
	}
}

// Status is the People page's status line.
func Status(r app.Results) string {
	match r {
	case app.Loading:
		"Searching…"
	case app.Loaded as l:
		if l.Query == "" {
			return "Click on any person to view their details:"
		}
		let n = l.Found.Len()
		"\(n) \(if n == 1 { "result" } else { "results" }) for “\(l.Query)”"
	}
}

// person is a person's page, or the not-found panel.
func person(f mut ui.Frame[app.Signal], id int) {
	let back = route.Print(route.People{Search: option.None})
	match people.Find(id) {
	case option.Some[people.Person] as q:
		link(f, "← Back to People", back)
		heading(f, q.Value.Name, 2)
		ui.Text(f, "ID: \(q.Value.ID)")
		ui.Text(f, "Role: \(q.Value.Role)")
	case option.None:
		heading(f, "Person Not Found", 2)
		ui.Text(f, "No person found with ID: \(id)")
		link(f, "← Back to People", back)
	}
}

// filesPage is the breadcrumb, then the directory's entries, the file's
// details, or the missing panel.
func filesPage(f mut ui.Frame[app.Signal], path []string) {
	ui.Semantic(f, named(ui.List, "Breadcrumb", option.None), option.None, ui.Plain()) {
		link(f, "Files", route.Print(route.FilesIndex))
		for i, segment in path {
			if i == path.Len()-1 {
				ui.Text(f, segment)
			} else {
				link(f, segment, route.Print(route.Files{Path: path[0 : i+1]}))
			}
		}
	}
	match files.Find(files.Tree, path) {
	case option.Some[files.Entry] as e:
		match e.Value {
		case files.Dir as d:
			entries(f, path, d.Entries)
		case files.File as x:
			heading(f, x.Name, 2)
			ui.Text(f, files.Size(x.Size))
		}
	case option.None:
		heading(f, "Nothing Here", 2)
		ui.Text(f, "No file or directory at \"\(strings.Join(path, "/"))\".")
		link(f, "← Back to Files", route.Print(route.FilesIndex))
	}
}

// entries is a directory's entries under parent: each a link and its size
// or its count of items.
func entries(f mut ui.Frame[app.Signal], parent []string, es []files.Entry) {
	ui.Semantic(f, named(ui.List, "Entries", option.None), option.None, ui.Plain()) {
		for e in es {
			let name = files.Name(e)
			link(f, name, route.Print(route.Files{Path: parent.Append(name)}))
			match e {
			case files.File as x:
				ui.Text(f, files.Size(x.Size))
			case files.Dir as d:
				ui.Text(f, if d.Entries.Len() == 1 { "1 item" } else { "\(d.Entries.Len()) items" })
			}
		}
	}
}

func link(f mut ui.Frame[app.Signal], label string, path string) {
	ui.Semantic(f, named(ui.Link, label, option.None), option.Some[app.Signal]{Value: app.Followed{Path: path}}, ui.Plain()) {
		ui.Text(f, label)
	}
}

func heading(f mut ui.Frame[app.Signal], text string, level int) {
	ui.Semantic(f, named(ui.Heading, text, option.Some{Value: level}), option.None, ui.Plain()) {
		ui.Text(f, text)
	}
}

// named is the access of a container with a role and a name.
func named(role ui.Role, name string, level option.Option[int]) ui.Access {
	ui.Access{Role: role, Name: name, Disabled: false, Description: "", Checked: option.None, Value: option.None, Selected: option.None, Expanded: option.None, Pressed: option.None, Invalid: false, Busy: false, HasPopup: false, Level: level, Mixed: false, Current: option.None, Modal: false, MultiSelectable: false, Range: option.None, Key: ui.NoKey, Rels: []ui.Rel{}}
}
