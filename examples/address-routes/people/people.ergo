// Package people is the people the People routes list and search.

import strings
import slices

// Person is someone on the list.
type Person { ID int, Name string, Role string }

// All is everyone, in order.
let All = []Person{
	Person{ID: 1, Name: "Alice Johnson", Role: "Designer"},
	Person{ID: 2, Name: "Bob Smith", Role: "Developer"},
	Person{ID: 3, Name: "Carol Davis", Role: "Manager"},
	Person{ID: 4, Name: "David Wilson", Role: "Developer"},
	Person{ID: 5, Name: "Eva Brown", Role: "Designer"},
}

// HistoryLimit is how many searches the history keeps.
let HistoryLimit = 5

// Search is everyone whose name or role contains text, in any case, in
// order; everyone for an empty text.
func Search(text string) []Person {
	let q = strings.ToLower(text)
	let mut out = []Person{}
	for p in All {
		if strings.Contains(strings.ToLower(p.Name), q) || strings.Contains(strings.ToLower(p.Role), q) {
			out = out.Append(p)
		}
	}
	out
}

// SearchMatchesNameOrRole: a search finds a person by any part of their
// name or role, in any case, and finds no one whose name and role both
// lack the text.
law SearchMatchesNameOrRole(who int, from int, to int, upper bool) {
	let p = All[((who%len(All))+len(All))%len(All)]
	let source = if from%2 == 0 { p.Name } else { p.Role }
	let a = ((from % len(source)) + len(source)) % len(source)
	let b = a + ((to%(len(source)-a+1))+(len(source)-a+1))%(len(source)-a+1)
	let text = if upper { strings.ToUpper(source[a:b]) } else { source[a:b] }
	let t = strings.ToLower(text)
	let mut found = false
	for q in Search(text) {
		if !(strings.Contains(strings.ToLower(q.Name), t) || strings.Contains(strings.ToLower(q.Role), t)) {
			return false
		}
		found = found || q == p
	}
	found
}

// Find is the person numbered id.
func Find(id int) Option[Person] {
	for p in All {
		if p.ID == id {
			return Some[Person]{Value: p}
		}
	}
	None
}

// Remember is history with text first: an empty text changes nothing,
// and a text already there moves to the front. It keeps the newest
// HistoryLimit.
func Remember(history []string, text string) []string {
	if text == "" {
		return history
	}
	let mut out = []string{text}
	for h in history {
		if h != text && len(out) < HistoryLimit {
			out = out.Append(h)
		}
	}
	out
}

// HistoryKeepsTheNewestDistinct: after any searches, the history is the
// distinct non-empty texts, newest first, at most HistoryLimit of them.
law HistoryKeepsTheNewestDistinct(picks []int) {
	let texts = []string{"", "a", "dev", "bob", "eva", "x", "an", "o"}
	let mut h = []string{}
	let mut seen = []string{}
	for k in picks {
		let t = texts[((k%len(texts))+len(texts))%len(texts)]
		h = Remember(h, t)
		if t != "" {
			seen = front(t, slices.Filter(seen, func(x string) bool { x != t }))
		}
	}
	let want = if len(seen) > HistoryLimit { seen[0:HistoryLimit] } else { seen }
	h == want
}

func front(t string, xs []string) []string {
	let mut out = []string{t}
	for x in xs {
		out = out.Append(x)
	}
	out
}
