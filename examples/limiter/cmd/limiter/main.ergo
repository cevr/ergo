// limiter serves a rate limiter to a TypeScript Effect gateway over
// Effect RPC. Package limits is the contract (the operation type and its
// laws); package bucket is the token bucket machine; package memory holds
// the buckets; limits/limitsrpc is generated by `ergo gen rpc
// limits.Limiter`. This
// binary is the only place that chooses them: it binds limits.Limiter to
// a memory limiter of two buckets and serves it on a loopback port, which
// it prints first so the gateway can find it.

import limiter/bucket
import limiter/limits
import limiter/limits/limitsrpc
import http
import limiter/memory
import os
import queue
import rpc
import strings
import task

// buckets is the limiter's shape: "api" holds five tokens and gets one
// back every 200 ms of its clock; "search" holds three, one per second.
func buckets() Map[string, bucket.Spec] {
	let mut specs = Map[string, bucket.Spec]{}
	specs["api"] = bucket.Spec{Capacity: 5, RefillMs: 200}
	specs["search"] = bucket.Spec{Capacity: 3, RefillMs: 1000}
	specs
}

// told is a Hold's note as a line, which the gateway's case waits for.
func told(n memory.Note) string {
	match n {
	case memory.Waits as w:
		"hold \(w.Hold) waits on \(w.Key)"
	case memory.Released as r:
		"hold \(r.Hold) released"
	}
}

// check is the small caller beside the server, `limiter check URL`: it
// asks the limiter that URL names for its buckets through the checked
// call, so a limiter that does not answer, or a URL that names no
// limiter, is a typed rpc.Transport: a line and status 1, not a defect.
func check(url string) fails os.Exit needs Console | Ambient {
	let keys = limitsrpc.BucketsChecked(limitsrpc.NewClient(rpc.Dial(url))) catch {
	case rpc.Transport:
		return os.Exit{Code: 1, Message: "limiter: no limiter answers at \(url)"}
	}
	Console.Println("the limiter has the buckets \(strings.Join(keys, ", "))")
}

func main() fails http.ListenFailed | http.InvalidLimits | os.Exit needs Console | Ambient {
	let args = os.NewHost().Args()
	if len(args) == 2 && args[0] == "check" {
		try check(args[1])
		return
	}
	let l = try http.Listen("127.0.0.1:0")
	Console.Println("listening \(l.Addr())")
	let notes = queue.New[memory.Note](64)
	let printer = task.Go() {
		for n in notes.Values() {
			Console.Println(told(n))
		}
	}
	with context { limits.Limiter: memory.New(buckets(), notes), Scheduler: NewLiveScheduler() } {
		try rpc.Serve(l, http.Limits{MaxBodyBytes: 65536, MaxHeaderBytes: 16384, IdleTimeout: 5s, ReadHeaderTimeout: 10s, ReadBodyTimeout: 30s}, "/rpc", limitsrpc.Handle)
	}
	notes.End()
	printer.Stop()
}
