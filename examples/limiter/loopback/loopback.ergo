// Package loopback is a limiter through the wire: the generated RPC
// Client of a limiter that its generated server serves in this process
// (rpc.Loopback). Every operation crosses Effect RPC's HTTP wire and the
// contract's codecs both ways. The package picks no limiter: its caller
// passes one in. Its tests (tests.ergo) pass a memory limiter and hold the
// limits.Limiter laws through the wire, as the memory package holds them
// directly.

import limiter/limits
import limiter/limits/limitsrpc
import rpc

// Loopback is a limits.Limiter whose every operation is an RPC call.
type Loopback { client limitsrpc.Client }

// NewLoopback serves inner in process and is its client. The server binds
// inner for each call, so every call reaches the same limiter when the
// copies of inner share their state (a memory.Memory's do).
func NewLoopback(inner limits.Limiter) Loopback {
	let conn = rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		with context { limits.Limiter: inner } {
			try limitsrpc.Handle(tag, payload)
		}
	})
	Loopback{client: limitsrpc.NewClient(conn)}
}

// Take is limits.Limiter's Take, over the wire.
func Take(l Loopback, key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost {
	try limitsrpc.Take(l.client, key, cost)
}

// Hold is limits.Limiter's Hold, over the wire.
func Hold(l Loopback, key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost {
	try limitsrpc.Hold(l.client, key, cost)
}

// Peek is limits.Limiter's Peek, over the wire.
func Peek(l Loopback, key string) Option[limits.Level] { limitsrpc.Peek(l.client, key) }

// Advance is limits.Limiter's Advance, over the wire.
func Advance(l Loopback, ms int) { limitsrpc.Advance(l.client, ms) }

// Buckets is limits.Limiter's Buckets, over the wire.
func Buckets(l Loopback) []string { limitsrpc.Buckets(l.client) }
