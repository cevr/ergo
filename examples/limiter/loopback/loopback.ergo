// Package loopback builds the generated clients of a limiter its caller
// passes in, served in this process: NewLoopback's RPC Client crosses
// Effect RPC's HTTP wire and the contract's codecs both ways
// (rpc.Loopback), and NewHub's hub Client carries each Request to a Call
// on it. The package picks no limiter. Its tests (tests.ergo) pass a
// memory limiter and hold the limits.Limiter laws on both clients, as the
// memory package holds them directly.

import limiter/limits
import limiter/limits/limitsapi
import limiter/limits/limitsrpc
import rpc

// NewLoopback serves inner in process and is its RPC client. The server
// binds inner for each call, so every call reaches the same limiter when
// the copies of inner share their state (a memory.Memory's do).
func NewLoopback(inner limits.Limiter) limitsrpc.Client {
	limitsrpc.NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		with context { limits.Limiter: inner } {
			try limitsrpc.Handle(tag, payload)
		}
	}))
}

// NewHub is the hub client of inner: each Request is a Call with inner
// bound, so its laws hold exactly when inner's and Call's do.
func NewHub(inner limits.Limiter) limitsapi.Client {
	limitsapi.NewClient(inner)
}
