// The limits.Limiter laws through the wire. A test file is where a test
// picks its provider (cmd/limiter/main.ergo picks the binary's): each case
// serves a fresh memory limiter (memory.NewMemory) and calls it through a
// Loopback, so the same laws that hold for the memory provider hold for
// its client.

import limiter/limits
import limiter/memory

// overMemory is a Loopback over a fresh memory limiter.
func overMemory() Loopback { NewLoopback(memory.NewMemory()) }

test NeverOverdrawsThroughTheWire(pick int, costs []int) {
	with context { limits.Limiter: overMemory() } {
		assert limits.NeverOverdraws(pick, costs)
	}
}

test RetryAfterIsExactThroughTheWire(pick int, cost int) {
	with context { limits.Limiter: overMemory() } {
		assert limits.RetryAfterIsExact(pick, cost)
	}
}

test LimitedTakesNothingThroughTheWire(pick int, cost int) {
	with context { limits.Limiter: overMemory() } {
		assert limits.LimitedTakesNothing(pick, cost)
	}
}
