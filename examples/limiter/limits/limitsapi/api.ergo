import json
import option
import rpc
import scope
import sync
import limiter/limits

// Request is one call of limits.Limiter: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = TakeRequest{Key string, Cost int} | HoldRequest{Key string, Cost int} | PeekRequest{Key string} | AdvanceRequest{Ms int} | BucketsRequest{}

// Op is an operation of limits.Limiter: what a policy matches on.
type Op = TakeOp{} | HoldOp{} | PeekOp{} | AdvanceOp{} | BucketsOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = TakeReply{Value limits.Grant} | HoldReply{Value limits.Grant} | PeekReply{Value option.Option[limits.Level]} | AdvanceReply{} | BucketsReply{Value []string}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = Limited{E limits.Limited} | UnknownBucket{E limits.UnknownBucket} | BadCost{E limits.BadCost}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case TakeRequest:
		TakeOp
	case HoldRequest:
		HoldOp
	case PeekRequest:
		PeekOp
	case AdvanceRequest:
		AdvanceOp
	case BucketsRequest:
		BucketsOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case TakeOp:
		"take"
	case HoldOp:
		"hold"
	case PeekOp:
		"peek"
	case AdvanceOp:
		"advance"
	case BucketsOp:
		"buckets"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case TakeOp:
		"Take(key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost"
	case HoldOp:
		"Hold(key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost"
	case PeekOp:
		"Peek(key string) option.Option[limits.Level]"
	case AdvanceOp:
		"Advance(ms int)"
	case BucketsOp:
		"Buckets() []string"
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case TakeOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"cost\":{\"type\":\"integer\"}},\"required\":[\"key\",\"cost\"]}")
	case HoldOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"cost\":{\"type\":\"integer\"}},\"required\":[\"key\",\"cost\"]}")
	case PeekOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"}},\"required\":[\"key\"]}")
	case AdvanceOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"ms\":{\"type\":\"integer\"}},\"required\":[\"ms\"]}")
	case BucketsOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	}
}

// Call answers r on the bound limits.Limiter: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs limits.Limiter {
	match r {
	case TakeRequest as x:
		let v = limits.Limiter.Take(x.Key, x.Cost) catch {
		case limits.Limited as e:
			return Rejected{Failure: Limited{E: e}}
		case limits.UnknownBucket as e:
			return Rejected{Failure: UnknownBucket{E: e}}
		case limits.BadCost as e:
			return Rejected{Failure: BadCost{E: e}}
		}
		Done{Reply: TakeReply{Value: v}}
	case HoldRequest as x:
		let v = limits.Limiter.Hold(x.Key, x.Cost) catch {
		case limits.UnknownBucket as e:
			return Rejected{Failure: UnknownBucket{E: e}}
		case limits.BadCost as e:
			return Rejected{Failure: BadCost{E: e}}
		}
		Done{Reply: HoldReply{Value: v}}
	case PeekRequest as x:
		let v = limits.Limiter.Peek(x.Key)
		Done{Reply: PeekReply{Value: v}}
	case AdvanceRequest as x:
		limits.Limiter.Advance(x.Ms)
		Done{Reply: AdvanceReply}
	case BucketsRequest:
		let v = limits.Limiter.Buckets()
		Done{Reply: BucketsReply{Value: v}}
	}
}

// Client provides limits.Limiter by invoking typed per-operation handlers directly:
// a direct call returns its exact value or declared failure row with no Outcome boxing.
type Client { opTake func(string, int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost, opHold func(string, int) limits.Grant fails limits.UnknownBucket | limits.BadCost, opPeek func(string) option.Option[limits.Level], opAdvance func(int), opBuckets func() []string } implements limits.Limiter

// NewClient is the limits.Limiter that invokes inner directly per operation.
func NewClient(inner limits.Limiter) Client {
	Client{
		opTake:    func(key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost { try inner.Take(key, cost) },
		opHold:    func(key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost { try inner.Hold(key, cost) },
		opPeek:    func(key string) option.Option[limits.Level] { inner.Peek(key) },
		opAdvance: func(ms int) { inner.Advance(ms) },
		opBuckets: func() []string { inner.Buckets() },
	}
}

// ClientInForce is the limits.Limiter that invokes the provider currently in force.
func ClientInForce() Client needs limits.Limiter {
	let held = scope.InForce[limits.Limiter]()
	Client{
		opTake:    func(key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost { with held { try limits.Limiter.Take(key, cost) } },
		opHold:    func(key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost { with held { try limits.Limiter.Hold(key, cost) } },
		opPeek:    func(key string) option.Option[limits.Level] { with held { limits.Limiter.Peek(key) } },
		opAdvance: func(ms int) { with held { limits.Limiter.Advance(ms) } },
		opBuckets: func() []string { with held { limits.Limiter.Buckets() } },
	}
}

// Take invokes limits.Limiter's Take directly.
func Take(client Client, key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost {
	try client.opTake(key, cost)
}

// Hold invokes limits.Limiter's Hold directly.
func Hold(client Client, key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost {
	try client.opHold(key, cost)
}

// Peek invokes limits.Limiter's Peek directly.
func Peek(client Client, key string) option.Option[limits.Level] {
	client.opPeek(key)
}

// Advance invokes limits.Limiter's Advance directly.
func Advance(client Client, ms int) {
	client.opAdvance(ms)
}

// Buckets invokes limits.Limiter's Buckets directly.
func Buckets(client Client) []string {
	client.opBuckets()
}

// CheckedClient carries erased limits.Limiter requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// TakeChecked sends limits.Limiter's Take over send and validates its Outcome.
func TakeChecked(client CheckedClient, key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost | rpc.Transport {
	match try client.send(TakeRequest{Key: key, Cost: cost}) {
	case Done as done:
		match done.Reply {
		case TakeReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "limitsapi: Take was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Limited as failure:
			return failure.E
		case UnknownBucket as failure:
			return failure.E
		case BadCost as failure:
			return failure.E
		}
	}
}

// HoldChecked sends limits.Limiter's Hold over send and validates its Outcome.
func HoldChecked(client CheckedClient, key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost | rpc.Transport {
	match try client.send(HoldRequest{Key: key, Cost: cost}) {
	case Done as done:
		match done.Reply {
		case HoldReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "limitsapi: Hold was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case UnknownBucket as failure:
			return failure.E
		case BadCost as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "limitsapi: Hold was answered with a failure outside its row"}
		}
	}
}

// PeekChecked sends limits.Limiter's Peek over send and validates its Outcome.
func PeekChecked(client CheckedClient, key string) option.Option[limits.Level] fails rpc.Transport {
	match try client.send(PeekRequest{Key: key}) {
	case Done as done:
		match done.Reply {
		case PeekReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "limitsapi: Peek was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "limitsapi: Peek was answered with a failure outside its row"}
	}
}

// AdvanceChecked sends limits.Limiter's Advance over send and validates its Outcome.
func AdvanceChecked(client CheckedClient, ms int) fails rpc.Transport {
	match try client.send(AdvanceRequest{Ms: ms}) {
	case Done as done:
		match done.Reply {
		case AdvanceReply:
		case _:
			return rpc.Transport{Reason: "limitsapi: Advance was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "limitsapi: Advance was answered with a failure outside its row"}
	}
}

// BucketsChecked sends limits.Limiter's Buckets over send and validates its Outcome.
func BucketsChecked(client CheckedClient) []string fails rpc.Transport {
	match try client.send(BucketsRequest) {
	case Done as done:
		match done.Reply {
		case BucketsReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "limitsapi: Buckets was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "limitsapi: Buckets was answered with a failure outside its row"}
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Take limits.Grant, Hold limits.Grant, Peek option.Option[limits.Level], Buckets []string }

func inRow(op Op, f Failure) bool {
	match op {
	case TakeOp:
		match f {
		case Limited, UnknownBucket, BadCost:
			true
		}
	case HoldOp:
		match f {
		case UnknownBucket, BadCost:
			true
		case _:
			false
		}
	case PeekOp, AdvanceOp, BucketsOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case TakeRequest:
		Done{Reply: TakeReply{Value: g.Values.Take}}
	case HoldRequest:
		Done{Reply: HoldReply{Value: g.Values.Hold}}
	case PeekRequest:
		Done{Reply: PeekReply{Value: g.Values.Peek}}
	case AdvanceRequest:
		Done{Reply: AdvanceReply}
	case BucketsRequest:
		Done{Reply: BucketsReply{Value: g.Values.Buckets}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opTake: func(key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost {
			sent.Update(func(rs []Request) []Request { rs.Append(TakeRequest{Key: key, Cost: cost}) })
			if g.Failing {
				match g.Failure {
				case Limited as err:
					return err.E
				case UnknownBucket as err:
					return err.E
				case BadCost as err:
					return err.E
				}
			}
			g.Values.Take
		},
		opHold: func(key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost {
			sent.Update(func(rs []Request) []Request { rs.Append(HoldRequest{Key: key, Cost: cost}) })
			if g.Failing {
				match g.Failure {
				case UnknownBucket as err:
					return err.E
				case BadCost as err:
					return err.E
				case _:
				}
			}
			g.Values.Hold
		},
		opPeek: func(key string) option.Option[limits.Level] {
			sent.Update(func(rs []Request) []Request { rs.Append(PeekRequest{Key: key}) })
			g.Values.Peek
		},
		opAdvance: func(ms int) {
			sent.Update(func(rs []Request) []Request { rs.Append(AdvanceRequest{Ms: ms}) })
		},
		opBuckets: func() []string {
			sent.Update(func(rs []Request) []Request { rs.Append(BucketsRequest) })
			g.Values.Buckets
		},
	}
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case TakeRequest as x:
		let v = TakeChecked(client, x.Key, x.Cost) catch {
		case limits.Limited as e:
			return Rejected{Failure: Limited{E: e}}
		case limits.UnknownBucket as e:
			return Rejected{Failure: UnknownBucket{E: e}}
		case limits.BadCost as e:
			return Rejected{Failure: BadCost{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: TakeReply{Value: v}}
	case HoldRequest as x:
		let v = HoldChecked(client, x.Key, x.Cost) catch {
		case limits.UnknownBucket as e:
			return Rejected{Failure: UnknownBucket{E: e}}
		case limits.BadCost as e:
			return Rejected{Failure: BadCost{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: HoldReply{Value: v}}
	case PeekRequest as x:
		let v = PeekChecked(client, x.Key) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: PeekReply{Value: v}}
	case AdvanceRequest as x:
		AdvanceChecked(client, x.Ms) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: AdvanceReply}
	case BucketsRequest:
		let v = BucketsChecked(client) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: BucketsReply{Value: v}}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { limits.Limiter: scripted(g, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(g, sent)
	let outer = NewClient(inner)
	let got = with context { limits.Limiter: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted(g, sentChecked)
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { limits.Limiter: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
