import json
import sync
import limiter/limits

// Request is one call of limits.Limiter: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = TakeRequest{Key string, Cost int} | HoldRequest{Key string, Cost int} | PeekRequest{Key string} | AdvanceRequest{Ms int} | BucketsRequest{}

// Op is an operation of limits.Limiter: what a policy matches on.
type Op = TakeOp{} | HoldOp{} | PeekOp{} | AdvanceOp{} | BucketsOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = TakeReply{Value limits.Grant} | HoldReply{Value limits.Grant} | PeekReply{Value Option[limits.Level]} | AdvanceReply{} | BucketsReply{Value []string}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = Limited{E limits.Limited} | UnknownBucket{E limits.UnknownBucket} | BadCost{E limits.BadCost}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case TakeRequest:
		TakeOp
	case HoldRequest:
		HoldOp
	case PeekRequest:
		PeekOp
	case AdvanceRequest:
		AdvanceOp
	case BucketsRequest:
		BucketsOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case TakeOp:
		"take"
	case HoldOp:
		"hold"
	case PeekOp:
		"peek"
	case AdvanceOp:
		"advance"
	case BucketsOp:
		"buckets"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case TakeOp:
		"Take(key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost"
	case HoldOp:
		"Hold(key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost"
	case PeekOp:
		"Peek(key string) Option[limits.Level]"
	case AdvanceOp:
		"Advance(ms int)"
	case BucketsOp:
		"Buckets() []string"
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case TakeOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"cost\":{\"type\":\"integer\"}},\"required\":[\"key\",\"cost\"]}")
	case HoldOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"cost\":{\"type\":\"integer\"}},\"required\":[\"key\",\"cost\"]}")
	case PeekOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"}},\"required\":[\"key\"]}")
	case AdvanceOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"ms\":{\"type\":\"integer\"}},\"required\":[\"ms\"]}")
	case BucketsOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	}
}

// Call answers r on the bound limits.Limiter: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs limits.Limiter {
	match r {
	case TakeRequest as x:
		let v = limits.Limiter.Take(x.Key, x.Cost) catch {
		case limits.Limited as e:
			return Rejected{Failure: Limited{E: e}}
		case limits.UnknownBucket as e:
			return Rejected{Failure: UnknownBucket{E: e}}
		case limits.BadCost as e:
			return Rejected{Failure: BadCost{E: e}}
		}
		Done{Reply: TakeReply{Value: v}}
	case HoldRequest as x:
		let v = limits.Limiter.Hold(x.Key, x.Cost) catch {
		case limits.UnknownBucket as e:
			return Rejected{Failure: UnknownBucket{E: e}}
		case limits.BadCost as e:
			return Rejected{Failure: BadCost{E: e}}
		}
		Done{Reply: HoldReply{Value: v}}
	case PeekRequest as x:
		let v = limits.Limiter.Peek(x.Key)
		Done{Reply: PeekReply{Value: v}}
	case AdvanceRequest as x:
		limits.Limiter.Advance(x.Ms)
		Done{Reply: AdvanceReply}
	case BucketsRequest:
		let v = limits.Limiter.Buckets()
		Done{Reply: BucketsReply{Value: v}}
	}
}

// Client provides limits.Limiter over send, any way to carry a Request to a
// Call and its Outcome back. An Outcome that is not the operation's (the
// value of another, a failure outside its row) is a defect.
type Client { send func(r Request) Outcome } implements limits.Limiter

// NewClient is the limits.Limiter that send answers.
func NewClient(send own func(r Request) Outcome) Client { Client{send: send} }

// Take sends limits.Limiter's Take and answers its Outcome.
func Take(client Client, key string, cost int) limits.Grant fails limits.Limited | limits.UnknownBucket | limits.BadCost {
	match client.send(TakeRequest{Key: key, Cost: cost}) {
	case Done as done:
		match done.Reply {
		case TakeReply as reply:
			reply.Value
		case _:
			Unreachable("limitsapi: Take was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Limited as failure:
			return failure.E
		case UnknownBucket as failure:
			return failure.E
		case BadCost as failure:
			return failure.E
		}
	}
}

// Hold sends limits.Limiter's Hold and answers its Outcome.
func Hold(client Client, key string, cost int) limits.Grant fails limits.UnknownBucket | limits.BadCost {
	match client.send(HoldRequest{Key: key, Cost: cost}) {
	case Done as done:
		match done.Reply {
		case HoldReply as reply:
			reply.Value
		case _:
			Unreachable("limitsapi: Hold was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case UnknownBucket as failure:
			return failure.E
		case BadCost as failure:
			return failure.E
		case _:
			Unreachable("limitsapi: Hold was answered with a failure outside its row")
		}
	}
}

// Peek sends limits.Limiter's Peek and answers its Outcome.
func Peek(client Client, key string) Option[limits.Level] {
	match client.send(PeekRequest{Key: key}) {
	case Done as done:
		match done.Reply {
		case PeekReply as reply:
			reply.Value
		case _:
			Unreachable("limitsapi: Peek was answered with the value of another operation")
		}
	case Rejected:
		Unreachable("limitsapi: Peek was answered with a failure outside its row")
	}
}

// Advance sends limits.Limiter's Advance and answers its Outcome.
func Advance(client Client, ms int) {
	match client.send(AdvanceRequest{Ms: ms}) {
	case Done as done:
		match done.Reply {
		case AdvanceReply:
		case _:
			Unreachable("limitsapi: Advance was answered with the value of another operation")
		}
	case Rejected:
		Unreachable("limitsapi: Advance was answered with a failure outside its row")
	}
}

// Buckets sends limits.Limiter's Buckets and answers its Outcome.
func Buckets(client Client) []string {
	match client.send(BucketsRequest) {
	case Done as done:
		match done.Reply {
		case BucketsReply as reply:
			reply.Value
		case _:
			Unreachable("limitsapi: Buckets was answered with the value of another operation")
		}
	case Rejected:
		Unreachable("limitsapi: Buckets was answered with a failure outside its row")
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Take limits.Grant, Hold limits.Grant, Peek Option[limits.Level], Buckets []string }

func inRow(op Op, f Failure) bool {
	match op {
	case TakeOp:
		match f {
		case Limited, UnknownBucket, BadCost:
			true
		}
	case HoldOp:
		match f {
		case UnknownBucket, BadCost:
			true
		case _:
			false
		}
	case PeekOp, AdvanceOp, BucketsOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case TakeRequest:
		Done{Reply: TakeReply{Value: g.Values.Take}}
	case HoldRequest:
		Done{Reply: HoldReply{Value: g.Values.Hold}}
	case PeekRequest:
		Done{Reply: PeekReply{Value: g.Values.Peek}}
	case AdvanceRequest:
		Done{Reply: AdvanceReply}
	case BucketsRequest:
		Done{Reply: BucketsReply{Value: g.Values.Buckets}}
	}
}

func scripted(want Outcome, sent sync.Ref[[]Request]) Client {
	NewClient(func(q Request) Outcome {
		sent.Update(func(rs []Request) []Request { rs.Append(q) })
		want
	})
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { limits.Limiter: scripted(want, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a Client whose send is Call answers each call as the
// provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(want, sent)
	let outer = NewClient(func(q Request) Outcome {
		with context { limits.Limiter: inner } { Call(q) }
	})
	let got = with context { limits.Limiter: outer } { Call(r) }
	got == want && sent.Get() == []Request{r}
}
