import api
import rpc
import limiter/limits
import limiter/limits/limitsapi

// Handle runs one call of limits.Limiter on the provider the caller binds,
// through the hub's Call: tag names the operation and payload is its
// Request's JSON. Its value is the result's JSON; a typed failure is
// Failed with the failure's tagged JSON. A request the contract does not
// hold and an int the wire cannot carry are defects, which the server
// answers as Die.
func Handle(tag string, payload string) string fails rpc.Failed needs limits.Limiter {
	try handle(tag, payload, limitsapi.Call)
}

func handle[R](tag string, payload string, answer func(r Request) limitsapi.Outcome needs R) string fails rpc.Failed needs R {
	let req = rpc.Decode[Request]("request", rpc.Tagged(tag+"Request", payload)) catch {
	case rpc.Transport as t:
		return rpc.Die[string]("RpcError", t.Reason)
	}
	match req {
	case TakeRequest as r:
		exactTakeRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case HoldRequest as r:
		exactHoldRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case AdvanceRequest as r:
		exactAdvanceRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case _:
	}
	match answer(req) {
	case limitsapi.Done as done:
		match done.Reply {
		case limitsapi.TakeReply as reply:
			let v = reply.Value
			exactLimitsGrant(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case limitsapi.HoldReply as reply:
			let v = reply.Value
			exactLimitsGrant(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case limitsapi.PeekReply as reply:
			let v = reply.Value
			exactOptionLimitsLevel(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case limitsapi.AdvanceReply:
			"null"
		case limitsapi.BucketsReply as reply:
			let v = reply.Value
			rpc.Encode(v)
		}
	case limitsapi.Rejected as rejected:
		match rejected.Failure {
		case limitsapi.Limited as failure:
			let e = failure.E
			exactLimitsLimited(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("Limited", rpc.Encode(e))}
		case limitsapi.UnknownBucket as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("UnknownBucket", rpc.Encode(e))}
		case limitsapi.BadCost as failure:
			let e = failure.E
			exactLimitsBadCost(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("BadCost", rpc.Encode(e))}
		}
	}
}

func carry(c Request, answer own func(c Request) limitsapi.Outcome) limitsapi.Outcome {
	let client = NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		try handle(tag, payload, answer)
	}))
	with context { limits.Limiter: client } { limitsapi.Call(c) }
}

// Wire is Effect RPC as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, limitsapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) limitsapi.Outcome) limitsapi.Outcome { carry(c, answer) }

// Fits reports whether r and o hold only ints the wire carries exactly
// (an int beyond 2^53-1 is Unrepresentable, a defect on either side).
func Fits(r Request, o limitsapi.Outcome) bool {
	match r {
	case limitsapi.TakeRequest as x:
		exactTakeRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case limitsapi.HoldRequest as x:
		exactHoldRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case limitsapi.AdvanceRequest as x:
		exactAdvanceRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case _:
	}
	match o {
	case limitsapi.Done as done:
		match done.Reply {
		case limitsapi.TakeReply as reply:
			exactLimitsGrant(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case limitsapi.HoldReply as reply:
			exactLimitsGrant(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case limitsapi.PeekReply as reply:
			exactOptionLimitsLevel(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case limitsapi.AdvanceReply:
		case limitsapi.BucketsReply:
		}
	case limitsapi.Rejected as rejected:
		match rejected.Failure {
		case limitsapi.Limited as failure:
			exactLimitsLimited(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		case limitsapi.UnknownBucket:
		case limitsapi.BadCost as failure:
			exactLimitsBadCost(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		}
	}
	true
}

// Agrees: the wire carries every call and every outcome the call can
// have unchanged, when they hold only ints it carries exactly (Fits).
law Agrees(r Request, g limitsapi.Given) {
	let o = limitsapi.OutcomeOf(r, g)
	!Fits(r, o) || api.Agrees(Wire, r, o)
}
