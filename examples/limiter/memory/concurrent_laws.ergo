import limiter/bucket
import limiter/limits
import machines
import maps
import testing

type limConcAct =
	| LimTake{Key string, Cost int}
	| LimPeek{Key string}
	| LimAdvance{Ms int}

type limRes =
	| LimGranted{Remaining int}
	| LimLimited{RetryAfterMs int}
	| LimUnknown{Key string}
	| LimBadCost{Cost int, Capacity int}
	| LimLevel{Level Option[limits.Level]}
	| LimAdvanced{}

func initialBuckets() Map[string, bucket.Bucket] {
	let mut bs = Map[string, bucket.Bucket]{}
	bs["fast"] = bucket.Open(bucket.Spec{Capacity: 3, RefillMs: 7})
	bs["slow"] = bucket.Open(bucket.Spec{Capacity: 4, RefillMs: 250})
	bs
}

func limStoryStep(bs Map[string, bucket.Bucket], a limConcAct) (Map[string, bucket.Bucket], limRes) {
	match a {
	case LimTake as x:
		let b = match bs.Get(x.Key) {
		case Some[bucket.Bucket] as s:
			s.Value
		case None:
			return (bs, LimUnknown{Key: x.Key})
		}
		let d = bucket.Step(b, bucket.Spend{Cost: x.Cost})
		let mut next = bs
		next[x.Key] = machines.Next(b, d)
		match d {
		case Emit[bucket.Bucket, bucket.Told] as e:
			match e.Output {
			case bucket.Granted as g:
				(next, LimGranted{Remaining: g.Remaining})
			case bucket.Short as s:
				(next, LimLimited{RetryAfterMs: s.RetryAfterMs})
			}
		case Enter[bucket.Bucket], Stay[bucket.Bucket], Tell[bucket.Bucket, bucket.Told], Ignore, Reject, Done[bucket.Told]:
			(bs, LimBadCost{Cost: x.Cost, Capacity: b.Capacity})
		}
	case LimPeek as x:
		match bs.Get(x.Key) {
		case Some[bucket.Bucket] as s:
			(bs, LimLevel{Level: Some[limits.Level]{Value: bucket.LevelOf(s.Value)}})
		case None:
			(bs, LimLevel{Level: None})
		}
	case LimAdvance as x:
		let mut next = bs
		for k in maps.Keys(bs) {
			let b = maps.GetOr(bs, k, bucket.Open(bucket.Spec{Capacity: 1, RefillMs: 1}))
			next[k] = machines.Next(b, bucket.Step(b, bucket.Elapse{Ms: x.Ms}))
		}
		(next, LimAdvanced)
	}
}

func runLimAct(m Memory, a limConcAct) limRes {
	match a {
	case LimTake as x:
		let g = m.Take(x.Key, x.Cost) catch {
		case limits.Limited as l:
			return LimLimited{RetryAfterMs: l.RetryAfterMs}
		case limits.UnknownBucket as u:
			return LimUnknown{Key: u.Key}
		case limits.BadCost as b:
			return LimBadCost{Cost: b.Cost, Capacity: b.Capacity}
		}
		LimGranted{Remaining: g.Remaining}
	case LimPeek as x:
		LimLevel{Level: m.Peek(x.Key)}
	case LimAdvance as x:
		m.Advance(x.Ms)
		LimAdvanced
	}
}

func showLimAct(a limConcAct) string {
	match a {
	case LimTake as x:
		"Take(\(x.Key),\(x.Cost))"
	case LimPeek as x:
		"Peek(\(x.Key))"
	case LimAdvance as x:
		"Advance(\(x.Ms))"
	}
}

func showLimRes(r limRes) string {
	match r {
	case LimGranted as g:
		"Granted(\(g.Remaining))"
	case LimLimited as l:
		"Limited(\(l.RetryAfterMs))"
	case LimUnknown as u:
		"Unknown(\(u.Key))"
	case LimBadCost as b:
		"BadCost(\(b.Cost),\(b.Capacity))"
	case LimLevel:
		"Level"
	case LimAdvanced:
		"Advanced"
	}
}

test LimiterConcurrentLinearizable {
	let m = NewMemory()
	let plans = [][]limConcAct{
		[]limConcAct{LimTake{Key: "fast", Cost: 2}, LimPeek{Key: "fast"}, LimTake{Key: "slow", Cost: 2}},
		[]limConcAct{LimTake{Key: "fast", Cost: 2}, LimAdvance{Ms: 7}, LimTake{Key: "fast", Cost: 1}},
		[]limConcAct{LimTake{Key: "slow", Cost: 3}, LimPeek{Key: "slow"}, LimPeek{Key: "fast"}},
	}
	testing.AgreesConcurrent(initialBuckets(), limStoryStep, plans, func(a limConcAct) limRes {
		runLimAct(m, a)
	}) catch {
	case testing.NotLinearizable[limConcAct, limRes] as nl:
		assert testing.FormatHistory(nl.History, showLimAct, showLimRes) == ""
	}
}
