// elevator drives one elevator car from standard input, one command a
// line (`call N`, `tick`, `tick N`, `halt`), and prints the car's state
// after each step. Package floors is the car's set of calls, package car
// the car as a machine. This binary is the only place that chooses the
// providers: the host's standard input.

import elevator/car
import io

func main() needs Console | Ambient {
	with context { io.Stdin: io.NewStdin() } {
		let _ = car.Drive()
	}
}
