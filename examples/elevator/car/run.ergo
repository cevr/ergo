import elevator/floors
import io
import machines
import strconv
import strings

// Unknown is a line that is no command.
type Unknown { Line string }

// Parse reads one command: `call N`, `tick`, `tick N` (N ticks) or
// `halt`.
func Parse(line string) []Signal fails Unknown {
	let words = strings.Fields(line)
	if len(words) == 1 && words[0] == "tick" {
		return []Signal{Tick}
	}
	if len(words) == 1 && words[0] == "halt" {
		return []Signal{Halt}
	}
	if len(words) != 2 {
		return Unknown{Line: line}
	}
	let n = strconv.Atoi(words[1]) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return Unknown{Line: line}
	}
	if words[0] == "call" {
		return []Signal{Call{Floor: n}}
	}
	if words[0] == "tick" && n >= 0 {
		return Ticks(n)
	}
	Unknown{Line: line}
}

// Drive drives the car from io.Stdin, one command a line, and tells each
// state it reaches on Console, until halt or the end of the input. A line
// or a signal that fails is told and changes nothing; a signal the car
// ignores prints nothing.
func Drive() Stopped needs Console | io.Stdin {
	let mut s = machines.Initial(Car{})
	Console.Println(Describe(s))
	for line in io.Stdin.Lines() {
		let sigs = Parse(line) catch {
		case Unknown as u:
			Console.Println("unknown command: " + u.Line)
			continue
		}
		for sig in sigs {
			let d = Step(s, sig) catch {
			case floors.Full as f:
				Console.Println("full: the car keeps at most \(f.Cap) calls")
				Reject
			case NoFloor as n:
				Console.Println("no floor \(n.Floor): the floors are 0 to \(Top)")
				Reject
			}
			match d {
			case Done[Stopped] as done:
				Console.Println(StopText(done.Output))
				return done.Output
			case Ignore, Reject:
				continue
			case Enter[State], Stay[State], Emit[State, Stopped], Tell[State, Stopped]:
			}
			s = machines.Next(s, d)
			Console.Println(Describe(s))
		}
	}
	let end = Stopped{At: AtOf(s), Served: ServedOf(s)}
	Console.Println(StopText(end))
	end
}

// Describe is a state as one line: what the car does, where, and its
// calls.
func Describe(s State) string {
	let calls = callsText(CallsOf(s))
	match s {
	case Idle as i:
		"idle at \(i.At) " + calls
	case Moving as m:
		"moving " + (if m.Up { "up" } else { "down" }) + " at \(m.At) " + calls
	case Open as o:
		"open at \(o.At) " + calls
	}
}

// StopText is how a run ended.
func StopText(s Stopped) string { "stopped at \(s.At); calls served: \(s.Served)" }

func callsText(c floors.Set) string {
	let mut parts = []string{}
	for f in floors.Floors(c) {
		parts = parts.Append(strconv.Itoa(f))
	}
	"[" + strings.Join(parts, " ") + "]"
}
