// Package memory is a Source provider over texts held in memory, for
// tests: an input is named by a key.

import lzpack/lz

// Texts holds the inputs by name.
type Texts { Inputs Map[string, string] }

// Bytes is the input named path.
func Bytes(t Texts, path string) string fails lz.Unreadable {
	match t.Inputs.Get(path) {
	case Some[string] as s:
		s.Value
	case None:
		return lz.Unreadable{Path: path, Reason: "no such input"}
	}
}
