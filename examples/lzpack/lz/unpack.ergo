// Unpack: the decoder keeps a window of the last Window bytes it wrote,
// as a ring, and copies a match from it, so it reads no byte of its
// output but the ring's. Every length and offset is checked against the
// block and the bytes so far before a byte moves.

import strings

type Decoder { win [65536]byte, out strings.Builder, total int, at int }

func Unpack(packed string) string fails Corrupt {
	let mut d = Decoder{win: [65536]byte{}, out: strings.NewBuilder(), total: 0, at: 0}
	d.out.Grow(3 * packed.Len())
	let ok = packed.Len() >= Magic.Len() && strings.Slice(packed, 0, Magic.Len()) == Magic
	let mut b = openFrame(Opened{Ok: ok}) catch {
	case r:
		return Corrupt{Offset: 0, Reason: r}
	}
	d.at = Magic.Len()
	let mut end = Ended{Total: 0}
	for {
		let h = d.at
		let n = try d.uvarint(packed)
		if n == 0 {
			end = closeFrame(b)
			break
		}
		b = stepBlock(b, Block{Raw: n}) catch {
		case r:
			return Corrupt{Offset: h, Reason: r}
		}
		try d.block(packed, n)
	}
	if d.at < packed.Len() {
		return Corrupt{Offset: d.at, Reason: rejectExtra(end)}
	}
	d.out.String()
}

// UnpackOfPackIsInput: what Pack writes, Unpack reads back.
law UnpackOfPackIsInput(s string, k int) {
	let input = sample(s, k)
	let back = Unpack(Pack(input)) catch {
	case Corrupt:
		return false
	}
	back == input
}

// filler is n bytes that repeat no four-byte run of each other within
// the window: a counter in base 251, three digits at a time.
func filler(n int) string {
	let mut b = strings.NewBuilder()
	let mut i = 0
	for b.Len() < n {
		b.WriteByte(byte(i % 251))
		b.WriteByte(byte((i / 251) % 251))
		b.WriteByte(byte((i/63001)%251 + 3))
		i += 1
	}
	strings.Slice(b.String(), 0, n)
}

// sample is an input built from s and k: s, copies of it, a run, and,
// for odd k, a filler of more than a Window between two copies of s.
func sample(s string, k int) string {
	let reps = (k%7 + 7) % 7
	let mut b = strings.NewBuilder()
	b.WriteString(s)
	for _ in 0..reps {
		b.WriteString(s)
		b.WriteByte(byte(reps))
	}
	for _ in 0..(k%40+40)%40 {
		b.WriteByte(byte(k))
	}
	if k%2 != 0 {
		b.WriteString(filler(Window + (k%300+300)%300))
		b.WriteString(s)
		b.WriteString(s)
	}
	b.String()
}

// MalformedIsAFailure: any bytes after the magic, and any stream Pack
// wrote with one byte changed or cut short, unpack to a text or fail with
// Corrupt; none is a defect.
law MalformedIsAFailure(body string, s string, k int, b int) {
	let _ = Unpack(Magic + body) catch {
	case Corrupt:
		""
	}
	let packed = Pack(sample(s, k))
	let at = (k%packed.Len() + packed.Len()) % packed.Len()
	let mut changed = strings.NewBuilder()
	changed.WriteString(strings.Slice(packed, 0, at))
	changed.WriteByte(byte((b%256 + 256) % 256))
	changed.WriteString(strings.Slice(packed, at+1, packed.Len()))
	let _ = Unpack(changed.String()) catch {
	case Corrupt:
		""
	}
	let _ = Unpack(strings.Slice(packed, 0, at)) catch {
	case Corrupt:
		""
	}
	true
}

func truncated(packed string) Corrupt { Corrupt{Offset: packed.Len(), Reason: Truncated} }

// uvarint reads a block header: at most three bytes of seven bits each,
// low first. A third byte with its high bit set is BlockTooLong.
func uvarint(d mut Decoder, packed string) int fails Corrupt {
	let h = d.at
	let mut v = 0
	let mut shift = 0
	for {
		if d.at >= packed.Len() {
			return truncated(packed)
		}
		let b = int(packed[d.at])
		d.at += 1
		v |= (b & 127) << shift
		if b < 128 {
			return v
		}
		shift += 7
		if shift >= 21 {
			return Corrupt{Offset: h, Reason: BlockTooLong}
		}
	}
}

// ext reads the rest of a length whose nibble is 15: base plus every byte
// up to and with the first that is not 255.
func ext(d mut Decoder, packed string, base int) int fails Corrupt {
	let mut v = base
	for {
		if d.at >= packed.Len() {
			return truncated(packed)
		}
		let b = int(packed[d.at])
		d.at += 1
		v += b
		if b != 255 {
			return v
		}
	}
}

// block reads the sequences of a block of n raw bytes.
func block(d mut Decoder, packed string, n int) fails Corrupt {
	let mut pos = 0
	for pos < n {
		let t = d.at
		if t >= packed.Len() {
			return truncated(packed)
		}
		let tok = int(packed[t])
		d.at += 1
		let mut l = tok >> 4
		if l == 15 {
			l = try d.ext(packed, 15)
		}
		if l > n-pos {
			return Corrupt{Offset: t, Reason: Overrun}
		}
		if l > packed.Len()-d.at {
			return truncated(packed)
		}
		d.literals(packed, l)
		pos += l
		if pos == n {
			if tok&15 != 0 {
				return Corrupt{Offset: t, Reason: StrayMatch}
			}
			return
		}
		if 2 > packed.Len()-d.at {
			return truncated(packed)
		}
		let off = int(packed[d.at]) | int(packed[d.at+1])<<8
		d.at += 2
		if off == 0 || off > d.total {
			return Corrupt{Offset: t, Reason: BadOffset}
		}
		let mut m = tok & 15
		if m == 15 {
			m = try d.ext(packed, 15)
		}
		m += MinMatch
		if m > n-pos {
			return Corrupt{Offset: t, Reason: Overrun}
		}
		d.copy(off, m)
		pos += m
	}
}

// literals writes the l bytes of packed at d.at, which are there.
func literals(d mut Decoder, packed string, l int) {
	let from = d.at
	d.out.WriteString(strings.Slice(packed, from, from+l))
	for k in 0..l {
		d.win[(d.total+k)&WindowMask] = packed[from+k]
	}
	d.total += l
	d.at += l
}

// copy writes m bytes from off back, one at a time, so a copy that
// overlaps what it writes repeats it. 1 <= off <= d.total and off <
// Window, so every byte it reads is in the ring.
func copy(d mut Decoder, off int, m int) {
	for k in 0..m {
		let c = d.win[(d.total+k-off)&WindowMask]
		d.win[(d.total+k)&WindowMask] = c
		d.out.WriteByte(c)
	}
	d.total += m
}
