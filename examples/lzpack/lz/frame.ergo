// The stream's frame as a machine: the magic, then blocks, then the end
// mark, and nothing after it. Unpack steps it once per block, so the
// order of a stream's parts is the machine's, and a refusal is a Reason
// the machine gives, never a branch spread over the decoder.

import machines

// Frame is where a stream is: before its magic, in its blocks (with the
// raw bytes so far), or past its end mark.
type Frame = Header{} | Body{Total int} | Ended{Total int}

// Part is what the decoder reads next at the frame's level: the magic (or
// bytes that are not it), a block header of Raw bytes, the end mark, or a
// byte after the end mark.
type Part = Opened{Ok bool} | Block{Raw int} | EndMark{} | Extra{}

func openFrame(o Opened) Body fails Reason {
	if o.Ok {
		Body{Total: 0}
	} else {
		return BadMagic
	}
}

func stepBlock(b Body, k Block) Body fails Reason {
	if k.Raw > BlockMax {
		return BlockTooLong
	}
	Body{Total: b.Total + k.Raw}
}

func closeFrame(b Body) Ended { Ended{Total: b.Total} }

func rejectExtra(e Ended) Reason { Trailing }

func FrameStep(f Frame, p Part) machines.Decision[Frame, Reason] {
	match (f, p) {
	case (Header, Opened as o):
		let next = openFrame(o) catch {
		case r:
			return machines.Done[Reason]{Output: r}
		}
		machines.Enter[Frame]{Next: next}
	case (Body as b, Block as k):
		let next = stepBlock(b, k) catch {
		case r:
			return machines.Done[Reason]{Output: r}
		}
		machines.Stay[Frame]{Next: next}
	case (Body as b, EndMark):
		machines.Enter[Frame]{Next: closeFrame(b)}
	case (Ended as e, Extra):
		machines.Done[Reason]{Output: rejectExtra(e)}
	case (Header, Block), (Header, EndMark), (Header, Extra), (Body, Opened), (Body, Extra), (Ended, Opened), (Ended, Block), (Ended, EndMark):
		machines.Reject
	}
}

// Framing is the frame as a machine.
type Framing machine[Frame, Part] {
	initial: Header,
	step:    FrameStep,

	// CanEnd: a stream can reach its end mark.
	law CanEnd reaches Ended,

	// InOrder: the magic opens the body, and the end mark closes it.
	law InOrder path [Header, Body, Ended],

	// TotalIsTheBlocks: the end mark's total is the sum of the blocks,
	// for blocks of 1 to BlockMax bytes.
	law TotalIsTheBlocks(raws []int) {
		let mut parts = []Part{Opened{Ok: true}}
		let mut sum = 0
		for r in raws {
			let n = 1 + (r%BlockMax+BlockMax)%BlockMax
			parts = parts.Append(Block{Raw: n})
			sum += n
		}
		parts = parts.Append(EndMark)
		let o = machines.Run(Framing{}, parts) catch {
		case machines.Rejected:
			return false
		}
		match o {
		case machines.Running[Frame, Reason] as r:
			r.State == Ended{Total: sum}
		case machines.Finished[Frame, Reason]:
			false
		}
	},

	// LongBlockIsRefused: a block of more than BlockMax bytes ends the
	// frame with BlockTooLong.
	law LongBlockIsRefused(extra int) {
		let n = BlockMax + 1 + (extra%1000+1000)%1000
		let o = machines.Run(Framing{}, []Part{Opened{Ok: true}, Block{Raw: n}}) catch {
		case machines.Rejected:
			return false
		}
		match o {
		case machines.Finished[Frame, Reason] as f:
			f.Output == BlockTooLong
		case machines.Running[Frame, Reason]:
			false
		}
	},
}
