// Package mapped is the host's Source provider: a file of the host's
// disk, mapped read-only (fs.MapFile), so a large input is read where the
// page cache holds it, with no copy.

import fs
import lzpack/lz

// Files reads the host's files. Only New makes one.
type Files { host fs.Host }

// New is the provider over the host's files.
func New(host fs.Host) Files { Files{host: host} }

// Bytes is the whole content of the file at path.
func Bytes(f Files, path string) string fails lz.Unreadable {
	fs.MapFile(f.host, path) catch {
	case fs.NotFound:
		return lz.Unreadable{Path: path, Reason: "no such file"}
	case fs.Denied:
		return lz.Unreadable{Path: path, Reason: "permission denied"}
	case fs.Failed as e:
		return lz.Unreadable{Path: path, Reason: e.Reason}
	}
}
