// The test file of package mapped picks the files its law runs read: each
// case of lz.Source's laws builds onTestHost, Files over the test's own
// folder, so Repeatable runs on the host's files as the binary's Files
// does. The context is unexported, so only the test build's law runs read
// it.

import fs
import lzpack/lz

// onTestHost binds the source to Files over the test's folder.
let onTestHost = context needs TestAmbient { lz.Source: New(fs.NewTestHost()) }
