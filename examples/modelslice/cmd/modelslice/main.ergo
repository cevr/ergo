// modelslice cuts a committed model slice from a provider's whole Smithy model:
//
//	modelslice <model.json> <out.json> <source> <note> [drop:<trait id>]... <operation id>...
//
// It reads the model, prunes it to the operations named (smithy.Prune) with
// the drop: traits left out, and writes the slice with its provenance in
// the metadata: the source address, the sha256 of the model text, the
// operations kept, the traits dropped and the note. The corpus under
// modules/clientgen/smithy/testdata is made by this binary (a module is a
// library with no cmd/, so the binary lives here) and no other
// tool (orchestrator, q11: one path).

import github.com/cevr/ergo/modules/clientgen/smithy
import fs
import fstest
import hex
import io
import json
import os
import sha256
import strings

let usage = "usage: modelslice <model.json> <out.json> <source> <note> [drop:<trait id>]... <operation id>..."

func run(args []string) fails os.Exit needs io.Stdout | fs.Files | fs.Writes {
	if len(args) < 5 {
		return os.Exit{Code: 2, Message: usage}
	}
	let mut drop = []string{}
	let mut keep = []string{}
	for a in args[4:] {
		if strings.HasPrefix(a, "drop:") {
			drop = drop.Append(strings.TrimPrefix(a, "drop:"))
		} else {
			keep = keep.Append(a)
		}
	}
	let text = fs.Files.ReadFile(args[0]) catch {
	case _:
		return os.Exit{Code: 1, Message: "modelslice: cannot read \(args[0])"}
	}
	let m = smithy.Read(text) catch {
	case json.Malformed:
		return os.Exit{Code: 1, Message: "modelslice: \(args[0]) is not JSON"}
	case smithy.NotSmithy as e:
		return os.Exit{Code: 1, Message: "modelslice: \(args[0]): \(e.Path): \(e.Reason)"}
	}
	let cut = smithy.Prune(m, keep, drop) catch {
	case smithy.Unknown as u:
		return os.Exit{Code: 1, Message: "modelslice: \(u.Id) is not an operation of \(args[0])"}
	}
	let p = smithy.Provenance{Source: args[2], Sha256: hex.Encode(sha256.Sum(text)), Kept: keep, Dropped: drop, Note: args[3]}
	let out = smithy.Write(smithy.WithProvenance(cut, p))
	fs.Writes.WriteFile(args[1], out + "\n") catch {
	case _:
		return os.Exit{Code: 1, Message: "modelslice: cannot write \(args[1])"}
	}
	io.Stdout.Println("\(args[1]): \(len(cut.Shapes)) of \(len(m.Shapes)) shapes, \(len(out)) bytes")
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), fs.Writes: fs.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}

// The test runs run over an fstest.Memory holding a three-shape model.

let tiny = "{\"smithy\":\"2.0\",\"shapes\":{\"t#Get\":{\"type\":\"operation\",\"input\":{\"target\":\"t#In\"},\"traits\":{\"smithy.api#http\":{\"method\":\"GET\",\"uri\":\"/x\"}}},\"t#In\":{\"type\":\"structure\",\"members\":{\"a\":{\"target\":\"smithy.api#String\",\"traits\":{\"smithy.api#documentation\":\"a\",\"x.test#tests\":{}}}}},\"t#Other\":{\"type\":\"string\"}}}"

// ran is what run prints for args over a disk holding m.json = tiny, or
// "exit <code>: <message>", and the slice it wrote ("" when none).
func ran(args []string) (string, string) fails fs.NotFound | fs.Denied | fs.Failed {
	let disk = fstest.NewMemory()
	try disk.WriteFile("m.json", tiny)
	let out = io.NewRecorder()
	with context { io.Stdout: out, fs.Files: disk, fs.Writes: disk } {
		run(args) catch {
		case os.Exit as e:
			out.Println("exit \(e.Code): \(e.Message)")
		}
	}
	let written = disk.ReadFile("s.json") catch {
	case _:
		""
	}
	(out.Text(), written)
}

test SliceKeepsTheClosureAndRecordsWhere {
	let (said, written) = try ran([]string{"m.json", "s.json", "src@1", "a note", "drop:x.test#tests", "t#Get"})
	assert said == "s.json: 2 of 3 shapes, \(len(written) - 1) bytes\n"
	assert strings.Contains(written, "\"clientgen.provenance\":{\"source\":\"src@1\",\"sha256\":\"" + hex.Encode(sha256.Sum(tiny)) + "\",\"kept\":[\"t#Get\"],\"dropped\":[\"x.test#tests\"],\"note\":\"a note\"}")
	assert !strings.Contains(written, "x.test#tests\":{}")
	assert !strings.Contains(written, "t#Other")
}

test UnknownOperationExits {
	let (said, written) = try ran([]string{"m.json", "s.json", "src", "", "t#In"})
	assert said == "exit 1: modelslice: t#In is not an operation of m.json\n"
	assert written == ""
}
