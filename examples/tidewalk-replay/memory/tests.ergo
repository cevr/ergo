// Fixed keeps the walk.Library law. ergo test skips a member law for a
// provider in another package (G-exup-1, G-ma-2), so this test runs the
// law's predicate against the one provider.

import tidewalk/walk

test FixedNamesEachReplayOnce {
	with context { walk.Library: Fixed } {
		assert walk.NamedOnce(walk.Library.Replays())
	}
}
