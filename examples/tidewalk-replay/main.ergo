// Tidewalk replay: a walker crosses a tidal flat to the high rocks while the
// tide rises one height step every six moves. The game is a pure machine:
// moves are commands, decide records what a move does as past-tense events,
// evolve folds them into the state, and step returns the machine's Decision.
// main replays fixed move lists and prints one text frame per state.

// level

// ground is the height map: '#' is rock, a digit is the height of sand.
// Height 3 is the peak.
let ground = []string{
	"###22#333",
	"#1112#233",
	"#0#1122##",
	"00111#21#",
	"#0011011#",
	"##1000###",
}

// items marks the start ('@') and the shells ('s').
let items = []string{
	".........",
	".........",
	"......s..",
	".s.......",
	"......s..",
	"..@......",
}

// Pos is a cell: x grows east, y grows south.
type Pos { X int, Y int }

func blocked(p Pos) bool {
	if p.X < 0 || p.Y < 0 || p.Y >= len(ground) || p.X >= len(ground[0]) {
		return true
	}
	return ground[p.Y][p.X] == '#'
}

func height(p Pos) int {
	return int(ground[p.Y][p.X] - '0')
}

func shellCount() int {
	let mut n = 0
	for row in items {
		for x in 0..len(row) {
			if row[x] == 's' {
				n = n + 1
			}
		}
	}
	return n
}

// moves

type Move = North{} | East{} | South{} | West{} | Wait{}

// BadMove is a letter of a move list that is not a move, at its 1-based
// position.
type BadMove { At int }

func parseMove(c byte, at int) Move fails BadMove {
	match c {
	case 'N':
		return North
	case 'E':
		return East
	case 'S':
		return South
	case 'W':
		return West
	case '.':
		return Wait
	case _:
		return BadMove{At: at}
	}
}

// parseMoves parses a whole move list before any move is played.
func parseMoves(s string) []Move fails BadMove {
	let mut out = []Move{}
	for i in 0..len(s) {
		let m = try parseMove(s[i], i+1)
		out = out.Append(m)
	}
	return out
}

func target(p Pos, m Move) Pos {
	match m {
	case North:
		return Pos{X: p.X, Y: p.Y - 1}
	case East:
		return Pos{X: p.X + 1, Y: p.Y}
	case South:
		return Pos{X: p.X, Y: p.Y + 1}
	case West:
		return Pos{X: p.X - 1, Y: p.Y}
	case Wait:
		return p
	}
}

// game

// Walk is the walker's progress. Left holds one byte per cell of the level,
// 's' where a shell is still to collect, so a step never writes to the old
// state.
type Walk { At Pos, Tide int, Turn int, Shells int, Left string }

type Game = Playing{W Walk} | Won{W Walk} | Drowned{W Walk}

func start() Game {
	let mut at = Pos{X: 0, Y: 0}
	let mut left = ""
	for y in 0..len(items) {
		for x in 0..len(items[y]) {
			if items[y][x] == '@' {
				at = Pos{X: x, Y: y}
			}
			if items[y][x] == 's' {
				left = left + "s"
			} else {
				left = left + "."
			}
		}
	}
	return Playing{W: Walk{At: at, Tide: 0, Turn: 0, Shells: 0, Left: left}}
}

func walkOf(g Game) Walk {
	match g {
	case Playing as p:
		return p.W
	case Won as w:
		return w.W
	case Drowned as d:
		return d.W
	}
}

func status(g Game) string {
	match g {
	case Playing:
		return "playing"
	case Won:
		return "won"
	case Drowned:
		return "drowned"
	}
}

// events

// Event is a fact an entered move records, in the past tense.
type Event = Walked{To Pos} | Waited{} | ShellCollected{At Pos} | TideRose{Tide int} | WalkerDrowned{} | PeakReached{}

// rules

func moved(to Pos, m Move) Event {
	match m {
	case North:
		return Walked{To: to}
	case East:
		return Walked{To: to}
	case South:
		return Walked{To: to}
	case West:
		return Walked{To: to}
	case Wait:
		return Waited
	}
}

// record is what a move from w does: nothing when its target is blocked;
// else the walk or the wait, a shell collected on dry sand, the tide rising
// on every sixth turn, then drowning under the tide or reaching the peak.
func record(w Walk, m Move) []Event {
	let to = target(w.At, m)
	if blocked(to) {
		return []Event{}
	}
	let h = height(to)
	let mut out = []Event{moved(to, m)}
	if w.Left[to.Y*len(ground[0])+to.X] == 's' && h >= w.Tide {
		out = out.Append(ShellCollected{At: to})
	}
	let mut tide = w.Tide
	if (w.Turn+1)%6 == 0 {
		tide = tide + 1
		out = out.Append(TideRose{Tide: tide})
	}
	if h < tide {
		out = out.Append(WalkerDrowned)
	}
	if h >= tide && h == 3 {
		out = out.Append(PeakReached)
	}
	return out
}

// decide records the events of a move. It is pure, and a finished game
// records none.
func decide(g Game, m Move) []Event {
	match g {
	case Playing as p:
		return record(p.W, m)
	case Won:
		return []Event{}
	case Drowned:
		return []Event{}
	}
}

func evolveWalk(w Walk, e Event) Game {
	match e {
	case Walked as x:
		return Playing{W: Walk{..w, At: x.To, Turn: w.Turn + 1}}
	case Waited:
		return Playing{W: Walk{..w, Turn: w.Turn + 1}}
	case ShellCollected as s:
		let k = s.At.Y*len(ground[0]) + s.At.X
		return Playing{W: Walk{..w, Shells: w.Shells + 1, Left: w.Left[0:k] + "." + w.Left[k+1:]}}
	case TideRose as t:
		return Playing{W: Walk{..w, Tide: t.Tide}}
	case WalkerDrowned:
		return Drowned{W: w}
	case PeakReached:
		return Won{W: w}
	}
}

// evolve applies one event. It is total over Game and Event and decides
// nothing.
func evolve(g Game, e Event) Game {
	match g {
	case Playing as p:
		return evolveWalk(p.W, e)
	case Won:
		return g
	case Drowned:
		return g
	}
}

// step is the machine's transition: a finished game ignores every move, a
// blocked move is rejected and passes no turn, and any other move enters the
// state that evolve reaches from the events decide records.
func step(g Game, m Move) Decision[Game, string] {
	match g {
	case Playing as p:
		if blocked(target(p.W.At, m)) {
			return Reject
		}
		let mut next = g
		for e in decide(g, m) {
			next = evolve(next, e)
		}
		return Enter[Game]{Next: next}
	case Won:
		return Ignore
	case Drowned:
		return Ignore
	}
}

// Tidewalk is the game as a machine: it starts at start() and moves by step.
type Tidewalk machine[Game, Move] {
	initial: start(),
	step:    step,
}

// apply is the state after a decision: Enter and Stay take Next; Ignore,
// Reject and Done keep the state.
func apply(g Game, d Decision[Game, string]) Game {
	match d {
	case Enter[Game] as e:
		return e.Next
	case Stay[Game] as s:
		return s.Next
	case Ignore:
		return g
	case Reject:
		return g
	case Done[string]:
		return g
	}
}

func word(d Decision[Game, string]) string {
	match d {
	case Enter[Game]:
		return "enter"
	case Stay[Game]:
		return "stay"
	case Ignore:
		return "ignore"
	case Reject:
		return "reject"
	case Done[string]:
		return "done"
	}
}

func ignored(d Decision[Game, string]) bool {
	return word(d) == "ignore"
}

func rejected(d Decision[Game, string]) bool {
	return word(d) == "reject"
}

// laws

law BlockedIsRejected(w Walk, m Move) { !blocked(target(w.At, m)) || rejected(step(Playing{W: w}, m)) }

law FinishedIsFinal(w Walk, m Move) { ignored(step(Won{W: w}, m)) && ignored(step(Drowned{W: w}, m)) }

law TurnNeverFalls(g Game, m Move) { walkOf(apply(g, step(g, m))).Turn >= walkOf(g).Turn }

law TideNeverFalls(g Game, m Move) { walkOf(apply(g, step(g, m))).Tide >= walkOf(g).Tide }

law ShellsNeverFall(g Game, m Move) { walkOf(apply(g, step(g, m))).Shells >= walkOf(g).Shells }

law TideFollowsTurn(moves []Move) {
	let mut g = start()
	for m in moves {
		g = apply(g, step(g, m))
	}
	walkOf(g).Tide == walkOf(g).Turn/6
}

// tests

func replayGame(s string) Game fails BadMove {
	let moves = try parseMoves(s)
	let mut g = start()
	for m in moves {
		g = apply(g, step(g, m))
	}
	return g
}

func moveCount(s string) int fails BadMove {
	let moves = try parseMoves(s)
	return len(moves)
}

test ShoreCollectsEveryShell {
	let g = try replayGame("NWNEEENEESSNNNE")
	assert status(g) == "won" && walkOf(g).Shells == 3 && walkOf(g).Turn == 15
}

test GreedyDrowns {
	let g = try replayGame("NWNEESEENN")
	assert status(g) == "drowned" && walkOf(g).Shells == 1 && walkOf(g).Turn == 8
}

test BumpRejectsBlockedMoves {
	let g = start()
	assert rejected(step(g, South)) && rejected(step(g, West))
	let won = try replayGame("SW.NNENEEENNE")
	assert status(won) == "won" && walkOf(won).Turn == 10
}

test TypoIsRejected {
	let at = moveCount("NNxE") catch {
	case BadMove as b:
		-b.At
	}
	assert at == -3
}

test FinishedIgnoresEveryMove(m Move) {
	let w = walkOf(start())
	assert ignored(step(Won{W: w}, m)) && ignored(step(Drowned{W: w}, m))
}

test TideFollowsEveryTurn(moves []Move) {
	let mut g = start()
	for m in moves {
		g = apply(g, step(g, m))
	}
	assert walkOf(g).Tide == walkOf(g).Turn/6
}

// frame

func eventWord(e Event) string {
	match e {
	case Walked:
		return "walked"
	case Waited:
		return "waited"
	case ShellCollected:
		return "shell"
	case TideRose:
		return "tide"
	case WalkerDrowned:
		return "drowned"
	case PeakReached:
		return "peak"
	}
}

func eventWords(es []Event) string {
	if len(es) == 0 {
		return "-"
	}
	let mut out = ""
	for i, e in es {
		if i > 0 {
			out = out + " "
		}
		out = out + eventWord(e)
	}
	return out
}

// cell draws one cell: the walker, rock, water over sand below the tide (a
// shell there is hidden), a shell, or the height of the sand.
func cell(w Walk, x int, y int) string {
	if w.At.X == x && w.At.Y == y {
		return "@"
	}
	if ground[y][x] == '#' {
		return "#"
	}
	let h = height(Pos{X: x, Y: y})
	if h < w.Tide {
		return "~"
	}
	if w.Left[y*len(ground[0])+x] == 's' {
		return "s"
	}
	return "\(h)"
}

func show(name string, i int, n int, move string, decision string, g Game, es []Event) needs Console {
	let w = walkOf(g)
	Console.Println("== \(name) move \(i)/\(n) \(move) \(decision) tide \(w.Tide) shells \(w.Shells)/\(shellCount()) \(status(g)) events \(eventWords(es))")
	for y in 0..len(ground) {
		let mut row = ""
		for x in 0..len(ground[y]) {
			row = row + cell(w, x, y)
		}
		Console.Println(row)
	}
	Console.Println("")
}

// play parses a replay's moves, then runs the machine over them from
// start(), one frame per state, and prints the result.
func play(r Replay) fails BadMove needs Console {
	let moves = try parseMoves(r.Moves)
	let mut g = start()
	show(r.Name, 0, len(moves), "-", "start", g, []Event{})
	for i, m in moves {
		let es = decide(g, m)
		let d = step(g, m)
		g = apply(g, d)
		show(r.Name, i+1, len(moves), r.Moves[i:i+1], word(d), g, es)
	}
	let w = walkOf(g)
	Console.Println("result \(r.Name) \(status(g)) shells \(w.Shells)/\(shellCount()) turns \(w.Turn)")
}

// main

// Replay is a named move list.
type Replay { Name string, Moves string }

func main() needs Console {
	let replays = []Replay{
		// replays: begin
		Replay{Name: "shore", Moves: "NWNEEENEESSNNNE"},
		Replay{Name: "greedy", Moves: "NWNEESEENN"},
		Replay{Name: "bump", Moves: "SW.NNENEEENNE"},
		Replay{Name: "typo", Moves: "NNxE"},
		// replays: end
	}
	for r in replays {
		play(r) catch {
		case BadMove as b:
			Console.Println("rejected \(r.Name): move \(b.At) is not one of N E S W .")
		}
	}
}
