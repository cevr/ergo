// The game's tests: four examples. ergo test runs the laws of laws.ergo (#162).

func replayOf(s string) Game fails BadMove {
	let ms = try ParseMoves(s)
	return Play(ms)
}

func moveCount(s string) int fails BadMove {
	let ms = try ParseMoves(s)
	return ms.Count()
}

test ShoreCollectsEveryShell {
	let g = try replayOf("NWNEEENEESSNNNE")
	assert Status(g) == "won" && WalkOf(g).Shells == 3 && WalkOf(g).Turn == 15
}

test GreedyDrowns {
	let g = try replayOf("NWNEESEENN")
	assert Status(g) == "drowned" && WalkOf(g).Shells == 1 && WalkOf(g).Turn == 8
}

test BumpRejectsBlockedMoves {
	let g = Start()
	assert rejected(Step(g, South)) && rejected(Step(g, West))
	let won = try replayOf("SW.NNENEEENNE")
	assert Status(won) == "won" && WalkOf(won).Turn == 10
}

test TypoIsRejected {
	let at = moveCount("NNxE") catch {
	case BadMove as b:
		-b.At
	}
	assert at == -3
}
