{
  "about": "counter-list' application mutants; each is judged by the example's tests, laws and cases (scripts/examples), not by a compiler test.",
  "mutants": [
    {
      "name": "fk2-at-steps-every-row",
      "origin": "wf10/fk2a",
      "file": "examples/counter-list/rows/rows.ergo",
      "from": "\t\t\tif x.Key != at.Key {\n\t\t\t\treturn x\n\t\t\t}\n",
      "to": "",
      "rule": "A counter's signal steps its own row only (law RowSignalTouchesOnlyItsRow).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2-at-missing-key-adds-a-row",
      "origin": "wf10/fk2a",
      "file": "examples/counter-list/rows/rows.ergo",
      "from": "\tcase At as at:\n\t\tif !has(r, at.Key) {\n\t\t\treturn machines.Ignore\n\t\t}\n",
      "to": "\tcase At as at:\n\t\tif !has(r, at.Key) {\n\t\t\treturn machines.Stay[Rows]{Next: Rows{Items: r.Items.Append(fresh(at.Key)), Next: r.Next}}\n\t\t}\n",
      "rule": "A signal for a key with no row changes nothing: it never brings a removed row back.",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2-remove-drops-the-rest",
      "origin": "wf10/fk2a",
      "file": "examples/counter-list/rows/rows.ergo",
      "from": "func(x Row) bool { x.Key != rm.Key }",
      "to": "func(x Row) bool { x.Key > rm.Key }",
      "rule": "A remove keeps every other row, in order (law RemoveKeepsTheOthers).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2-key-reused",
      "origin": "wf10/fk2a",
      "file": "examples/counter-list/rows/rows.ergo",
      "from": "r.Items.Append(fresh(r.Next))",
      "to": "r.Items.Append(fresh(len(r.Items)))",
      "rule": "An add gives a key no row had before (law KeysAreUnique).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2-next-not-advanced",
      "origin": "wf10/fk2a",
      "file": "examples/counter-list/rows/rows.ergo",
      "from": "Next: r.Next + 1}}",
      "to": "Next: r.Next}}",
      "rule": "Next moves past every key given (law KeysAreUnique).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2-counter-decrement-adds",
      "origin": "wf10/fk2a",
      "file": "examples/counter-list/counter/counter.ergo",
      "from": "Stay[Count]{Next: Count{N: c.N - 1}}",
      "to": "Stay[Count]{Next: Count{N: c.N + 1}}",
      "rule": "Decrement is one less (law Counter.UndoesItself).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2b-row-signal-to-next-row",
      "origin": "wf10/fk2b",
      "file": "examples/counter-list/screen/screen.ergo",
      "from": "rows.At{Key: x.Key, Sig: s}",
      "to": "rows.At{Key: x.Key + 1, Sig: s}",
      "rule": "A row's counter view sends its signal to its own row (case scenes: inc 1).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2b-minus-increments",
      "origin": "wf10/fk2b",
      "file": "examples/counter-list/counter/view.ergo",
      "from": "ui.Pressable(f, \"-\", to(Decrement))",
      "to": "ui.Pressable(f, \"-\", to(Increment))",
      "rule": "The - button sends Decrement (case scenes: given 3, press -).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2b-same-key-drops-count",
      "origin": "wf10/fk2b",
      "file": "examples/counter-list/screen/screen.ergo",
      "from": "ui.Same(f, ui.ByText(\"\\(x.Key)=\\(x.Counter.N)\"))",
      "to": "ui.Same(f, ui.ByText(\"\\(x.Key)\"))",
      "rule": "A row's Same is keyed by all it shows: a key without the count keeps a stale count (cases rows and scenes).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2b-remove-sends-first-key",
      "origin": "wf10/fk2b",
      "file": "examples/counter-list/screen/screen.ergo",
      "from": "ui.Pressable(f, RemoveLabel, rows.Remove{Key: x.Key})",
      "to": "ui.Pressable(f, RemoveLabel, rows.Remove{Key: 0})",
      "rule": "A row's Remove removes that row (case rows: remove 1).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    },
    {
      "name": "fk2b-given-next-zero",
      "origin": "wf10/fk2b",
      "file": "examples/counter-list/rows/rows.ergo",
      "from": "Rows{Items: items, Next: counts.Len()}",
      "to": "Rows{Items: items, Next: 0}",
      "rule": "A given list's next key is past its rows, so an add gives a fresh key (case scenes: given 0 0, add).",
      "anchor": {
        "tests": [
          "examples:counter-list"
        ]
      },
      "killers": [
        "examples:counter-list"
      ]
    }
  ]
}
