// Package screen is the list of counters on a screen (stage b): the
// heading, then each row as a group named after it (counter-N) that holds
// the counter's own view and a Remove button, then the button that adds a
// row.

import counterlist/counter
import counterlist/rows
import ui

// Title is the heading.
let Title = "Counters"

// AddLabel is the label of the button that adds a row.
let AddLabel = "+ Add Counter"

// RemoveLabel is the label of a row's Remove button.
let RemoveLabel = "Remove"

// Screen is the list. Each row is keyed by its key, so a removed row
// takes only its own nodes; and its body is a Same keyed by its key and
// its count, all it shows and sends, so a click runs the body of its own
// row only and keeps every other row.
func Screen(f mut ui.Frame[rows.Signal], r rows.Rows) {
	ui.Column(f, ui.Plain()) {
		ui.Text(f, Title)
		ui.Each(f, r.Items, func(x rows.Row) ui.Key { ui.ByInt(x.Key) }) func(x rows.Row) {
			ui.Same(f, ui.ByText("\(x.Key)=\(x.Counter.N)")) {
				ui.Semantic(f, group(rows.Name(x.Key)), None, ui.Plain()) {
					counter.View(f, x.Counter, func(s counter.Signal) rows.Signal { rows.At{Key: x.Key, Sig: s} })
					ui.Pressable(f, RemoveLabel, rows.Remove{Key: x.Key}) {
						ui.Text(f, RemoveLabel)
					}
				}
			}
		}
		ui.Pressable(f, AddLabel, rows.Add) {
			ui.Text(f, AddLabel)
		}
	}
}

// group is the access of a row: a group with its name, so a scene finds a
// row's buttons within it.
func group(name string) ui.Access {
	ui.Access{Role: ui.Group, Name: name, Disabled: false, Description: "", Checked: None, Value: None, Selected: None, Expanded: None, Pressed: None, Invalid: false, Busy: false, HasPopup: false, Level: None, Mixed: false, Current: None, Modal: false, MultiSelectable: false, Range: None, Key: ui.NoKey, Rels: []ui.Rel{}}
}
