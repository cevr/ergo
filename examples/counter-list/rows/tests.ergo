// The story tests, restated (conformance/upstream maps each), and an init
// test: the first list's counters are distinct. A key is the number N,
// and Name prints it as `counter-N`.

import counterlist/counter
import machines

// two is the first model: two counters at zero, next key 2.
func two(a int, b int) Rows {
	Rows{Items: []Row{Row{Key: 0, Counter: counter.Count{N: a}}, Row{Key: 1, Counter: counter.Count{N: b}}}, Next: 2}
}

// after is r after each signal in order.
func after(r Rows, signals []Signal) Rows {
	let o = machines.From(Counters{}, r, signals) catch {
	case machines.Rejected:
		return r
	}
	machines.LastState(o)
}

func counts(r Rows) []int {
	let mut out = []int{}
	for x in r.Items {
		out = out.Append(x.Counter.N)
	}
	out
}

test AddAppendsAFreshRowWithTheNextKey {
	// ClickedAddRow appends a fresh Counter row with the next id.
	let r = after(two(0, 0), []Signal{Add})
	assert r.Items.Len() == 3 && Name(r.Items[2].Key) == "counter-2" && r.Items[2].Counter.N == 0 && r.Next == 3
}

test RemoveDropsOnlyThatRow {
	// ClickedRemoveRow drops only the targeted row.
	let r = after(two(0, 0), []Signal{Remove{Key: 0}})
	assert r.Items.Len() == 1 && r.Items[0].Key == 1
}

test IncrementGoesToItsRowOnly {
	// GotCounterMessage routes ClickedIncrement to the matching row only.
	assert counts(after(two(0, 0), []Signal{At{Key: 1, Sig: counter.Increment}})) == []int{0, 1}
}

test DecrementGoesToItsRowOnly {
	// GotCounterMessage routes ClickedDecrement to the matching row only.
	assert counts(after(two(5, 5), []Signal{At{Key: 0, Sig: counter.Decrement}})) == []int{4, 5}
}

test SignalForAMissingKeyChangesNothing {
	// GotCounterMessage for a missing id leaves the model unchanged.
	let r = two(0, 0)
	assert Step(r, At{Key: 99, Sig: counter.Increment}) == machines.Ignore
}

test RowsAccumulateIndependently {
	// successive Messages accumulate per row independently.
	let signals = []Signal{At{Key: 0, Sig: counter.Increment}, At{Key: 0, Sig: counter.Increment}, At{Key: 1, Sig: counter.Decrement}}
	assert counts(after(two(0, 0), signals)) == []int{2, -1}
}

test InitialHasDistinctFreshCounters {
	// The list
	// starts with three counters at zero under three keys, and a signal to
	// one leaves the other two at zero.
	let r = after(Initial(), []Signal{At{Key: 1, Sig: counter.Increment}})
	assert counts(Initial()) == []int{0, 0, 0} && counts(r) == []int{0, 1, 0} && Initial().Next == 3
}
