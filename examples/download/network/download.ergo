import download/domain
import http
import strconv

type Remote { net http.Remote }
func New(net http.Remote) Remote { Remote{net: net} }

func Read(d Remote, url string) string fails domain.Denied | domain.Failed {
	let response = d.net.SendURL(http.URLRequest{URL: url, Method: "GET", Header: []http.Field{}, Credentials: []http.Credential{}, Body: ""}) catch {
	case http.OriginRefused as o:
		return domain.Denied{Origin: o.Origin}
	case http.RedirectLimit as l:
		return domain.Failed{Reason: "redirect limit " + strconv.Itoa(l.Limit)}
	case http.RequestFailed as f:
		let reason = match f.Cause {
		case http.Refused as c:
			c.Reason
		case http.Transport as c:
			c.Reason
		case http.Malformed as c:
			c.Reason
		case http.TooLarge as c:
			"response limit " + strconv.Itoa(c.Limit)
		}
		return domain.Failed{Reason: reason}
	}
	response.Body
}
