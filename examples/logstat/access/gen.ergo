// Plain and Damaged shape the requests and lines the laws draw: a law
// takes a generated Request (time.Time is built by time.NewTime) and
// makes it Valid with Plain, or breaks its line with Damaged.

import strings
import time

// Plain is r made Valid: each text field with its spaces and line ends
// made underscores, or "-" when it is empty; the status moved into
// 100..999; the numbers made not negative and short enough to read; and
// the time cut to its second, since the log's layout writes no fraction.
// A Valid r with a whole second is its own Plain.
func Plain(r Request) Request {
	Request{
		Addr:   plainText(r.Addr),
		At:     time.Unix(time.UnixSeconds(r.At), 0),
		Method: plainText(r.Method),
		Target: plainText(r.Target),
		Proto:  plainText(r.Proto),
		Status: if r.Status >= 100 && r.Status <= 999 { r.Status } else { 100 + natural(r.Status)%900 },
		Bytes:  natural(r.Bytes) % 1000000000000000000,
		Micros: natural(r.Micros) % (1000000000 * 1000000),
	}
}

// plainText is s with each space and line end made an underscore, or "-"
// when s is empty.
func plainText(s string) string {
	let t = strings.ReplaceAll(strings.ReplaceAll(s, " ", "_"), "\n", "_")
	if t == "" { "-" } else { t }
}

// noise is what Damaged puts in place of a byte.
let noise = []string{"", " ", "  ", "\"", "[", "]", "\\", "x", "-", ".", "9"}

// Damaged is the line of r with the byte at index i replaced by noise
// pick j, and cut after index cut when cut picks so: a line that may
// not parse.
func Damaged(r Request, i int, j int, cut int) string {
	let line = Format(r)
	let at = natural(i) % len(line)
	let damaged = strings.Slice(line, 0, at) + noise[natural(j)%len(noise)] + strings.Slice(line, at+1, len(line))
	if natural(cut)%3 != 0 {
		return damaged
	}
	strings.Slice(damaged, 0, natural(cut)%(len(damaged)+1))
}

// natural is n, or -(n+1) when n is negative: never negative.
func natural(n int) int { if n < 0 { -(n + 1) } else { n } }
