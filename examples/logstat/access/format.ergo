import strings
import time
import tz

// Format is the line of r, which Parse reads back as r when r is Valid.
// The time is written in UTC, offset +0000.
func Format(r Request) string {
	let req = escape(r.Method + " " + r.Target + " " + r.Proto)
	let size = if r.Bytes == 0 { "-" } else { "\(r.Bytes)" }
	"\(r.Addr) - - [\(tz.FormatZoned(tz.Zoned{At: r.At, Zone: tz.UTC()}, Layout))] \"\(req)\" \(r.Status) \(size) \(Seconds(r.Micros))"
}

// FormatParses: the line Format writes of a Valid request reads back as
// the request, for r made Valid by Plain, and for that request at r's own
// time when it is Valid.
law FormatParses(r Request) {
	let x = Plain(r)
	if !Valid(x) {
		return false
	}
	for y in []Request{x, Request{..x, At: r.At}} {
		if !Valid(y) {
			continue
		}
		let back = Parse(Format(y)) catch {
		case Problem:
			return false
		}
		if !Same(back, y) {
			return false
		}
	}
	true
}

// Same reports whether a and b are the same request at the same instant.
func Same(a Request, b Request) bool {
	a.Addr == b.Addr && time.Equal(a.At, b.At) && a.Method == b.Method && a.Target == b.Target && a.Proto == b.Proto && a.Status == b.Status && a.Bytes == b.Bytes && a.Micros == b.Micros
}

// Seconds is micros as seconds, with three decimals, or six when the
// last three are not zero.
func Seconds(micros int) string {
	let frac = "\(1000000 + micros%1000000)"
	let six = strings.Slice(frac, 1, 7)
	let digits = if strings.HasSuffix(six, "000") { strings.Slice(six, 0, 3) } else { six }
	"\(micros / 1000000).\(digits)"
}

// escape is s with a backslash before each quote and backslash.
func escape(s string) string {
	strings.ReplaceAll(strings.ReplaceAll(s, "\\", "\\\\"), "\"", "\\\"")
}

// Valid reports whether Format writes r as a line that Parse reads back
// as r: the address, method, target and protocol hold no space and are
// not empty, the status has three digits, the numbers are not negative
// and not too long to read, and the time is a whole second (the layout
// writes no fraction).
func Valid(r Request) bool {
	plain(r.Addr) && plain(r.Method) && plain(r.Target) && plain(r.Proto) && r.Status >= 100 && r.Status <= 999 && r.Bytes >= 0 && r.Bytes < 1000000000000000000 && r.Micros >= 0 && r.Micros < 1000000000*1000000 && time.Nanosecond(r.At) == 0
}

func plain(s string) bool { s != "" && !strings.Contains(s, " ") && !strings.Contains(s, "\n") }
