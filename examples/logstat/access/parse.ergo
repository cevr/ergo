import strconv
import strings
import time

// The failures of Parse. Each names the column, from 1, of the first
// byte of the field it could not read; the end of the line is the
// column after its last byte.

// Missing is a line that ends before the field Want.
type Missing { Column int, Want string }

// BadNumber is a field that is not the number it should be.
type BadNumber { Column int, Field string, Text string }

// BadTime is a time that is not in the log's layout.
type BadTime { Column int, Text string }

// BadRequest is a request line that is not a method, a target and a
// protocol.
type BadRequest { Column int, Text string }

// Trailing is text after the last field.
type Trailing { Column int, Text string }

// Layout is the layout of the log's times.
let Layout = time.Custom{Text: "02/Jan/2006:15:04:05 -0700"}

// scanner is the line and the index of the next byte to read. Parse
// owns it, and each field takes it by borrow and moves it on.
type scanner { line string, pos int }

// Parse is the Request of line.
func Parse(line string) Request fails Problem {
	let mut sc = scanner{line: line, pos: 0}
	let addr = try word(&sc, "the client address")
	let _ = try word(&sc, "the identity")
	let _ = try word(&sc, "the user")
	let at = try stamp(&sc)
	let req = try quoted(&sc, "the request")
	let parts = strings.Split(req.text, " ")
	if len(parts) != 3 || parts[0] == "" || parts[1] == "" || parts[2] == "" {
		return BadRequest{Column: req.column, Text: req.text}
	}
	let status = try integer(&sc, "status")
	let size = try word(&sc, "the size")
	let bytes = if size.text == "-" { 0 } else { try digits(size, "size") }
	let took = try word(&sc, "the time taken")
	let micros = try seconds(took)
	skipSpaces(&sc)
	if sc.pos < len(line) {
		return Trailing{Column: sc.pos + 1, Text: strings.Slice(line, sc.pos, len(line))}
	}
	Request{Addr: addr.text, At: at, Method: parts[0], Target: parts[1], Proto: parts[2], Status: status, Bytes: bytes, Micros: micros}
}

// field is the text of a field and the column it starts at.
type field { text string, column int }

func skipSpaces(sc *scanner) {
	for sc.pos < len(sc.line) && sc.line[sc.pos] == ' ' {
		sc.pos += 1
	}
}

// word is the next field up to a space or the end of the line.
func word(sc *scanner, want string) field fails Missing {
	skipSpaces(sc)
	let start = sc.pos
	for sc.pos < len(sc.line) && sc.line[sc.pos] != ' ' {
		sc.pos += 1
	}
	if sc.pos == start {
		return Missing{Column: start + 1, Want: want}
	}
	field{text: strings.Slice(sc.line, start, sc.pos), column: start + 1}
}

// closed is the next field between open and close, which a space may
// be inside of; close may be escaped with a backslash.
func closed(sc *scanner, open byte, close byte, want string) field fails Missing {
	skipSpaces(sc)
	let start = sc.pos
	if sc.pos >= len(sc.line) || sc.line[sc.pos] != open {
		return Missing{Column: start + 1, Want: want}
	}
	sc.pos += 1
	let mut parts = []string{}
	let mut from = sc.pos
	for sc.pos < len(sc.line) && sc.line[sc.pos] != close {
		if sc.line[sc.pos] == '\\' && sc.pos+1 < len(sc.line) {
			parts = parts.Append(strings.Slice(sc.line, from, sc.pos))
			from = sc.pos + 1
			sc.pos += 1
		}
		sc.pos += 1
	}
	if sc.pos >= len(sc.line) {
		return Missing{Column: len(sc.line) + 1, Want: "the end of " + want}
	}
	parts = parts.Append(strings.Slice(sc.line, from, sc.pos))
	sc.pos += 1
	field{text: strings.Join(parts, ""), column: start + 2}
}

func stamp(sc *scanner) time.Time fails Missing | BadTime {
	let f = try closed(sc, '[', ']', "the time in [ ]")
	time.Parse(Layout, f.text) catch {
	case time.ParseError:
		return BadTime{Column: f.column, Text: f.text}
	}
}

func quoted(sc *scanner, want string) field fails Missing {
	try closed(sc, '"', '"', want+" in quotes")
}

func integer(sc *scanner, name string) int fails Missing | BadNumber {
	try digits(try word(sc, "the "+name), name)
}

// digits is the number that f is all digits of.
func digits(f field, name string) int fails BadNumber {
	if len(f.text) > 18 {
		return BadNumber{Column: f.column, Field: name, Text: f.text}
	}
	for i in 0..len(f.text) {
		if f.text[i] < '0' || f.text[i] > '9' {
			return BadNumber{Column: f.column, Field: name, Text: f.text}
		}
	}
	strconv.Atoi(f.text) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return BadNumber{Column: f.column, Field: name, Text: f.text}
	}
}

// seconds is the microseconds of f, a count of seconds with at most six
// decimals, read exactly, with no float.
func seconds(f field) int fails BadNumber {
	let bad = BadNumber{Column: f.column, Field: "time taken", Text: f.text}
	let halves = strings.Cut(f.text, ".")
	match halves {
	case None:
		if len(f.text) > 9 {
			return bad
		}
		let whole = try digits(f, "time taken")
		whole * 1000000
	case Some as h:
		let frac = h.Value.After
		if h.Value.Before == "" || len(h.Value.Before) > 9 || frac == "" || len(frac) > 6 {
			return bad
		}
		let whole = digits(field{text: h.Value.Before, column: f.column}, "time taken") catch {
		case BadNumber:
			return bad
		}
		let part = digits(field{text: frac + strings.Repeat("0", 6-len(frac)), column: f.column}, "time taken") catch {
		case BadNumber:
			return bad
		}
		whole*1000000 + part
	}
}
