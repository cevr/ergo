import cmp
import maps
import slices

// Count is how many times a key was seen.
type Count { Key string, N int }

// Tally is how many times each of keys is in keys.
func Tally(keys []string) Map[string, int] {
	let mut m Map[string, int] = Map[string, int]{}
	for k in keys {
		m[k] = maps.GetOr(m, k, 0) + 1
	}
	m
}

// Rank is the counts of m, most first and then by key, at most top of
// them; a top below zero keeps them all.
func Rank(m Map[string, int], top int) []Count {
	let mut all = []Count{}
	for k, n in m {
		all = all.Append(Count{Key: k, N: n})
	}
	let sorted = slices.SortFunc(all, ByCountThenKey)
	if top < 0 || top >= len(sorted) {
		return sorted
	}
	let mut out = []Count{}
	for i in 0..top {
		out = out.Append(sorted[i])
	}
	out
}

// RankKeepsEveryKey: ranked with no limit, the counts sum to the number
// of keys, one count for each distinct key.
law RankKeepsEveryKey(keys []string, ns []int) {
	for ks in [][]string{keys, Keys(ns)} {
		let ranked = Rank(Tally(ks), -1)
		if Total(ranked) != len(ks) || len(ranked) != len(seen(ks)) {
			return false
		}
	}
	true
}

// seen is the distinct keys, each once, in the order first seen.
func seen(keys []string) []string {
	let mut out = []string{}
	for k in keys {
		if !slices.Contains(out, k) {
			out = out.Append(k)
		}
	}
	out
}

// Keys is a key from a to f for each of ns, so that keys repeat.
func Keys(ns []int) []string {
	let names = []string{"a", "b", "c", "d", "e", "f"}
	slices.Transform(ns, func(n int) string { names[natural(n)%len(names)] })
}

// RankIsOrdered: ranked counts are most first, ties by key, and are the
// first top of all the ranked counts.
law RankIsOrdered(keys []string, ns []int, top int) {
	for ks in [][]string{keys, Keys(ns)} {
		for t in []int{top, natural(top)%8 - 1} {
			let all = Rank(Tally(ks), -1)
			let ranked = Rank(Tally(ks), t)
			if t >= 0 && len(ranked) > t {
				return false
			}
			for i in 0..len(ranked) {
				if ranked[i] != all[i] || (i > 0 && ByCountThenKey(ranked[i-1], ranked[i]) >= 0) {
					return false
				}
			}
		}
	}
	true
}

// ByCountThenKey orders counts most first, and equal counts by key.
func ByCountThenKey(a Count, b Count) int {
	if a.N != b.N {
		return cmp.Compare(b.N, a.N)
	}
	cmp.Compare(a.Key, b.Key)
}

// Total is the sum of the counts.
func Total(cs []Count) int {
	let mut n = 0
	for c in cs {
		n += c.N
	}
	n
}
