// Package stats counts, ranks and takes percentiles: the arithmetic of
// a report, with no log in it.

import option
import slices

// Quantile is the value at percentile P of a sample.
type Quantile { P int, Value int }

// Percentiles is the nearest-rank percentile of the sample for each of
// ps: the smallest value that at least p percent of the sample is at or
// below. p is clamped to 0..100, and percentile 0 is the smallest
// value. An empty sample has none. The sample is an Ascending, so it is
// sorted by its type, not by a comment.
func Percentiles(sample slices.Ascending[int], ps []int) []Quantile {
	// Items is a copy of the sample, so it is taken once (gap G-ex-a-12).
	let xs = slices.Items(sample)
	let mut out = []Quantile{}
	if xs.Len() == 0 {
		return out
	}
	for p in ps {
		let q = if p < 0 { 0 } else if p > 100 { 100 } else { p }
		out = out.Append(Quantile{P: p, Value: xs[rank(q, xs.Len())]})
	}
	out
}

// PercentileIsMonotone: a higher percentile is never a smaller value.
law PercentileIsMonotone(xs []int, p int, q int) {
	let lo = percent(p)
	let hi = lo + natural(q)%(101-lo)
	let qs = Percentiles(slices.Ascend(xs), []int{lo, hi})
	qs.Len() == 0 || qs[0].Value <= qs[1].Value
}

// rank is the index of the nearest-rank percentile p of n sorted values:
// ceil(p * n / 100) - 1, and 0 for p = 0.
func rank(p int, n int) int {
	let r = (p*n + 99) / 100
	if r < 1 { 0 } else { r - 1 }
}

// Percentile is the one percentile p of the sample, if it has values.
func Percentile(sample slices.Ascending[int], p int) option.Option[int] {
	let qs = Percentiles(sample, []int{p})
	if qs.Len() == 0 {
		return option.None
	}
	option.Some{Value: qs[0].Value}
}

// PercentileIsASampleValue: a percentile of a sample is one of its
// values.
law PercentileIsASampleValue(xs []int, p int) {
	for pc in []int{p, percent(p)} {
		match Percentile(slices.Ascend(xs), pc) {
		case option.Some as v:
			if !slices.Contains(xs, v.Value) {
				return false
			}
		case option.None:
			if xs.Len() != 0 {
				return false
			}
		}
	}
	true
}

// percent is n made a percent, 0 to 100.
func percent(n int) int { natural(n) % 101 }

// natural is n made not negative, -1 to 0 and the least int to the
// greatest.
func natural(n int) int { if n < 0 { -(n + 1) } else { n } }

// PercentileCovers: at least p percent of the sample is at or below
// percentile p, and percentile 100 is the largest value.
law PercentileCovers(xs []int, p int) {
	for pc in []int{percent(p), 100} {
		match Percentile(slices.Ascend(xs), pc) {
		case option.Some as v:
			let mut at = 0
			for x in xs {
				if x <= v.Value {
					at += 1
				}
			}
			if at*100 < pc*xs.Len() || (pc == 100 && slices.Max(xs) != option.Some{Value: v.Value}) {
				return false
			}
		case option.None:
			if xs.Len() != 0 {
				return false
			}
		}
	}
	true
}

// Mean is the sum of xs over their count, rounded down, if there are
// any.
func Mean(xs []int) option.Option[int] {
	if xs.Len() == 0 {
		return option.None
	}
	let mut sum = 0
	for x in xs {
		sum += x
	}
	option.Some{Value: sum / xs.Len()}
}
