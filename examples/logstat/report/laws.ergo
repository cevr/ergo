// The rules of a report as laws.

import logstat/access
import logstat/stats
import slices
import strconv
import strings

// KeyNameReadsBack: the name of a key reads back as the key.
law KeyNameReadsBack(k Key) {
	match KeyNamed(KeyName(k)) {
	case Some as back:
		KeyName(back.Value) == KeyName(k)
	case None:
		false
	}
}

// EveryRequestIsCounted: the status classes and the top counts with no
// limit each add up to the number of requests: n of the samples of seed
// (time.Time has no generator, so a law cannot take a Request).
law EveryRequestIsCounted(seed int, n int, k Key) {
	let reqs = slices.Slice(access.Samples(seed), 0, (if n < 0 { -(n + 1) } else { n })%11)
	let s = Summarize(reqs, 0, k, -1)
	stats.Total(s.Classes) == s.Requests && stats.Total(s.Top) == s.Requests
}

// Safe reports whether q, a quoted string, holds no control byte, no
// <, > or &, and no quote but the first and last that a backslash does
// not escape.
func Safe(q string) bool {
	if len(q) < 2 || q[0] != '"' || q[len(q)-1] != '"' {
		return false
	}
	let mut i = 1
	for i < len(q)-1 {
		let c = q[i]
		if c < 32 || c == '<' || c == '>' || c == '&' || c == '"' {
			return false
		}
		i += if c == '\\' { 2 } else { 1 }
	}
	// a backslash before the last quote steps past it
	i == len(q)-1
}

// QuoteReadsBack: a JSON string of valid UTF-8 text reads back as the
// text (Go's strconv.Unquote reads JSON's escapes), for s made valid and
// with every escaped character added.
law QuoteReadsBack(s string) {
	let t = strings.ToValidUTF8(s, "\ufffd")
	for x in []string{t, t + "\"\\<>&\n\r\t\x00\x7f\u2028\u2029é", "\x01" + t} {
		let back = strconv.Unquote(Quote(x)) catch {
		case strconv.Malformed:
			return false
		}
		if back != x {
			return false
		}
	}
	true
}

// QuoteIsSafe: a JSON string holds no control character and no <, >
// or &, and every quote in it is escaped, whatever bytes s holds.
law QuoteIsSafe(s string) {
	Safe(Quote(s)) && Safe(Quote(s+"\"\\")) && Safe(Quote("<\x00>&\xff"+s))
}
