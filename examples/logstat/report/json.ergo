import logstat/stats
import strconv
import strings
import time
import utf8

// Encode is s as one line of JSON, with the fields in a fixed order, as
// Go's encoding/json writes a struct. Ergo has no JSON encoder (gap
// G-ex-a-14), so each value is written here.
func Encode(s Summary) string {
	let mut fields = []string{
		field("requests", "\(s.Requests)"),
		field("bad", "\(s.Bad)"),
		field("bytes", "\(s.Bytes)"),
	}
	match s.Span {
	case Some as sp:
		fields = fields.Append(field("from", Quote(time.Format(sp.Value.First, time.RFC3339))))
		fields = fields.Append(field("to", Quote(time.Format(sp.Value.Last, time.RFC3339))))
	case None:
		fields = fields.Append(field("from", "null"))
		fields = fields.Append(field("to", "null"))
	}
	fields = fields.Append(field("status", object(s.Classes)))
	let mut latency = []string{}
	match s.Mean {
	case Some as m:
		latency = latency.Append(field("mean", "\(m.Value)"))
	case None:
	}
	for q in s.Latency {
		latency = latency.Append(field("p\(q.P)", "\(q.Value)"))
	}
	fields = fields.Append(field("micros", "{"+strings.Join(latency, ",")+"}"))
	fields = fields.Append(field("by", Quote(s.By)))
	let mut top = []string{}
	for c in s.Top {
		top = top.Append("{" + field("key", Quote(c.Key)) + "," + field("count", "\(c.N)") + "}")
	}
	fields = fields.Append(field("top", "["+strings.Join(top, ",")+"]"))
	"{" + strings.Join(fields, ",") + "}\n"
}

func field(name string, value string) string { Quote(name) + ":" + value }

// object is counts as a JSON object of key and count, in their order.
func object(counts []stats.Count) string {
	let mut parts = []string{}
	for c in counts {
		parts = parts.Append(field(c.Key, "\(c.N)"))
	}
	"{" + strings.Join(parts, ",") + "}"
}

// Quote is s as a JSON string, as Go's encoding/json writes it: a quote
// and a backslash are escaped, the control characters are \n, \r, \t or
// \u00XX, <, > and & are \u003c, \u003e and \u0026, so the text is safe
// inside HTML, and U+2028 and U+2029 are \u2028 and \u2029, so it is safe
// inside JavaScript. Each byte of invalid UTF-8 is \ufffd.
func Quote(s string) string {
	let mut parts = []string{"\""}
	let mut i = 0
	for i < len(s) {
		let d = utf8.DecodeRuneInString(strings.Slice(s, i, len(s)))
		if d.Rune == 0xFFFD && d.Size == 1 {
			parts = parts.Append("\\ufffd")
		} else {
			parts = parts.Append(escaped(d.Rune))
		}
		i += d.Size
	}
	parts = parts.Append("\"")
	strings.Join(parts, "")
}

// escaped is the JSON text of the character r: its escape, or r.
func escaped(r rune) string {
	match r {
	case '"':
		"\\\""
	case '\\':
		"\\\\"
	case '\n':
		"\\n"
	case '\r':
		"\\r"
	case '\t':
		"\\t"
	case '<', '>', '&', 0x2028, 0x2029:
		unicode(r)
	case _:
		if r < 0x20 { unicode(r) } else { utf8.RuneText(r) }
	}
}

// unicode is r as \uXXXX.
func unicode(r rune) string { "\\u" + strings.PadLeft(strconv.FormatInt(int64(r), 16), 4, '0') }
