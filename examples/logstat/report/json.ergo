import json
import logstat/stats
import time

// Encode is s as one line of JSON, with the fields in a fixed order, as
// Go's encoding/json writes a struct: std json's HTML Text, which escapes
// <, > and & as Go does by default. The status classes and the latency
// keys are written in their order, so this is a text written by hand
// over the Text's events, not a derived codec (a Map's would sort them).
func Encode(s Summary) string {
	let t = json.NewHTMLText()
	t.BeginObject(10)
	t.Key("requests")
	t.Int(int64(s.Requests))
	t.Key("bad")
	t.Int(int64(s.Bad))
	t.Key("bytes")
	t.Int(int64(s.Bytes))
	match s.Span {
	case Some as sp:
		t.Key("from")
		t.String(time.Format(sp.Value.First, time.RFC3339))
		t.Key("to")
		t.String(time.Format(sp.Value.Last, time.RFC3339))
	case None:
		t.Key("from")
		t.Null()
		t.Key("to")
		t.Null()
	}
	t.Key("status")
	counts(t, s.Classes)
	t.Key("micros")
	t.BeginObject(len(s.Latency) + 1)
	match s.Mean {
	case Some as m:
		t.Key("mean")
		t.Int(int64(m.Value))
	case None:
	}
	for q in s.Latency {
		t.Key("p\(q.P)")
		t.Int(int64(q.Value))
	}
	t.EndObject()
	t.Key("by")
	t.String(s.By)
	t.Key("top")
	t.BeginList(len(s.Top))
	for c in s.Top {
		t.BeginObject(2)
		t.Key("key")
		t.String(c.Key)
		t.Key("count")
		t.Int(int64(c.N))
		t.EndObject()
	}
	t.EndList()
	t.EndObject()
	t.Written() + "\n"
}

// counts writes counts as a JSON object of key and count, in their order.
func counts(t json.Text, cs []stats.Count) {
	t.BeginObject(len(cs))
	for c in cs {
		t.Key(c.Key)
		t.Int(int64(c.N))
	}
	t.EndObject()
}

// Quote is s as a JSON string, as Go's encoding/json writes it: a quote
// and a backslash are escaped, the control characters are \n, \r, \t or
// \u00XX, <, > and & are \u003c, \u003e and \u0026, so the text is safe
// inside HTML, and U+2028 and U+2029 are \u2028 and \u2029, so it is safe
// inside JavaScript. A byte of invalid UTF-8 is std json's \udcXX of the
// byte (Go writes \ufffd), so the text reads back as the bytes.
func Quote(s string) string {
	let t = json.NewHTMLText()
	t.String(s)
	t.Written()
}
