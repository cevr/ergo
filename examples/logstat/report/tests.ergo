// The report's tests: a summary in each style, an empty log, and Go's
// escapes. The laws run under ergo test.

import logstat/access
import logstat/stats

let lines = []string{
	"203.0.113.9 - - [08/Nov/2026:10:00:00 +0000] \"GET /api/users?id=7 HTTP/1.1\" 200 512 0.120",
	"203.0.113.9 - - [08/Nov/2026:10:00:05 +0000] \"GET /api/users HTTP/1.1\" 200 1024 0.080",
	"198.51.100.7 - - [08/Nov/2026:09:59:58 +0000] \"POST /api/orders HTTP/1.1\" 201 64 0.300",
	"198.51.100.7 - - [08/Nov/2026:10:01:00 +0000] \"GET /<script> HTTP/1.1\" 404 - 0.002",
	"10.0.0.1 - - [08/Nov/2026:10:02:00 +0000] \"GET / HTTP/1.1\" 503 - 1.5",
}

func requests() []access.Request {
	let mut out = []access.Request{}
	for l in lines {
		let r = access.Parse(l) catch {
		case _:
			continue
		}
		out = out.Append(r)
	}
	out
}

test TextSummary {
	let s = Summarize(requests(), 2, ByPath, 2)
	assert Text(s) == "requests  5 (2 bad lines)\nfrom      2026-11-08T09:59:58Z\nto        2026-11-08T10:02:00Z\nbytes     1600\nstatus    2xx 3  4xx 1  5xx 1\nseconds   mean 0.400400  p50 0.120  p90 1.500  p99 1.500\ntop 2 by path\n  2  /api/users\n  1  /\n"
}

test JSONSummary {
	let s = Summarize(requests(), 0, ByAddr, 1)
	assert Encode(s) == "{\"requests\":5,\"bad\":0,\"bytes\":1600,\"from\":\"2026-11-08T09:59:58Z\",\"to\":\"2026-11-08T10:02:00Z\",\"status\":{\"2xx\":3,\"4xx\":1,\"5xx\":1},\"micros\":{\"mean\":400400,\"p50\":120000,\"p90\":1500000,\"p99\":1500000},\"by\":\"addr\",\"top\":[{\"key\":\"198.51.100.7\",\"count\":2}]}\n"
	assert Write(JSON, Summarize(requests(), 0, ByPath, -1)) == Encode(Summarize(requests(), 0, ByPath, -1))
}

test EmptyLog {
	let s = Summarize([]access.Request{}, 3, ByStatus, 5)
	assert Text(s) == "requests  0 (3 bad lines)\nbytes     0\n"
	assert Encode(s) == "{\"requests\":0,\"bad\":3,\"bytes\":0,\"from\":null,\"to\":null,\"status\":{},\"micros\":{},\"by\":\"status\",\"top\":[]}\n"
}

test KeysCount {
	let rs = requests()
	assert Summarize(rs, 0, ByStatus, 1).Top[0] == stats.Count{Key: "200", N: 2}
	assert Summarize(rs, 0, ByMethod, 1).Top[0] == stats.Count{Key: "GET", N: 4}
	assert Summarize(rs, 0, ByPath, 5).Top[3] == stats.Count{Key: "/api/orders", N: 1}
	match KeyNamed("host") {
	case Some:
		assert false
	case None:
	}
}

test QuoteEscapesAsGo {
	assert Quote("a\"b\\c") == "\"a\\\"b\\\\c\""
	assert Quote("<a&b>") == "\"\\u003ca\\u0026b\\u003e\""
	assert Quote("\n\t\r\x01\x1f é") == "\"\\n\\t\\r\\u0001\\u001f é\""
	assert Quote("a\xffb\xc3") == "\"a\\udcffb\\udcc3\"" && Quote("\u2028\ufffd") == "\"\\u2028\ufffd\""
}
