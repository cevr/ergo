// The fast solver's own law: it solves what the reference solves.

import sudoku/board
import sudoku/naive

// AgreesWithNaive: on every sampled puzzle, propagate and naive agree on
// whether it has a solution. (Their first solutions differ when it has
// several: they search in different orders.)
law AgreesWithNaive(seed int, blanks int, broken bool) {
	let n = board.BlanksOf(blanks)
	let p = if broken { board.Broken(seed, n+1) } else { board.Puzzle(seed, n) }
	board.Solvable(Solver, p) == board.Solvable(naive.Solver, p)
}
