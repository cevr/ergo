// The reference solver's tests: an easy puzzle. ergo test runs the
// board.Solver laws here, against Solver. Hard puzzles are left out: plain
// backtracking takes seconds on them.

import sudoku/board

test SolvesEasy {
	let p = try board.Parse("003020600900305001001806400008102900700000008006708200002609500800203009005010300")
	assert board.Line(try Solver.Solve(p)) == "483921657967345821251876493548132976729564138136798245372689514814253769695417382"
}
