// fk-transfers is a port of Foldkit's interrupting-commands example
// (stage a: the model, with no view): file transfers that a user starts,
// cancels one by one or all at once, and restarts. It runs a script of
// timed presses on a manual clock and shows the board after each one.
// Package transfer is one transfer, a machine whose Sending state owns its
// time; package board holds one live actor per transfer (shape A);
// package emitted is upstream's shape, a machine that emits commands to a
// registry (shape B); package script reads the script and plays it. This
// binary is the only place that chooses the clock: a time.Manual, so a
// script of minutes takes no wall time.

import fktransfers/script
import io
import os
import time

func main() fails os.Exit needs Console | Ambient {
	let clock = time.NewManual(0)
	let status = with context { io.Stdin: io.NewStdin(), Scheduler: clock } { script.Run(clock) }
	if status != 0 {
		return os.Exit{Code: status, Message: "fk-transfers: the script did not run"}
	}
}
