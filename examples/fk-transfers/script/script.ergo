// Package script plays a script of timed button presses on both shapes of
// the board: shape A (board, live actors on a time.Manual) and shape B
// (emitted, a fold with its registry), and shows shape A after each press.

import fktransfers/board
import fktransfers/emitted
import io
import strconv
import strings
import time

// Press is a button: start the next transfer, cancel one, cancel all, or
// restart one.
type Press = Start{} | Cancel{ID int} | CancelAll{} | Restart{ID int}

// Line is a press at a time since the start.
type Line { At duration, Press Press }

// Script is the presses, and the time the run ends.
type Script { Lines []Line, End duration }

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Read reads the lines of a script. Each line is `@MS WORD [ID]`: MS is
// the time in milliseconds, never earlier than the line before, and WORD
// is start, cancel ID, cancelall, restart ID or end, which must be last.
// A blank line or a line that starts with # is skipped.
func Read(text []string) Script fails BadLine {
	let mut lines = []Line{}
	let mut last = 0s
	for i, raw in text {
		let n = i + 1
		let t = strings.TrimSpace(raw)
		let words = strings.Fields(t)
		if len(words) == 0 || strings.HasPrefix(t, "#") {
			continue
		}
		if len(words) < 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD"}
		}
		let at = time.Times(1ms, try count(n, strings.TrimPrefix(words[0], "@")))
		if at < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = at
		let word = words[1]
		let press = match word {
		case "end":
			return Script{Lines: lines, End: at}
		case "start":
			Start
		case "cancelall":
			CancelAll
		case "cancel", "restart":
			if len(words) != 3 {
				return BadLine{Line: n, Why: "\(word) takes one id"}
			}
			let id = try count(n, words[2])
			if word == "cancel" { Cancel{ID: id} } else { Restart{ID: id} }
		case _:
			return BadLine{Line: n, Why: "unknown word \(word)"}
		}
		lines = lines.Append(Line{At: at, Press: press})
	}
	BadLine{Line: len(text) + 1, Why: "the script has no @MS end line"}
}

func count(n int, word string) int fails BadLine {
	let v = strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	v
}

// PlayA plays lines on shape A, the live board, moving clock to each
// line's time first (so a transfer due by then has arrived), and gives the
// board after each press, then after end.
func PlayA(lines []Line, end duration, clock time.Manual) [][]string needs Scheduler {
	let mut b = board.New()
	let mut out = [][]string{}
	let mut now = 0s
	for l in lines {
		time.Advance(clock, l.At-now)
		now = l.At
		match l.Press {
		case Start:
			b = board.Start(b)
		case Cancel as c:
			board.Cancel(b, c.ID)
		case CancelAll:
			board.CancelAll(b)
		case Restart as r:
			board.Restart(b, r.ID)
		}
		out = out.Append(board.Lines(b))
	}
	time.Advance(clock, end-now)
	out = out.Append(board.Lines(b))
	board.Shutdown(b)
	out
}

// PlayB plays lines on shape B, the machine with its registry, in the same
// way.
func PlayB(lines []Line, end duration) [][]string {
	let mut w = emitted.Fresh()
	let mut out = [][]string{}
	let mut now = 0s
	for l in lines {
		w = emitted.Wait(w, l.At-now)
		now = l.At
		w = emitted.Press(w, match l.Press {
		case Start:
			emitted.Begin
		case Cancel as c:
			emitted.CancelOne{ID: c.ID}
		case CancelAll:
			emitted.CancelEvery
		case Restart as r:
			emitted.RestartOne{ID: r.ID}
		})
		out = out.Append(emitted.Lines(w))
	}
	w = emitted.Wait(w, end-now)
	out.Append(emitted.Lines(w))
}

// Run reads the script from io.Stdin and shows shape A after each press
// and at the end: `@MS` and then one `  ID NAME WORD` line per transfer.
// It returns the exit status: 0, or 1 when the script is refused.
func Run(clock time.Manual) int needs Console | io.Stdin | Scheduler {
	let mut text = []string{}
	for line in io.Stdin.Lines() {
		text = text.Append(line)
	}
	let s = Read(text) catch {
	case BadLine as b:
		Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let shown = PlayA(s.Lines, s.End, clock)
	for i, rows in shown {
		let at = if i < len(s.Lines) { s.Lines[i].At } else { s.End }
		let what = if i < len(s.Lines) { Name(s.Lines[i].Press) } else { "end" }
		Console.Println("@\(time.Count(at, 1ms)) \(what)")
		for r in rows {
			Console.Println("  \(r)")
		}
	}
	0
}

// Name is how a press shows.
func Name(p Press) string {
	match p {
	case Start:
		"start"
	case Cancel as c:
		"cancel \(c.ID)"
	case CancelAll:
		"cancelall"
	case Restart as r:
		"restart \(r.ID)"
	}
}
