// A program of the decided language (docs/spec/ v0) inside the prototype
// checker's subset: rows, try, catch, a closed context and timeout.After.

import io

type NotFound { Name string }

type Greeter {
	Greet(name string) string fails NotFound,
}

type Friends {} implements Greeter

func Greet(_ Friends, name string) string fails NotFound {
	if name == "Ada" {
		return "hello, " + name
	}
	return NotFound{Name: name}
}

let Live = context {
	Greeter: Friends,
}

func greet(name string) needs io.Console {
	let line = with Live { Greeter.Greet(name) } catch {
	case NotFound:
		"no friend named " + name
	}
	io.Console.Println(line)
}

func main() needs io.Console {
	greet("Ada")
	greet("Bob")
}
