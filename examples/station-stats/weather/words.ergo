// Eight bytes at a time (SWAR): the fast path reads a station and a
// temperature as 64-bit little-endian words.

import fs

// Word is the eight bytes of w as a little-endian word. Its caller cuts w
// from the text where a guard proves the cut in range, so the cut needs
// no check (the lowering's bounds facts), and gc, which then sees eight
// bytes, needs none for the reads.
func Word(w fs.Text) uint64 {
	uint64(w[0]) | uint64(w[1])<<8 | uint64(w[2])<<16 | uint64(w[3])<<24 | uint64(w[4])<<32 | uint64(w[5])<<40 | uint64(w[6])<<48 | uint64(w[7])<<56
}

// Lanes marks the bytes of w equal to the byte that rep repeats in every
// lane: the high bit of the lowest marked lane is exact, and a lane above
// a marked one may be marked too.
func Lanes(w uint64, rep uint64) uint64 {
	let x = w ^ rep
	(x - 0x0101010101010101) & ^x & 0x8080808080808080
}

// Below keeps the bytes of a word below the lowest lane that s marks
// (Lanes): all of them when s marks none.
func Below(s uint64) uint64 {
	let z = ((s - 1) & ^s) >> 63
	((s ^ (s - 1)) >> 8) | -z
}

// Semis is 0x3B, ';', in every lane.
let Semis uint64 = 0x3B3B3B3B3B3B3B3B

// Newlines is 0x0A, '\n', in every lane.
let Newlines uint64 = 0x0A0A0A0A0A0A0A0A

// Temp is a temperature read from the word that starts it, "-?d?d.d\n":
// Bad is 0 exactly when the word holds that form.
type Temp { Tenths int, Width int, Bad uint64 }

// ReadTemp reads the temperature at the start of w: its tenths, the width
// of its text before the newline, and Bad, 0 exactly when w holds that
// form. It branches once on the form, d.d or dd.d after an optional '-',
// and each digit is its byte less '0', compared unsigned, so one compare
// rejects a byte below '0' as well as one above '9'.
func ReadTemp(w uint64) Temp {
	let sign = if (w & 0xFF) == 0x2D { 1 } else { 0 }
	let d = w >> (uint(sign) * 8)
	let c0 = (d & 0xFF) - 0x30
	let c1 = (d >> 8) & 0xFF
	let c2 = (d >> 16) & 0xFF
	let c3 = (d >> 24) & 0xFF
	if c1 == 0x2E && c3 == 0x0A && c0 <= 9 && c2-0x30 <= 9 {
		let v = int(c0*10 + c2 - 0x30)
		return Temp{Tenths: (v ^ -sign) + sign, Width: 3 + sign, Bad: 0}
	}
	if c2 == 0x2E && ((d>>32)&0xFF) == 0x0A && c0 <= 9 && c1-0x30 <= 9 && c3-0x30 <= 9 {
		let v = int(c0*100 + (c1-0x30)*10 + c3 - 0x30)
		return Temp{Tenths: (v ^ -sign) + sign, Width: 4 + sign, Bad: 0}
	}
	Temp{Tenths: 0, Width: 0, Bad: 1}
}

// Words is the first sixteen bytes of the station of n bytes at p, as the
// fast path loads and masks them, read byte by byte.
func Words(text fs.Text, p int, n int) (uint64, uint64) {
	let mut w0 uint64 = 0
	let mut w1 uint64 = 0
	for k in 0..lo(n, 16) {
		if k < 8 {
			w0 |= uint64(text[p+k]) << (uint(k) * 8)
		} else {
			w1 |= uint64(text[p+k]) << (uint(k-8) * 8)
		}
	}
	(w0, w1)
}
