// Package memory is a Readings provider over texts held in memory, for
// tests: an input is named by a key.

import onebrc/weather

// Texts holds the inputs by name.
type Texts { Inputs Map[string, string] }

// Text is the input named path.
func Text(t Texts, path string) string fails weather.Unreadable {
	match t.Inputs.Get(path) {
	case Some[string] as s:
		s.Value
	case None:
		return weather.Unreadable{Path: path, Reason: "no such input"}
	}
}
