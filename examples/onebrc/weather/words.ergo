// Eight bytes at a time (SWAR): the fast path reads a station and a
// temperature as 64-bit little-endian words.

import bits
import strings

// Word is the eight bytes of text at p as a little-endian word; p+8 is
// within text.
func Word(text string, p int) uint64 {
	let w = strings.Slice(text, p, p+8)
	uint64(w[0]) | uint64(w[1])<<8 | uint64(w[2])<<16 | uint64(w[3])<<24 | uint64(w[4])<<32 | uint64(w[5])<<40 | uint64(w[6])<<48 | uint64(w[7])<<56
}

// Lanes marks the bytes of w equal to the byte that rep repeats in every
// lane: the high bit of the lowest marked lane is exact, and a lane above
// a marked one may be marked too.
func Lanes(w uint64, rep uint64) uint64 {
	let x = w ^ rep
	(x - 0x0101010101010101) & ^x & 0x8080808080808080
}

// LowMask keeps the low n bytes of a word.
func LowMask(n int) uint64 { (uint64(1) << (uint(n) * 8)) - 1 }

// Semis is 0x3B, ';', in every lane.
let Semis uint64 = 0x3B3B3B3B3B3B3B3B

// Newlines is 0x0A, '\n', in every lane.
let Newlines uint64 = 0x0A0A0A0A0A0A0A0A

// Temp is a temperature read from the word that starts it, "-?d?d.d\n".
type Temp { Tenths int, Width int, Ok bool }

// ReadTemp reads the temperature at the start of w: its tenths, the width
// of its text before the newline, and whether w holds that form. One
// branch decides the form (Wuerthinger's multiply turns the digits into
// the value).
func ReadTemp(w uint64) Temp {
	let neg = (((w ^ 0x2D) & 0xFF) - 1) >> 63
	let dot = bits.TrailingZeros64(^w&0x10101000) >> 3
	let n = dot + 2
	let dotOk = (w>>(uint(dot)*8))&0xFF == 0x2E
	let nlOk = (w>>(uint(n)*8))&0xFF == 0x0A
	let l = LowMask(n + 1)
	let d = (w & l) ^ (uint64(0x1E) << (uint(dot) * 8)) ^ (neg * 0x1D) ^ (uint64(0x3A) << (uint(n) * 8))
	let digitsOk = d&0xF0F0F0F0F0F0F0F0&l == 0x3030303030303030&l && ((d&0x0F0F0F0F0F0F0F0F&l)+(0x0606060606060606&l))&0x1010101010101010 == 0
	let whole = dot - int(neg)
	let signed = -neg
	let digits = ((w & ^(signed & 0xFF)) << (24 - uint(dot)*8)) & 0x0F000F0F00
	let abs = ((digits * 0x640a0001) >> 32) & 0x3FF
	Temp{Tenths: int((abs ^ signed) - signed), Width: n, Ok: dot <= 3 && dotOk && nlOk && digitsOk && whole >= 1 && whole <= 2}
}

// Words is the first sixteen bytes of the station of n bytes at p, as the
// fast path loads and masks them, read byte by byte.
func Words(text string, p int, n int) (uint64, uint64) {
	let mut w0 uint64 = 0
	let mut w1 uint64 = 0
	for k in 0..lo(n, 16) {
		if k < 8 {
			w0 |= uint64(text[p+k]) << (uint(k) * 8)
		} else {
			w1 |= uint64(text[p+k]) << (uint(k-8) * 8)
		}
	}
	(w0, w1)
}
