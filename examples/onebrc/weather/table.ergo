// A chunk's table: open addressing over the stations of one chunk, keyed
// by a station's first sixteen bytes, its length and, past sixteen bytes,
// its bytes in the text. The key is never copied: a slot keeps where the
// station first appears.

import bits
import fs
import slices

// TableBits is log2 of the slots of a table.
let TableBits = 15

// Slots is the number of slots of a table, at most 61% full at
// MaxStations... and 31% here.
let Slots = 32768

// FastMargin is the room the fast path needs after a line start: a
// station of up to MaxName bytes, its ';' and a word of temperature, read
// at an offset masked to 0..127, so 127+1+8.
let FastMargin = 136

// Slot is one station of a table: its key words, where it first appears
// and its length (0: the slot is free), and its Stats.
type Slot { W0 uint64, W1 uint64, Start int, Len int, Min int, Max int, Sum int, Count int }

// Part is what one chunk sums up to: its stations, or the first malformed
// line of the chunk, or that it holds more than MaxStations stations and
// no malformed line.
type Part = Counted{Slots []Slot, Used []int} | Broken{Fault Malformed} | Crowded{}

// Hash is the slot of a station's key words.
func Hash(w0 uint64, w1 uint64) int {
	int(((w0 ^ w1*0xC2B2AE3D27D4EB4F) * 0x9E3779B97F4A7C15) >> 49)
}

// Scan sums up the lines that start from p up to end. Lines start at p
// and at end.
func Scan(text fs.Text, from int, end int) Part {
	let free = Slot{W0: 0, W1: 0, Start: 0, Len: 0, Min: 0, Max: 0, Sum: 0, Count: 0}
	let mut slots = slices.Repeat([]Slot{free}, Slots)
	let mut used = []int{}
	let mut p = from
	for p < end {
		let mut w0 uint64 = 0
		let mut w1 uint64 = 0
		let mut n = 0
		let mut v = 0
		let mut next = 0
		let mut fast = false
		// The guard proves each cut of the fast path in range (the
		// lowering's bounds facts: no cut ends past p+136), so none is
		// checked again. It is written with len on the right: p+FastMargin
		// could wrap past the largest int, len(text)-FastMargin cannot.
		if 0 <= p && p <= len(text)-FastMargin {
			w0 = Word(text[p : p+8])
			w1 = Word(text[p+8 : p+16])
			let s0 = Lanes(w0, Semis)
			let s1 = Lanes(w1, Semis)
			let mut bad uint64 = 0
			if (s0 | s1) != 0 {
				// A station of up to 15 bytes, with no branch on the word
				// that ends it: z is 1 when the first word has no ';'.
				let z = ((s0 - 1) & ^s0) >> 63
				w0 &= Below(s0)
				w1 &= Below(s1) & -z
				n = (bits.TrailingZeros64(s0) >> 3) + ((bits.TrailingZeros64(s1) >> 3) & -int(z))
				bad = Lanes(w0, Newlines) | Lanes(w1, Newlines)
			} else {
				bad = Lanes(w0, Newlines) | Lanes(w1, Newlines)
				n = 16
				for uint(n) <= uint(MaxName) {
					let w = Word(text[p+n : p+n+8])
					let s = Lanes(w, Semis)
					if s != 0 {
						bad |= Lanes(w&Below(s), Newlines)
						n += bits.TrailingZeros64(s) >> 3
						break
					}
					bad |= Lanes(w, Newlines)
					n += 8
				}
			}
			// The temperature's word, read with no branch: m is n for a
			// station of 1 to MaxName bytes, the only one the fast path
			// keeps, and stays in 0..127 for any other, so the word lies in
			// the guard's margin either way.
			let m = n & 127
			let t = ReadTemp(Word(text[p+m+1 : p+m+9]))
			v = t.Tenths
			next = p + n + t.Width + 2
			fast = (bad|t.Bad) == 0 && uint(n-1) < uint(MaxName)
		}
		if !fast {
			let r = ParseLine(text, p) catch {
			case Malformed as m:
				return Broken{Fault: m}
			}
			n = r.Len
			v = r.Tenths
			next = r.Next
			let (a, b) = Words(text, p, n)
			w0 = a
			w1 = b
		}
		let mut h = Hash(w0, w1)
		for {
			if slots[h].Len == n && slots[h].W0 == w0 && slots[h].W1 == w1 && (n <= 16 || text[slots[h].Start:slots[h].Start+n] == text[p:p+n]) {
				slots[h].Min = lo(slots[h].Min, v)
				slots[h].Max = hi(slots[h].Max, v)
				slots[h].Sum += v
				slots[h].Count += 1
				break
			}
			if slots[h].Len == 0 {
				if len(used) == MaxStations {
					Validate(text, next, end) catch {
					case Malformed as m:
						return Broken{Fault: m}
					}
					return Crowded
				}
				slots[h] = Slot{W0: w0, W1: w1, Start: p, Len: n, Min: v, Max: v, Sum: v, Count: 1}
				used = used.Append(h)
				break
			}
			h = (h + 1) & (Slots - 1)
		}
		p = next
	}
	Counted{Slots: slots, Used: used}
}

// StatsOf is the Stats a slot holds.
func StatsOf(s Slot) Stats { Stats{Min: s.Min, Max: s.Max, Sum: s.Sum, Count: s.Count} }
