// Package mapped is the host's Source provider: a file of the host's
// disk, mapped read-only (fs.MapFile) and copied once into the string the
// Source gives (fs.Clone): a Mapped's text lives only while its Mapped is
// open, and the Source's text outlives the call.

import fs
import kmeans/cluster

// Files reads the host's files. Only New makes one.
type Files { host fs.Host } implements cluster.Source

// New is the provider over the host's files.
func New(host fs.Host) Files { Files{host: host} }

// Text is the whole text of the file at path.
func Text(f Files, path string) string fails cluster.Unreadable {
	let m = fs.MapFile(f.host, path) catch {
	case fs.NotFound:
		return cluster.Unreadable{Path: path, Reason: "no such file"}
	case fs.Denied:
		return cluster.Unreadable{Path: path, Reason: "permission denied"}
	case fs.Failed as e:
		return cluster.Unreadable{Path: path, Reason: e.Reason}
	}
	// The text outlives m, which this call closes: a copy (fs.Clone).
	fs.Clone(m.Text())
}
