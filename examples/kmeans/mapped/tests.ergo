// The test file of package mapped picks the files its law runs read: each
// case of cluster.Source's laws builds onTestHost, Files over the test's
// own folder, so Repeatable runs on the host's files as the binary's Files
// does. The context is unexported, so only the test build's law runs read
// it.

import fs
import fstest
import kmeans/cluster

// onTestHost binds the source to Files over the test's folder.
let onTestHost = context needs fstest.TestAmbient { cluster.Source: New(fs.NewTestHost()) }
