// Package cluster is k-means clustering by Lloyd's algorithm with
// k-means++ seeding, on points of eight integer coordinates. The
// coordinates, the sums and the means are integers, so a sum is the same
// in any grouping and order: the assignment step runs on chunks in
// parallel, and the chunks' Sums merge by an operation whose laws make the
// result the same for every split.

// Dims is the number of coordinates of a point.
let Dims = 8

// MaxCoord is the largest coordinate.
let MaxCoord = 4095

// Point is a point: eight coordinates, 0 to MaxCoord.
type Point [8]int32

// Dist is the squared Euclidean distance of p and q.
func Dist(p Point, q Point) int {
	let d0 = int(p[0]) - int(q[0])
	let d1 = int(p[1]) - int(q[1])
	let d2 = int(p[2]) - int(q[2])
	let d3 = int(p[3]) - int(q[3])
	let d4 = int(p[4]) - int(q[4])
	let d5 = int(p[5]) - int(q[5])
	let d6 = int(p[6]) - int(q[6])
	let d7 = int(p[7]) - int(q[7])
	d0*d0 + d1*d1 + d2*d2 + d3*d3 + d4*d4 + d5*d5 + d6*d6 + d7*d7
}

// Flat is the coordinates of cents in one slice, centroid j's at j*Dims:
// the form Nearest reads, with no copy of a centroid per distance.
func Flat(cents []Point) []int32 {
	let mut flat = []int32{}
	for c in cents {
		for d in 0..Dims {
			flat = flat.Append(c[d])
		}
	}
	flat
}

// Nearest is the index of the centroid nearest to p and its distance: the
// first of equally near ones. flat holds the centroids (Flat), at least
// one. The distance is Dist, written out over the window of eight
// coordinates, so the loop calls nothing.
func Nearest(p Point, flat []int32) (int, int) {
	let mut best = 0
	let mut bestDist = 9223372036854775807
	let k = len(flat) / Dims
	for j in 0..k {
		let c = flat[j*Dims : j*Dims+Dims]
		let d0 = int(p[0]) - int(c[0])
		let d1 = int(p[1]) - int(c[1])
		let d2 = int(p[2]) - int(c[2])
		let d3 = int(p[3]) - int(c[3])
		let d4 = int(p[4]) - int(c[4])
		let d5 = int(p[5]) - int(c[5])
		let d6 = int(p[6]) - int(c[6])
		let d7 = int(p[7]) - int(c[7])
		let d = d0*d0 + d1*d1 + d2*d2 + d3*d3 + d4*d4 + d5*d5 + d6*d6 + d7*d7
		if d < bestDist {
			best = j
			bestDist = d
		}
	}
	(best, bestDist)
}

// NearestIsTheClosest: Nearest's distance is Dist to its centroid, and no
// centroid before it is as near and none after it nearer. Every centroid
// is in the list twice, so each case has a tie to break.
law NearestIsTheClosest(xs []int, ys []int) {
	let p = PointOf(xs)
	let once = pointsOfWindows(ys)
	if len(once) == 0 {
		return true
	}
	let mut cents = once
	for c in once {
		cents = cents.Append(c)
	}
	let (j, d) = Nearest(p, Flat(cents))
	if d != Dist(p, cents[j]) {
		return false
	}
	for i in 0..len(cents) {
		let e = Dist(p, cents[i])
		if (i < j && e <= d) || e < d {
			return false
		}
	}
	true
}

// pointsOfWindows is a point of every window of eight values of xs.
func pointsOfWindows(xs []int) []Point {
	let mut ps = []Point{}
	let mut i = 0
	for i+Dims <= len(xs) {
		ps = ps.Append(PointOf(xs[i:]))
		i += 1
	}
	ps
}

// PointOf is the point of the first eight values of xs, each brought into
// 0..MaxCoord; missing values are 0. Laws build points with it.
func PointOf(xs []int) Point {
	let mut p = Point{}
	for d in 0..Dims {
		if d < len(xs) {
			p[d] = int32((xs[d]%(MaxCoord+1) + MaxCoord + 1) % (MaxCoord + 1))
		}
	}
	p
}
