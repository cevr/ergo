// Screen is the screen a session shows. Home has its own, shorter wait.
type Screen = Home{} | Menu{} | Form{}

// Session is what a user does on the display: the screen, and whether the
// assist mode (larger text, slower pace) is on.
type Session { Screen Screen, Assist bool }

// Display is the machine's state. Each state but Suspended has a timer
// (Timer):
//
//	Suspended  the attract screen; no session
//	Waiting    a session; idle for Wait, then Prompt
//	Prompt     "are you still there?"; Left is the seconds the screen
//	           shows; after PromptFor the session is abandoned
//	Tapping    Taps quick corner taps so far; the window closes after
//	           TapWindow
//	Admin      the admin screen; it closes after AdminFor unused
type Display = Suspended{P Policy} | Waiting{P Policy, S Session} | Prompt{P Policy, S Session, Left int} | Tapping{P Policy, S Session, Taps int} | Admin{P Policy}

// Signal is what the display reads. The first seven come from outside: a
// touch, a screen opened, the assist switch, a tap in the hidden corner,
// the one-second tick of the screen's clock, the user's own finish, and
// leaving the admin screen. The last four are the states' timers; the
// runner sends them, and drops one whose entry has ended.
type Signal = Touch{} | Open{Screen Screen} | Assist{On bool} | CornerTap{} | Tick{} | Finish{} | Leave{} | Idle{} | Expired{} | WindowClosed{} | AdminIdle{}

// Event is what the display tells, each with the Emit of a step.
type Event = Began{} | Abandoned{} | Ended{} | AdminOpened{} | AdminClosed{}

// Begin is the first state of a display with the policy p: the machine's
// start function, so the policy is its input (V4).
func Begin(p Policy) Display { Suspended{P: p} }

// WaitFor is how long a session waits idle before the prompt: the wait of
// its screen, times the assist factor when assist is on.
func WaitFor(p Policy, s Session) duration {
	let base = match s.Screen {
	case Home:
		p.StartWait
	case Menu:
		p.ScreenWait
	case Form:
		p.ScreenWait
	}
	if s.Assist {
		duration(int64(base) * int64(p.AssistFactor))
	} else {
		base
	}
}

// Seconds is d in whole seconds, rounded up.
func Seconds(d duration) int { int((int64(d) + 999999999) / 1000000000) }

// Timer is each state's timer, which the runner arms when the state's
// entry opens and drops when the entry ends. Its wait is computed from
// the state: a session on the home screen waits less than one on another
// screen, and the assist mode waits longer.
func Timer(k Display) Option[Timeout[Signal]] {
	match k {
	case Suspended:
		None
	case Waiting as w:
		Some[Timeout[Signal]]{Value: Timeout[Signal]{In: WaitFor(w.P, w.S), Signal: Idle}}
	case Prompt as p:
		Some[Timeout[Signal]]{Value: Timeout[Signal]{In: p.P.PromptFor, Signal: Expired}}
	case Tapping as t:
		Some[Timeout[Signal]]{Value: Timeout[Signal]{In: t.P.TapWindow, Signal: WindowClosed}}
	case Admin as a:
		Some[Timeout[Signal]]{Value: Timeout[Signal]{In: a.P.AdminFor, Signal: AdminIdle}}
	}
}

// Step is the display's transition. Activity re-enters Waiting, which
// restarts its timer; a Tick in Prompt only stays, so it never moves the
// prompt's deadline; the end of a session Emits its event and moves to
// Suspended. A signal that means nothing in a state is Ignore.
func Step(k Display, s Signal) Decision[Display, Event] {
	match k {
	case Suspended as z:
		suspended(z, s)
	case Waiting as w:
		waiting(w, s)
	case Prompt as p:
		prompting(p, s)
	case Tapping as t:
		tapping(t, s)
	case Admin as a:
		admin(a, s)
	}
}

func enter(k Display) Decision[Display, Event] { Enter[Display]{Next: k} }

func emit(k Display, e Event) Decision[Display, Event] { Emit[Display, Event]{Next: k, Output: e} }

func suspended(z Suspended, s Signal) Decision[Display, Event] {
	let home = Session{Screen: Home, Assist: false}
	match s {
	case Touch:
		emit(Waiting{P: z.P, S: home}, Began)
	case Open as o:
		emit(Waiting{P: z.P, S: Session{Screen: o.Screen, Assist: false}}, Began)
	case Assist as a:
		emit(Waiting{P: z.P, S: Session{Screen: Home, Assist: a.On}}, Began)
	case CornerTap:
		Ignore
	case Tick:
		Ignore
	case Finish:
		Ignore
	case Leave:
		Ignore
	case Idle:
		Ignore
	case Expired:
		Ignore
	case WindowClosed:
		Ignore
	case AdminIdle:
		Ignore
	}
}

func waiting(w Waiting, s Signal) Decision[Display, Event] {
	match s {
	case Touch:
		enter(w)
	case Open as o:
		enter(Waiting{P: w.P, S: Session{..w.S, Screen: o.Screen}})
	case Assist as a:
		enter(Waiting{P: w.P, S: Session{..w.S, Assist: a.On}})
	case CornerTap:
		enter(Tapping{P: w.P, S: w.S, Taps: 1})
	case Tick:
		Ignore
	case Finish:
		emit(Suspended{P: w.P}, Ended)
	case Leave:
		Ignore
	case Idle:
		enter(Prompt{P: w.P, S: w.S, Left: Seconds(w.P.PromptFor)})
	case Expired:
		Ignore
	case WindowClosed:
		Ignore
	case AdminIdle:
		Ignore
	}
}

// prompting: any activity continues the session, and only the prompt's
// own timer abandons it.
func prompting(p Prompt, s Signal) Decision[Display, Event] {
	match s {
	case Touch:
		enter(Waiting{P: p.P, S: p.S})
	case Open as o:
		enter(Waiting{P: p.P, S: Session{..p.S, Screen: o.Screen}})
	case Assist as a:
		enter(Waiting{P: p.P, S: Session{..p.S, Assist: a.On}})
	case CornerTap:
		enter(Waiting{P: p.P, S: p.S})
	case Tick:
		Stay[Display]{Next: Prompt{..p, Left: if p.Left > 0 { p.Left - 1 } else { 0 }}}
	case Finish:
		emit(Suspended{P: p.P}, Ended)
	case Leave:
		Ignore
	case Idle:
		Ignore
	case Expired:
		emit(Suspended{P: p.P}, Abandoned)
	case WindowClosed:
		Ignore
	case AdminIdle:
		Ignore
	}
}

// tapping: each corner tap within the window re-enters Tapping, which
// restarts the window; the fifth opens the admin screen. Any other
// activity, or the window closing, goes back to the session.
func tapping(t Tapping, s Signal) Decision[Display, Event] {
	match s {
	case Touch:
		enter(Waiting{P: t.P, S: t.S})
	case Open as o:
		enter(Waiting{P: t.P, S: Session{..t.S, Screen: o.Screen}})
	case Assist as a:
		enter(Waiting{P: t.P, S: Session{..t.S, Assist: a.On}})
	case CornerTap:
		if t.Taps+1 >= AdminTaps {
			emit(Admin{P: t.P}, AdminOpened)
		} else {
			enter(Tapping{..t, Taps: t.Taps + 1})
		}
	case Tick:
		Ignore
	case Finish:
		emit(Suspended{P: t.P}, Ended)
	case Leave:
		Ignore
	case Idle:
		Ignore
	case Expired:
		Ignore
	case WindowClosed:
		enter(Waiting{P: t.P, S: t.S})
	case AdminIdle:
		Ignore
	}
}

// admin: a touch keeps the admin screen open; leaving it, or leaving it
// unused, closes it and ends the session.
func admin(a Admin, s Signal) Decision[Display, Event] {
	match s {
	case Touch:
		enter(a)
	case Open:
		enter(a)
	case Assist:
		Ignore
	case CornerTap:
		Ignore
	case Tick:
		Ignore
	case Finish:
		Ignore
	case Leave:
		emit(Suspended{P: a.P}, AdminClosed)
	case Idle:
		Ignore
	case Expired:
		Ignore
	case WindowClosed:
		Ignore
	case AdminIdle:
		emit(Suspended{P: a.P}, AdminClosed)
	}
}

// Name is the word of a state, for the screen and the laws.
func Name(k Display) string {
	match k {
	case Suspended:
		"suspended"
	case Waiting:
		"waiting"
	case Prompt as p:
		"prompt \(p.Left)"
	case Tapping as t:
		"tapping \(t.Taps)"
	case Admin:
		"admin"
	}
}
