// Package kiosk is a shared screen that ends a session nobody uses any
// more, as a machine whose timers the runner owns: a wait that depends on
// the state, a prompt with its own deadline, and a window for a hidden
// admin gesture. It is pure: no function needs a capability.

// Policy is how long a kiosk waits: the input of its machine.
type Policy {
	// StartWait is the wait on the home screen, ScreenWait on any other.
	StartWait  duration,
	ScreenWait duration,
	// AssistFactor multiplies the wait while the assist mode is on.
	AssistFactor int,
	// PromptFor is how long the "are you still there?" prompt shows.
	PromptFor duration,
	// TapWindow is how soon a corner tap must follow the last one to count
	// toward the admin gesture, and AdminFor how long an unused admin
	// screen stays.
	TapWindow duration,
	AdminFor  duration,
}

// AdminTaps is how many quick corner taps open the admin screen.
let AdminTaps = 5

// Standard is the policy of the machine in the laws and the sample kiosk.
func Standard() Policy {
	Policy{StartWait: 30s, ScreenWait: 60s, AssistFactor: 2, PromptFor: 10s, TapWindow: 600ms, AdminFor: 120s}
}

// BadPolicy is a policy a kiosk cannot run: every wait is positive, since
// a timer that is not positive fires at once, and a state whose timer
// re-enters it at once never lets time pass (runtime.md, Machines 9.1);
// the factor is at least 1 and the prompt shows at least one second.
type BadPolicy { Why string }

// Check is p, or BadPolicy. A machine's start function has no failure row
// (V4), so a program checks the policy before it starts the machine.
func Check(p Policy) Policy fails BadPolicy {
	if p.StartWait <= 0s || p.ScreenWait <= 0s || p.TapWindow <= 0s || p.AdminFor <= 0s {
		return BadPolicy{Why: "every wait is positive"}
	}
	if p.PromptFor < 1s {
		return BadPolicy{Why: "the prompt shows at least 1s"}
	}
	if p.AssistFactor < 1 {
		return BadPolicy{Why: "the assist factor is at least 1"}
	}
	p
}
