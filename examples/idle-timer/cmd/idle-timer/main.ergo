// idle-timer is a shared screen that ends a session nobody uses any more.
// It runs a script of timed touches on a virtual clock and shows what the
// display does. Package display is the machine, whose timers the runner owns;
// package script reads the script and runs it with machines.RunTimed;
// package memory holds the displays' policies. This binary is the only place
// that chooses them: Live binds display.Policies to memory's fixed
// policies, io to the host, and the clock to a testing.VirtualClock, so
// the replay of a script of hours takes no wall time.

import idletimer/display
import idletimer/memory
import idletimer/script
import io
import os
import testing
import time

let Live = context { display.Policies: memory.Fixed }

func main() fails os.Exit needs Console | Ambient {
	let c = testing.NewVirtualClock(0)
	let status = with Live {
		with context { io.Stdin: io.NewStdin(), time.Clock: c, Scheduler: c } {
			script.Run()
		}
	}
	if status != 0 {
		let code = os.ParseCode(status) catch {
		case Unsatisfied:
			Unreachable("timer script returned an invalid failure status")
		}
		return os.Exit{Code: code, Message: "idle-timer: the script did not run"}
	}
}
