// Package script runs the display over a script of timed lines on the
// time.Clock and Scheduler of its context (main binds a virtual clock),
// and shows what it does second by second.

import idletimer/display
import io
import machines
import strconv
import strings
import time

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Script is a read script: the signals at their times, and the time the
// run ends.
type Script { Trace []machines.Timed[display.Signal], End duration }

// Read reads the lines of a script after its first line. Each line is
// `@MS WORD …`: MS is the time in milliseconds from the start, never
// earlier than the line before, and WORD is touch, open home|menu|form,
// assist on|off, tap, finish, leave or end. The line `@MS end` ends the
// run at MS, and must be the last. A blank line or a line that starts
// with # is skipped.
func Read(lines []string) Script fails BadLine {
	let mut trace = []machines.Timed[display.Signal]{}
	let mut last = 0s
	for i, line in lines {
		let n = i + 2
		let text = strings.TrimSpace(line)
		let words = strings.Fields(text)
		if len(words) == 0 || strings.HasPrefix(text, "#") {
			continue
		}
		if len(words) < 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD"}
		}
		let t = try millis(n, strings.TrimPrefix(words[0], "@"))
		if t < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = t
		if words[1] == "end" {
			return Script{Trace: trace, End: t}
		}
		let s = try signalOf(n, words)
		trace = trace.Append(machines.Timed[display.Signal]{At: t, Signal: s})
	}
	BadLine{Line: len(lines) + 1, Why: "the script has no @MS end line"}
}

func millis(n int, word string) duration fails BadLine {
	let v = strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number of milliseconds"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "a time is 0 to 86400000 milliseconds"}
	}
	duration(int64(v) * 1000000)
}

func signalOf(n int, words []string) display.Signal fails BadLine {
	let arg = if len(words) > 2 { words[2] } else { "" }
	match words[1] {
	case "touch":
		display.Touch
	case "tap":
		display.CornerTap
	case "finish":
		display.Finish
	case "leave":
		display.Leave
	case "assist":
		match arg {
		case "on":
			display.Assist{On: true}
		case "off":
			display.Assist{On: false}
		case _:
			BadLine{Line: n, Why: "assist is on or off"}
		}
	case "open":
		match arg {
		case "home":
			display.Open{Screen: display.Home}
		case "menu":
			display.Open{Screen: display.Menu}
		case "form":
			display.Open{Screen: display.Form}
		case _:
			BadLine{Line: n, Why: "open takes home, menu or form"}
		}
	case _:
		BadLine{Line: n, Why: "unknown word \(words[1])"}
	}
}

// WithTicks is the trace with the screen clock's Tick at every whole
// second from 1s to end, each after the script's signals of that instant.
// The live runner would take ticks from a task that sleeps (M45); on the
// virtual clock they are signals of the trace.
func WithTicks(s Script) []machines.Timed[display.Signal] {
	let mut out = []machines.Timed[display.Signal]{}
	let mut i = 0
	let mut t = 1s
	for t <= s.End {
		for i < len(s.Trace) && s.Trace[i].At <= t {
			out = out.Append(s.Trace[i])
			i = i + 1
		}
		out = out.Append(machines.Timed[display.Signal]{At: t, Signal: display.Tick})
		t = t + 1s
	}
	for i < len(s.Trace) {
		out = out.Append(s.Trace[i])
		i = i + 1
	}
	out
}

// View is the state and the events of a run of the display.
type View { State display.Display, Told []display.Event }

// Upto is the run of m over the first n signals of trace, until end.
func Upto(m Machine[display.Display, display.Signal, display.Event], trace []machines.Timed[display.Signal], n int, end duration) View needs time.Clock | Scheduler {
	let mut part = []machines.Timed[display.Signal]{}
	for i, x in trace {
		if i < n {
			part = part.Append(x)
		}
	}
	let o = machines.RunTimed(m, part, end) catch {
	case machines.Rejected:
		return View{State: m.Initial, Told: []display.Event{}}
	}
	match o {
	case machines.Running[display.Display, display.Event] as r:
		View{State: r.State, Told: r.Emitted}
	case machines.Finished[display.Display, display.Event] as f:
		View{State: f.State, Told: f.Emitted}
	}
}

// Run reads the script from io.Stdin: its first line is `display NAME`,
// the policy of display.Policies to run, the machine's input. It shows each
// change of state and each event, at the time of the signal it follows,
// and returns the exit status: 0, or 1 when the script or the policy is
// refused.
func Run() int needs Console | io.Stdin | display.Policies | time.Clock | Scheduler {
	let mut lines = []string{}
	for line in io.Stdin.Lines() {
		lines = lines.Append(line)
	}
	if len(lines) == 0 {
		Console.Println("? the script names no display")
		return 1
	}
	let first = strings.Fields(lines[0])
	if len(first) != 2 || first[0] != "display" {
		Console.Println("? line 1: the first line is display NAME")
		return 1
	}
	let p = display.Policies.Policy(first[1]) catch {
	case display.NoSuchDisplay as n:
		Console.Println("? no display \(n.Name)")
		return 1
	}
	let policy = display.Check(p) catch {
	case display.BadPolicy as b:
		Console.Println("? display \(first[1]): \(b.Why)")
		return 1
	}
	let mut rest = []string{}
	for i, l in lines {
		if i > 0 {
			rest = rest.Append(l)
		}
	}
	let s = Read(rest) catch {
	case BadLine as b:
		Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let m = machines.Start(display.Idler{}, policy)
	let trace = WithTicks(s)
	Console.Println("@0 \(display.Name(m.Initial))")
	let mut shown = View{State: m.Initial, Told: []display.Event{}}
	for n in 1..len(trace)+1 {
		let t = trace[n-1].At
		let v = Upto(m, trace, n, t)
		show(t, shown, v)
		shown = v
	}
	show(s.End, shown, Upto(m, trace, len(trace), s.End))
	0
}

// show prints what changed from was to now, at the time t.
func show(t duration, was View, now View) needs Console {
	let stamp = "@\(int64(t) / 1000000)"
	for i, e in now.Told {
		if i >= len(was.Told) {
			Console.Println("\(stamp) ! \(Word(e))")
		}
	}
	if display.Name(now.State) != display.Name(was.State) {
		Console.Println("\(stamp) \(display.Name(now.State))")
	}
}

// Word is the word of an event.
func Word(e display.Event) string {
	match e {
	case display.Began:
		"began"
	case display.Abandoned:
		"abandoned"
	case display.Ended:
		"ended"
	case display.AdminOpened:
		"admin opened"
	case display.AdminClosed:
		"admin closed"
	}
}
