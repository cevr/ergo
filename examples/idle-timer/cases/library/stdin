kiosk library
@0 touch
# a touch at the very instant the home wait ends is stepped first:
# the old timer's entry has ended, so it is dropped and no prompt shows
@45000 touch
@90000 touch
@90000 assist on
# assist triples the 45s home wait: the prompt at 225s, 15s long
@230000 tap
# a tap on the prompt is activity: back to waiting, with a new wait
@300000 end
