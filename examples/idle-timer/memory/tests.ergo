// ergo test runs the display.Policies laws here, against Fixed; these two
// tests call the laws' functions again on the program's own table.

import idletimer/display

test FixedPoliciesCheck {
	with context { display.Policies: Fixed } {
		assert display.EveryPolicyChecks()
	}
}

test FixedUnlistedIsNoSuchDisplay(name string) {
	with context { display.Policies: Fixed } {
		assert display.UnlistedIsNoSuchDisplay(name)
	}
}
