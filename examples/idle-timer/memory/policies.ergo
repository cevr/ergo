// Package memory holds the in-memory providers of the display contracts.

import idletimer/display

// Fixed is a display.Policies of two fixed displays: the lobby, with the
// standard waits, and the library, which waits longer.
type Fixed {}

func Names(_ Fixed) []string { []string{"lobby", "library"} }

func Policy(_ Fixed, name string) display.Policy fails display.NoSuchDisplay {
	match name {
	case "lobby":
		display.Standard()
	case "library":
		display.Policy{StartWait: 45s, ScreenWait: 90s, AssistFactor: 3, PromptFor: 15s, TapWindow: 600ms, AdminFor: 60s}
	case _:
		display.NoSuchDisplay{Name: name}
	}
}
