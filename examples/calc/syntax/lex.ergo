// Package syntax reads the text of calc into an ast.Expr: Lex cuts it
// into tokens and Parse builds the tree by precedence climbing. Each
// failure names the column where it is, from 1.

import calc/ast
import slices
import strings
import utf8

// Token is a word of the source and its column.
type Token = IntTok{Text string, At int} | NameTok{Name string, At int} | SymTok{Sym string, At int} | EndTok{At int}

// BadChar is a character that starts no token.
type BadChar { At int, Char string }

// symbols are the tokens of two characters, then of one.
let pairs = []string{"==", "&&", "||"}
let singles = []string{"+", "-", "*", "/", "%", "<", "!", "(", ")", "="}

// Lex is the tokens of src, ended by EndTok. Spaces and tabs separate
// tokens. A number is a run of digits; a minus before it is a token of
// its own, which Parse joins to it.
func Lex(src string) []Token fails BadChar {
	let mut toks = []Token{}
	let mut i = 0
	for i < len(src) {
		let c = src[i]
		if c == ' ' || c == '\t' {
			i += 1
			continue
		}
		let start = i
		if ast.IsDigit(c) {
			for i < len(src) && ast.IsDigit(src[i]) {
				i += 1
			}
			toks = toks.Append(IntTok{Text: strings.Slice(src, start, i), At: start + 1})
			continue
		}
		if ast.IsLetter(c) {
			for i < len(src) && (ast.IsLetter(src[i]) || ast.IsDigit(src[i])) {
				i += 1
			}
			toks = toks.Append(NameTok{Name: strings.Slice(src, start, i), At: start + 1})
			continue
		}
		let sym = symbolAt(src, i)
		if sym == "" {
			// The character is its whole UTF-8 sequence, or one invalid byte.
			let size = utf8.DecodeRuneInString(strings.Slice(src, i, len(src))).Size
			return BadChar{At: start + 1, Char: strings.Slice(src, i, i+size)}
		}
		toks = toks.Append(SymTok{Sym: sym, At: start + 1})
		i += len(sym)
	}
	toks.Append(EndTok{At: len(src) + 1})
}

// symbolAt is the symbol that starts at byte i of src, or "".
func symbolAt(src string, i int) string {
	if i+2 <= len(src) {
		let two = strings.Slice(src, i, i+2)
		if slices.Contains(pairs, two) {
			return two
		}
	}
	let one = strings.Slice(src, i, i+1)
	if slices.Contains(singles, one) {
		return one
	}
	""
}

// At is the column of t.
func At(t Token) int {
	match t {
	case IntTok as n:
		n.At
	case NameTok as n:
		n.At
	case SymTok as s:
		s.At
	case EndTok as e:
		e.At
	}
}

// Describe is how an error names t.
func Describe(t Token) string {
	match t {
	case IntTok as n:
		"\"\(n.Text)\""
	case NameTok as n:
		"\"\(n.Name)\""
	case SymTok as s:
		"\"\(s.Sym)\""
	case EndTok:
		"the end"
	}
}
