// The rules of calc's text as laws.

import calc/ast

// RoundTrip: the text of an expression reads back as the expression,
// when its names are variable names: for e and the samples of seed,
// whose names are.
law RoundTrip(e ast.Expr, seed int) {
	for x in ast.Samples(e, seed) {
		if !ast.Valid(x) {
			continue
		}
		let back = Parse(ast.Print(x)) catch {
		case Failure:
			return false
		}
		if back != x {
			return false
		}
	}
	true
}

// ColumnsIncrease: the tokens of a text stand in order, each after the
// one before it, and the end after them all.
law ColumnsIncrease(src string) {
	let toks = Lex(src) catch {
	case BadChar:
		return true
	}
	let mut last = 0
	for t in toks {
		if At(t) <= last {
			return false
		}
		last = At(t)
	}
	last == len(src)+1
}
