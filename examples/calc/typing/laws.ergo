// The rule that ties the checker to the evaluator.

import calc/ast
import calc/eval

// Sound: a well-typed expression does not get stuck. It ends in a value
// of its type, or in a division by zero, which no type rules out. It
// holds for e and the samples of seed, half of them well-typed.
law Sound(e ast.Expr, seed int) {
	for x in ast.Samples(e, seed) {
		let t = Check(x) catch {
		case Failure:
			continue
		}
		let v = eval.Eval(x) catch {
		case eval.DivByZero:
			continue
		case eval.Stuck, eval.Unset:
			return false
		}
		if eval.TypeOf(v) != t {
			return false
		}
	}
	true
}
