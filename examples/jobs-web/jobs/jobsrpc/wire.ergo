import rpc
import jobsweb/jobs
import jobsweb/jobs/jobsapi

// Request is one call of jobs.Jobs: the hub's Request, a variant per
// operation whose fields are the operation's parameters, so its payload is
// the variant's JSON. Each variant is named here too.
type Request = jobsapi.Request

type SubmitRequest = jobsapi.SubmitRequest

type CancelRequest = jobsapi.CancelRequest

type StatusRequest = jobsapi.StatusRequest

type ListRequest = jobsapi.ListRequest

type WorkRequest = jobsapi.WorkRequest

func exactSubmitRequest(v SubmitRequest) fails rpc.Unrepresentable {
	exactJobsSpec(v.Spec) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("spec", u)
	}
}

func exactCancelRequest(v CancelRequest) fails rpc.Unrepresentable {
	exactInt(v.Id) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("id", u)
	}
}

func exactStatusRequest(v StatusRequest) fails rpc.Unrepresentable {
	exactInt(v.Id) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("id", u)
	}
}

func exactWorkRequest(v WorkRequest) fails rpc.Unrepresentable {
	exactInt(v.Ticks) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("ticks", u)
	}
}

func exactJobsSpec(v jobs.Spec) fails rpc.Unrepresentable {
	exactInt(v.Steps) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("steps", u)
	}
	exactInt(v.FailAt) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("failAt", u)
	}
}

func exactInt(v int) fails rpc.Unrepresentable {
	try rpc.Exact("", int64(v))
}

func exactJobsNoSuchJob(v jobs.NoSuchJob) fails rpc.Unrepresentable {
	exactInt(v.ID) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("id", u)
	}
}

func exactJobsAlreadyDone(v jobs.AlreadyDone) fails rpc.Unrepresentable {
	exactInt(v.ID) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("id", u)
	}
	exactJobsState(v.State) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("state", u)
	}
}

func exactJobsState(v jobs.State) fails rpc.Unrepresentable {
	match v {
	case jobs.Queued:
	case jobs.Running as x:
		exactInt(x.Step) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("step", u)
		}
		exactInt(x.Of) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("of", u)
		}
	case jobs.Finished:
	case jobs.Failed:
	case jobs.Cancelled:
	}
}

func exactOptionJobsJob(v Option[jobs.Job]) fails rpc.Unrepresentable {
	match v {
	case Some[jobs.Job] as x:
		exactJobsJob(x.Value) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("value", u)
		}
	case None:
	}
}

func exactJobsJob(v jobs.Job) fails rpc.Unrepresentable {
	exactInt(v.ID) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("id", u)
	}
	exactJobsState(v.State) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("state", u)
	}
}

func exactSliceJobsJob(v []jobs.Job) fails rpc.Unrepresentable {
	for i, x in v {
		exactJobsJob(x) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("\(i)", u)
		}
	}
}
