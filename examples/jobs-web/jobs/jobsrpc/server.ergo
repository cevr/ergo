import api
import rpc
import jobsweb/jobs
import jobsweb/jobs/jobsapi

// Handle runs one call of jobs.Jobs on the provider the caller binds,
// through the hub's Call: tag names the operation and payload is its
// Request's JSON. Its value is the result's JSON; a typed failure is
// Failed with the failure's tagged JSON. A request the contract does not
// hold and an int the wire cannot carry are defects, which the server
// answers as Die.
func Handle(tag string, payload string) string fails rpc.Failed needs jobs.Jobs {
	try handle(tag, payload, jobsapi.Call)
}

func handle[R](tag string, payload string, answer func(r Request) jobsapi.Outcome needs R) string fails rpc.Failed needs R {
	let req = rpc.Decode[Request]("request", rpc.Tagged(tag+"Request", payload)) catch {
	case rpc.Transport as t:
		return rpc.Die[string]("RpcError", t.Reason)
	}
	match req {
	case SubmitRequest as r:
		exactSubmitRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case CancelRequest as r:
		exactCancelRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case StatusRequest as r:
		exactStatusRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case WorkRequest as r:
		exactWorkRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case _:
	}
	match answer(req) {
	case jobsapi.Done as done:
		match done.Reply {
		case jobsapi.SubmitReply as reply:
			let v = reply.Value
			exactInt(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case jobsapi.CancelReply:
			"null"
		case jobsapi.StatusReply as reply:
			let v = reply.Value
			exactOptionJobsJob(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case jobsapi.ListReply as reply:
			let v = reply.Value
			exactSliceJobsJob(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case jobsapi.WorkReply:
			"null"
		}
	case jobsapi.Rejected as rejected:
		match rejected.Failure {
		case jobsapi.RejectedFailure as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("Rejected", rpc.Encode(e))}
		case jobsapi.NoSuchJob as failure:
			let e = failure.E
			exactJobsNoSuchJob(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("NoSuchJob", rpc.Encode(e))}
		case jobsapi.AlreadyDone as failure:
			let e = failure.E
			exactJobsAlreadyDone(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("AlreadyDone", rpc.Encode(e))}
		}
	}
}

func carry(c Request, answer own func(c Request) jobsapi.Outcome) jobsapi.Outcome {
	let client = NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		try handle(tag, payload, answer)
	}))
	with context { jobs.Jobs: client } { jobsapi.Call(c) }
}

// Wire is Effect RPC as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, jobsapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) jobsapi.Outcome) jobsapi.Outcome { carry(c, answer) }

// Fits reports whether r and o hold only ints the wire carries exactly
// (an int beyond 2^53-1 is Unrepresentable, a defect on either side).
func Fits(r Request, o jobsapi.Outcome) bool {
	match r {
	case jobsapi.SubmitRequest as x:
		exactSubmitRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case jobsapi.CancelRequest as x:
		exactCancelRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case jobsapi.StatusRequest as x:
		exactStatusRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case jobsapi.WorkRequest as x:
		exactWorkRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case _:
	}
	match o {
	case jobsapi.Done as done:
		match done.Reply {
		case jobsapi.SubmitReply as reply:
			exactInt(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case jobsapi.CancelReply:
		case jobsapi.StatusReply as reply:
			exactOptionJobsJob(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case jobsapi.ListReply as reply:
			exactSliceJobsJob(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case jobsapi.WorkReply:
		}
	case jobsapi.Rejected as rejected:
		match rejected.Failure {
		case jobsapi.RejectedFailure:
		case jobsapi.NoSuchJob as failure:
			exactJobsNoSuchJob(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		case jobsapi.AlreadyDone as failure:
			exactJobsAlreadyDone(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		}
	}
	true
}

// Agrees: the wire carries every call and every outcome the call can
// have unchanged, when they hold only ints it carries exactly (Fits).
law Agrees(r Request, g jobsapi.Given) {
	let o = jobsapi.OutcomeOf(r, g)
	!Fits(r, o) || api.Agrees(Wire, r, o)
}
