import json
import rpc
import sync
import jobsweb/jobs

// Request is one call of jobs.Jobs: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = SubmitRequest{Spec jobs.Spec} | CancelRequest{Id int} | StatusRequest{Id int} | ListRequest{} | WorkRequest{Ticks int}

// Op is an operation of jobs.Jobs: what a policy matches on.
type Op = SubmitOp{} | CancelOp{} | StatusOp{} | ListOp{} | WorkOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = SubmitReply{Value int} | CancelReply{} | StatusReply{Value Option[jobs.Job]} | ListReply{Value []jobs.Job} | WorkReply{}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = RejectedFailure{E jobs.Rejected} | NoSuchJob{E jobs.NoSuchJob} | AlreadyDone{E jobs.AlreadyDone}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case SubmitRequest:
		SubmitOp
	case CancelRequest:
		CancelOp
	case StatusRequest:
		StatusOp
	case ListRequest:
		ListOp
	case WorkRequest:
		WorkOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case SubmitOp:
		"submit"
	case CancelOp:
		"cancel"
	case StatusOp:
		"status"
	case ListOp:
		"list"
	case WorkOp:
		"work"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case SubmitOp:
		"Submit(spec jobs.Spec) int fails jobs.Rejected"
	case CancelOp:
		"Cancel(id int) fails jobs.NoSuchJob | jobs.AlreadyDone"
	case StatusOp:
		"Status(id int) Option[jobs.Job]"
	case ListOp:
		"List() []jobs.Job"
	case WorkOp:
		"Work(ticks int)"
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case SubmitOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"steps\":{\"type\":\"integer\"},\"failAt\":{\"type\":\"integer\"}},\"required\":[\"name\",\"steps\",\"failAt\"]}")
	case CancelOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"}},\"required\":[\"id\"]}")
	case StatusOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\"}},\"required\":[\"id\"]}")
	case ListOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case WorkOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"ticks\":{\"type\":\"integer\"}},\"required\":[\"ticks\"]}")
	}
}

// Call answers r on the bound jobs.Jobs: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs jobs.Jobs {
	match r {
	case SubmitRequest as x:
		let v = jobs.Jobs.Submit(x.Spec) catch {
		case jobs.Rejected as e:
			return Rejected{Failure: RejectedFailure{E: e}}
		}
		Done{Reply: SubmitReply{Value: v}}
	case CancelRequest as x:
		jobs.Jobs.Cancel(x.Id) catch {
		case jobs.NoSuchJob as e:
			return Rejected{Failure: NoSuchJob{E: e}}
		case jobs.AlreadyDone as e:
			return Rejected{Failure: AlreadyDone{E: e}}
		}
		Done{Reply: CancelReply}
	case StatusRequest as x:
		let v = jobs.Jobs.Status(x.Id)
		Done{Reply: StatusReply{Value: v}}
	case ListRequest:
		let v = jobs.Jobs.List()
		Done{Reply: ListReply{Value: v}}
	case WorkRequest as x:
		jobs.Jobs.Work(x.Ticks)
		Done{Reply: WorkReply}
	}
}

// Client provides jobs.Jobs by invoking inner directly per operation: a direct
// call returns its exact value or declared failure row with no Outcome boxing.
type Client { inner jobs.Jobs } implements jobs.Jobs

// NewClient is the jobs.Jobs that invokes inner directly per operation.
func NewClient(inner jobs.Jobs) Client { Client{inner: inner} }

// Submit invokes jobs.Jobs's Submit directly.
func Submit(client Client, spec jobs.Spec) int fails jobs.Rejected {
	try client.inner.Submit(spec)
}

// Cancel invokes jobs.Jobs's Cancel directly.
func Cancel(client Client, id int) fails jobs.NoSuchJob | jobs.AlreadyDone {
	try client.inner.Cancel(id)
}

// Status invokes jobs.Jobs's Status directly.
func Status(client Client, id int) Option[jobs.Job] {
	client.inner.Status(id)
}

// List invokes jobs.Jobs's List directly.
func List(client Client) []jobs.Job {
	client.inner.List()
}

// Work invokes jobs.Jobs's Work directly.
func Work(client Client, ticks int) {
	client.inner.Work(ticks)
}

// BoundClient provides jobs.Jobs over a held Context captured by ClientInForce.
type BoundClient { held Context[jobs.Jobs] } implements jobs.Jobs

// ClientInForce is the jobs.Jobs that invokes the provider currently in force.
func ClientInForce() BoundClient needs jobs.Jobs { BoundClient{held: InForce[jobs.Jobs]()} }

// Submit invokes jobs.Jobs's Submit on the held context.
func Submit(client BoundClient, spec jobs.Spec) int fails jobs.Rejected {
	with client.held { try jobs.Jobs.Submit(spec) }
}

// Cancel invokes jobs.Jobs's Cancel on the held context.
func Cancel(client BoundClient, id int) fails jobs.NoSuchJob | jobs.AlreadyDone {
	with client.held { try jobs.Jobs.Cancel(id) }
}

// Status invokes jobs.Jobs's Status on the held context.
func Status(client BoundClient, id int) Option[jobs.Job] {
	with client.held { jobs.Jobs.Status(id) }
}

// List invokes jobs.Jobs's List on the held context.
func List(client BoundClient) []jobs.Job {
	with client.held { jobs.Jobs.List() }
}

// Work invokes jobs.Jobs's Work on the held context.
func Work(client BoundClient, ticks int) {
	with client.held { jobs.Jobs.Work(ticks) }
}

// CheckedClient carries erased jobs.Jobs requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// SubmitChecked sends jobs.Jobs's Submit over send and validates its Outcome.
func SubmitChecked(client CheckedClient, spec jobs.Spec) int fails jobs.Rejected | rpc.Transport {
	match try client.send(SubmitRequest{Spec: spec}) {
	case Done as done:
		match done.Reply {
		case SubmitReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "jobsapi: Submit was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case RejectedFailure as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "jobsapi: Submit was answered with a failure outside its row"}
		}
	}
}

// CancelChecked sends jobs.Jobs's Cancel over send and validates its Outcome.
func CancelChecked(client CheckedClient, id int) fails jobs.NoSuchJob | jobs.AlreadyDone | rpc.Transport {
	match try client.send(CancelRequest{Id: id}) {
	case Done as done:
		match done.Reply {
		case CancelReply:
		case _:
			return rpc.Transport{Reason: "jobsapi: Cancel was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NoSuchJob as failure:
			return failure.E
		case AlreadyDone as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "jobsapi: Cancel was answered with a failure outside its row"}
		}
	}
}

// StatusChecked sends jobs.Jobs's Status over send and validates its Outcome.
func StatusChecked(client CheckedClient, id int) Option[jobs.Job] fails rpc.Transport {
	match try client.send(StatusRequest{Id: id}) {
	case Done as done:
		match done.Reply {
		case StatusReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "jobsapi: Status was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "jobsapi: Status was answered with a failure outside its row"}
	}
}

// ListChecked sends jobs.Jobs's List over send and validates its Outcome.
func ListChecked(client CheckedClient) []jobs.Job fails rpc.Transport {
	match try client.send(ListRequest) {
	case Done as done:
		match done.Reply {
		case ListReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "jobsapi: List was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "jobsapi: List was answered with a failure outside its row"}
	}
}

// WorkChecked sends jobs.Jobs's Work over send and validates its Outcome.
func WorkChecked(client CheckedClient, ticks int) fails rpc.Transport {
	match try client.send(WorkRequest{Ticks: ticks}) {
	case Done as done:
		match done.Reply {
		case WorkReply:
		case _:
			return rpc.Transport{Reason: "jobsapi: Work was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "jobsapi: Work was answered with a failure outside its row"}
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Submit int, Status Option[jobs.Job], List []jobs.Job }

func inRow(op Op, f Failure) bool {
	match op {
	case SubmitOp:
		match f {
		case RejectedFailure:
			true
		case _:
			false
		}
	case CancelOp:
		match f {
		case NoSuchJob, AlreadyDone:
			true
		case _:
			false
		}
	case StatusOp, ListOp, WorkOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case SubmitRequest:
		Done{Reply: SubmitReply{Value: g.Values.Submit}}
	case CancelRequest:
		Done{Reply: CancelReply}
	case StatusRequest:
		Done{Reply: StatusReply{Value: g.Values.Status}}
	case ListRequest:
		Done{Reply: ListReply{Value: g.Values.List}}
	case WorkRequest:
		Done{Reply: WorkReply}
	}
}

type scripted { g Given, sent sync.Ref[[]Request] } implements jobs.Jobs

func Submit(client scripted, spec jobs.Spec) int fails jobs.Rejected {
	client.sent.Update(func(rs []Request) []Request { rs.Append(SubmitRequest{Spec: spec}) })
	if client.g.Failing {
		match client.g.Failure {
		case RejectedFailure as err:
			return err.E
		case _:
		}
	}
	client.g.Values.Submit
}

func Cancel(client scripted, id int) fails jobs.NoSuchJob | jobs.AlreadyDone {
	client.sent.Update(func(rs []Request) []Request { rs.Append(CancelRequest{Id: id}) })
	if client.g.Failing {
		match client.g.Failure {
		case NoSuchJob as err:
			return err.E
		case AlreadyDone as err:
			return err.E
		case _:
		}
	}
}

func Status(client scripted, id int) Option[jobs.Job] {
	client.sent.Update(func(rs []Request) []Request { rs.Append(StatusRequest{Id: id}) })
	client.g.Values.Status
}

func List(client scripted) []jobs.Job {
	client.sent.Update(func(rs []Request) []Request { rs.Append(ListRequest) })
	client.g.Values.List
}

func Work(client scripted, ticks int) {
	client.sent.Update(func(rs []Request) []Request { rs.Append(WorkRequest{Ticks: ticks}) })
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case SubmitRequest as x:
		let v = SubmitChecked(client, x.Spec) catch {
		case jobs.Rejected as e:
			return Rejected{Failure: RejectedFailure{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: SubmitReply{Value: v}}
	case CancelRequest as x:
		CancelChecked(client, x.Id) catch {
		case jobs.NoSuchJob as e:
			return Rejected{Failure: NoSuchJob{E: e}}
		case jobs.AlreadyDone as e:
			return Rejected{Failure: AlreadyDone{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: CancelReply}
	case StatusRequest as x:
		let v = StatusChecked(client, x.Id) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: StatusReply{Value: v}}
	case ListRequest:
		let v = ListChecked(client) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: ListReply{Value: v}}
	case WorkRequest as x:
		WorkChecked(client, x.Ticks) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: WorkReply}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { jobs.Jobs: scripted{g: g, sent: sent} } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted{g: g, sent: sent}
	let outer = NewClient(inner)
	let got = with context { jobs.Jobs: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted{g: g, sent: sentChecked}
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { jobs.Jobs: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
