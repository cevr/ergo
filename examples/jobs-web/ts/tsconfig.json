{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "contentMappers": [{ "package": "ergo-ts", "extensions": [".ergo"] }],
  "include": ["jobs.ts", "app.ts"]
}
