// Package loopback builds the generated clients of a job server its caller
// passes in, served in this process: NewLoopback's RPC Client crosses
// Effect RPC's HTTP wire and the contract's codecs both ways
// (rpc.Loopback), and NewHub's hub Client carries each Request to a Call
// on it. The package picks no server. Its tests (tests.ergo) pass a memory
// server and hold the jobs.Jobs laws on both clients, as the memory
// package holds them directly.

import jobsweb/jobs
import jobsweb/jobs/jobsapi
import jobsweb/jobs/jobsrpc
import rpc

// NewLoopback serves inner in process and is its RPC client. The server
// binds inner for each call, so every call reaches the same jobs when the
// copies of inner share their state (a memory.Memory's do).
func NewLoopback(inner jobs.Jobs) jobsrpc.Client {
	jobsrpc.NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		with context { jobs.Jobs: inner } {
			try jobsrpc.Handle(tag, payload)
		}
	}))
}

// NewHub is the hub client of inner: each Request is a Call with inner
// bound, so its laws hold exactly when inner's and Call's do.
func NewHub(inner jobs.Jobs) jobsapi.Client {
	jobsapi.NewClient(inner)
}
