// stopwatch is a stopwatch program (stage a: the
// model, with no view). It runs a script of timed button presses on a
// virtual clock and shows the watch after each press. Package watch is the
// machine, whose Running state owns the tick; package script reads the
// script. This binary is the only place that chooses the clock: a
// testing.VirtualClock, so a script of an hour takes no wall time.

import stopwatch/script
import io
import os
import time

func main() fails os.Exit needs io.Console | os.Ambient {
	let c = time.NewManual(0)
	let status = with context { io.Stdin: io.NewStdin(), time.Clock: c, time.Scheduler: c } {
		script.Run(c)
	}
	if status != 0 {
		return os.Exit{Code: 1, Message: "stopwatch: the script did not run"}
	}
}
