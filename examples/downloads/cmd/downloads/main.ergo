// downloads is a download manager. It reads a list of files from stdin
// and fetches each, chunk by chunk, with a retry after a timeout that
// waits longer each time, and shows each file's progress and its end.
// Package fetch is the file's machine and the Source contract; package
// memory holds the source; package script reads the list and plays it.
// This binary is the only place that chooses them: it binds fetch.Source
// to a memory server and the clock to a manual one that the script moves.

import io
import os
import time
import downloads/fetch
import downloads/memory
import downloads/script

func main() fails os.Exit needs Console | Ambient {
	let mut lines = []string{}
	with context { io.Stdin: io.NewHost() } {
		for line in io.Stdin.Lines() {
			lines = lines.Append(line)
		}
	}
	let gets = script.Read(lines) catch {
	case script.BadLine as b:
		return os.Exit{Code: 1, Message: "downloads: line \(b.Line): \(b.Why)"}
	}
	let clock = time.NewManual(0)
	let shown = with context { fetch.Source: memory.NewServer(), Scheduler: clock } {
		script.Play(gets, clock)
	}
	for l in shown {
		Console.Println(l)
	}
}
