// The manager: one machine that owns a child per file. It runs the files
// in the order they were added, one at a time: each file is an entry of
// the manager, and the entry's work starts the file's Download as a child
// of that entry (MU5). The file's end comes back as a signal of the entry;
// the entry's end stops the child, so no file outlives its turn.

import actor
import machines
import option
import time

// FileActor is a file's address, the child an entry's work starts. A
// union whose only variant is an existing type is that type, an alias.
type FileActor = actor.Actor[File, Signal, machines.Decision[File, End]]

// Manager is the manager's state:
//
//	Idle     no file runs; Ends are the files that ended, in order
//	Running  the file Url runs as the child in File; Queue waits after
//	         it; Open is false once Drain came
//
// An Idle manager is always open: a Drain while idle ends the manager.
type Manager =
	| Idle{Ends []End}
	| Running{Url string, Queue []string, Ends []End, Open bool, File actor.Host[FileActor]}

// DrainRefusesAdds: after a drain the manager takes no add.
law DrainRefusesAdds(moves []int) { foldManager(moves).LateTook == 0 }

// Order is what the manager reads: Add and Drain from its user, Ended
// from the child of the running entry.
type Order = Add{Url string} | Drain{} | Ended{End End}

// Closed is an Add that the manager refuses, since it drains.
type Closed { Url string }

// Report is the manager's end: every file's end, in the order of the adds.
type Report { Ends []End }

// AddsRunInOrder: the manager starts the files in the order it took them,
// one at a time, and keeps each end in the order it came.
law AddsRunInOrder(moves []int) {
	let t = foldManager(moves)
	if t.Started.Len() > t.Took.Len() {
		return false
	}
	for i, u in t.Started {
		if t.Took[i] != u {
			return false
		}
	}
	let ends = match t.Report {
	case option.Some[Report] as r:
		r.Value.Ends
	case option.None:
		EndsOf(t.Last)
	}
	if ends.Len() != t.Sent.Len() {
		return false
	}
	for i, e in ends {
		if e != t.Sent[i] {
			return false
		}
	}
	true
}

// order is the order of a generated number m, the i-th of a run, while
// the manager is in s: an add (twice as often as the others), the end of
// the running file, or a drain.
func order(m int, i int, s Manager) Order {
	match pick(m, 4) {
	case 0:
		Add{Url: "f\(i)"}
	case 1:
		Add{Url: "f\(i)"}
	case 2:
		Ended{End: Saved{Url: runningUrl(s), Bytes: i}}
	case _:
		Drain
	}
}

// runningUrl is the file s runs, "" when it runs none.
func runningUrl(s Manager) string {
	match s {
	case Running as r:
		r.Url
	case Idle:
		""
	}
}

// ManagerTrace is a fold of the manager: the adds it took, the adds it
// took after a drain, the files it started, in order, the ends of running
// files it was sent, whether a drain came, its last state and its report
// once it ended.
type ManagerTrace {
	Took     []string,
	LateTook int,
	Started  []string,
	Sent     []End,
	Drained  bool,
	Last     Manager,
	Report   option.Option[Report],
}

// foldManager steps a new manager over the orders of moves, until its end.
func foldManager(moves []int) ManagerTrace {
	let mut s Manager = Idle{Ends: []End{}}
	let mut t = ManagerTrace{Took: []string{}, LateTook: 0, Started: []string{}, Sent: []End{}, Drained: false, Last: s, Report: option.None}
	for i, m in moves {
		let o = order(m, i, s)
		let d = StepManager(s, o) catch {
		case Closed:
			continue
		}
		match o {
		case Add as a:
			t = ManagerTrace{..t, Took: t.Took.Append(a.Url), LateTook: if t.Drained { t.LateTook + 1 } else { t.LateTook }}
		case Ended as e:
			if runningUrl(s) != "" {
				t = ManagerTrace{..t, Sent: t.Sent.Append(e.End)}
			}
		case Drain:
			t = ManagerTrace{..t, Drained: true}
		}
		match d {
		case machines.Done[Report] as r:
			return ManagerTrace{..t, Last: s, Report: option.Some[Report]{Value: r.Output}}
		case machines.Enter[Manager] as e:
			s = e.Next
			let u = runningUrl(s)
			if u != "" {
				t = ManagerTrace{..t, Started: t.Started.Append(u)}
			}
		case machines.Stay[Manager] as e:
			s = e.Next
		case _:
		}
	}
	ManagerTrace{..t, Last: s}
}

// DrainFinishesTheQueue: the manager ends only after a drain, and then
// exactly when every file it took has ended; its report has them all.
law DrainFinishesTheQueue(moves []int) {
	let t = foldManager(moves)
	match t.Report {
	case option.Some[Report] as r:
		t.Drained && r.Value.Ends.Len() == t.Took.Len()
	case option.None:
		!t.Drained || t.Sent.Len() < t.Took.Len()
	}
}

// running is the entry that runs url, with a fresh host for its child.
func running(url string, queue []string, ends []End, open bool) Running {
	Running{Url: url, Queue: queue, Ends: ends, Open: open, File: actor.NewHost[FileActor]()}
}

// StepManager is the manager's transition. Add runs a file at once when
// none runs, and queues it otherwise; after Drain it is Closed. Drain lets
// the queue finish and ends the manager after the last file (at once when
// idle). Ended records the file's end and starts the next one.
func StepManager(m Manager, o Order) machines.Decision[Manager, Report] fails Closed {
	match (m, o) {
	case (Idle as i, Add as a):
		machines.Enter[Manager]{Next: running(a.Url, []string{}, i.Ends, true)}
	case (Running as r, Add as a):
		if !r.Open {
			return Closed{Url: a.Url}
		}
		machines.Stay[Manager]{Next: Running{..r, Queue: r.Queue.Append(a.Url)}}
	case (Idle as i, Drain):
		machines.Done[Report]{Output: Report{Ends: i.Ends}}
	case (Running as r, Drain):
		machines.Stay[Manager]{Next: Running{..r, Open: false}}
	case (Running as r, Ended as e):
		let ends = r.Ends.Append(e.End)
		if r.Queue.Len() > 0 {
			machines.Enter[Manager]{Next: running(r.Queue[0], r.Queue[1:], ends, r.Open)}
		} else if r.Open {
			machines.Enter[Manager]{Next: Idle{Ends: ends}}
		} else {
			machines.Done[Report]{Output: Report{Ends: ends}}
		}
	case (Idle, Ended):
		machines.Ignore
	}
}

// ended is a file's end as the manager's order.
func ended(e End) Order { Ended{End: e} }

// hosting is the work of each state: Running starts its file as a child
// of the entry, in the entry's host. The child needs the Source, and
// starting it needs the Scheduler, so the work's row is both (MB F8).
func hosting(m Manager) option.Option[machines.Work[Order, Source | time.Scheduler]] {
	match m {
	case Running as r:
		option.Some{machines.Work{Start: func(send entry func(o Order)) needs Source | time.Scheduler {
			let _ = actor.ChildIn(send, r.File, machines.Start(Download{}, r.Url), 4, ended)
		}}}
	case Idle:
		option.None
	}
}

func idle(ends []End) Manager { Idle{Ends: ends} }

// Downloader is the manager as a machine: its input is the ends it starts
// with (none, for a new manager).
type Downloader machine[Manager, Order] {
	initial: idle,
	step:    StepManager,
	work:    hosting,
}

// EndsOf is the ends of m so far.
func EndsOf(m Manager) []End {
	match m {
	case Idle as i:
		i.Ends
	case Running as r:
		r.Ends
	}
}
