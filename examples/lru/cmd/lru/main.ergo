// lru looks ports up through an LRU memo, and benchmarks the cache.
//
//	lru [lookup [CAPACITY]]  read service names from standard input, one per
//	                         line, and look each up; then print the memo's counts
//	lru bench N              run N cache operations and print a checksum
//
// This binary is the only place that chooses the providers: the port
// table and the host's standard input.

import io
import lru/cache
import lru/registry
import lru/memo
import lru/memory
import os
import strconv
import strings

// Ports is the demo's port list.
let Ports = "web 8080\npostgres 5432\ndns 53\nssh 22\nsmtp 25\n"

// Usage is the text of a usage failure.
let Usage = "usage: lru [lookup [CAPACITY]] | lru bench N"

// Command is what the arguments ask for.
type Command = Lookup{Capacity int} | Bench{Ops int}

// Parse is the command of args, or os.Exit with the usage.
func Parse(args []string) Command fails os.Exit {
	if len(args) == 0 {
		return Lookup{Capacity: 2}
	}
	match (args[0], len(args)) {
	case ("lookup", 1):
		Lookup{Capacity: 2}
	case ("lookup", 2):
		Lookup{Capacity: try count(args[1])}
	case ("bench", 2):
		Bench{Ops: try count(args[1])}
	case (_, _):
		os.Exit{Code: 2, Message: Usage}
	}
}

// count is the positive count text spells.
func count(text string) int fails os.Exit {
	let n = strconv.Atoi(text) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return os.Exit{Code: 2, Message: "lru: \(strconv.Quote(text)) is not a count\n\(Usage)"}
	}
	if n < 1 {
		return os.Exit{Code: 2, Message: "lru: the count must be at least 1, not \(n)"}
	}
	n
}

// LookupAll looks each name of text up through a Memo of capacity entries,
// and prints the counts at the end.
func LookupAll(text string, capacity int, table memory.Table) fails os.Exit needs Console {
	let mut m = memo.New[string, int](capacity) catch {
	case cache.BadCapacity as b:
		return os.Exit{Code: 2, Message: "lru: capacity \(b.Capacity)"}
	}
	with context { registry.Registry: table } {
		for line in strings.Split(text, "\n") {
			let name = strings.TrimSpace(line)
			if name == "" {
				continue
			}
			let hits = m.CountsOf().Hits
			let port = registry.Lookup(&m, name) catch {
			case registry.Unknown as u:
				Console.Println("\(u.Name) is not in the registry")
				continue
			}
			let from = if m.CountsOf().Hits > hits { "cache" } else { "registry" }
			Console.Println("\(registry.Line(name, port)) (\(from))")
		}
	}
	let c = m.CountsOf()
	Console.Println("hits \(c.Hits), misses \(c.Misses), held \(c.Size), lookups \(table.Lookups())")
}

// Churn runs ops Get-or-Put operations on a cache of 1024 entries over
// 4096 keys drawn from a fixed generator, and is the sum of the values
// the Gets found. bench/hand.go is the same loop in hand-written Go.
func Churn(ops int) int {
	let mut c = cache.New[int, int](1024) catch {
	case cache.BadCapacity:
		return -1
	}
	let mut x = 1
	let mut sum = 0
	for i in 0..ops {
		x = (x*1103515245 + 12345) % 2147483648
		let k = (x / 65536) % 4096
		match c.Get(k) {
		case Some[int] as v:
			sum += v.Value
		case None:
			let _ = c.Put(k, i)
		}
	}
	sum
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost(), io.Stdin: io.NewStdin() } {
		match try Parse(os.Process.Args()) {
		case Lookup as q:
			let table = memory.Parse(Ports) catch {
			case memory.BadRow as b:
				return os.Exit{Code: 1, Message: "lru: bad port row \(strconv.Quote(b.Line))"}
			}
			let text = io.Stdin.ReadAll() catch {
			case io.ReadFailed as r:
				return os.Exit{Code: 1, Message: "lru: \(r.Reason)"}
			}
			try LookupAll(text, q.Capacity, table)
		case Bench as b:
			Console.Println("\(b.Ops) ops, sum \(Churn(b.Ops))")
		}
	}
}

test ParseReadsEachCommand {
	assert try Parse([]string{}) == Lookup{Capacity: 2}
	assert try Parse([]string{"lookup", "5"}) == Lookup{Capacity: 5}
	assert try Parse([]string{"bench", "10"}) == Bench{Ops: 10}
}

// exitOf is the status that Parse(args) exits with, or 0.
func exitOf(args []string) int {
	let _ = Parse(args) catch {
	case os.Exit as e:
		return int(e.Code)
	}
	0
}

test ParseRefusesTheRest {
	assert exitOf([]string{"bench"}) == 2 && exitOf([]string{"lookup", "0"}) == 2
	assert exitOf([]string{"lookup", "x"}) == 2 && exitOf([]string{"go"}) == 2
}

test BenchIsDeterministic {
	assert Churn(5000) == Churn(5000) && Churn(1) == 0
}

test LookupAllCountsHits {
	let out = io.NewRecorder()
	let table = try memory.Parse(Ports)
	with context { Console: out } {
		try LookupAll("web\ndns\nweb\nftp\n", 1, table)
	}
	assert out.Text() == "web :8080 (registry)\ndns :53 (registry)\nweb :8080 (registry)\nftp is not in the registry\nhits 0, misses 4, held 1, lookups 4\n"
}
