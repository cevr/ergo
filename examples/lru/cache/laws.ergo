// The rules of a Cache as laws over its operations. A top-level law is
// not generic (G-ex-d-13), so the laws are stated at int keys and values.

// SizeOf is a capacity from any n: 1 to 5, so a short run of puts fills
// and overflows the cache.
func SizeOf(n int) int {
	let m = if n < 0 { -(n + 1) } else { n }
	1 + m%5
}

// Filled is a cache of capacity SizeOf(n) after a Put of each key, the
// value of a key being its double.
func Filled(n int, keys []int) Cache[int, int] {
	let mut c = New[int, int](SizeOf(n)) catch {
	case BadCapacity:
		return Filled(1, keys)
	}
	for k in keys {
		let _ = c.Put(k, 2*k)
	}
	c
}

// CapacityBound: a cache never holds more entries than its capacity.
law CapacityBound(n int, keys []int) {
	let c = Filled(n, keys)
	c.Len() <= c.Capacity() && len(c.Entries()) == c.Len()
}

// GetAfterPut: a Get of the key just put is its value.
law GetAfterPut(n int, keys []int, k int, v int) {
	let mut c = Filled(n, keys)
	let _ = c.Put(k, v)
	c.Get(k) == Some{v}
}

// MostRecentKept: a cache keeps the most recently used entries: after a
// Put of each key, the entries are the last distinct keys, newest first,
// as many as fit.
law MostRecentKept(n int, keys []int) {
	let c = Filled(n, keys)
	let want = Recent(keys, SizeOf(n))
	let got = c.Entries()
	if len(got) != len(want) {
		return false
	}
	for i, e in got {
		if e.Key != want[i] || e.Value != 2*want[i] {
			return false
		}
	}
	true
}

// EvictsTheLeastRecent: a Put into a full cache of a new key returns the
// entry that a Get or Put touched longest ago.
law EvictsTheLeastRecent(n int, keys []int, k int) {
	let mut c = Filled(n, keys)
	let before = c.Entries()
	let full = c.Len() == c.Capacity()
	let fresh = c.Peek(k) == None
	match c.Put(k, 0) {
	case Some[Entry[int, int]] as out:
		full && fresh && out.Value == before[len(before)-1]
	case None:
		!full || !fresh
	}
}

// Recent is the last distinct keys of keys, newest first, at most size.
func Recent(keys []int, size int) []int {
	let mut out = []int{}
	let mut i = len(keys) - 1
	for i >= 0 && len(out) < size {
		let mut seen = false
		for k in out {
			if k == keys[i] {
				seen = true
			}
		}
		if !seen {
			out = out.Append(keys[i])
		}
		i = i - 1
	}
	out
}
