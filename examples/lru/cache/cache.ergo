// Package cache is a generic least-recently-used cache: a bounded map
// that, when full, drops the entry that was used longest ago. It is the
// Go shape of an LRU (a hash map into a doubly linked list), with the
// list's nodes in a std arena and its links arena Refs, since Ergo has no
// pointer fields.

import arena
import cmp
import slices

// node is one entry on the recency list, in the arena; a link is the
// Ref of a node, and arena.Null is no node. Of the links, prev is the more recent
// neighbour, next the less recent one.
type node[K, V] { key K, value V, prev arena.Ref[node[K, V]], next arena.Ref[node[K, V]] }

// Cache holds at most capacity entries. Its fields are unexported, so
// only this package builds one: outside cache, a Cache is always one
// that New and the operations made.
type Cache[K comparable, V] {
	capacity int,
	index    Map[K, arena.Ref[node[K, V]]],
	nodes    arena.Of[node[K, V]],
	head     arena.Ref[node[K, V]],
	tail     arena.Ref[node[K, V]],
}

// Entry is a key and its value.
type Entry[K, V] { Key K, Value V }

// BadCapacity is a capacity below one.
type BadCapacity { Capacity int }

// New is an empty cache of capacity entries.
func New[K comparable, V](capacity int) Cache[K, V] fails BadCapacity {
	if capacity < 1 {
		return BadCapacity{Capacity: capacity}
	}
	let none = arena.Null[node[K, V]]()
	Cache[K, V]{capacity: capacity, index: Map[K, arena.Ref[node[K, V]]]{}, nodes: arena.New[node[K, V]](), head: none, tail: none}
}

// Capacity is the most entries c holds.
func Capacity[K comparable, V](c Cache[K, V]) int { c.capacity }

// Len is the number of entries in c.
func Len[K comparable, V](c Cache[K, V]) int { len(c.index) }

// Get is the value of k, and makes k the most recently used entry.
func Get[K comparable, V](c *Cache[K, V], k K) Option[V] {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		let n = c.nodeAt(at.Value)
		c.touch(at.Value, n)
		Some{n.value}
	case None:
		None
	}
}

// Peek is the value of k, and changes no recency. It takes a borrow
// because an arena read does (std arena.Get).
func Peek[K comparable, V](c *Cache[K, V], k K) Option[V] {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		Some{c.nodeAt(at.Value).value}
	case None:
		None
	}
}

// Put sets k to v and makes k the most recently used entry. When c was
// full and k was not in it, Put drops the least recently used entry and
// returns it.
func Put[K comparable, V](c *Cache[K, V], k K, v V) Option[Entry[K, V]] {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		let n = c.nodeAt(at.Value)
		c.update(at.Value, func(p *node[K, V]) { p.value = v })
		c.touch(at.Value, n)
		return None
	case None:
	}
	let mut evicted Option[Entry[K, V]] = None
	if len(c.index) == c.capacity {
		let old = c.release(c.tail)
		c.index = c.index.Delete(old.key)
		evicted = Some{Entry[K, V]{Key: old.key, Value: old.value}}
	}
	let at = c.nodes.Put(node[K, V]{key: k, value: v, prev: arena.Null[node[K, V]](), next: c.head})
	c.index[k] = at
	c.pushed(at)
	evicted
}

// Remove drops k from c, and reports whether it was there.
func Remove[K comparable, V](c *Cache[K, V], k K) bool {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		let _ = c.release(at.Value)
		c.index = c.index.Delete(k)
		true
	case None:
		false
	}
}

// Entries is the entries of c, the most recently used first.
func Entries[K comparable, V](c *Cache[K, V]) []Entry[K, V] {
	let mut out = []Entry[K, V]{}
	let mut at = c.head
	for at != arena.Null[node[K, V]]() {
		let n = c.nodeAt(at)
		out = out.Append(Entry[K, V]{Key: n.key, Value: n.value})
		at = n.next
	}
	out
}

// Sorted is the entries of c in key order: a listing that does not
// depend on recency.
func Sorted[K ordered, V](c *Cache[K, V]) []Entry[K, V] {
	slices.SortFunc(c.Entries(), func(a Entry[K, V], b Entry[K, V]) int { cmp.Compare(a.Key, b.Key) })
}

// nodeAt is the node at names. Every link the cache holds names a node
// in its arena, so a stale one is a bug of this package.
func nodeAt[K comparable, V](c *Cache[K, V], at arena.Ref[node[K, V]]) node[K, V] {
	c.nodes.Get(at) catch {
	case arena.Stale:
		Unreachable("the cache holds a link to a freed node")
	}
}

// update changes the node at names in place.
func update[K comparable, V](c *Cache[K, V], at arena.Ref[node[K, V]], f func(n *node[K, V])) {
	c.nodes.Update(at, f) catch {
	case arena.Stale:
		Unreachable("the cache holds a link to a freed node")
	}
}

// touch moves the node at to the front of the recency list; n is that
// node as it was read, with its links.
func touch[K comparable, V](c *Cache[K, V], at arena.Ref[node[K, V]], n node[K, V]) {
	if c.head == at {
		return
	}
	c.unlink(n)
	let head = c.head
	c.update(at, func(p *node[K, V]) {
		p.prev = arena.Null[node[K, V]]()
		p.next = head
	})
	c.pushed(at)
}

// release takes the node at off the recency list, frees it and returns
// it.
func release[K comparable, V](c *Cache[K, V], at arena.Ref[node[K, V]]) node[K, V] {
	c.unlink(c.nodeAt(at))
	c.nodes.Free(at) catch {
	case arena.Stale:
		Unreachable("the cache holds a link to a freed node")
	}
}

// unlink joins the neighbours of n, a node on the recency list, so that
// the list no longer passes through it.
func unlink[K comparable, V](c *Cache[K, V], n node[K, V]) {
	if n.prev == arena.Null[node[K, V]]() {
		c.head = n.next
	} else {
		c.update(n.prev, func(p *node[K, V]) { p.next = n.next })
	}
	if n.next == arena.Null[node[K, V]]() {
		c.tail = n.prev
	} else {
		c.update(n.next, func(p *node[K, V]) { p.prev = n.prev })
	}
}

// pushed makes at, a node whose next is the old head, the head of the
// recency list.
func pushed[K comparable, V](c *Cache[K, V], at arena.Ref[node[K, V]]) {
	if c.head == arena.Null[node[K, V]]() {
		c.tail = at
	} else {
		c.update(c.head, func(p *node[K, V]) { p.prev = at })
	}
	c.head = at
}
