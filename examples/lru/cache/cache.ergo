// Package cache is a generic least-recently-used cache: a bounded map
// that, when full, drops the entry that was used longest ago. It is the
// Go shape of an LRU (a hash map into a doubly linked list), with the
// list's nodes in a std arena and its links arena Refs, since Ergo has no
// pointer fields.

import arena
import cmp
import slices

// node is one entry on the recency list, in the arena; a link is the
// Ref of a node, and arena.Null is no node. Of the links, prev is the more recent
// neighbour, next the less recent one.
type node[K, V] { key K, value V, prev arena.Ref[node[K, V]], next arena.Ref[node[K, V]] }

// Cache holds at most capacity entries. Its fields are unexported, so
// only this package builds one: outside cache, a Cache is always one
// that New and the operations made.
type Cache[K comparable, V] {
	capacity int,
	index    Map[K, arena.Ref[node[K, V]]],
	nodes    arena.Of[node[K, V]],
	head     arena.Ref[node[K, V]],
	tail     arena.Ref[node[K, V]],
}

// Entry is a key and its value.
type Entry[K, V] { Key K, Value V }

// MostRecentKept: a cache keeps the most recently used entries: after a
// Put of each key, the entries are the last distinct keys, newest first,
// as many as fit.
law MostRecentKept(n int, keys []int, seed int) {
	for ks in [][]int{keys, keysOf(seed)} {
		let want = slices.Transform(recent(ks, sizeOf(n)), func(k int) Entry[int, int] { Entry[int, int]{Key: k, Value: 2 * k} })
		let mut c = filled(n, ks)
		if c.Entries() != want {
			return false
		}
	}
	true
}

// recent is the last distinct keys of keys, newest first, at most size.
func recent(keys []int, size int) []int {
	let mut out = []int{}
	let mut i = len(keys) - 1
	for i >= 0 && len(out) < size {
		let mut seen = false
		for k in out {
			if k == keys[i] {
				seen = true
			}
		}
		if !seen {
			out = out.Append(keys[i])
		}
		i = i - 1
	}
	out
}

// BadCapacity is a capacity below one.
type BadCapacity { Capacity int }

// New is an empty cache of capacity entries.
func New[K comparable, V](capacity int) Cache[K, V] fails BadCapacity {
	if capacity < 1 {
		return BadCapacity{Capacity: capacity}
	}
	let none = arena.Null[node[K, V]]()
	Cache[K, V]{capacity: capacity, index: Map[K, arena.Ref[node[K, V]]]{}, nodes: arena.New[node[K, V]](), head: none, tail: none}
}

// Capacity is the most entries c holds.
func Capacity[K comparable, V](c Cache[K, V]) int { c.capacity }

// CapacityBound: a cache never holds more entries than its capacity.
law CapacityBound(n int, keys []int, seed int) {
	for ks in [][]int{keys, keysOf(seed)} {
		let mut c = filled(n, ks)
		if c.Len() > c.Capacity() || len(c.Entries()) != c.Len() {
			return false
		}
	}
	true
}

// sizeOf is a capacity from any n: 1 to 5, so a short run of puts fills
// and overflows the cache.
func sizeOf(n int) int {
	let m = if n < 0 { -(n + 1) } else { n }
	1 + m%5
}

// keysOf is up to 24 keys over 0 to 7, drawn from seed.
func keysOf(seed int) []int {
	let mut keys = []int{}
	for op in Ops(seed, 24) {
		match op {
		case PutOp as p:
			keys = keys.Append(p.Key)
		case GetOp as g:
			keys = keys.Append(g.Key)
		case RemoveOp:
		}
	}
	keys
}

// filled is a cache of capacity SizeOf(n) after a Put of each key, the
// value of a key being its double.
func filled(n int, keys []int) Cache[int, int] {
	let mut c = New[int, int](sizeOf(n)) catch {
	case BadCapacity:
		return filled(1, keys)
	}
	for k in keys {
		let _ = c.Put(k, 2*k)
	}
	c
}

// Len is the number of entries in c.
func Len[K comparable, V](c Cache[K, V]) int { len(c.index) }

// Get is the value of k, and makes k the most recently used entry.
func Get[K comparable, V](c mut Cache[K, V], k K) Option[V] {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		let n = c.nodeAt(at.Value)
		c.touch(at.Value, n.prev, n.next)
		Some{n.value}
	case None:
		None
	}
}

// GetAfterPut: a Get of the key just put is its value. SizeOf(k) is a key
// that KeysOf(seed) often holds, so the Put overwrites.
law GetAfterPut(n int, keys []int, seed int, k int, v int) {
	for ks in [][]int{keys, keysOf(seed)} {
		for key in []int{k, sizeOf(k)} {
			let mut c = filled(n, ks)
			let _ = c.Put(key, v)
			if c.Get(key) != (Some{v}) {
				return false
			}
		}
	}
	true
}

// Peek is the value of k, and changes no recency. It takes a borrow
// because an arena read does (std arena.Get).
func Peek[K comparable, V](c mut Cache[K, V], k K) Option[V] {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		Some{c.nodeAt(at.Value).value}
	case None:
		None
	}
}

// Put sets k to v and makes k the most recently used entry. When c was
// full and k was not in it, Put drops the least recently used entry and
// returns it.
func Put[K comparable, V](c mut Cache[K, V], k K, v V) Option[Entry[K, V]] {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		let n = c.nodeAt(at.Value)
		c.nodes.Update(at.Value, func(p mut node[K, V]) { p.value = v }) catch {
		case arena.Stale:
			Unreachable("the cache holds a link to a freed node")
		}
		c.touch(at.Value, n.prev, n.next)
		return None
	case None:
	}
	let mut evicted Option[Entry[K, V]] = None
	if len(c.index) == c.capacity {
		let old = c.release(c.tail)
		c.index = c.index.Delete(old.key)
		evicted = Some{Entry[K, V]{Key: old.key, Value: old.value}}
	}
	let at = c.nodes.Put(node[K, V]{key: k, value: v, prev: arena.Null[node[K, V]](), next: c.head})
	c.index[k] = at
	c.pushed(at)
	evicted
}

// Remove drops k from c, and reports whether it was there.
func Remove[K comparable, V](c mut Cache[K, V], k K) bool {
	match c.index.Get(k) {
	case Some[arena.Ref[node[K, V]]] as at:
		let _ = c.release(at.Value)
		c.index = c.index.Delete(k)
		true
	case None:
		false
	}
}

// Entries is the entries of c, the most recently used first.
func Entries[K comparable, V](c mut Cache[K, V]) []Entry[K, V] {
	let mut out = []Entry[K, V]{}
	let mut at = c.head
	for at != arena.Null[node[K, V]]() {
		let n = c.nodeAt(at)
		out = out.Append(Entry[K, V]{Key: n.key, Value: n.value})
		at = n.next
	}
	out
}

// EvictsTheLeastRecent: a Put into a full cache of a new key returns the
// entry that a Get or Put touched longest ago.
law EvictsTheLeastRecent(n int, keys []int, seed int, k int) {
	for ks in [][]int{keys, keysOf(seed)} {
		let mut c = filled(n, ks)
		let before = c.Entries()
		let full = c.Len() == c.Capacity()
		let fresh = c.Peek(k) == None
		let ok = match c.Put(k, 0) {
		case Some[Entry[int, int]] as out:
			full && fresh && out.Value == before[len(before)-1]
		case None:
			!full || !fresh
		}
		if !ok {
			return false
		}
	}
	true
}

// Sorted is the entries of c in key order: a listing that does not
// depend on recency.
func Sorted[K ordered, V](c mut Cache[K, V]) []Entry[K, V] {
	slices.SortFunc(c.Entries(), func(a Entry[K, V], b Entry[K, V]) int { cmp.Compare(a.Key, b.Key) })
}

// nodeAt is the node at names. Every link the cache holds names a node
// in its arena, so a stale one is a bug of this package.
func nodeAt[K comparable, V](c mut Cache[K, V], at arena.Ref[node[K, V]]) node[K, V] {
	c.nodes.Get(at) catch {
	case arena.Stale:
		Unreachable("the cache holds a link to a freed node")
	}
}

// touch moves the node at, whose links are prev and next, to the front
// of the recency list.
func touch[K comparable, V](c mut Cache[K, V], at own arena.Ref[node[K, V]], prev own arena.Ref[node[K, V]], next own arena.Ref[node[K, V]]) {
	if c.head == at {
		return
	}
	c.unlink(prev, next)
	let head = c.head
	c.nodes.Update(at, func(p mut node[K, V]) {
		p.prev = arena.Null[node[K, V]]()
		p.next = head
	}) catch {
	case arena.Stale:
		Unreachable("the cache holds a link to a freed node")
	}
	c.pushed(at)
}

// release takes the node at off the recency list, frees it and returns
// it. Free returns the node with its links, so one arena access reads
// and frees it.
func release[K comparable, V](c mut Cache[K, V], at arena.Ref[node[K, V]]) node[K, V] {
	let n = c.nodes.Free(at) catch {
	case arena.Stale:
		Unreachable("the cache holds a link to a freed node")
	}
	c.unlink(n.prev, n.next)
	n
}

// unlink joins prev and next, the neighbours of a node on the recency
// list, so that the list no longer passes through that node.
func unlink[K comparable, V](c mut Cache[K, V], prev own arena.Ref[node[K, V]], next own arena.Ref[node[K, V]]) {
	if prev == arena.Null[node[K, V]]() {
		c.head = next
	} else {
		c.nodes.Update(prev, func(p mut node[K, V]) { p.next = next }) catch {
		case arena.Stale:
			Unreachable("the cache holds a link to a freed node")
		}
	}
	if next == arena.Null[node[K, V]]() {
		c.tail = prev
	} else {
		c.nodes.Update(next, func(p mut node[K, V]) { p.prev = prev }) catch {
		case arena.Stale:
			Unreachable("the cache holds a link to a freed node")
		}
	}
}

// pushed makes at, a node whose next is the old head, the head of the
// recency list.
func pushed[K comparable, V](c mut Cache[K, V], at own arena.Ref[node[K, V]]) {
	if c.head == arena.Null[node[K, V]]() {
		c.tail = at
	} else {
		c.nodes.Update(c.head, func(p mut node[K, V]) { p.prev = at }) catch {
		case arena.Stale:
			Unreachable("the cache holds a link to a freed node")
		}
	}
	c.head = at
}
