// The cache's tests: examples, and the laws restated as property tests.
// The compiler checks laws and does not run them yet (#162); until it
// does, these tests run them. A generated slice holds at most three
// elements (G-ex-d-9), so each law also runs over KeysOf(seed), a run of
// up to 24 keys.

import slices

// KeysOf is up to 24 keys over 0 to 7, drawn from seed.
func KeysOf(seed int) []int {
	let mut keys = []int{}
	for op in Ops(seed, 24) {
		match op {
		case PutOp as p:
			keys = keys.Append(p.Key)
		case GetOp as g:
			keys = keys.Append(g.Key)
		case RemoveOp:
		}
	}
	keys
}

// refused is the capacity that New(n) refuses, or -1 when it makes a cache.
func refused(n int) int {
	let _ = New[string, int](n) catch {
	case BadCapacity as b:
		return b.Capacity
	}
	-1
}

test NewRefusesNoRoom {
	assert refused(0) == 0 && refused(-3) == -3 && refused(1) == -1
}

test EvictsInRecencyOrder {
	let mut c = try New[string, int](2)
	assert c.Put("a", 1) == None
	assert c.Put("b", 2) == None
	assert c.Get("a") == Some{1}
	assert c.Put("c", 3) == Some{Entry[string, int]{Key: "b", Value: 2}}
	assert c.Peek("b") == None && c.Len() == 2
	let keys = slices.Transform(c.Entries(), func(e Entry[string, int]) string { e.Key })
	assert slices.Equal(keys, []string{"c", "a"})
}

test PutOverwritesWithoutEvicting {
	let mut c = try New[string, int](2)
	let _ = c.Put("a", 1)
	let _ = c.Put("b", 2)
	assert c.Put("a", 10) == None
	assert c.Peek("a") == Some{10} && c.Len() == 2
}

test PeekKeepsRecency {
	let mut c = try New[int, int](2)
	let _ = c.Put(1, 1)
	let _ = c.Put(2, 2)
	assert c.Peek(1) == Some{1}
	assert c.Put(3, 3) == Some{Entry[int, int]{Key: 1, Value: 1}}
}

test RemoveFreesASlot {
	let mut c = try New[int, string](2)
	let _ = c.Put(1, "one")
	let _ = c.Put(2, "two")
	assert c.Remove(1) && !c.Remove(1)
	assert c.Put(3, "three") == None
	assert c.Len() == 2 && c.Peek(2) == Some{"two"}
}

test SortedIsKeyOrder {
	let mut c = try New[string, int](3)
	for k in []string{"pear", "apple", "fig", "kiwi"} {
		let _ = c.Put(k, len(k))
	}
	let keys = slices.Transform(c.Sorted(), func(e Entry[string, int]) string { e.Key })
	assert slices.Equal(keys, []string{"apple", "fig", "kiwi"})
}

test CapacityBoundHolds(n int, keys []int, seed int) {
	for ks in [][]int{keys, KeysOf(seed)} {
		let c = Filled(n, ks)
		assert c.Len() <= c.Capacity() && len(c.Entries()) == c.Len()
	}
}

test GetAfterPutHolds(n int, keys []int, seed int, k int, v int) {
	// SizeOf(k) is a key that KeysOf(seed) often holds, so Put overwrites.
	for ks in [][]int{keys, KeysOf(seed)} {
		for key in []int{k, SizeOf(k)} {
			let mut c = Filled(n, ks)
			let _ = c.Put(key, v)
			assert c.Get(key) == Some{v}
		}
	}
}

test MostRecentKeptHolds(n int, keys []int, seed int) {
	for ks in [][]int{keys, KeysOf(seed)} {
		let want = Recent(ks, SizeOf(n))
		let entries = Filled(n, ks).Entries()
		let got = slices.Transform(entries, func(e Entry[int, int]) int { e.Key })
		for e in entries {
			assert e.Value == 2*e.Key
		}
		assert slices.Equal(got, want)
	}
}

test EvictsTheLeastRecentHolds(n int, keys []int, seed int, k int) {
	for ks in [][]int{keys, KeysOf(seed)} {
		let mut c = Filled(n, ks)
		let before = c.Entries()
		let full = c.Len() == c.Capacity()
		let fresh = c.Peek(k) == None
		match c.Put(k, 0) {
		case Some[Entry[int, int]] as out:
			assert full && fresh && out.Value == before[len(before)-1]
		case None:
			assert !full || !fresh
		}
	}
}

test ModelAgreesHolds(n int, seed int) {
	let size = SizeOf(n)
	let mut c = try New[int, int](size)
	let mut m = Model{capacity: size, entries: []Entry[int, int]{}}
	for op in Ops(seed, 60) {
		let got = Apply(&c, op)
		let next, want = m.Step(op)
		m = next
		assert got == want
		assert SameEntries(c.Entries(), m.entries)
	}
}
