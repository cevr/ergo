// Package catalog is the domain of the demo: prices looked up by SKU from
// a slow source, quoted through a Memo so a repeated SKU is not looked
// up again.

import lru/memo

// Unknown is a SKU the catalog does not list.
type Unknown { SKU string }

// Catalog is the source of prices, in cents. A Memo may stand in front of
// it only because a price does not change between two lookups: the law
// Stable states that, and every provider must keep it.
type Catalog {
	Price(sku string) int fails Unknown,

	// Stable: two lookups of one SKU give one answer.
	law Stable(sku string) {
		let first = Price(sku) catch {
		case Unknown:
			let _ = Price(sku) catch {
			case Unknown:
				return true
			}
			return false
		}
		let second = Price(sku) catch {
		case Unknown:
			return false
		}
		first == second
	},

	// NotNegative: a price is never below zero.
	law NotNegative(sku string) {
		let p = Price(sku) catch {
		case Unknown:
			return true
		}
		p >= 0
	},
}

// Quote is the price of sku, from the Memo when it remembers one.
func Quote(m *memo.Memo[string, int], sku string) int fails Unknown needs Catalog {
	try m.Get(sku, func(s string) int fails Unknown needs Catalog { try Catalog.Price(s) })
}

// Line is the text of one quote: the SKU and its price in dollars and
// cents, or that the catalog does not list it.
func Line(sku string, price int) string {
	let cents = price % 100
	let pad = if cents < 10 { "0" } else { "" }
	"\(sku) $\(price / 100).\(pad)\(cents)"
}
