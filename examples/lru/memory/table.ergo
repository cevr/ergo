// Package memory holds an in-memory provider of catalog.Catalog.

import lru/catalog
import strconv
import strings
import sync

// Table is a Catalog over a fixed price list. It also counts its lookups
// in a sync.Ref, which every copy shares, so a test sees how many lookups
// a Memo saved.
type Table { prices Map[string, int], lookups sync.Ref[int] }

// BadRow is a line of a price list that is not "SKU CENTS".
type BadRow { Line string }

// NewTable is a Table of prices that has looked nothing up. A negative
// price is not listed, so a Table keeps the Catalog law NotNegative
// whatever prices it is given (ergo test builds it from generated ones).
func NewTable(prices Map[string, int]) Table {
	let mut listed = Map[string, int]{}
	for sku, cents in prices {
		if cents >= 0 {
			listed[sku] = cents
		}
	}
	Table{prices: listed, lookups: sync.NewRef[int](0)}
}

// Parse is the Table of a price list: one "SKU CENTS" per line; blank
// lines are skipped.
func Parse(text string) Table fails BadRow {
	let mut prices = Map[string, int]{}
	for line in strings.Split(text, "\n") {
		let fields = strings.Fields(line)
		if len(fields) == 0 {
			continue
		}
		if len(fields) != 2 {
			return BadRow{Line: line}
		}
		let cents = strconv.Atoi(fields[1]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return BadRow{Line: line}
		}
		if cents < 0 {
			return BadRow{Line: line}
		}
		prices[fields[0]] = cents
	}
	NewTable(prices)
}

// Price is the listed price of sku.
func Price(t Table, sku string) int fails catalog.Unknown {
	t.lookups.Update(func(n int) int { n + 1 })
	match t.prices.Get(sku) {
	case Some[int] as p:
		p.Value
	case None:
		catalog.Unknown{SKU: sku}
	}
}

// Lookups is how many times Price ran.
func Lookups(t Table) int { t.lookups.Get() }
