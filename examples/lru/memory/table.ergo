// Package memory holds an in-memory provider of registry.Registry.

import lru/registry
import strconv
import strings
import sync

// Table is a Registry over a fixed port list. It also counts its lookups
// in a sync.Ref, which every copy shares, so a test sees how many lookups
// a Memo saved.
type Table { ports Map[string, int], lookups sync.Ref[int] }

// BadRow is a line of a port list that is not "NAME PORT".
type BadRow { Line string }

// NewTable is a Table of ports that has looked nothing up. A negative
// port is not listed, so a Table keeps the Registry law NotNegative
// whatever ports it is given (ergo test builds it from generated ones).
func NewTable(ports Map[string, int]) Table {
	let mut listed = Map[string, int]{}
	for name, port in ports {
		if port >= 0 {
			listed[name] = port
		}
	}
	Table{ports: listed, lookups: sync.NewRef[int](0)}
}

// Parse is the Table of a port list: one "NAME PORT" per line; blank
// lines are skipped.
func Parse(text string) Table fails BadRow {
	let mut ports = Map[string, int]{}
	for line in strings.Split(text, "\n") {
		let fields = strings.Fields(line)
		if len(fields) == 0 {
			continue
		}
		if len(fields) != 2 {
			return BadRow{Line: line}
		}
		let port = strconv.Atoi(fields[1]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return BadRow{Line: line}
		}
		if port < 0 {
			return BadRow{Line: line}
		}
		ports[fields[0]] = port
	}
	NewTable(ports)
}

// Port is the listed port of name.
func Port(t Table, name string) int fails registry.Unknown {
	t.lookups.Update(func(n int) int { n + 1 })
	match t.ports.Get(name) {
	case Some[int] as p:
		p.Value
	case None:
		registry.Unknown{Name: name}
	}
}

// Lookups is how many times Port ran.
func Lookups(t Table) int { t.lookups.Get() }
