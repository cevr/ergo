// ergo test runs the registry.Registry laws against Table, built by
// NewTable from generated ports; these tests check its port list and
// show what a Memo in front of it saves.

import lru/registry
import lru/memo

// list is a Table of three names.
func list() Table {
	Parse("web 8080\ndb 5432\n\ndns 53\n") catch {
	case BadRow:
		NewTable(Map[string, int]{})
	}
}

test ParseRefusesABadRow {
	let at = Parse("web 8080\ndb fifty\n") catch {
	case BadRow as b:
		NewTable(Map[string, int]{b.Line: 0})
	}
	assert at.ports.Get("db fifty") == Some{0}
}

test MemoSavesLookups {
	let t = list()
	let mut m = try memo.New[string, int](2)
	with context { registry.Registry: t } {
		for name in []string{"web", "web", "db", "web", "dns", "db"} {
			let _ = try registry.Lookup(&m, name)
		}
	}
	assert t.Lookups() == 4
	assert m.CountsOf() == memo.Counts{Hits: 2, Misses: 4, Size: 2}
}

test UnknownIsLookedUpEachTime {
	let t = list()
	let mut m = try memo.New[string, int](2)
	with context { registry.Registry: t } {
		for _ in 0..3 {
			let p = registry.Lookup(&m, "ntp") catch {
			case registry.Unknown:
				-1
			}
			assert p == -1
		}
	}
	assert t.Lookups() == 3
}
