// Board's tests run over an fstest.Memory: the file's own form, and a
// corrupt line. ergo test runs the tasks.Board laws on Board itself, each
// case on a NewBoard over its own fstest.Memory.

import fstest
import taskscli/tasks

// fresh is the Board in the file "tasks.txt" of disk.
func fresh(disk fstest.Memory) Board { NewBoard(disk, disk) }

test TheFileForm {
	let disk = fstest.NewMemory()
	let b = fresh(disk)
	let _ = try b.Create("write the spec", tasks.High)
	let _ = try b.Create("tab\there", tasks.Low)
	let _ = try b.Close(1)
	assert try disk.ReadFile("tasks.txt") == "1\tclosed\thigh\t\"write the spec\"\n2\topen\tlow\t\"tab\\there\"\n"
}

test ACorruptLineIsBroken {
	let disk = fstest.NewMemory()
	try disk.WriteFile("tasks.txt", "1\topen\tlow\t\"a\"\n3\topen\tlow\t\"b\"\n")
	fresh(disk).All() catch {
	case tasks.Broken as b:
		assert b.Reason == "tasks.txt:2: not a task: 3\topen\tlow\t\"b\""
		return
	}
	assert false
}

test AMissingFileIsEmpty {
	assert len(try fresh(fstest.NewMemory()).All()) == 0
}
