// Board's tests run over an fstest.Memory: the tasks.Board laws (restated:
// ergo test skips them for this Board, which holds an fs.Files;
// expected-skips), the file's own form, and a corrupt line.

import fstest
import taskscli/tasks

// fresh is a Board in the file "tasks.txt" of disk.
func fresh(disk fstest.Memory) Board { Open("tasks.txt", disk, disk) }

test FileCreateNumbersInOrder(titles []string, p tasks.Priority) {
	with context { tasks.Board: fresh(fstest.NewMemory()) } {
		assert try tasks.CreateNumbersInOrderHolds(titles, p)
	}
}

test FileCloseClosesOnlyIt(title string, others []string) {
	with context { tasks.Board: fresh(fstest.NewMemory()) } {
		assert try tasks.CloseClosesOnlyItHolds(title, others)
	}
}

test FileCloseIsOnce(title string) {
	with context { tasks.Board: fresh(fstest.NewMemory()) } {
		assert try tasks.CloseIsOnceHolds(title)
	}
}

test FileCloseOfNoTaskIsNotFound(n int) {
	with context { tasks.Board: fresh(fstest.NewMemory()) } {
		assert try tasks.CloseOfNoTaskIsNotFoundHolds(n)
	}
}

test TheFileForm {
	let disk = fstest.NewMemory()
	let b = fresh(disk)
	let _ = try b.Create("write the spec", tasks.High)
	let _ = try b.Create("tab\there", tasks.Low)
	let _ = try b.Close(1)
	assert try disk.ReadFile("tasks.txt") == "1\tclosed\thigh\t\"write the spec\"\n2\topen\tlow\t\"tab\\there\"\n"
}

test ACorruptLineIsBroken {
	let disk = fstest.NewMemory()
	try disk.WriteFile("tasks.txt", "1\topen\tlow\t\"a\"\n3\topen\tlow\t\"b\"\n")
	fresh(disk).All() catch {
	case tasks.Broken as b:
		assert b.Reason == "tasks.txt:2: not a task: 3\topen\tlow\t\"b\""
		return
	}
	assert false
}

test AMissingFileIsEmpty {
	assert len(try fresh(fstest.NewMemory()).All()) == 0
}
