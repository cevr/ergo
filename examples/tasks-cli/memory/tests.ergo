// Board keeps the tasks.Board laws: each test runs one of tasks' checks on
// a new Board.

import tasks/tasks

test BoardCreateNumbersInOrder(titles []string, p tasks.Priority) {
	with context { tasks.Board: NewBoard() } {
		assert try tasks.CreateNumbersInOrderHolds(titles, p)
	}
}

test BoardCloseClosesOnlyIt(title string, others []string) {
	with context { tasks.Board: NewBoard() } {
		assert try tasks.CloseClosesOnlyItHolds(title, others)
	}
}

test BoardCloseIsOnce(title string) {
	with context { tasks.Board: NewBoard() } {
		assert try tasks.CloseIsOnceHolds(title)
	}
}

test BoardCloseOfNoTaskIsNotFound(n int) {
	with context { tasks.Board: NewBoard() } {
		assert try tasks.CloseOfNoTaskIsNotFoundHolds(n)
	}
}
