// The checks of Board's laws, one function per law, over the Board in the
// caller's context. A member law runs only for providers in its type's own
// package (G-exup-1), and a member law cannot call a function that needs
// its own type (gap G-ex-c-5), so a provider's tests call these.

// CreateNumbersInOrderHolds checks the law CreateNumbersInOrder.
func CreateNumbersInOrderHolds(titles []string, p Priority) bool fails Broken needs Board {
	let before = len(try Board.All())
	for i, title in titles {
		let t = try Board.Create(title, p)
		if t != (Task{ID: before + i + 1, Title: title, Priority: p, State: Open}) {
			return false
		}
	}
	let all = try Board.All()
	len(all) == before+len(titles) && (len(titles) == 0 || all[len(all)-1].Title == titles[len(titles)-1])
}

// CloseClosesOnlyItHolds checks the law CloseClosesOnlyIt.
func CloseClosesOnlyItHolds(title string, others []string) bool fails NotFound | AlreadyClosed | Broken needs Board {
	let t = try Board.Create(title, Low)
	for o in others {
		let _ = try Board.Create(o, High)
	}
	let before = try Board.All()
	let closed = try Board.Close(t.ID)
	let after = try Board.All()
	if closed != (Task{..t, State: Closed}) || len(after) != len(before) {
		return false
	}
	for i, a in after {
		let want = if a.ID == t.ID { closed } else { before[i] }
		if a != want {
			return false
		}
	}
	true
}

// CloseIsOnceHolds checks the law CloseIsOnce.
func CloseIsOnceHolds(title string) bool fails NotFound | AlreadyClosed | Broken needs Board {
	let t = try Board.Create(title, Medium)
	let _ = try Board.Close(t.ID)
	Board.Close(t.ID) catch {
	case AlreadyClosed as a:
		return a.ID == t.ID
	case NotFound as n:
		return n
	case Broken as b:
		return b
	}
	false
}

// CloseOfNoTaskIsNotFoundHolds checks the law CloseOfNoTaskIsNotFound.
func CloseOfNoTaskIsNotFoundHolds(n int) bool fails NotFound | AlreadyClosed | Broken needs Board {
	let id = len(try Board.All()) + 1 + (if n < 0 { -(n + 1) } else { n })%100
	Board.Close(id) catch {
	case NotFound as f:
		return f.ID == id
	case AlreadyClosed as c:
		return c
	case Broken as b:
		return b
	}
	false
}
