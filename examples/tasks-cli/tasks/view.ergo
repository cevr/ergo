import slices

// Which is the tasks a listing shows by state.
type Which = OpenOnly{} | ClosedOnly{} | Every{}

// Shows reports whether a listing of which and at least min shows t.
func Shows(t Task, which Which, min Priority) bool {
	let state = match which {
	case OpenOnly:
		IsOpen(t)
	case ClosedOnly:
		!IsOpen(t)
	case Every:
		true
	}
	state && Rank(t.Priority) >= Rank(min)
}

// View is the tasks that a listing of which and at least min shows, the
// most urgent first, and in the order they were created within one
// priority.
func View(tasks []Task, which Which, min Priority) []Task {
	let shown = slices.Filter(tasks, func(t Task) bool { Shows(t, which, min) })
	slices.SortStableFunc(shown, Before)
}

// ViewShowsWhatMatches: a listing holds each task that matches it, once,
// and no other.
law ViewShowsWhatMatches(tasks []Task, which Which, min Priority) {
	let numbered = numbered(tasks)
	let shown = View(numbered, which, min)
	let mut matching = 0
	for t in numbered {
		let mut seen = 0
		for s in shown {
			if s.ID == t.ID {
				seen = seen + 1
			}
		}
		let want = if matches(t, which, min) { 1 } else { 0 }
		if seen != want {
			return false
		}
		matching = matching + want
	}
	len(shown) == matching
}

// matches is the rule of a listing, written apart from Shows so the law
// checks it: which names the states shown, and min the least priority.
func matches(t Task, which Which, min Priority) bool {
	let state = match (which, t.State) {
	case (Every, Open), (Every, Closed), (OpenOnly, Open), (ClosedOnly, Closed):
		true
	case (OpenOnly, Closed), (ClosedOnly, Open):
		false
	}
	let mut atLeast = false
	for p in Priorities {
		if p == min {
			atLeast = true
		}
		if p == t.Priority {
			return state && atLeast
		}
	}
	false
}

// numbered is tasks with the IDs 1, 2, … in order, as a Board numbers
// them, so a generated list has distinct IDs.
func numbered(tasks []Task) []Task {
	let mut out = []Task{}
	for i, t in tasks {
		out = out.Append(Task{..t, ID: i + 1})
	}
	out
}

// ViewIsOrdered: a listing puts the more urgent task first, and the
// earlier one first within a priority.
law ViewIsOrdered(tasks []Task, which Which, min Priority) {
	let shown = View(numbered(tasks), which, min)
	for i, t in shown {
		if i > 0 && Before(shown[i-1], t) >= 0 {
			return false
		}
	}
	true
}

// Before compares a and b as a listing orders them: a negative number when
// a comes first.
func Before(a Task, b Task) int {
	if Rank(a.Priority) != Rank(b.Priority) {
		return Rank(b.Priority) - Rank(a.Priority)
	}
	a.ID - b.ID
}
