import slices

// A listing of each kind and the names. The listing laws run under ergo
// test; the Board laws run in package memory against memory.Board.

let a = Task{ID: 1, Title: "write the spec", Priority: Medium, State: Open}
let b = Task{ID: 2, Title: "fix the build", Priority: Urgent, State: Open}
let c = Task{ID: 3, Title: "old idea", Priority: Low, State: Closed}
let d = Task{ID: 4, Title: "ship it", Priority: Urgent, State: Open}

test AListingOfEachKind {
	assert slices.Equal(View([]Task{a, b, c, d}, OpenOnly, Low), []Task{b, d, a})
	assert slices.Equal(View([]Task{a, b, c, d}, ClosedOnly, Low), []Task{c})
	assert slices.Equal(View([]Task{a, b, c, d}, Every, High), []Task{b, d})
	assert slices.Equal(View([]Task{}, Every, Low), []Task{})
}

test PriorityNamesRoundTrip(p Priority) {
	assert PriorityNamed(PriorityName(p)) == Some[Priority]{Value: p}
	assert PriorityNamed("soon") == None
}
