import strconv
import strings
import taskscli/tasks
import cells text
import utf8

// Line is the text line of t: its number, priority, state and title in
// columns.
func Line(t tasks.Task) string {
	pad("#\(t.ID)", 5) + pad(tasks.PriorityName(t.Priority), 8) + pad(tasks.StateName(t.State), 8) + t.Title
}

// Lines is the text of a listing: a line per item, or "no tasks".
func Lines(items []tasks.Task) string {
	if len(items) == 0 {
		return "no tasks\n"
	}
	let mut out = ""
	for t in items {
		out = out + Line(t) + "\n"
	}
	out
}

// JSON is the JSON object of t, on one line.
func JSON(t tasks.Task) string {
	"{\"id\":\(t.ID),\"title\":" + Quote(t.Title) + ",\"priority\":\"" + tasks.PriorityName(t.Priority) + "\",\"state\":\"" + tasks.StateName(t.State) + "\"}"
}

// JSONList is the JSON array of items, on one line.
func JSONList(items []tasks.Task) string {
	let mut parts = []string{}
	for t in items {
		parts = parts.Append(JSON(t))
	}
	"[" + strings.Join(parts, ",") + "]"
}

// Quote is s as a JSON string: a quote, a backslash and each control
// character escaped, every other character written as it is. Ergo has no
// std json (G-ex-c-7).
func Quote(s string) string {
	let mut out = "\""
	for r in s {
		let text = match r {
		case '"':
			"\\\""
		case '\\':
			"\\\\"
		case _:
			if r < 32 { "\\u" + strings.PadLeft(strconv.FormatInt(int64(r), 16), 4, '0') } else { utf8.RuneText(r) }
		}
		out = out + text
	}
	out + "\""
}

// QuoteIsOneJSONString: a quoted title holds no control byte and no
// unescaped quote, so it is one JSON string on one line. Each text is
// checked as it is and with a quote, a backslash, a line feed and a tab
// after it, so every case meets each escape.
law QuoteIsOneJSONString(s string) { oneJSONString(Quote(s)) && oneJSONString(Quote(s+"\"\\\n\t")) }

// oneJSONString reports whether q is one JSON string: quoted, with no
// control byte and no unescaped quote inside.
func oneJSONString(q string) bool {
	if len(q) < 2 || q[0] != '"' || q[len(q)-1] != '"' {
		return false
	}
	let mut escaped = false
	for i in 1..len(q)-1 {
		let c = q[i]
		if c < 32 || (c == '"' && !escaped) {
			return false
		}
		escaped = !escaped && c == '\\'
	}
	!escaped
}

// pad is s with spaces after it to width terminal cells, and one space at
// least: a wide title or state keeps the columns aligned (std text.Cells).
func pad(s string, width int) string { cells.Pad(s, width-1) + " " }
