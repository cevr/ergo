import strconv
import strings
import taskscli/tasks
import utf8

// Line is the text line of t: its number, priority, state and title in
// columns.
func Line(t tasks.Task) string {
	pad("#\(t.ID)", 5) + pad(tasks.PriorityName(t.Priority), 8) + pad(tasks.StateName(t.State), 8) + t.Title
}

// Lines is the text of a listing: a line per item, or "no tasks".
func Lines(items []tasks.Task) string {
	if len(items) == 0 {
		return "no tasks\n"
	}
	let mut out = ""
	for t in items {
		out = out + Line(t) + "\n"
	}
	out
}

// JSON is the JSON object of t, on one line.
func JSON(t tasks.Task) string {
	"{\"id\":\(t.ID),\"title\":" + Quote(t.Title) + ",\"priority\":\"" + tasks.PriorityName(t.Priority) + "\",\"state\":\"" + tasks.StateName(t.State) + "\"}"
}

// JSONList is the JSON array of items, on one line.
func JSONList(items []tasks.Task) string {
	let mut parts = []string{}
	for t in items {
		parts = parts.Append(JSON(t))
	}
	"[" + strings.Join(parts, ",") + "]"
}

// Quote is s as a JSON string: a quote, a backslash and each control
// character escaped, every other character written as it is. Ergo has no
// std json (G-ex-c-7).
func Quote(s string) string {
	let mut out = "\""
	for r in s {
		let text = match r {
		case '"':
			"\\\""
		case '\\':
			"\\\\"
		case _:
			if r < 32 { "\\u" + strings.PadLeft(strconv.FormatInt(int64(r), 16), 4, '0') } else { utf8.RuneText(r) }
		}
		out = out + text
	}
	out + "\""
}

// pad is text with spaces after it to width, and one space at least.
func pad(text string, width int) string { strings.PadRight(text, width-1, ' ') + " " }
