// Package cli is the command line of tasks-cli: its commands and flags, the
// text and JSON it prints, the confirm prompt and the shell completions.

import flag
import strconv
import strings
import taskscli/tasks

// Shell is a shell that completions are written for.
type Shell = Bash{} | Zsh{} | Fish{}

// Cmd is one command line of tasks.
type Cmd = List{Which tasks.Which, Min tasks.Priority, JSON bool} | Create{Title string, Priority tasks.Priority, JSON bool} | Close{ID int, Yes bool, JSON bool} | Completion{Shell Shell}

// ArgsRoundTrip: the command line Args writes parses back to the command.
law ArgsRoundTrip(c Cmd) {
	let s = Sane(c)
	try Parse(Args(s)) == s
}

// Args is a command line that parses to c.
func Args(c Cmd) []string {
	match c {
	case List as l:
		let state = match l.Which {
		case tasks.OpenOnly:
			"open"
		case tasks.ClosedOnly:
			"closed"
		case tasks.Every:
			"all"
		}
		[]string{"list", "--state=" + state, "--min=" + tasks.PriorityName(l.Min), "--json=\(l.JSON)"}
	case Create as n:
		[]string{"create", "--priority", tasks.PriorityName(n.Priority), "--json=\(n.JSON)", "--", n.Title}
	case Close as d:
		[]string{"close", "--yes=\(d.Yes)", "--json=\(d.JSON)", "--", strconv.Itoa(d.ID)}
	case Completion as m:
		match m.Shell {
		case Bash:
			[]string{"completion", "bash"}
		case Zsh:
			[]string{"completion", "zsh"}
		case Fish:
			[]string{"completion", "fish"}
		}
	}
}

// Sane is c as a command line can carry it: a title of words with single
// spaces, and not empty.
func Sane(c Cmd) Cmd {
	match c {
	case Create as n:
		Create{..n, Title: strings.Join(strings.Fields("t "+n.Title), " ")}
	case List, Close, Completion:
		c
	}
}

let jsonFlag = flag.Bool("json", false, "print JSON")
let stateFlag = flag.Choice("state", "open", []string{"open", "closed", "all"}, "which tasks to list")
let minFlag = flag.Choice("min", "low", []string{"low", "medium", "high", "urgent"}, "the least priority to list")
let priorityFlag = flag.Choice("priority", "medium", []string{"low", "medium", "high", "urgent"}, "the priority of the task")
let yesFlag = flag.Bool("yes", false, "close without asking")
let titleArgs = flag.Remaining("title", "the title of the task, its words joined by spaces")
let idArg = flag.Arg("id", "the number of the task")
let shellArg = flag.Arg("shell", "bash, zsh or fish")

// Commands are the commands of tasks-cli, each parsed into a Cmd.
let Commands = []flag.Command[Cmd]{
	flag.Command[Cmd]{Name: "list", Usage: "list tasks, the most urgent first", Set: flag.Set{Name: "tasks-cli list", Usage: "", Flags: []flag.Flag{stateFlag, minFlag, jsonFlag}, Args: []flag.ArgSpec{}}, Build: buildList, Commands: []flag.Command[Cmd]{}},
	flag.Command[Cmd]{Name: "create", Usage: "create a task", Set: flag.Set{Name: "tasks-cli create", Usage: "", Flags: []flag.Flag{priorityFlag, jsonFlag}, Args: []flag.ArgSpec{titleArgs}}, Build: buildCreate, Commands: []flag.Command[Cmd]{}},
	flag.Command[Cmd]{Name: "close", Usage: "close a task, after asking", Set: flag.Set{Name: "tasks-cli close", Usage: "", Flags: []flag.Flag{yesFlag, jsonFlag}, Args: []flag.ArgSpec{idArg}}, Build: buildClose, Commands: []flag.Command[Cmd]{}},
	flag.Command[Cmd]{Name: "completion", Usage: "print the completion script of a shell", Set: flag.Set{Name: "tasks-cli completion", Usage: "", Flags: []flag.Flag{}, Args: []flag.ArgSpec{shellArg}}, Build: buildCompletion, Commands: []flag.Command[Cmd]{}},
}

// Parse reads args as a command line of tasks.
func Parse(args []string) Cmd fails flag.Failure {
	try flag.ParseCommand("tasks-cli", "tasks keeps a list of tasks in a file", Commands, args)
}

func buildList(v flag.Values) Cmd fails flag.Failure {
	// A Choice reads a string, so each match needs a case _ (G-ex-c-6).
	let which = match stateFlag.Get(v) {
	case "closed":
		tasks.ClosedOnly
	case "all":
		tasks.Every
	case _:
		tasks.OpenOnly
	}
	List{Which: which, Min: priority(minFlag.Get(v)), JSON: jsonFlag.Get(v)}
}

func buildCreate(v flag.Values) Cmd fails flag.Failure {
	let title = strings.TrimSpace(strings.Join(flag.Rest(v), " "))
	if title == "" {
		return flag.Missing{Name: "title"}
	}
	Create{Title: title, Priority: priority(priorityFlag.Get(v)), JSON: jsonFlag.Get(v)}
}

func buildClose(v flag.Values) Cmd fails flag.Failure {
	let text = text(idArg, v)
	let id = strconv.Atoi(text) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return flag.Invalid{Name: "id", Text: text, Reason: "not a task number"}
	}
	Close{ID: id, Yes: yesFlag.Get(v), JSON: jsonFlag.Get(v)}
}

func buildCompletion(v flag.Values) Cmd fails flag.Failure {
	match text(shellArg, v) {
	case "bash":
		Completion{Shell: Bash}
	case "zsh":
		Completion{Shell: Zsh}
	case "fish":
		Completion{Shell: Fish}
	case _ as other:
		flag.Invalid{Name: "shell", Text: other, Reason: "not bash, zsh or fish"}
	}
}

// priority is the priority of a name the parser has checked.
func priority(name string) tasks.Priority {
	match tasks.PriorityNamed(name) {
	case Some[tasks.Priority] as p:
		p.Value
	case None:
		tasks.Medium
	}
}

// text is the value of a required positional argument.
func text(a flag.ArgSpec, v flag.Values) string {
	match a.Get(v) {
	case Some[string] as s:
		s.Value
	case None:
		""
	}
}
