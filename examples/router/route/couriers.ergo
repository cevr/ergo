import actor
import machines

// Delivery: the dispatcher carries messages by the router's table. Each
// route has a courier, a child actor of the dispatcher's entry; a client
// names a route's courier before it exists through its host (actor.Host),
// so it can wait for it. The dispatcher keeps no table of its own: Use
// gives it the router's table, and each Use opens a new entry with new
// couriers.

// Courier carries the messages of one route; Sent counts them.
type Courier = Open{Route Route, Sent int}

// Carry is a message for a courier. A body "crash" makes the courier
// fail: a defect, which ends the dispatcher's incarnation too.
type Carry = Message{Body string}

// Delivered is a message a courier carried, which it tells the
// dispatcher.
type Delivered { Topic string, Dest string, Body string }

// Carried is a courier's step: count the message and tell it.
func Carried(s Courier, sig Carry) Decision[Courier, Delivered] {
	let c = match s {
	case Open as o:
		o
	}
	let m = match sig {
	case Message as g:
		g
	}
	if m.Body == "crash" {
		Unreachable("the courier of \(c.Route.Topic) crashed")
	}
	Emit[Courier, Delivered]{Next: Open{..c, Sent: c.Sent + 1}, Output: Delivered{Topic: c.Route.Topic, Dest: c.Route.Dest, Body: m.Body}}
}

func courierOf(r Route) Courier { Open{Route: r, Sent: 0} }

// Couriers is the courier as a machine; its input is its route.
type Couriers machine[Courier, Carry] {
	initial: courierOf,
	step:    Carried,
}

// Lane is a route and the host of its courier: empty until the entry's
// work starts the courier, closed when the entry ends.
type Lane { Route Route, Courier actor.Host[actor.Actor[Courier, Carry, Decision[Courier, Delivered]]] }

// Dispatch is the dispatcher's state: Waiting for a table, or Carrying by
// one, with a lane per route and the messages carried in this entry,
// in the order the couriers told them.
type Dispatch = Waiting{} | Carrying{Lanes []Lane, Log []Delivered}

// DispatchSignal is what the dispatcher reads: a table to carry by, and
// the messages its couriers tell.
type DispatchSignal = Use{Table Table} | Told{Delivered Delivered}

// lanes is a lane with a new host for each route of t. NewHost runs in
// the step that enters the state, so the entry owns the hosts.
func lanes(t Table) []Lane {
	let mut out = []Lane{}
	for r in t.Routes {
		out = out.Append(Lane{Route: r, Courier: actor.NewHost[actor.Actor[Courier, Carry, Decision[Courier, Delivered]]]()})
	}
	out
}

// Dispatched is the dispatcher's step: Use opens an entry with a courier
// per route; a told message is kept in the log of the entry.
func Dispatched(s Dispatch, sig DispatchSignal) Decision[Dispatch, Delivered] {
	match sig {
	case Use as u:
		Enter[Dispatch]{Next: Carrying{Lanes: lanes(u.Table), Log: []Delivered{}}}
	case Told as t:
		match s {
		case Carrying as c:
			Stay[Dispatch]{Next: Carrying{..c, Log: c.Log.Append(t.Delivered)}}
		case Waiting:
			Ignore
		}
	}
}

func told(d Delivered) DispatchSignal { Told{Delivered: d} }

// couriers is the work of each state: Carrying starts the courier of
// each lane in its host, a child of the entry.
func couriers(s Dispatch) Option[machines.Work[DispatchSignal, Scheduler]] {
	match s {
	case Carrying as c:
		Some{machines.Work{Listen: func(send func(e DispatchSignal)) needs Scheduler {
			for l in c.Lanes {
				let _ = actor.ChildIn(send, l.Courier, machines.Start(Couriers{}, l.Route), 4, told)
			}
		}}}
	case Waiting:
		None
	}
}

// Dispatcher is the dispatcher as a machine.
type Dispatcher machine[Dispatch, DispatchSignal] {
	initial: Waiting,
	step:    Dispatched,
	work:    couriers,
}

// LaneOf is the lane of topic in s, if s carries it.
func LaneOf(s Dispatch, topic string) Option[Lane] {
	match s {
	case Carrying as c:
		for l in c.Lanes {
			if l.Route.Topic == topic {
				return Some[Lane]{Value: l}
			}
		}
		None
	case Waiting:
		None
	}
}

// LogOf is the messages s carried.
func LogOf(s Dispatch) []Delivered {
	match s {
	case Carrying as c:
		c.Log
	case Waiting:
		[]Delivered{}
	}
}
