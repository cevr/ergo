// The journal's tests: its lines, a corrupt file, a disk that fails, and
// the ledger.Store laws and the journal's own, restated as property tests
// (#162). The journal runs on a memory Disk, never on the host.

import fs
import ledger/ledger
import ledger/memory

// Broken is a disk that fails every read and write.
type Broken { reason string }

func ReadFile(b Broken, path string) string fails fs.NotFound | fs.Denied | fs.Failed {
	fs.Failed{Path: path, Reason: b.reason}
}

func ReadDir(b Broken, path string) []string fails fs.NotFound | fs.Denied | fs.Failed {
	fs.Failed{Path: path, Reason: b.reason}
}

func Stat(b Broken, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed {
	fs.Failed{Path: path, Reason: b.reason}
}

func WriteFile(b Broken, path string, text string) fails fs.NotFound | fs.Denied | fs.Failed {
	fs.Failed{Path: path, Reason: b.reason}
}

func MkdirAll(b Broken, path string) fails fs.Denied | fs.Failed {
	fs.Failed{Path: path, Reason: b.reason}
}

// on is a Journal at bank.journal on the Disk d.
func on(d memory.Disk) Journal { At("bank.journal", d, d) }

// day is a Journal on a fresh Disk with the accounts of ledger.Bank and
// the transfers of ledger.Day(ns) posted.
func day(ns []int) ledger.Store {
	let text, _ = Written(ledger.Day(ns))
	on(memory.NewDisk(Map[string, string]{"bank.journal": text}))
}

// total is the sum of the balances of s.
func total(s ledger.Store) int64 fails ledger.UnknownAccount | ledger.Unavailable {
	let mut sum = int64(0)
	for id in try s.Accounts() {
		let b = try s.Balance(id)
		sum = sum + b
	}
	sum
}

// why is the reason s is unavailable for Accounts, or "ok".
func why(s ledger.Store) string {
	let _ = s.Accounts() catch {
	case ledger.Unavailable as u:
		return u.Reason
	}
	"ok"
}

// tried is what became of a Post of t on s.
func tried(s ledger.Store, t ledger.Transfer) string {
	let r = s.Post(t) catch {
	case ledger.InsufficientFunds as f:
		return "insufficient \(f.Balance)"
	case ledger.KeyReused, ledger.BadAmount, ledger.SameAccount, ledger.UnknownAccount, ledger.Unavailable:
		return "refused"
	}
	"posted \(r.Seq)"
}

test WritesOneLineEach {
	let d = memory.NewDisk(Map[string, string]{})
	let s ledger.Store = on(d)
	try s.Open("alice", 0)
	let _ = try s.Post(ledger.Transfer{Key: "d1", From: ledger.World, To: "alice", Amount: 250})
	let _ = try s.Post(ledger.Transfer{Key: "d1", From: ledger.World, To: "alice", Amount: 250})
	let r fs.Files = d
	assert try r.ReadFile("bank.journal") == "open\t\"alice\"\t0\npost\t\"d1\"\t\"world\"\t\"alice\"\t250\n"
	assert try s.Balance("alice") == 250
}

test ARefusalWritesNothing {
	let d = memory.NewDisk(Map[string, string]{})
	let s ledger.Store = on(d)
	try s.Open("alice", 0)
	assert tried(s, ledger.Transfer{Key: "p", From: "alice", To: ledger.World, Amount: 1}) == "insufficient 0"
	let r fs.Files = d
	assert try r.ReadFile("bank.journal") == "open\t\"alice\"\t0\n"
}

test CorruptIsUnavailable {
	assert why(on(memory.NewDisk(Map[string, string]{"bank.journal": "open\t\"a\"\t0\nopen\t\"a\"\t0\n"}))) == "bank.journal:2: the account a does not open"
	assert why(on(memory.NewDisk(Map[string, string]{"bank.journal": "post\t\"k\"\t\"world\"\t\"a\"\t5\n"}))) == "bank.journal:1: the transfer k does not post"
	assert why(on(memory.NewDisk(Map[string, string]{"bank.journal": "open\talice\t0\n"}))) == "bank.journal:1: alice is not a quoted word"
	assert why(on(memory.NewDisk(Map[string, string]{"bank.journal": "close\t\"a\"\n"}))) == "bank.journal:1: not an open or a post line"
	assert why(At("bank.journal", Broken{reason: "disk on fire"}, Broken{reason: "disk on fire"})) == "bank.journal: disk on fire"
	assert why(on(memory.NewDisk(Map[string, string]{}))) == "ok"
}

test TotalIsKeptHolds(ns []int, m int) {
	let s = day(ns)
	let t = ledger.Day([]int{m})[0]
	let before = try total(s)
	let _ = s.Post(t) catch {
	case ledger.KeyReused, ledger.BadAmount, ledger.SameAccount, ledger.UnknownAccount, ledger.InsufficientFunds, ledger.Unavailable:
		assert try total(s) == before
		return
	}
	assert try total(s) == before
}

test PostIsIdempotentHolds(ns []int, m int) {
	let s = day(ns)
	let t = ledger.Day([]int{m})[0]
	let first = s.Post(t) catch {
	case ledger.KeyReused, ledger.BadAmount, ledger.SameAccount, ledger.UnknownAccount, ledger.InsufficientFunds, ledger.Unavailable:
		return
	}
	let from = try s.Balance(t.From)
	assert try s.Post(t) == first
	assert try s.Balance(t.From) == from
}

test FloorHoldsHolds(ns []int, m int) {
	let s = day(ns)
	let t = ledger.Day([]int{m})[0]
	s.Open("erin", 0) catch {
	case ledger.AccountExists, ledger.BadFloor, ledger.Unavailable:
		assert false
		return
	}
	let _ = s.Post(ledger.Transfer{..t, From: "erin"}) catch {
	case ledger.KeyReused, ledger.BadAmount, ledger.SameAccount, ledger.UnknownAccount, ledger.InsufficientFunds, ledger.Unavailable:
		assert try s.Balance("erin") == 0
		return
	}
	assert try s.Balance("erin") >= 0
}

test ReplayRebuildsHolds(ns []int) {
	let text, b = Written(ledger.Day(ns))
	assert Agree(try Replay(text), b)
}

test AnyWordKeepsHolds(id string, key string) {
	if id == "" || id == ledger.World {
		return
	}
	let b = try Replay(OpenLine(id, 0) + PostLine(ledger.Transfer{Key: key, From: ledger.World, To: id, Amount: 7}))
	assert try ledger.Balance(b, id) == 7
}
