import fs
import ledger/ledger

// Journal is a ledger.Store over the journal file at path. It reads the
// file through read and writes it through write, which the program binds:
// the host's file system, or a memory Disk in a test. Each operation
// replays the file and, when it changes the ledger, writes the file with
// one more line (fs.Writes has no append: gaps G-ex-b-14).
type Journal { path string, read fs.Files, write fs.Writes }

// At is the journal at path. A missing file is an empty ledger.
func At(path string, read fs.Files, write fs.Writes) Journal {
	Journal{path: path, read: read, write: write}
}

// load is the journal's text and its Book.
func load(j Journal) (string, ledger.Book) fails ledger.Unavailable {
	let text = j.read.ReadFile(j.path) catch {
	case fs.NotFound:
		""
	case fs.Denied:
		return ledger.Unavailable{Reason: "\(j.path): permission denied"}
	case fs.Failed as f:
		return ledger.Unavailable{Reason: "\(j.path): \(f.Reason)"}
	}
	let b = Replay(text) catch {
	case Corrupt as c:
		return ledger.Unavailable{Reason: "\(j.path):\(c.Line): \(c.Reason)"}
	}
	(text, b)
}

// keep writes text to the journal's file.
func keep(j Journal, text string) fails ledger.Unavailable {
	j.write.WriteFile(j.path, text) catch {
	case fs.NotFound:
		return ledger.Unavailable{Reason: "\(j.path): no such directory"}
	case fs.Denied:
		return ledger.Unavailable{Reason: "\(j.path): permission denied"}
	case fs.Failed as f:
		return ledger.Unavailable{Reason: "\(j.path): \(f.Reason)"}
	}
}

// Open opens the account id with its floor, and writes its line.
func Open(j Journal, id string, floor int64) fails ledger.AccountExists | ledger.BadFloor | ledger.Unavailable {
	let text, b = try load(j)
	let _ = try ledger.Open(b, id, floor)
	try keep(j, text+OpenLine(id, floor))
}

// Post posts t, and writes its line unless its key was posted before.
func Post(j Journal, t ledger.Transfer) ledger.Receipt fails ledger.KeyReused | ledger.BadAmount | ledger.SameAccount | ledger.UnknownAccount | ledger.InsufficientFunds | ledger.Unavailable {
	let text, b = try load(j)
	let next, r = try ledger.Apply(b, t)
	if ledger.Count(next) != ledger.Count(b) {
		try keep(j, text+PostLine(t))
	}
	r
}

// Balance is the balance of id.
func Balance(j Journal, id string) int64 fails ledger.UnknownAccount | ledger.Unavailable {
	let _, b = try load(j)
	try ledger.Balance(b, id)
}

// Accounts is the accounts, World first and then by name.
func Accounts(j Journal) []string fails ledger.Unavailable {
	let _, b = try load(j)
	ledger.IDs(b)
}
