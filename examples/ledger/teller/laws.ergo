import strconv
import strings

// AmountReadsDollars: Amount reads back every sum Dollars writes, so an
// answer of the counter can be typed in again.
law AmountReadsDollars(cents int64) {
	if cents < 0 || cents > 9000000000000000000 {
		return true
	}
	let back = Amount(strings.TrimPrefix(Dollars(cents), "$")) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return false
	}
	back == cents
}
