import ledger/ledger

// Do carries out c on the Store and says what became of it. A refusal is
// an answer, not a failure: the teller reads it out and goes on. Only a
// store that is unavailable stops the counter.
func Do(c Command) string fails ledger.Unavailable needs ledger.Store {
	match c {
	case OpenCmd as o:
		ledger.Store.Open(o.ID, o.Floor) catch {
		case ledger.AccountExists as e:
			return "refused: \(e.ID) is open already"
		case ledger.BadFloor as b:
			return "refused: \(b.ID) cannot start below its floor \(Dollars(b.Floor))"
		case ledger.Unavailable as u:
			return u
		}
		if o.Floor < 0 { "opened \(o.ID), overdraft \(Dollars(-o.Floor))" } else { "opened \(o.ID)" }
	case Deposit as d:
		try post(ledger.Transfer{Key: d.Key, From: ledger.World, To: d.ID, Amount: d.Amount})
	case Withdraw as w:
		try post(ledger.Transfer{Key: w.Key, From: w.ID, To: ledger.World, Amount: w.Amount})
	case Pay as p:
		try post(ledger.Transfer{Key: p.Key, From: p.From, To: p.To, Amount: p.Amount})
	case BalanceCmd as b:
		let v = ledger.Store.Balance(b.ID) catch {
		case ledger.UnknownAccount as u:
			return "refused: no account \(u.ID)"
		case ledger.Unavailable as u:
			return u
		}
		"\(b.ID) \(Dollars(v))"
	case List:
		let mut out = ""
		for id in try ledger.Store.Accounts() {
			let v = ledger.Store.Balance(id) catch {
			case ledger.UnknownAccount:
				continue
			case ledger.Unavailable as u:
				return u
			}
			out = out + (if out == "" { "" } else { ", " }) + "\(id) \(Dollars(v))"
		}
		out
	}
}

// post posts t and says so, or says why the ledger refused it.
func post(t ledger.Transfer) string fails ledger.Unavailable needs ledger.Store {
	let r = ledger.Store.Post(t) catch {
	case ledger.KeyReused as k:
		return "refused \(t.Key): the key was used for \(Dollars(k.Was.Amount)) from \(k.Was.From) to \(k.Was.To)"
	case ledger.BadAmount as a:
		return "refused \(t.Key): \(Dollars(a.Amount)) is not an amount to move"
	case ledger.SameAccount as s:
		return "refused \(t.Key): \(s.ID) pays itself"
	case ledger.UnknownAccount as u:
		return "refused \(t.Key): no account \(u.ID)"
	case ledger.InsufficientFunds as f:
		return "refused \(t.Key): \(f.ID) has \(Dollars(f.Balance)), \(Dollars(f.Amount)) would take it below \(Dollars(f.Floor))"
	case ledger.Unavailable as u:
		return u
	}
	"#\(r.Seq) \(r.Key): \(Dollars(r.Amount)) from \(r.From) to \(r.To)"
}

// Serve carries out each command in turn, and is the answer to each.
func Serve(cs []Command) []string fails ledger.Unavailable needs ledger.Store {
	let mut out = []string{}
	for c in cs {
		out = out.Append(try Do(c))
	}
	out
}
