// Package teller is the bank's counter: it reads a teller's commands,
// one per line, and carries each out on a ledger.Store, saying what
// became of it. It knows no store; the program binds one.

import strconv
import strings

// Command is one line a teller writes.
type Command = OpenCmd{ID string, Floor int64} | Deposit{Key string, ID string, Amount int64} | Withdraw{Key string, ID string, Amount int64} | Pay{Key string, From string, To string, Amount int64} | BalanceCmd{ID string} | List{}

// BadCommand is a line that does not read.
type BadCommand { Line int, Reason string }

// Dollars is the text of cents as money: "$12.05", "-$0.40".
func Dollars(cents int64) string {
	let sign = if cents < 0 { "-" } else { "" }
	let c = if cents < 0 { -cents } else { cents }
	let rest = c % 100
	let pad = if rest < 10 { "0" } else { "" }
	"\(sign)$\(c / 100).\(pad)\(rest)"
}

// Amount reads an amount of money with at most two places after the
// point, as "12", "12.5" or "12.05", in cents. The std has no decimal
// type, so the program reads its own.
func Amount(text string) int64 fails strconv.Malformed | strconv.OutOfRange {
	let whole, part = match strings.Cut(text, ".") {
	case Some[strings.Halves] as h:
		(h.Value.Before, h.Value.After)
	case None:
		(text, "")
	}
	if whole == "" || len(part) > 2 || strings.HasPrefix(whole, "-") || strings.HasPrefix(whole, "+") || strings.HasPrefix(part, "-") || strings.HasPrefix(part, "+") {
		return strconv.Malformed{Text: text}
	}
	let w = try strconv.ParseInt(whole, 10, 64)
	let p = if part == "" { int64(0) } else { try strconv.ParseInt(part, 10, 64) }
	let cents = if len(part) == 1 { p * 10 } else { p }
	if w > 90000000000000000 {
		return strconv.OutOfRange{Text: text}
	}
	w*100 + cents
}

// Parse is the command of a line, numbered n for its failure.
func Parse(n int, line string) Command fails BadCommand {
	let w = strings.Fields(line)
	let verb = if len(w) > 0 { w[0] } else { "" }
	match (verb, len(w)) {
	case ("open", 2):
		OpenCmd{ID: w[1], Floor: 0}
	case ("open", 3):
		OpenCmd{ID: w[1], Floor: -(try money(n, w[2]))}
	case ("deposit", 4):
		Deposit{Key: w[1], ID: w[2], Amount: try money(n, w[3])}
	case ("withdraw", 4):
		Withdraw{Key: w[1], ID: w[2], Amount: try money(n, w[3])}
	case ("pay", 5):
		Pay{Key: w[1], From: w[2], To: w[3], Amount: try money(n, w[4])}
	case ("balance", 2):
		BalanceCmd{ID: w[1]}
	case ("accounts", 1):
		List
	case _:
		BadCommand{Line: n, Reason: "\(strings.TrimSpace(line)) is not open ID [OVERDRAFT], deposit KEY ID AMOUNT, withdraw KEY ID AMOUNT, pay KEY FROM TO AMOUNT, balance ID or accounts"}
	}
}

// money is the amount w on line n.
func money(n int, w string) int64 fails BadCommand {
	Amount(w) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return BadCommand{Line: n, Reason: "\(w) is not an amount such as 12.50"}
	}
}

// ParseAll is the commands of text, one per line; a blank line and a
// line from # on are skipped.
func ParseAll(text string) []Command fails BadCommand {
	let mut out = []Command{}
	for i, raw in strings.Split(text, "\n") {
		let line = match strings.Cut(raw, "#") {
		case Some[strings.Halves] as h:
			h.Value.Before
		case None:
			raw
		}
		if strings.TrimSpace(line) == "" {
			continue
		}
		out = out.Append(try Parse(i+1, line))
	}
	out
}
