// The counter's tests: money, the command reader and a morning at the
// counter on a memory store (the law runs in laws.ergo).

import ledger/ledger
import ledger/memory
import strconv

// reason is why text does not read, or "ok".
func reason(text string) string {
	let _ = ParseAll(text) catch {
	case BadCommand as b:
		return "line \(b.Line): \(b.Reason)"
	}
	"ok"
}

// counter is the answers to text at a counter on a fresh memory store.
func counter(text string) []string fails BadCommand | ledger.Unavailable {
	let cs = try ParseAll(text)
	with context { ledger.Store: memory.NewStore() } { try Serve(cs) }
}

test WritesDollars {
	assert Dollars(0) == "$0.00" && Dollars(5) == "$0.05" && Dollars(1250) == "$12.50" && Dollars(-40) == "-$0.40"
}

test ReadsAmounts {
	assert try Amount("12") == 1200
	assert try Amount("12.5") == 1250
	assert try Amount("0.07") == 7
	let _ = Amount("1.234") catch {
	case strconv.Malformed as m:
		assert m.Text == "1.234"
		return
	case strconv.OutOfRange:
		assert false
		return
	}
	assert false
}

test RefusesBadLines {
	assert reason("open alice\npay p1 alice bob\n") == "line 2: pay p1 alice bob is not open ID [OVERDRAFT], deposit KEY ID AMOUNT, withdraw KEY ID AMOUNT, pay KEY FROM TO AMOUNT, balance ID or accounts"
	assert reason("deposit d1 alice -5") == "line 1: -5 is not an amount such as 12.50"
	assert reason("# nothing\n\nopen bob 100 # an overdraft\n") == "ok"
}

test AMorningAtTheCounter {
	let out = try counter("open alice\nopen bob 100\ndeposit d1 alice 50\npay p1 alice bob 20.25\npay p1 alice bob 20.25\npay p2 bob alice 150\npay p3 alice carol 1\npay p1 alice bob 3\nwithdraw w1 alice 30\nbalance alice\naccounts\nopen alice\n")
	assert out[0] == "opened alice"
	assert out[1] == "opened bob, overdraft $100.00"
	assert out[2] == "#1 d1: $50.00 from world to alice"
	assert out[3] == "#2 p1: $20.25 from alice to bob"
	assert out[4] == "#2 p1: $20.25 from alice to bob"
	assert out[5] == "refused p2: bob has $20.25, $150.00 would take it below -$100.00"
	assert out[6] == "refused p3: no account carol"
	assert out[7] == "refused p1: the key was used for $20.25 from alice to bob"
	assert out[8] == "refused w1: alice has $29.75, $30.00 would take it below $0.00"
	assert out[9] == "alice $29.75"
	assert out[10] == "world -$50.00, alice $29.75, bob $20.25"
	assert out[11] == "refused: alice is open already"
	assert len(out) == 12
}
