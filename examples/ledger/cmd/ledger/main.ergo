// ledger is a bank's counter: it reads a teller's commands on standard
// input, one per line, and answers each. Package ledger is the
// double-entry Book and the Store contract, teller the commands, memory
// and file the two stores. This binary is the only place that chooses
// the store: a memory one, or with -journal a journal file on the host's
// disk, which outlives the run.

import flag
import fs
import fstest
import io
import ledger/file
import ledger/ledger
import ledger/memory
import ledger/teller
import os

let Journal = flag.String("journal", "", "keep the ledger in the journal `file`; without it the ledger lives in memory for one run")

// Set is the command line's flags.
func Set() flag.Set {
	flag.Set{Name: "ledger", Usage: "ledger answers a teller's commands from standard input: open ID [OVERDRAFT], deposit KEY ID AMOUNT, withdraw KEY ID AMOUNT, pay KEY FROM TO AMOUNT, balance ID, accounts.", Flags: []flag.Flag{Journal}, Args: []flag.ArgSpec{}}
}

// read is the journal path of args ("" for memory), None after help, or
// the end of the program.
func read(args []string) Option[string] fails os.Exit needs io.Stdout {
	let set = Set()
	let v = flag.Parse(set, args) catch {
	case err:
		try flag.Exit(err, flag.Usage(set))
		return None
	}
	Some[string]{Value: Journal.Get(v)}
}

func main() fails os.Exit needs Ambient {
	let disk = fs.NewHost()
	with context { os.Process: os.NewHost(), io.Stdout: io.NewHost(), io.Stdin: io.NewStdin() } { try run(os.Process.Args(), disk, disk) }
}

// run is the program after main binds the host. The disk is a parameter,
// not a capability, because only the journal store uses it, and a test
// gives an fstest.Memory.
func run(args []string, disk fs.Files, writes fs.Writes) fails os.Exit needs io.Stdout | io.Stdin {
	let path = match try read(args) {
	case Some[string] as s:
		s.Value
	case None:
		return
	}
	let text = io.Stdin.ReadAll() catch {
	case io.ReadFailed as r:
		return os.Exit{Code: 1, Message: "ledger: \(r.Reason)"}
	}
	let cs = teller.ParseAll(text) catch {
	case teller.BadCommand as b:
		return os.Exit{Code: 2, Message: "ledger: line \(b.Line): \(b.Reason)"}
	}
	let store ledger.Store = if path == "" { memory.NewStore() } else { file.At(path, disk, writes) }
	with context { ledger.Store: store } { serve(cs) } catch {
	case ledger.Unavailable as u:
		return os.Exit{Code: 1, Message: "ledger: \(u.Reason)"}
	}
}

// serve answers each command as it is carried out, so the answers before
// a store fails are written.
func serve(cs []teller.Command) fails ledger.Unavailable needs ledger.Store | io.Stdout {
	for c in cs {
		io.Stdout.Println(try teller.Do(c))
	}
}

// session is the output of a run of args on input, with disk as the
// host's file system, or the exit it ends with.
func session(args []string, input string, disk fstest.Memory) string {
	let out = io.NewRecorder()
	with context { io.Stdout: out, io.Stdin: io.Input{Text: input} } { run(args, disk, disk) } catch {
	case os.Exit as e:
		return out.Text() + "exit \(e.Code): \(e.Message)"
	}
	out.Text()
}

test MemoryForgets {
	let d = fstest.NewMemory()
	assert session([]string{}, "open alice\ndeposit d1 alice 5\n", d) == "opened alice\n#1 d1: $5.00 from world to alice\n"
	assert session([]string{}, "balance alice\n", d) == "refused: no account alice\n"
}

test JournalRemembers {
	let d = fstest.NewMemory()
	let args = []string{"-journal", "bank.journal"}
	assert session(args, "open alice\ndeposit d1 alice 5\n", d) == "opened alice\n#1 d1: $5.00 from world to alice\n"
	assert session(args, "deposit d1 alice 5\ndeposit d2 alice 2.50\nbalance alice\n", d) == "#1 d1: $5.00 from world to alice\n#2 d2: $2.50 from world to alice\nalice $7.50\n"
	assert try d.ReadFile("bank.journal") == "open\t\"alice\"\t0\npost\t\"d1\"\t\"world\"\t\"alice\"\t500\npost\t\"d2\"\t\"world\"\t\"alice\"\t250\n"
}

test RefusalsExit {
	let d = try memory.Files(Map[string, string]{"bad.journal": "open\talice\t0\n"})
	assert session([]string{"-journal", "bad.journal"}, "open bob\naccounts\n", d) == "exit 1: ledger: bad.journal:1: alice is not a quoted word"
	assert session([]string{}, "open\n", d) == "exit 2: ledger: line 1: open is not open ID [OVERDRAFT], deposit KEY ID AMOUNT, withdraw KEY ID AMOUNT, pay KEY FROM TO AMOUNT, balance ID or accounts"
	assert session([]string{"-h"}, "", d) == flag.Usage(Set())
}
