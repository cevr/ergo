// Package ledger is a double-entry bank ledger. Money moves only by a
// Transfer, which takes an amount from one account and gives it to
// another, so the balances of all the accounts always add up to zero.
// Money comes in from outside through the account World, which may go as
// far below zero as it must. A Transfer has a key: a second Transfer with
// the same key is the first one again, not a second payment.
//
// Book is the pure ledger, and Ledger the contract a store keeps; the
// stores live in the packages memory and file.

import slices

// World is the account that money from outside the bank comes from and
// goes to. Every Book has it.
let World = "world"

// WorldFloor is how far below zero World may go.
let WorldFloor = int64(-1000000000000)

// Transfer is a request to move Amount cents from From to To, once for
// its Key.
type Transfer { Key string, From string, To string, Amount int64 }

// Receipt is a transfer the ledger made, and its place in the journal.
type Receipt { Key string, From string, To string, Amount int64, Seq int }

// The failures of the ledger.

// UnknownAccount is an account the ledger has not opened.
type UnknownAccount { ID string }

// AccountExists is an account opened twice.
type AccountExists { ID string }

// BadFloor is a lowest balance above zero: an account opens at zero, so
// it would start below its floor.
type BadFloor { ID string, Floor int64 }

// BadAmount is a transfer of nothing or less.
type BadAmount { Amount int64 }

// SameAccount is a transfer from an account to itself.
type SameAccount { ID string }

// InsufficientFunds is a transfer that would take From below its floor.
type InsufficientFunds { ID string, Balance int64, Amount int64, Floor int64 }

// KeyReused is a key already used by a different transfer.
type KeyReused { Key string, Was Receipt }

// Unavailable is a store that cannot read or keep the ledger.
type Unavailable { Reason string }

// Book is the ledger as a value: each account's floor and balance, and
// the receipt of each key. Its fields are unexported, so only this package
// changes it, and only by Open and Apply.
type Book { floors Map[string, int64], balances Map[string, int64], receipts Map[string, Receipt], count int }

// Empty is a Book with only World in it.
func Empty() Book {
	Book{floors: Map[string, int64]{World: WorldFloor}, balances: Map[string, int64]{World: 0}, receipts: Map[string, Receipt]{}, count: 0}
}

// clone is a copy of m. A Map is shared by every copy of a Book (stdlib.md,
// Slices and Maps; #197), so a change goes into a copy, and the Book given
// stays as it was.
func clone[K comparable, V](m Map[K, V]) Map[K, V] {
	let mut out = Map[K, V]{}
	for k, v in m {
		out[k] = v
	}
	out
}

// Open is b with the account id, at zero, which may go down to floor.
func Open(b Book, id string, floor int64) Book fails AccountExists | BadFloor {
	match b.floors.Get(id) {
	case Some[int64]:
		return AccountExists{ID: id}
	case None:
	}
	if floor > 0 {
		return BadFloor{ID: id, Floor: floor}
	}
	let mut floors = clone(b.floors)
	let mut balances = clone(b.balances)
	floors[id] = floor
	balances[id] = 0
	Book{..b, floors: floors, balances: balances}
}

// Balance is the balance of id in b.
func Balance(b Book, id string) int64 fails UnknownAccount {
	match b.balances.Get(id) {
	case Some[int64] as v:
		v.Value
	case None:
		UnknownAccount{ID: id}
	}
}

// floor is the lowest balance id may have in b.
func floor(b Book, id string) int64 fails UnknownAccount {
	match b.floors.Get(id) {
	case Some[int64] as v:
		v.Value
	case None:
		UnknownAccount{ID: id}
	}
}

// Same reports whether r is the receipt of t.
func Same(r Receipt, t Transfer) bool {
	r.Key == t.Key && r.From == t.From && r.To == t.To && r.Amount == t.Amount
}

// Apply is b after t, and its receipt. A key used before gives its first
// receipt and the same Book when the transfer is the same, and KeyReused
// when it is not. The guards are, in order: the key, the amount, the
// accounts, and the floor of From.
func Apply(b Book, t Transfer) (Book, Receipt) fails KeyReused | BadAmount | SameAccount | UnknownAccount | InsufficientFunds {
	match b.receipts.Get(t.Key) {
	case Some[Receipt] as r:
		if Same(r.Value, t) {
			return (b, r.Value)
		}
		return KeyReused{Key: t.Key, Was: r.Value}
	case None:
	}
	if t.Amount <= 0 {
		return BadAmount{Amount: t.Amount}
	}
	if t.From == t.To {
		return SameAccount{ID: t.From}
	}
	let from = try Balance(b, t.From)
	let to = try Balance(b, t.To)
	let low = try floor(b, t.From)
	if from-t.Amount < low {
		return InsufficientFunds{ID: t.From, Balance: from, Amount: t.Amount, Floor: low}
	}
	let r = Receipt{Key: t.Key, From: t.From, To: t.To, Amount: t.Amount, Seq: b.count + 1}
	let mut balances = clone(b.balances)
	let mut receipts = clone(b.receipts)
	balances[t.From] = from - t.Amount
	balances[t.To] = to + t.Amount
	receipts[t.Key] = r
	(Book{..b, balances: balances, receipts: receipts, count: b.count + 1}, r)
}

// Total is the sum of every balance in b: zero, always (law Balances).
func Total(b Book) int64 {
	let mut sum = int64(0)
	for v in b.balances {
		sum = sum + v
	}
	sum
}

// IDs is the accounts of b, World first and then by name.
func IDs(b Book) []string {
	let mut names = []string{}
	for id, _ in b.balances {
		if id != World {
			names = names.Append(id)
		}
	}
	let mut out = []string{World}
	for id in slices.Sort(names) {
		out = out.Append(id)
	}
	out
}

// Count is the number of transfers b has made.
func Count(b Book) int { b.count }
