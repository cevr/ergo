// The rules of the Book as laws. Each runs a day of transfers among three
// accounts, made from a list of numbers, so a law over any list meets
// deposits, payments, refusals and keys used again.

// Bank is a Book with alice (floor 0), bob (an overdraft of 500) and
// carol (floor 0) opened.
func Bank() Book {
	let b = Open(Empty(), "alice", 0) catch {
	case AccountExists, BadFloor:
		Empty()
	}
	let c = Open(b, "bob", -500) catch {
	case AccountExists, BadFloor:
		b
	}
	Open(c, "carol", 0) catch {
	case AccountExists, BadFloor:
		c
	}
}

// who is one of the accounts of Bank, or a stranger, by n.
func who(n int) string {
	match n % 5 {
	case 0:
		World
	case 1:
		"alice"
	case 2:
		"bob"
	case 3:
		"carol"
	case _:
		"dave"
	}
}

// Day is the transfers of ns: each n picks a key (one of 8, so keys come
// back), the two accounts and an amount from -10 to 400.
func Day(ns []int) []Transfer {
	let mut out = []Transfer{}
	for n in ns {
		let k = if n < 0 { -(n % 1000003) } else { n % 1000003 }
		out = out.Append(Transfer{Key: "k\(k % 8)", From: who(k / 8), To: who(k / 40), Amount: int64(k%411) - 10})
	}
	out
}

// Posted is b after every transfer of ts that it takes; a refused one
// changes nothing.
func Posted(b Book, ts []Transfer) Book {
	let mut now = b
	for t in ts {
		let next, _ = Apply(now, t) catch {
		case KeyReused, BadAmount, SameAccount, UnknownAccount, InsufficientFunds:
			continue
		}
		now = next
	}
	now
}

// Balances: the balances of a Book always add up to zero.
law Balances(ns []int) {
	Total(Posted(Bank(), Day(ns))) == 0
}

// ApplyIsIdempotent: a transfer applied again gives its first receipt and
// the same balances. The transfer is one of Day's, so it meets the
// accounts and keys of the day.
law ApplyIsIdempotent(ns []int, m int) {
	let t = Day([]int{m})[0]
	let b = Posted(Bank(), Day(ns))
	let once, first = Apply(b, t) catch {
	case KeyReused, BadAmount, SameAccount, UnknownAccount, InsufficientFunds:
		return true
	}
	let twice, again = try Apply(once, t)
	let a = try Balance(twice, t.From)
	let b1 = try Balance(once, t.From)
	again == first && Count(twice) == Count(once) && a == b1
}

// FloorsHold: no account of a Book is below its floor.
law FloorsHold(ns []int) {
	let b = Posted(Bank(), Day(ns))
	for id in IDs(b) {
		let low = try floor(b, id)
		if try Balance(b, id) < low {
			return false
		}
	}
	true
}

// ApplyLeavesItsArgument: Apply makes a new Book and leaves the one it is
// given as it was, though the two share no field the program can see.
law ApplyLeavesItsArgument(ns []int, m int) {
	let t = Day([]int{m})[0]
	let b = Posted(Bank(), Day(ns))
	let before = Count(b)
	let from = Balance(b, t.From) catch {
	case UnknownAccount:
		return true
	}
	let _, _ = Apply(b, t) catch {
	case KeyReused, BadAmount, SameAccount, UnknownAccount, InsufficientFunds:
		return true
	}
	let now = try Balance(b, t.From)
	Count(b) == before && now == from
}
