// ergo test runs the quiz.Sets laws here, against Shelf; these two tests
// call the laws' functions again on the program's own shelf.

import quiz/quiz

test ShelfSetsPlay {
	with context { quiz.Sets: Shelf } {
		assert quiz.EverySetPlays()
	}
}

test ShelfUnlistedIsNoSuchSet(name string) {
	with context { quiz.Sets: Shelf } {
		assert quiz.UnlistedIsNoSuchSet(name)
	}
}
