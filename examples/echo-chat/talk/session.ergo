// The chat as a machine.

import machines
import strings
import time

// Said is a line of the conversation: its text, whether this side sent it
// or the server did, and when it was sent or came.
type Said { Text string, Mine bool, At time.Time }

// Link is the connection's state. Only Online has a conversation and an
// outbox, the texts submitted and not yet sent, so a send without a line
// cannot be written.
type Link = Offline{} | Connecting{} | Online{Log []Said, Out []string} | Broken{Why string}

// SendOnlyWhenOnline: a text joins the outbox only on Submit, only
// Online, only for an input that is not blank: the trimmed input, at the
// end, and the field clears. No other step adds to it, and every step
// in Online is a Stay, so the line's entry lasts.
law SendOnlyWhenOnline(k int, i int, g int) {
	let s = Session{Link: linkOf(k), Input: inputs[pick(i, len(inputs))]}
	let sig = signalOf(g)
	let d = Step(s, sig)
	let text = strings.TrimSpace(s.Input)
	let asks = match s.Link {
	case Online:
		sig == Submit && text != ""
	case Offline, Connecting, Broken:
		false
	}
	let next = machines.Next(s, d)
	if asks {
		return d == Stay[Session]{Next: next} && Outbox(next) == Outbox(s).Append(text) && next.Input == ""
	}
	len(Outbox(next)) <= len(Outbox(s))
}

func pick(n int, size int) int { ((n % size) + size) % size }

// at is the time of every drawn frame and send.
let at = time.Unix(60, 0)

let inputs = []string{"", "   ", "hi", "  Hello there  "}

// linkOf is a link of each kind, drawn by k.
func linkOf(k int) Link {
	let links = []Link{Offline, Connecting, Online{Log: []Said{Said{Text: "old", Mine: true, At: at}}, Out: []string{"mine"}}, Broken{Why: "Connection error"}}
	links[pick(k, len(links))]
}

// signalOf is each signal but Typed, drawn by k.
func signalOf(k int) Signal {
	let sigs = []Signal{Connect, Submit, Opened, Denied{Why: "Timeout"}, Received{Text: "echo", At: at}, Closed, Failed{Why: "Connection error"}, Sent{Text: "mine", At: at}, Unsent{Why: "Socket unavailable"}, TimedOut}
	sigs[pick(k, len(sigs))]
}

// Session is the machine's state: the link and the text being typed.
type Session { Link Link, Input string }

// ReconnectIsAFreshEntry: with no line (Offline or Broken), Connect
// enters Connecting, a new entry whose work dials a new line; and any
// news of a line there, a late one of the line that ended included,
// changes nothing.
law ReconnectIsAFreshEntry(k int where 0 <= k && k <= 1, g int) {
	let s = Session{Link: if k == 0 { Offline } else { Broken{Why: "Connection error"} }, Input: "x"}
	let sig = signalOf(g)
	let d = Step(s, sig)
	match sig {
	case Connect:
		d == Enter[Session]{Next: Session{..s, Link: Connecting}}
	case Submit, Opened, Denied, Received, Closed, Failed, Sent, Unsent, TimedOut:
		d == Ignore
	case Typed:
		false
	}
}

// DisconnectReleasesTheConnection: every end of a line is an Enter, so
// the entry that holds the line ends and the line is released: a refused
// dial, a dial that timed out and a failure leave Broken with the reason
// (a timer that comes once the line is open changes nothing), and the server's close
// leaves Offline with the conversation gone.
law DisconnectReleasesTheConnection(g int) {
	let online = Session{Link: Online{Log: []Said{Said{Text: "old", Mine: false, At: at}}, Out: []string{}}, Input: "draft"}
	let connecting = Session{..online, Link: Connecting}
	let sig = signalOf(g)
	match sig {
	case Denied as d:
		Step(connecting, sig) == Enter[Session]{Next: Session{..connecting, Link: Broken{Why: d.Why}}}
	case Failed as f:
		Step(online, sig) == Enter[Session]{Next: Session{..online, Link: Broken{Why: f.Why}}}
	case Unsent as u:
		Step(online, sig) == Enter[Session]{Next: Session{..online, Link: Broken{Why: u.Why}}}
	case Closed:
		Step(online, sig) == Enter[Session]{Next: Session{..online, Link: Offline}}
	case TimedOut:
		Step(connecting, sig) == Enter[Session]{Next: Session{..connecting, Link: Broken{Why: TimeoutWhy}}} && Step(online, sig) == Ignore
	case Connect, Submit, Opened, Received, Sent, Typed:
		true
	}
}

// ConversationKeepsOrder: once the line opens, frames received and texts
// sent (typed, submitted, then sent) are the conversation, in the order
// they came, each marked as the server's or this side's, at the time its
// signal carried.
law ConversationKeepsOrder(ops []int) {
	let mut s = Session{Link: Connecting, Input: ""}
	s = machines.Next(s, Step(s, Opened))
	let mut want = []Said{}
	for o in ops {
		let mine = pick(o, 2) == 0
		let text = "t\(pick(o/2, 50))"
		if mine {
			s = machines.Next(s, Step(s, Typed{Text: text}))
			s = machines.Next(s, Step(s, Submit))
			s = machines.Next(s, Step(s, Sent{Text: text, At: time.Unix(int64(pick(o, 1000)), 0)}))
		} else {
			s = machines.Next(s, Step(s, Received{Text: text, At: time.Unix(int64(pick(o, 1000)), 0)}))
		}
		want = want.Append(Said{Text: text, Mine: mine, At: time.Unix(int64(pick(o, 1000)), 0)})
	}
	s.Link == Online{Log: want, Out: []string{}}
}

// Signal is what the chat reads: Connect (and Try again) clicked, the
// field typed in, Send clicked; the line's news from the entry's work
// (open, refused, a frame, closed by the server, failed); and the host's
// answer to the outbox's first text: sent, or not, for no line was open;
// and the dial's timer, when the line has not opened in DialTimeout. A
// frame and a send carry the time they came, read by the work and the
// host, so the step needs no clock.
type Signal = Connect{} | Typed{Text string} | Submit{} | Opened{} | Denied{Why string} | Received{Text string, At time.Time} | Closed{} | Failed{Why string} | Sent{Text string, At time.Time} | Unsent{Why string} | TimedOut{}

// DialTimeout is how long a dial may take before the chat gives up on it.
let DialTimeout = 5s

// TimeoutWhy is why the chat gave up on a dial.
let TimeoutWhy = "Connection timeout"

// Blank is a chat with no line.
let Blank = Session{Link: Offline, Input: ""}

// Step is the chat's transition. Connect from Offline or Broken enters
// Connecting, a new entry, whose work dials; its answer Opened is a Stay
// into Online, so the entry, and the line its work holds, lasts through
// Online. Every step in Online is a Stay for the same reason: a frame or
// a sent text adds to the conversation, and Submit puts the trimmed text
// in the outbox, which the host sends (an Emit would end the entry, and
// the line with it). A server's close enters Offline, and a failure
// Broken: both end the entry, which releases the line. Every other pair
// is ignored: the news of a line whose entry has ended among them.
func Step(s Session, sig Signal) Decision[Session, Never] {
	match (s.Link, sig) {
	case (Offline, Connect), (Broken, Connect):
		Enter[Session]{Next: Session{..s, Link: Connecting}}
	case (Connecting, Opened):
		Stay[Session]{Next: Session{..s, Link: Online{Log: []Said{}, Out: []string{}}}}
	case (Connecting, TimedOut):
		Enter[Session]{Next: Session{..s, Link: Broken{Why: TimeoutWhy}}}
	case (Connecting, Denied as d):
		Enter[Session]{Next: Session{..s, Link: Broken{Why: d.Why}}}
	case (Online as o, Received as r):
		Stay[Session]{Next: Session{..s, Link: Online{..o, Log: o.Log.Append(Said{Text: r.Text, Mine: false, At: r.At})}}}
	case (Online as o, Sent as t):
		if len(o.Out) == 0 || o.Out[0] != t.Text {
			return Ignore
		}
		Stay[Session]{Next: Session{..s, Link: Online{Log: o.Log.Append(Said{Text: t.Text, Mine: true, At: t.At}), Out: o.Out[1:]}}}
	case (Online, Closed):
		Enter[Session]{Next: Session{..s, Link: Offline}}
	case (Online, Failed as f):
		Enter[Session]{Next: Session{..s, Link: Broken{Why: f.Why}}}
	case (Online, Unsent as u):
		Enter[Session]{Next: Session{..s, Link: Broken{Why: u.Why}}}
	case (Online as o, Submit):
		let text = strings.TrimSpace(s.Input)
		if text == "" {
			return Ignore
		}
		Stay[Session]{Next: Session{Link: Online{..o, Out: o.Out.Append(text)}, Input: ""}}
	case (_, Typed as t):
		Stay[Session]{Next: Session{..s, Input: t.Text}}
	case (Offline, _), (Connecting, _), (Online, _), (Broken, _):
		Ignore
	}
}

// IsBlank is whether a field's text sends nothing: empty, or spaces only
// (Submit ignores it, and the screen disables Send).
func IsBlank(input string) bool { strings.TrimSpace(input) == "" }

// Outbox is the texts waiting to be sent: Online's outbox, and none in
// any other state.
func Outbox(s Session) []string {
	match s.Link {
	case Online as o:
		o.Out
	case Offline, Connecting, Broken:
		[]string{}
	}
}

// listen is the work of Connecting's entry, which lasts through Online:
// dial, say whether the line opened, then pass each frame on until the
// server closes the line or it fails. The entry's end stops the work at
// its wait, and the line is released then, on every path.
func listen(s Session) Option[machines.Work[Signal, Channel | time.Clock]] {
	match s.Link {
	case Connecting:
		Some{machines.Work[Signal, Channel | time.Clock]{Start: func(send entry func(sig Signal)) needs Channel | time.Clock {
			let line = Channel.Dial() catch {
			case Refused as r:
				send(Denied{Why: r.Why})
				return
			}
			send(Opened)
			for {
				let text = line.Read() catch {
				case Hangup:
					send(Closed)
					return
				case Broke as b:
					send(Failed{Why: b.Why})
					return
				}
				send(Received{Text: text, At: time.Clock.Now()})
			}
		}}}
	case Offline, Online, Broken:
		None
	}
}

// dialTimer is Connecting's timer: TimedOut once the dial has taken
// DialTimeout. A Connecting entry that opened its line is Online, whose
// state sets no timer.
func dialTimer(s Session) Option[Timeout[Signal]] {
	match s.Link {
	case Connecting:
		Some{Timeout[Signal]{In: DialTimeout, Signal: TimedOut}}
	case Offline, Online, Broken:
		None
	}
}

// Chat is the chat as a machine. It starts Offline.
type Chat machine[Session, Signal] {
	initial: Blank,
	step:    Step,
	after:   dialTimer,
	work:    listen,
}
