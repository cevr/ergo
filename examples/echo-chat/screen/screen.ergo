// Package screen is the chat on a screen (stage b): the heading,
// the connection's status, the conversation (or a word that
// there is none yet), and under it what the link allows: Connect to Chat
// while offline, a word while the dial is under way, the field and Send
// while online, and the error with Try Again once the line failed. Send is
// disabled while the field is blank, and Enter in the field sends as the
// form's submit does.

import echochat/talk
import option
import time
import ui

// Title and Subtitle are the heading.
let Title = "WebSocket Chat"

let Subtitle = "Echo server demo"

// ConnectLabel, TryAgainLabel and SendLabel name the buttons.
let ConnectLabel = "Connect to Chat"

let TryAgainLabel = "Try Again"

let SendLabel = "Send"

// FieldLabel names the field (a ui.Input is named by its placeholder).
let FieldLabel = "Type a message..."

// ListLabel names the conversation's rows.
let ListLabel = "Messages"

// RowHeight is the height of a line of the conversation: its text and its
// time.
let RowHeight = ui.Length(56.0)

// Screen is the chat.
func Screen(f mut ui.Frame[talk.Signal], s talk.Session) {
	ui.Column(f, ui.Plain()) {
		ui.Semantic(f, named(ui.Heading, Title, option.Some{Value: 1}), option.None, ui.Plain()) {
			ui.Text(f, Title)
		}
		ui.Text(f, Subtitle)
		ui.Semantic(f, named(ui.Status, "", option.None), option.None, ui.Plain()) {
			ui.Text(f, Status(s.Link))
		}
		conversation(f, Log(s.Link))
		match s.Link {
		case talk.Offline:
			ui.Pressable(f, ConnectLabel, talk.Connect) {
				ui.Text(f, ConnectLabel)
			}
		case talk.Connecting:
			ui.Text(f, "Connecting...")
		case talk.Online:
			compose(f, s.Input)
		case talk.Broken as b:
			ui.Semantic(f, named(ui.Alert, "", option.None), option.None, ui.Plain()) {
				ui.Text(f, "Connection Error")
				ui.Text(f, b.Why)
			}
			ui.Pressable(f, TryAgainLabel, talk.Connect) {
				ui.Text(f, TryAgainLabel)
			}
		}
	}
}

// Status is the connection's word beside the heading.
func Status(l talk.Link) string {
	match l {
	case talk.Offline:
		"Disconnected"
	case talk.Connecting:
		"Connecting..."
	case talk.Online:
		"Connected"
	case talk.Broken:
		"Error"
	}
}

// Log is the conversation the link shows: Online's, and none otherwise.
func Log(l talk.Link) []talk.Said {
	match l {
	case talk.Online as o:
		o.Log
	case talk.Offline, talk.Connecting, talk.Broken:
		[]talk.Said{}
	}
}

// conversation is the lines of log as virtual rows, keyed by their place
// (a line never moves), or a word that there are none yet.
func conversation(f mut ui.Frame[talk.Signal], log []talk.Said) {
	if log.Len() == 0 {
		ui.Text(f, "No messages yet")
		ui.Text(f, "Send a message to get started!")
		return
	}
	ui.Rows(f, ListLabel, log.Len(), RowHeight, func(i int) ui.Key { ui.ByInt(i) }, func(i int) {
		let said = log[i]
		ui.Semantic(f, named(ui.Group, if said.Mine { "sent" } else { "received" }, option.None), option.None, ui.Plain()) {
			ui.Text(f, said.Text)
			ui.Text(f, Stamp(said.At))
		}
	})
}

// Stamp is a line's time: two-digit hour, minute and second, in UTC
// (std time has no local zone).
func Stamp(t time.Time) string { t.Format(time.TimeOnly) }

// compose is the field and Send, disabled while the field is blank; Enter
// sends.
func compose(f mut ui.Frame[talk.Signal], input string) {
	ui.OnKey(f, func(k ui.KeyPress) option.Option[talk.Signal] {
		if k.Name == "Enter" { option.Some{Value: talk.Submit} } else { option.None }
	})
	ui.Row(f, ui.Plain()) {
		ui.Input(f, input, FieldLabel, func(t string) talk.Signal { talk.Typed{Text: t} })
		ui.Fieldset(f, talk.IsBlank(input), "") {
			ui.Pressable(f, SendLabel, talk.Submit) {
				ui.Text(f, SendLabel)
			}
		}
	}
}

// named is the access of a container with a role and a name.
func named(role ui.Role, name string, level option.Option[int]) ui.Access {
	ui.Access{Role: role, Name: name, Disabled: false, Description: "", Checked: option.None, Value: option.None, Selected: option.None, Expanded: option.None, Pressed: option.None, Invalid: false, Busy: false, HasPopup: false, Level: level, Mixed: false, Current: option.None, Modal: false, MultiSelectable: false, Range: option.None, Key: ui.NoKey, Rels: []ui.Rel{}}
}
