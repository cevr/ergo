// Package screen is the permit desk on a screen (stage b): the permit's
// heading and the step the permit is at, each with its own heading,
// controls and buttons (Continue and Back, Cancel on every open step),
// the review's code field and fees, and the inspector: the stage and the
// log of transitions, newest first. The machine's graph is not drawn: it
// is `ergo inspect machine ./permit` (README, The graph).

import option
import permitwizard/desk
import permitwizard/permit
import ui

// Title and InspectorTitle are the two headings of the page.
let Title = "Your permit"

let InspectorTitle = "State machine inspector"

// The buttons and controls, by label.
let OvernightLabel = "Overnight trip"

let DayLabel = "Day trip"

let ContinueLabel = "Continue"

let ReviewLabel = "Review permit"

let BackLabel = "Back"

let CancelLabel = "Cancel permit"

let LeaderLabel = "Leader: Ana Rivera"

let RulesLabel = "Accept the park rules"

let CodePlaceholder = "Allowance code"

let ApplyLabel = "Apply"

let StartOverLabel = "Start a permit again"

// LogName names the inspector's log.
let LogName = "Recent transitions"

// Fee is a trip's permit fee in cents: an overnight trip's, or a day
// trip's.
func Fee(overnight bool) int {
	if overnight { 4000 } else { 2500 }
}

// Off is what an allowance takes off fee, in cents.
func Off(a permit.Allowance, fee int) int { fee * permit.Percent(a) / 100 }

// Dollars is cents as $D.CC.
func Dollars(cents int) string {
	let c = cents % 100
	"$\(cents / 100).\(if c < 10 { "0" } else { "" })\(c)"
}

// FileLabel is the file button's label: the fee to pay, after the
// allowance.
func FileLabel(overnight bool, pass permit.Pass) string {
	let fee = Fee(overnight)
	let due = match pass {
	case permit.Granted as g:
		fee - Off(g.Allowance, fee)
	case permit.NoCode, permit.Refused:
		fee
	}
	"File permit · \(Dollars(due))"
}

// Screen is the desk: the permit's step, then the inspector.
func Screen(f mut ui.Frame[desk.Signal], d desk.Desk) {
	ui.Column(f, ui.Plain()) {
		heading(f, Title, 1)
		step(f, d.Stage, d.Code)
		inspector(f, d)
	}
}

// step is the permit's current step.
func step(f mut ui.Frame[desk.Signal], s permit.Stage, typed string) {
	match s {
	case permit.Plan as p:
		heading(f, "Plan the trip", 2)
		ui.Check(f, OvernightLabel, p.Overnight, desk.Do{Signal: permit.Chose{Overnight: true}})
		ui.Check(f, DayLabel, !p.Overnight, desk.Do{Signal: permit.Chose{Overnight: false}})
		ui.Text(f, if p.Overnight { "Two days or more: pack supplies next." } else { "Back the same day: no supplies needed." })
		button(f, ContinueLabel, permit.Continue)
		button(f, CancelLabel, permit.Cancel)
	case permit.Supplies:
		heading(f, "Supplies", 2)
		ui.Text(f, "Pack food and water for every night out.")
		button(f, ContinueLabel, permit.Continue)
		button(f, BackLabel, permit.Back)
		button(f, CancelLabel, permit.Cancel)
	case permit.Permit as p:
		heading(f, "Permit", 2)
		ui.Check(f, LeaderLabel, p.Leader, desk.Do{Signal: permit.Led{On: !p.Leader}})
		ui.Fieldset(f, !p.Leader, "") {
			button(f, ReviewLabel, permit.Continue)
		}
		button(f, BackLabel, permit.Back)
		button(f, CancelLabel, permit.Cancel)
	case permit.Review as r:
		heading(f, "Review and file", 2)
		ui.Text(f, if r.Overnight { "Overnight trip" } else { "Day trip" })
		ui.Text(f, if r.Leader { LeaderLabel } else { "No leader named" })
		ui.Check(f, RulesLabel, r.Agreed, desk.Do{Signal: permit.Agreed{On: !r.Agreed}})
		code(f, typed)
		let fee = Fee(r.Overnight)
		ui.Text(f, "Permit fee · \(Dollars(fee))")
		match r.Pass {
		case permit.Granted as g:
			ui.Text(f, "\(permit.Code(g.Allowance)) applied · \(permit.Percent(g.Allowance))% off")
			ui.Text(f, "Allowance · \(permit.Code(g.Allowance)) · -\(Dollars(Off(g.Allowance, fee)))")
		case permit.Refused:
			ui.Text(f, "That code isn't recognized.")
		case permit.NoCode:
		}
		let label = FileLabel(r.Overnight, r.Pass)
		ui.Fieldset(f, !(r.Leader && r.Agreed), "") {
			button(f, label, permit.File)
		}
		button(f, BackLabel, permit.Back)
		button(f, CancelLabel, permit.Cancel)
	case permit.Filing:
		heading(f, "Filing your permit", 2)
		ui.Text(f, "The office answers in a moment.")
	case permit.Confirmed as c:
		heading(f, "Permit \(c.ID) confirmed", 2)
		button(f, StartOverLabel, permit.StartOver)
	case permit.Cancelled:
		heading(f, "Permit cancelled", 2)
		ui.Text(f, "Nothing was filed. Your trip's kind is kept.")
		button(f, StartOverLabel, permit.StartOver)
	}
}

// code is the review's code field over the desk's Code: each text
// typed in it is a desk.Typed (the permit's Edited), and Apply gives the machine the code parsed.
func code(f mut ui.Frame[desk.Signal], typed string) {
	ui.Input(f, typed, CodePlaceholder, func(t string) desk.Signal { desk.Typed{Text: t} })
	let applied permit.Signal = match permit.ParseCode(typed) {
	case option.Some[permit.Allowance] as a:
		permit.Applied{Allowance: a.Value}
	case option.None:
		permit.Unknown
	}
	button(f, ApplyLabel, applied)
}

// inspector is the stage and the log, newest first.
func inspector(f mut ui.Frame[desk.Signal], d desk.Desk) {
	heading(f, InspectorTitle, 2)
	ui.Text(f, "Stage: \(desk.StageName(d.Stage))")
	ui.Semantic(f, named(ui.List, LogName, option.None), option.None, ui.Plain()) {
		ui.Each(f, d.Log, func(e desk.Entry) ui.Key { ui.ByInt(e.ID) }) func(e desk.Entry) {
			ui.Same(f, ui.ByInt(e.ID)) {
				ui.Text(f, "\(e.ID): \(e.Summary)")
			}
		}
	}
}

func heading(f mut ui.Frame[desk.Signal], text string, level int) {
	ui.Semantic(f, named(ui.Heading, text, option.Some{Value: level}), option.None, ui.Plain()) {
		ui.Text(f, text)
	}
}

func button(f mut ui.Frame[desk.Signal], label string, on permit.Signal) {
	ui.Pressable(f, label, desk.Do{Signal: on}) {
		ui.Text(f, label)
	}
}

// named is the access of a container with a role and a name.
func named(role ui.Role, name string, level option.Option[int]) ui.Access {
	ui.Access{Role: role, Name: name, Disabled: false, Description: "", Checked: option.None, Value: option.None, Selected: option.None, Expanded: option.None, Pressed: option.None, Invalid: false, Busy: false, HasPopup: false, Level: level, Mixed: false, Current: option.None, Modal: false, MultiSelectable: false, Range: option.None, Key: ui.NoKey, Rels: []ui.Rel{}}
}
