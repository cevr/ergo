// permit-wizard is a wizard program (stage b: the
// view on std ui's test host): an expedition permit filled in step by step
// as one machine, with an inspector's log of its transitions. It plays a
// script of the user's acts on the screen and shows the screen after each.
// Package permit is the machine; package desk adds the log; package screen
// is the view; package script plays the script. This binary is the only
// place that chooses the clock: a time.Manual that only the script's waits
// move, so the filing office's second takes no wall time.

import permitwizard/script
import io
import os
import time

func main() fails os.Exit needs Console | Ambient {
	let clock = time.NewManual(0)
	let status = with context { io.Stdin: io.NewStdin(), Scheduler: clock } { script.Run(clock) }
	if status != 0 {
		return os.Exit{Code: 1, Message: "permit-wizard: the script did not run"}
	}
}
