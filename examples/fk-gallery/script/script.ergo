// Package script plays a script of timed visits on the site: the host of
// stage a. It steps gallery.Site, runs what the site asks (a catalog load
// takes 600 ms, a painting 400 ms, a save 300 ms, as upstream's sleeps),
// pushes the site's own links as the next URL, and shows the page after
// each line and each answer. Time is a count of milliseconds: nothing
// waits.

import fkgallery/gallery
import io
import strconv
import strings

// Act is a line's act: the page opened at a URL (a cold load or a
// reload), a link of the site followed, a link elsewhere followed, the
// studio's field set to a text, or the history moved to a URL.
type Act = Open{URL string} | Follow{URL string} | Away{Href string} | Write{Text string} | Back{URL string}

// Line is an act at a time since the start.
type Line { At int, Act Act }

// Script is the acts, and the time the run ends.
type Script { Lines []Line, End int }

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Read reads the lines of a script: `@MS open URL`, `@MS go PATH`,
// `@MS away HREF`, `@MS type TEXT` (the rest of the line, maybe empty),
// `@MS back PATH`, and `@MS end`, which must be last. The times never go
// back. A blank line or a line that starts with # is skipped.
func Read(text []string) Script fails BadLine {
	let mut lines = []Line{}
	let mut last = 0
	for i, raw in text {
		let n = i + 1
		let t = strings.TrimSpace(raw)
		if t == "" || strings.HasPrefix(t, "#") {
			continue
		}
		let words = strings.Fields(t)
		if len(words) < 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD ..."}
		}
		let at = try count(n, strings.TrimPrefix(words[0], "@"))
		if at < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = at
		let rest = if len(words) > 2 { strings.Join(words[2:len(words)], " ") } else { "" }
		let act Act = match words[1] {
		case "end":
			return Script{Lines: lines, End: at}
		case "open":
			Open{URL: rest}
		case "go":
			Follow{URL: rest}
		case "away":
			Away{Href: rest}
		case "type":
			Write{Text: rest}
		case "back":
			Back{URL: rest}
		case _:
			return BadLine{Line: n, Why: "unknown word \(words[1])"}
		}
		lines = lines.Append(Line{At: at, Act: act})
	}
	BadLine{Line: len(text) + 1, Why: "the script has no @MS end line"}
}

func count(n int, word string) int fails BadLine {
	let v = strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	v
}

// Due is an answer the host owes the site, and when.
type Due { At int, Signal gallery.Signal }

// Host is the site and what the host owes it.
type Host { Site gallery.Site, Owed []Due, Out []string }

// Takes is how long the host takes to answer a command, in ms.
func Takes(c gallery.Command) int {
	match c {
	case gallery.LoadCatalog:
		600
	case gallery.LoadPainting:
		400
	case gallery.SaveDraft:
		300
	case gallery.Push, gallery.Leave:
		0
	}
}

// step steps the site with sig at now, runs what it asks, and shows it
// under the heading head.
func step(h Host, now int, head string, sig gallery.Signal) Host {
	let d = gallery.Step(h.Site, sig)
	let mut at = Host{..h, Site: gallery.After(h.Site, d), Out: h.Out.Append(head)}
	let mut asks = []string{}
	let mut then = []gallery.Signal{}
	for c in gallery.Commands(d) {
		asks = asks.Append(Ask(c))
		match c {
		case gallery.LoadCatalog:
			at = Host{..at, Owed: at.Owed.Append(Due{At: now + Takes(c), Signal: gallery.CatalogLoaded})}
		case gallery.LoadPainting as p:
			at = Host{..at, Owed: at.Owed.Append(Due{At: now + Takes(c), Signal: gallery.PaintingLoaded{ID: p.ID}})}
		case gallery.SaveDraft as s:
			at = Host{..at, Owed: at.Owed.Append(Due{At: now + Takes(c), Signal: gallery.DraftSaved{Draft: s.Draft}})}
		case gallery.Push as p:
			then = then.Append(gallery.Arrived{URL: p.URL})
		case gallery.Leave:
		}
	}
	if len(asks) > 0 {
		at = Host{..at, Out: at.Out.Append("  asks: " + strings.Join(asks, ", "))}
	}
	at = Host{..at, Out: at.Out.Append("  " + Page(at.Site))}
	for sig2 in then {
		at = step(at, now, "@\(now) arrive", sig2)
	}
	at
}

// settle answers, in time order, what the host owes by until.
func settle(h Host, until int) Host {
	let mut at = h
	for {
		let mut k = -1
		for i, o in at.Owed {
			if o.At <= until && (k < 0 || o.At < at.Owed[k].At) {
				k = i
			}
		}
		if k < 0 {
			return at
		}
		let o = at.Owed[k]
		let mut rest = []Due{}
		for i, x in at.Owed {
			if i != k {
				rest = rest.Append(x)
			}
		}
		at = step(Host{..at, Owed: rest}, o.At, "@\(o.At) \(Answer(o.Signal))", o.Signal)
	}
}

// Play plays the script and gives what it shows.
func Play(s Script) []string {
	let mut h = Host{Site: gallery.Blank, Owed: []Due{}, Out: []string{}}
	for l in s.Lines {
		h = settle(h, l.At)
		let head = "@\(l.At) \(Word(l.Act))"
		h = match l.Act {
		case Open as o:
			step(h, l.At, head, gallery.Arrived{URL: o.URL})
		case Follow as f:
			step(h, l.At, head, gallery.Clicked{Link: gallery.Internal{URL: f.URL}})
		case Away as a:
			step(h, l.At, head, gallery.Clicked{Link: gallery.External{Href: a.Href}})
		case Write as w:
			step(h, l.At, head, gallery.Drafted{Text: w.Text})
		case Back as b:
			step(h, l.At, head, gallery.Arrived{URL: b.URL})
		}
	}
	h = settle(h, s.End)
	h.Out.Append("@\(s.End) end").Append("  " + Page(h.Site)).Append("  log: " + Log(h.Site))
}

// Run reads the script from io.Stdin and prints what it shows. It returns
// the exit status: 0, or 1 when the script is refused.
func Run() int needs Console | io.Stdin {
	let mut text = []string{}
	for line in io.Stdin.Lines() {
		text = text.Append(line)
	}
	let s = Read(text) catch {
	case BadLine as b:
		Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	for line in Play(s) {
		Console.Println(line)
	}
	0
}

// Word is how an act shows.
func Word(a Act) string {
	match a {
	case Open as o:
		"open \(o.URL)"
	case Follow as f:
		"go \(f.URL)"
	case Away as aw:
		"away \(aw.Href)"
	case Write as w:
		"type \"\(w.Text)\""
	case Back as b:
		"back \(b.URL)"
	}
}

// Ask is how a command shows.
func Ask(c gallery.Command) string {
	match c {
	case gallery.LoadCatalog:
		"load the catalog"
	case gallery.LoadPainting as p:
		"load painting \(p.ID)"
	case gallery.SaveDraft as s:
		"save \"\(s.Draft)\""
	case gallery.Push as p:
		"push \(p.URL)"
	case gallery.Leave as l:
		"leave for \(l.Href)"
	}
}

// Answer is how an answer shows.
func Answer(sig gallery.Signal) string {
	match sig {
	case gallery.CatalogLoaded:
		"catalog loaded"
	case gallery.PaintingLoaded as p:
		"painting \(p.ID) loaded"
	case gallery.DraftSaved as d:
		"saved \"\(d.Draft)\""
	case gallery.Arrived, gallery.Clicked, gallery.Drafted:
		"signal"
	}
}

// Page is the page the site shows: the route, the catalog, the painting
// (its title once loaded), the draft and the draft saved.
func Page(s gallery.Site) string {
	let route = match s.Route {
	case Some[gallery.Route] as r:
		gallery.Label(r.Value)
	case None:
		"blank"
	}
	let catalog = match s.Catalog {
	case gallery.Idle:
		"idle"
	case gallery.Loading:
		"loading"
	case gallery.Ready:
		"ready"
	}
	let painting = match s.Painting {
	case gallery.NoPainting:
		"none"
	case gallery.LoadingPainting as p:
		"\(p.ID) loading"
	case gallery.ReadyPainting as p:
		match gallery.Find(p.ID) {
		case Some[gallery.Work] as w:
			"\(p.ID) \"\(w.Value.Title)\" by \(w.Value.Artist)"
		case None:
			"\(p.ID) not in the gallery"
		}
	}
	let saved = match s.Saved {
	case Some[string] as d:
		"\"\(d.Value)\""
	case None:
		"none"
	}
	"\(route); catalog \(catalog); painting \(painting); draft \"\(s.Draft)\"; saved \(saved)"
}

// Log is the site's log, oldest first: `N FROM->TO`.
func Log(s gallery.Site) string {
	let mut out = []string{}
	for i in 0..len(s.Log) {
		let l = s.Log[len(s.Log)-1-i]
		let from = match l.From {
		case Some[gallery.Route] as r:
			gallery.Label(r.Value)
		case None:
			"cold"
		}
		out = out.Append("\(l.Seq) \(from)->\(gallery.Label(l.To))")
	}
	strings.Join(out, ", ")
}
