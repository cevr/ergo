// Package script plays a script of timed acts on the site's screen: the
// host of stage b. The site runs as an actor on a manual clock with its
// screen on std ui's test host, whose history is the browser's. The host
// runs what the site asks (a catalog load takes 600 ms, a painting 400
// ms, a save 300 ms, as upstream's sleeps), follows the site's own links
// as a browser does (a push, then the address change, which the screen's
// OnURL gives the site as Arrived), and shows what changed after each
// line and each answer.

import actor
import fkgallery/gallery
import fkgallery/screen
import io
import queue
import strconv
import strings
import sync
import time
import ui

// Act is a line's act: an address typed (a cold load or a reload), a
// link of the screen clicked, a link elsewhere followed, the studio's
// field typed in, or the browser's Back.
type Act = Open{URL string} | Follow{Label string} | Away{Href string} | Write{Text string} | Back{}

// Line is an act at a time since the start.
type Line { At int, Act Act }

// Script is the acts, and the time the run ends.
type Script { Lines []Line, End int }

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Read reads the lines of a script: `@MS open URL`, `@MS link LABEL`,
// `@MS away HREF`, `@MS type TEXT` (the rest of the line, maybe empty),
// `@MS back` and `@MS end`, which must be last. The times never go back.
// A blank line or a line that starts with # is skipped.
func Read(text []string) Script fails BadLine {
	let mut lines = []Line{}
	let mut last = 0
	for i, raw in text {
		let n = i + 1
		let t = strings.TrimSpace(raw)
		if t == "" || strings.HasPrefix(t, "#") {
			continue
		}
		let words = strings.Fields(t)
		if len(words) < 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD ..."}
		}
		let at = try count(n, strings.TrimPrefix(words[0], "@"))
		if at < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = at
		let rest = if len(words) > 2 { strings.Join(words[2:len(words)], " ") } else { "" }
		let act Act = match words[1] {
		case "end":
			return Script{Lines: lines, End: at}
		case "open":
			Open{URL: rest}
		case "link":
			Follow{Label: rest}
		case "away":
			Away{Href: rest}
		case "type":
			Write{Text: rest}
		case "back":
			Back
		case _:
			return BadLine{Line: n, Why: "unknown word \(words[1])"}
		}
		lines = lines.Append(Line{At: at, Act: act})
	}
	BadLine{Line: len(text) + 1, Why: "the script has no @MS end line"}
}

func count(n int, word string) int fails BadLine {
	let v = strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	v
}

// Site is the running site.
type Site = actor.Actor[gallery.Site, gallery.Signal, Decision[gallery.Site, []gallery.Command]]

// Host is the site on the test host.
type Host = ui.TestHost[gallery.Site, gallery.Signal, Decision[gallery.Site, []gallery.Command]]

// Due is an answer the host owes the site, and when.
type Due { At int, Signal gallery.Signal }

// Ran is what the host did with the site's commands: the answers it owes
// now, and how each command shows.
type Ran { Owed []Due, Asks []string }

// Takes is how long the host takes to answer a command, in ms.
func Takes(c gallery.Command) int {
	match c {
	case gallery.LoadCatalog:
		600
	case gallery.LoadPainting:
		400
	case gallery.SaveDraft:
		300
	case gallery.Push, gallery.Leave:
		0
	}
}

// Frame is what a line or an answer shows: its heading, what the site
// asked, and the screen's lines, with the work of the step.
type Frame { Head string, Asks []string, Lines []string, Counts ui.StepCounts }

// PlayScreen plays s on the site's screen, on the test host over clock,
// and gives each frame to show: one per line, one per answer, and one at
// the end.
func PlayScreen[R](s Script, clock time.Manual, show func(f Frame) needs R) fails actor.Stopped | ui.BadPatch needs R | Scheduler {
	let gone = queue.New[[]gallery.Command](64)
	let site = actor.StartMachine(gallery.Gallerist{}, 16, func(cs []gallery.Command) {
		gone.Push(cs) catch {
		case queue.Closed:
		}
	})
	played(site, gone, s, clock, show) catch {
	case err:
		site.Stop()
		return err
	}
	site.Stop()
}

func played[R](site Site, gone queue.Queue[[]gallery.Command], s Script, clock time.Manual, show func(f Frame) needs R) fails actor.Stopped | ui.BadPatch needs R | Scheduler {
	let mut h = try ui.NewTestHost(site, screen.Screen, clock, 16)
	let mut owed = []Due{}
	let mut now = 0
	for i in 0..len(s.Lines)+1 {
		let until = if i < len(s.Lines) { s.Lines[i].At } else { s.End }
		// the answers due by then, in time order
		for {
			let mut k = -1
			for j, o in owed {
				if o.At <= until && (k < 0 || o.At < owed[k].At) {
					k = j
				}
			}
			if k < 0 {
				break
			}
			let o = owed[k]
			let mut rest = []Due{}
			for j, x in owed {
				if j != k {
					rest = rest.Append(x)
				}
			}
			try ui.Advance(&h, time.Times(1ms, o.At-now))
			now = o.At
			let _ = try site.Ask(o.Signal)
			try ui.Settle(&h)
			let ran = try run(&h, gone, now, rest)
			owed = ran.Owed
			show(Frame{Head: "@\(now) \(Answer(o.Signal))", Asks: ran.Asks, Lines: View(&h), Counts: ui.Counts(&h)})
		}
		try ui.Advance(&h, time.Times(1ms, until-now))
		try ui.Settle(&h)
		now = until
		if i == len(s.Lines) {
			show(Frame{Head: "@\(now) end", Asks: []string{}, Lines: View(&h), Counts: ui.Counts(&h)})
			return
		}
		let l = s.Lines[i]
		let mut missing = ""
		match l.Act {
		case Away as a:
			let _ = try site.Ask(gallery.Clicked{Link: gallery.External{Href: a.Href}})
			try ui.Settle(&h)
		case Open, Follow, Write, Back:
			let act ui.Act = match l.Act {
			case Open as o:
				ui.NavigateTo{Href: o.URL}
			case Follow as fl:
				ui.ClickOn{At: ui.WithRole{Role: ui.Link, Name: fl.Label}}
			case Write as w:
				ui.FillIn{At: ui.WithPlaceholder{Text: screen.DraftPlaceholder}, Text: w.Text}
			case Back, Away:
				ui.GoBack
			}
			ui.Play(&h, []ui.Act{act, ui.SettleAll}) catch {
			case ui.NoNode as no:
				missing = "no node: \(no.Label)"
			case ui.Ambiguous as m:
				missing = "\(m.Count) nodes: \(m.At)"
			case ui.Mismatch:
				missing = "no match"
			case actor.Stopped as st:
				return st
			case ui.BadPatch as b:
				return b
			}
		}
		let ran = try run(&h, gone, now, owed)
		owed = ran.Owed
		let asks = if missing == "" { ran.Asks } else { ran.Asks.Append("? " + missing) }
		show(Frame{Head: "@\(now) \(Word(l.Act))", Asks: asks, Lines: View(&h), Counts: ui.Counts(&h)})
	}
}

// run runs the commands the site gave since the last step at now: a load
// or a save is owed its answer, a push of the site's own URL is followed
// at once (and what it asks is run too), and a page elsewhere is left
// for.
func run(h *Host, gone queue.Queue[[]gallery.Command], now int, owed []Due) Ran fails actor.Stopped | ui.BadPatch {
	let mut out = owed
	let mut asks = []string{}
	for {
		let cs = match gone.Poll() {
		case Some[[]gallery.Command] as x:
			x.Value
		case None:
			return Ran{Owed: out, Asks: asks}
		}
		for c in cs {
			asks = asks.Append(Ask(c))
			match c {
			case gallery.LoadCatalog:
				out = out.Append(Due{At: now + Takes(c), Signal: gallery.CatalogLoaded})
			case gallery.LoadPainting as p:
				out = out.Append(Due{At: now + Takes(c), Signal: gallery.PaintingLoaded{ID: p.ID}})
			case gallery.SaveDraft as s:
				out = out.Append(Due{At: now + Takes(c), Signal: gallery.DraftSaved{Draft: s.Draft}})
			case gallery.Push as p:
				try ui.Navigate(h, p.URL)
				try ui.Settle(h)
			case gallery.Leave:
			}
		}
	}
}

// Run reads the script from io.Stdin, plays it on the screen and prints
// each frame: its heading, what the site asked, and the screen's lines
// that changed; with stats, the work of each step too. It returns the
// exit status: 0, or 1 when the script is refused or the screen fails.
func Run(clock time.Manual, stats bool) int needs Console | io.Stdin | Scheduler {
	let mut text = []string{}
	for line in io.Stdin.Lines() {
		text = text.Append(line)
	}
	let s = Read(text) catch {
	case BadLine as b:
		Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let shown = sync.NewRef[[]string]([]string{})
	PlayScreen(s, clock, func(f Frame) needs Console {
		Console.Println(f.Head)
		if len(f.Asks) > 0 {
			Console.Println("  asks: " + strings.Join(f.Asks, ", "))
		}
		let before = shown.Get()
		for k, l in f.Lines {
			if k >= len(before) || before[k] != l {
				Console.Println("  " + l)
			}
		}
		shown.Set(f.Lines)
		if stats {
			Console.Println("  stats: \(ui.CountsLine(f.Counts))")
		}
	}) catch {
	case actor.Stopped:
		Console.Println("? the site stopped")
		return 1
	case ui.BadPatch as p:
		Console.Println("? a patch is refused: \(p.Why)")
		return 1
	}
	0
}

// View is the screen in three lines: the address and its depth, the page
// (a heading as # NAME, a link as <NAME>, the field as ?TEXT?, each text
// itself), and the log's newest entry.
func View(h *Host) []string {
	let all = tokens(ui.Screen(h))
	let mut page = []string{}
	let mut log = ""
	let mut inLog = false
	for t in all {
		if t == "# \(screen.LogTitle)" {
			inLog = true
		} else if inLog {
			if log == "" {
				log = t
			}
		} else {
			page = page.Append(t)
		}
	}
	let at = ui.History(h)
	[]string{"address: \(ui.Href(ui.Current(at))) (\(ui.Depth(at)) behind)", "page: " + strings.Join(page, " | "), "log: " + log}
}

func tokens(shapes []ui.Shape[gallery.Signal]) []string {
	let mut out = []string{}
	for s in shapes {
		match s.Node {
		case ui.TextNode as t:
			out = out.Append(t.Value)
		case ui.InputNode as i:
			out = out.Append("?\(i.Value)?")
		case ui.SemanticNode as g:
			if g.Access.Role == ui.Heading {
				out = out.Append("# \(g.Access.Name)")
			} else if g.Access.Role == ui.Link {
				out = out.Append("<\(g.Access.Name)>")
			} else {
				for t in tokens(s.Kids) {
					out = out.Append(t)
				}
			}
		case _:
			for t in tokens(s.Kids) {
				out = out.Append(t)
			}
		}
	}
	out
}

// Word is how an act shows.
func Word(a Act) string {
	match a {
	case Open as o:
		"open \(o.URL)"
	case Follow as f:
		"link \(f.Label)"
	case Away as aw:
		"away \(aw.Href)"
	case Write as w:
		"type \"\(w.Text)\""
	case Back:
		"back"
	}
}

// Ask is how a command shows.
func Ask(c gallery.Command) string {
	match c {
	case gallery.LoadCatalog:
		"load the catalog"
	case gallery.LoadPainting as p:
		"load painting \(p.ID)"
	case gallery.SaveDraft as s:
		"save \"\(s.Draft)\""
	case gallery.Push as p:
		"push \(p.URL)"
	case gallery.Leave as l:
		"leave for \(l.Href)"
	}
}

// Answer is how an answer shows.
func Answer(sig gallery.Signal) string {
	match sig {
	case gallery.CatalogLoaded:
		"catalog loaded"
	case gallery.PaintingLoaded as p:
		"painting \(p.ID) loaded"
	case gallery.DraftSaved as d:
		"saved \"\(d.Draft)\""
	case gallery.Arrived, gallery.Clicked, gallery.Drafted:
		"signal"
	}
}
