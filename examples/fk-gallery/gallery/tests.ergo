// Upstream's story tests (route-transitions/src/story.test.ts) that a law
// or the tour case does not already restate. Each test here kills a
// mutant that nothing else kills (testdata/mutants.json); the other nine
// stories are restated by the laws and the tour (origin/tests.txt, and
// README.md, "Upstream tests").

test AStaleAnswerForAnotherIdIsIgnored {
	// update: a stale painting response for another id is ignored. The
	// decision is Ignore, not a Stay on the same site (mutant
	// fk9-stale-answer-stays).
	let s = Site{..Blank, Route: Some[Route]{Value: Painting{ID: 2}}, Painting: LoadingPainting{ID: 2}}
	assert Step(s, PaintingLoaded{ID: 1}) == Ignore
}
