// fk-gallery is a port of Foldkit's route-transitions example (stage a:
// the model, with no view): a gallery site whose navigations load the
// catalog on entry, load a painting by its id, and save the studio's
// draft on leaving. It plays a script of timed visits and shows the page
// after each one. Package gallery is the site; package script is the
// host that plays the script.

import fkgallery/script
import io
import os

func main() fails os.Exit needs Console | Ambient {
	let status = with context { io.Stdin: io.NewStdin() } { script.Run() }
	if status != 0 {
		return os.Exit{Code: status, Message: "fk-gallery: the script did not run"}
	}
}
