// dash-gui is an animated dashboard: twelve panels (line charts over
// rings of 10,000 samples, spark lines, gauges that ease toward each new
// value, heat strips and an event log), each fed by a sensor source that
// runs as its own task through a bounded queue, on a virtual clock of 120
// frames a second. Its headless driver runs a script on standard input
// that moves the clock and writes what a window would show; its scene
// runs the view on ui.TestHost.
//
//	dash-gui gen [-seed S] [-n N]   write a script of N steps
//	dash-gui play [-seed S]         play the script on standard input
//	dash-gui scene [-seed S] [-frames N]
//	                                move the view N frames, then play a
//	                                scene script on it
//
// This binary is the only place that chooses the providers: the seeded
// synthetic sensors for play and scene, the scene's manual clock, a
// seeded generator for gen.

import actor
import dash/feed
import dash/script
import dash/synth
import flag
import io
import os
import queue
import rand
import slices
import tasks
import time
import ui

// Usage is the text of a usage failure.
let Usage = "usage: dash-gui gen [-seed S] [-n N] | dash-gui play [-seed S] | dash-gui scene [-seed S] [-frames N]"

let seedFlag = flag.Int("seed", 1, "the seed")
let countFlag = flag.Int("n", 50, "how many steps")

let genSet = flag.Set{Name: "dash-gui gen", Usage: "", Flags: []flag.Flag{seedFlag, countFlag}, Args: []flag.ArgSpec{}}
let playSet = flag.Set{Name: "dash-gui play", Usage: "", Flags: []flag.Flag{seedFlag}, Args: []flag.ArgSpec{}}
let framesFlag = flag.Int("frames", 0, "frames the scene moves before its script")
let sceneSet = flag.Set{Name: "dash-gui scene", Usage: "", Flags: []flag.Flag{seedFlag, framesFlag}, Args: []flag.ArgSpec{}}

// run is dash-gui on args.
func run(args []string) fails os.Exit | queue.Closed | tasks.Closed needs io.Stdout | io.Stdin {
	if len(args) == 0 {
		return os.Exit{Code: 2, Message: Usage}
	}
	let rest = slices.Slice(args, 1, len(args))
	match args[0] {
	case "gen":
		let v = flag.Parse(genSet, rest) catch {
		case err:
			try flag.Exit(err, Usage)
			return
		}
		let n = countFlag.Get(v)
		if n < 0 {
			return os.Exit{Code: 2, Message: "dash-gui: -n must not be negative\n" + Usage}
		}
		with context { Random: rand.Seeded(uint64(seedFlag.Get(v))) } {
			io.Stdout.Print(script.Generate(n))
		}
	case "play":
		let v = flag.Parse(playSet, rest) catch {
		case err:
			try flag.Exit(err, Usage)
			return
		}
		with context { feed.Sensors: synth.Bank{Seed: seedFlag.Get(v)} } {
			try script.Play(io.Stdin.Lines())
		}
	case "scene":
		let v = flag.Parse(sceneSet, rest) catch {
		case err:
			try flag.Exit(err, Usage)
			return
		}
		let frames = framesFlag.Get(v)
		if frames < 0 {
			return os.Exit{Code: 2, Message: "dash-gui: -frames must not be negative\n" + Usage}
		}
		let clock = time.NewManual(0)
		with context { feed.Sensors: synth.Bank{Seed: seedFlag.Get(v)}, Scheduler: clock } {
			script.Scene(io.Stdin.Lines(), frames, clock) catch {
			case ui.BadPatch as b:
				return os.Exit{Code: 1, Message: "dash-gui: the view's patch did not apply: " + b.Why}
			case actor.Stopped:
				return os.Exit{Code: 1, Message: "dash-gui: the app stopped"}
			}
		}
	case _:
		return os.Exit{Code: 2, Message: Usage}
	}
}

func main() fails os.Exit | queue.Closed | tasks.Closed needs Ambient {
	with context { io.Stdout: io.NewHost(), io.Stdin: io.NewStdin() } {
		try run(os.NewHost().Args())
	}
}
