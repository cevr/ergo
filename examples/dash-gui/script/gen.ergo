// A generated session: the workload of the program at any length, drawn
// from the Random in the context, so a seed replays it.

import ergo.local/prototype/examples/dashgui/feed
import rand
import strings

// Generate is a script of n steps: runs of the clock, pauses and resumes,
// policy changes and frames, ending with show and drops.
func Generate(n int) string needs rand.Random {
	let panels = feed.Kinds().Len()
	let mut b = strings.NewBuilder()
	for _ in 0..n {
		let c = match rand.Random.IntN(10) {
		case 0:
			Pause{Panel: rand.Random.IntN(panels)}
		case 1:
			Resume{Panel: rand.Random.IntN(panels)}
		case 2:
			SetPolicy{Panel: rand.Random.IntN(panels), Policy: if rand.Random.IntN(2) == 0 { feed.DropOldest } else { feed.DropNewest }}
		case 3:
			Show
		case _:
			Run{Frames: 1 + rand.Random.IntN(120)}
		}
		b.WriteString(Line(c) + "\n")
	}
	b.WriteString("show\ndrops\n")
	b.String()
}
