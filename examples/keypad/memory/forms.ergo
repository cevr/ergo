// Package memory holds the in-memory providers of the keypad contracts.

import keypad/keypad

// Fixed is a keypad.Forms of three fixed forms.
type Fixed {}

func Names(_ Fixed) []string { []string{"login", "address", "code"} }

func Form(_ Fixed, name string) []keypad.Spec fails keypad.NoSuchForm {
	match name {
	case "login":
		keypad.Login()
	case "address":
		[]keypad.Spec{
			keypad.Spec{ID: "street", Layout: keypad.AnyText, Min: 1, Max: 0},
			keypad.Spec{ID: "city", Layout: keypad.Letters, Min: 1, Max: 0},
			keypad.Spec{ID: "zip", Layout: keypad.Digits, Min: 5, Max: 5},
		}
	case "code":
		[]keypad.Spec{keypad.Spec{ID: "code", Layout: keypad.Digits, Min: 6, Max: 6}}
	case _:
		keypad.NoSuchForm{Name: name}
	}
}
