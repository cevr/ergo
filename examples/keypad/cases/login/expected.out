form login: *name(letters) pin(digits) note(any) [lower]
shift: *name(letters) pin(digits) note(any) [shift]
  name = "A"
  name = "Ad"
  name = "Ada"
  greyed: key 7
  name = "Ad"
  name = "Adm"
submit name "Adm"
focus pin
  pin = "1"
  pin = "12"
  greyed: key x
? pin needs 4 characters, has 2
  pin = "123"
  pin = "1234"
  greyed: key 5
submit pin "1234"
focus note
shift: name(letters) pin(digits) *note(any) [shift]
shift: name(letters) pin(digits) *note(any) [caps]
  note = "O"
  note = "OK"
  note = "OK "
shift: name(letters) pin(digits) *note(any) [lower]
  note = "OK é"
  note = "OK éß"
  note = "OK é"
  note = "OK "
  note = "OK"
  note = "O"
  note = ""
  greyed: back
focus pin
? no field note
? no field nowhere
add zip: name(letters) *pin(digits) zip(digits) [lower]
? field zip exists
? field bad: min 3 and max 2 do not fit
remove name: *pin(digits) zip(digits) [lower]
focus zip
? zip is the last field
closed zip=""
