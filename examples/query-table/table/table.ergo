// Package table is the table as a machine whose state is the address:
// every control asks the host to replace the address, and the table
// follows the address it is told. Rows is the table's rows for a query.

import querytable/dino
import querytable/query
import slices
import strings

// Signal is what the table reads: the address changed (the host replaced
// it, or the user typed one), the search typed, a column header clicked,
// and a filter chosen (None for all).
type Signal = Navigated{Path string} | Searched{Text string} | Clicked{Column query.Column} | ChoseDiet{Diet Option[dino.Diet]} | ChosePeriod{Period Option[dino.Period]}

// UrlIsAFunctionOfTheControls: a control changes nothing itself and asks
// for the address of the controls with that one changed, from the table
// or from a path it is not at; a new address is the state.
law UrlIsAFunctionOfTheControls(q query.Query, lost bool, sig Signal) {
	let r = if lost { query.NotFound{Path: "/elsewhere"} } else { query.Browse{Query: q} }
	let shown = if lost { query.Default } else { q }
	let want = match sig {
	case Navigated as n:
		return Step(r, sig) == Enter[query.Route]{Next: query.Decode(n.Path)}
	case Searched as s:
		query.Query{..shown, Search: s.Text}
	case Clicked as c:
		query.Query{..shown, Sorting: query.Next(shown.Sorting, c.Column)}
	case ChoseDiet as d:
		query.Query{..shown, Diet: d.Diet}
	case ChosePeriod as p:
		query.Query{..shown, Period: p.Period}
	}
	match Step(r, sig) {
	case Emit[query.Route, Replace] as e:
		e.Next == r && query.Decode(e.Output.Path) == query.Browse{Query: want}
	case Enter[query.Route], Stay[query.Route], Tell[query.Route, Replace], Ignore, Reject, Done[Replace]:
		false
	}
}

// Replace is the table's request to replace the address with Path, which
// the host does, then tells the table Navigated; the history gets no new
// entry.
type Replace { Path string }

// Open is the table at the address path.
func Open(path string) query.Route { query.Decode(path) }

// Controls is the query the controls show: the route's, or the defaults
// on a path the table is not at.
func Controls(r query.Route) query.Query {
	match r {
	case query.Browse as b:
		b.Query
	case query.NotFound:
		query.Default
	}
}

// Step is the table's transition. A new address is the state. A control
// asks for the address of the controls with that one changed, and leaves
// the state to the address.
func Step(r query.Route, sig Signal) Decision[query.Route, Replace] {
	let q = Controls(r)
	match sig {
	case Navigated as n:
		Enter[query.Route]{Next: query.Decode(n.Path)}
	case Searched as s:
		Emit[query.Route, Replace]{Next: r, Output: Replace{Path: query.Encode(query.Query{..q, Search: s.Text})}}
	case Clicked as c:
		Emit[query.Route, Replace]{Next: r, Output: Replace{Path: query.Encode(query.Query{..q, Sorting: query.Next(q.Sorting, c.Column)})}}
	case ChoseDiet as d:
		Emit[query.Route, Replace]{Next: r, Output: Replace{Path: query.Encode(query.Query{..q, Diet: d.Diet})}}
	case ChosePeriod as p:
		Emit[query.Route, Replace]{Next: r, Output: Replace{Path: query.Encode(query.Query{..q, Period: p.Period})}}
	}
}

// Table is the table as a machine; its input is the address it opens at.
type Table machine[query.Route, Signal] {
	initial: Open,
	step:    Step,
}

// Matches is whether d passes q's search (a part of its name, in any
// case) and filters.
func Matches(q query.Query, d dino.Dinosaur) bool {
	if !strings.Contains(strings.ToLower(d.Name), strings.ToLower(q.Search)) {
		return false
	}
	match q.Diet {
	case Some[dino.Diet] as w:
		if d.Diet != w.Value {
			return false
		}
	case None:
	}
	match q.Period {
	case Some[dino.Period] as p:
		if d.Period != p.Value {
			return false
		}
	case None:
	}
	true
}

// Compare orders a and b by column c: names, periods and diets by their
// names' text, lengths and weights by number.
func Compare(c query.Column, a dino.Dinosaur, b dino.Dinosaur) int {
	match c {
	case query.Name:
		strings.Compare(a.Name, b.Name)
	case query.Era:
		strings.Compare(dino.PeriodName(a.Period), dino.PeriodName(b.Period))
	case query.Eats:
		strings.Compare(dino.DietName(a.Diet), dino.DietName(b.Diet))
	case query.Length:
		a.Length - b.Length
	case query.Weight:
		a.Weight - b.Weight
	}
}

// Rows is the table for q: the dinosaurs that match it, sorted by its
// sorting; rows that tie keep the listed order.
func Rows(q query.Query) []dino.Dinosaur {
	let kept = slices.Filter(dino.All, func(d dino.Dinosaur) bool { Matches(q, d) })
	match q.Sorting {
	case query.Unsorted:
		kept
	case query.Ascending as a:
		slices.SortStableFunc(kept, func(x dino.Dinosaur, y dino.Dinosaur) int { Compare(a.Column, x, y) })
	case query.Descending as d:
		slices.SortStableFunc(kept, func(x dino.Dinosaur, y dino.Dinosaur) int { Compare(d.Column, y, x) })
	}
}

// RowsAreTheMatches: the rows are exactly the dinosaurs that match the
// query, each once, in the sorting's order, and rows that tie keep the
// listed order.
law RowsAreTheMatches(drawn query.Query, part int) {
	// The search is a part of a listed name, or none, so rows show.
	let parts = []string{"", "", "saurus", "RAPTOR", "o", "x"}
	let q = query.Query{..drawn, Search: parts[((part%len(parts))+len(parts))%len(parts)]}
	let rows = Rows(q)
	let mut want = 0
	for d in dino.All {
		if Matches(q, d) {
			want = want + 1
		}
	}
	if len(rows) != want {
		return false
	}
	for i, d in rows {
		if !Matches(q, d) {
			return false
		}
		if i == 0 {
			continue
		}
		let prev = rows[i-1]
		let c = match q.Sorting {
		case query.Unsorted:
			0
		case query.Ascending as a:
			Compare(a.Column, prev, d)
		case query.Descending as s:
			Compare(s.Column, d, prev)
		}
		if c > 0 || (c == 0 && slices.Index(dino.All, prev) >= slices.Index(dino.All, d)) {
			return false
		}
	}
	true
}
