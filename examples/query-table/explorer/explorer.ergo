// Package explorer is the program as a machine, Explorer: the table and
// its two list boxes, the diet's and the period's. For a list box's
// signal the step runs the list box's step and folds its effects into the
// page: a Selected becomes the table's choice of that filter, so the
// table asks for the address; a Focus becomes the host's.

import querytable/dino
import querytable/listbox
import querytable/query
import querytable/table

// Page is the program's state: the table's route (the address) and the
// two list boxes.
type Page { Route query.Route, Diet listbox.Box, Period listbox.Box }

// Filter names a list box: the diet's or the period's.
type Filter = DietFilter{} | PeriodFilter{}

// Signal is what the program reads: the table's signals, a list box's
// signals, and a link of the page followed.
type Signal = OnTable{Signal table.Signal} | OnList{Filter Filter, Signal listbox.Signal} | Followed{Path string}

// Command is what the program asks the host: replace the address (the
// table's controls), push one (a link), or move the focus to a list
// box's button.
type Command = Replace{Path string} | Push{Path string} | Focus{Filter Filter}

// Open is the program at the address path, both list boxes shut.
func Open(path string) Page {
	Page{Route: table.Open(path), Diet: listbox.New(len(dino.Diets) + 1), Period: listbox.New(len(dino.Periods) + 1)}
}

// DietAt is the diet of the diet list's item i: item 0 is all diets,
// then the diets in their order.
func DietAt(i int) Option[dino.Diet] {
	if i <= 0 || i > len(dino.Diets) {
		return None
	}
	Some[dino.Diet]{Value: dino.Diets[i-1]}
}

// PeriodAt is the period of the period list's item i, as DietAt.
func PeriodAt(i int) Option[dino.Period] {
	if i <= 0 || i > len(dino.Periods) {
		return None
	}
	Some[dino.Period]{Value: dino.Periods[i-1]}
}

// DietIndex is the item of the diet list that d is.
func DietIndex(d Option[dino.Diet]) int {
	match d {
	case Some[dino.Diet] as v:
		for i, x in dino.Diets {
			if x == v.Value {
				return i + 1
			}
		}
		0
	case None:
		0
	}
}

// PeriodIndex is the item of the period list that p is.
func PeriodIndex(p Option[dino.Period]) int {
	match p {
	case Some[dino.Period] as v:
		for i, x in dino.Periods {
			if x == v.Value {
				return i + 1
			}
		}
		0
	case None:
		0
	}
}

// Box is the page's list box of f.
func Box(p Page, f Filter) listbox.Box {
	match f {
	case DietFilter:
		p.Diet
	case PeriodFilter:
		p.Period
	}
}

// Step is the program's transition.
func Step(p Page, sig Signal) Decision[Page, []Command] {
	match sig {
	case OnTable as t:
		fromTable(p, table.Step(p.Route, t.Signal))
	case OnList as l:
		let d = listbox.Step(Box(p, l.Filter), l.Signal)
		let (b, effects) = match d {
		case Emit[listbox.Box, []listbox.Effect] as e:
			(e.Next, e.Output)
		case Stay[listbox.Box] as s:
			(s.Next, []listbox.Effect{})
		case Enter[listbox.Box] as e:
			(e.Next, []listbox.Effect{})
		case Tell[listbox.Box, []listbox.Effect] as t:
			(t.Next, t.Output)
		case Ignore, Reject, Done[[]listbox.Effect]:
			return Ignore
		}
		let at = match l.Filter {
		case DietFilter:
			Page{..p, Diet: b}
		case PeriodFilter:
			Page{..p, Period: b}
		}
		let mut out = []Command{}
		for e in effects {
			match e {
			case listbox.Selected as s:
				let chose = match l.Filter {
				case DietFilter:
					table.ChoseDiet{Diet: DietAt(s.Index)}
				case PeriodFilter:
					table.ChosePeriod{Period: PeriodAt(s.Index)}
				}
				for c in commandsOf(table.Step(at.Route, chose)) {
					out = out.Append(c)
				}
			case listbox.Focus:
				out = out.Append(Focus{Filter: l.Filter})
			}
		}
		if len(out) == 0 {
			return Stay[Page]{Next: at}
		}
		Emit[Page, []Command]{Next: at, Output: out}
	case Followed as f:
		Emit[Page, []Command]{Next: p, Output: []Command{Push{Path: f.Path}}}
	}
}

// fromTable is the table's decision d as the page's.
func fromTable(p Page, d Decision[query.Route, table.Replace]) Decision[Page, []Command] {
	match d {
	case Emit[query.Route, table.Replace] as e:
		Emit[Page, []Command]{Next: Page{..p, Route: e.Next}, Output: []Command{Replace{Path: e.Output.Path}}}
	case Enter[query.Route] as e:
		Enter[Page]{Next: Page{..p, Route: e.Next}}
	case Stay[query.Route] as s:
		Stay[Page]{Next: Page{..p, Route: s.Next}}
	case Tell[query.Route, table.Replace] as t:
		Tell[Page, []Command]{Next: Page{..p, Route: t.Next}, Output: []Command{Replace{Path: t.Output.Path}}}
	case Ignore:
		Ignore
	case Reject:
		Reject
	case Done[table.Replace]:
		Unreachable("explorer: the table never ends")
	}
}

func commandsOf(d Decision[query.Route, table.Replace]) []Command {
	match d {
	case Emit[query.Route, table.Replace] as e:
		[]Command{Replace{Path: e.Output.Path}}
	case Tell[query.Route, table.Replace] as t:
		[]Command{Replace{Path: t.Output.Path}}
	case Enter[query.Route], Stay[query.Route], Ignore, Reject, Done[table.Replace]:
		[]Command{}
	}
}

// Explorer is the program as a machine; its input is the opening address.
type Explorer machine[Page, Signal] {
	initial: Open,
	step:    Step,
}

// Commands is what the decision d asks the host.
func Commands(d Decision[Page, []Command]) []Command {
	match d {
	case Emit[Page, []Command] as e:
		e.Output
	case Tell[Page, []Command] as t:
		t.Output
	case Enter[Page], Stay[Page], Ignore, Reject, Done[[]Command]:
		[]Command{}
	}
}

// AListChoiceIsTheTableChoice: opening a filter's list box and picking
// its item i asks for the address the table asks for when that filter is
// chosen directly, then gives the focus back to the list box's button;
// the list is shut after, and the route is unchanged until the host
// replaces the address (a story test: selecting a diet refocuses the
// list box's button and replaces the URL).
law AListChoiceIsTheTableChoice(q query.Query, diet bool, i int where 0 <= i && i <= 3) {
	let f Filter = if diet { DietFilter } else { PeriodFilter }
	let p = Page{..Open("/"), Route: query.Browse{Query: q}}
	let opened = match Step(p, OnList{Filter: f, Signal: listbox.Pressed{Selected: 0}}) {
	case Stay[Page] as s:
		s.Next
	case Emit[Page, []Command], Enter[Page], Tell[Page, []Command], Ignore, Reject, Done[[]Command]:
		return false
	}
	let d = Step(opened, OnList{Filter: f, Signal: listbox.Picked{Index: i}})
	let direct = if diet { table.Step(p.Route, table.ChoseDiet{Diet: DietAt(i)}) } else { table.Step(p.Route, table.ChosePeriod{Period: PeriodAt(i)}) }
	let want = commandsOf(direct).Append(Focus{Filter: f})
	let after = match d {
	case Emit[Page, []Command] as e:
		e.Next
	case Enter[Page], Stay[Page], Tell[Page, []Command], Ignore, Reject, Done[[]Command]:
		return false
	}
	Commands(d) == want && !Box(after, f).Open && after.Route == p.Route
}
