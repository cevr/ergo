// Package listbox is a list box as a machine: a button that opens a list
// of Count items, one of them active while the list is open. It knows no
// table, so it can serve any list of choices (SP1's examples/kit when that
// lands). The step's output is Selected and a Focus
// of the button, and the parent matches them.

import machines

// Box is the list box: how many items it lists, whether the list is open,
// and the active item while it is.
type Box { Count int, Open bool, Active int }

// New is a closed list box of count items.
func New(count int) Box { Box{Count: count, Open: false, Active: 0} }

// Signal is what the list box reads: its button pressed (with the item
// selected now, which an opening list makes active), the active item
// moved by some items or to an end, an item hovered or picked, and the
// list dismissed (Escape, or a press outside it).
type Signal = Pressed{Selected int} | Moved{By int} | Ended{Last bool} | Hovered{Index int} | Picked{Index int} | Dismissed{}

// Effect is what the list box asks of its parent: an item selected, and
// the focus back on its button.
type Effect = Selected{Index int} | Focus{}

// Step is the list box's transition. Pressing the button opens the list
// at the selected item or shuts it; while it is open, the arrows and the
// ends move the active item within the list, and a pick selects the item,
// shuts the list and gives the focus back, as Escape does without a
// selection. A shut list takes nothing but its button.
func Step(b Box, sig Signal) machines.Decision[Box, []Effect] {
	match sig {
	case Pressed as p:
		if b.Open {
			return machines.Stay[Box]{Next: Box{..b, Open: false}}
		}
		machines.Stay[Box]{Next: Box{..b, Open: true, Active: within(b, p.Selected)}}
	case Moved as m:
		if !b.Open {
			return machines.Ignore
		}
		machines.Stay[Box]{Next: Box{..b, Active: within(b, b.Active+m.By)}}
	case Ended as e:
		if !b.Open {
			return machines.Ignore
		}
		machines.Stay[Box]{Next: Box{..b, Active: if e.Last { b.Count - 1 } else { 0 }}}
	case Hovered as h:
		if !b.Open || h.Index < 0 || h.Index >= b.Count {
			return machines.Ignore
		}
		machines.Stay[Box]{Next: Box{..b, Active: h.Index}}
	case Picked as p:
		if !b.Open || p.Index < 0 || p.Index >= b.Count {
			return machines.Ignore
		}
		machines.Emit[Box, []Effect]{Next: Box{..b, Open: false}, Output: []Effect{Selected{Index: p.Index}, Focus}}
	case Dismissed:
		if !b.Open {
			return machines.Ignore
		}
		machines.Emit[Box, []Effect]{Next: Box{..b, Open: false}, Output: []Effect{Focus}}
	}
}

// within is i kept in b's list.
func within(b Box, i int) int {
	if i < 0 {
		return 0
	}
	if i >= b.Count {
		return b.Count - 1
	}
	i
}

// Listbox is the list box as a machine; its input is the count of items.
type Listbox machine[Box, Signal] {
	initial: New,
	step:    Step,
}

func after(b Box, d machines.Decision[Box, []Effect]) Box {
	match d {
	case machines.Emit[Box, []Effect] as e:
		e.Next
	case machines.Enter[Box] as e:
		e.Next
	case machines.Stay[Box] as s:
		s.Next
	case machines.Tell[Box, []Effect] as t:
		t.Next
	case machines.Ignore, machines.Reject, machines.Done[[]Effect]:
		b
	}
}

func signalOf(op int, count int) Signal {
	let n = if op < 0 { -(op / 2) } else { op }
	match n % 6 {
	case 0:
		Pressed{Selected: n/6%(count+2) - 1}
	case 1:
		Moved{By: n/6%5 - 2}
	case 2:
		Ended{Last: n/6%2 == 0}
	case 3:
		Hovered{Index: n/6%(count+2) - 1}
	case 4:
		Picked{Index: n/6%(count+2) - 1}
	case _:
		Dismissed
	}
}

// ActiveStaysInTheList: over drawn signals, an open list's active item is
// always one of its items, whatever the signals point at.
law ActiveStaysInTheList(size int where 1 <= size && size <= 6, ops []int) {
	let mut b = New(size)
	for o in ops {
		b = after(b, Step(b, signalOf(o, size)))
		if b.Open && (b.Active < 0 || b.Active >= b.Count) {
			return false
		}
	}
	true
}

// OnlyAPickSelects: over drawn signals, a step selects exactly when it
// picks an item of the open list, and then it selects that item, shuts
// the list and gives the focus back; Escape on an open list only gives
// the focus back; nothing else asks anything.
law OnlyAPickSelects(size int where 1 <= size && size <= 6, ops []int) {
	let mut b = New(size)
	for o in ops {
		let sig = signalOf(o, size)
		let d = Step(b, sig)
		let out = match d {
		case machines.Emit[Box, []Effect] as e:
			e.Output
		case machines.Enter[Box], machines.Stay[Box], machines.Tell[Box, []Effect], machines.Ignore, machines.Reject, machines.Done[[]Effect]:
			[]Effect{}
		}
		let want = match sig {
		case Picked as p:
			if b.Open && p.Index >= 0 && p.Index < size { []Effect{Selected{Index: p.Index}, Focus} } else { []Effect{} }
		case Dismissed:
			if b.Open { []Effect{Focus} } else { []Effect{} }
		case Pressed, Moved, Ended, Hovered:
			[]Effect{}
		}
		if out != want {
			return false
		}
		b = after(b, d)
		if out.Len() > 0 && b.Open {
			return false
		}
	}
	true
}
