// Package dino is the table's data: the dinosaurs, a constant, as
// upstream's data.ts is.

// Diet is what a dinosaur ate.
type Diet = Carnivore{} | Herbivore{} | Omnivore{}

// Period is when a dinosaur lived.
type Period = Triassic{} | Jurassic{} | Cretaceous{}

// Dinosaur is a row of the table. Its length is in tenths of a metre, so
// 12.3 m is 123.
type Dinosaur { Name string, Period Period, Diet Diet, Length int, Weight int }

// Diets and Periods are every diet and period, in the order the filters
// list them.
let Diets = []Diet{Carnivore, Herbivore, Omnivore}

let Periods = []Period{Triassic, Jurassic, Cretaceous}

// DietName is d's name, as the URL and the table write it.
func DietName(d Diet) string {
	match d {
	case Carnivore:
		"Carnivore"
	case Herbivore:
		"Herbivore"
	case Omnivore:
		"Omnivore"
	}
}

// PeriodName is p's name, as the URL and the table write it.
func PeriodName(p Period) string {
	match p {
	case Triassic:
		"Triassic"
	case Jurassic:
		"Jurassic"
	case Cretaceous:
		"Cretaceous"
	}
}

