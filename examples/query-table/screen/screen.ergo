// Package screen is the program on a screen (stage b): the heading,
// the search box, the two list boxes, the count, and
// the table with a sortable header, or the empty state; or the not-found
// page with its link back. The table's rows are an Each keyed by name,
// each row a Same keyed by the dinosaur, so a keystroke runs only the rows
// that come in. The address comes back from OnURL as the table's
// Navigated.

import option
import querytable/dino
import querytable/explorer
import querytable/listbox
import querytable/query
import querytable/table
import strconv
import ui

// Title is the page's heading.
let Title = "Dinosaur Explorer"

// SearchPlaceholder is the search box's placeholder.
let SearchPlaceholder = "Search by name…"

// Empty is the empty state's first line.
let Empty = "No dinosaurs match your filters."

// BackLink is the not-found page's link back.
let BackLink = "← Back to Dinosaur Explorer"

// Screen is the page for p.
func Screen(f mut ui.Frame[explorer.Signal], p explorer.Page) {
	ui.OnURL(f, func(u ui.URL) option.Option[explorer.Signal] { option.Some[explorer.Signal]{Value: explorer.OnTable{Signal: table.Navigated{Path: ui.Href(u)}}} })
	keys(f, p)
	ui.Column(f, ui.Plain()) {
		ui.Text(f, "ergo")
		ui.Text(f, "query-sync example")
		match p.Route {
		case query.Browse as b:
			browse(f, p, b.Query)
		case query.NotFound as n:
			heading(f, "404 — Page Not Found")
			ui.Text(f, "The path \"\(n.Path)\" was not found.")
			ui.Semantic(f, named(ui.Link, BackLink), option.Some[explorer.Signal]{Value: explorer.Followed{Path: query.Encode(query.Default)}}, ui.Plain()) {
				ui.Text(f, BackLink)
			}
		}
	}
}

// keys gives the open list box the keys: the arrows and the ends move its
// active item, Enter and Space pick it, Escape shuts the list.
func keys(f mut ui.Frame[explorer.Signal], p explorer.Page) {
	for fl in []explorer.Filter{explorer.DietFilter, explorer.PeriodFilter} {
		let b = explorer.Box(p, fl)
		if !b.Open {
			continue
		}
		ui.OnKey(f, func(k ui.KeyPress) option.Option[explorer.Signal] {
			let sig option.Option[listbox.Signal] = match k.Name {
			case "ArrowDown":
				option.Some{Value: listbox.Moved{By: 1}}
			case "ArrowUp":
				option.Some{Value: listbox.Moved{By: -1}}
			case "Home":
				option.Some{Value: listbox.Ended{Last: false}}
			case "End":
				option.Some{Value: listbox.Ended{Last: true}}
			case "Enter", " ":
				option.Some{Value: listbox.Picked{Index: b.Active}}
			case "Escape":
				option.Some{Value: listbox.Dismissed}
			case _:
				option.None
			}
			match sig {
			case option.Some[listbox.Signal] as s:
				option.Some[explorer.Signal]{Value: explorer.OnList{Filter: fl, Signal: s.Value}}
			case option.None:
				option.None
			}
		})
	}
}

func browse(f mut ui.Frame[explorer.Signal], p explorer.Page, q query.Query) {
	heading(f, Title)
	ui.Text(f, "Filter, sort, and search. Every control syncs to the URL. Try changing the filters, then copy the URL or hit the back button.")
	ui.Row(f, ui.Plain()) {
		ui.Input(f, q.Search, SearchPlaceholder, func(t string) explorer.Signal { explorer.OnTable{Signal: table.Searched{Text: t}} })
		list(f, explorer.DietFilter, p.Diet, explorer.DietIndex(q.Diet))
		list(f, explorer.PeriodFilter, p.Period, explorer.PeriodIndex(q.Period))
	}
	let rows = table.Rows(q)
	ui.Text(f, "Showing \(rows.Len()) of \(dino.All.Len()) dinosaurs")
	if rows.Len() == 0 {
		ui.Text(f, Empty)
		ui.Text(f, "Try broadening your search or removing filters.")
	} else {
		ui.Semantic(f, named(ui.Table, "Dinosaurs"), option.None, ui.Plain()) {
			ui.Semantic(f, named(ui.TableRow, "Columns"), option.None, ui.Plain()) {
				for c in query.Columns {
					header(f, c, q.Sorting)
				}
			}
			ui.Each(f, rows, func(d dino.Dinosaur) ui.Key { ui.ByText(d.Name) }) func(d dino.Dinosaur) {
				ui.Same(f, ui.ByText(d.Name)) {
					ui.Semantic(f, named(ui.TableRow, d.Name), option.None, ui.Plain()) {
						cell(f, d.Name)
						cell(f, dino.PeriodName(d.Period))
						cell(f, dino.DietName(d.Diet))
						cell(f, Metres(d.Length))
						cell(f, Kilograms(d.Weight))
					}
				}
			}
		}
	}
	ui.Text(f, "All filter and sort state lives in the URL. Share it or bookmark it.")
}

// Label is a column's header text.
func Label(c query.Column) string {
	match c {
	case query.Length:
		"Length (m)"
	case query.Weight:
		"Weight (kg)"
	case query.Name, query.Era, query.Eats:
		query.ColumnName(c)
	}
}

// Direction is how the sorting s sorts column c: none, ascending or
// descending.
func Direction(c query.Column, s query.Sorting) string {
	match s {
	case query.Ascending as a:
		if a.Column == c { "ascending" } else { "none" }
	case query.Descending as d:
		if d.Column == c { "descending" } else { "none" }
	case query.Unsorted:
		"none"
	}
}

// header is column c's header cell, named by its label, whose button sorts
// by it; the button's name says the sorting.
func header(f mut ui.Frame[explorer.Signal], c query.Column, s query.Sorting) {
	let dir = Direction(c, s)
	let name = query.ColumnName(c)
	let said = match dir {
	case "ascending":
		"Sort by \(name), currently ascending"
	case "descending":
		"Sort by \(name), currently descending"
	case _:
		"Sort by \(name)"
	}
	let mark = match dir {
	case "ascending":
		"↑"
	case "descending":
		"↓"
	case _:
		""
	}
	ui.Semantic(f, named(ui.TableCell, Label(c)), option.None, ui.Plain()) {
		ui.Semantic(f, named(ui.Button, said), option.Some[explorer.Signal]{Value: explorer.OnTable{Signal: table.Clicked{Column: c}}}, ui.Plain()) {
			ui.Text(f, Label(c))
			ui.Text(f, mark)
		}
	}
}

func cell(f mut ui.Frame[explorer.Signal], text string) {
	ui.Semantic(f, named(ui.TableCell, text), option.None, ui.Plain()) {
		ui.Text(f, text)
	}
}

// ListName is the list box of fl's name, which its group carries.
func ListName(fl explorer.Filter) string {
	match fl {
	case explorer.DietFilter:
		"Diet"
	case explorer.PeriodFilter:
		"Period"
	}
}

// ItemLabel is the label of item i of fl's list: All Diets or All Periods,
// then the values.
func ItemLabel(fl explorer.Filter, i int) string {
	match fl {
	case explorer.DietFilter:
		match explorer.DietAt(i) {
		case option.Some[dino.Diet] as d:
			dino.DietName(d.Value)
		case option.None:
			"All Diets"
		}
	case explorer.PeriodFilter:
		match explorer.PeriodAt(i) {
		case option.Some[dino.Period] as p:
			dino.PeriodName(p.Value)
		case option.None:
			"All Periods"
		}
	}
}

// list is fl's list box in a group named by it: the button, named by the
// item selected, and while it is open the list of items, the selected
// one marked and the active one known to the list.
func list(f mut ui.Frame[explorer.Signal], fl explorer.Filter, b listbox.Box, selected int) {
	ui.Semantic(f, named(ui.Group, ListName(fl)), option.None, ui.Plain()) {
		let button = ui.Access{..named(ui.Button, ItemLabel(fl, selected)), HasPopup: true, Expanded: option.Some[bool]{Value: b.Open}}
		ui.Semantic(f, button, option.Some[explorer.Signal]{Value: explorer.OnList{Filter: fl, Signal: listbox.Pressed{Selected: selected}}}, ui.Plain()) {
			ui.Text(f, ItemLabel(fl, selected))
		}
		if b.Open {
			ui.Semantic(f, ui.Access{..named(ui.Menu, ListName(fl)), Value: option.Some[string]{Value: ItemLabel(fl, b.Active)}}, option.None, ui.Plain()) {
				for i in 0..b.Count {
					let item = ui.Access{..named(ui.MenuItem, ItemLabel(fl, i)), Selected: option.Some[bool]{Value: i == selected}}
					ui.Semantic(f, item, option.Some[explorer.Signal]{Value: explorer.OnList{Filter: fl, Signal: listbox.Picked{Index: i}}}, ui.Plain()) {
						ui.Text(f, ItemLabel(fl, i))
					}
				}
			}
		}
	}
}

// Metres prints a length in tenths of a metre.
func Metres(tenths int) string {
	let whole = strconv.Itoa(tenths / 10)
	if tenths%10 == 0 { whole } else { whole + "." + strconv.Itoa(tenths%10) }
}

// Kilograms is a weight with thousands grouped, as toLocaleString does.
func Kilograms(kg int) string {
	let s = strconv.Itoa(kg)
	let mut out = ""
	for i in 0..s.Len() {
		if i > 0 && (s.Len()-i)%3 == 0 {
			out = out + ","
		}
		out = out + s[i:i+1]
	}
	out
}

func heading(f mut ui.Frame[explorer.Signal], text string) {
	ui.Semantic(f, ui.Access{..named(ui.Heading, text), Level: option.Some[int]{Value: 1}}, option.None, ui.Plain()) {
		ui.Text(f, text)
	}
}

// named is the access of a node with a role and a name.
func named(role ui.Role, name string) ui.Access {
	ui.Access{Role: role, Name: name, Disabled: false, Description: "", Checked: option.None, Value: option.None, Selected: option.None, Expanded: option.None, Pressed: option.None, Invalid: false, Busy: false, HasPopup: false, Level: option.None, Mixed: false, Current: option.None, Modal: false, MultiSelectable: false, Range: option.None, Key: ui.NoKey, Rels: []ui.Rel{}}
}
