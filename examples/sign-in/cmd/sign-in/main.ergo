// sign-in is a member sign-in screen driven by a script on standard
// input. This binary is the only place that chooses the providers: the
// in-memory member directory, a manual clock for the screen's timers, and
// the host's standard input.

import io
import time
import signin/memory
import signin/screen
import signin/signin

func main() needs Console | Ambient {
	let clock = time.NewManual(0)
	with context { io.Stdin: io.NewStdin(), Scheduler: clock, signin.Codes: memory.Directory } {
		screen.Run(clock)
	}
}
