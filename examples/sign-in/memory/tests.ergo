// Directory keeps the laws of signin.Codes. ergo test does not run a law
// of an imported operation type against this package's providers yet
// (types.md Laws rule 10; finding F4), so these properties call the
// laws' checks with Directory bound.

import signin/signin

test DirectoryCheckIsStable(phone string, code string) {
	with context { signin.Codes: Directory } {
		assert signin.CheckText(phone, code) == signin.CheckText(phone, code)
		assert signin.CheckText(phone, CodeFor(phone)) != "wrong" || len(phone) < 4
	}
}

test DirectoryCardIsStable(card string) {
	with context { signin.Codes: Directory } {
		assert signin.CardText(card) == signin.CardText(card)
	}
}
