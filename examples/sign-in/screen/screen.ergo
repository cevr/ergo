// Package screen drives the sign-in flow as an actor from a script of
// lines, one per touch, key or scan, and prints what the screen shows. A
// script's first line may name the methods on: `methods phone card`.
//
// Commands: phone, type DIGITS, erase, submit, scan CARD, wait (30 s pass
// on the screen's clock), cancel. The card reader is the script itself:
// a `scan` line is a scan, sent to the actor like a touch (M49, an
// actor-lifetime source, is not built).

import actor
import io
import machines
import strconv
import strings
import time
import signin/pad
import signin/signin

// Command is a line of the script.
type Command = Send{Signals []signin.Signal} | Wait{} | Unknown{Line string}

// Parse reads a line.
func Parse(line string) Command {
	let words = strings.Fields(line)
	if len(words) == 0 {
		return Unknown{Line: line}
	}
	let arg = if len(words) > 1 { words[1] } else { "" }
	match words[0] {
	case "phone":
		Send{Signals: []signin.Signal{signin.UsePhone}}
	case "type":
		let mut keys = []signin.Signal{}
		for i in 0..len(arg) {
			let d = strconv.Atoi(strings.Slice(arg, i, i+1)) catch {
			case strconv.Malformed:
				return Unknown{Line: line}
			case strconv.OutOfRange:
				return Unknown{Line: line}
			}
			keys = keys.Append(signin.Press{Key: pad.Digit{D: d}})
		}
		Send{Signals: keys}
	case "erase":
		Send{Signals: []signin.Signal{signin.Press{Key: pad.Erase}}}
	case "submit":
		Send{Signals: []signin.Signal{signin.Submit}}
	case "scan":
		Send{Signals: []signin.Signal{signin.Scanned{Card: arg}}}
	case "cancel":
		Send{Signals: []signin.Signal{signin.Cancel}}
	case "wait":
		Wait
	case _:
		Unknown{Line: line}
	}
}

// methods reads a `methods ...` line.
func methods(line string) signin.Methods {
	let words = strings.Fields(line)
	let mut on = signin.Methods{Phone: false, Card: false}
	for w in words {
		match w {
		case "phone":
			on = signin.Methods{..on, Phone: true}
		case "card":
			on = signin.Methods{..on, Card: true}
		case _:
		}
	}
	on
}

// Show is what the screen shows in a state.
func Show(s signin.Flow) string {
	match s {
	case signin.Options as o:
		"choose: \(choices(o.On))"
	case signin.EnteringPhone as p:
		"phone: \(shown(p.Pad))"
	case signin.SendingCode as w:
		"sending a code to \(w.Phone)"
	case signin.EnteringCode as c:
		"code for \(c.Phone): \(shown(c.Pad)) (wrong so far: \(c.Tries))"
	case signin.Verifying as v:
		match v.Via {
		case signin.ByCode:
			"checking the code"
		case signin.ByCard as b:
			"checking card \(b.Card)"
		}
	case signin.Failed as f:
		"sorry: \(f.Why)"
	}
}

func choices(on signin.Methods) string {
	match (on.Phone, on.Card) {
	case (true, true):
		"phone or card"
	case (true, false):
		"phone"
	case (false, true):
		"scan a card"
	case (false, false):
		"nothing"
	}
}

func shown(p pad.Pad) string { p.Text + strings.Repeat("_", p.Max-len(p.Text)) }

// Told is the line for a result.
func Told(r signin.Result) string {
	match r {
	case signin.SignedIn as s:
		"welcome, \(s.Who.Name) (\(s.Who.ID))"
	case signin.Locked as l:
		"locked: too many wrong codes for \(l.Phone)"
	case signin.Cancelled:
		"cancelled"
	}
}

// answer is the word for the step's decision of a signal.
func answer(d Decision[signin.Flow, signin.Result]) string {
	match d {
	case Enter[signin.Flow]:
		""
	case Stay[signin.Flow]:
		""
	case Emit[signin.Flow, signin.Result]:
		""
	case Ignore:
		"(ignored)"
	case Reject:
		"(refused)"
	case Done[signin.Result] as r:
		Told(r.Output)
	}
}

// Run plays the script on standard input against the flow, on clock.
func Run(clock time.Manual) needs Console | io.Stdin | Scheduler | signin.Codes {
	let mut lines = []string{}
	for line in io.Stdin.Lines() {
		lines = lines.Append(line)
	}
	let mut on = signin.Methods{Phone: true, Card: true}
	let mut from = 0
	if len(lines) > 0 && strings.HasPrefix(lines[0], "methods") {
		on = methods(lines[0])
		from = 1
	}
	let a = actor.StartMachine(machines.Start(signin.SignIn{}, on), 8, func(r signin.Result) {})
	Console.Println("screen: \(Show(a.State()))")
	let mut ended = false
	for i in from..len(lines) {
		Console.Println("> \(lines[i])")
		if ended {
			Console.Println("(the sign-in has ended)")
			continue
		}
		match Parse(lines[i]) {
		case Unknown as u:
			Console.Println("? unknown command: \(u.Line)")
			continue
		case Wait:
			// The error screen's timer sleeps on the clock from a task of
			// its own, which may not sleep yet: wait for it before moving
			// the clock (finding F2).
			match a.State() {
			case signin.Failed:
				for clock.Sleepers() == 0 {
				}
			case _:
			}
			clock.Advance(30s)
		case Send as cmd:
			for e in cmd.Signals {
				let d = a.Ask(e) catch {
				case actor.Stopped:
					ended = true
					break
				}
				match d {
				case Done[signin.Result]:
					ended = true
				case _:
				}
				let told = answer(d)
				if told != "" && (told != "(ignored)" || len(cmd.Signals) == 1) {
					Console.Println(told)
				}
				if ended {
					break
				}
			}
		}
		if ended {
			continue
		}
		// Wait until the screen waits for the person again: a sent code or
		// a verify has answered, and an error screen's timer has fired.
		let s = actor.WaitFor(a, func(s signin.Flow) bool {
			match s {
			case signin.Failed:
				!timePassed(lines[i])
			case _:
				signin.Waits(s)
			}
		}) catch {
		case actor.Stopped:
			// The work's answer ended the flow (a verify that signed in).
			Console.Println(Ending(actor.ExitOf(a)))
			ended = true
			continue
		}
		Console.Println("screen: \(Show(s))")
	}
	a.Stop()
	if !ended {
		Console.Println(Ending(actor.ExitOf(a)))
	}
}

// Ending is the line for the actor's exit.
func Ending(e actor.Exit[signin.Flow, signin.Result]) string {
	match e {
	case actor.Finished[signin.Flow, signin.Result] as f:
		Told(f.Output)
	case actor.Halted[signin.Flow] as h:
		"left at: \(Show(h.State))"
	case actor.Defected:
		"defect"
	}
}

// timePassed reports whether the line was a wait: an error screen then
// is one the timer has not left yet.
func timePassed(line string) bool { strings.TrimSpace(line) == "wait" }
