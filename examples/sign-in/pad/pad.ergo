// Package pad is the digit entry of a sign-in screen: a small pure machine
// that the flow keeps in a field of its state and steps with Press (the
// region pattern: a sub-machine held as data, M56).

// Pad is the digits typed so far, and how many the field takes.
type Pad { Text string, Max int }

// Key is a key of the on-screen pad.
type Key = Digit{D int} | Erase{}

// Empty is a pad with no digits that takes max of them.
func Empty(max int) Pad { Pad{Text: "", Max: max} }

// Press is the pad after the key k. A digit outside 0 to 9 and a digit on
// a full pad change nothing; Erase on an empty pad changes nothing.
func Press(p Pad, k Key) Pad {
	match k {
	case Digit as d:
		if d.D < 0 || d.D > 9 || len(p.Text) >= p.Max {
			p
		} else {
			Pad{..p, Text: p.Text + "\(d.D)"}
		}
	case Erase:
		if len(p.Text) == 0 {
			p
		} else {
			Pad{..p, Text: p.Text[0 : len(p.Text)-1]}
		}
	}
}

// Full reports whether the pad holds all its digits.
func Full(p Pad) bool { len(p.Text) == p.Max }
