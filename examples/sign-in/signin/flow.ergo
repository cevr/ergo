// Package signin is a member sign-in screen: a phone number and a one-time
// code, or a member card scan. The flow is a machine whose states own
// their work (sending and checking a code) and their timer (an error
// screen returns to the start after 30 s).

import machines
import signin/pad

// Methods are the ways in that the screen offers: the machine's input.
type Methods { Phone bool, Card bool }

// Proof is what a verify checks.
type Proof = ByCode{Phone string, Code string, Tries int} | ByCard{Card string}

// Flow is the screen's state. The pads are the digit-entry sub-machine,
// held as data.
type Flow =
	| Options{On Methods}
	| EnteringPhone{On Methods, Pad pad.Pad}
	| SendingCode{On Methods, Phone string}
	| EnteringCode{On Methods, Phone string, Pad pad.Pad, Tries int}
	| Verifying{On Methods, Via Proof}
	| Failed{On Methods, Why string}

// Signal is what the flow takes: keys and scans from the person, results
// of the states' work, and the error screen's timer.
type Signal =
	| UsePhone{}
	| Press{Key pad.Key}
	| Submit{}
	| Scanned{Card string}
	| CodeSent{}
	| SendFailed{Why string}
	| Accepted{Who Member}
	| WrongCode
	| UnknownCard
	| Back{}
	| Cancel{}

// Result is how a sign-in ends.
type Result = SignedIn{Who Member} | Locked{Phone string} | Cancelled{}

// PhoneDigits is the length of a phone number; CodeDigits of a code;
// MaxTries the wrong codes that lock the phone.
func PhoneDigits() int { 10 }

func CodeDigits() int { 4 }

func MaxTries() int { 3 }

// SignIn is the flow as a machine.
type SignIn machine[Flow, Signal] { initial: Start, step: Step, after: timer, work: work }

// Start is the first state for the methods on.
func Start(on Methods) Flow { Settle(Options{On: on}) }

// Settle is the eventless step (M48 pattern): a state that has nothing to
// choose becomes the state it would choose. Options with the phone as the
// only method is the phone pad at once.
func Settle(s Flow) Flow {
	match s {
	case Options as o:
		if o.On.Phone && !o.On.Card {
			EnteringPhone{On: o.On, Pad: pad.Empty(PhoneDigits())}
		} else {
			s
		}
	case EnteringPhone:
		s
	case SendingCode:
		s
	case EnteringCode:
		s
	case Verifying:
		s
	case Failed:
		s
	}
}

// Waits reports whether the state waits for the person: no work runs in
// it, so a driver that waits for it sees the work's answer.
func Waits(s Flow) bool {
	match s {
	case Options:
		true
	case EnteringPhone:
		true
	case SendingCode:
		false
	case EnteringCode:
		true
	case Verifying:
		false
	case Failed:
		true
	}
}

// into enters next, settled.
func into(next Flow) Decision[Flow, Result] { Enter[Flow]{Next: Settle(next)} }

// scan is a card scan in a state that waits for the person: it skips the
// phone and verifies the card, when the screen takes cards.
func scan(on Methods, card string) Decision[Flow, Result] {
	if on.Card {
		into(Verifying{On: on, Via: ByCard{Card: card}})
	} else {
		Reject
	}
}

// wrong is a wrong code: the code pad again, or Locked at the last try.
func wrong(v Verifying) Decision[Flow, Result] {
	match v.Via {
	case ByCode as b:
		if b.Tries+1 >= MaxTries() {
			Done[Result]{Output: Locked{Phone: b.Phone}}
		} else {
			into(EnteringCode{On: v.On, Phone: b.Phone, Pad: pad.Empty(CodeDigits()), Tries: b.Tries + 1})
		}
	case ByCard:
		Ignore
	}
}

// Step is the flow's step. Cancel ends it from every state; each state
// then lists what it takes, and ignores the rest.
func Step(s Flow, e Signal) Decision[Flow, Result] {
	match (s, e) {
	case (_, Cancel):
		Done[Result]{Output: Cancelled}
	case (Options as o, UsePhone):
		if o.On.Phone {
			into(EnteringPhone{On: o.On, Pad: pad.Empty(PhoneDigits())})
		} else {
			Reject
		}
	case (Options as o, Scanned as c):
		scan(o.On, c.Card)
	case (Options, _):
		Ignore
	case (EnteringPhone as p, Press as k):
		Stay[Flow]{Next: EnteringPhone{..p, Pad: pad.Press(p.Pad, k.Key)}}
	case (EnteringPhone as p, Submit):
		if pad.Full(p.Pad) {
			into(SendingCode{On: p.On, Phone: p.Pad.Text})
		} else {
			Reject
		}
	case (EnteringPhone as p, Scanned as c):
		scan(p.On, c.Card)
	case (EnteringPhone, _):
		Ignore
	case (SendingCode as w, CodeSent):
		into(EnteringCode{On: w.On, Phone: w.Phone, Pad: pad.Empty(CodeDigits()), Tries: 0})
	case (SendingCode as w, SendFailed as f):
		into(Failed{On: w.On, Why: f.Why})
	case (SendingCode, _):
		Ignore
	case (EnteringCode as c, Press as k):
		Stay[Flow]{Next: EnteringCode{..c, Pad: pad.Press(c.Pad, k.Key)}}
	case (EnteringCode as c, Submit):
		if pad.Full(c.Pad) {
			into(Verifying{On: c.On, Via: ByCode{Phone: c.Phone, Code: c.Pad.Text, Tries: c.Tries}})
		} else {
			Reject
		}
	case (EnteringCode as c, Scanned as sc):
		scan(c.On, sc.Card)
	case (EnteringCode, _):
		Ignore
	case (Verifying, Accepted as a):
		Done[Result]{Output: SignedIn{Who: a.Who}}
	case (Verifying as v, WrongCode):
		wrong(v)
	case (Verifying as v, UnknownCard):
		into(Failed{On: v.On, Why: "unknown card"})
	case (Verifying, _):
		Ignore
	case (Failed as f, Back):
		into(Options{On: f.On})
	case (Failed as f, Scanned as c):
		scan(f.On, c.Card)
	case (Failed, _):
		Ignore
	}
}

// timer is each state's timer: an error screen returns to the start after
// 30 s. The runner owns it: a re-entry restarts it, and it never fires
// after its entry ended.
func timer(s Flow) Option[Timeout[Signal]] {
	match s {
	case Failed:
		Some{Timeout[Signal]{In: 30s, Signal: Back}}
	case Options:
		None
	case EnteringPhone:
		None
	case SendingCode:
		None
	case EnteringCode:
		None
	case Verifying:
		None
	}
}

// work is each state's work against Codes. The runner starts it after the
// state's entry commits and interrupts it when the entry ends, so a Cancel
// during a verify drops its answer. WrongCode and UnknownCard are signals
// and need no map; Unreachable is mapped to SendFailed.
func work(s Flow) Option[machines.Work[Signal, Codes]] {
	match s {
	case SendingCode as w:
		Some{machines.Work{Run: func() Signal fails Unreachable needs Codes {
			try Codes.Send(w.Phone)
			CodeSent
		}, OnFailure: func(f) {
			match f {
			case Unreachable as u:
				SendFailed{Why: "cannot send a code to \(u.Phone)"}
			}
		}}}
	case Verifying as v:
		match v.Via {
		case ByCode as b:
			Some{machines.Work{Run: func() Member fails WrongCode needs Codes { try Codes.Check(b.Phone, b.Code) }, OnSuccess: func(m Member) Signal { Accepted{Who: m} }}}
		case ByCard as c:
			Some{machines.Work{Run: func() Member fails UnknownCard needs Codes { try Codes.Card(c.Card) }, OnSuccess: func(m Member) Signal { Accepted{Who: m} }}}
		}
	case Options:
		None
	case EnteringPhone:
		None
	case EnteringCode:
		None
	case Failed:
		None
	}
}
