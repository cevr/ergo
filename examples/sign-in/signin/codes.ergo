// Member is a signed-in member.
type Member { ID string, Name string }

// Unreachable is a phone that a code cannot be sent to.
type Unreachable { Phone string }

// WrongCode is a code that does not match the one sent. It is also a
// signal of the flow, so the work that checks a code needs no failure map.
type WrongCode {}

// UnknownCard is a card that names no member. It is a signal too.
type UnknownCard {}

// Codes is the contract the flow needs: it sends one-time codes, checks
// them, and reads member cards. A provider package implements it (memory
// in this program).
type Codes {
	Send(phone string) fails Unreachable,
	Check(phone string, code string) Member fails WrongCode,
	Card(card string) Member fails UnknownCard,

	// CheckIsStable: asking twice about one code gives one answer, so a
	// verify that an exit interrupted can run again.
	law CheckIsStable(phone string, code string) {
		CheckText(phone, code) == CheckText(phone, code)
	},
	// CardIsStable: a card names the same member, or none, each time.
	law CardIsStable(card string) {
		CardText(card) == CardText(card)
	},
}

// CheckText is Check's answer as text: the member's ID, or "wrong".
func CheckText(phone string, code string) string needs Codes {
	let m = Codes.Check(phone, code) catch {
	case WrongCode:
		return "wrong"
	}
	m.ID
}

// CardText is Card's answer as text: the member's ID, or "unknown".
func CardText(card string) string needs Codes {
	let m = Codes.Card(card) catch {
	case UnknownCard:
		return "unknown"
	}
	m.ID
}
