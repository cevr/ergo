// Package screen is the board's view (stage b): one Area that takes the
// pointer, a Zone per column and per card that names what the pointer is
// over (H5g), a button per card that lifts it for a keyboard drag, the
// keys of a drag, the form that adds a card, and the live region that
// says what happens.

import option
import taskboard/board
import taskboard/drag
import taskboard/kanban
import ui

// Label is the Area's label: the board.
let Label = "Board"

// AddLabel is the label of each column's add button.
let AddLabel = "+ Add card"

// TitleLabel is the form's input, named by its placeholder.
let TitleLabel = "New card title"

// Screen is the board: the columns side by side in the Area, each with
// its name, its count, its cards and its add button or form; while a
// pointer drag is over a spot, a drop placeholder there; and the live
// region with what the program last said.
func Screen(f mut ui.Frame[kanban.Signal], b kanban.Board) {
	ui.OnKey(f, keys(b))
	ui.Area(f, Label, ui.Plain(), pointer(b)) {
		ui.Row(f, ui.Plain()) {
			ui.Each(f, b.Columns, func(c board.Column) ui.Key { ui.ByText(c.ID) }) func(c board.Column) {
				column(f, b, c)
			}
		}
	}
	ui.Announce(f, b.Said)
}

// column is a column's zone: its name and count, its cards (with the
// drop placeholder where a pointer drag would drop), and the form or the
// add button.
func column(f mut ui.Frame[kanban.Signal], b kanban.Board, c board.Column) {
	ui.Zone(f, ui.ByText(c.ID), ui.Plain()) {
		ui.Text(f, c.Name)
		ui.Text(f, "\(c.Cards.Len())")
		let drop = dropAt(b.Drag.State, c.ID)
		let mut shown = 0
		for i, card in c.Cards {
			if drop == (option.Some{Value: shown}) && !held(b.Drag.State, card.ID) {
				placeholder(f)
			}
			if !held(b.Drag.State, card.ID) {
				shown = shown + 1
			}
			cardView(f, b, c, card, i)
		}
		if drop == (option.Some{Value: shown}) {
			placeholder(f)
		}
		match b.Adding {
		case option.Some[string] as at:
			if at.Value == c.ID {
				form(f, b)
			} else {
				addButton(f, c)
			}
		case option.None:
			addButton(f, c)
		}
	}
}

// cardView is a card's zone: a button, named by the card's title, whose
// press lifts the card for a keyboard drag, with the title, the
// description, and how the drag holds it.
//
// The card's body is a Same keyed by all it shows and sends (its column,
// its position, its text and its mark), so a pass runs the bodies of only
// the cards that changed: a pointer move over a long column runs none.
func cardView(f mut ui.Frame[kanban.Signal], b kanban.Board, c board.Column, card board.Card, at int) {
	let mark = markOf(b.Drag.State, card.ID)
	ui.Zone(f, ui.ByText(card.ID), ui.Plain()) {
		ui.Same(f, ui.ByText("\(c.ID)\n\(at)\n\(card.Title)\n\(card.Description)\n\(mark)")) {
			ui.Pressable(f, card.Title, kanban.Dragging{Signal: drag.Activated{Item: card.ID, Container: c.ID, Index: at}}) {
				ui.Text(f, card.Title)
				if card.Description != "" {
					ui.Text(f, card.Description)
				}
				if mark != "" {
					ui.Text(f, mark)
				}
			}
		}
	}
}

// markOf is how a drag holds the card id: "(dragging)" under a pointer,
// "(lifted to COLUMN N)" on the keyboard, "" when it does not hold it.
func markOf(s drag.State, id string) string {
	match s {
	case drag.Dragging as g:
		if g.Item == id { "(dragging)" } else { "" }
	case drag.Lifted as l:
		if l.Item == id { "(lifted to \(l.To) \(l.ToIndex + 1))" } else { "" }
	case drag.Idle, drag.Pending:
		""
	}
}

func placeholder(f mut ui.Frame[kanban.Signal]) { ui.Text(f, "(drop here)") }

func addButton(f mut ui.Frame[kanban.Signal], c board.Column) {
	ui.Pressable(f, AddLabel, kanban.AddClicked{Column: c.ID}) {
		ui.Text(f, AddLabel)
	}
}

// form is the add-card form: the title, Cancel and Add.
func form(f mut ui.Frame[kanban.Signal], b kanban.Board) {
	ui.Input(f, b.Title, TitleLabel, func(t string) kanban.Signal { kanban.Typed{Text: t} })
	ui.Pressable(f, "Cancel", kanban.Cancelled) {
		ui.Text(f, "Cancel")
	}
	ui.Pressable(f, "Add", kanban.Submitted) {
		ui.Text(f, "Add")
	}
}

// held is whether a pointer drag holds the card id.
func held(s drag.State, id string) bool {
	match s {
	case drag.Dragging as g:
		g.Item == id
	case drag.Idle, drag.Pending, drag.Lifted:
		false
	}
}

// dropAt is where a pointer drag over the column col would drop: the
// position among the column's other cards.
func dropAt(s drag.State, col string) option.Option[int] {
	match s {
	case drag.Dragging as g:
		match g.Target {
		case option.Some[drag.Target] as t:
			if t.Value.Container == col {
				return option.Some{Value: t.Value.Index}
			}
			option.None
		case option.None:
			option.None
		}
	case drag.Idle, drag.Pending, drag.Lifted:
		option.None
	}
}

// pointer is the Area's pointer: a press on a card starts a drag of it,
// a move while one is pressed or dragged says where it is and what spot
// it is over, and the release ends it. A move with no drag, and a wheel,
// say nothing.
func pointer(b kanban.Board) func(p ui.PointerEvent) option.Option[kanban.Signal] {
	func(p ui.PointerEvent) option.Option[kanban.Signal] {
		let at = drag.Point{X: int(p.X), Y: int(p.Y)}
		match p.Phase {
		case ui.Down:
			match spotOf(b, p.Zone, "") {
			case option.Some[Over] as o:
				match o.Value.Card {
				case option.Some[string] as card:
					option.Some{Value: kanban.Dragging{Signal: drag.Pressed{Item: card.Value, Container: o.Value.Column, Index: o.Value.Index, Screen: at}}}
				case option.None:
					option.None
				}
			case option.None:
				option.None
			}
		case ui.Moved, ui.Drag:
			match drag.Item(b.Drag.State) {
			case option.Some[string] as item:
				let target = match spotOf(b, p.Zone, item.Value) {
				case option.Some[Over] as o:
					option.Some{Value: drag.Target{Container: o.Value.Column, Index: o.Value.Index}}
				case option.None:
					option.None
				}
				option.Some{Value: kanban.Dragging{Signal: drag.Moved{Screen: at, Client: at, Target: target}}}
			case option.None:
				option.None
			}
		case ui.Up:
			match b.Drag.State {
			case drag.Pending, drag.Dragging:
				option.Some{Value: kanban.Dragging{Signal: drag.Released}}
			case drag.Idle, drag.Lifted:
				option.None
			}
		case ui.Wheel, ui.PointerEnter, ui.PointerLeave:
			option.None
		}
	}
}

// Over is a spot the pointer is over: a column, the position there, and
// the card under the pointer, if any.
type Over { Column string, Index int, Card option.Option[string] }

// spotOf is the spot under the pointer's zone: over a card, its position
// among the column's cards other than item (the one dragged), and one
// further in the card's lower half; over a column and no card, its end.
func spotOf(b kanban.Board, z option.Option[ui.ZoneHit], item string) option.Option[Over] {
	let hit = match z {
	case option.Some[ui.ZoneHit] as h:
		h.Value
	case option.None:
		return option.None
	}
	if hit.Path.Len() == 0 {
		return option.None
	}
	for c in b.Columns {
		if ui.ByText(c.ID) != hit.Path[0] {
			continue
		}
		let mut before = 0
		for i, card in c.Cards {
			if hit.Path.Len() > 1 && ui.ByText(card.ID) == hit.Path[1] {
				let lower = if card.ID != item && hit.Y >= float64(hit.Box.H)/2.0 { 1 } else { 0 }
				return option.Some{Value: Over{Column: c.ID, Index: if item == "" { i } else { before + lower }, Card: option.Some{Value: card.ID}}}
			}
			if card.ID != item {
				before = before + 1
			}
		}
		return option.Some{Value: Over{Column: c.ID, Index: before, Card: option.None}}
	}
	option.None
}

// keys is the board's keys: Escape shuts the form; while a card is
// lifted, the arrows move it, Tab (Shift+Tab) moves it to the next
// (previous) column, Space or Enter drops it and Escape puts it back;
// while a pointer drag runs, Escape gives it up.
func keys(b kanban.Board) func(k ui.KeyPress) option.Option[kanban.Signal] {
	func(k ui.KeyPress) option.Option[kanban.Signal] {
		if b.Adding != option.None && k.Name == "Escape" {
			return option.Some{Value: kanban.Cancelled}
		}
		match b.Drag.State {
		case drag.Lifted:
			let sig option.Option[drag.Signal] = match k.Name {
			case "ArrowUp":
				option.Some{Value: drag.Arrow{Way: drag.Up}}
			case "ArrowDown":
				option.Some{Value: drag.Arrow{Way: drag.Down}}
			case "ArrowLeft":
				option.Some{Value: drag.Arrow{Way: drag.Left}}
			case "ArrowRight":
				option.Some{Value: drag.Arrow{Way: drag.Right}}
			case "Tab":
				option.Some{Value: drag.Arrow{Way: if k.Mods.Shift { drag.PreviousContainer } else { drag.NextContainer }}}
			case " ", "Enter":
				option.Some{Value: drag.Confirmed}
			case "Escape":
				option.Some{Value: drag.Cancel}
			case _:
				option.None
			}
			match sig {
			case option.Some[drag.Signal] as s:
				option.Some{Value: kanban.Dragging{Signal: s.Value}}
			case option.None:
				option.None
			}
		case drag.Pending, drag.Dragging:
			if k.Name == "Escape" {
				return option.Some{Value: kanban.Dragging{Signal: drag.Cancel}}
			}
			option.None
		case drag.Idle:
			option.None
		}
	}
}
