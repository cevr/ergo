// Package kanban is the board as a program: the machine Kanban, whose
// state holds the columns, the drag (package drag, a child machine whose
// output the step folds in), the form that adds a card, and the line a
// screen reader says. Its output is the commands the host runs: make a
// card's id, save the board, and focus the form or a card.

import taskboard/board
import taskboard/drag
import strings

// Board is the program's state.
type Board { Columns []board.Column, Drag drag.Drag, Adding Option[string], Title string, Said string }

// CancelRestoresTheBoard: any drag, by pointer or keyboard, that is
// given up (Escape, or a release over nothing) leaves the board as it
// was and asks for no save, and Escape leaves the drag idle.
law CancelRestoresTheBoard(ops []int) {
	let mut r = fresh()
	for o in ops {
		r = feed(r, Dragging{Signal: dragSignal(r.Board, o)})
		match r.Board.Drag.State {
		case drag.Dragging as g:
			// A release here would drop on the target; give it up instead.
			if pick(o/3, 2) == 0 {
				r = feed(r, Dragging{Signal: drag.Moved{Screen: g.Origin, Client: g.At, Target: None}})
				r = feed(r, Dragging{Signal: drag.Released})
			}
		case drag.Idle, drag.Pending, drag.Lifted:
		}
	}
	r = feed(r, Dragging{Signal: drag.Cancel})
	r.Board.Columns == board.Defaults && r.Saves == 0 && r.Board.Drag.State == drag.Idle
}

// dragSignal is a drawn drag signal that never drops: a press, a move
// over a drawn target or none, an arrow, a pick-up, Escape, or a release
// over nothing.
func dragSignal(b Board, o int) drag.Signal {
	let col = b.Columns[pick(o/8, 3)]
	let index = pick(o/24, 8)
	let item = if len(col.Cards) == 0 { "card-1" } else { col.Cards[pick(o/24, len(col.Cards))].ID }
	let op = pick(o, 8)
	if op == 0 {
		return drag.Pressed{Item: item, Container: col.ID, Index: index, Screen: drag.Point{X: 100, Y: 100}}
	}
	if op == 1 || op == 2 {
		let target Option[drag.Target] = if op == 1 { Some[drag.Target]{Value: drag.Target{Container: col.ID, Index: index}} } else { None }
		return drag.Moved{Screen: drag.Point{X: 100 + index*3, Y: 100 + index*7}, Client: drag.Point{X: 1, Y: 1}, Target: target}
	}
	if op == 3 {
		let ways = []drag.Direction{drag.Up, drag.Down, drag.Left, drag.Right, drag.NextContainer, drag.PreviousContainer}
		return drag.Arrow{Way: ways[pick(o/8, 6)]}
	}
	if op == 4 {
		return drag.Activated{Item: item, Container: col.ID, Index: index}
	}
	if op == 5 {
		return drag.Cancel
	}
	if op == 6 {
		return drag.ScrollFrame
	}
	drag.Moved{Screen: drag.Point{X: 0, Y: 0}, Client: drag.Point{X: 0, Y: 0}, Target: None}
}

// Signal is what the program reads: a signal of the drag; Add card
// clicked on a column; the form's title typed, submitted, cancelled; and
// the host's answers (an id made, a save done, the form focused).
type Signal = Dragging{Signal drag.Signal} | AddClicked{Column string} | Typed{Text string} | Submitted{} | Cancelled{} | IDMade{ID string, Column string, Title string} | Saved{} | FormFocused{}

// NewCardFollowsTheForm: drawn clicks, titles, submits and cancels
// against a reference of the form: a click opens it on its column with
// no title; a submit of a title that is not blank adds the trimmed title
// as a card at the end of that column, shuts the form and saves once; a
// blank submit or a submit with the form shut changes nothing; a cancel
// shuts it.
law NewCardFollowsTheForm(ops []int) {
	let mut r = fresh()
	let mut adding = ""
	let mut title = ""
	let mut want = Run{Board: r.Board, Saves: 0, Made: 0}
	let mut lists = board.Defaults
	for o in ops {
		let op = pick(o, 4)
		if op == 0 {
			let c = columnIDs[pick(o/4, 3)]
			r = feed(r, AddClicked{Column: c})
			adding = c
			title = ""
		} else if op == 1 {
			let t = titles[pick(o/4, len(titles))]
			r = feed(r, Typed{Text: t})
			title = t
		} else if op == 2 {
			r = feed(r, Submitted)
			let trimmed = strings.TrimSpace(title)
			if adding != "" && trimmed != "" {
				want = Run{..want, Saves: want.Saves + 1, Made: want.Made + 1}
				let mut next = []board.Column{}
				for c in lists {
					next = next.Append(if c.ID == adding { board.Append(c, board.Card{ID: "new-\(want.Made)", Title: trimmed, Description: "", Key: ""}) } else { c })
				}
				lists = next
				adding = ""
				title = ""
			}
		} else {
			r = feed(r, Cancelled)
			adding = ""
			title = ""
		}
		let open Option[string] = if adding == "" { None } else { Some[string]{Value: adding} }
		if r.Board.Adding != open || r.Board.Title != title || r.Board.Columns != lists || r.Saves != want.Saves {
			return false
		}
	}
	true
}

// Run is the program after sig and the answers to what it asks, with the
// saves it asked for.
type Run { Board Board, Saves int, Made int }

// feed steps r with sig and answers every command it causes.
func feed(r Run, sig Signal) Run {
	let mut at = r
	let mut queue = []Signal{sig}
	for len(queue) > 0 {
		let s = queue[0]
		queue = queue[1:]
		let d = Step(at.Board, s)
		at = Run{..at, Board: After(at.Board, d)}
		for c in Commands(d) {
			match c {
			case MakeID as m:
				at = Run{..at, Made: at.Made + 1}
				queue = queue.Append(IDMade{ID: "new-\(at.Made)", Column: m.Column, Title: m.Title})
			case Save:
				at = Run{..at, Saves: at.Saves + 1}
				queue = queue.Append(Saved)
			case FocusForm:
				queue = queue.Append(FormFocused)
			case FocusCard:
				queue = queue.Append(Dragging{Signal: drag.Focused})
			case Locate as l:
				let to = board.Step(at.Board.Columns, l.Item, l.At, l.Way)
				queue = queue.Append(Dragging{Signal: drag.Resolved{Container: to.Column, Index: to.Index}})
			}
		}
	}
	at
}

func fresh() Run { Run{Board: Start(board.Defaults), Saves: 0, Made: 0} }

func pick(n int, size int) int { ((n % size) + size) % size }

let columnIDs = []string{"todo", "in-progress", "done"}

let titles = []string{"", "   ", "Polish the lens", "  Count the moths  "}

// KeyboardDropEqualsPointerDrop: moving a drawn card to a drawn spot by
// pointer (press, move past the threshold over the spot, release) and by
// keyboard (Space, the spot resolved, Space) gives the same board, and
// each saves it once.
law KeyboardDropEqualsPointerDrop(card int where 1 <= card && card <= 17, to int where 0 <= to && to <= 2, index int where 0 <= index && index <= 7) {
	let id = "card-\(card)"
	let from = match board.Where(board.Defaults, id) {
	case Some[board.Spot] as s:
		s.Value
	case None:
		return false
	}
	let target = drag.Target{Container: columnIDs[to], Index: index}
	let mut p = fresh()
	p = feed(p, Dragging{Signal: drag.Pressed{Item: id, Container: from.Column, Index: from.Index, Screen: drag.Point{X: 100, Y: 100}}})
	p = feed(p, Dragging{Signal: drag.Moved{Screen: drag.Point{X: 100, Y: 200}, Client: drag.Point{X: 100, Y: 200}, Target: Some[drag.Target]{Value: target}}})
	p = feed(p, Dragging{Signal: drag.Released})
	let mut k = fresh()
	k = feed(k, Dragging{Signal: drag.Activated{Item: id, Container: from.Column, Index: from.Index}})
	k = feed(k, Dragging{Signal: drag.Resolved{Container: target.Container, Index: target.Index}})
	k = feed(k, Dragging{Signal: drag.Confirmed})
	let mut want = board.Defaults
	want = board.Reorder(want, id, from.Column, target.Container, target.Index)
	p.Board.Columns == k.Board.Columns && p.Board.Columns == want && p.Saves == 1 && k.Saves == 1
}

// Command is what the program asks the host: an id for a new card, a save
// of the board, a focus of the form or of a card, and where a keyboard
// move goes (answered with the drag's Resolved).
type Command = MakeID{Column string, Title string} | Save{Columns []board.Column} | FocusForm{} | FocusCard{ID string} | Locate{Item string, At board.Spot, Way board.Way}

// Start is the program on columns, idle, with the form shut.
func Start(columns []board.Column) Board {
	Board{Columns: columns, Drag: drag.New("kanban"), Adding: None, Title: "", Said: ""}
}

// Kanban is the program as a machine.
type Kanban machine[Board, Signal] {
	initial: Start(board.Defaults),
	step:    Step,
}

// Step is the program's transition.
func Step(b Board, sig Signal) Decision[Board, []Command] {
	match sig {
	case Dragging as g:
		dragged(b, g.Signal)
	case AddClicked as a:
		give(Board{..b, Adding: Some[string]{Value: a.Column}, Title: ""}, []Command{FocusForm})
	case Typed as t:
		give(Board{..b, Title: t.Text}, []Command{})
	case Submitted:
		match b.Adding {
		case Some[string] as c:
			let title = strings.TrimSpace(b.Title)
			if title == "" {
				return Ignore
			}
			give(b, []Command{MakeID{Column: c.Value, Title: title}})
		case None:
			Ignore
		}
	case IDMade as m:
		let mut columns = []board.Column{}
		for c in b.Columns {
			columns = columns.Append(if c.ID == m.Column { board.Append(c, board.Card{ID: m.ID, Title: m.Title, Description: "", Key: ""}) } else { c })
		}
		give(Board{..b, Columns: columns, Adding: None, Title: ""}, []Command{Save{Columns: columns}})
	case Cancelled:
		give(Board{..b, Adding: None, Title: ""}, []Command{})
	case Saved, FormFocused:
		Ignore
	}
}

// dragged steps the drag with sig and folds what it gives into the
// board: the new phase and what a screen reader says of it, a focus or a
// move to locate for the host, and a drop's reorder and save.
func dragged(b Board, sig drag.Signal) Decision[Board, []Command] {
	let dec = drag.Step(b.Drag, sig)
	match dec {
	case Ignore, Reject, Done[[]drag.Effect]:
		return Ignore
	case Emit[drag.Drag, []drag.Effect], Tell[drag.Drag, []drag.Effect], Enter[drag.Drag], Stay[drag.Drag]:
	}
	let next = drag.After(b.Drag, dec)
	let mut at = Board{..b, Drag: next, Said: announce(b, next.State)}
	let mut out = []Command{}
	for e in drag.Effects(dec) {
		match e {
		case drag.Reordered as r:
			let columns = board.Reorder(at.Columns, r.Item, r.From, r.To, r.ToIndex)
			at = Board{..at, Columns: columns, Said: "Dropped \(board.Title(b.Columns, r.Item)) in position \(r.ToIndex + 1) of \(board.Name(b.Columns, r.To))."}
			out = out.Append(Save{Columns: columns})
		case drag.Cancelled:
			let said = match drag.Item(b.Drag.State) {
			case Some[string] as id:
				"Drag cancelled, \(board.Title(b.Columns, id.Value)) returned to original position."
			case None:
				"Drag cancelled."
			}
			at = Board{..at, Said: said}
		case drag.Focus as f:
			out = out.Append(FocusCard{ID: f.Item})
		case drag.Resolve as r:
			out = out.Append(Locate{Item: r.Item, At: board.Spot{Column: r.Container, Index: r.Index}, Way: way(r.Way)})
		}
	}
	give(at, out)
}

// announce is what a screen reader says when the drag goes from b's phase
// to next: the pick-up and its keys, a move to another column, or a new
// position; otherwise what it said before.
func announce(b Board, next drag.State) string {
	let n = match next {
	case drag.Lifted as l:
		l
	case drag.Idle, drag.Pending, drag.Dragging:
		return b.Said
	}
	match b.Drag.State {
	case drag.Idle:
		"Picked up \(board.Title(b.Columns, n.Item)). Use arrow keys to move within column, Tab to move between columns, Space to drop, Escape to cancel."
	case drag.Lifted as was:
		let name = board.Name(b.Columns, n.To)
		if was.To != n.To {
			return "Moved to \(name), position \(n.ToIndex + 1)."
		}
		if was.ToIndex != n.ToIndex {
			return "Position \(n.ToIndex + 1) in \(name)."
		}
		b.Said
	case drag.Pending, drag.Dragging:
		b.Said
	}
}

// way is the board's step for an arrow: up and left go back, down and
// right forward (a column is a vertical list).
func way(d drag.Direction) board.Way {
	match d {
	case drag.Up, drag.Left:
		board.Back
	case drag.Down, drag.Right:
		board.Forward
	case drag.NextContainer:
		board.NextColumn
	case drag.PreviousContainer:
		board.PreviousColumn
	}
}

// give is the program at b asking out.
func give(b Board, out []Command) Decision[Board, []Command] {
	if len(out) == 0 {
		return Stay[Board]{Next: b}
	}
	Emit[Board, []Command]{Next: b, Output: out}
}

// Commands is what the decision asks.
func Commands(d Decision[Board, []Command]) []Command {
	match d {
	case Emit[Board, []Command] as e:
		e.Output
	case Enter[Board], Stay[Board], Tell[Board, []Command], Ignore, Reject, Done[[]Command]:
		[]Command{}
	}
}

// After is the program after the decision.
func After(b Board, d Decision[Board, []Command]) Board {
	match d {
	case Emit[Board, []Command] as e:
		e.Next
	case Enter[Board] as e:
		e.Next
	case Stay[Board] as s:
		s.Next
	case Ignore, Tell[Board, []Command], Reject, Done[[]Command]:
		b
	}
}
