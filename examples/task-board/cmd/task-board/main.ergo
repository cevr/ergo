// task-board is a task-board program (stage a: the model,
// with no view): a task board whose cards move by pointer or keyboard,
// with what a screen reader says, and a form that adds cards. It plays a
// script of acts from standard input and keeps the board in board.json in
// the working directory. Packages: board (the columns, the cards and the
// Store contract), sortkey, drag (the drag machine), kanban (the program),
// file and memory (the stores), and script (the host). This binary is the
// only place that chooses the store.

import taskboard/board
import taskboard/file
import taskboard/script
import fs
import io
import os
import time

func main() fails os.Exit needs io.Console | os.Ambient {
	let host = fs.NewHost()
	let clock = time.NewManual(0)
	let status = with context { io.Stdin: io.NewStdin(), board.Store: file.NewSheet(host, host), time.Scheduler: clock } { script.Run(clock) }
	if status != 0 {
		return os.Exit{Code: 1, Message: "task-board: the script did not run"}
	}
}
