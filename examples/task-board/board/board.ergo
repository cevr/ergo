// Package board is the domain of a task board: columns of cards, each
// card ordered in its column by a fractional sort key, so moving a card
// rewrites one key. It declares the contract Store, which keeps a board
// between runs; package memory and package file provide it.

import option
import taskboard/sortkey

// Card is a card of the board. Key orders it in its column; its codec
// key is sortKey.
type Card { ID string, Title string, Description string, Key string "sortKey" }

// Column is a column of the board and its cards, in key order.
type Column { ID string, Name string, Cards []Card }

// Removed is a column without a card, and the card when the column had
// it.
type Removed { Column Column, Card option.Option[Card] }

// Remove takes the card id out of c.
func Remove(c Column, id string) Removed {
	let mut cards = []Card{}
	let mut found option.Option[Card] = option.None
	for card in c.Cards {
		if card.ID == id {
			found = option.Some[Card]{Value: card}
		} else {
			cards = cards.Append(card)
		}
	}
	Removed{Column: Column{..c, Cards: cards}, Card: found}
}

// Insert puts card into c at position at, clamped to the column, with a
// key between its new neighbours'. (Clamping keeps the keys in order, where
// a key made past the end as if the column were empty would not.)
func Insert(c Column, card Card, at int) Column {
	let i = if at < 0 { 0 } else if at > c.Cards.Len() { c.Cards.Len() } else { at }
	let lo option.Option[string] = if i == 0 { option.None } else { option.Some[string]{Value: c.Cards[i-1].Key} }
	let hi option.Option[string] = if i == c.Cards.Len() { option.None } else { option.Some[string]{Value: c.Cards[i].Key} }
	let placed = Card{..card, Key: sortkey.Between(lo, hi)}
	let mut cards = []Card{}
	for j in 0..c.Cards.Len() {
		if j == i {
			cards = cards.Append(placed)
		}
		cards = cards.Append(c.Cards[j])
	}
	if i == c.Cards.Len() {
		cards = cards.Append(placed)
	}
	Column{..c, Cards: cards}
}

// Append puts card at the end of c.
func Append(c Column, card Card) Column { Insert(c, card, c.Cards.Len()) }

// Reorder moves the card item from the column from to position at of the
// column to (a position counted without the card). A card or a column
// the board does not have leaves it as it is.
func Reorder(columns []Column, item string, from string, to string, at int) []Column {
	let mut card option.Option[Card] = option.None
	for c in columns {
		if c.ID == from {
			card = Remove(c, item).Card
		}
	}
	let moving = match card {
	case option.Some[Card] as m:
		m.Value
	case option.None:
		return columns
	}
	let mut landed = false
	for c in columns {
		if c.ID == to {
			landed = true
		}
	}
	if !landed {
		return columns
	}
	let mut out = []Column{}
	for c in columns {
		let without = if c.ID == from { Remove(c, item).Column } else { c }
		out = out.Append(if c.ID == to { Insert(without, moving, at) } else { without })
	}
	out
}

// ReorderIsAPermutation: drawn reorders of the default board (cards of
// it and ids it lacks, any columns and one it lacks, positions past
// either end) move the
// cards as the reference does: the card leaves its column and lands at
// its position, every other card keeps its place and the board keeps
// every card once.
law ReorderIsAPermutation(moves []int) {
	let mut board = Defaults
	let mut want = ids(Defaults)
	for m in moves {
		let from = pick(m, 3)
		let to = pick(m/3, 3)
		let at = pick(m/9, 9) - 1
		let col = board[from].Cards
		let item = if col.Len() == 0 || pick(m/81, 8) == 0 { "card-none" } else { col[pick(m/648, col.Len())].ID }
		if pick(m, 13) == 12 {
			// A column the board does not have changes nothing.
			board = Reorder(board, item, board[from].ID, "column-none", at)
			continue
		}
		board = Reorder(board, item, board[from].ID, board[to].ID, at)
		want = moved(want, item, from, to, at)
		if ids(board) != want {
			return false
		}
	}
	true
}

// ids is the card ids of each column.
func ids(columns []Column) [][]string {
	let mut out = [][]string{}
	for c in columns {
		let mut col = []string{}
		for card in c.Cards {
			col = col.Append(card.ID)
		}
		out = out.Append(col)
	}
	out
}

// moved is the reference of a reorder: the ids with item taken out of
// column from and put at at (clamped) in column to.
func moved(lists [][]string, item string, from int, to int, at int) [][]string {
	let mut has = false
	for x in lists[from] {
		if x == item {
			has = true
		}
	}
	if !has {
		return lists
	}
	let mut out = [][]string{}
	for i, col in lists {
		let mut rest = []string{}
		for x in col {
			if !(i == from && x == item) {
				rest = rest.Append(x)
			}
		}
		if i == to {
			let k = if at < 0 { 0 } else if at > rest.Len() { rest.Len() } else { at }
			let mut put = []string{}
			for j in 0..rest.Len() {
				if j == k {
					put = put.Append(item)
				}
				put = put.Append(rest[j])
			}
			if k == rest.Len() {
				put = put.Append(item)
			}
			rest = put
		}
		out = out.Append(rest)
	}
	out
}

func pick(n int, size int) int { ((n % size) + size) % size }

// Way is where a keyboard move goes: a step in the column, or to the
// next or the previous column.
type Way = Back{} | Forward{} | NextColumn{} | PreviousColumn{}

// Spot is a position on the board: a column and an index in it.
type Spot { Column string, Index int }

// Step is the spot a keyboard move from at goes to, with item lifted (a
// step within a column counts its cards without item). A step stops at
// the column's ends; a move to another column stops at the board's ends
// and lands at the top. The board answers it, not the page.
func Step(columns []Column, item string, at Spot, way Way) Spot {
	match way {
	case Back:
		Spot{..at, Index: if at.Index-1 < 0 { 0 } else { at.Index - 1 }}
	case Forward:
		let mut count = 0
		for c in columns {
			if c.ID == at.Column {
				for card in c.Cards {
					if card.ID != item {
						count = count + 1
					}
				}
			}
		}
		Spot{..at, Index: if at.Index+1 > count { count } else { at.Index + 1 }}
	case NextColumn, PreviousColumn:
		let mut here = 0
		for i, c in columns {
			if c.ID == at.Column {
				here = i
			}
		}
		let next = match way {
		case NextColumn:
			if here+1 > columns.Len()-1 { columns.Len() - 1 } else { here + 1 }
		case Back, Forward, PreviousColumn:
			if here-1 < 0 { 0 } else { here - 1 }
		}
		if next < 0 {
			return Spot{Column: at.Column, Index: 0}
		}
		Spot{Column: columns[next].ID, Index: 0}
	}
}

// Where is the spot of the card id, if the board has it.
func Where(columns []Column, id string) option.Option[Spot] {
	for c in columns {
		for i, card in c.Cards {
			if card.ID == id {
				return option.Some[Spot]{Value: Spot{Column: c.ID, Index: i}}
			}
		}
	}
	option.None
}

// Title is the title of the card id, or the id when the board has no
// such card.
func Title(columns []Column, id string) string {
	for c in columns {
		for card in c.Cards {
			if card.ID == id {
				return card.Title
			}
		}
	}
	id
}

// Name is the name of the column id, or the id when the board has no
// such column.
func Name(columns []Column, id string) string {
	for c in columns {
		if c.ID == id {
			return c.Name
		}
	}
	id
}
