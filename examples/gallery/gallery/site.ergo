import machines
import time

// The site as a machine. Rather than read each URL change through
// helpers (entered, stayed, exited, a cold load) that return commands,
// the step matches the route before and the route after:
// entering the gallery loads the catalog, entering a painting loads it,
// and staying on a painting with another id loads the new one. The loads
// are jobs of the site's state, and the machine's work runs them: each
// takes its time on the clock (Takes) and answers with its signal.
// Leaving the studio saves its draft: the save is the studio's exit
// action (leave), which runs when the studio's entry ends, with the draft
// as last typed, whatever ends it (a navigation away, or the site's end).
// A key typed and a stay in the studio keep the entry, so they save
// nothing. The studio's work reads the draft last saved back (Recalled).
// The host does only what the page asks of the browser (the step's
// output): push a URL, or leave.

// Catalog is the gallery's catalog: not asked for, loading, or loaded.
type Catalog = Idle{} | Loading{} | Ready{}

// Shown is the painting the page holds: none, one loading, or one
// loaded, by id.
type Shown = NoPainting{} | LoadingPainting{ID int} | ReadyPainting{ID int}

// StayRefetchesOnlyOnIdChange: on a painting, loaded or loading, a
// navigation to a painting loads it exactly when its id is another.
law StayRefetchesOnlyOnIdChange(a int where 1 <= a && a <= 9, b int where 1 <= b && b <= 9, loaded bool) {
	let shown Shown = if loaded { ReadyPainting{ID: a} } else { LoadingPainting{ID: a} }
	let s = Site{..Blank, Route: Some[Route]{Value: Painting{ID: a}}, Painting: shown}
	let d = Step(s, Arrived{URL: "/gallery/\(b)"})
	let asked = has(Commands(s, d), LoadPainting{ID: b})
	let after = After(s, d).Painting
	let want Shown = if a != b { LoadingPainting{ID: b} } else { shown }
	asked == (a != b) && after == want
}

func has(cs []Load, c Load) bool {
	for x in cs {
		if x == c {
			return true
		}
	}
	false
}

// Logged is one navigation in the log: its number, the route before (None
// for the cold load) and the route after.
type Logged { Seq int, From Option[Route], To Route }

// Site is the machine's state: the route (None before the first URL),
// the log of navigations (newest first, at most LogSize), the catalog,
// the painting, the studio's draft, the draft last saved, the jobs the
// work runs (in the order asked), and the number of jobs asked.
type Site { Route Option[Route], Log []Logged, Catalog Catalog, Painting Shown, Draft string, Saved Option[string], Jobs []Job, Asked int }

// Job is a load the site asked for: its number, the command,
// and when it answers, once the work has read the clock.
type Job { Seq int, Do Load, Due Option[time.Time] }

type Link = Internal{URL string} | External{Href string}

type Signal = Arrived{URL string} | Clicked{Link Link} | CatalogLoaded{} | PaintingLoaded{ID int} | Drafted{Text string} | Recalled{Draft Option[string]} | Dated{Seq int, At time.Time} | Answered{Seq int, Job Load}

type Load = LoadCatalog{} | LoadPainting{ID int}

type Action = Push{URL string} | Leave{Href string}

// LogSize is how many navigations the log keeps.
let LogSize = 20

// Blank is the site before its first URL.
let Blank = Site{Route: None, Log: []Logged{}, Catalog: Idle, Painting: NoPainting, Draft: "", Saved: None, Jobs: []Job{}, Asked: 0}

// CatalogueLoadsOncePerVisit: over drawn navigations and catalog answers,
// the site asks for the catalog exactly when it enters the gallery (from
// another page or cold) with no load in flight: a reference model of a
// visit and a flight, step by step.
law CatalogueLoadsOncePerVisit(ops []int) {
	let mut s = Blank
	let mut onGallery = false
	let mut flying = false
	for o in ops {
		let op = if o < 0 { -(o / 2) } else { o }
		if op%4 == 3 {
			s = After(s, Step(s, CatalogLoaded))
			flying = false
			continue
		}
		let next = routeOf(op/4, 1+op%7)
		let entering = next == Gallery && !onGallery
		let want = entering && !flying
		let got = catalogLoads(Commands(s, Step(s, Arrived{URL: Print(next)})))
		if got != (if want { 1 } else { 0 }) {
			return false
		}
		s = After(s, Step(s, Arrived{URL: Print(next)}))
		flying = flying || want
		onGallery = next == Gallery
	}
	true
}

// Routes are one route of each kind; a painting's id comes from the case.
func routeOf(k int, id int) Route {
	let ks = []Route{Home, Gallery, Painting{ID: id}, Studio, NotFound{Path: "/nowhere"}}
	ks[((k%len(ks))+len(ks))%len(ks)]
}

func catalogLoads(cs []Load) int {
	let mut n = 0
	for c in cs {
		match c {
		case LoadCatalog:
			n = n + 1
		case LoadPainting:
		}
	}
	n
}

// LogKeepsTheLastTwenty: after n navigations the log holds the last
// min(n, 20), newest first, numbered n down.
law LogKeepsTheLastTwenty(n int where 0 <= n && n <= 60) {
	let mut s = Blank
	for i in 0..n {
		s = After(s, Step(s, Arrived{URL: Print(routeOf(i, i))}))
	}
	let want = if n < LogSize { n } else { LogSize }
	if len(s.Log) != want {
		return false
	}
	for i, l in s.Log {
		if l.Seq != n-i {
			return false
		}
	}
	true
}

// Gallerist is the site as a machine.
type Gallerist machine[Site, Signal] {
	initial: Blank,
	step:    Step,
	work:    jobs,
	exit:    leave,
}

// Step is the site's transition.
func Step(s Site, sig Signal) Decision[Site, []Action] {
	match sig {
	case Arrived as a:
		arrive(s, Parse(a.URL))
	case Clicked as c:
		match c.Link {
		case Internal as i:
			Tell[Site, []Action]{Next: s, Output: []Action{Push{URL: i.URL}}}
		case External as e:
			Tell[Site, []Action]{Next: s, Output: []Action{Leave{Href: e.Href}}}
		}
	case CatalogLoaded:
		Stay[Site]{Next: Site{..s, Catalog: Ready}}
	case PaintingLoaded as p:
		match s.Painting {
		case LoadingPainting as l:
			if l.ID != p.ID {
				return Ignore
			}
			Stay[Site]{Next: Site{..s, Painting: ReadyPainting{ID: p.ID}}}
		case NoPainting, ReadyPainting:
			Ignore
		}
	case Dated as d:
		let mut js = []Job{}
		for j in s.Jobs {
			js = js.Append(if j.Seq == d.Seq { Job{..j, Due: Some[time.Time]{Value: d.At}} } else { j })
		}
		Stay[Site]{Next: Site{..s, Jobs: js}}
	case Answered as a:
		let mut js = []Job{}
		for j in s.Jobs {
			if j.Seq != a.Seq {
				js = js.Append(j)
			}
		}
		let done = Site{..s, Jobs: js}
		match Step(done, Answer(a.Job)) {
		case Stay[Site] as st:
			Stay[Site]{Next: st.Next}
		case Enter[Site] as e:
			Stay[Site]{Next: e.Next}
		case Emit[Site, []Action] as e:
			Stay[Site]{Next: e.Next}
		case Tell[Site, []Action] as t:
			Stay[Site]{Next: t.Next}
		case Ignore, Reject, Done[[]Action]:
			Stay[Site]{Next: done}
		}
	case Drafted as d:
		Stay[Site]{Next: Site{..s, Draft: d.Text}}
	case Recalled as r:
		Stay[Site]{Next: Site{..s, Saved: r.Draft}}
	}
}

func arrive(s Site, next Route) Decision[Site, []Action] {
	let seq = if len(s.Log) == 0 { 1 } else { s.Log[0].Seq + 1 }
	let mut log = []Logged{Logged{Seq: seq, From: s.Route, To: next}}
	for l in s.Log {
		if len(log) < LogSize {
			log = log.Append(l)
		}
	}
	let mut at = Site{..s, Route: Some[Route]{Value: next}, Log: log}
	let mut out = []Load{}
	// A cold load comes from no page; as a path the site does not have, it
	// enters every page of the site.
	let before = match s.Route {
	case Some[Route] as r:
		r.Value
	case None:
		NotFound{Path: ""}
	}
	let mut painting = false
	match (before, next) {
	case (Studio, Studio):
		// A stay in the studio keeps its entry, so its exit action runs
		// once, when the site leaves the studio.
		return Stay[Site]{Next: at}
	case (Gallery, Gallery):
		// A stay on the gallery is no entry.
	case (Home, Gallery), (Painting, Gallery), (Studio, Gallery), (NotFound, Gallery):
		match s.Catalog {
		case Loading:
			// The load in flight answers this visit too.
		case Idle, Ready:
			at = Site{..at, Catalog: Loading}
			out = out.Append(LoadCatalog)
		}
	case (Painting, Painting):
		// A stay on a painting loads only another painting.
		painting = paintingID(before) != paintingID(next)
	case (Home, Painting), (Gallery, Painting), (Studio, Painting), (NotFound, Painting):
		painting = true
	case (Home, Home), (Home, Studio), (Home, NotFound), (Gallery, Home), (Gallery, Studio), (Gallery, NotFound), (Painting, Home), (Painting, Studio), (Painting, NotFound), (Studio, Home), (Studio, NotFound), (NotFound, Home), (NotFound, Studio), (NotFound, NotFound):
	}
	if painting {
		at = Site{..at, Painting: LoadingPainting{ID: paintingID(next)}}
		out = out.Append(LoadPainting{ID: paintingID(next)})
	}
	if len(out) == 0 {
		return Enter[Site]{Next: at}
	}
	// A navigation ends the entry, so the work starts again with the new
	// jobs, and each job keeps its due time.
	let mut js = at.Jobs
	for i, c in out {
		js = js.Append(Job{Seq: s.Asked + i + 1, Do: c, Due: None})
	}
	Enter[Site]{Next: Site{..at, Jobs: js, Asked: s.Asked + len(out)}}
}

// leave is each state's exit action: in the studio with a draft, save the
// draft. The runner gives it the state the studio's entry ends with, so
// the draft is the one last typed (a key is a Stay), and it runs once per
// studio visit, at the navigation away or at the site's end.
func leave(s Site) Option[func() needs Drafts] {
	if !inStudio(s) || s.Draft == "" {
		return None
	}
	let draft = s.Draft
	Some{func() needs Drafts { Drafts.Save(draft) }}
}

// inStudio is whether the site is in the studio.
func inStudio(s Site) bool {
	match s.Route {
	case Some[Route] as r:
		r.Value == Studio
	case None:
		false
	}
}

func paintingID(r Route) int {
	match r {
	case Painting as p:
		p.ID
	case Home, Gallery, Studio, NotFound:
		0
	}
}

// Commands is what the decision d from s asks for: its output (a push or
// a leave), then the jobs it adds, in the order asked.
func Commands(s Site, d Decision[Site, []Action]) []Load {
	let mut out = []Load{}
	for j in After(s, d).Jobs {
		if j.Seq > s.Asked {
			out = out.Append(j.Do)
		}
	}
	out
}

func Answer(c Load) Signal {
	match c {
	case LoadCatalog:
		CatalogLoaded
	case LoadPainting as p:
		PaintingLoaded{ID: p.ID}
	}
}

func Takes(c Load) duration {
	match c {
	case LoadCatalog:
		600ms
	case LoadPainting:
		400ms
	}
}

// jobs is the site's work while it has jobs: it gives each job with no
// due time the clock's now and the job's time (Dated), then, in due order
// (ties in the order asked), sleeps until each and gives its end
// (Answered). A navigation ends the entry and starts the work again with
// the jobs left, each at its own due time. In the studio it first reads
// the draft last saved (Recalled): the studio's exit action saved it as
// the last visit ended, before this entry opened.
func jobs(s Site) Option[machines.Work[Signal, time.Clock | Scheduler | Drafts]] {
	let studio = inStudio(s)
	if len(s.Jobs) == 0 && !studio {
		return None
	}
	Some{machines.Work{Start: func(send entry func(e Signal)) needs time.Clock | Scheduler | Drafts {
		if studio {
			send(Recalled{Draft: Drafts.Last()})
		}
		let now = time.Clock.Now()
		let mut dues = []due{}
		for j in s.Jobs {
			let at = match j.Due {
			case Some[time.Time] as t:
				t.Value
			case None:
				let at = time.Add(now, Takes(j.Do))
				send(Dated{Seq: j.Seq, At: at})
				at
			}
			dues = dues.Append(due{At: at, Job: j, Done: false})
		}
		for _ in dues {
			let mut k = -1
			for i, d in dues {
				if !d.Done && (k < 0 || time.Before(d.At, dues[k].At)) {
					k = i
				}
			}
			let d = dues[k]
			dues[k] = due{..d, Done: true}
			let t = time.Clock.Now()
			if time.Before(t, d.At) {
				Scheduler.Sleep(d.At.Sub(t))
			}
			send(Answered{Seq: d.Job.Seq, Job: d.Job.Do})
		}
	}}}
}

// due is a job of the work with its due time, and whether it answered.
type due { At time.Time, Job Job, Done bool }

// After is the site after the decision d from s.
func After(s Site, d Decision[Site, []Action]) Site {
	match d {
	case Emit[Site, []Action] as e:
		e.Next
	case Enter[Site] as e:
		e.Next
	case Stay[Site] as st:
		st.Next
	case Tell[Site, []Action] as t:
		t.Next
	case Ignore, Reject, Done[[]Action]:
		s
	}
}
