import option

// Drafts is where the studio keeps the drafts it saves: the site saves
// its draft when it leaves the studio (the studio's exit action), and
// reads the last one back when it enters it (the studio's work). The site
// declares the contract; package memory holds one in process, and the
// binary chooses it.
type Drafts {
	// Save keeps draft as the draft last saved.
	Save(draft string),
	// Last is the draft last saved, or None before any save.
	Last() option.Option[string],

	// LastIsTheLatestSave: after any saves, Last is the last draft saved;
	// a save of a draft equal to an earlier one still counts as the last.
	law LastIsTheLatestSave(drafts []string) {
		let before = Last()
		for d in drafts {
			Save(d)
		}
		if drafts.Len() == 0 {
			return Last() == before
		}
		Last() == option.Some[string]{Value: drafts[drafts.Len()-1]}
	},
}
