import actor
import ergo.local/prototype/examples/drawgui/canvas
import ergo.local/prototype/examples/drawgui/memory
import ergo.local/prototype/examples/drawgui/window
import gen
import machines
import temporal
import time
import ui

func exploreProperties() []temporal.Formula[ui.ExploreSnapshot[canvas.State, canvas.Signal]] {
	let mut props = ui.DefaultsWith[canvas.State, canvas.Signal](2s)
	props = props.Append(temporal.Always[ui.ExploreSnapshot[canvas.State, canvas.Signal]](
		temporal.Named[ui.ExploreSnapshot[canvas.State, canvas.Signal]]("canvas-layer-and-zoom-valid", func(s ui.ExploreSnapshot[canvas.State, canvas.Signal]) bool {
			let c = canvas.CanvasOf(s.State)
			c.Layer >= 0 && c.Layer < canvas.Layers && c.View.Zoom > 0 && s.Offers.Len() > 0
		}),
	))
	props
}

func exploreOnce(steps int) ui.Finding needs gen.Draws {
	let clock = time.NewManual(0)
	let shelf = memory.NewShelf()
	with context { time.Scheduler: clock, canvas.Store: shelf } {
		let a = actor.StartMachine(machines.Start(window.App{}, canvas.Empty()), 8, func(_ canvas.Output) {})
		let mut h = ui.NewTestHost(a, window.View, clock, 4) catch {
		case ui.BadPatch as bp:
			a.Stop()
			return ui.Found{Script: []ui.Act{}, Step: 0, Violation: bp.Why}
		}
		let res = ui.Explore(&h, exploreProperties(), ui.ExploreConfig{Steps: steps, Swarm: false, AdvanceStep: 500ms, Weights: Map[string, int]{}})
		a.Stop()
		res
	}
}

// Explored holds that autonomous exploration over seeds 1 to 3 finds no
// default or drawing-canvas invariant violation on draw-gui.
law Explored() {
	let mut allClean = true
	for seed in 1..4 {
		let cfg = gen.Config{Seed: uint64(seed), Cases: 8, Shrinks: 50, MaxDraws: 4096, MaxRejected: 100}
		let outcome = gen.Check(cfg, func() bool fails gen.Rejected needs gen.Draws {
			match exploreOnce(18) {
			case ui.Clean:
				true
			case ui.Found:
				false
			}
		})
		match outcome {
		case gen.Held:
		case _:
			allClean = false
		}
	}
	allClean
}
