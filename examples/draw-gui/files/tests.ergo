// The test file of package files picks the disk its law runs use: each
// case of canvas.Store's laws builds onTestHost, a Disk over the test's own
// folder, so SaveThenLoad runs on the host's files as the binary's Disk
// does (cmd/drawgui/main.ergo picks fs.NewHost). The context is
// unexported, so only the test build's law runs read it.

import ergo.local/prototype/examples/drawgui/canvas
import fs
import fstest

// onTestHost binds the store to a Disk over the test's folder.
let onTestHost = context needs fstest.TestAmbient { canvas.Store: New(fs.NewTestHost()) }
