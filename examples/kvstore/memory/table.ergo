// Package memory holds the in-memory providers: Table, a kv.Store whose
// entries live in a map, and Disk, an fs.Files and fs.Writes provider of
// files in a map, so a test of the file store touches no host disk.

import kvstore/kv
import maps
import slices

// Table is a kv.Store in memory. Its map is shared by every copy of the
// Table, as a Go map is, so a Table bound in a context keeps its entries
// from one call to the next. Its field is unexported: New makes one.
type Table { entries Map[string, string] }

// New is an empty Table.
func New() Table {
	let entries Map[string, string]
	Table{entries: entries}
}

// Get is the value of key.
func Get(t Table, key string) string fails kv.Missing | kv.Broken {
	match t.entries.Get(key) {
	case Some[string] as v:
		v.Value
	case None:
		kv.Missing{Key: key}
	}
}

// Put makes key hold value.
func Put(t Table, key string, value string) fails kv.Broken {
	let mut entries = t.entries
	entries[key] = value
}

// Delete removes key.
func Delete(t Table, key string) fails kv.Missing | kv.Broken {
	let _ = try t.Get(key)
	let _ = t.entries.Delete(key)
}

// Keys is every key, sorted.
func Keys(t Table) []string fails kv.Broken { slices.Sorted(maps.Keys(t.entries)) }

// Compact does nothing: a map holds no garbage.
func Compact(_ Table) fails kv.Broken {}
