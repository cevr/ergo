// ergo test runs the kv.Store laws here, against Table (NewTable). These
// tests run the same kv checks on a Table that package file runs on a Log,
// whose laws ergo test skips (expected-skips), so the two stores keep one
// contract.

import kvstore/kv

test TableGetAfterPut(key string, value string) {
	with context { kv.Store: NewTable() } {
		assert try kv.GetAfterPutHolds(key, value)
	}
}

test TablePutOverwrites(key string, first string, second string) {
	with context { kv.Store: NewTable() } {
		assert try kv.PutOverwritesHolds(key, first, second)
	}
}

test TableDeleteRemoves(key string, value string) {
	with context { kv.Store: NewTable() } {
		assert try kv.DeleteRemovesHolds(key, value)
	}
}

test TablePutKeepsOthers(key string, other string, a string, b string) {
	with context { kv.Store: NewTable() } {
		assert try kv.PutKeepsOthersHolds(key, other, a, b)
	}
}

test TableKeysAreSortedAndDistinct(keys []string) {
	with context { kv.Store: NewTable() } {
		assert try kv.KeysAreSortedAndDistinctHolds(keys)
	}
}

test TableCompactKeepsContents(puts []string, drops []int) {
	with context { kv.Store: NewTable() } {
		assert try kv.CompactKeepsContentsHolds(puts, drops)
	}
}

test ACopySharesTheEntries {
	let t = NewTable()
	let copy = t
	try copy.Put("a", "1")
	assert try t.Get("a") == "1"
}
