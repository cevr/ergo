import fs
import slices
import strings

// Disk is an fs.Files and fs.Writes provider of files and directories in
// maps, so a test reads and writes files with no host disk. Its maps are
// shared by every copy, as Table's is. A write makes the whole new text
// visible at once, as fs.Host's write and rename does.
type Disk { files Map[string, string], dirs Map[string, bool] }

// NewDisk is a Disk with no files and the one directory ".".
func NewDisk() Disk {
	let files Map[string, string]
	let mut dirs Map[string, bool]
	dirs["."] = true
	Disk{files: files, dirs: dirs}
}

// ReadFile is the text of the file at path.
func ReadFile(d Disk, path string) string fails fs.NotFound | fs.Denied | fs.Failed {
	match d.files.Get(path) {
	case Some[string] as t:
		t.Value
	case None:
		if d.isDir(path) {
			return fs.Failed{Path: path, Reason: "is a directory"}
		}
		fs.NotFound{Path: path}
	}
}

// ReadDir is the names in the directory path, sorted.
func ReadDir(d Disk, path string) []string fails fs.NotFound | fs.Denied | fs.Failed {
	if !d.isDir(path) {
		return fs.NotFound{Path: path}
	}
	let mut names = []string{}
	for p, _ in d.files {
		if parent(p) == path {
			names = names.Append(strings.TrimPrefix(p, path+"/"))
		}
	}
	slices.Sort(names)
}

// Stat describes the file or directory at path.
func Stat(d Disk, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed {
	if d.isDir(path) {
		return fs.Info{Name: path, Size: 0, Dir: true}
	}
	fs.Info{Name: path, Size: len(try d.ReadFile(path)), Dir: false}
}

// WriteFile makes the file at path hold text. Its directory must exist.
func WriteFile(d Disk, path string, text string) fails fs.NotFound | fs.Denied | fs.Failed {
	if d.isDir(path) {
		return fs.Failed{Path: path, Reason: "is a directory"}
	}
	if !d.isDir(parent(path)) {
		return fs.NotFound{Path: path}
	}
	let mut files = d.files
	files[path] = text
}

// MkdirAll makes the directory path and each missing parent.
func MkdirAll(d Disk, path string) fails fs.Denied | fs.Failed {
	let mut dirs = d.dirs
	let mut p = path
	for _ in 0..len(path)+1 {
		if p == "." || p == "" {
			return
		}
		match d.files.Get(p) {
		case Some[string]:
			return fs.Failed{Path: path, Reason: "not a directory"}
		case None:
		}
		dirs[p] = true
		p = parent(p)
	}
}

// isDir reports whether path is a directory of d.
func isDir(d Disk, path string) bool {
	match d.dirs.Get(path) {
	case Some[bool]:
		true
	case None:
		false
	}
}

// parent is the directory of path: the text before its last "/", or ".".
func parent(path string) string {
	let at = strings.LastIndex(path, "/")
	if at < 0 {
		return "."
	}
	strings.Slice(path, 0, at)
}

// Full is an fs.Writes provider of a disk with no space left: every write
// fails, and a directory that is there already is no failure. A test binds
// it with a Disk's reads to show that a failed write leaves the old text.
type Full { disk Disk }

// FullOf is the Full disk over d: d's reads, and no room to write.
func FullOf(d Disk) Full { Full{disk: d} }

// WriteFile fails: the disk is full.
func WriteFile(_ Full, path string, _ string) fails fs.NotFound | fs.Denied | fs.Failed {
	fs.Failed{Path: path, Reason: "no space left on device"}
}

// MkdirAll succeeds when the directory is there, and fails otherwise.
func MkdirAll(f Full, path string) fails fs.Denied | fs.Failed {
	if !f.disk.isDir(path) {
		return fs.Failed{Path: path, Reason: "no space left on device"}
	}
}
