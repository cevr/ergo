// Disk keeps the laws of fs.Files and fs.Writes, and the contract of the
// two over one store that no law states yet (fs.Writes' comment): after a
// write succeeds, a read of the path is the text written. Full fails every
// write and changes nothing.

import fs
import slices

test DiskReadIsRepeatable(path string, text string) {
	let d = NewDisk()
	try d.WriteFile("f", text)
	for p in []string{"f", path} {
		let first = d.ReadFile(p) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			"failed"
		}
		let second = d.ReadFile(p) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			"failed"
		}
		assert first == second
	}
}

test DiskMkdirAllIsIdempotent(name string) {
	let d = NewDisk()
	let path = "a/" + name
	let once = madeDir(d, path)
	assert !once || madeDir(d, path)
}

// madeDir reports whether d.MkdirAll(path) succeeds.
func madeDir(d Disk, path string) bool {
	d.MkdirAll(path) catch {
	case fs.Denied, fs.Failed:
		return false
	}
	true
}

test DiskReadsWhatItWrote(name string, text string) {
	let d = NewDisk()
	try d.MkdirAll("dir")
	let path = "dir/" + name
	d.WriteFile(path, text) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		// A name with a "/" names a missing directory, or "dir" itself.
		return
	}
	assert try d.ReadFile(path) == text
}

test DiskWriteNeedsItsDirectory {
	let d = NewDisk()
	assert wrote(d, "nodir/f", "x") == "not found: nodir/f"
	try d.MkdirAll("a/b")
	try d.WriteFile("a/b/f", "x")
	try d.WriteFile("a/g", "y")
	assert slices.Equal(try d.ReadDir("a"), []string{"g"})
	assert (try d.Stat("a/b")).Dir
}

test FullKeepsTheOldText(text string) {
	let d = NewDisk()
	try d.WriteFile("f", "old")
	assert wrote(FullOf(d), "f", text) == "failed: f: no space left on device"
	assert try d.ReadFile("f") == "old"
}

// wrote is "ok" when w writes text at path, or the failure.
func wrote(w fs.Writes, path string, text string) string {
	w.WriteFile(path, text) catch {
	case fs.NotFound as n:
		return "not found: " + n.Path
	case fs.Denied as d:
		return "denied: " + d.Path
	case fs.Failed as f:
		return "failed: " + f.Path + ": " + f.Reason
	}
	"ok"
}
