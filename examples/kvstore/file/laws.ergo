// The rules of the log as laws over its pure parts, and the rule that a
// failed write keeps the store as it was.

import kvstore/kv
import kvstore/memory

// RoundTrip: a record's line decodes to the record, whatever its texts.
law RoundTrip(key string, value string) {
	let set = Set{Key: key, Value: value}
	let unset = Unset{Key: key}
	(try Decode(1, Encode(set))) == set && (try Decode(2, Encode(unset))) == unset
}

// OneLine: a record's line holds no line feed, so the log is one record
// per line.
law OneLine(key string, value string) { !hasLineFeed(Encode(Set{Key: key, Value: value})) }

// CompactedReplaysTheSame: the compacted log of what a log leaves leaves
// the same entries.
law CompactedReplaysTheSame(puts []string, drops []int) {
	let entries = try Replay(logOf(puts, drops))
	sameMaps(try Replay(Compacted(entries)), entries)
}

// FailedWriteKeepsTheStore: when the disk is full, a put fails Broken and
// every entry keeps its value.
law FailedWriteKeepsTheStore(puts []string, key string, value string) {
	let disk = memory.NewDisk()
	let before = with context { kv.Store: try Open("db", disk, disk) } {
		for k in puts {
			try kv.Store.Put(k, "v "+k)
		}
		try kv.Snapshot()
	}
	with context { kv.Store: try Open("db", disk, memory.FullOf(disk)) } {
		kv.Store.Put(key, value) catch {
		case kv.Broken:
		}
		kv.Equal(try kv.Snapshot(), before)
	}
}

// logOf is the log of a put of each of puts, then a delete of the key
// each of drops picks (kv.Pick).
func logOf(puts []string, drops []int) string {
	let mut out = ""
	for k in puts {
		out = out + Encode(Set{Key: k, Value: "v " + k}) + "\n"
	}
	for d in drops {
		out = out + Encode(Unset{Key: kv.Pick(puts, d)}) + "\n"
	}
	out
}

// hasLineFeed reports whether text holds a line feed.
func hasLineFeed(text string) bool {
	for i in 0..len(text) {
		if text[i] == '\n' {
			return true
		}
	}
	false
}

// sameMaps reports whether a and b hold the same entries.
func sameMaps(a Map[string, string], b Map[string, string]) bool {
	if len(a) != len(b) {
		return false
	}
	for k, v in a {
		// The literal is bound first: in an if header, the lowering drops
		// its parentheses and Go refuses it (gap G-ex-c-2).
		let want = Some[string]{Value: v}
		if b.Get(k) != want {
			return false
		}
	}
	true
}
