// Log keeps the kv.Store laws: each test runs one of kv's checks on a new
// Log over an fstest.Memory, the same checks package memory runs on a
// Table. ergo test skips Store's laws for Log (it holds an fs.Files and
// has no constructor without rows; expected-skips). The laws of laws.ergo
// run as they are.

import fstest
import kvstore/kv
import kvstore/memory
import strings

// fresh is a Log in the directory db of a new fstest.Memory.
func fresh() Log fails kv.Broken {
	let disk = fstest.NewMemory()
	try Open("db", disk, disk)
}

test LogGetAfterPut(key string, value string) {
	with context { kv.Store: try fresh() } {
		assert try kv.GetAfterPutHolds(key, value)
	}
}

test LogPutOverwrites(key string, first string, second string) {
	with context { kv.Store: try fresh() } {
		assert try kv.PutOverwritesHolds(key, first, second)
	}
}

test LogDeleteRemoves(key string, value string) {
	with context { kv.Store: try fresh() } {
		assert try kv.DeleteRemovesHolds(key, value)
	}
}

test LogPutKeepsOthers(key string, other string, a string, b string) {
	with context { kv.Store: try fresh() } {
		assert try kv.PutKeepsOthersHolds(key, other, a, b)
	}
}

test LogKeysAreSortedAndDistinct(keys []string) {
	with context { kv.Store: try fresh() } {
		assert try kv.KeysAreSortedAndDistinctHolds(keys)
	}
}

test LogCompactKeepsContents(puts []string, drops []int) {
	with context { kv.Store: try fresh() } {
		assert try kv.CompactKeepsContentsHolds(puts, drops)
	}
}

// The log's own form: a put, an overwrite and a delete are three lines,
// and a compaction leaves one.
test TheLogIsOneLinePerChange {
	let disk = fstest.NewMemory()
	let log = try Open("db", disk, disk)
	with context { kv.Store: log } {
		try kv.Store.Put("name", "Ada Lovelace")
		try kv.Store.Put("lang", "Ergo")
		try kv.Store.Put("lang", "Go\tand\nErgo")
		try kv.Store.Delete("name")
		assert try disk.ReadFile(log.Path()) == "put\t\"name\"\t\"Ada Lovelace\"\nput\t\"lang\"\t\"Ergo\"\nput\t\"lang\"\t\"Go\\tand\\nErgo\"\ndel\t\"name\"\n"
		try kv.Store.Compact()
		assert try disk.ReadFile(log.Path()) == "put\t\"lang\"\t\"Go\\tand\\nErgo\"\n"
		assert try kv.Store.Get("lang") == "Go\tand\nErgo"
	}
}

// A line that is not a record is a broken store, which names the line.
test ACorruptLineIsBroken {
	let disk = fstest.NewMemory()
	try disk.MkdirAll("db")
	try disk.WriteFile("db/kv.log", "put\t\"a\"\t\"1\"\nput \"b\" 2\n")
	with context { kv.Store: try Open("db", disk, disk) } {
		let reason = kv.Store.Keys() catch {
		case kv.Broken as b:
			[]string{b.Reason}
		}
		assert strings.Join(reason, ",") == "db/kv.log:2: not a record: put \"b\" 2"
	}
}

// Step is one generated change of a store: a put or a delete of one of
// four keys, or a compaction.
type Step = PutStep{Key int, Value string} | DeleteStep{Key int} | CompactStep{}

// keyOf is one of four keys, so generated steps meet the same keys.
func keyOf(n int) string { "k\(if n < 0 { -(n + 1) % 4 } else { n % 4 })" }

// script runs steps on the Store in the context and is what each step
// answers, then every entry: "ok", "missing" or the value.
func script(steps []Step) []string fails kv.Broken needs kv.Store {
	let mut out = []string{}
	for s in steps {
		match s {
		case PutStep as p:
			try kv.Store.Put(keyOf(p.Key), p.Value)
			out = out.Append("ok")
		case DeleteStep as d:
			try kv.Store.Delete(keyOf(d.Key)) catch {
			case kv.Missing:
				out = out.Append("missing")
				continue
			}
			out = out.Append("deleted")
		case CompactStep:
			try kv.Store.Compact()
			out = out.Append("compacted")
		}
	}
	for e in try kv.Snapshot() {
		out = out.Append(e.Key + "=" + e.Value)
	}
	out
}

// The two stores agree: any script of puts, deletes and compactions
// answers the same on a Log as on a memory.Table, the model.
test LogAgreesWithTable(steps []Step) {
	let model = with context { kv.Store: memory.NewTable() } { try script(steps) }
	let got = with context { kv.Store: try fresh() } { try script(steps) }
	assert got == model
}

// A second Log over the same disk reads what the first wrote: the store
// is the file, not the value.
test TheLogIsTheFile {
	let disk = fstest.NewMemory()
	with context { kv.Store: try Open("db", disk, disk) } {
		try kv.Store.Put("k", "v")
	}
	with context { kv.Store: try Open("db", disk, disk) } {
		assert try kv.Store.Get("k") == "v"
	}
}

// Open removes the temp files a crash inside a compaction left, and
// nothing else.
test OpenRemovesStaleTempFiles {
	let disk = fstest.NewMemory()
	try disk.MkdirAll("db")
	try disk.WriteFile("db/kv.log", "put\t\"a\"\t\"1\"\n")
	try disk.WriteFile("db/kv.log.tmp12345", "put\t\"a\"\t\"2\"\n")
	try disk.WriteFile("db/notes.tmp1", "mine")
	with context { kv.Store: try Open("db", disk, disk) } {
		assert try kv.Store.Get("a") == "1"
	}
	assert try disk.ReadDir("db") == []string{"kv.log", "notes.tmp1"}
}
