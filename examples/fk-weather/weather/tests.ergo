// Upstream's two story tests of update (weather/src/story.test.ts),
// restated. A story's Command.resolve(FetchWeather, M) is "step the
// answer M": a fold runs no work. The other three upstream tests are of
// the fetch itself and are restated in package web.

import machines

// beverly is upstream's fixture weatherData.
let beverly = Report{Zip: "90210", Temperature: 72, Description: "Clear sky", Humidity: 45, WindSpeed: 10, Location: "Beverly Hills", Region: "California"}

// asked is upstream's fixture weatherModel: 90210 typed, nothing shown.
let asked = Lookup{Draft: "90210", Panel: Blank}

func next(l Lookup, s Signal) Lookup { machines.Next(l, Step(l, s)) }

test SubmitFetchesAndShowsTheReport {
	// submitting the weather form fetches weather and shows result
	let loading = next(asked, Submitted)
	let p Panel = Loading{Zip: "90210"}
	assert loading.Panel == p && Busy(loading)
	let q Panel = Ready{Report: beverly}
	let shown = next(loading, Got{Report: beverly})
	assert shown.Panel == q
}

test FailedFetchShowsWhy {
	// failed fetch shows failure state
	let why = Unavailable{Reason: "Network error"}
	let p Panel = Failed{Why: why}
	assert next(next(asked, Submitted), why).Panel == p
}
