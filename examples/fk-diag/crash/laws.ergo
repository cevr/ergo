// The crash app's law, on the test host.

import time
import ui

// CrashShowsTheCrashView: over cycles of a press of Crash and a press of
// Reload, each press of Crash crashes the app with a defect: the screen
// is the crash view (its title, the kind of crash and Reload), and the
// report has logged one line per crash so far; each Reload starts the app
// afresh, and the screen is its first screen again, with no crash.
law CrashShowsTheCrashView(cycles int) {
	let m = time.NewManual(0)
	with context { Scheduler: m } {
		crashCycles((cycles%5+5)%5+1, m)
	}
}

func crashCycles(n int, m time.Manual) bool needs Scheduler {
	let reports = NewReports()
	let mut h = ui.NewAppTestHost(App{}, 4, View, Crashes(reports), m, 16) catch {
	case ui.BadPatch:
		return false
	}
	let first = ui.Screenshot(&h)
	for i in 0..n {
		ui.Play(&h, []ui.Act{ui.TapOn{Label: "Crash"}}) catch {
		case _:
			return false
		}
		let shot = ui.Screenshot(&h)
		if State(ui.CrashOf(&h)) != "crashed: a defect" || shot != "text \"Something went wrong\"\ntext \"A defect ended the app.\"\nbutton \"Reload\"\n  text \"Reload\"\n" || len(Logged(reports)) != i+1 {
			return false
		}
		ui.Play(&h, []ui.Act{ui.TapOn{Label: "Reload"}}) catch {
		case _:
			return false
		}
		if State(ui.CrashOf(&h)) != "running" || ui.Screenshot(&h) != first {
			return false
		}
	}
	true
}
