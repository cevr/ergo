// Package crash is the crash app (Foldkit's crash-view): one button whose
// step defects, the app's crash view with a Reload button, and its crash
// report.

import sync
import ui

// Calm is the app's state: it has none to speak of (upstream's Model is
// null).
type Calm {}

// Signal is a press of the app's button, or of the crash view's Reload.
type Signal = ClickedCrash{} | ClickedReload{}

// Step defects on every signal: handling any signal is the simulated
// crash. A Reload never reaches it: while the crash view shows, the
// session takes the crash view's signal as the reload (ui.StartApp).
func Step(s Calm, e Signal) Decision[Calm, Never] {
	Unreachable("This is a simulated crash!")
}

// App is the crash app as a machine. It starts Calm.
type App machine[Calm, Signal] {
	initial: Calm,
	step:    Step,
}

// View is the app's one screen: the Crash button.
func View(f *ui.Frame[Signal], s Calm) {
	ui.Pressable(f, "Crash", ClickedCrash) {
		ui.Text(f, "Crash")
	}
}

// CrashView is what the window shows once the app crashed: what went
// wrong, and a Reload button that starts the app afresh. A defect carries
// no message to the crash view (ui.DefectCrash has no field), so the line
// under the title names the kind of crash, where upstream shows the
// thrown error's message (ledger row FK13-g1).
func CrashView[F](f *ui.Frame[Signal], c ui.Crash[Calm, Signal, F]) {
	ui.Text(f, "Something went wrong")
	match c.Cause {
	case ui.DefectCrash:
		ui.Text(f, "A defect ended the app.")
	case ui.FailureCrash[F]:
		ui.Text(f, "The app's step failed.")
	}
	ui.Pressable(f, "Reload", ClickedReload) {
		ui.Text(f, "Reload")
	}
}

// Reports is the app's crash report, kept as a log: upstream logs each
// crash to the console; here each crash adds one line, which the script
// prints.
type Reports { log sync.Ref[[]string] }

// NewReports is an empty report log.
func NewReports() Reports { Reports{log: sync.NewRef([]string{})} }

// Logged is the report's lines, oldest first.
func Logged(r Reports) []string { r.log.Get() }

// Crashes is the app's crash view, and a report that logs each crash in r.
func Crashes(r Reports) ui.Crashes[Calm, Signal] {
	crashes(r)
}

// crashes is Crashes for a step's failure row F (the app's is empty).
func crashes[F](r Reports) ui.Crashes[Calm, Signal, F] {
	ui.Crashes[Calm, Signal, F]{View: CrashView[F], Report: report[F](r)}
}

// report logs a crash in r.
func report[F](r Reports) func(c ui.Crash[Calm, Signal, F]) {
	func(c ui.Crash[Calm, Signal, F]) {
		r.log.Update(func(l []string) []string { l.Append("crash report: \(Kind(c))") })
	}
}

// State is how the app's crash shows (ui.CrashOf): running, or crashed
// and how.
func State[F](c Option[ui.Crash[Calm, Signal, F]]) string {
	match c {
	case Some[ui.Crash[Calm, Signal, F]] as x:
		"crashed: \(Kind(x.Value))"
	case None:
		"running"
	}
}

// Kind names a crash.
func Kind[F](c ui.Crash[Calm, Signal, F]) string {
	match c.Cause {
	case ui.DefectCrash:
		"a defect"
	case ui.FailureCrash[F]:
		"a failure"
	}
}
