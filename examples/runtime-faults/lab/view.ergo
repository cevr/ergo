// The lab's screen, and the work each workload makes it do.

import ui

// Budget is the work one pass may do before the session warns: a bound
// per phase's counter (ui.OnSlow), the others unbounded.
func Budget() ui.Budget {
	ui.Budget{Signals: Bound(UpdatePhase), Written: Bound(ViewPhase), Committed: 0, Ops: Bound(PatchPhase), Painted: 0, Fetches: Bound(DependencyPhase)}
}

// Bound is a phase's budget. The patch work's rows fit the view's bound,
// and the view work's nodes make few ops, so each workload is over one
// bound only.
func Bound(p Phase) int {
	match p {
	case UpdatePhase:
		4
	case ViewPhase:
		5000
	case PatchPhase:
		100
	case DependencyPhase:
		4
	}
}

// BurstSignals is how many signals the update work steps in one frame.
let BurstSignals = 8

// ViewNodes is how many nodes the view work writes.
let ViewNodes = 5250

// DependencyFetches is how many fetches the dependency work starts.
let DependencyFetches = 8

// Spent is the view work's group's failure: the work is done, and the
// group drops what it wrote.
type Spent {}

func spend() fails Spent { return Spent }

// Screen is the lab: the four workloads, the warning log and the patch
// surface. The session judges each pass against Budget and sends each
// warning back as a Recorded signal.
func Screen(f mut ui.Frame[Signal], s Lab) {
	ui.OnSlow(f, Budget(), func(x ui.Slow) Signal { Recorded{Slow: x} })
	ui.Text(f, "Slow Warnings Lab")
	ui.Text(f, "Each workload makes one part of a pass do more counted work than its budget allows.")
	for p in []Phase{UpdatePhase, ViewPhase, PatchPhase, DependencyPhase} {
		card(f, p)
	}
	match s.Active {
	case Busy as b:
		work(f, b.Phase)
	case Idle:
	}
	warnings(f, s.Warnings)
	patchSurface(f, s)
}

// card is a phase's scenario: what it loads, its budget and its button.
func card(f mut ui.Frame[Signal], p Phase) {
	ui.Text(f, "Slow \(Label(p))")
	ui.Text(f, "Budget: \(Bound(p)) \(Unit(p))")
	ui.Pressable(f, Button(p), Run{Phase: p}) {
		ui.Text(f, Button(p))
	}
}

// work is what a busy phase makes the pass do: a frame that steps a burst
// of signals (the step), a group that writes many nodes and stops (the
// view), nothing here for the patch (its rows are the patch surface's),
// and a fetch per dependency (the subscriptions).
func work(f mut ui.Frame[Signal], p Phase) {
	match p {
	case UpdatePhase:
		for _ in 0..BurstSignals {
			ui.Animate(f, func(at duration) Signal { Burn })
		}
	case ViewPhase:
		ui.Boundary(f) {
			for i in 0..ViewNodes {
				ui.Text(f, "work \(i)")
			}
			try spend()
		} catch {
		case Spent:
		}
	case PatchPhase:
	case DependencyPhase:
		for i in 0..DependencyFetches {
			ui.Load(f, ui.ByInt(i), func() Signal { Derived })
		}
	}
}

// warnings is the log, newest first, and its Clear button.
func warnings(f mut ui.Frame[Signal], log []Warning) {
	ui.Text(f, "Recorded warnings")
	ui.Pressable(f, "Clear", Clear) {
		ui.Text(f, "Clear")
	}
	if log.Len() == 0 {
		ui.Text(f, "Run a workload to record a warning.")
		return
	}
	ui.Each(f, log, func(w Warning) ui.Key { ui.ByInt(w.ID) }) func(w Warning) {
		ui.Text(f, Title(w))
		ui.Text(f, "\(w.Count) \(Unit(w.Phase))")
		ui.Text(f, "\(w.Details) Trigger: \(w.Trigger).")
	}
}

// Title is a warning's heading.
func Title(w Warning) string { "\(Label(w.Phase)) exceeded \(w.Bound) \(Unit(w.Phase))" }

// patchSurface is the patch work's rows, which a Same keeps from pass to
// pass until the next mount (lazy rows): a mount writes them
// all, and no other pass writes them again.
func patchSurface(f mut ui.Frame[Signal], s Lab) {
	ui.Text(f, "Patch surface")
	ui.Text(f, "\(s.PatchRows) keyed rows mounted")
	ui.Same(f, ui.ByInt(s.PatchRun)) {
		patchRows(f, s.PatchRows, s.PatchRun)
	}
}

// patchRows is the rows of the run'th mount, keyed by run and row, so a
// new mount replaces every row.
func patchRows(f mut ui.Frame[Signal], count int, run int) {
	if count == 0 {
		ui.Text(f, "Patch rows will appear here.")
		return
	}
	let mut rows = []int{}
	for r in 0..count {
		rows = rows.Append(r + 1)
	}
	ui.Each(f, rows, func(r int) ui.Key { ui.ByText("\(run)-\(r)") }) func(r int) {
		ui.Text(f, "Patch row \(r)")
	}
}
