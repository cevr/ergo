// Package crash is the crash app: one button whose
// step defects, the app's crash view with a Reload button, and its crash
// report.

import actor
import core
import machines
import option
import sync
import ui
import time
import strings

// Calm is the app's state: it has none to speak of.
type Calm {}

// Signal is a press of the app's button, or of the crash view's Reload.
type Signal = ClickedCrash{} | ClickedReload{}

// SimulatedCrash is the deliberate defect payload raised by the crash app's
// live step when handling a signal.
type SimulatedCrash { Message string }

// Step is the pure preview/replay transition for App.
func Step(s Calm, e Signal) machines.Decision[Calm, core.Never] {
	machines.Enter[Calm]{Next: s}
}

// LiveStep defects on every signal: handling any signal is the simulated
// crash. A Reload never reaches it: while the crash view shows, the
// session takes the crash view's signal as the reload (ui.StartLiveApp).
func LiveStep(s Calm, e Signal) machines.Decision[Calm, core.Never] defects {
	die SimulatedCrash{Message: "This is a simulated crash!"}
}

// App is the crash app as a pure machine. It starts Calm.
type App machine[Calm, Signal] {
	initial: Calm,
	step:    Step,
}

func noTimer(s Calm) option.Option[machines.Timeout[Signal]] { option.None }

func noWork(s Calm) option.Option[func(send entry func(e Signal)) defects] { option.None }

func noExit(s Calm) option.Option[func()] { option.None }

// LiveApp is the crash app as a live machine whose step raises SimulatedCrash.
func LiveApp() actor.LiveMachine[Calm, Signal, core.Never] {
	actor.LiveMachine[Calm, Signal, core.Never]{Initial: Calm, Step: LiveStep, After: noTimer, Work: noWork, Exit: noExit}
}

// View is the app's one screen: the Crash button.
func View(f mut ui.Frame[Signal], s Calm) {
	ui.Pressable(f, "Crash", ClickedCrash) {
		ui.Text(f, "Crash")
	}
}

// CrashShowsTheCrashView: over cycles of a press of Crash and a press of
// Reload, each press of Crash crashes the app with a defect: the screen
// is the crash view (its title, the defect's reason, which ends with the
// step's message, and Reload), and the report has logged one line per
// crash so far, naming the press, the state and the reason; each Reload
// starts the app afresh, and the screen is its first screen again, with
// no crash.
law CrashShowsTheCrashView(cycles int) {
	let m = time.NewManual(0)
	with context { time.Scheduler: m } {
		crashCycles((cycles%5+5)%5+1, m)
	}
}

func crashCycles(n int, m time.Manual) bool needs time.Scheduler {
	let reports = NewReports()
	let mut h = ui.NewLiveAppTestHost(LiveApp(), 4, View, Crashes(reports), m, 16) catch {
	case ui.BadPatch:
		return false
	}
	let first = ui.Screenshot(&h)
	for i in 0..n {
		ui.Play(&h, []ui.Act{ui.TapOn{Label: "Crash"}}) catch {
		case _:
			return false
		}
		let shot = ui.Screenshot(&h)
		let log = Logged(reports)
		let reason = defectReason(ui.CrashOf(&h))
		if !strings.HasPrefix(reason, "die at ") || !strings.Contains(reason, "This is a simulated crash!") || State(ui.CrashOf(&h)) != "crashed: a defect" || shot != "text \"Something went wrong\"\ntext \"\(reason)\"\nbutton \"Reload\"\n  text \"Reload\"\n" || log.Len() != i+1 || log[i] != "crash report: a defect on ClickedCrash in Calm: \(reason)" {
			return false
		}
		ui.Play(&h, []ui.Act{ui.TapOn{Label: "Reload"}}) catch {
		case _:
			return false
		}
		if State(ui.CrashOf(&h)) != "running" || ui.Screenshot(&h) != first {
			return false
		}
	}
	true
}

// defectReason is the reason of a crash by a defect, or "" for none.
func defectReason[F](c option.Option[ui.Crash[Calm, Signal, F]]) string {
	match c {
	case option.Some[ui.Crash[Calm, Signal, F]] as x:
		match x.Value.Cause {
		case ui.DefectCrash as d:
			d.Reason
		case ui.FailureCrash[F]:
			""
		}
	case option.None:
		""
	}
}

// CrashView is what the window shows once the app crashed: what went
// wrong (a defect's reason), and a Reload button that starts the app afresh.
func CrashView[F](f mut ui.Frame[Signal], c ui.Crash[Calm, Signal, F]) {
	ui.Text(f, "Something went wrong")
	match c.Cause {
	case ui.DefectCrash as d:
		ui.Text(f, d.Reason)
	case ui.FailureCrash[F]:
		ui.Text(f, "The app's step failed.")
	}
	ui.Pressable(f, "Reload", ClickedReload) {
		ui.Text(f, "Reload")
	}
}

// Reports is the app's crash report, kept as a log: each crash adds one line, which the script
// prints.
type Reports { log sync.Ref[[]string] }

// NewReports is an empty report log.
func NewReports() Reports { Reports{log: sync.NewRef([]string{})} }

// Logged is the report's lines, oldest first.
func Logged(r Reports) []string { r.log.Get() }

// Crashes is the app's crash view, and a report that logs each crash in r.
func Crashes(r Reports) ui.Crashes[Calm, Signal] {
	crashes(r)
}

// crashes is Crashes for a step's failure row F (the app's is empty).
func crashes[F](r Reports) ui.Crashes[Calm, Signal, F] {
	ui.Crashes[Calm, Signal, F]{View: CrashView[F], Report: report[F](r)}
}

// report logs a crash in r: the kind of crash, the signal it crashed around, the state it
// crashed in, and a defect's reason.
func report[F](r Reports) func(c ui.Crash[Calm, Signal, F]) {
	func(c ui.Crash[Calm, Signal, F]) {
		r.log.Update(func(l []string) []string { l.Append("crash report: \(Kind(c)) on \(signalName(c.Signal)) in \(stateName(c.State))\(reasonOf(c.Cause))") })
	}
}

// State is how the app's crash shows (ui.CrashOf): running, or crashed
// and how.
func State[F](c option.Option[ui.Crash[Calm, Signal, F]]) string {
	match c {
	case option.Some[ui.Crash[Calm, Signal, F]] as x:
		"crashed: \(Kind(x.Value))"
	case option.None:
		"running"
	}
}

// signalName names the signal a crash came around,
// or says there was none in flight.
func signalName(s option.Option[Signal]) string {
	match s {
	case option.Some[Signal] as x:
		match x.Value {
		case ClickedCrash:
			"ClickedCrash"
		case ClickedReload:
			"ClickedReload"
		}
	case option.None:
		"no signal"
	}
}

// stateName names the state a crash came in: Calm has no
// fields.
func stateName(s Calm) string { "Calm" }

// reasonOf is a defect's reason after a colon, or nothing for a failure.
func reasonOf[F](c ui.CrashCause[F]) string {
	match c {
	case ui.DefectCrash as d:
		": \(d.Reason)"
	case ui.FailureCrash[F]:
		""
	}
}

// Kind names a crash.
func Kind[F](c ui.Crash[Calm, Signal, F]) string {
	match c.Cause {
	case ui.DefectCrash:
		"a defect"
	case ui.FailureCrash[F]:
		"a failure"
	}
}
