// ergo test runs the payments.Payments law here, against Gateway and
// Decliner; these tests check it again with fixed amounts.

import checkout/payments

test GatewayReceiptsTheAmount {
	with context { payments.Payments: Gateway } {
		for amount in []int64{-1, 0, 1, 100, 2500} {
			let receipt = payments.Payments.Charge(amount) catch {
			case payments.Declined:
				payments.Receipt{ID: "declined", Amount: amount}
			}
			assert payments.Receipted(receipt, amount)
		}
	}
}

test DeclinerReceiptsNothing {
	with context { payments.Payments: Decliner } {
		let receipt = payments.Payments.Charge(100) catch {
		case payments.Declined:
			payments.Receipt{ID: "declined", Amount: 100}
		}
		assert payments.Receipted(receipt, 100)
	}
}
