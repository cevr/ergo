// Package memory holds in-memory providers of the payments contract.

import checkout/payments

// Two providers of payments.Payments: same-named functions on distinct types.
type Gateway {}
type Decliner {}

func Charge(_ Gateway, amount int64) payments.Receipt fails payments.Declined {
	if amount <= 0 {
		return payments.Declined{Reason: "amount must be positive"}
	}
	payments.Receipt{ID: "paid", Amount: amount}
}

func Charge(_ Decliner, amount int64) payments.Receipt fails payments.Declined {
	payments.Declined{Reason: "card declined"}
}

// Paying binds the contract to the paying gateway.
let Paying = context { payments.Payments: Gateway }
