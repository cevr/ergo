import vt/traffic

// SplitDoesNotMatter: feeding a stream in pieces gives the events and the
// tally of feeding it whole. Pieces of 1 to 16 bytes cut UTF-8
// characters, sequences, OSC strings and text runs.
law SplitDoesNotMatter(seed int, cuts []int) {
	let input = traffic.Gen(seed, 600)
	Replay(input, []int{}, true) == Replay(input, cuts, true)
}

// FastPathMatchesStep: taking a run of text or of OSC data in one step
// gives what taking each of its bytes through the machine gives.
law FastPathMatchesStep(seed int, cuts []int) {
	let input = traffic.Gen(seed, 600)
	Replay(input, cuts, true) == Replay(input, cuts, false)
}

// Replay is the rendered events and the tally of input fed in pieces:
// piece k is 1 to 16 bytes long, by cuts[k % len(cuts)]; with no cuts,
// one piece.
func Replay(input string, cuts []int, fast bool) []string {
	let mut p = NewStream(fast)
	let mut at = 0
	let mut k = 0
	for at < len(input) {
		let mut size = len(input) - at
		if len(cuts) > 0 {
			let c = cuts[k%len(cuts)] % 16
			size = (if c < 0 { -c } else { c }) + 1
			if at+size > len(input) {
				size = len(input) - at
			}
		}
		p.Feed(input[at : at+size])
		at += size
		k += 1
	}
	p.Finish()
	Render(p.Take()).Append(TallyText(p.Tally))
}

// TallyText is the tally as one line.
func TallyText(t Tally) string {
	"bytes \(t.Bytes) dropped \(t.Dropped) bad-text \(t.BadText) osc-cut \(t.OscCut)"
}
