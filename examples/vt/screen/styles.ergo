import dense
import option
import vt/vt

// The screen's styles are a dense.Counted[vt.Style]: each style in use
// has an id, and the id's count is the cells that hold it, plus one if
// the pen holds it. When a count falls to 0 the style leaves the set and
// its id is free for the next new style (a reference-counted set). A cell
// holds a dense.Opt of the id: no id is the default style, which is never
// counted.

// noStyle is the default style's id.
let noStyle = dense.NoID[vt.Style]()

// intern is the id of st in t, with no new holder: no id for the
// default style.
func intern(t mut dense.Counted[vt.Style], st vt.Style) dense.Opt[vt.Style] {
	if st == vt.Default {
		return noStyle
	}
	dense.OptOf(t.Add(st))
}

// retain counts one more holder of id.
func retain(t mut dense.Counted[vt.Style], id dense.Opt[vt.Style]) {
	match dense.Unpack(id) {
	case option.Some[dense.ID[vt.Style]] as held:
		t.Use(held.Value)
	case option.None:
	}
}

// release counts one holder of id less; at 0 its style leaves the set.
func release(t mut dense.Counted[vt.Style], id dense.Opt[vt.Style]) {
	match dense.Unpack(id) {
	case option.Some[dense.ID[vt.Style]] as held:
		t.Release(held.Value)
	case option.None:
	}
}

// retainN counts n more holders of id: a run of cells taking id.
func retainN(t mut dense.Counted[vt.Style], id dense.Opt[vt.Style], n int) {
	match dense.Unpack(id) {
	case option.Some[dense.ID[vt.Style]] as held:
		t.UseN(held.Value, n)
	case option.None:
	}
}

// releaseN counts n holders of id less: a run of cells giving id up.
func releaseN(t mut dense.Counted[vt.Style], id dense.Opt[vt.Style], n int) {
	match dense.Unpack(id) {
	case option.Some[dense.ID[vt.Style]] as held:
		t.ReleaseN(held.Value, n)
	case option.None:
	}
}

// styleAt is the style of id.
func styleAt(t dense.Counted[vt.Style], id dense.Opt[vt.Style]) vt.Style {
	match dense.Unpack(id) {
	case option.Some[dense.ID[vt.Style]] as held:
		dense.Member(t, held.Value)
	case option.None:
		vt.Default
	}
}
