import sync
import vt/vt

// Shared is the reference screen in a sync.Ref: a vt.Screen whose every copy is the
// same screen, so that ergo test can build one (NewShared) and run the
// laws of vt.Screen on it. Each command copies the screen in and out, so
// Shared is for laws on small screens; a program binds *Screen.
type Shared { at sync.Ref[Screen] }

// NewShared is a blank screen of vt.LawSize.
func NewShared() Shared { Shared{at: sync.NewRef[Screen](New(vt.LawSize))} }

// Print gives the screen Print.
func Print(h Shared, run string) {
	h.at.Update(func(v Screen) Screen {
		let mut x = v
		x.Print(run)
		x
	})
}

// PrintRune gives the screen PrintRune.
func PrintRune(h Shared, c rune, width int) {
	h.at.Update(func(v Screen) Screen {
		let mut x = v
		x.PrintRune(c, width)
		x
	})
}

