// fk-domains is the port of foldkit-domains. Stage a has no pages yet:
//
//	fk-domains serve [ADDR]                  serve the registry over Effect RPC at /rpc
//	fk-domains search LABEL [OFFSET [LIMIT]]  print a search, one listing a line
//
// serve listens on ADDR (127.0.0.1:0, a free port, when absent) and
// prints the address first. Package domains is the contract, sample the
// provider, domains/domainsrpc is generated by `ergo gen rpc
// domains.Registry`, and server answers HTTP with the original's
// refusals. This binary is the only place that chooses them: it binds
// domains.Registry to the sample registry.

import crc32
import http
import json
import os
import strconv
import fk-domains/domains
import fk-domains/sample
import fk-domains/server

func usage() os.Exit { os.Exit{Code: 2, Message: "usage: fk-domains serve [ADDR] | search LABEL [OFFSET [LIMIT]] | bench N"} }

// line is a listing as search prints it.
func line(l domains.Listing) string {
	match l {
	case domains.Available as a:
		"\(a.Name) \(a.Price), renews at \(a.RenewalPrice), \(a.Years) year"
	case domains.Unavailable as u:
		"\(u.Name) taken"
	}
}

func integer(text string) int fails os.Exit {
	strconv.Atoi(text) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return os.Exit{Code: 1, Message: "fk-domains: \(text) is not a number"}
	}
}

// search prints the registry's answer for args, LABEL [OFFSET [LIMIT]];
// a label, an offset or a limit the Api refuses is a line and status 1.
func search(args []string) fails os.Exit needs Console | domains.Registry {
	if len(args) < 1 || len(args) > 3 {
		return usage()
	}
	let label = domains.ParseLabel(args[0]) catch {
	case Unsatisfied:
		return os.Exit{Code: 1, Message: "fk-domains: \(args[0]) is not a label: a to z, 0 to 9 and inner hyphens, at most 63"}
	}
	let mut offset json.Optional[domains.Offset] = json.Absent
	if len(args) > 1 {
		let o = domains.ParseOffset(try integer(args[1])) catch {
		case Unsatisfied:
			return os.Exit{Code: 1, Message: "fk-domains: the offset is 0 to \(len(domains.Catalog) - 1)"}
		}
		offset = json.Present[domains.Offset]{Value: o}
	}
	let mut limit json.Optional[domains.Limit] = json.Absent
	if len(args) > 2 {
		let n = domains.ParseLimit(try integer(args[2])) catch {
		case Unsatisfied:
			return os.Exit{Code: 1, Message: "fk-domains: the limit is 1 to \(len(domains.Catalog))"}
		}
		limit = json.Present[domains.Limit]{Value: n}
	}
	let listings = domains.Registry.SearchDomains(label, offset, limit) catch {
	case domains.Down:
		return os.Exit{Code: 1, Message: "fk-domains: the registry is down"}
	}
	for l in listings {
		Console.Println(line(l))
	}
}

// bench answers the first N requests of server's script through
// server.Answer, in process, and prints how many bytes they answered and
// the CRC-32 of each answer's status, headers and body. It is target
// P11's workload: the hand Go control prints the same line.
func bench(args []string) fails os.Exit needs Console | domains.Registry {
	if len(args) != 1 {
		return usage()
	}
	let n = try integer(args[0])
	let mut bytes = 0
	let mut crc uint32 = 0
	with context { http.Streaming: http.NewRecorder() } {
		for i in 0..n {
			let a = server.Answer(server.ScriptRequest(i))
			crc = crc32.Update(crc, "\(a.Status)\n")
			for h in a.Header {
				crc = crc32.Update(crc, h.Name+": "+h.Value+"\n")
			}
			crc = crc32.Update(crc, a.Body)
			bytes += len(a.Body)
		}
	}
	Console.Println("\(n) requests, \(bytes) answer bytes, crc32 \(crc)")
}

func serve(args []string) fails http.ListenFailed | http.InvalidLimits | os.Exit needs Console | Ambient | domains.Registry {
	if len(args) > 1 {
		return usage()
	}
	let addr = if len(args) == 1 { args[0] } else { "127.0.0.1:0" }
	let l = try http.Listen(addr)
	Console.Println("listening \(l.Addr())")
	with context { Scheduler: NewLiveScheduler() } {
		try http.Serve(l, server.Limits(), server.Answer)
	}
}

func main() fails http.ListenFailed | http.InvalidLimits | os.Exit needs Console | Ambient {
	let args = os.NewHost().Args()
	if len(args) == 0 {
		return usage()
	}
	with context { domains.Registry: sample.NewSample() } {
		match args[0] {
		case "serve":
			try serve(args[1:])
		case "search":
			try search(args[1:])
		case "bench":
			try bench(args[1:])
		case _:
			return usage()
		}
	}
}
