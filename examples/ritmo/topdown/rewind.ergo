// The rewind laws: the session's ring of worlds against the worlds a
// plain list of every tick keeps.

// within maps n into 0..span-1.
func within(n int, span int) int { if n < 0 { -(n % span) } else { n % span } }

// RewindReplays: rewinding k ticks and stepping the same k inputs again
// gives the same world, bit for bit (ritmo's Checkpoint promise), also
// on a ring that has wrapped around and after an earlier rewind.
law RewindReplays(seed int, k int, keep int) {
	let inputs = inputsOf(seed, 120)
	let size = 1 + within(keep, 40)
	let back = within(k, size+1)
	let mut s = Begin(size)
	for i, c in inputs {
		Advance(&s, c)
		if i == 60 {
			Back(&s, 0) catch {
			case TooFar:
				return false
			}
		}
	}
	let end = s.Now()
	Back(&s, back) catch {
	case TooFar:
		return false
	}
	for c in inputs[len(inputs)-back : len(inputs)] {
		Advance(&s, c)
	}
	s.Now() == end
}

// RewindKeepsNoMore: a session of any keep, past the wrap of its ring,
// rewinds keep ticks to the world of then and steps on from it, and a
// rewind past what it keeps fails TooFar with what it keeps.
law RewindKeepsNoMore(seed int, keep int, extra int) {
	let size = within(keep, 30)
	let mut s = Begin(size)
	let mut worlds = []World{}
	let inputs = inputsOf(seed, 3*size+5)
	for c in inputs {
		worlds = worlds.Append(s.Now())
		Advance(&s, c)
	}
	worlds = worlds.Append(s.Now())
	let past = size + 1 + within(extra, 50)
	let mut refused = false
	Back(&s, past) catch {
	case TooFar as t:
		refused = s.Kept() == size && t.Kept == size && t.Asked == past
	}
	if !refused {
		return false
	}
	Back(&s, size) catch {
	case TooFar:
		return false
	}
	let then = len(worlds) - 1 - size
	if s.Now() != worlds[then] || s.Kept() != 0 {
		return false
	}
	Advance(&s, inputs[then])
	s.Now() == worlds[then+1]
}
