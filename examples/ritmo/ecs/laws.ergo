// The rules of a column as laws. Each builds its column from generated
// ids and values with Set and Remove only.

// columnOf is the column of ids[i] set to vals[i], for each i both have.
func columnOf(ids []int, vals []int) Column[int] {
	let mut c = Empty[int]()
	for i, id in ids {
		if i < len(vals) {
			c = c.Set(Entity{Id: id}, vals[i])
		}
	}
	c
}

// GetSeesSet: a value set for an entity is the value its lookup gives.
law GetSeesSet(ids []int, vals []int, id int, v int) {
	columnOf(ids, vals).Set(Entity{Id: id}, v).Get(Entity{Id: id}) == Some[int]{Value: v}
}

// SetKeepsTheOthers: a set changes no other entity's value.
law SetKeepsTheOthers(ids []int, vals []int, id int, other int, v int) {
	if id == other {
		return true
	}
	let c = columnOf(ids, vals)
	c.Set(Entity{Id: id}, v).Get(Entity{Id: other}) == c.Get(Entity{Id: other})
}

// RemoveForgets: a removed entity has no value, and the column is one
// smaller exactly when it had one.
law RemoveForgets(ids []int, vals []int, id int) {
	let c = columnOf(ids, vals)
	let e = Entity{Id: id}
	let after = c.Remove(e)
	after.Get(e) == None && !after.Has(e) && after.Size() == c.Size() - (if c.Has(e) { 1 } else { 0 })
}

// OneValueAnEntity: however often an entity is set, the column holds it
// once.
law OneValueAnEntity(ids []int, vals []int) {
	let c = columnOf(ids, vals)
	for i, e in c.Ents {
		for j in (i + 1)..len(c.Ents) {
			if c.Ents[j] == e {
				return false
			}
		}
	}
	true
}
