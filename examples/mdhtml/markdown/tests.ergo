// The reader's tests: golden documents, each rule of the machine, the
// inline spans and the Highlighters. The laws run under ergo test.

import mdhtml/html
import strings

let plain = context { Highlighter: NoColor }
let colored = context { Highlighter: Keywords{Lang: "go", Words: GoKeywords} }

test GoldenDocument {
	let src = "# Title *one*\n\nSome **bold** and `code`,\nand a [link](https://go.dev).\n\n- one\n- two\n  continued\n\n3. three\n4. four\n\n```go\nfunc main() {\n\tif x < 1 {}\n}\n```\n---\n## End\n"
	let want = "<h1>Title <em>one</em></h1>\n<p>Some <strong>bold</strong> and <code>code</code>,\nand a <a href=\"https://go.dev\">link</a>.</p>\n<ul><li>one</li><li>two continued</li></ul>\n<ol start=\"3\"><li>three</li><li>four</li></ol>\n<pre><code class=\"language-go\">func main() {\n\tif x &lt; 1 {}\n}</code></pre>\n<hr>\n<h2>End</h2>\n"
	assert with plain { Render(src) } == want
}

test KeywordsMarkOnlyTheirLanguage {
	let src = "```go\nfor x := range xs {}\n```\n```sh\nfor x in y\n```\n"
	assert with colored { Render(src) } == "<pre><code class=\"language-go\"><span class=\"kw\">for</span> x := <span class=\"kw\">range</span> xs {}</code></pre>\n<pre><code class=\"language-sh\">for x in y</code></pre>\n"
}

test BlocksCloseEachOther {
	assert with plain { Render("para\n# head\n- item\n1. num\n```\ncode\n") } == "<p>para</p>\n<h1>head</h1>\n<ul><li>item</li></ul>\n<ol><li>num</li></ol>\n<pre><code>code</code></pre>\n"
	assert with plain { Render("a\n***\nb") } == "<p>a</p>\n<hr>\n<p>b</p>\n"
	assert with plain { Render("") } == ""
	assert with plain { Render("\n\n") } == ""
}

test LinesThatAreNotWhatTheyLookLike {
	assert with plain { Render("#nospace\n-nospace\n1.5 is a number\n####### seven") } == "<p>#nospace\n-nospace\n1.5 is a number\n####### seven</p>\n"
	assert with plain { Render("#\n```\n# not a head\n```go\n```") } == "<h1></h1>\n<pre><code># not a head\n```go</code></pre>\n"
}

// inline is the HTML of the line s.
func inline(s string) string { html.RenderAll(Inline(s)) }

test InlineSpans {
	assert inline("a *b* c") == "a <em>b</em> c"
	assert inline("__x__ and _y_") == "<strong>x</strong> and <em>y</em>"
	assert inline("**a *b* c**") == "<strong>a <em>b</em> c</strong>"
	assert inline("*a **b** c*") == "<em>a </em><em>b</em><em> c</em>"
	assert inline("`a *b* <c>`") == "<code>a *b* &lt;c&gt;</code>"
	assert inline("[*go*](https://go.dev)") == "<a href=\"https://go.dev\"><em>go</em></a>"
	assert inline("[x](javascript:alert(1))") == "<a href=\"#\">x</a>)"
	assert inline("2 * 3 * 4") == "2 <em> 3 </em> 4"
	assert inline("** x") == "** x"
	assert inline("\\*not\\* \\`code\\`") == "*not* `code`"
	assert inline("a < b & c") == "a &lt; b &amp; c"
	assert inline("[open") == "[open"
}

// The Go keywords keep the text: the law KeepsTheText meets generated
// Keywords, whose words rarely occur in generated code.
test GoKeywordsKeepTheText(code string, ns []int) {
	let text = code + strings.Join(Doc(ns), " func for ")
	for info in []string{"go", "sh", ""} {
		assert with plain { TextOfAll(Highlighter.Highlight(info, text)) } == text
		assert with colored { TextOfAll(Highlighter.Highlight(info, text)) } == text
	}
}
