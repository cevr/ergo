// The rules of the reader as laws over its machine and its inline text.
// The laws over documents build them from a pool of lines that reach
// every kind of line: generated strings are rarely markdown.

import machines
import mdhtml/html
import slices
import strings

// pool is lines of every kind.
let pool = []string{"", "text", "more *em* text", "# head", "### sub", "- a", "* b", "1. one", "2. two", "```", "```go", "---", "  indented", "\\*x\\*", "[l](u)"}

// Doc is the lines that ns pick from pool.
func Doc(ns []int) []string {
	let mut out = []string{}
	for n in ns {
		let k = if n < 0 { -(n + 1) } else { n }
		out = out.Append(pool[k%len(pool)])
	}
	out
}

// After is the mode of the machine after lines.
func After(lines []string) Mode {
	let mut m = machines.Initial(Blocks{})
	for line in lines {
		m = machines.Next(m, Step(m, Got{Raw: line}))
	}
	m
}

// IsCode reports whether m is inside a fence.
func IsCode(m Mode) bool {
	match m {
	case InCode:
		true
	case Idle, InPara, InList:
		false
	}
}

// EndIsDone: the end of the source is Done with the open block, in every
// mode.
law EndIsDone(ns []int) {
	let m = After(Doc(ns))
	match Step(m, End) {
	case Done[[]Block] as d:
		d.Output == Open(m)
	case Enter[Mode], Stay[Mode], Emit[Mode, []Block], Ignore, Reject:
		false
	}
}

// BlankSeparates: outside a fence, a blank line between two texts makes
// the blocks of the first and then the blocks of the second.
law BlankSeparates(xs []int, ys []int) {
	let a = Doc(xs)
	let b = Doc(ys)
	if IsCode(After(a)) {
		return true
	}
	Read(slices.Concat(a.Append(""), b)) == slices.Concat(Read(a), Read(b))
}

// FenceKeepsLines: the lines inside a fence are the code, as they are,
// when none of them is a bare fence.
law FenceKeepsLines(ns []int, extra string) {
	let lines = Doc(ns).Append(extra)
	let mut src = []string{"```"}
	for l in lines {
		if strings.TrimSpace(l) == "```" {
			return true
		}
		src = src.Append(l)
	}
	Read(src.Append("```")) == []Block{Code{Info: "", Text: strings.Join(lines, "\n")}}
}

// PlainTextStaysText: s with its markers taken out is one text node of
// itself.
law PlainTextStaysText(s string) {
	let mut kept = []string{}
	for i in 0..len(s) {
		if !isMarker(s[i]) {
			kept = kept.Append(strings.Slice(s, i, i+1))
		}
	}
	let t = strings.Join(kept, "")
	let ns = Inline(t)
	if t == "" {
		return len(ns) == 0
	}
	len(ns) == 1 && html.RenderAll(ns) == html.Escape(t)
}

// EscapedMarkersAreText: a backslash before each marker keeps it as
// text, so no span starts.
law EscapedMarkersAreText(s string, ns []int) {
	let text = s + strings.Join(Doc(ns), "")
	let mut parts = []string{}
	for i in 0..len(text) {
		let c = strings.Slice(text, i, i+1)
		parts = parts.Append(if isMarker(text[i]) { "\\" + c } else { c })
	}
	let out = Inline(strings.Join(parts, ""))
	TextOfAll(out) == text && !strings.Contains(html.RenderAll(out), "<")
}
