import machines
import slices
import strings

// Block is a block of the document.
type Block =
	| Head{Level int, Text string}
	| Para{Text string}
	| List{Ordered bool, Start int, Items []string}
	| Code{Info string, Text string}
	| HRule

type HRule {}

// Mode is what the reader is in the middle of: no block, or the lines of
// the open block. A block is handed out by the step that closes it.
type Mode =
	| Idle{}
	| InPara{Lines []string}
	| InList{Ordered bool, Start int, Items []string}
	| InCode{Info string, Lines []string}

// Signal is what the reader reads: a line, or the end of the source.
type Signal = Got{Raw string} | End{}

// Blocks reads the lines of a document into its blocks: it starts Idle
// and moves by Step, one line at a time. A step that closes blocks Emits
// them, and the end is Done with the open block.
type Blocks machine[Mode, Signal] {
	initial: Idle,
	step:    Step,
}

// Step is the reader's transition. In code every line but a bare fence
// is kept as it is. Elsewhere a blank line closes the open block, a
// plain line continues a paragraph or the last list item, an item of
// the other kind of list closes the list, and a heading, a rule or a
// fence closes the open block and is read as from Idle. Each closed
// block is emitted. The end is Done with the open block closed: an
// unclosed fence runs to the end, as in CommonMark.
func Step(m Mode, s Signal) Decision[Mode, []Block] {
	match s {
	case End:
		Done[[]Block]{Output: Open(m)}
	case Got as g:
		let line = Classify(g.Raw)
		match m {
		case Idle:
			fromIdle(line)
		case InCode as c:
			match line {
			case Fence as f:
				if f.Info == "" {
					return Emit[Mode, []Block]{Next: Idle, Output: Open(m)}
				}
				Stay[Mode]{Next: InCode{..c, Lines: c.Lines.Append(g.Raw)}}
			case Blank, Heading, Bullet, Numbered, Rule, Plain:
				Stay[Mode]{Next: InCode{..c, Lines: c.Lines.Append(g.Raw)}}
			}
		case InPara as p:
			match line {
			case Plain as t:
				Stay[Mode]{Next: InPara{Lines: p.Lines.Append(t.Text)}}
			case Blank:
				Emit[Mode, []Block]{Next: Idle, Output: Open(m)}
			case Heading, Bullet, Numbered, Fence, Rule:
				moved(Open(m), line)
			}
		case InList as l:
			match line {
			case Bullet as b:
				if l.Ordered {
					return moved(Open(m), line)
				}
				Stay[Mode]{Next: InList{..l, Items: l.Items.Append(b.Text)}}
			case Numbered as n:
				if !l.Ordered {
					return moved(Open(m), line)
				}
				Stay[Mode]{Next: InList{..l, Items: l.Items.Append(n.Text)}}
			case Plain as t:
				let mut items = l.Items
				items[len(items)-1] = items[len(items)-1] + " " + t.Text
				Stay[Mode]{Next: InList{..l, Items: items}}
			case Blank:
				Emit[Mode, []Block]{Next: Idle, Output: Open(m)}
			case Heading, Fence, Rule:
				moved(Open(m), line)
			}
		}
	}
}

// fromIdle is the decision on line with no block open.
func fromIdle(line Line) Decision[Mode, []Block] {
	match line {
	case Blank:
		Ignore
	case Heading as h:
		Emit[Mode, []Block]{Next: Idle, Output: []Block{Head{Level: h.Level, Text: h.Text}}}
	case Rule:
		Emit[Mode, []Block]{Next: Idle, Output: []Block{HRule}}
	case Plain as t:
		Enter[Mode]{Next: InPara{Lines: []string{t.Text}}}
	case Bullet as b:
		Enter[Mode]{Next: InList{Ordered: false, Start: 1, Items: []string{b.Text}}}
	case Numbered as n:
		Enter[Mode]{Next: InList{Ordered: true, Start: n.N, Items: []string{n.Text}}}
	case Fence as f:
		Enter[Mode]{Next: InCode{Info: f.Info, Lines: []string{}}}
	}
}

// moved is fromIdle after the blocks closed closed: it emits them, and
// then the blocks line closes itself (a heading or a rule).
func moved(closed []Block, line Line) Decision[Mode, []Block] {
	let d = fromIdle(line)
	match d {
	case Emit[Mode, []Block] as e:
		Emit[Mode, []Block]{Next: e.Next, Output: slices.Concat(closed, e.Output)}
	case Enter[Mode], Stay[Mode], Ignore, Reject, Done[[]Block]:
		Emit[Mode, []Block]{Next: machines.Next(Idle, d), Output: closed}
	}
}

// Open is the open block of m, closed: none when m is Idle.
func Open(m Mode) []Block {
	match m {
	case Idle:
		[]Block{}
	case InPara as p:
		[]Block{Para{Text: strings.Join(p.Lines, "\n")}}
	case InList as l:
		[]Block{List{Ordered: l.Ordered, Start: l.Start, Items: l.Items}}
	case InCode as c:
		[]Block{Code{Info: c.Info, Text: strings.Join(c.Lines, "\n")}}
	}
}

// Read is the blocks of lines: the machine Blocks run to its end, each
// emitted block in order and then the block open at the end.
func Read(lines []string) []Block {
	let mut signals = []Signal{}
	for line in lines {
		signals = signals.Append(Got{Raw: line})
	}
	let o = machines.Run(Blocks{}, signals.Append(End)) catch {
	case machines.Rejected:
		Unreachable("Step never rejects")
	}
	match o {
	case machines.Finished[Mode, []Block] as f:
		let mut doc = []Block{}
		for closed in f.Emitted {
			doc = slices.Concat(doc, closed)
		}
		slices.Concat(doc, f.Output)
	case machines.Running[Mode, []Block]:
		Unreachable("the last signal is End, and Step ends every End with Done")
	}
}

// Lines is the lines of text, without their line feeds; a final line
// feed ends the last line and makes no empty one.
func Lines(text string) []string {
	let parts = strings.Split(text, "\n")
	if len(parts) > 0 && parts[len(parts)-1] == "" {
		return slices.Slice(parts, 0, len(parts)-1)
	}
	parts
}
