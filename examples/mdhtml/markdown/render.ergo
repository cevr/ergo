// The output: the blocks and their inlines as a tree of HTML nodes.

import mdhtml/html
import strings

// Highlighter writes the text of a code block. Whatever it marks up, a
// reader sees the code as it was written.
type Highlighter {
	Highlight(lang string, code string) []html.Node,

	law KeepsTheText(lang string, code string) { TextOfAll(Highlight(lang, code)) == code },
}

// NoColor is the Highlighter that writes the code as text.
type NoColor {}

func Highlight(_ NoColor, lang string, code string) []html.Node { []html.Node{html.Text{S: code}} }

// Keywords is the Highlighter that marks each of Words in a block of
// language Lang as <span class="kw">, and writes other blocks as text.
type Keywords { Lang string, Words []string }

func Highlight(k Keywords, lang string, code string) []html.Node {
	if lang != k.Lang {
		return []html.Node{html.Text{S: code}}
	}
	let mut out = []html.Node{}
	let mut i = 0
	for i < len(code) {
		let start = i
		let word = isWordByte(code[i])
		for i < len(code) && isWordByte(code[i]) == word {
			i += 1
		}
		let piece = strings.Slice(code, start, i)
		if word && oneOf(piece, k.Words) {
			out = out.Append(html.ElAttrs("span", []html.Attr{html.Attr{Name: "class", Value: "kw"}}, []html.Node{html.Text{S: piece}}))
		} else {
			out = out.Append(html.Text{S: piece})
		}
	}
	out
}

func isWordByte(c byte) bool { asciiAlnum(c) || c == '_' }

// GoKeywords are Go's keywords, for a Keywords of language go.
let GoKeywords = []string{"break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"}

// TextOfAll is the text of ns, one after the other.
func TextOfAll(ns []html.Node) string {
	let mut b = strings.NewBuilder()
	for n in ns {
		b.WriteString(html.TextOf(n))
	}
	b.String()
}

// Trust is how far the document's author is trusted: Safe leaves raw
// HTML out and sends a script or data link nowhere, as cmark does by
// default; Unsafe keeps both, as the specification's examples expect.
type Trust = Safe | Unsafe

type Safe {}
type Unsafe {}

// omitted stands for raw HTML a Safe document leaves out.
let omitted = "<!-- raw HTML omitted -->"

// Doc is a read document: its blocks and the inlines of its paragraphs
// and headings.
type Doc { blocks []block, nodes []inline }

// Parse reads the Markdown text src.
func Parse(src string) Doc {
	let mut p = parseBlocks(src)
	let mut q = newInlines(p.refs)
	for id in 0..len(p.blocks) {
		let k = p.blocks[id].kind
		if k == Para || k == Heading {
			p.blocks[id].inlines = parseInlines(&q, p.blocks[id].content)
		}
	}
	Doc{blocks: p.blocks, nodes: q.nodes}
}

// Blocks is how many blocks d holds, the document's own included.
func Blocks(d Doc) int { len(d.blocks) }

// Nodes is the HTML of d.
func Nodes(d Doc, trust Trust) []html.Node needs Highlighter { children(d, trust, 0, false) }

// Render is the HTML of the Markdown text src.
func Render(src string, trust Trust) string needs Highlighter { html.RenderAll(Nodes(Parse(src), trust)) }

func children(d Doc, trust Trust, id int, tight bool) []html.Node needs Highlighter {
	let mut out = []html.Node{}
	let mut k = d.blocks[id].first
	for k >= 0 {
		let b = d.blocks[k]
		if b.kind == Para && tight {
			out = appendInlines(d, trust, out, b.inlines)
		} else {
			out = out.Append(blockNode(d, trust, k))
		}
		k = b.next
	}
	out
}

func url(trust Trust, raw string) html.Url {
	match trust {
	case Safe:
		html.Href(raw)
	case Unsafe:
		html.Trusted(raw)
	}
}

func raw(trust Trust, s string, block bool) html.Node {
	let text = match trust {
	case Safe:
		omitted
	case Unsafe:
		s
	}
	if block { html.RawBlock{S: text} } else { html.Raw{S: text} }
}

func blockNode(d Doc, trust Trust, id int) html.Node needs Highlighter {
	let b = d.blocks[id]
	match b.kind {
	case Quote:
		html.El("blockquote", children(d, trust, id, false))
	case ListBlock:
		let mut items = []html.Node{}
		let mut k = b.first
		for k >= 0 {
			items = items.Append(html.El("li", children(d, trust, k, b.list.tight)))
			k = d.blocks[k].next
		}
		if !b.list.ordered {
			return html.El("ul", items)
		}
		if b.list.start == 1 {
			return html.El("ol", items)
		}
		html.ElAttrs("ol", []html.Attr{html.Attr{Name: "start", Value: "\(b.list.start)"}}, items)
	case Para:
		html.El("p", appendInlines(d, trust, []html.Node{}, b.inlines))
	case Heading:
		html.El("h\(b.level)", appendInlines(d, trust, []html.Node{}, b.inlines))
	case Rule:
		html.El("hr", []html.Node{})
	case Code:
		let mut end = 0
		for end < len(b.info) && !isSpace(b.info[end]) {
			end += 1
		}
		let lang = strings.Slice(b.info, 0, end)
		let attrs = if lang == "" { []html.Attr{} } else { []html.Attr{html.Attr{Name: "class", Value: "language-" + lang}} }
		html.El("pre", []html.Node{html.ElAttrs("code", attrs, Highlighter.Highlight(lang, b.literal))})
	case RawHtml:
		raw(trust, b.literal, true)
	case Document, Item:
		html.El("div", children(d, trust, id, false))
	}
}

func appendInlines(d Doc, trust Trust, out []html.Node, id int) []html.Node {
	let mut all = out
	let mut k = d.nodes[id].first
	for k >= 0 {
		all = all.Append(inlineNode(d, trust, k))
		k = d.nodes[k].next
	}
	all
}

func inlineNode(d Doc, trust Trust, id int) html.Node {
	let n = d.nodes[id]
	match n.kind {
	case Str:
		html.Text{S: n.text}
	case SoftBreak:
		html.Text{S: "\n"}
	case HardBreak:
		html.El("br", []html.Node{})
	case CodeSpan:
		html.El("code", []html.Node{html.Text{S: n.text}})
	case Emph:
		html.El("em", appendInlines(d, trust, []html.Node{}, id))
	case Strong:
		html.El("strong", appendInlines(d, trust, []html.Node{}, id))
	case Link:
		html.A(url(trust, n.dest), n.title, appendInlines(d, trust, []html.Node{}, id))
	case Image:
		let mut alt = strings.NewBuilder()
		plain(d, &alt, id)
		html.Img(url(trust, n.dest), alt.String(), n.title)
	case InlineHtml:
		raw(trust, n.text, false)
	case Root:
		html.El("span", appendInlines(d, trust, []html.Node{}, id))
	}
}

// plain writes the text of the inlines below id, for an image's alt.
func plain(d Doc, b *strings.Builder, id int) {
	let mut k = d.nodes[id].first
	for k >= 0 {
		let n = d.nodes[k]
		match n.kind {
		case Str, CodeSpan, InlineHtml:
			b.WriteString(n.text)
		case SoftBreak, HardBreak:
			b.WriteString("\n")
		case Root, Emph, Strong, Link, Image:
			plain(d, b, k)
		}
		k = n.next
	}
}
