// Entity and numeric character references.

import option
import strings
import utf8
import mdhtml/html

// Entity is a reference as read: its length in the text and the text it
// stands for.
type Entity { Len int, Text string }

// entities is entityTable as a Map from a name to its text.
let entities = loadEntities(entityTable)

// EntitiesAreTheirText: &name; is its text, escaped; &#n; is the
// character n, or U+FFFD for 0, a surrogate or past U+10FFFF.
law EntitiesAreTheirText(pick int, n int) {
	let name = entityNames[index(pick, entityNames.Len())]
	let text = match entities.Get(name) {
	case option.Some as t:
		t.Value
	case option.None:
		""
	}
	let v = index(n, 0x110010)
	let r = if v == 0 || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF) { '\uFFFD' } else { rune(v) }
	let numeric = "<p>" + html.Escape(utf8.RuneText(r)) + "</p>\n"
	md("&"+name+";") == "<p>"+html.Escape(text)+"</p>\n" && md("&#\(v);") == numeric
}

// entityNames is the names of the entity table, in its order.
let entityNames = namesOf(entityTable)

func namesOf(table string) []string {
	let mut out = []string{}
	for entry in strings.Split(table, ",") {
		match strings.Cut(entry, ":") {
		case option.Some as h:
			out = out.Append(h.Value.Before)
		case option.None:
		}
	}
	out
}

func parseEntityCodes(codes string) option.Option[string] {
	let mut b = strings.NewBuilder()
	for code in strings.Split(codes, "+") {
		if code.Len() == 0 || code.Len() > 6 {
			return option.None
		}
		let mut v = 0
		for i in 0..code.Len() {
			if !hexDigit(code[i]) {
				return option.None
			}
			v = v*16 + hexValue(code[i])
		}
		if v > 0x10FFFF {
			return option.None
		}
		b.WriteString(utf8.RuneText(rune(v)))
	}
	option.Some[string]{Value: b.String()}
}

func loadEntities(table string) Map[string, string] {
	let mut m = Map[string, string]{}
	for entry in strings.Split(table, ",") {
		match strings.Cut(entry, ":") {
		case option.Some as h:
			match parseEntityCodes(h.Value.After) {
			case option.Some as text:
				m = m.Put(h.Value.Before, text.Value)
			case option.None:
			}
		case option.None:
		}
	}
	m
}

law EntitiesTableIsValid() {
	entities.Len() == entityNames.Len() && parseEntityCodes("zz") == option.None
}

// EntityAt reads the entity or numeric character reference that s starts
// with: &name; for an HTML5 name, &#digits; or &#xhex;. A number that is
// 0, a surrogate or past U+10FFFF stands for U+FFFD.
func EntityAt(s string) option.Option[Entity] {
	if s.Len() < 3 || s[0] != '&' {
		return option.None
	}
	if s[1] == '#' {
		let mut i = 2
		let hex = i < s.Len() && (s[i] == 'x' || s[i] == 'X')
		if hex {
			i += 1
		}
		let from = i
		let mut v = 0
		for i < s.Len() && (asciiDigit(s[i]) || (hex && hexDigit(s[i]))) && i-from < 8 {
			v = v*(if hex { 16 } else { 10 }) + hexValue(s[i])
			i += 1
		}
		let n = i - from
		if n == 0 || (hex && n > 6) || (!hex && n > 7) || i >= s.Len() || s[i] != ';' {
			return option.None
		}
		let r = if v == 0 || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF) { '\uFFFD' } else { rune(v) }
		return option.Some[Entity]{Value: Entity{Len: i + 1, Text: utf8.RuneText(r)}}
	}
	let mut i = 1
	for i < s.Len() && asciiAlnum(s[i]) && i <= 33 {
		i += 1
	}
	if i-1 < 2 || i-1 > 32 || i >= s.Len() || s[i] != ';' || !asciiLetter(s[1]) {
		return option.None
	}
	match entities.Get(strings.Slice(s, 1, i)) {
	case option.Some as t:
		option.Some[Entity]{Value: Entity{Len: i + 1, Text: t.Value}}
	case option.None:
		option.None
	}
}

func hexValue(c byte) int {
	if c >= '0' && c <= '9' {
		return int(c - '0')
	}
	if c >= 'a' && c <= 'f' {
		return int(c-'a') + 10
	}
	int(c-'A') + 10
}
