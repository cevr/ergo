// Package markdown reads a subset of Markdown: ATX headings, paragraphs,
// bullet and numbered lists, fenced code, rules, and inside a line
// emphasis, strong emphasis, code spans, links and backslash escapes.
// Classify tells what a line is; the machine Blocks gathers lines into
// blocks; Render writes the blocks as HTML. Everything is pure but the
// code blocks, which a Highlighter writes.

import strconv
import strings

// Line is what one line of the source is, read on its own.
type Line =
	| Blank
	| Heading{Level int, Text string}
	| Bullet{Text string}
	| Numbered{N int, Text string}
	| Fence{Info string}
	| Rule
	| Plain{Text string}

type Blank {}
type Rule {}

// Classify is what raw is. A heading is one to six # and a space (or
// nothing); a bullet starts "- ", "* " or "+ "; a numbered item is
// digits, "." and a space; a fence starts with three back quotes; a rule
// is three or more -, * or _ and nothing else but spaces.
func Classify(raw string) Line {
	let s = strings.TrimSpace(raw)
	if s == "" {
		return Blank
	}
	if strings.HasPrefix(s, "```") {
		return Fence{Info: strings.TrimSpace(strings.Slice(s, 3, len(s)))}
	}
	if isRule(s) {
		return Rule
	}
	let hashes = run(s, '#')
	if hashes >= 1 && hashes <= 6 && (hashes == len(s) || s[hashes] == ' ') {
		return Heading{Level: hashes, Text: strings.TrimSpace(strings.Slice(s, hashes, len(s)))}
	}
	for p in []string{"- ", "* ", "+ "} {
		if strings.HasPrefix(s, p) {
			return Bullet{Text: strings.TrimSpace(strings.Slice(s, 2, len(s)))}
		}
	}
	let digits = digitRun(s)
	if digits >= 1 && digits <= 9 && digits+1 < len(s) && s[digits] == '.' && s[digits+1] == ' ' {
		let n = strconv.Atoi(strings.Slice(s, 0, digits)) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return Plain{Text: s}
		}
		return Numbered{N: n, Text: strings.TrimSpace(strings.Slice(s, digits+2, len(s)))}
	}
	Plain{Text: s}
}

// run is how many c start s.
func run(s string, c byte) int {
	let mut n = 0
	for n < len(s) && s[n] == c {
		n += 1
	}
	n
}

func digitRun(s string) int {
	let mut n = 0
	for n < len(s) && s[n] >= '0' && s[n] <= '9' {
		n += 1
	}
	n
}

// isRule reports whether s is three or more of one of -, * and _, with
// spaces between them.
func isRule(s string) bool {
	let c = s[0]
	if c != '-' && c != '*' && c != '_' {
		return false
	}
	let mut n = 0
	for i in 0..len(s) {
		if s[i] == c {
			n += 1
		} else if s[i] != ' ' {
			return false
		}
	}
	n >= 3
}
