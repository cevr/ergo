// The inline phase: the text of a paragraph or a heading into a tree of
// inlines, held in one slice and linked by ids, with CommonMark's
// delimiter stack for emphasis and its bracket stack for links.

import go unicode
import option
import slices
import strings
import utf8

// IKind is what an inline is.
type IKind = Root | Str | SoftBreak | HardBreak | CodeSpan | Emph | Strong | Link | Image | InlineHtml

type Root {}
type Str {}
type SoftBreak {}
type HardBreak {}
type CodeSpan {}
type Emph {}
type Strong {}
type Link {}
type Image {}
type InlineHtml {}

// inline is an inline and its links, each an id or -1. text is a
// string's, a code span's or raw HTML's literal.
type inline {
	kind   IKind,
	text   string,
	dest   string,
	title  string,
	parent int,
	first  int,
	last   int,
	prev   int,
	next   int,
}

// delim is a run of * or _ on the delimiter stack: how many are left of
// how many it had, its text node, its neighbours, and what it may do.
type delim {
	cc       byte,
	num      int,
	orig     int,
	node     int,
	prev     int,
	next     int,
	canOpen  bool,
	canClose bool,
}

// bracket is a [ or ![ that may open a link or an image.
type bracket {
	node         int,
	prevDelim    int,
	index        int,
	image        bool,
	active       bool,
	bracketAfter bool,
}

// inlines is the inline parser: the text, where it is, the inlines of
// every block so far, and the two stacks.
type inlines {
	subject  string,
	pos      int,
	nodes    []inline,
	delims   []delim,
	top      int,
	brackets []bracket,
	refs     Map[string, Ref],
}

func newInlines(refs Map[string, Ref]) inlines {
	inlines{subject: "", pos: 0, nodes: []inline{}, delims: []delim{}, top: -1, brackets: []bracket{}, refs: refs}
}

func newNode(q mut inlines, k IKind, s string) int {
	q.nodes = q.nodes.Append(inline{kind: k, text: s, dest: "", title: "", parent: -1, first: -1, last: -1, prev: -1, next: -1})
	q.nodes.Len() - 1
}

func appendInline(q mut inlines, parent int, child int) {
	let prev = q.nodes[parent].last
	q.nodes[child].parent = parent
	q.nodes[child].prev = prev
	q.nodes[child].next = -1
	if prev >= 0 {
		q.nodes[prev].next = child
	} else {
		q.nodes[parent].first = child
	}
	q.nodes[parent].last = child
}

func unlinkInline(q mut inlines, id int) {
	let n = q.nodes[id]
	if n.prev >= 0 {
		q.nodes[n.prev].next = n.next
	} else if n.parent >= 0 {
		q.nodes[n.parent].first = n.next
	}
	if n.next >= 0 {
		q.nodes[n.next].prev = n.prev
	} else if n.parent >= 0 {
		q.nodes[n.parent].last = n.prev
	}
	q.nodes[id].parent = -1
	q.nodes[id].prev = -1
	q.nodes[id].next = -1
}

// insertAfter puts the unlinked inline id right after at.
func insertAfter(q mut inlines, at int, id int) {
	let next = q.nodes[at].next
	let parent = q.nodes[at].parent
	q.nodes[id].parent = parent
	q.nodes[id].prev = at
	q.nodes[id].next = next
	q.nodes[at].next = id
	if next >= 0 {
		q.nodes[next].prev = id
	} else if parent >= 0 {
		q.nodes[parent].last = id
	}
}

func addText(q mut inlines, parent int, s string) { appendInline(q, parent, newNode(q, Str, s)) }

func peek(q mut inlines) int {
	if q.pos < q.subject.Len() { int(q.subject[q.pos]) } else { -1 }
}

// parseInlines reads content's inlines under a new root, and is the root.
func parseInlines(q mut inlines, content string) int {
	q.subject = trimSpace(content)
	q.pos = 0
	q.delims = []delim{}
	q.top = -1
	q.brackets = []bracket{}
	let root = newNode(q, Root, "")
	for parseInline(q, root) {
	}
	processEmphasis(q, -1)
	root
}

func parseInline(q mut inlines, root int) bool {
	let c = peek(q)
	if c == -1 {
		return false
	}
	let mut ok = true
	if c == '\n' {
		newline(q, root)
	} else if c == '\\' {
		backslash(q, root)
	} else if c == '`' {
		backticks(q, root)
	} else if c == '*' || c == '_' {
		handleDelim(q, byte(c), root)
	} else if c == '[' {
		q.pos += 1
		let id = newNode(q, Str, "[")
		appendInline(q, root, id)
		addBracket(q, id, q.pos-1, false)
	} else if c == '!' {
		q.pos += 1
		if peek(q) == '[' {
			q.pos += 1
			let id = newNode(q, Str, "![")
			appendInline(q, root, id)
			addBracket(q, id, q.pos-1, true)
		} else {
			addText(q, root, "!")
		}
	} else if c == ']' {
		closeBracket(q, root)
	} else if c == '<' {
		ok = autolink(q, root) || htmlInline(q, root)
	} else if c == '&' {
		ok = entityInline(q, root)
	} else {
		ok = plainRun(q, root)
	}
	if !ok {
		q.pos += 1
		addText(q, root, strings.Slice(q.subject, q.pos-1, q.pos))
	}
	true
}

func special(c byte) bool {
	c == '\n' || c == '`' || c == '[' || c == ']' || c == '\\' || c == '!' || c == '<' || c == '&' || c == '*' || c == '_' || c == '\'' || c == '"'
}

func plainRun(q mut inlines, root int) bool {
	let start = q.pos
	for q.pos < q.subject.Len() && !special(q.subject[q.pos]) {
		q.pos += 1
	}
	if q.pos == start {
		return false
	}
	addText(q, root, strings.Slice(q.subject, start, q.pos))
	true
}

func newline(q mut inlines, root int) {
	q.pos += 1
	let last = q.nodes[root].last
	if last >= 0 && q.nodes[last].kind == Str && strings.HasSuffix(q.nodes[last].text, " ") {
		let t = q.nodes[last].text
		let hard = t.Len() >= 2 && t[t.Len()-2] == ' '
		q.nodes[last].text = strings.TrimRight(t, " ")
		appendInline(q, root, newNode(q, if hard { HardBreak } else { SoftBreak }, ""))
	} else {
		appendInline(q, root, newNode(q, SoftBreak, ""))
	}
	for peek(q) == ' ' {
		q.pos += 1
	}
}

// Escapable says whether a backslash makes c itself: ASCII punctuation.
func Escapable(c byte) bool {
	(c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~')
}

func backslash(q mut inlines, root int) {
	q.pos += 1
	let c = peek(q)
	if c == '\n' {
		q.pos += 1
		appendInline(q, root, newNode(q, HardBreak, ""))
	} else if c >= 0 && Escapable(byte(c)) {
		addText(q, root, strings.Slice(q.subject, q.pos, q.pos+1))
		q.pos += 1
	} else {
		addText(q, root, "\\")
	}
}

func backticks(q mut inlines, root int) {
	let start = q.pos
	for peek(q) == '`' {
		q.pos += 1
	}
	let ticks = q.pos - start
	let after = q.pos
	for q.pos < q.subject.Len() {
		if q.subject[q.pos] != '`' {
			q.pos += 1
			continue
		}
		let run = q.pos
		for peek(q) == '`' {
			q.pos += 1
		}
		if q.pos-run == ticks {
			let mut contents = strings.ReplaceAll(strings.Slice(q.subject, after, run), "\n", " ")
			if contents.Len() >= 2 && contents[0] == ' ' && contents[contents.Len()-1] == ' ' && strings.TrimLeft(contents, " ") != "" {
				contents = strings.Slice(contents, 1, contents.Len()-1)
			}
			appendInline(q, root, newNode(q, CodeSpan, contents))
			return
		}
	}
	q.pos = after
	addText(q, root, strings.Slice(q.subject, start, after))
}

// runeBefore and runeAfter are the characters around a delimiter run; a
// line ending stands for the start or the end of the text.
func runeBefore(s string, i int) rune {
	if i == 0 {
		return '\n'
	}
	let mut from = i - 1
	for from > 0 && from > i-4 && s[from] >= 0x80 && s[from] < 0xC0 {
		from -= 1
	}
	let d = utf8.DecodeRuneInString(strings.Slice(s, from, i))
	if d.Size == i-from { d.Rune } else { '\uFFFD' }
}

func runeAfter(s string, i int) rune {
	if i >= s.Len() {
		return '\n'
	}
	utf8.DecodeRuneInString(strings.Slice(s, i, s.Len())).Rune
}

// UnicodeSpace is CommonMark's Unicode whitespace: Zs, tab, line feed,
// form feed, carriage return.
func UnicodeSpace(r rune) bool {
	r == ' ' || r == '\t' || r == '\n' || r == '\f' || r == '\r' || r == '\u00A0' || r == '\u1680' || r == '\u202F' || r == '\u205F' || r == '\u3000' || (r >= '\u2000' && r <= '\u200A')
}

// Punctuation is CommonMark's Unicode punctuation: categories P and S.
func Punctuation(r rune) bool { unicode.IsPunct(r) || unicode.IsSymbol(r) }

// Flanks is what a run of * or _ may do, from the characters around it.
type Flanks { Open bool, Close bool }

// Flanking is CommonMark's rule for a delimiter run of cc between the
// characters before and after: a left-flanking run may open, a right-
// flanking one may close, and _ inside a word does neither.
func Flanking(cc byte, before rune, after rune) Flanks {
	let afterSpace = UnicodeSpace(after)
	let afterPunct = Punctuation(after)
	let beforeSpace = UnicodeSpace(before)
	let beforePunct = Punctuation(before)
	let left = !afterSpace && (!afterPunct || beforeSpace || beforePunct)
	let right = !beforeSpace && (!beforePunct || afterSpace || afterPunct)
	if cc == '_' {
		return Flanks{Open: left && (!right || beforePunct), Close: right && (!left || afterPunct)}
	}
	Flanks{Open: left, Close: right}
}

func handleDelim(q mut inlines, cc byte, root int) {
	let start = q.pos
	for peek(q) == int(cc) {
		q.pos += 1
	}
	let n = q.pos - start
	let f = Flanking(cc, runeBefore(q.subject, start), runeAfter(q.subject, q.pos))
	let id = newNode(q, Str, strings.Slice(q.subject, start, q.pos))
	appendInline(q, root, id)
	if f.Open || f.Close {
		q.delims = q.delims.Append(delim{cc: cc, num: n, orig: n, node: id, prev: q.top, next: -1, canOpen: f.Open, canClose: f.Close})
		let d = q.delims.Len() - 1
		if q.top >= 0 {
			q.delims[q.top].next = d
		}
		q.top = d
	}
}

func removeDelim(q mut inlines, d int) {
	let x = q.delims[d]
	if x.prev >= 0 {
		q.delims[x.prev].next = x.next
	}
	if x.next < 0 {
		q.top = x.prev
	} else {
		q.delims[x.next].prev = x.prev
	}
}

// processEmphasis matches the closers above bottom with their openers,
// as CommonMark's "process emphasis" does.
func processEmphasis(q mut inlines, bottom int) {
	let mut openersBottom = slices.Repeat([]int{bottom}, 12)
	let mut closer = q.top
	for closer >= 0 && q.delims[closer].prev != bottom {
		closer = q.delims[closer].prev
	}
	for closer >= 0 {
		let c = q.delims[closer]
		if !c.canClose {
			closer = c.next
			continue
		}
		let idx = c.orig%3 + (if c.canOpen { 3 } else { 0 }) + (if c.cc == '*' { 6 } else { 0 })
		let mut opener = c.prev
		let mut found = false
		for opener >= 0 && opener != bottom && opener != openersBottom[idx] {
			let o = q.delims[opener]
			let odd = (c.canOpen || o.canClose) && c.orig%3 != 0 && (o.orig+c.orig)%3 == 0
			if o.cc == c.cc && o.canOpen && !odd {
				found = true
				break
			}
			opener = o.prev
		}
		let old = closer
		if !found {
			closer = c.next
			openersBottom[idx] = q.delims[old].prev
			if !q.delims[old].canOpen {
				removeDelim(q, old)
			}
			continue
		}
		let use = if c.num >= 2 && q.delims[opener].num >= 2 { 2 } else { 1 }
		let on = q.delims[opener].node
		let cn = c.node
		q.delims[opener].num -= use
		q.delims[closer].num -= use
		q.nodes[on].text = strings.Slice(q.nodes[on].text, 0, q.nodes[on].text.Len()-use)
		q.nodes[cn].text = strings.Slice(q.nodes[cn].text, 0, q.nodes[cn].text.Len()-use)
		let emph = newNode(q, if use == 2 { Strong } else { Emph }, "")
		let mut t = q.nodes[on].next
		for t >= 0 && t != cn {
			let next = q.nodes[t].next
			unlinkInline(q, t)
			appendInline(q, emph, t)
			t = next
		}
		insertAfter(q, on, emph)
		if q.delims[opener].next != closer {
			q.delims[opener].next = closer
			q.delims[closer].prev = opener
		}
		if q.delims[opener].num == 0 {
			unlinkInline(q, on)
			removeDelim(q, opener)
		}
		if q.delims[closer].num == 0 {
			unlinkInline(q, cn)
			let next = q.delims[closer].next
			removeDelim(q, closer)
			closer = next
		}
	}
	for q.top >= 0 && q.top != bottom {
		removeDelim(q, q.top)
	}
}

func addBracket(q mut inlines, node int, index int, image bool) {
	let n = q.brackets.Len()
	if n > 0 {
		q.brackets[n-1].bracketAfter = true
	}
	q.brackets = q.brackets.Append(bracket{node: node, prevDelim: q.top, index: index, image: image, active: true, bracketAfter: false})
}

func popBracket(q mut inlines) { q.brackets = slices.Slice(q.brackets, 0, q.brackets.Len()-1) }

// Target is a link's destination and title.
type Target { Dest string, Title string }

// inlineTarget reads (destination "title") after a ], if it is there.
func inlineTarget(q mut inlines) option.Option[Target] {
	if peek(q) != '(' {
		return option.None
	}
	let save = q.pos
	q.pos += 1
	spnl(q)
	match linkDestination(q) {
	case option.Some as d:
		spnl(q)
		let mut title = ""
		if q.pos > 0 && isSpace(q.subject[q.pos-1]) {
			match linkTitle(q) {
			case option.Some as t:
				title = t.Value
			case option.None:
			}
		}
		spnl(q)
		if peek(q) == ')' {
			q.pos += 1
			return option.Some[Target]{Value: Target{Dest: d.Value, Title: title}}
		}
	case option.None:
	}
	q.pos = save
	option.None
}

func closeBracket(q mut inlines, root int) {
	q.pos += 1
	let start = q.pos
	if q.brackets.Len() == 0 {
		addText(q, root, "]")
		return
	}
	let opener = q.brackets[q.brackets.Len()-1]
	if !opener.active {
		addText(q, root, "]")
		popBracket(q)
		return
	}
	let save = q.pos
	let mut target = inlineTarget(q)
	if target == option.None {
		let before = q.pos
		let n = linkLabel(q)
		let label = if n > 2 { strings.Slice(q.subject, before, before+n) } else if !opener.bracketAfter { strings.Slice(q.subject, opener.index, start) } else { "" }
		if n == 0 {
			q.pos = save
		}
		if label != "" {
			match q.refs.Get(NormalizeLabel(label)) {
			case option.Some as r:
				target = option.Some[Target]{Value: Target{Dest: r.Value.Dest, Title: r.Value.Title}}
			case option.None:
			}
		}
	}
	match target {
	case option.None:
		popBracket(q)
		q.pos = start
		addText(q, root, "]")
	case option.Some as t:
		let link = newNode(q, if opener.image { Image } else { Link }, "")
		q.nodes[link].dest = t.Value.Dest
		q.nodes[link].title = t.Value.Title
		let mut k = q.nodes[opener.node].next
		for k >= 0 {
			let next = q.nodes[k].next
			unlinkInline(q, k)
			appendInline(q, link, k)
			k = next
		}
		appendInline(q, root, link)
		processEmphasis(q, opener.prevDelim)
		popBracket(q)
		unlinkInline(q, opener.node)
		if !opener.image {
			for i in 0..q.brackets.Len() {
				if !q.brackets[i].image {
					q.brackets[i].active = false
				}
			}
		}
	}
}

// spnl moves past spaces and tabs, at most one line ending, and spaces
// and tabs.
func spnl(q mut inlines) {
	for peek(q) == ' ' || peek(q) == '\t' {
		q.pos += 1
	}
	if peek(q) == '\n' {
		q.pos += 1
		for peek(q) == ' ' || peek(q) == '\t' {
			q.pos += 1
		}
	}
}

// linkDestination reads a link destination: <…>, or a run with balanced
// parentheses and no space.
func linkDestination(q mut inlines) option.Option[string] {
	let s = q.subject
	if peek(q) == '<' {
		let mut i = q.pos + 1
		for i < s.Len() {
			let c = s[i]
			if c == '\\' && i+1 < s.Len() && Escapable(s[i+1]) {
				i += 2
				continue
			}
			if c == '>' {
				let d = NormalizeURI(UnescapeString(strings.Slice(s, q.pos+1, i)))
				q.pos = i + 1
				return option.Some[string]{Value: d}
			}
			if c == '<' || c == '\n' {
				return option.None
			}
			i += 1
		}
		return option.None
	}
	let start = q.pos
	let mut open = 0
	for q.pos < s.Len() {
		let c = s[q.pos]
		if c == '\\' && q.pos+1 < s.Len() && Escapable(s[q.pos+1]) {
			q.pos += 2
		} else if c == '(' {
			q.pos += 1
			open += 1
		} else if c == ')' {
			if open < 1 {
				break
			}
			q.pos += 1
			open -= 1
		} else if isSpace(c) {
			break
		} else {
			q.pos += 1
		}
	}
	if q.pos == start && peek(q) != ')' {
		return option.None
	}
	if open != 0 {
		q.pos = start
		return option.None
	}
	option.Some[string]{Value: NormalizeURI(UnescapeString(strings.Slice(s, start, q.pos)))}
}

// linkTitle reads a link title in "", '' or ().
func linkTitle(q mut inlines) option.Option[string] {
	let s = q.subject
	if q.pos >= s.Len() {
		return option.None
	}
	let opening = s[q.pos]
	if opening != '"' && opening != '\'' && opening != '(' {
		return option.None
	}
	let closing = if opening == '(' { byte(')') } else { opening }
	let mut i = q.pos + 1
	for i < s.Len() {
		let c = s[i]
		if c == '\\' && i+1 < s.Len() {
			i += 2
			continue
		}
		if c == closing {
			let t = UnescapeString(strings.Slice(s, q.pos+1, i))
			q.pos = i + 1
			return option.Some[string]{Value: t}
		}
		if opening == '(' && c == '(' {
			return option.None
		}
		i += 1
	}
	option.None
}

// linkLabel is the length of the link label at the position, or 0: [ ]
// around at most 999 characters, with no unescaped bracket.
func linkLabel(q mut inlines) int {
	let s = q.subject
	if peek(q) != '[' {
		return 0
	}
	let start = q.pos
	let mut i = start + 1
	let mut n = 0
	for i < s.Len() && n <= 1000 {
		let c = s[i]
		if c == ']' {
			let length = i + 1 - start
			if length > 1001 {
				return 0
			}
			q.pos = i + 1
			return length
		}
		if c == '[' {
			return 0
		}
		i += if c == '\\' && i+1 < s.Len() { 2 } else { 1 }
		n += 1
	}
	0
}

// NormalizeLabel is a link label's key: the text inside the brackets,
// trimmed, its whitespace runs one space, case folded.
func NormalizeLabel(label string) string {
	let s = trimSpace(strings.Slice(label, 1, label.Len()-1))
	let mut b = strings.NewBuilder()
	let mut space = false
	for i in 0..s.Len() {
		let c = s[i]
		if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
			space = true
			continue
		}
		if space {
			b.WriteByte(' ')
			space = false
		}
		b.WriteByte(c)
	}
	strings.ReplaceAll(strings.ToUpper(strings.ToLower(b.String())), "ß", "SS")
}

func autolink(q mut inlines, root int) bool {
	let s = strings.Slice(q.subject, q.pos, q.subject.Len())
	let e = emailAutolink(s)
	if e > 0 {
		let addr = strings.Slice(s, 1, e-1)
		let link = newNode(q, Link, "")
		q.nodes[link].dest = NormalizeURI("mailto:" + addr)
		appendInline(q, root, link)
		addText(q, link, addr)
		q.pos += e
		return true
	}
	let u = uriAutolink(s)
	if u > 0 {
		let uri = strings.Slice(s, 1, u-1)
		let link = newNode(q, Link, "")
		q.nodes[link].dest = NormalizeURI(uri)
		appendInline(q, root, link)
		addText(q, link, uri)
		q.pos += u
		return true
	}
	false
}

// uriAutolink is the length of <scheme:rest> at the start of s, or 0.
func uriAutolink(s string) int {
	if s.Len() < 4 || s[0] != '<' || !asciiLetter(s[1]) {
		return 0
	}
	let mut i = 2
	for i < s.Len() && (asciiAlnum(s[i]) || s[i] == '.' || s[i] == '+' || s[i] == '-') {
		i += 1
	}
	if i-1 < 2 || i-1 > 32 || i >= s.Len() || s[i] != ':' {
		return 0
	}
	i += 1
	for i < s.Len() {
		let c = s[i]
		if c == '>' {
			return i + 1
		}
		if c == '<' || c <= ' ' {
			return 0
		}
		i += 1
	}
	0
}

func localByte(c byte) bool {
	asciiAlnum(c) || c == '.' || c == '!' || c == '#' || c == '$' || c == '%' || c == '&' || c == '\'' || c == '*' || c == '+' || c == '/' || c == '=' || c == '?' || c == '^' || c == '_' || c == '`' || c == '{' || c == '|' || c == '}' || c == '~' || c == '-'
}

// emailAutolink is the length of <address> at the start of s, or 0.
func emailAutolink(s string) int {
	if s.Len() < 3 || s[0] != '<' {
		return 0
	}
	let mut i = 1
	for i < s.Len() && localByte(s[i]) {
		i += 1
	}
	if i == 1 || i >= s.Len() || s[i] != '@' {
		return 0
	}
	i += 1
	for {
		if i >= s.Len() || !asciiAlnum(s[i]) {
			return 0
		}
		let mut j = i + 1
		for j < s.Len() && (asciiAlnum(s[j]) || s[j] == '-') && j-i < 63 {
			j += 1
		}
		for j > i+1 && s[j-1] == '-' {
			j -= 1
		}
		i = j
		if i < s.Len() && s[i] == '.' {
			i += 1
			continue
		}
		break
	}
	if i < s.Len() && s[i] == '>' { i + 1 } else { 0 }
}

func htmlInline(q mut inlines, root int) bool {
	let n = HtmlTag(strings.Slice(q.subject, q.pos, q.subject.Len()))
	if n == 0 {
		return false
	}
	appendInline(q, root, newNode(q, InlineHtml, strings.Slice(q.subject, q.pos, q.pos+n)))
	q.pos += n
	true
}

func entityInline(q mut inlines, root int) bool {
	match EntityAt(strings.Slice(q.subject, q.pos, q.subject.Len())) {
	case option.Some as e:
		addText(q, root, e.Value.Text)
		q.pos += e.Value.Len
		true
	case option.None:
		false
	}
}

// UnescapeString is s with its backslash escapes and references read.
func UnescapeString(s string) string {
	if !strings.Contains(s, "\\") && !strings.Contains(s, "&") {
		return s
	}
	let mut b = strings.NewBuilder()
	let mut i = 0
	for i < s.Len() {
		let c = s[i]
		if c == '\\' && i+1 < s.Len() && Escapable(s[i+1]) {
			b.WriteByte(s[i+1])
			i += 2
			continue
		}
		if c == '&' {
			match EntityAt(strings.Slice(s, i, s.Len())) {
			case option.Some as e:
				b.WriteString(e.Value.Text)
				i += e.Value.Len
				continue
			case option.None:
			}
		}
		b.WriteByte(c)
		i += 1
	}
	b.String()
}

let hexDigits = "0123456789ABCDEF"

// NormalizeURI percent-encodes what a URL may not hold, keeping %XX.
func NormalizeURI(s string) string {
	let mut b = strings.NewBuilder()
	let mut i = 0
	for i < s.Len() {
		let c = s[i]
		if asciiAlnum(c) || urlByte(c) {
			b.WriteByte(c)
		} else if c == '%' && i+2 < s.Len() && hexDigit(s[i+1]) && hexDigit(s[i+2]) {
			b.WriteString(strings.Slice(s, i, i+3))
			i += 2
		} else {
			b.WriteByte('%')
			b.WriteByte(hexDigits[int(c>>4)])
			b.WriteByte(hexDigits[int(c&15)])
		}
		i += 1
	}
	b.String()
}

// urlByte is a byte of ;/?:@&=+$,-_.!~*'()# that a URL keeps.
func urlByte(c byte) bool {
	c == ';' || c == '/' || c == '?' || c == ':' || c == '@' || c == '&' || c == '=' || c == '+' || c == '$' || c == ',' || c == '-' || c == '_' || c == '.' || c == '!' || c == '~' || c == '*' || c == '\'' || c == '(' || c == ')' || c == '#'
}

func hexDigit(c byte) bool { asciiDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') }

// Def is a link reference definition as read: its length, its key and
// what it names.
type Def { Len int, Key string, Ref Ref }

// ParseReference reads the link reference definition that s starts
// with, if it is one.
func ParseReference(s string) option.Option[Def] {
	let mut q = newInlines(Map[string, Ref]{})
	q.subject = s
	let n = linkLabel(&q)
	if n == 0 {
		return option.None
	}
	let raw = strings.Slice(s, 0, n)
	if peek(&q) != ':' {
		return option.None
	}
	q.pos += 1
	spnl(&q)
	match linkDestination(&q) {
	case option.None:
		option.None
	case option.Some as d:
		let beforeTitle = q.pos
		spnl(&q)
		let mut title option.Option[string] = option.None
		if q.pos != beforeTitle {
			title = linkTitle(&q)
		}
		if title == option.None {
			q.pos = beforeTitle
		}
		if !lineEnd(&q) {
			if title == option.None {
				return option.None
			}
			title = option.None
			q.pos = beforeTitle
			if !lineEnd(&q) {
				return option.None
			}
		}
		let key = NormalizeLabel(raw)
		if key == "" {
			return option.None
		}
		let t = match title {
		case option.Some as v:
			v.Value
		case option.None:
			""
		}
		option.Some[Def]{Value: Def{Len: q.pos, Key: key, Ref: Ref{Dest: d.Value, Title: t}}}
	}
}

// lineEnd moves past spaces and tabs and a line ending, or says there is
// more on the line.
func lineEnd(q mut inlines) bool {
	let mut i = q.pos
	for i < q.subject.Len() && (q.subject[i] == ' ' || q.subject[i] == '\t') {
		i += 1
	}
	if i < q.subject.Len() && q.subject[i] != '\n' {
		return false
	}
	q.pos = if i < q.subject.Len() { i + 1 } else { i }
	true
}
