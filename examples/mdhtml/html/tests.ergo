// The tree's tests, and its laws restated as property tests over
// generated strings (#162 runs laws).

import strings

test RenderEscapesByType {
	let n = El("p", []Node{Text{S: "a < b & \"c\""}, El("em", []Node{Text{S: "it's"}})})
	assert Render(n) == "<p>a &lt; b &amp; &quot;c&quot;<em>it&#39;s</em></p>"
	assert Render(El("hr", []Node{})) == "<hr>"
	assert TextOf(n) == "a < b & \"c\"it's"
}

test AttributesAreEscapedAndLinksTakeAUrl {
	let n = ElAttrs("code", []Attr{Attr{Name: "class", Value: "x\"><script>"}, Attr{Name: "href", Value: "javascript:alert(1)"}}, []Node{})
	assert Render(n) == "<code class=\"x&quot;&gt;&lt;script&gt;\"></code>"
	assert Render(A(Href("https://go.dev/?a=1&b=2"), []Node{Text{S: "go"}})) == "<a href=\"https://go.dev/?a=1&amp;b=2\">go</a>"
}

test HrefKeepsOnlySafeSchemes {
	assert HrefOf(Href(" docs/a.html ")) == "docs/a.html"
	assert HrefOf(Href("HTTPS://x")) == "HTTPS://x"
	assert HrefOf(Href("mailto:a@b")) == "mailto:a@b"
	assert HrefOf(Href("JavaScript:alert(1)")) == "#"
	assert HrefOf(Href("data:text/html,x")) == "#"
	assert HrefOf(Href("a/b:c")) == "a/b:c"
}

test EscapeRoundTripHolds(s string) {
	assert Unescape(Escape(s)) == s
	assert Unescape(Escape("&amp;"+s)) == "&amp;"+s
}

test EscapeHasNoMarkupHolds(s string) {
	let e = Escape(s + "<>\"'")
	assert !strings.Contains(e, "<") && !strings.Contains(e, ">") && !strings.Contains(e, "\"") && !strings.Contains(e, "'")
}

test TextSurvivesRenderingHolds(words []string) {
	let mut kids = []Node{}
	for w in words {
		kids = kids.Append(El("em", []Node{Text{S: w + "<b>&"}}))
	}
	let n = El("p", kids)
	assert Unescape(stripTags(Render(n))) == TextOf(n)
}

test HrefIsSafeHolds(raw string, scheme int) {
	let schemes = []string{"javascript:", "JAVASCRIPT:", "data:", "http:", "vbscript:", "", "a/", " javascript:"}
	let pick = if scheme < 0 { -(scheme + 1) } else { scheme }
	assert SafeScheme(HrefOf(Href(schemes[pick%len(schemes)] + raw)))
	assert SafeScheme(HrefOf(Href(raw)))
}
