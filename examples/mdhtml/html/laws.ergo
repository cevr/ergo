// The rules of the tree's text as laws.

import strings

// EscapeRoundTrip: Unescape reads back what Escape wrote.
law EscapeRoundTrip(s string) { Unescape(Escape(s)) == s }

// EscapeHasNoMarkup: escaped text starts no tag and ends no attribute.
law EscapeHasNoMarkup(s string) {
	let e = Escape(s)
	!strings.Contains(e, "<") && !strings.Contains(e, ">") && !strings.Contains(e, "\"")
}

// TextSurvivesRendering: the text of a node, rendered and unescaped
// without its tags and line breaks, is the node's text; markup never eats
// text.
law TextSurvivesRendering(words []string) {
	let mut kids = []Node{}
	for w in words {
		let clean = strings.ReplaceAll(w, "\n", " ")
		kids = kids.Append(El("em", []Node{Text{S: clean}}))
		kids = kids.Append(El("br", []Node{}))
	}
	let n = El("blockquote", []Node{El("p", kids)})
	Unescape(strings.ReplaceAll(stripTags(Render(n)), "\n", "")) == TextOf(n)
}

// HrefIsSafe: a Url from Href never names the scheme javascript:,
// vbscript: or file:, nor data: other than an image. The raw text starts
// with a scheme picked from a list half the time: generated strings
// rarely spell one.
law HrefIsSafe(raw string, scheme int) {
	let schemes = []string{"javascript:", "JAVASCRIPT:", "data:", "http:", "vbscript:", "", "File:", "data:image/png", "data:image/svg", "data:text/html,"}
	let pick = if scheme < 0 { -(scheme + 1) } else { scheme }
	SafeScheme(HrefOf(Href(schemes[pick%len(schemes)]+raw))) && SafeScheme(HrefOf(Href(raw)))
}

// SafeScheme reports whether href runs no script and loads no data other
// than an image.
func SafeScheme(href string) bool {
	let l = strings.ToLower(href)
	if strings.HasPrefix(l, "data:") {
		return strings.HasPrefix(l, "data:image/png") || strings.HasPrefix(l, "data:image/gif") || strings.HasPrefix(l, "data:image/jpeg") || strings.HasPrefix(l, "data:image/webp")
	}
	!strings.HasPrefix(l, "javascript:") && !strings.HasPrefix(l, "vbscript:") && !strings.HasPrefix(l, "file:")
}

// stripTags is html with every <…> removed. Rendered text holds no < or
// > of its own, since Escape wrote them as references.
func stripTags(html string) string {
	let mut out = strings.NewBuilder()
	let mut inTag = false
	for i in 0..len(html) {
		let c = html[i]
		if c == '<' {
			inTag = true
		} else if c == '>' {
			inTag = false
		} else if !inTag {
			out.WriteByte(c)
		}
	}
	out.String()
}
