import particles/sim
import sync

// Tape is a sim.Screen that keeps every frame it is shown, in order. Its
// frames are in a sync.Ref, so every copy of a Tape is the same tape.
type Tape { frames sync.Ref[[]sim.Frame] }

// NewTape is an empty Tape.
func NewTape() Tape { Tape{frames: sync.NewRef[[]sim.Frame]([]sim.Frame{})} }

// Show adds f at the end of t.
func Show(t Tape, f sim.Frame) {
	t.frames.Update(func(fs []sim.Frame) []sim.Frame { fs.Append(f) })
}

// Shown is the number of frames t has shown.
func Shown(t Tape) int { len(t.frames.Get()) }

// Frames is the frames of t, in the order they were shown.
func Frames(t Tape) []sim.Frame { t.frames.Get() }
