// The rules of the game as laws over its machine and its loop.

import gen
import particles/record
import particles/world
import rand
import time

// box is a box of 3 to 20 columns from a seed, for tests.
func box(seed uint64, n int) world.World {
	let count = if n < 0 { -(n % 9) } else { n % 9 }
	with context { Random: rand.Seeded(seed) } { world.Spawn(12, 5, count, 0) } catch {
	case world.BadSize, world.BadLoss, world.TooMany:
		world.Blank()
	}
}

func drawnBox() world.World needs gen.Draws {
	let count = gen.Named("particles", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 8) })
	let s0 = gen.Below(uint64(0))
	with context { Random: rand.Seeded(s0) } { world.Spawn(12, 5, count, 0) } catch {
	case world.BadSize, world.BadLoss, world.TooMany:
		world.Blank()
	}
}

// StepsFollowTheClock: with no key, the loop steps the box once per Dt of
// the time that passed, whatever each frame took: the steps are the
// elapsed time over Dt, rounded down.
law StepsFollowTheClock() {
	assert gen.Report(gen.Check(gen.Defaults(), func() bool fails gen.Rejected needs gen.Draws {
		let w = drawnBox()
		let k = gen.Named("frames", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(0, 19) })
		let m = time.NewManual(0)
		let g = with context { Scheduler: lateEvery{m: m, every: 3}, time.Clock: m, Screen: recorded() } {
			Play(w, "", k, Pace{Frame: 50ms, Dt: 20ms})
		}
		g.Steps == time.Count(m.Now().Sub(time.Unix(0, 0)), 20ms)
	})) == ""
	true
}

// lateEvery is a Scheduler that sleeps on m with no wait, and a quarter
// longer on each every-th sleep, as a late frame does.
type lateEvery { m time.Manual, every int } implements Scheduler

func Sleep(l lateEvery, d duration) {
	let n = time.Count(l.m.Now().Sub(time.Unix(0, 0)), d)
	let late = if n%l.every == l.every-1 { time.Divide(d, 4) } else { 0s }
	l.m.Advance(d + late)
}

// Alarms is m's, with no lateness.
func Alarms(l lateEvery) AlarmClock { l.m.Alarms() }

// recorder is the package's own test provider of a capability, derived as
// testing.Script is (patterns.md, Provider plans): recorder[Screen] has one
// record.Op field per operation of Screen and implements Screen. record.Op
// is written in Ergo, so no part of it is std's.
type recorder[S] derive Provider(Of[S](), Of[record.Op](), Of[record.NoArgs]())

// recorded is a Screen for the laws and tests: a recorder that keeps every
// frame it is shown (s.Show.Calls()) and answers Shown with their count. The
// checker derives it from Screen's operations, so no hand fake restates
// them.
func recorded() recorder[Screen] {
	let s = recorder[Screen]{}
	s.Shown.Answer(func() int { len(s.Show.Calls()) })
	s
}
