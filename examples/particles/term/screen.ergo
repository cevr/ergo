// Package term shows the game's frames on a standard output: the box,
// then its status line. On a terminal it clears the screen before each
// frame, so the box stays in one place; to a pipe it writes every frame
// one after another.

import io
import particles/render
import particles/sim
import sync

// Screen is a sim.Screen that writes to out. Its count of frames is in a
// sync.Ref, so every copy of a Screen counts the same frames.
type Screen { out io.Stdout, count sync.Ref[int] }

// New is a Screen that writes to out.
func New(out io.Stdout) Screen { Screen{out: out, count: sync.NewRef[int](0)} }

// Show writes f: on a terminal after the escape that clears the screen.
func Show(s Screen, f sim.Frame) {
	if s.out.IsTerminal() {
		s.out.Print("\x1b[H\x1b[2J")
	}
	for line in render.Box(f.G.W) {
		s.out.Println(line)
	}
	s.out.Println(render.Status(f))
	s.count.Update(func(n int) int { n + 1 })
}

// Shown is the number of frames s has written.
func Shown(s Screen) int { s.count.Get() }
