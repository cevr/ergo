// Package memory holds an in-memory provider of order.Orders: an event
// log per order and a snapshot of each order's state, so a command is
// decided without replaying the order's history.

import maps
import shop/order
import sync

// Log is the store: the streams and the snapshots, in one sync.Ref, so
// every copy of a Log is the same store and a Send writes both at once.
type Log { cells sync.Ref[store] }

// store is what a Log holds.
type store { streams Map[string, []order.Event], states Map[string, order.State] }

// New is an empty store.
func New() Log {
	Log{cells: sync.NewRef[store](store{streams: Map[string, []order.Event]{}, states: Map[string, order.State]{}})}
}

func History(l Log, id string) []order.Event { maps.GetOr(l.cells.Get().streams, id, []order.Event{}) }

func Current(l Log, id string) order.State { maps.GetOr(l.cells.Get().states, id, order.Absent) }

// Send decides c against the snapshot, then appends the events to the
// order's stream and evolves the snapshot by each of them.
func Send(l Log, c order.Command) []order.Event fails order.Rejection {
	let id = order.OrderOf(c)
	let s = l.Current(id)
	let events = try order.Decide(s, c)
	let mut stream = l.History(id)
	let mut next = s
	for e in events {
		stream = stream.Append(e)
		next = order.Evolve(next, e)
	}
	l.cells.Update(func(k store) store {
		let mut streams = k.streams
		let mut states = k.states
		streams[id] = stream
		states[id] = next
		store{streams: streams, states: states}
	})
	events
}
