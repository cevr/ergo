// ergo test runs the laws of order.Orders here, against Log (NewLog), over
// generated commands. These properties check them again over scripts
// drawn from a seed, which reach accepted commands far more often: each
// command of a script is sent in turn, and each law is checked after it.

import shop/order

// sent is the events and the rejection's name of c, sent to the store.
func sent(c order.Command) ([]order.Event, string) needs order.Orders {
	let events = order.Orders.Send(c) catch {
	case order.UnknownOrder:
		return ([]order.Event{}, "UnknownOrder")
	case order.AlreadyPlaced:
		return ([]order.Event{}, "AlreadyPlaced")
	case order.InvalidLine:
		return ([]order.Event{}, "InvalidLine")
	case order.WrongAmount:
		return ([]order.Event{}, "WrongAmount")
	case order.NotAllowed:
		return ([]order.Event{}, "NotAllowed")
	}
	(events, "")
}

test RejectedCommandEmitsNothingHolds(seed int) {
	with context { order.Orders: NewLog() } {
		for c in order.Script(seed, 40) {
			let before = order.Orders.History(order.OrderOf(c))
			let _, rejected = sent(c)
			if rejected != "" {
				assert order.Orders.History(order.OrderOf(c)) == before
			}
		}
	}
}

test AcceptedCommandIsRecordedHolds(seed int) {
	with context { order.Orders: NewLog() } {
		for c in order.Script(seed, 40) {
			let before = order.Orders.History(order.OrderOf(c))
			let events, rejected = sent(c)
			if rejected == "" {
				let mut want = before
				for e in events {
					want = want.Append(e)
				}
				assert order.Orders.History(order.OrderOf(c)) == want
			}
		}
	}
}

test ReplayRebuildsStateHolds(seed int) {
	with context { order.Orders: NewLog() } {
		for c in order.Script(seed, 40) {
			let _, _ = sent(c)
			let id = order.OrderOf(c)
			assert order.Replay(order.Orders.History(id)) == order.Orders.Current(id)
		}
	}
}

// The store records what the reference records: Simulate's log of each
// order is the store's history of it.
test TheStoreAgreesWithTheReference(seed int) {
	let script = order.Script(seed, 40)
	let log = order.Simulate(script)
	with context { order.Orders: NewLog() } {
		for c in script {
			let _, _ = sent(c)
		}
		assert order.Orders.History("a") == order.Of(log, "a")
		assert order.Orders.History("b") == order.Of(log, "b")
	}
}

test ARejectionLeavesTheStoreAsItWas {
	with context { order.Orders: NewLog() } {
		let _, first = sent(order.Place{Order: "a", Customer: "ana", Lines: []order.Line{order.Line{Sku: "tea", Qty: 2, Price: 150}}})
		let _, wrong = sent(order.Pay{Order: "a", Amount: 1})
		assert first == "" && wrong == "WrongAmount"
		assert len(order.Orders.History("a")) == 2
		assert order.Orders.Current("a") == order.Open{S: order.Summary{Customer: "ana", Total: 300, Items: 2}}
	}
}
