// shop-domain runs an event-sourced shop over a script read from standard
// input, one command per line:
//
//	place ORDER CUSTOMER SKU:QTY:CENTS ...
//	pay ORDER CENTS
//	ship ORDER
//	cancel ORDER REASON ...
//	wait MINUTES
//	sales
//
// It prints each command's events or its rejection, the commands the
// fulfilment saga sends, and the sales view at the end. Package order is
// the aggregate and its contract, sales the view, fulfil the saga and
// the desk, memory the store. This binary is the only place that chooses
// the providers: the memory store and the host's standard input and
// output.

import io
import os
import shop/fulfil
import shop/memory
import shop/order
import shop/sales
import strconv
import strings

// Step is one line of the script.
type Step = Do{C order.Command} | Wait{Minutes int} | Report{} | Blank{}

// BadLine is a line of the script that is not a command.
type BadLine { Line int, Reason string }

// Parse is the step of a line of the script.
func Parse(n int, line string) Step fails BadLine {
	let w = strings.Fields(line)
	if len(w) == 0 || strings.HasPrefix(w[0], "#") {
		return Blank
	}
	match w[0] {
	case "place":
		if len(w) < 4 {
			return BadLine{Line: n, Reason: "place needs an order, a customer and a line"}
		}
		let mut lines = []order.Line{}
		for i in 3..len(w) {
			lines = lines.Append(try lineOf(n, w[i]))
		}
		Do{C: order.Place{Order: w[1], Customer: w[2], Lines: lines}}
	case "pay":
		if len(w) != 3 {
			return BadLine{Line: n, Reason: "pay needs an order and an amount"}
		}
		Do{C: order.Pay{Order: w[1], Amount: int64(try whole(n, w[2]))}}
	case "ship":
		if len(w) != 2 {
			return BadLine{Line: n, Reason: "ship needs an order"}
		}
		Do{C: order.Ship{Order: w[1]}}
	case "cancel":
		if len(w) < 3 {
			return BadLine{Line: n, Reason: "cancel needs an order and a reason"}
		}
		let mut reason = w[2]
		for i in 3..len(w) {
			reason = reason + " " + w[i]
		}
		Do{C: order.Cancel{Order: w[1], Reason: reason}}
	case "wait":
		if len(w) != 2 {
			return BadLine{Line: n, Reason: "wait needs minutes"}
		}
		Wait{Minutes: try whole(n, w[1])}
	case "sales":
		Report
	case _:
		BadLine{Line: n, Reason: "no command " + w[0]}
	}
}

// lineOf is the order line SKU:QTY:CENTS.
func lineOf(n int, text string) order.Line fails BadLine {
	let parts = strings.Split(text, ":")
	if len(parts) != 3 {
		return BadLine{Line: n, Reason: "a line is SKU:QTY:CENTS, not " + text}
	}
	order.Line{Sku: parts[0], Qty: try whole(n, parts[1]), Price: int64(try whole(n, parts[2]))}
}

// whole is the text as a whole number. It is not named number, a prelude
// name (G-ex-c-11).
func whole(n int, text string) int fails BadLine {
	strconv.Atoi(text) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return BadLine{Line: n, Reason: "not a number: " + text}
	}
}

// Describe is the text of an event.
func Describe(e order.Event) string {
	match e {
	case order.Placed as p:
		"placed for " + p.Customer
	case order.ItemAdded as i:
		"  \(i.Qty) x " + i.Sku + " at " + sales.Money(i.Price)
	case order.PaymentTaken as p:
		"paid " + sales.Money(p.Amount)
	case order.Shipped:
		"shipped"
	case order.Cancelled as x:
		if x.Refund > 0 {
			return "cancelled (" + x.Reason + "), refunded " + sales.Money(x.Refund)
		}
		"cancelled (" + x.Reason + ")"
	}
}

// print prints the outcomes and is the view after their events.
func print(v sales.Sales, outcomes []fulfil.Outcome) sales.Sales needs io.Stdout {
	let mut view = v
	for o in outcomes {
		match o {
		case fulfil.Recorded as r:
			for e in r.Events {
				io.Stdout.Println(order.OrderOf(r.C) + ": " + Describe(e))
				view = sales.Project(view, e)
			}
		case fulfil.Refused as r:
			io.Stdout.Println(order.OrderOf(r.C) + ": refused: " + r.Why)
		}
	}
	view
}

// run runs the script on standard input against the orders.
func run() fails os.Exit needs io.Stdin | io.Stdout | order.Orders {
	let mut desk = fulfil.Open()
	let mut view = sales.Of([]order.Event{})
	let mut n = 0
	for line in io.Stdin.Lines() {
		n = n + 1
		let step = Parse(n, line) catch {
		case BadLine as b:
			return os.Exit{Code: 2, Message: "shop-domain: line \(b.Line): " + b.Reason}
		}
		match step {
		case Do as d:
			let next, outcomes = fulfil.Submit(desk, d.C)
			desk = next
			view = print(view, outcomes)
		case Wait as w:
			io.Stdout.Println("-- \(w.Minutes) minutes later")
			let next, outcomes = fulfil.Advance(desk, w.Minutes)
			desk = next
			view = print(view, outcomes)
		case Report:
			io.Stdout.Println(sales.Text(view))
		case Blank:
		}
	}
	io.Stdout.Println(sales.Text(view))
}

func main() fails os.Exit needs Ambient {
	with context { io.Stdin: io.NewHost(), io.Stdout: io.NewHost(), order.Orders: memory.New() } {
		try run()
	}
}

// ran is the output of run on the script, with a failure printed as
// "exit CODE: MESSAGE".
func ran(script string) string {
	let out = io.NewRecorder()
	with context { io.Stdin: io.Input{Text: script}, io.Stdout: out, order.Orders: memory.New() } {
		run() catch {
		case os.Exit as e:
			io.Stdout.Println("exit \(e.Code): \(e.Message)")
		}
	}
	out.Text()
}

test APaidOrderShipsAndCounts {
	let out = ran("place a ana tea:2:150\npay a 300\n")
	assert out == "a: placed for ana\na:   2 x tea at 1.50\na: paid 3.00\na: shipped\nplaced 1, paid 1, shipped 1, cancelled 0, units 2, revenue 3.00\n"
}

test AnUnpaidOrderIsCancelled {
	let out = ran("place b bo mug:1:900\nwait 45\nship b\n")
	assert out == "b: placed for bo\nb:   1 x mug at 9.00\n-- 45 minutes later\nb: cancelled (unpaid after 30 minutes)\nb: refused: cannot ship an order that is cancelled\nplaced 1, paid 0, shipped 0, cancelled 1, units 1, revenue 0.00\n"
}

test ABadLineExits {
	assert ran("# a script\n\nplace a ana tea:x:1\n") == "exit 2: shop-domain: line 3: not a number: x\n"
	assert ran("refund a\n") == "exit 2: shop-domain: line 1: no command refund\n"
}
