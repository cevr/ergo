// Package order is the order aggregate of the shop: the commands it
// decides, the events it records, the ways it refuses a command, and the
// state it folds its events into. Every function here is pure: no
// capability, no host.

// Line is one line of an order: a quantity of a product at a unit price
// in cents.
type Line { Sku string, Qty int, Price int64 }

// Command is a request to change an order.
type Command = Place{Order string, Customer string, Lines []Line} | Pay{Order string, Amount int64} | Ship{Order string} | Cancel{Order string, Reason string}

// Event is a fact an order records. Each event carries what Decide worked
// out (a line's price, a refund), so Evolve copies it and repeats no rule.
type Event = Placed{Order string, Customer string} | ItemAdded{Order string, Sku string, Qty int, Price int64} | PaymentTaken{Order string, Amount int64} | Shipped{Order string} | Cancelled{Order string, Reason string, Refund int64}

// The rejections: each is a typed failure of Decide, so a caller that
// sends a command names every way it can be refused.
type UnknownOrder { Order string }
type AlreadyPlaced { Order string }
type InvalidLine { Order string, Sku string, Reason string }
type WrongAmount { Order string, Due int64, Got int64 }
type NotAllowed { Order string, Action string, Status string }

// Rejection is the row of every rejection.
type Rejection = UnknownOrder | AlreadyPlaced | InvalidLine | WrongAmount | NotAllowed

// Summary is what an order holds in every state after it is placed.
type Summary { Customer string, Total int64, Items int }

// State is an order's state. Absent is the state before its first event.
type State = Absent{} | Open{S Summary} | Paid{S Summary} | Sent{S Summary} | Void{S Summary, Reason string}

// OrderOf is the order a command is about.
func OrderOf(c Command) string {
	match c {
	case Place as p:
		p.Order
	case Pay as p:
		p.Order
	case Ship as s:
		s.Order
	case Cancel as x:
		x.Order
	}
}

// StreamOf is the order an event belongs to.
func StreamOf(e Event) string {
	match e {
	case Placed as p:
		p.Order
	case ItemAdded as i:
		i.Order
	case PaymentTaken as p:
		p.Order
	case Shipped as s:
		s.Order
	case Cancelled as x:
		x.Order
	}
}

// StatusOf is the name of a state, as a rejection reports it.
func StatusOf(s State) string {
	match s {
	case Absent:
		"absent"
	case Open:
		"open"
	case Paid:
		"paid"
	case Sent:
		"shipped"
	case Void:
		"cancelled"
	}
}
