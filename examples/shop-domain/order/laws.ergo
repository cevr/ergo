// The aggregate's own laws, over drawn scripts. The laws of a provider
// are on the Orders contract (orders.ergo).

// PaymentIsTheTotal: every payment an order records is the sum of its
// lines, and no order records two payments.
law PaymentIsTheTotal(seed int) {
	PaymentsAreTotals(Simulate(Script(seed, 40)))
}

// RefundIsThePayment: a cancelled order refunds what it was paid, and an
// unpaid one refunds nothing.
law RefundIsThePayment(seed int) {
	RefundsArePayments(Simulate(Script(seed, 40)))
}

// PaymentsAreTotals is the check of PaymentIsTheTotal on a log.
func PaymentsAreTotals(log []Event) bool {
	for id in []string{"a", "b"} {
		let mut total = int64(0)
		let mut payments = 0
		for e in Of(log, id) {
			match e {
			case ItemAdded as i:
				total = total + int64(i.Qty)*i.Price
			case PaymentTaken as p:
				payments = payments + 1
				if p.Amount != total || payments > 1 {
					return false
				}
			case Placed, Shipped, Cancelled:
			}
		}
	}
	true
}

// RefundsArePayments is the check of RefundIsThePayment on a log.
func RefundsArePayments(log []Event) bool {
	for id in []string{"a", "b"} {
		let mut paid = int64(0)
		for e in Of(log, id) {
			match e {
			case PaymentTaken as p:
				paid = p.Amount
			case Cancelled as x:
				if x.Refund != paid {
					return false
				}
			case Placed, ItemAdded, Shipped:
			}
		}
	}
	true
}
