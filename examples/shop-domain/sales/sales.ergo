// Package sales is a view of the shop: it folds the order events into
// the numbers a shopkeeper asks for. It reads events only, never an
// order's state.

import shop/order

// Sales is the view: orders placed, paid, shipped and cancelled, the
// units sold, and the revenue (payments less refunds) in cents.
type Sales { Placed int, Paid int, Shipped int, Cancelled int, Units int, Revenue int64 }

// Project is the view after event e.
func Project(v Sales, e order.Event) Sales {
	match e {
	case order.Placed:
		Sales{..v, Placed: v.Placed + 1}
	case order.ItemAdded as i:
		Sales{..v, Units: v.Units + i.Qty}
	case order.PaymentTaken as p:
		Sales{..v, Paid: v.Paid + 1, Revenue: v.Revenue + p.Amount}
	case order.Shipped:
		Sales{..v, Shipped: v.Shipped + 1}
	case order.Cancelled as x:
		Sales{..v, Cancelled: v.Cancelled + 1, Revenue: v.Revenue - x.Refund}
	}
}

// Of is the view of a log, folded from nothing.
func Of(log []order.Event) Sales {
	let mut v = Sales{Placed: 0, Paid: 0, Shipped: 0, Cancelled: 0, Units: 0, Revenue: 0}
	for e in log {
		v = Project(v, e)
	}
	v
}

// Text is the view as the shop prints it.
func Text(v Sales) string {
	"placed \(v.Placed), paid \(v.Paid), shipped \(v.Shipped), cancelled \(v.Cancelled), units \(v.Units), revenue \(Money(v.Revenue))"
}

// Money is cents as dollars and cents: 1250 is "12.50".
func Money(cents int64) string {
	let sign = if cents < 0 { "-" } else { "" }
	let c = if cents < 0 { -cents } else { cents }
	let rest = c % 100
	let pad = if rest < 10 { "0" } else { "" }
	sign + "\(c / 100)." + pad + "\(rest)"
}

// RevenueIsWhatOrdersHold: the revenue is the total of the orders that
// are paid or shipped, as their histories replay, and the view counts
// each order the log places.
law RevenueIsWhatOrdersHold(seed int) {
	Agrees(order.Simulate(order.Script(seed, 40)))
}

// Agrees is the check of RevenueIsWhatOrdersHold on a log of the orders
// "a" and "b".
func Agrees(log []order.Event) bool {
	let mut held = int64(0)
	let mut placed = 0
	for id in []string{"a", "b"} {
		match order.Replay(order.Of(log, id)) {
		case order.Paid as p:
			held = held + p.S.Total
		case order.Sent as s:
			held = held + s.S.Total
		case order.Absent:
			placed = placed - 1
		case order.Open, order.Void:
		}
		placed = placed + 1
	}
	let v = Of(log)
	v.Revenue == held && v.Placed == placed
}
