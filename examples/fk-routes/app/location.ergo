// AtStart is a Back with no earlier page in the history.
type AtStart {}

// Location is the browser's address and its history: the program reads
// the address, pushes a new one when it navigates, and goes back. After
// a push or a back, the host tells the machine the new address
// (Navigated).
type Location {
	// Here is the current address.
	Here() string,
	// Push makes path the current address, after the current one; the
	// addresses ahead of the current one are dropped.
	Push(path string),
	// Back makes the address before the current one current, and is it.
	Back() string fails AtStart,

	// BackRestoresRoute: a push makes its address current, and Back after
	// it returns to the address before, so the route the program shows is
	// the one it showed then.
	law BackRestoresRoute(picks []int) {
		let paths = []string{"/", "/people", "/people/3", "/files/photos", "/people?searchText=dev", "/nowhere"}
		for k in picks {
			let before = Here()
			let path = paths[((k%len(paths))+len(paths))%len(paths)]
			Push(path)
			if Here() != path {
				return false
			}
			let back = Back() catch {
			case AtStart:
				return false
			}
			if back != before || Here() != before {
				return false
			}
			Push(path)
		}
		true
	},

	// BackStopsAtTheStart: with nothing pushed, Back fails AtStart and
	// keeps the address.
	law BackStopsAtTheStart() {
		let here = Here()
		let _ = Back() catch {
		case AtStart:
			return Here() == here
		}
		false
	},
}
