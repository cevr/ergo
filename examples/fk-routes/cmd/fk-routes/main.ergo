// fk-routes is a port of Foldkit's routing example (stage a: the model,
// with no view): screens chosen by the address, with a URL parameter, a
// query, nested and rest segments, and a not-found screen. It plays a
// script of the user's acts and shows what changes after each. Package
// route reads and writes addresses; package app is the program as a
// machine and its contract Location; packages people and files are the
// data the screens show; package memory is the history; package script
// plays the script. This binary is the only place that chooses the clock:
// a time.Manual that only the script's waits move.

import fkroutes/script
import io
import os
import time

func main() fails os.Exit needs Console | Ambient {
	let clock = time.NewManual(0)
	let status = with context { io.Stdin: io.NewStdin(), Scheduler: clock } { script.Run(clock) }
	if status != 0 {
		return os.Exit{Code: status, Message: "fk-routes: the script did not run"}
	}
}
