import fs
import slices
import strings

// Disk is an fs.Files and fs.Writes provider over a Map from each file's
// path to its text, so a test reads and writes files with no host. A
// directory is any path that a file's path starts with, then a /. Every
// copy of a Disk shares its Map, so a write through one copy is read
// through another (G-ex-b-3: a provider keeps state only in a Map).
type Disk { Files Map[string, string] }

// NewDisk is a Disk of the files.
func NewDisk(files Map[string, string]) Disk { Disk{Files: files} }

// ReadFile is the text of the file at path.
func ReadFile(d Disk, path string) string fails fs.NotFound | fs.Denied | fs.Failed {
	match d.Files.Get(path) {
	case Some[string] as t:
		t.Value
	case None:
		if isDir(d, path) {
			return fs.Failed{Path: path, Reason: "is a directory"}
		}
		fs.NotFound{Path: path}
	}
}

// ReadDir is the name of each entry of the directory at path, sorted.
func ReadDir(d Disk, path string) []string fails fs.NotFound | fs.Denied | fs.Failed {
	let prefix = path + "/"
	let mut seen = Map[string, bool]{}
	for p, _ in d.Files {
		if strings.HasPrefix(p, prefix) {
			let rest = strings.TrimPrefix(p, prefix)
			match strings.Cut(rest, "/") {
			case Some[strings.Halves] as h:
				seen[h.Value.Before] = true
			case None:
				seen[rest] = true
			}
		}
	}
	if len(seen) == 0 {
		return fs.NotFound{Path: path}
	}
	let mut names = []string{}
	for name, _ in seen {
		names = names.Append(name)
	}
	slices.Sort(names)
}

// Stat describes the file or directory at path.
func Stat(d Disk, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed {
	let name = lastOf(path)
	match d.Files.Get(path) {
	case Some[string] as t:
		fs.Info{Name: name, Size: len(t.Value), Dir: false}
	case None:
		if isDir(d, path) {
			return fs.Info{Name: name, Size: 0, Dir: true}
		}
		fs.NotFound{Path: path}
	}
}

// WriteFile makes the file at path hold text. A path under a file, or
// at a directory, fails.
func WriteFile(d Disk, path string, text string) fails fs.NotFound | fs.Denied | fs.Failed {
	if isDir(d, path) {
		return fs.Failed{Path: path, Reason: "is a directory"}
	}
	let mut files = d.Files
	files[path] = text
}

// MkdirAll makes nothing: a Disk's directories are the paths of its
// files. A file on the way fails, as the host's does.
func MkdirAll(d Disk, path string) fails fs.Denied | fs.Failed {
	let mut at = ""
	for part in strings.Split(path, "/") {
		at = if at == "" { part } else { at + "/" + part }
		match d.Files.Get(at) {
		case Some[string]:
			return fs.Failed{Path: path, Reason: "not a directory"}
		case None:
		}
	}
}

func isDir(d Disk, path string) bool {
	for p, _ in d.Files {
		if strings.HasPrefix(p, path+"/") {
			return true
		}
	}
	false
}

func lastOf(path string) string {
	let parts = strings.Split(path, "/")
	parts[len(parts)-1]
}
