// Read and Write run over an fstest.Memory, so no test touches the host's
// file system.

import fs
import fstest
import ssg/memory
import ssg/site

// sample is a site folder s with pages, templates and files that are
// neither.
func sample() fstest.Memory fails fs.NotFound | fs.Denied | fs.Failed {
	try memory.Files(Map[string, string]{
		"s/content/index.md":     "home",
		"s/content/posts/b.md":   "b",
		"s/content/posts/a.md":   "a",
		"s/content/notes.txt":    "skipped",
		"s/templates/page.html":  "{{ raw body }}",
		"s/templates/readme.txt": "skipped",
	})
}

test ReadWalksEveryFolder {
	with context { fs.Files: try sample() } {
		let src = try Read("s")
		assert src.Pages() == []string{"index.md", "posts/a.md", "posts/b.md"}
		assert src.TemplateNames() == []string{"page"}
		assert try src.ReadPage("posts/b.md") == "b"
	}
}

// unreadable is the path that Read("s") over d fails on, or "read".
func unreadable(d fstest.Memory) string {
	with context { fs.Files: d } {
		let _ = Read("s") catch {
		case site.Unreadable as u:
			return u.Path + ": " + u.Reason
		}
		"read"
	}
}

test MissingFoldersAreUnreadable {
	assert unreadable(try memory.Files(Map[string, string]{"s/content/a.md": "a"})) == "s/templates: no such folder"
	assert unreadable(fstest.NewMemory()) == "s/content: no such folder"
}

test WriteMakesFolders {
	let out = fstest.NewMemory()
	with context { fs.Writes: out } {
		let wrote = try Write("public", []site.Output{site.Output{Path: "index.html", Text: "i"}, site.Output{Path: "posts/a.html", Text: "a"}})
		assert wrote == []string{"public/index.html", "public/posts/a.html"}
	}
	assert try out.ReadFile("public/posts/a.html") == "a"
}

test WriteOverAFileFails {
	assert unwritable(try memory.Files(Map[string, string]{"public": "a file"})) == "public: not a directory"
}

// unwritable is the failure of writing x.html under public on d, or
// "wrote".
func unwritable(d fstest.Memory) string {
	with context { fs.Writes: d } {
		let _ = Write("public", []site.Output{site.Output{Path: "x.html", Text: "x"}}) catch {
		case Unwritable as u:
			return u.Path + ": " + u.Reason
		}
		"wrote"
	}
}
