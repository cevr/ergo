// Package alert turns a stream of threshold checks into alerts, at most
// Limit of them in any Window milliseconds, as a machine.

import machines

// Policy is how often the limiter may alert: at most Limit alerts in any
// Window milliseconds.
type Policy { Limit int, Window int64 }

// Signal is one check of the watched value: above the threshold, or not.
type Signal = Breach{At int64, Value float64} | Calm{At int64}

// State is the limiter's state. Sent is the times of the alerts sent in
// the last Window, oldest first; Muted counts the breaches that were not
// alerted because the rate was spent.
type State =
	| Quiet{Policy Policy, Sent []int64, Muted int}
	| Firing{Policy Policy, Since int64, Sent []int64, Muted int}

// Initial is the state of a limiter with policy p: quiet, nothing sent.
func Initial(p Policy) State { Quiet{Policy: p, Sent: []int64{}, Muted: 0} }

// recent is the times of sent that are still within window of now.
func recent(sent []int64, now int64, window int64) []int64 {
	let mut out = []int64{}
	for t in sent {
		if t > now-window {
			out = out.Append(t)
		}
	}
	out
}

// Event is what one signal did.
type Event = Alerted{At int64, Value float64} | Resolved{At int64, Since int64} | Muted{At int64} | Nothing{}

// Step is the limiter's transition. A breach while quiet alerts, by
// entering Firing with its time added to Sent, unless Limit alerts were
// sent in the last Window: then it stays quiet and counts one muted. A
// breach while firing is the same incident and is ignored. A calm check
// while firing resolves the incident; while quiet it is ignored. Each
// alert, mute and resolution is emitted.
func Step(s State, sig Signal) machines.Decision[State, Event] {
	match (s, sig) {
	case (Quiet as q, Breach as b):
		let sent = recent(q.Sent, b.At, q.Policy.Window)
		if sent.Len() >= q.Policy.Limit {
			machines.Emit[State, Event]{Next: Quiet{..q, Sent: sent, Muted: q.Muted + 1}, Output: Muted{At: b.At}}
		} else {
			machines.Emit[State, Event]{Next: Firing{Policy: q.Policy, Since: b.At, Sent: sent.Append(b.At), Muted: q.Muted}, Output: Alerted{At: b.At, Value: b.Value}}
		}
	case (Firing, Breach):
		machines.Ignore
	case (Firing as f, Calm as c):
		machines.Emit[State, Event]{Next: Quiet{Policy: f.Policy, Sent: f.Sent, Muted: f.Muted}, Output: Resolved{At: c.At, Since: f.Since}}
	case (Quiet, Calm):
		machines.Ignore
	}
}

// Limiter is the alert limiter as a machine. Its input is the policy.
type Limiter machine[State, Signal] {
	initial: Initial,
	step:    Step,
}

// Drive runs the limiter with policy p over signals, and is what each
// signal did: its emitted event, or Nothing.
func Drive(p Policy, signals []Signal) []Event {
	let m = machines.Start(Limiter{}, p)
	let mut s = machines.Initial(m)
	let mut out = []Event{}
	for sig in signals {
		let d = m.Step(s, sig)
		match d {
		case machines.Emit[State, Event] as e:
			out = out.Append(e.Output)
		case machines.Enter[State], machines.Stay[State], machines.Tell[State, Event], machines.Ignore, machines.Reject, machines.Done[Event]:
			out = out.Append(Nothing)
		}
		s = machines.Next(s, d)
	}
	out
}

// BreachesAreAccounted: every breach alerts, is muted, or falls inside
// an incident that is already firing; every calm check resolves an
// incident or does nothing; and each resolution names the alert that
// opened its incident.
law BreachesAreAccounted(seed int, l int, w int) {
	let signals = signals(seed, 80)
	let events = Drive(policyOf(l, w), signals)
	let mut firing = false
	let mut since = int64(0)
	for i, e in events {
		match (signals[i], e) {
		case (Breach, Alerted as a):
			if firing {
				return false
			}
			firing = true
			since = a.At
		case (Breach, Muted):
			if firing {
				return false
			}
		case (Breach, Nothing):
			if !firing {
				return false
			}
		case (Calm, Resolved as r):
			if !firing || r.Since != since {
				return false
			}
			firing = false
		case (Calm, Nothing):
			if firing {
				return false
			}
		case (_, _):
			return false
		}
	}
	true
}

// AlertTimes is the times of the alerts among events.
func AlertTimes(events []Event) []int64 {
	let mut out = []int64{}
	for e in events {
		match e {
		case Alerted as a:
			out = out.Append(a.At)
		case Resolved, Muted, Nothing:
		}
	}
	out
}

// NeverExceedsRate: whatever the checks, the alerts keep the policy's
// rate.
law NeverExceedsRate(seed int, l int, w int) {
	let p = policyOf(l, w)
	withinRate(AlertTimes(Drive(p, signals(seed, 80))), p)
}

// signals is count checks drawn from seed: times that step 0 to 20000 ms,
// each a breach or calm, breaches more often, so the rate is often spent.
func signals(seed int, count int) []Signal {
	let mut x = (if seed < 0 { -(seed + 1) } else { seed }) % 2147483648
	let mut at = int64(0)
	let mut out = []Signal{}
	for i in 0..count {
		x = (x*1103515245 + 12345) % 2147483648
		at += int64((x / 65536) % 20001)
		if (x/8)%3 == 0 {
			out = out.Append(Calm{At: at})
		} else {
			out = out.Append(Breach{At: at, Value: float64(i)})
		}
	}
	out
}

// policyOf is a policy from any l and w: a limit of 1 to 4 alerts in a
// window of 1 to 120 seconds.
func policyOf(l int, w int) Policy {
	let limit = 1 + (if l < 0 { -(l + 1) } else { l })%4
	let seconds = 1 + (if w < 0 { -(w + 1) } else { w })%120
	Policy{Limit: limit, Window: int64(seconds) * 1000}
}

// withinRate reports whether no window of p.Window milliseconds holds
// more than p.Limit of times: for each time t, the times in (t-Window, t].
func withinRate(times []int64, p Policy) bool {
	for t in times {
		let mut n = 0
		for u in times {
			if u > t-p.Window && u <= t {
				n += 1
			}
		}
		if n > p.Limit {
			return false
		}
	}
	true
}
