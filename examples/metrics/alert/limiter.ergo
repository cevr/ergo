// Package alert turns a stream of threshold checks into alerts, at most
// Limit of them in any Window milliseconds, as a machine.

// Policy is how often the limiter may alert: at most Limit alerts in any
// Window milliseconds.
type Policy { Limit int, Window int64 }

// Signal is one check of the watched value: above the threshold, or not.
type Signal = Breach{At int64, Value float64} | Calm{At int64}

// State is the limiter's state. Sent is the times of the alerts sent in
// the last Window, oldest first; Muted counts the breaches that were not
// alerted because the rate was spent.
type State =
	| Quiet{Policy Policy, Sent []int64, Muted int}
	| Firing{Policy Policy, Since int64, Sent []int64, Muted int}

// Initial is the state of a limiter with policy p: quiet, nothing sent.
func Initial(p Policy) State { Quiet{Policy: p, Sent: []int64{}, Muted: 0} }

// recent is the times of sent that are still within window of now.
func recent(sent []int64, now int64, window int64) []int64 {
	let mut out = []int64{}
	for t in sent {
		if t > now-window {
			out = out.Append(t)
		}
	}
	out
}

// Step is the limiter's transition. A breach while quiet alerts, by
// entering Firing with its time added to Sent, unless Limit alerts were
// sent in the last Window: then it stays quiet and counts one muted. A
// breach while firing is the same incident and is ignored. A calm check
// while firing resolves the incident; while quiet it is ignored.
func Step(s State, sig Signal) Decision[State, int] {
	match (s, sig) {
	case (Quiet as q, Breach as b):
		let sent = recent(q.Sent, b.At, q.Policy.Window)
		if len(sent) >= q.Policy.Limit {
			Stay[State]{Next: Quiet{..q, Sent: sent, Muted: q.Muted + 1}}
		} else {
			Enter[State]{Next: Firing{Policy: q.Policy, Since: b.At, Sent: sent.Append(b.At), Muted: q.Muted}}
		}
	case (Firing, Breach):
		Ignore
	case (Firing as f, Calm):
		Enter[State]{Next: Quiet{Policy: f.Policy, Sent: f.Sent, Muted: f.Muted}}
	case (Quiet, Calm):
		Ignore
	}
}

// Limiter is the alert limiter as a machine.
type Limiter machine[State, Signal] {
	initial: Initial(Policy{Limit: 2, Window: 60000}),
	step:    Step,
}

// Event is what one signal did.
type Event = Alerted{At int64, Value float64} | Resolved{At int64, Since int64} | Muted{At int64} | Nothing{}

// Next is the state after d, and what happened.
func Next(s State, sig Signal, d Decision[State, int]) (State, Event) {
	match d {
	case Enter[State] as e:
		match (e.Next, sig) {
		case (Firing as f, Breach as b):
			(e.Next, Alerted{At: f.Since, Value: b.Value})
		case (Quiet, Calm as c):
			match s {
			case Firing as f:
				(e.Next, Resolved{At: c.At, Since: f.Since})
			case Quiet:
				(e.Next, Nothing)
			}
		case (_, _):
			(e.Next, Nothing)
		}
	case Stay[State] as st:
		match sig {
		case Breach as b:
			(st.Next, Muted{At: b.At})
		case Calm:
			(st.Next, Nothing)
		}
	case Ignore:
		(s, Nothing)
	case Reject:
		(s, Nothing)
	case Done[int]:
		(s, Nothing)
	}
}

// Drive runs the limiter with policy p over signals, and is what each
// signal did. A machine has no runner (G-ex-d-11), so Drive is its loop.
func Drive(p Policy, signals []Signal) []Event {
	let mut s = Initial(p)
	let mut out = []Event{}
	for sig in signals {
		let next, e = Next(s, sig, Step(s, sig))
		s = next
		out = out.Append(e)
	}
	out
}

// AlertTimes is the times of the alerts among events.
func AlertTimes(events []Event) []int64 {
	let mut out = []int64{}
	for e in events {
		match e {
		case Alerted as a:
			out = out.Append(a.At)
		case Resolved, Muted, Nothing:
		}
	}
	out
}
