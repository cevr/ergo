// Windows over samples.

import slices

// BadWidth is a window width below one millisecond.
type BadWidth { Width int64 }

// Bucket is the samples of one tumbling window [Start, Start+width).
type Bucket { Start int64, Count int, Sum float64, Min float64, Max float64, Values []float64 }

// StartOf is the start of the tumbling window of width that holds at.
func StartOf(at int64, width int64) int64 {
	let r = at % width
	if r < 0 { at - r - width } else { at - r }
}

// Tumbling is the non-empty tumbling windows of width over samples, in
// time order. samples are in time order.
func Tumbling(samples []Sample, width int64) []Bucket fails BadWidth {
	if width < 1 {
		return BadWidth{Width: width}
	}
	let mut out = []Bucket{}
	for s in samples {
		let start = StartOf(s.At, width)
		if len(out) > 0 && out[len(out)-1].Start == start {
			let i = len(out) - 1
			out[i].Count += 1
			out[i].Sum += s.Value
			if s.Value < out[i].Min {
				out[i].Min = s.Value
			}
			if s.Value > out[i].Max {
				out[i].Max = s.Value
			}
			out[i].Values = out[i].Values.Append(s.Value)
		} else {
			out = out.Append(Bucket{Start: start, Count: 1, Sum: s.Value, Min: s.Value, Max: s.Value, Values: []float64{s.Value}})
		}
	}
	out
}

// TumblingSumsEqualFold: each tumbling bucket's sum and count are the
// fold of the samples in its window, the buckets tile time in order, and
// together they hold every sample.
law TumblingSumsEqualFold(seed int, n int) {
	let samples = run(seed, 40)
	let width = widthOf(n)
	let buckets = Tumbling(samples, width) catch {
	case BadWidth:
		return false
	}
	let mut total = 0
	for i, b in buckets {
		let sum, count = naiveSum(samples, len(samples), b.Start, b.Start+width)
		if b.Sum != sum || b.Count != count || b.Start%width != 0 || (i > 0 && b.Start <= buckets[i-1].Start) {
			return false
		}
		total += b.Count
	}
	total == len(samples)
}

// run is count samples drawn from seed: times that step 0 to 1500 ms from
// an origin that may be negative, values from -50 to 50.
func run(seed int, count int) []Sample {
	let mut x = (if seed < 0 { -(seed + 1) } else { seed }) % 2147483648
	let next = func(n int) int {
		x = (x*1103515245 + 12345) % 2147483648
		(x / 65536) % n
	}
	let mut at = int64(next(20000)) - 10000
	let mut out = []Sample{}
	for _ in 0..count {
		at += int64(next(1501))
		out = out.Append(Sample{At: at, Value: float64(next(101) - 50)})
	}
	out
}

// widthOf is a window width from any n: 1 to 5000 ms.
func widthOf(n int) int64 {
	let m = if n < 0 { -(n + 1) } else { n }
	int64(1 + m%5000)
}

// naiveSum is the sum and count of the first upTo samples with
// from <= At < to.
func naiveSum(samples []Sample, upTo int, from int64, to int64) (float64, int) {
	let mut sum = 0.0
	let mut n = 0
	for i, s in samples {
		if i < upTo && s.At >= from && s.At < to {
			sum += s.Value
			n += 1
		}
	}
	(sum, n)
}

// Sliding is the samples of the last width milliseconds: after Add of a
// sample at t, it holds the samples added with At in (t-width, t]. Its
// sum is kept as samples come and go, so Add is amortized O(1).
type Sliding { width int64, samples []Sample, head int, sum float64 }

// NewSliding is an empty sliding window of width.
func NewSliding(width int64) Sliding fails BadWidth {
	if width < 1 {
		return BadWidth{Width: width}
	}
	Sliding{width: width, samples: []Sample{}, head: 0, sum: 0}
}

// SlidingAgrees: after each Add, the sliding window's sum and count are
// the fold of the samples added so far in the last width milliseconds.
law SlidingAgrees(seed int, n int) {
	let samples = run(seed, 120)
	let width = widthOf(n)
	let mut w = NewSliding(width) catch {
	case BadWidth:
		return false
	}
	for i, s in samples {
		w.Add(s)
		let sum, count = naiveSum(samples, i+1, s.At-width+1, s.At+1)
		if w.Sum() != sum || w.Count() != count {
			return false
		}
	}
	true
}

// Add puts s in w and drops the samples that fall out of it. Samples are
// added in time order.
func Add(w mut Sliding, s Sample) {
	w.samples = w.samples.Append(s)
	w.sum += s.Value
	for w.samples[w.head].At <= s.At-w.width {
		w.sum -= w.samples[w.head].Value
		w.head += 1
	}
	// The dead prefix is dropped by a copy once it is half the slice, so
	// the array of the dead samples is freed.
	if w.head > 32 && w.head*2 > len(w.samples) {
		w.samples = slices.Clone(slices.Slice(w.samples, w.head, len(w.samples)))
		w.head = 0
	}
}

// Count is the number of samples in w.
func Count(w Sliding) int { len(w.samples) - w.head }

// Sum is the sum of the samples in w.
func Sum(w Sliding) float64 { w.sum }

// Mean is the mean of the samples in w, or None when it is empty.
func Mean(w Sliding) Option[float64] {
	if w.Count() == 0 { None } else { Some{w.sum / float64(w.Count())} }
}

// Percentile is the p-th percentile of values by the nearest rank: the
// smallest value with at least p percent of the values at or below it.
// p is clamped to 1..100. None when values is empty.
func Percentile(values []float64, p int) Option[float64] {
	if len(values) == 0 {
		return None
	}
	let q = if p < 1 { 1 } else if p > 100 { 100 } else { p }
	let sorted = slices.Sort(values)
	let rank = (q*len(sorted) + 99) / 100
	Some{sorted[rank-1]}
}

// PercentileIsARank: a percentile is one of the values, at least p
// percent of the values are at or below it, and it does not fall as p
// rises.
law PercentileIsARank(seed int, p int) {
	let mut values = []float64{}
	for s in run(seed, 25) {
		values = values.Append(s.Value)
	}
	let q = 1 + (if p < 0 { -(p + 1) } else { p })%100
	match (Percentile(values, q), Percentile(values, if q < 100 { q + 1 } else { 100 })) {
	case (Some[float64] as v, Some[float64] as w):
		let mut below = 0
		let mut found = false
		for x in values {
			if x <= v.Value {
				below += 1
			}
			if x == v.Value {
				found = true
			}
		}
		found && below*100 >= q*len(values) && v.Value <= w.Value
	case (_, _):
		false
	}
}
