// Calendar buckets: the samples of each day, week or month of a span of
// dates, in UTC, through std civil.

import civil
import option
import time

// Period is the samples whose UTC day is in Span.
type Period { Span civil.Span, Count int, Sum float64 }

// MillisPerDay is the milliseconds of a UTC day.
let MillisPerDay int64 = 86400000

// DayOf is the UTC day of the millisecond at.
func DayOf(at int64) civil.Date {
	let q = at / MillisPerDay
	civil.FromUnixDays(if at%MillisPerDay < 0 { q - 1 } else { q })
}

// Days is the span from the day of the first sample to the day of the
// last, or None when samples is empty. samples are in time order.
func Days(samples []Sample) option.Option[civil.Span] {
	if samples.Len() == 0 {
		return option.None
	}
	let s = civil.NewSpan(DayOf(samples[0].At), DayOf(samples[samples.Len()-1].At)) catch {
	case civil.Reversed:
		return option.None
	}
	option.Some{s}
}

// Calendar is a period per part of s in the unit u (a day, a week or a
// month of s), empty parts included, in order. A sample outside s is in
// no period. samples are in time order.
func Calendar(samples []Sample, s civil.Span, u civil.Unit) []Period {
	let mut out = []Period{}
	let mut i = 0
	for i < samples.Len() && civil.Before(DayOf(samples[i].At), civil.From(s)) {
		i += 1
	}
	for part in civil.Split(s, u) {
		let mut p = Period{Span: part, Count: 0, Sum: 0}
		for i < samples.Len() && civil.Contains(part, DayOf(samples[i].At)) {
			p.Count += 1
			p.Sum += samples[i].Value
			i += 1
		}
		out = out.Append(p)
	}
	out
}

// CalendarTilesTheSpan: the periods of a span in days, weeks or months
// cover it in order with no gap, and each counts the samples whose day it
// holds. The run's steps are scaled to hours, so it crosses days.
law CalendarTilesTheSpan(seed int, n int, k int) {
	let mut samples = []Sample{}
	for s in run(seed, 40) {
		samples = samples.Append(Sample{At: s.At * 9600, Value: s.Value})
	}
	let m = if n < 0 { -(n + 1) } else { n }
	let a = civil.AddDays(DayOf(samples[0].At), m%5)
	let s = civil.NewSpan(a, civil.AddDays(a, m%40)) catch {
	case civil.Reversed:
		return false
	}
	let u = match (if k < 0 { -(k + 1) } else { k }) % 3 {
	case 0:
		civil.Days
	case 1:
		civil.Weeks{First: time.Monday}
	case _:
		civil.Months
	}
	let mut next = civil.From(s)
	let mut total = 0
	for p in Calendar(samples, s, u) {
		if civil.From(p.Span) != next {
			return false
		}
		let mut count = 0
		for x in samples {
			if civil.Contains(p.Span, DayOf(x.At)) {
				count += 1
			}
		}
		if p.Count != count {
			return false
		}
		next = civil.AddDays(civil.To(p.Span), 1)
		total += p.Count
	}
	let mut inside = 0
	for x in samples {
		if civil.Contains(s, DayOf(x.At)) {
			inside += 1
		}
	}
	next == civil.AddDays(civil.To(s), 1) && total == inside
}
