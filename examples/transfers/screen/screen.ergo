// Package screen is the desk on a screen (stage b): the heading,
// the button that starts a transfer and, while one sends, the
// button that cancels all; then each transfer as a row (its file, its
// size, its status, and Cancel while it sends or Restart once cancelled),
// or a line that says there is none. The view reads the desk and loads
// nothing: the desk's work owns the transfers' time.

import option
import transfers/desk
import transfers/transfer
import ui

// Title is the heading.
let Title = "File Uploads"

// StartLabel and CancelAllLabel are the two buttons above the list.
let StartLabel = "Upload a file"

let CancelAllLabel = "Cancel all"

// Empty is the line shown when there is no transfer.
let Empty = "Nothing here yet. Start an upload."

// Screen is the desk.
func Screen(f mut ui.Frame[desk.Signal], d desk.Desk) {
	ui.Column(f, ui.Plain()) {
		ui.Semantic(f, named(ui.Heading, Title, option.Some{Value: 1}), option.None, ui.Plain()) {
			ui.Text(f, Title)
		}
		button(f, StartLabel, "Upload a file", desk.Begin)
		if anySending(d) {
			button(f, CancelAllLabel, "Cancel all", desk.CancelEvery)
		}
		if d.Rows.Len() == 0 {
			ui.Text(f, Empty)
		}
		ui.Each(f, d.Rows, func(r desk.Row) ui.Key { ui.ByInt(r.ID) }) func(r desk.Row) {
			ui.Same(f, SameKey(r)) {
				row(f, r)
			}
		}
	}
}

// row is one transfer: a group named after it with its file, its size,
// its status and its action.
func row(f mut ui.Frame[desk.Signal], r desk.Row) {
	ui.Semantic(f, named(ui.Group, RowName(r.ID), option.None), option.None, ui.Plain()) {
		ui.Text(f, r.File.Name)
		ui.Text(f, "\(r.File.MB) MB")
		match r.Transfer {
		case transfer.Sending:
			ui.Text(f, "Uploading")
			button(f, CancelLabel(r.ID), "Cancel", desk.At{ID: r.ID, Sig: transfer.Cancel})
		case transfer.Sent:
			ui.Text(f, "Done")
		case transfer.Cancelled:
			ui.Text(f, "Cancelled")
			button(f, RestartLabel(r.ID), "Restart", desk.At{ID: r.ID, Sig: transfer.Restart})
		}
	}
}

// SameKey is all a row shows and sends: its id (which fixes its file and
// size) and its transfer's state. A row's run and due time are the desk's
// timing and are not shown, so a press runs only the rows whose state it
// changed and keeps every other (UI HOT PATHS).
func SameKey(r desk.Row) ui.Key { ui.ByText("\(r.ID)/\(transfer.Word(r.Transfer))") }

// RowPrefix begins the name of each row's group; RowName is row id's.
let RowPrefix = "Upload "

func RowName(id int) string { RowPrefix + "\(id)" }

// CancelLabel and RestartLabel are the names of row id's buttons.
func CancelLabel(id int) string { "Cancel upload \(id)" }

func RestartLabel(id int) string { "Restart upload \(id)" }

func button(f mut ui.Frame[desk.Signal], label string, text string, on desk.Signal) {
	ui.Pressable(f, label, on) {
		ui.Text(f, text)
	}
}

func anySending(d desk.Desk) bool {
	for r in d.Rows {
		if transfer.IsSending(r.Transfer) {
			return true
		}
	}
	false
}

// named is the access of a container with a role and a name.
func named(role ui.Role, name string, level option.Option[int]) ui.Access {
	ui.Access{Role: role, Name: name, Disabled: false, Description: "", Checked: option.None, Value: option.None, Selected: option.None, Expanded: option.None, Pressed: option.None, Invalid: false, Busy: false, HasPopup: false, Level: level, Mixed: false, Current: option.None, Modal: false, MultiSelectable: false, Range: option.None, Key: ui.NoKey, Rels: []ui.Rel{}}
}
