// transfers is an interruptible-transfer program
// (stage b: the view on std ui's test host): file transfers that a user
// starts, cancels one by one or all at once, and restarts. It runs a
// script of timed presses on a manual clock, clicks each press's button on
// the screen, and shows the screen after each one. Package transfer is one
// transfer, a machine whose Sending state owns its time; package board
// holds one live actor per transfer (shape A); package emitted is
// a machine that emits commands to a registry (shape B);
// package desk is the board as one pure machine for the view, and package
// screen is the view; package script reads the script and plays it. This
// binary is the only place that chooses the clock: a time.Manual, so a
// script of minutes takes no wall time. With -stats it also prints the
// work of each press.

import transfers/script
import flag
import io
import os
import time

let statsFlag = flag.Bool("stats", false, "print the work of each press (ui.Counts)")

let set = flag.Set{Name: "transfers", Usage: "", Flags: []flag.Flag{statsFlag}, Args: []flag.ArgSpec{}}

let usage = "usage: transfers [-stats] < script"

func main() fails os.Exit needs io.Console | os.Ambient {
	let v = with context { os.Process: os.NewHost() } {
		flag.Parse(set, os.Process.Args()) catch {
		case err:
			with context { io.Stdout: io.NewHost(), io.Stderr: io.NewErrors() } {
				try flag.Exit(err, usage)
			}
			return
		}
	}
	let clock = time.NewManual(0)
	let status = with context { io.Stdin: io.NewStdin(), time.Scheduler: clock } { script.Run(clock, statsFlag.Get(v)) }
	if status != 0 {
		return os.Exit{Code: 1, Message: "transfers: the script did not run"}
	}
}
