import actor
import transfers/desk
import transfers/screen
import strings
import time
import ui

// Host is the desk on the test host.
type Host = ui.TestHost[desk.Desk, desk.Signal, Decision[desk.Desk, Never]]

// Frame is the screen read after a press:
//
//	Top      the heading, the buttons above the list and the empty line
//	Rows     `ID NAME WORD` per row group, in screen order, with
//	         the status words of shape A (Uploading is sending,
//	         Done is sent, Cancelled is cancelled)
//	Actions  each row's button, or "" for a row with none
//	Counts   the work of the press, from ui.Counts
type Frame { Top []string, Rows []string, Actions []string, Counts ui.StepCounts }

// PlayScreen plays lines on the desk's screen, on std ui's test host over
// clock, as PlayA plays them on the live board. The first frame is the
// screen before any press. For each line it moves the clock to the line's
// time and settles, so each transfer due by then has arrived; clicks the
// line's button and settles; and reads the screen. Then it moves the clock
// to end and reads the screen again. A press whose button is not on the
// screen (a cancel of a transfer that does not send, a restart of one that
// was not cancelled, an id with no row) clicks nothing: the button is not
// there. Each frame goes to show as it is
// read, so a long script keeps none.
func PlayScreen[R](lines []Line, end duration, clock time.Manual, show func(f Frame) needs R) fails actor.Stopped | ui.BadPatch needs R | Scheduler {
	let app = with context { time.Clock: clock } { actor.StartMachine(desk.Desks{}, 16, func(o Never) {}) }
	played(app, lines, end, clock, show) catch {
	case err:
		app.Stop()
		return err
	}
	app.Stop()
}

func played[R](app actor.Actor[desk.Desk, desk.Signal, Decision[desk.Desk, Never]], lines []Line, end duration, clock time.Manual, show func(f Frame) needs R) fails actor.Stopped | ui.BadPatch needs R | Scheduler {
	let mut h = try ui.NewTestHost(app, screen.Screen, clock, 16)
	show(read(&h))
	let mut now = 0s
	for l in lines {
		try ui.Advance(&h, l.At-now)
		try ui.Settle(&h)
		now = l.At
		ui.Play(&h, []ui.Act{ui.ClickOn{At: ui.WithRole{Role: ui.Button, Name: Label(l.Press)}}, ui.SettleAll}) catch {
		case ui.NoNode, ui.Ambiguous, ui.Mismatch:
		case actor.Stopped as s:
			return s
		case ui.BadPatch as p:
			return p
		}
		show(read(&h))
	}
	try ui.Advance(&h, end-now)
	try ui.Settle(&h)
	show(read(&h))
}

// pressWork is the visits of each press after n transfers started: a
// start, a cancel of one and its restart, all before the first arrival
// (UI HOT PATHS; the counts are ui.Counts of the test host, no time).
func pressWork(n int) []int {
	let mut ls = []Line{}
	for i in 0..n {
		ls = ls.Append(Line{At: time.Times(1ms, i), Press: Start})
	}
	ls = ls.Append(Line{At: 1000ms, Press: Start})
	ls = ls.Append(Line{At: 1001ms, Press: Cancel{ID: n / 2}})
	ls = ls.Append(Line{At: 1002ms, Press: Restart{ID: n / 2}})
	let c = time.NewManual(0)
	let mut visits = []int{}
	with context { Scheduler: c } {
		PlayScreen(ls, 1002ms, c, func(f Frame) { visits = visits.Append(f.Counts.Visits) })
	} catch {
	case _:
		return []int{}
	}
	// the frames of the three presses: after the open frame and n starts
	[]int{visits[n+1], visits[n+2], visits[n+3]}
}

test PressWorkIsFlat {
	// A press runs the rows it changed and keeps every other (each row is a
	// ui.Same keyed by its state), so its work is the same at 4 and at 8
	// transfers running.
	let small = pressWork(4)
	assert len(small) == 3 && small == pressWork(8)
}

// Label is the accessible name of the button a press clicks.
func Label(p Press) string {
	match p {
	case Start:
		screen.StartLabel
	case Cancel as c:
		screen.CancelLabel(c.ID)
	case CancelAll:
		screen.CancelAllLabel
	case Restart as r:
		screen.RestartLabel(r.ID)
	}
}

func read(h mut Host) Frame {
	let mut f = Frame{Top: []string{}, Rows: []string{}, Actions: []string{}, Counts: ui.Counts(h)}
	walk(&f, ui.Screen(h))
	f
}

// walk reads shapes into f: a row group becomes a row, a heading its
// text, a button outside a row its label, and a text outside a row
// itself.
func walk(f mut Frame, shapes []ui.Shape[desk.Signal]) {
	for s in shapes {
		match s.Node {
		case ui.SemanticNode as g:
			if g.Access.Role == ui.Heading {
				f.Top = f.Top.Append("# " + strings.Join(textsOf(s.Kids), " "))
				continue
			}
			if strings.HasPrefix(g.Access.Name, screen.RowPrefix) {
				let texts = textsOf(s.Kids)
				let word = if len(texts) < 3 { "?" } else { wordOf(texts[2]) }
				let name = if len(texts) < 1 { "?" } else { texts[0] }
				f.Rows = f.Rows.Append("\(strings.TrimPrefix(g.Access.Name, screen.RowPrefix)) \(name) \(word)")
				f.Actions = f.Actions.Append(strings.Join(buttonsOf(s.Kids), " "))
				continue
			}
		case ui.PressableNode as p:
			f.Top = f.Top.Append("[\(p.Label)]")
			continue
		case ui.TextNode as t:
			f.Top = f.Top.Append(t.Value)
			continue
		case _:
		}
		walk(f, s.Kids)
	}
}

// textsOf is the texts of shapes that are not a button's, in order.
func textsOf(shapes []ui.Shape[desk.Signal]) []string {
	let mut out = []string{}
	for s in shapes {
		match s.Node {
		case ui.TextNode as t:
			out = out.Append(t.Value)
		case ui.PressableNode:
		case _:
			for t in textsOf(s.Kids) {
				out = out.Append(t)
			}
		}
	}
	out
}

// buttonsOf is the labels of the buttons in shapes, as `[LABEL]`.
func buttonsOf(shapes []ui.Shape[desk.Signal]) []string {
	let mut out = []string{}
	for s in shapes {
		match s.Node {
		case ui.PressableNode as p:
			out = out.Append("[\(p.Label)]")
		case _:
			for b in buttonsOf(s.Kids) {
				out = out.Append(b)
			}
		}
	}
	out
}

func wordOf(status string) string {
	match status {
	case "Uploading":
		"sending"
	case "Done":
		"sent"
	case "Cancelled":
		"cancelled"
	case _:
		"? \(status)"
	}
}
