// Package script plays a script of timed button presses on three forms of
// the board: shape A (board, live actors on a time.Manual), shape B
// (emitted, a fold with its registry), and the desk's screen on std ui's
// test host (host.ergo), and shows the screen after each press.

import actor
import transfers/board
import transfers/emitted
import io
import strconv
import strings
import time
import ui

// Press is a button: start the next transfer, cancel one, cancel all, or
// restart one.
type Press = Start{} | Cancel{ID int} | CancelAll{} | Restart{ID int}

// CancelAllLeavesNoneRunning: right after a cancel all, no transfer of the
// live board sends.
law CancelAllLeavesNoneRunning(gaps []int, kinds []int, ids []int) {
	let ls = lines(gaps, kinds, ids)
	let shown = live(ls, if ls.Len() > 0 { ls[ls.Len()-1].At } else { 0s })
	for i, l in ls {
		if l.Press == CancelAll {
			for row in shown[i] {
				if strings.HasSuffix(row, " sending") {
					return false
				}
			}
		}
	}
	true
}

// Line is a press at a time since the start.
type Line { At duration, Press Press }

// IdsNeverReused: the live board's ids are 0, 1, 2, … in the order of the
// starts, after every press: an id is never given twice, and a restart
// keeps its id.
law IdsNeverReused(gaps []int, kinds []int, ids []int) {
	let ls = lines(gaps, kinds, ids)
	for rows in live(ls, if ls.Len() > 0 { ls[ls.Len()-1].At } else { 0s }) {
		for i, row in rows {
			if !strings.HasPrefix(row, "\(i) ") {
				return false
			}
		}
	}
	true
}

// Script is the presses, and the time the run ends.
type Script { Lines []Line, End duration }

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Read reads the lines of a script. Each line is `@MS WORD [ID]`: MS is
// the time in milliseconds, never earlier than the line before, and WORD
// is start, cancel ID, cancelall, restart ID or end, which must be last.
// A blank line or a line that starts with # is skipped.
func Read(text []string) Script fails BadLine {
	let mut lines = []Line{}
	let mut last = 0s
	for i, raw in text {
		let n = i + 1
		let t = strings.TrimSpace(raw)
		let words = strings.Fields(t)
		if words.Len() == 0 || strings.HasPrefix(t, "#") {
			continue
		}
		if words.Len() < 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD"}
		}
		let at = time.Times(1ms, try count(n, strings.TrimPrefix(words[0], "@")))
		if at < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = at
		let word = words[1]
		let press = match word {
		case "end":
			return Script{Lines: lines, End: at}
		case "start":
			Start
		case "cancelall":
			CancelAll
		case "cancel", "restart":
			if words.Len() != 3 {
				return BadLine{Line: n, Why: "\(word) takes one id"}
			}
			let id = try count(n, words[2])
			if word == "cancel" { Cancel{ID: id} } else { Restart{ID: id} }
		case _:
			return BadLine{Line: n, Why: "unknown word \(word)"}
		}
		lines = lines.Append(Line{At: at, Press: press})
	}
	BadLine{Line: text.Len() + 1, Why: "the script has no @MS end line"}
}

func count(n int, word string) int fails BadLine {
	let v = strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	v
}

// PlayA plays lines on shape A, the live board, moving clock to each
// line's time first (so a transfer due by then has arrived), and gives the
// board after each press, then after end.
func PlayA(lines []Line, end duration, clock time.Manual) [][]string needs time.Scheduler {
	let mut b = board.New()
	let mut out = [][]string{}
	let mut now = 0s
	for l in lines {
		time.Advance(clock, l.At-now)
		now = l.At
		match l.Press {
		case Start:
			b.Start()
		case Cancel as c:
			board.Cancel(b, c.ID)
		case CancelAll:
			board.CancelAll(b)
		case Restart as r:
			board.Restart(b, r.ID)
		}
		out = out.Append(board.Lines(b))
	}
	time.Advance(clock, end-now)
	out = out.Append(board.Lines(b))
	out
}

// PlayB plays lines on shape B, the machine with its registry, in the same
// way.
func PlayB(lines []Line, end duration) [][]string {
	let mut w = emitted.Fresh()
	let mut out = [][]string{}
	let mut now = 0s
	for l in lines {
		w = emitted.Wait(w, l.At-now)
		now = l.At
		w = emitted.Press(w, match l.Press {
		case Start:
			emitted.Begin
		case Cancel as c:
			emitted.CancelOne{ID: c.ID}
		case CancelAll:
			emitted.CancelEvery
		case Restart as r:
			emitted.RestartOne{ID: r.ID}
		})
		out = out.Append(emitted.Lines(w))
	}
	w = emitted.Wait(w, end-now)
	out.Append(emitted.Lines(w))
}

// ShapesAgree: the live board of actors (shape A), the machine that emits
// commands to its registry (shape B) and the desk's screen, clicked on the
// test host, show the same transfers in the same states after every press
// and at the end, over generated presses and clock moves.
law ShapesAgree(gaps []int, kinds []int, ids []int, tail int) {
	let ls = lines(gaps, kinds, ids)
	let end = (if ls.Len() > 0 { ls[ls.Len()-1].At } else { 0s }) + time.Times(1ms, pick(tail, 10000))
	let a = live(ls, end)
	a == PlayB(ls, end) && a == onScreen(ls, end)
}

// lines is a generated script: gaps of 0 to 2999 ms, or (for an even
// number) whole tenths of a second up to 9.9 s, which land presses on the
// instants transfers arrive (every file is whole tenths), and presses of
// every kind with ids up to 5, past the transfers a short script starts.
func lines(gaps []int, kinds []int, ids []int) []Line {
	let mut out = []Line{}
	let mut t = 0s
	for i, g in gaps {
		t = t + if pick(g, 2) == 0 { time.Times(100ms, pick(g/2, 100)) } else { time.Times(1ms, pick(g, 3000)) }
		let k = if i < kinds.Len() { kinds[i] } else { 0 }
		let id = pick(if i < ids.Len() { ids[i] } else { i }, 6)
		let press = match pick(k, 4) {
		case 0:
			Start
		case 1:
			Cancel{ID: id}
		case 2:
			CancelAll
		case _:
			Restart{ID: id}
		}
		out = out.Append(Line{At: t, Press: press})
	}
	out
}

// live is shape A over ls until end, on a fresh time.Manual.
func live(ls []Line, end duration) [][]string {
	let c = time.NewManual(0)
	with context { time.Scheduler: c } { PlayA(ls, end, c) }
}

// onScreen is the rows of the desk's screen over ls until end, after each
// press and at the end (the frame before the first press dropped), on a
// fresh time.Manual; a screen that fails gives no rows at all.
func onScreen(ls []Line, end duration) [][]string {
	let c = time.NewManual(0)
	let mut out = [][]string{}
	let mut first = true
	with context { time.Scheduler: c } {
		PlayScreen(ls, end, c, func(f Frame) {
			if !first {
				out = out.Append(f.Rows)
			}
			first = false
		})
	} catch {
	case _:
		return [][]string{}
	}
	out
}

func pick(n int, count int) int { ((n % count) + count) % count }

// Run reads the script from io.Stdin and plays it on the desk's screen
// (PlayScreen). It shows the screen before the first press, after each
// press and at the end: `@MS WHAT`, the line above the list (the heading,
// the buttons and the empty line), and one `  ID NAME WORD [BUTTON]` line
// per transfer; with stats, also the work of the press. It returns the
// exit status: 0, or 1 when the script is refused or the screen fails.
func Run(clock time.Manual, stats bool) int needs io.Console | io.Stdin | time.Scheduler {
	let mut text = []string{}
	for line in io.Stdin.Lines() {
		text = text.Append(line)
	}
	let s = Read(text) catch {
	case BadLine as b:
		io.Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let mut i = 0
	PlayScreen(s.Lines, s.End, clock, func(f Frame) needs io.Console {
		let at = if i == 0 { 0s } else if i <= s.Lines.Len() { s.Lines[i-1].At } else { s.End }
		let what = if i == 0 { "open" } else if i <= s.Lines.Len() { Name(s.Lines[i-1].Press) } else { "end" }
		i = i + 1
		io.Console.Println("@\(time.Count(at, 1ms)) \(what)")
		io.Console.Println("  \(strings.Join(f.Top, " "))")
		for j, r in f.Rows {
			io.Console.Println(if f.Actions[j] == "" { "  \(r)" } else { "  \(r) \(f.Actions[j])" })
		}
		if stats {
			io.Console.Println("  stats: \(ui.CountsLine(f.Counts))")
		}
	}) catch {
	case actor.Stopped:
		io.Console.Println("? the desk stopped")
		return 1
	case ui.BadPatch as p:
		io.Console.Println("? the screen: \(p.Why)")
		return 1
	}
	0
}

// Name is how a press shows.
func Name(p Press) string {
	match p {
	case Start:
		"start"
	case Cancel as c:
		"cancel \(c.ID)"
	case CancelAll:
		"cancelall"
	case Restart as r:
		"restart \(r.ID)"
	}
}
