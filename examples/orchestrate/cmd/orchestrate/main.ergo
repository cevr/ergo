import api
import filepath
import fs
import github.com/cevr/ergo/modules/orchestrate/orchestrate
import github.com/cevr/ergo/modules/orchestrate/orchestrate/orchestratecli
import github.com/cevr/ergo/modules/orchestrate/sqlite
import http
import io
import json
import mcp
import mcp/httpmcp
import mcp/stdio
import option
import orchestrate/server
import os
import os/host
import queue
import rand
import signal
import slices
import strconv
import strings
import task
import time

func storeFlag(args []string) (option.Option[string], []string) fails os.Exit {
	let mut path option.Option[string] = option.None
	let mut rest = []string{}
	let mut i = 0
	let mut stop = false
	for i < args.Len() {
		let a = args[i]
		if !stop && a == "--" {
			stop = true
		}
		if !stop && (a == "--store" || a == "-store") {
			if i+1 >= args.Len() {
				return os.Exit{Code: 2, Message: "orchestrate: --store requires a path"}
			}
			path = option.Some[string]{Value: args[i+1]}
			i = i + 2
			continue
		}
		if !stop && strings.HasPrefix(a, "--store=") {
			path = option.Some[string]{Value: strings.TrimPrefix(a, "--store=")}
			i = i + 1
			continue
		}
		rest = rest.Append(a)
		i = i + 1
	}
	(path, rest)
}

func jsonFirst(args []string) []string {
	for i, a in args {
		if a == "--" {
			return args
		}
		if i > 0 && (a == "--json" || a == "-json") {
			return slices.Concat([]string{a}, slices.Concat(args[0:i], args[i+1:]))
		}
	}
	args
}

func clockOf(now option.Option[string]) time.Clock fails os.Exit needs os.Ambient {
	match now {
	case option.Some[string] as text:
		let sec = strconv.ParseInt(text.Value, 10, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "orchestrate: ORCHESTRATE_NOW is a Unix second, not \(text.Value)"}
		}
		time.NewManual(sec)
	case option.None:
		time.NewHost()
	}
}

type hostFixture {
	Status    host.Status,
	Processes []host.Process,
}

func hostOf(spec option.Option[string]) host.System fails os.Exit needs os.Ambient {
	match spec {
	case option.Some[string] as raw:
		if strings.TrimSpace(raw.Value) == "" {
			return os.Exit{Code: 2, Message: "orchestrate: ORCHESTRATE_HOST_STATIC must not be empty"}
		}
		let fix = json.Decode(json.Codec[hostFixture]{MaxBytes: 1048576, MaxDepth: 32}, raw.Value) catch {
		case _:
			return os.Exit{Code: 2, Message: "orchestrate: invalid ORCHESTRATE_HOST_STATIC JSON"}
		}
		host.NewStatic(fix.Status, fix.Processes) catch {
		case host.Malformed as err:
			return os.Exit{Code: 2, Message: "orchestrate: invalid ORCHESTRATE_HOST_STATIC: \(err.Reason)"}
		}
	case option.None:
		host.NewHost()
	}
}

func defaultStore(process os.Process) string {
	match process.Getenv("XDG_STATE_HOME") {
	case option.Some[string] as x:
		if x.Value != "" {
			return filepath.Join([]string{x.Value, "orchestrate", "ledger.db"})
		}
	case option.None:
	}
	let home = match process.Getenv("HOME") {
	case option.Some[string] as h:
		h.Value
	case option.None:
		"."
	}
	filepath.Join([]string{home, ".local", "state", "orchestrate", "ledger.db"})
}

func openStore(path string) sqlite.Store fails os.Exit needs os.Ambient | go.Foreign {
	if path == ":memory:" {
		return sqlite.OpenMemory() catch {
		case orchestrate.StoreFailed as e:
			return os.Exit{Code: 1, Message: "orchestrate: open :memory: failed: \(e.Reason)"}
		}
	}
	fs.NewHost().MkdirAll(filepath.Dir(path)) catch {
	case fs.Denied, fs.Failed:
		return os.Exit{Code: 1, Message: "orchestrate: cannot make the folder of \(path)"}
	}
	sqlite.Open(path) catch {
	case orchestrate.StoreFailed as e:
		return os.Exit{Code: 1, Message: "orchestrate: open \(path) failed: \(e.Reason)"}
	}
}

func closeStoreQuiet(store sqlite.Store) needs go.Foreign {
	store.Close() catch {
	case orchestrate.StoreFailed:
	}
}

func runEventsCmd(service orchestrate.Service, sys host.System, clock time.Clock, args []string) fails os.Exit needs os.Ambient | io.Console {
	let opts = try parseEventsCommand(args)
	if !opts.follow {
		let page = service.EventsSince(opts.req) catch {
		case orchestrate.InvalidInput as e:
			return os.Exit{Code: 2, Message: "orchestrate events: \(e.Field): \(e.Why)"}
		case orchestrate.StoreFailed as e:
			return os.Exit{Code: 1, Message: "orchestrate events: store failed: \(e.Reason)"}
		}
		if opts.jsonMode {
			io.Console.Println(json.Encode(json.Codec[orchestrate.EventStreamPage]{MaxBytes: 0, MaxDepth: 0}, page))
		} else if page.Items.Len() == 0 {
			io.Console.Println("(no events)")
		} else {
			for item in page.Items {
				io.Console.Println(server.FormatEventLine(item, false))
			}
		}
		return
	}
	let sched = time.NewLiveScheduler()
	let stdout = io.NewHost()
	let stops = signal.Watch([]signal.Stop{signal.Interrupt, signal.Terminate, signal.Hangup})
	let _ = signal.UntilStop(stops) {
		with context { io.Stdout: stdout, time.Clock: clock, time.Scheduler: sched } {
			server.RunEventsFollow(service, option.Some[host.System]{Value: sys}, orchestrate.DefaultReadinessPolicy(), opts.req, opts.interval, opts.jsonMode, 0)
		}
	} catch {
	case signal.Stopped as s:
		signal.Unwatch(stops)
		return os.Exit{Code: signal.StatusOf(s.Kind), Message: ""}
	case orchestrate.InvalidInput as e:
		signal.Unwatch(stops)
		return os.Exit{Code: 2, Message: "orchestrate events: \(e.Field): \(e.Why)"}
	case orchestrate.StoreFailed as e:
		signal.Unwatch(stops)
		return os.Exit{Code: 1, Message: "orchestrate events: store failed: \(e.Reason)"}
	}
	signal.Unwatch(stops)
}

func runMCPCmd(store sqlite.Store, service orchestrate.Service, sys host.System, clock time.Clock, args []string) fails os.Exit needs os.Ambient | go.Foreign {
	if args.Len() > 0 {
		return os.Exit{Code: 2, Message: "orchestrate mcp: unknown argument \(args[0])"}
	}
	let notifier = mcp.NewNotifier(64)
	let hub = server.NewControlHub(store, service, sys, clock, orchestrate.DefaultReadinessPolicy(), option.Some[mcp.Notifier]{Value: notifier}, option.None)
	let sched = time.NewLiveScheduler()
	let stopQ = queue.New[int](4)
	let tr = stdio.New()
	let monitor = task.Go() {
		with context { time.Clock: clock, time.Scheduler: sched } {
			server.RunMonitorLoop(hub, stopQ, 2s, false)
		}
		0
	}
	let _ = server.RunStdioMCP(hub, notifier, tr)
	stopQ.End()
	mcp.Close(notifier)
	server.CloseAllSSE(hub)
	let _ = monitor.Wait()
}

func runHTTPServeLoop(
	hub server.ControlHub,
	ep httpmcp.Endpoint,
	sess httpmcp.Sessions,
	addr string,
	limits http.Limits,
	clock time.Clock,
	sched time.LiveScheduler,
	stopQ queue.Queue[int],
	interval duration,
) int fails os.Exit needs os.Ambient {
	let listener = http.Listen(addr) catch {
	case http.ListenFailed as e:
		return os.Exit{Code: 1, Message: "orchestrate serve: listen \(e.Addr) failed: \(e.Reason)"}
	}
	let monitor = task.Go() {
		with context { time.Clock: clock, time.Scheduler: sched } {
			server.RunMonitorLoop(hub, stopQ, interval, true)
		}
		0
	}
	with context { time.Clock: clock, time.Scheduler: sched } {
		http.Serve(listener, limits, func(req http.Request) http.Response needs http.Streaming {
			server.DispatchHTTP(hub, ep, req)
		})
	} catch {
	case http.InvalidLimits:
	}
	stopQ.End()
	server.CloseAllSSE(hub)
	httpmcp.CloseAllStreams(sess)
	let _ = monitor.Wait()
	0
}

func runServeCmd(store sqlite.Store, service orchestrate.Service, sys host.System, clock time.Clock, args []string) fails os.Exit needs os.Ambient | go.Foreign {
	let (addr, policy, interval) = try parseServeCommand(args)
	let sess = httpmcp.NewSessions(rand.NewSecureHost())
	let hub = server.NewControlHub(store, service, sys, clock, policy, option.None, option.Some[httpmcp.Sessions]{Value: sess})
	let ep = httpmcp.NewFull(hub.Full, httpmcp.Options{
		AllowedOrigins: []string{},
		MaxBodyBytes:   1048576,
		Sessions:       httpmcp.Stateful{Store: sess},
	})
	let limits = http.Limits{
		MaxBodyBytes:      1048576,
		MaxHeaderBytes:    65536,
		IdleTimeout:       60s,
		ReadHeaderTimeout: 10s,
		ReadBodyTimeout:   30s,
	}
	let sched = time.NewLiveScheduler()
	let stopQ = queue.New[int](4)
	let stops = signal.Watch([]signal.Stop{signal.Interrupt, signal.Terminate, signal.Hangup})
	let _ = signal.UntilStop(stops) {
		try runHTTPServeLoop(hub, ep, sess, addr, limits, clock, sched, stopQ, interval)
	} catch {
	case signal.Stopped as s:
		stopQ.End()
		server.CloseAllSSE(hub)
		httpmcp.CloseAllStreams(sess)
		signal.Unwatch(stops)
		return os.Exit{Code: signal.StatusOf(s.Kind), Message: ""}
	case os.Exit as e:
		stopQ.End()
		server.CloseAllSSE(hub)
		httpmcp.CloseAllStreams(sess)
		signal.Unwatch(stops)
		return e
	}
	stopQ.End()
	server.CloseAllSSE(hub)
	httpmcp.CloseAllStreams(sess)
	signal.Unwatch(stops)
}

func main() fails os.Exit needs os.Ambient | io.Console | go.Foreign {
	let process = os.NewHost()
	let clock = try clockOf(process.Getenv("ORCHESTRATE_NOW"))
	let sys = try hostOf(process.Getenv("ORCHESTRATE_HOST_STATIC"))
	let (flagged, args) = try storeFlag(process.Args())
	if args.Len() > 0 && args[0] == "wait" {
		try runWaitCmd(sys, clock, args[1:])
		return
	}
	let path = match flagged {
	case option.Some[string] as p:
		p.Value
	case option.None:
		defaultStore(process)
	}
	let store = try openStore(path)
	let service = orchestrate.NewServiceWithHost(store, clock, sys)
	if args.Len() > 0 && args[0] == "mcp" {
		runMCPCmd(store, service, sys, clock, args[1:]) catch {
		case os.Exit as e:
			closeStoreQuiet(store)
			return e
		}
		closeStoreQuiet(store)
		return
	}
	if args.Len() > 0 && args[0] == "serve" {
		runServeCmd(store, service, sys, clock, args[1:]) catch {
		case os.Exit as e:
			closeStoreQuiet(store)
			return e
		}
		closeStoreQuiet(store)
		return
	}
	if args.Len() > 0 && args[0] == "events" {
		runEventsCmd(service, sys, clock, args[1:]) catch {
		case os.Exit as e:
			closeStoreQuiet(store)
			return e
		}
		closeStoreQuiet(store)
		return
	}
	let out = with context { orchestrate.Api: service } {
		orchestratecli.Run(jsonFirst(args), orchestratecli.Defaults())
	}
	closeStoreQuiet(store)
	try api.ExitAs("orchestrate", out)
}
