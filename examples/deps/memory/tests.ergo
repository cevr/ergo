// Registry's tests. ergo test runs resolve.Index's laws against Registry,
// built by NewRegistry from generated releases; KeepsTheIndexLaws checks
// them again over resolve's steered names (TableOf, NameOf), which meet a
// package with versions far more often than generated names do.
// ResolvesAsTable: Registry resolves as Table does.

import deps/resolve
import deps/semver

test KeepsTheIndexLaws(entries []resolve.Entry, n int) {
	let r = NewRegistry(resolve.TableOf(entries).Releases)
	let name = resolve.NameOf(n)
	let vs = r.Versions(name) catch {
	case resolve.UnknownPackage:
		return
	}
	for i in 1..len(vs) {
		assert semver.Compare(vs[i-1], vs[i]) > 0
	}
	for x in vs {
		let _ = try r.Needs(name, x)
	}
}

test ResolvesAsTable(entries []resolve.Entry, root []resolve.Need) {
	let t = resolve.TableOf(entries)
	let rq = resolve.RootOf(root)
	let a = with context { resolve.Index: t } {
		resolve.Outcome(rq)
	}
	let b = with context { resolve.Index: NewRegistry(t.Releases) } {
		resolve.Outcome(rq)
	}
	assert a == b
}
