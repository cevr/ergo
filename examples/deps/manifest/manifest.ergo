// Package manifest reads a deps manifest: the project's own needs and the
// registry of releases, one line at a time, by a machine whose state is
// the block being read. It is pure.
//
//	# a comment
//	project app
//	  needs web ^2.1
//	  needs log >=1.2 <2
//
//	package web 2.3.1
//	  needs log ^1.4
//
// A needs line belongs to the project or package line above it, and is
// indented. A blank line or a comment changes nothing.

import deps/resolve
import machines
import option
import semver
import slices
import strings

// Manifest is a project's name, its own needs, and the releases it may
// choose from, in the order the manifest lists them.
type Manifest { Project string, Root []resolve.Requirement, Releases []resolve.Release }

// BadLine is a line the manifest cannot read; No counts from 1.
type BadLine { No int, Text string, Reason string }

// Block is what the reader is inside: nothing yet, the project, or a
// package release. Each holds the manifest read so far.
type Block = Top{M Manifest} | InProject{M Manifest} | InRelease{M Manifest}

// Signal is a line of the manifest, or its end.
type Signal = Line{No int, Text string} | End{}

// LineAction says how a line advanced the reader. Only Finish can end it.
type LineAction = Opened{} | Extended{} | Skipped{}

// Reader reads a manifest one line at a time.
type Reader machine[Block, Signal] {
	initial: Start(),
	step:    decide,
}

// Start is the first block: nothing read yet.
func Start() Block {
	Top{M: Manifest{Project: "", Root: []resolve.Requirement{}, Releases: []resolve.Release{}}}
}

// ManifestOf is the manifest that b holds.
func ManifestOf(b Block) Manifest {
	match b {
	case Top as t:
		t.M
	case InProject as p:
		p.M
	case InRelease as r:
		r.M
	}
}

// Finish returns the manifest in b, or fails if no project was declared.
func Finish(b Block) Manifest fails BadLine {
	let m = ManifestOf(b)
	if m.Project == "" {
		return BadLine{No: 0, Text: "", Reason: "the manifest has no project line"}
	}
	m
}

// decide exposes the line actions and end to the general machine runner.
func decide(b Block, s Signal) machines.Decision[Block, Manifest] fails BadLine {
	match s {
	case End:
		machines.Done[Manifest]{Output: try Finish(b)}
	case Line as l:
		let (next, action) = try Step(b, l)
		match action {
		case Opened:
			machines.Enter[Block]{Next: next}
		case Extended:
			machines.Stay[Block]{Next: next}
		case Skipped:
			machines.Ignore
		}
	}
}

// Step reads one line. A project or package opens a block, a needs line
// extends the current block, and blank lines and comments leave it alone.
func Step(b Block, l Line) (Block, LineAction) fails BadLine {
	let text = strings.TrimSpace(stripComment(l.Text))
	if text == "" {
		return (b, Skipped)
	}
	let words = strings.Fields(text)
	let indented = strings.HasPrefix(l.Text, " ") || strings.HasPrefix(l.Text, "\t")
	let m = ManifestOf(b)
	match (words[0], indented) {
	case ("project", false):
		if words.Len() != 2 {
			return BadLine{No: l.No, Text: l.Text, Reason: "write project NAME"}
		}
		if m.Project != "" {
			return BadLine{No: l.No, Text: l.Text, Reason: "a second project line"}
		}
		(InProject{M: Manifest{..m, Project: words[1]}}, Opened)
	case ("package", false):
		if words.Len() != 3 {
			return BadLine{No: l.No, Text: l.Text, Reason: "write package NAME VERSION"}
		}
		let v = semver.Parse(words[2]) catch {
		case semver.Malformed:
			return BadLine{No: l.No, Text: l.Text, Reason: "\(words[2]) is not a version"}
		}
		for r in m.Releases {
			if r.Name == words[1] && r.V == v {
				return BadLine{No: l.No, Text: l.Text, Reason: "\(words[1]) \(semver.Format(v)) is listed twice"}
			}
		}
		let release = resolve.Release{Name: words[1], V: v, Needs: []resolve.Requirement{}}
		(InRelease{M: Manifest{..m, Releases: m.Releases.Append(release)}}, Opened)
	case ("needs", true):
		if words.Len() < 2 {
			return BadLine{No: l.No, Text: l.Text, Reason: "write needs NAME [CONSTRAINT]"}
		}
		let want = resolve.ParseConstraint(strings.Join(slices.Slice(words, 2, words.Len()), " ")) catch {
		case semver.Malformed as c:
			return BadLine{No: l.No, Text: l.Text, Reason: "\(c.Text) names no version"}
		}
		let r = resolve.Requirement{Name: words[1], Want: want}
		match b {
		case Top:
			BadLine{No: l.No, Text: l.Text, Reason: "a needs line belongs under a project or package line"}
		case InProject:
			(InProject{M: Manifest{..m, Root: m.Root.Append(r)}}, Extended)
		case InRelease:
			(InRelease{M: withNeed(m, r)}, Extended)
		}
	case (_, true):
		BadLine{No: l.No, Text: l.Text, Reason: "an indented line is a needs line"}
	case (_, false):
		BadLine{No: l.No, Text: l.Text, Reason: "unknown line; want project, package or an indented needs"}
	}
}

// stripComment is text up to a #.
func stripComment(text string) string {
	match strings.Cut(text, "#") {
	case option.Some[strings.Halves] as h:
		h.Value.Before
	case option.None:
		text
	}
}

// withNeed is m with r added to the needs of its last release. A Manifest
// is a value: the block before keeps its own releases.
func withNeed(m Manifest, r resolve.Requirement) Manifest {
	let mut rs = m.Releases
	let last = rs[rs.Len()-1]
	rs[rs.Len()-1] = resolve.Release{..last, Needs: last.Needs.Append(r)}
	Manifest{..m, Releases: rs}
}

// Read advances through each line and finishes the last block.
func Read(text string) Manifest fails BadLine {
	let mut block = Start()
	let mut no = 0
	for l in strings.Lines(text) {
		no = no + 1
		let (next, _) = try Step(block, Line{No: no, Text: l})
		block = next
	}
	try Finish(block)
}

// ReadInvertsFormat: reading a formatted manifest gives the manifest back.
law ReadInvertsFormat(entries []resolve.Entry, root []resolve.Need) {
	let m = Generated(entries, root)
	try Read(Format(m)) == m
}

// Format is m as manifest text that Read reads back: the project and its
// needs, then each release and its needs, a blank line between blocks.
func Format(m Manifest) string {
	let mut lines = []string{"project " + m.Project}
	for r in m.Root {
		lines = lines.Append(needLine(r))
	}
	for rel in m.Releases {
		lines = lines.Append("")
		lines = lines.Append("package " + rel.Name + " " + semver.Format(rel.V))
		for r in rel.Needs {
			lines = lines.Append(needLine(r))
		}
	}
	strings.Join(lines, "\n") + "\n"
}

func needLine(r resolve.Requirement) string { "  needs " + r.Name + " " + r.Want.Text }

// Generated is the manifest of a generated registry: project app, the
// root's needs, and each release once.
func Generated(entries []resolve.Entry, root []resolve.Need) Manifest {
	let mut rs = []resolve.Release{}
	for r in resolve.TableOf(entries).Releases {
		let mut seen = false
		for x in rs {
			if x.Name == r.Name && x.V == r.V {
				seen = true
			}
		}
		if !seen {
			rs = rs.Append(r)
		}
	}
	Manifest{Project: "app", Root: resolve.RootOf(root), Releases: rs}
}

// NoiseChangesNothing: blank lines, comments and trailing comments do not
// change what a manifest says.
law NoiseChangesNothing(entries []resolve.Entry, root []resolve.Need) {
	let text = Format(Generated(entries, root))
	let noisy = "# deps manifest\n\n" + strings.ReplaceAll(text, "\n", "  # note\n\n")
	Format(try Read(noisy)) == text
}
