// The manifest's tests: examples of each line. Its laws run under ergo
// test.

import machines

func failure(text string) string {
	let _ = Read(text) catch {
	case BadLine as b:
		return "\(b.No): \(b.Reason)"
	}
	"ok"
}

test ReadsBlocks {
	let m = try Read("# x\nproject app\n  needs web ^2.1\n  needs log >=1.2   <2\n\npackage web 2.3.1\n\tneeds log ^1.4 # why\npackage log 1.5.3\n")
	assert m.Project == "app" && m.Root.Len() == 2 && m.Root[1].Want.Text == ">=1.2 <2"
	assert m.Releases.Len() == 2 && m.Releases[0].Needs.Len() == 1 && m.Releases[1].Needs.Len() == 0
	assert Format(m) == "project app\n  needs web ^2.1\n  needs log >=1.2 <2\n\npackage web 2.3.1\n  needs log ^1.4\n\npackage log 1.5.3\n"
}

test BadLinesNameTheirNumber {
	assert failure("project app\nneeds web\n") == "2: unknown line; want project, package or an indented needs"
	assert failure("  needs web\nproject app\n") == "1: a needs line belongs under a project or package line"
	assert failure("project app\n  depends web\n") == "2: an indented line is a needs line"
	assert failure("project app\npackage web two\n") == "2: two is not a version"
	assert failure("project app\npackage web v1.0.0\npackage web 1.0.0\n") == "3: web 1.0.0 is listed twice"
	assert failure("project app\n  needs web ^y\n") == "2: ^y names no version"
	assert failure("project app\nproject b\n") == "2: a second project line"
	assert failure("package web 1.0.0\n") == "0: the manifest has no project line"
	assert failure("project a b\n") == "1: write project NAME"
}

test LineAndFinishHaveSeparateContracts {
	let (project, _) = try Step(Start(), Line{No: 1, Text: "project app"})
	let (withRoot, _) = try Step(project, Line{No: 2, Text: "  needs web"})
	let (withRelease, _) = try Step(withRoot, Line{No: 3, Text: "package web 1.0.0"})
	let m Manifest = try Finish(withRelease)
	assert m.Project == "app" && m.Root.Len() == 1 && m.Releases.Len() == 1

	let top = Start()
	match try decide(top, Line{No: 1, Text: "# only a comment"}) {
	case machines.Ignore:
	case _:
		assert false
	}
	let inProject = match try decide(top, Line{No: 1, Text: "project app"}) {
	case machines.Enter[Block] as e:
		e.Next
	case _:
		top
	}
	match try decide(inProject, Line{No: 2, Text: "  needs web"}) {
	case machines.Stay[Block] as s:
		assert ManifestOf(s.Next).Root.Len() == 1
	case _:
		assert false
	}
	match try decide(inProject, End) {
	case machines.Done[Manifest] as d:
		assert d.Output.Project == "app"
	case _:
		assert false
	}
}
