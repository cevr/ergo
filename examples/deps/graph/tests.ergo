// The graph's tests: examples at string nodes, and the laws restated as
// property tests at int nodes (#162 runs laws; until then these do).

import slices
import strings

func e(from string, to string) Edge[string] { Edge[string]{From: from, To: to} }

func orderText(g Graph[string]) string {
	let order = Order(g) catch {
	case Cycle[string] as c:
		return "cycle " + strings.Join(c.Path, " -> ")
	}
	strings.Join(order, " ")
}

test OrderPutsNeedsFirst {
	let g = Of([]string{"app"}, []Edge[string]{e("app", "web"), e("app", "log"), e("web", "log"), e("web", "http"), e("http", "log")})
	assert orderText(g) == "log http web app"
}

test SmallerReadyNodeFirst {
	let g = Of([]string{"d", "c", "b", "a"}, []Edge[string]{})
	assert orderText(g) == "a b c d"
}

test CycleNamesItsPath {
	let g = Of([]string{}, []Edge[string]{e("app", "a"), e("a", "b"), e("b", "c"), e("c", "a"), e("x", "x")})
	assert orderText(g) == "cycle a -> b -> c -> a"
	assert orderText(Of([]string{}, []Edge[string]{e("x", "x")})) == "cycle x -> x"
}

test PathIsShortest {
	let g = Of([]string{}, []Edge[string]{e("a", "b"), e("b", "c"), e("c", "d"), e("a", "c")})
	match g.Path("a", "d") {
	case Some[[]string] as p:
		assert strings.Join(p.Value, " ") == "a c d"
	case None:
		assert false
	}
	match g.Path("d", "a") {
	case Some[[]string]:
		assert false
	case None:
	}
}

test OrderRespectsEdgesHolds(nodes []int, edges []Edge[int]) {
	let g = Of(nodes, Downhill(edges))
	let order = try Order(g)
	for x in g.Edges() {
		assert slices.Index(order, x.To) < slices.Index(order, x.From)
	}
}

test OrderHasEveryNodeOnceHolds(nodes []int, edges []Edge[int]) {
	let g = Of(nodes, Downhill(edges))
	assert slices.Equal(slices.Sort(try Order(g)), g.Nodes())
}

test OrderIsDeterministicHolds(nodes []int, edges []Edge[int]) {
	let down = Downhill(edges)
	let a = try Order(Of(nodes, down))
	let b = try Order(Of(slices.Reverse(nodes), slices.Reverse(down)))
	assert slices.Equal(a, b)
}

test CycleIsAClosedWalkHolds(nodes []int, edges []Edge[int]) {
	let g = Of(nodes, Crowded(edges))
	let _ = Order(g) catch {
	case Cycle[int] as c:
		assert IsClosedWalk(g, c.Path)
		return
	}
}

// A graph with an edge both ways between two nodes has no order.
test BackEdgeIsACycle(a int, b int) {
	if a == b {
		return
	}
	let g = Of([]int{}, []Edge[int]{Edge[int]{From: a, To: b}, Edge[int]{From: b, To: a}})
	let _ = Order(g) catch {
	case Cycle[int] as c:
		assert len(c.Path) == 3 && IsClosedWalk(g, c.Path)
		return
	}
	assert false
}

test PathFollowsEdgesHolds(edges []Edge[int], a int, b int) {
	let g = Of([]int{Few(a), Few(b)}, Crowded(edges))
	match g.Path(Few(a), Few(b)) {
	case Some[[]int] as p:
		let path = p.Value
		assert path[0] == Few(a) && path[len(path)-1] == Few(b)
		for i in 1..len(path) {
			assert slices.Contains(g.Needs(path[i-1]), path[i])
		}
	case None:
		assert Few(a) != Few(b)
	}
}
