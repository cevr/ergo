// Package graph is a directed graph over any ordered node type, its
// topological order and its cycles. An edge a → b means that a depends
// on b, so b comes first. Every result is deterministic: where the order leaves a
// choice, the smaller node comes first. It is pure.

import cmp
import option
import slices

// Graph is nodes and the edges out of each. Its fields are unexported, so
// only Of and Add build one: every node an edge names is a node.
type Graph[N cmp.Ordered] { nodes []N, edges Map[N, []N] }

// Cycle is a path of edges that comes back to its first node: the first
// and the last node are the same.
type Cycle[N] { Path []N }

// CycleIsAClosedWalk: when a graph has no order, its cycle starts and
// ends at one node and each step is an edge.
law CycleIsAClosedWalk(nodes []int, edges []Edge[int]) {
	let g = Of(nodes, crowded(edges))
	let _ = Order(g) catch {
	case Cycle[int] as c:
		return IsClosedWalk(g, c.Path)
	}
	true
}

// IsClosedWalk reports whether path has two nodes or more, starts and
// ends at one node, and each step is an edge of g.
func IsClosedWalk[N cmp.Ordered](g Graph[N], path []N) bool {
	if path.Len() < 2 || path[0] != path[path.Len()-1] {
		return false
	}
	for i in 1..path.Len() {
		if !slices.Contains(g.Needs(path[i-1]), path[i]) {
			return false
		}
	}
	true
}

// crowded is edges among the nodes 0 to 3, so that generated graphs have
// cycles and paths of more than one step.
func crowded(edges []Edge[int]) []Edge[int] {
	let mut out = []Edge[int]{}
	for x in edges {
		out = out.Append(Edge[int]{From: few(x.From), To: few(x.To)})
	}
	out
}

// few is n's remainder mod 4, from 0 to 3.
func few(n int) int { ((n % 4) + 4) % 4 }

// Edge is a needs b.
type Edge[N] { From N, To N }

// Empty is the graph with no nodes.
func Empty[N cmp.Ordered]() Graph[N] { Graph[N]{nodes: []N{}, edges: Map[N, []N]{}} }

// Of is the graph of nodes and edges; a node an edge names is added.
func Of[N cmp.Ordered](nodes []N, edges []Edge[N]) Graph[N] {
	let mut g = Empty[N]()
	for n in nodes {
		g = g.Add(n)
	}
	for e in edges {
		g = g.Link(e.From, e.To)
	}
	g
}

// Add is g with the node n.
func Add[N cmp.Ordered](g Graph[N], n N) Graph[N] {
	if slices.Contains(g.nodes, n) {
		return g
	}
	let mut edges = g.edges
	edges[n] = []N{}
	Graph[N]{nodes: slices.Sort(g.nodes.Append(n)), edges: edges}
}

// Link is g with the edge from → to, and both nodes.
func Link[N cmp.Ordered](g Graph[N], from N, to N) Graph[N] {
	let h = g.Add(from).Add(to)
	let out = h.Needs(from)
	if slices.Contains(out, to) {
		return h
	}
	let mut edges = h.edges
	edges[from] = slices.Sort(out.Append(to))
	Graph[N]{nodes: h.nodes, edges: edges}
}

// Nodes is every node of g, sorted.
func Nodes[N cmp.Ordered](g Graph[N]) []N { g.nodes }

// Needs is the nodes n has an edge to, sorted.
func Needs[N cmp.Ordered](g Graph[N], n N) []N {
	match g.edges.Get(n) {
	case option.Some[[]N] as out:
		out.Value
	case option.None:
		[]N{}
	}
}

// Edges is every edge of g, by From and then To.
func Edges[N cmp.Ordered](g Graph[N]) []Edge[N] {
	let mut out = []Edge[N]{}
	for n in g.nodes {
		for m in g.Needs(n) {
			out = out.Append(Edge[N]{From: n, To: m})
		}
	}
	out
}

// Order is every node of g with each node after the nodes it needs. Of
// the nodes that are ready at a step, the smallest comes first (Kahn's
// algorithm with a sorted ready set). A graph with a cycle has no order:
// it fails with the cycle that the smallest node left over is on or
// leads to.
func Order[N cmp.Ordered](g Graph[N]) []N fails Cycle[N] {
	let mut waiting = Map[N, int]{}
	let mut users = Map[N, []N]{}
	for n in g.nodes {
		waiting[n] = g.Needs(n).Len()
		for m in g.Needs(n) {
			let before = match users.Get(m) {
			case option.Some[[]N] as u:
				u.Value
			case option.None:
				[]N{}
			}
			users[m] = before.Append(n)
		}
	}
	let mut ready = []N{}
	for n in g.nodes {
		if g.Needs(n).Len() == 0 {
			ready = ready.Append(n)
		}
	}
	let mut order = []N{}
	for ready.Len() > 0 {
		let sorted = slices.Sort(ready)
		let n = sorted[0]
		ready = rest(sorted)
		order = order.Append(n)
		let us = match users.Get(n) {
		case option.Some[[]N] as u:
			u.Value
		case option.None:
			[]N{}
		}
		for u in us {
			let left = count(waiting, u) - 1
			waiting[u] = left
			if left == 0 {
				ready = ready.Append(u)
			}
		}
	}
	if order.Len() < g.nodes.Len() {
		return Cycle[N]{Path: cycleIn(g, order)}
	}
	order
}

// OrderRespectsEdges: in the order of a graph with no cycle, every node
// comes after each node it needs.
law OrderRespectsEdges(nodes []int, edges []Edge[int]) {
	let g = Of(nodes, downhill(edges))
	let order = try Order(g)
	for e in g.Edges() {
		if slices.Index(order, e.To) > slices.Index(order, e.From) {
			return false
		}
	}
	true
}

// downhill is edges with each edge pointing from the higher node to the
// lower, and none from a node to itself: a graph with no cycle. A node is
// higher by its remainder mod 3 and then by value, so an edge goes to a
// larger node as often as to a smaller one, and the order of the ready
// nodes alone does not put each node after its needs.
func downhill(edges []Edge[int]) []Edge[int] {
	let mut out = []Edge[int]{}
	for e in edges {
		if higher(e.From, e.To) {
			out = out.Append(e)
		} else if higher(e.To, e.From) {
			out = out.Append(Edge[int]{From: e.To, To: e.From})
		}
	}
	out
}

func higher(a int, b int) bool {
	let ra = ((a % 3) + 3) % 3
	let rb = ((b % 3) + 3) % 3
	if ra != rb {
		return ra > rb
	}
	a > b
}

// OrderHasEveryNodeOnce: the order is a permutation of the nodes.
law OrderHasEveryNodeOnce(nodes []int, edges []Edge[int]) {
	let g = Of(nodes, downhill(edges))
	slices.Equal(slices.Sort(try Order(g)), g.Nodes())
}

// OrderIsDeterministic: the order does not depend on the order the nodes
// and edges were given in.
law OrderIsDeterministic(nodes []int, edges []Edge[int]) {
	let down = downhill(edges)
	let a = try Order(Of(nodes, down))
	let b = try Order(Of(slices.Reverse(nodes), slices.Reverse(down)))
	slices.Equal(a, b)
}

func count[N comparable](m Map[N, int], k N) int {
	match m.Get(k) {
	case option.Some[int] as n:
		n.Value
	case option.None:
		0
	}
}

// rest is xs without its first element.
func rest[N](xs []N) []N {
	let mut out = []N{}
	for i, x in xs {
		if i > 0 {
			out = out.Append(x)
		}
	}
	out
}

// cycleIn is a cycle among the nodes of g that are not in done: from the
// smallest such node, follow the smallest edge that stays among them
// until a node repeats. Every such node waits on another, so the walk
// never stops before it repeats.
func cycleIn[N cmp.Ordered](g Graph[N], done []N) []N {
	let mut start = g.nodes[0]
	let mut found = false
	for n in g.nodes {
		if !found && !slices.Contains(done, n) {
			start = n
			found = true
		}
	}
	let mut path = []N{start}
	let mut at = start
	for {
		let mut next = at
		let mut moved = false
		for m in g.Needs(at) {
			if !moved && !slices.Contains(done, m) {
				next = m
				moved = true
			}
		}
		let seen = slices.Index(path, next)
		path = path.Append(next)
		if seen >= 0 {
			let mut loop = []N{}
			for i, p in path {
				if i >= seen {
					loop = loop.Append(p)
				}
			}
			return loop
		}
		at = next
	}
}

// Path is the shortest path of edges from a to b, a and b included, or
// None when b cannot be reached. Of two shortest paths, the one through
// smaller nodes comes first.
func Path[N cmp.Ordered](g Graph[N], a N, b N) option.Option[[]N] {
	let mut from = Map[N, N]{}
	let mut seen = []N{a}
	let mut frontier = []N{a}
	for frontier.Len() > 0 {
		let mut next = []N{}
		for n in frontier {
			for m in g.Needs(n) {
				if !slices.Contains(seen, m) {
					seen = seen.Append(m)
					from[m] = n
					next = next.Append(m)
				}
			}
		}
		if slices.Contains(seen, b) {
			return option.Some[[]N]{Value: back(from, a, b)}
		}
		frontier = next
	}
	if a == b {
		return option.Some[[]N]{Value: []N{a}}
	}
	option.None
}

// PathFollowsEdges: a path that Path finds starts at a, ends at b and
// steps along edges.
law PathFollowsEdges(edges []Edge[int], a int, b int) {
	let g = Of([]int{few(a), few(b)}, crowded(edges))
	match g.Path(few(a), few(b)) {
	case option.Some[[]int] as p:
		let path = p.Value
		if path[0] != few(a) || path[path.Len()-1] != few(b) {
			return false
		}
		for i in 1..path.Len() {
			if !slices.Contains(g.Needs(path[i-1]), path[i]) {
				return false
			}
		}
		true
	case option.None:
		few(a) != few(b)
	}
}

// back is the path to b that from records, from a.
func back[N cmp.Ordered](from Map[N, N], a N, b own N) []N {
	let mut path = []N{b}
	let mut at = b
	for at != a {
		match from.Get(at) {
		case option.Some[N] as p:
			at = p.Value
			path = path.Append(at)
		case option.None:
			return slices.Reverse(path)
		}
	}
	slices.Reverse(path)
}
