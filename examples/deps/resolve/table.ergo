// Table and the generated registries that the laws and tests of resolve
// run over.

import option
import semver
import slices

// Table is an Index over a list of releases, in memory. Of two releases
// of one version, the first counts. Package memory's Registry is the
// program's provider; Table lets this package state laws with no import
// of memory, which imports resolve.
type Table { Releases []Release } implements Index

// Versions is every version of name, newest first, each once.
func Versions(t Table, name string) []semver.Version fails UnknownPackage {
	let mut vs = []semver.Version{}
	for r in t.Releases {
		if r.Name == name && !hasVersion(vs, r.V) {
			vs = vs.Append(r.V)
		}
	}
	if vs.Len() == 0 {
		return UnknownPackage{Name: name}
	}
	slices.SortFunc(vs, func(a semver.Version, b semver.Version) int { semver.Compare(b, a) })
}

func hasVersion(vs []semver.Version, v semver.Version) bool {
	for w in vs {
		if w == v {
			return true
		}
	}
	false
}

// Distinct is t with only the first release of each version: the
// releases that count.
func Distinct(t Table) Table {
	let mut rs = []Release{}
	for r in t.Releases {
		if slices.IndexFunc(rs, func(x Release) bool { x.Name == r.Name && x.V == r.V }) < 0 {
			rs = rs.Append(r)
		}
	}
	Table{Releases: rs}
}

// Needs is what the first release name v needs.
func Needs(t Table, name string, v semver.Version) []Requirement fails UnknownPackage | UnknownVersion {
	let _ = try t.Versions(name)
	for r in t.Releases {
		if r.Name == name && r.V == v {
			return r.Needs
		}
	}
	UnknownVersion{Name: name, V: v}
}

// Entry is a generated release: package number, version and needs.
type Entry { Pkg int, V semver.Version, Needs []Need }

// ResolutionIsSound: a resolution keeps every want of the project and of
// each pinned release, and orders each package after what it needs.
law ResolutionIsSound(entries []Entry, root []Need) {
	let t = TableOf(entries)
	let r = RootOf(root)
	with context { Index: t } {
		let p = Resolve(r) catch {
		case _:
			return true
		}
		Sound(t, r, p)
	}
}

// pinned is the version pinned for name in p.
func pinOf(p Plan, name string) option.Option[semver.Version] {
	for pin in p.Pins {
		if pin.Name == name {
			return option.Some[semver.Version]{Value: pin.V}
		}
	}
	option.None
}

// Keeps reports whether p pins r's package to a version that keeps r.
func Keeps(p Plan, r Requirement) bool {
	match pinOf(p, r.Name) {
	case option.Some[semver.Version] as v:
		Allows(r.Want, v.Value)
	case option.None:
		false
	}
}

// Sound reports whether p keeps every requirement of root and of each
// pinned release in t, and pins each package after the packages its
// release needs.
func Sound(t Table, root []Requirement, p Plan) bool {
	for r in root {
		if !Keeps(p, r) {
			return false
		}
	}
	for i, pin in p.Pins {
		let wanted = t.Needs(pin.Name, pin.V) catch {
		case UnknownPackage, UnknownVersion:
			return false
		}
		for r in wanted {
			if !Keeps(p, r) {
				return false
			}
			let at = slices.IndexFunc(p.Pins, func(q Pin) bool { q.Name == r.Name })
			if at > i {
				return false
			}
		}
	}
	true
}

// ResolutionIsDeterministic: the registry's order does not change the
// resolution, nor whether it fails.
law ResolutionIsDeterministic(entries []Entry, root []Need) {
	let r = RootOf(root)
	let a = with context { Index: TableOf(entries) } {
		Outcome(r)
	}
	let b = with context { Index: Table{Releases: slices.Reverse(Distinct(TableOf(entries)).Releases)} } {
		Outcome(r)
	}
	a == b
}

// Text is p as one line, "name version" by pin, in order.
func Text(p Plan) string {
	let mut out = ""
	for pin in p.Pins {
		out = out + pin.Name + " " + semver.Format(pin.V) + ";"
	}
	out
}

// Outcome is the resolution of root as text, or the name of its failure.
func Outcome(root []Requirement) string needs Index {
	let p = Resolve(root) catch {
	case NoVersion as n:
		return "no version of " + n.Name
	case Circular as c:
		return "circular at " + c.Path[0].Name
	case NoPlan:
		return "no plan"
	case TooHard:
		return "too hard"
	case UnknownPackage as u:
		return "unknown " + u.Name
	case UnknownVersion as u:
		return "unknown " + u.Name + " " + semver.Format(u.V)
	}
	Text(p)
}

// Need is a generated requirement: a package number and a caret or an
// at-most bound.
type Need { Pkg int, From semver.Version, Caret bool }

// NameOf is the package name of a generated number: one of three, so that
// generated releases meet.
func NameOf(n int) string {
	let m = n % 3
	"p\(if m < 0 { -m } else { m })"
}

// Few is v with each part 0 to 2, so that generated constraints meet.
func Few(v semver.Version) semver.Version {
	semver.Version{Major: small(v.Major), Minor: small(v.Minor), Patch: small(v.Patch), Pre: []string{}, Build: []string{}}
}

func small(n int) int {
	let m = n % 3
	if m < 0 { -m } else { m }
}

// RequirementOf is the requirement a generated need stands for.
func RequirementOf(n Need) Requirement {
	let v = Few(n.From)
	// A caret need is the one that can fail (0.0.0 keeps every at-most
	// need); half of the needs are carets, so that some registries fail.
	let caret = n.Caret
	let text = (if caret { "^" } else { "<=" }) + semver.Format(v)
	let want = ParseConstraint(text) catch {
	case semver.Malformed:
		Any()
	}
	Requirement{Name: NameOf(n.Pkg), Want: want}
}

// TableOf is the registry of generated entries, after a release 0.0.0
// with no needs of each of the three names. So every name is known and
// every at-most need can be kept, while a caret need, or the needs of a
// newer release, may fail: generated registries reach plans, NoVersion
// and cycles.
func TableOf(entries []Entry) Table {
	let mut rs = []Release{}
	for n in 0..3 {
		rs = rs.Append(Release{Name: NameOf(n), V: semver.Version{Major: 0, Minor: 0, Patch: 0, Pre: []string{}, Build: []string{}}, Needs: []Requirement{}})
	}
	for e in entries {
		let mut wanted = []Requirement{}
		for n in e.Needs {
			wanted = wanted.Append(RequirementOf(n))
		}
		rs = rs.Append(Release{Name: NameOf(e.Pkg), V: Few(e.V), Needs: wanted})
	}
	Table{Releases: rs}
}

// RootOf is the project's requirements: a want of any version of each of
// the three names, then the generated needs. So the search pins every
// name, in name order, and a release pinned later can want an older
// version of one pinned before it: generated registries reach the step
// back that the laws of soundness and determinism are about.
func RootOf(ns []Need) []Requirement {
	let mut out = []Requirement{}
	for n in 0..3 {
		out = out.Append(Requirement{Name: NameOf(n), Want: Any()})
	}
	for n in ns {
		out = out.Append(RequirementOf(n))
	}
	out
}
