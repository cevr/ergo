import tomlparse/toml

// DocumentIsTOML: the workload of every seed is TOML, so the receipts
// time the parse of a document and not a failure at its first value.
law DocumentIsTOML(seed int) {
	let _ = toml.Parse(Document(seed, 40)) catch {
	case toml.Malformed, toml.Duplicate, toml.Clash:
		return false
	}
	true
}
