// Disk over an fstest.Memory, so that ergo test runs the law
// app.Documents.Repeatable on Disk: NewDisk builds the value of each
// case.

import fs
import fstest

// NewDisk is a Disk over a memory file system that holds a.toml.
func NewDisk() Disk {
	let files = fstest.NewMemory()
	files.WriteFile("a.toml", "a = 1\n[b]\nc = \"d\"\n") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
	}
	New(files)
}
