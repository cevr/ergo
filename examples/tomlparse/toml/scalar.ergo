// TOML's integers, floats, and dates and times.

import math
import strconv
import strings

func isDigit(c byte) bool { c >= '0' && c <= '9' }

// digitsAt says whether n decimal digits stand at offset i.
func digitsAt(b *builder, i int, n int) bool {
	if i+n > len(b.src) {
		return false
	}
	for k in i..i+n {
		if !isDigit(b.src[k]) {
			return false
		}
	}
	true
}

// scalar reads a number, or a date or a time, at the next byte.
func scalar(b *builder) Value fails Malformed {
	if digitsAt(b, b.pos, 4) && b.pos+4 < len(b.src) && b.src[b.pos+4] == '-' {
		return try moment(b)
	}
	if digitsAt(b, b.pos, 2) && b.pos+2 < len(b.src) && b.src[b.pos+2] == ':' {
		return try moment(b)
	}
	try numeral(b)
}

// ofBase says whether c is a digit of base.
func ofBase(c byte, base int) bool {
	match base {
	case 16:
		digit(c) >= 0
	case 8:
		c >= '0' && c <= '7'
	case 2:
		c == '0' || c == '1'
	case _:
		isDigit(c)
	}
}

// run is the end of the digits of base at offset i, with one underscore
// at most between two digits, written without the underscores into out.
func run(b *builder, i int, base int, out *strings.Builder) int fails Malformed {
	if i >= len(b.src) || !ofBase(b.src[i], base) {
		return fail(b, i, "expected a digit, found "+found(b, i))
	}
	out.WriteByte(b.src[i])
	let mut j = i + 1
	for j < len(b.src) {
		let c = b.src[j]
		if ofBase(c, base) {
			out.WriteByte(c)
			j += 1
		} else if c == '_' {
			if j+1 >= len(b.src) || !ofBase(b.src[j+1], base) {
				return fail(b, j, "an underscore needs a digit on each side")
			}
			j += 1
		} else {
			break
		}
	}
	j
}

// numeral reads an integer or a float at the next byte.
func numeral(b *builder) Value fails Malformed {
	let start = b.pos
	let mut i = start
	let mut out = strings.NewBuilder()
	if b.src[i] == '+' || b.src[i] == '-' {
		if b.src[i] == '-' {
			out.WriteByte('-')
		}
		i += 1
	}
	let rest = strings.Slice(b.src, i, len(b.src))
	if strings.HasPrefix(rest, "inf") || strings.HasPrefix(rest, "nan") {
		try ended(b, i+3)
		b.pos = i + 3
		let negative = b.src[start] == '-'
		if strings.HasPrefix(rest, "nan") {
			return Float{F: math.NaN()}
		}
		return Float{F: math.Inf(if negative { -1 } else { 1 })}
	}
	if i == start && strings.HasPrefix(rest, "0") && len(rest) > 1 && (rest[1] == 'x' || rest[1] == 'o' || rest[1] == 'b') {
		let base = match rest[1] {
		case 'x':
			16
		case 'o':
			8
		case _:
			2
		}
		let end = try run(b, i+2, base, &out)
		try ended(b, end)
		b.pos = end
		let n = strconv.ParseInt(out.String(), base, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return fail(b, start, "an integer out of range")
		}
		return Int{N: n}
	}
	let whole = i
	i = try run(b, i, 10, &out)
	if b.src[whole] == '0' && i > whole+1 {
		return fail(b, whole, "a number with a leading zero")
	}
	let mut float = false
	if i < len(b.src) && b.src[i] == '.' {
		out.WriteByte('.')
		i = try run(b, i+1, 10, &out)
		float = true
	}
	if i < len(b.src) && (b.src[i] == 'e' || b.src[i] == 'E') {
		out.WriteByte('e')
		i += 1
		if i < len(b.src) && (b.src[i] == '+' || b.src[i] == '-') {
			out.WriteByte(b.src[i])
			i += 1
		}
		i = try run(b, i, 10, &out)
		float = true
	}
	try ended(b, i)
	b.pos = i
	let text = out.String()
	if float {
		let f = strconv.ParseFloat(text) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return fail(b, start, "a float out of range")
		}
		return Float{F: f}
	}
	let n = strconv.ParseInt(text, 10, 64) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return fail(b, start, "an integer out of range")
	}
	Int{N: n}
}

// two is the number the two digits at offset i spell.
func two(b *builder, i int) int { int(b.src[i]-'0')*10 + int(b.src[i+1]-'0') }

// leap says whether year is a leap year.
func leap(year int) bool { year%4 == 0 && (year%100 != 0 || year%400 == 0) }

// days is how many days month has in year.
func days(year int, month int) int {
	match month {
	case 2:
		if leap(year) { 29 } else { 28 }
	case 4, 6, 9, 11:
		30
	case _:
		31
	}
}

// clock reads a time HH:MM:SS with an optional fraction at offset i into
// out, and is the offset after it.
func clock(b *builder, i int, out *strings.Builder) int fails Malformed {
	if !digitsAt(b, i, 2) || i+2 >= len(b.src) || b.src[i+2] != ':' || !digitsAt(b, i+3, 2) || i+5 >= len(b.src) || b.src[i+5] != ':' || !digitsAt(b, i+6, 2) {
		return fail(b, i, "a time is HH:MM:SS")
	}
	if two(b, i) > 23 || two(b, i+3) > 59 || two(b, i+6) > 59 {
		return fail(b, i, "a time out of range")
	}
	let mut j = i + 8
	if j < len(b.src) && b.src[j] == '.' {
		if !digitsAt(b, j+1, 1) {
			return fail(b, j+1, "expected a digit, found "+found(b, j+1))
		}
		j += 1
		for j < len(b.src) && isDigit(b.src[j]) {
			j += 1
		}
	}
	out.WriteString(strings.Slice(b.src, i, j))
	j
}

// moment reads a date, a time or both at the next byte.
func moment(b *builder) Value fails Malformed {
	let start = b.pos
	let mut out = strings.NewBuilder()
	if b.src[start+2] == ':' {
		let end = try clock(b, start, &out)
		try ended(b, end)
		b.pos = end
		return Moment{Kind: LocalTime, Text: out.String()}
	}
	if !digitsAt(b, start, 4) || b.src[start+4] != '-' || !digitsAt(b, start+5, 2) || start+7 >= len(b.src) || b.src[start+7] != '-' || !digitsAt(b, start+8, 2) {
		return fail(b, start, "a date is YYYY-MM-DD")
	}
	let year = two(b, start)*100 + two(b, start+2)
	let month = two(b, start+5)
	let day = two(b, start+8)
	if month < 1 || month > 12 || day < 1 || day > days(year, month) {
		return fail(b, start, "a date out of range")
	}
	out.WriteString(strings.Slice(b.src, start, start+10))
	let mut i = start + 10
	let spaced = i+1 < len(b.src) && b.src[i] == ' ' && isDigit(b.src[i+1])
	if i >= len(b.src) || (b.src[i] != 'T' && b.src[i] != 't' && !spaced) {
		try ended(b, i)
		b.pos = i
		return Moment{Kind: LocalDate, Text: out.String()}
	}
	out.WriteByte('T')
	i = try clock(b, i+1, &out)
	let mut kind Clock = LocalDateTime
	if i < len(b.src) && (b.src[i] == 'Z' || b.src[i] == 'z') {
		out.WriteByte('Z')
		i += 1
		kind = OffsetDateTime
	} else if i < len(b.src) && (b.src[i] == '+' || b.src[i] == '-') {
		if !digitsAt(b, i+1, 2) || i+3 >= len(b.src) || b.src[i+3] != ':' || !digitsAt(b, i+4, 2) {
			return fail(b, i, "an offset is +HH:MM or -HH:MM")
		}
		if two(b, i+1) > 23 || two(b, i+4) > 59 {
			return fail(b, i, "an offset out of range")
		}
		out.WriteString(strings.Slice(b.src, i, i+6))
		i += 6
		kind = OffsetDateTime
	}
	try ended(b, i)
	b.pos = i
	Moment{Kind: kind, Text: out.String()}
}
