// Package memory is a Documents provider over texts held in memory, for
// tests: a document is named by a key.

import option
import tomlparse/app

// Texts holds the documents by name.
type Texts { Documents Map[string, string] } implements app.Documents

// Read is the document named path.
func Read(t Texts, path string) string fails app.Unreadable {
	match t.Documents.Get(path) {
	case option.Some[string] as s:
		s.Value
	case option.None:
		app.Unreadable{Path: path, Reason: "no such document"}
	}
}
