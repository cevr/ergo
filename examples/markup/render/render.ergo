// Package render writes a document as lines of markup. Each block adds
// its opening line, its body and its closing line to the output in one
// chain of Appends: the chain writes the output in place, since each link
// owns the slice the one before it made (the entry rule,
// docs/spec/types.md, Bindings), so a render costs its lines, not the
// square of them.

// Block is one block of a document.
type Block = Heading{Level int, Text string} | Para{Text string} | Quote{Lines []string} | Rule{}

// Lines is the markup of the document, one line a slot.
func Lines(doc []Block) []string {
	let mut out = []string{}
	for b in doc {
		match b {
		case Heading as h:
			out = out.Append("<h\(h.Level)>").Append(h.Text).Append("</h\(h.Level)>")
		case Para as p:
			out = out.Append("<p>").Append(p.Text).Append("</p>")
		case Quote as q:
			out = out.Append("<blockquote>")
			for l in q.Lines {
				out = out.Append("  ").Append(l)
			}
			out = out.Append("</blockquote>")
		case Rule:
			out = out.Append("<hr>")
		}
	}
	out
}

// ThreeLinesABlock: n paragraphs render to 3n lines, each body between
// its tags.
law ThreeLinesABlock(n int) {
	let k = count(n)
	let mut doc = []Block{}
	for i in 0..k {
		doc = doc.Append(Para{Text: "p\(i)"})
	}
	let out = Lines(doc)
	let mut ok = len(out) == 3*k
	for i in 0..k {
		ok = ok && out[3*i] == "<p>" && out[3*i+1] == "p\(i)" && out[3*i+2] == "</p>"
	}
	ok
}

func count(n int) int { (if n < 0 { -(n + 1) } else { n }) % 7 }

// QuoteIndents: a quote of n lines renders to 2n + 2 lines.
law QuoteIndents(n int) {
	let k = count(n)
	let mut ls = []string{}
	for i in 0..k {
		ls = ls.Append("q\(i)")
	}
	len(Lines([]Block{Quote{Lines: ls}, Rule})) == 2*k+3
}

// Tagged is the lines of doc with a header and a footer around them, made
// from a document's lines the caller keeps: those lines are not changed.
func Tagged(lines []string, title string) []string {
	lines.Append("<!-- \(title) -->").Append("<!-- end -->")
}

// TaggedKeepsItsInput: Tagged adds two lines and leaves the caller's
// lines as they were.
law TaggedKeepsItsInput(n int) {
	let lines = Lines([]Block{Heading{Level: 1 + count(n), Text: "t"}})
	let a = Tagged(lines, "a")
	let b = Tagged(lines, "b")
	len(lines) == 3 && len(a) == 5 && len(b) == 5 && a[3] == "<!-- a -->" && b[3] == "<!-- b -->" && lines[2] == "</h\(1 + count(n))>"
}
