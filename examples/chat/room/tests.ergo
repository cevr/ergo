// The room's tests: examples (the laws run in laws.ergo).

import time

test JoinSayLeave {
	let s = try Apply(try Apply(Start(), Join{Name: "ada"}), Join{Name: "bob"})
	assert Members(s) == []string{"ada", "bob"}
	let es = try Decide(s, Say{From: "bob", Text: "hi"}, time.Unix(3723, 0))
	assert len(es) == 1 && Render(es[0]) == "[01:02:03] bob: hi"
	assert Members(try Apply(s, Leave{Name: "ada"})) == []string{"bob"}
}

// refusal is the name of the failure of sig in s, or "ok".
func refusal(s State, sig Signal) string {
	let _ = Apply(s, sig) catch {
	case NameTaken as n:
		return "taken \(n.Name)"
	case NotMember as n:
		return "not member \(n.Name)"
	case RoomClosed:
		return "closed"
	}
	"ok"
}

test RefusalsAreTyped {
	let s = RoomOf([]string{"ada"})
	assert refusal(s, Join{Name: "ada"}) == "taken ada"
	assert refusal(s, Say{From: "eve", Text: "x"}) == "not member eve"
	assert refusal(s, Shut{By: "eve"}) == "not member eve"
	assert refusal(try Apply(s, Shut{By: "ada"}), Join{Name: "bob"}) == "closed"
}

test RendersEveryEvent {
	assert Render(Joined{Name: "ada"}) == "* ada joined"
	assert Render(Left{Name: "ada"}) == "* ada left"
	assert Render(Closed{By: "ada"}) == "* ada closed the room"
}

test StepEmitsItsEvents {
	match try Step(Start(), Join{Name: "ada"}) {
	case Emit[State, []Event] as e:
		assert Members(e.Next) == []string{"ada"}
		assert e.Output == []Event{Joined{Name: "ada"}}
	case _:
		assert false
	}
}
