// Package room is the domain of the chat: who is in the room, what they
// said, and the rules of joining, leaving, speaking and closing. It is
// pure and event-sourced: Decide checks a signal against the state and
// records its events; Evolve folds an event into the state and decides
// nothing.

import civil
import machines
import slices
import time

// Signal is what a client asks of the room.
type Signal = Join{Name string} | Leave{Name string} | Say{From string, Text string} | Shut{By string}

// JoinAppendsOrRefuses: a join adds the name at the end, or fails with
// NameTaken exactly when the name is a member.
law JoinAppendsOrRefuses(names []string, name string) {
	let s = roomOf(names)
	let taken = slices.Contains(Members(s), name)
	let after = Apply(s, Join{Name: name}) catch {
	case NameTaken:
		return taken
	case NotMember:
		return false
	case RoomClosed:
		return false
	}
	!taken && Members(after) == Members(s).Append(name)
}

// roomOf is the room after each of names joins in turn; a name that is
// taken is skipped.
func roomOf(names []string) State {
	let mut s = Start()
	for n in names {
		s = Apply(s, Join{Name: n}) catch {
		case NameTaken:
			s
		case NotMember:
			s
		case RoomClosed:
			s
		}
	}
	s
}

// Apply is s after the events of sig at time zero.
func Apply(s State, sig Signal) State fails NameTaken | NotMember | RoomClosed {
	let mut next = s
	for e in try Decide(s, sig, time.Unix(0, 0)) {
		next = Evolve(next, e)
	}
	next
}

// SayNeedsMember: a say fails with NotMember exactly when its sender is
// not a member, and changes no member when it succeeds.
law SayNeedsMember(names []string, n int, text string) {
	let s = roomOf(names)
	// from is a member half the time: a name of names, or a new one.
	let from = if names.Len() > 0 && n%2 == 0 { names[(if n < 0 { -n } else { n })%names.Len()] } else { "stranger" }
	let after = Apply(s, Say{From: from, Text: text}) catch {
	case NotMember:
		return !slices.Contains(Members(s), from)
	case NameTaken:
		return false
	case RoomClosed:
		return false
	}
	slices.Contains(Members(s), from) && Members(after) == Members(s)
}

// LeaveUndoesJoin: a new name that joins and leaves gives the room back.
law LeaveUndoesJoin(names []string, name string) {
	let s = roomOf(names)
	if slices.Contains(Members(s), name) {
		return true
	}
	let back = Apply(try Apply(s, Join{Name: name}), Leave{Name: name}) catch {
	case NotMember:
		return false
	case NameTaken:
		return false
	case RoomClosed:
		return false
	}
	Members(back) == Members(s)
}

// ClosedRefusesAll: after a member shuts the room, every signal fails
// with RoomClosed.
law ClosedRefusesAll(names []string, name string, text string) {
	if names.Len() == 0 {
		return true
	}
	let shut = try Apply(roomOf(names), Shut{By: names[0]})
	for sig in []Signal{Join{Name: name}, Leave{Name: names[0]}, Say{From: names[0], Text: text}, Shut{By: names[0]}} {
		let _ = Apply(shut, sig) catch {
		case RoomClosed:
			continue
		case NameTaken:
			return false
		case NotMember:
			return false
		}
		return false
	}
	Members(shut).Len() == 0
}

// Event is what happened in the room, in the past tense.
type Event = Joined{Name string} | Left{Name string} | Said{From string, Text string, At time.Time} | Closed{By string}

// State is the room: open with its members in the order they joined, or
// closed. A machine's state is a union (G-ex-c-16).
type State = Open{Members []string} | Shutdown{}

// The failures of Decide.

// NameTaken is a join under the name of a member.
type NameTaken { Name string }

// NotMember is a leave, a say or a shut by a name that is not a member.
type NotMember { Name string }

// RoomClosed is any signal after the room is closed.
type RoomClosed {}

// Start is the room before anyone joins: open and empty.
func Start() State { Open{Members: []string{}} }

// Decide is the events of sig in s at the time now.
func Decide(s State, sig Signal, now time.Time) []Event fails NameTaken | NotMember | RoomClosed {
	match s {
	case Shutdown:
		RoomClosed
	case Open as o:
		match sig {
		case Join as j:
			if slices.Contains(o.Members, j.Name) {
				return NameTaken{Name: j.Name}
			}
			[]Event{Joined{Name: j.Name}}
		case Leave as l:
			try member(o, l.Name)
			[]Event{Left{Name: l.Name}}
		case Say as y:
			try member(o, y.From)
			[]Event{Said{From: y.From, Text: y.Text, At: now}}
		case Shut as x:
			try member(o, x.By)
			[]Event{Closed{By: x.By}}
		}
	}
}

// member fails with NotMember unless name is a member of o.
func member(o Open, name string) fails NotMember {
	if !slices.Contains(o.Members, name) {
		return NotMember{Name: name}
	}
}

// Evolve is s after the event e.
func Evolve(s State, e Event) State {
	match s {
	case Shutdown:
		s
	case Open as o:
		match e {
		case Joined as j:
			Open{Members: o.Members.Append(j.Name)}
		case Left as l:
			Open{Members: slices.Filter(o.Members, func(n string) bool { n != l.Name })}
		case Said:
			s
		case Closed:
			Shutdown
		}
	}
}

// Step is the room as a machine's transition: the events of sig folded
// into s, and emitted. A machine has no clock, so a Said is stamped at
// time zero; the server, which stamps each say with its clock, calls
// Decide and Evolve itself.
func Step(s State, sig Signal) machines.Decision[State, []Event] fails NameTaken | NotMember | RoomClosed {
	let events = try Decide(s, sig, time.Unix(0, 0))
	let mut next = s
	for e in events {
		next = Evolve(next, e)
	}
	machines.Emit[State, []Event]{Next: next, Output: events}
}

// Room is the chat room as a machine.
type Room machine[State, Signal] {
	initial: Start(),
	step:    Step,
}

// Members is the members of s, in the order they joined.
func Members(s State) []string {
	match s {
	case Open as o:
		o.Members
	case Shutdown:
		[]string{}
	}
}

// Render is the line that every member reads for e.
func Render(e Event) string {
	match e {
	case Joined as j:
		"* \(j.Name) joined"
	case Left as l:
		"* \(l.Name) left"
	case Said as s:
		"[\(civil.FormatDateTime(civil.DateTimeOf(s.At), civil.ClockSeconds))] \(s.From): \(s.Text)"
	case Closed as c:
		"* \(c.By) closed the room"
	}
}
