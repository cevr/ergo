// ergo-work is `ergo work`: copy-on-write workspaces of one base checkout
// (module work, modules/work). `ergo work ARGS` runs it as ergo-work from
// PATH. Its commands are the generated command line of work.Api
// (work/workcli): init, new, adopt, list, rm, gc, du; --json prints every
// answer as JSON.
//
// This binary is the only place that chooses the providers: the Cloners
// that share blocks in the order the file system is tried (a btrfs
// snapshot, a reflink per file, clonefile), the plain copy (made only
// when asked), the journal registry beside the base, git, and the host's
// files, commands and clock.
//
// The base is ERGO_WORK_BASE when it is set; else, from the working
// folder up, the base of the workspace it is in (a folder of
// .ergo-work/REPO/ is a workspace of the base REPO beside .ergo-work),
// or the first folder with a .git; else the working folder. A relative
// ERGO_WORK_BASE stays relative, so every path the tool prints is relative
// to the working folder (the cases print the same lines on every host).
// ERGO_WORK_NOW, a Unix second, fixes the clock for the same reason.

import exec
import filepath
import fs
import github.com/cevr/ergo/modules/work/btrfs
import github.com/cevr/ergo/modules/work/clonefile
import github.com/cevr/ergo/modules/work/copy
import github.com/cevr/ergo/modules/work/git
import github.com/cevr/ergo/modules/work/journal
import github.com/cevr/ergo/modules/work/reflink
import github.com/cevr/ergo/modules/work/work
import github.com/cevr/ergo/modules/work/work/workcli
import os
import strconv
import strings
import time

// baseOf is the base of the working folder cwd, as the head says.
func baseOf(files fs.Files, cwd string) string {
	let mut dir = filepath.Clean(cwd)
	for {
		let home = filepath.Dir(dir)
		if filepath.Base(filepath.Dir(home)) == ".ergo-work" {
			return filepath.Join([]string{filepath.Dir(filepath.Dir(home)), filepath.Base(home)})
		}
		let found = files.Stat(filepath.Join([]string{dir, ".git"})) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			fs.Info{Name: "", Size: 0, Dir: false, Perm: 0}
		}
		if found.Name != "" {
			return dir
		}
		if home == dir {
			return filepath.Clean(cwd)
		}
		dir = home
	}
}

// clockOf is the clock: the host's, or a clock fixed at the Unix second
// now says.
func clockOf(now Option[string]) time.Clock fails os.Exit needs Ambient {
	match now {
	case Some[string] as text:
		let sec = strconv.ParseInt(text.Value, 10, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "ergo work: ERGO_WORK_NOW is a Unix second, not \(text.Value)"}
		}
		time.NewManual(sec)
	case None:
		time.NewHost()
	}
}

func main() fails os.Exit needs Ambient | Console {
	let process = os.NewHost()
	let cwd = process.Getwd() catch {
	case os.NoWorkdir as n:
		return os.Exit{Code: 1, Message: "ergo work: \(n.Message)"}
	}
	let files = fs.NewHost()
	let base = match process.Getenv("ERGO_WORK_BASE") {
	case Some[string] as b:
		filepath.Clean(b.Value)
	case None:
		baseOf(files, cwd)
	}
	let run = exec.NewHost()
	let sharing = []work.Cloner{btrfs.New(run), reflink.New(run), clonefile.New(run)}
	let tool = work.NewTool(base, sharing, copy.New(run), journal.Open(files, files, work.RegistryFile(base)), git.New(run), files, files, run, try clockOf(process.Getenv("ERGO_WORK_NOW")), cwd)
	let o = with context { work.Api: tool } { workcli.Run(process.Args()) }
	if o.Out != "" {
		Console.Println(strings.TrimSuffix(o.Out, "\n"))
	}
	if o.Code != 0 {
		let code = os.ParseCode(o.Code) catch {
		case Unsatisfied:
			Unreachable("the generated CLI's Run gives status 0, 1 or 2")
			os.ParseCode(1) catch {
			case Unsatisfied:
				return
			}
		}
		// With --json the failure's JSON is the answer on standard output;
		// an Exit always writes a line, so it says where the answer went.
		if o.Err == "" {
			return os.Exit{Code: code, Message: "ergo work: failed; the JSON on standard output says why"}
		}
		return os.Exit{Code: code, Message: "ergo work: " + strings.TrimSuffix(o.Err, "\n")}
	}
}
