// work: copy-on-write workspaces of any Git repository (module work,
// modules/work). `ergo work ARGS` runs it from PATH; it needs no Ergo
// module. Its commands are the generated command line of work.Api
// (work/workcli): init, new, adopt, adopt-rift, list, rm, gc, du,
// plugin-test, ready, sync, env, merge-file, merge-folders, derive, deps,
// trust, doctor, refresh, bases, shell-init and import-rift; --json,
// before the command or after it, prints every answer as JSON.
//
// This binary is the only place that chooses the providers: the Cloners
// that share blocks in the order the file system is tried (a btrfs
// snapshot, a reflink per file, clonefile), the plain copy (made only
// when asked), the journal registry and its lock in the base's storage,
// the hooks by sh, git, and the host's files, commands and clock. The
// registry's lock waits at most 10 seconds for another work, then the
// command fails Locked.
//
// The base is WORK_BASE when it is set; else, from the working folder
// up, the base of the workspace it is in (its folder in a .work/REPO/
// beside the base, the default storage), or the first
// folder with a .git (or the base whose registry holds that folder: an
// adopted copy); else the working folder. A relative WORK_BASE
// stays relative, so every path the tool prints is relative to the
// working folder (the cases print the same lines on every host), and "."
// is the working folder itself. WORK_NOW, a Unix second, fixes the clock
// for the same reason. The list of bases is in XDG_DATA_HOME/work (by
// default ~/.local/share/work).

import api
import embed
import exec
import filepath
import fs
import github.com/cevr/ergo/modules/work/btrfs
import github.com/cevr/ergo/modules/work/clonefile
import github.com/cevr/ergo/modules/work/copy
import github.com/cevr/ergo/modules/work/git
import github.com/cevr/ergo/modules/work/journal
import github.com/cevr/ergo/modules/work/reflink
import github.com/cevr/ergo/modules/work/sh
import github.com/cevr/ergo/modules/work/system
import github.com/cevr/ergo/modules/work/work
import github.com/cevr/ergo/modules/work/work/workcli
import io
import option
import os
import slices
import strconv
import strings
import time

let BuildStamp = embed.File[string]("version.txt")

// baseOf is the base of the working folder cwd, as the head says; a
// folder with a .git that a registered base's registry holds as a
// workspace (an adopted copy) has that base (journal.BaseHolding over
// the list of bases in data, "" for none).
func baseOf(files fs.Files, cwd string, data string) string {
	let mut dir = filepath.Clean(cwd)
	for {
		let home = filepath.Dir(dir)
		if filepath.Base(filepath.Dir(home)) == ".work" {
			return filepath.Join([]string{filepath.Dir(filepath.Dir(home)), filepath.Base(home)})
		}
		let found = files.Stat(filepath.Join([]string{dir, ".git"})) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			fs.Info{Name: "", Size: 0, Dir: false, Perm: 0}
		}
		if found.Name != "" {
			let held = if data == "" { "" } else { journal.BaseHolding(files, data, dir) }
			return if held != "" { held } else { dir }
		}
		if home == dir {
			return filepath.Clean(cwd)
		}
		dir = home
	}
}

// jsonFirst is args with a --json written after the command moved before
// it, where the command line reads it (workcli.Run takes [--json] COMMAND
// ARGS...), so `work list --json` is `work --json list`. An argument
// after "--" is an operand and stays.
func jsonFirst(args []string) []string {
	for i, a in args {
		if a == "--" {
			return args
		}
		if i > 0 && (a == "--json" || a == "-json") {
			return slices.Concat([]string{a}, slices.Concat(args[0:i], args[i+1:]))
		}
	}
	args
}

// clockOf is the clock: the host's, or a clock fixed at the Unix second
// now says.
func clockOf(now option.Option[string]) time.Clock fails os.Exit needs os.Ambient {
	match now {
	case option.Some[string] as text:
		let sec = strconv.ParseInt(text.Value, 10, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "work: WORK_NOW is a Unix second, not \(text.Value)"}
		}
		time.NewManual(sec)
	case option.None:
		time.NewHost()
	}
}

func main() fails os.Exit needs os.Ambient | io.Console {
	let process = os.NewHost()
	let cwd = process.Getwd() catch {
	case os.NoWorkdir as n:
		return os.Exit{Code: 1, Message: "work: \(n.Message)"}
	}
	let files = fs.NewHost()
	let shared = match process.Getenv("XDG_DATA_HOME") {
	case option.Some[string] as x:
		filepath.Join([]string{x.Value, "work"})
	case option.None:
		match process.Getenv("HOME") {
		case option.Some[string] as h:
			filepath.Join([]string{h.Value, ".local", "share", "work"})
		case option.None:
			""
		}
	}
	let base = match process.Getenv("WORK_BASE") {
	case option.Some[string] as b:
		// "." is the working folder: its storage beside it must not be
		// inside it.
		if filepath.Clean(b.Value) == "." { filepath.Clean(cwd) } else { filepath.Clean(b.Value) }
	case option.None:
		baseOf(files, cwd, shared)
	}
	let home = work.Home(base, work.StorageOf(files, base))
	let data = if shared != "" { shared } else { filepath.Join([]string{home, ".data"}) }
	// Git, clone tools and hooks run with the user's explicit environment.
	let run = exec.NewHost().InheritEnv(process.Environ())
	let resolve = func(name string) string {
		with context { os.Process: process, fs.Files: files } {
			exec.LookPath(name) catch {
			case exec.NotFound, exec.Denied:
				""
			}
		}
	}
	let trees = system.New(run, resolve)
	let stamp = strings.TrimSpace(BuildStamp)
	let p = work.Providers{
		Cloners:  []work.Cloner{btrfs.New(trees), reflink.New(trees), clonefile.New(trees)},
		Copier:   copy.New(trees),
		Registry: journal.Open(files, files, work.RegistryFile(home), stamp),
		Lock:     journal.NewLock(files, home, 10s),
		Hooks:    sh.NewHooks(run),
		Vcs:      git.New(run),
		Files:    files,
		Writes:   files,
		Runner:   run,
		Clock:    try clockOf(process.Getenv("WORK_NOW")),
	}
	let tool = work.NewTool(base, home, data, p, cwd).WithVersion(stamp)
	try api.ExitAs("work", with context { work.Api: tool } { workcli.Run(jsonFirst(process.Args()), workcli.Defaults()) })
}
