// Disk over an fstest.Memory, so that ergo test runs the law
// script.Sources.Repeatable on Disk: NewDisk builds the value of each
// case.

import fs
import fstest

// NewDisk is a Disk over a memory file system that holds a.tw.
func NewDisk() Disk {
	let files = fstest.NewMemory()
	files.WriteFile("a.tw", "print(1)\n") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
	}
	New(files)
}
