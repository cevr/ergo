import machines
import strconv
import strings

// LexError is a text that is no token.
type LexError { At Pos, Msg string }

// Puncts are the punctuation tokens, the two-byte ones first, so that <=
// is one token and not < and =.
let Puncts = []string{"<=", ">=", "==", "!=", "(", ")", "{", "}", "[", "]", ",", ":", ".", "+", "-", "*", "/", "%", "<", ">", "="}

// Lex is the tokens of src, ended by an End token. Spaces, tabs, returns
// and newlines separate tokens; // starts a comment that runs to the end
// of the line. A number is a run of digits, with a fraction when a dot
// and a digit follow it.
func Lex(src string) []Token fails LexError {
	let mut toks = []Token{}
	let mut i = 0
	let mut line = 1
	let mut lineStart = 0
	let mut fresh = true
	for i < src.Len() {
		let c = src[i]
		if c == '\n' {
			i += 1
			line += 1
			lineStart = i
			fresh = true
			continue
		}
		if c == ' ' || c == '\t' || c == '\r' {
			i += 1
			continue
		}
		if c == '/' && i+1 < src.Len() && src[i+1] == '/' {
			for i < src.Len() && src[i] != '\n' {
				i += 1
			}
			continue
		}
		let at = Pos{Line: line, Col: i - lineStart + 1}
		let start = i
		if IsLetter(c) {
			for i < src.Len() && (IsLetter(src[i]) || IsDigit(src[i])) {
				i += 1
			}
			let w = strings.Slice(src, start, i)
			let kind Kind = if IsKeyword(w) { Keyword } else { Ident }
			toks = toks.Append(Token{Kind: kind, Text: w, At: at, Fresh: fresh})
		} else if IsDigit(c) {
			for i < src.Len() && IsDigit(src[i]) {
				i += 1
			}
			let fraction = i+1 < src.Len() && src[i] == '.' && IsDigit(src[i+1])
			if fraction {
				i += 1
				for i < src.Len() && IsDigit(src[i]) {
					i += 1
				}
			}
			let kind Kind = if fraction { FloatTok } else { IntTok }
			toks = toks.Append(Token{Kind: kind, Text: strings.Slice(src, start, i), At: at, Fresh: fresh})
		} else if c == '"' {
			let (text, end) = try quoted(src, i+1, at)
			i = end
			toks = toks.Append(Token{Kind: StrTok, Text: text, At: at, Fresh: fresh})
		} else {
			let p = punctAt(src, i)
			if p == "" {
				return LexError{At: at, Msg: "unexpected character " + strconv.Quote(strings.Slice(src, i, i+1))}
			}
			i += p.Len()
			toks = toks.Append(Token{Kind: Punct, Text: p, At: at, Fresh: fresh})
		}
		fresh = false
	}
	toks.Append(Token{Kind: End, Text: "", At: Pos{Line: line, Col: src.Len() - lineStart + 1}, Fresh: fresh})
}

// TokensStandInOrder: the tokens of a text stand in order, each after the
// one before it, and End is last, after them all.
law TokensStandInOrder(src string) {
	let toks = Lex(src) catch {
	case LexError:
		return true
	}
	let mut line = 0
	let mut col = 0
	for i, t in toks {
		let after = t.At.Line > line || (t.At.Line == line && t.At.Col > col)
		if !after {
			return false
		}
		match t.Kind {
		case End:
			if i != toks.Len()-1 {
				return false
			}
		case Ident, Keyword, IntTok, FloatTok, StrTok, Punct:
		}
		line = t.At.Line
		col = t.At.Col
	}
	true
}

// quoted reads a string literal whose body starts at byte from of src,
// with the machine Quoting: it is the literal's value and the byte after
// its closing quote.
func quoted(src string, from int, at Pos) (string, int) fails LexError {
	let mut value = strings.NewBuilder()
	let mut q Quote = Body
	let mut i = from
	for i < src.Len() {
		let d = QuoteStep(q, MarkOf(src[i]))
		i += 1
		match d {
		case machines.Emit[Quote, Piece] as e:
			q = e.Next
			match e.Output {
			case Char as ch:
				value.WriteByte(ch.C)
			case Closed, Broken:
			}
		case machines.Enter[Quote] as e:
			q = e.Next
		case machines.Done[Piece] as e:
			match e.Output {
			case Closed:
				return (value.String(), i)
			case Broken as b:
				return LexError{At: at, Msg: b.Why}
			case Char:
			}
		case machines.Stay[Quote], machines.Tell[Quote, Piece], machines.Ignore, machines.Reject:
		}
	}
	LexError{At: at, Msg: "a string has no closing quote"}
}

// punctAt is the punctuation token that starts at byte i of src, or "".
func punctAt(src string, i int) string {
	for p in Puncts {
		if i+p.Len() <= src.Len() && strings.Slice(src, i, i+p.Len()) == p {
			return p
		}
	}
	""
}
