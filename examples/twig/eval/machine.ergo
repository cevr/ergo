import slices
import strings
import twig/resolve
import rand
import twig/syntax

// Pos is a place in the source.
type Pos = resolve.Pos

// RunError is a run-time error: what went wrong and where.
type RunError { At Pos, Msg string }

// Returned is a return on its way to the call that owns it.
type Returned { V Value }

// Broke is a break on its way to its loop.
type Broke {}

// Continued is a continue on its way to its loop.
type Continued {}

// Flow is how a statement can end other than by running to its end.
type Flow = RunError | Returned | Broke | Continued

// MaxDepth is how deep calls may nest: one more is a RunError, not a
// stack overflow of the host.
let MaxDepth = 2000

// Frame is the variables of one call, and the frame of the function that
// made the callee.
type Frame { Slots []Value, Parent int }

// Record is a record: its field numbers and their values, in the order
// of its literal.
type Record { Keys []int, Vals []Value }

// Machine is the state of a run: the frames, the frames free for reuse,
// the lists and records, what print wrote, and two counters: the nodes
// evaluated (each expression and each statement) and the calls.
type Machine {
	frames []Frame,
	free   []int,
	lists  [][]Value,
	recs   []Record,
	out    strings.Builder,
	depth  int,
	nodes  int,
	calls  int,
}

// End is how a run ended.
type End = Finished | Crashed{At Pos, Msg string}

type Finished {}

// Report is a run: what it printed, how it ended, and its counters.
type Report { Out string, End End, Nodes int, Calls int }

// Run runs the program p.
func Run(p resolve.Program) Report {
	let main = p.Funcs[resolve.Main]
	let mut m = Machine{
		frames: []Frame{Frame{Slots: slices.Repeat([]Value{Nil}, main.Slots), Parent: -1}},
		free:   []int{},
		lists:  [][]Value{},
		recs:   []Record{},
		out:    strings.NewBuilder(),
		depth:  0,
		nodes:  0,
		calls:  0,
	}
	let mut end End = Finished
	exec(&m, p, main.Body, 0) catch {
	case RunError as e:
		end = Crashed{At: e.At, Msg: e.Msg}
	case Returned, Broke, Continued:
		end = Crashed{At: main.At, Msg: "a jump left the program"}
	}
	Report{Out: m.out.String(), End: end, Nodes: m.nodes, Calls: m.calls}
}

// ArithmeticAgreesWithModel: twig prints what the model computes for an
// int expression, and fails with a division by zero where the model
// divides by zero.
law ArithmeticAgreesWithModel(seed int) {
	with context { rand.Random: rand.Seeded(uint64(seed)) } {
		for _ in 0..20 {
			let e = genInt(5)
			let call = syntax.ExprStmt{X: syntax.Call{Fn: syntax.Name{Id: "print", At: nowhere}, Args: []syntax.Expr{e}, At: nowhere}, At: nowhere}
			let p = resolve.Resolve([]syntax.Stmt{call}) catch {
			case resolve.ResolveError:
				return false
			}
			let r = Run(p)
			let ok = match model(e) {
			case Folded as v:
				r.Out == "\(v.N)\n" && r.End == Finished
			case ByZero:
				match r.End {
				case Crashed as c:
					c.Msg == "division by zero" && r.Out == ""
				case Finished:
					false
				}
			}
			if !ok {
				return false
			}
		}
		true
	}
}

let nowhere = syntax.Pos{Line: 0, Col: 0}

// genInt is an expression of ints of depth at most depth: literals near
// 0, 1 and the extremes, negations and the arithmetic operators.
func genInt(depth int) syntax.Expr needs rand.Random {
	if depth <= 0 || rand.Random.IntN(4) == 0 {
		let n = match rand.Random.IntN(6) {
		case 0:
			0
		case 1:
			1
		case 2:
			9223372036854775807
		case _:
			rand.Random.IntN(41)
		}
		return syntax.IntLit{N: n, At: nowhere}
	}
	if rand.Random.IntN(5) == 0 {
		return syntax.Unary{Op: syntax.Neg, X: genInt(depth - 1), At: nowhere}
	}
	let ops = []syntax.BinOp{syntax.Add, syntax.Sub, syntax.Mul, syntax.Div, syntax.Mod}
	syntax.Binary{Op: ops[rand.Random.IntN(ops.Len())], L: genInt(depth - 1), R: genInt(depth - 1), At: nowhere}
}

// Model is the outcome of an int expression: its value, or a division
// by zero.
type Model = Folded{N int} | ByZero{}

// model is the value of e, an expression genInt makes.
func model(e syntax.Expr) Model {
	match e {
	case syntax.IntLit as x:
		Folded{N: x.N}
	case syntax.Unary as x:
		match model(x.X) {
		case Folded as v:
			Folded{N: -v.N}
		case ByZero:
			ByZero
		}
	case syntax.Binary as x:
		match (model(x.L), model(x.R)) {
		case (Folded as a, Folded as b):
			match x.Op {
			case syntax.Add:
				Folded{N: a.N + b.N}
			case syntax.Sub:
				Folded{N: a.N - b.N}
			case syntax.Mul:
				Folded{N: a.N * b.N}
			case syntax.Div:
				if b.N == 0 { ByZero } else { Folded{N: a.N / b.N} }
			case syntax.Mod:
				if b.N == 0 { ByZero } else { Folded{N: a.N % b.N} }
			case _:
				ByZero
			}
		case (_, _):
			ByZero
		}
	case _:
		ByZero
	}
}

// enter is a frame of size slots, each nil, whose parent is env: a free
// one when there is one, else a new one. A slot read before its let (a
// function a block binds at its start can be called before the let of a
// name it reads) is nil, never a value of an earlier call.
func enter(m mut Machine, slots int, env int) int {
	if m.free.Len() == 0 {
		m.frames = m.frames.Append(Frame{Slots: slices.Repeat([]Value{Nil}, slots), Parent: env})
		return m.frames.Len() - 1
	}
	let id = m.free[m.free.Len()-1]
	m.free = m.free[0 : m.free.Len()-1]
	if m.frames[id].Slots.Len() < slots {
		m.frames[id].Slots = slices.Repeat([]Value{Nil}, slots)
	} else {
		for i in 0..slots {
			m.frames[id].Slots[i] = Nil
		}
	}
	m.frames[id].Parent = env
	id
}

// frameOf is the frame hops parents up from env.
func frameOf(m mut Machine, env int, hops int) int {
	let mut f = env
	for _ in 0..hops {
		f = m.frames[f].Parent
	}
	f
}
