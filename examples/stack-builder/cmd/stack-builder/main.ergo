// stack-builder is a stack builder driven by a script on standard input.
// This binary is the only place that chooses the providers: the library,
// the in-memory cluster, a manual clock for the actors, and the host's
// standard input.

import io
import time
import stackbuilder/memory
import stackbuilder/parts
import stackbuilder/stack
import stackbuilder/screen

func main() needs Console | Ambient {
	with context { io.Stdin: io.NewStdin(), Scheduler: time.NewManual(0), stack.Cluster: memory.Cluster } {
		screen.Run(parts.Sample())
	}
}
