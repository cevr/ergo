import actor
import machines
import option
import strings
import time

// Library is the library as pages of parts.
type Library { Pages [][]Part }

// From is where an editor was opened from: the hub goes back there when
// the editor ends (history as data).
type From = FromList{Page int} | FromSearch{Query string, Page int}

// Screen is what the hub shows. Editing keeps the open editor's host,
// which the entry's work fills with the editor.
type Screen =
	| Browsing{Page int}
	| Searching{Query string, Page int}
	| Editing{Part Part, From From, Editor actor.Host[EditActor]}

// HistoryRestores: an editor opened from a page or a search, and left
// with Back or with an added unit, returns the hub to that page or search.
law HistoryRestores(page int, i int, query string, fromSearch bool, add bool) {
	let m = fixture()
	let from Screen = if fromSearch { Searching{Query: query, Page: small(page) % 2} } else { Browsing{Page: small(page) % 2} }
	let h = Hub{Library: m, Units: []Unit{}, Screen: from}
	let parts = match from {
	case Searching as q:
		Find(m, q.Query)
	case _:
		m.Pages[small(page)%2]
	}
	match screenAfter(Step(h, Open{Index: small(i)})) {
	case option.Some[Screen] as s:
		let ending HubSignal = if add { UnitAdded{L: lineOf(i)} } else { EditorBack }
		match screenAfter(Step(Hub{..h, Screen: s.Value}, ending)) {
		case option.Some[Screen] as after:
			sameScreen(after.Value, from)
		case option.None:
			false
		}
	case option.None:
		small(i) >= parts.Len()
	}
}

func small(n int) int {
	let c = n % 3
	if c < 0 { -c } else { c }
}

// fixture is a library of two pages with a composite of two slots.
func fixture() Library {
	let a = Part{Name: "a", Size: 100, Slots: []Slot{}}
	let b = Part{Name: "b", Size: 200, Slots: []Slot{}}
	let composite = Part{Name: "ab", Size: 50, Slots: []Slot{Slot{Name: "x", Choices: []Part{a, b}}, Slot{Name: "y", Choices: []Part{b, a}}}}
	Library{Pages: [][]Part{[]Part{a, b, composite}, []Part{composite, a}}}
}

func lineOf(n int) Unit { Unit{Part: "l\(small(n))", Size: small(n)*100 + 1, Count: small(n) + 1, Subs: []Unit{}} }

func screenAfter(d machines.Decision[Hub, Plan]) option.Option[Screen] {
	match d {
	case machines.Enter[Hub] as x:
		option.Some{x.Next.Screen}
	case machines.Stay[Hub] as x:
		option.Some{x.Next.Screen}
	case _:
		option.None
	}
}

func sameScreen(a Screen, b Screen) bool {
	match (a, b) {
	case (Browsing as x, Browsing as y):
		x.Page == y.Page
	case (Searching as x, Searching as y):
		x.Query == y.Query && x.Page == y.Page
	case (_, _):
		false
	}
}

// Hub is the hub's state: the library, the plan and the screen (a record
// with a union field: the screen is a region of the state). A machine
// takes a record state as a union of one variant.
type Hub { Library Library, Units []Unit, Screen Screen }

// BackChangesNothing: an editor that ends with Back leaves the plan as
// it was; one that adds a unit adds exactly that unit.
law BackChangesNothing(ns []int, n int, text string, add bool) {
	let plan = basketOf(ns)
	let h = Hub{Library: fixture(), Units: plan, Screen: Editing{Part: fixture().Pages[0][0], From: FromList{Page: 0}, Editor: actor.NewHost[EditActor]()}}
	if add {
		let after = basketAfter(Step(h, UnitAdded{L: lineOf(n)}))
		after.Len() == plan.Len()+1 && Total(after) == Total(plan)+Total([]Unit{lineOf(n)})
	} else {
		let after = basketAfter(Step(h, EditorBack))
		after.Len() == plan.Len() && Total(after) == Total(plan)
	}
}

func basketOf(ns []int) []Unit {
	let mut out = []Unit{}
	for n in ns {
		out = out.Append(lineOf(n))
	}
	out
}

func basketAfter(d machines.Decision[Hub, Plan]) []Unit {
	match d {
	case machines.Enter[Hub] as x:
		x.Next.Units
	case machines.Stay[Hub] as x:
		x.Next.Units
	case _:
		[]Unit{}
	}
}

// EditorOpensOnlyFromAList: no hub signal on any screen leaves the hub in
// an Editing screen it did not open from Browsing or Searching.
law EditorOpensOnlyFromAList(n int, m int, text string) {
	let s = screenAt(n, text)
	let h = Hub{Library: fixture(), Units: []Unit{}, Screen: s}
	let e HubSignal = match small(m) + small(m/3)*3 {
	case 0:
		Open{Index: 0}
	case 1:
		Close
	case 2:
		Next
	case 3:
		Search
	case 4:
		Type{Text: text}
	case 5:
		Deploy
	case 6:
		EditorBack
	case 7:
		UnitAdded{L: lineOf(m)}
	case _:
		Prev
	}
	match (s, screenAfter(Step(h, e))) {
	case (Editing, _):
		true
	case (_, option.Some[Screen] as next):
		match next.Value {
		case Editing:
			match e {
			case Open:
				true
			case _:
				false
			}
		case _:
			true
		}
	case (_, option.None):
		true
	}
}

// screenAt is a hub screen picked by n.
func screenAt(n int, text string) Screen {
	let k = small(n)
	match k {
	case 0:
		Browsing{Page: small(n) % 2}
	case 1:
		Searching{Query: text, Page: 1}
	case _:
		Editing{Part: fixture().Pages[0][2], From: if n%2 == 0 { FromList{Page: 1} } else { FromSearch{Query: text, Page: 0} }, Editor: actor.NewHost[EditActor]()}
	}
}

type HubSignal =
	| Next{}
	| Prev{}
	| Open{Index int}
	| Search{}
	| Type{Text string}
	| Close{}
	| Deploy{}
	| UnitAdded{L Unit}
	| EditorBack{}

// Plan is the hub's end: the plan and its total.
type Plan { Units []Unit, Total int }

type Builder machine[Hub, HubSignal] { initial: Start, step: Step, work: hubWork }

// HubActor is the hub's address (an alias, as EditActor is).
type HubActor = actor.Actor[Hub, HubSignal, machines.Decision[Hub, Plan]]

func Start(m Library) Hub { Hub{Library: m, Units: []Unit{}, Screen: Browsing{Page: 0}} }

// Find is the parts of the library whose name holds the query.
func Find(m Library, query string) []Part {
	let mut hits = []Part{}
	for page in m.Pages {
		for it in page {
			if query != "" && strings.Contains(it.Name, query) {
				hits = hits.Append(it)
			}
		}
	}
	hits
}

// Total is the size of the units.
func Total(units []Unit) int {
	let mut n = 0
	for l in units {
		n = n + l.Size*l.Count
	}
	n
}

// back is the screen an editor opened from.
func back(f From) Screen {
	match f {
	case FromList as m:
		Browsing{Page: m.Page}
	case FromSearch as q:
		Searching{Query: q.Query, Page: q.Page}
	}
}

func show(h Hub, s Screen) machines.Decision[Hub, Plan] { machines.Stay[Hub]{Next: Hub{..h, Screen: s}} }

func open(h Hub, s Screen) machines.Decision[Hub, Plan] { machines.Enter[Hub]{Next: Hub{..h, Screen: s}} }

// pick opens the editor of the i-th of parts.
func pick(h Hub, parts []Part, i int, from From) machines.Decision[Hub, Plan] {
	if i < 0 || i >= parts.Len() {
		return machines.Reject
	}
	open(h, Editing{Part: parts[i], From: from, Editor: actor.NewHost[EditActor]()})
}

// Step is the hub's step: a match on the screen region and the signal.
func Step(h Hub, e HubSignal) machines.Decision[Hub, Plan] {
	match (h.Screen, e) {
	case (Browsing as b, Next):
		if b.Page+1 < h.Library.Pages.Len() {
			show(h, Browsing{Page: b.Page + 1})
		} else {
			machines.Reject
		}
	case (Browsing as b, Prev):
		if b.Page > 0 {
			show(h, Browsing{Page: b.Page - 1})
		} else {
			machines.Reject
		}
	case (Browsing as b, Open as o):
		pick(h, h.Library.Pages[b.Page], o.Index, FromList{Page: b.Page})
	case (Browsing as b, Search):
		open(h, Searching{Query: "", Page: b.Page})
	case (Browsing, Deploy):
		if h.Units.Len() > 0 {
			machines.Done[Plan]{Output: Plan{Units: h.Units, Total: Total(h.Units)}}
		} else {
			machines.Reject
		}
	case (Browsing, _):
		machines.Ignore
	case (Searching as q, Type as t):
		show(h, Searching{..q, Query: t.Text})
	case (Searching as q, Open as o):
		pick(h, Find(h.Library, q.Query), o.Index, FromSearch{Query: q.Query, Page: q.Page})
	case (Searching as q, Close):
		open(h, Browsing{Page: q.Page})
	case (Searching, _):
		machines.Ignore
	case (Editing as ed, UnitAdded as a):
		machines.Enter[Hub]{Next: Hub{..h, Units: h.Units.Append(a.L), Screen: back(ed.From)}}
	case (Editing as ed, EditorBack):
		open(h, back(ed.From))
	case (Editing, _):
		machines.Ignore
	}
}

// toHub is an editor's end as a hub signal.
func toHub(o EditOut) HubSignal {
	match o {
	case Added as a:
		UnitAdded{L: a.L}
	case WentBack:
		EditorBack
	}
}

// hubWork: Editing hosts the part's editor, a child of the entry; the
// same Editor machine is a child of the hub and of an editor.
func hubWork(h Hub) option.Option[machines.Work[HubSignal, time.Scheduler]] {
	match h.Screen {
	case Editing as ed:
		option.Some{machines.Work{Start: func(send entry func(e HubSignal)) needs time.Scheduler {
			let _ = actor.ChildIn(send, ed.Editor, machines.Start(Editor{}, ed.Part), 4, toHub)
		}}}
	case Browsing:
		option.None
	case Searching:
		option.None
	}
}
