// Package stack is a stack builder: a hub that browses a library, searches
// it, and opens a part editor as a child actor. A composite's editor opens a
// nested editor of the same machine for each of its slots, so editors
// nest as deep as the library does, and each unit is built inside its
// parent's unit.

import actor
import machines
import option
import time

// Part is a library part. A composite has slots, each a choice among parts.
type Part { Name string, Size int, Slots []Slot }

type Slot { Name string, Choices []Part }

// Unit is a part as planned: its unit size, its count, and the units
// of its slots.
type Unit { Part string, Size int, Count int, Subs []Unit }

// NestedPartsInsideParent: a composite's unit holds one sub-unit per slot, each
// the unit its nested editor gave, and its size is the part's and its
// subs'.
law NestedPartsInsideParent(picks []int, count int) {
	let composite = fixture().Pages[0][2]
	let mut s = editing(composite)
	let mut subs = []Unit{}
	for k, slot in composite.Slots {
		let c = if k < picks.Len() { small(picks[k]) % slot.Choices.Len() } else { 0 }
		match editStep(s, Choose{Index: c}) {
		case machines.Enter[Edit] as x:
			s = x.Next
		case _:
			return false
		}
		let sub = UnitOf(slot.Choices[c], 1+small(k+count), []Unit{})
		subs = subs.Append(sub)
		match editStep(s, SubAdded{L: sub}) {
		case machines.Enter[Edit] as x:
			s = x.Next
		case _:
			return false
		}
	}
	for _ in 0..small(count) {
		match editStep(s, More) {
		case machines.Stay[Edit] as x:
			s = x.Next
		case _:
			return false
		}
	}
	match editStep(s, Add) {
	case machines.Done[EditOut] as d:
		match d.Output {
		case Added as a:
			a.L.Subs.Len() == composite.Slots.Len() && a.L.Size == composite.Size+Total(subs) && a.L.Count == small(count)+1
		case WentBack:
			false
		}
	case _:
		false
	}
}

// Edit is an editor's state. Picking waits for the choice of the next
// slot; Nested hosts the editor of that choice: Sub is its host, which
// the entry's work fills, so a screen reaches the editor through it.
type Edit =
	| Choosing{Part Part, Count int, Subs []Unit}
	| Picking{Part Part, Count int, Subs []Unit}
	| Nested{Part Part, Count int, Subs []Unit, Choice Part, Sub actor.Host[EditActor]}

// CountStaysPositive: Less at a quantity of one is refused.
law CountStaysPositive(n int) {
	let s = Choosing{Part: fixture().Pages[0][0], Count: 1, Subs: []Unit{}}
	match editStep(s, Less) {
	case machines.Reject:
		true
	case _:
		false
	}
}

type EditSignal =
	| More{}
	| Less{}
	| Choose{Index int}
	| Add{}
	| Back{}
	| SubAdded{L Unit}
	| SubBack{}

// EditOut is how an editor ends: the unit it built, or back with nothing.
type EditOut = Added{L Unit} | WentBack{}

// EditActor is an editor's address. A union whose only variant is an
// existing type is that type, an alias: the address is actor.Child's result
// itself, with no wrapper to build or unwrap.
type EditActor = actor.Actor[Edit, EditSignal, machines.Decision[Edit, EditOut]]

type Editor machine[Edit, EditSignal] { initial: editing, step: editStep, work: editWork }

func editing(it Part) Edit { settle(Choosing{Part: it, Count: 1, Subs: []Unit{}}) }

// settle is the eventless step: a composite with a slot left picks it first.
func settle(e Edit) Edit {
	match e {
	case Choosing as c:
		if c.Subs.Len() < c.Part.Slots.Len() {
			Picking{Part: c.Part, Count: c.Count, Subs: c.Subs}
		} else {
			e
		}
	case Picking:
		e
	case Nested:
		e
	}
}

// UnitOf is the unit of a part with its subs: the unit size is the
// part's and its subs'.
func UnitOf(it Part, count int, subs []Unit) Unit {
	let mut size = it.Size
	for p in subs {
		size = size + p.Size*p.Count
	}
	Unit{Part: it.Name, Size: size, Count: count, Subs: subs}
}

func editStep(s Edit, e EditSignal) machines.Decision[Edit, EditOut] {
	match (s, e) {
	case (Choosing as c, More):
		machines.Stay[Edit]{Next: Choosing{..c, Count: c.Count + 1}}
	case (Choosing as c, Less):
		if c.Count > 1 {
			machines.Stay[Edit]{Next: Choosing{..c, Count: c.Count - 1}}
		} else {
			machines.Reject
		}
	case (Choosing as c, Add):
		machines.Done[EditOut]{Output: Added{L: UnitOf(c.Part, c.Count, c.Subs)}}
	case (Choosing, Back):
		machines.Done[EditOut]{Output: WentBack}
	case (Choosing, _):
		machines.Ignore
	case (Picking as p, Choose as ch):
		let choices = p.Part.Slots[p.Subs.Len()].Choices
		if ch.Index >= 0 && ch.Index < choices.Len() {
			machines.Enter[Edit]{Next: Nested{Part: p.Part, Count: p.Count, Subs: p.Subs, Choice: choices[ch.Index], Sub: actor.NewHost[EditActor]()}}
		} else {
			machines.Reject
		}
	case (Picking, Back):
		machines.Done[EditOut]{Output: WentBack}
	case (Picking, _):
		machines.Ignore
	case (Nested as n, SubAdded as a):
		machines.Enter[Edit]{Next: settle(Choosing{Part: n.Part, Count: n.Count, Subs: n.Subs.Append(a.L)})}
	case (Nested as n, SubBack):
		machines.Enter[Edit]{Next: Picking{Part: n.Part, Count: n.Count, Subs: n.Subs}}
	case (Nested, _):
		machines.Ignore
	}
}

// toSub is a nested editor's end as a signal of its parent editor.
func toSub(o EditOut) EditSignal {
	match o {
	case Added as a:
		SubAdded{L: a.L}
	case WentBack:
		SubBack
	}
}

// editWork: Nested hosts the editor of its choice, a child of the entry,
// in the state's host.
func editWork(s Edit) option.Option[machines.Work[EditSignal, time.Scheduler]] {
	match s {
	case Nested as n:
		option.Some{machines.Work{Start: func(send entry func(e EditSignal)) needs time.Scheduler {
			let _ = actor.ChildIn(send, n.Sub, machines.Start(Editor{}, n.Choice), 4, toSub)
		}}}
	case Choosing:
		option.None
	case Picking:
		option.None
	}
}
