import editor/edit
import editor/piece
import ui

// Mono is the page's measure: a cell grid of 8 by 16 (the test host's;
// the desktop host gives its own text engine).
let Mono = ui.Monospace{Advance: 8.0, Line: 16.0}

// Font is the page's font.
let Font = ui.Font{Family: "mono", Size: 14.0}

// PageWidth is the page's width; a longer line wraps.
let PageWidth = ui.Length(640.0)

// Viewer is the view of a window whose saves store runs and whose copies
// and pastes go through clip: the toolbar, the status line, the text
// input the host commits typed text to, the find's replacement field, the
// lines around the caret, and the page: the caret and the selection where
// the text layout puts them, and a press that puts the caret under it.
func Viewer(store edit.Store, clip ui.Clipboard) func(f *ui.Frame[Signal], w Window) {
	func(f *ui.Frame[Signal], w Window) { view(f, w, store, clip) }
}

func view(f *ui.Frame[Signal], w Window, store edit.Store, clip ui.Clipboard) {
	ui.OnKey(f, func(k ui.KeyPress) Option[Signal] { Keyed(k) })
	match w.Writing {
	case Some[string] as t:
		let name = w.Name
		let text = t.Value
		ui.Load(f, ui.IntKey{Value: w.Saves}, func() Signal { written(store, name, text) })
	case None:
	}
	match w.Clipping {
	case Some[Clip] as c:
		let job = c.Value
		ui.Load(f, ui.IntKey{Value: w.Clips}, func() Signal { clipped(clip, job) })
	case None:
	}
	let replacement = ui.NewDraft(f, "")
	ui.Column(f, ui.Plain()) {
		ui.Row(f, ui.Plain()) {
			for b in Buttons() {
				ui.Pressable(f, b.Label, b.Signal) {
					ui.Text(f, b.Label)
				}
			}
			ui.Field(f, replacement, "with")
			ui.Submit(f, replacement, "replace", Do{Signal: edit.Replace{With: replacement.Value}}) {
				ui.Text(f, "replace")
			}
		}
		ui.Input(f, "", "type", func(t string) Signal { Do{Signal: edit.Type{Text: t}} })
		for line in edit.Frame(w.Ed) {
			ui.Text(f, line)
		}
		let d = edit.DocOf(w.Ed)
		let (from, to) = Shown(d)
		let l = ui.LayoutText(Mono, piece.Slice(d.Buf, from, to), Font, PageWidth)
		ui.Area(f, "page", ui.Plain(), func(p ui.PointerEvent) Option[Signal] { Pressed(p, l, from) }) {
			ui.Canvas(f, "paint", PageWidth, ui.Length(float64(len(l.Lines)))*l.LineHeight) func(p *ui.Paint) {
				Page(p, l, w.Ed, from, to)
			}
		}
	}
}

// Pressed is the signal of a pointer on the page, which lays out the
// bytes from from in l: a press puts the caret at the rune boundary
// nearest it (ui.OffsetAt); a move or a release does nothing.
func Pressed(p ui.PointerEvent, l ui.TextLayout, from int) Option[Signal] {
	match p.Phase {
	case ui.Down:
		Some{Value: Do{Signal: edit.Goto{At: from + ui.OffsetAt(Mono, l, ui.Length(p.X), ui.Length(p.Y))}}}
	case ui.Moved, ui.Up, ui.Wheel:
		None
	}
}

// Button is a toolbar button: its label and its signal.
type Button { Label string, Signal Signal }

// Buttons are the toolbar's buttons.
func Buttons() []Button {
	[]Button{
		Button{Label: "undo", Signal: Do{Signal: edit.UndoIt}},
		Button{Label: "redo", Signal: Do{Signal: edit.RedoIt}},
		Button{Label: "save", Signal: Do{Signal: edit.Save}},
		Button{Label: "select", Signal: Do{Signal: edit.Select}},
		Button{Label: "find", Signal: Do{Signal: edit.Find}},
		Button{Label: "next", Signal: Do{Signal: edit.Next}},
		Button{Label: "copy", Signal: Do{Signal: edit.Copy}},
		Button{Label: "cut", Signal: Do{Signal: edit.Cut}},
		Button{Label: "paste", Signal: AskPaste},
	}
}

// clipped runs a clipboard task on clip, as a host task: a copy's text
// put on it, or its text taken for a paste.
func clipped(clip ui.Clipboard, job Clip) Signal {
	match job {
	case Put as p:
		clip.Write(p.Text)
		ClipWritten
	case Take:
		Clipped{Text: clip.Read()}
	}
}

// written is the end of a save of text as name, which the host runs as
// a task: the bytes written, or why not.
func written(store edit.Store, name string, text string) Signal {
	store.Save(name, text) catch {
	case edit.Unwritable as u:
		return WriteFailed{Reason: u.Reason}
	}
	Wrote{Bytes: len(text)}
}

// Shown is the bytes [from, to) of the lines a window shows: the caret's
// line and two lines on each side, as edit.Frame writes them.
func Shown(d edit.Doc) (int, int) {
	let lines = piece.Lines(d.Buf)
	let at = edit.LineOf(d, d.Caret)
	let first = if at > 2 { at - 2 } else { 1 }
	let last = if at+2 < lines { at + 2 } else { lines }
	(piece.LineStart(d.Buf, first), piece.LineEnd(d.Buf, last))
}

// SelectionColor and CaretColor are the page's colors.
let SelectionColor = ui.Color{R: 180, G: 210, B: 255, A: 255}
let CaretColor = ui.Color{R: 0, G: 0, B: 0, A: 255}

// Page paints the selection and the caret of s over the shown bytes
// [from, to), laid out in l: the selection's boxes from the layout
// (ui.SelectionRects), clipped to the shown bytes, and the caret as a bar
// one unit wide where the layout puts it (ui.CaretAt).
func Page(p *ui.Paint, l ui.TextLayout, s edit.State, from int, to int) {
	let d = edit.DocOf(s)
	match s {
	case edit.Selecting as x:
		let lo = clamp(if x.Anchor < d.Caret { x.Anchor } else { d.Caret }, from, to)
		let hi = clamp(if x.Anchor < d.Caret { d.Caret } else { x.Anchor }, from, to)
		for r in ui.SelectionRects(Mono, l, lo-from, hi-from) {
			ui.Fill(p, ui.RectPath(float64(r.X), float64(r.Y), float64(r.W), float64(r.H)), SelectionColor)
		}
	case edit.Editing, edit.Searching:
	}
	let c = ui.CaretAt(Mono, l, d.Caret-from)
	ui.Fill(p, ui.RectPath(float64(c.X), float64(c.Top), 1.0, float64(c.Height)), CaretColor)
}

func clamp(v int, lo int, hi int) int {
	if v < lo {
		return lo
	}
	if v > hi {
		return hi
	}
	v
}

// Keyed is the editor's signal of a key: the arrows move a rune or a
// line, Home and End to the line's ends and with Ctrl to the text's;
// Backspace and Delete erase, Enter breaks the line, Escape leaves a
// selection or a search; Ctrl+Z undoes, Ctrl+Y redoes, Ctrl+S saves,
// Ctrl+F finds, F3 finds the next match, and Ctrl+C, Ctrl+X and Ctrl+V
// copy, cut and paste. Typed text is not a key: the host commits it to
// the text input.
func Keyed(k ui.KeyPress) Option[Signal] {
	let ctrl = k.Mods.Ctrl
	match k.Name {
	case "ArrowLeft":
		Some{Value: Do{Signal: edit.Left{N: 1}}}
	case "ArrowRight":
		Some{Value: Do{Signal: edit.Right{N: 1}}}
	case "ArrowUp":
		Some{Value: Do{Signal: edit.Up{N: 1}}}
	case "ArrowDown":
		Some{Value: Do{Signal: edit.Down{N: 1}}}
	case "Home":
		Some{Value: Do{Signal: if ctrl { edit.Top } else { edit.Home }}}
	case "End":
		Some{Value: Do{Signal: if ctrl { edit.Bottom } else { edit.End }}}
	case "Backspace":
		Some{Value: Do{Signal: edit.Back}}
	case "Delete":
		Some{Value: Do{Signal: edit.Del}}
	case "Enter":
		Some{Value: Do{Signal: edit.Type{Text: "\n"}}}
	case "Escape":
		Some{Value: Do{Signal: edit.Escape}}
	case "F3":
		Some{Value: Do{Signal: edit.Next}}
	case _:
		if !ctrl {
			return None
		}
		match k.Name {
		case "z":
			Some{Value: Do{Signal: edit.UndoIt}}
		case "y":
			Some{Value: Do{Signal: edit.RedoIt}}
		case "s":
			Some{Value: Do{Signal: edit.Save}}
		case "f":
			Some{Value: Do{Signal: edit.Find}}
		case "c":
			Some{Value: Do{Signal: edit.Copy}}
		case "x":
			Some{Value: Do{Signal: edit.Cut}}
		case "v":
			Some{Value: AskPaste}
		case _:
			None
		}
	}
}
