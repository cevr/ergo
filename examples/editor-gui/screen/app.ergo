// Package screen is the editor's window: the app machine that holds the
// editor and its save in flight, and the view a window shows of it,
// written once for every ui host (ui.TestHost here; the desktop host at
// stage c). The editor's save is its output; here it becomes a write the
// view asks the host for (ui.Load), whose end comes back as a signal.

import ergo.local/prototype/examples/editorgui/edit
import machines
import option

// Signal is what the view sends the app: a signal of the editor (a key,
// a button, committed text, a click), the end of a save the host ran, a
// paste asked for, or the end of a clipboard task: the text read for a
// paste, or the text written for a copy.
type Signal = Do{Signal edit.Signal} | Wrote{Bytes int} | WriteFailed{Reason string} | AskPaste{} | Clipped{Text string} | ClipWritten{}

// Clip is a clipboard task in flight: put the text a copy or a cut took,
// or take the text a paste types.
type Clip = Put{Text string} | Take{}

// Window is the app's state: the editor, the document's name, the text a
// save is writing (None when no save is in flight), and how many saves
// were asked for, which keys the write so that a new save replaces the
// old; and the same for the clipboard: the task in flight and how many
// were asked for.
type Window { Ed edit.State, Name string, Writing option.Option[string], Saves int, Clipping option.Option[Clip], Clips int }

// Opening is what the app starts on: the document's text and name.
type Opening { Text string, Name string }

// Note is what the app tells the user: a save ended, or failed.
type Note = SavedNote{Name string, Bytes int} | CannotSave{Name string, Reason string}

// Begin is the editor on o: the machine's input.
func Begin(o Opening) Window {
	Window{Ed: edit.Open(o.Text), Name: o.Name, Writing: option.None, Saves: 0, Clipping: option.None, Clips: 0}
}

// Step is the app's transition. The editor's Write starts a save; its end
// tells the editor Saved and notes it, a failure notes it and keeps the
// edits unsaved, as the headless driver does. The editor's Copied starts
// a clipboard write; a paste starts a clipboard read, whose text the
// editor gets typed, as the headless driver types it.
func Step(w Window, e Signal) machines.Decision[Window, Note] {
	match e {
	case Do as d:
		match edit.Step(w.Ed, d.Signal) {
		case machines.Enter[edit.State] as x:
			machines.Stay[Window]{Next: Window{..w, Ed: x.Next}}
		case machines.Stay[edit.State] as x:
			machines.Stay[Window]{Next: Window{..w, Ed: x.Next}}
		case machines.Emit[edit.State, edit.Output] as x:
			match x.Output {
			case edit.Write as t:
				machines.Stay[Window]{Next: Window{..w, Ed: x.Next, Writing: option.Some{Value: t.Text}, Saves: w.Saves + 1}}
			case edit.Copied as c:
				machines.Stay[Window]{Next: Window{..w, Ed: x.Next, Clipping: option.Some{Value: Put{Text: c.Text}}, Clips: w.Clips + 1}}
			}
		case machines.Ignore, machines.Tell[edit.State, edit.Output]:
			machines.Ignore
		case machines.Reject, machines.Done[edit.Output]:
			machines.Reject
		}
	case Wrote as x:
		machines.Emit[Window, Note]{Next: Window{..w, Ed: edit.After(w.Ed, edit.Saved), Writing: option.None}, Output: SavedNote{Name: w.Name, Bytes: x.Bytes}}
	case WriteFailed as x:
		machines.Emit[Window, Note]{Next: Window{..w, Writing: option.None}, Output: CannotSave{Name: w.Name, Reason: x.Reason}}
	case AskPaste:
		machines.Stay[Window]{Next: Window{..w, Clipping: option.Some{Value: Take}, Clips: w.Clips + 1}}
	case Clipped as c:
		machines.Stay[Window]{Next: Window{..w, Ed: edit.After(w.Ed, edit.Type{Text: c.Text}), Clipping: option.None}}
	case ClipWritten:
		machines.Stay[Window]{Next: Window{..w, Clipping: option.None}}
	}
}

// NoteLine is the line of a note, as the headless driver writes it.
func NoteLine(n Note) string {
	match n {
	case SavedNote as s:
		"saved " + s.Name + " (\(s.Bytes) bytes)"
	case CannotSave as c:
		"cannot save " + c.Name + ": " + c.Reason
	}
}

// After is the window after e: a rejected or ignored signal leaves it as
// it was.
func After(w Window, e Signal) Window {
	match Step(w, e) {
	case machines.Enter[Window] as x:
		x.Next
	case machines.Stay[Window] as x:
		x.Next
	case machines.Emit[Window, Note] as x:
		x.Next
	case machines.Ignore, machines.Tell[Window, Note], machines.Reject, machines.Done[Note]:
		w
	}
}

// App is the editor as a machine: an actor runs it under the view.
type App machine[Window, Signal] {
	initial: Begin,
	step:    Step,

	// WroteIsSaved: an edit, a save and its end leave the document saved,
	// with no write in flight.
	law WroteIsSaved(o Opening, typed string) {
		let w = After(After(After(Begin(o), Do{Signal: edit.Type{Text: typed + "x"}}), Do{Signal: edit.Save}), Wrote{Bytes: 0})
		!edit.DocOf(w.Ed).Dirty && w.Writing == option.None
	},

	// FailedSaveKeepsEdits: a save that fails leaves the edits unsaved,
	// with no write in flight.
	law FailedSaveKeepsEdits(o Opening, typed string, reason string) {
		let w = After(After(After(Begin(o), Do{Signal: edit.Type{Text: typed + "x"}}), Do{Signal: edit.Save}), WriteFailed{Reason: reason})
		edit.DocOf(w.Ed).Dirty && w.Writing == option.None
	},

	// CopyPutsTheSelection: a copy of a selection asks the host to put
	// the selected text on the clipboard, and its end leaves no task.
	law CopyPutsTheSelection(o Opening, n int) {
		let w = After(After(After(Begin(o), Do{Signal: edit.Select}), Do{Signal: edit.Right{N: n % 64}}), Do{Signal: edit.Copy})
		let d = edit.DocOf(w.Ed)
		w.Clipping == option.Some{Value: Put{Text: edit.Text(d)[0:d.Caret]}} && After(w, ClipWritten).Clipping == option.None
	},

	// PasteTypesTheClipboard: a paste asks the host for the clipboard,
	// and the text it reads is typed at the caret, as one change.
	law PasteTypesTheClipboard(o Opening, clip string) {
		let w = After(After(Begin(o), AskPaste), Clipped{Text: clip})
		let d = edit.DocOf(w.Ed)
		let undos = if clip == "" { 0 } else { 1 }
		After(Begin(o), AskPaste).Clipping == option.Some{Value: Take} && w.Clipping == option.None && edit.Text(d) == clip+o.Text && d.Undo.Len() == undos
	},
}
