// editor-gui is a text editor with undo: a piece table, a caret, a
// selection, find and replace, and an undo log of inverse edits. This
// stage is its model and its headless driver: a script of commands on
// standard input, and the frames a window would show, as text.
//
//	editor-gui gen [-seed S] [-n N]   write a text of N lines
//	editor-gui edit FILE              play the script on standard input
//	editor-gui scene FILE             play it on the window's view, on
//	                                  ui.TestHost
//
// A FILE that does not exist is a new, empty document; save writes it.
// This binary is the only place that chooses the providers: the host's
// files for the documents, a seeded generator for gen.

import actor
import editor/edit
import editor/files
import editor/script
import flag
import fs
import io
import os
import rand
import slices
import time
import ui

// Usage is the text of a usage failure.
let Usage = "usage: editor-gui gen [-seed S] [-n N] | editor-gui edit FILE | editor-gui scene FILE"

let seedFlag = flag.Int("seed", 1, "the seed of the text")
let countFlag = flag.Int("n", 1000, "how many lines")
let fileArg = flag.Arg("file", "the document")

let genSet = flag.Set{Name: "editor-gui gen", Usage: "", Flags: []flag.Flag{seedFlag, countFlag}, Args: []flag.ArgSpec{}}
let editSet = flag.Set{Name: "editor-gui edit", Usage: "", Flags: []flag.Flag{}, Args: []flag.ArgSpec{fileArg}}
let sceneSet = flag.Set{Name: "editor-gui scene", Usage: "", Flags: []flag.Flag{}, Args: []flag.ArgSpec{fileArg}}

// run is editor-gui on args; a window's saves go to store, and its
// copies and pastes to clip.
func run(args []string, store edit.Store, clip ui.Clipboard) fails os.Exit needs edit.Store | ui.Clipboard | io.Stdout | io.Stdin {
	if len(args) == 0 {
		return os.Exit{Code: 2, Message: Usage}
	}
	let rest = slices.Slice(args, 1, len(args))
	match args[0] {
	case "gen":
		let v = flag.Parse(genSet, rest) catch {
		case err:
			try flag.Exit(err, Usage)
			return
		}
		let n = countFlag.Get(v)
		if n < 0 {
			return os.Exit{Code: 2, Message: "editor-gui: -n must not be negative\n" + Usage}
		}
		with context { Random: rand.Seeded(uint64(seedFlag.Get(v))) } {
			io.Stdout.Print(edit.Generate(n))
		}
	case "edit":
		let v = flag.Parse(editSet, rest) catch {
		case err:
			try flag.Exit(err, Usage)
			return
		}
		let (name, text) = try open(v)
		let _ = script.Play(edit.Open(text), name, io.Stdin.Lines())
	case "scene":
		let v = flag.Parse(sceneSet, rest) catch {
		case err:
			try flag.Exit(err, Usage)
			return
		}
		let (name, text) = try open(v)
		let clock = time.NewManual(0)
		with context { Scheduler: clock } {
			script.Scene(text, name, store, clip, io.Stdin.Lines(), clock) catch {
			case ui.BadPatch as b:
				return os.Exit{Code: 1, Message: "editor-gui: the view's patch did not apply: " + b.Why}
			case actor.Stopped:
				return os.Exit{Code: 1, Message: "editor-gui: the app stopped"}
			}
		}
	case _:
		return os.Exit{Code: 2, Message: Usage}
	}
}

// open is the name v names and its document's text.
func open(v flag.Values) (string, string) fails os.Exit needs edit.Store {
	let name = match fileArg.Get(v) {
	case Some[string] as a:
		a.Value
	case None:
		return os.Exit{Code: 2, Message: Usage}
	}
	let text = edit.OpenDoc(name) catch {
	case edit.Unreadable as u:
		return os.Exit{Code: 1, Message: "editor-gui: \(u.Name): \(u.Reason)"}
	case edit.NotText as n:
		return os.Exit{Code: 1, Message: "editor-gui: " + edit.DescribeNotText(name, n)}
	}
	(name, text)
}

func main() fails os.Exit needs Ambient {
	let store = files.New(fs.NewHost())
	let clip = ui.NewMemoryClipboard()
	with context { edit.Store: store, ui.Clipboard: clip, io.Stdout: io.NewHost(), io.Stdin: io.NewStdin() } {
		try run(os.NewHost().Args(), store, clip)
	}
}
