// Package memory is a Store provider over documents held in memory, for
// tests. Every copy of a Shelf is the same store.

import editor/edit
import sync

// Shelf holds documents by name.
type Shelf { docs sync.Ref[Map[string, string]] }

// NewShelf is an empty store.
func NewShelf() Shelf { Shelf{docs: sync.NewRef[Map[string, string]](Map[string, string]{})} }

// Load is the document named name.
func Load(s Shelf, name string) string fails edit.Missing | edit.Unreadable {
	match s.docs.Get().Get(name) {
	case Some[string] as t:
		t.Value
	case None:
		return edit.Missing{Name: name}
	}
}

// Save makes the document named name hold text.
func Save(s Shelf, name string, text string) fails edit.Unwritable {
	s.docs.Update(func(m Map[string, string]) Map[string, string] { m.Put(name, text) })
}
