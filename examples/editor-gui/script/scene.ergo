// A scene: the editor's window on ui.TestHost, driven by the same script
// lines as Play, the way a user drives it. type commits its text to the
// window's text input at once, as a host's text-input client does;
// enter, back, del, the moves, escape and the shortcuts are keys (a move
// of N is N presses: up 3 is three presses of the up arrow, each keeping
// the column of the line it leaves); select, find, next, undo, redo and
// save press their buttons; replace TEXT writes the replacement field
// and presses replace; copy and paste are Ctrl+C and Ctrl+V, cut its
// button; click ROW COL presses the page where that row and column's
// caret is drawn. After each line the host settles: a save or a clipboard
// task the view asked for runs, and its end comes back. show writes the
// window's text lines (the status line and the lines around the caret,
// as Play's show writes the frame); shot writes the whole screen with the
// page's paint list.

import actor
import editor/edit
import editor/piece
import editor/screen
import io
import machines
import strings
import sync
import time
import ui

// Scene opens the window on text, named name, saving through store and
// copying and pasting through clip, and plays lines.
func Scene(text string, name string, store edit.Store, clip ui.Clipboard, lines Seq[string], clock time.Manual) fails ui.BadPatch | actor.Stopped needs Scheduler | io.Stdout {
	let notes = sync.NewRef[[]screen.Note]([]screen.Note{})
	let a = actor.StartMachine(machines.Start(screen.App{}, screen.Opening{Text: text, Name: name}), 8, func(n screen.Note) {
		notes.Update(func(old []screen.Note) []screen.Note { old.Append(n) })
	})
	let mut h = try ui.NewTestHost(a, screen.Viewer(store, clip), clock, 4)
	for line in lines {
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		if line == "shot" {
			io.Stdout.Print(ui.Screenshot(&h))
			continue
		}
		let c = Parse(line) catch {
		case BadLine as b:
			io.Stdout.Println("? \"" + b.Text + "\": want " + b.Want)
			continue
		}
		let acts = match c {
		case Show:
			for t in Texts(ui.Screen(&h)) {
				io.Stdout.Println(t)
			}
			continue
		case Send as m:
			Acts(m.Signal)
		case Paste:
			[]ui.Act{key("v", true)}
		case Click as k:
			[]ui.Act{click(ui.StateOf(&h).Ed, k.Row, k.Col)}
		}
		ui.Play(&h, acts.Append(ui.SettleAll)) catch {
		case ui.NoNode as x:
			io.Stdout.Println("? no node " + x.Label)
		case actor.Stopped as s:
			return s
		case ui.BadPatch as b:
			return b
		}
		for n in notes.Get() {
			io.Stdout.Println(screen.NoteLine(n))
		}
		notes.Set([]screen.Note{})
	}
	a.Stop()
}

// click is a press on the page where the caret of row and column of s's
// window is drawn (edit.PointAt): the point a user aims at, which the
// view's hit test (ui.OffsetAt) takes back to the offset.
func click(s edit.State, row int, col int) ui.Act {
	let d = edit.DocOf(s)
	let (from, to) = screen.Shown(d)
	let l = ui.LayoutText(screen.Mono, piece.Slice(d.Buf, from, to), screen.Font, screen.PageWidth)
	let k = ui.CaretAt(screen.Mono, l, edit.PointAt(s, row, col)-from)
	ui.PointOn{Label: "page", Pointer: ui.PointerEvent{Phase: ui.Down, X: float64(k.X), Y: float64(k.Top + k.Height/2.0)}}
}

// Acts is the window's steps of an editor signal.
func Acts(sig edit.Signal) []ui.Act {
	match sig {
	case edit.Type as t:
		if t.Text == "\n" {
			return []ui.Act{key("Enter", false)}
		}
		[]ui.Act{ui.TypeInto{Label: "type", Text: t.Text}}
	case edit.Back:
		[]ui.Act{key("Backspace", false)}
	case edit.Del:
		[]ui.Act{key("Delete", false)}
	case edit.Left as l:
		presses("ArrowLeft", l.N)
	case edit.Right as r:
		presses("ArrowRight", r.N)
	case edit.Up as u:
		presses("ArrowUp", u.N)
	case edit.Down as w:
		presses("ArrowDown", w.N)
	case edit.Home:
		[]ui.Act{key("Home", false)}
	case edit.End:
		[]ui.Act{key("End", false)}
	case edit.Top:
		[]ui.Act{key("Home", true)}
	case edit.Bottom:
		[]ui.Act{key("End", true)}
	case edit.Select:
		[]ui.Act{ui.TapOn{Label: "select"}}
	case edit.Find:
		[]ui.Act{key("f", true)}
	case edit.Next:
		[]ui.Act{ui.TapOn{Label: "next"}}
	case edit.Replace as r:
		[]ui.Act{ui.TypeInto{Label: "with", Text: r.With}, ui.TapOn{Label: "replace"}}
	case edit.UndoIt:
		[]ui.Act{key("z", true)}
	case edit.RedoIt:
		[]ui.Act{ui.TapOn{Label: "redo"}}
	case edit.Escape:
		[]ui.Act{key("Escape", false)}
	case edit.Save:
		[]ui.Act{key("s", true)}
	case edit.Copy:
		[]ui.Act{key("c", true)}
	case edit.Cut:
		[]ui.Act{ui.TapOn{Label: "cut"}}
	case edit.Saved, edit.Goto:
		[]ui.Act{}
	}
}

func presses(name string, n int) []ui.Act {
	let mut acts = []ui.Act{}
	for _ in 0..n {
		acts = acts.Append(key(name, false))
	}
	acts
}

func key(name string, ctrl bool) ui.Act {
	ui.KeyIn{Press: ui.KeyPress{Name: name, Mods: ui.Mods{Shift: false, Ctrl: ctrl, Alt: false, Meta: false}}}
}

// Texts is the values of the screen's text nodes in tree order, leaving
// out the captions inside buttons.
func Texts(shapes []ui.Shape[screen.Signal]) []string {
	let mut out = []string{}
	for s in shapes {
		match s.Node {
		case ui.TextNode as t:
			out = out.Append(t.Value)
		case ui.PressableNode:
			continue
		case ui.BoxNode, ui.RowNode, ui.ColumnNode, ui.ScrollNode, ui.CheckNode, ui.InputNode, ui.ToggleNode, ui.AreaNode, ui.CanvasNode, ui.RowsNode:
		}
		for t in Texts(s.Kids) {
			out = out.Append(t)
		}
	}
	out
}
