// The Editor as a machine, and its laws.

import editor/piece
import strings

// Editor is the editor as a machine, started on a text.
type Editor machine[State, Signal] {
	initial: Open,
	step:    Step,

	// SelectAndBack: from editing, a selection that is started and
	// escaped leaves the editor as it was.
	law SelectAndBack(text string, signals []Signal) {
		let s = Run(Open(text), signals)
		match s {
		case Editing:
			After(After(s, Select), Escape) == s
		case Selecting, Searching:
			true
		}
	},

	// SearchAndBack: from editing, a search that is typed and escaped
	// leaves the editor as it was, the caret where the search started.
	law SearchAndBack(text string, signals []Signal, query string) {
		let s = Run(Open(text), signals)
		match s {
		case Editing:
			After(After(After(s, Find), Type{Text: query}), Escape) == s
		case Selecting, Searching:
			true
		}
	},

	// CaretWithinText: after every signal, the caret is inside the text.
	law CaretWithinText(text string, signals []Signal) {
		let mut s = Open(text)
		for sig in signals {
			s = After(s, sig)
			let d = DocOf(s)
			if d.Caret < 0 || d.Caret > piece.Len(d.Buf) {
				return false
			}
		}
		true
	},

	// NextFindsAMatch: after a search for a query and any number of Next,
	// the caret is on a match, or where the search started when the text
	// holds none.
	law NextFindsAMatch(text string, query string, n int) {
		let mut s = After(After(Open(text), Find), Type{Text: query})
		for _ in 0..(n % 8) {
			s = After(s, Next)
		}
		let d = DocOf(s)
		if query == "" || !strings.Contains(text, query) {
			return d.Caret == 0
		}
		strings.HasPrefix(strings.Slice(text, d.Caret, len(text)), query)
	},

	// UndoRedoRoundTrips: after any signals and every change redone,
	// undoing every change gives the loaded text back, and redoing every
	// change gives the same text again, the caret where the last change
	// left it.
	law UndoRedoRoundTrips(text string, signals []Signal) {
		let mut done = DocOf(Run(Open(text), signals))
		for len(done.Redo) > 0 {
			done = Redo(done)
		}
		let mut d = done
		for len(d.Undo) > 0 {
			d = Undo(d)
		}
		if Text(d) != text || len(d.Redo) != len(done.Undo) {
			return false
		}
		for len(d.Redo) > 0 {
			d = Redo(d)
		}
		let caret = if len(done.Undo) > 0 { done.Undo[len(done.Undo)-1].After } else { d.Caret }
		Text(d) == Text(done) && d.Caret == caret && len(d.Undo) == len(done.Undo)
	},

	// ReplaceIsReplaceAll: replacing a query's matches gives the text
	// strings.ReplaceAll gives, as one change. The text is drawn around the
	// query, a unit repeated, and ends in the unit and the query, so the
	// query's matches could overlap.
	law ReplaceIsReplaceAll(parts []string, unit string, n int, by string) {
		let mut query = unit
		for _ in 0..(n % 3) {
			query = query + unit
		}
		if query == "" {
			return true
		}
		let text = strings.Join(parts, query) + unit + query
		let s = After(After(Open(text), Find), Type{Text: query})
		let r = Step(s, Replace{With: by})
		match r {
		case Enter[State] as e:
			let d = DocOf(e.Next)
			Text(d) == strings.ReplaceAll(text, query, by) && len(d.Undo) == 1
		case Stay[State], Emit[State, Output], Ignore, Reject, Done[Output]:
			!strings.Contains(text, query)
		}
	},
}

// Pointing and the clipboard, as laws of the editor's signals.
law GotoLandsOnARune(text string, signals []Signal, at int) {
	let s = Run(Open(text), signals)
	let d = DocOf(s)
	let to = if at < 0 { 0 } else if at > piece.Len(d.Buf) { piece.Len(d.Buf) } else { at }
	let c = DocOf(After(s, Goto{At: at})).Caret
	match s {
	case Searching:
		c == d.Caret
	case Editing, Selecting:
		// The caret is the last rune boundary of to's line at or before to:
		// the moves' column walk reaches it, and the next rune ends past to.
		let next = RuneAfter(d, c)
		let start = LineStart(d, c)
		c <= to && (next == 0 || c+next > to) && Forward(d, start, Column(d, c), LineEnd(d, c)) == c && LineOf(d, c) == LineOf(d, to)
	}
}

// selection is a selection from a to b made on the editor after signals,
// or the state the signals reach when it is not editing.
func selection(text string, signals []Signal, a int, b int) State {
	let s = Run(Open(text), signals)
	match s {
	case Editing:
		After(After(After(s, Goto{At: a}), Select), Goto{At: b})
	case Selecting, Searching:
		s
	}
}

// CopyIsTheSelection: a copy puts the selected text on the clipboard and
// changes nothing.
law CopyIsTheSelection(text string, signals []Signal, a int, b int) {
	let s = selection(text, signals, a, b)
	match s {
	case Selecting as l:
		let d = l.D
		let lo = if l.Anchor < d.Caret { l.Anchor } else { d.Caret }
		let hi = if l.Anchor < d.Caret { d.Caret } else { l.Anchor }
		match Step(s, Copy) {
		case Emit[State, Output] as e:
			e.Next == s && e.Output == Copied{Text: piece.Slice(d.Buf, lo, hi)}
		case Enter[State], Stay[State], Ignore, Reject, Done[Output]:
			false
		}
	case Editing, Searching:
		Step(s, Copy) == Reject
	}
}

// CutThenPasteRestores: a cut puts the selected text on the clipboard and
// takes it out, as one change; typing what it put there gives the text
// back.
law CutThenPasteRestores(text string, signals []Signal, a int, b int) {
	let s = selection(text, signals, a, b)
	match s {
	case Selecting as l:
		let d = l.D
		let lo = if l.Anchor < d.Caret { l.Anchor } else { d.Caret }
		let hi = if l.Anchor < d.Caret { d.Caret } else { l.Anchor }
		match Step(s, Cut) {
		case Emit[State, Output] as e:
			let cut = DocOf(e.Next)
			let copied = match e.Output {
			case Copied as c:
				c.Text
			case Write:
				return false
			}
			let undos = if lo < hi { len(d.Undo) + 1 } else { len(d.Undo) }
			copied == piece.Slice(d.Buf, lo, hi) && len(cut.Undo) == undos && Text(DocOf(After(e.Next, Type{Text: copied}))) == Text(d)
		case Enter[State], Stay[State], Ignore, Reject, Done[Output]:
			false
		}
	case Editing, Searching:
		Step(s, Cut) == Reject
	}
}

// Run is the state after the signals, from s.
func Run(s State, signals []Signal) State {
	let mut at = s
	for sig in signals {
		at = After(at, sig)
	}
	at
}

// After is the state after sig: a rejected signal leaves it as it was.
func After(s State, sig Signal) State {
	match Step(s, sig) {
	case Enter[State] as e:
		e.Next
	case Stay[State] as t:
		t.Next
	case Emit[State, Output] as m:
		m.Next
	case Ignore, Reject, Done[Output]:
		s
	}
}
