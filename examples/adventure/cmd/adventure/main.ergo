// adventure is a small text adventure: it reads commands from standard
// input, one per line, and answers on standard output. Package world is
// the map; package game is the play, a machine of states. This binary is
// the only place that chooses the providers: the host's standard input.

import adventure/game
import io

func main() needs Console | Ambient {
	with context { io.Stdin: io.NewHost() } {
		let _ = game.Run()
	}
}
