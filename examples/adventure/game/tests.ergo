// The game's tests drive Run with a scripted io.Input and record what it
// tells with an io.Recorder, with no host. Its laws run under ergo test.

import io
import strings

// session is the transcript of Run over the input script, and how the
// game ended.
func session(script string) (string, Ending) {
	let out = io.NewRecorder()
	with context { io.Stdin: io.Input{Text: script}, Console: out } {
		let e = Run()
		(out.Text(), e)
	}
}

test FullPlaythroughWins {
	let text, e = session("n\ne\ntake lamp\nd\ntake key\nu\nw\nw\nup\nlook\n")
	assert e == Won{Moves: 7}
	assert strings.HasSuffix(text, "== tower ==\nThe foot of the tower. A stair winds up.\nExits: east, up.\nYou stand on the roof. You won in 7 moves.\n")
	assert !strings.Contains(text, "== roof ==")
}

test TheDarkAndTheDoorBar {
	let text, e = session("n\nw\ne\nd\n")
	assert e == Stopped{Moves: 2, At: "kitchen"}
	assert strings.Contains(text, "The tower door is locked.\n== kitchen ==") && strings.Contains(text, "It is too dark to go down without a light.\n")
}

test QuitAsksFirst {
	let text, e = session("quit\nno\nquit\nyes\nn\n")
	assert e == Stopped{Moves: 0, At: "gate"}
	assert strings.HasSuffix(text, "Really quit? (y/n)\nThen carry on.\nReally quit? (y/n)\nYou stopped in the gate after 0 moves.\n")
}

test FailuresAreToldAndChangeNothing {
	let text, e = session("dance\ngo\ngo sideways\ntake\ntake lamp\ndrop key\nsouth\n")
	assert e == Stopped{Moves: 0, At: "gate"}
	assert strings.Contains(text, "I do not know the word \"dance\".\nGo what?\n\"sideways\" is not a direction.\nTake what?\nThere is no lamp here.\nYou do not carry the key.\nYou cannot go south from here.\n")
}
