// Package game is the play of an adventure: the commands a player types,
// the game as a machine that each command steps, and what the player is
// told. It is pure but for Run, which reads and writes the console.

import adventure/world
import option
import strings
import machines

// Game is a game in play: the world, the room you are in, where each item
// is, and the moves you have made.
type Game { World world.World, At string, Items []world.Place, Moves int }

// Ending is how a game ends: on the goal, or when the player stops.
type Ending = Won{Moves int} | Stopped{Moves int, At string}

// Signal is what the game reads: a line the player typed, or the end of
// the input.
type Signal = Said{Line string} | Ended{}

// The failures of a command: each changes nothing, and is told.

// NoExit is a way out that the room does not have.
type NoExit { Way world.Dir }

// Barred is an exit whose key you do not carry; Text says why.
type Barred { Way world.Dir, Key string, Text string }

// BarredIsTheKey: a move is barred exactly when its exit has a key you do
// not carry.
law BarredIsTheKey(codes []int, way int) {
	let g = GameOf(played(scriptOf(codes)))
	let d = world.DirOf(way)
	match world.ExitOf(g.World, g.At, d) {
	case option.Some[world.Exit] as e:
		let locked = e.Value.Key != "" && Where(g, e.Value.Key) != world.Carried
		let barred = IsBarred(g, d)
		locked == barred
	case option.None:
		true
	}
}

// IsBarred reports whether the move way from g fails Barred.
func IsBarred(g Game, way world.Dir) bool {
	let _ = Moved(g, way) catch {
	case Barred:
		return true
	case NoExit:
		return false
	}
	false
}

// NotHere is an item that is not in the room.
type NotHere { Item string }

// NotCarried is an item you do not carry.
type NotCarried { Item string }

// Refusal names the row of a step's failures: a line that does not parse,
// and a command the game refuses.
type Refusal = Unknown | Missing | NoWay | NoExit | Barred | NotHere | NotCarried

// New is the game at the start of w.
func New(w world.World) Game { Game{World: w, At: w.Start, Items: w.Items, Moves: 0} }

// State is the machine's state: exploring, or asking whether you really
// mean to quit. Each holds the game.
type State = Exploring{G Game} | Asking{G Game}

// GameOf is the game that s holds.
func GameOf(s State) Game {
	match s {
	case Exploring as e:
		e.G
	case Asking as a:
		a.G
	}
}

// ItemsAreKept: play moves items and never makes or loses one: each of
// the world's items is in one place, a room or carried.
law ItemsAreKept(codes []int) {
	Kept(GameOf(played(scriptOf(codes))))
}

// scriptOf is a script of commands, one per code.
func scriptOf(codes []int) []Command {
	let mut out = []Command{}
	for k in codes {
		out = out.Append(commandOf(k))
	}
	out
}

// played is the state after the lines of script from the start, each line
// that fails changing nothing, up to the end of the game.
func played(script []Command) State {
	let mut s = machines.Initial(Play{})
	for c in script {
		let d = Step(s, Said{Line: Text(c)}) catch {
		case Refusal:
			machines.Reject
		}
		match d {
		case machines.Done[Ending]:
			return s
		case machines.Enter[State], machines.Stay[State], machines.Emit[State, Ending], machines.Tell[State, Ending], machines.Ignore, machines.Reject:
		}
		s = machines.Next(s, d)
	}
	s
}

// Kept reports whether g has each of its world's items once, in the
// world's order, each in a room or carried.
func Kept(g Game) bool {
	if g.Items.Len() != g.World.Items.Len() {
		return false
	}
	for i, p in g.Items {
		let inRoom = world.RoomOf(g.World, p.At) != option.None
		if p.Item != g.World.Items[i].Item || !(inRoom || p.At == world.Carried) {
			return false
		}
	}
	true
}

// GoingBackReturns: a move that is allowed can be undone by the opposite
// move, to the room you left, one move later.
law GoingBackReturns(codes []int, way int) {
	let g = GameOf(played(scriptOf(codes)))
	let d = world.DirOf(way)
	let there = Moved(g, d) catch {
	case NoExit, Barred:
		return true
	}
	let back = Moved(there, world.Opposite(d)) catch {
	case NoExit, Barred:
		return false
	}
	back.At == g.At && back.Moves == g.Moves+2
}

// EndIsStopped: the end of the input is Done with where you are and the
// moves you made, in either state.
law EndIsStopped(codes []int, asking bool) {
	let g = GameOf(played(scriptOf(codes)))
	let s = if asking { Asking{G: g} } else { Exploring{G: g} }
	let d = Step(s, Ended) catch {
	case Refusal:
		return false
	}
	match d {
	case machines.Done[Ending] as done:
		done.Output == Stopped{Moves: g.Moves, At: g.At}
	case machines.Enter[State], machines.Stay[State], machines.Emit[State, Ending], machines.Tell[State, Ending], machines.Ignore, machines.Reject:
		false
	}
}

// Play is the adventure as a machine: it starts at the castle's gate and
// moves by Step until the goal, a quit, or the end of the input.
type Play machine[State, Signal] {
	initial: Exploring{G: New(world.Castle())},
	step:    Step,
}

type Transition = Entered{Next State} | Stayed{Next State} | Finished{Output Ending}

func Advance(s State, sig Signal) Transition fails Refusal {
	let g = GameOf(s)
	match (s, sig) {
	case (_, Ended):
		Finished{Output: Stopped{Moves: g.Moves, At: g.At}}
	case (Asking, Said as said):
		if IsYes(said.Line) {
			return Finished{Output: Stopped{Moves: g.Moves, At: g.At}}
		}
		Entered{Next: Exploring{G: g}}
	case (Exploring, Said as said):
		try explore(g, try Parse(said.Line))
	}
}

func Step(s State, sig Signal) machines.Decision[State, Ending] fails Refusal {
	match try Advance(s, sig) {
	case Entered as e:
		machines.Enter[State]{Next: e.Next}
	case Stayed as st:
		machines.Stay[State]{Next: st.Next}
	case Finished as f:
		machines.Done[Ending]{Output: f.Output}
	}
}

func IsYes(line string) bool {
	let word = strings.ToLower(strings.TrimSpace(line))
	word == "y" || word == "yes"
}

func explore(g Game, c Command) Transition fails NoExit | Barred | NotHere | NotCarried {
	match c {
	case Go as m:
		let next = try Moved(g, m.Way)
		if next.At == g.World.Goal {
			return Finished{Output: Won{Moves: next.Moves}}
		}
		Entered{Next: Exploring{G: next}}
	case Take as t:
		if Where(g, t.Item) != g.At {
			return NotHere{Item: t.Item}
		}
		Stayed{Next: Exploring{G: Placed(g, t.Item, world.Carried)}}
	case Drop as d:
		if Where(g, d.Item) != world.Carried {
			return NotCarried{Item: d.Item}
		}
		Stayed{Next: Exploring{G: Placed(g, d.Item, g.At)}}
	case Quit:
		Entered{Next: Asking{G: g}}
	case Look, Inventory, Help, Blank:
		Stayed{Next: Exploring{G: g}}
	}
}

// Moved is g after a move way: in the next room, one move on.
func Moved(g Game, way world.Dir) Game fails NoExit | Barred {
	match world.ExitOf(g.World, g.At, way) {
	case option.Some[world.Exit] as e:
		let exit = e.Value
		if exit.Key != "" && Where(g, exit.Key) != world.Carried {
			return Barred{Way: way, Key: exit.Key, Text: exit.Barred}
		}
		Game{..g, At: exit.To, Moves: g.Moves + 1}
	case option.None:
		NoExit{Way: way}
	}
}

// Where is the place of item: a room, world.Carried, or "" when the world
// has no such item.
func Where(g Game, item string) string {
	for p in g.Items {
		if p.Item == item {
			return p.At
		}
	}
	""
}

// Placed is g with item at, in a new slice of places: a Game is a value.
func Placed(g Game, item string, at string) Game {
	let mut items = []world.Place{}
	for p in g.Items {
		items = items.Append(if p.Item == item { world.Place{Item: item, At: at} } else { p })
	}
	Game{..g, Items: items}
}

// ItemsAt is the items at a place, in the world's order.
func ItemsAt(g Game, at string) []string {
	let mut out = []string{}
	for p in g.Items {
		if p.At == at {
			out = out.Append(p.Item)
		}
	}
	out
}
