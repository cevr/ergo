import io
import machines

// Run plays the castle: it reads lines from io.Stdin and answers each on
// Console, until the goal, a quit or the end of the input, and returns
// how the game ended. A line that fails is told and changes nothing.
func Run() Ending needs Console | io.Stdin {
	let mut s = machines.Initial(Play{})
	Console.Println(Intro)
	tell(Describe(GameOf(s)))
	for line in io.Stdin.Lines() {
		let d = Step(s, Said{Line: line}) catch {
		case Refusal as r:
			Console.Println(Failure(r))
			Reject
		}
		tell(Say(s, line, d))
		match d {
		case Done[Ending] as done:
			return done.Output
		case Enter[State], Stay[State], Emit[State, Ending], Ignore, Reject:
		}
		s = machines.Next(s, d)
	}
	// The end of the input is Step(s, Ended), Done with this Stopped; the
	// call would need a catch of failures it cannot fail and a match of
	// decisions it cannot give (G-ex-a-3), so the end is built here, and
	// the law EndIsStopped holds the two together.
	let g = GameOf(s)
	let end = Stopped{Moves: g.Moves, At: g.At}
	Console.Println(EndText(end))
	end
}

func tell(lines []string) needs Console {
	for l in lines {
		Console.Println(l)
	}
}
