// The map's tests: examples, and the laws restated as property tests
// (#162 runs laws; until then these do).

import strings

test CastleRoomsAreReachable {
	let w = Castle()
	for e in w.Exits {
		let from = RoomOf(w, e.From)
		let to = RoomOf(w, e.To)
		assert from != None && to != None
	}
	assert RoomOf(w, w.Start) != None && RoomOf(w, w.Goal) != None
}

test ParseDirRefusesOtherWords {
	assert ParseDir("nw") == None && ParseDir("") == None && ParseDir("norths") == None
}

test OppositeIsAnInvolutionHolds(n int) {
	let d = DirOf(n)
	assert Opposite(d) != d && Opposite(Opposite(d)) == d
}

test ParseDirReadsDirNameHolds(n int) {
	let d = DirOf(n)
	let back = Some[Dir]{Value: d}
	assert ParseDir(DirName(d)) == back && ParseDir(strings.Slice(DirName(d), 0, 1)) == back
}

test EveryExitHasAWayBackHolds(n int) {
	let w = Castle()
	let e = w.Exits[((n%len(w.Exits))+len(w.Exits))%len(w.Exits)]
	match ExitOf(w, e.To, Opposite(e.Way)) {
	case Some[Exit] as back:
		assert back.Value.To == e.From && back.Value.Key == e.Key
	case None:
		assert false
	}
}
