// Package errgroup is the provider of jobs.Checker in Go's errgroup
// shape, written on std tasks.Transform: each payload is checked on a task
// of its own, at most limit at once, and the first check to fail stops
// the rest (Go's errgroup.Group with SetLimit, Effect's forEach with
// concurrency). Which check fails first depends on the tasks, so a failed
// run names its job through jobs.FirstBad, the contract's reference, and
// the law NamesFirstBad holds on every schedule.

import admit/jobs
import option
import tasks

// Checker is a jobs.Checker that checks payloads limit at a time.
type Checker { limit int } implements jobs.Checker

// New is a Checker that runs at most limit checks at once (at least one).
func New(limit int) Checker {
	if limit < 1 {
		return Checker{limit: 1}
	}
	Checker{limit: limit}
}

// checkOne fails with the job when its payload has a problem
// (jobs.Problem).
func checkOne(j jobs.Job) bool fails jobs.BadPayload {
	match jobs.Problem(j.Payload) {
	case option.Some[string] as p:
		return jobs.BadPayload{Name: j.Name, Reason: p.Value}
	case option.None:
		true
	}
}

// Check runs checkOne on each job, at most limit at once. A Checker the
// law cases generate may hold any limit, and tasks.Transform takes none
// below 1, so it runs at least one.
func Check(c Checker, js []jobs.Job) fails jobs.BadPayload {
	let mut limit = c.limit
	if limit < 1 {
		limit = 1
	}
	let _ = tasks.Transform(js, limit, checkOne) catch {
	case jobs.BadPayload as b:
		match jobs.FirstBad(js) {
		case option.Some[jobs.BadPayload] as first:
			return first.Value
		case option.None:
			return b
		}
	}
}
