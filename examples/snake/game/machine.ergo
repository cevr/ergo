import rand
import machines

// Mode is what the game is doing. Title waits for Begin; Playing moves
// on each Tick; Paused waits for Pause again; Over shows the end until
// Quit.
type Mode = Title{Width int, Height int} | Playing{W World} | Paused{W World} | Over{W World, Why Cause}

// StaysOnTheBoard: every cell of the snake is on the board, in every mode
// of every game. The law states the bounds itself, not through Inside,
// which the game uses to find the wall.
law StaysOnTheBoard(seed int) {
	for m in replay(seed) {
		for p in BodyOf(m) {
			if p.X < 0 || p.Y < 0 || p.X >= 5 || p.Y >= 4 {
				return false
			}
		}
	}
	true
}

// replay is the modes of a game of 300 signals drawn from Random seeded
// with seed, on a board of 5 by 4 cells: the mode after each signal.
func replay(seed int) []Mode {
	with context { Random: rand.Seeded(uint64(seed)) } {
		let signals = signals(300)
		Play(Title{Width: 5, Height: 4}, signals)
	}
}

// signals is n signals drawn from Random: ticks four times in ten, each
// turn once in ten, a pause once in ten and a begin once in ten.
func signals(n int) []Signal needs Random {
	let mut out = []Signal{}
	for _ in 0..n {
		let s = match Random.IntN(10) {
		case 4:
			Turn{To: Up}
		case 5:
			Turn{To: Down}
		case 6:
			Turn{To: Left}
		case 7:
			Turn{To: Right}
		case 8:
			Pause
		case 9:
			Begin
		case _:
			Tick
		}
		out = out.Append(s)
	}
	out
}

// Play is the mode after each of signals, from m.
func Play(m Mode, signals []Signal) []Mode needs Random {
	let mut out = []Mode{}
	let mut at = m
	for s in signals {
		at = machines.Next(at, Step(at, s))
		out = out.Append(at)
	}
	out
}

// BodyOf is the snake of m, or no cell at the title.
func BodyOf(m Mode) []Point {
	match m {
	case Title:
		[]Point{}
	case Playing as p:
		p.W.Body
	case Paused as p:
		p.W.Body
	case Over as o:
		o.W.Body
	}
}

// FoodIsNeverOnTheSnake: while a game is on, the food is on a free cell.
law FoodIsNeverOnTheSnake(seed int) {
	for m in replay(seed) {
		match m {
		case Playing as p:
			if Holds(p.W.Body, p.W.Food) {
				return false
			}
		case Paused as p:
			if Holds(p.W.Body, p.W.Food) {
				return false
			}
		case Title, Over:
		}
	}
	true
}

// GrowsOnlyByEating: from one playing world to the next, the snake is
// one cell longer exactly when the score is one more, and otherwise
// keeps its length and score.
law GrowsOnlyByEating(seed int) {
	let modes = replay(seed)
	for i in 1..len(modes) {
		match (modes[i-1], modes[i]) {
		case (Playing as a, Playing as b):
			let grew = len(b.W.Body) - len(a.W.Body)
			let scored = b.W.Score - a.W.Score
			if grew != scored || grew < 0 || grew > 1 {
				return false
			}
		case (_, _):
		}
	}
	true
}

// NeverIntoTheNeck: however the turns come between two ticks, no tick
// moves the head onto the cell right behind it.
law NeverIntoTheNeck(seed int) {
	for m in replay(seed) {
		match m {
		case Playing as p:
			if Toward(p.W.Body[0], p.W.Heading) == p.W.Body[1] {
				return false
			}
		case Title, Paused, Over:
		}
	}
	true
}

// OverIsFinal: a game that is over ignores every signal but Quit, which
// is Done with its score.
law OverIsFinal(seed int, score int) {
	let w = World{Width: 5, Height: 4, Body: []Point{Point{X: 0, Y: 0}}, Heading: Left, Moved: Left, Food: Point{X: 4, Y: 3}, Score: score}
	let over = Over{W: w, Why: Wall}
	with context { Random: rand.Seeded(uint64(seed)) } {
		for s in []Signal{Begin, Tick, Turn{To: Up}, Pause} {
			if Word(Step(over, s)) != "ignore" {
				return false
			}
		}
		match Step(over, Quit) {
		case Done[int] as d:
			d.Output == score
		case Enter[Mode], Stay[Mode], Emit[Mode, int], Tell[Mode, int], Ignore, Reject:
			false
		}
	}
}

// Word names a decision.
func Word(d Decision[Mode, int]) string {
	match d {
	case Enter[Mode]:
		"enter"
	case Stay[Mode]:
		"stay"
	case Emit[Mode, int], Tell[Mode, int]:
		"emit"
	case Ignore:
		"ignore"
	case Reject:
		"reject"
	case Done[int]:
		"done"
	}
}

// SeedReplays: one seed plays one game: the same modes, signal by signal.
law SeedReplays(seed int) { replay(seed) == replay(seed) }

// Signal is what the game reads: the start, a tick of the clock, a turn,
// a pause (which also resumes) or quit.
type Signal = Begin{} | Tick{} | Turn{To Dir} | Pause{} | Quit{}

// Board is the size of a game's board, in cells.
type Board { Width int, Height int }

// Titled is the title of a game on board b.
func Titled(b Board) Mode { Title{Width: b.Width, Height: b.Height} }

// Snake is the game as a machine. Its input is the board: it starts at
// the board's title and moves by Step until Quit is Done with the score.
// Placing the first food draws from Random, so Begin places it, not the
// start.
type Snake machine[Mode, Signal] {
	initial: Titled,
	step:    Step,
}

// Start is the world at the start of a game on a board of w by h cells:
// a snake of three cells in the middle row, heading right, and food
// drawn from Random.
func Start(w int, h int) World needs Random {
	let y = h / 2
	let body = []Point{Point{X: 2, Y: y}, Point{X: 1, Y: y}, Point{X: 0, Y: y}}
	let food = match PlaceFood(w, h, body) {
	case Some[Point] as p:
		p.Value
	case None:
		Point{X: w - 1, Y: 0}
	}
	World{Width: w, Height: h, Body: body, Heading: Right, Moved: Right, Food: food, Score: 0}
}

// Step is the machine's transition. Quit is Done with the score in every
// mode. A turn back the way the snake last moved is Reject; a turn the
// way it already heads is Ignore. Over ignores everything but Quit.
func Step(m Mode, s Signal) Decision[Mode, int] needs Random {
	match (m, s) {
	case (_, Quit):
		Done[int]{Output: ScoreOf(m)}
	case (Title as t, Begin):
		Enter[Mode]{Next: Playing{W: Start(t.Width, t.Height)}}
	case (Title, _):
		Ignore
	case (Playing as p, Tick):
		Enter[Mode]{Next: Advance(p.W)}
	case (Playing as p, Turn as t):
		if Opposite(t.To, p.W.Moved) {
			return Reject
		}
		if t.To == p.W.Heading {
			return Ignore
		}
		Enter[Mode]{Next: Playing{W: World{..p.W, Heading: t.To}}}
	case (Playing as p, Pause):
		Enter[Mode]{Next: Paused{W: p.W}}
	case (Playing, Begin):
		Ignore
	case (Paused as p, Pause):
		Enter[Mode]{Next: Playing{W: p.W}}
	case (Paused, Turn):
		Reject
	case (Paused, _):
		Ignore
	case (Over, _):
		Ignore
	}
}

// Advance is the mode after one tick of w: the head moves one cell the
// way it heads. Off the board is Over by Wall; onto the body (but the
// tail, which moves away) is Over by Bitten. Onto the food the snake
// grows by one, scores one, and new food is drawn; with no free cell left
// the game is Over by Filled.
func Advance(w World) Mode needs Random {
	let head = Toward(w.Body[0], w.Heading)
	if !Inside(head, w.Width, w.Height) {
		return Over{W: w, Why: Wall}
	}
	let eats = head == w.Food
	let body = Moved(w.Body, head, eats)
	if Bites(body) {
		return Over{W: w, Why: Bitten}
	}
	let next = World{..w, Body: body, Moved: w.Heading, Score: if eats { w.Score + 1 } else { w.Score }}
	if !eats {
		return Playing{W: next}
	}
	match PlaceFood(w.Width, w.Height, body) {
	case Some[Point] as p:
		Playing{W: World{..next, Food: p.Value}}
	case None:
		Over{W: next, Why: Filled}
	}
}

// ScoreOf is the score of the game in m.
func ScoreOf(m Mode) int {
	match m {
	case Title:
		0
	case Playing as p:
		p.W.Score
	case Paused as p:
		p.W.Score
	case Over as o:
		o.W.Score
	}
}
