// The game's tests: examples of each transition, and the laws restated as
// property tests. The compiler checks laws and does not run them yet
// (#162); until it does, these tests run them.

import rand

// world is a playing world of 6 by 4 cells with the body and the food.
func world(body []Point, heading Dir, food Point) World {
	World{Width: 6, Height: 4, Body: body, Heading: heading, Moved: heading, Food: food, Score: 0}
}

// row is the cells (x, y) for each x of xs.
func row(y int, xs []int) []Point {
	let mut out = []Point{}
	for x in xs {
		out = out.Append(Point{X: x, Y: y})
	}
	out
}

test ATickMovesTheHead {
	with context { Random: rand.Seeded(1) } {
		match Advance(world(row(1, []int{2, 1, 0}), Right, Point{X: 5, Y: 3})) {
		case Playing as p:
			assert Key(Playing{W: p.W}) == "playing 0 food 5,3 body 3,1 2,1 1,1 RR"
		case Title, Paused, Over:
			assert false
		}
	}
}

test EatingGrowsAndScores {
	with context { Random: rand.Seeded(1) } {
		match Advance(world(row(1, []int{2, 1, 0}), Right, Point{X: 3, Y: 1})) {
		case Playing as p:
			assert len(p.W.Body) == 4 && p.W.Score == 1 && !Holds(p.W.Body, p.W.Food)
		case Title, Paused, Over:
			assert false
		}
	}
}

// causeOf is the cause of the end of the tick of w, or "playing".
func causeOf(w World) string {
	with context { Random: rand.Seeded(1) } {
		match Advance(w) {
		case Over as o:
			causeName(o.Why)
		case Title, Playing, Paused:
			"playing"
		}
	}
}

test TheWallAndTheBodyEndTheGame {
	assert causeOf(world(row(0, []int{5, 4, 3}), Right, Point{X: 0, Y: 3})) == "wall"
	// A snake curled so that its head moves onto its own body.
	let curled = []Point{Point{X: 1, Y: 1}, Point{X: 2, Y: 1}, Point{X: 2, Y: 2}, Point{X: 1, Y: 2}, Point{X: 0, Y: 2}}
	assert causeOf(world(curled, Down, Point{X: 5, Y: 0})) == "bitten"
	// The tail moves away, so the head may take its cell.
	let ring = []Point{Point{X: 1, Y: 1}, Point{X: 2, Y: 1}, Point{X: 2, Y: 2}, Point{X: 1, Y: 2}}
	assert causeOf(world(ring, Down, Point{X: 5, Y: 0})) == "playing"
}

test FillingTheBoardWins {
	let w = World{Width: 2, Height: 2, Body: []Point{Point{X: 0, Y: 1}, Point{X: 0, Y: 0}, Point{X: 1, Y: 0}}, Heading: Right, Moved: Down, Food: Point{X: 1, Y: 1}, Score: 0}
	assert causeOf(w) == "filled"
}

test TwoTurnsCannotReverse {
	with context { Random: rand.Seeded(3) } {
		let start = Playing{W: world(row(1, []int{2, 1, 0}), Right, Point{X: 5, Y: 3})}
		let up = Next(start, Step(start, Turn{To: Up}))
		assert Word(Step(up, Turn{To: Left})) == "reject"
		assert Word(Step(start, Turn{To: Left})) == "reject"
		assert Word(Step(start, Turn{To: Right})) == "ignore"
	}
}

test PauseHoldsTheGame {
	with context { Random: rand.Seeded(3) } {
		let start = Playing{W: world(row(1, []int{2, 1, 0}), Right, Point{X: 5, Y: 3})}
		let paused = Next(start, Step(start, Pause))
		assert Word(Step(paused, Tick)) == "ignore" && Word(Step(paused, Turn{To: Up})) == "reject"
		assert Key(Next(paused, Step(paused, Pause))) == Key(start)
	}
}

test StaysOnTheBoardHolds(seed int) {
	for m in Replay(seed) {
		for p in BodyOf(m) {
			assert p.X >= 0 && p.Y >= 0 && p.X < 5 && p.Y < 4
		}
	}
}

test FoodIsNeverOnTheSnakeHolds(seed int) {
	for m in Replay(seed) {
		match m {
		case Playing as p:
			assert !Holds(p.W.Body, p.W.Food)
		case Paused as p:
			assert !Holds(p.W.Body, p.W.Food)
		case Title, Over:
		}
	}
}

test GrowsOnlyByEatingHolds(seed int) {
	let modes = Replay(seed)
	for i in 1..len(modes) {
		match (modes[i-1], modes[i]) {
		case (Playing as a, Playing as b):
			let grew = len(b.W.Body) - len(a.W.Body)
			assert grew == b.W.Score-a.W.Score && grew >= 0 && grew <= 1
		case (_, _):
		}
	}
}

test NeverIntoTheNeckHolds(seed int) {
	for m in Replay(seed) {
		match m {
		case Playing as p:
			assert Toward(p.W.Body[0], p.W.Heading) != p.W.Body[1]
		case Title, Paused, Over:
		}
	}
}

test OverIsFinalHolds(seed int, score int) {
	let w = World{Width: 5, Height: 4, Body: []Point{Point{X: 0, Y: 0}}, Heading: Left, Moved: Left, Food: Point{X: 4, Y: 3}, Score: score}
	let ok = with context { Random: rand.Seeded(uint64(seed)) } {
		AnswersOnlyQuit(Over{W: w, Why: Wall}, score)
	}
	assert ok
}

test SeedReplaysHolds(seed int) {
	assert Keys(Replay(seed)) == Keys(Replay(seed))
}

// The seeded games end at the wall and eat, so the laws above see a game
// end and a snake grow. A random game seldom bites itself and never fills
// a board of 20 cells: the examples above reach those ends.
test ReplaysReachTheWallAndEat {
	let mut ends = Map[string, bool]{}
	let mut best = 0
	for seed in 0..200 {
		for m in Replay(seed) {
			match m {
			case Over as o:
				ends[causeName(o.Why)] = true
				if o.W.Score > best {
					best = o.W.Score
				}
			case Title, Playing, Paused:
			}
		}
	}
	let yes = Some[bool]{Value: true}
	assert ends.Get("wall") == yes && best >= 2
}
