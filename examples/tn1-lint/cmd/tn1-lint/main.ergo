import ergo.dev/tn1
import ergo.dev/tn1/ts
import fs
import io
import json
import os
import strconv
import strings

let Usage = "usage: tn1-lint lint --rule NAME WEIGHTS FILE... | tn1-lint no-comments [--fix] FILE... | tn1-lint record FILE | tn1-lint project FILE... | tn1-lint chunks FILE | tn1-lint serve | tn1-lint --help"

type Lint { Rule string, Weights string, Files []string }
type NoComments { Fix bool, Files []string }
type Record { File string }
type Project { Files []string }
type Chunks { File string }
type Help {}
type Serve {}
type Command = Lint | NoComments | Record | Project | Chunks | Serve | Help

func usage() os.Exit { os.Exit{Code: 2, Message: Usage} }

func Parse(args []string) Command fails os.Exit {
	if args.Len() == 1 && (args[0] == "--help" || args[0] == "-h") {
		return Help
	}
	if args.Len() == 1 && args[0] == "serve" {
		return Serve
	}
	if args.Len() == 2 && args[0] == "record" {
		return Record{File: args[1]}
	}
	if args.Len() >= 2 && args[0] == "project" {
		return Project{Files: args[1:]}
	}
	if args.Len() == 2 && args[0] == "chunks" {
		return Chunks{File: args[1]}
	}
	if args.Len() >= 2 && args[0] == "no-comments" {
		if args[1] == "--fix" {
			if args.Len() < 3 {
				return usage()
			}
			return NoComments{Fix: true, Files: args[2:]}
		}
		return NoComments{Fix: false, Files: args[1:]}
	}
	if args.Len() >= 4 && args[0] == "lint" && args[1] == "--rule" && args[2] == "no-comments" {
		if args[3] == "--fix" {
			if args.Len() < 5 {
				return usage()
			}
			return NoComments{Fix: true, Files: args[4:]}
		}
		return NoComments{Fix: false, Files: args[3:]}
	}
	if args.Len() >= 5 && args[0] == "lint" && args[1] == "--rule" {
		return Lint{Rule: args[2], Weights: args[3], Files: args[4:]}
	}
	return usage()
}

type Place { Offset int "offset", Length int "length", Line int "line", Column int "column" }
type Label { Span Place "span" }
type Diagnostic {
	Message  string "message",
	Code     string "code",
	Severity string "severity",
	Filename string "filename",
	Labels   []Label "labels",
}
type Report {
	Diagnostics []Diagnostic "diagnostics",
	Files       int "number_of_files",
	Rules       int "number_of_rules",
}

func read(path string) string fails os.Exit needs fs.Files | io.Stdin {
	if path == "-" {
		return io.Stdin.ReadAll() catch {
		case io.ReadFailed as r:
			return os.Exit{Code: 1, Message: "tn1-lint: cannot read the standard input: \(r.Reason)"}
		}
	}
	fs.Files.ReadFile(path) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return os.Exit{Code: 1, Message: "tn1-lint: cannot read \(path)"}
	}
}

func write(path string, text string) fails os.Exit needs fs.Writes {
	fs.Writes.WriteFile(path, text) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return os.Exit{Code: 1, Message: "tn1-lint: cannot write \(path)"}
	}
}

func thousandths(n int) string { "0." + strings.PadLeft(strconv.Itoa(n), 3, '0') }

func Findings(rule string, net tn1.Net, path string, src string) []Diagnostic {
	let model = strings.Slice(tn1.ID(net), 0, 12)
	let linted = ts.ForLint(src)
	let mut out = []Diagnostic{}
	for f in tn1.Run(net, tn1.Features{Version: 2, Language: "ts", Lines: linted.Lines, Nodes: []tn1.Node{}, Packages: []tn1.PackageItem{}, Files: []tn1.FileItem{}}) {
		let s = linted.Spans[f.Line-1]
		let lineStart = s.From - lastNewline(src, s.From)
		out = out.Append(Diagnostic{
			Message:  "\(rule): flagged by a local network (p=\(thousandths(f.Permille)), model \(model))",
			Code:     "ergo-tn1(\(rule))",
			Severity: "advice",
			Filename: path,
			Labels:   []Label{Label{Span: Place{Offset: s.From, Length: s.To - s.From, Line: f.Line, Column: lineStart}}},
		})
	}
	out
}

func NoCommentFindings(path string, src string) []Diagnostic {
	let mut out = []Diagnostic{}
	for c in ts.Comments(src) {
		if c.Form != ts.Prose {
			continue
		}
		let col = c.From - lastNewline(src, c.From)
		out = out.Append(Diagnostic{
			Message:  "no-comments: comment is not a directive",
			Code:     "ergo-tn1(no-comments)",
			Severity: "error",
			Filename: path,
			Labels:   []Label{Label{Span: Place{Offset: c.From, Length: c.To - c.From, Line: c.Line, Column: col}}},
		})
	}
	out
}

func lastNewline(src string, p int) int {
	let mut i = p
	for i > 0 && src[i-1] != '\n' {
		i -= 1
	}
	i - 1
}

func Run(c Command) string fails os.Exit needs fs.Files | fs.Writes | io.Stdin | io.Stdout {
	match c {
	case Help:
		Usage + "\n"
	case Serve:
		Answer()
		""
	case Record as r:
		tn1.EncodeRecord(ts.FromSource(try read(r.File)))
	case Project as p:
		let mut named = []tn1.Named{}
		for f in p.Files {
			named = named.Append(tn1.Named{Name: f, Text: try read(f)})
		}
		let mut b = strings.NewBuilder()
		let records = ts.Project(named)
		for i in 0..records.Len() {
			b.WriteString("== \(p.Files[i])\n")
			b.WriteString(tn1.EncodeRecord(records[i]))
		}
		b.String()
	case Chunks as k:
		let mut b = strings.NewBuilder()
		for s in ts.Statements(try read(k.File)) {
			b.WriteString("\(s.From) \(s.To)\n")
		}
		b.String()
	case NoComments as nc:
		if nc.Fix {
			let mut b = strings.NewBuilder()
			for f in nc.Files {
				let src = try read(f)
				let fixed = ts.Fix(src)
				if f == "-" {
					b.WriteString(fixed)
				} else if fixed != src {
					try write(f, fixed)
				}
			}
			return b.String()
		}
		let mut all = []Diagnostic{}
		for f in nc.Files {
			for d in NoCommentFindings(f, try read(f)) {
				all = all.Append(d)
			}
		}
		json.Encode(json.Codec[Report]{MaxBytes: 0, MaxDepth: 0}, Report{Diagnostics: all, Files: nc.Files.Len(), Rules: 1}) + "\n"
	case Lint as l:
		let net = tn1.ParseNet(try read(l.Weights)) catch {
		case tn1.Malformed as m:
			return os.Exit{Code: 1, Message: "tn1-lint: \(l.Weights):\(m.Line): \(m.Reason)"}
		}
		let mut all = []Diagnostic{}
		for f in l.Files {
			for d in Findings(l.Rule, net, f, try read(f)) {
				all = all.Append(d)
			}
		}
		json.Encode(json.Codec[Report]{MaxBytes: 0, MaxDepth: 0}, Report{Diagnostics: all, Files: l.Files.Len(), Rules: 1}) + "\n"
	}
}

func main() fails os.Exit needs os.Ambient {
	let c = try Parse(os.NewHost().Args())
	with context { fs.Files: fs.NewHost(), fs.Writes: fs.NewHost(), io.Stdin: io.NewStdin(), io.Stdout: io.NewHost() } {
		io.Stdout.Print(try Run(c))
	}
}
