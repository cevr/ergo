// Samples: trees and texts made from a seed, for the laws. A property
// test cannot choose its generator (G-ex-d-4), so a test takes an int
// and makes its tree from it here, the same tree for the same seed.

import strings

// alphabet is the bytes of sampled texts and literals: two letters and a
// byte that the syntax must escape.
let alphabet = "ab*"

// source is a pseudo-random number source: a 64-bit linear congruential
// generator (Knuth's MMIX constants).
type source { state uint64 }

// next is a number in 0..n-1. n is above 0.
func next(g mut source, n int) int {
	g.state = g.state*6364136223846793005 + 1442695040888963407
	int((g.state >> 33) % uint64(n))
}

// seeded is the source of seed.
func seeded(seed int) source { source{state: uint64(seed) * 2654435761} }

// Sample is a tree of seed, at most four levels deep. Each of its Cat
// nodes has two or three parts, so it prints and parses back to itself.
func Sample(seed int) Node {
	let mut g = seeded(seed)
	g.tree(4)
}

// RoundTrip: a sampled tree prints to a text that parses back to it.
law RoundTrip(seed int) {
	let n = Sample(seed)
	try Parse(Print(n)) == n
}

// tree is a tree of at most depth levels.
func tree(g mut source, depth int) Node {
	if depth <= 1 {
		return g.leaf()
	}
	match g.next(12) {
	case 7:
		g.counted(g.tree(depth - 1))
	case 8:
		Group{Name: g.name(), Of: g.tree(depth - 1)}
	case 0:
		Cat{Parts: g.parts(depth - 1)}
	case 1:
		Cat{Parts: g.parts(depth - 1)}
	case 2:
		Alt{Left: g.tree(depth - 1), Right: g.tree(depth - 1)}
	case 3:
		Star{Of: g.tree(depth - 1)}
	case 4:
		Plus{Of: g.tree(depth - 1)}
	case 5:
		Quest{Of: g.tree(depth - 1)}
	case 6:
		Empty
	case _:
		g.leaf()
	}
}

// counted is of counted: at least 0 to 2 times, and at most 0 or 1
// times more, or with no bound.
func counted(g mut source, of Node) Node {
	let min = g.next(3)
	let max = if g.next(3) == 0 { -1 } else { min + g.next(2) }
	Count{Of: of, Min: min, Max: max, As: Counted(of, min, max)}
}

// name is a group name of three: the laws see names repeat in a tree.
func name(g mut source) string { groupNames[g.next(3)] }

// groupNames are the names that sampled groups take.
let groupNames = []string{"X", "y", "_z1"}

// parts is two or three trees of at most depth levels.
func parts(g mut source, depth int) []Node {
	let mut out = []Node{g.tree(depth), g.tree(depth)}
	if g.next(2) == 0 {
		out = out.Append(g.tree(depth))
	}
	out
}

// leaf is a tree of one node: a literal of the alphabet, Any, or a class.
func leaf(g mut source) Node {
	match g.next(7) {
	case 0:
		Lit{C: alphabet[0]}
	case 1:
		Lit{C: alphabet[1]}
	case 2:
		Lit{C: alphabet[2]}
	case 3:
		Any
	case 4:
		Class{Spans: []Span{Span{Lo: alphabet[0], Hi: alphabet[1]}}, Negated: false}
	case 5:
		Class{Spans: []Span{Span{Lo: alphabet[0], Hi: alphabet[0]}}, Negated: true}
	case _:
		Class{Spans: []Span{Span{Lo: alphabet[2], Hi: alphabet[2]}, Span{Lo: alphabet[1], Hi: alphabet[1]}}, Negated: false}
	}
}

// Scramble is text with the bytes of a generated string (a b z space A Z
// 0 9 _, G-ex-d-4) turned into the bytes the syntax gives a meaning:
// ( ) * | [ ] \ . ^. A generated string holds none of them, so a property
// test over patterns scrambles its string first.
func Scramble(text string) string {
	let from = "abz AZ09_"
	let to = "()*|[]\\.^"
	let mut out = ""
	for i in 0..text.Len() {
		let k = strings.Index(from, text[i:i+1])
		out = out + if k < 0 { text[i : i+1] } else { to[k : k+1] }
	}
	out
}

// ParsedIsCanonical: whatever text parses, its tree prints to a text
// that parses back to the same tree. The texts are text, its scramble,
// and 20 printed samples with one byte cut out, which parse to many
// shapes or fail.
law ParsedIsCanonical(text string, seed int) {
	if !canonical(text) || !canonical(Scramble(text)) {
		return false
	}
	for k in 0..20 {
		let src = Print(Sample(seed*20 + k))
		if src.Len() > 0 {
			let cut = (seed + k) % src.Len()
			let at = if cut < 0 { cut + src.Len() } else { cut }
			if !canonical(src[:at] + src[at+1:]) {
				return false
			}
		}
	}
	true
}

// canonical reports whether text fails to parse, or parses to a tree
// that prints and parses back to itself.
func canonical(text string) bool {
	let n = Parse(text) catch {
	case _:
		return true
	}
	let back = Parse(Print(n)) catch {
	case _:
		return false
	}
	back == n
}

// FailureIsInside: a failure of Parse names an offset inside the text.
law FailureIsInside(text string) { inside(text) && inside(Scramble(text)) }

// inside reports whether Parse(text) succeeds or fails inside text.
func inside(text string) bool {
	let _ = Parse(text) catch {
	case err:
		let at = Offset(err)
		return 0 <= at && at < text.Len()
	}
	true
}

// SampleText is a text of seed over the alphabet, of 0 to 7 bytes.
func SampleText(seed int) string {
	let mut g = seeded(seed + 7919)
	let n = g.next(8)
	let mut out = ""
	for _ in 0..n {
		let i = g.next(alphabet.Len())
		out = out + alphabet[i:i+1]
	}
	out
}
