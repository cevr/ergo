// The syntax's tests: examples. `ergo test` runs the laws.

test ParsesPrecedence {
	let n = try Parse("ab|c*")
	let want = Alt{Left: Cat{Parts: []Node{Lit{C: 'a'}, Lit{C: 'b'}}}, Right: Star{Of: Lit{C: 'c'}}}
	assert n == want
}

test ParsesClasses {
	let n = try Parse("[^a-c\\]]")
	assert n == Class{Spans: []Span{Span{Lo: 'a', Hi: 'c'}, Span{Lo: ']', Hi: ']'}}, Negated: true}
	assert (try Parse("[]")) == Class{Spans: []Span{}, Negated: false}
	assert (try Parse("[a-]")) == Class{Spans: []Span{Span{Lo: 'a', Hi: 'a'}, Span{Lo: '-', Hi: '-'}}, Negated: false}
}

test GroupsAreNotNodes {
	assert (try Parse("(a)")) == Lit{C: 'a'}
	assert (try Parse("()")) == Empty
	assert (try Parse("(ab)c")) == Cat{Parts: []Node{Cat{Parts: []Node{Lit{C: 'a'}, Lit{C: 'b'}}}, Lit{C: 'c'}}}
}

// failure is the message of Parse(text), or "ok".
func failure(text string) string {
	let _ = Parse(text) catch {
	case err:
		return Describe(err)
	}
	"ok"
}

test FailuresAreNamed {
	assert failure("(ab") == "missing ) for the ( at 0"
	assert failure("ab)") == "unexpected ) at 2"
	assert failure("a|*") == "nothing to repeat before * at 2"
	assert failure("ab\\") == "trailing \\ at 2"
	assert failure("x[ab") == "missing ] for the [ at 1"
	assert failure("[z-a]") == "bad range z-a at 1"
	assert failure("a(b|c)*d") == "ok"
}

test PrintsCanonically {
	assert Print(try Parse("a(b|c)*d")) == "a(b|c)*d"
	assert Print(try Parse("((a))(b)")) == "ab"
	assert Print(Literal("a.b*")) == "a\\.b\\*"
	assert Print(Alt{Left: Lit{C: 'a'}, Right: Alt{Left: Lit{C: 'b'}, Right: Lit{C: 'c'}}}) == "a|(b|c)"
	assert Print(Class{Spans: []Span{Span{Lo: '^', Hi: '^'}, Span{Lo: '-', Hi: ']'}}, Negated: false}) == "[\\^\\--\\]]"
}

test SamplesVary {
	let mut sizes = Map[int, bool]{}
	for seed in 0..50 {
		sizes[Size(Sample(seed))] = true
	}
	assert len(sizes) >= 5
}

test ScrambleReachesTheMetas {
	assert Scramble("abz AZ09_xé") == "()*|[]\\.^xé"
}

// Every one-byte text parses or fails inside it; all 256 bytes print back.
test EveryByteRoundTrips {
	for i in 0..256 {
		let n = Literal(ByteText(byte(i)))
		assert (try Parse(Print(n))) == n
	}
}
