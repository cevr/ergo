// The syntax's tests: examples, and the laws restated as property tests.
// The compiler checks laws and does not run them yet (#162); until it
// does, these tests run them. A property gets 100 cases, so the seeded
// ones loop over 20 trees per case.

test ParsesPrecedence {
	let n = try Parse("ab|c*")
	let want = Alt{Left: Cat{Parts: []Node{Lit{C: 'a'}, Lit{C: 'b'}}}, Right: Star{Of: Lit{C: 'c'}}}
	assert Equal(n, want)
}

test ParsesClasses {
	let n = try Parse("[^a-c\\]]")
	assert Equal(n, Class{Spans: []Span{Span{Lo: 'a', Hi: 'c'}, Span{Lo: ']', Hi: ']'}}, Negated: true})
	assert Equal(try Parse("[]"), Class{Spans: []Span{}, Negated: false})
	assert Equal(try Parse("[a-]"), Class{Spans: []Span{Span{Lo: 'a', Hi: 'a'}, Span{Lo: '-', Hi: '-'}}, Negated: false})
}

test GroupsAreNotNodes {
	assert Equal(try Parse("(a)"), Lit{C: 'a'})
	assert Equal(try Parse("()"), Empty)
	assert Equal(try Parse("(ab)c"), Cat{Parts: []Node{Cat{Parts: []Node{Lit{C: 'a'}, Lit{C: 'b'}}}, Lit{C: 'c'}}})
}

// failure is the message of Parse(text), or "ok".
func failure(text string) string {
	let _ = Parse(text) catch {
	case err:
		return Describe(err)
	}
	"ok"
}

test FailuresAreNamed {
	assert failure("(ab") == "missing ) for the ( at 0"
	assert failure("ab)") == "unexpected ) at 2"
	assert failure("a|*") == "nothing to repeat before * at 2"
	assert failure("ab\\") == "trailing \\ at 2"
	assert failure("x[ab") == "missing ] for the [ at 1"
	assert failure("[z-a]") == "bad range z-a at 1"
	assert failure("a(b|c)*d") == "ok"
}

test PrintsCanonically {
	assert Print(try Parse("a(b|c)*d")) == "a(b|c)*d"
	assert Print(try Parse("((a))(b)")) == "ab"
	assert Print(Literal("a.b*")) == "a\\.b\\*"
	assert Print(Alt{Left: Lit{C: 'a'}, Right: Alt{Left: Lit{C: 'b'}, Right: Lit{C: 'c'}}}) == "a|(b|c)"
	assert Print(Class{Spans: []Span{Span{Lo: '^', Hi: '^'}, Span{Lo: '-', Hi: ']'}}, Negated: false}) == "[\\^\\--\\]]"
}

test SamplesVary {
	let mut sizes = Map[int, bool]{}
	for seed in 0..50 {
		sizes[Size(Sample(seed))] = true
	}
	assert len(sizes) >= 5
}

test RoundTripHolds(seed int) {
	for k in 0..20 {
		let n = Sample(seed*20 + k)
		assert Equal(try Parse(Print(n)), n)
	}
}

// canonical reports whether text fails to parse, or parses to a tree
// that prints and parses back to itself.
func canonical(text string) bool {
	let n = Parse(text) catch {
	case _:
		return true
	}
	let back = Parse(Print(n)) catch {
	case _:
		return false
	}
	Equal(back, n)
}

// The texts are the scrambled string, and 20 printed samples with one
// byte cut out, which parse to many shapes or fail.
test ParsedIsCanonicalHolds(text string, seed int) {
	assert canonical(text) && canonical(Scramble(text))
	for k in 0..20 {
		let src = Print(Sample(seed*20 + k))
		if len(src) > 0 {
			let cut = (seed + k) % len(src)
			let at = if cut < 0 { cut + len(src) } else { cut }
			assert canonical(src[:at] + src[at+1:])
		}
	}
}

test LiteralRoundTripHolds(text string) {
	for t in []string{text, Scramble(text)} {
		let n = Literal(t)
		assert Equal(try Parse(Print(n)), n)
	}
}

// inside reports whether Parse(text) succeeds or fails inside text.
func inside(text string) bool {
	let _ = Parse(text) catch {
	case err:
		let at = Offset(err)
		return 0 <= at && at < len(text)
	}
	true
}

test FailureIsInsideHolds(text string) {
	assert inside(text) && inside(Scramble(text))
}

test ScrambleReachesTheMetas {
	assert Scramble("abz AZ09_xé") == "()*|[]\\.^xé"
}

// Every one-byte text parses or fails inside it; all 256 bytes print back.
test EveryByteRoundTrips {
	for i in 0..256 {
		let n = Literal(ByteText(byte(i)))
		assert Equal(try Parse(Print(n)), n)
	}
}
