// The syntax's tests: examples. `ergo test` runs the laws.

test ParsesPrecedence {
	let n = try Parse("ab|c*")
	let want = Alt{Left: Cat{Parts: []Node{Lit{C: 'a'}, Lit{C: 'b'}}}, Right: Star{Of: Lit{C: 'c'}}}
	assert n == want
}

test ParsesClasses {
	let n = try Parse("[^a-c\\]]")
	assert n == Class{Spans: []Span{Span{Lo: 'a', Hi: 'c'}, Span{Lo: ']', Hi: ']'}}, Negated: true}
	assert (try Parse("[]")) == Class{Spans: []Span{}, Negated: false}
	assert (try Parse("[a-]")) == Class{Spans: []Span{Span{Lo: 'a', Hi: 'a'}, Span{Lo: '-', Hi: '-'}}, Negated: false}
}

test GroupsAreNotNodes {
	assert (try Parse("(a)")) == Lit{C: 'a'}
	assert (try Parse("()")) == Empty
	assert (try Parse("(ab)c")) == Cat{Parts: []Node{Cat{Parts: []Node{Lit{C: 'a'}, Lit{C: 'b'}}}, Lit{C: 'c'}}}
}

// failure is the message of Parse(text), or "ok".
func failure(text string) string {
	let _ = Parse(text) catch {
	case err:
		return Describe(err)
	}
	"ok"
}

test FailuresAreNamed {
	assert failure("(ab") == "missing ) for the ( at 0"
	assert failure("ab)") == "unexpected ) at 2"
	assert failure("a|*") == "nothing to repeat before * at 2"
	assert failure("ab\\") == "trailing \\ at 2"
	assert failure("x[ab") == "missing ] for the [ at 1"
	assert failure("[z-a]") == "bad range z-a at 1"
	assert failure("a(b|c)*d") == "ok"
}

// RC1-digit-literal, RC1-count-extra-copy: no law reads "\d" or a
// Count's As against its counts, since Print writes neither.
test ParsesCountsAndGroups {
	let digits = Class{Spans: []Span{Span{Lo: '0', Hi: '9'}}, Negated: false}
	assert (try Parse("(?<Year>\\d{4})")) == Group{Name: "Year", Of: Count{Of: digits, Min: 4, Max: 4, As: Cat{Parts: []Node{digits, digits, digits, digits}}}}
	let word = Class{Spans: []Span{Span{Lo: '0', Hi: '9'}, Span{Lo: '_', Hi: '_'}}, Negated: false}
	assert (try Parse("[\\d_]{2,}")) == Count{Of: word, Min: 2, Max: -1, As: Cat{Parts: []Node{word, word, Star{Of: word}}}}
	let x = Lit{C: 'x'}
	assert (try Parse("x{1,3}")) == Count{Of: x, Min: 1, Max: 3, As: Cat{Parts: []Node{x, Quest{Of: Cat{Parts: []Node{x, Quest{Of: x}}}}}}}
	assert (try Parse("a{,2}")) == Cat{Parts: []Node{Lit{C: 'a'}, Lit{C: '{'}, Lit{C: ','}, Lit{C: '2'}, Lit{C: '}'}}}
}

test CaptureFailuresAreNamed {
	assert failure("(?x)") == "bad group at 0: want (?<name>"
	assert failure("(?<1a>x)") == "bad group at 0: want (?<name>"
	assert failure("a{3,2}") == "bad repeat {3,2} at 1"
	assert failure("a{1001}") == "bad repeat {1001} at 1"
	assert failure("a{1000}{5}") == "bad repeat {5} at 7"
	assert failure("{2}") == "nothing to repeat before {2} at 0"
	assert refusal("(a?)*") == "repeat a?* can match the empty text"
	assert refusal("(?<X>x)(?<X>y)") == "group name X is used twice: group 2, (?<X>y), repeats it"
	assert refusal("(?<A>(?<X>a)|(?<X>a))") == "group name X is used twice: group 3, (?<X>a), repeats it"
	assert refusal("(?<X>a){2}") == "ok"
	let fake = Count{Of: Lit{C: 'a'}, Min: 2, Max: 2, As: Lit{C: 'a'}}
	assert refusalOf(fake) == "repeat a{2} is not a counted repeat that Parse makes"
	assert refusal("x[^\x00-\xff]") == "class [^\x00-\xff] matches no byte"
	assert refusal("(?<X>a|b?)+c") == "repeat (?<X>a|b?)+ can match the empty text"
	assert refusal("(?<A>a)+(?<B>b{0,2}c)") == "ok"
}

// refusal is the message of Check on the tree of text, or "ok".
func refusal(text string) string {
	let n = Parse(text) catch {
	case err:
		return Describe(err)
	}
	refusalOf(n)
}

// refusalOf is the message of Check on n, or "ok".
func refusalOf(n Node) string {
	let _ = Check(n) catch {
	case err:
		return DescribeCapture(err)
	}
	"ok"
}

test PrintsCanonically {
	assert Print(try Parse("a(b|c)*d")) == "a(b|c)*d"
	assert Print(try Parse("((a))(b)")) == "ab"
	assert Print(Literal("a.b*")) == "a\\.b\\*"
	assert Print(Alt{Left: Lit{C: 'a'}, Right: Alt{Left: Lit{C: 'b'}, Right: Lit{C: 'c'}}}) == "a|(b|c)"
	assert Print(Class{Spans: []Span{Span{Lo: '^', Hi: '^'}, Span{Lo: '-', Hi: ']'}}, Negated: false}) == "[\\^\\--\\]]"
}

test SamplesVary {
	let mut sizes = Map[int, bool]{}
	for seed in 0..50 {
		sizes[Size(Sample(seed))] = true
	}
	assert len(sizes) >= 5
}

test ScrambleReachesTheMetas {
	assert Scramble("abz AZ09_xé") == "()*|[]\\.^xé"
}

// Every one-byte text parses or fails inside it; all 256 bytes print back.
test EveryByteRoundTrips {
	for i in 0..256 {
		let n = Literal(ByteText(byte(i)))
		assert (try Parse(Print(n))) == n
	}
}
