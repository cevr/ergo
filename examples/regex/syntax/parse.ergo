// The parser: a pattern's text to its tree, by recursive descent.
//
//	alt    = cat { "|" cat }
//	cat    = { repeat }
//	repeat = atom { "*" | "+" | "?" | "{" n "}" | "{" n ",}" | "{" n "," m "}" }
//	atom   = "(" alt ")" | "(?<" name ">" alt ")" | "." | "[" ["^"] item { item } "]" | "\" byte | byte
//	item   = "\d" | byte [ "-" byte ]
//
// Inside a class and outside it, "\d" is the digits 0 to 9 and "\" takes
// any other next byte as it is. A plain group is not a node: (ab) is the
// Cat of a and b. A named group (?<name>ab) is a Group, which captures.
// A name is a letter or "_", then letters, digits and "_". n and m are
// decimal, at most 1000, and m is not below n. A "{" that does not start
// such a repeat is a literal byte, as in Go. A counted repeat is a
// Count, whose As Counted writes out: (ab){2} matches as (ab)(ab).

// The failures of Parse. Each names the offset of the byte it is about.
// SyntaxError is their row, and one value of it can be described.
type SyntaxError = Unclosed | Unopened | NothingToRepeat | TrailingEscape | UnclosedClass | BadRange | BadGroup | BadRepeat

// nested is the row of a part of the pattern: all but Unopened, which
// only the whole pattern can find.
type nested = Unclosed | NothingToRepeat | TrailingEscape | UnclosedClass | BadRange | BadGroup | BadRepeat

// BadGroup is a "(?" that does not start a named group "(?<name>".
type BadGroup { At int }

// BadRepeat is a counted repeat above 1000, whose m is below its n, or
// whose copies would hold more than 4096 nodes. Text is the repeat as
// written.
type BadRepeat { At int, Text string }

// maxRepeat is the largest count of a counted repeat, Go's limit.
let maxRepeat = 1000

// maxNodes bounds the nodes of the copies a counted repeat writes out,
// as RC3 bounds the nodes of its expansion.
let maxNodes = 4096

// Unclosed is a "(" with no ")".
type Unclosed { At int }

// Unopened is a ")" with no "(".
type Unopened { At int }

// NothingToRepeat is a "*", "+" or "?" with no atom before it. Op is
// the operator's text: a byte has no conversion to text (G-ex-d-1), so
// the parser slices it out of the pattern.
type NothingToRepeat { At int, Op string }

// TrailingEscape is a "\" at the end of the pattern.
type TrailingEscape { At int }

// UnclosedClass is a "[" with no "]".
type UnclosedClass { At int }

// BadRange is a span whose low byte is above its high byte, as in [z-a].
// Text is the span as written.
type BadRange { At int, Text string }

// parser is a pattern's text and the offset of the next byte to read.
type parser { src string, at int }

// Parse is the tree of the pattern text.
func Parse(text string) Node fails SyntaxError {
	let mut p = parser{src: text, at: 0}
	let n = try p.alternation()
	if p.at < len(text) {
		// alternation stops only at the end or at a ")".
		return Unopened{At: p.at}
	}
	n
}

// more reports whether p has a byte left to read.
func more(p *parser) bool { p.at < len(p.src) }

// peek is the next byte of p. p has one.
func peek(p *parser) byte { p.src[p.at] }

// alternation reads cat { "|" cat }, left to right.
func alternation(p *parser) Node fails nested {
	let mut n = try p.concatenation()
	for p.more() && p.peek() == '|' {
		p.at += 1
		let right = try p.concatenation()
		n = Alt{Left: n, Right: right}
	}
	n
}

// concatenation reads repeats up to a "|", a ")" or the end. None is
// Empty, one is itself.
func concatenation(p *parser) Node fails nested {
	let mut parts = []Node{}
	for p.more() && p.peek() != '|' && p.peek() != ')' {
		parts = parts.Append(try p.repetition())
	}
	if len(parts) == 0 {
		return Empty
	}
	if len(parts) == 1 {
		return parts[0]
	}
	Cat{Parts: parts}
}

// repetition reads an atom and the "*", "+", "?" and counted repeats
// after it.
func repetition(p *parser) Node fails nested {
	let mut n = try p.atom()
	for p.more() {
		match p.peek() {
		case '*':
			n = Star{Of: n}
		case '+':
			n = Plus{Of: n}
		case '?':
			n = Quest{Of: n}
		case '{':
			match p.counted() {
			case Some[bounds] as s:
				let b = s.Value
				let copies = if b.Max == -1 { b.Min + 1 } else { b.Max }
				if b.Min > maxRepeat || b.Max > maxRepeat || (b.Max >= 0 && b.Max < b.Min) || Size(n)*copies > maxNodes {
					return BadRepeat{At: p.at, Text: p.src[p.at:b.End]}
				}
				n = Count{Of: n, Min: b.Min, Max: b.Max, As: Counted(n, b.Min, b.Max)}
				p.at = b.End - 1
			case None:
				return n
			}
		case _:
			return n
		}
		p.at += 1
	}
	n
}

// bounds is a counted repeat as read: its counts, Max -1 for no bound,
// and the offset after its "}".
type bounds { Min int, Max int, End int }

// counted reads the counted repeat at p's "{" without moving p, or is
// None when the "{" does not start one. A count above maxRepeat reads as
// maxRepeat+1.
func counted(p *parser) Option[bounds] {
	let mut at = p.at + 1
	let lo = digitRun(p.src, at)
	if lo.End == at {
		return None
	}
	at = lo.End
	if at < len(p.src) && p.src[at] == '}' {
		return Some{Value: bounds{Min: lo.Value, Max: lo.Value, End: at + 1}}
	}
	if at >= len(p.src) || p.src[at] != ',' {
		return None
	}
	at += 1
	let hi = digitRun(p.src, at)
	if hi.End >= len(p.src) || p.src[hi.End] != '}' {
		return None
	}
	if hi.End == at {
		return Some{Value: bounds{Min: lo.Value, Max: -1, End: hi.End + 1}}
	}
	Some{Value: bounds{Min: lo.Value, Max: hi.Value, End: hi.End + 1}}
}

// decimal is a run of digits read at some offset: its value, capped at
// maxRepeat+1, and the offset after it.
type decimal { Value int, End int }

// digitRun reads the digits of src from at.
func digitRun(src string, at int) decimal {
	let mut value = 0
	let mut end = at
	for end < len(src) && '0' <= src[end] && src[end] <= '9' {
		value = value*10 + int(src[end]-'0')
		if value > maxRepeat {
			value = maxRepeat + 1
		}
		end += 1
	}
	decimal{Value: value, End: end}
}

// atom reads one atom. The caller has seen a byte that is not "|" or ")".
func atom(p *parser) Node fails nested {
	let start = p.at
	let c = p.peek()
	p.at += 1
	match c {
	case '(':
		let mut name = ""
		let named = p.more() && p.peek() == '?'
		if named {
			name = try p.groupName(start)
		}
		let inner = try p.alternation()
		if !p.more() {
			return Unclosed{At: start}
		}
		p.at += 1
		if named {
			return Group{Name: name, Of: inner}
		}
		inner
	case '.':
		Any
	case '[':
		try p.class(start)
	case '\\':
		if p.more() && p.peek() == 'd' {
			p.at += 1
			return digits
		}
		Lit{C: try p.escaped(start)}
	case '{':
		p.at = start
		match p.counted() {
		case Some[bounds] as s:
			p.at = s.Value.End
			NothingToRepeat{At: start, Op: p.src[start:p.at]}
		case None:
			p.at = start + 1
			Lit{C: c}
		}
	case '*':
		NothingToRepeat{At: start, Op: p.src[start:p.at]}
	case '+':
		NothingToRepeat{At: start, Op: p.src[start:p.at]}
	case '?':
		NothingToRepeat{At: start, Op: p.src[start:p.at]}
	case _:
		Lit{C: c}
	}
}

// digits is the class that "\d" stands for: the ASCII digits.
let digits = Class{Spans: []Span{Span{Lo: '0', Hi: '9'}}, Negated: false}

// groupName reads "?<name>" after the "(" at start, and is the name.
func groupName(p *parser, start int) string fails BadGroup {
	p.at += 1
	if !p.more() || p.peek() != '<' {
		return BadGroup{At: start}
	}
	p.at += 1
	let from = p.at
	for p.more() && nameByte(p.peek(), p.at == from) {
		p.at += 1
	}
	if p.at == from || !p.more() || p.peek() != '>' {
		return BadGroup{At: start}
	}
	let name = p.src[from:p.at]
	p.at += 1
	name
}

// nameByte reports whether c may be a byte of a group name; first says
// it would be the name's first byte, which is not a digit.
func nameByte(c byte, first bool) bool {
	('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z') || c == '_' || (!first && '0' <= c && c <= '9')
}

// escaped is the byte after a "\" at start.
func escaped(p *parser, start int) byte fails TrailingEscape {
	if !p.more() {
		return TrailingEscape{At: start}
	}
	let c = p.peek()
	p.at += 1
	c
}

// class reads a class after its "[" at start, up to its "]". The first
// "]" ends it: a class has at least one item only when it is written so,
// and [] is an empty class, which matches no byte.
func class(p *parser, start int) Node fails UnclosedClass | TrailingEscape | BadRange {
	let mut negated = false
	if p.more() && p.peek() == '^' {
		negated = true
		p.at += 1
	}
	let mut spans = []Span{}
	for {
		if !p.more() {
			return UnclosedClass{At: start}
		}
		if p.peek() == ']' {
			p.at += 1
			return Class{Spans: spans, Negated: negated}
		}
		if p.peek() == '\\' && p.at+1 < len(p.src) && p.src[p.at+1] == 'd' {
			p.at += 2
			spans = spans.Append(Span{Lo: '0', Hi: '9'})
		} else {
			let at = p.at
			let lo = try p.classByte(start)
			let mut hi = lo
			if p.at+1 < len(p.src) && p.peek() == '-' && p.src[p.at+1] != ']' {
				p.at += 1
				hi = try p.classByte(start)
			}
			if lo > hi {
				return BadRange{At: at, Text: p.src[at:p.at]}
			}
			spans = spans.Append(Span{Lo: lo, Hi: hi})
		}
	}
}

// classByte reads one byte of a class, "\" taking the next as it is.
func classByte(p *parser, start int) byte fails UnclosedClass | TrailingEscape {
	if !p.more() {
		return UnclosedClass{At: start}
	}
	let c = p.peek()
	p.at += 1
	if c == '\\' {
		return try p.escaped(p.at - 1)
	}
	c
}

// Offset is the offset in the pattern that a failure of Parse names.
func Offset(e SyntaxError) int {
	match e {
	case Unclosed as u:
		u.At
	case Unopened as u:
		u.At
	case NothingToRepeat as n:
		n.At
	case TrailingEscape as t:
		t.At
	case UnclosedClass as u:
		u.At
	case BadRange as b:
		b.At
	case BadGroup as g:
		g.At
	case BadRepeat as r:
		r.At
	}
}

// Describe is the message of a failure of Parse.
func Describe(e SyntaxError) string {
	match e {
	case Unclosed as u:
		"missing ) for the ( at \(u.At)"
	case Unopened as u:
		"unexpected ) at \(u.At)"
	case NothingToRepeat as n:
		"nothing to repeat before \(n.Op) at \(n.At)"
	case TrailingEscape as t:
		"trailing \\ at \(t.At)"
	case UnclosedClass as u:
		"missing ] for the [ at \(u.At)"
	case BadRange as b:
		"bad range \(b.Text) at \(b.At)"
	case BadGroup as g:
		"bad group at \(g.At): want (?<name>"
	case BadRepeat as r:
		"bad repeat \(r.Text) at \(r.At)"
	}
}
