// The laws of Engine as checks over a provider value, for the providers'
// property tests. ergo test runs a member law only for providers in this
// package (G-exup-1), and it cannot be called, so each check restates
// its law's body (G-ex-c-5).

import regex/syntax

// LiteralMatchesItselfHolds is law LiteralMatchesItself for e.
func LiteralMatchesItselfHolds(e Engine, text string) bool { e.Compile(syntax.Literal(text)).Matches(text) }

// StarMatchesEmptyHolds is law StarMatchesEmpty for e.
func StarMatchesEmptyHolds(e Engine, seed int) bool { e.Compile(syntax.Star{Of: syntax.Sample(seed)}).Matches("") }

// AltIsEitherHolds is law AltIsEither for e.
func AltIsEitherHolds(e Engine, seed int, other int) bool {
	let a = syntax.Sample(seed)
	let b = syntax.Sample(other)
	let t = syntax.SampleText(seed + other)
	e.Compile(syntax.Alt{Left: a, Right: b}).Matches(t) == (e.Compile(a).Matches(t) || e.Compile(b).Matches(t))
}

// PlusIsOneThenStarHolds is law PlusIsOneThenStar for e.
func PlusIsOneThenStarHolds(e Engine, seed int) bool {
	let p = syntax.Sample(seed)
	let t = syntax.SampleText(seed)
	e.Compile(syntax.Plus{Of: p}).Matches(t) == e.Compile(syntax.Cat{Parts: []syntax.Node{p, syntax.Star{Of: p}}}).Matches(t)
}

// SearchFindsInsideHolds is law SearchFindsInside for e.
func SearchFindsInsideHolds(e Engine, seed int, before string, after string) bool {
	let p = syntax.Sample(seed)
	let t = syntax.SampleText(seed)
	!e.Compile(p).Matches(t) || e.Compile(syntax.Search(p)).Matches(before+t+after)
}

// RepeatableHolds is law Repeatable of Matcher for the matchers of e.
func RepeatableHolds(e Engine, seed int, other string) bool {
	let m = e.Compile(syntax.Sample(seed))
	let text = syntax.SampleText(seed)
	let first = m.Matches(text)
	let _ = m.Matches(other)
	m.Matches(text) == first
}
