// The NFA's tests: examples. ergo test runs the engine.Engine and
// engine.Matcher laws here, against Engine and Compiled.

import regex/syntax
import regex/engine
import strings

let Fast = context { engine.Engine: Engine }

// R2-reallocate: Boolean matcher laws cannot see per-line scratch setup.
// These counters count actual storage slots initialized, not allocations.
test WorkspaceReusesStorage {
	let c = NewSearchCompiled(try syntax.Parse("(c|m)at|h[aeiou]t"))
	let mut w = NewWorkspace(c.program.Len())
	let setup = w.Storage
	for text in []string{"cat", "none", "hot!", "", "mat", "no", "hat"} {
		let got = c.RunSearch(&w, text).Matched
		assert got == NewCompiled(syntax.Search(try syntax.Parse("(c|m)at|h[aeiou]t"))).Matches(text)
		assert w.Storage == setup
	}
	assert setup > 0
}

// R2-yield-stop: Boolean matching and iterator output equality do not
// observe pulling the source after the consumer has stopped.
test LinesStop {
	let c = NewSearchCompiled(syntax.Literal("cat"))
	let source = Seq[string](func(yield func(v string) bool) {
		if !yield("cat") {
			return
		}
		Unreachable("Lines pulled after its consumer stopped")
	})
	for line in c.Lines(source) {
		assert line == "cat"
		break
	}
}

// matches reports whether the NFA matches pattern, parsed, on text.
func matches(pattern string, text string) bool fails syntax.SyntaxError {
	Compile(Engine, try syntax.Parse(pattern)).Matches(text)
}

test MatchesWholeTexts {
	assert try matches("a(b|c)*d", "abcbd")
	assert !(try matches("a(b|c)*d", "abcb"))
	assert try matches("[^0-9]+x?", "abx")
	assert !(try matches("[^0-9]+", "a1"))
	assert try matches("", "")
	assert !(try matches("", "a"))
	assert try matches("(a*)*", "aaa")
	assert try matches("a.c", "a\nc")
	assert try matches("[]|x", "x")
	assert !(try matches("[]", ""))
}

// A pattern that makes a backtracker take exponential time runs in
// linear time here: (a?)^n a^n on a^n, with n = 40.
test PathologicalPatternIsLinear {
	let n = 40
	let pattern = strings.Repeat("a?", n) + strings.Repeat("a", n)
	assert try matches(pattern, strings.Repeat("a", n))
	assert !(try matches(pattern, strings.Repeat("a", n-1)))
}

test ProgramsAreSmall {
	let p = Build(try syntax.Parse("a(b|c)*d"))
	assert p.Len() == 7
}

// The samples are not vacuous: some patterns match their texts and some
// do not, so AgreesWithBacktrack compares both answers.
test SamplesMatchSometimes {
	let mut yes = 0
	for s in 0..400 {
		if Compile(Engine, syntax.Sample(s)).Matches(syntax.SampleText(s)) {
			yes += 1
		}
	}
	assert yes >= 40 && yes <= 360
}

// SearchSkipsImpossibleStarts catches R1-literal-machine: Boolean-only
// agreement cannot see a correct but unaccelerated literal search.
test SearchSkipsImpossibleStarts {
	let literal = NewSearchCompiled(syntax.Literal("cat"))
	let yes = literal.Measure("the cat sat")
	assert yes.Matched && yes.Starts == 0 && yes.Transitions == 0
	let no = literal.Measure("the dog sat")
	assert !no.Matched && no.Starts == 0 && no.Transitions == 0
	let partial = NewSearchCompiled(try syntax.Parse("cat[sz]"))
	let absent = partial.Measure("the dog sat")
	assert !absent.Matched && absent.Starts == 0 && absent.Transitions == 0
	let found = partial.Measure("cats!")
	assert found.Matched && found.Starts == 1 && found.Transitions > 0
	// Whole must not be routed through the literal Inside fast path.
	assert !(with Fast { engine.Select(syntax.Literal("cat"), engine.Whole) }).Matches("the cat sat")
	assert (with Fast { engine.Select(syntax.Literal("cat"), engine.Inside) }).Matches("the cat sat")
}

// Minimal repros of the R1 candidate-selection bugs. The old tests only
// exercise Whole or an already-expanded Search, never the new entry point.
test SearchKeepsNullableAndOverlappingCandidates {
	// R1-alt-prefix: neither alternative's entire prefix is required.
	assert Search(Engine, try syntax.Parse("ab|ac")).Matches("ac")
	// R1-nullable-prefix: an optional head is not a required prefix.
	assert Search(Engine, try syntax.Parse("a?b")).Matches("b")
	// R1-overlap: the failed aa.c at byte 0 must not skip byte 1.
	assert Search(Engine, try syntax.Parse("aa.c")).Matches("aaaac")
	// R1-live-candidate: a later start must not discard byte 0's state.
	assert Search(Engine, try syntax.Parse("a.ab")).Matches("aaab")
	// R1-early-accept: the text need not end at the pattern's Accept.
	assert Search(Engine, try syntax.Parse("a[bc]")).Matches("xab!")
	// R1-plus-complete: a repeated operand cannot join a fixed Cat prefix.
	assert Search(Engine, try syntax.Parse("xa+b")).Matches("xaab")
}
