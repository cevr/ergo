// Package nfa is the fast engine: a pattern compiles to a Thompson NFA,
// a program of instructions, and a machine runs it on the text one byte
// at a time, keeping the set of every instruction it could be at. It
// takes time linear in the text for every pattern.

import regex/syntax

// Inst is an instruction of a program. Byte, AnyByte and Set read one
// byte and go to Next; Split goes to both X and Y without reading;
// Accept is the end of a match.
type Inst = Byte{C byte, Next int} | AnyByte{Next int} | Set{Class syntax.Class, Next int} | Split{X int, Y int} | Accept{}

// Program is the instructions of a pattern and the one to start at.
type Program { insts []Inst, start int }

// Len is the number of instructions of p.
func Len(p Program) int { len(p.insts) }

// builder is a program while it is compiled.
type builder { insts []Inst }

// add appends i to b and is its index.
func add(b *builder, i Inst) int {
	b.insts = b.insts.Append(i)
	len(b.insts) - 1
}

// Build is the program of n. (Not Compile: Engine's Compile takes the name, G-ex-e-1.)
func Build(n syntax.Node) Program {
	let mut b = builder{insts: []Inst{}}
	let accept = b.add(Accept)
	let start = b.emit(n, accept)
	Program{insts: b.insts, start: start}
}

// emit adds the instructions of n, which go on to next after a match of
// n, and is the index of the first.
func emit(b *builder, n syntax.Node, next int) int {
	match n {
	case syntax.Empty:
		next
	case syntax.Lit as l:
		b.add(Byte{C: l.C, Next: next})
	case syntax.Any:
		b.add(AnyByte{Next: next})
	case syntax.Class as c:
		b.add(Set{Class: c, Next: next})
	case syntax.Cat as c:
		let mut at = next
		for i in 0..len(c.Parts) {
			at = b.emit(c.Parts[len(c.Parts)-1-i], at)
		}
		at
	case syntax.Alt as a:
		let x = b.emit(a.Left, next)
		let y = b.emit(a.Right, next)
		b.add(Split{X: x, Y: y})
	case syntax.Star as s:
		// The loop's Split is added first, so the body can go back to it.
		let loop = b.add(Split{X: next, Y: next})
		let body = b.emit(s.Of, loop)
		b.insts[loop] = Split{X: body, Y: next}
		loop
	case syntax.Plus as p:
		let loop = b.add(Split{X: next, Y: next})
		let body = b.emit(p.Of, loop)
		b.insts[loop] = Split{X: body, Y: next}
		body
	case syntax.Quest as q:
		let x = b.emit(q.Of, next)
		b.add(Split{X: x, Y: next})
	}
}
