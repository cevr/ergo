// The simulation: a machine whose state is the set of instructions the
// program could be at, and whose signals are the bytes of the text and
// its end.

import regex/engine
import regex/syntax
import slices
import regex/backtrack

// Signal is what the machine reads: a byte of the text, or its end.
type Signal = Read{C byte} | End{}

// Scan is the machine's state: the program, and the set of instructions
// it could be at, each one that reads a byte or Accept. A machine's state
// is a union (G-ex-c-16), so Scan is a union of one variant.
type Scan = Live{P Program, At []int}

// Start is the state before the first byte of a text.
func Start(p Program) Live { Live{P: p, At: closure(p, []int{p.start})} }

// Step moves the frontier over one byte. An empty frontier cannot match.
func Step(p Program, at []int, r Read) []int {
	advance(p, at, r.C)
}

// Finish reports whether the frontier holds an accepting instruction.
func Finish(p Program, at []int) bool { accepts(p, at) }

func simulationStart(p Program) Scan { Start(p) }

func decideScan(s Scan, sig Signal) Decision[Scan, bool] {
	match (s, sig) {
	case (Live as l, Read as r):
		let at = Step(l.P, l.At, r)
		if len(at) == 0 {
			return Done[bool]{Output: false}
		}
		Enter[Scan]{Next: Live{P: l.P, At: at}}
	case (Live as l, End):
		Done[bool]{Output: Finish(l.P, l.At)}
	}
}

// Simulation is the NFA as a machine. Its input is the program.
type Simulation machine[Scan, Signal] {
	initial: simulationStart,
	step:    decideScan,
}

// advance is the set after the byte c: the closure of the next
// instruction of each instruction of at that reads c.
func advance(p Program, at []int, c byte) []int {
	let mut next = []int{}
	for pc in at {
		match p.insts[pc] {
		case Byte as b:
			if b.C == c {
				next = next.Append(b.Next)
			}
		case AnyByte as a:
			next = next.Append(a.Next)
		case Set as s:
			if s.Class.Has(c) {
				next = next.Append(s.Next)
			}
		case Split, Save:
		case Accept:
		}
	}
	closure(p, next)
}

// accepts reports whether at holds Accept.
func accepts(p Program, at []int) bool {
	for pc in at {
		match p.insts[pc] {
		case Accept:
			return true
		case _:
		}
	}
	false
}

// visit is a set of instructions while a closure is built: the members,
// in the order they were found, and a mark for each instruction.
type visit { members []int, marked []bool }

// closure is the set of instructions that the instructions of from reach
// through Split, each once, keeping only the ones that read or Accept.
func closure(p Program, from []int) []int {
	let mut v = visit{members: []int{}, marked: slices.Repeat([]bool{false}, len(p.insts))}
	for pc in from {
		v.include(p, pc)
	}
	v.members
}

// include adds pc and what it reaches to v.
func include(v mut visit, p Program, pc int) {
	if v.marked[pc] {
		return
	}
	v.marked[pc] = true
	match p.insts[pc] {
	case Split as s:
		v.include(p, s.X)
		v.include(p, s.Y)
	case Save as s:
		v.include(p, s.Next)
	case _:
		v.members = v.members.Append(pc)
	}
}

// Engine is the NFA engine.
type Engine {} implements engine.Engine

// Compile is the Matcher of pattern: its program, run by the machine.
func Compile(_ Engine, pattern syntax.Node) engine.Matcher { NewCompiled(pattern) }

// AgreesWithBacktrack: on every sampled pattern and text, the NFA and
// the backtracking engine give the same answer. The texts are text, the
// empty text, and two sampled texts, which the pattern often matches.
law AgreesWithBacktrack(seed int, text string) {
	let p = syntax.Sample(seed)
	for t in []string{text, "", syntax.SampleText(seed), syntax.SampleText(seed + 1)} {
		if Compile(Engine, p).Matches(t) != backtrack.Compile(backtrack.Engine, p).Matches(t) {
			return false
		}
	}
	true
}

// Compiled is a pattern's program. Only Build makes a program the machine
// runs, so NewCompiled builds every Compiled, and ergo test builds each
// provider of the engine.Matcher laws with it.
type Compiled { program Program } implements engine.Matcher

// NewCompiled is the Compiled of pattern.
func NewCompiled(pattern syntax.Node) Compiled { Compiled{program: Build(pattern)} }

// Matches advances the frontier over text and finishes at its end.
func Matches(c Compiled, text string) bool {
	let (matched, _) = scanText(c.program, text)
	matched
}

// scanText returns the match and the number of bytes visited. No later
// byte can bring back an empty frontier, so stop at the byte that killed it.
func scanText(p Program, text string) (bool, int) {
	let mut at = Start(p).At
	for i in 0..len(text) {
		at = Step(p, at, Read{C: text[i]})
		if len(at) == 0 {
			return (false, i+1)
		}
	}
	(Finish(p, at), len(text))
}
