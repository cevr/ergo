// The NFA's own law: it agrees with the reference engine.

import regex/backtrack
import regex/syntax

// AgreesWithBacktrack: on every sampled pattern and text, the NFA and
// the backtracking engine give the same answer. The texts are text, the
// empty text, and two sampled texts, which the pattern often matches.
law AgreesWithBacktrack(seed int, text string) {
	let p = syntax.Sample(seed)
	for t in []string{text, "", syntax.SampleText(seed), syntax.SampleText(seed + 1)} {
		if Compile(Engine, p).Matches(t) != backtrack.Compile(backtrack.Engine, p).Matches(t) {
			return false
		}
	}
	true
}

// ProgramIsLinear: a program has at most one instruction per node of
// its pattern, and Accept.
law ProgramIsLinear(seed int) {
	let p = syntax.Sample(seed)
	Build(p).Len() <= syntax.Size(p)+1
}
