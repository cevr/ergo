// Package menu holds the program's menu: data, not a service, so it
// needs no contract.

import orderbuilder/order

func item(name string, price int) order.Item { order.Item{Name: name, Price: price, Slots: []order.Slot{}} }

func burger() order.Item { item("burger", 650) }

func wrap() order.Item { item("wrap", 600) }

func fries() order.Item { item("fries", 250) }

func salad() order.Item { item("salad", 300) }

// meal is a combo: a main and a side, in a box of 100.
func meal() order.Item {
	order.Item{Name: "meal", Price: 100, Slots: []order.Slot{order.Slot{Name: "main", Choices: []order.Item{burger(), wrap()}}, order.Slot{Name: "side", Choices: []order.Item{fries(), salad()}}}}
}

// family is a combo of two meals, each a combo: editors nest three deep.
func family() order.Item {
	order.Item{Name: "family", Price: 0, Slots: []order.Slot{order.Slot{Name: "first", Choices: []order.Item{meal()}}, order.Slot{Name: "second", Choices: []order.Item{meal()}}}}
}

// Sample is the menu: two pages.
func Sample() order.Menu {
	order.Menu{Pages: [][]order.Item{[]order.Item{burger(), fries(), meal()}, []order.Item{wrap(), salad(), family()}}}
}
