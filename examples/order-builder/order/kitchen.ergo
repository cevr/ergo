// Ticket is a kitchen's receipt of an order: its number and how many
// lines it has to make, parts included.
type Ticket { Number int, Lines int }

// Closed is a kitchen that takes no order.
type Closed { Why string }

// Kitchen is the contract the builder's screen needs to place an order.
type Kitchen {
	Send(o Order) Ticket fails Closed,

	// TicketCountsEveryLine: a ticket counts every line to make, the parts
	// of a combo included.
	law TicketCountsEveryLine(qty int, parts int) {
		let o = Order{Lines: []Line{Line{Item: "x", Price: 1, Qty: 1 + qty%3, Parts: partsOf(parts)}}, Total: 1}
		let t = Send(o) catch {
		case Closed:
			return true
		}
		t.Lines == CountLines(o.Lines)
	},
}

func partsOf(n int) []Line {
	let mut out = []Line{}
	for _ in 0..n%4 {
		out = out.Append(Line{Item: "p", Price: 1, Qty: 1, Parts: []Line{}})
	}
	out
}

// CountLines is the lines to make: each line and its parts, at depth.
func CountLines(lines []Line) int {
	let mut n = 0
	for l in lines {
		n = n + 1 + CountLines(l.Parts)
	}
	n
}
