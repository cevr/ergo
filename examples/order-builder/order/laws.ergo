// The hub's and the editor's rules as laws over their steps (machine
// laws, MU6, are not on this base). Children stopping with their entry,
// nested ones first, is the runner's rule (MU5); the cases run it.

import actor

func small(n int) int {
	let c = n % 3
	if c < 0 { -c } else { c }
}

// fixture is a menu of two pages with a combo of two slots.
func fixture() Menu {
	let a = Item{Name: "a", Price: 100, Slots: []Slot{}}
	let b = Item{Name: "b", Price: 200, Slots: []Slot{}}
	let combo = Item{Name: "ab", Price: 50, Slots: []Slot{Slot{Name: "x", Choices: []Item{a, b}}, Slot{Name: "y", Choices: []Item{b, a}}}}
	Menu{Pages: [][]Item{[]Item{a, b, combo}, []Item{combo, a}}}
}

func lineOf(n int) Line { Line{Item: "l\(small(n))", Price: small(n)*100 + 1, Qty: small(n) + 1, Parts: []Line{}} }

// screenAt is a hub screen picked by n.
func screenAt(n int, text string) Screen {
	let k = small(n)
	match k {
	case 0:
		Browsing{Page: small(n) % 2}
	case 1:
		Searching{Query: text, Page: 1}
	case _:
		Editing{Item: fixture().Pages[0][2], From: if n%2 == 0 { FromMenu{Page: 1} } else { FromSearch{Query: text, Page: 0} }, Editor: actor.NewHost[EditActor]()}
	}
}

func basketOf(ns []int) []Line {
	let mut out = []Line{}
	for n in ns {
		out = out.Append(lineOf(n))
	}
	out
}

func screenAfter(d Decision[Hub, Order]) Option[Screen] {
	match d {
	case Enter[Hub] as x:
		Some{x.Next.Screen}
	case Stay[Hub] as x:
		Some{x.Next.Screen}
	case _:
		None
	}
}

func basketAfter(d Decision[Hub, Order]) []Line {
	match d {
	case Enter[Hub] as x:
		x.Next.Basket
	case Stay[Hub] as x:
		x.Next.Basket
	case _:
		[]Line{}
	}
}

func sameScreen(a Screen, b Screen) bool {
	match (a, b) {
	case (Browsing as x, Browsing as y):
		x.Page == y.Page
	case (Searching as x, Searching as y):
		x.Query == y.Query && x.Page == y.Page
	case (_, _):
		false
	}
}

// HistoryRestores: an editor opened from a page or a search, and left
// with Back or with an added line, returns the hub to that page or search.
law HistoryRestores(page int, i int, query string, fromSearch bool, add bool) {
	let m = fixture()
	let from Screen = if fromSearch { Searching{Query: query, Page: small(page) % 2} } else { Browsing{Page: small(page) % 2} }
	let h = Hub{Menu: m, Basket: []Line{}, Screen: from}
	let items = match from {
	case Searching as q:
		Find(m, q.Query)
	case _:
		m.Pages[small(page)%2]
	}
	match screenAfter(Step(h, Open{Index: small(i)})) {
	case Some[Screen] as s:
		let ending HubSignal = if add { LineAdded{L: lineOf(i)} } else { EditorBack }
		match screenAfter(Step(Hub{..h, Screen: s.Value}, ending)) {
		case Some[Screen] as after:
			sameScreen(after.Value, from)
		case None:
			false
		}
	case None:
		small(i) >= len(items)
	}
}

// BackChangesNothing: an editor that ends with Back leaves the basket as
// it was; one that adds a line adds exactly that line.
law BackChangesNothing(ns []int, n int, text string, add bool) {
	let basket = basketOf(ns)
	let h = Hub{Menu: fixture(), Basket: basket, Screen: Editing{Item: fixture().Pages[0][0], From: FromMenu{Page: 0}, Editor: actor.NewHost[EditActor]()}}
	if add {
		let after = basketAfter(Step(h, LineAdded{L: lineOf(n)}))
		len(after) == len(basket)+1 && Total(after) == Total(basket)+Total([]Line{lineOf(n)})
	} else {
		let after = basketAfter(Step(h, EditorBack))
		len(after) == len(basket) && Total(after) == Total(basket)
	}
}

// NestedLinesInsideParent: a combo's line holds one part per slot, each
// the line its nested editor gave, and its price is the item's and its
// parts'.
law NestedLinesInsideParent(picks []int, qty int) {
	let combo = fixture().Pages[0][2]
	let mut s = editing(combo)
	let mut parts = []Line{}
	for k, slot in combo.Slots {
		let c = if k < len(picks) { small(picks[k]) % len(slot.Choices) } else { 0 }
		match editStep(s, Choose{Index: c}) {
		case Enter[Edit] as x:
			s = x.Next
		case _:
			return false
		}
		let part = LineOf(slot.Choices[c], 1+small(k+qty), []Line{})
		parts = parts.Append(part)
		match editStep(s, PartAdded{L: part}) {
		case Enter[Edit] as x:
			s = x.Next
		case _:
			return false
		}
	}
	for _ in 0..small(qty) {
		match editStep(s, More) {
		case Stay[Edit] as x:
			s = x.Next
		case _:
			return false
		}
	}
	match editStep(s, Add) {
	case Done[EditOut] as d:
		match d.Output {
		case Added as a:
			len(a.L.Parts) == len(combo.Slots) && a.L.Price == combo.Price+Total(parts) && a.L.Qty == small(qty)+1
		case WentBack:
			false
		}
	case _:
		false
	}
}

// QtyStaysPositive: Less at a quantity of one is refused.
law QtyStaysPositive(n int) {
	let s = Choosing{Item: fixture().Pages[0][0], Qty: 1, Parts: []Line{}}
	match editStep(s, Less) {
	case Reject:
		true
	case _:
		false
	}
}

// EditorOpensOnlyFromAList: no hub signal on any screen leaves the hub in
// an Editing screen it did not open from Browsing or Searching.
law EditorOpensOnlyFromAList(n int, m int, text string) {
	let s = screenAt(n, text)
	let h = Hub{Menu: fixture(), Basket: []Line{}, Screen: s}
	let e HubSignal = match small(m) + small(m/3)*3 {
	case 0:
		Open{Index: 0}
	case 1:
		Close
	case 2:
		Next
	case 3:
		Search
	case 4:
		Type{Text: text}
	case 5:
		Checkout
	case 6:
		EditorBack
	case 7:
		LineAdded{L: lineOf(m)}
	case _:
		Prev
	}
	match (s, screenAfter(Step(h, e))) {
	case (Editing, _):
		true
	case (_, Some[Screen] as next):
		match next.Value {
		case Editing:
			match e {
			case Open:
				true
			case _:
				false
			}
		case _:
			true
		}
	case (_, None):
		true
	}
}
