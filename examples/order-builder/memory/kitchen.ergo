// Package memory holds an in-memory provider of order.Kitchen.

import orderbuilder/order

// Kitchen numbers tickets by the order's total and refuses an order over
// 100.00. It keeps no state.
type Kitchen {}

func Send(_ Kitchen, o order.Order) order.Ticket fails order.Closed {
	if o.Total > 10000 {
		return order.Closed{Why: "orders over 100.00 need a call"}
	}
	order.Ticket{Number: 1 + o.Total%97, Lines: order.CountLines(o.Lines)}
}
