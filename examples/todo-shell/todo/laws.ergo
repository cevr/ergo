// The rules of a todo list as laws over its operations.

// AddCountsOne: an added item is one more item, open, at the end.
law AddCountsOne(texts []string, text string) {
	let l = Of(texts).Add(text)
	let last = l.At(l.Count()) catch {
	case NoSuchItem:
		return false
	}
	l.Count() == len(texts)+1 && last.Text == text && !last.Done
}

// CompleteIsIdempotent: completing an item twice is completing it once.
law CompleteIsIdempotent(texts []string, at int) {
	let once = Of(texts).Complete(at) catch {
	case NoSuchItem:
		return at < 1 || at > len(texts)
	}
	let twice = once.Complete(at) catch {
	case NoSuchItem:
		return false
	}
	Equal(once, twice)
}

// ReopenUndoesComplete: reopening an open item that was completed gives
// the list back.
law ReopenUndoesComplete(texts []string, at int) {
	let l = Of(texts)
	let back = Complete(l, at) catch {
	case NoSuchItem:
		return true
	}
	let again = back.Reopen(at) catch {
	case NoSuchItem:
		return false
	}
	Equal(again, l)
}

// DropRemovesOne: dropping an item keeps every other item, in order.
law DropRemovesOne(texts []string, at int) {
	let l = Of(texts).Drop(at) catch {
	case NoSuchItem:
		return at < 1 || at > len(texts)
	}
	let mut kept = []string{}
	for i, t in texts {
		if i+1 != at {
			kept = kept.Append(t)
		}
	}
	Equal(l, Of(kept))
}

// OpenAtMostCount: a list never has more open items than items.
law OpenAtMostCount(texts []string, at int) {
	let l = Of(texts).Complete(at) catch {
	case NoSuchItem:
		return Of(texts).Open() == len(texts)
	}
	l.Open() == l.Count()-1 && l.Open() >= 0
}
