// The list's tests: examples, and the laws restated as property tests
// over generated texts and numbers. The compiler checks laws and does not
// run them yet (#162); until it does, these tests run them.

test AddKeepsOrder {
	let l = Of([]string{"milk", "eggs"}).Add("bread")
	assert l.Count() == 3 && l.Open() == 3
	assert (try l.At(3)).Text == "bread" && (try l.At(1)).Text == "milk"
}

test CompleteMarksOne {
	let l = try Of([]string{"milk", "eggs"}).Complete(2)
	assert l.Open() == 1 && (try l.At(2)).Done && !(try l.At(1)).Done
}

test DropRenumbers {
	let l = try Of([]string{"milk", "eggs", "bread"}).Drop(1)
	assert l.Count() == 2 && (try l.At(1)).Text == "eggs"
}

test NoItemZero {
	let at = Of([]string{"milk"}).At(0) catch {
	case NoSuchItem as n:
		Item{Text: "missing \(n.At) of \(n.Count)", Note: "", Done: false}
	}
	assert at.Text == "missing 0 of 1"
}

// pick is a number of an item of a list of texts, from any n, so a
// property test names an item in every case. texts is not empty.
func pick(texts []string, n int) int {
	let m = if n < 0 { -(n + 1) } else { n }
	1 + m%len(texts)
}

test AddCountsOneHolds(texts []string, text string) {
	let l = Of(texts).Add(text)
	let last = try l.At(l.Count())
	assert l.Count() == len(texts)+1 && last.Text == text && !last.Done
}

test CompleteIsIdempotentHolds(texts []string, n int) {
	if len(texts) == 0 {
		return
	}
	let at = pick(texts, n)
	let once = try Of(texts).Complete(at)
	assert Equal(once, try once.Complete(at))
}

test ReopenUndoesCompleteHolds(texts []string, n int) {
	if len(texts) == 0 {
		return
	}
	let at = pick(texts, n)
	let l = Of(texts)
	assert Equal(try (try l.Complete(at)).Reopen(at), l)
}

test DropRemovesOneHolds(texts []string, n int) {
	if len(texts) == 0 {
		return
	}
	let at = pick(texts, n)
	let mut kept = []string{}
	for i, t in texts {
		if i+1 != at {
			kept = kept.Append(t)
		}
	}
	assert Equal(try Of(texts).Drop(at), Of(kept))
}

// countIn is the Count that Drop(at) of l fails with, or -1 when it
// drops an item.
func countIn(l List, at int) int {
	let _ = l.Drop(at) catch {
	case NoSuchItem as e:
		return e.Count
	}
	-1
}

test OutOfRangeIsNoSuchItem(texts []string, at int) {
	if at >= 1 && at <= len(texts) {
		return
	}
	assert countIn(Of(texts), at) == len(texts)
}
