// The list's tests: examples and one property. ergo test runs the laws of
// laws.ergo itself (#162).

test AddKeepsOrder {
	let l = Of([]string{"milk", "eggs"}).Add("bread")
	assert l.Count() == 3 && l.Open() == 3
	assert (try l.At(3)).Text == "bread" && (try l.At(1)).Text == "milk"
}

test CompleteMarksOne {
	let l = try Of([]string{"milk", "eggs"}).Complete(2)
	assert l.Open() == 1 && (try l.At(2)).Done && !(try l.At(1)).Done
}

test DropRenumbers {
	let l = try Of([]string{"milk", "eggs", "bread"}).Drop(1)
	assert l.Count() == 2 && (try l.At(1)).Text == "eggs"
}

test NoItemZero {
	let at = Of([]string{"milk"}).At(0) catch {
	case NoSuchItem as n:
		Item{Text: "missing \(n.At) of \(n.Count)", Note: "", Done: false}
	}
	assert at.Text == "missing 0 of 1"
}

// countIn is the Count that Drop(at) of l fails with, or -1 when it
// drops an item.
func countIn(l List, at int) int {
	let _ = l.Drop(at) catch {
	case NoSuchItem as e:
		return e.Count
	}
	-1
}

test OutOfRangeIsNoSuchItem(texts []string, at int) {
	if at >= 1 && at <= len(texts) {
		return
	}
	assert countIn(Of(texts), at) == len(texts)
}
