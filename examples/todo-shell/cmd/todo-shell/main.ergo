// todo-shell is a small interactive todo list: it reads commands from
// standard input, one per line, and answers on standard output. Package
// todo is the list; package shell is the line protocol, a machine of
// modes. This binary is the only place that chooses the providers: the
// host's standard input and output.

import io
import todoshell/shell

func main() needs Console | Ambient {
	with context { io.Stdin: io.NewStdin(), io.Stdout: io.NewHost() } {
		let l = shell.Run()
		Console.Println("bye: \(l.Open()) open of \(l.Count())")
	}
}
