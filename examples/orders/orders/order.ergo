// Package orders is the domain of the orders server: a draft that a
// customer sends, the order it becomes, the lifecycle of an order as a
// machine, and Book, the contract of the store of orders, with its laws.
// It knows nothing of HTTP or JSON: package api maps its failures to
// status codes.

import machines

// Line is one product of an order: its SKU, how many, and the price of
// one in cents.
type Line { SKU string, Quantity int, Cents int }

// Draft is what a customer sends to place an order.
type Draft { Customer string, Lines []Line }

// Order is a placed order. Total is the sum of each line's quantity times
// its price, in cents.
type Order { ID string, Customer string, Lines []Line, Total int, Status Status }

// Invalid is a draft that breaks a rule. Field names the part of the
// draft, such as "lines[1].quantity".
type Invalid { Field string, Reason string }

// MaxQuantity is the most of one product a line may order.
let MaxQuantity = 1000

// MaxCents is the highest price of one product, in cents. With
// MaxQuantity and MaxLines it keeps a total far from the bounds of an
// int.
let MaxCents = 100_000_000

// MaxLines is the most lines of an order.
let MaxLines = 1_000

// Validate fails Invalid at the first rule d breaks: a customer is named,
// an order has at least one line, a line has a SKU, a quantity from 1 to
// MaxQuantity and a price from 0 to MaxCents, and there are at most
// MaxLines lines.
func Validate(d Draft) fails Invalid {
	if d.Customer == "" {
		return Invalid{Field: "customer", Reason: "is empty"}
	}
	if len(d.Lines) == 0 {
		return Invalid{Field: "lines", Reason: "an order has at least one line"}
	}
	if len(d.Lines) > MaxLines {
		return Invalid{Field: "lines", Reason: "an order has at most \(MaxLines) lines"}
	}
	for i, l in d.Lines {
		let at = "lines[\(i)]"
		if l.SKU == "" {
			return Invalid{Field: at + ".sku", Reason: "is empty"}
		}
		if l.Quantity < 1 || l.Quantity > MaxQuantity {
			return Invalid{Field: at + ".quantity", Reason: "is not from 1 to \(MaxQuantity)"}
		}
		if l.Cents < 0 {
			return Invalid{Field: at + ".cents", Reason: "is negative"}
		}
		if l.Cents > MaxCents {
			return Invalid{Field: at + ".cents", Reason: "is more than \(MaxCents)"}
		}
	}
}

// Total is the sum of each line's quantity times its price.
func Total(lines []Line) int {
	let mut sum = 0
	for l in lines {
		sum = sum + l.Quantity*l.Cents
	}
	sum
}

// Place adds the order d describes to the Book, with the next ID, and is
// the order. An invalid draft adds nothing.
func Place(d Draft) Order fails Invalid needs Book {
	try Validate(d)
	let o = Order{ID: "ord-\(Book.Count() + 1)", Customer: d.Customer, Lines: d.Lines, Total: Total(d.Lines), Status: Placed}
	Book.Add(o) catch {
	case Taken as t:
		// Count only grows and IDs follow it, so an ID is never taken
		// twice: a store that says so breaks its laws.
		return Invalid{Field: "id", Reason: "the book already holds \(t.ID)"}
	}
	o
}

// Apply moves the order id by the event e, as its lifecycle allows, and
// is the order after it. An event the lifecycle refuses fails Conflict
// and changes nothing; one it ignores changes nothing too.
func Apply(id string, e Event) Order fails NotFound | Conflict needs Book {
	let o = try Book.Find(id)
	let d = Step(o.Status, e)
	match d {
	case Ignore:
		return o
	case Reject:
		return Conflict{ID: id, Status: Name(o.Status), Event: EventName(e)}
	case Enter[Status], Stay[Status], Emit[Status, Status], Done[Status]:
	}
	let changed = Order{..o, Status: machines.Next(o.Status, d)}
	try Book.Replace(changed)
	changed
}
