// The wire format's tests over a memory.Ledger and an io.Recorder, and
// the laws restated as property tests (#162).

import io
import orders/api
import orders/memory
import orders/orders
import strings

// served is the text Serve writes for text, over a new Ledger.
func served(text string) string {
	let out = io.NewRecorder()
	let _ = with context { orders.Book: memory.New(), io.Stdout: out } { Serve(text) }
	out.Text()
}

test ReadRequestReadsAPost {
	let text = "POST /orders?x=1 HTTP/1.1\r\nHost: shop\r\nContent-Length: 2\r\n\r\n{}GET / HTTP/1.1\r\n\r\n"
	let r, end = try ReadRequest(text, 0)
	assert r.Method == "POST" && r.Path == "/orders" && r.Body == "{}"
	assert api.HeaderOf(r.Headers, "host") == Some[string]{Value: "shop"}
	assert strings.Slice(text, end, len(text)) == "GET / HTTP/1.1\r\n\r\n"
}

// garbled is the reason ReadRequest fails with on text, or "read".
func garbled(text string) string {
	let _, _ = ReadRequest(text, 0) catch {
	case Garbled as g:
		return "\(g.At): \(g.Reason)"
	}
	"read"
}

test ReadRequestRefusesGarbage {
	assert garbled("hello\r\n\r\n") == "0: not a request line"
	assert garbled("GET / HTTP/2\r\n\r\n") == "0: not HTTP/1.x: HTTP/2"
	assert garbled("GET / HTTP/1.1\r\nHost") == "16: the head does not end"
	assert garbled("GET / HTTP/1.1\r\nbad\r\n\r\n") == "21: a header with no ':'"
	assert garbled("POST / HTTP/1.1\r\nContent-Length: 9\r\n\r\n{}") == "38: the body is shorter than its Content-Length"
	assert garbled("GET / HTTP/1.1\nHost: lf\n\n") == "read"
}

test AConnectionOfThreeRequests {
	let body = "{\"customer\":\"ada\",\"lines\":[{\"sku\":\"tea\",\"quantity\":1,\"cents\":450}]}"
	let text = "POST /orders HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: \(len(body))\r\n\r\n" + body + "\r\nGET /orders/ord-1 HTTP/1.1\r\n\r\nGET /orders/ord-2 HTTP/1.1\r\nConnection: close\r\n\r\nGET /orders HTTP/1.1\r\n\r\n"
	let want = "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nLocation: /orders/ord-1\r\nContent-Length: 110\r\n\r\n{\"id\":\"ord-1\",\"customer\":\"ada\",\"status\":\"placed\",\"total\":450,\"lines\":[{\"sku\":\"tea\",\"quantity\":1,\"cents\":450}]}" + "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 110\r\n\r\n{\"id\":\"ord-1\",\"customer\":\"ada\",\"status\":\"placed\",\"total\":450,\"lines\":[{\"sku\":\"tea\",\"quantity\":1,\"cents\":450}]}" + "HTTP/1.1 404 Not Found\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: 26\r\n\r\n{\"error\":\"no order ord-2\"}"
	assert served(text) == want
}

test AGarbledRequestEndsTheConnection {
	assert served("GET /orders HTTP/1.1\r\n\r\nBREW /pot HTCPCP/1.0\r\n\r\nGET /orders HTTP/1.1\r\n\r\n") == "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n[]HTTP/1.1 400 Bad Request\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: 64\r\n\r\n{\"error\":\"garbled request at byte 24: not HTTP/1.x: HTCPCP/1.0\"}"
}

test RequestRoundTripHolds(r api.Request) {
	let s = Sane(r)
	let back, end = try ReadRequest(WriteRequest(s), 0)
	assert SameRequest(back, s)
	assert end == len(WriteRequest(s))
}

test PipelinedRequestsAreAnsweredInOrderHolds(paths []string) {
	assert PipelinedHolds(memory.New(), paths)
}

test ContentLengthIsTheBodyHolds(status int, body string) {
	assert strings.HasSuffix(WriteResponse(api.Response{Status: status, Headers: []api.Header{}, Body: body}), "Content-Length: \(len(body))\r\n\r\n"+body)
}
