// The parser's examples. The laws run under ergo test.

// failure is the offset and reason Parse(text) fails with, or "parsed".
func failure(text string) string {
	let _ = Parse(text) catch {
	case Malformed as m:
		return "\(m.At): \(m.Reason)"
	}
	"parsed"
}

test ParseReadsEachKind {
	let v = try Parse(" {\"a\": [null, true, false, -1.5e3, \"x\\ty\\/z\\u00e9\"], \"b\": {}} ")
	assert Encode(v) == "{\"a\":[null,true,false,-1.5e3,\"x\\ty/zé\"],\"b\":{}}"
}

test ParseRefusesWhatIsNotJSON {
	assert failure("") == "0: a value is missing"
	assert failure("{\"a\" 1}") == "5: ':' is missing"
	assert failure("[1,]") == "3: not a value"
	assert failure("01") == "0: a leading zero"
	assert failure("1 2") == "2: text after the value"
	assert failure("\"a\nb\"") == "2: a control byte in a string"
	assert failure("\"\\q\"") == "0: a bad escape in a string"
	assert failure("[1") == "2: ',' or ']' is missing"
	assert failure("nul") == "0: not a value"
}

test QuoteWritesJSONEscapes {
	assert Quote("a\"b\\c\n\a\U0001F600") == "\"a\\\"b\\\\c\\n\\u0007😀\""
	assert Quote("\x7f") == "\"\\u007f\""
}

// found is the text of a found value, or "none". An Option[Value] holds a
// Value, which holds slices, so == does not compare it.
func found(v Option[Value]) string {
	match v {
	case Some[Value] as s:
		Encode(s.Value)
	case None:
		"none"
	}
}

test MemberAndInt {
	let o = Obj{Fields: []Field{Field{Name: "n", Value: Number{Text: "42"}}, Field{Name: "f", Value: Number{Text: "4.2"}}}}
	assert found(Member(o, "n")) == "42"
	assert found(Member(o, "x")) == "none"
	assert Int(Number{Text: "42"}) == Some[int]{Value: 42}
	assert Int(Number{Text: "4.2"}) == None
}
