// The rules of JSON text as laws over Parse and Encode.

import strings

// RoundTrip: the text of a value parses back to the value. Sane makes
// each generated Number a JSON number first.
law RoundTrip(v Value) {
	let s = Sane(v)
	Equal(try Parse(Encode(s)), s)
}

// WhiteSpaceIsIgnored: white space around a value and its text does not
// change it.
law WhiteSpaceIsIgnored(v Value) {
	let s = Sane(v)
	Equal(try Parse(" \n\t"+Encode(s)+"\r\n "), s)
}

// EncodeIsOneLine: the text of a value holds no line feed, so a value is
// one line of a log or a response.
law EncodeIsOneLine(v Value) { !strings.Contains(Encode(Sane(v)), "\n") }

// QuoteRoundTrip: a quoted string of valid UTF-8 parses back to itself.
law QuoteRoundTrip(s string) {
	if !ValidUTF8(s) {
		return true
	}
	Equal(try Parse(Quote(s)), Str{V: s})
}

// Sane is v with each Number whose text is not a JSON number replaced by
// the length of its text, so a generated Value has valid numbers.
func Sane(v Value) Value {
	match v {
	case Number as n:
		if isNumber(n.Text) {
			return n
		}
		Number{Text: "\(len(n.Text))"}
	case Arr as a:
		let mut items = []Value{}
		for x in a.Items {
			items = items.Append(Sane(x))
		}
		Arr{Items: items}
	case Obj as o:
		let mut fields = []Field{}
		for f in o.Fields {
			fields = fields.Append(Field{Name: f.Name, Value: Sane(f.Value)})
		}
		Obj{Fields: fields}
	case Null, Bool, Str:
		v
	}
}

// isNumber reports whether text is exactly one JSON number.
func isNumber(text string) bool {
	if text == "" {
		return false
	}
	let _, end = numeral(text, 0) catch {
	case Malformed:
		return false
	}
	end == len(text)
}

// ValidUTF8 reports whether s is valid UTF-8. Ergo's std has no utf8
// package; a user extern binds Go's unicode/utf8, which is pure.
extern go unicode/utf8.ValidString func ValidUTF8(s string) bool
