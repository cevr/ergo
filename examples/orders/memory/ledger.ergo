// Package memory holds Ledger, the in-memory orders.Book. The server
// keeps its orders for one run: Ergo has no listener yet, so a run is one
// connection (cmd/orders).

import orders/orders
import sync

// entries is what a Ledger holds: the orders by ID, and the IDs in the
// order they were added.
type entries { byID Map[string, orders.Order], order []string }

// Ledger is an orders.Book in memory. Its entries are in a sync.Ref, so
// every copy of a Ledger is the same store: a Ledger bound in a context
// keeps its orders from one request to the next. NewLedger makes one.
type Ledger { cell sync.Ref[entries] }

// NewLedger is an empty Ledger.
func NewLedger() Ledger {
	Ledger{cell: sync.NewRef[entries](entries{byID: Map[string, orders.Order]{}, order: []string{}})}
}

// Add keeps o under its ID.
func Add(l Ledger, o orders.Order) fails orders.Taken {
	let added = sync.Modify(l.cell, func(e entries) (bool, entries) {
		if e.byID.Get(o.ID) != None {
			return (false, e)
		}
		let mut byID = e.byID
		byID[o.ID] = o
		(true, entries{byID: byID, order: e.order.Append(o.ID)})
	})
	if !added {
		return orders.Taken{ID: o.ID}
	}
}

// Replace keeps o in place of the order of its ID.
func Replace(l Ledger, o orders.Order) fails orders.NotFound {
	let found = sync.Modify(l.cell, func(e entries) (bool, entries) {
		if e.byID.Get(o.ID) == None {
			return (false, e)
		}
		let mut byID = e.byID
		byID[o.ID] = o
		(true, entries{..e, byID: byID})
	})
	if !found {
		return orders.NotFound{ID: o.ID}
	}
}

// Find is the order of id.
func Find(l Ledger, id string) orders.Order fails orders.NotFound {
	match l.cell.Get().byID.Get(id) {
	case Some[orders.Order] as o:
		o.Value
	case None:
		orders.NotFound{ID: id}
	}
}

// All is every order, in the order they were added.
func All(l Ledger) []orders.Order {
	let e = l.cell.Get()
	let mut out = []orders.Order{}
	for id in e.order {
		match e.byID.Get(id) {
		case Some[orders.Order] as o:
			out = out.Append(o.Value)
		case None:
		}
	}
	out
}

// Count is how many orders the Ledger holds.
func Count(l Ledger) int { len(l.cell.Get().byID) }
