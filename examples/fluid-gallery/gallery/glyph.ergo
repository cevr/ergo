// Glyphs the specimens draw. Plus, ArrowRight, Search, Copy, ChevronLeft and ChevronRight are Lucide's (ISC; derived from Feather,
// MIT: ../licenses/lucide.txt), drawn with the original's stroke of 1.5; Eight is the
// original's busy glyph, a figure eight traced by a dash.

// Glyph is a glyph a specimen draws.
type Glyph = Plus{} | ArrowRight{} | Search{} | Copy{} | ChevronLeft{} | ChevronRight{} | Eight{}

// markup is a glyph's SVG markup, with class on its root.
func markup(g Glyph, class string) string {
	let open = "<svg class=\"" + class + "\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">"
	match g {
	case Plus:
		open + "<path d=\"M5 12h14\"></path><path d=\"M12 5v14\"></path></svg>"
	case ArrowRight:
		open + "<path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg>"
	case Search:
		open + "<path d=\"m21 21-4.34-4.34\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle></svg>"
	case Copy:
		open + "<rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"></rect><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"></path></svg>"
	case ChevronLeft:
		open + "<path d=\"m15 18-6-6 6-6\"></path></svg>"
	case ChevronRight:
		open + "<path d=\"m9 18 6-6-6-6\"></path></svg>"
	case Eight:
		"<svg class=\"" + class + "\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 12C14 8.5 19 8.5 19 12C19 15.5 14 15.5 12 12C10 8.5 5 8.5 5 12C5 15.5 10 15.5 12 12Z\" stroke=\"currentColor\" stroke-width=\"1.125\" stroke-linecap=\"round\" stroke-dasharray=\"15 85\" pathLength=\"100\"></path></svg>"
	}
}
