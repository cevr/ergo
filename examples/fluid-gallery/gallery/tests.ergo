import ergo.dev/fluid/web
import appweb github.com/cevr/ergo/modules/web

// ResolvedOncePerLook: the gallery resolves its looks to classes once, when the program starts;
// a hundred renders of each page resolve none. Mutant it kills: a view that resolves a look per
// render (web.Classes inside a page's view), which no law sees, since the page's bytes are the
// same either way.
test ResolvedOncePerLook {
	let before = web.Resolutions()
	for _ in 0..100 {
		for path in []string{"/docs/button", "/docs/badge"} {
			assert appweb.Fetch(Site(), appweb.Request("GET", path)).Status == 200
		}
	}
	assert web.Resolutions() == before
}
