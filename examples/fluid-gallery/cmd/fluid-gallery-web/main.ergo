// fluid-gallery-web serves the gallery of ergo.dev/fluid: /docs/<component> is a component's
// page, built by gallery.Site through web.Fetch, and /fonts/ is the folder given as the first
// argument (the gallery's pages ask for /fonts/InterVariable.ttf; no font is in the repo).
// It prints its address first, then serves until it is stopped.

import fluidgallery/gallery
import fs
import http
import io
import os
import strings
import github.com/cevr/ergo/modules/web
import time

// Usage: the fonts folder is missing.
type Usage { Text string }

func main() fails Usage | fs.NotFound | fs.Denied | fs.Failed | http.ListenFailed | http.InvalidLimits needs io.Console | os.Ambient {
	let args = with context { os.Process: os.NewHost() } { os.Process.Args() }
	if args.Len() < 1 || args.Len() > 2 {
		return Usage{Text: "usage: fluid-gallery-web FONT-FOLDER [ADDR]"}
	}
	let addr = if args.Len() == 2 { args[1] } else { "127.0.0.1:0" }
	let fonts = try fs.OpenRoot(args[0])
	let site = gallery.Site()
	let l = try http.Listen(addr)
	io.Console.Println("listening \(l.Addr())")
	with context { time.Scheduler: time.NewLiveScheduler() } {
		try http.Serve(l, http.Limits{MaxBodyBytes: 65536, MaxHeaderBytes: 16384, IdleTimeout: 5s, ReadHeaderTimeout: 10s, ReadBodyTimeout: 30s}, func(r http.Request) http.Response needs http.Streaming {
			if strings.HasPrefix(r.Path, "/fonts/") {
				return http.Files(fonts, "/fonts/", r)
			}
			web.Fetch(site, r)
		})
	}
}
