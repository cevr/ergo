// fluid-gallery prints the answer the gallery's site gives to GET of each path it is given: the
// status line, then the page. No server and no socket: each path is one web.Fetch. (FL4 makes
// this binary the headless leg, a script played on ui.TestHost.)

import fluidgallery/gallery
import os
import github.com/cevr/ergo/modules/web

// Usage: no path was given.
type Usage { Text string }

func main() fails Usage needs Console | Ambient {
	let args = with context { os.Process: os.NewHost() } { os.Process.Args() }
	if len(args) == 0 {
		return Usage{Text: "usage: fluid-gallery PATH..."}
	}
	let site = gallery.Site()
	for path in args {
		let answer = web.Fetch(site, web.Request("GET", path))
		Console.Println("GET \(path) -> \(answer.Status)")
		Console.Println(answer.Body)
	}
}
