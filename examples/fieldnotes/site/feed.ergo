import fieldnotes/journal
import html
import strings
import ui

// FeedText is the RSS 2.0 feed of entries: the journal's title and link,
// and an item for each entry with its title, its link and its first
// paragraph. Every text is XML text (law FeedIsWellFormed): valid UTF-8,
// with no control byte but tab and line breaks, and escaped.
func FeedText(origin string, entries []journal.Entry) string {
	let mut b = strings.NewBuilder()
	b.WriteString("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\"><channel>")
	b.WriteString("<title>Field notes</title><link>" + xmlText(origin+"/") + "</link><description>A field journal</description>")
	for e in entries {
		let at = xmlText(origin + ui.Href(Href(Map, Entry{Slug: e.Slug})))
		b.WriteString("<item><title>" + xmlText(e.Title) + "</title><link>" + at + "</link><guid>" + at + "</guid>")
		if e.Body.Len() > 0 {
			b.WriteString("<description>" + xmlText(e.Body[0]) + "</description>")
		}
		b.WriteString("</item>")
	}
	b.WriteString("</channel></rss>\n")
	b.String()
}

// xmlText is s as XML text: a byte that is not UTF-8 is U+FFFD, a control
// byte other than tab, line feed and carriage return is dropped, and the
// rest escaped as html escapes text.
func xmlText(s string) string {
	let valid = strings.ToValidUTF8(s, "�")
	let mut b = strings.NewBuilder()
	for i in 0..valid.Len() {
		let c = valid[i]
		if c >= 0x20 || c == '\t' || c == '\n' || c == '\r' {
			b.WriteByte(c)
		}
	}
	html.Escape(b.String())
}
