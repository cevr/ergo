// Package screen draws the picker as ANSI text: a frame clears the screen,
// writes a header, and writes each visible item, the one under the cursor
// in reverse video. Lines end with CR LF, as a terminal in raw mode needs.
// The codes are std ansi's; the cursor's line is reverse video whatever
// NO_COLOR says, since reverse is how the picker shows the cursor, not a
// colour, so it writes ansi.SGR itself rather than ansi.Paint.

import ansi
import tui/picker
import strings

let clear = ansi.Home + ansi.ClearScreen
let reverse = ansi.SGR(ansi.Style{..ansi.Plain, Reverse: true})

// Frame is the screen of m.
func Frame(m picker.Mode) string {
	let v = picker.ViewOf(m)
	let mut out = clear + Header(m) + "\r\n"
	let shown = picker.Visible(v)
	if len(shown) == 0 {
		return out + "  (no match)\r\n"
	}
	for i, item in shown {
		out = out + (if i == v.Cursor { Marked(item) } else { "  " + item }) + "\r\n"
	}
	out
}

// Header is the first line of m's screen: the filter being typed, or the
// keys and the filter that holds.
func Header(m picker.Mode) string {
	match m {
	case picker.Filtering as f:
		"filter: " + f.View.Filter + "_"
	case picker.Browsing as b:
		let help = "/ filter  up/down move  enter pick  q quit"
		if b.View.Filter == "" { help } else { help + "  [" + b.View.Filter + "]" }
	}
}

// Marked is the line of the item under the cursor.
func Marked(item string) string { reverse + "> " + item + ansi.Reset }

// OneLineIsMarked: a frame marks exactly one line, the item under the
// cursor, when an item is visible, and none otherwise; and it has one
// line per visible item after its header. m's cursor is put on the list
// first, as the picker keeps it. A generated filter seldom matches, so
// the law also draws m with no filter, which shows every item.
law OneLineIsMarked(m picker.Mode) {
	let v = picker.ViewOf(m)
	marks(m, v) && marks(m, picker.View{..v, Filter: ""})
}

// marks checks OneLineIsMarked for the mode of m with the view v.
func marks(m picker.Mode, v picker.View) bool {
	let shown = picker.Visible(v)
	let cursor = if len(shown) == 0 { 0 } else { (if v.Cursor < 0 { -(v.Cursor + 1) } else { v.Cursor }) % len(shown) }
	let placed = match m {
	case picker.Browsing:
		picker.Browsing{View: picker.View{..v, Cursor: cursor}}
	case picker.Filtering:
		picker.Filtering{View: picker.View{..v, Cursor: cursor}}
	}
	let frame = Frame(placed)
	let lines = strings.Split(strings.TrimSuffix(frame, "\r\n"), "\r\n")
	if len(shown) == 0 {
		return strings.Count(frame, reverse) == 0 && len(lines) == 2
	}
	strings.Count(frame, reverse) == 1 && lines[cursor+1] == Marked(shown[cursor]) && len(lines) == len(shown)+1
}
