// The bytes of each key. `ergo test` runs the laws.

test TheBytesOfEachKey {
	assert Decode("\x1b[A\x1b[Bé\r\x7f\x1b\x03x\n\x08") == []Key{Up, Down, Char{Text: "é"}, Return, Backspace, Escape, Interrupt, Char{Text: "x"}, Return, Backspace}
	assert Decode("\x1b[C\x01a") == []Key{Char{Text: "a"}}
	assert Decode("\x1b[") == []Key{Escape, Char{Text: "["}}
	assert Decode("") == []Key{}
}
