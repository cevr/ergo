// Package keys reads the bytes a terminal sends for each key, as a
// terminal in raw mode sends them: arrows as ANSI escape sequences, Return
// as a carriage return, Backspace as DEL.

import strings
import utf8

// Key is one key a person pressed.
type Key = Up{} | Down{} | Return{} | Backspace{} | Escape{} | Interrupt{} | Char{Text string}

// RoundTrip: the bytes of keys decode to the keys.
law RoundTrip(keys []Key) {
	let sane = sane(keys)
	Decode(Script(sane)) == sane
}

// sane is keys as a terminal can send them apart: each Char one letter,
// digit or space. A Char "[" after an Escape would read as an escape
// sequence, as it does on a real terminal, which tells them apart by time.
func sane(keys []Key) []Key {
	let letters = "abcdefghijklmnopqrstuvwxyz0123456789 "
	let mut out = []Key{}
	for k in keys {
		match k {
		case Char as c:
			let n = if len(c.Text) == 0 { 0 } else { int(c.Text[0]) % len(letters) }
			out = out.Append(Char{Text: strings.Slice(letters, n, n+1)})
		case Up, Down, Return, Backspace, Escape, Interrupt:
			out = out.Append(k)
		}
	}
	out
}

let esc = "\x1b"

// Decode is the keys of text, in order. An arrow is ESC [ A or ESC [ B; an
// ESC that no '[' follows is Escape; CR or LF is Return (Enter); DEL or BS is
// Backspace; Ctrl-C is Interrupt; a printable character, one UTF-8
// sequence, is a Char. Any other control byte, and any other escape
// sequence of three bytes, is skipped.
func Decode(text string) []Key {
	let mut out = []Key{}
	let mut i = 0
	for i < len(text) {
		let c = text[i]
		if c == 27 {
			if i+2 < len(text) && text[i+1] == '[' {
				let final = text[i+2]
				if final == 'A' {
					out = out.Append(Up)
				} else if final == 'B' {
					out = out.Append(Down)
				}
				i = i + 3
			} else {
				out = out.Append(Escape)
				i = i + 1
			}
			continue
		}
		if c == '\r' || c == '\n' {
			out = out.Append(Return)
		} else if c == 127 || c == 8 {
			out = out.Append(Backspace)
		} else if c == 3 {
			out = out.Append(Interrupt)
		} else if c >= 32 {
			let n = utf8.DecodeRuneInString(strings.Slice(text, i, len(text))).Size
			out = out.Append(Char{Text: strings.Slice(text, i, i+n)})
			i = i + n
			continue
		}
		i = i + 1
	}
	out
}

// DecodeTakesEveryText: Decode reads any bytes, and no Char it gives is
// empty or a control byte. The text is also read with an arrow and a
// control byte after it, which generated texts seldom hold.
law DecodeTakesEveryText(text string) { consumes(text) && consumes(text+"\x1b[A\x05") }

// consumes checks DecodeTakesEveryText for one text.
func consumes(text string) bool {
	for k in Decode(text) {
		match k {
		case Char as c:
			if c.Text == "" || c.Text[0] < 32 || c.Text[0] == 127 {
				return false
			}
		case Up, Down, Return, Backspace, Escape, Interrupt:
		}
	}
	true
}

// Encode is the bytes a terminal sends for k.
func Encode(k Key) string {
	match k {
	case Up:
		esc + "[A"
	case Down:
		esc + "[B"
	case Return:
		"\r"
	case Backspace:
		"\x7f"
	case Escape:
		esc
	case Interrupt:
		"\x03"
	case Char as c:
		c.Text
	}
}

// Script is the bytes of keys, one after another: a scripted session.
func Script(keys []Key) string {
	let mut out = ""
	for k in keys {
		out = out + Encode(k)
	}
	out
}

// Typed is a Char for each character of text.
func Typed(text string) []Key {
	let mut out = []Key{}
	for r in text {
		out = out.Append(Char{Text: utf8.RuneText(r)})
	}
	out
}
