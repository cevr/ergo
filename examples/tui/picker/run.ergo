import machines
import tui/keys
import slices

// Outcome is a run of the picker over keys: each mode it showed, the
// first one included, how many keys it rejected, and the choice, or None
// when the keys ran out first.
type Outcome { Frames []Mode, Rejected int, Choice Option[Choice] }

// Run steps m by each key until the picker is Done. A new mode is a
// frame; a rejected key is counted. machines.Run would give only the
// last mode, and the screen draws each one.
func Run(m Mode, ks []keys.Key) Outcome {
	let mut now = m
	let mut frames = []Mode{m}
	let mut rejected = 0
	for k in ks {
		let d = Step(now, k)
		match d {
		case Enter[Mode], Stay[Mode], Emit[Mode, Choice], Tell[Mode, Choice]:
			now = machines.Next(now, d)
			frames = frames.Append(now)
		case Ignore:
		case Reject:
			rejected = rejected + 1
		case Done[Choice] as e:
			return Outcome{Frames: frames, Rejected: rejected, Choice: Some[Choice]{Value: e.Output}}
		}
	}
	Outcome{Frames: frames, Rejected: rejected, Choice: None}
}

// CursorStaysOnTheList: after any keys, the cursor is on a visible item,
// or at 0 when none is visible.
law CursorStaysOnTheList(items []string, ks []keys.Key) {
	cursorStays(items, ks) && cursorStays(langs, ks) && cursorStays(langs, slices.Concat(narrow, ks))
}

// langs is the items of the scripted sessions.
let langs = []string{"Gleam", "ReScript", "Elixir", "Elm"}

// narrow is keys that move down and then narrow the list under the
// cursor.
let narrow = []keys.Key{keys.Down, keys.Down, keys.Down, keys.Char{Text: "/"}, keys.Char{Text: "m"}}

// cursorStays checks CursorStaysOnTheList for one run.
func cursorStays(items []string, ks []keys.Key) bool {
	for m in Run(Start(items), ks).Frames {
		let v = ViewOf(m)
		let n = len(Visible(v))
		if v.Cursor < 0 || (n == 0 && v.Cursor != 0) || (n > 0 && v.Cursor >= n) {
			return false
		}
	}
	true
}

// Last is the last mode of o.
func Last(o Outcome) Mode { o.Frames[len(o.Frames)-1] }
