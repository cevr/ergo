import machines
import tui/keys

// Outcome is a run of the picker over keys: each mode it showed, the
// first one included, how many keys it rejected, and the choice, or None
// when the keys ran out first.
type Outcome { Frames []Mode, Rejected int, Choice Option[Choice] }

// Run steps m by each key until the picker is Done. A new mode is a
// frame; a rejected key is counted. machines.Run would give only the
// last mode, and the screen draws each one.
func Run(m Mode, ks []keys.Key) Outcome {
	let mut now = m
	let mut frames = []Mode{m}
	let mut rejected = 0
	for k in ks {
		let d = Step(now, k)
		match d {
		case Enter[Mode], Stay[Mode], Emit[Mode, Choice]:
			now = machines.Next(now, d)
			frames = frames.Append(now)
		case Ignore:
		case Reject:
			rejected = rejected + 1
		case Done[Choice] as e:
			return Outcome{Frames: frames, Rejected: rejected, Choice: Some[Choice]{Value: e.Output}}
		}
	}
	Outcome{Frames: frames, Rejected: rejected, Choice: None}
}

// Last is the last mode of o.
func Last(o Outcome) Mode { o.Frames[len(o.Frames)-1] }
