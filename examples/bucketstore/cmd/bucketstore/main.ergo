// bucketstore N bumps N counters spread over 64 buckets of one store and
// prints how many buckets it holds and a few counts.

import io
import os
import strconv
import bucketstore/store

func main() fails os.Exit needs io.Console | os.Ambient {
	let args = os.NewHost().Args()
	if args.Len() != 1 {
		return os.Exit{Code: 2, Message: "usage: bucketstore N"}
	}
	let n = strconv.Atoi(args[0]) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return os.Exit{Code: 2, Message: "N is not a number"}
	}
	let s = store.New()
	let mut total = 0
	for i in 0..n {
		total = total + store.Bump(s, "bucket\(i % 64)", "counter\(i % 7)")
	}
	io.Console.Println("buckets \(store.Buckets(s))")
	io.Console.Println("bucket0/counter0 \(store.Count(s, "bucket0", "counter0"))")
	io.Console.Println("bucket5/counter5 \(store.Count(s, "bucket5", "counter5"))")
	io.Console.Println("sum of counts returned \(total)")
}
