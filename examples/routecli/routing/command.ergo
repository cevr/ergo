import strconv
import strings

// Command is the typed input to a route planner. Parsing does not choose
// a network or a storage provider.
type Command = Add{Name string, Note Option[string], Priority Option[int], Targets []string} | List{}

func Describe(c Command) string {
	match c {
	case List:
		"list routes"
	case Add as a:
		let note = match a.Note {
		case None:
			"absent"
		case Some as n:
			strconv.Quote(n.Value)
		}
		let priority = match a.Priority {
		case None:
			"absent"
		case Some as n:
			strconv.Itoa(n.Value)
		}
		"add " + a.Name + " note=" + note + " priority=" + priority + " targets=" + strings.Join(a.Targets, ",")
	}
}
