import actor
import gen
import scopedengine/engine
import scopedengine/memory
import scopedengine/screen
import temporal
import time
import ui

func exploreProperties(pool memory.Pool) []temporal.Formula[ui.ExploreSnapshot[engine.Mode, engine.Signal]] {
	let mut props = ui.DefaultsWith[engine.Mode, engine.Signal](2s)
	props = props.Append(temporal.Always[ui.ExploreSnapshot[engine.Mode, engine.Signal]](
		temporal.Named[ui.ExploreSnapshot[engine.Mode, engine.Signal]]("at-most-one-engine-leased", func(s ui.ExploreSnapshot[engine.Mode, engine.Signal]) bool {
			let held = memory.Held(pool)
			let okMode = match s.State {
			case engine.Off, engine.Failed:
				held == 0
			case engine.Booting, engine.Ready:
				held >= 0 && held <= 1
			}
			okMode && len(s.Offers) > 0
		}),
	))
	props
}

func exploreOnce(steps int) ui.Finding needs gen.Draws {
	let clock = time.NewManual(0)
	let pool = memory.OnClock(clock, BootTakes())
	with context { Scheduler: clock, engine.Engines: pool } {
		let app = actor.StartMachine(engine.Panel{}, 4, func(_ Never) {})
		let mut h = ui.NewTestHost(app, screen.Screen, clock, 4) catch {
		case ui.BadPatch as bp:
			app.Stop()
			return ui.Found{Script: []ui.Act{}, Step: 0, Violation: bp.Why}
		}
		let res = ui.Explore(&h, exploreProperties(pool), ui.ExploreConfig{Steps: steps, Swarm: false, AdvanceStep: 500ms, Weights: Map[string, int]{}})
		app.Stop()
		if memory.Held(pool) != 0 {
			return ui.Found{Script: []ui.Act{}, Step: steps, Violation: "engine lease leaked after panel stop"}
		}
		res
	}
}

// Explored holds that autonomous exploration over seeds 1 to 3 finds no
// default or engine-lease lifecycle violation on scoped-engine.
law Explored() {
	let mut allClean = true
	for seed in 1..4 {
		let cfg = gen.Config{Seed: uint64(seed), Cases: 10, Shrinks: 50, MaxDraws: 4096, MaxRejected: 100}
		let outcome = gen.Check(cfg, func() bool fails gen.Rejected needs gen.Draws {
			match exploreOnce(20) {
			case ui.Clean:
				true
			case ui.Found:
				false
			}
		})
		match outcome {
		case gen.Held:
		case _:
			allClean = false
		}
	}
	allClean
}
