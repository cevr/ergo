// Package script plays a script of timed button presses on the panel,
// live: the Panel runs as an actor on a time.Manual, with a memory.Pool
// whose boots take BootTakes (Play), and on the panel's screen on std
// ui's test host (PlayScreen, host.ergo), whose screen and engines out
// are shown after each press.

import actor
import scopedengine/engine
import scopedengine/memory
import io
import strconv
import strings
import time
import ui

// BootTakes is how long a boot takes.
func BootTakes() duration { 500ms }

// Press is a button (start, stop, compute), or a fault of the next boot.
type Press = Start{} | Stop{} | Compute{} | Fault{}

// OneBootPerStart: no more engines boot than the starts pressed while the
// screen was off or failed; a start while booting or ready boots nothing,
// and a stop while booting ends the boot before it gives an engine.
law OneBootPerStart(gaps []int, kinds []int) {
	let ls = lines(gaps, kinds)
	let seen = live(ls, if len(ls) > 0 { ls[len(ls)-1].At } else { 0s })
	let mut starts = 0
	for i, l in ls {
		if l.Press == Start && canStart(seen[i].Before) {
			starts = starts + 1
		}
	}
	seen[len(seen)-1].Booted <= starts
}

func canStart(m engine.Mode) bool {
	match m {
	case engine.Off, engine.Failed:
		true
	case engine.Ready, engine.Booting:
		false
	}
}

// Line is a press at a time since the start.
type Line { At duration, Press Press }

// ReleasesEqualAcquires: after every press, one engine is out while the
// screen is ready and none otherwise; once the screen stops, every engine
// booted is back.
law ReleasesEqualAcquires(gaps []int, kinds []int, tail int) {
	let ls = lines(gaps, kinds)
	let end = (if len(ls) > 0 { ls[len(ls)-1].At } else { 0s }) + time.Times(1ms, pick(tail, 2000))
	let seen = live(ls, end)
	for i, s in seen {
		if i < len(ls) && s.Held != (if isReady(s.Mode) { 1 } else { 0 }) {
			return false
		}
	}
	seen[len(seen)-1].Held == 0
}

func isReady(m engine.Mode) bool {
	match m {
	case engine.Ready:
		true
	case engine.Off, engine.Booting, engine.Failed:
		false
	}
}

// Script is the presses, and the time the run ends.
type Script { Lines []Line, End duration }

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Read reads the lines of a script. Each line is `@MS WORD`: MS is the
// time in milliseconds, never earlier than the line before, and WORD is
// start, stop, compute, fault or end, which must be last. A blank line or
// a line that starts with # is skipped.
func Read(text []string) Script fails BadLine {
	let mut lines = []Line{}
	let mut last = 0s
	for i, raw in text {
		let n = i + 1
		let t = strings.TrimSpace(raw)
		let words = strings.Fields(t)
		if len(words) == 0 || strings.HasPrefix(t, "#") {
			continue
		}
		if len(words) != 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD"}
		}
		let at = time.Times(1ms, try count(n, strings.TrimPrefix(words[0], "@")))
		if at < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = at
		let press = match words[1] {
		case "end":
			return Script{Lines: lines, End: at}
		case "start":
			Start
		case "stop":
			Stop
		case "compute":
			Compute
		case "fault":
			Fault
		case _:
			return BadLine{Line: n, Why: "unknown word \(words[1])"}
		}
		lines = lines.Append(Line{At: at, Press: press})
	}
	BadLine{Line: len(text) + 1, Why: "the script has no @MS end line"}
}

func count(n int, word string) int fails BadLine {
	let v = strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	v
}

// Seen is the screen just before a press (the clock moved to its time),
// and the screen and the pool after it.
type Seen { Before engine.Mode, Mode engine.Mode, Held int, Booted int }

// Play plays lines on a live screen with a fresh pool on clock, which the
// caller binds as engine.Engines, moving clock to each line's time first
// (so a boot due by then has ended), and gives what is seen after each
// press, then after end once the screen has stopped: every engine is back
// by then.
func Play(lines []Line, end duration, clock time.Manual, pool memory.Pool) []Seen needs Scheduler | engine.Engines {
	let screen = actor.StartMachine(engine.Panel{}, 4, func(n Never) {})
	let mut out = []Seen{}
	let mut now = 0s
	for l in lines {
		time.Advance(clock, l.At-now)
		now = l.At
		let before = screen.State()
		match l.Press {
		case Start:
			ask(screen, engine.Start)
		case Stop:
			ask(screen, engine.Stop)
		case Compute:
			ask(screen, engine.Compute)
		case Fault:
			memory.Fault(pool)
		}
		out = out.Append(Seen{Before: before, Mode: screen.State(), Held: memory.Held(pool), Booted: memory.Booted(pool)})
	}
	time.Advance(clock, end-now)
	let last = screen.State()
	screen.Stop()
	let _ = actor.ExitOf(screen)
	out.Append(Seen{Before: last, Mode: last, Held: memory.Held(pool), Booted: memory.Booted(pool)})
}

// ask steps s on the screen and waits for it: the screen never ends
// before Play stops it, so Stopped cannot come.
func ask(screen actor.Actor[engine.Mode, engine.Signal, Decision[engine.Mode, Never]], s engine.Signal) {
	let _ = screen.Ask(s) catch {
	case actor.Stopped:
		return
	}
}

// Run reads the script from io.Stdin, plays it on the panel's screen
// (PlayScreen) and shows the screen after each press and at the end:
// `@MS WORD`, then `  SCREEN; N out`; with stats, also the work of the
// press. It returns the exit status: 0, or 1 when the script is refused
// or the screen fails.
func Run(clock time.Manual, pool memory.Pool, stats bool) int needs Console | io.Stdin | Scheduler | engine.Engines {
	let mut text = []string{}
	for line in io.Stdin.Lines() {
		text = text.Append(line)
	}
	let s = Read(text) catch {
	case BadLine as b:
		Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let mut i = 0
	PlayScreen(s.Lines, s.End, clock, pool, func(f Frame) needs Console {
		let at = if i < len(s.Lines) { s.Lines[i].At } else { s.End }
		let what = if i < len(s.Lines) { Name(s.Lines[i].Press) } else { "end" }
		i = i + 1
		Console.Println("@\(time.Count(at, 1ms)) \(what)")
		Console.Println("  \(ShownLine(f)); \(f.Held) out")
		if stats {
			Console.Println("  stats: \(ui.CountsLine(f.Counts))")
		}
	}) catch {
	case actor.Stopped:
		Console.Println("? the panel stopped")
		return 1
	case ui.BadPatch as p:
		Console.Println("? the screen: \(p.Why)")
		return 1
	}
	0
}

// Name is how a press shows.
func Name(p Press) string {
	match p {
	case Start:
		"start"
	case Stop:
		"stop"
	case Compute:
		"compute"
	case Fault:
		"fault"
	}
}
