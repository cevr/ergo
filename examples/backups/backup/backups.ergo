// Backups is the contract the backup service needs: an event-sourced store of
// backups that decides each command against the backup's history and
// records the events. Package memory provides it.

type Backups {
	Send(c Command) []Event fails Rejection,
	History(backup string) []Event,
	Current(backup string) State,

	// The state a provider keeps is the state its history replays to.
	law ReplayRebuildsState(c Command) {
		let _ = Send(c) catch {
		case Rejection:
			return Replay(History(BackupOf(c))) == Current(BackupOf(c))
		}
		Replay(History(BackupOf(c))) == Current(BackupOf(c))
	},

	// A command the backup refuses records nothing.
	law RejectedCommandEmitsNothing(c Command) {
		let before = len(History(BackupOf(c)))
		let _ = Send(c) catch {
		case Rejection:
			return len(History(BackupOf(c))) == before
		}
		true
	},

	// A command the backup accepts records its events after the history.
	law AcceptedCommandIsRecorded(c Command) {
		let before = len(History(BackupOf(c)))
		let events = Send(c) catch {
		case Rejection:
			return true
		}
		len(History(BackupOf(c))) == before+len(events)
	},
}

// Simulate is the log of every event the script records, decided and
// evolved in memory with no provider: the reference the laws compare a
// provider with.
func Simulate(script []Command) []Event {
	let mut states = Map[string, State]{}
	let mut log = []Event{}
	for c in script {
		let s = match states.Get(BackupOf(c)) {
		case Some[State] as found:
			found.Value
		case None:
			Absent
		}
		let events = Decide(s, c) catch {
		case Rejection:
			[]Event{}
		}
		let mut next = s
		for e in events {
			next = Evolve(next, e)
			log = log.Append(e)
		}
		states[BackupOf(c)] = next
	}
	log
}

// Of is the events of log that belong to the backup.
func Of(log []Event, backup string) []Event {
	let mut events = []Event{}
	for e in log {
		if StreamOf(e) == backup {
			events = events.Append(e)
		}
	}
	events
}
