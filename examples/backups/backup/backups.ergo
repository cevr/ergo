// Backups is the contract the backup service needs: an event-sourced store of
// backups that decides each command against the backup's history and
// records the events. Package memory provides it.

import option

type Backups {
	Send(c Command) []Event fails Rejection,
	History(backup string) []Event,
	Current(backup string) State,

	// The state a provider keeps is the state its history replays to.
	law ReplayRebuildsState(c Command) {
		let _ = Send(c) catch {
		case Rejection:
			return Replay(History(BackupOf(c))) == Current(BackupOf(c))
		}
		Replay(History(BackupOf(c))) == Current(BackupOf(c))
	},

	// A command the backup refuses records nothing.
	law RejectedCommandEmitsNothing(c Command) {
		let before = History(BackupOf(c)).Len()
		let _ = Send(c) catch {
		case Rejection:
			return History(BackupOf(c)).Len() == before
		}
		true
	},

	// A command the backup accepts records its events after the history.
	law AcceptedCommandIsRecorded(c Command) {
		let before = History(BackupOf(c)).Len()
		let events = Send(c) catch {
		case Rejection:
			return true
		}
		History(BackupOf(c)).Len() == before+events.Len()
	},
}

// Simulate is the log of every event the script records, decided and
// evolved in memory with no provider: the reference the laws compare a
// provider with.
func Simulate(script []Command) []Event {
	let mut states = Map[string, State]{}
	let mut log = []Event{}
	for c in script {
		let s = match states.Get(BackupOf(c)) {
		case option.Some[State] as found:
			found.Value
		case option.None:
			Absent
		}
		let events = Decide(s, c) catch {
		case Rejection:
			[]Event{}
		}
		let mut next = s
		for e in events {
			next = Evolve(next, e)
			log = log.Append(e)
		}
		states[BackupOf(c)] = next
	}
	log
}

// StoreIsTheTotal: every store a backup records is the sum of its
// files, and no backup records two stores.
law StoreIsTheTotal(seed int) {
	storesAreTotals(Simulate(Script(seed, 40)))
}

// storesAreTotals is the check of StoreIsTheTotal on a log.
func storesAreTotals(log []Event) bool {
	for id in []string{"a", "b"} {
		let mut total = int64(0)
		let mut stores = 0
		for e in Of(log, id) {
			match e {
			case FileAdded as i:
				total = total + int64(i.Count)*i.Size
			case Stored as p:
				stores = stores + 1
				if p.Size != total || stores > 1 {
					return false
				}
			case Planned, Verified, Aborted:
			}
		}
	}
	true
}

// FreedIsTheStored: an aborted backup frees what it stored, and an
// unstored one frees nothing.
law FreedIsTheStored(seed int) {
	freedAreStored(Simulate(Script(seed, 40)))
}

// freedAreStored is the check of FreedIsTheStored on a log.
func freedAreStored(log []Event) bool {
	for id in []string{"a", "b"} {
		let mut stored = int64(0)
		for e in Of(log, id) {
			match e {
			case Stored as p:
				stored = p.Size
			case Aborted as x:
				if x.Freed != stored {
					return false
				}
			case Planned, FileAdded, Verified:
			}
		}
	}
	true
}

// Of is the events of log that belong to the backup.
func Of(log []Event, backup string) []Event {
	let mut events = []Event{}
	for e in log {
		if StreamOf(e) == backup {
			events = events.Append(e)
		}
	}
	events
}
