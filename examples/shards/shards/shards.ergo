// Package shards is a sharded write: a staging of parts, a write of
// one or more shares, and a summary screen. The write is a machine whose Writing phase
// hosts a child, the write runner, which hosts a child per share: the
// writes run at once, and their answers climb back up as signals of the
// entry that started them.

import actor
import machines

// Part is a part of the staging and its size in hundredths of a MB.
type Part { Name string, Size int }

// Job is the write's state.
type Job =
	| Staging{Parts []Part, Note string}
	| Writing{Parts []Part, Shares []Share}
	| RollingBack{Parts []Part, Refs []Ref, Why string}
	| Summary{Parts []Part, Refs []Ref}

// SummaryTouchRestarts: a touch re-enters the summary (its timer starts
// again), and its timer's signal closes.
law SummaryTouchRestarts(partSizes []int, id string) {
	let r = Summary{Parts: partsOf(partSizes), Refs: []Ref{Ref{ID: id, Size: 1}}}
	let reentered = match Step(r, Touch) {
	case Enter[Job]:
		true
	case _:
		false
	}
	let closes = match timer(r) {
	case Some[Timeout[Signal]] as t:
		match Step(r, t.Value.Signal) {
		case Done[Result] as d:
			match d.Output {
			case Stored as s:
				s.Total == Total(r.Parts) && t.Value.In == SummaryWait()
			case Cancelled:
				false
			}
		case _:
			false
		}
	case None:
		false
	}
	reentered && closes
}

// Signal is what the write takes: the operator's touches, and the outputs of
// its phases' children and work.
type Signal =
	| Add{Name string, Size int}
	| Place{Shares []Share}
	| Cancel{}
	| Touch{}
	| SharesWritten{Refs []Ref}
	| SharesLost{Refs []Ref, Why string}
	| Erased{}
	| Idle{}

// NoCancelWhileWriting: a cancel while writes run is refused.
law NoCancelWhileWriting(partSizes []int, shareSizes []int) {
	refused(Step(Writing{Parts: partsOf(partSizes), Shares: sharesOf(shareSizes)}, Cancel))
}

// Result is how a write ends.
type Result = Stored{Total int, Refs []Ref} | Cancelled{}

// SummaryWait is how long the summary stays with no touch.
func SummaryWait() duration { 60s }

// Shards is the write's machine. Its work needs Targets | Scheduler: the
// runner child writes through the target, and starting a child needs
// the Scheduler. The target is a capability the binary binds, not a
// value carried in every state.
type Shards machine[Job, Signal] { initial: Open, step: Step, after: timer, work: work }

// Open is a staging that starts with parts (none for a new write).
func Open(parts []Part) Job { Staging{Parts: parts, Note: ""} }

// Total is the size of the parts.
func Total(parts []Part) int {
	let mut n = 0
	for l in parts {
		n = n + l.Size
	}
	n
}

// SharesCoverExactly: Place starts a write exactly when the shares sum to
// the staging's total, each positive; otherwise it is refused.
law SharesCoverExactly(partSizes []int, shareSizes []int, exact bool) {
	let parts = partsOf(partSizes)
	let shares = if exact && len(parts) > 0 { split(Total(parts), shareSizes) } else { sharesOf(shareSizes) }
	let d = Step(Staging{Parts: parts, Note: ""}, Place{Shares: shares})
	match moved(d) {
	case Some[Job] as s:
		match s.Value {
		case Writing as p:
			Sum(p.Shares) == Total(parts) && len(parts) > 0
		case _:
			false
		}
	case None:
		refused(d) && !placeable(parts, shares)
	}
}

// hundredths is n cut to 0..9999 (also for the least int, whose negation is
// itself).
func hundredths(n int) int {
	let c = n % 10000
	if c < 0 { -c } else { c }
}

func partsOf(partSizes []int) []Part {
	let mut out = []Part{}
	for p in partSizes {
		out = out.Append(Part{Name: "part", Size: hundredths(p) + 1})
	}
	out
}

// sharesOf is a share per size, disks and tapes by turns.
func sharesOf(shareSizes []int) []Share {
	let mut out = []Share{}
	for i, a in shareSizes {
		if i%2 == 0 {
			out = out.Append(Disk{Device: "1\(i)", Size: a})
		} else {
			out = out.Append(Tape{Label: "V\(i)", Size: a})
		}
	}
	out
}

// split is shares that cover total exactly: the shareSizes, cut to total, and
// the rest in a last disk.
func split(total int, shareSizes []int) []Share {
	let mut left = total
	let mut parts = []int{}
	for a in shareSizes {
		let c = hundredths(a) % (left + 1)
		if c > 0 && c < left {
			parts = parts.Append(c)
			left = left - c
		}
	}
	sharesOf(parts.Append(left))
}

// moved is the state a decision enters or stays in, if any.
func moved(d Decision[Job, Result]) Option[Job] {
	match d {
	case Enter[Job] as x:
		Some{x.Next}
	case Stay[Job] as x:
		Some{x.Next}
	case Emit[Job, Result] as x:
		Some{x.Next}
	case Ignore, Tell[Job, Result]:
		None
	case Reject:
		None
	case Done[Result]:
		None
	}
}

func refused(d Decision[Job, Result]) bool {
	match d {
	case Reject:
		true
	case _:
		false
	}
}

// placeable reports whether the shares cover the staging exactly, each with
// a positive size.
func placeable(parts []Part, shares []Share) bool {
	let mut ok = len(parts) > 0 && len(shares) > 0 && Sum(shares) == Total(parts)
	for t in shares {
		ok = ok && SizeOf(t) > 0
	}
	ok
}

// Step is the write's step.
func Step(s Job, e Signal) Decision[Job, Result] {
	match (s, e) {
	case (Staging as b, Add as a):
		if a.Size > 0 {
			Stay[Job]{Next: Staging{..b, Parts: b.Parts.Append(Part{Name: a.Name, Size: a.Size}), Note: ""}}
		} else {
			Reject
		}
	case (Staging as b, Place as p):
		if placeable(b.Parts, p.Shares) {
			Enter[Job]{Next: Writing{Parts: b.Parts, Shares: p.Shares}}
		} else {
			Reject
		}
	case (Staging, Cancel):
		Done[Result]{Output: Cancelled}
	case (Staging, _):
		Ignore
	case (Writing as p, SharesWritten as t):
		Enter[Job]{Next: Summary{Parts: p.Parts, Refs: t.Refs}}
	case (Writing as p, SharesLost as d):
		if len(d.Refs) == 0 {
			Enter[Job]{Next: Staging{Parts: p.Parts, Note: d.Why}}
		} else {
			Enter[Job]{Next: RollingBack{Parts: p.Parts, Refs: d.Refs, Why: d.Why}}
		}
	case (Writing, Cancel):
		// A write in flight is never abandoned: a write may be taken.
		Reject
	case (Writing, _):
		Ignore
	case (RollingBack as v, Erased):
		Enter[Job]{Next: Staging{Parts: v.Parts, Note: "\(v.Why); \(len(v.Refs)) erased"}}
	case (RollingBack, _):
		Ignore
	case (Summary as r, Touch):
		// A touch re-enters the summary, so its timer starts again.
		Enter[Job]{Next: r}
	case (Summary as r, Idle):
		Done[Result]{Output: Stored{Total: Total(r.Parts), Refs: r.Refs}}
	case (Summary, _):
		Ignore
	}
}

// SummaryOnlyAfterWritten: the summary opens only when the runner reports
// every share taken, or again on a touch of the summary.
law SummaryOnlyAfterWritten(n int, m int, partSizes []int, shareSizes []int, text string) {
	let s = sample(n, partSizes, shareSizes, text)
	let e = signalOf(m, shareSizes, text)
	match moved(Step(s, e)) {
	case Some[Job] as next:
		match next.Value {
		case Summary:
			match (s, e) {
			case (Writing, SharesWritten):
				true
			case (Summary, Touch):
				true
			case (_, _):
				false
			}
		case _:
			true
		}
	case None:
		true
	}
}

// sample is a write state of every variant, picked by n.
func sample(n int, partSizes []int, shareSizes []int, text string) Job {
	let parts = partsOf(partSizes)
	let shares = sharesOf(shareSizes)
	let refs = []Ref{Ref{ID: text, Size: Total(parts)}}
	let k = if n < 0 { -n } else { n }
	match k % 4 {
	case 0:
		Staging{Parts: parts, Note: text}
	case 1:
		Writing{Parts: parts, Shares: shares}
	case 2:
		RollingBack{Parts: parts, Refs: refs, Why: text}
	case _:
		Summary{Parts: parts, Refs: refs}
	}
}

// signalOf is a write signal of every variant, picked by n.
func signalOf(n int, shareSizes []int, text string) Signal {
	let k = if n < 0 { -n } else { n }
	match k % 8 {
	case 0:
		Add{Name: text, Size: k % 500}
	case 1:
		Place{Shares: sharesOf(shareSizes)}
	case 2:
		Cancel
	case 3:
		Touch
	case 4:
		SharesWritten{Refs: []Ref{Ref{ID: text, Size: 1}}}
	case 5:
		SharesLost{Refs: []Ref{}, Why: text}
	case 6:
		Erased
	case _:
		Idle
	}
}

func timer(s Job) Option[Timeout[Signal]] {
	match s {
	case Summary:
		Some{Timeout[Signal]{In: SummaryWait(), Signal: Idle}}
	case Staging:
		None
	case Writing:
		None
	case RollingBack:
		None
	}
}

// outcome is the runner's output as a write signal.
func outcome(o Outcome) Signal {
	match o {
	case AllTaken as a:
		SharesWritten{Refs: a.Refs}
	case SomeLost as d:
		SharesLost{Refs: d.Refs, Why: d.Why}
	}
}

// work: Writing hosts the write runner as a child; RollingBack erases the
// writes that were taken.
func work(s Job) Option[machines.Work[Signal, Targets | Scheduler]] {
	match s {
	case Writing as p:
		Some{machines.Work{Start: func(send entry func(e Signal)) needs Targets | Scheduler {
			actor.Child(send, machines.Start(Runner{}, p.Shares), 1, outcome)
		}}}
	case RollingBack as v:
		Some{machines.Do(func() Signal needs Targets | Scheduler {
			for r in v.Refs {
				Targets.Erase(r)
			}
			Erased
		})}
	case Staging:
		None
	case Summary:
		None
	}
}
