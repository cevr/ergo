import actor
import machines

// The write runner is the Writing phase's child. Its work starts one
// Write child per share, so the writes run at once; each answer comes
// back as a signal of the runner's entry. It waits for every answer, so a
// write that was taken is never lost when another is lost, and ends
// with the outcome in share order.
type Run = Running{Shares []Share, Answers []Answer}

type RunSignal = Answered{A Answer}

// RunnerWaitsForAll: the runner ends only after every share answered,
// so no taken write is lost to an early end.
law RunnerWaitsForAll(shareSizes []int, order int) {
	let answers = answersOf(shareSizes, order)
	let mut s = running(sharesOf(shareSizes))
	for i, a in answers {
		match runStep(s, Answered{A: a}) {
		case Stay[Run] as x:
			s = x.Next
		case Done[Outcome]:
			return i == len(answers)-1
		case _:
			return false
		}
	}
	len(answers) == 0
}

// Outcome is the runner's end: every share taken, or some lost, with
// the writes that were taken (the write erases them).
type Outcome = AllTaken{Refs []Ref} | SomeLost{Refs []Ref, Why string}

// OutcomeIgnoresArrival: the runner's outcome is the same whatever order
// the writes answer in, and lists the taken writes in share order.
law OutcomeIgnoresArrival(shareSizes []int, order int) {
	told(OutcomeOf(answersOf(shareSizes, order))) == told(OutcomeOf(answersOf(shareSizes, 0)))
}

// answersOf is an answer per share, in the order given by order: a
// share whose size is odd is lost.
func answersOf(shareSizes []int, order int) []Answer {
	let shares = sharesOf(shareSizes)
	let n = len(shares)
	let mut out = []Answer{}
	for j in 0..n {
		let i = if n == 0 { 0 } else { (j + hundredths(order)) % n }
		let t = shares[i]
		if SizeOf(t)%2 == 0 {
			out = out.Append(Taken{Index: i, Share: t, R: Ref{ID: "r\(i)", Size: SizeOf(t)}})
		} else {
			out = out.Append(Lost{Index: i, Share: t, Why: "odd \(i)"})
		}
	}
	out
}

// told is an outcome as text.
func told(o Outcome) string {
	let mut text = ""
	let refs = match o {
	case AllTaken as a:
		text = "taken"
		a.Refs
	case SomeLost as d:
		text = "lost \(d.Why)"
		d.Refs
	}
	for r in refs {
		text = text + " " + r.ID
	}
	text
}

type Runner machine[Run, RunSignal] { initial: running, step: runStep, work: runWork }

// running is the runner's start: the shares to write, none answered.
func running(shares []Share) Run { Running{Shares: shares, Answers: []Answer{}} }

func runStep(s Run, e RunSignal) Decision[Run, Outcome] {
	match (s, e) {
	case (Running as r, Answered as a):
		let answers = r.Answers.Append(a.A)
		if len(answers) < len(r.Shares) {
			Stay[Run]{Next: Running{..r, Answers: answers}}
		} else {
			Done[Outcome]{Output: OutcomeOf(answers)}
		}
	}
}

// runWork starts a write per share. The children belong to the entry:
// when the runner ends, or the write leaves Writing, they stop first.
func runWork(s Run) Option[machines.Work[RunSignal, Targets | Scheduler]] {
	match s {
	case Running as r:
		Some{machines.Work{Start: func(send entry func(e RunSignal)) needs Targets | Scheduler {
			for i in 0..len(r.Shares) {
				actor.Child(send, machines.Start(Writer{}, (i, r.Shares[i])), 1, func(a Answer) RunSignal { Answered{A: a} })
			}
		}}}
	}
}

// OutcomeOf is the outcome of the answers, in share order whatever order
// they came in.
func OutcomeOf(answers []Answer) Outcome {
	let mut refs = []Ref{}
	let mut why = ""
	for i in 0..len(answers) {
		for a in answers {
			match a {
			case Taken as t:
				if t.Index == i {
					refs = refs.Append(t.R)
				}
			case Lost as d:
				if d.Index == i && why == "" {
					why = d.Why
				}
			}
		}
	}
	if why == "" {
		AllTaken{Refs: refs}
	} else {
		SomeLost{Refs: refs, Why: why}
	}
}
