// shards is a sharded write driven by a script on standard input. This binary
// is the only place that chooses the providers: the in-memory target, a
// manual clock for the summary's and the writes' timers, and the host's
// standard input.

import io
import time
import shards/shards
import shards/console
import shards/memory

func main() needs Console | Ambient {
	let clock = time.NewManual(0)
	with context { io.Stdin: io.NewStdin(), shards.Targets: memory.Targets, Scheduler: clock } {
		console.Run(clock)
	}
}
