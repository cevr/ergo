// The generator builds values and byte strings from Random, for the laws:
// every variant, texts with a CR, an LF and a CRLF in them, bulk strings
// of any bytes, empty and nested aggregates. Samples binds Random to
// rand.Seeded(seed), so a law that takes a seed replays from it.

import rand
import strings

// Texts are the texts the generator draws simple strings, errors and bulk
// strings from.
let Texts = []string{"", "OK", "a", "ERR bad", "a b", "line\nnext", "cr\rhere", "x\r\ny", "\r\n", "$3", "*1", "é", "☃"}

// Integers are the integers the generator draws.
let Integers = []int64{0, 1, -1, 42, -1000, 9223372036854775807, -9223372036854775807 - 1}

func draw(xs []string) string needs Random { xs[Random.IntN(len(xs))] }

// GenBytes is n random bytes, as a string of bytes.
func GenBytes(n int) string needs Random {
	let mut bs = []byte{}
	for _ in 0..n {
		bs = bs.Append(byte(Random.IntN(256)))
	}
	strings.FromBytes(bs)
}

// GenValue is a value of depth at most depth.
func GenValue(depth int) Value needs Random {
	let n = if depth <= 0 { Random.IntN(7) } else { Random.IntN(10) }
	match n {
	case 0:
		Simple{Text: draw(Texts)}
	case 1:
		Fault{Text: draw(Texts)}
	case 2:
		Integer{N: Integers[Random.IntN(len(Integers))]}
	case 3:
		Bulk{Data: draw(Texts)}
	case 4:
		Bulk{Data: GenBytes(Random.IntN(12))}
	case 5:
		Null
	case 6:
		Boolean{Truth: Random.IntN(2) == 0}
	case 7:
		Array{Items: genItems(depth)}
	case 8:
		Set{Items: genItems(depth)}
	case _:
		let mut pairs = []Pair{}
		for _ in 0..Random.IntN(4) {
			pairs = pairs.Append(Pair{Key: GenValue(depth - 1), Value: GenValue(depth - 1)})
		}
		Dict{Pairs: pairs}
	}
}

func genItems(depth int) []Value needs Random {
	let mut items = []Value{}
	for _ in 0..Random.IntN(4) {
		items = items.Append(GenValue(depth - 1))
	}
	items
}

// Samples is ten values of depth at most 3 from seed.
func Samples(seed int) []Value {
	with context { Random: rand.Seeded(uint64(seed)) } {
		let mut out = []Value{}
		for _ in 0..10 {
			out = out.Append(GenValue(3))
		}
		out
	}
}

// Wire are the bytes the generator draws noise from: RESP's type bytes,
// digits, signs, CR and LF, a letter, and a byte that is no type.
let Wire = "+-:$*_#%~0123456789\r\n-tfa!"

// Noise is twenty byte strings from seed that are mostly not RESP: bytes
// drawn from Wire, and encodings of samples with a byte changed, a byte
// dropped or the end cut.
func Noise(seed int) []string {
	with context { Random: rand.Seeded(uint64(seed)) } {
		let mut out = []string{}
		for _ in 0..10 {
			let mut bs = []byte{}
			for _ in 0..Random.IntN(24) {
				bs = bs.Append(Wire[Random.IntN(len(Wire))])
			}
			out = out.Append(strings.FromBytes(bs))
		}
		for _ in 0..10 {
			let enc = strings.FromBytes(Encode(GenValue(3), Resp3))
			let i = Random.IntN(len(enc))
			let cut = match Random.IntN(3) {
			case 0:
				enc[:i] + strings.FromBytes([]byte{Wire[Random.IntN(len(Wire))]}) + enc[i+1:]
			case 1:
				enc[:i] + enc[i+1:]
			case _:
				enc[:i]
			}
			out = out.Append(cut)
		}
		out
	}
}
