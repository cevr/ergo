import slices
import strings

// Incomplete is bytes that end inside a frame: more bytes may complete
// it. A Reader waits for them.
type Incomplete {}

// Malformed is bytes that are not RESP: At is the offset of the first byte
// that breaks the frame, and Reason says how. A connection that sends one
// is closed, as Redis closes it.
type Malformed { At int, Reason string }

// MalformedNeverPanics: any bytes give a frame, Incomplete or Malformed,
// and never stop the reader. A frame uses at least one byte and no more
// than it was given, and the same bytes alone read as the same frame; a
// Malformed names an offset inside the bytes.
law MalformedNeverPanics(seed int) {
	for text in Noise(seed) {
		let buf = strings.Bytes(text)
		let f = Parse(buf) catch {
		case Incomplete:
			continue
		case Malformed as m:
			if m.At < 0 || m.At >= buf.Len() {
				return false
			}
			continue
		}
		if f.Used < 1 || f.Used > buf.Len() {
			return false
		}
		let again = Parse(buf[:f.Used]) catch {
		case Incomplete, Malformed:
			return false
		}
		if again.Used != f.Used || !Equal(again.Value, f.Value) {
			return false
		}
	}
	true
}

// Frame is a value read from the start of a buffer and Used, the count of
// its bytes.
type Frame { Value Value, Used int }

// MaxDepth is how deeply arrays, maps and sets may nest.
let MaxDepth = 64

// MaxLine is the longest line of a simple string or an error, without its
// CRLF. A longer one is Malformed, so a peer cannot make a reader wait for
// a line without end.
let MaxLine = 65536

// MaxBulk is the longest bulk string: 512 MiB, Redis's proto-max-bulk-len.
let MaxBulk = 536870912

// MaxCount is the largest count of an array, a map or a set.
let MaxCount = 1048576

// maxDigits is the longest line of a length, a count or an integer: a
// sign and the nineteen digits of an int64.
let maxDigits = 20

// Parse is the frame at the start of buf: one value and the count of its
// bytes. Bytes after it are not read.
func Parse(buf []byte) Frame fails Incomplete | Malformed { ParseAt(buf, 0) }

// ParseInvertsAppend: a value written and read back is the value, in both
// protocols: Parse(Encode(v, p)) is Clean(v) in RESP3 and Clean(Down(v))
// in RESP2, and it uses every byte written.
law ParseInvertsAppend(seed int) {
	for v in Samples(seed) {
		for p in []Protocol{Resp3, Resp2} {
			let enc = Encode(v, p)
			let want = match p {
			case Resp3:
				Clean(v)
			case Resp2:
				Clean(Down(v))
			}
			let f = Parse(enc) catch {
			case Incomplete, Malformed:
				return false
			}
			if f.Used != enc.Len() || !Equal(f.Value, want) {
				return false
			}
		}
	}
	true
}

// ParseAt is the frame that starts at offset at of buf; its Used counts
// from at.
func ParseAt(buf []byte, at int) Frame fails Incomplete | Malformed {
	let end = try value(buf, at, 0)
	Frame{Value: end.Value, Used: end.Used - at}
}

// value reads the value at offset at, depth levels inside arrays, maps
// and sets. Its Frame's Used is the offset after it, not a count.
func value(buf []byte, at int, depth int) Frame fails Incomplete | Malformed {
	if at >= buf.Len() {
		return Incomplete
	}
	let kind = buf[at]
	match kind {
	case '+':
		let e = try lineEnd(buf, at+1, MaxLine)
		Frame{Value: Simple{Text: strings.FromBytes(buf[at+1 : e])}, Used: e + 2}
	case '-':
		let e = try lineEnd(buf, at+1, MaxLine)
		Frame{Value: Fault{Text: strings.FromBytes(buf[at+1 : e])}, Used: e + 2}
	case ':':
		let e = try lineEnd(buf, at+1, maxDigits)
		Frame{Value: Integer{N: try integer(buf, at+1, e)}, Used: e + 2}
	case '$':
		let e = try lineEnd(buf, at+1, maxDigits)
		let n = try integer(buf, at+1, e)
		if n == -1 {
			return Frame{Value: Null, Used: e + 2}
		}
		if n < 0 || n > int64(MaxBulk) {
			return Malformed{At: at + 1, Reason: "bad bulk length"}
		}
		let start = e + 2
		let stop = start + int(n)
		if stop+2 > buf.Len() {
			return Incomplete
		}
		if buf[stop] != '\r' || buf[stop+1] != '\n' {
			return Malformed{At: stop, Reason: "bulk string longer than its length"}
		}
		Frame{Value: Bulk{Data: strings.FromBytes(buf[start:stop])}, Used: stop + 2}
	case '_':
		let e = try lineEnd(buf, at+1, 0)
		Frame{Value: Null, Used: e + 2}
	case '#':
		let e = try lineEnd(buf, at+1, 1)
		if e != at+2 || (buf[at+1] != 't' && buf[at+1] != 'f') {
			return Malformed{At: at + 1, Reason: "bad boolean"}
		}
		Frame{Value: Boolean{Truth: buf[at+1] == 't'}, Used: e + 2}
	case '*', '~', '%':
		if depth >= MaxDepth {
			return Malformed{At: at, Reason: "nested too deeply"}
		}
		let e = try lineEnd(buf, at+1, maxDigits)
		let n = try integer(buf, at+1, e)
		if n == -1 && kind == '*' {
			return Frame{Value: Null, Used: e + 2}
		}
		if n < 0 || n > int64(MaxCount) {
			return Malformed{At: at + 1, Reason: "bad count"}
		}
		let width = if kind == '%' { 2 * int(n) } else { int(n) }
		let mut items = []Value{}
		let mut next = e + 2
		for _ in 0..width {
			let f = try value(buf, next, depth+1)
			items = items.Append(f.Value)
			next = f.Used
		}
		Frame{Value: aggregate(kind, items), Used: next}
	case _:
		Malformed{At: at, Reason: "unknown type byte"}
	}
}

// aggregate is the array, the set or the map of items; a map's items are
// its keys and values in turn.
func aggregate(kind byte, items []Value) Value {
	if kind == '~' {
		return Set{Items: items}
	}
	if kind == '*' {
		return Array{Items: items}
	}
	let mut pairs = []Pair{}
	let mut i = 0
	for i+1 < items.Len() {
		pairs = pairs.Append(Pair{Key: items[i], Value: items[i+1]})
		i += 2
	}
	Dict{Pairs: pairs}
}

// lineEnd is the offset of the CR that ends the line starting at from: the
// first CR, which an LF must follow. A line longer than limit bytes is
// Malformed; one whose end is not in buf yet is Incomplete.
func lineEnd(buf []byte, from int, limit int) int fails Incomplete | Malformed {
	let mut i = from
	for i < buf.Len() {
		if buf[i] == '\r' {
			if i+1 == buf.Len() {
				return Incomplete
			}
			if buf[i+1] != '\n' {
				return Malformed{At: i + 1, Reason: "CR without LF"}
			}
			return i
		}
		if i-from >= limit {
			return Malformed{At: i, Reason: "line too long"}
		}
		i += 1
	}
	Incomplete
}

// integer is the decimal integer in buf[from:to]: an optional minus sign
// and at least one digit, within int64.
func integer(buf []byte, from int, to int) int64 fails Malformed {
	let mut i = from
	let negative = i < to && buf[i] == '-'
	if negative {
		i += 1
	}
	if i == to {
		return Malformed{At: i, Reason: "no digits"}
	}
	let mut n = int64(0)
	for i < to {
		let c = buf[i]
		if c < '0' || c > '9' {
			return Malformed{At: i, Reason: "not a digit"}
		}
		let d = int64(c - '0')
		if negative {
			if n < (-9223372036854775807-1+d)/10 {
				return Malformed{At: i, Reason: "integer out of range"}
			}
			n = n*10 - d
		} else {
			if n > (9223372036854775807-d)/10 {
				return Malformed{At: i, Reason: "integer out of range"}
			}
			n = n*10 + d
		}
		i += 1
	}
	n
}

// Reader frames values out of the bytes of a connection, given in chunks
// of any size: a value cut across two chunks is read once its last byte
// arrives. It keeps one buffer and reads in place.
type Reader { buf []byte, next int }

// NewReader is a reader with no bytes.
func NewReader() Reader { Reader{buf: []byte{}, next: 0} }

// Feed gives r the next chunk. The bytes of values already read are
// dropped then.
func Feed(r mut Reader, chunk []byte) {
	if r.next > 0 {
		r.buf = slices.Concat(r.buf[r.next:], chunk)
		r.next = 0
		return
	}
	r.buf = slices.Concat(r.buf, chunk)
}

// Next is the next value of r. Incomplete leaves r as it was, to read
// again after the next Feed.
func Next(r mut Reader) Value fails Incomplete | Malformed {
	let f = try value(r.buf, r.next, 0)
	r.next = f.Used
	f.Value
}

// Buffered is the count of bytes r holds that no value has used yet.
func Buffered(r Reader) int { r.buf.Len() - r.next }
