// The rules of the reader and the writer as laws, over generated values
// and generated bytes.

import strings

// ParseInvertsAppend: a value written and read back is the value, in both
// protocols: Parse(Encode(v, p)) is Clean(v) in RESP3 and Clean(Down(v))
// in RESP2, and it uses every byte written.
law ParseInvertsAppend(seed int) {
	for v in Samples(seed) {
		for p in []Protocol{Resp3, Resp2} {
			let enc = Encode(v, p)
			let want = match p {
			case Resp3:
				Clean(v)
			case Resp2:
				Clean(Down(v))
			}
			let f = Parse(enc) catch {
			case Incomplete, Malformed:
				return false
			}
			if f.Used != len(enc) || !Equal(f.Value, want) {
				return false
			}
		}
	}
	true
}

// SplitAnywhereParsesTheSame: a stream of values cut into two chunks at
// any byte reads as the same values: before the last byte of a value
// arrives the reader says Incomplete, and it never reads a value twice or
// loses one. A bulk string that a parser ends early, or a CRLF it looks
// for past its chunk, breaks it.
law SplitAnywhereParsesTheSame(seed int) {
	let vs = Samples(seed)
	let mut stream = []byte{}
	for v in vs {
		stream = Append(stream, v, Resp3)
	}
	for k in 0..len(stream)+1 {
		let mut r = NewReader()
		let mut got = []Value{}
		Feed(&r, stream[:k])
		got = drain(&r, got) catch {
		case Malformed:
			return false
		}
		Feed(&r, stream[k:])
		got = drain(&r, got) catch {
		case Malformed:
			return false
		}
		if len(got) != len(vs) || Buffered(r) != 0 {
			return false
		}
		for i, v in vs {
			if !Equal(got[i], Clean(v)) {
				return false
			}
		}
	}
	true
}

// drain is got with every value r holds, until r is Incomplete.
func drain(r *Reader, got []Value) []Value fails Malformed {
	let mut out = got
	for {
		let v = try Next(r) catch {
		case Incomplete:
			return out
		}
		out = out.Append(v)
	}
}

// MalformedNeverPanics: any bytes give a frame, Incomplete or Malformed,
// and never stop the reader. A frame uses at least one byte and no more
// than it was given, and the same bytes alone read as the same frame; a
// Malformed names an offset inside the bytes.
law MalformedNeverPanics(seed int) {
	for text in Noise(seed) {
		let buf = strings.Bytes(text)
		let f = Parse(buf) catch {
		case Incomplete:
			continue
		case Malformed as m:
			if m.At < 0 || m.At >= len(buf) {
				return false
			}
			continue
		}
		if f.Used < 1 || f.Used > len(buf) {
			return false
		}
		let again = Parse(buf[:f.Used]) catch {
		case Incomplete, Malformed:
			return false
		}
		if again.Used != f.Used || !Equal(again.Value, f.Value) {
			return false
		}
	}
	true
}

// BulkTakesItsLength: a bulk string is the count of bytes its header
// says, followed by CRLF. Data of another length is never read as a bulk
// string of that data: it is Incomplete while the declared bytes may yet
// arrive, and Malformed when the CRLF is not where the length puts it.
law BulkTakesItsLength(seed int) {
	for v in Samples(seed) {
		let data = strings.FromBytes(Encode(v, Resp3))
		for n in []int{0, len(data) / 2, len(data) + 1, len(data) + 5} {
			if n == len(data) {
				continue
			}
			let enc = strings.Bytes("$\(n)\r\n" + data + "\r\n")
			let f = Parse(enc) catch {
			case Incomplete, Malformed:
				continue
			}
			match f.Value {
			case Bulk as b:
				if b.Data == data || len(b.Data) != n {
					return false
				}
			case _:
				return false
			}
		}
	}
	true
}
