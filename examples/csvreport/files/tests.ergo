// Load's tests run over an fstest.Memory, with no host file system.

import csvreport/memory
import csvreport/report
import fs
import fstest

// locked is an fs.Files where "locked.csv" is denied; any other path is
// its Memory's. A Memory never fails Denied, so this wrapper stays.
type locked { disk fstest.Memory }

func ReadFile(l locked, path string) string fails fs.NotFound | fs.Denied | fs.Failed {
	if path == "locked.csv" {
		return fs.Denied{Path: path}
	}
	try l.disk.ReadFile(path)
}

func ReadDir(l locked, path string) []string fails fs.NotFound | fs.Denied | fs.Failed { try l.disk.ReadDir(path) }

func Stat(l locked, path string) fs.Info fails fs.NotFound | fs.Denied | fs.Failed { try l.disk.Stat(path) }

// outcome is the shelf's read of name, as "text: T", "missing" or
// "unreadable: R".
func outcome(s memory.Shelf, name string) string {
	let text = s.Read(name) catch {
	case report.Missing:
		return "missing"
	case report.Unreadable as u:
		return "unreadable: " + u.Reason
	}
	"text: " + text
}

test LoadKeepsWhatItCanRead {
	let disk = fstest.NewMemory()
	try disk.WriteFile("a.csv", "x\n")
	try disk.MkdirAll("dir")
	with context { fs.Files: locked{disk: disk} } {
		let s = Load([]string{"a.csv", "locked.csv", "gone.csv", "dir"})
		assert outcome(s, "a.csv") == "text: x\n"
		assert outcome(s, "locked.csv") == "unreadable: permission denied"
		assert outcome(s, "gone.csv") == "missing"
		assert outcome(s, "dir") == "unreadable: is a directory"
		assert outcome(s, "never.csv") == "missing"
	}
}
