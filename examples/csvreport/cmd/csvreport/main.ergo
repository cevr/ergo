// csvreport prints a report of a sales CSV file: the sales grouped by
// region or product, with their count, units and revenue, then the total.
// The file's header names region, product, units and price, in any order.
// Package report is the domain; package files reads the file into a
// memory.Shelf. This binary is the only place that chooses the providers:
// the host's file system, arguments and standard output.

import csv
import csvreport/files
import csvreport/report
import flag
import fs
import fstest
import io
import os

let byFlag = flag.Choice("by", "region", []string{"region", "product"}, "group the sales by `key`")
let regionFlag = flag.String("region", "", "count only the sales of `name`")
let minFlag = flag.Int("min", 0, "count only the sales of at least `units` units; 0 counts every sale")
let fileArg = flag.Arg("file", "the sales CSV file")

let set = flag.Set{Name: "csvreport", Usage: "", Flags: []flag.Flag{byFlag, regionFlag, minFlag}, Args: []flag.ArgSpec{fileArg}}

let usage = "usage: csvreport [-by region|product] [-region name] [-min units] file"

// Query is what a command line asks: a file, the filters, and the key.
type Query { File string, Keeps []report.Keep, Key report.Key }

// parse reads args as csvreport's command line.
func parse(args []string) Query fails flag.Help | flag.Unknown | flag.NeedsValue | flag.Invalid | flag.Missing | flag.Extra {
	let v = try flag.Parse(set, args)
	let mut keeps = []report.Keep{}
	let region = byFlag.Get(v)
	if regionFlag.Get(v) != "" {
		keeps = keeps.Append(report.InRegion{Name: regionFlag.Get(v)})
	}
	if minFlag.Get(v) != 0 {
		keeps = keeps.Append(report.AtLeast{Units: minFlag.Get(v)})
	}
	let file = match fileArg.Get(v) {
	case Some[string] as f:
		f.Value
	case None:
		""
	}
	let key = if region == "product" { report.ByProduct } else { report.ByRegion }
	Query{File: file, Keeps: keeps, Key: key}
}

// run is csvreport on args. Each failure of the domain ends it with
// status 1 and a line on standard error; its catch names every failure,
// with no case _, so a new failure of Report stops the build until run
// handles it.
func run(args []string) fails os.Exit needs io.Stdout | fs.Files {
	let q = parse(args) catch {
	case err:
		try flag.Exit(err, usage)
		return
	}
	with context { report.Source: files.Load([]string{q.File}) } {
		let lines = report.Report(q.File, q.Keeps, q.Key) catch {
		case report.Missing as m:
			return os.Exit{Code: 1, Message: "csvreport: no file \(m.Name)"}
		case report.Unreadable as u:
			return os.Exit{Code: 1, Message: "csvreport: \(u.Name): \(u.Reason)"}
		case csv.ParseError as b:
			return os.Exit{Code: 1, Message: "csvreport: \(q.File):\(b.Line):\(b.Column): \(b.Reason)"}
		case report.MissingColumn as m:
			return os.Exit{Code: 1, Message: "csvreport: \(q.File): the header has no \(m.Name) column"}
		case report.BadNumber as n:
			return os.Exit{Code: 1, Message: "csvreport: \(q.File):\(n.Line):\(n.Column): \(n.Field) \(n.Text) is not a number"}
		}
		for l in lines {
			io.Stdout.Println(l)
		}
	}
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), io.Stdout: io.NewHost() } {
		try run(os.Process.Args())
	}
}

// The tests run run over an fstest.Memory and an io.Recorder, with no
// host.

// ran is run on args over the test files, with a failure printed as
// "exit CODE: MESSAGE".
func ran(args []string) string fails fs.NotFound | fs.Denied | fs.Failed {
	let disk = fstest.NewMemory()
	try disk.WriteFile("sales.csv", "region,product,units,price\nnorth,tea,3,2.50\nsouth,tea,1,2.50\nnorth,cake,2,4.00\n")
	try disk.WriteFile("bad.csv", "region,product,units,price\nnorth,tea,three,2.50\n")
	try disk.WriteFile("quote.csv", "region,product,units,price\nnorth,te\"a,1,2\n")
	try disk.WriteFile("short.csv", "region,product,units,price\nnorth,tea\n")
	try disk.WriteFile("cols.csv", "region,item,units,price\n")
	let out = io.NewRecorder()
	with context { io.Stdout: out, fs.Files: disk } {
		run(args) catch {
		case os.Exit as e:
			out.Println("exit \(e.Code): \(e.Message)")
		}
	}
	out.Text()
}

test GroupsByRegion {
	assert try ran([]string{"sales.csv"}) == "region   sales    units       revenue\nnorth        2        5         15.50\nsouth        1        1          2.50\ntotal        3        6         18.00\n"
}

test FiltersAndGroupsByProduct {
	assert try ran([]string{"-by", "product", "-region", "north", "-min", "3", "sales.csv"}) == "product   sales    units       revenue\ntea           1        3          7.50\ntotal         1        3          7.50\n"
}

test FailuresExitOne {
	assert try ran([]string{"nosuch.csv"}) == "exit 1: csvreport: no file nosuch.csv\n"
	assert try ran([]string{"bad.csv"}) == "exit 1: csvreport: bad.csv:2:11: units three is not a number\n"
	assert try ran([]string{"quote.csv"}) == "exit 1: csvreport: quote.csv:2:9: bare \" in non-quoted-field\n"
	assert try ran([]string{"short.csv"}) == "exit 1: csvreport: short.csv:2:1: wrong number of fields\n"
	assert try ran([]string{"cols.csv"}) == "exit 1: csvreport: cols.csv: the header has no product column\n"
}

test UsageErrorsExitTwo {
	assert try ran([]string{}) == "exit 2: missing required flag or argument: file\n"+usage+"\n"
	assert try ran([]string{"-by", "colour", "sales.csv"}) == "exit 2: invalid value \"colour\" for flag -by: not one of region, product\n"+usage+"\n"
	assert try ran([]string{"-min", "many", "sales.csv"}) == "exit 2: invalid value \"many\" for flag -min: parse error\n"+usage+"\n"
}
