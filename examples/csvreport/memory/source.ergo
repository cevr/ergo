// Package memory holds meter files in memory: Shelf provides
// report.Source.

import csvreport/report

// Entry is a file of a Shelf: its text, or the reason it cannot be read.
type Entry = Readable{Name string, Text string} | Broken{Name string, Reason string}

// Shelf is a report.Source of fixed entries. A name with no entry is
// report.Missing.
type Shelf { Entries []Entry }

// Read is the text of the first entry named name.
func Read(s Shelf, name string) string fails report.Missing | report.Unreadable {
	for e in s.Entries {
		match e {
		case Readable as r:
			if r.Name == name {
				return r.Text
			}
		case Broken as b:
			if b.Name == name {
				return report.Unreadable{Name: name, Reason: b.Reason}
			}
		}
	}
	report.Missing{Name: name}
}
