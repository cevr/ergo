// Filtering, grouping and the report's text.

import utf8
import slices
import strings

// Keep is which readings a report counts.
type Keep = Every{} | AtSite{Name string} | AtLeast{Hours int}

// Kept reports whether k keeps s.
func Kept(k Keep, s Reading) bool {
	match k {
	case Every:
		true
	case AtSite as r:
		s.Site == r.Name
	case AtLeast as a:
		s.Hours >= a.Hours
	}
}

// Key is what a report groups readings by.
type Key = BySite{} | ByDevice{}

// KeyOf is the group of s under k.
func KeyOf(k Key, s Reading) string {
	match k {
	case BySite:
		s.Site
	case ByDevice:
		s.Device
	}
}

// Summary is a group of readings: how many, how many hours, and their
// energy in hundredths of a kWh.
type Summary { Key string, Readings int, Hours int, Energy int64 }

// Energy is the energy of s in hundredths of a kWh: hours times kW.
func Energy(s Reading) int64 { int64(s.Hours) * s.Kw }

// add is t with s counted.
func add(t Summary, s Reading) Summary {
	Summary{..t, Readings: t.Readings + 1, Hours: t.Hours + s.Hours, Energy: t.Energy + Energy(s)}
}

// Total is the summary of every reading, under the key "total".
func Total(readings []Reading) Summary {
	slices.Fold(readings, Summary{Key: "total", Readings: 0, Hours: 0, Energy: 0}, add)
}

// Group is a summary per key of readings under k, in key order.
func Group(readings []Reading, k Key) []Summary {
	let mut by = Map[string, Summary]{}
	for s in readings {
		let key = KeyOf(k, s)
		let t = match by.Get(key) {
		case Some[Summary] as found:
			found.Value
		case None:
			Summary{Key: key, Readings: 0, Hours: 0, Energy: 0}
		}
		by[key] = add(t, s)
	}
	let mut out = []Summary{}
	for _, t in by {
		out = out.Append(t)
	}
	slices.SortFunc(out, func(a Summary, b Summary) int { strings.Compare(a.Key, b.Key) })
}

// Filter is the readings that k keeps, in order.
func Filter(readings []Reading, k Keep) []Reading { slices.Filter(readings, func(s Reading) bool { Kept(k, s) }) }

// Table is the report of readings under k: a line per group, then the
// total, in aligned columns.
func Table(readings []Reading, k Key) []string {
	let groups = Group(readings, k)
	let name = match k {
	case BySite:
		"site"
	case ByDevice:
		"device"
	}
	let mut width = utf8.RuneCount(name)
	for g in groups {
		if utf8.RuneCount(g.Key) > width {
			width = utf8.RuneCount(g.Key)
		}
	}
	let mut out = []string{line(name, "readings", "hours", "energy", width)}
	for g in groups {
		out = out.Append(line(g.Key, "\(g.Readings)", "\(g.Hours)", Hundredths(g.Energy), width))
	}
	let t = Total(readings)
	out.Append(line("total", "\(t.Readings)", "\(t.Hours)", Hundredths(t.Energy), width))
}

// line is one line of the table: the key padded to width, and three
// columns right-aligned in 8, 7 and 12 characters, as Go's
// fmt.Sprintf("%-*s  %8s  %7s  %12s") writes it.
func line(key string, readings string, hours string, energy string, width int) string {
	strings.PadRight(key, width, ' ') + "  " + strings.PadLeft(readings, 8, ' ') + "  " + strings.PadLeft(hours, 7, ' ') + "  " + strings.PadLeft(energy, 12, ' ')
}
