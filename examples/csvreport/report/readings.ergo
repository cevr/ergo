// Package report is the domain of the CSV report: meter readings read
// from rows, filtered, grouped and totalled, and the report's text. The
// source of the CSV text is a contract, Source, that a binary binds.

import csv
import strconv
import strings

// Reading is one row of a meter file: a device ran Hours at a load of Kw
// kilowatts, in hundredths.
type Reading { Site string, Device string, Hours int, Kw int64 }

// The failures of Load. A row with fewer or more fields than the header
// is the reader's csv.ParseError ("wrong number of fields").

// MissingColumn is a header without one of the four columns.
type MissingColumn { Name string }

// BadNumber is an hours or kw field (Field) that is not a number of its
// form: Line and Column are where the field starts in the text, as the
// reader gives them (csv.Position), so the message names the input as a
// csv.ParseError does.
type BadNumber { Line int, Column int, Field string, Text string }

// columns are the columns a meter file has, in any order.
let columns = []string{"site", "device", "hours", "kw"}

// Load is the readings of a CSV text whose first row is a header naming
// site, device, hours and kw, in any order, among other columns.
// It reads the rows as a stream and stops at the first bad one.
func Load(text string) []Reading fails csv.ParseError | MissingColumn | BadNumber {
	let mut at = []int{}
	let mut out = []Reading{}
	for item in csv.Rows(text) {
		match item {
		case csv.Malformed as m:
			return m.Error
		case csv.Parsed as p:
			if len(at) == 0 {
				at = try header(p.Fields)
				continue
			}
			out = out.Append(try reading(p, at))
		}
	}
	if len(at) == 0 {
		return MissingColumn{Name: columns[0]}
	}
	out
}

// header is the index of each of columns in fields.
func header(fields []string) []int fails MissingColumn {
	let mut at = []int{}
	for name in columns {
		let mut found = -1
		for i, f in fields {
			if strings.ToLower(strings.TrimSpace(f)) == name && found < 0 {
				found = i
			}
		}
		if found < 0 {
			return MissingColumn{Name: name}
		}
		at = at.Append(found)
	}
	at
}

// reading is the reading of the record p, with its columns at at. The
// reader gives every record as many fields as the header.
func reading(p csv.Parsed, at []int) Reading fails BadNumber {
	let fields = p.Fields
	let hoursText = strings.TrimSpace(fields[at[2]])
	let hours = strconv.Atoi(hoursText) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return bad(p, at[2], "hours")
	}
	let kwText = strings.TrimSpace(fields[at[3]])
	let kw = ParseHundredths(kwText) catch {
	case NotFixed:
		return bad(p, at[3], "kw")
	}
	Reading{Site: fields[at[0]], Device: fields[at[1]], Hours: hours, Kw: kw}
}

// bad is the failure of the field i of p, the column name.
func bad(p csv.Parsed, i int, name string) BadNumber {
	BadNumber{Line: p.At[i].Line, Column: p.At[i].Column, Field: name, Text: strings.TrimSpace(p.Fields[i])}
}

// NotFixed is a text that is not an amount of the form 12, 12.5 or 12.50.
type NotFixed {}

// ParseHundredths is the amount of text in hundredths: digits, then
// optionally a point and one or two digits.
func ParseHundredths(text string) int64 fails NotFixed {
	let cut = strings.Cut(text, ".")
	let mut whole = text
	let mut frac = ""
	match cut {
	case Some[strings.Halves] as h:
		whole = h.Value.Before
		frac = h.Value.After
		if len(frac) == 0 || len(frac) > 2 {
			return NotFixed
		}
	case None:
	}
	if len(whole) == 0 || len(whole) > 15 || !digits(whole) || !digits(frac) {
		return NotFixed
	}
	let u = strconv.ParseInt(whole, 10, 64) catch {
	case strconv.Malformed:
		return NotFixed
	case strconv.OutOfRange:
		return NotFixed
	}
	let mut f = int64(0)
	for i in 0..2 {
		f = f * 10
		if i < len(frac) {
			f = f + int64(frac[i]-'0')
		}
	}
	u*100 + f
}

// digits reports whether s is decimal digits only.
func digits(s string) bool {
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	true
}

// Hundredths is an amount in hundredths as text: 1234 is "12.34", -5 is "-0.05".
func Hundredths(hundredths int64) string {
	let sign = if hundredths < 0 { "-" } else { "" }
	let c = if hundredths < 0 { -hundredths } else { hundredths }
	let frac = c % 100
	"\(sign)\(c / 100).\(if frac < 10 { "0" } else { "" })\(frac)"
}
