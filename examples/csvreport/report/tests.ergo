// The report's tests: examples. The laws run under ergo test.

import csv

let file = "Site,Device,Hours,Kw,Note\nnorth,hub,3,2.50,\nsouth,hub,1,2.5,\"late, logged\"\nnorth,fan,2,4,\n"

test LoadsAnyColumnOrder {
	let readings = try Load("kw,hours,device,site\n1.05,2,hub,east\n")
	assert len(readings) == 1 && readings[0] == Reading{Site: "east", Device: "hub", Hours: 2, Kw: 105}
}

test TablesGroupAndTotal {
	let readings = try Load(file)
	let lines = Table(readings, BySite)
	assert len(lines) == 4
	assert lines[0] == "site   readings    hours        energy"
	assert lines[1] == "north         2        5         15.50"
	assert lines[2] == "south         1        1          2.50"
	assert lines[3] == "total         3        6         18.00"
	// Keys pad to the widest of the column name and the keys: "device", 6.
	let north = Table(Filter(readings, AtSite{Name: "north"}), ByDevice)
	assert north[0] == "device  readings    hours        energy"
	assert north[1] == "fan            1        2          8.00"
	assert north[2] == "hub            1        3          7.50"
}

// failure is the message of Load(text), or "ok".
func failure(text string) string {
	let _ = Load(text) catch {
	case csv.ParseError as b:
		return "csv \(b.Line):\(b.Column) \(b.Reason)"
	case MissingColumn as m:
		return "missing \(m.Name)"
	case BadNumber as n:
		return "bad \(n.Field) \(n.Text) at \(n.Line):\(n.Column)"
	}
	"ok"
}

test LoadFailures {
	assert failure("") == "missing site"
	assert failure("site,device,hours\n") == "missing kw"
	assert failure("site,device,hours,kw\nn,t,1\n") == "csv 2:1 wrong number of fields"
	assert failure("site,device,hours,kw\nn,t,x,1\n") == "bad hours x at 2:5"
	assert failure("site,device,hours,kw\nn,t,1,1.234\n") == "bad kw 1.234 at 2:7"
	assert failure("site,device,hours,kw\nn,t,1,\"1\n") == "csv 2:10 extraneous or missing \" in quoted-field"
	// A quoted field over two lines is one record: the next record is on
	// line 4, and a field after the quoted one is on line 3.
	assert failure("site,device,hours,kw\n\"a\nb\",t,1,1\nn,t,x,1\n") == "bad hours x at 4:5"
	assert failure("site,device,hours,kw\n\"a\nb\",t,x,1\n") == "bad hours x at 3:6"
	assert failure(file) == "ok"
}

test KeysPadByCharacters {
	let lines = Table([]Reading{Reading{Site: "Montréal", Device: "thé", Hours: 1, Kw: 100}}, BySite)
	assert lines[0] == "site      readings    hours        energy"
	assert lines[1] == "Montréal         1        1          1.00"
}

test HundredthsReads {
	assert try ParseHundredths("12") == 1200 && try ParseHundredths("12.5") == 1250 && try ParseHundredths("0.07") == 7
	assert Hundredths(1234) == "12.34" && Hundredths(-5) == "-0.05" && Hundredths(100) == "1.00"
}

// Generated readings rarely share a site, so the groups are also checked
// over readings with three sites.
test GroupsMerge(hours []int) {
	let mut readings = []Reading{}
	for i, u in hours {
		readings = readings.Append(Reading{Site: if i%2 == 0 { "a" } else { "b" }, Device: "p", Hours: u, Kw: 10})
		readings = readings.Append(Reading{Site: "a", Device: "q", Hours: 1, Kw: 1})
	}
	let groups = Group(readings, BySite)
	let mut energy = int64(0)
	for g in groups {
		energy += g.Energy
	}
	assert energy == Total(readings).Energy && len(groups) == (if len(hours) == 0 { 0 } else if len(hours) == 1 { 1 } else { 2 })
}
