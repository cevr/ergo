// The report's tests: examples. The laws run under ergo test.

import csv

let file = "Region,Product,Units,Price,Note\nnorth,tea,3,2.50,\nsouth,tea,1,2.5,\"late, paid\"\nnorth,cake,2,4,\n"

test LoadsAnyColumnOrder {
	let sales = try Load("price,units,product,region\n1.05,2,tea,east\n")
	assert len(sales) == 1 && sales[0] == Sale{Region: "east", Product: "tea", Units: 2, Cents: 105}
}

test TablesGroupAndTotal {
	let sales = try Load(file)
	let lines = Table(sales, ByRegion)
	assert len(lines) == 4
	assert lines[0] == "region   sales    units       revenue"
	assert lines[1] == "north        2        5         15.50"
	assert lines[2] == "south        1        1          2.50"
	assert lines[3] == "total        3        6         18.00"
	// Keys pad to the widest of the column name and the keys: "product", 7.
	let north = Table(Filter(sales, InRegion{Name: "north"}), ByProduct)
	assert north[0] == "product   sales    units       revenue"
	assert north[1] == "cake          1        2          8.00"
	assert north[2] == "tea           1        3          7.50"
}

// failure is the message of Load(text), or "ok".
func failure(text string) string {
	let _ = Load(text) catch {
	case csv.ParseError as b:
		return "csv \(b.Line):\(b.Column) \(b.Reason)"
	case MissingColumn as m:
		return "missing \(m.Name)"
	case BadNumber as n:
		return "bad \(n.Field) \(n.Text) at \(n.Line):\(n.Column)"
	}
	"ok"
}

test LoadFailures {
	assert failure("") == "missing region"
	assert failure("region,product,units\n") == "missing price"
	assert failure("region,product,units,price\nn,t,1\n") == "csv 2:1 wrong number of fields"
	assert failure("region,product,units,price\nn,t,x,1\n") == "bad units x at 2:5"
	assert failure("region,product,units,price\nn,t,1,1.234\n") == "bad price 1.234 at 2:7"
	assert failure("region,product,units,price\nn,t,1,\"1\n") == "csv 2:10 extraneous or missing \" in quoted-field"
	// A quoted field over two lines is one record: the next record is on
	// line 4, and a field after the quoted one is on line 3.
	assert failure("region,product,units,price\n\"a\nb\",t,1,1\nn,t,x,1\n") == "bad units x at 4:5"
	assert failure("region,product,units,price\n\"a\nb\",t,x,1\n") == "bad units x at 3:6"
	assert failure(file) == "ok"
}

test KeysPadByCharacters {
	let lines = Table([]Sale{Sale{Region: "Montréal", Product: "thé", Units: 1, Cents: 100}}, ByRegion)
	assert lines[0] == "region     sales    units       revenue"
	assert lines[1] == "Montréal       1        1          1.00"
}

test MoneyReads {
	assert (try ParseCents("12")) == 1200 && (try ParseCents("12.5")) == 1250 && (try ParseCents("0.07")) == 7
	assert Money(1234) == "12.34" && Money(-5) == "-0.05" && Money(100) == "1.00"
}

// Generated sales rarely share a region, so the groups are also checked
// over sales with three regions.
test GroupsMerge(units []int) {
	let mut sales = []Sale{}
	for i, u in units {
		sales = sales.Append(Sale{Region: if i%2 == 0 { "a" } else { "b" }, Product: "p", Units: u, Cents: 10})
		sales = sales.Append(Sale{Region: "a", Product: "q", Units: 1, Cents: 1})
	}
	let groups = Group(sales, ByRegion)
	let mut revenue = int64(0)
	for g in groups {
		revenue += g.Revenue
	}
	assert revenue == Total(sales).Revenue && len(groups) == (if len(units) == 0 { 0 } else if len(units) == 1 { 1 } else { 2 })
}
