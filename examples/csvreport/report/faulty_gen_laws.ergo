import csv
import gen
import sync
import testing

type stubReportSource {
	Body string,
} implements Source

func Read(s stubReportSource, name string) string fails Missing | Unreadable {
	if name == "meters.csv" {
		return s.Body
	}
	Missing{Name: name}
}

type reportFaultOutcome =
	| ReportFaultOk{Lines int}
	| ReportFaultMissing{}
	| ReportFaultUnreadable{}
	| ReportFaultOther{}

func runReportWithSource(name string) reportFaultOutcome needs Source {
	let lines = Report(name, []Keep{Every}, BySite) catch {
	case Missing:
		return ReportFaultMissing
	case Unreadable:
		return ReportFaultUnreadable
	case csv.ParseError, MissingColumn, BadNumber:
		return ReportFaultOther
	}
	ReportFaultOk{Lines: len(lines)}
}

// ReportPropagatesSourceFaults wraps report.Source in testing.Faulty and proves
// injected Missing and Unreadable faults propagate cleanly without panics while
// clean reads produce a valid report table.
law ReportPropagatesSourceFaults() {
	let cfg = gen.Config{Seed: uint64(1), Cases: 64, Shrinks: 0, MaxDraws: 2048, MaxRejected: 10}
	let sawSuccess = sync.NewRef(false)
	let sawMissing = sync.NewRef(false)
	let sawUnreadable = sync.NewRef(false)
	let base = stubReportSource{Body: "site,device,hours,kw\nnorth,pump,4,1.50\nsouth,fan,2,0.50\n"}
	let outcome = gen.Check(cfg, func() bool fails gen.Rejected needs gen.Draws {
		let faulty = testing.Faulty[Source](base)
		let f0 = len(faulty.Read.Faults())
		let res = with context { Source: faulty } { runReportWithSource("meters.csv") }
		let faulted = len(faulty.Read.Faults()) > f0
		match res {
		case ReportFaultOk as ok:
			if faulted {
				return false
			}
			sawSuccess.Set(true)
			ok.Lines == 4
		case ReportFaultMissing:
			sawMissing.Set(true)
			faulted
		case ReportFaultUnreadable:
			sawUnreadable.Set(true)
			faulted
		case ReportFaultOther:
			false
		}
	})
	match outcome {
	case gen.Held:
		sawSuccess.Get() && sawMissing.Get() && sawUnreadable.Get()
	case gen.Refuted, gen.GaveUp:
		false
	}
}

// FilterChainAndTableConsistency proves Filter composition commutes across AtSite
// and AtLeast, Table emits header + group rows + total, and ParseHundredths
// rejects malformed fixed-point inputs with NotFixed.
law FilterChainAndTableConsistency() {
	let cfg = gen.Config{Seed: uint64(1), Cases: 40, Shrinks: 0, MaxDraws: 2048, MaxRejected: 10}
	let sites = []string{"north", "south", "east"}
	let devices = []string{"pump", "fan", "valve"}
	let outcome = gen.Check(cfg, func() bool fails gen.Rejected needs gen.Draws {
		let n = gen.IntIn(0, 10)
		let mut rs = []Reading{}
		for _ in 0..n {
			rs = rs.Append(Reading{
				Site:   gen.OneOf(sites),
				Device: gen.OneOf(devices),
				Hours:  gen.IntIn(0, 24),
				Kw:     int64(gen.IntIn(0, 5000)),
			})
		}
		let siteKeep = AtSite{Name: gen.OneOf(sites)}
		let hoursKeep = AtLeast{Hours: gen.IntIn(0, 24)}
		if Filter(Filter(rs, siteKeep), hoursKeep) != Filter(Filter(rs, hoursKeep), siteKeep) {
			return false
		}
		if Filter(rs, Every) != rs {
			return false
		}
		let key = if gen.Bool() { BySite } else { ByDevice }
		let groups = Group(rs, key)
		let tbl = Table(rs, key)
		if len(tbl) != len(groups)+2 {
			return false
		}
		let bad = gen.OneOf([]string{"", "12.", "12.345", "-1.00", "abc", ".5"})
		let _ = ParseHundredths(bad) catch {
		case NotFixed:
			return true
		}
		false
	})
	match outcome {
	case gen.Held:
		true
	case gen.Refuted, gen.GaveUp:
		false
	}
}
