// The rules of the report as laws over its functions.

import csv
import strings

// Metered is readings as a file can hold them: every kW not negative, and
// no CR LF in a site or device (the reader reads a CR LF as LF).
func Metered(readings []Reading) []Reading {
	let mut out = []Reading{}
	for s in readings {
		out = out.Append(Reading{Site: lf(s.Site), Device: lf(s.Device), Hours: s.Hours, Kw: if s.Kw < 0 { -(s.Kw % 1000000) } else { s.Kw % 1000000 }})
	}
	out
}

// lf is s with each CR LF turned into LF until none is left.
func lf(s string) string {
	let mut out = s
	for strings.Contains(out, "\r\n") {
		out = strings.ReplaceAll(out, "\r\n", "\n")
	}
	out
}

// TotalIsFold: the total counts every reading once, and its energy is the
// sum of hours times kW, as a loop computes it.
law TotalIsFold(readings []Reading) {
	let t = Total(readings)
	let mut hours = 0
	let mut energy = int64(0)
	for s in readings {
		hours += s.Hours
		energy += int64(s.Hours) * s.Kw
	}
	t.Readings == len(readings) && t.Hours == hours && t.Energy == energy
}

// GroupsSumToTotal: the groups, under either key, add up to the total,
// and each key has one group.
law GroupsSumToTotal(readings []Reading, byDevice bool) {
	let groups = Group(readings, if byDevice { ByDevice } else { BySite })
	let t = Total(readings)
	let mut n = 0
	let mut hours = 0
	let mut energy = int64(0)
	for i, g in groups {
		n += g.Readings
		hours += g.Hours
		energy += g.Energy
		if i > 0 && groups[i-1].Key >= g.Key {
			return false
		}
	}
	n == t.Readings && hours == t.Hours && energy == t.Energy
}

// FilterKeepsOnly: a filter keeps exactly the readings its Keep keeps, in
// order.
law FilterKeepsOnly(readings []Reading, hours int) {
	let k = AtLeast{Hours: hours}
	let kept = Filter(readings, k)
	let mut j = 0
	for s in readings {
		if Kept(k, s) {
			if j >= len(kept) || kept[j] != s {
				return false
			}
			j += 1
		}
	}
	j == len(kept)
}

// LoadReadsRows: readings written as CSV load back as the same readings.
law LoadReadsRows(readings []Reading) {
	let ps = Metered(readings)
	try Load(csv.Format(Rows(ps))) == ps
}

// FixedRoundTrip: an amount of hundredths that is not negative reads back
// from its text.
law FixedRoundTrip(hundredths int64) {
	let c = if hundredths < 0 { -(hundredths % 1000000000) } else { hundredths % 1000000000 }
	try ParseHundredths(Hundredths(c)) == c
}
