// The source of a meter file, and the report over it.

import csv

// Missing is a name that the source has no file for.
type Missing { Name string }

// Unreadable is a file that the source has but cannot read.
type Unreadable { Name string, Reason string }

// Source is where meter files come from.
type Source {
	// Read is the text of the file name.
	Read(name string) string fails Missing | Unreadable,

	// ReadIsRepeatable: two reads of one name give one text, or both fail.
	law ReadIsRepeatable(name string) {
		let a = Read(name) catch {
		case Missing:
			return true
		case Unreadable:
			return true
		}
		let b = Read(name) catch {
		case Missing:
			return false
		case Unreadable:
			return false
		}
		a == b
	},
}

// Report is the table of the readings in the file name that every one of
// keeps keeps, grouped under k.
func Report(name string, keeps []Keep, k Key) []string fails Missing | Unreadable | csv.ParseError | MissingColumn | BadNumber needs Source {
	let text = try Source.Read(name)
	let mut readings = try Load(text)
	for keep in keeps {
		readings = Filter(readings, keep)
	}
	Table(readings, k)
}

// Rows is the CSV rows of readings, with a header first: the inverse of
// Load for readings whose kW is not negative.
func Rows(readings []Reading) [][]string {
	let mut out = [][]string{[]string{"site", "device", "hours", "kw"}}
	for s in readings {
		out = out.Append([]string{s.Site, s.Device, "\(s.Hours)", Hundredths(s.Kw)})
	}
	out
}
