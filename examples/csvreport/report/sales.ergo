// Package report is the domain of the CSV report: sales read from rows,
// filtered, grouped and totalled, and the report's text. The source of
// the CSV text is a contract, Source, that a binary binds.

import csvreport/csv
import strconv
import strings

// Sale is one row of a sales file: units sold at a price in cents.
type Sale { Region string, Product string, Units int, Cents int64 }

// The failures of Load.

// MissingColumn is a header without one of the four columns.
type MissingColumn { Name string }

// ShortRow is a row with fewer fields than the header names.
type ShortRow { Line int, Want int, Have int }

// BadNumber is a units or price field that is not a number of its form.
type BadNumber { Line int, Column string, Text string }

// columns are the columns a sales file has, in any order.
let columns = []string{"region", "product", "units", "price"}

// Load is the sales of a CSV text whose first row is a header naming
// region, product, units and price, in any order, among other columns.
// It reads the rows as a stream and stops at the first bad one.
func Load(text string) []Sale fails csv.BadCSV | MissingColumn | ShortRow | BadNumber {
	let mut at = []int{}
	let mut out = []Sale{}
	for item in csv.Rows(text) {
		match item {
		case csv.Malformed as m:
			return csv.BadCSV{Line: m.Line, Column: m.Column, Reason: m.Reason}
		case csv.Parsed as p:
			if len(at) == 0 {
				at = try header(p.Row.Fields)
				continue
			}
			out = out.Append(try sale(p.Row, at))
		}
	}
	if len(at) == 0 {
		return MissingColumn{Name: columns[0]}
	}
	out
}

// header is the index of each of columns in fields.
func header(fields []string) []int fails MissingColumn {
	let mut at = []int{}
	for name in columns {
		let mut found = -1
		for i, f in fields {
			if strings.ToLower(strings.TrimSpace(f)) == name && found < 0 {
				found = i
			}
		}
		if found < 0 {
			return MissingColumn{Name: name}
		}
		at = at.Append(found)
	}
	at
}

// sale is the sale of row r, with its columns at at.
func sale(r csv.Row, at []int) Sale fails ShortRow | BadNumber {
	let mut most = 0
	for i in at {
		if i+1 > most {
			most = i + 1
		}
	}
	if len(r.Fields) < most {
		return ShortRow{Line: r.Line, Want: most, Have: len(r.Fields)}
	}
	let unitsText = strings.TrimSpace(r.Fields[at[2]])
	let units = strconv.Atoi(unitsText) catch {
	case strconv.Malformed:
		return BadNumber{Line: r.Line, Column: "units", Text: unitsText}
	case strconv.OutOfRange:
		return BadNumber{Line: r.Line, Column: "units", Text: unitsText}
	}
	let priceText = strings.TrimSpace(r.Fields[at[3]])
	let cents = ParseCents(priceText) catch {
	case NotMoney:
		return BadNumber{Line: r.Line, Column: "price", Text: priceText}
	}
	Sale{Region: r.Fields[at[0]], Product: r.Fields[at[1]], Units: units, Cents: cents}
}

// NotMoney is a text that is not an amount of the form 12, 12.5 or 12.50.
type NotMoney {}

// ParseCents is the amount of text in cents: digits, then optionally a
// point and one or two digits.
func ParseCents(text string) int64 fails NotMoney {
	let whole = strings.Cut(text, ".")
	let mut units = text
	let mut frac = ""
	match whole {
	case Some[strings.Halves] as h:
		units = h.Value.Before
		frac = h.Value.After
		if len(frac) == 0 || len(frac) > 2 {
			return NotMoney
		}
	case None:
	}
	if len(units) == 0 || len(units) > 15 || !digits(units) || !digits(frac) {
		return NotMoney
	}
	let u = strconv.ParseInt(units, 10, 64) catch {
	case strconv.Malformed:
		return NotMoney
	case strconv.OutOfRange:
		return NotMoney
	}
	let mut f = int64(0)
	for i in 0..2 {
		f = f * 10
		if i < len(frac) {
			f = f + int64(frac[i]-'0')
		}
	}
	u*100 + f
}

// digits reports whether s is decimal digits only.
func digits(s string) bool {
	for i in 0..len(s) {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	true
}

// Money is cents as text: 1234 is "12.34", -5 is "-0.05".
func Money(cents int64) string {
	let sign = if cents < 0 { "-" } else { "" }
	let c = if cents < 0 { -cents } else { cents }
	let frac = c % 100
	"\(sign)\(c / 100).\(if frac < 10 { "0" } else { "" })\(frac)"
}
