// The writer: rows to text that ReadAll reads back.

import strings

// Format is rows as text, each row's fields joined by commas and ended
// by a line feed. A field is quoted, its quotes written twice, when it
// holds a comma, a quote, a CR or a LF, or starts with a space or a tab,
// as Go's encoding/csv writes it. Unlike Go, a row of one empty field is
// written "" and not as an empty line, which a reader skips, so every
// row reads back (law RoundTrip).
func Format(rows [][]string) string {
	let mut out = ""
	for fields in rows {
		if len(fields) == 1 && fields[0] == "" {
			out = out + "\"\"\n"
			continue
		}
		let mut quoted = []string{}
		for f in fields {
			quoted = quoted.Append(Quote(f))
		}
		out = out + strings.Join(quoted, ",") + "\n"
	}
	out
}

// Quote is f as a field: as it is, or in quotes when it needs them.
func Quote(f string) string {
	if !NeedsQuotes(f) {
		return f
	}
	"\"" + strings.ReplaceAll(f, "\"", "\"\"") + "\""
}

// NeedsQuotes reports whether f must be quoted to read back.
func NeedsQuotes(f string) bool {
	if f == "" {
		return false
	}
	if strings.Contains(f, ",") || strings.Contains(f, "\"") || strings.Contains(f, "\r") || strings.Contains(f, "\n") {
		return true
	}
	f[0] == ' ' || f[0] == '\t'
}

// FieldsOf is the fields of each row, in order.
func FieldsOf(rows []Row) [][]string {
	let mut out = [][]string{}
	for r in rows {
		out = out.Append(r.Fields)
	}
	out
}

// Same reports whether a and b hold the same fields in the same rows.
// A slice has no == (G-ex-d-5).
func Same(a [][]string, b [][]string) bool {
	if len(a) != len(b) {
		return false
	}
	for i, fs in a {
		if len(fs) != len(b[i]) {
			return false
		}
		for j, f in fs {
			if f != b[i][j] {
				return false
			}
		}
	}
	true
}
