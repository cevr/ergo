// Samples for the laws. A generated string holds none of the bytes the
// format gives a meaning (G-ex-d-4), so Spice turns some letters into
// them.

import strings

// Spice is s with a b z A Z turned into , " LF CR and CR LF.
func Spice(s string) string {
	let from = "abzAZ"
	let mut out = ""
	for i in 0..len(s) {
		match strings.Index(from, s[i:i+1]) {
		case 0:
			out = out + ","
		case 1:
			out = out + "\""
		case 2:
			out = out + "\n"
		case 3:
			out = out + "\r"
		case 4:
			out = out + "\r\n"
		case _:
			out = out + s[i:i+1]
		}
	}
	out
}

// Spiced is rows with every field spiced.
func Spiced(rows [][]string) [][]string {
	let mut out = [][]string{}
	for fs in rows {
		let mut row = []string{}
		for f in fs {
			row = row.Append(Spice(f))
		}
		out = out.Append(row)
	}
	out
}

// NonEmpty is rows without the rows of no field, which have no text.
func NonEmpty(rows [][]string) [][]string {
	let mut out = [][]string{}
	for fs in rows {
		if len(fs) > 0 {
			out = out.Append(fs)
		}
	}
	out
}
