// Clock keeps time.Clock's law NowNeverFalls, and a Sleep moves it.

import time

test SleepMovesNow(start int, steps []int) {
	let c = NewClock(int64(start % 4000000000))
	let mut last = c.Now()
	for step in steps {
		// A step of up to a day each way: a duration holds about 292 years.
		let s = step % 86400
		c.Sleep(duration(int64(s) * 1000000000))
		let now = c.Now()
		assert !now.Before(last)
		if s > 0 {
			assert time.UnixSeconds(now) == time.UnixSeconds(last)+int64(s)
		}
		last = now
	}
}

test ACopySharesTheTime {
	let c = NewClock(100)
	let d = c
	d.Sleep(60s)
	assert time.UnixSeconds(c.Now()) == 160
}
