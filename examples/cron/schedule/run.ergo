import cron
import option
import time
import tz

// Job is one line of a table: a name and when it fires.
type Job { Name string, When cron.Expr }

// Firing is a job that fired: the instant it was due, and the minute the
// clock read when it fired.
type Firing { Job string, Due time.Time, Woke time.Time }

// Upcoming is the first n instants after t at which e fires in z, fewer
// when e stops firing within cron's horizon.
func Upcoming(e cron.Expr, z tz.Zone, t time.Time, n int) []time.Time {
	let mut out = []time.Time{}
	let mut at = t
	for out.Len() < n {
		match cron.Next(e, z, at) {
		case option.Some[time.Time] as next:
			out = out.Append(next.Value)
			at = next.Value
		case option.None:
			return out
		}
	}
	out
}

// Run fires the jobs in the zone z on the clock of its context until the
// instant until: it sleeps on the Scheduler to the next instant that a
// job is due, then calls fire for each job due then, in table order. The
// first instant it considers is the one after the clock's time when it
// starts.
func Run[R](jobs []Job, z tz.Zone, until time.Time, fire func(f Firing) needs R) needs time.Clock | time.Scheduler | R {
	let mut cursor = time.Clock.Now()
	for {
		let mut due = time.Add(until, 1s)
		for j in jobs {
			match cron.Next(j.When, z, cursor) {
			case option.Some[time.Time] as n:
				if time.Before(n.Value, due) {
					due = n.Value
				}
			case option.None:
			}
		}
		if time.After(due, until) {
			return
		}
		let wait = time.Sub(due, time.Clock.Now())
		if wait > 0s {
			time.Scheduler.Sleep(wait)
		}
		let woke = MinuteOf(time.Clock.Now())
		for j in jobs {
			if cron.Next(j.When, z, cursor) == (option.Some[time.Time]{Value: due}) {
				fire(Firing{Job: j.Name, Due: due, Woke: woke})
			}
		}
		cursor = due
	}
}
