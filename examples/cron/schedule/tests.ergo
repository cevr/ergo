// The schedule's tests: examples of next firings, in UTC and across New
// York's clock changes, the table, and a run on a virtual clock. std
// cron's laws hold Next to a brute-force walk.

import cron
import strings
import testing
import time
import tz
import tz/iana

// at is the minute of the text "2006-01-02 15:04" in UTC.
func at(text string) time.Time fails BadMinute { try MinuteIn(text, tz.UTC()) }

// next is the text of the first firing of the expression after the
// minute, both in z, or "never", or "bad".
func next(expr string, after string, z tz.Zone) string {
	let e = cron.Parse(expr) catch {
	case cron.FieldCount, cron.BadValue, cron.OutOfRange, cron.BadStep, cron.BadRange:
		return "bad"
	}
	let t = MinuteIn(after, z) catch {
	case BadMinute:
		return "bad time"
	}
	match cron.Next(e, z, t) {
	case Some[time.Time] as n:
		Text(n.Value, z)
	case None:
		"never"
	}
}

test NextFirings {
	let utc = tz.UTC()
	assert next("*/15 9-17 * * MON-FRI", "2026-11-08 12:00", utc) == "2026-11-09 09:00 Mon"
	assert next("*/15 9-17 * * mon-fri", "2026-11-09 17:45", utc) == "2026-11-10 09:00 Tue"
	assert next("0 0 29 2 *", "2026-11-08 12:00", utc) == "2028-02-29 00:00 Tue"
	assert next("0 0 30 2 *", "2026-11-08 12:00", utc) == "never"
	assert next("@yearly", "2026-12-31 23:59", utc) == "2027-01-01 00:00 Fri"
	assert next("0 12 */10 * FRI", "2026-11-08 12:00", utc) == "2026-12-11 12:00 Fri"
}

// A job at 02:30 in New York fires at 03:30 on the day the clocks skip
// 02:00 to 03:00, and once at 01:30 on the day they show 01:00 twice.
test NextFiringsAcrossClockChanges {
	let ny = try iana.New().Load("America/New_York")
	assert next("30 2 * * *", "2026-03-07 12:00", ny) == "2026-03-08 03:30 Sun"
	assert next("30 2 * * *", "2026-03-08 03:30", ny) == "2026-03-09 02:30 Mon"
	assert next("30 1 * * *", "2026-11-01 01:30", ny) == "2026-11-02 01:30 Mon"
}

test ATableHasJobsCommentsAndBlanks {
	let jobs = try ParseTable("# nightly\n0 3 * * * backup the disk\n\n@hourly  rotate logs\n")
	assert len(jobs) == 2 && jobs[0].Name == "backup the disk" && jobs[1].Name == "rotate logs"
	assert cron.Format(jobs[1].When) == "0 * * * *"
}

// badLine is the line and reason that ParseTable refuses in text.
func badLine(text string) string {
	let _ = ParseTable(text) catch {
	case BadLine as b:
		return "\(b.Line): " + b.Reason
	}
	"ok"
}

test ABadLineNamesItsNumber {
	assert badLine("0 3 * * * a\n0 3 * *\n") == "2: no job name after the expression"
	assert badLine("\n\n61 3 * * * a\n") == "3: minute: 61 is not in 0-59"
	assert badLine("@weekly\n") == "1: no job name after the expression"
	assert badLine("@often job\n") == "1: 1 fields, not 5"
	assert badLine("* 5-1 * * * a\n") == "1: hour: range 5-1 ends before it starts"
}

// Run comes last: it loops on cron.Next, so a Next that does not move
// hangs it, and std cron's laws report that first.
test RunFiresOnTimeOnAVirtualClock {
	let utc = tz.UTC()
	let start = try at("2026-11-08 12:00")
	let jobs = []Job{Job{Name: "a", When: try cron.Parse("*/20 * * * *")}, Job{Name: "b", When: try cron.Parse("30,40 12 * * *")}}
	let clock = testing.NewVirtualClock(time.UnixSeconds(start))
	let mut log = []string{}
	with context { time.Clock: clock, Scheduler: clock } {
		Run(jobs, utc, time.Add(start, 1h), func(f Firing) {
			log = log.Append(f.Job + " " + Text(f.Due, utc) + " woke " + Text(f.Woke, utc))
		})
	}
	assert strings.Join(log, "\n") == "a 2026-11-08 12:20 Sun woke 2026-11-08 12:20 Sun\nb 2026-11-08 12:30 Sun woke 2026-11-08 12:30 Sun\na 2026-11-08 12:40 Sun woke 2026-11-08 12:40 Sun\nb 2026-11-08 12:40 Sun woke 2026-11-08 12:40 Sun\na 2026-11-08 13:00 Sun woke 2026-11-08 13:00 Sun"
}
