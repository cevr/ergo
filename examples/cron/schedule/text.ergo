// Package schedule is the domain of cron: a table of jobs, and Run, which
// fires them on a clock in a time zone. The expression, its parser and
// printer and the next time it fires are std cron's; this package adds
// the table, the run, and the text of a minute. Everything but Run is
// pure.

import civil
import time
import tz

// minuteWithWeekday is the minute label printed for a firing.
let minuteWithWeekday = civil.WithWeekday(civil.DateTimeMinutes, civil.Short)

// Text is the minute of t in z as "2006-01-02 15:04 Mon".
func Text(t time.Time, z tz.Zone) string { civil.FormatDateTime(tz.Civil(z, t), minuteWithWeekday) }

// BadMinute is a text that is not a minute written "2006-01-02 15:04".
type BadMinute { Text string }

// MinuteIn is the instant of the wall time text, written "2006-01-02
// 15:04", in z. A minute z skips is read a gap later, and a minute z shows
// twice at its first showing (tz.Compatible), as std cron fires them.
func MinuteIn(text string, z tz.Zone) time.Time fails BadMinute {
	let dt = civil.ParseDateTime(civil.DateTimeMinutes, text) catch {
	case civil.ParseError:
		return BadMinute{Text: text}
	}
	tz.Compatible(tz.Resolve(z, dt))
}

// MinuteOf is t with its seconds dropped.
func MinuteOf(t time.Time) time.Time {
	let s = time.UnixSeconds(t)
	time.Unix(if s >= 0 { s / 60 * 60 } else { (s - 59) / 60 * 60 }, 0)
}
