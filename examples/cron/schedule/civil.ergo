// Package schedule is the domain of cron: an expression of five fields,
// its parser and printer, the next minute it fires after a given one, and
// Run, which fires a table of jobs on a clock. Everything but Run is pure.
//
// Times are whole minutes in UTC: an Instant is minutes since 1970-01-01
// 00:00 UTC, and Civil is its calendar reading, which std civil gives: the
// day is a civil.Date, and the minute of the day is the rest.

import civil
import time

// Instant is a minute: the number of minutes since 1970-01-01 00:00 UTC.
type Instant int64

// Civil is the calendar reading of an Instant, in the numbers a cron field
// names: Month is 1 to 12, Day 1 to 31, Hour 0 to 23, Minute 0 to 59, and
// Weekday 0 (Sunday) to 6. Date is the day itself.
type Civil { Date civil.Date, Year int64, Month int64, Day int64, Hour int64, Minute int64, Weekday int64 }

// MinutesPerDay is the minutes of a day: an Instant has no leap seconds.
let MinutesPerDay int64 = 1440

// DayOf is the day of t.
func DayOf(t Instant) civil.Date {
	let n = int64(t)
	let q = n / MinutesPerDay
	civil.FromUnixDays(if n%MinutesPerDay < 0 { q - 1 } else { q })
}

// StartOfDay is the first minute of d.
func StartOfDay(d civil.Date) Instant { Instant(civil.UnixDays(d) * MinutesPerDay) }

// CivilOf is the calendar reading of t.
func CivilOf(t Instant) Civil {
	let d = DayOf(t)
	let m = int64(t - StartOfDay(d))
	Civil{
		Date:    d,
		Year:    int64(civil.Year(d)),
		Month:   int64(time.MonthNumber(civil.Month(d))),
		Day:     int64(civil.Day(d)),
		Hour:    m / 60,
		Minute:  m % 60,
		Weekday: int64(time.WeekdayNumber(civil.Weekday(d))),
	}
}

// InstantOf is the minute that c reads, from its date, hour and minute.
func InstantOf(c Civil) Instant { StartOfDay(c.Date) + Instant(c.Hour*60+c.Minute) }

// NextMonth is the first minute of the month after c's.
func NextMonth(c Civil) Instant { StartOfDay(civil.AddMonths(civil.StartOf(c.Date, civil.Months), 1)) }

// NextDay is the first minute of the day after c's.
func NextDay(c Civil) Instant { StartOfDay(civil.AddDays(c.Date, 1)) }

// MonthDays is the number of days of month m of year y; m is 1 to 12.
func MonthDays(y int64, m int64) int64 { int64(civil.DaysIn(int(y), month(m))) }

// month is the month numbered n, 1 to 12.
func month(n int64) time.Month {
	match time.MonthOf(int(n)) {
	case Some[time.Month] as m:
		m.Value
	case None:
		Unreachable("a cron month is 1 to 12")
	}
}

// Text is t as "2006-01-02 15:04 Mon".
func Text(t Instant) string { time.Format(time.Unix(int64(t)*60, 0), time.Custom{Text: "2006-01-02 15:04 Mon"}) }

// DayNames are the names of the weekdays, from Sunday.
let DayNames = []string{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}

// MonthNames are the names of the months, from January.
let MonthNames = []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}
