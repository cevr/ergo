// Package schedule is the domain of cron: an expression of five fields,
// its parser and printer, the next minute it fires after a given one, and
// Run, which fires a table of jobs on a clock. Everything but Run is pure.
//
// Times are whole minutes in UTC: an Instant is minutes since 1970-01-01
// 00:00 UTC, and Civil is its calendar reading, which std time's Calendar
// and Date give.

import time

// Instant is a minute: the number of minutes since 1970-01-01 00:00 UTC.
type Instant int64

// Civil is the calendar reading of an Instant, in the numbers a cron field
// names: Month is 1 to 12, Day 1 to 31, Hour 0 to 23, Minute 0 to 59, and
// Weekday 0 (Sunday) to 6.
type Civil { Year int64, Month int64, Day int64, Hour int64, Minute int64, Weekday int64 }

// timeOf is the time of t.
func timeOf(t Instant) time.Time { time.Unix(int64(t)*60, 0) }

// CivilOf is the calendar reading of t.
func CivilOf(t Instant) Civil {
	let c = time.Calendar(timeOf(t))
	Civil{
		Year:    int64(c.Year),
		Month:   int64(time.MonthNumber(c.Month)),
		Day:     int64(c.Day),
		Hour:    int64(c.Hour),
		Minute:  int64(c.Minute),
		Weekday: int64(time.WeekdayNumber(c.Weekday)),
	}
}

// InstantOf is the minute that c reads, from its year, month, day, hour
// and minute; Weekday is not read. Month is 1 to 12.
func InstantOf(c Civil) Instant {
	let at = time.Date(int(c.Year), month(c.Month), int(c.Day), int(c.Hour), int(c.Minute), 0, 0)
	Instant(time.UnixSeconds(at) / 60)
}

// MonthDays is the number of days of month m of year y.
func MonthDays(y int64, m int64) int64 {
	let first = InstantOf(Civil{Year: y, Month: m, Day: 1, Hour: 0, Minute: 0, Weekday: 0})
	let next = InstantOf(Civil{Year: y + m/12, Month: m%12 + 1, Day: 1, Hour: 0, Minute: 0, Weekday: 0})
	int64(next-first) / 1440
}

// month is the month numbered n, 1 to 12.
func month(n int64) time.Month {
	match time.MonthOf(int(n)) {
	case Some[time.Month] as m:
		m.Value
	case None:
		Unreachable("a cron month is 1 to 12")
	}
}

// Text is t as "2006-01-02 15:04 Mon".
func Text(t Instant) string { time.Format(timeOf(t), time.Custom{Text: "2006-01-02 15:04 Mon"}) }

// DayNames are the names of the weekdays, from Sunday.
let DayNames = []string{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}

// MonthNames are the names of the months, from January.
let MonthNames = []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}
