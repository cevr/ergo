// Package memory holds the in-memory providers of the search contracts.

import search/search
import strings

// Shelf is a search.Catalog of ten fixed items, in a fixed order. Its
// index takes at most 12 letters: a longer query is IndexDown, so that a
// script can show a search that fails.
type Shelf {}

func All(_ Shelf) []search.Item {
	[]search.Item{
		search.Item{Name: "Apple", Price: 120},
		search.Item{Name: "Apricot jam", Price: 450},
		search.Item{Name: "Banana", Price: 90},
		search.Item{Name: "Bread", Price: 300},
		search.Item{Name: "Cabbage", Price: 210},
		search.Item{Name: "Carrot", Price: 80},
		search.Item{Name: "Grape", Price: 260},
		search.Item{Name: "Pear", Price: 150},
		search.Item{Name: "Peach", Price: 170},
		search.Item{Name: "Pineapple", Price: 390},
	}
}

func Find(s Shelf, query string) []search.Item fails search.IndexDown {
	if len(strings.TrimSpace(query)) > 12 {
		return search.IndexDown{Query: query}
	}
	let mut hits = []search.Item{}
	for it in All(s) {
		if search.Matches(it, query) {
			hits = hits.Append(it)
		}
	}
	hits
}
