// Package memory holds the in-memory providers of the search contracts.

import search/search
import strings
import machines
import search/script
import time

// Listing is a search.Index of ten fixed entries, in a fixed order. Its
// index takes at most 12 letters: a longer query is IndexDown, so that a
// script can show a search that fails.
type Listing {} implements search.Index

// DebounceCoalesces: a key restarts the pause, so the search runs once
// after the last key and once in each gap of a pause or more (at the
// instant the pause ends, the timer goes first).
law DebounceCoalesces(gaps []int) {
	let s = typed(gaps)
	let mut want = if s.Trace.Len() > 0 { 1 } else { 0 }
	for i, g in gaps {
		if i > 0 && i < word.Len() && gap(g) >= 250 {
			want = want + 1
		}
	}
	let mut searches = 0
	for l in play(s) {
		if strings.Contains(l, " searching ") {
			searches = searches + 1
		}
	}
	searches == want
}

func All(_ Listing) []search.Entry {
	[]search.Entry{
		search.Entry{Name: "Apple.md", Size: 120},
		search.Entry{Name: "Apricot-jam.md", Size: 450},
		search.Entry{Name: "Banana.md", Size: 90},
		search.Entry{Name: "Bread.md", Size: 300},
		search.Entry{Name: "Cabbage.md", Size: 210},
		search.Entry{Name: "Carrot.md", Size: 80},
		search.Entry{Name: "Grape.md", Size: 260},
		search.Entry{Name: "Pear.md", Size: 150},
		search.Entry{Name: "Peach.md", Size: 170},
		search.Entry{Name: "Pineapple.md", Size: 390},
	}
}

func Find(s Listing, query string) []search.Entry fails search.IndexDown {
	if strings.TrimSpace(query).Len() > 12 {
		return search.IndexDown{Query: query}
	}
	let mut hits = []search.Entry{}
	for it in All(s) {
		if search.Matches(it, query) {
			hits = hits.Append(it)
		}
	}
	hits
}

// HitsForLatestQuery: once the keys stop, the screen shows the hits of
// the whole text typed.
law HitsForLatestQuery(gaps []int) {
	let s = typed(gaps)
	if s.Trace.Len() == 0 {
		return true
	}
	let text = strings.Slice(word, 0, s.Trace.Len())
	let hits = Find(Listing, text) catch {
	case search.IndexDown:
		return false
	}
	let mut last = ""
	for l in play(s) {
		if !strings.Contains(l, " ! ") {
			last = l
		}
	}
	strings.HasSuffix(last, search.Name(search.Showing{Query: text, Hits: hits, Pins: []search.Entry{}}))
}

// word is the text the laws type, one letter per key.
let word = "apricot"

// typed is a script that types the first letters of word, one per gap
// (at most len(word)), each 0 to 499 ms after the one before, and ends a
// second after the last key.
func typed(gaps []int) script.Script {
	let mut trace = []machines.Timed[search.Signal]{}
	let mut at = 0
	for i, g in gaps {
		if i == word.Len() {
			break
		}
		if i > 0 {
			at = at + gap(g)
		}
		trace = trace.Append(machines.Timed[search.Signal]{At: millis(at), Signal: search.Key{Text: strings.Slice(word, i, i+1)}})
	}
	script.Script{Trace: trace, End: millis(at + 1000)}
}

func gap(g int) int { ((g % 500) + 500) % 500 }

func millis(n int) duration { duration(int64(n) * 1000000) }

func play(s script.Script) []string {
	let clock = time.NewManual(0)
	with context { search.Index: Listing, time.Scheduler: clock } {
		script.Play(s, clock)
	}
}
