// Search is the machine's state. Every state holds the cart, the items
// added so far.
//
//	Idle       nothing typed
//	Typing     a query typed; the search waits for a pause (Pause)
//	Searching  the search of Query runs (its work)
//	Showing    the hits of Query
//	Adding     the add of Item to the cart runs (its work)
//	Problem    a search or an add failed; Message says why
type Search = Idle{Cart []Item} | Typing{Query string, Cart []Item} | Searching{Query string, Cart []Item} | Showing{Query string, Hits []Item, Cart []Item} | Adding{Query string, Hits []Item, Item Item, Cart []Item} | Problem{Query string, Hits []Item, Cart []Item, Message string}

// Signal is what the machine reads. Key, Clear, Choose, Back and Checkout
// come from the user; Paused from the state's timer; Found, IndexFailed,
// Added and Full are the results of the states' work, which the runner
// sends only to the entry that started it.
type Signal = Key{Text string} | Clear{} | Choose{Hit int} | Back{} | Checkout{} | Paused{} | Found{Hits []Item} | IndexFailed{} | Added{Cart []Item} | Full{}

// Output is what the machine tells: the hits of a query, an item put in
// the cart, and the order at Checkout.
type Output = Shown{Query string, Count int} | Put{Name string} | Order{Items []Item}

// NoSuchHit is a Choose of a hit the screen does not show.
type NoSuchHit { Hit int, Count int }

// Pause is how long Typing waits with no key before it searches.
let Pause = 250ms

// Job is a state's work, which the runner starts when the state's entry
// opens and stops when it ends. Ergo has no state-owned work yet (M45):
// Work names it as after names a timer, and Drive runs it.
type Job = FindJob{Query string} | AddJob{Cart []Item, Item Item}

// Work is the job of each state.
func Work(s Search) Option[Job] {
	match s {
	case Idle:
		None
	case Typing:
		None
	case Searching as q:
		Some[Job]{Value: FindJob{Query: q.Query}}
	case Showing:
		None
	case Adding as a:
		Some[Job]{Value: AddJob{Cart: a.Cart, Item: a.Item}}
	case Problem:
		None
	}
}

// Timer is the timer of each state: Typing waits Pause, then searches.
func Timer(s Search) Option[Timeout[Signal]] {
	match s {
	case Idle:
		None
	case Typing:
		Some[Timeout[Signal]]{Value: Timeout[Signal]{In: Pause, Signal: Paused}}
	case Searching:
		None
	case Showing:
		None
	case Adding:
		None
	case Problem:
		None
	}
}

// CartOf is the cart of s.
func CartOf(s Search) []Item {
	match s {
	case Idle as i:
		i.Cart
	case Typing as t:
		t.Cart
	case Searching as q:
		q.Cart
	case Showing as w:
		w.Cart
	case Adding as a:
		a.Cart
	case Problem as p:
		p.Cart
	}
}

// HitsOf is the hits s shows or keeps, none in Idle, Typing and
// Searching.
func HitsOf(s Search) []Item {
	match s {
	case Idle:
		[]Item{}
	case Typing:
		[]Item{}
	case Searching:
		[]Item{}
	case Showing as w:
		w.Hits
	case Adding as a:
		a.Hits
	case Problem as p:
		p.Hits
	}
}

// QueryOf is the query of s, "" in Idle.
func QueryOf(s Search) string {
	match s {
	case Idle:
		""
	case Typing as t:
		t.Query
	case Searching as q:
		q.Query
	case Showing as w:
		w.Query
	case Adding as a:
		a.Query
	case Problem as p:
		p.Query
	}
}

func enter(s Search) Decision[Search, Output] { Enter[Search]{Next: s} }

// typed is the decision of the key k in s: a key always enters Typing
// with the longer query, so it restarts the pause and stops any running
// work: the last query wins.
func typed(s Search, k Key) Decision[Search, Output] {
	enter(Typing{Query: QueryOf(s) + k.Text, Cart: CartOf(s)})
}

// Start is the machine's start function: the cart it begins with is its
// input (V4).
func Start(cart []Item) Search { Idle{Cart: cart} }

// Step is the search's transition. A key types; Clear goes back to Idle;
// a pause searches; the search's result shows; Choose adds a hit; the
// add's result shows the hits again; Checkout is Done with the order. A
// result in a state that has no work is Ignore: the runner never sends
// one (rule 6), and the step does not trust that.
func Step(s Search, sig Signal) Decision[Search, Output] fails NoSuchHit {
	let cart = CartOf(s)
	match sig {
	case Key as k:
		typed(s, k)
	case Clear:
		match s {
		case Idle:
			Ignore
		case Typing:
			enter(Idle{Cart: cart})
		case Searching:
			enter(Idle{Cart: cart})
		case Showing:
			enter(Idle{Cart: cart})
		case Adding:
			enter(Idle{Cart: cart})
		case Problem:
			enter(Idle{Cart: cart})
		}
	case Checkout:
		Done[Output]{Output: Order{Items: cart}}
	case Paused:
		match s {
		case Typing as t:
			enter(Searching{Query: t.Query, Cart: cart})
		case Idle:
			Ignore
		case Searching:
			Ignore
		case Showing:
			Ignore
		case Adding:
			Ignore
		case Problem:
			Ignore
		}
	case Found as f:
		match s {
		case Searching as q:
			Emit[Search, Output]{Next: Showing{Query: q.Query, Hits: f.Hits, Cart: cart}, Output: Shown{Query: q.Query, Count: len(f.Hits)}}
		case Idle:
			Ignore
		case Typing:
			Ignore
		case Showing:
			Ignore
		case Adding:
			Ignore
		case Problem:
			Ignore
		}
	case IndexFailed:
		match s {
		case Searching as q:
			enter(Problem{Query: q.Query, Hits: []Item{}, Cart: cart, Message: "the index is down"})
		case Idle:
			Ignore
		case Typing:
			Ignore
		case Showing:
			Ignore
		case Adding:
			Ignore
		case Problem:
			Ignore
		}
	case Choose as c:
		match s {
		case Showing as w:
			if c.Hit < 1 || c.Hit > len(w.Hits) {
				return NoSuchHit{Hit: c.Hit, Count: len(w.Hits)}
			}
			enter(Adding{Query: w.Query, Hits: w.Hits, Item: w.Hits[c.Hit-1], Cart: cart})
		case Idle:
			NoSuchHit{Hit: c.Hit, Count: 0}
		case Typing:
			NoSuchHit{Hit: c.Hit, Count: 0}
		case Searching:
			NoSuchHit{Hit: c.Hit, Count: 0}
		case Adding:
			Ignore
		case Problem:
			NoSuchHit{Hit: c.Hit, Count: 0}
		}
	case Added as a:
		match s {
		case Adding as ad:
			Emit[Search, Output]{Next: Showing{Query: ad.Query, Hits: ad.Hits, Cart: a.Cart}, Output: Put{Name: ad.Item.Name}}
		case Idle:
			Ignore
		case Typing:
			Ignore
		case Searching:
			Ignore
		case Showing:
			Ignore
		case Problem:
			Ignore
		}
	case Full:
		match s {
		case Adding as ad:
			enter(Problem{Query: ad.Query, Hits: ad.Hits, Cart: cart, Message: "the cart is full"})
		case Idle:
			Ignore
		case Typing:
			Ignore
		case Searching:
			Ignore
		case Showing:
			Ignore
		case Problem:
			Ignore
		}
	case Back:
		match s {
		case Problem as p:
			enter(Showing{Query: p.Query, Hits: p.Hits, Cart: cart})
		case Idle:
			Ignore
		case Typing:
			Ignore
		case Searching:
			Ignore
		case Showing:
			Ignore
		case Adding:
			Ignore
		}
	}
}

// Finder is the search as a machine: its input is the cart it begins
// with, its timer is the pause after a key, and its work, which Drive
// runs, is Work.
type Finder machine[Search, Signal] {
	initial: Start,
	step:    Step,
	after:   Timer,
}

// Name is the word of a state.
func Name(s Search) string {
	match s {
	case Idle:
		"idle"
	case Typing as t:
		"typing \"\(t.Query)\""
	case Searching as q:
		"searching \"\(q.Query)\""
	case Showing as w:
		"showing \"\(w.Query)\": \(Names(w.Hits))"
	case Adding as a:
		"adding \(a.Item.Name)"
	case Problem as p:
		"problem: \(p.Message)"
	}
}
