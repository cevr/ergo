// The step's own rules, as top-level laws over Step. MU6 machine laws
// landed beside this program; moving these into Finder is a follow-up.
// The live laws are in memory, where the catalogue is.

// CartHoldsRoom: a chosen hit goes into the cart and is told, unless the
// cart holds Room items; then the screen shows the problem.
law CartHoldsRoom(n int) {
	let have = ((n % 5) + 5) % 5
	let mut cart = []Item{}
	for i in 0..have {
		cart = cart.Append(Item{Name: "x\(i)", Price: i})
	}
	let hits = []Item{Item{Name: "Pear", Price: 150}}
	let d = Step(Showing{Query: "pe", Hits: hits, Cart: cart}, Choose{Hit: 1}) catch {
	case NoSuchHit:
		return false
	}
	match d {
	case Emit[Search, Output] as e:
		have < Room && len(CartOf(e.Next)) == have+1 && e.Output == Put{Name: "Pear"}
	case Enter[Search] as en:
		match en.Next {
		case Problem as p:
			have >= Room && len(p.Cart) == have
		case _:
			false
		}
	case _:
		false
	}
}
