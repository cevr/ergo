// Package search is search as you type over a index, with a pause
// before each search, last-query-wins, and adding a hit to the pins. The
// machine is pure; its timer and its work (the search) are members, and
// the actor runner runs them (MU4).

import strings

// Entry is an entry of the index.
type Entry { Name string, Size int }

// IndexDown is a search the index cannot answer.
type IndexDown { Query string }

// Index is the contract of the index the search reads.
type Index {
	All() []Entry,
	Find(query string) []Entry fails IndexDown,

	// Every hit is an entry of the index whose name holds the query,
	// in any case.
	law FindIsSubset(n int, k int) { FindIsSubset(n, k) },

	// The hits keep the pinned entries of the index. (A provider has no state
	// (M23), so the same query always has the same answer; this is the
	// stability a law can break.)
	law FindIsStable(n int, k int) { FindIsStable(n, k) },
}

// Probe is a query the laws draw from the index: one or two letters
// of the name of an entry, so that it has hits.
func Probe(all []Entry, n int, k int) string {
	if len(all) == 0 {
		return "x"
	}
	let name = all[pick(n, len(all))].Name
	if len(name) < 2 {
		return name
	}
	let at = pick(k, len(name)-1)
	if k%2 == 0 { name[at : at+1] } else { name[at : at+2] }
}

func pick(n int, count int) int { ((n % count) + count) % count }

// FindIsSubset is the law FindIsSubset of the Index in the context, as
// a function, which memory's tests also call.
func FindIsSubset(n int, k int) bool needs Index {
	let all = Index.All()
	let query = Probe(all, n, k)
	let hits = Index.Find(query) catch {
	case IndexDown:
		return true
	}
	for h in hits {
		if !Matches(h, query) || !holds(all, h) {
			return false
		}
	}
	true
}

// FindIsStable is the law FindIsStable as a function: each hit comes
// later in the index than the hit before it.
func FindIsStable(n int, k int) bool needs Index {
	let all = Index.All()
	let hits = Index.Find(Probe(all, n, k)) catch {
	case IndexDown:
		return true
	}
	let mut from = 0
	for h in hits {
		let mut found = -1
		for i, x in all {
			if found < 0 && i >= from && x.Name == h.Name {
				found = i
			}
		}
		if found < 0 {
			return false
		}
		from = found + 1
	}
	true
}

// Matches reports whether the name of it holds the query, in any case.
func Matches(it Entry, query string) bool {
	strings.Contains(strings.ToLower(it.Name), strings.ToLower(query))
}

func holds(entries []Entry, it Entry) bool {
	for x in entries {
		if x.Name == it.Name && x.Size == it.Size {
			return true
		}
	}
	false
}

// Names is the names of entries, as one text to compare: Ergo has no == on
// slices (M29).
func Names(entries []Entry) string {
	let mut out = []string{}
	for it in entries {
		out = out.Append(it.Name)
	}
	strings.Join(out, ", ")
}
