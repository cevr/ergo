// Package search is search as you type over a catalogue, with a pause
// before each search, last-query-wins, and adding a hit to a cart. The
// machine is pure; its timer and its work (a search, an add) are run by
// Drive, a runner written by hand until Ergo has state-owned work (M45).

import strings

// Item is an item of the catalogue.
type Item { Name string, Price int }

// IndexDown is a search the catalogue cannot answer.
type IndexDown { Query string }

// CartFull is an add to a cart that has no room.
type CartFull { Room int }

// Catalog is the contract of the catalogue the search reads.
type Catalog {
	All() []Item,
	Find(query string) []Item fails IndexDown,

	// Every hit is an item of the catalogue whose name holds the query,
	// in any case.
	law FindIsSubset(query string) {
		let hits = Find(query) catch {
		case IndexDown:
			return true
		}
		for h in hits {
			if !Matches(h, query) || !holds(All(), h) {
				return false
			}
		}
		true
	},

	// A search answers the same for the same query.
	law FindIsStable(query string) {
		let a = Find(query) catch {
		case IndexDown:
			return true
		}
		let b = Find(query) catch {
		case IndexDown:
			return false
		}
		Names(a) == Names(b)
	},
}

// Cart is the contract of the cart the search adds to. A cart is a value
// that the machine holds; the contract decides what an add does.
type Cart {
	Room() int,
	Add(have []Item, item Item) []Item fails CartFull,

	// An add puts the item at the end, or is CartFull exactly when the cart
	// holds Room items or more.
	law AddAddsOne(have []Item, item Item) {
		let after = Add(have, item) catch {
		case CartFull:
			return len(have) >= Room()
		}
		len(have) < Room() && len(after) == len(have)+1 && after[len(have)].Name == item.Name && Names(have) == Names(without(after, len(have)))
	},
}

// Matches reports whether the name of it holds the query, in any case.
func Matches(it Item, query string) bool {
	strings.Contains(strings.ToLower(it.Name), strings.ToLower(query))
}

func holds(items []Item, it Item) bool {
	for x in items {
		if x.Name == it.Name && x.Price == it.Price {
			return true
		}
	}
	false
}

// Names is the names of items, as one text to compare: Ergo has no == on
// slices (M29).
func Names(items []Item) string {
	let mut out = []string{}
	for it in items {
		out = out.Append(it.Name)
	}
	strings.Join(out, ", ")
}

// without is xs without the element at i, in a new slice.
func without[T](xs []T, i int) []T {
	let mut out = []T{}
	for j, x in xs {
		if j != i {
			out = out.Append(x)
		}
	}
	out
}
