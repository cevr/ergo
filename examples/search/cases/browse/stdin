# two keys within the pause: one search of "pe", from 350; a search
# takes 100ms (search.Latency), so the hits show at 450
@0 key p
@100 key e
@1000 pin 2
# hit 9 is not on the screen
@1200 pin 9
@1300 clear
@1400 key a
# "a" is searched from 1650; the key at 1700 comes while that search
# runs, so it stops it and "a" shows nothing; "ap" is searched from 1950
@1700 key p
@2500 pin 1
@2700 open
@3000 end
