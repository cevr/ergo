// Package script plays a script of timed lines against the search, run
// as an actor on a manual clock, and shows what it does, millisecond by
// millisecond.

import actor
import io
import machines
import queue
import search/search
import strconv
import strings
import task
import time

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Script is a read script: the signals at their times, and the time the
// run ends.
type Script { Trace []machines.Timed[search.Signal], End duration }

// Read reads the lines of a script. Each line is `@MS WORD …`: MS is the
// time in milliseconds from the start, never earlier than the line
// before, and WORD is key TEXT, clear, pin N, back or open. The
// line `@MS end` ends the run at MS, and must be the last. A blank line
// or a line that starts with # is skipped.
func Read(lines []string) Script fails BadLine {
	let mut trace = []machines.Timed[search.Signal]{}
	let mut last = 0s
	for i, line in lines {
		let n = i + 1
		let text = strings.TrimSpace(line)
		let words = strings.Fields(text)
		if len(words) == 0 || strings.HasPrefix(text, "#") {
			continue
		}
		if len(words) < 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD"}
		}
		let t = try millis(n, strings.TrimPrefix(words[0], "@"))
		if t < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = t
		if words[1] == "end" {
			return Script{Trace: trace, End: t}
		}
		let s = try signalOf(n, words)
		trace = trace.Append(machines.Timed[search.Signal]{At: t, Signal: s})
	}
	BadLine{Line: len(lines) + 1, Why: "the script has no @MS end line"}
}

func millis(n int, word string) duration fails BadLine {
	let v = try count(n, word)
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "a time is 0 to 86400000 milliseconds"}
	}
	duration(int64(v) * 1000000)
}

func count(n int, word string) int fails BadLine {
	strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
}

func signalOf(n int, words []string) search.Signal fails BadLine {
	let arg = if len(words) > 2 { words[2] } else { "" }
	match words[1] {
	case "key":
		if arg == "" {
			return BadLine{Line: n, Why: "key takes the text it types"}
		}
		search.Key{Text: arg}
	case "clear":
		search.Clear
	case "pin":
		search.Pin{Hit: try count(n, arg)}
	case "back":
		search.Back
	case "open":
		search.Open
	case _:
		BadLine{Line: n, Why: "unknown word \(words[1])"}
	}
}

// Run reads the script from io.Stdin, plays it against the search with an
// no pins (the machine's input) on clock, and shows its timeline. It
// returns the exit status: 0, or 1 when the script is refused.
func Run(clock time.Manual) int needs Console | io.Stdin | Scheduler | search.Index {
	let mut lines = []string{}
	for line in io.Stdin.Lines() {
		lines = lines.Append(line)
	}
	let s = Read(lines) catch {
	case BadLine as b:
		Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	for l in Play(s, clock) {
		Console.Println(l)
	}
	0
}

// Play runs the search as an actor on clock, which only Play moves, and
// is its timeline: each state the actor commits and then each output it
// tells, at the millisecond of the clock. At one instant the timer that is
// due goes first, then the script's signal. The search's work answers at
// the instant it starts: the memory index does not wait.
//
// The actor keeps its own timers on clock, and Advance returns only when
// every task of the clock's domain waits again (time.Advance), so Play
// reads no timer: a watcher task records each state the actor commits at
// the instant it commits it, and the actor's outputs are stamped as it
// tells them. clock must be made by the task that runs Play or an
// ancestor, so the actor and the watcher are in its domain.
func Play(s Script, clock time.Manual) []string needs Scheduler | search.Index {
	let start = clock.Now()
	let since = func() duration { clock.Now().Sub(start) }
	let states = queue.New[Event](64)
	let told = queue.New[Event](64)
	let a = actor.StartMachine(machines.Start(search.Finder{}, []search.Entry{}), 8, func(o search.Output) {
		told.Push(Event{At: since(), Line: "! " + search.Said(o)}) catch {
		case queue.Closed:
		}
	})
	// Changes gives the state when the loop begins first, which line @0
	// shows, then each state the actor commits.
	let watch = task.Go() {
		let mut first = true
		for st in a.Changes() {
			if first {
				first = false
				continue
			}
			states.Push(Event{At: since(), Line: search.Name(st)}) catch {
			case queue.Closed:
			}
		}
	}
	// Settle once, so the watcher's loop has begun before the first signal.
	clock.Advance(0s)
	let mut lines = []string{"@0 \(search.Name(a.State()))"}
	// flush shows what happened since the last flush, instant by instant:
	// at each instant the states, then the outputs.
	let flush = func() {
		for l in merge(drain(states), drain(told)) {
			lines = lines.Append(l)
		}
	}
	let mut over = false
	for t in s.Trace {
		if over {
			break
		}
		if t.At > since() {
			clock.Advance(t.At - since())
		}
		flush()
		let d = a.Ask(t.Signal) catch {
		case search.NoSuchHit as h:
			lines = lines.Append("\(ms(since())) ? no hit \(h.Hit): \(h.Count) shown")
			continue
		case actor.Stopped:
			over = true
			break
		}
		match d {
		case Done[search.Output]:
			over = true
		case _:
		}
		clock.Advance(0s)
		flush()
	}
	if !over && s.End > since() {
		clock.Advance(s.End - since())
	}
	// Only an Ask meets NoSuchHit, and the asker gets it: no failure ends
	// the search.
	a.Stop() catch {
	case search.NoSuchHit:
	}
	watch.Wait()
	flush()
	states.End()
	told.End()
	lines
}

// Event is a line of the timeline at the time it happened.
type Event { At duration, Line string }

// drain takes every event q holds now.
func drain(q queue.Queue[Event]) []Event {
	let mut out = []Event{}
	let mut more = true
	for more {
		match q.Poll() {
		case Some[Event] as e:
			out = out.Append(e.Value)
		case None:
			more = false
		}
	}
	out
}

// merge is the lines of states and outputs in time order, each list in
// its own order, and at one instant the states first.
func merge(states []Event, outputs []Event) []string {
	let mut out = []string{}
	let mut i = 0
	let mut j = 0
	for i < len(states) || j < len(outputs) {
		if j == len(outputs) || i < len(states) && states[i].At <= outputs[j].At {
			out = out.Append("\(ms(states[i].At)) \(states[i].Line)")
			i = i + 1
		} else {
			out = out.Append("\(ms(outputs[j].At)) \(outputs[j].Line)")
			j = j + 1
		}
	}
	out
}

// ms is the word of a time on the clock: @ and its milliseconds.
func ms(d duration) string { "@\(int64(d) / 1000000)" }
