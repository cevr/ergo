// search is search as you type over a catalogue, with a pause before each
// search, last-query-wins, and a cart. It plays a script of timed keys
// against the search, run as an actor on a manual clock, and shows what
// the search does. Package search is the machine; package script reads
// the script and plays it; package memory holds the catalogue. This binary
// is the only place that chooses them: Live binds search.Catalog to
// memory's provider, and main binds the clock and io to the host.

import io
import os
import time
import search/memory
import search/script
import search/search

let Live = context { search.Catalog: memory.Shelf }

func main() fails os.Exit needs Console | Ambient {
	let clock = time.NewManual(0)
	let status = with Live {
		with context { io.Stdin: io.NewStdin(), Scheduler: clock } {
			script.Run(clock)
		}
	}
	if status != 0 {
		return os.Exit{Code: status, Message: "search: the script did not run"}
	}
}
