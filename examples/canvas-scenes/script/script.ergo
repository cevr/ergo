// Package script is the host of stage b: it runs the program as an actor
// on std ui's test host, plays a script of frames and the user's acts on
// the screen, and shows after each what the screen shows: the heading and
// prompt, the buttons and the count, the sliders, and the canvas, read
// from its paint. A frame is the host's: the screen asks for frames while
// its scene runs, and the host sends one each period of the clock it
// moves. A line is one of:
//
//	seed N             the stream's start (the first line only; 1 if none)
//	frame MS [xK]      move the clock K periods (1 if none) of MS milliseconds
//	press X Y          press the canvas at (X, Y) and let go
//	move X Y           move the pointer over the canvas to (X, Y)
//	click NAME         click a button: Balls, Flow, Pause, Play, Clear, Reset
//	strength V         press the Turbulence slider where it reads V
//	scale V            press the Noise scale slider where it reads V
//
// A blank line or one that starts with # is skipped.

import actor
import canvasscenes/app
import canvasscenes/flow
import canvasscenes/screen
import io
import machines
import math
import strconv
import strings
import time
import ui

// Bad is a script line the host cannot read.
type Bad { Why string }

// Site is the running program.
type Site = actor.Actor[app.Program, app.Signal, Decision[app.Program, Never]]

// Host is the program on the test host.
type Host = ui.TestHost[app.Program, app.Signal, Decision[app.Program, Never]]

// Run plays the script on standard input over clock and prints what the
// screen shows; with stats, the work of each line too; with last, only the
// last screen, once the script has run. It returns the
// exit status: 0, or 1 for a line it cannot read or a screen that fails.
func Run(clock time.Manual, stats bool, last bool) int needs Console | io.Stdin | Scheduler {
	let mut lines = []string{}
	for raw in io.Stdin.Lines() {
		lines = lines.Append(raw)
	}
	let mut n = 1
	let mut first = 0
	for i, raw in lines {
		let line = strings.TrimSpace(raw)
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		let words = strings.Fields(line)
		if words[0] == "seed" && len(words) == 2 {
			n = strconv.Atoi(words[1]) catch {
			case strconv.Malformed, strconv.OutOfRange:
				Console.Println("? line \(i + 1): a seed is a whole number")
				return 1
			}
			first = i + 1
		}
		break
	}
	let site = actor.StartMachine(machines.Start(app.Shown{}, uint64(n)), 16, func(o Never) {})
	let status = played(site, lines, first, n, clock, stats, last) catch {
	case actor.Stopped:
		Console.Println("? the program stopped")
		1
	case ui.BadPatch as p:
		Console.Println("? a patch is refused: \(p.Why)")
		1
	}
	site.Stop()
	status
}

func played(site Site, lines []string, first int, n int, clock time.Manual, stats bool, last bool) int fails actor.Stopped | ui.BadPatch needs Console | Scheduler {
	let mut h = try ui.NewTestHost(site, screen.Screen, clock, 16)
	try ui.Settle(&h)
	let mut shown = []string{}
	Console.Println("> seed \(n)")
	if !last {
		shown = show(shown, View(&h))
	}
	for i in first..len(lines) {
		let line = strings.TrimSpace(lines[i])
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		if !last {
			Console.Println("> " + line)
		}
		let acts = actsOf(line) catch {
		case Bad as b:
			Console.Println("? line \(i + 1): \(b.Why)")
			return 1
		}
		let mut missing = ""
		let mut counts = ui.NoCounts()
		let framesBefore = h.Frames()
		for a in acts {
			match a {
			case Every as e:
				ui.FrameEvery(&h, e.Period)
			case Do as d:
				let before = ui.Counts(&h)
				ui.Play(&h, []ui.Act{d.Act, ui.SettleAll}) catch {
				case ui.NoNode as no:
					missing = "no node: \(no.Label)"
				case ui.Ambiguous as m:
					missing = "\(m.Count) nodes: \(m.At)"
				case ui.Mismatch:
					missing = "no match"
				case actor.Stopped as st:
					return st
				case ui.BadPatch as b:
					return b
				}
				// A frame is no input: its passes join the step of the act
				// before it, so the line's share is what it added.
				let after = ui.Counts(&h)
				counts = ui.AddCounts(counts, if input(d.Act) { after } else { less(after, before) })
			}
			if missing != "" {
				break
			}
		}
		if missing != "" {
			Console.Println("  ? " + missing)
		}
		if !last {
			shown = show(shown, View(&h))
		}
		if stats {
			Console.Println("  stats: \(ui.CountsLine(counts)); \(h.Frames() - framesBefore) frames")
		}
	}
	if last {
		let _ = show([]string{}, View(&h))
	}
	Console.Println("> stop")
	0
}

// input is whether a is an input of the test host, which starts a step.
func input(a ui.Act) bool {
	match a {
	case ui.AdvanceBy, ui.SettleAll, ui.ExpectOn:
		false
	case _:
		true
	}
}

// less is a with b's counts taken away: the work of a step after b.
func less(a ui.StepCounts, b ui.StepCounts) ui.StepCounts {
	ui.StepCounts{Inserted: a.Inserted - b.Inserted, Moved: a.Moved - b.Moved, Removed: a.Removed - b.Removed, Set: a.Set - b.Set, Ran: a.Ran - b.Ran, Kept: a.Kept - b.Kept, GroupsRan: a.GroupsRan - b.GroupsRan, GroupsKept: a.GroupsKept - b.GroupsKept, Visits: a.Visits - b.Visits}
}

// Receipt is the receipt's script (plan §18.3 FK12: a frame at 600 paths):
// the flow, 25 bursts of 22 over a 5 by 5 grid on its 55 particles, 40
// frames so the trails reach their length, then n frames of 16 ms, each
// one frame of about 600 trails.
func Receipt(n int) []string {
	let mut out = []string{"seed 1", "click Flow", "frame 16 x10"}
	for i in 0..25 {
		out = out.Append("press \(80 + (i%5)*200) \(80 + (i/5)*110)")
	}
	out = out.Append("frame 16 x40")
	for _ in 0..n {
		out = out.Append("frame 16")
	}
	out
}

// Step is one step of a line: a frame period for the host's clock, or an
// act on the screen.
type Step = Every{Period duration} | Do{Act ui.Act}

func amount(word string, what string) float64 fails Bad {
	strconv.ParseFloat(word) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return Bad{Why: "\(what) is a number, not \(word)"}
	}
}

func count(word string) int fails Bad {
	if !strings.HasPrefix(word, "x") {
		return Bad{Why: "a repeat is xK"}
	}
	let k = strconv.Atoi(strings.TrimPrefix(word, "x")) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return Bad{Why: "a repeat is xK"}
	}
	if k < 1 || k > 10000 {
		return Bad{Why: "a repeat is 1 to 10000"}
	}
	k
}

// ms is a duration of v milliseconds, to the nanosecond.
func ms(v float64) duration { duration(int64(math.Round(v * 1000000.0))) }

// frames is K frame periods of MS milliseconds: the host's period, then
// the clock moved by K of them.
func frames(period float64, k int) []Step fails Bad {
	if period < 1.0 || period > 10000.0 {
		return Bad{Why: "a frame is 1 to 10000 ms"}
	}
	[]Step{Every{Period: ms(period)}, Do{Act: ui.AdvanceBy{By: ms(period * float64(k))}}}
}

// pointer is a pointer event of phase at (x, y), over no zone.
func pointer(phase ui.Phase, x float64, y float64) ui.PointerEvent {
	ui.PointerEvent{Pointer: ui.MousePointer, Phase: phase, X: x, Y: y, Zone: None}
}

// pressAt presses the Area label at (x, y) and lets go there.
func pressAt(label string, x float64, y float64) []Step {
	[]Step{Do{Act: ui.PointOn{Label: label, Pointer: pointer(ui.Down, x, y)}}, Do{Act: ui.PointOn{Label: label, Pointer: pointer(ui.Up, x, y)}}}
}

// along is where on a slider's track of range lo to hi it reads v.
func along(v float64, lo float64, hi float64) float64 { (v - lo) / (hi - lo) * screen.SliderWidth }

// actsOf is a line's steps.
func actsOf(line string) []Step fails Bad {
	let words = strings.Fields(line)
	let want = func(k int) bool { len(words) == k }
	match words[0] {
	case "frame":
		if want(2) {
			return try frames(try amount(words[1], "a frame"), 1)
		}
		if want(3) {
			return try frames(try amount(words[1], "a frame"), try count(words[2]))
		}
		Bad{Why: "frame MS [xK]"}
	case "press", "move":
		if !want(3) {
			return Bad{Why: "\(words[0]) X Y"}
		}
		let x = try amount(words[1], "X")
		let y = try amount(words[2], "Y")
		if words[0] == "press" {
			return pressAt("Canvas", x, y)
		}
		[]Step{Do{Act: ui.PointOn{Label: "Canvas", Pointer: pointer(ui.Moved, x, y)}}}
	case "click":
		if !want(2) {
			return Bad{Why: "click NAME"}
		}
		[]Step{Do{Act: ui.ClickOn{At: ui.WithRole{Role: ui.Button, Name: words[1]}}}}
	case "strength":
		if !want(2) {
			return Bad{Why: "strength V"}
		}
		pressAt("Turbulence", along(try amount(words[1], "a strength"), flow.StrengthMin, flow.StrengthMax), 4.0)
	case "scale":
		if !want(2) {
			return Bad{Why: "scale V"}
		}
		pressAt("Noise scale", along(try amount(words[1], "a scale"), flow.ScaleMin, flow.ScaleMax), 4.0)
	case "seed":
		Bad{Why: "seed is the first line only"}
	case _:
		Bad{Why: "unknown word \(words[0])"}
	}
}

// show prints the lines of now whose part (the words before the first
// ": ") was absent from shown or read otherwise, and names the parts of
// shown that are gone; it is now.
func show(shown []string, now []string) []string needs Console {
	for l in now {
		let mut same = false
		for s in shown {
			if s == l {
				same = true
			}
		}
		if !same {
			Console.Println("  " + l)
		}
	}
	for s in shown {
		let part = partOf(s)
		let mut kept = false
		for l in now {
			if partOf(l) == part {
				kept = true
			}
		}
		if !kept {
			Console.Println("  \(part): gone")
		}
	}
	now
}

func partOf(l string) string {
	let i = strings.Index(l, ": ")
	if i < 0 { l } else { l[0:i] }
}

// whole is v to the nearest whole number. Positions are shown whole, so
// that the last bits of a float, which a fused multiply-add may change on
// another host, rarely show.
func whole(v float64) string { strconv.Itoa(int(math.Round(v))) }

// seen is what the screen shows, read part by part.
type seen { Page []string, Buttons []string, Texts []string, Sliders []string, Paint []ui.PaintOp, Size string, Frames bool }

// View is the screen as lines, one per part: the page's headings and
// prompt, the buttons and the count, the sliders and their values, and
// the canvas, read from its paint (Canvas).
func View(h mut Host) []string {
	let mut s = seen{Page: []string{}, Buttons: []string{}, Texts: []string{}, Sliders: []string{}, Paint: []ui.PaintOp{}, Size: "", Frames: ui.WantsFrames(h)}
	for x in ui.Screen(h) {
		s = walk(x, s, false)
	}
	let mut out = []string{"page: " + strings.Join(s.Page, " | "), "controls: " + strings.Join(s.Buttons, ", ") + "; " + strings.Join(s.Texts, ", ")}
	if len(s.Sliders) > 0 {
		out = out.Append("sliders: " + strings.Join(s.Sliders, ", "))
	}
	out = out.Append("frames: " + if s.Frames { "wanted" } else { "none" })
	for l in Canvas(s.Size, s.Paint) {
		out = out.Append(l)
	}
	out
}

func walk(x ui.Shape[app.Signal], s seen, inButton bool) seen {
	match x.Node {
	case ui.TextNode as t:
		if inButton || t.Value == "" {
			return s
		}
		if strings.HasSuffix(t.Value, " balls") || strings.HasSuffix(t.Value, " particles") {
			return seen{..s, Texts: s.Texts.Append(t.Value)}
		}
		seen{..s, Page: s.Page.Append(t.Value)}
	case ui.SemanticNode as g:
		let a = g.Access
		if a.Role == ui.Heading {
			return seen{..s, Page: s.Page.Append("# " + a.Name)}
		}
		if a.Role == ui.Button {
			return seen{..s, Buttons: s.Buttons.Append("[\(a.Name)]")}
		}
		kids(x, s, inButton)
	case ui.AreaNode as ar:
		if ar.Label == "Canvas" {
			return kids(x, s, inButton)
		}
		let mut value = ""
		for k in x.Kids {
			match k.Node {
			case ui.TextNode as t:
				value = t.Value
			case _:
			}
		}
		seen{..s, Sliders: s.Sliders.Append("\(ar.Label) \(value)")}
	case ui.CanvasNode as c:
		seen{..s, Paint: c.Paint, Size: "\(whole(float64(c.Width)))x\(whole(float64(c.Height)))"}
	case _:
		kids(x, s, inButton)
	}
}

func kids(x ui.Shape[app.Signal], s seen, inButton bool) seen {
	let mut out = s
	for k in x.Kids {
		out = walk(k, out, inButton)
	}
	out
}

// box is a path's bounding box over its points (a cubic's control points
// included, which for a circle drawn as four cubics is the circle's box).
type box { X0 float64, Y0 float64, X1 float64, Y1 float64, Points int }

func boxOf(p ui.Path) box {
	let mut b = box{X0: 1e18, Y0: 1e18, X1: -1e18, Y1: -1e18, Points: 0}
	for seg in p.Segs {
		match seg {
		case ui.MoveTo as m:
			b = grow(b, m.X, m.Y)
		case ui.LineTo as l:
			b = grow(b, l.X, l.Y)
		case ui.QuadTo as q:
			b = grow(grow(b, q.CX, q.CY), q.X, q.Y)
		case ui.CubicTo as c:
			b = grow(grow(grow(b, c.C1X, c.C1Y), c.C2X, c.C2Y), c.X, c.Y)
		case ui.ClosePath:
		}
	}
	b
}

func grow(b box, x float64, y float64) box {
	box{X0: lesser(b.X0, x), Y0: lesser(b.Y0, y), X1: greater(b.X1, x), Y1: greater(b.Y1, y), Points: b.Points + 1}
}

func lesser(a float64, b float64) float64 { if a < b { a } else { b } }

func greater(a float64, b float64) float64 { if a > b { a } else { b } }

// colour is c as "#rrggbb", with "/A" for an alpha under 255.
func colour(c ui.Color) string {
	let hex = "0123456789abcdef"
	let mut out = "#"
	for v in []int{int(c.R), int(c.G), int(c.B)} {
		out = out + hex[v/16:v/16+1] + hex[v%16:v%16+1]
	}
	if int(c.A) == 255 { out } else { out + "/\(int(c.A))" }
}

// Canvas is the canvas as lines, read from its paint: its size and what
// it paints (fills, strokes and the points of their paths), then, for
// each filled circle under 30 pixels (a ball, or a particle's head), its
// centre, radius and colour for a few, and the centre of them all.
func Canvas(size string, ops []ui.PaintOp) []string {
	if size == "" {
		return []string{"canvas: none"}
	}
	let mut fills = 0
	let mut strokes = 0
	let mut points = 0
	let mut dots = []string{}
	let mut ndots = 0
	let mut sx = 0.0
	let mut sy = 0.0
	let mut ring = "none"
	for op in ops {
		match op {
		case ui.FillOp as f:
			fills = fills + 1
			let b = boxOf(f.Path)
			points = points + b.Points
			let r = (b.X1 - b.X0) / 2.0
			let cx = (b.X0 + b.X1) / 2.0
			let cy = (b.Y0 + b.Y1) / 2.0
			if len(f.Path.Segs) == 6 && r < 30.0 {
				ndots = ndots + 1
				sx = sx + cx
				sy = sy + cy
				if ndots <= 6 {
					dots = dots.Append("dot \(ndots): at (\(whole(cx)), \(whole(cy))), radius \(whole(r)), \(colour(f.Color))")
				}
			} else if len(f.Path.Segs) == 6 && whole(r) == "130" {
				ring = "(\(whole(cx)), \(whole(cy)))"
			}
		case ui.StrokeOp as st:
			strokes = strokes + 1
			points = points + boxOf(st.Path).Points
		case ui.PushTransform, ui.PushClip, ui.PopPaint:
		}
	}
	let middle = if ndots == 0 { "none" } else { "(\(whole(sx / float64(ndots))), \(whole(sy / float64(ndots))))" }
	let mut out = []string{"canvas: \(size), \(fills) fills, \(strokes) strokes, \(points) points", "dots: \(ndots), centred at \(middle), pointer ring \(ring)"}
	for d in dots {
		out = out.Append(d)
	}
	out
}
