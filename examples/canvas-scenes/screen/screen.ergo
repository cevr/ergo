// Package screen is the program on a screen (stage b), in two
// views: a switch between the scenes, then the balls (canvas-art) or the
// flow (generative-art). Each has its heading, its canvas in an Area that
// takes the pointer, its buttons and its count; the flow has its two
// sliders, each an Area its pointer sets. A canvas paints the scene's
// shapes in order. While the scene runs, the
// screen asks for frames (ui.Animate), and each frame is the program's
// Framed.

import canvasscenes/app
import canvasscenes/balls
import canvasscenes/flow
import canvasscenes/scene
import color
import math
import option
import ui

// SliderWidth is the width of a slider's track, in pixels: a press or a
// drag at x on it sets the value at x / SliderWidth of its range.
let SliderWidth = 200.0

// Screen is the page for p.
func Screen(f mut ui.Frame[app.Signal], p app.Program) {
	if app.Running(p.Scene) {
		ui.Animate(f, func(at duration) app.Signal { app.Framed{At: float64(int64(at)) / 1000000.0} })
	}
	ui.Column(f, ui.Plain()) {
		ui.Semantic(f, named(ui.Group, "Scenes"), option.None, ui.Plain()) {
			button(f, "Balls", scene.ShowBalls)
			button(f, "Flow", scene.ShowFlow)
		}
		match p.Scene {
		case scene.Balls as b:
			ballsView(f, b)
		case scene.Flow as fl:
			flowView(f, fl.Field)
		}
	}
}

func ballsView(f mut ui.Frame[app.Signal], b scene.Balls) {
	heading(f, "Canvas Art")
	ui.Text(f, "Click the canvas to spawn a ball.")
	ui.Area(f, "Canvas", ui.Plain(), func(e ui.PointerEvent) option.Option[app.Signal] {
		match e.Phase {
		case ui.Down:
			option.Some[app.Signal]{Value: app.On{Signal: scene.Pressed{X: e.X, Y: e.Y}}}
		case ui.Moved, ui.Drag, ui.Up, ui.Wheel, ui.PointerEnter, ui.PointerLeave:
			option.None
		}
	}) {
		ui.Canvas(f, "Canvas", ui.Length(balls.Width), ui.Length(balls.Height)) func(pt mut ui.Paint) {
			ui.Fill(pt, ui.RectPath(0.0, 0.0, balls.Width, balls.Height), hex("#0a0a0f"))
			for x in b.Field.Balls {
				ui.Fill(pt, Circle(x.X, x.Y, x.Radius), hex(x.Color))
			}
		}
	}
	ui.Row(f, ui.Plain()) {
		button(f, if b.Running { "Pause" } else { "Play" }, scene.Toggled)
		button(f, "Clear", scene.Cleared)
		ui.Text(f, "\(b.Field.Balls.Len()) balls")
	}
}

func flowView(f mut ui.Frame[app.Signal], fl flow.Field) {
	heading(f, "Prism Field")
	ui.Text(f, "Move to stir. Click to bloom.")
	ui.Area(f, "Canvas", ui.Plain(), func(e ui.PointerEvent) option.Option[app.Signal] {
		match e.Phase {
		case ui.Down:
			option.Some[app.Signal]{Value: app.On{Signal: scene.Pressed{X: e.X, Y: e.Y}}}
		case ui.Moved, ui.Drag:
			option.Some[app.Signal]{Value: app.On{Signal: scene.Moved{X: e.X, Y: e.Y}}}
		case ui.Up, ui.Wheel, ui.PointerEnter, ui.PointerLeave:
			option.None
		}
	}) {
		ui.Canvas(f, "Canvas", ui.Length(flow.Width), ui.Length(flow.Height)) func(pt mut ui.Paint) {
			paintFlow(pt, fl)
		}
	}
	ui.Row(f, ui.Plain()) {
		button(f, if fl.Running { "Pause" } else { "Play" }, scene.Toggled)
		button(f, "Reset", scene.Cleared)
		ui.Text(f, "\(fl.Particles.Len()) particles")
	}
	slider(f, "Turbulence", fl.Strength, flow.StrengthMin, flow.StrengthMax, func(v float64) scene.Signal { scene.SetStrength{Value: v} })
	slider(f, "Noise scale", fl.Scale, flow.ScaleMin, flow.ScaleMax, func(v float64) scene.Signal { scene.SetScale{Value: v} })
}

// slider is a labelled track that shows its value: an Area named label,
// whose press at x asks for the value at x of the range (the scene keeps
// it in range and on its step). A move is no press: the Area cannot tell
// a drag from a hover, so only a press sets the value (gap FK12-g1).
func slider(f mut ui.Frame[app.Signal], label string, value float64, lo float64, hi float64, set own func(v float64) scene.Signal) {
	ui.Area(f, label, ui.Plain(), func(e ui.PointerEvent) option.Option[app.Signal] {
		match e.Phase {
		case ui.Down:
			option.Some[app.Signal]{Value: app.On{Signal: set(lo + (hi-lo)*e.X/SliderWidth)}}
		case ui.Moved, ui.Drag, ui.Up, ui.Wheel, ui.PointerEnter, ui.PointerLeave:
			option.None
		}
	}) {
		ui.Text(f, Fixed2(value))
	}
}

// Fixed2 is v with two decimals, as toFixed(2).
func Fixed2(v float64) string {
	let n = int(math.Round(v * 100.0))
	let sign = if n < 0 { "-" } else { "" }
	let a = if n < 0 { -n } else { n }
	let cents = a % 100
	"\(sign)\(a / 100).\(if cents < 10 { "0" } else { "" })\(cents)"
}

// The flow's paint.
let glowWidth = 5.0
let coreWidth = 1.4
let headRadius = 2.4
let pointerRadius = 130.0
let fadeInMs = 350.0
let fadeOutMs = 900.0
let twoPi = 6.283185307179586

// paintFlow paints the flow: the background, the
// three nebula glows, each particle's trail (a glow and a core stroke),
// each particle's head, the vignette's strips, and the pointer's ring.
func paintFlow(pt mut ui.Paint, fl flow.Field) {
	ui.Fill(pt, ui.RectPath(0.0, 0.0, flow.Width, flow.Height), hex("#04030a"))
	let speeds = []float64{0.11, 0.07, 0.13}
	let offX = []float64{0.3, 0.72, 0.52}
	let offY = []float64{0.4, 0.62, 0.28}
	let ampX = []float64{80.0, 100.0, 60.0}
	let ampY = []float64{50.0, 60.0, 80.0}
	let glows = []ui.Color{rgba(120, 35, 200, 0.18), rgba(28, 90, 200, 0.16), rgba(220, 30, 140, 0.13)}
	for i in 0..3 {
		let phase = float64(i) / 3.0 * twoPi
		let x = flow.Width*offX[i] + math.Sin(fl.Elapsed*speeds[i]+phase)*ampX[i]
		let y = flow.Height*offY[i] + math.Cos(fl.Elapsed*speeds[i]+phase)*ampY[i]
		ui.Fill(pt, Circle(x, y, 280.0), glows[i])
	}
	for p in fl.Particles {
		if p.Trail.Len() < 2 {
			continue
		}
		let fade = Fade(p)
		if fade < 0.01 {
			continue
		}
		let path = trail(p.Trail)
		let hue = Hue(p, fl.Elapsed)
		ui.Stroke(pt, path, hsla(hue, 90.0, 60.0, 0.18*fade), glowWidth)
		ui.Stroke(pt, path, hsla(hue, 90.0, 78.0, 0.85*fade), coreWidth)
	}
	for p in fl.Particles {
		if p.Trail.Len() == 0 {
			continue
		}
		let head = p.Trail[p.Trail.Len()-1]
		ui.Fill(pt, Circle(head.X, head.Y, headRadius), hsla(Hue(p, fl.Elapsed), 90.0, 92.0, 0.95*Fade(p)))
	}
	let strip = rgba(2, 1, 8, 0.55/4.0)
	for step in 0..4 {
		let w = 80.0 * (1.0 - float64(step)/4.0)
		if w <= 1.0 {
			continue
		}
		ui.Fill(pt, ui.RectPath(0.0, 0.0, flow.Width, w), strip)
		ui.Fill(pt, ui.RectPath(0.0, flow.Height-w, flow.Width, w), strip)
		ui.Fill(pt, ui.RectPath(0.0, 0.0, w, flow.Height), strip)
		ui.Fill(pt, ui.RectPath(flow.Width-w, 0.0, w, flow.Height), strip)
	}
	match fl.Pointer {
	case option.Some[flow.Point] as at:
		ui.Fill(pt, Circle(at.Value.X, at.Value.Y, pointerRadius), rgba(255, 255, 255, 0.04))
	case option.None:
	}
}

// Fade is a particle's opacity: it fades in over its first 350 ms and out
// over its last 900.
func Fade(p flow.Particle) float64 {
	let fadeIn = minimum(1.0, p.AgeMs/fadeInMs)
	let fadeOut = minimum(1.0, (p.LifespanMs-p.AgeMs)/fadeOutMs)
	let v = minimum(fadeIn, fadeOut)
	if v < 0.0 { 0.0 } else { v }
}

// Hue is a particle's hue at elapsed seconds, drifting from its base.
func Hue(p flow.Particle, elapsed float64) float64 {
	let raw = p.BaseHue + p.HueDrift*(elapsed-p.BornAt)
	let m = raw - 360.0*math.Floor(raw/360.0)
	m
}

func minimum(a float64, b float64) float64 { if a < b { a } else { b } }

func trail(points []flow.Point) ui.Path {
	let mut segs = []ui.Seg{ui.MoveTo{X: points[0].X, Y: points[0].Y}}
	for i in 1..points.Len() {
		segs = segs.Append(ui.LineTo{X: points[i].X, Y: points[i].Y})
	}
	ui.Path{Segs: segs}
}

// kappa places a cubic's control points on a quarter circle.
let kappa = 0.5522847498307936

// Circle is the path of a circle of radius r at (x, y): four cubics.
func Circle(x float64, y float64, r float64) ui.Path {
	let k = kappa * r
	ui.Path{Segs: []ui.Seg{
		ui.MoveTo{X: x + r, Y: y},
		ui.CubicTo{C1X: x + r, C1Y: y + k, C2X: x + k, C2Y: y + r, X: x, Y: y + r},
		ui.CubicTo{C1X: x - k, C1Y: y + r, C2X: x - r, C2Y: y + k, X: x - r, Y: y},
		ui.CubicTo{C1X: x - r, C1Y: y - k, C2X: x - k, C2Y: y - r, X: x, Y: y - r},
		ui.CubicTo{C1X: x + k, C1Y: y - r, C2X: x + r, C2Y: y - k, X: x + r, Y: y},
		ui.ClosePath,
	}}
}

func rgba(r int, g int, b int, a float64) ui.Color {
	ui.Color{R: uint8(r), G: uint8(g), B: uint8(b), A: alpha(a)}
}

func alpha(a float64) uint8 {
	let v = math.Round(a * 255.0)
	if v < 0.0 { uint8(0) } else if v > 255.0 { uint8(255) } else { uint8(int(v)) }
}

// hex is the colour of "#rrggbb", opaque.
func hex(s string) ui.Color {
	color.Parse(s) catch {
	case color.InvalidColor:
		color.Transparent
	}
}

// hsla is the colour of hue h (degrees), saturation s and lightness l
// (percent) and alpha a, as CSS's hsla.
func hsla(h float64, s float64, l float64, a float64) ui.Color {
	color.FromHSL(color.HSL{H: h, S: s / 100.0, L: l / 100.0, Alpha: a})
}

func button(f mut ui.Frame[app.Signal], label string, sig scene.Signal) {
	ui.Semantic(f, named(ui.Button, label), option.Some[app.Signal]{Value: app.On{Signal: sig}}, ui.Plain()) {
		ui.Text(f, label)
	}
}

func heading(f mut ui.Frame[app.Signal], text string) {
	ui.Semantic(f, ui.Access{..named(ui.Heading, text), Level: option.Some[int]{Value: 1}}, option.None, ui.Plain()) {
		ui.Text(f, text)
	}
}

// named is the access of a node with a role and a name.
func named(role ui.Role, name string) ui.Access {
	ui.Access{Role: role, Name: name, Disabled: false, Description: "", Checked: option.None, Value: option.None, Selected: option.None, Expanded: option.None, Pressed: option.None, Invalid: false, Busy: false, HasPopup: false, Level: option.None, Mixed: false, Current: option.None, Modal: false, MultiSelectable: false, Range: option.None, Key: ui.NoKey, Rels: []ui.Rel{}}
}
