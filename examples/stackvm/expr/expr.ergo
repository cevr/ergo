// Package expr is a small language of integer expressions with two ways
// to run it: Eval walks the tree, and Compile makes a vm program. The
// tree walk is the reference: the law CompiledAgrees holds the compiler
// and the vm to it.

import stackvm/vm

// Expr is an integer expression.
type Expr =
	| Lit{N int}
	| Neg{X Expr}
	| Bin{Op Op, L Expr, R Expr}
	| IfZero{Cond Expr, Then Expr, Else Expr}
	| Square{X Expr}

// CompiledAgrees: a compiled expression computes what the tree walk
// computes, and fails where it fails.
law CompiledAgrees(seed int) { Agrees(of(seed)) }

// gen is an expression of at most depth levels, drawn from d. Literals
// are small, so a Quot or Rem by zero happens often.
func gen(d mut vm.Draws, depth int) Expr {
	let k = if depth <= 0 { 0 } else { d.Next(8) }
	match k {
	case 0, 1:
		Lit{N: d.Next(9) - 3}
	case 2:
		Neg{X: gen(d, depth-1)}
	case 3:
		IfZero{Cond: gen(d, depth-1), Then: gen(d, depth-1), Else: gen(d, depth-1)}
	case 4:
		Square{X: gen(d, depth-1)}
	case _:
		let ops = []Op{Plus, Minus, Times, Quot, Rem, Below, Equal}
		Bin{Op: ops[d.Next(len(ops))], L: gen(d, depth-1), R: gen(d, depth-1)}
	}
}

// of is an expression drawn from seed, at most 5 levels deep.
func of(seed int) Expr {
	let mut d = vm.Seed(seed)
	gen(&d, 5)
}

// Agrees reports whether running the compiled e gives what Eval gives:
// the stack holds exactly its value, or both divide by zero.
func Agrees(e Expr) bool {
	let want = Eval(e) catch {
	case DivideByZero:
		let _ = vm.Run(Compile(e), 100000) catch {
		case vm.Trap as t:
			return t.Why == vm.DivideByZero
		}
		return false
	}
	let got = vm.Run(Compile(e), 100000) catch {
	case vm.Trap:
		return false
	}
	got.Stack == []int{want} && len(got.Printed) == 0
}

// Op is a binary operator. Less and Equal give 1 or 0.
type Op = Plus{} | Minus{} | Times{} | Quot{} | Rem{} | Below{} | Equal{}

// DivideByZero is a Quot or Rem whose right side is zero.
type DivideByZero {}

// Eval is the value of e, by walking the tree.
func Eval(e Expr) int fails DivideByZero {
	match e {
	case Lit as l:
		l.N
	case Neg as n:
		0 - try Eval(n.X)
	case Bin as b:
		let l = try Eval(b.L)
		let r = try Eval(b.R)
		match b.Op {
		case Plus:
			l + r
		case Minus:
			l - r
		case Times:
			l * r
		case Quot:
			if r == 0 {
				return DivideByZero
			}
			l / r
		case Rem:
			if r == 0 {
				return DivideByZero
			}
			l % r
		case Below:
			if l < r { 1 } else { 0 }
		case Equal:
			if l == r { 1 } else { 0 }
		}
	case IfZero as i:
		if try Eval(i.Cond) == 0 {
			try Eval(i.Then)
		} else {
			try Eval(i.Else)
		}
	case Square as s:
		let x = try Eval(s.X)
		x * x
	}
}

// builder is a program being compiled.
type builder { code []vm.Instr }

// Compile is a vm program that leaves the value of e on the stack and
// halts. A Square calls a subroutine after the Halt.
func Compile(e Expr) []vm.Instr {
	let mut b = builder{code: []vm.Instr{}}
	emit(&b, e)
	b.code = b.code.Append(vm.Halt)
	let square = len(b.code)
	b.code = b.code.Append(vm.Dup)
	b.code = b.code.Append(vm.Mul)
	b.code = b.code.Append(vm.Ret)
	for n, i in b.code {
		match i {
		case vm.Call:
			b.code[n] = vm.Call{To: square}
		case vm.Push, vm.Pop, vm.Dup, vm.Swap, vm.Over, vm.Add, vm.Sub, vm.Mul, vm.Div, vm.Mod, vm.Less, vm.Same, vm.Not, vm.Jump, vm.JumpIf, vm.JumpIfNot, vm.Ret, vm.Print, vm.Halt:
		}
	}
	b.code
}

// emit adds the code of e to b. A Call's target is set by Compile.
func emit(b mut builder, e Expr) {
	match e {
	case Lit as l:
		b.code = b.code.Append(vm.Push{N: l.N})
	case Neg as n:
		b.code = b.code.Append(vm.Push{N: 0})
		emit(b, n.X)
		b.code = b.code.Append(vm.Sub)
	case Bin as o:
		emit(b, o.L)
		emit(b, o.R)
		b.code = b.code.Append(match o.Op {
		case Plus:
			vm.Add
		case Minus:
			vm.Sub
		case Times:
			vm.Mul
		case Quot:
			vm.Div
		case Rem:
			vm.Mod
		case Below:
			vm.Less
		case Equal:
			vm.Same
		})
	case IfZero as i:
		emit(b, i.Cond)
		let toElse = len(b.code)
		b.code = b.code.Append(vm.JumpIf{To: 0})
		emit(b, i.Then)
		let toEnd = len(b.code)
		b.code = b.code.Append(vm.Jump{To: 0})
		b.code[toElse] = vm.JumpIf{To: len(b.code)}
		emit(b, i.Else)
		b.code[toEnd] = vm.Jump{To: len(b.code)}
	case Square as s:
		emit(b, s.X)
		b.code = b.code.Append(vm.Call{To: 0})
	}
}
