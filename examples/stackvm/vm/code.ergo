// Bytecode: a program as a flat list of ints, one opcode per instruction,
// followed by its operand when it has one. An operand is an int (Push's
// value, or a target index), so a program is a []int, not a []byte.

// BadCode is a bytecode that does not decode: an unknown opcode at At,
// or an opcode at At whose operand is missing.
type BadCode { At int, Code int, Reason string }

// Opcode is the number of i's kind.
func Opcode(i Instr) int {
	match i {
	case Push:
		1
	case Pop:
		2
	case Dup:
		3
	case Swap:
		4
	case Over:
		5
	case Add:
		6
	case Sub:
		7
	case Mul:
		8
	case Div:
		9
	case Mod:
		10
	case Less:
		11
	case Same:
		12
	case Not:
		13
	case Jump:
		14
	case JumpIf:
		15
	case JumpIfNot:
		16
	case Call:
		17
	case Ret:
		18
	case Print:
		19
	case Halt:
		20
	}
}

// Encode is the bytecode of program.
func Encode(program []Instr) []int {
	let mut out = []int{}
	for i in program {
		out = out.Append(Opcode(i))
		match i {
		case Push as p:
			out = out.Append(p.N)
		case Jump, JumpIf, JumpIfNot, Call:
			match Target(i) {
			case Some[int] as t:
				out = out.Append(t.Value)
			case None:
			}
		case Pop, Dup, Swap, Over, Add, Sub, Mul, Div, Mod, Less, Same, Not, Ret, Print, Halt:
		}
	}
	out
}

// Decode is the program of code.
func Decode(code []int) []Instr fails BadCode {
	let mut program = []Instr{}
	let mut at = 0
	for at < len(code) {
		let op = code[at]
		let plain = []Instr{Pop, Dup, Swap, Over, Add, Sub, Mul, Div, Mod, Less, Same, Not}
		if op >= 2 && op <= 13 {
			program = program.Append(plain[op-2])
			at += 1
			continue
		}
		match op {
		case 18:
			program = program.Append(Ret)
		case 19:
			program = program.Append(Print)
		case 20:
			program = program.Append(Halt)
		case 1, 14, 15, 16, 17:
			if at+1 >= len(code) {
				return BadCode{At: at, Code: op, Reason: "its operand is missing"}
			}
			let n = code[at+1]
			program = program.Append(match op {
			case 1:
				Push{N: n}
			case 14:
				Jump{To: n}
			case 15:
				JumpIf{To: n}
			case 16:
				JumpIfNot{To: n}
			case _:
				Call{To: n}
			})
			at += 1
		case _:
			return BadCode{At: at, Code: op, Reason: "no instruction has this opcode"}
		}
		at += 1
	}
	program
}

// DecodeInvertsEncode: the bytecode of a program decodes to it.
law DecodeInvertsEncode(seed int, size int) {
	let p = Program(seed, size%40)
	let back = Decode(Encode(p)) catch {
	case BadCode:
		return false
	}
	back == p
}

// Draws is a seeded stream of numbers, for generators.
type Draws { x int }

// Seed is the stream of seed.
func Seed(seed int) Draws { Draws{x: (if seed < 0 { -(seed + 1) } else { seed }) % 2147483648} }

// Next is a draw in 0 to n-1.
func Next(d mut Draws, n int) int {
	d.x = (d.x*1103515245 + 12345) % 2147483648
	(d.x / 65536) % n
}

// Program is size instructions drawn from seed: every kind, with small
// values and targets that are mostly inside the program, sometimes its
// end and sometimes outside it.
func Program(seed int, size int) []Instr {
	let mut d = Seed(seed)
	let mut out = []Instr{}
	for _ in 0..size {
		let to = d.Next(size+3) - 1
		let kinds = []Instr{Pop, Dup, Swap, Over, Add, Sub, Mul, Div, Mod, Less, Same, Not, Ret, Print, Halt}
		let k = d.Next(20)
		out = out.Append(match k {
		case 0:
			Push{N: d.Next(21) - 10}
		case 1:
			Jump{To: to}
		case 2:
			JumpIf{To: to}
		case 3:
			JumpIfNot{To: to}
		case 4:
			Call{To: to}
		case _:
			kinds[k-5]
		})
	}
	out
}
