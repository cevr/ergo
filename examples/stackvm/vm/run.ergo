// The dispatch loop.

import option

// Trap is a run that stopped at the instruction PC for the reason Why.
// One failure type with a union inside carries the PC once, and a match
// on Why is exhaustive.
type Trap { PC int, Why Cause }

// Cause is why a run trapped.
type Cause =
	| Underflow{}
	| DivideByZero{}
	| BadTarget{To int}
	| NoFrame{}
	| TooDeep{}
	| OutOfFuel{}

// Result is a run that halted: what it printed, the stack it left, top
// last, and the instructions it ran.
type Result { Printed []int, Stack []int, Steps int }

// MaxFrames is the deepest a run may call.
let MaxFrames = 10000

// Run runs program from instruction 0 until Halt or the end of the
// program, for at most fuel instructions. It verifies program once: a
// program that Verify accepts runs on Exec's loop, any other on Checked's
// (verify.ergo).
func Run(program []Instr, fuel int) Result fails Trap {
	match Verify(program) {
	case option.Some[Verified] as v:
		try Exec(v.Value, fuel)
	case option.None:
		try Checked(program, fuel)
	}
}

// Checked is Run with every check on every instruction: the loop for a
// program that Verify refuses, and the reference that Exec agrees with.
func Checked(program []Instr, fuel int) Result fails Trap {
	try resume(program, fuel, paused{stack: []int{}, frames: []int{}, printed: []int{}, pc: 0, steps: 0})
}

// paused is a run stopped before instruction pc: the stack, top last,
// the return points of the open calls, innermost last, what it printed
// and the instructions it ran.
type paused { stack []int, frames []int, printed []int, pc int, steps int }

// resume runs program on the checked loop from where.
func resume(program []Instr, fuel int, where paused) Result fails Trap {
	let mut stack = where.stack
	let mut sp = stack.Len()
	let mut frames = where.frames
	let mut fp = frames.Len()
	let mut printed = where.printed
	let mut pc = where.pc
	let mut steps = where.steps
	for pc < program.Len() {
		if steps == fuel {
			return Trap{PC: pc, Why: OutOfFuel}
		}
		steps += 1
		let at = pc
		pc += 1
		match program[at] {
		case Push as p:
			if sp == stack.Len() {
				stack = stack.Append(p.N)
			} else {
				stack[sp] = p.N
			}
			sp += 1
		case Pop:
			if sp < 1 {
				return Trap{PC: at, Why: Underflow}
			}
			sp -= 1
		case Dup:
			if sp < 1 {
				return Trap{PC: at, Why: Underflow}
			}
			if sp == stack.Len() {
				stack = stack.Append(stack[sp-1])
			} else {
				stack[sp] = stack[sp-1]
			}
			sp += 1
		case Swap:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			let top = stack[sp-1]
			stack[sp-1] = stack[sp-2]
			stack[sp-2] = top
		case Over:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			if sp == stack.Len() {
				stack = stack.Append(stack[sp-2])
			} else {
				stack[sp] = stack[sp-2]
			}
			sp += 1
		case Add:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			stack[sp-2] = stack[sp-2] + stack[sp-1]
			sp -= 1
		case Sub:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			stack[sp-2] = stack[sp-2] - stack[sp-1]
			sp -= 1
		case Mul:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			stack[sp-2] = stack[sp-2] * stack[sp-1]
			sp -= 1
		case Div:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			if stack[sp-1] == 0 {
				return Trap{PC: at, Why: DivideByZero}
			}
			stack[sp-2] = stack[sp-2] / stack[sp-1]
			sp -= 1
		case Mod:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			if stack[sp-1] == 0 {
				return Trap{PC: at, Why: DivideByZero}
			}
			stack[sp-2] = stack[sp-2] % stack[sp-1]
			sp -= 1
		case Less:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			stack[sp-2] = if stack[sp-2] < stack[sp-1] { 1 } else { 0 }
			sp -= 1
		case Same:
			if sp < 2 {
				return Trap{PC: at, Why: Underflow}
			}
			stack[sp-2] = if stack[sp-2] == stack[sp-1] { 1 } else { 0 }
			sp -= 1
		case Not:
			if sp < 1 {
				return Trap{PC: at, Why: Underflow}
			}
			stack[sp-1] = if stack[sp-1] == 0 { 1 } else { 0 }
		case Jump as j:
			pc = try jumpTo(at, j.To, program.Len())
		case JumpIf as j:
			if sp < 1 {
				return Trap{PC: at, Why: Underflow}
			}
			sp -= 1
			if stack[sp] != 0 {
				pc = try jumpTo(at, j.To, program.Len())
			}
		case JumpIfNot as j:
			if sp < 1 {
				return Trap{PC: at, Why: Underflow}
			}
			sp -= 1
			if stack[sp] == 0 {
				pc = try jumpTo(at, j.To, program.Len())
			}
		case Call as c:
			if fp == MaxFrames {
				return Trap{PC: at, Why: TooDeep}
			}
			if fp == frames.Len() {
				frames = frames.Append(pc)
			} else {
				frames[fp] = pc
			}
			fp += 1
			pc = try jumpTo(at, c.To, program.Len())
		case Ret:
			if fp < 1 {
				return Trap{PC: at, Why: NoFrame}
			}
			fp -= 1
			pc = frames[fp]
		case Print:
			if sp < 1 {
				return Trap{PC: at, Why: Underflow}
			}
			sp -= 1
			printed = printed.Append(stack[sp])
		case Halt:
			break
		}
	}
	let mut left = []int{}
	for i in 0..sp {
		left = left.Append(stack[i])
	}
	Result{Printed: printed, Stack: left, Steps: steps}
}

// jumpTo is to, when it is an instruction of a program of size
// instructions or its end.
func jumpTo(at int, to int, size int) int fails Trap {
	if to < 0 || to > size {
		return Trap{PC: at, Why: BadTarget{To: to}}
	}
	to
}

// Describe is the text of a trap.
func Describe(t Trap) string {
	let why = match t.Why {
	case Underflow:
		"stack underflow"
	case DivideByZero:
		"division by zero"
	case BadTarget as b:
		"jump to \(b.To), outside the program"
	case NoFrame:
		"return with no call"
	case TooDeep:
		"calls nested deeper than \(MaxFrames)"
	case OutOfFuel:
		"out of fuel"
	}
	"trap at \(t.PC): \(why)"
}
