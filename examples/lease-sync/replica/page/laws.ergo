import slices

// The laws of Window, over windows that a generated run of pages, live
// rows, pending rows, confirmations and failed pages makes. A run reads a
// list of int keys (a key is its row's place in the list) whose ID is "r"
// and the key, or the pending row's ID once it is confirmed.

type sim {
	W        Window[int, string],
	List     []Row[int, string],
	Readable int,
	Flight   []Page[int, string],
	Outbox   []Pending[string],
	Made     int,
}

func digit(op int, n int) int { ((op % n) + n) % n }

func start() sim {
	let mut list = []Row[int, string]{}
	for k in 0..5 {
		list = list.Append(Row[int, string]{Key: k, ID: "r\(k)", Value: "v\(k)"})
	}
	sim{W: Empty[int, string](), List: list, Readable: 5, Flight: []Page[int, string]{}, Outbox: []Pending[string]{}, Made: 0}
}

// readAfter is the read model's page of at most n rows after the cursor,
// of the rows it has caught up to.
func readAfter(list []Row[int, string], after Option[int], n int) Page[int, string] {
	let mut rows = []Row[int, string]{}
	for r in list {
		if atMost(after, r.Key) && after != (Some{Value: r.Key}) {
			if len(rows) == n {
				return Page[int, string]{Rows: rows, After: after, Before: Some{Value: r.Key}}
			}
			rows = rows.Append(r)
		}
	}
	Page[int, string]{Rows: rows, After: after, Before: None}
}

// readBefore is the read model's page of at most n rows before the cursor.
func readBefore(list []Row[int, string], before Option[int], n int) Page[int, string] {
	let mut below = []Row[int, string]{}
	for r in list {
		if atLeast(before, r.Key) && before != (Some{Value: r.Key}) {
			below = below.Append(r)
		}
	}
	if len(below) <= n {
		return Page[int, string]{Rows: below, After: None, Before: before}
	}
	Page[int, string]{Rows: below[len(below)-n:], After: Some{Value: below[len(below)-n-1].Key}, Before: before}
}

func confirmed(list []Row[int, string], id string) bool { holds(list, id) }

func live(s sim, id string, value string) sim {
	let r = Row[int, string]{Key: len(s.List), ID: id, Value: value}
	sim{..s, List: s.List.Append(r), W: Tail(s.W, r)}
}

// step is one generated event: a page asked after or before the window
// (it is in flight until it is delivered or fails), a page delivered, a
// page failed, a live row, a submit, a confirmation of a pending row (its
// row arrives live), and the read model catching up or the outbox
// dropping a confirmed or refused row.
func step(s sim, op int) sim {
	let x = digit(op/8, 1000)
	let k = digit(op, 8)
	if k == 0 {
		return sim{..s, Flight: s.Flight.Append(readAfter(s.List[:s.Readable], Next(s.W), 1+x%3))}
	}
	if k == 1 {
		return sim{..s, Flight: s.Flight.Append(readBefore(s.List[:s.Readable], Prev(s.W), 1+x%3))}
	}
	if k == 2 || k == 3 {
		if len(s.Flight) == 0 {
			return s
		}
		let i = x % len(s.Flight)
		let rest = slices.Concat(s.Flight[:i], s.Flight[i+1:])
		if k == 3 {
			return sim{..s, Flight: rest, W: Fail(s.W)}
		}
		return sim{..s, Flight: rest, W: Extend(s.W, s.Flight[i])}
	}
	if k == 4 {
		return live(s, "r\(len(s.List))", "v\(len(s.List))")
	}
	if k == 5 {
		let outbox = s.Outbox.Append(Pending[string]{ID: "p\(s.Made)", Value: "mine \(s.Made)"})
		return sim{..s, Outbox: outbox, Made: s.Made + 1, W: Local(s.W, outbox)}
	}
	if k == 6 {
		if len(s.Outbox) == 0 {
			return s
		}
		let p = s.Outbox[x%len(s.Outbox)]
		if confirmed(s.List, p.ID) {
			return s
		}
		return live(s, p.ID, p.Value)
	}
	if x%2 == 0 {
		return sim{..s, Readable: len(s.List)}
	}
	let mut outbox = []Pending[string]{}
	for i in 0..len(s.Outbox) {
		if !confirmed(s.List, s.Outbox[i].ID) && i != x%(len(s.Outbox)+1) {
			outbox = outbox.Append(s.Outbox[i])
		}
	}
	sim{..s, Outbox: outbox, W: Local(s.W, outbox)}
}

// trace is the states of a run of ops, the first state included.
func trace(ops []int) []sim {
	let mut s = start()
	let mut out = []sim{s}
	for op in ops {
		s = step(s, op)
		out = out.Append(s)
	}
	out
}

// drain reads, with the read model caught up, after the window until it
// ends and before it until it starts. The bound is one page a row and one
// more each way.
func drain(s sim) sim {
	let mut t = sim{..s, Readable: len(s.List), Flight: []Page[int, string]{}}
	for _ in 0..len(t.List)+1 {
		if !Ended(t.W) {
			t = sim{..t, W: Extend(t.W, readAfter(t.List, Next(t.W), 1))}
		}
		if !Started(t.W) {
			t = sim{..t, W: ExtendBack(t.W, readBefore(t.List, Prev(t.W), 1))}
		}
	}
	t
}

func loaded(items []Item[string]) []string {
	let mut out = []string{}
	for it in items {
		if !it.Pending {
			out = out.Append(it.ID)
		}
	}
	out
}

func pending(items []Item[string]) []string {
	let mut out = []string{}
	for it in items {
		if it.Pending {
			out = out.Append(it.ID)
		}
	}
	out
}

func ids(list []Row[int, string]) []string {
	let mut out = []string{}
	for r in list {
		out = out.Append(r.ID)
	}
	out
}

// shown is what the view must show of s: the outbox rows that no loaded
// row confirms, when the window has ended.
func shown(s sim, rows []string) []string {
	let mut out = []string{}
	if !Ended(s.W) {
		return out
	}
	for p in s.Outbox {
		if !slices.Contains(rows, p.ID) {
			out = out.Append(p.ID)
		}
	}
	out
}

// isWindowOf is true when s's view is a window of its list: the loaded
// rows are a run of the list with no gap, no row twice and none out of
// order, from its first row when the window started and to its last when
// it ended; then the outbox rows that no row confirms.
func isWindowOf(s sim) bool {
	let items = Rows(s.W)
	let rows = loaded(items)
	let all = ids(s.List)
	if pending(items) != shown(s, rows) {
		return false
	}
	if len(rows) == 0 {
		return !Ended(s.W) || len(all) == 0
	}
	let mut first = -1
	for i in 0..len(all) {
		if all[i] == rows[0] {
			first = i
		}
	}
	if first < 0 || first+len(rows) > len(all) || all[first:first+len(rows)] != rows {
		return false
	}
	if Started(s.W) && first != 0 {
		return false
	}
	!Ended(s.W) || first+len(rows) == len(all)
}

// WindowIsTheListsWindow is the model-based property (wf10 RPG1): after
// any run, the view is a window of the list (isWindowOf), no loaded row is
// ever lost, and reading to both ends then shows the whole list and the
// outbox rows that no row confirms.
law WindowIsTheListsWindow(ops []int) {
	let states = trace(ops)
	for i in 0..len(states) {
		if !isWindowOf(states[i]) {
			return false
		}
		if i > 0 {
			let now = loaded(Rows(states[i].W))
			for id in loaded(Rows(states[i-1].W)) {
				if !slices.Contains(now, id) {
					return false
				}
			}
		}
	}
	let d = drain(states[len(states)-1])
	isWindowOf(d) && Started(d.W) && Ended(d.W) && loaded(Rows(d.W)) == ids(d.List)
}

// FailedPageChangesNothing: a failed page changes no row of the view and
// no cursor.
law FailedPageChangesNothing(ops []int) {
	for s in trace(ops) {
		let f = Fail(s.W)
		if Rows(f) != Rows(s.W) || Next(f) != Next(s.W) || Prev(f) != Prev(s.W) || !Failed(f) {
			return false
		}
	}
	true
}

// LiveRowStaysAfterLoadedEnd: a live row shows after the loaded rows when
// the window holds the list's last row, and not at all before: never
// inside a part of the list that is not loaded.
law LiveRowStaysAfterLoadedEnd(ops []int) {
	for s in trace(ops) {
		let r = Row[int, string]{Key: len(s.List), ID: "live", Value: "live"}
		let before = loaded(Rows(s.W))
		let after = loaded(Rows(Tail(s.W, r)))
		if Ended(s.W) && after != before.Append("live") {
			return false
		}
		if !Ended(s.W) && after != before {
			return false
		}
	}
	true
}

// ConfirmedLocalRowIsNotTwice: a pending row whose confirmed row arrived
// shows once, as the confirmed row, while the outbox still holds it.
law ConfirmedLocalRowIsNotTwice(ops []int) {
	for s in trace(ops) {
		for p in s.Outbox {
			if confirmed(s.List, p.ID) {
				continue
			}
			let w = Tail(s.W, Row[int, string]{Key: len(s.List), ID: p.ID, Value: p.Value})
			let mut n = 0
			for it in Rows(w) {
				if it.ID == p.ID {
					n = n + 1
				}
			}
			if n != (if Ended(s.W) { 1 } else { 0 }) {
				return false
			}
		}
	}
	true
}
