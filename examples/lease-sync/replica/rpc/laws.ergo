import lease-sync/domain
import lease-sync/lease
import lease-sync/replica
import lease-sync/replica/memory
import lease-sync/replica/server
import rpc
import schedule
import slices
import strings
import sync
import testing
import time

let at = time.Unix(0, 0)

// told is what an authority answered a push, as text both providers can
// be compared by.
func told(a replica.Authority[lease.Pool, lease.Cmd, lease.Event, lease.Refusal], m domain.Envelope[lease.Cmd]) string {
	let r = a.Push(m) catch {
	case replica.Unavailable as u:
		return "unavailable: \(u.Reason)"
	case replica.Unauthorized:
		return "unauthorized"
	case replica.OutOfOrder as o:
		return "out of order, expected \(o.Expected)"
	case replica.IDConflict as x:
		return "conflict \(x.ID)"
	}
	"kept \(r.ID) at \(r.Stream) \(r.Position)"
}

func read(a replica.Authority[lease.Pool, lease.Cmd, lease.Event, lease.Refusal], by replica.ClientID, from int) Option[Frame] {
	let f = a.Pull(by, from) catch {
	case replica.Unavailable, replica.Unauthorized:
		return None
	}
	Some[Frame]{Value: f}
}

// envelope is op as a command of client "a" or "b": a take or a give of
// one of three names, at, before or after the client's next number.
func envelope(op int, next func(origin replica.ClientID) int) domain.Envelope[lease.Cmd] {
	let x = (op%1000 + 1000) % 1000
	let origin = if x%2 == 0 { replica.ClientID("a") } else { replica.ClientID("b") }
	let seq = next(origin) + (x/2)%3 - 1
	let name = "n\((x / 6) % 3)"
	let cmd = if (x/18)%2 == 0 { lease.Take{Name: name} } else { lease.Give{Name: name} }
	domain.Envelope[lease.Cmd]{ID: replica.IDOf(origin, if seq < 1 { 1 } else { seq }), By: string(origin), At: at, Command: cmd}
}

// AgreesWithMemory: for any pushes (resends, commands out of order and
// conflicts among them) and pulls from any position, the rpc provider over
// the whole wire gives the same answers and the same frames as the memory
// provider, and none of them is Unavailable: the wire carries every
// receipt, failure and frame of the protocol both ways.
law AgreesWithMemory(ops []int, froms []int) {
	let remote = NewLeases()
	let mem = memory.NewLeases()
	let kept = sync.NewRef(Map[replica.ClientID, int]{})
	let next = func(o replica.ClientID) int {
		match kept.Get().Get(o) {
		case Some[int] as n:
			n.Value + 1
		case None:
			1
		}
	}
	for i, op in ops {
		let m = envelope(op, next)
		let w = told(remote, m)
		if w != told(mem, m) || strings.HasPrefix(w, "unavailable") {
			return false
		}
		if strings.HasPrefix(w, "kept") {
			let o = server.Origin(m.ID)
			kept.Update(func(k Map[replica.ClientID, int]) Map[replica.ClientID, int] { k.Put(o, replica.SeqOf(m.ID, o)) })
		}
		if i < len(froms) {
			let by = if froms[i]%2 == 0 { replica.ClientID("a") } else { replica.ClientID("b") }
			let from = (froms[i]%12 + 12) % 12
			let f = read(remote, by, from)
			if f == None || f != read(mem, by, from) {
				return false
			}
		}
	}
	true
}

// loopback is a lease authority served through the wire for the
// clients allow takes, with long polls; a test of it pulls only where the
// log has something new (rpc.Loopback's call is not a wait that a
// VirtualClock or a Manual's Advance sees, so the long poll's own tests
// call server.Handle directly: replica/server/poll.ergo).
func loopback(allow escaping func(by replica.ClientID) bool) Leases {
	let a = server.Start[lease.Pool, lease.Cmd, lease.Event, lease.Refusal, lease.Refusal](source, server.Facts, 8)
	Over(rpc.Loopback(Serve(a, allow, 30s, time.NewManual(0))), true)
}

// Flaky is a lease authority whose next Left pushes fail Unavailable
// before they reach it; it records the id of each push it is given.
type Flaky { inner Leases, left sync.Ref[int], seen sync.Ref[[]domain.CommandID] }

func NewFlaky() Flaky { Flaky{inner: NewLeases(), left: sync.NewRef(2), seen: sync.NewRef([]domain.CommandID{})} }

func Push(f Flaky, m domain.Envelope[lease.Cmd]) domain.Receipt fails replica.Unavailable | replica.Unauthorized | replica.OutOfOrder | replica.IDConflict {
	f.seen.Update(func(s []domain.CommandID) []domain.CommandID { s.Append(m.ID) })
	let fail = sync.Modify(f.left, func(n int) (bool, int) { (n > 0, n - 1) })
	if fail {
		return replica.Unavailable{Reason: "dropped"}
	}
	try f.inner.Push(m)
}

func Pull(f Flaky, by replica.ClientID, from int) Frame fails replica.Unavailable | replica.Unauthorized { try f.inner.Pull(by, from) }

// RetryResendsTheSameID: a push that the network drops is sent again with
// the same envelope, so each try carries the command's own id, and after
// the retries every pending command is in the log once at its id.
law RetryResendsTheSameID(drops int, n int) {
	let f = Flaky{..NewFlaky(), left: sync.NewRef((drops%4 + 4) % 4)}
	let k = (n%4+4)%4 + 1
	let mut pending = []domain.Envelope[lease.Cmd]{}
	for i in 1..k+1 {
		pending = pending.Append(domain.Envelope[lease.Cmd]{ID: replica.IDOf(replica.ClientID("a"), i), By: "a", At: at, Command: lease.Give{Name: "n\(i)"}})
	}
	let c = testing.NewVirtualClock(0)
	let conn = with context { Scheduler: c, time.Clock: c } {
		replica.Send(f, pending, schedule.Exponential(1s, 2.0, 1m).And(schedule.Recurs(4)))
	}
	if conn != replica.Live {
		return false
	}
	let mut ids = []domain.CommandID{}
	for m in pending {
		ids = ids.Append(m.ID)
	}
	for id in f.seen.Get() {
		if !slices.Contains(ids, id) {
			return false
		}
	}
	let log = f.inner.Pull(replica.ClientID("a"), 0) catch {
	case replica.Unavailable, replica.Unauthorized:
		return false
	}
	match log {
	case replica.Delta[lease.Event, lease.Refusal] as d:
		if len(d.Records) != k {
			return false
		}
		for i, r in d.Records {
			if r.ID != pending[i].ID {
				return false
			}
		}
		true
	case replica.Snapshot[lease.Pool, lease.Refusal]:
		false
	}
}

// RefusedClientNeedsSignIn: a client the authority's allow refuses is
// shown as needing a sign-in, by the push loop and by the pull loop; never
// as offline, which a retry would end. Another client is not refused.
test RefusedClientNeedsSignIn {
	let c = testing.NewVirtualClock(0)
	let l = loopback(func(by replica.ClientID) bool { by != replica.ClientID("b") })
	let retry = schedule.Recurs(2)
	let b = []domain.Envelope[lease.Cmd]{domain.Envelope[lease.Cmd]{ID: replica.IDOf(replica.ClientID("b"), 1), By: "b", At: at, Command: lease.Take{Name: "x"}}}
	let a = []domain.Envelope[lease.Cmd]{domain.Envelope[lease.Cmd]{ID: replica.IDOf(replica.ClientID("a"), 1), By: "a", At: at, Command: lease.Take{Name: "x"}}}
	with context { Scheduler: c, time.Clock: c } {
		assert replica.Send(l, b, retry) == replica.NeedsAuth
		assert replica.Send(l, a, retry) == replica.Live
		match replica.Fetch(l, replica.ClientID("b"), 0, retry) {
		case replica.Link as k:
			assert k.Conn == replica.NeedsAuth
		case _:
			assert false
		}
		match replica.Fetch(l, replica.ClientID("a"), 0, retry) {
		case replica.Pulled[lease.Pool, lease.Event, lease.Refusal]:
		case _:
			assert false
		}
	}
}

// Held is a lease authority in this process whose Pull is the long poll,
// held on its virtual clock: the provider the pull loop's counted test
// runs on.
type Held { s Authority, c testing.VirtualClock }

func NewHeld() Held { Held{s: server.Start[lease.Pool, lease.Cmd, lease.Event, lease.Refusal, lease.Refusal](source, server.Facts, 8), c: testing.NewVirtualClock(0)} }

func Push(h Held, m domain.Envelope[lease.Cmd]) domain.Receipt fails replica.Unavailable | replica.Unauthorized | replica.OutOfOrder | replica.IDConflict {
	try server.Push(h.s, m, h.c.Now())
}

func Pull(h Held, by replica.ClientID, from int) Frame fails replica.Unavailable | replica.Unauthorized {
	with context { Scheduler: h.c } {
		server.Await(h.s, by, from, 30s)
	}
}

// IdleCostsOneCallPerWait: the pull loop over an idle log makes one call
// per held wait, never a loop of empty frames: four calls take four waits.
test IdleCostsOneCallPerWait {
	let h = NewHeld()
	let start = h.c.Now()
	let mut calls = 0
	with context { Scheduler: h.c, time.Clock: h.c } {
		replica.Follow(h, replica.ClientID("a"), 0, schedule.Recurs(0), func(sig replica.Signal[lease.Pool, lease.Cmd, lease.Event, lease.Refusal]) Option[int] {
			calls = calls + 1
			if calls == 4 {
				return None
			}
			Some[int]{Value: 0}
		})
	}
	assert calls == 4
	assert h.c.Now().Sub(start) == 120s
}
