// Package memory holds the in-memory providers of gent's contracts: a
// model that plays a script, and a working directory that is a map of
// files. Tests, laws and the cases use them; no network, no disk.

import exec
import gent/agent
import strings
import testing
import time

// World is a scripted world, as a script file holds it: the model's
// replies, the working directory's files, and what each shell command
// gives, keyed by its command line.
type World { Replies []Entry, Files Map[string, string], Shell Map[string, Ran] }

// Ran is what a scripted shell command gives: its exit status and its
// output on each stream.
type Ran { Status int, Stdout string, Stderr string }

// Commands is the exec.Script of w's shell: each command line, run as
// the shell tool runs it (sh -c), gives its Ran; any other is NotFound.
func Commands(w World) exec.Script {
	let mut results = Map[string, exec.Result]{}
	for line, r in w.Shell {
		results[exec.Key(exec.New("sh", []string{"-c", line}))] = exec.Result{Status: r.Status, Stdout: r.Stdout, Stderr: r.Stderr}
	}
	exec.Script{Results: results}
}

// Entry is one reply of a script: a reply in pieces, with its calls and
// why it ended; a reply whose stream breaks after its pieces; or a
// failed ask.
type Entry = Says{Pieces []string, Calls []agent.Call, End agent.End} | Breaks{Pieces []string} | Fails{Failure agent.ModelFailure}

// Scripted is a Model that plays Replies: the reply to a prompt is the
// entry numbered by the asks in the prompt's transcript (agent.Attempts),
// so the first ask gets the first entry, a retry the next. It is a value
// with no state, so Complete and Stream of one prompt agree, and a
// replayed transcript is answered as it was.
type Scripted { Replies []Entry } implements agent.Model

// NewScripted is the script whose first reply has the pieces first, cut
// short when cut, and whose later replies are rest. Law runs draw
// scripts by it (the generator calls a package's New<T>): a first ask
// then streams pieces of text, which generated entries seldom hold.
func NewScripted(first []string, cut bool, rest []Entry) Scripted {
	let mut head Entry = Says{Pieces: first, Calls: []agent.Call{}, End: agent.Finished}
	if cut {
		head = Breaks{Pieces: first}
	}
	Scripted{Replies: []Entry{head}.Concat(rest)}
}

// ReplayIsTheRun: a live session that asks texts of the script over the
// tree and a shell that runs nothing, as an actor with its work and its
// timers on a virtual clock, its asks answered by allow, ends in the
// state that the fold of its recorded signals gives, with no work, no
// clock, no model and no shell.
law ReplayIsTheRun(s Scripted, t Tree, texts []string, allow bool) {
	let c = testing.NewVirtualClock(0)
	let (live, record) = with context { agent.Model: s, agent.Tools: t, exec.Runner: exec.Script{Results: Map[string, exec.Result]{}}, Scheduler: c, time.Clock: c } {
		agent.Headless(agent.Limits{MaxSteps: 4, MaxRetries: 2}, texts, allow)
	}
	agent.Replay(record) == live
}

// entry is the entry that answers p, or the failure of a script that has
// run out.
func entry(s Scripted, p agent.Prompt) Entry {
	let n = agent.Attempts(p.Log)
	if n >= len(s.Replies) {
		let out agent.ModelFailure = agent.Malformed{Reason: "the script has no reply \(n + 1)"}
		return Fails{Failure: out}
	}
	s.Replies[n]
}

func Complete(s Scripted, p agent.Prompt) agent.Turn fails agent.RateLimited | agent.Overloaded | agent.Unauthorized | agent.Refused | agent.Truncated | agent.Transport | agent.Malformed {
	match entry(s, p) {
	case Says as r:
		agent.Turn{Text: strings.Join(r.Pieces, ""), Calls: r.Calls, End: r.End}
	case Breaks as b:
		agent.Truncated{Text: strings.Join(b.Pieces, "")}
	case Fails as f:
		try fail(f.Failure)
	}
}

func Stream(s Scripted, p agent.Prompt, put func(d agent.Delta) fails agent.SinkFailed) agent.Turn fails agent.RateLimited | agent.Overloaded | agent.Unauthorized | agent.Refused | agent.Truncated | agent.Transport | agent.Malformed | agent.SinkFailed {
	match entry(s, p) {
	case Says as r:
		for piece in r.Pieces {
			try put(agent.Delta{Text: piece})
		}
		agent.Turn{Text: strings.Join(r.Pieces, ""), Calls: r.Calls, End: r.End}
	case Breaks as b:
		for piece in b.Pieces {
			try put(agent.Delta{Text: piece})
		}
		agent.Truncated{Text: strings.Join(b.Pieces, "")}
	case Fails as f:
		// A truncated reply came as far as its text.
		match f.Failure {
		case agent.Truncated as t:
			try put(agent.Delta{Text: t.Text})
		case agent.RateLimited, agent.Overloaded, agent.Unauthorized, agent.Refused, agent.Transport, agent.Malformed:
		}
		try fail(f.Failure)
	}
}

// fail fails with f.
func fail(f agent.ModelFailure) agent.Turn fails agent.RateLimited | agent.Overloaded | agent.Unauthorized | agent.Refused | agent.Truncated | agent.Transport | agent.Malformed {
	match f {
	case agent.RateLimited as x:
		x
	case agent.Overloaded as x:
		x
	case agent.Unauthorized as x:
		x
	case agent.Refused as x:
		x
	case agent.Truncated as x:
		x
	case agent.Transport as x:
		x
	case agent.Malformed as x:
		x
	}
}
