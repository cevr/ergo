// gent is a small agent harness in a terminal, after the owner's gent:
// type a message, the model's reply streams in, and the tools it calls
// run in the working directory. Package agent is the domain (the Model
// and Tools contracts and the Agent machine), memory holds the scripted
// model and the map of files, screen draws a frame. This binary is the
// only place that chooses the providers.
//
//	gent --script WORLD -p TEXT    one turn, the transcript printed
//	gent --script WORLD            a chat at the terminal
//	gent --replay RUN              the transcript of a recorded run
//
// A WORLD file is the JSON of memory.World (the replies, the files, the
// shell's results); a RUN file the JSON of agent.Recorded, which --record
// writes. With --session FILE the run's signals are kept in FILE as they
// commit, and a later run on the same FILE goes on from them: a turn the
// first run left open is closed, and a call it left running is told it
// was interrupted, not run again. With --here the tools act on the real working directory (a
// confined fs.Root) and the shell runs commands on this machine; each
// command waits for the person's y, and with -p, where no one can
// answer, it is declined unless --allow-shell allows every one.

import exec
import flag
import fs
import gent/agent
import gent/host
import gent/memory
import gent/screen
import io
import json
import os
import term
import time

let promptFlag = flag.String("p", "", "send `text` with no terminal, print the transcript, and leave")
let scriptFlag = flag.String("script", "", "the scripted world to talk to: a JSON `file` of replies and files")
let replayFlag = flag.String("replay", "", "print the transcript of the recorded run in `file`, and leave")
let recordFlag = flag.String("record", "", "write the run's signals to `file` (with -p)")
let stepsFlag = flag.Int("max-steps", 8, "the most asks of the model after one message")
let retriesFlag = flag.Int("retries", 3, "the most retries of one failed ask")
let allowShellFlag = flag.Bool("allow-shell", false, "with -p: run every shell command the model asks for (else each is declined)")
let sessionFlag = flag.String("session", "", "keep the session's signals in `file`, and go on from those it holds")
let hereFlag = flag.Bool("here", false, "act on the real working directory and run shell commands on this machine (each one asked first)")

let set = flag.Set{Name: "gent", Usage: "", Flags: []flag.Flag{promptFlag, scriptFlag, replayFlag, recordFlag, stepsFlag, retriesFlag, allowShellFlag, sessionFlag, hereFlag}, Args: []flag.ArgSpec{}}

let usage = "usage: gent --script FILE [--here] [--session FILE] [-p TEXT [--allow-shell] [--record FILE]] | gent --replay FILE"

// run is the program on args.
func run(args []string) fails os.Exit needs os.Ambient | io.Stdout | io.Stdin | fs.Files | fs.Writes | term.Terminal | time.Scheduler | time.Clock {
	let v = flag.Parse(set, args) catch {
	case err:
		try flag.Exit(err, usage)
		return
	}
	let replay = replayFlag.Get(v)
	if replay != "" {
		let r = try loadRecorded(replay, json.Codec[agent.Recorded]{MaxBytes: 64 << 20, MaxDepth: 64})
		print(agent.Replay(r).Log)
		return
	}
	let script = scriptFlag.Get(v)
	if script == "" {
		return os.Exit{Code: 2, Message: "gent: no model: pass --script FILE (a live model is a later unit)\n" + usage}
	}
	let world = try loadWorld(script, json.Codec[memory.World]{MaxBytes: 16 << 20, MaxDepth: 64})
	let limits = agent.Limits{MaxSteps: stepsFlag.Get(v), MaxRetries: retriesFlag.Get(v)}
	let model = memory.Scripted{Replies: world.Replies}
	let disk = fs.NewHost()
	if hereFlag.Get(v) {
		let root = fs.OpenRoot(".") catch {
		case _:
			return os.Exit{Code: 1, Message: "gent: cannot open the working directory"}
		}
		with context { agent.Model: model, agent.Tools: host.Workdir{Root: root}, exec.Runner: exec.NewHost().InheritEnv(os.NewHost().Environ()) } {
			try talk(v, limits, disk)
		}
		return
	}
	with context { agent.Model: model, agent.Tools: memory.Tree{Files: world.Files}, exec.Runner: memory.Commands(world) } {
		try talk(v, limits, disk)
	}
}

// talk is one turn with no terminal (-p), or a chat at the terminal; the
// session file, if any, is read and written with disk.
func talk(v flag.Values, limits agent.Limits, disk fs.Host) fails os.Exit needs agent.Model | agent.Tools | exec.Runner | io.Stdout | io.Stdin | fs.Writes | term.Terminal | time.Scheduler | time.Clock {
	let text = promptFlag.Get(v)
	if text != "" {
		let (last, record) = agent.Headless(try openSession(disk, limits, sessionFlag.Get(v)), []string{text}, allowShellFlag.Get(v))
		print(last.Log)
		let path = recordFlag.Get(v)
		if path != "" {
			fs.Writes.WriteFile(path, json.Encode(json.Codec[agent.Recorded]{MaxBytes: 0, MaxDepth: 0}, record)+"\n") catch {
			case _:
				return os.Exit{Code: 1, Message: "gent: cannot write " + path}
			}
		}
		return
	}
	if !io.Stdin.IsTerminal() {
		return os.Exit{Code: 2, Message: "gent: standard input is not a terminal: pass -p TEXT for one turn, or --replay FILE\n" + usage}
	}
	let s = try openSession(disk, limits, sessionFlag.Get(v))
	term.Raw() {
		io.Stdout.Print("\x1b[?1049h")
		Chat(s)
		io.Stdout.Print("\x1b[?1049l")
	} catch {
	case term.NotTerminal:
		s.Agent.Stop()
		return os.Exit{Code: 2, Message: "gent: standard input is not a terminal"}
	}
}

// readText is the text of the file at path.
func readText(path string) string fails os.Exit needs fs.Files {
	fs.Files.ReadFile(path) catch {
	case _:
		return os.Exit{Code: 1, Message: "gent: cannot read " + path}
	}
}

// loadRecorded is the recorded run that the JSON file at path holds.
func loadRecorded(path string, c json.Codec[agent.Recorded]) agent.Recorded fails os.Exit needs fs.Files {
	json.Decode(c, try readText(path)) catch {
	case json.Malformed as m:
		return os.Exit{Code: 1, Message: "gent: " + path + ": " + m.Reason}
	case _:
		return os.Exit{Code: 1, Message: "gent: " + path + " is not a " + "gent file"}
	}
}

// loadWorld is the scripted world that the JSON file at path holds.
func loadWorld(path string, c json.Codec[memory.World]) memory.World fails os.Exit needs fs.Files {
	json.Decode(c, try readText(path)) catch {
	case json.Malformed as m:
		return os.Exit{Code: 1, Message: "gent: " + path + ": " + m.Reason}
	case _:
		return os.Exit{Code: 1, Message: "gent: " + path + " is not a " + "gent file"}
	}
}

// print writes the transcript's lines.
func print(log []agent.Row) needs io.Stdout {
	for line in screen.Transcript(log, true) {
		io.Stdout.Println(line)
	}
}

func main() fails os.Exit needs os.Ambient {
	with context { os.Process: os.NewHost(), io.Stdout: io.NewHost(), io.Stdin: io.NewStdin(), fs.Files: fs.NewHost(), fs.Writes: fs.NewHost(), term.Terminal: term.NewHost(), time.Scheduler: time.NewLiveScheduler(), time.Clock: time.NewHost() } {
		try run(os.Process.Args())
	}
}
