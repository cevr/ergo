// The chat at a terminal: one loop draws. Three tasks feed it events, one
// reading keys, one following the agent's states, and one asking for a
// redraw every turn of the spinner (a request that carries no state: the
// frame reads the clock, and nothing reaches the agent or its journal);
// the loop takes one event at a time, edits the composer,
// scrolls, or sends the agent a signal, and paints the lines of the frame
// that changed. Nothing else writes to standard output.

import exec
import gent/agent
import gent/memory
import gent/screen
import io
import machines
import queue
import slices
import strconv
import strings
import task
import term
import testing
import time

// Event is what the loop takes: a key, a state the agent committed, or a
// request to draw again.
type Event = Pressed{Key term.Key} | Changed{State agent.State} | Redraw{}

// Chat runs the session s at the terminal until it ends, and stops it.
func Chat(s agent.Session) needs io.Stdout | term.Terminal | time.Scheduler | time.Clock {
	let events = queue.New[Event](64)
	let keys = task.Go() { readKeys(events) }
	let states = task.Go() { follow(s, events) }
	let ticks = task.Go() { redraws(events) }
	let now = time.Clock.Now()
	let mut view = screen.View{State: s.Agent.State(), Line: screen.Line{Text: "", At: 0}, Scroll: screen.Stuck(), Detail: false, Since: now, Now: now}
	let mut shown = Shown{Window: size(), Lines: []string{}}
	shown = paint(shown, view)
	for {
		let e = events.Pop() catch {
		case queue.Closed:
			break
		}
		match e {
		case Pressed as p:
			match screen.Intent(p.Key, view.State.Phase) {
			case screen.Type as t:
				view = screen.View{..view, Line: machines.Next(view.Line, screen.Edit(view.Line, t.Key))}
			case screen.Send as send:
				s.Agent.Send(send.Signal) catch {
				case _:
				}
			case screen.SendLine:
				s.Agent.Send(agent.Submit{Text: view.Line.Text}) catch {
				case _:
				}
				view = screen.View{..view, Line: screen.Line{Text: "", At: 0}}
			case screen.Page as pg:
				view = screen.Paged(view, pg.Up, size())
			case screen.Toggle:
				view = screen.View{..view, Detail: !view.Detail}
			case screen.Nothing:
			}
		case Changed as c:
			view = Began(view, c.State, time.Clock.Now())
		case Redraw:
		}
		view = screen.View{..view, Now: time.Clock.Now()}
		shown = paint(shown, view)
		if view.State.Phase == agent.Ended {
			break
		}
	}
	events.End()
	keys.Stop()
	states.Stop()
	ticks.Stop()
	s.Agent.Stop()
}

// readKeys puts each key of the terminal in events, until the end of
// the input.
func readKeys(events queue.Queue[Event]) needs term.Terminal {
	for {
		let k = term.Terminal.ReadKey() catch {
		case io.ReadFailed:
			term.EndOfInput
		}
		events.Push(Pressed{Key: k}) catch {
		case queue.Closed:
			return
		}
		if k == term.EndOfInput {
			return
		}
	}
}

// follow puts the agent's latest state in events each time it commits
// (LatestChanges: a draw needs only the newest state).
func follow(s agent.Session, events queue.Queue[Event]) {
	for st in s.Agent.LatestChanges() {
		events.Push(Changed{State: st}) catch {
		case queue.Closed:
			return
		}
	}
}

// Began is v showing the state st, seen at now: the work's start is now
// when st works and v's state did not, else it stays.
func Began(v screen.View, st agent.State, now time.Time) screen.View {
	let since = if working(st) && !working(v.State) { now } else { v.Since }
	screen.View{..v, State: st, Since: since}
}

// working reports whether s's phase works (the spinner turns).
func working(s agent.State) bool { screen.Spin(screen.View{State: s, Line: screen.Line{Text: "", At: 0}, Scroll: screen.Stuck(), Detail: false, Since: time.Unix(0, 0), Now: time.Unix(0, 0)}) != "" }

// SpinnerFollowsTheClock: the draw loop's spinner is the clock's: a turn
// that begins at the clock's reading shows the third mark 240ms of the
// clock later, and another state of the same work keeps its start.
test SpinnerFollowsTheClock {
	let c = testing.NewVirtualClock(0)
	let asking = agent.Replay(agent.Recorded{Limits: agent.Limits{MaxSteps: 2, MaxRetries: 0}, Signals: []agent.Signal{agent.Submit{Text: "hi"}}})
	let idle = agent.Start(agent.Limits{MaxSteps: 2, MaxRetries: 0})
	let (first, later) = with context { time.Scheduler: c, time.Clock: c } {
		let v = screen.View{State: idle, Line: screen.Line{Text: "", At: 0}, Scroll: screen.Stuck(), Detail: false, Since: time.Unix(0, 0), Now: time.Unix(0, 0)}
		time.Scheduler.Sleep(1s)
		let began = Began(v, asking, time.Clock.Now())
		time.Scheduler.Sleep(240ms)
		let more = Began(began, agent.State{..asking, Phase: agent.Asking{Draft: "H", Try: 0}}, time.Clock.Now())
		(screen.Spin(screen.View{..began, Now: time.Clock.Now()}), screen.Spin(screen.View{..more, Now: time.Clock.Now()}))
	}
	assert first == screen.Marks[2] && later == screen.Marks[2]
}

// redraws asks for a redraw every turn of the spinner, until events end.
func redraws(events queue.Queue[Event]) needs time.Scheduler {
	for {
		time.Scheduler.Sleep(screen.Turn)
		events.Push(Redraw) catch {
		case queue.Closed:
			return
		}
	}
}

// DrawsOnlyStatesThatExisted is the draw loop's model: keys and the
// model's deltas reach the one loop in either order, and under every
// schedule (the explore leg searches them: explored) each frame painted
// is the frame of an agent state the run committed and a composer line
// the keys typed, and the last frame is the frame of the run's last
// state.
test DrawsOnlyStatesThatExisted {
	let w = term.Window{Cols: 40, Rows: 6}
	let keys = []term.Key{term.Char{Text: "h"}, term.Char{Text: "i"}, term.Return, term.EndOfInput}
	let world = memory.Scripted{Replies: []memory.Entry{memory.Says{Pieces: []string{"Hel", "lo"}, Calls: []agent.Call{}, End: agent.Finished}}}
	let out = io.NewRecorder()
	let c = testing.NewVirtualClock(0)
	let record = with context { agent.Model: world, agent.Tools: memory.Tree{Files: Map[string, string]{}}, exec.Runner: exec.Script{Results: Map[string, exec.Result]{}}, io.Stdout: out, term.Terminal: term.NewScript(keys, w), time.Scheduler: c, time.Clock: c } {
		let s = agent.Open(agent.Limits{MaxSteps: 2, MaxRetries: 0})
		Chat(s)
		agent.RecordOf(s)
	}
	let lines = []screen.Line{screen.Line{Text: "", At: 0}, screen.Line{Text: "h", At: 1}, screen.Line{Text: "hi", At: 2}}
	let mut seen = []string{}
	for k in 0..(record.Signals.Len() + 1) {
		let st = agent.Replay(agent.Recorded{Limits: record.Limits, Signals: record.Signals[0:k]})
		for line in lines {
			for spin in 0..4 {
				let since = time.Unix(0, 0)
				seen = seen.Append(strings.Join(screen.Frame(screen.View{State: st, Line: line, Scroll: screen.Stuck(), Detail: false, Since: since, Now: since.Add(time.Times(screen.Turn, spin))}, w), "\n"))
			}
		}
	}
	let paints = strings.Split(out.Text(), "\x1b[H")
	assert paints[0] == ""
	let mut at = []string{}
	for p in paints[1:] {
		at = painted(at, w.Rows, p)
		assert slices.Contains(seen, strings.Join(at, "\n"))
	}
	let end = agent.Replay(record)
	let last = strings.Join(at, "\n")
	assert last == strings.Join(screen.Frame(screen.View{State: end, Line: lines[0], Scroll: screen.Stuck(), Detail: false, Since: time.Unix(0, 0), Now: time.Unix(0, 0)}, w), "\n") || last == strings.Join(screen.Frame(screen.View{State: end, Line: lines[2], Scroll: screen.Stuck(), Detail: false, Since: time.Unix(0, 0), Now: time.Unix(0, 0)}, w), "\n")
}

// painted is the screen of rows lines that a shows after the bytes p of
// one paint (screen.PaintChanges after its leading cursor home): each
// write moves to a row, writes its text and clears the rest of it. Bytes
// that are no such write give a screen no frame is: one line that names
// them.
func painted(a []string, rows int, p string) []string {
	let mut ws = []screen.Write{}
	let parts = strings.Split(p, "\x1b[K")
	for i, part in parts {
		let at = strings.Index(part, ";1H")
		if i == parts.Len()-1 && part == "" {
			break
		}
		if !strings.HasPrefix(part, "\x1b[") || at <= 2 {
			return []string{"not a write: " + strconv.Quote(part)}
		}
		let row = strconv.Atoi(strings.Slice(part, 2, at)) catch {
		case _:
			return []string{"not a row: " + strconv.Quote(part)}
		}
		ws = ws.Append(screen.Write{Row: row - 1, Text: strings.Slice(part, at+3, part.Len())})
	}
	screen.Apply(a, rows, ws)
}

// Shown is what the terminal shows: the lines last painted, in the window
// they were painted for.
type Shown { Window term.Window, Lines []string }

// size is the terminal's window (80 by 24 when it has none).
func size() term.Window needs term.Terminal {
	term.Terminal.Size() catch {
	case term.NotTerminal:
		term.Window{Cols: 80, Rows: 24}
	}
}

// paint draws v over what the terminal shows: only the lines that
// changed, or every line when the window changed size. It gives what the
// terminal shows after.
func paint(was Shown, v screen.View) Shown needs io.Stdout | term.Terminal {
	let w = size()
	let before = if w == was.Window { was.Lines } else { []string{} }
	let lines = screen.Frame(v, w)
	let ws = screen.Changes(before, lines)
	if ws.Len() > 0 {
		io.Stdout.Print("\x1b[H" + screen.PaintChanges(ws))
	}
	Shown{Window: w, Lines: lines}
}
