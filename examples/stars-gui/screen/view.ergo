import stars/catalog
import ui

// RowHeight is the height of a row of the list.
let RowHeight = ui.Length(20.0)

// View shows s: a button a column that sorts by it, a button a column
// that edits the cell under the cursor, the filter, mark and extend
// buttons, the status line, the text field, and the view's rows as a
// virtual list keyed by star id, one text a row (catalog.RowLine).
func View(f *ui.Frame[Signal], s catalog.State) {
	ui.OnKey(f, func(k ui.KeyPress) Option[Signal] { Keyed(k) })
	let g = catalog.GridOf(s)
	ui.Column(f, ui.Plain()) {
		ui.Row(f, ui.Plain()) {
			for c in catalog.Columns() {
				ui.Pressable(f, "sort "+catalog.ColumnName(c), Do{Signal: catalog.SortBy{Column: c}}) {
					ui.Text(f, catalog.ColumnName(c))
				}
			}
		}
		ui.Row(f, ui.Plain()) {
			for c in catalog.Columns() {
				ui.Pressable(f, "edit "+catalog.ColumnName(c), Do{Signal: catalog.Edit{Column: c}}) {
					ui.Text(f, "edit")
				}
			}
			ui.Pressable(f, "filter", Do{Signal: catalog.StartFilter}) {
				ui.Text(f, "filter")
			}
			ui.Pressable(f, "mark", Do{Signal: catalog.Mark}) {
				ui.Text(f, "mark")
			}
			ui.Pressable(f, "extend", Do{Signal: catalog.Extend}) {
				ui.Text(f, "extend")
			}
		}
		ui.Text(f, catalog.Status(s))
		ui.Input(f, Typed(s), "text", func(t string) Signal { Retext{Text: t} })
		ui.Rows(f, "stars", len(g.View), RowHeight, func(i int) ui.Key { ui.IntKey{Value: g.View[i]} }, func(i int) {
			ui.Text(f, catalog.RowLine(g, i))
		})
	}
}

// Keyed is the table's signal of a key: the arrows move a row, the page
// keys a window, Home and End to the ends; Enter commits, Escape cancels
// and Backspace drops a letter of the field.
func Keyed(k ui.KeyPress) Option[Signal] {
	match k.Name {
	case "ArrowDown":
		Some{Value: Do{Signal: catalog.Move{By: 1}}}
	case "ArrowUp":
		Some{Value: Do{Signal: catalog.Move{By: -1}}}
	case "PageDown":
		Some{Value: Do{Signal: catalog.Page{Down: true}}}
	case "PageUp":
		Some{Value: Do{Signal: catalog.Page{Down: false}}}
	case "Home":
		Some{Value: Do{Signal: catalog.Home}}
	case "End":
		Some{Value: Do{Signal: catalog.End}}
	case "Enter":
		Some{Value: Do{Signal: catalog.Commit}}
	case "Escape":
		Some{Value: Do{Signal: catalog.Cancel}}
	case "Backspace":
		Some{Value: Do{Signal: catalog.Backspace}}
	case _:
		None
	}
}
