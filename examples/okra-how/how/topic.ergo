// Package how is the domain of `okra how`: a guide's topic, the catalogue
// that finds a topic by its name, the request the command line makes, and
// the text the command prints. It is pure: no function needs a capability,
// and Library is the one contract it needs from its host.

import io
import slices
import strings

// Topic is one guide: its name, the first sentence of its description,
// and its text without the front matter.
type Topic { Name string, Summary string, Body string }

// Parse is the topic name of the guide doc, as okra reads an embedded
// SKILL.md: the front matter is a first line "---", one or more lines,
// and a line that starts with "---". Summary is the first sentence of the
// front matter's description, and Body is the rest of doc with the front
// matter removed, trimmed. A doc with no front matter has no summary, and
// its body is doc, trimmed.
//
// It reads doc a line at a time through io.Input's Lines. Its law
// LinesSplitInput (the lines joined by line feeds are the input) is what
// lets Parse join the lines after the front matter back into the body.
func Parse(name string, doc string) Topic {
	let lines = slices.Collect(io.Input{Text: doc}.Lines())
	let close = closing(lines)
	if close < 0 {
		return Topic{Name: name, Summary: "", Body: strings.TrimSpace(doc)}
	}
	let mut description = ""
	let mut found = false
	for i in 1..close {
		let line = lines[i]
		let at = strings.Index(line, ":")
		if !found && at >= 0 && strings.TrimSpace(strings.Slice(line, 0, at)) == "description" {
			description = strings.TrimSpace(strings.Slice(line, at+1, len(line)))
			found = true
		}
	}
	Topic{Name: name, Summary: FirstSentence(description), Body: strings.TrimSpace(after(lines, close))}
}

// closing is the index of the line that closes the front matter of lines,
// or -1 when lines has none. The first line is "---" (a carriage return
// may end it), and the closing line is the first line after the second
// that starts with "---": the front matter holds at least one line.
func closing(lines []string) int {
	if len(lines) < 3 || strings.TrimSuffix(lines[0], "\r") != "---" {
		return -1
	}
	for i in 2..len(lines) {
		if strings.HasPrefix(lines[i], "---") {
			return i
		}
	}
	-1
}

// after is the text after the closing line close: what follows "---" on
// that line, past one carriage return, and then each later line.
func after(lines []string, close int) string {
	let rest = strings.TrimPrefix(strings.Slice(lines[close], 3, len(lines[close])), "\r")
	let mut out = []string{}
	if rest != "" {
		out = out.Append(rest)
	}
	for i in close+1..len(lines) {
		out = out.Append(lines[i])
	}
	strings.Join(out, "\n")
}

// FirstSentence is text up to its first '.', '!' or '?' that ends the
// text or comes before a space, a tab or a line end, trimmed; with no such
// mark on the first line, it is all of text, trimmed.
func FirstSentence(text string) string {
	for i in 0..len(text) {
		let c = text[i]
		if c == '\n' || c == '\r' {
			return strings.TrimSpace(text)
		}
		if (c == '.' || c == '!' || c == '?') && (i+1 == len(text) || space(text[i+1])) {
			return strings.TrimSpace(strings.Slice(text, 0, i+1))
		}
	}
	strings.TrimSpace(text)
}

// space reports whether c is an ASCII space character.
func space(c byte) bool {
	c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f'
}
