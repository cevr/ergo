import strings

// Request is what `okra how` is asked: the contents, or one topic's guide.
type Request = Contents{} | Guide{Name string}

// Answer is the text that answers r from c. A guide of a name that c has
// no topic of fails NotFound.
func Answer(c Catalogue, r Request) string fails NotFound {
	match r {
	case Contents:
		Table(c)
	case Guide as g:
		Show(c, try c.Find(g.Name))
	}
}

// Table is the contents: a heading, then each topic with its summary, the
// names padded to one width, in the order of the contents.
func Table(c Catalogue) string {
	let mut width = 0
	for t in c.Topics() {
		if len(t.Name) > width {
			width = len(t.Name)
		}
	}
	let mut lines = []string{"okra — AI agent orchestration toolkit", "", "Topics:"}
	for t in c.Topics() {
		lines = lines.Append("  " + t.Name + strings.Repeat(" ", width-len(t.Name)) + "  " + t.Summary)
	}
	lines = lines.Append("")
	lines = lines.Append("Run `okra how <topic>` for the full guide.")
	strings.Join(lines, "\n")
}

// Show is the guide of t: its body and, when t has subtopics, a line that
// names them.
func Show(c Catalogue, t Topic) string {
	let subs = c.Subtopics(t.Name)
	if len(subs) == 0 {
		return t.Body
	}
	let mut names = []string{}
	for s in subs {
		names = names.Append(s.Name)
	}
	t.Body + "\n\nSubtopics: " + strings.Join(names, ", ") + " — run `okra how <subtopic>` for details."
}

// Message is the text of n, as okra writes it after the code NOT_FOUND.
func Message(n NotFound) string {
	"Unknown topic '" + n.Name + "'. Available topics: " + strings.Join(n.Known, ", ")
}
