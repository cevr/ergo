// The rules of `okra how` as laws over the domain.

import slices
import strings

// FindsEveryTopic: a catalogue of distinct names finds each topic by its
// name.
law FindsEveryTopic(names []string) {
	let c = Of(topicsNamed(names)) catch {
	case Duplicate:
		return !distinct(names)
	}
	for name in names {
		let t = c.Find(name) catch {
		case NotFound:
			return false
		}
		if t.Name != name || t.Body != "body of "+name {
			return false
		}
	}
	true
}

// MissNamesTheContents: a name that no topic has fails NotFound, which
// names it and every topic, in the order of the contents.
law MissNamesTheContents(names []string, name string) {
	if !distinct(names) || slices.Contains(names, name) {
		return true
	}
	let c = Of(topicsNamed(names)) catch {
	case Duplicate:
		return false
	}
	c.Find(name) catch {
	case NotFound as n:
		return n.Name == name && n.Known == names
	}
	false
}

// FrontMatterIsRemoved: a guide's body is its text after the front matter,
// trimmed, and its summary is the first sentence of the description.
law FrontMatterIsRemoved(description string, body string) {
	if strings.Contains(description, "\n") || strings.Contains(description, "\r") {
		return true
	}
	let t = Parse("t", "---\nname: t\ndescription: "+description+"\n---\n"+body)
	t.Body == strings.TrimSpace(body) && t.Summary == FirstSentence(strings.TrimSpace(description))
}

// FirstSentenceIsAPrefix: the first sentence of a text starts the text,
// trimmed.
law FirstSentenceIsAPrefix(text string) { strings.HasPrefix(strings.TrimSpace(text), FirstSentence(text)) }

// topicsNamed is a topic for each name, whose body is "body of " and the
// name.
func topicsNamed(names []string) []Topic {
	let mut out = []Topic{}
	for name in names {
		out = out.Append(Topic{Name: name, Summary: "", Body: "body of " + name})
	}
	out
}

// distinct reports whether no two names are equal.
func distinct(names []string) bool {
	for i, a in names {
		for j, b in names {
			if i != j && a == b {
				return false
			}
		}
	}
	true
}
