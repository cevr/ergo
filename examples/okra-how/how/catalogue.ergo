import cmp
import slices
import strings

// Catalogue is the topics of a library: in the order of the contents, and
// sorted by name for the search. Its fields are unexported, so only this
// package builds one, through Load or Of: a Catalogue never holds two
// topics of one name.
type Catalogue { order []Topic, names slices.Ascending[string], byName []Topic }

// NotFound is a topic name that no topic of the catalogue has. Known is
// every name, in the order of the contents.
type NotFound { Name string, Known []string }

// Duplicate is a name that two topics of a library share.
type Duplicate { Name string }

// Load reads every guide of the library in its context into a Catalogue.
func Load() Catalogue fails Unreadable | Duplicate needs Library {
	let mut topics = []Topic{}
	for name in Library.Names() {
		topics = topics.Append(Parse(name, try Library.Guide(name)))
	}
	try Of(topics)
}

// Of is the catalogue of topics, in their order. Two topics of one name
// fail Duplicate.
func Of(topics []Topic) Catalogue fails Duplicate {
	let mut names = []string{}
	for t in topics {
		names = names.Append(t.Name)
	}
	let sorted = slices.Ascend(names)
	let items = sorted.Items()
	for i in 1..len(items) {
		if items[i] == items[i-1] {
			return Duplicate{Name: items[i]}
		}
	}
	let byName = slices.SortFunc(topics, func(a Topic, b Topic) int { cmp.Compare(a.Name, b.Name) })
	Catalogue{order: topics, names: sorted, byName: byName}
}

// Topics is every topic of c, in the order of the contents.
func Topics(c Catalogue) []Topic { c.order }

// Names is the name of every topic of c, in the order of the contents.
func Names(c Catalogue) []string {
	let mut out = []string{}
	for t in c.order {
		out = out.Append(t.Name)
	}
	out
}

// Find is the topic of c named name: a binary search of the sorted names,
// which only an Ascending allows.
func Find(c Catalogue, name string) Topic fails NotFound {
	match slices.BinarySearch(c.names, name) {
	case Some[int] as at:
		c.byName[at.Value]
	case None:
		NotFound{Name: name, Known: c.Names()}
	}
}

// Subtopics is each topic of c nested under name by okra's convention, in
// the order of the contents: a topic x has the subtopics x-a, x-b and so
// on.
func Subtopics(c Catalogue, name string) []Topic {
	let mut out = []Topic{}
	for t in c.order {
		if strings.HasPrefix(t.Name, name+"-") {
			out = out.Append(t)
		}
	}
	out
}
