// Library is the contract of a store of guides: the operation type a
// program supplies in its context. Package files reads guides from a
// directory; package memory holds fixed ones for tests.
type Library {
	// Names is the name of each topic, in the order of the contents.
	Names() []string,
	// Guide is the whole text of the guide of a topic: its front matter
	// and its body.
	Guide(name string) string fails Unreadable,

	// The contents name each topic once, and every name is a word: the
	// catalogue finds a topic by its name, so two topics of one name
	// cannot both be found.
	law NamedOnce() { NamedOnce(Names()) },

	// With no writer, two reads of one guide agree.
	law GuideIsRepeatable(name string) {
		let first = try Guide(name)
		try Guide(name) == first
	},
}

// Unreadable is a guide that the store holds in its contents and cannot
// read. Reason is the store's text for it.
type Unreadable { Name string, Reason string }

// NamedOnce reports whether every name in names is not empty and no two
// are equal: the Library law, as a function that a provider's test calls.
func NamedOnce(names []string) bool {
	for i, a in names {
		if a == "" {
			return false
		}
		for j, b in names {
			if i != j && a == b {
				return false
			}
		}
	}
	true
}
