// Package files reads a shelf of guides from the file system. A provider
// of how.Library cannot need a capability that the contract's operations
// do not write (rows.md, Context 2), so files reads every guide once, at
// the start, into a memory.Shelf: okra embeds its guides in the binary,
// and the port reads them before it answers, as okra's build does.

import fs
import io
import okra/how
import okra/memory
import strings

// Read is the shelf of the guides in dir. The file dir/topics names the
// topics, one per line, in the order of the contents; a blank line is
// skipped. The file dir/NAME/SKILL.md is the guide of the topic NAME. A
// file that cannot be read fails how.Unreadable with its topic's name, or
// "topics" for the index.
func Read(dir string) memory.Shelf fails how.Unreadable needs fs.Files {
	let index = try text("topics", dir+"/topics")
	let mut entries = []memory.Entry{}
	for line in (io.Input{Text: index}).Lines() {
		let name = strings.TrimSpace(line)
		if name != "" {
			entries = entries.Append(memory.Entry{Name: name, Text: try text(name, dir+"/"+name+"/SKILL.md")})
		}
	}
	memory.Shelf{Entries: entries}
}

// text is the whole file at path; a failure names the topic name.
func text(name string, path string) string fails how.Unreadable needs fs.Files {
	fs.Files.ReadFile(path) catch {
	case fs.NotFound as n:
		return how.Unreadable{Name: name, Reason: "no file " + n.Path}
	case fs.Denied as d:
		return how.Unreadable{Name: name, Reason: "permission denied: " + d.Path}
	case fs.Failed as f:
		return how.Unreadable{Name: name, Reason: f.Path + ": " + f.Reason}
	}
}
