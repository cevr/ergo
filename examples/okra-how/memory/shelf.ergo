// Package memory holds the in-memory provider of the how contract.

import okra/how

// Entry is one guide on a shelf: its topic's name and its whole text.
type Entry { Name string, Text string }

// Shelf is a how.Library of guides held in memory, in the order of its
// entries. Package files reads one from a directory; a test writes one.
type Shelf { Entries []Entry }

// Names is the name of each entry, in order.
func Names(s Shelf) []string {
	let mut out = []string{}
	for e in s.Entries {
		out = out.Append(e.Name)
	}
	out
}

// Guide is the text of the first entry named name. A name of no entry
// fails how.Unreadable.
func Guide(s Shelf, name string) string fails how.Unreadable {
	for e in s.Entries {
		if e.Name == name {
			return e.Text
		}
	}
	how.Unreadable{Name: name, Reason: "the shelf holds no guide of this name"}
}
