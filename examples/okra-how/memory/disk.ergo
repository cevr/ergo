import filepath
import fs
import fstest

// File is one file of a test disk: its path and its text.
type File { Path string, Text string }

// Disk is a std fstest.Memory that holds files, each in its directory, so a
// test reads files with no host file system.
func Disk(files []File) fstest.Memory fails fs.NotFound | fs.Denied | fs.Failed {
	let m = fstest.NewMemory()
	for f in files {
		try m.MkdirAll(filepath.Dir(f.Path))
		try m.WriteFile(f.Path, f.Text)
	}
	m
}
