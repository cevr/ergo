import gen
import strings

// sortedInts is a drawn ascending list: each element is the last plus a
// drawn step of 0 to 9, from a drawn start of 0 to 9. A generator is a
// plain function that needs gen.Draws.
func sortedInts() []int needs gen.Draws {
	let steps = gen.ListOf(0, 12, func() int needs gen.Draws { gen.IntIn(0, 9) })
	let mut at = 0
	let mut xs = []int{}
	for s in steps {
		at = at + s
		xs = xs.Append(at)
	}
	xs
}

// showInts is xs as an Ergo literal, for the report.
func showInts(xs []int) string {
	let mut parts = []string{}
	for x in xs {
		parts = parts.Append("\(x)")
	}
	"[]int{\(strings.Join(parts, ", "))}"
}

// InsertKeepsOrder: inserting a drawn integer into a drawn ascending list
// gives an ascending list one longer. The body draws, so it runs under
// gen.Draws' harness, gen.Property: 100 seeded cases, and a failing case
// prints the failed assert, its seed, the shrunk xs and x, the drawn ones
// and the ergo test command that replays it.
test InsertKeepsOrder {
	let xs = gen.Named("xs", showInts, sortedInts)
	let x = gen.Named("x", func(v int) string { "\(v)" }, func() int needs gen.Draws { gen.IntIn(-5, 100) })
	let got = Insert(xs, x)
	assert IsSorted(got)
	assert len(got) == len(xs)+1
}

test InsertsInPlace {
	assert Insert([]int{1, 3, 5}, 4) == []int{1, 3, 4, 5}
}
