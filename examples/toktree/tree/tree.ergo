// Package tree builds the flat tree of bracket groups over a token stream,
// in the form the self-hosted compiler's syntax tree takes (wf10
// self-layout plan §2.2): one row per node in columns (kind, main token,
// child run), the child lists in one pool, children put before their
// parent so the root is the last row, and lists gathered on one scratch
// stack with marks. A leaf is a token that is not a comment or a bracket;
// a group is an open bracket and what it holds up to its close; an
// unclosed group closes at the end; the root holds the top level.

import dense
import toktree/token

// The kinds of a row.
let Leaf = 1
let Group = 2
let Root = 3

// Node is the row tag of the tree.
type Node {}

// Tree is the flat tree: row i is Kind, Tok and the child run of its id.
type Tree {
	ids  dense.Table[Node],
	kind dense.Col[Node, uint8],
	tok  dense.Col[Node, uint32],
	kids dense.Col[Node, dense.Run[dense.ID[Node]]],
	pool dense.Pool[dense.ID[Node]],
}

// Len is the number of rows.
func Len(tr Tree) int { dense.Len(tr.ids) }

// At is the id of row i.
func At(tr Tree, i int) dense.ID[Node] { dense.IDOf(tr.ids, i) }

// Kind is the kind of row id.
func Kind(tr Tree, id dense.ID[Node]) int { int(dense.Of(tr.kind, id)) }

// Tok is the index of row id's main token: a leaf's token, a group's open
// bracket, 0 for the root.
func Tok(tr Tree, id dense.ID[Node]) int { int(dense.Of(tr.tok, id)) }

// Kids is the children of row id, in order.
func Kids(tr Tree, id dense.ID[Node]) []dense.ID[Node] { dense.List(tr.pool, dense.Of(tr.kids, id)) }

// Pooled is the number of child ids in the pool.
func Pooled(tr Tree) int { dense.Items(tr.pool) }

// add puts one row and returns its id.
func add(tr *Tree, kind int, tok int, kids []dense.ID[Node]) dense.ID[Node] {
	let id = dense.Put(&tr.ids, Node)
	dense.Push(&tr.kind, uint8(kind))
	dense.Push(&tr.tok, uint32(tok))
	dense.Push(&tr.kids, dense.PutList(&tr.pool, kids))
	id
}

// Built is a tree and its deepest nesting.
type Built { Tree Tree, Depth int }

// Build is the tree of the tokens t. The scratch stack keeps its own top
// in an integer: a slice that shrinks (stack = stack[0:mark]) lowers to a
// copy today (OWN1; plan §2.3 point 1).
func Build(t token.Toks) Built {
	let mut tr = Tree{
		ids:  dense.New[Node](),
		kind: dense.NewCol[Node, uint8](),
		tok:  dense.NewCol[Node, uint32](),
		kids: dense.NewCol[Node, dense.Run[dense.ID[Node]]](),
		pool: dense.NewPool[dense.ID[Node]](),
	}
	let mut stack = []dense.ID[Node]{}
	let mut top = 0
	let mut marks = []int{}
	let mut opens = []int{}
	let mut open = 0
	let mut depth = 0
	let none = []dense.ID[Node]{}
	for i in 0..token.Len(t) {
		let k = token.Kind(t, token.At(t, i))
		if k == token.Comment {
			continue
		}
		if k == token.Open {
			if open < len(marks) {
				marks[open] = top
				opens[open] = i
			} else {
				marks = marks.Append(top)
				opens = opens.Append(i)
			}
			open = open + 1
			if open > depth {
				depth = open
			}
			continue
		}
		let id = if k == token.Close && open > 0 {
			open = open - 1
			let mark = marks[open]
			let g = add(&tr, Group, opens[open], stack[mark:top])
			top = mark
			g
		} else {
			add(&tr, Leaf, i, none)
		}
		if top < len(stack) {
			stack[top] = id
		} else {
			stack = stack.Append(id)
		}
		top = top + 1
	}
	for open > 0 {
		open = open - 1
		let mark = marks[open]
		let id = add(&tr, Group, opens[open], stack[mark:top])
		top = mark
		if top < len(stack) {
			stack[top] = id
		} else {
			stack = stack.Append(id)
		}
		top = top + 1
	}
	let _ = add(&tr, Root, 0, stack[0:top])
	Built{Tree: tr, Depth: depth}
}
