// The scanner's rules, over generated text of the bytes it treats apart.

// pieces are fragments whose concatenations reach every branch of Scan:
// whitespace, names, numbers, both comment forms (closed and not), the
// three string forms with escapes, brackets and punctuation.
let pieces = []string{" ", "\n", "\t", "ab_1", "Z", "42", "3.5e", "// c\n", "/* x */", "/* open", "\"s\\\"q\"", "'r'", "`raw`", "\"open\n", "(", ")", "[", "]", "{", "}", "+", "/", ";", "é"}

// Sample is the concatenation of the pieces picks names, each taken modulo
// the number of pieces.
func Sample(picks []int) string {
	let mut s = ""
	for p in picks {
		let k = if p < 0 { -(p % len(pieces)) } else { p % len(pieces) }
		s = s + pieces[k]
	}
	s
}

// StartsAdvance: the starts strictly increase, each is inside the text,
// and no token starts on whitespace.
law StartsAdvance(picks []int) {
	let src = Sample(picks)
	let t = Scan(src)
	let mut last = -1
	for i in 0..Len(t) {
		let s = Start(t, At(t, i))
		if s <= last || s >= len(src) {
			return false
		}
		let c = src[s]
		if c == 32 || c == 9 || c == 10 || c == 13 {
			return false
		}
		last = s
	}
	true
}

// BracketsAreTheirOwnTokens: every bracket byte outside a comment or a
// string is one token of kind Open or Close of length one.
law BracketsAreTheirOwnTokens(picks []int) {
	let src = Sample(picks)
	let t = Scan(src)
	for i in 0..Len(t) {
		let id = At(t, i)
		let k = Kind(t, id)
		if k == Open || k == Close {
			let c = src[Start(t, id)]
			let open = c == 40 || c == 91 || c == 123
			let close = c == 41 || c == 93 || c == 125
			if (k == Open && !open) || (k == Close && !close) {
				return false
			}
			let end = if i+1 < Len(t) { Start(t, At(t, i+1)) } else { len(src) }
			for j in Start(t, id)+1..end {
				let d = src[j]
				if d != 32 && d != 9 && d != 10 && d != 13 {
					return false
				}
			}
		}
	}
	true
}
