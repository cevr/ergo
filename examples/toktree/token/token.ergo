// Package token scans source text into two token columns, kind and start,
// in the form of Zig's tokenizer: no end and no text are kept, and a
// token's text is found by scanning again from its start. It is the
// SELFLAYOUT prototype's scanner (wf10 self-layout plan §2.3), a byte-class
// scanner for Ergo-like text: identifiers, numbers, strings, runes,
// comments, brackets and punctuation. It is not Ergo's grammar.

import dense

// The kinds of a token.
let Comment = 1
let Ident = 2
let Number = 3
let String = 4
let Rune = 5
let Open = 6
let Close = 7
let Punct = 8

// Tok is the row tag of tokens.
type Tok {}

// Toks is the token stream as columns: token i is Kind of its id and Start
// of its id, the offset of its first byte.
type Toks {
	ids   dense.Table[Tok],
	kind  dense.Col[Tok, uint8],
	start dense.Col[Tok, uint32],
}

// Len is the number of tokens.
func Len(t Toks) int { dense.Len(t.ids) }

// At is the id of the token at index i.
func At(t Toks, i int) dense.ID[Tok] { dense.IDOf(t.ids, i) }

// Kind is the kind of token id.
func Kind(t Toks, id dense.ID[Tok]) int { int(dense.Of(t.kind, id)) }

// Start is the offset of token id's first byte.
func Start(t Toks, id dense.ID[Tok]) int { int(dense.Of(t.start, id)) }

func isIdentStart(c byte) bool {
	c >= 97 && c <= 122 || c >= 65 && c <= 90 || c == 95
}

func isDigit(c byte) bool { c >= 48 && c <= 57 }

// Scan is the tokens of src.
func Scan(src string) Toks {
	let mut t = Toks{ids: dense.New[Tok](), kind: dense.NewCol[Tok, uint8](), start: dense.NewCol[Tok, uint32]()}
	let n = len(src)
	let mut i = 0
	for i < n {
		let c = src[i]
		if c == 32 || c == 9 || c == 10 || c == 13 {
			i = i + 1
			continue
		}
		let start = i
		let mut kind = uint8(Punct)
		if isIdentStart(c) {
			kind = uint8(Ident)
			i = i + 1
			for i < n && (isIdentStart(src[i]) || isDigit(src[i])) {
				i = i + 1
			}
		} else if isDigit(c) {
			kind = uint8(Number)
			i = i + 1
			for i < n && (isIdentStart(src[i]) || isDigit(src[i]) || src[i] == 46) {
				i = i + 1
			}
		} else if c == 47 && i+1 < n && src[i+1] == 47 {
			kind = uint8(Comment)
			i = i + 2
			for i < n && src[i] != 10 {
				i = i + 1
			}
		} else if c == 47 && i+1 < n && src[i+1] == 42 {
			kind = uint8(Comment)
			i = i + 2
			for i < n && !(src[i] == 42 && i+1 < n && src[i+1] == 47) {
				i = i + 1
			}
			if i < n {
				i = i + 2
			}
		} else if c == 34 || c == 39 {
			kind = if c == 39 { uint8(Rune) } else { uint8(String) }
			i = i + 1
			for i < n && src[i] != c && src[i] != 10 {
				if src[i] == 92 && i+1 < n {
					i = i + 1
				}
				i = i + 1
			}
			if i < n && src[i] == c {
				i = i + 1
			}
		} else if c == 96 {
			kind = uint8(String)
			i = i + 1
			for i < n && src[i] != 96 {
				i = i + 1
			}
			if i < n {
				i = i + 1
			}
		} else if c == 40 || c == 91 || c == 123 {
			kind = uint8(Open)
			i = i + 1
		} else if c == 41 || c == 93 || c == 125 {
			kind = uint8(Close)
			i = i + 1
		} else {
			i = i + 1
		}
		let _ = dense.Put(&t.ids, Tok)
		dense.Push(&t.kind, kind)
		dense.Push(&t.start, uint32(start))
	}
	t
}
