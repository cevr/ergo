import http
import jobs/api/endpoint
import jobs/jobs
import json

// Endpoint carries only a route's identity; Jobs declares what it asks and
// answers. Handle calls Jobs in its context, so this is the served contract.
type Endpoint = endpoint.Endpoint

// Jobs is the job queue's public application contract. Failures declares
// the HTTP status of each type of its failure rows.
type Jobs {
	ListJobs() Listing,
	SubmitJob(draft Draft) View fails BadBody,
	ShowJob(id int) View fails jobs.NotFound,
	CancelJob(id int) View fails jobs.NotFound | jobs.Conflict,
	DeleteJob(id int) fails jobs.NotFound | jobs.Conflict,

	// EmptyNameIsBadBody applies to every provider, not only the HTTP adapter.
	// DraftOf already refuses an empty name before Handle calls Jobs, so the
	// HTTP model cannot catch a provider that forgets this validation.
	law EmptyNameIsBadBody(priority int) {
		SubmitJob(Draft{Name: "", Priority: json.Present[int]{Value: priority}}) catch {
		case BadBody as bad:
			return bad.Field == "name"
		}
		false
	},
}

// Routes is shared by http.Match and the TypeScript content mapper. Every
// endpoint occurs exactly once, checked by the mapper and RoutesCoverEndpoints.
let Routes = []http.Route[Endpoint]{
	http.Route{Value: endpoint.ListJobs, Method: "GET", Path: "/jobs", Status: 200},
	http.Route{Value: endpoint.SubmitJob, Method: "POST", Path: "/jobs", Status: 201},
	http.Route{Value: endpoint.ShowJob, Method: "GET", Path: "/jobs/:id", Status: 200},
	http.Route{Value: endpoint.CancelJob, Method: "POST", Path: "/jobs/:id/cancel", Status: 200},
	http.Route{Value: endpoint.DeleteJob, Method: "DELETE", Path: "/jobs/:id", Status: 204},
}

// Endpoints is every endpoint, independent of the route table. A new variant
// is generated for this law, so a missing or repeated route refutes it.
law RoutesCoverEndpoints(e Endpoint) {
	let mut count = 0
	for route in Routes {
		if route.Value == e { count = count + 1 }
	}
	count == 1
}
