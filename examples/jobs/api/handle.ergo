import fs
import http
import jobs/api/endpoint
import jobs/jobs
import json
import strconv
import strings

// BadId is a path id that is not a job id: not a whole number above 0.
type BadId { Text string }

// WrongMethod is a request whose path a route takes with other methods,
// Allow. http.Match and http.Body give a request no route takes, a body
// over the limit and one that could not be read as values (http.NotFound,
// http.BodyTooLarge, http.BodyReadFailed); the api's rows name them, so
// here they are failures of their own types.
type WrongMethod { Allow string }

// Handle answers r from Jobs in the context. answer
// fails with every refusal by its type. The total catch names transport
// refusals explicitly; contract failures use Failures, the shared table.
// A new unhandled failure stops the build; a missing contract status also
// refutes the example law and is a TypeScript projection diagnostic.
//
//	400 a body that is not JSON, or that could not be read
//	404 no such route, or no such job
//	405 a known path with another method (Allow lists the methods)
//	409 a cancel or a delete the job's state does not allow
//	413 a body over MaxBody
//	422 JSON of the wrong shape, or an empty name
func Handle(r http.Request) http.Response needs Jobs {
	answer(r) catch {
	case http.NotFound:
		Refuse(404, "no route "+r.Method+" "+r.Path)
	case WrongMethod as w:
		let p = Refuse(405, r.Method+" is not allowed on "+r.Path)
		http.Response{..p, Header: p.Header.Append(http.Field{Name: "Allow", Value: w.Allow})}
	case http.BodyTooLarge as b:
		Refuse(413, "the body is over \(b.Limit) bytes")
	case http.BodyReadFailed as f:
		Refuse(400, "the body could not be read: "+f.Reason)
	case json.Malformed as m:
		Refuse(400, "the body is not JSON: \(m.Reason) at byte \(m.Offset)")
	case BadBody as b:
		Failure(contractFailure{Error: b})
	case BadId as b:
		Refuse(404, "no job "+b.Text)
	case jobs.NotFound as n:
		Failure(contractFailure{Error: n})
	case jobs.Conflict as c:
		Failure(contractFailure{Error: c})
	}
}

func Failure(f contractFailure) http.Response {
	http.Failure(Failures, json.Encode(json.Codec[BadBody | jobs.NotFound | jobs.Conflict]{MaxBytes: 0, MaxDepth: 0}, f.Error))
}

// answer is the response to r, or the refusal that stops it.
func answer(r http.Request) http.Response fails http.NotFound | WrongMethod | http.BodyTooLarge | http.BodyReadFailed | json.Malformed | BadBody | BadId | jobs.NotFound | jobs.Conflict needs Jobs {
	match http.Match(Routes, r.Method, r.Path) {
	case http.NotFound as n:
		return n
	case http.MethodNotAllowed as m:
		return WrongMethod{Allow: strings.Join(m.Allow, ", ")}
	case http.Found as f:
		match f.Route.Value {
		case endpoint.ListJobs:
			http.Success(f.Route, ListingText(Jobs.ListJobs()))
		case endpoint.SubmitJob:
			let d = try DraftOf(try textOf(r.Body))
			let j = try Jobs.SubmitJob(d)
			let created = http.Success(f.Route, ViewText(j))
			http.Response{..created, Header: created.Header.Append(http.Field{Name: "Location", Value: "/jobs/\(j.Id)"})}
		case endpoint.ShowJob:
			http.Success(f.Route, ViewText(try Jobs.ShowJob(try idOf(f))))
		case endpoint.CancelJob:
			http.Success(f.Route, ViewText(try Jobs.CancelJob(try idOf(f))))
		case endpoint.DeleteJob:
			try Jobs.DeleteJob(try idOf(f))
			http.Success(f.Route, "")
		}
	}
}

// idOf is the job id of f's path.
func idOf(f http.Found[Endpoint]) int fails BadId {
	let text = match f.Params.Get("id") {
	case Some[string] as s:
		s.Value
	case None:
		""
	}
	let id = strconv.Atoi(text) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return BadId{Text: text}
	}
	if id < 1 || strconv.Itoa(id) != text {
		return BadId{Text: text}
	}
	id
}

// textOf is a buffered body's text; a body over the limit or one that
// could not be read is its refusal.
func textOf(b http.Body) string fails http.BodyTooLarge | http.BodyReadFailed {
	match b {
	case http.Buffered as t:
		t.Text
	case http.BodyTooLarge as l:
		l
	case http.BodyReadFailed as f:
		f
	}
}

// Respond is a response of status with the JSON body text.
func Respond(status int, text string) http.Response {
	http.Response{Status: status, Header: []http.Field{http.Field{Name: "Content-Type", Value: "application/json"}}, Body: text}
}

// Refuse is a refusal: status, and {"error": message}.
func Refuse(status int, message string) http.Response { Respond(status, ProblemText(Problem{Error: message})) }

// WithSite answers a path under /jobs with Handle, and any other path
// with a file of site: "/" is "/index.html". http.Files reads through the
// root, so no request path reaches outside it.
func WithSite(site fs.Root, r http.Request) http.Response needs Jobs {
	if r.Path == "/jobs" || strings.HasPrefix(r.Path, "/jobs/") {
		return Handle(r)
	}
	let page = if r.Path == "/" { http.Request{..r, Path: "/index.html"} } else { r }
	http.Files(site, "/", page)
}
