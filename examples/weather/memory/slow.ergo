import weather/weather

// Slow is a weather.Forecast that answers as Stations does, after Wait
// returns: main's Wait sleeps on the script's clock, so a screen shows
// the lookup loading until the script moves the clock.
type Slow { Wait func() } implements weather.Forecast

func Fetch(s Slow, zip string) weather.Report fails weather.NotFound | weather.Unavailable {
	s.Wait()
	try fetchStation(zip)
}
