// Package script plays a script of form events on the weather lookup's
// screen (stage b), on std ui's test host over the manual clock main
// binds, and shows the screen after each one.

import actor
import machines
import weather/screen
import weather/weather
import io
import strconv
import strings
import time
import ui

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Line is a read line: its text and what it does.
type Line { Text string, Do Do }

// Do is what a line does: an act on the screen, or a count of the act
// before it.
type Do = Act{Act ui.Act} | Stats

// Stats is the line `stats`.
type Stats {}

// Read reads the lines of a script. A line is one of:
//   - `type TEXT`: fill the zip field with TEXT (the rest of the line,
//     possibly empty);
//   - `submit`: click the button Get Weather;
//   - `click LABEL`: click the one button named LABEL;
//   - `wait MS`: move the clock MS milliseconds, so a fetch that waits on
//     it answers, and settle;
//   - `stats`: print the work of the act before it.
//
// A blank line or a line that starts with # is skipped.
func Read(lines []string) []Line fails BadLine {
	let mut out = []Line{}
	for i, line in lines {
		let n = i + 1
		let text = strings.TrimSpace(line)
		if text == "" || strings.HasPrefix(text, "#") {
			continue
		}
		let do Do = if text == "submit" {
			Act{Act: ui.ClickOn{At: button(screen.AskLabel)}}
		} else if text == "stats" {
			Stats
		} else if text == "type" || strings.HasPrefix(text, "type ") {
			// The draft keeps the spaces after the one that ends the word.
			let draft = strings.TrimPrefix(strings.TrimPrefix(text, "type"), " ")
			Act{Act: ui.FillIn{At: ui.WithPlaceholder{Text: screen.Placeholder}, Text: draft}}
		} else if strings.HasPrefix(text, "click ") {
			Act{Act: ui.ClickOn{At: button(strings.TrimPrefix(text, "click "))}}
		} else if strings.HasPrefix(text, "wait ") {
			let ms = strconv.Atoi(strings.TrimPrefix(text, "wait ")) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return BadLine{Line: n, Why: "wait takes milliseconds"}
			}
			Act{Act: ui.AdvanceBy{By: time.Times(1ms, ms)}}
		} else {
			return BadLine{Line: n, Why: "a line is type TEXT, submit, click LABEL, wait MS or stats"}
		}
		out = out.Append(Line{Text: text, Do: do})
	}
	out
}

func button(label string) ui.Locator { ui.WithRole{Role: ui.Button, Name: label} }

// Host is the lookup on the test host.
type Host = ui.TestHost[weather.Lookup, weather.Signal, machines.Decision[weather.Lookup, weather.Never]]

// Run reads the script from io.Stdin and plays it on the screen, on std
// ui's test host over clock, with the Forecast of its context. It shows
// the screen first and after each line: `> LINE`, then the screen in a
// line. An act whose locator finds no node, or more than one, does
// nothing and says so, as a scene that names no node fails. It returns the
// exit status: 0, or 1 when the script is refused or the screen fails.
func Run(clock time.Manual) int needs io.Console | io.Stdin | time.Scheduler | weather.Forecast {
	let mut lines = []string{}
	for line in io.Stdin.Lines() {
		lines = lines.Append(line)
	}
	let script = Read(lines) catch {
	case BadLine as b:
		io.Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let app = actor.StartMachine(weather.Weather{}, 8, func(o weather.Never) {})
	let status = play(app, clock, script) catch {
	case actor.Stopped:
		io.Console.Println("? the lookup stopped")
		1
	case ui.BadPatch as p:
		io.Console.Println("? a patch is refused: \(p.Why)")
		1
	}
	app.Stop()
	status
}

func play(app actor.Actor[weather.Lookup, weather.Signal, machines.Decision[weather.Lookup, weather.Never]], clock time.Manual, script []Line) int fails actor.Stopped | ui.BadPatch needs io.Console {
	let mut h = try ui.NewTestHost(app, screen.Screen, clock, 8)
	io.Console.Println(Shown(&h))
	for x in script {
		io.Console.Println("> \(x.Text)")
		match x.Do {
		case Act as a:
			ui.Play(&h, []ui.Act{a.Act, ui.SettleAll}) catch {
			case ui.NoNode as no:
				io.Console.Println("? no node: \(no.Label)")
				continue
			case ui.Ambiguous as m:
				io.Console.Println("? \(m.Count) nodes: \(m.At)")
				continue
			case ui.Mismatch:
				continue
			case actor.Stopped as s:
				return s
			case ui.BadPatch as p:
				return p
			}
			io.Console.Println(Shown(&h))
		case Stats:
			io.Console.Println("stats: \(ui.CountsLine(ui.Counts(&h)))")
		}
	}
	0
}

// Shown is the screen in a line, in screen order: the zip field as
// <VALUE>, each button as [LABEL] ([LABEL, disabled] in a disabled
// fieldset), each heading as # NAME, each other named region as
// NAME{...}, and each text.
func Shown(h mut Host) string { strings.Join(tokens(ui.Screen(h), false), " ") }

func tokens(shapes []ui.Shape[weather.Signal], off bool) []string {
	let mut out = []string{}
	for s in shapes {
		match s.Node {
		case ui.TextNode as t:
			out = out.Append(t.Value)
		case ui.InputNode as i:
			out = out.Append("<\(i.Value)>")
		case ui.PressableNode as p:
			out = out.Append(if off { "[\(p.Label), disabled]" } else { "[\(p.Label)]" })
		case ui.FieldsetNode as fs:
			for t in tokens(s.Kids, off || fs.Disabled) {
				out = out.Append(t)
			}
		case ui.SemanticNode as g:
			match g.Access.Role {
			case ui.Heading:
				out = out.Append("# \(g.Access.Name)")
			case _:
				out = out.Append("\(g.Access.Name){\(strings.Join(tokens(s.Kids, off), " "))}")
			}
		case _:
			for t in tokens(s.Kids, off) {
				out = out.Append(t)
			}
		}
	}
	out
}
