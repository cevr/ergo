// Package script runs the stopwatch over a script of timed button presses
// on the time.Clock and Scheduler of its context (main binds a virtual
// clock), and shows the watch after each press and at the end.

import fkstopwatch/watch
import io
import machines
import strconv
import strings
import time

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Script is a read script: the presses at their times, and the time the
// run ends.
type Script { Trace []machines.Timed[watch.Button], End duration }

// Read reads the lines of a script. Each line is `@MS WORD`: MS is the
// time in milliseconds from the start, never earlier than the line before,
// and WORD is start, stop, reset or end. The line `@MS end` ends the run
// at MS and must be the last. A blank line or a line that starts with # is
// skipped.
func Read(lines []string) Script fails BadLine {
	let mut trace = []machines.Timed[watch.Button]{}
	let mut last = 0s
	for i, line in lines {
		let n = i + 1
		let text = strings.TrimSpace(line)
		let words = strings.Fields(text)
		if len(words) == 0 || strings.HasPrefix(text, "#") {
			continue
		}
		if len(words) != 2 || !strings.HasPrefix(words[0], "@") {
			return BadLine{Line: n, Why: "a line is @MS WORD"}
		}
		let t = try millis(n, strings.TrimPrefix(words[0], "@"))
		if t < last {
			return BadLine{Line: n, Why: "the time goes back"}
		}
		last = t
		let s = match words[1] {
		case "end":
			return Script{Trace: trace, End: t}
		case "start":
			watch.Start
		case "stop":
			watch.Stop
		case "reset":
			watch.Reset
		case _:
			return BadLine{Line: n, Why: "unknown word \(words[1])"}
		}
		trace = trace.Append(machines.Timed[watch.Button]{At: t, Signal: s})
	}
	BadLine{Line: len(lines) + 1, Why: "the script has no @MS end line"}
}

func millis(n int, word string) duration fails BadLine {
	let v = strconv.Atoi(word) catch {
	case strconv.Malformed:
		return BadLine{Line: n, Why: "\(word) is not a number of milliseconds"}
	case strconv.OutOfRange:
		return BadLine{Line: n, Why: "\(word) is out of range"}
	}
	if v < 0 || v > 86400000 {
		return BadLine{Line: n, Why: "a time is 0 to 86400000 milliseconds"}
	}
	time.Times(1ms, v)
}

// Run reads the script from io.Stdin and shows the watch after each press
// and at the end: `@MS MM:SS.cc running|stopped`. It returns the exit
// status: 0, or 1 when the script is refused.
func Run() int needs Console | io.Stdin | time.Clock | Scheduler {
	let mut lines = []string{}
	for line in io.Stdin.Lines() {
		lines = lines.Append(line)
	}
	let s = Read(lines) catch {
	case BadLine as b:
		Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let mut part = []machines.Timed[watch.Button]{}
	for x in s.Trace {
		part = part.Append(x)
		show(x.At, watch.Replay(part, x.At))
	}
	show(s.End, watch.Replay(s.Trace, s.End))
	0
}

func show(t duration, w watch.Watch) needs Console {
	let mode = if watch.IsRunning(w) { "running" } else { "stopped" }
	Console.Println("@\(time.Count(t, 1ms)) \(watch.Format(watch.ElapsedOf(w))) \(mode)")
}
