# start, run 1.234s, stop between two ticks: the watch keeps 1.23s
@0 start
@1234 stop
# a stop while stopped is ignored
@1500 stop
# start again from 1.23s; a start while running keeps the tick going
@2000 start
@2005 start
@2777 stop
@3000 reset
@3000 start
# a stop at the very time of a tick is stepped before it: 0.09s, not 0.10s
@3100 stop
@3500 start
@65432 end
