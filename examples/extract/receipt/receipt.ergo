// Package receipt is the value extract reads out of a document: a
// receipt's merchant, items, total and payment, as its derived JSON codec
// writes them. Its schema, in receipt/receiptschema, is what ergo gen
// schema writes for Receipt, so the schema a model is asked for and the
// JSON the program reads are one form.

import json

// Receipt is one purchase. Amounts are in cents, so a total is exact.
type Receipt { Merchant string, Items []Item, Total int, Paid Payment, Note json.Optional[string] }

// Item is one line of a receipt: Count of Name at Cents each.
type Item { Name string, Count int, Cents int }

// Payment is how the receipt was paid: a card, by the last four digits a
// receipt prints, or cash.
type Payment = Card{Last4 string} | Cash{}

// Problem is a receipt that reads but does not add up: its total is not
// the sum of its items, or it has no items.
type Problem = TotalMismatch{Total int, Sum int} | NoItems{}

// Sum is what the items add up to, in cents.
func Sum(items []Item) int {
	let mut s = 0
	for i in items {
		s = s + i.Count*i.Cents
	}
	s
}

// Check is every problem of r, in a fixed order: no items, then a total
// that is not the items' sum.
func Check(r Receipt) []Problem {
	let mut ps = []Problem{}
	if len(r.Items) == 0 {
		ps = ps.Append(NoItems)
	}
	let s = Sum(r.Items)
	if s != r.Total {
		ps = ps.Append(TotalMismatch{Total: r.Total, Sum: s})
	}
	ps
}

// CheckFindsTheTotal: a receipt whose total is its items' sum has no
// mismatch, and moving the total by any amount but zero makes one that
// names both numbers.
law CheckFindsTheTotal(r Receipt, off int) {
	let fixed = Receipt{Merchant: r.Merchant, Items: r.Items, Total: Sum(r.Items), Paid: r.Paid, Note: r.Note}
	let moved = Receipt{Merchant: r.Merchant, Items: r.Items, Total: Sum(r.Items) + off, Paid: r.Paid, Note: r.Note}
	mismatch(Check(fixed)) == None && (off == 0 || mismatch(Check(moved)) == Some{Value: TotalMismatch{Total: Sum(r.Items) + off, Sum: Sum(r.Items)}})
}

// mismatch is the total mismatch among ps, if any.
func mismatch(ps []Problem) Option[TotalMismatch] {
	for p in ps {
		match p {
		case TotalMismatch as m:
			return Some{Value: m}
		case NoItems:
		}
	}
	None
}

// Describe is a problem as the program prints it.
func Describe(p Problem) string {
	match p {
	case TotalMismatch as m:
		"the total \(Money(m.Total)) is not the items' sum \(Money(m.Sum))"
	case NoItems:
		"no items"
	}
}

// Money is cents as dollars and cents: 1234 is "12.34", -5 is "-0.05".
func Money(cents int) string {
	let sign = if cents < 0 { "-" } else { "" }
	let c = if cents < 0 { -cents } else { cents }
	let rest = c % 100
	let pad = if rest < 10 { "0" } else { "" }
	"\(sign)\(c / 100).\(pad)\(rest)"
}

// Paid is a payment as the program prints it.
func Paid(p Payment) string {
	match p {
	case Card as c:
		"card ending \(c.Last4)"
	case Cash:
		"cash"
	}
}
