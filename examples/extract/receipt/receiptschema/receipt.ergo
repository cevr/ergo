import json
import jsonschema
import extract/receipt

// Receipt is the JSON schema of receipt.Receipt's wire form: the JSON its derived
// codec writes and reads.
func Receipt() jsonschema.Schema { receiptSchema }

let receiptSchema = parseReceipt()

func parseReceipt() jsonschema.Schema {
	jsonschema.Parse("{\"type\":\"object\",\"properties\":{\"merchant\":{\"type\":\"string\"},\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"count\":{\"type\":\"integer\"},\"cents\":{\"type\":\"integer\"}},\"required\":[\"name\",\"count\",\"cents\"]}},\"total\":{\"type\":\"integer\"},\"paid\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Card\"},\"last4\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"last4\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Cash\"}},\"required\":[\"_tag\"]}]},\"note\":{\"type\":\"string\"}},\"required\":[\"merchant\",\"items\",\"total\",\"paid\"]}") catch {
	case jsonschema.Invalid:
		Unreachable("ergo gen schema writes a schema")
	}
}

// ReceiptValuesFitTheSchema: the JSON the codec writes for any receipt.Receipt fits
// Receipt().
law ReceiptValuesFitTheSchema(v receipt.Receipt) {
	let written = json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, json.Encode(json.Codec[receipt.Receipt]{MaxBytes: 0, MaxDepth: 0}, v)) catch {
	case _:
		return false
	}
	jsonschema.Conforms(Receipt(), written)
}
