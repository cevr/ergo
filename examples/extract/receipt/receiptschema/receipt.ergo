import json
import jsonschema
import extract/receipt

func Receipt() jsonschema.Schema { receiptSchema }

let receiptSchema = jsonschema.Object([]jsonschema.Prop{jsonschema.Prop{Key: "merchant", Schema: jsonschema.String()}, jsonschema.Prop{Key: "items", Schema: jsonschema.Array(jsonschema.Object([]jsonschema.Prop{jsonschema.Prop{Key: "name", Schema: jsonschema.String()}, jsonschema.Prop{Key: "count", Schema: jsonschema.Integer()}, jsonschema.Prop{Key: "cents", Schema: jsonschema.Integer()}}, []string{"name", "count", "cents"}))}, jsonschema.Prop{Key: "total", Schema: jsonschema.Integer()}, jsonschema.Prop{Key: "paid", Schema: jsonschema.AnyOf(jsonschema.Object([]jsonschema.Prop{jsonschema.Prop{Key: "_tag", Schema: jsonschema.ConstString("Card")}, jsonschema.Prop{Key: "last4", Schema: jsonschema.String()}}, []string{"_tag", "last4"}), []jsonschema.Schema{jsonschema.Object([]jsonschema.Prop{jsonschema.Prop{Key: "_tag", Schema: jsonschema.ConstString("Cash")}}, []string{"_tag"})})}, jsonschema.Prop{Key: "note", Schema: jsonschema.String()}}, []string{"merchant", "items", "total", "paid"})

law ReceiptValuesFitTheSchema(v receipt.Receipt) {
	let written = json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, json.Encode(json.Codec[receipt.Receipt]{MaxBytes: 0, MaxDepth: 0}, v)) catch {
	case _:
		return false
	}
	jsonschema.Conforms(Receipt(), written)
}
