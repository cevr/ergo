// record writes the recording extract replays for one document:
//
//	record DOCUMENT REPLY [length]
//
// It asks for the receipt in DOCUMENT as extract does, through
// recorded.Record over a model that says the text of REPLY (and stops at
// its length with "length"), and prints the recording's lines. The
// replies under testdata are written in the shapes models give: in a
// fence, in prose, with comments, trailing commas, single quotes, cut
// short. With a real provider bound in place of the canned reply, the same
// program records a real model once.

import extract/reader
import fs
import io
import llm
import llm/memory
import llm/recorded
import os

func load(file string) string fails os.Exit needs fs.Files {
	fs.Files.ReadFile(file) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return os.Exit{Code: 2, Message: "record: cannot read \(file)"}
	}
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), io.Stdout: io.NewHost() } {
		let args = os.Process.Args()
		if len(args) != 2 && !(len(args) == 3 && args[2] == "length") {
			return os.Exit{Code: 2, Message: "usage: record DOCUMENT REPLY [length]"}
		}
		let stop llm.Stop = if len(args) == 3 { llm.Length } else { llm.Ended }
		let reply = memory.Says{Deltas: []llm.Delta{llm.Text{Text: try load(args[1])}}, Stop: stop, Usage: llm.Usage{Input: 0, Output: 0, CacheRead: 0, CacheWrite: 0}}
		let rec = recorded.NewRecord(memory.NewSequence([]memory.Reply{reply}))
		with context { llm.Model: rec } {
			let _ = reader.Read(try load(args[0]))
		}
		io.Stdout.Print(recorded.Lines(rec))
	}
}
