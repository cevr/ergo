// The decoder's tests: a whole configuration, the defaults, each failure
// with its place and the variables. The laws run under ergo test.

import confparse/toml

let sample = "name = \"edge\"\n\n[listen]\nhost = \"0.0.0.0\"\nport = 8080\n\n[log]\nlevel = \"warn\"\n\n[[upstream]]\nname = \"a\"\naddr = \"10.0.0.1:9000\"\nweight = 5\n\n[[upstream]]\nname = \"b\"\naddr = \"10.0.0.2:9000\"\nbackup = true\n"

func decoded(text string, env Map[string, string]) Config fails toml.Problem | Problem {
	Decode(try toml.Parse(text), env)
}

test DecodesAWholeFile {
	let c = try decoded(sample, Map[string, string]{})
	assert c.Name == "edge" && c.Listen == Listen{Host: "0.0.0.0", Port: 8080}
	assert Wire(c.Log) == "warn"
	assert len(c.Upstreams) == 2
	assert c.Upstreams[0] == Upstream{Name: "a", Addr: "10.0.0.1:9000", Weight: 5, Backup: false}
	assert c.Upstreams[1] == Upstream{Name: "b", Addr: "10.0.0.2:9000", Weight: 1, Backup: true}
}

test FillsTheDefaults {
	let c = try decoded("name = 'x'\n[listen]\nport = 1\n", Map[string, string]{})
	assert c.Listen.Host == "127.0.0.1"
	assert Wire(c.Log) == "info"
	assert len(c.Upstreams) == 0
}

test VariablesWin {
	let env = Map[string, string]{"CONFPARSE_LISTEN_PORT": "9090", "CONFPARSE_LOG_LEVEL": "debug", "CONFPARSE_NAME": "from env"}
	let c = try decoded(sample, env)
	assert c.Listen.Port == 9090 && Wire(c.Log) == "debug" && c.Name == "from env"
	let only = try decoded("name = 'x'\n", Map[string, string]{"CONFPARSE_LISTEN_PORT": "443"})
	assert only.Listen == Listen{Host: "127.0.0.1", Port: 443}
}

// problem is the place and text of what is wrong with text under env,
// or "ok".
func problem(text string, env Map[string, string]) string {
	let d = toml.Parse(text) catch {
	case err:
		let p = toml.PosOf(err)
		return "f:\(p.Line):\(p.Column): \(toml.Describe(err))"
	}
	let _ = Decode(d, env) catch {
	case err:
		return Place("f", Where(err)) + ": " + Describe(err)
	}
	"ok"
}

func none() Map[string, string] { Map[string, string]{} }

test FailuresNameTheirPlace {
	assert problem("", none()) == "f:1:1: name is required"
	assert problem("name = 'x'", none()) == "f:1:1: port is required in [listen]"
	assert problem("name = 'x'\n\n[listen]\nhost = 'h'", none()) == "f:3:1: port is required in [listen]"
	assert problem("name = 1", none()) == "f:1:8: name must be a string, not an integer"
	assert problem("name = 'x'\n[listen]\nport = '80'", none()) == "f:3:8: port must be an integer, not a string"
	assert problem("name = 'x'\n[listen]\nport = 0", none()) == "f:3:8: port = 0 is not a Port, where 1 <= it && it <= 65535"
	assert problem("name = 'x'\n[listen]\nprot = 80", none()) == "f:3:1: unknown key prot in [listen]"
	assert problem("name = 'x'\n[listn]\nport = 80", none()) == "f:2:1: unknown table [listn]"
	assert problem("name = 'x'\n[[listen]]\nport = 80", none()) == "f:2:1: unknown table [[listen]]"
	assert problem("name = 'x'\n[upstream]\nname = 'a'", none()) == "f:2:1: unknown table [upstream]"
	assert problem("name = 'x'\n[listen]\nport = 80\n[log]\nlevel = 'loud'", none()) == "f:5:9: level = \"loud\" is not one of debug, info, warn, error"
	assert problem("name = 'x'\n[listen]\nport = 80\n[[upstream]]\nname = 'a'\naddr = 'h'\nweight = 101", none()) == "f:7:10: weight = 101 is not a Weight, where 1 <= it && it <= 100"
	assert problem("name = 'x'\n[listen]\nport = 80\n[[upstream]]\nname = 'a'\naddr = 'h'\nbackup = 'no'", none()) == "f:7:10: backup must be a boolean, not a string"
	assert problem("name = 'x'\n[listen]\nport = 80\n[[upstream]]\nname = 'a'\naddr = 'h'\n[[upstream]]\nname = 'a'\naddr = 'i'", none()) == "f:7:1: upstream \"a\" is already defined at line 4"
	assert problem("name = 'x'\n[listen]\nport = 80\n[[upstream]]\nname = 'a'", none()) == "f:4:1: addr is required in [upstream]"
	assert problem("name = 'x'\nport = 80", none()) == "f:2:1: unknown key port"
	assert problem("name = 'x'", Map[string, string]{"CONFPARSE_LISTEN_PORT": "eighty"}) == "f: $CONFPARSE_LISTEN_PORT: port must be an integer, not \"eighty\""
	assert problem("name = 'x'", Map[string, string]{"CONFPARSE_LISTEN_PORT": "70000"}) == "f: $CONFPARSE_LISTEN_PORT: port = 70000 is not a Port, where 1 <= it && it <= 65535"
	assert problem("name = 'x'\n[listen]\nport = 1", Map[string, string]{"CONFPARSE_LOG_LEVEL": "trace"}) == "f: $CONFPARSE_LOG_LEVEL: level = \"trace\" is not one of debug, info, warn, error"
	assert problem("name = 'x'\n[listen]\nport = 1\nname = 2", none()) == "f:4:1: unknown key name in [listen]"
}

// The samples are Valid, so the laws check the round trip on each.
test SamplesAreValid(seed int) {
	assert Valid(Sample(seed))
}
