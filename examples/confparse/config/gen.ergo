// Gen builds configurations from Random; Sample binds Random to
// rand.Seeded(seed), so the laws that take a seed replay from it.

import rand

let hosts = []string{"127.0.0.1", "0.0.0.0", "::", "proxy.local", "with \"quote\"", ""}
let ports = []Port{1, 80, 443, 8080, 65535}
let weights = []Weight{1, 2, 5, 10, 25, 50, 75, 99, 100}
let names = []string{"a", "b", "eu-1", "us_2", "back\\up", "x y"}

func Gen() Config needs rand.Random {
	let mut ups = []Upstream{}
	for n in names {
		if rand.Random.IntN(3) == 0 {
			ups = ups.Append(Upstream{
				Name:   n,
				Addr:   "10.0.0.\(rand.Random.IntN(256)):\(ports[rand.Random.IntN(ports.Len())])",
				Weight: weights[rand.Random.IntN(weights.Len())],
				Backup: rand.Random.IntN(2) == 0,
			})
		}
	}
	let levels = []Level{Debug, Info, Warn, Error}
	Config{
		Name:      names[rand.Random.IntN(names.Len())],
		Listen:    Listen{Host: hosts[rand.Random.IntN(hosts.Len())], Port: ports[rand.Random.IntN(ports.Len())]},
		Log:       levels[rand.Random.IntN(levels.Len())],
		Upstreams: ups,
	}
}

// Sample is the Valid configuration Gen builds from seed.
func Sample(seed int) Config {
	with context { rand.Random: rand.Seeded(uint64(seed)) } {
		Gen()
	}
}
