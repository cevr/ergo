import confparse/toml

// Encode is c as a document that Decode reads back as c when c is Valid.
func Encode(c Config) toml.Doc {
	let mut tables = []toml.Table{
		table("listen", false, []toml.Entry{entry("host", toml.Str{S: c.Listen.Host}), entry("port", toml.Int{N: int(c.Listen.Port)})}),
		table("log", false, []toml.Entry{entry("level", toml.Str{S: LevelName(c.Log)})}),
	}
	for u in c.Upstreams {
		tables = tables.Append(table("upstream", true, []toml.Entry{
			entry("name", toml.Str{S: u.Name}),
			entry("addr", toml.Str{S: u.Addr}),
			entry("weight", toml.Int{N: int(u.Weight)}),
			entry("backup", toml.Bool{B: u.Backup}),
		}))
	}
	toml.Doc{Root: table("", false, []toml.Entry{entry("name", toml.Str{S: c.Name})}), Tables: tables}
}

func nowhere() toml.Pos { toml.Pos{Line: 0, Column: 0} }

func entry(key string, v toml.Value) toml.Entry {
	toml.Entry{Key: key, KeyAt: nowhere(), Value: v, At: nowhere()}
}

func table(name string, many bool, entries []toml.Entry) toml.Table {
	toml.Table{Name: name, Many: many, At: nowhere(), Entries: entries}
}

// Valid reports whether Decode takes c: the upstreams' names are
// distinct. The port and the weights need no check: their refined types
// hold only values Decode takes.
func Valid(c Config) bool {
	for i, u in c.Upstreams {
		for j in 0..i {
			if c.Upstreams[j].Name == u.Name {
				return false
			}
		}
	}
	true
}
