import machines
import slices
import time
import vending/light
import vending/vend

// Both is the two machines side by side, the money the vending machine
// has kept, and the time of the last thing that happened.
type Both { Vend vend.State, Light light.Light, Books vend.Books, Now duration }

// Line is one line of the log: when, which machine, and what it did.
type Line { At duration, Who string, Text string }

// Fresh is both machines switched on at time 0, the vending machine with
// slots.
func Fresh(slots []vend.Slot) Both {
	Both{Vend: machines.Initial(machines.Start(vend.Vend{}, slots)), Light: machines.Initial(light.Crossing{}), Books: vend.Books{In: 0, Sales: 0, Change: 0, Refunds: 0}, Now: 0s}
}

// Show is the text of d as a script writes it: whole seconds as "12s",
// anything else as "1500ms". Duration reads it back (ShowReads).
func Show(d duration) string {
	let ms = time.Count(d, 1ms)
	if ms%1000 == 0 {
		return "\(ms / 1000)s"
	}
	"\(ms)ms"
}

// Text is the text of l.
func Text(l Line) string { "\(Show(l.At)) \(l.Who): \(l.Text)" }

// Due is the deadline that comes first: the vending machine's, the
// light's, or none.
type Due = VendDue{At duration} | LightDue{At duration} | NoneDue{}

// within is o when it is at or before upto.
func within(o Option[duration], upto duration) Option[duration] {
	match o {
	case Some[duration] as d:
		if d.Value <= upto { o } else { None }
	case None:
		None
	}
}

// due is the first deadline of b at or before upto. On a tie the vending
// machine goes first, so a run is the same each time.
func due(b Both, upto duration) Due {
	match (within(vend.Deadline(b.Vend), upto), within(light.Deadline(b.Light), upto)) {
	case (Some[duration] as v, Some[duration] as l):
		if v.Value <= l.Value { VendDue{At: v.Value} } else { LightDue{At: l.Value} }
	case (Some[duration] as v, None):
		VendDue{At: v.Value}
	case (None, Some[duration] as l):
		LightDue{At: l.Value}
	case (None, None):
		NoneDue
	}
}

// CatchUp is b at the time upto: each deadline at or before it gets its
// Tick at the deadline itself, first deadline first. A Tick at a deadline
// always moves its machine on, so the loop ends.
func CatchUp(b Both, upto duration) (Both, []Line) {
	let mut now = b
	let mut log = []Line{}
	for {
		match due(now, upto) {
		case VendDue as v:
			let next, lines = toVend(now, vend.Tick{At: v.At})
			now = next
			log = slices.Concat(log, lines)
		case LightDue as l:
			let next, lines = toLight(now, light.Tick{At: l.At})
			now = next
			log = slices.Concat(log, lines)
		case NoneDue:
			break
		}
	}
	if upto > now.Now {
		now = Both{..now, Now: upto}
	}
	(now, log)
}

// eventText is the log text of e.
func eventText(e vend.Event) string {
	match e {
	case vend.Accepted as a:
		"took \(a.Cents)c, credit \(a.Credit)c"
	case vend.Sold as s:
		"sold \(s.Item) from \(s.Slot) for \(s.Price)c, change \(s.Change)c"
	case vend.Refunded as r:
		"refunded \(r.Cents)c (\(r.Why))"
	case vend.Dropped as d:
		"\(d.Slot) dropped into the tray"
	case vend.WentOff:
		"out of service"
	case vend.CameBack:
		"back in service"
	}
}

// toVend is b after the vending machine takes sig, and the lines it
// logs: one per event, or one for a refusal.
func toVend(b Both, sig vend.Signal) (Both, []Line) {
	let at = vend.AtOf(sig)
	let es = vend.Decide(b.Vend, sig) catch {
	case vend.NotEnough as n:
		return (Both{..b, Now: at}, []Line{Line{At: at, Who: "vend", Text: "refused \(n.Slot): costs \(n.Price)c, credit \(n.Credit)c"}})
	case vend.SoldOut as o:
		return (Both{..b, Now: at}, []Line{Line{At: at, Who: "vend", Text: "refused \(o.Slot): sold out"}})
	case vend.NoSuchSlot as n:
		return (Both{..b, Now: at}, []Line{Line{At: at, Who: "vend", Text: "refused \(n.Slot): no such slot"}})
	case vend.Busy:
		return (Both{..b, Now: at}, []Line{Line{At: at, Who: "vend", Text: "refused: busy dropping"}})
	case vend.OutOfService:
		return (Both{..b, Now: at}, []Line{Line{At: at, Who: "vend", Text: "refused: out of service"}})
	case vend.BadCoin as c:
		return (Both{..b, Now: at}, []Line{Line{At: at, Who: "vend", Text: "refused a coin of \(c.Cents)c"}})
	}
	let mut lines = []Line{}
	for e in es {
		lines = lines.Append(Line{At: at, Who: "vend", Text: eventText(e)})
	}
	(Both{..b, Vend: machines.Next(b.Vend, vend.Apply(b.Vend, at, es)), Books: vend.Kept(b.Books, es), Now: at}, lines)
}

// cueAt is the time of c.
func cueAt(c light.Cue) duration {
	match c {
	case light.Tick as t:
		t.At
	case light.Button as p:
		p.At
	case light.Fault as f:
		f.At
	case light.Repair as r:
		r.At
	}
}

// lightText is the log text of the light l after a change.
func lightText(l light.Light) string {
	match l {
	case light.Green as g:
		if g.Asked { "green, ends early" } else { "green" }
	case light.Red:
		"red"
	case light.Yellow:
		"yellow"
	case light.Flashing:
		"flashing red"
	}
}

// toLight is b after the light takes c, and the line it logs.
func toLight(b Both, c light.Cue) (Both, []Line) {
	let at = cueAt(c)
	let d = light.Step(b.Light, c)
	let next = Both{..b, Light: machines.Next(b.Light, d), Now: at}
	match d {
	case Enter[light.Light] as e:
		(next, []Line{Line{At: at, Who: "light", Text: lightText(e.Next)}})
	case Stay[light.Light] as s:
		(next, []Line{Line{At: at, Who: "light", Text: lightText(s.Next)}})
	case Emit[light.Light, string] as m:
		(next, []Line{Line{At: at, Who: "light", Text: m.Output}})
	case Ignore:
		(next, []Line{Line{At: at, Who: "light", Text: "ignored, still \(light.Colour(b.Light))"}})
	case Reject:
		(next, []Line{})
	case Done[string]:
		(next, []Line{})
	}
}

// Deliver is b after the item it, and the lines it logs. A coin goes
// through the coin mechanism first: a coin it refuses never reaches the
// machine. End changes nothing.
func Deliver(b Both, it Item) (Both, []Line) needs vend.Acceptor {
	match it {
	case CoinIn as c:
		let cents = vend.Acceptor.Value(c.Coin) catch {
		case vend.Counterfeit as f:
			return (Both{..b, Now: c.At}, []Line{Line{At: c.At, Who: "coins", Text: "returned \(f.Name)"}})
		}
		toVend(b, vend.Coin{At: c.At, Cents: cents})
	case Key as k:
		toVend(b, vend.Select{At: k.At, Slot: k.Slot})
	case CancelKey as c:
		toVend(b, vend.Cancel{At: c.At})
	case ServiceKey as s:
		toVend(b, vend.Service{At: s.At})
	case ResumeKey as r:
		toVend(b, vend.Resume{At: r.At})
	case Press as p:
		toLight(b, light.Button{At: p.At})
	case Break as f:
		toLight(b, light.Fault{At: f.At})
	case Fix as f:
		toLight(b, light.Repair{At: f.At})
	case End as e:
		(Both{..b, Now: e.At}, []Line{})
	}
}

// Run is b after the items, in order, and the log: before each item, the
// deadlines up to its time; after End, nothing more.
func Run(b Both, items []Item) (Both, []Line) needs vend.Acceptor {
	let mut now = b
	let mut log = []Line{}
	for it in items {
		let caught, ticks = CatchUp(now, ItemAt(it))
		let next, lines = Deliver(caught, it)
		now = next
		log = slices.Concat(slices.Concat(log, ticks), lines)
		match it {
		case End:
			break
		case CoinIn, Key, CancelKey, ServiceKey, ResumeKey, Press, Break, Fix:
		}
	}
	(now, log)
}

// Summary is the last line of a run: the time, each machine, and the
// money, which always adds up (vend.MoneyIsKept).
func Summary(b Both) string {
	let k = b.Books
	"at \(Show(b.Now)): vend \(vend.Name(b.Vend)), light \(light.Colour(b.Light)); in \(k.In)c = sales \(k.Sales)c + change \(k.Change)c + refunds \(k.Refunds)c + credit \(vend.CreditOf(b.Vend))c"
}
