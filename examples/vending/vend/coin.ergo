// Package vend is the vending machine: its coins, its stock, and the
// machine that takes coins, sells from a slot and gives change, with
// timeouts on a clock that only the signals move. It is pure; the coin
// mechanism is a contract that a provider keeps.

import slices

// Counterfeit is a coin the mechanism does not take.
type Counterfeit { Name string }

// Denominations is the value in cents of each coin the machine takes.
let Denominations = []int{5, 10, 25, 100}

// Acceptor is the coin mechanism: it tells the value of a coin by its
// name, or refuses it.
type Acceptor {
	Value(coin string) int fails Counterfeit,

	// TakesOnlyDenominations: a coin the mechanism takes is worth one of
	// the denominations.
	law TakesOnlyDenominations(coin string) {
		let v = Value(coin) catch {
		case Counterfeit:
			return true
		}
		IsDenomination(v)
	},

	// IsRepeatable: a coin is worth the same each time it is tried.
	law IsRepeatable(coin string) {
		let first = Value(coin) catch {
		case Counterfeit:
			return true
		}
		try Value(coin) == first
	},
}

// IsDenomination reports whether cents is the value of a coin the machine
// takes.
func IsDenomination(cents int) bool { slices.Contains(Denominations, cents) }
