// Slot is one column of the machine: its name on the keypad, what it
// holds, its price in cents and how many are left.
type Slot { Name string, Item string, Price int, Count int }

// State is what the machine is doing. Each state holds the slots, so no
// state loses the stock. Collecting and Vending end at Until, a time since
// the machine was switched on; a Tick at or after it moves them on.
type State = Idle{Slots []Slot} | Collecting{Slots []Slot, Credit int, Until duration} | Vending{Slots []Slot, Slot string, Until duration} | Off{Slots []Slot}

// Signal is what reaches the machine, each at a time since it was
// switched on: a coin the mechanism took, a key, the cancel button, the
// clock, and the service switch.
type Signal = Coin{At duration, Cents int} | Select{At duration, Slot string} | Cancel{At duration} | Tick{At duration} | Service{At duration} | Resume{At duration}

// Wait is how long the machine keeps a credit with no coin or key.
let Wait = 30s

// Drop is how long a sale takes to fall into the tray.
let Drop = 2s

// The failures of a signal the machine refuses: the state stays as it was.

// NotEnough is a key pressed with less credit than the price.
type NotEnough { Slot string, Price int, Credit int }

// SoldOut is a key of an empty slot.
type SoldOut { Slot string }

// NoSuchSlot is a key that names no slot.
type NoSuchSlot { Slot string }

// Busy is a coin or a key while a sale drops.
type Busy {}

// OutOfService is a coin or a key while the machine is off.
type OutOfService {}

// BadCoin is a coin of a value the machine does not take.
type BadCoin { Cents int }

// Start is a machine switched on with slots.
func Start(slots []Slot) State { Idle{Slots: slots} }

// SlotsOf is the slots that s holds.
func SlotsOf(s State) []Slot {
	match s {
	case Idle as i:
		i.Slots
	case Collecting as c:
		c.Slots
	case Vending as v:
		v.Slots
	case Off as o:
		o.Slots
	}
}

// CreditOf is the credit that s holds: only Collecting holds one.
func CreditOf(s State) int {
	match s {
	case Collecting as c:
		c.Credit
	case Idle:
		0
	case Vending:
		0
	case Off:
		0
	}
}

// Deadline is the time at which s moves on by itself, or None.
func Deadline(s State) Option[duration] {
	match s {
	case Collecting as c:
		Some[duration]{Value: c.Until}
	case Vending as v:
		Some[duration]{Value: v.Until}
	case Idle:
		None
	case Off:
		None
	}
}

// Name is the word for s.
func Name(s State) string {
	match s {
	case Idle:
		"idle"
	case Collecting:
		"collecting"
	case Vending:
		"vending"
	case Off:
		"off"
	}
}

// find is the slot named name in slots.
func find(slots []Slot, name string) Slot fails NoSuchSlot {
	for s in slots {
		if s.Name == name {
			return s
		}
	}
	NoSuchSlot{Slot: name}
}

// take is slots with one fewer in the slot named name, in a new slice.
func take(slots []Slot, name string) []Slot {
	let mut out = []Slot{}
	for s in slots {
		out = out.Append(if s.Name == name { Slot{..s, Count: s.Count - 1} } else { s })
	}
	out
}

// sell is the events of a key for name with credit: the guards are the
// slot, its stock and the price, in that order.
func sell(slots []Slot, name string, credit int) []Event fails NoSuchSlot | SoldOut | NotEnough {
	let s = try find(slots, name)
	if s.Count <= 0 {
		return SoldOut{Slot: name}
	}
	if credit < s.Price {
		return NotEnough{Slot: name, Price: s.Price, Credit: credit}
	}
	[]Event{Sold{Slot: name, Item: s.Item, Price: s.Price, Change: credit - s.Price}}
}

// Decide is the events of sig in s. It decides; Evolve only folds. A
// signal the machine refuses is a failure, and a signal that changes
// nothing has no events.
func Decide(s State, sig Signal) []Event fails NotEnough | SoldOut | NoSuchSlot | Busy | OutOfService | BadCoin {
	match (s, sig) {
	case (Off, Resume as r):
		[]Event{CameBack{At: r.At}}
	case (Off, Tick):
		[]Event{}
	case (Off, Service):
		[]Event{}
	case (Off, _):
		OutOfService
	case (Vending, Coin):
		Busy
	case (Vending, Select):
		Busy
	case (Vending, Cancel):
		Busy
	case (Vending as v, Tick as t):
		if t.At >= v.Until { []Event{Dropped{Slot: v.Slot}} } else { []Event{} }
	case (_, Coin as c):
		if !IsDenomination(c.Cents) {
			return BadCoin{Cents: c.Cents}
		}
		[]Event{Accepted{At: c.At, Cents: c.Cents, Credit: CreditOf(s) + c.Cents}}
	case (_, Select as k):
		try sell(SlotsOf(s), k.Slot, CreditOf(s))
	case (Collecting as c, Cancel):
		[]Event{Refunded{Cents: c.Credit, Why: "cancel"}}
	case (Idle, Cancel):
		[]Event{}
	case (Collecting as c, Tick as t):
		if t.At >= c.Until { []Event{Refunded{Cents: c.Credit, Why: "timeout"}} } else { []Event{} }
	case (Idle, Tick):
		[]Event{}
	case (Collecting as c, Service):
		[]Event{Refunded{Cents: c.Credit, Why: "service"}, WentOff}
	case (_, Service):
		[]Event{WentOff}
	case (_, Resume):
		[]Event{}
	}
}

// Event is what a signal did, in the past tense.
type Event = Accepted{At duration, Cents int, Credit int} | Sold{Slot string, Item string, Price int, Change int} | Refunded{Cents int, Why string} | Dropped{Slot string} | WentOff{} | CameBack{At duration}

// Evolve is s after the event e. A sale starts its drop at the time of
// the coin or key that made it, so Evolve takes that time.
func Evolve(s State, at duration, e Event) State {
	let slots = SlotsOf(s)
	match e {
	case Accepted as a:
		Collecting{Slots: slots, Credit: a.Credit, Until: a.At + Wait}
	case Sold as d:
		Vending{Slots: take(slots, d.Slot), Slot: d.Slot, Until: at + Drop}
	case Refunded:
		Idle{Slots: slots}
	case Dropped:
		Idle{Slots: slots}
	case WentOff:
		Off{Slots: slots}
	case CameBack:
		Idle{Slots: slots}
	}
}

// AtOf is the time of sig.
func AtOf(sig Signal) duration {
	match sig {
	case Coin as c:
		c.At
	case Select as k:
		k.At
	case Cancel as c:
		c.At
	case Tick as t:
		t.At
	case Service as v:
		v.At
	case Resume as r:
		r.At
	}
}

// Apply is the decision of the events es in s at the time at: no event
// is Ignore; events that keep the state's kind Stay; others Enter.
func Apply(s State, at duration, es []Event) Decision[State, []Slot] {
	if len(es) == 0 {
		return Ignore
	}
	let mut next = s
	for e in es {
		next = Evolve(next, at, e)
	}
	if Name(next) == Name(s) {
		Stay[State]{Next: next}
	} else {
		Enter[State]{Next: next}
	}
}

// Step is the machine's transition: the events Decide records, folded by
// Apply. The machine never ends, so it is never Done: its output type is
// the stock it would hand over.
func Step(s State, sig Signal) Decision[State, []Slot] fails NotEnough | SoldOut | NoSuchSlot | Busy | OutOfService | BadCoin {
	Apply(s, AtOf(sig), try Decide(s, sig))
}

// Vend is the vending machine as a machine. It starts with no slots; a
// program starts it with its own by Start.
type Vend machine[State, Signal] {
	initial: Start([]Slot{}),
	step:    Step,
}

// Tried is Step(s, sig), or Reject when the machine refuses sig.
func Tried(s State, sig Signal) Decision[State, []Slot] {
	Step(s, sig) catch {
	case NotEnough, SoldOut, NoSuchSlot, Busy, OutOfService, BadCoin:
		Reject
	}
}

// Next is the state after the decision d in s.
func Next(s State, d Decision[State, []Slot]) State {
	match d {
	case Enter[State] as e:
		e.Next
	case Stay[State] as k:
		k.Next
	case Ignore:
		s
	case Reject:
		s
	case Done[[]Slot]:
		s
	}
}
