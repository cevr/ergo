// ergo test runs the vend.Acceptor laws against Coins, built by NewCoins
// from generated tables; this test checks the US table.

import vending/vend

test KnowsUSCoins {
	let a vend.Acceptor = US()
	assert try a.Value("quarter") == 25
	assert try a.Value("dollar") == 100
	let v = a.Value("penny") catch {
	case vend.Counterfeit as c:
		assert c.Name == "penny"
		return
	}
	assert v == -1
}
