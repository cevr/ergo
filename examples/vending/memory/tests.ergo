// The coin table keeps the vend.Acceptor laws: restated as property tests
// (#162), over the names of the table and any other name.

import vending/vend

// pick is one of the table's names, or the name given.
func pick(n int, other string) string {
	let k = if n < 0 { -(n % 5) } else { n % 5 }
	match k {
	case 0:
		"nickel"
	case 1:
		"dime"
	case 2:
		"quarter"
	case 3:
		"dollar"
	case _:
		other
	}
}

test KnowsUSCoins {
	let a vend.Acceptor = US()
	assert try a.Value("quarter") == 25
	assert try a.Value("dollar") == 100
	let v = a.Value("penny") catch {
	case vend.Counterfeit as c:
		assert c.Name == "penny"
		return
	}
	assert v == -1
}

test TakesOnlyDenominationsHolds(n int, other string) {
	let a vend.Acceptor = US()
	let v = a.Value(pick(n, other)) catch {
	case vend.Counterfeit:
		return
	}
	assert vend.IsDenomination(v)
}

test IsRepeatableHolds(n int, other string) {
	let a vend.Acceptor = US()
	let coin = pick(n, other)
	let first = a.Value(coin) catch {
	case vend.Counterfeit:
		return
	}
	assert try a.Value(coin) == first
}
