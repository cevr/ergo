// vending runs a vending machine and the traffic light at the crossing in
// front of it on one virtual clock, from a script on standard input, and
// prints what each did and when. Package vend is the vending machine,
// light the crossing, drive the script and the clock, and memory the coin
// table. This binary is the only place that chooses the providers: the
// US coin table as the coin mechanism, and the host's input and output.

import flag
import io
import os
import vending/drive
import vending/memory
import vending/vend

let Brief = flag.Bool("brief", false, "print only the last line")
let Stock = flag.Int("stock", 2, "how many of each item the machine holds")

// Options is the command line, read.
type Options { Brief bool, Stock int }

// Set is the command line's flags.
func Set() flag.Set {
	flag.Set{Name: "vending", Usage: "vending runs a vending machine and a crossing light from a script on standard input.", Flags: []flag.Flag{Brief, Stock}, Args: []flag.ArgSpec{}}
}

// Shelf is the machine's slots, each with stock items.
func Shelf(stock int) []vend.Slot {
	[]vend.Slot{vend.Slot{Name: "A1", Item: "cola", Price: 125, Count: stock}, vend.Slot{Name: "A2", Item: "water", Price: 100, Count: stock}, vend.Slot{Name: "B1", Item: "chips", Price: 75, Count: stock}}
}

// read is the options of args, None after help, or the end of the
// program: help prints the usage, and any other failure exits 2 with it.
func read(args []string) Option[Options] fails os.Exit needs io.Stdout {
	let set = Set()
	let v = flag.Parse(set, args) catch {
	case err:
		try flag.Exit(err, flag.Usage(set))
		return None
	}
	let o = Options{Brief: Brief.Get(v), Stock: Stock.Get(v)}
	if o.Stock < 0 {
		return os.Exit{Code: 2, Message: "vending: a stock of \(o.Stock) is less than none"}
	}
	Some[Options]{Value: o}
}

func main() fails os.Exit needs Ambient {
	with context { os.Process: os.NewHost(), io.Stdout: io.NewHost(), io.Stdin: io.NewHost(), vend.Acceptor: memory.US() } { try run(os.Process.Args()) }
}

// run is the program after main binds its providers; the tests run it
// over a recorder and catch its exit.
func run(args []string) fails os.Exit needs io.Stdout | io.Stdin | vend.Acceptor {
	let o = match try read(args) {
	case Some[Options] as s:
		s.Value
	case None:
		return
	}
	let text = io.Stdin.ReadAll() catch {
	case io.ReadFailed as r:
		return os.Exit{Code: 1, Message: "vending: \(r.Reason)"}
	}
	let items = drive.ParseScript(text) catch {
	case drive.BadLine as b:
		return os.Exit{Code: 2, Message: "vending: line \(b.Line): \(b.Reason): \(b.Text)"}
	}
	let end, lines = drive.Run(drive.Fresh(Shelf(o.Stock)), items)
	if !o.Brief {
		for l in lines {
			io.Stdout.Println(drive.Text(l))
		}
	}
	io.Stdout.Println(drive.Summary(end))
}

// session is the output of a run of args on input, as main runs it with
// the US coins, or the exit it ends with.
func session(args []string, input string) string {
	let out = io.NewRecorder()
	with context { io.Stdout: out, io.Stdin: io.Input{Text: input}, vend.Acceptor: memory.US() } { run(args) } catch {
	case os.Exit as e:
		return out.Text() + "exit \(e.Code): \(e.Message)"
	}
	out.Text()
}

test ScriptedRun {
	let text = session([]string{"-stock", "1"}, "1s coin dollar\n2s coin quarter\n3s select A1\n4s coin dime\n5s select A1\n40s end\n")
	assert text == "1s vend: took 100c, credit 100c\n2s vend: took 25c, credit 125c\n3s vend: sold cola from A1 for 125c, change 0c\n4s vend: refused: busy dropping\n5s vend: A1 dropped into the tray\n5s vend: refused A1: sold out\n30s light: green\nat 40s: vend idle, light green; in 125c = sales 125c + change 0c + refunds 0c + credit 0c\n"
}

test RefusalsExit {
	assert session([]string{"-stock", "-1"}, "") == "exit 2: vending: a stock of -1 is less than none"
	assert session([]string{}, "1s coin\n") == "exit 2: vending: line 1: coin takes 1 word after it: 1s coin"
	assert session([]string{"-h"}, "") == flag.Usage(Set())
}

test BriefPrintsTheBooks {
	assert session([]string{"-brief"}, "1s coin dollar\n2s coin penny\n3s cancel\n9s end\n") == "at 9s: vend idle, light red; in 100c = sales 0c + change 0c + refunds 100c + credit 0c\n"
}
