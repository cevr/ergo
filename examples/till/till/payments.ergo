// Tender is one way a sale is paid: a card or a voucher, for an amount in
// cents.
type Tender = Card{Number string, Amount int} | Voucher{Code string, Amount int}

// Ref is an approved charge: the gateway's reference and the amount taken.
type Ref { ID string, Amount int }

// Refused is a charge the gateway declined.
type Refused { Why string }

// Payments is the contract the till needs from a payment gateway.
type Payments {
	Charge(t Tender) Ref fails Refused,
	Refund(r Ref) int,

	// ChargeTakesTheAmount: an approved charge takes exactly the tender's
	// amount.
	law ChargeTakesTheAmount(card string, amount int) {
		let t = Card{Number: card, Amount: amount}
		let r = Charge(t) catch {
		case Refused:
			return true
		}
		r.Amount == AmountOf(t)
	},
	// RefundGivesBack: a refund gives back the amount of its charge.
	law RefundGivesBack(id string, amount int) {
		Refund(Ref{ID: id, Amount: amount}) == amount
	},
}

// AmountOf is a tender's amount.
func AmountOf(t Tender) int {
	match t {
	case Card as c:
		c.Amount
	case Voucher as v:
		v.Amount
	}
}

// Sum is the amount of the tenders.
func Sum(ts []Tender) int {
	let mut n = 0
	for t in ts {
		n = n + AmountOf(t)
	}
	n
}
