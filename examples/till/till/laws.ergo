// The till's rules as laws over its three machines' steps (machine laws,
// MU6, are not on this base). The children's lifetimes (each phase's
// children stop before the next entry; a late output is dropped) are the
// runner's rules, proved by MU5's model and test; the cases run them.

// refusing is a gateway that refuses every charge: the Payments laws run
// against it.
type refusing {}

func Charge(_ refusing, t Tender) Ref fails Refused { Refused{Why: "no"} }

func Refund(_ refusing, r Ref) int { r.Amount }

// cents is n cut to 0..9999 (also for the least int, whose negation is
// itself).
func cents(n int) int {
	let c = n % 10000
	if c < 0 { -c } else { c }
}

func linesOf(prices []int) []Line {
	let mut out = []Line{}
	for p in prices {
		out = out.Append(Line{Item: "item", Price: cents(p) + 1})
	}
	out
}

// tendersOf is a tender per amount, cards and vouchers by turns.
func tendersOf(amounts []int) []Tender {
	let mut out = []Tender{}
	for i, a in amounts {
		if i%2 == 0 {
			out = out.Append(Card{Number: "1\(i)", Amount: a})
		} else {
			out = out.Append(Voucher{Code: "V\(i)", Amount: a})
		}
	}
	out
}

// split is tenders that pay total exactly: the amounts, cut to total, and
// the rest in a last card.
func split(total int, amounts []int) []Tender {
	let mut left = total
	let mut parts = []int{}
	for a in amounts {
		let c = cents(a) % (left + 1)
		if c > 0 && c < left {
			parts = parts.Append(c)
			left = left - c
		}
	}
	tendersOf(parts.Append(left))
}

// sample is a till state of every variant, picked by n.
func sample(n int, prices []int, amounts []int, text string) Sale {
	let lines = linesOf(prices)
	let tenders = tendersOf(amounts)
	let refs = []Ref{Ref{ID: text, Amount: Total(lines)}}
	let k = if n < 0 { -n } else { n }
	match k % 4 {
	case 0:
		Basket{Lines: lines, Note: text}
	case 1:
		Paying{Lines: lines, Tenders: tenders}
	case 2:
		Voiding{Lines: lines, Refs: refs, Why: text}
	case _:
		Receipt{Lines: lines, Refs: refs}
	}
}

// signalOf is a till signal of every variant, picked by n.
func signalOf(n int, amounts []int, text string) Signal {
	let k = if n < 0 { -n } else { n }
	match k % 8 {
	case 0:
		Add{Item: text, Price: k % 500}
	case 1:
		Pay{Tenders: tendersOf(amounts)}
	case 2:
		Void
	case 3:
		Touch
	case 4:
		TendersTaken{Refs: []Ref{Ref{ID: text, Amount: 1}}}
	case 5:
		TendersDeclined{Refs: []Ref{}, Why: text}
	case 6:
		Refunded
	case _:
		Idle
	}
}

// moved is the state a decision enters or stays in, if any.
func moved(d Decision[Sale, Result]) Option[Sale] {
	match d {
	case Enter[Sale] as x:
		Some{x.Next}
	case Stay[Sale] as x:
		Some{x.Next}
	case Emit[Sale, Result] as x:
		Some{x.Next}
	case Ignore:
		None
	case Reject:
		None
	case Done[Result]:
		None
	}
}

func refused(d Decision[Sale, Result]) bool {
	match d {
	case Reject:
		true
	case _:
		false
	}
}

// TendersPayExactly: Pay starts a payment exactly when the tenders sum to
// the basket's total, each positive; otherwise it is refused.
law TendersPayExactly(prices []int, amounts []int, exact bool) {
	let lines = linesOf(prices)
	let tenders = if exact && len(lines) > 0 { split(Total(lines), amounts) } else { tendersOf(amounts) }
	let d = Step(Basket{Lines: lines, Note: ""}, Pay{Tenders: tenders})
	match moved(d) {
	case Some[Sale] as s:
		match s.Value {
		case Paying as p:
			Sum(p.Tenders) == Total(lines) && len(lines) > 0
		case _:
			false
		}
	case None:
		refused(d) && !payable(lines, tenders)
	}
}

// ReceiptOnlyAfterPaid: the receipt opens only when the runner reports
// every tender taken, or again on a touch of the receipt.
law ReceiptOnlyAfterPaid(n int, m int, prices []int, amounts []int, text string) {
	let s = sample(n, prices, amounts, text)
	let e = signalOf(m, amounts, text)
	match moved(Step(s, e)) {
	case Some[Sale] as next:
		match next.Value {
		case Receipt:
			match (s, e) {
			case (Paying, TendersTaken):
				true
			case (Receipt, Touch):
				true
			case (_, _):
				false
			}
		case _:
			true
		}
	case None:
		true
	}
}

// NoVoidWhilePaying: a void while charges run is refused.
law NoVoidWhilePaying(prices []int, amounts []int) {
	refused(Step(Paying{Lines: linesOf(prices), Tenders: tendersOf(amounts)}, Void))
}

// TakenChargesAreRefunded: when some tender is declined, every charge
// that was taken goes to Voiding, which refunds them.
law TakenChargesAreRefunded(prices []int, ids []string, why string) {
	let mut refs = []Ref{}
	for id in ids {
		refs = refs.Append(Ref{ID: id, Amount: 1})
	}
	let reason = "declined: \(why)"
	match moved(Step(Paying{Lines: linesOf(prices), Tenders: []Tender{}}, TendersDeclined{Refs: refs, Why: reason})) {
	case Some[Sale] as s:
		match s.Value {
		case Voiding as v:
			len(refs) > 0 && len(v.Refs) == len(refs)
		case Basket as b:
			len(refs) == 0 && b.Note == reason
		case _:
			false
		}
	case None:
		false
	}
}

// answersOf is an answer per tender, in the order given by order: a
// tender whose amount is odd is declined.
func answersOf(amounts []int, order int) []Answer {
	let tenders = tendersOf(amounts)
	let n = len(tenders)
	let mut out = []Answer{}
	for j in 0..n {
		let i = if n == 0 { 0 } else { (j + cents(order)) % n }
		let t = tenders[i]
		if AmountOf(t)%2 == 0 {
			out = out.Append(Taken{Index: i, Tender: t, R: Ref{ID: "r\(i)", Amount: AmountOf(t)}})
		} else {
			out = out.Append(Declined{Index: i, Tender: t, Why: "odd \(i)"})
		}
	}
	out
}

// told is an outcome as text.
func told(o Outcome) string {
	let mut text = ""
	let refs = match o {
	case AllTaken as a:
		text = "taken"
		a.Refs
	case SomeDeclined as d:
		text = "declined \(d.Why)"
		d.Refs
	}
	for r in refs {
		text = text + " " + r.ID
	}
	text
}

// OutcomeIgnoresArrival: the runner's outcome is the same whatever order
// the charges answer in, and lists the taken charges in tender order.
law OutcomeIgnoresArrival(amounts []int, order int) {
	told(OutcomeOf(answersOf(amounts, order))) == told(OutcomeOf(answersOf(amounts, 0)))
}

// RunnerWaitsForAll: the runner ends only after every tender answered,
// so no taken charge is lost to an early end.
law RunnerWaitsForAll(amounts []int, order int) {
	let answers = answersOf(amounts, order)
	let mut s = running(tendersOf(amounts))
	for i, a in answers {
		match runStep(s, Answered{A: a}) {
		case Stay[Run] as x:
			s = x.Next
		case Done[Outcome]:
			return i == len(answers)-1
		case _:
			return false
		}
	}
	len(answers) == 0
}

// ChargeAlwaysAnswers: every signal ends a charge with its answer, and
// the charge's timer gives up after ChargeWait.
law ChargeAlwaysAnswers(i int, card string, amount int, m int) {
	let s = authorize((i, Card{Number: card, Amount: amount}))
	let k = if m < 0 { -m } else { m }
	let e ChargeSignal = match k % 3 {
	case 0:
		Approved{R: Ref{ID: card, Amount: amount}}
	case 1:
		let r ChargeSignal = Refused{Why: card}
		r
	case _:
		NoAnswer
	}
	let timed = match chargeTimer(s) {
	case Some[Timeout[ChargeSignal]] as t:
		t.Value.In == ChargeWait()
	case None:
		false
	}
	match chargeStep(s, e) {
	case Done[Answer] as d:
		timed && match d.Output {
		case Taken as t:
			t.Index == i && k%3 == 0
		case Declined as x:
			x.Index == i && k%3 != 0
		}
	case _:
		false
	}
}

// ReceiptTouchRestarts: a touch re-enters the receipt (its timer starts
// again), and its timer's signal sells.
law ReceiptTouchRestarts(prices []int, id string) {
	let r = Receipt{Lines: linesOf(prices), Refs: []Ref{Ref{ID: id, Amount: 1}}}
	let reentered = match Step(r, Touch) {
	case Enter[Sale]:
		true
	case _:
		false
	}
	let sells = match timer(r) {
	case Some[Timeout[Signal]] as t:
		match Step(r, t.Value.Signal) {
		case Done[Result] as d:
			match d.Output {
			case Sold as s:
				s.Total == Total(r.Lines) && t.Value.In == ReceiptWait()
			case Voided:
				false
			}
		case _:
			false
		}
	case None:
		false
	}
	reentered && sells
}
