import actor
import machines

// The payment runner is the Paying phase's child. Its work starts one
// Charge child per tender, so the charges run at once; each answer comes
// back as a signal of the runner's entry. It waits for every answer, so a
// charge that was taken is never lost when another is declined, and ends
// with the outcome in tender order.
type Run = Running{Tenders []Tender, Answers []Answer, Gateway Payments}

type RunSignal = Answered{A Answer}

// Outcome is the runner's end: every tender taken, or some declined, with
// the charges that were taken (the till refunds them).
type Outcome = AllTaken{Refs []Ref} | SomeDeclined{Refs []Ref, Why string}

type Runner machine[Run, RunSignal] { initial: running, step: runStep, work: runWork }

// Plan is the runner's input: the tenders and the gateway to charge. (A
// tuple input `([]Tender, Payments)` does not parse: finding F9.)
type Plan { Tenders []Tender, Gateway Payments }

func running(p Plan) Run { Running{Tenders: p.Tenders, Answers: []Answer{}, Gateway: p.Gateway} }

func runStep(s Run, e RunSignal) Decision[Run, Outcome] {
	match (s, e) {
	case (Running as r, Answered as a):
		let answers = r.Answers.Append(a.A)
		if len(answers) < len(r.Tenders) {
			Stay[Run]{Next: Running{..r, Answers: answers}}
		} else {
			Done[Outcome]{Output: OutcomeOf(answers)}
		}
	}
}

// runWork starts a charge per tender. The children belong to the entry:
// when the runner ends, or the till leaves Paying, they stop first.
func runWork(s Run) Option[machines.Work[RunSignal, Scheduler]] {
	match s {
	case Running as r:
		Some{machines.Work{Listen: func(send func(e RunSignal)) needs Scheduler {
			for i in 0..len(r.Tenders) {
				actor.Child(send, machines.Start(Charger{}, (i, r.Tenders[i], r.Gateway)), 1, func(a Answer) RunSignal { Answered{A: a} })
			}
		}}}
	}
}

// OutcomeOf is the outcome of the answers, in tender order whatever order
// they came in.
func OutcomeOf(answers []Answer) Outcome {
	let mut refs = []Ref{}
	let mut why = ""
	for i in 0..len(answers) {
		for a in answers {
			match a {
			case Taken as t:
				if t.Index == i {
					refs = refs.Append(t.R)
				}
			case Declined as d:
				if d.Index == i && why == "" {
					why = d.Why
				}
			}
		}
	}
	if why == "" {
		AllTaken{Refs: refs}
	} else {
		SomeDeclined{Refs: refs, Why: why}
	}
}
