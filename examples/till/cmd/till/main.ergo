// till is a shop till driven by a script on standard input. This binary
// is the only place that chooses the providers: the in-memory gateway, a
// manual clock for the receipt's and the charges' timers, and the host's
// standard input.

import io
import time
import till/till
import till/counter
import till/memory

func main() needs Console | Ambient {
	let clock = time.NewManual(0)
	with context { io.Stdin: io.NewStdin(), till.Payments: memory.Gateway, Scheduler: clock } {
		counter.Run(clock)
	}
}
