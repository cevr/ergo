// Gateway keeps the laws of till.Payments. ergo test does not run a law
// of an imported operation type against this package's providers (sign-in
// finding F4), so these properties restate them with Gateway.

import till/till

test GatewayTakesTheAmount(card string, code string, amount int) {
	let g till.Payments = Gateway
	for t in []till.Tender{till.Card{Number: card, Amount: amount}, till.Voucher{Code: code, Amount: amount}} {
		let r = g.Charge(t) catch {
		case till.Refused:
			till.Ref{ID: "", Amount: till.AmountOf(t)}
		}
		assert r.Amount == till.AmountOf(t)
	}
}

test GatewayRefundGivesBack(id string, amount int) {
	let g till.Payments = Gateway
	assert g.Refund(till.Ref{ID: id, Amount: amount}) == amount
}
