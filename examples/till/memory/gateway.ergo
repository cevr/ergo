// Package memory holds an in-memory provider of the till's Payments.

import strings
import till/till

// Gateway approves every tender except a card whose number starts with 0
// and a voucher whose code starts with X. It keeps no state.
type Gateway {}

func Charge(_ Gateway, t till.Tender) till.Ref fails till.Refused {
	match t {
	case till.Card as c:
		if strings.HasPrefix(c.Number, "0") {
			return till.Refused{Why: "card \(c.Number) declined"}
		}
		till.Ref{ID: "card-\(c.Number)", Amount: c.Amount}
	case till.Voucher as v:
		if strings.HasPrefix(v.Code, "X") {
			return till.Refused{Why: "voucher \(v.Code) spent"}
		}
		till.Ref{ID: "voucher-\(v.Code)", Amount: v.Amount}
	}
}

func Refund(_ Gateway, r till.Ref) int { r.Amount }
