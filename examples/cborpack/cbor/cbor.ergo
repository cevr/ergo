// Package cbor writes the derived codec's events as CBOR (RFC 8949), the
// binary form of the JSON data model. It is a module's own codec, written
// as std json's is: Item, the writer, is an operation type whose one
// provider is the record item below, so an encode(v, t) whose t a let
// binds by a cell of item calls item's functions, not a Writer adapter.
// The build unfolds each event by its definition and joins constant bytes
// by the law RawJoins, which ergo test proves (ergo.laws): a record's map
// header and keys become one constant append. Encode borrows its buffer
// from std strings, as std json's Encode does, so a value encoded again
// allocates its result and nothing else.
//
// The form: a record is a map of its wire keys, a union value the map of
// its variant with the member "_tag" first, a Map a map in key order; maps
// are indefinite-length (0xbf … 0xff), since a union writes one member
// more than its record has fields. A slice or tuple is a definite-length
// array. An integer is the shortest head of its major type (0 for n ≥ 0,
// 1 for -1-n), a float the 8 bytes of its IEEE 754 bits, a string a text
// string of its bytes.

import go math
import codec
import strings
import utf8

// Item is CBOR being written: the prelude's Writer events. The private
// operations are the parts of the events: raw appends bytes as they are,
// head the head of a data item, and text a text string. A public event's
// body is a straight line of its parts, and head's is an if on its
// argument, so at constant arguments the build unfolds them to raw calls
// of constant bytes, and RawJoins joins them.
type Item {
	..codec.Writer,

	// raw appends bytes as they are.
	mut raw(bytes string),
	// head appends the head of an item of a major type and argument.
	mut head(major int, n uint64),
	// wideHead is head for an argument of 256 or more.
	mut wideHead(major int, n uint64),
	// text appends the text string s.
	mut text(s string),
	// finish is the bytes written, and gives the buffer back (Encode
	// only: nothing may use the Item after).
	mut finish(hint int) string,

	law RawJoins(a string, b string) { raw(a); raw(b) } == { raw(a + b) },
}

// item is Item's provider: the bytes written.
type item { out []byte } implements Item

extern go append func appendString(out []byte, s string) []byte

extern go append func appendByte[T](out []T, b T) []T

func raw(t mut item, bytes string) { t.out = appendString(t.out, bytes) }

func head(t mut item, major int, n uint64) {
	if n < 24 {
		t.raw(byteText(major*32 + int(n)))
	} else if n < 256 {
		t.raw(byteText(major*32 + 24))
		t.raw(byteText(int(n)))
	} else {
		t.wideHead(major, n)
	}
}

func wideHead(t mut item, major int, n uint64) {
	let mut size = 8
	let mut info = 27
	if n < 65536 {
		size = 2
		info = 25
	} else if n < 4294967296 {
		size = 4
		info = 26
	}
	t.out = appendByte(t.out, byte(major*32+info))
	t.bigEndian(n, size)
}

// bigEndian appends the low size bytes of n, the high byte first.
func bigEndian(t mut item, n uint64, size int) {
	for i in 0..size {
		t.out = appendByte(t.out, byte(n>>uint64(8*(size-1-i))))
	}
}

func text(t mut item, s string) {
	t.head(3, uint64(s.Len()))
	t.raw(s)
}

// byteText is the byte b, 0 to 255, as a one-byte string: a slice of a
// constant, so it allocates nothing.
func byteText(b int) string {
	"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"[b : b+1]
}

func Bool(t mut item, b bool) {
	if b {
		t.raw("\xf5")
	} else {
		t.raw("\xf4")
	}
}

func Int(t mut item, n int64) {
	if n >= 0 {
		t.head(0, uint64(n))
	} else {
		t.head(1, uint64(-1-n))
	}
}

func Uint(t mut item, n uint64) { t.head(0, n) }

func Float(t mut item, f float64) {
	t.raw("\xfb")
	t.bigEndian(math.Float64bits(f), 8)
}

func String(t mut item, s string) { t.text(s) }

// StringBytes writes the string whose bytes are b, as String does (the
// prelude Writer's StringBytes, GX10).
func StringBytes(t mut item, b []byte) { t.text(utf8.String(b)) }

func Null(t mut item) { t.raw("\xf6") }

func Number(t mut item, text string) { t.text(text) }

func BeginList(t mut item, n int) { t.head(4, uint64(n)) }

func EndList(t mut item) {}

func BeginObject(t mut item, n int) { t.raw("\xbf") }

func EndObject(t mut item) { t.raw("\xff") }

// Tag writes a union's tag as the member "_tag", as std json does.
func Tag(t mut item, name string) {
	t.text("_tag")
	t.text(name)
}

func Key(t mut item, k string) { t.text(k) }

func finish(t mut item, hint int) string {
	let s = strings.FromBytes(t.out)
	t.out = strings.Give(t.out, hint)
	s
}

// Encode is v's CBOR.
// (Its Item's buffer is borrowed, strings.Borrow and Give, as std json's
// Encode borrows its Text's.)
func Encode[T wire](v T) string needs wired[T] {
	let hint = strings.Hint[item, T]()
	let t Item = item{out: strings.Borrow(hint)}
	codec.Encode(v, t)
	t.finish(hint)
}
