import gen
import strings

type cborSampleRecord {
	Name string,
	N    int64,
	Flag bool,
}

func expectedHeadLen(u uint64) int {
	if u < 24 {
		1
	} else if u < 256 {
		2
	} else if u < 65536 {
		3
	} else if u < 4294967296 {
		5
	} else {
		9
	}
}

func expectedMajorByte(major int, u uint64) byte {
	let info = if u < 24 {
		int(u)
	} else if u < 256 {
		24
	} else if u < 65536 {
		25
	} else if u < 4294967296 {
		26
	} else {
		27
	}
	byte(major*32 + info)
}

// EncodeMajorTypesAndCanonicalHeads proves CBOR Encode emits shortest canonical
// RFC 8949 heads across integer boundaries, text strings, booleans, arrays, and
// indefinite-length record maps, and is deterministic across repeated calls.
law EncodeMajorTypesAndCanonicalHeads() {
	let cfg = gen.Config{Seed: uint64(1), Cases: 64, Shrinks: 0, MaxDraws: 2048, MaxRejected: 10}
	let outcome = gen.Check(cfg, func() bool fails gen.Rejected needs gen.Draws {
		let bucket = gen.IntIn(0, 4)
		let pos = match bucket {
		case 0:
			int64(gen.IntIn(0, 23))
		case 1:
			int64(gen.IntIn(24, 255))
		case 2:
			int64(gen.IntIn(256, 65535))
		case 3:
			int64(65536 + gen.IntIn(0, 100000))
		case _:
			int64(4294967296) + int64(gen.IntIn(0, 1000))
		}
		let encPos = Encode(pos)
		if encPos.Len() != expectedHeadLen(uint64(pos)) || encPos[0] != expectedMajorByte(0, uint64(pos)) {
			return false
		}
		let neg = -1 - pos
		let encNeg = Encode(neg)
		if encNeg.Len() != expectedHeadLen(uint64(pos)) || encNeg[0] != expectedMajorByte(1, uint64(pos)) {
			return false
		}
		let s = gen.OneOf([]string{"", "a", "hello", "twenty-four-bytes-longer-string"})
		let encStr = Encode(s)
		if encStr.Len() != expectedHeadLen(uint64(s.Len()))+s.Len() || encStr[0] != expectedMajorByte(3, uint64(s.Len())) {
			return false
		}
		if !strings.HasSuffix(encStr, s) {
			return false
		}
		let flag = gen.Bool()
		let encBool = Encode(flag)
		if encBool != (if flag { "\xf5" } else { "\xf4" }) {
			return false
		}
		let rec = cborSampleRecord{Name: s, N: pos, Flag: flag}
		let encRec1 = Encode(rec)
		let encRec2 = Encode(rec)
		if encRec1 != encRec2 || encRec1.Len() < 2 || encRec1[0] != 0xbf || encRec1[encRec1.Len()-1] != 0xff {
			return false
		}
		let arr = []int64{pos, neg}
		let encArr = Encode(arr)
		encArr.Len() == 1+encPos.Len()+encNeg.Len() && encArr[0] == byte(4*32+2)
	})
	match outcome {
	case gen.Held:
		true
	case gen.Refuted, gen.GaveUp:
		false
	}
}
