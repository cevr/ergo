// Package evidence probes P7 structured bounded-test evidence on a member law
// using explore.CheckPathsWithSink alongside an ordinary proved finite law.
import explore
import sync
import testing

type evCmd = evInc{} | evReset{}

type evOpenErr { Why string }

type evDriveErr { Why string }

type evSess {
	val      sync.Ref[int],
	released sync.Ref[bool],
} implements explore.PathSession[evCmd, explore.Observed[int, int, Never], evDriveErr]

func Read(s evSess) explore.Observed[int, int, Never] fails evDriveErr {
	explore.InitialRead[int]{State: s.val.Get()}
}

func Apply(s evSess, c evCmd) explore.Observed[int, int, Never] fails evDriveErr {
	let next = match c {
	case evInc:
		let v = s.val.Get() + 1
		s.val.Set(v)
		v
	case evReset:
		s.val.Set(0)
		0
	}
	explore.StepResult[int, int, Never]{Step: explore.StepObs[int, int, Never]{
		Kind:     explore.DisEmit,
		State:    Some[int]{Value: next},
		Outputs:  []int{next},
		Error:    None,
		Terminal: false,
	}}
}

func Close(s evSess) {
	s.released.Set(true)
}

func evModel() explore.PathModel[int, evCmd, int, int, Never] {
	explore.PathModelOfMachine[int, evCmd, int](
		[]int{0},
		[]evCmd{evInc, evReset},
		func(s int, c evCmd) Decision[int, int] {
			match c {
			case evInc:
				Emit[int, int]{Next: s + 1, Output: s + 1}
			case evReset:
				Emit[int, int]{Next: 0, Output: 0}
			}
		},
	)
}

// CounterBackend opens a fresh counter session per path case.
type CounterBackend {
	Open(start int) explore.PathSession[evCmd, explore.Observed[int, int, Never], evDriveErr] fails evOpenErr,

	law PathsMatch() {
		let res = explore.CheckPathsWithSink(
			evModel(),
			explore.ToDepth{Depth: 2},
			explore.PathBounds{MaxStates: 64, MaxEdges: 256, MaxPaths: 256, MaxSteps: 1024, MaxWork: 8192, MaxBytes: 65536},
			func(start int) explore.PathSession[evCmd, explore.Observed[int, int, Never], evDriveErr] fails evOpenErr {
				try Open(start)
			},
			testing.ActiveEvidenceSink(),
		)
		match res.Verdict {
		case explore.CampaignPassed:
			true
		case explore.CampaignRefuted, explore.CampaignIncomplete:
			false
		}
	},
}

// MemCounter implements CounterBackend in memory.
type MemCounter {} implements CounterBackend

func Open(_ MemCounter, start int) explore.PathSession[evCmd, explore.Observed[int, int, Never], evDriveErr] fails evOpenErr {
	evSess{val: sync.NewRef(start), released: sync.NewRef(false)}
}

let onMemCounter = context { CounterBackend: MemCounter }

law FiniteControl() {
	1+1 == 2
}
