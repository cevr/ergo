// Package keyfile is the text of the key store: a JSON object of
// strings, as JavaScript's JSON.parse reads it and JSON.stringify writes
// it. The text is std json's: Open checks it whole, and its Reader and
// Text read and write the object's members in their order, which a Map's
// derived codec would not keep (JSON.parse keeps it). It is pure.

import json
import okrakeys/keys

// Decode is the keys of text, or None when text is not a JSON object
// whose values are all strings: the original then treats the store as
// empty. A name given twice keeps its first place and its last value, as
// JSON.parse does.
func Decode(text string) Option[keys.Keys] {
	let r = json.Open(text, 0, 0) catch {
	case json.Malformed:
		return None
	}
	read(r) catch {
	case WireWrongKind:
		None
	}
}

// read is the object r holds, member by member.
func read(r json.Reader) Option[keys.Keys] fails WireWrongKind {
	try r.BeginObject()
	let mut k = keys.Empty()
	for r.More() {
		let name = r.Key()
		k = k.Set(name, try r.String())
	}
	r.End()
	Some[keys.Keys]{Value: k}
}

// Encode is k as JSON.stringify writes it: compact, in k's order, each
// string with JSON's escapes (std json writes \b and \f as \u0008 and
// \u000c, and U+2028 and U+2029 escaped, which JSON.parse reads the same).
func Encode(k keys.Keys) string {
	let t = json.NewText()
	t.BeginObject(len(k.Entries()))
	for e in k.Entries() {
		t.Key(e.Name)
		t.String(e.Secret)
	}
	t.EndObject()
	t.Written()
}

// Quote is s as a JSON string.
func Quote(s string) string {
	let t = json.NewText()
	t.String(s)
	t.Written()
}
