// Vault's tests: it keeps keys.Store's law, restated here because a member
// law runs only for providers in its type's own package (G-exup-1).

import okrakeys/keys

test LoadSeesSaveHolds(names []string, secrets []string) {
	let v = NewVault(keys.Empty())
	let mut k = keys.Empty()
	for i, name in names {
		k = k.Set(name, if i < len(secrets) { secrets[i] } else { "s" })
	}
	let _ = try v.Save(k)
	assert try v.Load() == k
}
