// Home's tests run it over an fstest.Memory, with no host: it keeps
// keys.Store's law, reads what the original writes, writes the key file
// for its owner alone, and treats a file that is not an object of strings
// as no keys.

import fs
import fstest
import okrakeys/keys

func home(d fstest.Memory, dir string) Home { New(d, d, Some[string]{Value: dir}) }

test SavesWhereTheOriginalDoes {
	let d = fstest.NewMemory()
	let h = home(d, ".")
	assert try h.Save(keys.Empty().Set("openai", "sk-1").Set("10", "n")) == ".okra/keys.json"
	assert try d.ReadFile(".okra/keys.json") == "{\"10\":\"n\",\"openai\":\"sk-1\"}\n"
	assert try home(d, "/home/u/").Save(keys.Empty()) == "/home/u/.okra/keys.json"
}

test TheKeyFileIsTheOwners {
	let d = fstest.NewMemory()
	let file = try home(d, "/h").Save(keys.Empty().Set("openai", "sk-1"))
	assert (try d.Stat(file)).Perm == fs.Perm(fs.Private())
	assert (try d.Stat("/h/.okra")).Perm == fs.Perm(fs.PrivateDir())
	// A file that was there with a wider mode is narrowed.
	try d.Chmod(file, fs.Shared())
	let _ = try home(d, "/h").Save(keys.Empty())
	assert (try d.Stat(file)).Perm == fs.Perm(fs.Private())
}

func failure(h Home) string {
	let _ = h.Save(keys.Empty()) catch {
	case keys.StoreFailed as s:
		return s.Message
	}
	let _ = h.Load() catch {
	case keys.StoreFailed as s:
		return s.Message
	}
	"ok"
}

test FailuresNameThePath {
	let d = fstest.NewMemory()
	assert failure(New(d, d, None)) == "HOME environment variable is not set"
	try d.WriteFile("/file", "not a directory")
	assert failure(home(d, "/file")) == "Cannot create /file/.okra: not a directory"
	try d.MkdirAll("/h/.okra/keys.json")
	assert failure(home(d, "/h")) == "Cannot write /h/.okra/keys.json: is a directory"
}

test BadFilesAreEmpty {
	let d = fstest.NewMemory()
	try d.MkdirAll("h/.okra")
	try d.WriteFile("h/.okra/keys.json", "{\"a\":1}")
	assert len((try home(d, "h").Load()).Entries()) == 0
	assert len((try home(d, "none").Load()).Entries()) == 0
}

test LoadSeesSaveHolds(names []string, secrets []string) {
	let h = home(fstest.NewMemory(), "/h")
	let mut k = keys.Empty()
	for i, name in names {
		k = k.Set(name, if i < len(secrets) { secrets[i] } else { "s" })
	}
	let _ = try h.Save(k)
	assert try h.Load() == k
}
