// Package pad is the digit entry of a pairing screen: a small pure machine
// that the flow keeps in a field of its state and steps with Press (the
// region pattern: a sub-machine held as data, M56).

import strings

// Pad is the digits typed so far, and how many the field takes.
type Pad { Text string, Max int }

// DigitsRegionTotal: whatever is pressed, the pad holds only digits and
// never more than it takes.
law DigitsRegionTotal(max int, presses []int) {
	let p = fill(max, presses)
	p.Text.Len() <= p.Max && digitsOnly(p.Text)
}

// keyOf reads a generated number as a key: a negative number is Erase, any
// other is a digit, some of them out of range.
func keyOf(n int) Key {
	if n < 0 {
		Erase
	} else {
		Digit{D: n % 12}
	}
}

// fill is a pad of max digits after the presses.
func fill(max int, presses []int) Pad {
	let mut p = Empty(if max < 0 { 0 } else { max % 12 })
	for n in presses {
		p = Press(p, keyOf(n))
	}
	p
}

// digitsOnly reports whether s holds only the digits 0 to 9.
func digitsOnly(s string) bool {
	let mut rest = s
	for d in 0..10 {
		rest = strings.ReplaceAll(rest, "\(d)", "")
	}
	rest == ""
}

// Key is a key of the on-screen pad.
type Key = Digit{D int} | Erase{}

// EraseUndoesDigit: a digit that the pad takes, then Erase, gives the pad
// back.
law EraseUndoesDigit(max int, presses []int, d int) {
	let p = fill(max, presses)
	let digit = if d < 0 { -d % 10 } else { d % 10 }
	Full(p) || Press(Press(p, Digit{D: digit}), Erase) == p
}

// Empty is a pad with no digits that takes max of them.
func Empty(max int) Pad { Pad{Text: "", Max: max} }

// Press is the pad after the key k. A digit outside 0 to 9 and a digit on
// a full pad change nothing; Erase on an empty pad changes nothing.
func Press(p Pad, k Key) Pad {
	match k {
	case Digit as d:
		if d.D < 0 || d.D > 9 || p.Text.Len() >= p.Max {
			p
		} else {
			Pad{..p, Text: p.Text + "\(d.D)"}
		}
	case Erase:
		if p.Text.Len() == 0 {
			p
		} else {
			Pad{..p, Text: p.Text[0 : p.Text.Len()-1]}
		}
	}
}

// Full reports whether the pad holds all its digits.
func Full(p Pad) bool { p.Text.Len() == p.Max }
