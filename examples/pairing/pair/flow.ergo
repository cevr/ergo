// Package pair is a device pairing screen: a serial number and a one-time
// code, or a device tag tap. The flow is a machine whose states own
// their work (sending and checking a code) and their timer (an error
// screen returns to the start after 30 s).

import machines
import option
import pairing/pad
import slices

// Methods are the ways in that the screen offers: the machine's input.
type Methods { Serial bool, Tag bool }

// ThreeStrikes: three wrong codes for one serial lock it; two do not.
law ThreeStrikes(n int, serial []int, code []int) {
	let on = Methods{Serial: true, Tag: n%2 == 0}
	let attempt = slices.Concat(presses(CodeDigits(), code), []Signal{Submit, wrongCode()})
	let mut script = slices.Concat(slices.Concat([]Signal{UseSerial}, presses(SerialDigits(), serial)), []Signal{Submit, CodeSent})
	for _ in 0..MaxTries()-1 {
		script = slices.Concat(script, attempt)
	}
	let _, early = fold(Start(on), script)
	let _, end = fold(Start(on), slices.Concat(script, attempt))
	match (early, end) {
	case (option.None, option.Some[Result] as r):
		match r.Value {
		case Locked:
			true
		case Paired:
			false
		case Cancelled:
			false
		}
	case (_, _):
		false
	}
}

// fold steps s over the signals as the actor would, with the work's
// results given as signals; it stops at Done. A Reject keeps the state,
// as the live actor does; machines.Run would fail Rejected there.
func fold(s Flow, signals []Signal) (Flow, option.Option[Result]) {
	let mut at = s
	for e in signals {
		match Step(at, e) {
		case machines.Done[Result] as d:
			return (at, option.Some{d.Output})
		case machines.Enter[Flow] as x:
			at = x.Next
		case machines.Stay[Flow] as x:
			at = x.Next
		case machines.Emit[Flow, Result] as x:
			at = x.Next
		case machines.Ignore, machines.Tell[Flow, Result]:
		case machines.Reject:
		}
	}
	(at, option.None)
}

// presses is n digit presses, from digits and then 1s.
func presses(n int, digits []int) []Signal {
	let mut out = []Signal{}
	for i in 0..n {
		let d = if i < digits.Len() { (digits[i]%10 + 10) % 10 } else { 1 }
		out = out.Append(Press{Key: pad.Digit{D: d}})
	}
	out
}

// Proof is what a verify checks.
type Proof = ByCode{Serial string, Code string, Tries int} | ByTag{Tag string}

// Flow is the screen's state. The pads are the digit-entry sub-machine,
// held as data.
type Flow =
	| Options{On Methods}
	| EnteringSerial{On Methods, Pad pad.Pad}
	| SendingCode{On Methods, Serial string}
	| EnteringCode{On Methods, Serial string, Pad pad.Pad, Tries int}
	| Verifying{On Methods, Via Proof}
	| Failed{On Methods, Why string}

// CodeOnlyAfterSend: the code pad opens only from a sent code, or again
// after a wrong one; a Stay on it is a key press.
law CodeOnlyAfterSend(n int, digits []int, text string) {
	let s = sample(n, digits, text)
	for m in 0..12 {
		if !codeOpensRightly(s, signalOf(m, text)) {
			return false
		}
	}
	true
}

// signalOf is a signal of every variant, picked by n.
func signalOf(n int, text string) Signal {
	let k = if n < 0 { -n } else { n }
	match k % 12 {
	case 0:
		UseSerial
	case 1:
		Press{Key: pad.Digit{D: k % 10}}
	case 2:
		Press{Key: pad.Erase}
	case 3:
		Submit
	case 4:
		Tapped{Tag: text}
	case 5:
		CodeSent
	case 6:
		SendFailed{Why: text}
	case 7:
		Accepted{Who: Device{ID: text, Name: text}}
	case 8:
		wrongCode()
	case 9:
		let u Signal = UnknownTag
		u
	case 10:
		Back
	case _:
		Cancel
	}
}

// enters is the state a decision moves to, if it moves.
func enters(d machines.Decision[Flow, Result]) option.Option[Flow] {
	match d {
	case machines.Enter[Flow] as x:
		option.Some{x.Next}
	case machines.Stay[Flow] as x:
		option.Some{x.Next}
	case machines.Emit[Flow, Result] as x:
		option.Some{x.Next}
	case machines.Ignore, machines.Tell[Flow, Result]:
		option.None
	case machines.Reject:
		option.None
	case machines.Done[Result]:
		option.None
	}
}

// codeOpensRightly reports whether a step that moves to the code pad
// comes from a sent code, a wrong code, or a key on the pad.
func codeOpensRightly(s Flow, e Signal) bool {
	match enters(Step(s, e)) {
	case option.Some[Flow] as next:
		match next.Value {
		case EnteringCode:
			match (s, e) {
			case (SendingCode, CodeSent):
				true
			case (Verifying, WrongCode):
				true
			case (EnteringCode, Press):
				true
			case (_, _):
				false
			}
		case _:
			true
		}
	case option.None:
		true
	}
}

// wrongCode is the WrongCode signal as a value: WrongCode is also a
// failure type, and a failure type's value that ends a function fails
// (rows.md, Tail results 3), so it is bound as a Signal first.
func wrongCode() Signal {
	let w Signal = WrongCode
	w
}

// FailedReturns: an error screen's timer is 30 s, and its signal starts
// the flow again with the same methods.
law FailedReturns(n int, why string) {
	let on = methodsOf(n)
	let f = Failed{On: on, Why: why}
	match timer(f) {
	case option.Some[machines.Timeout[Signal]] as t:
		t.Value.In == 30s && enters(Step(f, t.Value.Signal)) == option.Some[Flow]{Start(on)}
	case option.None:
		false
	}
}

// Signal is what the flow takes: keys and taps from the operator, results
// of the states' work, and the error screen's timer.
type Signal =
	| UseSerial{}
	| Press{Key pad.Key}
	| Submit{}
	| Tapped{Tag string}
	| CodeSent{}
	| SendFailed{Why string}
	| Accepted{Who Device}
	| WrongCode
	| UnknownTag
	| Back{}
	| Cancel{}

// CancelAlwaysEnds: Cancel ends the flow with Cancelled from every state.
law CancelAlwaysEnds(n int, digits []int, text string) {
	match Step(sample(n, digits, text), Cancel) {
	case machines.Done[Result] as d:
		d.Output == Cancelled
	case machines.Enter[Flow]:
		false
	case machines.Stay[Flow]:
		false
	case machines.Emit[Flow, Result], machines.Tell[Flow, Result]:
		false
	case machines.Ignore:
		false
	case machines.Reject:
		false
	}
}

// methodsOf reads a generated number as the methods on.
func methodsOf(n int) Methods { Methods{Serial: n%2 == 0, Tag: n%3 != 0} }

// padOf is a pad of max digits holding up to max of the digits. When the
// count of digits is even it is filled up with 7s, so half the pads are
// full.
func padOf(max int, digits []int) pad.Pad {
	let mut p = pad.Empty(max)
	for d in digits {
		p = pad.Press(p, pad.Digit{D: if d < 0 { -d % 10 } else { d % 10 }})
	}
	if digits.Len()%2 == 0 {
		for _ in 0..max {
			p = pad.Press(p, pad.Digit{D: 7})
		}
	}
	p
}

// sample is a state of every variant, picked by n.
func sample(n int, digits []int, text string) Flow {
	let k = if n < 0 { -n } else { n }
	let on = methodsOf(k / 8)
	let tries = k % MaxTries()
	match k % 8 {
	case 0:
		Options{On: on}
	case 1:
		EnteringSerial{On: on, Pad: padOf(SerialDigits(), digits)}
	case 2:
		SendingCode{On: on, Serial: text}
	case 3:
		EnteringCode{On: on, Serial: text, Pad: padOf(CodeDigits(), digits), Tries: tries}
	case 4:
		Verifying{On: on, Via: ByCode{Serial: text, Code: text, Tries: tries}}
	case 5:
		Verifying{On: on, Via: ByTag{Tag: text}}
	case 6:
		Failed{On: on, Why: text}
	case _:
		Settle(Options{On: on})
	}
}

// Result is how a pairing ends.
type Result = Paired{Who Device} | Locked{Serial string} | Cancelled{}

// SerialDigits is the length of a serial number; CodeDigits of a code;
// MaxTries the wrong codes that lock the serial.
func SerialDigits() int { 10 }

func CodeDigits() int { 4 }

func MaxTries() int { 3 }

// Pair is the flow as a machine.
type Pair machine[Flow, Signal] { initial: Start, step: Step, after: timer, work: work }

// Start is the first state for the methods on.
func Start(on Methods) Flow { Settle(Options{On: on}) }

// SettleSkipsOnlyNoChoice: the flow starts on the serial pad exactly when
// the serial is the only method; with a tag on, the screen waits for a
// choice or a tap.
law SettleSkipsOnlyNoChoice(n int) {
	let on = methodsOf(n)
	match Start(on) {
	case EnteringSerial:
		on.Serial && !on.Tag
	case Options:
		!(on.Serial && !on.Tag)
	case _:
		false
	}
}

// Settle is the eventless step (M48 pattern): a state that has nothing to
// choose becomes the state it would choose. Options with the serial as the
// only method is the serial pad at once.
func Settle(s Flow) Flow {
	match s {
	case Options as o:
		if o.On.Serial && !o.On.Tag {
			EnteringSerial{On: o.On, Pad: pad.Empty(SerialDigits())}
		} else {
			s
		}
	case EnteringSerial:
		s
	case SendingCode:
		s
	case EnteringCode:
		s
	case Verifying:
		s
	case Failed:
		s
	}
}

// SettleIsStable: settling a settled state changes nothing.
law SettleIsStable(n int, digits []int, text string) {
	let s = Settle(sample(n, digits, text))
	Settle(s) == s
}

// Waits reports whether the state waits for the operator: no work runs in
// it, so a driver that waits for it sees the work's answer.
func Waits(s Flow) bool {
	match s {
	case Options:
		true
	case EnteringSerial:
		true
	case SendingCode:
		false
	case EnteringCode:
		true
	case Verifying:
		false
	case Failed:
		true
	}
}

// TagSkipsSerial: a tap in a waiting state of a screen that takes tags
// verifies the tag at once, whatever was typed.
law TagSkipsSerial(n int, digits []int, tag string) {
	let s = sample(n, digits, tag)
	!Waits(s) || !methodsIn(s).Tag || enters(Step(s, Tapped{Tag: tag})) == option.Some[Flow]{Verifying{On: methodsIn(s), Via: ByTag{Tag: tag}}}
}

// methodsIn is the methods of a state.
func methodsIn(s Flow) Methods {
	match s {
	case Options as x:
		x.On
	case EnteringSerial as x:
		x.On
	case SendingCode as x:
		x.On
	case EnteringCode as x:
		x.On
	case Verifying as x:
		x.On
	case Failed as x:
		x.On
	}
}

// into enters next, settled.
func into(next Flow) machines.Decision[Flow, Result] { machines.Enter[Flow]{Next: Settle(next)} }

// tap is a tag tap in a state that waits for the operator: it skips the
// serial and verifies the tag, when the screen takes tags.
func tap(on Methods, tag string) machines.Decision[Flow, Result] {
	if on.Tag {
		into(Verifying{On: on, Via: ByTag{Tag: tag}})
	} else {
		machines.Reject
	}
}

// wrong is a wrong code: the code pad again, or Locked at the last try.
func wrong(v Verifying) machines.Decision[Flow, Result] {
	match v.Via {
	case ByCode as b:
		if b.Tries+1 >= MaxTries() {
			machines.Done[Result]{Output: Locked{Serial: b.Serial}}
		} else {
			into(EnteringCode{On: v.On, Serial: b.Serial, Pad: pad.Empty(CodeDigits()), Tries: b.Tries + 1})
		}
	case ByTag:
		machines.Ignore
	}
}

// Step is the flow's step. Cancel ends it from every state; each state
// then lists what it takes, and ignores the rest.
func Step(s Flow, e Signal) machines.Decision[Flow, Result] {
	match (s, e) {
	case (_, Cancel):
		machines.Done[Result]{Output: Cancelled}
	case (Options as o, UseSerial):
		if o.On.Serial {
			into(EnteringSerial{On: o.On, Pad: pad.Empty(SerialDigits())})
		} else {
			machines.Reject
		}
	case (Options as o, Tapped as c):
		tap(o.On, c.Tag)
	case (Options, _):
		machines.Ignore
	case (EnteringSerial as p, Press as k):
		machines.Stay[Flow]{Next: EnteringSerial{..p, Pad: pad.Press(p.Pad, k.Key)}}
	case (EnteringSerial as p, Submit):
		if pad.Full(p.Pad) {
			into(SendingCode{On: p.On, Serial: p.Pad.Text})
		} else {
			machines.Reject
		}
	case (EnteringSerial as p, Tapped as c):
		tap(p.On, c.Tag)
	case (EnteringSerial, _):
		machines.Ignore
	case (SendingCode as w, CodeSent):
		into(EnteringCode{On: w.On, Serial: w.Serial, Pad: pad.Empty(CodeDigits()), Tries: 0})
	case (SendingCode as w, SendFailed as f):
		into(Failed{On: w.On, Why: f.Why})
	case (SendingCode, _):
		machines.Ignore
	case (EnteringCode as c, Press as k):
		machines.Stay[Flow]{Next: EnteringCode{..c, Pad: pad.Press(c.Pad, k.Key)}}
	case (EnteringCode as c, Submit):
		if pad.Full(c.Pad) {
			into(Verifying{On: c.On, Via: ByCode{Serial: c.Serial, Code: c.Pad.Text, Tries: c.Tries}})
		} else {
			machines.Reject
		}
	case (EnteringCode as c, Tapped as sc):
		tap(c.On, sc.Tag)
	case (EnteringCode, _):
		machines.Ignore
	case (Verifying, Accepted as a):
		machines.Done[Result]{Output: Paired{Who: a.Who}}
	case (Verifying as v, WrongCode):
		wrong(v)
	case (Verifying as v, UnknownTag):
		into(Failed{On: v.On, Why: "unknown tag"})
	case (Verifying, _):
		machines.Ignore
	case (Failed as f, Back):
		into(Options{On: f.On})
	case (Failed as f, Tapped as c):
		tap(f.On, c.Tag)
	case (Failed, _):
		machines.Ignore
	}
}

// timer is each state's timer: an error screen returns to the start after
// 30 s. The runner owns it: a re-entry restarts it, and it never fires
// after its entry ended.
func timer(s Flow) option.Option[machines.Timeout[Signal]] {
	match s {
	case Failed:
		option.Some{machines.Timeout[Signal]{In: 30s, Signal: Back}}
	case Options:
		option.None
	case EnteringSerial:
		option.None
	case SendingCode:
		option.None
	case EnteringCode:
		option.None
	case Verifying:
		option.None
	}
}

// work is each state's work against Devices. The runner starts it after the
// state's entry commits and interrupts it when the entry ends, so a Cancel
// during a verify drops its answer. WrongCode and UnknownTag are signals
// and need no map; DeviceUnreachable is mapped to SendFailed.
func work(s Flow) option.Option[machines.Work[Signal, Devices]] {
	match s {
	case SendingCode as w:
		option.Some{machines.Attempt(func() Signal fails DeviceUnreachable needs Devices {
			try Devices.Send(w.Serial)
			CodeSent
		}, func(sent Signal) Signal { sent }, func(f) {
			match f {
			case DeviceUnreachable as u:
				SendFailed{Why: "cannot send a code to \(u.Serial)"}
			}
		})}
	case Verifying as v:
		match v.Via {
		case ByCode as b:
			option.Some{machines.Attempt(func() Device fails WrongCode needs Devices { try Devices.Check(b.Serial, b.Code) }, func(m Device) Signal { Accepted{Who: m} }, func(failure) {
				let wrong Signal = failure
				wrong
			})}
		case ByTag as c:
			option.Some{machines.Attempt(func() Device fails UnknownTag needs Devices { try Devices.Tag(c.Tag) }, func(m Device) Signal { Accepted{Who: m} }, func(failure) {
				let unknown Signal = failure
				unknown
			})}
		}
	case Options:
		option.None
	case EnteringSerial:
		option.None
	case EnteringCode:
		option.None
	case Failed:
		option.None
	}
}
