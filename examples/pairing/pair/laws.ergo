// The flow's rules as laws over generated states and signals. They are
// top-level laws over the step (machine laws, MU6, are not on this base);
// ergo test runs them.

import slices
import pairing/pad

// methodsOf reads a generated number as the methods on.
func methodsOf(n int) Methods { Methods{Serial: n%2 == 0, Tag: n%3 != 0} }

// padOf is a pad of max digits holding up to max of the digits. When the
// count of digits is even it is filled up with 7s, so half the pads are
// full.
func padOf(max int, digits []int) pad.Pad {
	let mut p = pad.Empty(max)
	for d in digits {
		p = pad.Press(p, pad.Digit{D: if d < 0 { -d % 10 } else { d % 10 }})
	}
	if len(digits)%2 == 0 {
		for _ in 0..max {
			p = pad.Press(p, pad.Digit{D: 7})
		}
	}
	p
}

// sample is a state of every variant, picked by n.
func sample(n int, digits []int, text string) Flow {
	let k = if n < 0 { -n } else { n }
	let on = methodsOf(k / 8)
	let tries = k % MaxTries()
	match k % 8 {
	case 0:
		Options{On: on}
	case 1:
		EnteringSerial{On: on, Pad: padOf(SerialDigits(), digits)}
	case 2:
		SendingCode{On: on, Serial: text}
	case 3:
		EnteringCode{On: on, Serial: text, Pad: padOf(CodeDigits(), digits), Tries: tries}
	case 4:
		Verifying{On: on, Via: ByCode{Serial: text, Code: text, Tries: tries}}
	case 5:
		Verifying{On: on, Via: ByTag{Tag: text}}
	case 6:
		Failed{On: on, Why: text}
	case _:
		Settle(Options{On: on})
	}
}

// signalOf is a signal of every variant, picked by n.
func signalOf(n int, text string) Signal {
	let k = if n < 0 { -n } else { n }
	match k % 12 {
	case 0:
		UseSerial
	case 1:
		Press{Key: pad.Digit{D: k % 10}}
	case 2:
		Press{Key: pad.Erase}
	case 3:
		Submit
	case 4:
		Tapped{Tag: text}
	case 5:
		CodeSent
	case 6:
		SendFailed{Why: text}
	case 7:
		Accepted{Who: Device{ID: text, Name: text}}
	case 8:
		wrongCode()
	case 9:
		let u Signal = UnknownTag
		u
	case 10:
		Back
	case _:
		Cancel
	}
}

// enters is the state a decision moves to, if it moves.
func enters(d Decision[Flow, Result]) Option[Flow] {
	match d {
	case Enter[Flow] as x:
		Some{x.Next}
	case Stay[Flow] as x:
		Some{x.Next}
	case Emit[Flow, Result] as x:
		Some{x.Next}
	case Ignore:
		None
	case Reject:
		None
	case Done[Result]:
		None
	}
}

// fold steps s over the signals as the actor would, with the work's
// results given as signals; it stops at Done. A Reject keeps the state,
// as the live actor does; machines.Run would fail Rejected there.
func fold(s Flow, signals []Signal) (Flow, Option[Result]) {
	let mut at = s
	for e in signals {
		match Step(at, e) {
		case Done[Result] as d:
			return (at, Some{d.Output})
		case Enter[Flow] as x:
			at = x.Next
		case Stay[Flow] as x:
			at = x.Next
		case Emit[Flow, Result] as x:
			at = x.Next
		case Ignore:
		case Reject:
		}
	}
	(at, None)
}

// methodsIn is the methods of a state.
func methodsIn(s Flow) Methods {
	match s {
	case Options as x:
		x.On
	case EnteringSerial as x:
		x.On
	case SendingCode as x:
		x.On
	case EnteringCode as x:
		x.On
	case Verifying as x:
		x.On
	case Failed as x:
		x.On
	}
}

// CancelAlwaysEnds: Cancel ends the flow with Cancelled from every state.
law CancelAlwaysEnds(n int, digits []int, text string) {
	match Step(sample(n, digits, text), Cancel) {
	case Done[Result] as d:
		d.Output == Cancelled
	case Enter[Flow]:
		false
	case Stay[Flow]:
		false
	case Emit[Flow, Result]:
		false
	case Ignore:
		false
	case Reject:
		false
	}
}

// CodeOnlyAfterSend: the code pad opens only from a sent code, or again
// after a wrong one; a Stay on it is a key press.
law CodeOnlyAfterSend(n int, digits []int, text string) {
	let s = sample(n, digits, text)
	for m in 0..12 {
		if !codeOpensRightly(s, signalOf(m, text)) {
			return false
		}
	}
	true
}

// codeOpensRightly reports whether a step that moves to the code pad
// comes from a sent code, a wrong code, or a key on the pad.
func codeOpensRightly(s Flow, e Signal) bool {
	match enters(Step(s, e)) {
	case Some[Flow] as next:
		match next.Value {
		case EnteringCode:
			match (s, e) {
			case (SendingCode, CodeSent):
				true
			case (Verifying, WrongCode):
				true
			case (EnteringCode, Press):
				true
			case (_, _):
				false
			}
		case _:
			true
		}
	case None:
		true
	}
}

// TagSkipsSerial: a tap in a waiting state of a screen that takes tags
// verifies the tag at once, whatever was typed.
law TagSkipsSerial(n int, digits []int, tag string) {
	let s = sample(n, digits, tag)
	!Waits(s) || !methodsIn(s).Tag || enters(Step(s, Tapped{Tag: tag})) == Some[Flow]{Verifying{On: methodsIn(s), Via: ByTag{Tag: tag}}}
}

// presses is n digit presses, from digits and then 1s.
func presses(n int, digits []int) []Signal {
	let mut out = []Signal{}
	for i in 0..n {
		let d = if i < len(digits) { (digits[i]%10 + 10) % 10 } else { 1 }
		out = out.Append(Press{Key: pad.Digit{D: d}})
	}
	out
}

// wrongCode is the WrongCode signal as a value: WrongCode is also a
// failure type, and a failure type's value that ends a function fails
// (rows.md, Tail results 3), so it is bound as a Signal first.
func wrongCode() Signal {
	let w Signal = WrongCode
	w
}

// ThreeStrikes: three wrong codes for one serial lock it; two do not.
law ThreeStrikes(n int, serial []int, code []int) {
	let on = Methods{Serial: true, Tag: n%2 == 0}
	let attempt = slices.Concat(presses(CodeDigits(), code), []Signal{Submit, wrongCode()})
	let mut script = slices.Concat(slices.Concat([]Signal{UseSerial}, presses(SerialDigits(), serial)), []Signal{Submit, CodeSent})
	for _ in 0..MaxTries()-1 {
		script = slices.Concat(script, attempt)
	}
	let _, early = fold(Start(on), script)
	let _, end = fold(Start(on), slices.Concat(script, attempt))
	match (early, end) {
	case (None, Some[Result] as r):
		match r.Value {
		case Locked:
			true
		case Paired:
			false
		case Cancelled:
			false
		}
	case (_, _):
		false
	}
}

// SettleSkipsOnlyNoChoice: the flow starts on the serial pad exactly when
// the serial is the only method; with a tag on, the screen waits for a
// choice or a tap.
law SettleSkipsOnlyNoChoice(n int) {
	let on = methodsOf(n)
	match Start(on) {
	case EnteringSerial:
		on.Serial && !on.Tag
	case Options:
		!(on.Serial && !on.Tag)
	case _:
		false
	}
}

// SettleIsStable: settling a settled state changes nothing.
law SettleIsStable(n int, digits []int, text string) {
	let s = Settle(sample(n, digits, text))
	Settle(s) == s
}

// FailedReturns: an error screen's timer is 30 s, and its signal starts
// the flow again with the same methods.
law FailedReturns(n int, why string) {
	let on = methodsOf(n)
	let f = Failed{On: on, Why: why}
	match timer(f) {
	case Some[Timeout[Signal]] as t:
		t.Value.In == 30s && enters(Step(f, t.Value.Signal)) == Some[Flow]{Start(on)}
	case None:
		false
	}
}
