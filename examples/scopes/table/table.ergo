// Package table is a symbol table of nested scopes, read and written
// through a borrow, as a resolver walks a program. A lookup reads one
// scope out of the Map of scopes through the borrow and copies nothing
// (the entry rule, docs/spec/types.md, Bindings); it costs the scopes it
// walks, not the size of the table.

import option

// Table holds each scope's names and each scope's parent. Scope 0, the
// root, is its own parent.
type Table { scopes Map[int, Map[string, int]], parents Map[int, int] }

// New is a table with the root scope only.
func New() Table {
	Table{scopes: Map[int, Map[string, int]]{0: Map[string, int]{}}, parents: Map[int, int]{0: 0}}
}

// InnerShadows: a name declared in an inner scope hides the outer one,
// and the outer scope still sees its own.
law InnerShadows(a int, b int) {
	let mut t = New()
	let _ = OpenScope(&t, 1, 0)
	let _ = Declare(&t, 0, "x", a)
	let _ = Declare(&t, 1, "x", b)
	let inner = match Resolve(&t, 1, "x") {
	case Bound as r:
		r.Value == b && r.Out == 0
	case Unbound:
		false
	}
	let outer = match Resolve(&t, 0, "x") {
	case Bound as r:
		r.Value == a && r.Out == 0
	case Unbound:
		false
	}
	inner && outer
}

// FoundOutward: a name bound only at the root is found k scopes out from
// a chain k deep, and a name bound nowhere is unbound.
law FoundOutward(n int, v int) {
	let k = small(n)
	let mut t = New()
	let _ = Declare(&t, 0, "root", v)
	for i in 1..k+1 {
		let _ = OpenScope(&t, i, i-1)
	}
	let found = match Resolve(&t, k, "root") {
	case Bound as r:
		r.Value == v && r.Out == k
	case Unbound:
		false
	}
	let missing = match Resolve(&t, k, "nowhere") {
	case Bound:
		false
	case Unbound:
		true
	}
	found && missing
}

func small(n int) int { (if n < 0 { -(n + 1) } else { n }) % 8 }

// Opened is the outcome of opening a scope.
type Opened = Open{} | Taken{} | NoScope{}

// OpenOnce: a scope opens once, and only inside an open scope.
law OpenOnce(n int) {
	let s = 1 + small(n)
	let mut t = New()
	let first = OpenScope(&t, s, 0)
	let again = OpenScope(&t, s, 0)
	let orphan = OpenScope(&t, s+10, s+20)
	let firstOK = match first {
	case Open:
		true
	case Taken, NoScope:
		false
	}
	let againOK = match again {
	case Taken:
		true
	case Open, NoScope:
		false
	}
	let orphanOK = match orphan {
	case NoScope:
		true
	case Open, Taken:
		false
	}
	firstOK && againOK && orphanOK
}

// OpenScope opens scope s inside scope parent.
func OpenScope(t mut Table, s int, parent int) Opened {
	if t.scopes.Get(s) != option.None {
		return Taken
	}
	if t.scopes.Get(parent) == option.None {
		return NoScope
	}
	t.scopes[s] = Map[string, int]{}
	t.parents[s] = parent
	Open
}

// Declare binds name to value in scope s; it reports false when s is not
// open.
func Declare(t mut Table, s int, name string, value int) bool {
	match t.scopes.Get(s) {
	case option.Some[Map[string, int]] as m:
		let mut names = m.Value
		names[name] = value
		t.scopes[s] = names
		true
	case option.None:
		false
	}
}

// Resolved is a name's value and how many scopes out it was found, or
// that no scope on the way to the root binds it.
type Resolved = Bound{Value int, Out int} | Unbound{}

// Resolve looks name up in scope s, then in each enclosing scope.
func Resolve(t mut Table, s int, name string) Resolved {
	let mut at = s
	for out in 0..t.parents.Len()+1 {
		match t.scopes.Get(at) {
		case option.Some[Map[string, int]] as m:
			match m.Value.Get(name) {
			case option.Some[int] as v:
				return Bound{Value: v.Value, Out: out}
			case option.None:
			}
		case option.None:
			return Unbound
		}
		if at == 0 {
			return Unbound
		}
		match t.parents.Get(at) {
		case option.Some[int] as p:
			at = p.Value
		case option.None:
			return Unbound
		}
	}
	Unbound
}
