// Package view is the one view of the screen (PX3a): a function of the
// screen's state, whose loads call the pipeline.Pipeline it is given. It
// serves every host: the test host here, and the terminal, the desktop
// and the page hosts later (PX3b, PX4).

import pipeline/pipeline
import pipeline/pipeline/pipelineapi
import pipeline/run
import pipeline/screen
import ui
import strings
import testing
import actor
import github.com/cevr/ergo/modules/domain
import github.com/cevr/ergo/modules/domain/memory
import time
import pipeline/board

// SubmitOf, CancelOf, RetryOf and ShowOf are the requests of the form: what
// the buttons "submit", "cancel", "retry" and "show" ask.
func SubmitOf(f screen.Form) screen.Request {
	pipelineapi.SubmitRequest{C: pipeline.SubmitRun{ID: f.ID, Run: f.Run, Stages: screen.Number(f)}}
}

func CancelOf(f screen.Form) screen.Request {
	pipelineapi.CancelRequest{C: pipeline.CancelRun{ID: f.ID, Run: f.Run, Why: f.Why}}
}

func RetryOf(f screen.Form) screen.Request {
	pipelineapi.RetryRequest{C: pipeline.RetryRun{ID: f.ID, Run: f.Run, Stage: screen.Number(f)}}
}

func ShowOf(f screen.Form) screen.Request { pipelineapi.RunOfRequest{Id: f.Run} }

// Call is the reply of api to the command r. A read is not a command: its
// reply is Unavailable (the step never sends one).
func Call(r screen.Request) screen.Reply needs pipeline.Pipeline {
	let receipt = match r {
	case pipelineapi.SubmitRequest as x:
		pipeline.Pipeline.Submit(x.C)
	case pipelineapi.CancelRequest as x:
		pipeline.Pipeline.Cancel(x.C)
	case pipelineapi.RetryRequest as x:
		pipeline.Pipeline.Retry(x.C)
	case pipelineapi.BoardRequest, pipelineapi.RunOfRequest:
		return screen.Refused{Why: screen.Unavailable{Cause: pipeline.Unavailable}}
	} catch {
	case run.WrongState as e:
		return screen.Refused{Why: screen.WrongState{Cause: e}}
	case run.WrongStage as e:
		return screen.Refused{Why: screen.WrongStage{Cause: e}}
	case run.Closed as e:
		return screen.Refused{Why: screen.Closed{Cause: e}}
	case run.BadLength as e:
		return screen.Refused{Why: screen.BadLength{Cause: e}}
	case pipeline.NoSuchRun as e:
		return screen.Refused{Why: screen.NoSuchRun{Cause: e}}
	case pipeline.Unavailable as e:
		return screen.Refused{Why: screen.Unavailable{Cause: e}}
	}
	screen.Took{Receipt: receipt}
}

// Describe is the line the screen shows for a notice.
func Describe(n screen.Notice) string {
	match n {
	case screen.Quiet:
		"ready"
	case screen.Said as s:
		match s.Reply {
		case screen.Took as t:
			"took \(t.Receipt.Command) at \(t.Receipt.Position)"
		case screen.Refused as r:
			"refused: " + rejection(r.Why)
		}
	}
}

func rejection(r screen.Rejection) string {
	match r {
	case screen.WrongState as e:
		"\(e.Cause.Command) does not apply to a \(e.Cause.Status) run"
	case screen.WrongStage as e:
		"stage \(e.Cause.Got + 1) is not the failed stage \(e.Cause.Expected + 1)"
	case screen.Closed as e:
		"the run is \(e.Cause.Status)"
	case screen.BadLength as e:
		"a run has 1 to 9 stages, not \(e.Cause.Stages)"
	case screen.NoSuchRun as e:
		"no run \(e.Cause.Run)"
	case screen.Unavailable:
		"the pipeline does not run"
	}
}

// Sending is the line the screen shows while the command r is in flight.
func Sending(r screen.Request) string {
	match r {
	case pipelineapi.SubmitRequest as x:
		"sending submit \(x.C.ID)"
	case pipelineapi.CancelRequest as x:
		"sending cancel \(x.C.ID)"
	case pipelineapi.RetryRequest as x:
		"sending retry \(x.C.ID)"
	case pipelineapi.BoardRequest, pipelineapi.RunOfRequest:
		"reading"
	}
}

// Columns are the board's lines, one per column: "running: build, docs".
func Columns(l screen.Lines) []string {
	[]string{"queued: " + l.Queued, "running: " + l.Running, "failing: " + l.Failing, "passed: " + l.Passed, "stopped: " + l.Stopped}
}

// RunLine is the line of the picked run.
func RunLine(id string, r ui.Async[run.Run, pipeline.NoSuchRun]) string {
	match r {
	case ui.Loading:
		"\(id): loading"
	case ui.Ready[run.Run] as x:
		"\(id): " + runText(x.Value)
	case ui.Failed[pipeline.NoSuchRun]:
		"no run \(id)"
	}
}

func runText(r run.Run) string {
	match r {
	case run.Unsubmitted:
		"unsubmitted"
	case run.Queued as q:
		"queued, \(q.Stages) stages"
	case run.Running as x:
		"running stage \(x.Next + 1) of \(x.Stages)"
	case run.Failing as x:
		"stage \(x.Stage + 1) of \(x.Stages) failed"
	case run.Done as d:
		match d.Outcome {
		case run.Passed:
			"passed"
		case run.GaveUp as g:
			"gave up at stage \(g.Stage + 1)"
		case run.Cancelled as c:
			"cancelled: \(c.Why)"
		}
	}
}

// View is the view of the screen on the Pipeline in force: the view a host shows.
func View(f mut ui.Frame[screen.Signal], s screen.Screen) needs pipeline.Pipeline { Board(f, s) }

// ReplyIsShown: the view of a screen whose last command got reply shows a
// line that says so: "took ID at POSITION" for a receipt, "refused: " and
// the reason for a rejection.
law ReplyIsShown(reply screen.Reply) {
	let api = testing.Script[pipeline.Pipeline]{}
	let s = screen.Showing{Shown: screen.Shown{..screen.ShownOf(screen.Fresh), Notice: screen.Said{Reply: reply}}}
	let mut f = ui.NewFrame[screen.Signal]()
	let _ = with context { pipeline.Pipeline: api } { ui.Render(&f, View, s) }
	for line in texts(ui.FrameShape(&f)) {
		match reply {
		case screen.Took as t:
			if line == "took \(t.Receipt.Command) at \(t.Receipt.Position)" {
				return true
			}
		case screen.Refused:
			if strings.HasPrefix(line, "refused: ") && len(line) > len("refused: ") {
				return true
			}
		}
	}
	false
}

// texts are the values of the text nodes of shapes, in tree order.
func texts(shapes []ui.Shape[screen.Signal]) []string {
	let mut out = []string{}
	for s in shapes {
		match s.Node {
		case ui.TextNode as t:
			out = out.Append(t.Value)
		case _:
		}
		for t in texts(s.Kids) {
			out = out.Append(t)
		}
	}
	out
}

// HeldTryShowsRunningThenPassed: the screen of the in-process context
// whose runner holds its try submits a run of one stage; the board shows
// the run running (the busy state) while the try is held. Once a Release
// passes the try and the context settles, a refresh shows it passed.
law HeldTryShowsRunningThenPassed(pick int) {
	let name = pipeline.Names[((pick%3)+3)%3]
	let runner = testing.Script[pipeline.Runner]{}
	runner.Run.Hold()
	let clock = time.NewManual(0)
	with context { Scheduler: clock, pipeline.Runner: runner } {
		let m = pipeline.Open(memory.New[pipeline.Entry]()) catch {
		case domain.Conflict, domain.Reused, domain.Unkept:
			return false
		}
		with context { pipeline.Pipeline: m } {
			let a = actor.StartMachine(screen.Life{}, 8, func(r screen.Reply) {})
			let mut h = ui.NewTestHost(a, View, clock, 8) catch {
			case ui.BadPatch:
				return false
			}
			ui.Play(&h, []ui.Act{ui.SettleAll, ui.TypeInto{Label: "id", Text: "c1"}, ui.TypeInto{Label: "run", Text: name}, ui.TypeInto{Label: "number", Text: "1"}, ui.TapOn{Label: "submit"}, ui.SettleAll}) catch {
			case _:
				return false
			}
			let busy = shows(&h, "took c1 at 1") && shows(&h, "running: "+name) && !shows(&h, "passed: "+name)
			runner.Run.Release(func(id string, stage int, attempt int) bool fails pipeline.Offline { true })
			let _ = m.Settle() catch {
			case pipeline.Unavailable:
				return false
			}
			ui.Play(&h, []ui.Act{ui.TapOn{Label: "refresh"}, ui.SettleAll}) catch {
			case _:
				return false
			}
			let done = shows(&h, "passed: "+name) && !shows(&h, "running: "+name)
			stop(a)
			busy && done && testing.Unanswered() == ""
		}
	}
}

// shows is whether the screen of h shows the line.
func shows[D, F](h mut ui.TestHost[screen.Screen, screen.Signal, D, F], line string) bool { ui.Find(h, line) != None }

// stop stops the screen's actor.
func stop[S, E, D, F](a actor.Actor[S, E, D, F]) {
	a.Stop() catch {
	case _:
	}
}

// HeldAskShowsSendingThenReceipt: while the Api holds the screen's submit,
// the screen shows it sending; once a Release answers it, the screen
// shows the receipt, and the Api got the command the form holds. The id
// field is one line: it keeps id with its newlines dropped (ui.OneLine),
// and that is the id the screen sends and shows.
law HeldAskShowsSendingThenReceipt(id string, at int) {
	let kept = ui.OneLine(ui.Editing{Text: id, Caret: len(id), Anchor: len(id)}, 1).Text
	let api = testing.Script[pipeline.Pipeline]{}
	api.Board.Answer(func() board.View { board.Empty })
	api.Submit.Hold()
	let clock = time.NewManual(0)
	with context { Scheduler: clock } {
		let a = actor.StartMachine(screen.Life{}, 8, func(r screen.Reply) {})
		let mut h = with context { pipeline.Pipeline: api } { ui.NewTestHost(a, View, clock, 8) } catch {
		case ui.BadPatch:
			return false
		}
		ui.Play(&h, []ui.Act{ui.SettleAll, ui.TypeInto{Label: "id", Text: id}, ui.TypeInto{Label: "run", Text: "build"}, ui.TypeInto{Label: "number", Text: "2"}, ui.TapOn{Label: "submit"}}) catch {
		case _:
			return false
		}
		let sending = shows(&h, "sending submit \(kept)")
		api.Submit.Release(func(c pipeline.SubmitRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable {
			pipeline.Receipt{Command: c.ID, Position: at}
		})
		ui.Play(&h, []ui.Act{ui.SettleAll}) catch {
		case _:
			return false
		}
		let took = shows(&h, "took \(kept) at \(at)")
		let sent = api.Submit.Calls() == []pipeline.SubmitRun{pipeline.SubmitRun{ID: kept, Run: "build", Stages: 2}}
		let _ = api.Board.Calls()
		stop(a)
		sending && took && sent && testing.Unanswered() == ""
	}
}

// Board shows s: the form and its buttons, the notice (or the command in
// flight), the board, and the picked run. The board is a load keyed by the
// version, so an answer or a refresh fetches it again; the picked run is
// one keyed by its name and the version; a command in flight is a load
// whose fetch calls the Api, keyed by the version it was sent at.
func Board(f mut ui.Frame[screen.Signal], s screen.Screen) needs pipeline.Pipeline {
	let sh = screen.ShownOf(s)
	ui.Load(f, ui.ByInt(sh.Version), func() screen.Signal { screen.Loaded{Board: screen.LinesOf(pipeline.Pipeline.Board())} })
	match sh.Picked {
	case Some[string] as p:
		let id = p.Value
		ui.Load(f, ui.ByText("\(id)@\(sh.Version)"), func() screen.Signal {
			let r = pipeline.Pipeline.RunOf(id) catch {
			case pipeline.NoSuchRun as e:
				return screen.RunMissing{Err: e}
			}
			screen.RunLoaded{Run: r}
		})
	case None:
	}
	let status = match s {
	case screen.Asking as a:
		let req = a.Req
		ui.Load(f, ui.ByText("ask@\(sh.Version)"), func() screen.Signal { screen.Replied{Reply: Call(req)} })
		Sending(req)
	case screen.Showing:
		Describe(sh.Notice)
	}
	let form = sh.Form
	ui.Column(f, ui.Plain()) {
		ui.Row(f, ui.Plain()) {
			ui.Input(f, form.ID, "id", func(t string) screen.Signal { screen.Typed{Field: screen.IDField, Text: t} })
			ui.Input(f, form.Run, "run", func(t string) screen.Signal { screen.Typed{Field: screen.RunField, Text: t} })
			ui.Input(f, form.N, "number", func(t string) screen.Signal { screen.Typed{Field: screen.NField, Text: t} })
			ui.Input(f, form.Why, "why", func(t string) screen.Signal { screen.Typed{Field: screen.WhyField, Text: t} })
		}
		ui.Row(f, ui.Plain()) {
			button(f, "submit", SubmitOf(form))
			button(f, "cancel", CancelOf(form))
			button(f, "retry", RetryOf(form))
			button(f, "show", ShowOf(form))
			button(f, "refresh", pipelineapi.BoardRequest)
		}
		ui.Text(f, status)
		match sh.Board {
		case ui.Loading:
			ui.Text(f, "loading the board")
		case ui.Ready[screen.Lines] as b:
			for line in Columns(b.Value) {
				ui.Text(f, line)
			}
		case ui.Failed[pipeline.Unavailable]:
			ui.Text(f, "the pipeline does not run")
		}
		match sh.Picked {
		case Some[string] as p:
			ui.Text(f, RunLine(p.Value, sh.Run))
		case None:
		}
	}
}

// button is a button labelled label that asks r.
func button(f mut ui.Frame[screen.Signal], label string, r screen.Request) {
	ui.Pressable(f, label, screen.Ask{Req: r}) {
		ui.Text(f, label)
	}
}
