// Package notify is the pipeline's policy: an event of a run that ended
// gives a notice for the operator. React is pure, so a log replayed
// gives the same notices.

import pipeline/run

// Notice is what the operator is told.
type Notice = Passed{ID string} | GaveUp{ID string, Stage int} | Cancelled{ID string, Why string}

// React is the notices that the event e of the run id gives.
func React(id string, e run.Event) []Notice {
	match e {
	case run.Finished:
		[]Notice{Passed{ID: id}}
	case run.Abandoned as a:
		[]Notice{GaveUp{ID: id, Stage: a.Stage}}
	case run.Stopped as s:
		[]Notice{Cancelled{ID: id, Why: s.Why}}
	case run.Submitted, run.Started, run.StagePassed, run.StageFailed, run.Retried:
		[]Notice{}
	}
}

// OneNoticePerEnd: over the events of a run driven by any answers (and
// cancelled at the step cancelAt, if it has one), the policy gives one
// notice when the run ends and none before.
law OneNoticePerEnd(stages int, oks []bool, cancelAt int) {
	let mut s run.Run = run.Unsubmitted
	let mut notices = 0
	for i, ok in oks {
		let c = if i == cancelAt { run.Cancel{Why: "stop"} } else { run.Forward(s, ok, stages) }
		let es = run.Decide(s, c) catch {
		case run.WrongState, run.WrongStage, run.Closed, run.BadLength:
			[]run.Event{}
		}
		for e in es {
			let told = React("r", e).Len()
			s = run.Evolve(s, e)
			notices = notices + told
			if told > 0 && !run.IsDone(s) {
				return false
			}
		}
	}
	notices == (if run.IsDone(s) { 1 } else { 0 })
}

// Text is the notice as a line.
func Text(n Notice) string {
	match n {
	case Passed as p:
		"! \(p.ID) passed"
	case GaveUp as g:
		"! \(g.ID) gave up at stage \(g.Stage + 1)"
	case Cancelled as c:
		"! \(c.ID) was cancelled: \(c.Why)"
	}
}
