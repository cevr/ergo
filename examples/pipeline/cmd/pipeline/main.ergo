// pipeline runs a build pipeline in this process. It reads an operator's
// script on standard input, a command of the generated command line
// (pipeline/pipelinecli) on each line, as `pipeline --server` takes one:
// submit, cancel and retry runs, board, run-of; and wait, which lets an
// hour pass. It prints what the pipeline does. Its runner is a memory
// runner whose stages fail their first tries as -fail says; its clock is
// a manual clock that only `wait` moves, so a run prints the same lines on
// every host. Package pipeline is the Api and the context; this binary is
// the only place that chooses the providers: the runner, the event log
// (module domain's memory log), the cursor of the notices' follower and
// the clock.

import api
import flag
import io
import github.com/cevr/ergo/modules/domain
import github.com/cevr/ergo/modules/domain/memory
import os
import runners pipeline/memory
import pipeline/notify
import pipeline/pipeline
import pipeline/pipeline/pipelineapi
import pipeline/pipeline/pipelinecli
import pipeline/pipeline/pipelinerpc
import pipeline/run
import rpc
import strconv
import strings
import sync
import time

let failFlag = flag.String("fail", "", "STAGE:TRIES: stage STAGE (1 is the first) fails its first TRIES tries; a negative TRIES makes the runner offline for them").Repeated()

let set = flag.Set{
	Name:  "pipeline",
	Usage: "pipeline runs a build pipeline over a script of commands on standard input.",
	Flags: []flag.Flag{failFlag},
	Args:  []flag.ArgSpec{},
}

// failing is the runner's table from the -fail values: stage (0 is the
// first) to tries.
func failing(values []string) Map[int, int] fails os.Exit {
	let mut out = Map[int, int]{}
	for v in values {
		let parts = strings.Split(v, ":")
		let bad = os.Exit{Code: 2, Message: "pipeline: -fail takes STAGE:TRIES, not \(v)"}
		if len(parts) != 2 {
			return bad
		}
		let stage = strconv.Atoi(parts[0]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return bad
		}
		out[stage-1] = strconv.Atoi(parts[1]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return bad
		}
	}
	out
}

// eventText is an event as the script shows it.
func eventText(e run.Event) string {
	match e {
	case run.Submitted as s:
		"submitted (stages: \(s.Stages))"
	case run.Started:
		"started"
	case run.StagePassed as p:
		"stage \(p.Stage + 1) passed"
	case run.StageFailed as f:
		"stage \(f.Stage + 1) failed"
	case run.Retried as r:
		"stage \(r.Stage + 1) is tried again"
	case run.Finished:
		"finished"
	case run.Abandoned as a:
		"gave up at stage \(a.Stage + 1)"
	case run.Stopped as s:
		"cancelled: \(s.Why)"
	}
}

func column(name string, ids []string) string {
	if len(ids) == 0 {
		return "\(name): -"
	}
	"\(name): \(strings.Join(ids, " "))"
}

// code is the status of a typed failure in a script: a refused command
// is the pipeline's answer, and the script goes on; a pipeline that does
// not run ends it.
func code(f pipelineapi.Failure) int {
	match f {
	case pipelineapi.WrongState, pipelineapi.WrongStage, pipelineapi.Closed, pipelineapi.BadLength, pipelineapi.NoSuchRun:
		0
	case pipelineapi.Unavailable:
		1
	}
}

// text is a value as the script shows it: a receipt as the command it
// took, the board by column, a run by its status.
func text(r pipelineapi.Reply) Option[string] {
	let shown = match r {
	case pipelineapi.SubmitReply as s:
		receipt(s.Value)
	case pipelineapi.CancelReply as c:
		receipt(c.Value)
	case pipelineapi.RetryReply as t:
		receipt(t.Value)
	case pipelineapi.BoardReply as b:
		let v = b.Value
		strings.Join([]string{column("queued", v.Queued), column("running", v.Running), column("failing", v.Failing), column("passed", v.Passed), column("stopped", v.Stopped)}, "\n")
	case pipelineapi.RunOfReply as x:
		run.StatusOf(x.Value)
	}
	Some[string]{Value: shown}
}

func receipt(r pipeline.Receipt) string { "taken as \(r.Command) at log position \(r.Position)" }

// script is the policy of a script's commands: code and text.
func script() pipelinecli.Policy {
	let d = pipelinecli.Defaults()
	pipelinecli.Policy{..d, Code: code, Text: text}
}

// told is what the follower "notify" tells of the records of log after its
// cursor: each event, and each notice the policy gives for it.
func told(log domain.Log[pipeline.Entry], cursor domain.Cursor) []string {
	let lines = sync.NewRef([]string{})
	let _ = domain.Follow(log, cursor, "notify", pipeline.Stream, func(d domain.Delivery[pipeline.Entry]) fails domain.Unkept {
		for e in d.Record.Events {
			lines.Update(func(xs []string) []string { xs.Append("\(e.Run): \(eventText(e.Event))") })
			for note in notify.React(e.Run, e.Event) {
				lines.Update(func(xs []string) []string { xs.Append(notify.Text(note)) })
			}
		}
	}) catch {
	case domain.Unkept:
		0
	}
	lines.Get()
}

// Remote is a command line that names a server: `--server URL` then a
// command of the generated CLI (pipeline/pipelinecli), such as
// `submit -id=c1 -run=build -stages=3`, `board` or `run-of -- build`.
type Remote { URL string, Command []string }

// remoteOf is the remote command line of args, or None for a script.
// The URL comes first, as --server URL or --server=URL (one dash too).
func remoteOf(args []string) Option[Remote] {
	if len(args) == 0 {
		return None
	}
	for prefix in []string{"--server=", "-server="} {
		if strings.HasPrefix(args[0], prefix) {
			return Some[Remote]{Value: Remote{URL: strings.TrimPrefix(args[0], prefix), Command: args[1:]}}
		}
	}
	if len(args) >= 2 && (args[0] == "--server" || args[0] == "-server") {
		return Some[Remote]{Value: Remote{URL: args[1], Command: args[2:]}}
	}
	None
}

// call sends the command of r to the server through the generated
// client and prints what the generated CLI's Run gives. A server that
// does not answer is a line and status 1, not a defect: the board is
// asked first through the checked call.
func call(r Remote) fails os.Exit needs Ambient | Console {
	let client = pipelinerpc.NewClient(rpc.Dial(r.URL))
	let _ = pipelinerpc.BoardChecked(client) catch {
	case rpc.Transport as t:
		return os.Exit{Code: 1, Message: "pipeline: no pipeline answers at \(r.URL): \(t.Reason)"}
	}
	try api.Exit(with context { pipeline.Pipeline: client } { pipelinecli.Run(r.Command, pipelinecli.Defaults()) })
}

func main() fails os.Exit needs Ambient | Console {
	let args = with context { os.Process: os.NewHost() } { os.Process.Args() }
	match remoteOf(args) {
	case Some[Remote] as r:
		try call(r.Value)
		return
	case None:
	}
	let v = with context { io.Stdout: io.NewHost(), io.Stderr: io.NewErrors() } {
		flag.Parse(set, args) catch {
		case err:
			try flag.Exit(err, flag.UsageText(set))
			return
		}
	}
	let table = try failing(failFlag.Get(v))
	let mut lines = []string{}
	with context { io.Stdin: io.NewStdin() } {
		for line in io.Stdin.Lines() {
			lines = lines.Append(line)
		}
	}
	let (steps, tries) = session(lines, table) catch {
	case domain.Conflict, domain.Reused:
		return os.Exit{Code: 1, Message: "pipeline: the log refused a record"}
	case domain.Unkept as u:
		return os.Exit{Code: 1, Message: "pipeline: the log could not keep a record: \(u.Reason)"}
	}
	let mut last = api.Output{Out: "", Err: "", Code: 0}
	let mut at = 0
	for s in steps {
		Console.Println("> " + s.Text)
		for l in shown(s.Output.Out) {
			Console.Println("  " + l)
		}
		if s.Output.Code == 0 {
			for l in shown(s.Output.Err) {
				Console.Println("  refused: " + l)
			}
		}
		last = s.Output
		at = s.Line
	}
	Console.Println("the runner ran \(tries) tries")
	if last.Code != 0 {
		try api.ExitOf(api.Output{..last, Err: "pipeline: line \(at): " + strings.TrimSuffix(last.Err, "\n")})
	}
}

// shown is the lines of an output's text.
func shown(text string) []string {
	if text == "" {
		return []string{}
	}
	strings.Split(strings.TrimSuffix(text, "\n"), "\n")
}

// session binds the providers: a memory runner of the table, a manual
// clock, a memory log and the notices' memory cursor. It runs the script
// through the generated command line (api.Session) under the script's
// policy, where the one word that is not the Api's, wait, lets an hour
// pass; after each line, what the pipeline did until the runner runs no
// try: each new event of the log and each notice it gives, which the
// follower "notify" reads after its cursor. It ends with the steps and
// the number of tries the runner ran.
func session(lines []string, table Map[int, int]) ([]api.Step, int) fails domain.Conflict | domain.Reused | domain.Unkept {
	let runner = runners.New(table)
	let clock = time.NewManual(0)
	with context { Scheduler: clock, pipeline.Runner: runner } {
		let log = memory.New[pipeline.Entry]()
		let m = try pipeline.Open(log)
		let cursor = memory.NewCursor()
		let p = script()
		let steps = with context { pipeline.Pipeline: m } {
			api.Session(lines, func(args []string) api.Output needs pipeline.Pipeline | Scheduler {
				let o = if len(args) == 1 && args[0] == "wait" {
					clock.Advance(1h)
					api.Output{Out: "", Err: "", Code: 0}
				} else {
					pipelinecli.Run(args, p)
				}
				let _ = pipeline.Settle(m) catch {
				case pipeline.Unavailable:
					return api.Output{..o, Err: "the pipeline does not run\n", Code: 1}
				}
				let mut out = o.Out
				for l in told(log, cursor) {
					out = out + l + "\n"
				}
				api.Output{..o, Out: out}
			})
		}
		pipeline.Stop(m)
		(steps, runners.Ran(runner))
	}
}
