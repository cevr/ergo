// pipeline-mcp serves the pipeline's Api to a model as Model Context
// Protocol tools on standard input and output: a client (an agent's host)
// starts it as a process and sends JSON-RPC lines. Each tool is an
// operation of pipeline.Pipeline, generated by ergo gen mcp
// (pipeline/pipelinemcp). This binary is the only place that chooses the
// providers of the served context: a memory runner whose every stage
// passes, module domain's memory log, the live clock and module mcp's
// stdio transport.

import github.com/cevr/ergo/modules/domain
import github.com/cevr/ergo/modules/domain/memory
import github.com/cevr/ergo/modules/mcp
import github.com/cevr/ergo/modules/mcp/stdio
import os
import runners pipeline/memory
import pipeline/pipeline
import pipeline/pipeline/pipelinemcp

func main() fails os.Exit needs Ambient {
	with context { Scheduler: NewLiveScheduler(), pipeline.Runner: runners.New(Map[int, int]{}) } {
		let m = pipeline.Open(memory.New[pipeline.Entry]()) catch {
		case domain.Conflict, domain.Reused:
			return os.Exit{Code: 1, Message: "pipeline-mcp: the log refused a record"}
		case domain.Unkept as u:
			return os.Exit{Code: 1, Message: "pipeline-mcp: the log could not keep a record: \(u.Reason)"}
		}
		let server = mcp.Server{Name: "pipeline", Version: "0.1.0", Tools: pipelinemcp.Tools(m)}
		let _ = mcp.Serve(server, stdio.New())
		pipeline.Stop(m)
	}
}
