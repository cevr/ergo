// Package retry is the saga of one stage's tries: a failed try waits a
// backoff, then the stage is tried again; after Attempts failed tries it
// gives up. It is a machine with a timer on its waiting state, so its
// laws run under machines.RunTimed on a virtual clock. The pipeline's
// desk runs it as a pure child: its step calls Step on the attempt of
// the stage it runs, and its timer is Timer's.

import machines
import testing
import time

// Policy is how often a stage is tried and how long a failed try waits:
// Base after the first failure, doubled after each next one.
type Policy { Attempts int, Base duration }

// Standard is the pipeline's policy: three tries, waits of 1s then 2s.
let Standard = Policy{Attempts: 3, Base: 1s}

// Attempt is where the tries of a stage are: try Try runs, or it failed
// and the stage waits before try Try+1.
type Attempt = Trying{P Policy, Try int} | Backoff{P Policy, Try int}

// Signal is what reaches the saga: a try failed, or a wait ended (its
// timer).
type Signal = Failed{} | Due{}

// GivesUpAfterAttempts: a stage whose every try fails is tried Attempts
// times, each try ordered after its wait, and then given up, whenever in
// its try each failure comes (a failure at the very instant of its order
// comes before it, so each comes at least 1ms after).
law GivesUpAfterAttempts(gaps []int) {
	let mut trace = []machines.Timed[Signal]{}
	let mut at = 0s
	for n in 1..(Standard.Attempts + 1) {
		let gap = 1ms + (if n-1 < len(gaps) { ms(gaps[n-1]) } else { 0s })
		trace = trace.Append(machines.Timed[Signal]{At: at + gap, Signal: Failed})
		at = at + gap + Delay(Standard, n)
	}
	let t = timed(trace, at+1s)
	let mut want = []Order{}
	for n in 2..(Standard.Attempts + 1) {
		want = want.Append(Again{Try: n})
	}
	t.Orders == want && t.Last == Some[Order]{Value: GiveUp{Tries: Standard.Attempts}}
}

// Told is the end of a timed run of the saga: the orders it gave, the
// last order of a run that gave up (None for one that did not), and
// where it is.
type Told { Orders []Order, Last Option[Order], At Attempt }

// timed runs the saga over trace until end, on a fresh virtual clock.
func timed(trace []machines.Timed[Signal], end duration) Told {
	let c = testing.NewVirtualClock(0)
	with context { Scheduler: c, time.Clock: c } { run(trace, end) }
}

func run(trace []machines.Timed[Signal], end duration) Told needs time.Clock | Scheduler {
	let o = machines.RunTimed(Saga{}, trace, end) catch {
	case machines.Rejected:
		return Told{Orders: []Order{}, Last: None, At: First(Standard)}
	}
	match o {
	case machines.Running[Attempt, Order] as r:
		Told{Orders: r.Emitted, Last: None, At: r.State}
	case machines.Finished[Attempt, Order] as f:
		Told{Orders: f.Emitted, Last: Some[Order]{Value: f.Output}, At: f.State}
	}
}

func ms(n int) duration { duration(int64(((n%500)+500)%500) * int64(1ms)) }

// WaitsItsBackoff: after a failed try the next is ordered exactly when
// its wait ends: not a moment before.
law WaitsItsBackoff(early int) {
	let fail = []machines.Timed[Signal]{machines.Timed[Signal]{At: 0s, Signal: Failed}}
	let wait = Delay(Standard, 1)
	let before = timed(fail, wait-1ms-ms(early))
	let after = timed(fail, wait)
	len(before.Orders) == 0 && after.Orders == []Order{Again{Try: 2}}
}

// Order is what the saga tells the stage's owner: try again (Again, the
// number of the next try), or give up after Tries tries.
type Order = Again{Try int} | GiveUp{Tries int}

// First is the first try of a stage under p.
func First(p Policy) Attempt { Trying{P: p, Try: 1} }

// Delay is the wait after the failed try n (1 is the first).
func Delay(p Policy, n int) duration {
	let mut d = p.Base
	for _ in 1..n {
		d = duration(int64(d) * 2)
	}
	d
}

type FailedOutcome = Wait{Next Backoff} | Exhausted{Order GiveUp} | AlreadyWaiting{}

func OnFailed(a Attempt) FailedOutcome {
	match a {
	case Trying as t:
		if t.Try >= t.P.Attempts {
			return Exhausted{Order: GiveUp{Tries: t.Try}}
		}
		Wait{Next: Backoff{P: t.P, Try: t.Try}}
	case Backoff:
		AlreadyWaiting
	}
}

func OnDue(a Attempt) Option[Trying] {
	match a {
	case Backoff as b:
		Some[Trying]{Value: Trying{P: b.P, Try: b.Try + 1}}
	case Trying:
		None
	}
}

func Step(a Attempt, s Signal) Decision[Attempt, Order] {
	match s {
	case Failed:
		match OnFailed(a) {
		case Exhausted as e:
			Done[Order]{Output: e.Order}
		case Wait as w:
			Enter[Attempt]{Next: w.Next}
		case AlreadyWaiting:
			Ignore
		}
	case Due:
		match a {
		case Backoff as b:
			Emit[Attempt, Order]{Next: Trying{P: b.P, Try: b.Try + 1}, Output: Again{Try: b.Try + 1}}
		case Trying:
			Ignore
		}
	}
}

// Timer is the timer of a waiting attempt: Due after its delay.
func Timer(a Attempt) Option[Timeout[Signal]] {
	match a {
	case Backoff as b:
		Some[Timeout[Signal]]{Value: Timeout[Signal]{In: Delay(b.P, b.Try), Signal: Due}}
	case Trying:
		None
	}
}

// TryOf is the number of the try a is at.
func TryOf(a Attempt) int {
	match a {
	case Trying as t:
		t.Try
	case Backoff as b:
		b.Try
	}
}

// Saga is the tries of one stage under the Standard policy.
type Saga machine[Attempt, Signal] {
	initial: First(Standard),
	step:    Step,
	after:   Timer,
}
