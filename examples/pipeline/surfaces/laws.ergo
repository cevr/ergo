// The laws of the surfaces. Each surface runs on a context of its own: a
// durable actor of Dispatch over a memory event log (module domain), a runner whose first
// stage fails its first tries, and a manual clock that no one moves, so a
// failed stage waits for a retry. After each request the surface settles
// its context, so the runner's tries are part of what the next request
// sees.

import actor
import github.com/cevr/ergo/modules/domain
import github.com/cevr/ergo/modules/domain/memory
import runners pipeline/memory
import rpc
import pipeline/pipeline
import api
import pipeline/pipeline/pipelineapi
import pipeline/pipeline/pipelinecli
import pipeline/pipeline/pipelinemcp
import pipeline/pipeline/pipelinerpc
import pipeline/board
import pipeline/run
import pipeline/screen
import pipeline/view
import strings
import time
import ui

// Names are the runs the requests name.
let Names = []string{"build", "docs", "lint"}

// RequestOf is the request of the act k at place i: a submit (of -1 to 9
// stages, so some are refused), a cancel, a retry of stage 0 to 2, a
// resend of the first command, the board, or a run's state.
func RequestOf(i int, k int) Request {
	let name = Names[((k/8)%3+3)%3]
	let small = ((k/24)%3 + 3) % 3
	match ((k % 8) + 8) % 8 {
	case 0, 1:
		pipelineapi.SubmitRequest{C: pipeline.SubmitRun{ID: "c\(i)", Run: name, Stages: ((k/24)%11+11)%11 - 1}}
	case 2:
		pipelineapi.CancelRequest{C: pipeline.CancelRun{ID: "c\(i)", Run: name, Why: "stop"}}
	case 3, 4:
		pipelineapi.RetryRequest{C: pipeline.RetryRun{ID: "c\(i)", Run: name, Stage: small}}
	case 5:
		pipelineapi.SubmitRequest{C: pipeline.SubmitRun{ID: "c0", Run: name, Stages: 2}}
	case 6:
		pipelineapi.BoardRequest
	case _:
		pipelineapi.RunOfRequest{Id: name}
	}
}

// requests are the requests of the acts.
func requests(acts []int) []Request {
	let mut out = []Request{}
	for i, k in acts {
		out = out.Append(RequestOf(i, k))
	}
	out
}

// settled is out with a line when m has stopped.
func settled(out []string, m pipeline.Model) []string {
	let _ = pipeline.Settle(m) catch {
	case pipeline.Unavailable:
		return out.Append("the context stopped")
	}
	out
}

// onModel is the model's answers: each request on m, through its handle
// h.
func onModel(rs []Request, m pipeline.Model, h pipeline.Handle) []string {
	let mut out = []string{}
	with context { pipeline.Pipeline: h } {
		for r in rs {
			out = settled(out.Append(Text(pipelineapi.Call(r))), m)
		}
		out.Append(rpc.Encode(pipeline.Pipeline.Board()))
	}
}

// onScreen is the screen's answers: each request typed into the screen's
// form and asked by its button, on ui.TestHost over m, read once the
// screen settled. The reply of a command is the screen's notice, a board
// is what a refresh loads, a run what "show" loads.
func onScreen(rs []Request, m pipeline.Model, p pipeline.Handle, clock time.Manual) []string needs Scheduler {
	let a = actor.StartMachine(screen.Life{}, 8, func(r screen.Reply) {})
	let mut h = ui.NewTestHost(a, view.View(p), clock, 8) catch {
	case ui.BadPatch:
		return []string{"the screen did not start"}
	}
	let mut out = []string{}
	for r in rs {
		out = settled(out.Append(asked(&h, r)), m)
	}
	out = out.Append(asked(&h, pipelineapi.BoardRequest))
	a.Stop()
	out
}

// typing is the acts that fill the form's fields.
func typing(id string, name string, n string, why string) []ui.Act {
	[]ui.Act{ui.TypeInto{Label: "id", Text: id}, ui.TypeInto{Label: "run", Text: name}, ui.TypeInto{Label: "number", Text: n}, ui.TypeInto{Label: "why", Text: why}}
}

// asked is the screen's answer to r: the form filled, its button pressed,
// the screen settled, and what it then holds as text, in Text's form.
func asked[D, F](h mut ui.TestHost[screen.Screen, screen.Signal, D, F], r Request) string {
	let acts = match r {
	case pipelineapi.SubmitRequest as x:
		typing(x.C.ID, x.C.Run, "\(x.C.Stages)", "").Append(ui.TapOn{Label: "submit"})
	case pipelineapi.CancelRequest as x:
		typing(x.C.ID, x.C.Run, "", x.C.Why).Append(ui.TapOn{Label: "cancel"})
	case pipelineapi.RetryRequest as x:
		typing(x.C.ID, x.C.Run, "\(x.C.Stage)", "").Append(ui.TapOn{Label: "retry"})
	case pipelineapi.BoardRequest:
		[]ui.Act{ui.TapOn{Label: "refresh"}}
	case pipelineapi.RunOfRequest as x:
		typing("", x.Id, "", "").Append(ui.TapOn{Label: "show"})
	}
	ui.Play(h, acts.Append(ui.SettleAll)) catch {
	case _:
		return "the screen failed"
	}
	let sh = screen.ShownOf(ui.StateOf(h))
	match r {
	case pipelineapi.SubmitRequest, pipelineapi.CancelRequest, pipelineapi.RetryRequest:
		replyText(sh.Notice)
	case pipelineapi.BoardRequest:
		match sh.Board {
		case ui.Ready[screen.Lines] as b:
			rpc.Encode(viewOf(b.Value))
		case ui.Loading, ui.Failed[pipeline.Unavailable]:
			"no board"
		}
	case pipelineapi.RunOfRequest:
		match sh.Run {
		case ui.Ready[run.Run] as x:
			rpc.Encode(x.Value)
		case ui.Failed[pipeline.NoSuchRun] as e:
			rpc.Tagged("NoSuchRun", rpc.Encode(e.Error))
		case ui.Loading:
			"no run"
		}
	}
}

// replyText is the notice n as Text writes an outcome.
func replyText(n screen.Notice) string {
	match n {
	case screen.Quiet:
		"no reply"
	case screen.Said as s:
		match s.Reply {
		case screen.Took as t:
			rpc.Encode(t.Receipt)
		case screen.Refused as x:
			match x.Why {
			case screen.WrongState as e:
				rpc.Tagged("WrongState", rpc.Encode(e.Cause))
			case screen.WrongStage as e:
				rpc.Tagged("WrongStage", rpc.Encode(e.Cause))
			case screen.Closed as e:
				rpc.Tagged("Closed", rpc.Encode(e.Cause))
			case screen.BadLength as e:
				rpc.Tagged("BadLength", rpc.Encode(e.Cause))
			case screen.NoSuchRun as e:
				rpc.Tagged("NoSuchRun", rpc.Encode(e.Cause))
			case screen.Unavailable as e:
				rpc.Tagged("Unavailable", rpc.Encode(e.Cause))
			}
		}
	}
}

// viewOf is the board whose lines are l. The runs the requests name hold
// no ", ", so the lines split back into the columns.
func viewOf(l screen.Lines) board.View {
	board.View{Queued: column(l.Queued), Running: column(l.Running), Failing: column(l.Failing), Passed: column(l.Passed), Stopped: column(l.Stopped)}
}

func column(s string) []string {
	if s == "" {
		return []string{}
	}
	strings.Split(s, ", ")
}

// Surface is a road from a list of requests to the answers.
type Surface = ThroughModel{} | ThroughScreen{}

// answers plays rs on the surface s, on a context of its own whose first
// stage fails its first failing tries.
func answers(s Surface, rs []Request, failing int) []string fails domain.Conflict | domain.Reused | domain.Unkept {
	let mut table = Map[int, int]{}
	table[0] = ((failing % 3) + 3) % 3
	let clock = time.NewManual(0)
	with context { Scheduler: clock, pipeline.Runner: runners.New(table) } {
		let m, h = try pipeline.Share(memory.New[pipeline.Entry]())
		match s {
		case ThroughModel:
			onModel(rs, m, h)
		case ThroughScreen:
			onScreen(rs, m, h, clock)
		}
	}
}

// SurfacesAgree: one list of requests gets the same answers, rejections
// included, and leaves the same board, through the model and on the
// screen. The generated transports need no arm here: each one's law
// Agrees says it carries every call and every outcome unchanged.
law SurfacesAgree(acts []int, failing int) {
	let rs = requests(acts)
	let byModel = answers(ThroughModel, rs, failing) catch {
	case domain.Conflict, domain.Reused, domain.Unkept:
		return false
	}
	let byScreen = answers(ThroughScreen, rs, failing) catch {
	case domain.Conflict, domain.Reused, domain.Unkept:
		return false
	}
	byScreen == byModel
}

// Through is the Api over the transport t to h: each call carried by t's
// Wire to the hub's Call on h, and its outcome carried back. It binds h,
// a program implementation, so it stands in this file of laws (lint
// with-at-entry).
func Through(t Transport, h pipeline.Handle) pipelineapi.Client {
	pipelineapi.NewClient(func(r Request) pipelineapi.Outcome {
		match t {
		case Line:
			carried(pipelinecli.Wire, r, h)
		case Tools:
			carried(pipelinemcp.Wire, r, h)
		case Wire:
			carried(pipelinerpc.Wire, r, h)
		}
	})
}

// carried is r carried by w to the hub's Call on h.
func carried(w api.Transport[Request, pipelineapi.Outcome], r Request, h pipeline.Handle) pipelineapi.Outcome {
	w.Carry(r, func(c Request) pipelineapi.Outcome {
		with context { pipeline.Pipeline: h } { pipelineapi.Call(c) }
	})
}

// TransportsTakeEachCommandOnce: Pipeline.DuplicateIsNoop holds through
// each generated transport (the command line, the MCP tools, the Effect
// RPC wire): a command sent twice is taken once.
law TransportsTakeEachCommandOnce(c pipeline.SubmitRun, t Transport) {
	with context { Scheduler: time.NewManual(0), pipeline.Runner: runners.NewFlaky() } {
		let m, h = pipeline.Share(memory.New[pipeline.Entry]()) catch {
		case domain.Conflict, domain.Reused, domain.Unkept:
			return false
		}
		with context { pipeline.Pipeline: Through(t, h) } { pipeline.DuplicateIsNoop(c) }
	}
}
