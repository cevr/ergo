// The test file of package surfaces feeds the Api's laws at the two
// generated Clients (types.md, Laws 10), each over a Model. overModel
// builds the Model and owns it, so each law case closes it when the case
// ends (resources.md R24). overHub and overWire embed it and replace its
// Pipeline with a Client built over the Model they replace (rows.md
// Context 7): the laws then say that each Client carries what the Model
// answers, over the hub's Call and over Effect RPC's wire (rpc.Loopback).

import rpc
import github.com/cevr/ergo/modules/domain
import github.com/cevr/ergo/modules/domain/memory
import runners pipeline/memory
import pipeline/pipeline
import pipeline/pipeline/pipelineapi
import pipeline/pipeline/pipelinerpc
import time

// apiOver is the hub's Client whose calls the Pipeline in force answers,
// on the providers held where it was made.
func apiOver() pipelineapi.Client needs pipeline.Pipeline {
	let held = InForce[pipeline.Pipeline]()
	pipelineapi.NewClient(func(r Request) pipelineapi.Outcome {
		with held { pipelineapi.Call(r) }
	})
}

// rpcOver is Effect RPC's Client whose calls cross the wire to a server
// in this process whose Pipeline is the one in force where it was made.
func rpcOver() pipelinerpc.Client needs pipeline.Pipeline {
	let held = InForce[pipeline.Pipeline]()
	pipelinerpc.NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		with held { try pipelinerpc.Handle(tag, payload) }
	}))
}

let overModel = context fails domain.Conflict | domain.Reused | domain.Unkept {
	Scheduler:         time.NewManual(0),
	pipeline.Runner:   runners.New(Map[int, int]{}),
	pipeline.Pipeline: try pipeline.Open(memory.New[pipeline.Entry]()),
}

let overHub = context fails domain.Conflict | domain.Reused | domain.Unkept { overModel, replace pipeline.Pipeline: apiOver() }

let overWire = context fails domain.Conflict | domain.Reused | domain.Unkept { overModel, replace pipeline.Pipeline: rpcOver() }
