// Package surfaces holds what the surfaces of the Api share: the text of
// an outcome, which the screen's answers are compared in, and Through,
// the Api over one generated transport (pipelinecli, pipelinemcp,
// pipelinerpc) to a context served in this process. Each transport's own
// law Agrees says it carries every call and outcome unchanged; here
// SurfacesAgree plays one list of requests on the screen as on the
// model, and the Api's laws run through each transport.

import rpc
import pipeline/pipeline/pipelineapi

// Request is one call of the Api, on every surface: the hub's Request.
type Request = pipelineapi.Request

// Text is the outcome o as text: the value's JSON, or the rejection's
// type and JSON (the wire's forms).
func Text(o pipelineapi.Outcome) string {
	match o {
	case pipelineapi.Done as done:
		match done.Reply {
		case pipelineapi.SubmitReply as x:
			rpc.Encode(x.Value)
		case pipelineapi.CancelReply as x:
			rpc.Encode(x.Value)
		case pipelineapi.RetryReply as x:
			rpc.Encode(x.Value)
		case pipelineapi.BoardReply as x:
			rpc.Encode(x.Value)
		case pipelineapi.RunOfReply as x:
			rpc.Encode(x.Value)
		}
	case pipelineapi.Rejected as rejected:
		match rejected.Failure {
		case pipelineapi.WrongState as f:
			rpc.Tagged("WrongState", rpc.Encode(f.E))
		case pipelineapi.WrongStage as f:
			rpc.Tagged("WrongStage", rpc.Encode(f.E))
		case pipelineapi.Closed as f:
			rpc.Tagged("Closed", rpc.Encode(f.E))
		case pipelineapi.BadLength as f:
			rpc.Tagged("BadLength", rpc.Encode(f.E))
		case pipelineapi.NoSuchRun as f:
			rpc.Tagged("NoSuchRun", rpc.Encode(f.E))
		case pipelineapi.Unavailable as f:
			rpc.Tagged("Unavailable", rpc.Encode(f.E))
		}
	}
}

// Transport is a generated transport of the Api: the command line, the
// MCP tools, or the Effect RPC wire.
type Transport = Line{} | Tools{} | Wire{}
