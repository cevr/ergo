import api
import rpc
import pipeline/pipeline
import pipeline/pipeline/pipelineapi

// Handle runs one call of pipeline.Pipeline on the provider the caller binds,
// through the hub's Call: tag names the operation and payload is its
// Request's JSON. Its value is the result's JSON; a typed failure is
// Failed with the failure's tagged JSON. A request the contract does not
// hold and an int the wire cannot carry are defects, which the server
// answers as Die.
func Handle(tag string, payload string) string fails rpc.Failed needs pipeline.Pipeline {
	try handle(tag, payload, pipelineapi.Call)
}

func handle[R](tag string, payload string, answer func(r Request) pipelineapi.Outcome needs R) string fails rpc.Failed needs R {
	let req = rpc.Decode[Request]("request", rpc.Tagged(tag+"Request", payload)) catch {
	case rpc.Transport as t:
		return rpc.Die[string]("RpcError", t.Reason)
	}
	match req {
	case SubmitRequest as r:
		exactSubmitRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case RetryRequest as r:
		exactRetryRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case _:
	}
	match answer(req) {
	case pipelineapi.Done as done:
		match done.Reply {
		case pipelineapi.SubmitReply as reply:
			let v = reply.Value
			exactPipelineReceipt(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case pipelineapi.CancelReply as reply:
			let v = reply.Value
			exactPipelineReceipt(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case pipelineapi.RetryReply as reply:
			let v = reply.Value
			exactPipelineReceipt(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case pipelineapi.BoardReply as reply:
			let v = reply.Value
			rpc.Encode(v)
		case pipelineapi.RunOfReply as reply:
			let v = reply.Value
			exactRunRun(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		}
	case pipelineapi.Rejected as rejected:
		match rejected.Failure {
		case pipelineapi.WrongState as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("WrongState", rpc.Encode(e))}
		case pipelineapi.WrongStage as failure:
			let e = failure.E
			exactRunWrongStage(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("WrongStage", rpc.Encode(e))}
		case pipelineapi.Closed as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("Closed", rpc.Encode(e))}
		case pipelineapi.BadLength as failure:
			let e = failure.E
			exactRunBadLength(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("BadLength", rpc.Encode(e))}
		case pipelineapi.NoSuchRun as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("NoSuchRun", rpc.Encode(e))}
		case pipelineapi.Unavailable as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("Unavailable", rpc.Encode(e))}
		}
	}
}

func carry(c Request, answer own func(c Request) pipelineapi.Outcome) pipelineapi.Outcome {
	let client = NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		try handle(tag, payload, answer)
	}))
	with context { pipeline.Pipeline: client } { pipelineapi.Call(c) }
}

// Wire is Effect RPC as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, pipelineapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) pipelineapi.Outcome) pipelineapi.Outcome { carry(c, answer) }

// Fits reports whether r and o hold only ints the wire carries exactly
// (an int beyond 2^53-1 is Unrepresentable, a defect on either side).
func Fits(r Request, o pipelineapi.Outcome) bool {
	match r {
	case pipelineapi.SubmitRequest as x:
		exactSubmitRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case pipelineapi.RetryRequest as x:
		exactRetryRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case _:
	}
	match o {
	case pipelineapi.Done as done:
		match done.Reply {
		case pipelineapi.SubmitReply as reply:
			exactPipelineReceipt(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case pipelineapi.CancelReply as reply:
			exactPipelineReceipt(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case pipelineapi.RetryReply as reply:
			exactPipelineReceipt(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case pipelineapi.BoardReply:
		case pipelineapi.RunOfReply as reply:
			exactRunRun(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		}
	case pipelineapi.Rejected as rejected:
		match rejected.Failure {
		case pipelineapi.WrongState:
		case pipelineapi.WrongStage as failure:
			exactRunWrongStage(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		case pipelineapi.Closed:
		case pipelineapi.BadLength as failure:
			exactRunBadLength(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		case pipelineapi.NoSuchRun:
		case pipelineapi.Unavailable:
		}
	}
	true
}

// Agrees: the wire carries every call and every outcome the call can
// have unchanged, when they hold only ints it carries exactly (Fits).
law Agrees(r Request, g pipelineapi.Given) {
	let o = pipelineapi.OutcomeOf(r, g)
	!Fits(r, o) || api.Agrees(Wire, r, o)
}
