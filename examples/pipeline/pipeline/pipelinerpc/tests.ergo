// Exercise the generated RPC Client over an in-process wire and a fresh
// Model. The context owns the Model until the last call made by the law.
import github.com/cevr/ergo/modules/domain
import github.com/cevr/ergo/modules/domain/memory
import runners pipeline/memory
import pipeline/pipeline
import rpc
import time

func rpcOver() Client needs pipeline.Pipeline {
	let held = InForce[pipeline.Pipeline]()
	NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		with held { try Handle(tag, payload) }
	}))
}

let overModel = context fails domain.Conflict | domain.Reused | domain.Unkept {
	Scheduler:         time.NewManual(0),
	pipeline.Runner:   runners.New(Map[int, int]{}),
	pipeline.Pipeline: try pipeline.Open(memory.New[pipeline.Entry]()),
}

let overWire = context fails domain.Conflict | domain.Reused | domain.Unkept { overModel, replace pipeline.Pipeline: rpcOver() }
