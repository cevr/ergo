import api
import json
import mcp
import rpc
import scope
import pipeline/board
import pipeline/pipeline
import pipeline/pipeline/pipelineapi
import pipeline/run

// Request is one call of pipeline.Pipeline: the hub's Request.
type Request = pipelineapi.Request

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

func textOf(v json.Value) string { json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, v) }

func untagged(v json.Value) json.Value {
	match v {
	case json.Object as o:
		let mut members = []json.Member{}
		for m in o.Members {
			if m.Key != "_tag" {
				members = members.Append(m)
			}
		}
		json.Object{Members: members}
	case json.Null, json.Boolean, json.Num, json.Str, json.Array:
		v
	}
}

// Names are the tools' names, one per operation of pipeline.Pipeline, in its order.
let Names = []string{"submit", "cancel", "retry", "board", "run-of"}

// Description is what the tool name does: its operation's doc comment,
// or its signature (the hub's Doc).
func Description(name string) string {
	match name {
	case "submit":
		pipelineapi.Doc(pipelineapi.SubmitOp)
	case "cancel":
		pipelineapi.Doc(pipelineapi.CancelOp)
	case "retry":
		pipelineapi.Doc(pipelineapi.RetryOp)
	case "board":
		pipelineapi.Doc(pipelineapi.BoardOp)
	case "run-of":
		pipelineapi.Doc(pipelineapi.RunOfOp)
	case _:
		""
	}
}

// Input is the JSON schema of the tool name's arguments (the hub's
// Schema; an object schema with no properties for a name that is no
// tool's).
func Input(name string) json.Value {
	match name {
	case "submit":
		pipelineapi.Schema(pipelineapi.SubmitOp)
	case "cancel":
		pipelineapi.Schema(pipelineapi.CancelOp)
	case "retry":
		pipelineapi.Schema(pipelineapi.RetryOp)
	case "board":
		pipelineapi.Schema(pipelineapi.BoardOp)
	case "run-of":
		pipelineapi.Schema(pipelineapi.RunOfOp)
	case _:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	}
}

// Call is the Request that a call of the tool name with arguments asks
// for: arguments that are not the tool's fail ToolError, a name that is
// no tool's UnknownTool.
func Call(name string, arguments json.Value) Request fails mcp.ToolError | mcp.UnknownTool {
	let text = match name {
	case "submit":
		rpc.Tagged("SubmitRequest", "{\"c\":"+textOf(arguments)+"}")
	case "cancel":
		rpc.Tagged("CancelRequest", "{\"c\":"+textOf(arguments)+"}")
	case "retry":
		rpc.Tagged("RetryRequest", "{\"c\":"+textOf(arguments)+"}")
	case "board":
		rpc.Tagged("BoardRequest", textOf(arguments))
	case "run-of":
		rpc.Tagged("RunOfRequest", textOf(arguments))
	case _:
		return mcp.UnknownTool{Name: name}
	}
	rpc.Decode[Request]("arguments of "+name, text) catch {
	case rpc.Transport as e:
		return mcp.ToolError{Message: e.Reason}
	}
}

// Arguments is the tool and the arguments that ask for r: Call reads
// them as r again.
func Arguments(r Request) (string, json.Value) {
	match r {
	case pipelineapi.SubmitRequest as x:
		("submit", untagged(valueOf(rpc.Encode(x.C))))
	case pipelineapi.CancelRequest as x:
		("cancel", untagged(valueOf(rpc.Encode(x.C))))
	case pipelineapi.RetryRequest as x:
		("retry", untagged(valueOf(rpc.Encode(x.C))))
	case pipelineapi.BoardRequest:
		("board", json.Object{Members: []json.Member{}})
	case pipelineapi.RunOfRequest as x:
		("run-of", untagged(valueOf(rpc.Encode(x))))
	}
}

// Show is the outcome o as a tool's answer: its value as JSON (null for
// none), or its typed failure as a ToolError whose message is the
// failure's tagged JSON.
func Show(o pipelineapi.Outcome) json.Value fails mcp.ToolError {
	match o {
	case pipelineapi.Done as done:
		match done.Reply {
		case pipelineapi.SubmitReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case pipelineapi.CancelReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case pipelineapi.RetryReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case pipelineapi.BoardReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case pipelineapi.RunOfReply as reply:
			valueOf(rpc.Encode(reply.Value))
		}
	case pipelineapi.Rejected as rejected:
		match rejected.Failure {
		case pipelineapi.WrongState as failure:
			return mcp.ToolError{Message: rpc.Tagged("WrongState", rpc.Encode(failure.E))}
		case pipelineapi.WrongStage as failure:
			return mcp.ToolError{Message: rpc.Tagged("WrongStage", rpc.Encode(failure.E))}
		case pipelineapi.Closed as failure:
			return mcp.ToolError{Message: rpc.Tagged("Closed", rpc.Encode(failure.E))}
		case pipelineapi.BadLength as failure:
			return mcp.ToolError{Message: rpc.Tagged("BadLength", rpc.Encode(failure.E))}
		case pipelineapi.NoSuchRun as failure:
			return mcp.ToolError{Message: rpc.Tagged("NoSuchRun", rpc.Encode(failure.E))}
		case pipelineapi.Unavailable as failure:
			return mcp.ToolError{Message: rpc.Tagged("Unavailable", rpc.Encode(failure.E))}
		}
	}
}

// Answer answers r through the hub's Call on the bound pipeline.Pipeline (Show).
func Answer(r Request) json.Value fails mcp.ToolError needs pipeline.Pipeline {
	try Show(pipelineapi.Call(r))
}

// ReadAnswer is the outcome of r that a tool's result says: its value's
// JSON, or, when it is an error, an admitted failure's tagged JSON.
// Invalid or missing replies fail Transport, outside the operation's own row.
func ReadAnswer(r Request, result mcp.Called) pipelineapi.Outcome fails rpc.Transport {
	if result.Content.Len() != 1 {
		return rpc.Transport{Reason: "a tool answered \(result.Content.Len()) blocks, not one"}
	}
	let text = result.Content[0].Text
	if !result.IsError {
		match r {
		case pipelineapi.SubmitRequest:
			let v = try rpc.Decode[pipeline.Receipt]("value", text)
			pipelineapi.Done{Reply: pipelineapi.SubmitReply{Value: v}}
		case pipelineapi.CancelRequest:
			let v = try rpc.Decode[pipeline.Receipt]("value", text)
			pipelineapi.Done{Reply: pipelineapi.CancelReply{Value: v}}
		case pipelineapi.RetryRequest:
			let v = try rpc.Decode[pipeline.Receipt]("value", text)
			pipelineapi.Done{Reply: pipelineapi.RetryReply{Value: v}}
		case pipelineapi.BoardRequest:
			let v = try rpc.Decode[board.View]("value", text)
			pipelineapi.Done{Reply: pipelineapi.BoardReply{Value: v}}
		case pipelineapi.RunOfRequest:
			let v = try rpc.Decode[run.Run]("value", text)
			pipelineapi.Done{Reply: pipelineapi.RunOfReply{Value: v}}
		}
	} else {
		match r {
		case pipelineapi.SubmitRequest:
			match rpc.TagOf(text) {
			case "WrongState":
				let e = try rpc.Decode[run.WrongState]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongState{E: e}}
			case "WrongStage":
				let e = try rpc.Decode[run.WrongStage]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongStage{E: e}}
			case "Closed":
				let e = try rpc.Decode[run.Closed]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Closed{E: e}}
			case "BadLength":
				let e = try rpc.Decode[run.BadLength]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.BadLength{E: e}}
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case "Unavailable":
				let e = try rpc.Decode[pipeline.Unavailable]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Unavailable{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool submit answered an undeclared failure: " + text}
			}
		case pipelineapi.CancelRequest:
			match rpc.TagOf(text) {
			case "WrongState":
				let e = try rpc.Decode[run.WrongState]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongState{E: e}}
			case "WrongStage":
				let e = try rpc.Decode[run.WrongStage]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongStage{E: e}}
			case "Closed":
				let e = try rpc.Decode[run.Closed]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Closed{E: e}}
			case "BadLength":
				let e = try rpc.Decode[run.BadLength]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.BadLength{E: e}}
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case "Unavailable":
				let e = try rpc.Decode[pipeline.Unavailable]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Unavailable{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool cancel answered an undeclared failure: " + text}
			}
		case pipelineapi.RetryRequest:
			match rpc.TagOf(text) {
			case "WrongState":
				let e = try rpc.Decode[run.WrongState]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongState{E: e}}
			case "WrongStage":
				let e = try rpc.Decode[run.WrongStage]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongStage{E: e}}
			case "Closed":
				let e = try rpc.Decode[run.Closed]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Closed{E: e}}
			case "BadLength":
				let e = try rpc.Decode[run.BadLength]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.BadLength{E: e}}
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case "Unavailable":
				let e = try rpc.Decode[pipeline.Unavailable]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Unavailable{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool retry answered an undeclared failure: " + text}
			}
		case pipelineapi.BoardRequest:
			return rpc.Transport{Reason: "the tool board answered an undeclared failure: " + text}
		case pipelineapi.RunOfRequest:
			match rpc.TagOf(text) {
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool run-of answered an undeclared failure: " + text}
			}
		}
	}
}

func toolOver(name string, answer own func(r Request) pipelineapi.Outcome) mcp.Tool {
	mcp.Tool{Name: name, Description: Description(name), Input: Input(name), Call: func(arguments json.Value) json.Value fails mcp.ToolError {
		let r = Call(name, arguments) catch {
		case mcp.ToolError as e:
			return e
		case mcp.UnknownTool as e:
			return mcp.ToolError{Message: "no tool is named " + e.Name}
		}
		try Show(answer(r))
	}}
}

func toolsOver(answer own func(r Request) pipelineapi.Outcome) []mcp.Tool {
	let mut out = []mcp.Tool{}
	for name in Names {
		out = out.Append(toolOver(name, answer))
	}
	out
}

// Tools are the tools of the pipeline.Pipeline in force, one per operation, in its order.
func Tools() []mcp.Tool needs pipeline.Pipeline {
	let held = scope.InForce[pipeline.Pipeline]()
	toolsOver(func(r Request) pipelineapi.Outcome {
		with held { pipelineapi.Call(r) }
	})
}

func carry(c Request, answer own func(c Request) pipelineapi.Outcome) pipelineapi.Outcome fails rpc.Transport {
	let server = mcp.Server{Name: "carry", Version: "1", Tools: toolsOver(answer)}
	let (name, arguments) = Arguments(c)
	let message = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":" + rpc.Encode(name) + ",\"arguments\":" + textOf(arguments) + "}}"
	match mcp.Handle(server, message) {
	case mcp.Answered as a:
		let result = json.Decode(json.Codec[mcp.Called]{MaxBytes: 0, MaxDepth: 0}, a.Result) catch {
		case _:
			return rpc.Transport{Reason: "a tool's result is not one: " + a.Result}
		}
		try ReadAnswer(c, result)
	case mcp.Refused as e:
		return rpc.Transport{Reason: "the server refused the call: " + e.Message}
	case mcp.Silent:
		return rpc.Transport{Reason: "the server did not answer the call"}
	}
}

// Wire is the protocol as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, pipelineapi.Outcome, rpc.Transport]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) pipelineapi.Outcome) pipelineapi.Outcome fails rpc.Transport { try carry(c, answer) }

// Agrees: the protocol carries every call and every outcome the call
// can have unchanged.
law Agrees(r Request, g pipelineapi.Given) { api.Agrees[Request, pipelineapi.Outcome, rpc.Transport](Wire, r, pipelineapi.OutcomeOf(r, g)) }

// RoundTrips reports whether Call reads what Arguments writes of r as r.
func RoundTrips(r Request) bool {
	let (name, arguments) = Arguments(r)
	let back = Call(name, arguments) catch {
	case mcp.ToolError, mcp.UnknownTool:
		return false
	}
	back == r
}

// FitsSchema reports whether the arguments that ask for r fit the
// schema their tool lists.
func FitsSchema(r Request) bool {
	let (name, arguments) = Arguments(r)
	mcp.Conforms(Input(name), arguments)
}

// ArgumentsRoundTrip: Call reads what Arguments writes as the same Request.
law ArgumentsRoundTrip(r Request) { RoundTrips(r) }

// ArgumentsFitTheSchema: the arguments of every Request fit the schema
// of their tool.
law ArgumentsFitTheSchema(r Request) { FitsSchema(r) }
