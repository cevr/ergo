import api
import flag
import io
import option
import prompt
import rpc
import slices
import strings
import term
import pipeline/board
import pipeline/pipeline
import pipeline/pipeline/pipelineapi
import pipeline/run

// Request is one call of pipeline.Pipeline: the hub's Request.
type Request = pipelineapi.Request

// Output is what Run prints: std api's Output (Out to standard output,
// Err to standard error, and the exit status).
type Output = api.Output

// Commands are the commands of pipeline.Pipeline, one per operation, in its order.
func Commands() []flag.Command[Request] {
	[]flag.Command[Request]{commandSubmit(), commandCancel(), commandRetry(), commandBoard(), commandRunOf()}
}

func commandSubmit() flag.Command[Request] {
	let f0 = flag.RequiredString("id", "c.ID (string)")
	let f1 = flag.RequiredString("run", "c.Run (string)")
	let f2 = flag.RequiredInt("stages", "c.Stages (int)")
	let usage = pipelineapi.Doc(pipelineapi.SubmitOp)
	flag.Command[Request]{Name: "submit", Usage: usage, Set: flag.Set{Name: "submit", Usage: usage, Flags: []flag.Flag{f0, f1, f2}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		pipelineapi.SubmitRequest{C: pipeline.SubmitRun{ID: f0.Get(v), Run: f1.Get(v), Stages: f2.Get(v)}}
	}, Commands: []flag.Command[Request]{}}
}

func commandCancel() flag.Command[Request] {
	let f0 = flag.RequiredString("id", "c.ID (string)")
	let f1 = flag.RequiredString("run", "c.Run (string)")
	let f2 = flag.RequiredString("why", "c.Why (string)")
	let usage = pipelineapi.Doc(pipelineapi.CancelOp)
	flag.Command[Request]{Name: "cancel", Usage: usage, Set: flag.Set{Name: "cancel", Usage: usage, Flags: []flag.Flag{f0, f1, f2}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		pipelineapi.CancelRequest{C: pipeline.CancelRun{ID: f0.Get(v), Run: f1.Get(v), Why: f2.Get(v)}}
	}, Commands: []flag.Command[Request]{}}
}

func commandRetry() flag.Command[Request] {
	let f0 = flag.RequiredString("id", "c.ID (string)")
	let f1 = flag.RequiredString("run", "c.Run (string)")
	let f2 = flag.RequiredInt("stage", "c.Stage (int)")
	let usage = pipelineapi.Doc(pipelineapi.RetryOp)
	flag.Command[Request]{Name: "retry", Usage: usage, Set: flag.Set{Name: "retry", Usage: usage, Flags: []flag.Flag{f0, f1, f2}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		pipelineapi.RetryRequest{C: pipeline.RetryRun{ID: f0.Get(v), Run: f1.Get(v), Stage: f2.Get(v)}}
	}, Commands: []flag.Command[Request]{}}
}

func commandBoard() flag.Command[Request] {
	let usage = pipelineapi.Doc(pipelineapi.BoardOp)
	flag.Command[Request]{Name: "board", Usage: usage, Set: flag.Set{Name: "board", Usage: usage, Flags: []flag.Flag{}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		pipelineapi.BoardRequest
	}, Commands: []flag.Command[Request]{}}
}

func commandRunOf() flag.Command[Request] {
	let a0 = flag.Arg("id", "id (string)")
	let usage = pipelineapi.Doc(pipelineapi.RunOfOp)
	flag.Command[Request]{Name: "run-of", Usage: usage, Set: flag.Set{Name: "run-of", Usage: usage, Flags: []flag.Flag{}, Args: []flag.ArgSpec{a0}}, Build: func(v flag.Values) Request fails flag.Failure {
		let t1 = argText(a0, v)
		pipelineapi.RunOfRequest{Id: t1}
	}, Commands: []flag.Command[Request]{}}
}

func argText(a flag.ArgSpec, v flag.Values) string {
	match a.Get(v) {
	case option.Some[string] as s:
		s.Value
	case option.None:
		""
	}
}

// Parse reads args as a command line of pipeline.Pipeline: a command and its
// flags and arguments. It builds only the command args[0] names; the
// list of every command is built only for help or an unknown command.
func Parse(args []string) Request fails flag.Failure {
	let first = if args.Len() > 0 { args[0] } else { "" }
	match first {
	case "submit":
		let c = commandSubmit()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "pipeline submit"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "cancel":
		let c = commandCancel()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "pipeline cancel"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "retry":
		let c = commandRetry()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "pipeline retry"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "board":
		let c = commandBoard()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "pipeline board"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "run-of":
		let c = commandRunOf()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "pipeline run-of"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case _:
		try flag.ParseCommand("pipeline", "pipeline.Pipeline on a command line", Commands(), args)
	}
}

// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case pipelineapi.SubmitRequest as x:
		let mut out = []string{"submit"}
		out = out.Append("-id=\(x.C.ID)")
		out = out.Append("-run=\(x.C.Run)")
		out = out.Append("-stages=\(x.C.Stages)")
		out
	case pipelineapi.CancelRequest as x:
		let mut out = []string{"cancel"}
		out = out.Append("-id=\(x.C.ID)")
		out = out.Append("-run=\(x.C.Run)")
		out = out.Append("-why=\(x.C.Why)")
		out
	case pipelineapi.RetryRequest as x:
		let mut out = []string{"retry"}
		out = out.Append("-id=\(x.C.ID)")
		out = out.Append("-run=\(x.C.Run)")
		out = out.Append("-stage=\(x.C.Stage)")
		out
	case pipelineapi.BoardRequest:
		[]string{"board"}
	case pipelineapi.RunOfRequest as x:
		let mut out = []string{"run-of"}
		out = out.Append("--")
		out = out.Append("\(x.Id)")
		out
	}
}

// RoundTrips reports whether Parse reads what Print writes of r as r.
func RoundTrips(r Request) bool {
	let back = Parse(Print(r)) catch {
	case flag.Failure:
		return false
	}
	back == r
}

// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// Policy is what a binary decides of its command line: Code, the exit
// status of a typed failure (default 1); Text, the text of a value
// without --json (default None: a basic value as its text, else its
// JSON; --json never calls it); Confirm, the question a call asks before
// it runs (default None: none; --yes answers it).
type Policy { Code func(f pipelineapi.Failure) int, Text func(r pipelineapi.Reply) option.Option[string], Confirm func(r Request) option.Option[string] }

// Defaults is the Policy of a binary that decides nothing.
func Defaults() Policy {
	Policy{Code: func(f pipelineapi.Failure) int { 1 }, Text: func(r pipelineapi.Reply) option.Option[string] { option.None }, Confirm: func(r Request) option.Option[string] { option.None }}
}

func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else {
		Output{Out: line(plain), Err: "", Code: 0}
	}
}

func line(s string) string {
	if s == "" {
		return ""
	}
	s + "\n"
}

func failed(asJSON bool, tagged string, status int) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: status}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: status}
	}
}

// Show is what Run prints of the outcome o under the policy p: the value
// (p's Text when it has one and there is no --json; else its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed) with p's Code.
func Show(o pipelineapi.Outcome, asJSON bool, p Policy) Output {
	match o {
	case pipelineapi.Done as done:
		if !asJSON {
			match p.Text(done.Reply) {
			case option.Some[string] as s:
				return Output{Out: line(s.Value), Err: "", Code: 0}
			case option.None:
			}
		}
		match done.Reply {
		case pipelineapi.SubmitReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case pipelineapi.CancelReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case pipelineapi.RetryReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case pipelineapi.BoardReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case pipelineapi.RunOfReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		}
	case pipelineapi.Rejected as rejected:
		let status = p.Code(rejected.Failure)
		match rejected.Failure {
		case pipelineapi.WrongState as failure:
			failed(asJSON, rpc.Tagged("WrongState", rpc.Encode(failure.E)), status)
		case pipelineapi.WrongStage as failure:
			failed(asJSON, rpc.Tagged("WrongStage", rpc.Encode(failure.E)), status)
		case pipelineapi.Closed as failure:
			failed(asJSON, rpc.Tagged("Closed", rpc.Encode(failure.E)), status)
		case pipelineapi.BadLength as failure:
			failed(asJSON, rpc.Tagged("BadLength", rpc.Encode(failure.E)), status)
		case pipelineapi.NoSuchRun as failure:
			failed(asJSON, rpc.Tagged("NoSuchRun", rpc.Encode(failure.E)), status)
		case pipelineapi.Unavailable as failure:
			failed(asJSON, rpc.Tagged("Unavailable", rpc.Encode(failure.E)), status)
		}
	}
}

// Read is the outcome of r that the Output of Run with --json and its
// default status policy says: its value's JSON on standard output with
// status 0, or an admitted failure's tagged JSON with status 1. Invalid
// or missing replies fail Transport, outside the operation's own row.
func Read(r Request, out Output) pipelineapi.Outcome fails rpc.Transport {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case pipelineapi.SubmitRequest:
			let v = try rpc.Decode[pipeline.Receipt]("value", text)
			pipelineapi.Done{Reply: pipelineapi.SubmitReply{Value: v}}
		case pipelineapi.CancelRequest:
			let v = try rpc.Decode[pipeline.Receipt]("value", text)
			pipelineapi.Done{Reply: pipelineapi.CancelReply{Value: v}}
		case pipelineapi.RetryRequest:
			let v = try rpc.Decode[pipeline.Receipt]("value", text)
			pipelineapi.Done{Reply: pipelineapi.RetryReply{Value: v}}
		case pipelineapi.BoardRequest:
			let v = try rpc.Decode[board.View]("value", text)
			pipelineapi.Done{Reply: pipelineapi.BoardReply{Value: v}}
		case pipelineapi.RunOfRequest:
			let v = try rpc.Decode[run.Run]("value", text)
			pipelineapi.Done{Reply: pipelineapi.RunOfReply{Value: v}}
		}
	} else if out.Code == 1 {
		match r {
		case pipelineapi.SubmitRequest:
			match rpc.TagOf(text) {
			case "WrongState":
				let e = try rpc.Decode[run.WrongState]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongState{E: e}}
			case "WrongStage":
				let e = try rpc.Decode[run.WrongStage]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongStage{E: e}}
			case "Closed":
				let e = try rpc.Decode[run.Closed]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Closed{E: e}}
			case "BadLength":
				let e = try rpc.Decode[run.BadLength]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.BadLength{E: e}}
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case "Unavailable":
				let e = try rpc.Decode[pipeline.Unavailable]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Unavailable{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered Submit with an undeclared failure: " + text}
			}
		case pipelineapi.CancelRequest:
			match rpc.TagOf(text) {
			case "WrongState":
				let e = try rpc.Decode[run.WrongState]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongState{E: e}}
			case "WrongStage":
				let e = try rpc.Decode[run.WrongStage]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongStage{E: e}}
			case "Closed":
				let e = try rpc.Decode[run.Closed]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Closed{E: e}}
			case "BadLength":
				let e = try rpc.Decode[run.BadLength]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.BadLength{E: e}}
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case "Unavailable":
				let e = try rpc.Decode[pipeline.Unavailable]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Unavailable{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered Cancel with an undeclared failure: " + text}
			}
		case pipelineapi.RetryRequest:
			match rpc.TagOf(text) {
			case "WrongState":
				let e = try rpc.Decode[run.WrongState]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongState{E: e}}
			case "WrongStage":
				let e = try rpc.Decode[run.WrongStage]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.WrongStage{E: e}}
			case "Closed":
				let e = try rpc.Decode[run.Closed]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Closed{E: e}}
			case "BadLength":
				let e = try rpc.Decode[run.BadLength]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.BadLength{E: e}}
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case "Unavailable":
				let e = try rpc.Decode[pipeline.Unavailable]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.Unavailable{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered Retry with an undeclared failure: " + text}
			}
		case pipelineapi.BoardRequest:
			return rpc.Transport{Reason: "the command line answered Board with an undeclared failure: " + text}
		case pipelineapi.RunOfRequest:
			match rpc.TagOf(text) {
			case "NoSuchRun":
				let e = try rpc.Decode[pipeline.NoSuchRun]("failure", text)
				pipelineapi.Rejected{Failure: pipelineapi.NoSuchRun{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered RunOf with an undeclared failure: " + text}
			}
		}
	} else {
		return rpc.Transport{Reason: "the command line answered status \(out.Code): " + out.Err}
	}
}

type front = asked{R Request, JSON bool, Yes bool} | ended{O Output}

func frontOf(args []string) front {
	let mut asJSON = false
	let mut yes = false
	let mut globals = true
	let mut rest = []string{}
	for a in args {
		if globals && (a == "--json" || a == "-json") {
			asJSON = true
		} else if globals && (a == "--yes" || a == "-yes") {
			yes = true
		} else {
			globals = false
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return ended{O: Output{Out: h.Text, Err: "", Code: 0}}
	case err:
		return ended{O: Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}}
	}
	asked{R: r, JSON: asJSON, Yes: yes}
}

func needsYes(question string) Output {
	Output{Out: "", Err: question + " (no terminal to ask on: pass --yes to answer yes)\n", Code: 2}
}

func declined(question string) Output {
	Output{Out: "", Err: question + ": not confirmed\n", Code: 1}
}

func runOver[R](args []string, p Policy, answer func(r Request) pipelineapi.Outcome needs R) Output needs R {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case option.Some[string] as q:
				return needsYes(q.Value)
			case option.None:
			}
		}
		Show(answer(a.R), a.JSON, p)
	}
}

// Run reads args as [--json] [--yes] COMMAND ARGS..., answers the call
// through the hub's Call on the pipeline.Pipeline the caller binds, and is what to
// print under the policy p: the value, a typed failure with p's Code, the
// help (status 0) or a usage error (status 2). It asks nothing: a call p
// asks a question of needs --yes (status 2 without it).
func Run(args []string, p Policy) Output needs pipeline.Pipeline {
	runOver(args, p, pipelineapi.Call)
}

// RunOnTerminal is Run that asks p's question on the terminal (std
// prompt) when there is no --yes: a yes runs the call, a no or a cancel
// ends with status 1, and standard input that is not a terminal ends with
// status 2, as Run does.
func RunOnTerminal(args []string, p Policy) Output needs pipeline.Pipeline | term.Terminal | io.Stderr {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case option.Some[string] as q:
				let yes = prompt.Confirm(q.Value, false) catch {
				case prompt.NotInteractive:
					return needsYes(q.Value)
				case prompt.Cancelled:
					return declined(q.Value)
				case io.ReadFailed:
					return Output{Out: "", Err: q.Value + ": the answer could not be read\n", Code: 2}
				}
				if !yes {
					return declined(q.Value)
				}
			case option.None:
			}
		}
		Show(pipelineapi.Call(a.R), a.JSON, p)
	}
}

// Completion is the script that completes pipeline's commands in shell.
func Completion(shell api.Shell) string {
	api.Completion("pipeline", shell, []api.Entry{api.Entry{Name: pipelineapi.Name(pipelineapi.SubmitOp), Doc: pipelineapi.Doc(pipelineapi.SubmitOp)}, api.Entry{Name: pipelineapi.Name(pipelineapi.CancelOp), Doc: pipelineapi.Doc(pipelineapi.CancelOp)}, api.Entry{Name: pipelineapi.Name(pipelineapi.RetryOp), Doc: pipelineapi.Doc(pipelineapi.RetryOp)}, api.Entry{Name: pipelineapi.Name(pipelineapi.BoardOp), Doc: pipelineapi.Doc(pipelineapi.BoardOp)}, api.Entry{Name: pipelineapi.Name(pipelineapi.RunOfOp), Doc: pipelineapi.Doc(pipelineapi.RunOfOp)}})
}

// Wire is the command line as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, pipelineapi.Outcome, rpc.Transport]

// Carry prints c with --json, runs it against answer using the default
// status policy, and reads back the reply. Delivery can fail separately
// from answer's outcome.
func Carry(w Wire, c Request, answer own func(c Request) pipelineapi.Outcome) pipelineapi.Outcome fails rpc.Transport {
	let mut args = []string{"--json"}
	for a in Print(c) {
		args = args.Append(a)
	}
	try Read(c, runOver(args, Defaults(), answer))
}

// Agrees: the command line carries every call and every outcome the
// call can have unchanged.
law Agrees(r Request, g pipelineapi.Given) { api.Agrees[Request, pipelineapi.Outcome, rpc.Transport](Wire, r, pipelineapi.OutcomeOf(r, g)) }

// CodeIsThePolicy: a call's status is 0 for a value and the policy's
// Code for a typed failure.
law CodeIsThePolicy(r Request, g pipelineapi.Given, k int) {
	let status = 1 + ((k%125)+125)%125
	let d = Defaults()
	let p = Policy{..d, Code: func(f pipelineapi.Failure) int { status }}
	let o = pipelineapi.OutcomeOf(r, g)
	let out = runOver(Print(r), p, func(c Request) pipelineapi.Outcome { o })
	match o {
	case pipelineapi.Done:
		out.Code == 0
	case pipelineapi.Rejected:
		out.Code == status
	}
}

// TextIsThePolicy: without --json a value prints as the policy's Text;
// with --json every outcome prints as the wire's JSON, whatever Text says.
law TextIsThePolicy(r Request, g pipelineapi.Given, t string) {
	let d = Defaults()
	let p = Policy{..d, Text: func(reply pipelineapi.Reply) option.Option[string] { option.Some[string]{Value: t} }}
	let o = pipelineapi.OutcomeOf(r, g)
	let same = Show(o, true, p) == Show(o, true, d)
	match o {
	case pipelineapi.Done:
		same && Show(o, false, p).Out == line(t)
	case pipelineapi.Rejected:
		same && Show(o, false, p) == Show(o, false, d)
	}
}
