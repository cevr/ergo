import json
import rpc
import sync
import pipeline/board
import pipeline/pipeline
import pipeline/run

// Request is one call of pipeline.Pipeline: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = SubmitRequest{C pipeline.SubmitRun} | CancelRequest{C pipeline.CancelRun} | RetryRequest{C pipeline.RetryRun} | BoardRequest{} | RunOfRequest{Id string}

// Op is an operation of pipeline.Pipeline: what a policy matches on.
type Op = SubmitOp{} | CancelOp{} | RetryOp{} | BoardOp{} | RunOfOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = SubmitReply{Value pipeline.Receipt} | CancelReply{Value pipeline.Receipt} | RetryReply{Value pipeline.Receipt} | BoardReply{Value board.View} | RunOfReply{Value run.Run}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = WrongState{E run.WrongState} | WrongStage{E run.WrongStage} | Closed{E run.Closed} | BadLength{E run.BadLength} | NoSuchRun{E pipeline.NoSuchRun} | Unavailable{E pipeline.Unavailable}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case SubmitRequest:
		SubmitOp
	case CancelRequest:
		CancelOp
	case RetryRequest:
		RetryOp
	case BoardRequest:
		BoardOp
	case RunOfRequest:
		RunOfOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case SubmitOp:
		"submit"
	case CancelOp:
		"cancel"
	case RetryOp:
		"retry"
	case BoardOp:
		"board"
	case RunOfOp:
		"run-of"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case SubmitOp:
		"Submit starts a new run of 1 to 9 stages; a resend of the ID gets the first receipt."
	case CancelOp:
		"Cancel stops a run that has not ended, with the reason why."
	case RetryOp:
		"Retry tries the failed stage of a run now, without waiting for its backoff."
	case BoardOp:
		"Board is every run by column: queued, running, failing, passed, stopped."
	case RunOfOp:
		"RunOf is the state of the run named id."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case SubmitOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"stages\":{\"type\":\"integer\"}},\"required\":[\"id\",\"run\",\"stages\"]}")
	case CancelOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"why\":{\"type\":\"string\"}},\"required\":[\"id\",\"run\",\"why\"]}")
	case RetryOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"stage\":{\"type\":\"integer\"}},\"required\":[\"id\",\"run\",\"stage\"]}")
	case BoardOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case RunOfOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"}},\"required\":[\"id\"]}")
	}
}

// Call answers r on the bound pipeline.Pipeline: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs pipeline.Pipeline {
	match r {
	case SubmitRequest as x:
		let v = pipeline.Pipeline.Submit(x.C) catch {
		case run.WrongState as e:
			return Rejected{Failure: WrongState{E: e}}
		case run.WrongStage as e:
			return Rejected{Failure: WrongStage{E: e}}
		case run.Closed as e:
			return Rejected{Failure: Closed{E: e}}
		case run.BadLength as e:
			return Rejected{Failure: BadLength{E: e}}
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		case pipeline.Unavailable as e:
			return Rejected{Failure: Unavailable{E: e}}
		}
		Done{Reply: SubmitReply{Value: v}}
	case CancelRequest as x:
		let v = pipeline.Pipeline.Cancel(x.C) catch {
		case run.WrongState as e:
			return Rejected{Failure: WrongState{E: e}}
		case run.WrongStage as e:
			return Rejected{Failure: WrongStage{E: e}}
		case run.Closed as e:
			return Rejected{Failure: Closed{E: e}}
		case run.BadLength as e:
			return Rejected{Failure: BadLength{E: e}}
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		case pipeline.Unavailable as e:
			return Rejected{Failure: Unavailable{E: e}}
		}
		Done{Reply: CancelReply{Value: v}}
	case RetryRequest as x:
		let v = pipeline.Pipeline.Retry(x.C) catch {
		case run.WrongState as e:
			return Rejected{Failure: WrongState{E: e}}
		case run.WrongStage as e:
			return Rejected{Failure: WrongStage{E: e}}
		case run.Closed as e:
			return Rejected{Failure: Closed{E: e}}
		case run.BadLength as e:
			return Rejected{Failure: BadLength{E: e}}
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		case pipeline.Unavailable as e:
			return Rejected{Failure: Unavailable{E: e}}
		}
		Done{Reply: RetryReply{Value: v}}
	case BoardRequest:
		let v = pipeline.Pipeline.Board()
		Done{Reply: BoardReply{Value: v}}
	case RunOfRequest as x:
		let v = pipeline.Pipeline.RunOf(x.Id) catch {
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		}
		Done{Reply: RunOfReply{Value: v}}
	}
}

// Client provides pipeline.Pipeline by invoking typed per-operation handlers directly:
// a direct call returns its exact value or declared failure row with no Outcome boxing.
type Client { opSubmit func(pipeline.SubmitRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable, opCancel func(pipeline.CancelRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable, opRetry func(pipeline.RetryRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable, opBoard func() board.View, opRunOf func(string) run.Run fails pipeline.NoSuchRun } implements pipeline.Pipeline

// NewClient is the pipeline.Pipeline that invokes inner directly per operation.
func NewClient(inner pipeline.Pipeline) Client {
	Client{
		opSubmit: func(c pipeline.SubmitRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable { try inner.Submit(c) },
		opCancel: func(c pipeline.CancelRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable { try inner.Cancel(c) },
		opRetry:  func(c pipeline.RetryRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable { try inner.Retry(c) },
		opBoard:  func() board.View { inner.Board() },
		opRunOf:  func(id string) run.Run fails pipeline.NoSuchRun { try inner.RunOf(id) },
	}
}

// ClientInForce is the pipeline.Pipeline that invokes the provider currently in force.
func ClientInForce() Client needs pipeline.Pipeline {
	let held = InForce[pipeline.Pipeline]()
	Client{
		opSubmit: func(c pipeline.SubmitRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable { with held { try pipeline.Pipeline.Submit(c) } },
		opCancel: func(c pipeline.CancelRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable { with held { try pipeline.Pipeline.Cancel(c) } },
		opRetry:  func(c pipeline.RetryRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable { with held { try pipeline.Pipeline.Retry(c) } },
		opBoard:  func() board.View { with held { pipeline.Pipeline.Board() } },
		opRunOf:  func(id string) run.Run fails pipeline.NoSuchRun { with held { try pipeline.Pipeline.RunOf(id) } },
	}
}

// Submit invokes pipeline.Pipeline's Submit directly.
func Submit(client Client, c pipeline.SubmitRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable {
	try client.opSubmit(c)
}

// Cancel invokes pipeline.Pipeline's Cancel directly.
func Cancel(client Client, c pipeline.CancelRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable {
	try client.opCancel(c)
}

// Retry invokes pipeline.Pipeline's Retry directly.
func Retry(client Client, c pipeline.RetryRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable {
	try client.opRetry(c)
}

// Board invokes pipeline.Pipeline's Board directly.
func Board(client Client) board.View {
	client.opBoard()
}

// RunOf invokes pipeline.Pipeline's RunOf directly.
func RunOf(client Client, id string) run.Run fails pipeline.NoSuchRun {
	try client.opRunOf(id)
}

// CheckedClient carries erased pipeline.Pipeline requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// SubmitChecked sends pipeline.Pipeline's Submit over send and validates its Outcome.
func SubmitChecked(client CheckedClient, c pipeline.SubmitRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable | rpc.Transport {
	match try client.send(SubmitRequest{C: c}) {
	case Done as done:
		match done.Reply {
		case SubmitReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "pipelineapi: Submit was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case WrongState as failure:
			return failure.E
		case WrongStage as failure:
			return failure.E
		case Closed as failure:
			return failure.E
		case BadLength as failure:
			return failure.E
		case NoSuchRun as failure:
			return failure.E
		case Unavailable as failure:
			return failure.E
		}
	}
}

// CancelChecked sends pipeline.Pipeline's Cancel over send and validates its Outcome.
func CancelChecked(client CheckedClient, c pipeline.CancelRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable | rpc.Transport {
	match try client.send(CancelRequest{C: c}) {
	case Done as done:
		match done.Reply {
		case CancelReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "pipelineapi: Cancel was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case WrongState as failure:
			return failure.E
		case WrongStage as failure:
			return failure.E
		case Closed as failure:
			return failure.E
		case BadLength as failure:
			return failure.E
		case NoSuchRun as failure:
			return failure.E
		case Unavailable as failure:
			return failure.E
		}
	}
}

// RetryChecked sends pipeline.Pipeline's Retry over send and validates its Outcome.
func RetryChecked(client CheckedClient, c pipeline.RetryRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable | rpc.Transport {
	match try client.send(RetryRequest{C: c}) {
	case Done as done:
		match done.Reply {
		case RetryReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "pipelineapi: Retry was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case WrongState as failure:
			return failure.E
		case WrongStage as failure:
			return failure.E
		case Closed as failure:
			return failure.E
		case BadLength as failure:
			return failure.E
		case NoSuchRun as failure:
			return failure.E
		case Unavailable as failure:
			return failure.E
		}
	}
}

// BoardChecked sends pipeline.Pipeline's Board over send and validates its Outcome.
func BoardChecked(client CheckedClient) board.View fails rpc.Transport {
	match try client.send(BoardRequest) {
	case Done as done:
		match done.Reply {
		case BoardReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "pipelineapi: Board was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "pipelineapi: Board was answered with a failure outside its row"}
	}
}

// RunOfChecked sends pipeline.Pipeline's RunOf over send and validates its Outcome.
func RunOfChecked(client CheckedClient, id string) run.Run fails pipeline.NoSuchRun | rpc.Transport {
	match try client.send(RunOfRequest{Id: id}) {
	case Done as done:
		match done.Reply {
		case RunOfReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "pipelineapi: RunOf was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NoSuchRun as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "pipelineapi: RunOf was answered with a failure outside its row"}
		}
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Submit pipeline.Receipt, Cancel pipeline.Receipt, Retry pipeline.Receipt, Board board.View, RunOf run.Run }

func inRow(op Op, f Failure) bool {
	match op {
	case SubmitOp:
		match f {
		case WrongState, WrongStage, Closed, BadLength, NoSuchRun, Unavailable:
			true
		}
	case CancelOp:
		match f {
		case WrongState, WrongStage, Closed, BadLength, NoSuchRun, Unavailable:
			true
		}
	case RetryOp:
		match f {
		case WrongState, WrongStage, Closed, BadLength, NoSuchRun, Unavailable:
			true
		}
	case RunOfOp:
		match f {
		case NoSuchRun:
			true
		case _:
			false
		}
	case BoardOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case SubmitRequest:
		Done{Reply: SubmitReply{Value: g.Values.Submit}}
	case CancelRequest:
		Done{Reply: CancelReply{Value: g.Values.Cancel}}
	case RetryRequest:
		Done{Reply: RetryReply{Value: g.Values.Retry}}
	case BoardRequest:
		Done{Reply: BoardReply{Value: g.Values.Board}}
	case RunOfRequest:
		Done{Reply: RunOfReply{Value: g.Values.RunOf}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opSubmit: func(c pipeline.SubmitRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable {
			sent.Update(func(rs []Request) []Request { rs.Append(SubmitRequest{C: c}) })
			if g.Failing {
				match g.Failure {
				case WrongState as err:
					return err.E
				case WrongStage as err:
					return err.E
				case Closed as err:
					return err.E
				case BadLength as err:
					return err.E
				case NoSuchRun as err:
					return err.E
				case Unavailable as err:
					return err.E
				}
			}
			g.Values.Submit
		},
		opCancel: func(c pipeline.CancelRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable {
			sent.Update(func(rs []Request) []Request { rs.Append(CancelRequest{C: c}) })
			if g.Failing {
				match g.Failure {
				case WrongState as err:
					return err.E
				case WrongStage as err:
					return err.E
				case Closed as err:
					return err.E
				case BadLength as err:
					return err.E
				case NoSuchRun as err:
					return err.E
				case Unavailable as err:
					return err.E
				}
			}
			g.Values.Cancel
		},
		opRetry: func(c pipeline.RetryRun) pipeline.Receipt fails run.WrongState | run.WrongStage | run.Closed | run.BadLength | pipeline.NoSuchRun | pipeline.Unavailable {
			sent.Update(func(rs []Request) []Request { rs.Append(RetryRequest{C: c}) })
			if g.Failing {
				match g.Failure {
				case WrongState as err:
					return err.E
				case WrongStage as err:
					return err.E
				case Closed as err:
					return err.E
				case BadLength as err:
					return err.E
				case NoSuchRun as err:
					return err.E
				case Unavailable as err:
					return err.E
				}
			}
			g.Values.Retry
		},
		opBoard: func() board.View {
			sent.Update(func(rs []Request) []Request { rs.Append(BoardRequest) })
			g.Values.Board
		},
		opRunOf: func(id string) run.Run fails pipeline.NoSuchRun {
			sent.Update(func(rs []Request) []Request { rs.Append(RunOfRequest{Id: id}) })
			if g.Failing {
				match g.Failure {
				case NoSuchRun as err:
					return err.E
				case _:
				}
			}
			g.Values.RunOf
		},
	}
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case SubmitRequest as x:
		let v = SubmitChecked(client, x.C) catch {
		case run.WrongState as e:
			return Rejected{Failure: WrongState{E: e}}
		case run.WrongStage as e:
			return Rejected{Failure: WrongStage{E: e}}
		case run.Closed as e:
			return Rejected{Failure: Closed{E: e}}
		case run.BadLength as e:
			return Rejected{Failure: BadLength{E: e}}
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		case pipeline.Unavailable as e:
			return Rejected{Failure: Unavailable{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: SubmitReply{Value: v}}
	case CancelRequest as x:
		let v = CancelChecked(client, x.C) catch {
		case run.WrongState as e:
			return Rejected{Failure: WrongState{E: e}}
		case run.WrongStage as e:
			return Rejected{Failure: WrongStage{E: e}}
		case run.Closed as e:
			return Rejected{Failure: Closed{E: e}}
		case run.BadLength as e:
			return Rejected{Failure: BadLength{E: e}}
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		case pipeline.Unavailable as e:
			return Rejected{Failure: Unavailable{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: CancelReply{Value: v}}
	case RetryRequest as x:
		let v = RetryChecked(client, x.C) catch {
		case run.WrongState as e:
			return Rejected{Failure: WrongState{E: e}}
		case run.WrongStage as e:
			return Rejected{Failure: WrongStage{E: e}}
		case run.Closed as e:
			return Rejected{Failure: Closed{E: e}}
		case run.BadLength as e:
			return Rejected{Failure: BadLength{E: e}}
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		case pipeline.Unavailable as e:
			return Rejected{Failure: Unavailable{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: RetryReply{Value: v}}
	case BoardRequest:
		let v = BoardChecked(client) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: BoardReply{Value: v}}
	case RunOfRequest as x:
		let v = RunOfChecked(client, x.Id) catch {
		case pipeline.NoSuchRun as e:
			return Rejected{Failure: NoSuchRun{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: RunOfReply{Value: v}}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { pipeline.Pipeline: scripted(g, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(g, sent)
	let outer = NewClient(inner)
	let got = with context { pipeline.Pipeline: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted(g, sentChecked)
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { pipeline.Pipeline: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
