// The scene and its story. A story is the pure reference: the desk's
// rules written again over run.Decide and run.Fold, with the runner's
// answers read from a table. A scene plays the same acts on the real
// program: a durable actor of Dispatch over a memory event log (module
// domain's Sourced), its runner
// a testing.Script, its clock a time.Manual that only the scene moves.
// The law SceneAgreesWithStory says both end in the same desk.

import github.com/cevr/ergo/modules/domain
import github.com/cevr/ergo/modules/domain/memory
import pipeline/board

import pipeline/retry
import pipeline/run
import testing
import time

// Act is what a scene does: submit a run, cancel one, retry a stage of
// one now, or let the clock run (an hour, which ends any backoff).
type Act = Submits{Pick int, Stages int} | Cancels{Pick int} | Retries{Pick int, Stage int} | Waits{}

// RecoverAgrees: the stream a scene wrote folds back (domain.Sourced's
// recover with Evolve, which a restart runs) into the desk the scene
// ended in, exactly: its runs, its log, the runs still queued, and the
// job with its try. The step commits the desk that Evolve folds (desk.ergo
// apply), so no normal form is needed.
law RecoverAgrees(acts []Act, flaky []int) {
	let log = memory.New[Entry]()
	match played(acts, 0, flaky, log) {
	case Some[Played] as p:
		let l = Recovered(log).Recover() catch {
		case domain.Conflict, domain.Reused, domain.Unkept:
			return false
		}
		match l {
		case Some[Ledger] as r:
			r.Value.State == p.Value.Desk
		case None:
			false
		}
	case None:
		false
	}
}

// Played is how a scene ended: the desk and the board.
type Played { Desk Desk, Board board.View }

// played plays acts on log with the runner that flaky scripts (as
// SceneAgreesWithStory's), naming the commands from the place from on,
// or None when the context failed.
func played(acts []Act, from int, flaky []int, log domain.Log[Entry]) Option[Played] {
	let s = testing.Script[Runner]{}
	s.Run.Answer(func(id string, stage int, attempt int) bool fails Offline {
		match answerOf(flaky, stage, attempt) {
		case Some[bool] as a:
			a.Value
		case None:
			Offline{Why: "down"}
		}
	})
	let clock = time.NewManual(0)
	let d, v = with context { Scheduler: clock, Runner: s } { sceneOn(acts, from, clock, log) } catch {
	case domain.Conflict, domain.Reused, domain.Unkept, Unavailable:
		return None
	}
	Some[Played]{Value: Played{Desk: d, Board: v}}
}

// RestartGoesOn: a context stopped after the acts before cut and opened
// again over the same log (a restart: it recovers by Evolve, then
// appends after the last record) plays the rest of the acts to the desk
// that the story of all of them gives.
law RestartGoesOn(acts []Act, flaky []int, cut int) { restarted(acts, flaky, cut) }

// restarted is whether the acts, played on a log, stopped after the acts
// before cut and played on again, end in the story's desk.
func restarted(acts []Act, flaky []int, cut int) bool {
	let k = len(acts) + 1
	let at = ((cut % k) + k) % k
	let log = memory.New[Entry]()
	match played(acts[0:at], 0, flaky, log) {
	case Some[Played]:
	case None:
		return false
	}
	match played(acts[at:len(acts)], at, flaky, log) {
	case Some[Played] as p:
		Normal(p.Value.Desk) == Normal(Story(acts, flaky))
	case None:
		false
	}
}

// RestartMidStage: RestartGoesOn for one run of two stages whose first
// stage fails once (and the operator retries it) and whose second fails
// twice, cut anywhere: a restart while the second stage waits goes on
// with that stage's own try, not the first stage's failures too.
law RestartMidStage(waits int, cut int) {
	let mut acts = []Act{Submits{Pick: 0, Stages: 1}, Retries{Pick: 0, Stage: 0}}
	for _ in 0..small(waits)+1 {
		acts = acts.Append(Waits)
	}
	restarted(acts, []int{1, 2}, cut)
}

// Names are the runs of a scene.
let Names = []string{"build", "docs", "lint"}

func nameOf(pick int) string { Names[((pick%3)+3)%3] }

func small(n int) int { ((n % 3) + 3) % 3 }

// answerOf is the runner's answer to try attempt of stage, by the table
// flaky: stage s fails its first flaky[s] % 4 tries, and when flaky[s]
// is a multiple of 5 the runner is offline (None) for the first one.
func answerOf(flaky []int, stage int, attempt int) Option[bool] {
	if len(flaky) == 0 {
		return Some[bool]{Value: true}
	}
	let f = flaky[stage%len(flaky)]
	if f%5 == 0 && attempt == 1 {
		return None
	}
	Some[bool]{Value: attempt > ((f%4)+4)%4}
}

// envelopeOf is the command of the act a, named by its place i.
func envelopeOf(i int, a Act) Option[Envelope] {
	let id = "c\(i)"
	match a {
	case Submits as p:
		Some[Envelope]{Value: Envelope{ID: id, Run: nameOf(p.Pick), Command: run.Submit{Stages: 1 + small(p.Stages)}}}
	case Cancels as s:
		Some[Envelope]{Value: Envelope{ID: id, Run: nameOf(s.Pick), Command: run.Cancel{Why: "stop"}}}
	case Retries as g:
		Some[Envelope]{Value: Envelope{ID: id, Run: nameOf(g.Pick), Command: run.Retry{Stage: small(g.Stage)}}}
	case Waits:
		None
	}
}

// record is b after the command c of the run id, by Decide and Fold, or
// None when the run refuses it.
func record(b Book, id string, c run.Command) Option[Book] {
	let s = RunIn(b, id)
	let es = run.Decide(s, c) catch {
	case run.WrongState, run.WrongStage, run.Closed, run.BadLength:
		return None
	}
	let mut log = b.Log
	for e in es {
		log = log.Append(Entry{Run: id, Event: e})
	}
	Some[Book]{Value: Book{..b, Runs: b.Runs.Put(id, run.Fold(s, es)), Log: log}}
}

// must is the book that record gives for a command the story knows the
// run takes.
func must(o Option[Book]) Book {
	match o {
	case Some[Book] as b:
		b.Value
	case None:
		Unreachable("the story sent a command its run refuses")
	}
}

// next is the story's desk with the book b and no job: the first run of
// the queue that still waits starts, else the desk is idle.
func next(b Book) Desk {
	let mut left = []string{}
	let mut found = ""
	for id in b.Queue {
		if found != "" {
			left = left.Append(id)
			continue
		}
		match RunIn(b, id) {
		case run.Queued:
			found = id
		case run.Unsubmitted, run.Running, run.Failing, run.Done:
		}
	}
	if found == "" {
		return Idle{Book: Book{..b, Queue: []string{}}}
	}
	let started = must(record(Book{..b, Queue: left}, found, run.Start))
	Busy{Book: started, Job: Job{Run: found, Stage: 0, Attempt: retry.First(retry.Standard)}}
}

// told is the story's desk after the command env. (A scene names each
// command by its place, so the story sees no resend.)
func told(d Desk, env Envelope) Desk {
	let b = BookOf(d)
	let known = match RunIn(b, env.Run) {
	case run.Unsubmitted:
		false
	case run.Queued, run.Running, run.Failing, run.Done:
		true
	}
	let submit = match env.Command {
	case run.Submit:
		true
	case run.Start, run.Finish, run.Retry, run.GiveUp, run.Cancel:
		false
	}
	if !known && !submit {
		return d
	}
	let taken = match record(b, env.Run, env.Command) {
	case Some[Book] as t:
		t.Value
	case None:
		return d
	}
	let mut nb = taken
	if submit {
		nb = Book{..nb, Queue: nb.Queue.Append(env.Run)}
	}
	let now = RunIn(nb, env.Run)
	match d {
	case Idle:
		next(nb)
	case Busy as w:
		if w.Job.Run == env.Run && run.IsDone(now) { next(nb) } else { Busy{Book: nb, Job: w.Job} }
	case Waiting as w:
		if w.Job.Run != env.Run {
			return Waiting{Book: nb, Job: w.Job}
		}
		match now {
		case run.Running:
			Busy{Book: nb, Job: Job{..w.Job, Attempt: retry.Trying{P: retry.Standard, Try: retry.TryOf(w.Job.Attempt) + 1}}}
		case run.Done:
			next(nb)
		case run.Unsubmitted, run.Queued, run.Failing:
			Waiting{Book: nb, Job: w.Job}
		}
	}
}

// drive is the story's desk once the runner ran every try it could: each
// try's answer comes from flaky, until the desk is idle or waits.
func drive(d Desk, flaky []int) Desk {
	let mut at = d
	for {
		let (b, j) = match at {
		case Busy as w:
			(w.Book, w.Job)
		case Idle, Waiting:
			return at
		}
		let ok = match answerOf(flaky, j.Stage, retry.TryOf(j.Attempt)) {
		case Some[bool] as a:
			a.Value
		case None:
			false
		}
		let nb = must(record(b, j.Run, run.Finish{Stage: j.Stage, OK: ok}))
		at = match RunIn(nb, j.Run) {
		case run.Running as r:
			Busy{Book: nb, Job: Job{Run: j.Run, Stage: r.Next, Attempt: retry.First(retry.Standard)}}
		case run.Failing:
			let tries = retry.TryOf(j.Attempt)
			if tries >= retry.Standard.Attempts {
				next(must(record(nb, j.Run, run.GiveUp{Stage: j.Stage})))
			} else {
				Waiting{Book: nb, Job: Job{..j, Attempt: retry.Backoff{P: retry.Standard, Try: tries}}}
			}
		case run.Unsubmitted, run.Queued, run.Done:
			next(nb)
		}
	}
}

// Story is the desk after the acts, by the reference: each act, then the
// runner's tries until the desk is idle or waits; a Waits lets an hour pass.
func Story(acts []Act, flaky []int) Desk {
	let mut d Desk = Fresh
	for i, a in acts {
		match envelopeOf(i, a) {
		case Some[Envelope] as e:
			d = told(d, e.Value)
		case None:
			d = waited(d, flaky)
		}
		d = drive(d, flaky)
	}
	d
}

// waited is the story's desk after an hour: each backoff ends (they are
// seconds long), and the runner runs the tries that follow, until the
// desk is idle.
func waited(d Desk, flaky []int) Desk {
	let mut at = d
	for {
		match at {
		case Waiting as w:
			let n = retry.TryOf(w.Job.Attempt) + 1
			at = drive(Busy{Book: must(record(w.Book, w.Job.Run, run.Retry{Stage: w.Job.Stage})), Job: Job{..w.Job, Attempt: retry.Trying{P: retry.Standard, Try: n}}}, flaky)
		case Idle, Busy:
			return at
		}
	}
}

// scene plays the acts on a context opened over a fresh memory log, with
// the runner and the clock of the caller's context, and is the desk at
// the end.
func scene(acts []Act, clock time.Manual) Desk fails domain.Conflict | domain.Reused | domain.Unkept | Unavailable needs Runner | Scheduler {
	let d, _ = try sceneOn(acts, 0, clock, memory.New[Entry]())
	d
}

// sceneOn plays the acts on a context opened over log, naming the
// commands from the place from on, and is the desk and the board at the
// end. After each act it waits until the runner
// runs no try; a Waits moves the clock an hour.
func sceneOn(acts []Act, from int, clock time.Manual, log domain.Log[Entry]) (Desk, board.View) fails domain.Conflict | domain.Reused | domain.Unkept | Unavailable needs Runner | Scheduler {
	let m = try Open(log)
	for i, a in acts {
		match envelopeOf(from+i, a) {
		case Some[Envelope] as e:
			let _ = send(m.h, e.Value) catch {
			case run.WrongState, run.WrongStage, run.Closed, run.BadLength, NoSuchRun:
				Receipt{Command: "", Position: 0}
			case Unavailable:
				return Unavailable
			}
		case None:
			clock.Advance(1h)
		}
		let _ = try m.Settle()
	}
	let d = m.h.desk.State().State
	let v = m.Board()
	(d, v)
}

// SceneAgreesWithStory: the program, played act by act with a scripted
// runner and a manual clock, ends in the desk that the story gives.
law SceneAgreesWithStory(acts []Act, flaky []int) {
	let want = Story(acts, flaky)
	let s = testing.Script[Runner]{}
	s.Run.Answer(func(id string, stage int, attempt int) bool fails Offline {
		match answerOf(flaky, stage, attempt) {
		case Some[bool] as a:
			a.Value
		case None:
			Offline{Why: "down"}
		}
	})
	let clock = time.NewManual(0)
	let got = with context { Scheduler: clock, Runner: s } { scene(acts, clock) } catch {
	case domain.Conflict, domain.Reused, domain.Unkept, Unavailable:
		return false
	}
	got == want
}
