// The context's event log (PX-log, DK5). The desk is event-sourced on a
// domain.Log by domain.Sourced: each step that gives entries commits them
// as one record of the stream Stream, which the actor's save appends
// before it commits the step, and a start folds the stream back into the
// desk with Evolve. The record of an operator's command carries the
// command's ID, so the log keeps a resend once; a step of the runner's or
// the saga's carries a domain.StepID. The board and the notices are
// followers of the stream.

import github.com/cevr/ergo/modules/domain
import pipeline/retry
import pipeline/run

// Stream is the stream of the context's entries.
let Stream = "pipeline"

// Recovered is the store of the desk over log: domain.Sourced of the
// stream Stream, which folds its entries from Fresh with Evolve.
func Recovered(log domain.Log[Entry]) domain.Store[Desk, Signal, Entry] {
	domain.Sourced[Desk, Signal, Entry](log, Stream, Fresh, Evolve)
}

// Evolve is the desk after the entry e: the run's state after the event,
// the log with the entry, the queue, and the job as the desk's step
// leaves it. A run is queued when submitted and leaves the queue when it
// starts or stops; its start makes it the job, at its first stage; a
// passed stage moves the job on; a failed one waits as the saga orders
// (a failure the saga gives up on stays the job until its run is
// abandoned); a retry tries again; the run's end leaves the desk idle.
func Evolve(d Desk, e Entry) Desk {
	let was = BookOf(d)
	let b = Book{..was, Runs: was.Runs.Put(e.Run, run.Evolve(RunIn(was, e.Run), e.Event)), Log: was.Log.Append(e)}
	match e.Event {
	case run.Submitted:
		within(d, Book{..b, Queue: b.Queue.Append(e.Run)})
	case run.Started:
		Busy{Book: Book{..b, Queue: without(b.Queue, e.Run)}, Job: Job{Run: e.Run, Stage: 0, Attempt: retry.First(retry.Standard)}}
	case run.StagePassed:
		match RunIn(b, e.Run) {
		case run.Running as r:
			Busy{Book: b, Job: Job{Run: e.Run, Stage: r.Next, Attempt: retry.First(retry.Standard)}}
		case run.Unsubmitted, run.Queued, run.Failing, run.Done:
			within(d, b)
		}
	case run.StageFailed as f:
		let j = jobOf(d, e.Run, f.Stage)
		match retry.Step(j.Attempt, retry.Failed) {
		case Enter[retry.Attempt] as n:
			Waiting{Book: b, Job: Job{..j, Attempt: n.Next}}
		case Stay[retry.Attempt], Emit[retry.Attempt, retry.Order], Tell[retry.Attempt, retry.Order], Done[retry.Order], Ignore, Reject:
			within(d, b)
		}
	case run.Retried as r:
		let j = jobOf(d, e.Run, r.Stage)
		Busy{Book: b, Job: Job{..j, Attempt: retry.Trying{P: retry.Standard, Try: retry.TryOf(j.Attempt) + 1}}}
	case run.Finished, run.Abandoned:
		Idle{Book: b}
	case run.Stopped:
		let left = Book{..b, Queue: without(b.Queue, e.Run)}
		match d {
		case Busy as w:
			if w.Job.Run == e.Run { Idle{Book: left} } else { within(d, left) }
		case Waiting as w:
			if w.Job.Run == e.Run { Idle{Book: left} } else { within(d, left) }
		case Idle:
			Idle{Book: left}
		}
	}
}

// within is d with the book b, in the same state.
func within(d Desk, b Book) Desk {
	match d {
	case Idle:
		Idle{Book: b}
	case Busy as w:
		Busy{Book: b, Job: w.Job}
	case Waiting as w:
		Waiting{Book: b, Job: w.Job}
	}
}

// jobOf is d's job, or the first try of stage of the run id when d has
// none.
func jobOf(d Desk, id string, stage int) Job {
	match d {
	case Busy as w:
		w.Job
	case Waiting as w:
		w.Job
	case Idle:
		Job{Run: id, Stage: stage, Attempt: retry.First(retry.Standard)}
	}
}

// without is q with no id.
func without(q []string, id string) []string {
	let mut out = []string{}
	for x in q {
		if x != id {
			out = out.Append(x)
		}
	}
	out
}

// Normal is d with its queue as Evolve gives it: the runs still queued.
// The desk commits the desk Evolve folds, so Normal of a desk is the desk;
// the story (scene.ergo), a second implementation for the laws, keeps a
// run it no longer runs (one cancelled while queued) in its queue until it
// passes it, so RestartGoesOn compares both in this form.
func Normal(d Desk) Desk {
	let b = BookOf(d)
	let mut queue = []string{}
	for id in b.Queue {
		match RunIn(b, id) {
		case run.Queued:
			queue = queue.Append(id)
		case run.Unsubmitted, run.Running, run.Failing, run.Done:
		}
	}
	within(d, Book{..b, Queue: queue})
}
