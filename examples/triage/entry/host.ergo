// HostCase compares hosts as a resolver does: case does not matter, so
// web-1, WEB-1 and Web-1 are one host. It is a provider of the prelude's
// Hashing[string]: its Equal compares the lower-case forms and its Hash
// hashes that form, so a Map[string, int, HostCase] is Go's own map keyed
// by the lower-case host (types.md, Maps 5), each entry keeping the
// spelling the log first wrote. The package's test build runs Hashing's
// laws against it.

import strings

type HostCase {} implements Hashing[string]

// Hash is the hash of the host's lower-case form.
func Hash(_ HostCase, host string) uint64 { hash(strings.ToLower(host)) }

// Equal reports whether a and b are one host.
func Equal(_ HostCase, a string, b string) bool { strings.ToLower(a) == strings.ToLower(b) }

// Counts is the number of entries of each host, hosts compared by
// HostCase; a host keeps its first spelling.
func Counts(entries []Entry) Map[string, int, HostCase] {
	let mut out = Map[string, int, HostCase]{}
	for e in entries {
		let n = match out.Get(e.Host) {
		case Some[int] as c:
			c.Value + 1
		case None:
			1
		}
		out[e.Host] = n
	}
	out
}
