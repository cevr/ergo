// Package screen keeps a scrollback buffer of lines and the pages a
// reader has marked. A mark keeps a window of the buffer; the buffer is
// written after (a line is redrawn), and the mark must still show the
// lines as they were. The window is copied, once, at the mark: not the
// buffer (the entry rule, docs/spec/types.md, Bindings), so a mark costs
// its page, not the scrollback.

import slices

// Screen is the buffer and the marked pages.
type Screen { lines []string, marks [][]string }

// New is a screen of n blank lines.
func New(n int) Screen {
	let mut lines = []string{}
	for _ in 0..n {
		lines = lines.Append("")
	}
	Screen{lines: lines, marks: [][]string{}}
}

// Marked is the outcome of a mark.
type Marked = Page{Index int} | OutOfRange{}

// Draw writes line i of the buffer; a line past the end is ignored.
func Draw(s mut Screen, i int, text string) {
	if i >= 0 && i < s.lines.Len() {
		s.lines[i] = text
	}
}

// Mark keeps lines from to to (not included) as a page.
func Mark(s mut Screen, from int, to int) Marked {
	if from < 0 || to > s.lines.Len() || from > to {
		return OutOfRange
	}
	s.marks = s.marks.Append(slices.Slice(s.lines, from, to))
	Page{Index: s.marks.Len() - 1}
}

// MarkKeepsThePast: a page shows the lines as they were when it was
// marked, though the buffer is redrawn after.
law MarkKeepsThePast(a int, b int) {
	let mut s = New(8)
	let from = small(a)
	let to = from + 1 + small(b)%(8-from)
	for i in 0..8 {
		Draw(&s, i, "old\(i)")
	}
	let p = match Mark(&s, from, to) {
	case Page as pg:
		pg.Index
	case OutOfRange:
		return false
	}
	for i in 0..8 {
		Draw(&s, i, "new\(i)")
	}
	let page = PageOf(s, p)
	let mut ok = page.Len() == to-from && Line(s, from) == "new\(from)"
	for i in 0..page.Len() {
		ok = ok && page[i] == "old\(from + i)"
	}
	ok
}

func small(n int) int { (if n < 0 { -(n + 1) } else { n }) % 6 }

// MarkOutOfRange: a window past the buffer is refused and no page is
// kept.
law MarkOutOfRange(n int) {
	let mut s = New(4)
	match Mark(&s, 2, 5+small(n)) {
	case Page:
		false
	case OutOfRange:
		PageOf(s, 0).Len() == 0
	}
}

// PageOf is marked page i, empty when there is none.
func PageOf(s Screen, i int) []string {
	if i < 0 || i >= s.marks.Len() { []string{} } else { s.marks[i] }
}

// Line is line i of the buffer, empty past the end.
func Line(s Screen, i int) string {
	if i < 0 || i >= s.lines.Len() { "" } else { s.lines[i] }
}
