// Package seed is a seeded stream of numbers kept as a value (SplitMix64),
// so a scene's state carries its own randomness and a step stays pure: the
// same seed and the same acts give the same scene, on every run.

// Seed is the stream's state.
type Seed { State uint64 }

// Of is the stream that starts at n.
func Of(n uint64) Seed { Seed{State: n} }

// Draw is the stream's next 64 bits and the stream after them.
func Draw(s Seed) (uint64, Seed) {
	let next = s.State + 0x9E3779B97F4A7C15
	let mut z = next
	z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
	z = (z ^ (z >> 27)) * 0x94D049BB133111EB
	(z ^ (z >> 31), Seed{State: next})
}

// Between is a number in [lo, hi) and the stream after it.
func Between(s Seed, lo float64, hi float64) (float64, Seed) {
	let bits, after = Draw(s)
	let unit = float64(bits>>11) / 9007199254740992.0
	(lo + (hi-lo)*unit, after)
}

// Below is a whole number in [0, n) and the stream after it; n > 0.
func Below(s Seed, n int) (int, Seed) {
	let bits, after = Draw(s)
	(int(bits % uint64(n)), after)
}
