// The file's laws. ergo test also runs board.Store's laws on a Sheet over
// each case's own fstest.Memory (NewSheet).

import fkboard/board
import fstest
import strings

// ACutFileIsNamed: a file cut short anywhere before its last byte loads
// as Broken, naming the file.
law ACutFileIsNamed(n int, cut int where 0 <= cut) {
	let disk = fstest.NewMemory()
	let text = Encode(board.Sample(n))
	let at = cut % (len(text) - 1)
	try disk.WriteFile(Name, text[:at])
	let _ = NewSheet(disk, disk).Load() catch {
	case board.Broken as b:
		return strings.HasPrefix(b.Why, Name+": ")
	}
	false
}
