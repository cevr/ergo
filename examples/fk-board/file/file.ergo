// Package file holds Sheet, a board.Store that keeps the board in one text
// file, a line per column and a line per card under it:
//
//	column	"todo"	"To Do"
//	card	"card-1"	"V"	"Align the finder scope"	""
//
// Each text is quoted by strconv.Quote, so a line holds no raw tab and no
// line feed. A save writes the whole file, which fs.Writes' WriteFile
// replaces at once, so a crash leaves the old board or the new one.

import fkboard/board
import fs
import strconv
import strings

// Sheet is a board.Store in the file at path. It holds the file system it
// reads and writes as values (as kvstore's Log does).
type Sheet { path string, files fs.Files, writes fs.Writes }

// Name is the file of a Sheet made by NewSheet.
let Name = "board.txt"

// NewSheet is the Sheet in Name in the working directory.
func NewSheet(files fs.Files, writes fs.Writes) Sheet { At(Name, files, writes) }

// At is the Sheet in the file path.
func At(path string, files fs.Files, writes fs.Writes) Sheet { Sheet{path: path, files: files, writes: writes} }

// Load is the board in the file, or None when there is no file.
func Load(s Sheet) Option[[]board.Column] fails board.Broken {
	let text = s.files.ReadFile(s.path) catch {
	case fs.NotFound:
		return None
	case fs.Denied as d:
		return board.Broken{Why: "permission denied: " + d.Path}
	case fs.Failed as f:
		return board.Broken{Why: f.Path + ": " + f.Reason}
	}
	Some[[]board.Column]{Value: try Decode(s.path, text)}
}

// Save writes columns as the file.
func Save(s Sheet, columns []board.Column) fails board.Broken {
	s.writes.WriteFile(s.path, Encode(columns)) catch {
	case fs.NotFound as n:
		return board.Broken{Why: "no directory for " + n.Path}
	case fs.Denied as d:
		return board.Broken{Why: "permission denied: " + d.Path}
	case fs.Failed as f:
		return board.Broken{Why: f.Path + ": " + f.Reason}
	}
}

// Encode is the file's text for columns.
func Encode(columns []board.Column) string {
	let mut out = ""
	for c in columns {
		out = out + "column\t" + strconv.Quote(c.ID) + "\t" + strconv.Quote(c.Name) + "\n"
		for card in c.Cards {
			out = out + "card\t" + strconv.Quote(card.ID) + "\t" + strconv.Quote(card.Key) + "\t" + strconv.Quote(card.Title) + "\t" + strconv.Quote(card.Description) + "\n"
		}
	}
	out
}

// Decode is the board of a file's text; path names the file in the
// failure.
func Decode(path string, text string) []board.Column fails board.Broken {
	let mut columns = []board.Column{}
	let mut n = 0
	for raw in strings.Lines(text) {
		n = n + 1
		let line = strings.TrimSuffix(raw, "\n")
		let bad = board.Broken{Why: "\(path):\(n): not a column or a card: \(line)"}
		let f = strings.Split(line, "\t")
		let mut texts = []string{}
		for i in 1..len(f) {
			texts = texts.Append(strconv.Unquote(f[i]) catch {
			case strconv.Malformed:
				return bad
			})
		}
		match (f[0], len(f)) {
		case ("column", 3):
			columns = columns.Append(board.Column{ID: texts[0], Name: texts[1], Cards: []board.Card{}})
		case ("card", 5):
			if len(columns) == 0 {
				return bad
			}
			let last = columns[len(columns)-1]
			let card = board.Card{ID: texts[0], Key: texts[1], Title: texts[2], Description: texts[3]}
			let mut next = []board.Column{}
			for i in 0..len(columns)-1 {
				next = next.Append(columns[i])
			}
			columns = next.Append(board.Column{..last, Cards: last.Cards.Append(card)})
		case (_, _):
			return bad
		}
	}
	columns
}
