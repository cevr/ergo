// The inbox's rules as laws.

// InOrder: the messages of a thread are kept in the order they are filed,
// and each after the first joins the thread with its new count.
law InOrder(n int) {
	let k = 1 + (if n < 0 { -(n + 1) } else { n })%12
	let mut b = New()
	for i in 0..k {
		match File(&b, Msg{Thread: "t", From: "a", Body: "m\(i)"}) {
		case Opened as o:
			if i != 0 || o.Thread != "t" {
				return false
			}
		case Joined as j:
			if i == 0 || j.Count != i+1 {
				return false
			}
		case EmptyBody:
			return false
		}
	}
	let t = Thread(b, "t")
	let mut ok = len(t) == k && Unread(b, "t") == k
	for i in 0..len(t) {
		ok = ok && t[i].Body == "m\(i)"
	}
	ok
}

// ThreadsApart: filing into one thread leaves every other thread, and a
// copy of the inbox taken before, as they were.
law ThreadsApart(n int) {
	let k = 1 + (if n < 0 { -(n + 1) } else { n })%6
	let mut b = New()
	let _ = File(&b, Msg{Thread: "x", From: "a", Body: "first"})
	let _ = File(&b, Msg{Thread: "y", From: "a", Body: "other"})
	let before = b
	for i in 0..k {
		let _ = File(&b, Msg{Thread: "x", From: "b", Body: "more \(i)"})
	}
	len(Thread(b, "x")) == k+1 && len(Thread(b, "y")) == 1 && len(Thread(before, "x")) == 1 && Unread(before, "x") == 1
}

// EmptyRefused: a message with no body is refused and changes nothing.
law EmptyRefused(n int) {
	let mut b = New()
	let name = "t\(n)"
	match File(&b, Msg{Thread: name, From: "a", Body: ""}) {
	case EmptyBody:
		Threads(b) == 0 && Unread(b, name) == 0
	case Opened, Joined:
		false
	}
}

// ReadClears: reading a thread returns its unread count and clears it,
// keeping its messages.
law ReadClears(n int) {
	let k = 1 + (if n < 0 { -(n + 1) } else { n })%5
	let mut b = New()
	for i in 0..k {
		let _ = File(&b, Msg{Thread: "t", From: "a", Body: "m\(i)"})
	}
	MarkRead(&b, "t") == k && Unread(b, "t") == 0 && len(Thread(b, "t")) == k
}
