// Package threads files the messages of an inbox into threads: a Map from
// a thread's name to its messages, in the order they came, and a count of
// the unread ones. Filing a message reads its thread out of the Map,
// appends to it and stores it back; the lowering moves the thread out and
// back in place (the entry move-out, docs/spec/types.md, Bindings), so
// filing costs the same however long the thread is.

import maps
import option

// Msg is one message.
type Msg { Thread string, From string, Body string }

// Inbox is the threads and the unread count of each.
type Inbox { threads Map[string, []Msg], unread Map[string, int] }

// New is an empty inbox.
func New() Inbox {
	Inbox{threads: Map[string, []Msg]{}, unread: Map[string, int]{}}
}

// InOrder: the messages of a thread are kept in the order they are filed,
// and each after the first joins the thread with its new count.
law InOrder(n int) {
	let k = 1 + (if n < 0 { -(n + 1) } else { n })%12
	let mut b = New()
	for i in 0..k {
		match File(&b, Msg{Thread: "t", From: "a", Body: "m\(i)"}) {
		case Opened as o:
			if i != 0 || o.Thread != "t" {
				return false
			}
		case Joined as j:
			if i == 0 || j.Count != i+1 {
				return false
			}
		case EmptyBody:
			return false
		}
	}
	let t = Thread(b, "t")
	let mut ok = t.Len() == k && Unread(b, "t") == k
	for i in 0..t.Len() {
		ok = ok && t[i].Body == "m\(i)"
	}
	ok
}

// ThreadsApart: filing into one thread leaves every other thread, and a
// copy of the inbox taken before, as they were.
law ThreadsApart(n int) {
	let k = 1 + (if n < 0 { -(n + 1) } else { n })%6
	let mut b = New()
	let _ = File(&b, Msg{Thread: "x", From: "a", Body: "first"})
	let _ = File(&b, Msg{Thread: "y", From: "a", Body: "other"})
	let before = b
	for i in 0..k {
		let _ = File(&b, Msg{Thread: "x", From: "b", Body: "more \(i)"})
	}
	Thread(b, "x").Len() == k+1 && Thread(b, "y").Len() == 1 && Thread(before, "x").Len() == 1 && Unread(before, "x") == 1
}

// EmptyRefused: a message with no body is refused and changes nothing.
law EmptyRefused(n int) {
	let mut b = New()
	let name = "t\(n)"
	match File(&b, Msg{Thread: name, From: "a", Body: ""}) {
	case EmptyBody:
		Threads(b) == 0 && Unread(b, name) == 0
	case Opened, Joined:
		false
	}
}

// ReadClears: reading a thread returns its unread count and clears it,
// keeping its messages.
law ReadClears(n int) {
	let k = 1 + (if n < 0 { -(n + 1) } else { n })%5
	let mut b = New()
	for i in 0..k {
		let _ = File(&b, Msg{Thread: "t", From: "a", Body: "m\(i)"})
	}
	MarkRead(&b, "t") == k && Unread(b, "t") == 0 && Thread(b, "t").Len() == k
}

// Filed is the outcome of filing a message: it opened a thread, joined
// one, or was refused for an empty body.
type Filed = Opened{Thread string} | Joined{Thread string, Count int} | EmptyBody{}

// File puts m at the end of its thread.
func File(b mut Inbox, m Msg) Filed {
	if m.Body.Len() == 0 {
		return EmptyBody
	}
	let mut msgs = []Msg{}
	match b.threads.Get(m.Thread) {
	case option.Some[[]Msg] as t:
		msgs = t.Value
	case option.None:
	}
	let opened = msgs.Len() == 0
	msgs = msgs.Append(m)
	let count = msgs.Len()
	b.threads[m.Thread] = msgs
	b.unread[m.Thread] = Unread(*b, m.Thread) + 1
	if opened {
		return Opened{Thread: m.Thread}
	}
	Joined{Thread: m.Thread, Count: count}
}

// Forward adds m to the end of thread to as an upsert, without touching
// the unread counts, and returns the thread's new length. maps.Update
// hands the Map over and gets it back (b.threads = maps.Update(b.threads,
// …)), and the callback's thread is fresh, so the Map is written in place.
func Forward(b mut Inbox, to string, m Msg) int {
	b.threads = maps.Update(b.threads, to, func(old option.Option[[]Msg]) []Msg {
		match old {
		case option.Some[[]Msg] as t:
			t.Value.Append(m)
		case option.None:
			[]Msg{m}
		}
	})
	Thread(*b, to).Len()
}

// ForwardIsFile: forwarding k messages builds the thread filing them
// would, and leaves a copy of the inbox taken before as it was.
law ForwardIsFile(n int) {
	let k = 1 + (if n < 0 { -(n + 1) } else { n })%6
	let mut a = New()
	let mut b = New()
	let _ = File(&b, Msg{Thread: "x", From: "a", Body: "first"})
	let _ = File(&a, Msg{Thread: "x", From: "a", Body: "first"})
	let before = b
	let mut ok = true
	for i in 0..k {
		let m = Msg{Thread: "x", From: "b", Body: "more \(i)"}
		let _ = File(&a, m)
		ok = ok && Forward(&b, "x", m) == i+2
	}
	let ta = Thread(a, "x")
	let tb = Thread(b, "x")
	ok = ok && ta.Len() == tb.Len() && Thread(before, "x").Len() == 1
	for i in 0..ta.Len() {
		ok = ok && ta[i].Body == tb[i].Body
	}
	ok
}

// Thread is the messages of a thread, oldest first; empty when there are
// none.
func Thread(b Inbox, name string) []Msg {
	match b.threads.Get(name) {
	case option.Some[[]Msg] as t:
		t.Value
	case option.None:
		[]Msg{}
	}
}

// Unread is the number of messages of a thread not yet read.
func Unread(b Inbox, name string) int {
	match b.unread.Get(name) {
	case option.Some[int] as n:
		n.Value
	case option.None:
		0
	}
}

// MarkRead reads a thread: its unread count goes to zero, and the count
// it had is returned.
func MarkRead(b mut Inbox, name string) int {
	let n = Unread(*b, name)
	b.unread[name] = 0
	n
}

// Threads is the number of threads.
func Threads(b Inbox) int { b.threads.Len() }
