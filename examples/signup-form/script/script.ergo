// Package script plays a script of form events on the subscription form's
// screen (stage b), on std ui's test host over the manual clock main
// binds, and shows the screen after each one.

import actor
import core
import machines
import signupform/screen
import signupform/subscribe
import io
import strconv
import strings
import time
import ui

// BadLine is a line the script cannot read.
type BadLine { Line int, Why string }

// Line is a read line: its text and what it does.
type Line { Text string, Do Do }

// Do is what a line does: an act on the screen, or a count of the act
// before it.
type Do = Act{Act ui.Act} | Stats

// Stats is the line `stats`.
type Stats {}

// Read reads the lines of a script. A line is one of:
//   - `name TEXT`, `email TEXT`, `note TEXT`: fill that field with TEXT
//     (the rest of the line after one space, possibly empty);
//   - `submit`: click the button Subscribe;
//   - `enter`: press Enter in the form, which submits it;
//   - `wait MS`: move the clock MS milliseconds, so a check or a submit
//     that waits on it answers, and settle;
//   - `stats`: print the work of the act before it.
//
// A blank line or a line that starts with # is skipped.
func Read(lines []string) []Line fails BadLine {
	let mut out = []Line{}
	for i, line in lines {
		let n = i + 1
		let text = strings.TrimSpace(line)
		if text == "" || strings.HasPrefix(text, "#") {
			continue
		}
		let word = strings.Fields(text)[0]
		let rest = strings.TrimPrefix(strings.TrimPrefix(text, word), " ")
		let do Do = match word {
		case "name":
			fill(screen.NameLabel, rest)
		case "email":
			fill(screen.EmailLabel, rest)
		case "note":
			fill(screen.NoteLabel, rest)
		case "submit":
			Act{Act: ui.ClickOn{At: ui.WithRole{Role: ui.Button, Name: screen.SubmitLabel}}}
		case "enter":
			Act{Act: ui.KeyIn{Press: ui.KeyPress{Name: "Enter", Mods: ui.Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}}
		case "stats":
			Stats
		case "wait":
			let ms = strconv.Atoi(rest) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return BadLine{Line: n, Why: "wait takes milliseconds"}
			}
			Act{Act: ui.AdvanceBy{By: time.Times(1ms, ms)}}
		case _:
			return BadLine{Line: n, Why: "a line is name, email or note TEXT, submit, enter, wait MS or stats"}
		}
		out = out.Append(Line{Text: text, Do: do})
	}
	out
}

func fill(label string, text string) Do { Act{Act: ui.FillIn{At: ui.WithPlaceholder{Text: label}, Text: text}} }

// Host is the form on the test host.
type Host = ui.TestHost[subscribe.Form, subscribe.Signal, machines.Decision[subscribe.Form, core.Never]]

// Run reads the script from io.Stdin and plays it on the screen, on std
// ui's test host over clock, with the Subscribers of its context. It shows
// the screen first and after each line: `> LINE`, then the screen in a
// line. An act whose locator finds no node, or more than one, does
// nothing and says so, as a scene that names no node fails. It returns the
// exit status: 0, or 1 when the script is refused or the screen fails.
func Run(clock time.Manual) int needs io.Console | io.Stdin | time.Scheduler | subscribe.Subscribers {
	let mut lines = []string{}
	for line in io.Stdin.Lines() {
		lines = lines.Append(line)
	}
	let script = Read(lines) catch {
	case BadLine as b:
		io.Console.Println("? line \(b.Line): \(b.Why)")
		return 1
	}
	let app = actor.StartMachine(subscribe.Subscribing{}, 8, func(o core.Never) {})
	let status = play(app, clock, script) catch {
	case actor.Stopped:
		io.Console.Println("? the form stopped")
		1
	case ui.BadPatch as p:
		io.Console.Println("? a patch is refused: \(p.Why)")
		1
	}
	app.Stop()
	status
}

func play(app actor.Actor[subscribe.Form, subscribe.Signal, machines.Decision[subscribe.Form, core.Never]], clock time.Manual, script []Line) int fails actor.Stopped | ui.BadPatch needs io.Console {
	let mut h = try ui.NewTestHost(app, screen.Screen, clock, 8)
	io.Console.Println(Shown(&h))
	for x in script {
		io.Console.Println("> \(x.Text)")
		match x.Do {
		case Act as a:
			ui.Play(&h, []ui.Act{a.Act, ui.SettleAll}) catch {
			case ui.NoNode as no:
				io.Console.Println("? no node: \(no.Label)")
				continue
			case ui.Ambiguous as m:
				io.Console.Println("? \(m.Count) nodes: \(m.At)")
				continue
			case ui.Mismatch:
				continue
			case actor.Stopped as s:
				return s
			case ui.BadPatch as p:
				return p
			}
			io.Console.Println(Shown(&h))
		case Stats:
			io.Console.Println("stats: \(ui.CountsLine(ui.Counts(&h)))")
		}
	}
	0
}

// Shown is the screen in lines, in screen order, each indented: the
// heading as # NAME; each field as LABEL<VALUE>, with its description
// after it in parentheses; each button as [LABEL] ([LABEL, disabled] in a
// disabled fieldset); a status as status{TEXT} and an alert as
// alert{TEXT}.
func Shown(h mut Host) string {
	let mut out = []string{}
	for t in tokens(ui.Screen(h), false, "") {
		out = out.Append("  " + t)
	}
	strings.Join(out, "\n")
}

func tokens(shapes []ui.Shape[subscribe.Signal], off bool, said string) []string {
	let mut out = []string{}
	for s in shapes {
		match s.Node {
		case ui.TextNode as t:
			out = out.Append(t.Value)
		case ui.InputNode as i:
			out = out.Append(if said == "" { "\(i.Placeholder)<\(i.Value)>" } else { "\(i.Placeholder)<\(i.Value)> (\(said))" })
		case ui.PressableNode as p:
			out = out.Append(if off { "[\(p.Label), disabled]" } else { "[\(p.Label)]" })
		case ui.FieldsetNode as fs:
			for t in tokens(s.Kids, off || fs.Disabled, if fs.Description == "" { said } else { fs.Description }) {
				out = out.Append(t)
			}
		case ui.SemanticNode as g:
			match g.Access.Role {
			case ui.Heading:
				out = out.Append("# \(g.Access.Name)")
			case ui.Status:
				out = out.Append("status{\(strings.Join(tokens(s.Kids, off, said), " "))}")
			case ui.Alert:
				out = out.Append("alert{\(strings.Join(tokens(s.Kids, off, said), " "))}")
			case _:
				for t in tokens(s.Kids, off, said) {
					out = out.Append(t)
				}
			}
		case _:
			for t in tokens(s.Kids, off, said) {
				out = out.Append(t)
			}
		}
	}
	out
}
