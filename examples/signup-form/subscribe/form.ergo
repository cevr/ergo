import machines

// Form is the state: the three fields and the stage of the submit.
type Form {
	Name  Field[Name, TooShort],
	Email Field[Email, EmailWhy],
	Note  string,
	Stage Stage,
}

// EditClearsThatFieldsError: outside a submit, an edit sets its field to
// the field its text gives, an earlier error included, and touches no
// other field and not the stage; during a submit it changes nothing.
law EditClearsThatFieldsError(f Form, k int, n int, generated string) {
	let text = textOf(n, generated)
	let next = machines.Next(f, Step(f, edit(k, text)))
	match f.Stage {
	case Sending:
		next == f
	case Editing, Sent, Refused:
		match edit(k, text) {
		case NameEdited:
			next == Form{..f, Name: NameField(text)}
		case EmailEdited:
			next == Form{..f, Email: EmailField(text)}
		case _:
			next == Form{..f, Note: text}
		}
	}
}

// edit is the edit of kind k (name, email or note) with text.
func edit(k int, text string) Signal {
	match ((k % 3) + 3) % 3 {
	case 0:
		NameEdited{Text: text}
	case 1:
		EmailEdited{Text: text}
	case _:
		NoteEdited{Text: text}
	}
}

// texts are drafts the laws type: an empty one, one byte, a name, a valid
// address, and a malformed one; and the generated text.
func textOf(n int, generated string) string {
	let texts = []string{"", "A", "Alice", "alice@example.com", "alice@example", generated}
	texts[((n%len(texts))+len(texts))%len(texts)]
}

// StaleCheckIsDropped: an edit of the email opens a new entry, so the
// entry that owns a check of an older address ends and the runner drops
// that check's answer (runtime.md, Machines and actors 12); an edit of
// the name or the note keeps the entry, so a check under way goes on. And
// an answer when no check is under way changes nothing: the old answer
// never arrives, so no address needs comparing with the field's.
law StaleCheckIsDropped(f Form, k int, text string, taken bool) {
	let d = Step(f, edit(k, text))
	let entry = match f.Stage {
	case Sending:
		d == Ignore
	case Editing, Sent, Refused:
		match edit(k, text) {
		case EmailEdited:
			d == Enter[Form]{Next: machines.Next(f, d)}
		case _:
			d == Stay[Form]{Next: machines.Next(f, d)}
		}
	}
	let stray = match f.Email.Verdict {
	case Checking[Email]:
		true
	case Unchecked, Valid[Email], Invalid[EmailWhy]:
		Step(f, Checked{Taken: taken}) == Ignore
	}
	entry && stray
}

// Stage is the submit: not sent yet, under way, taken (with the welcome
// text), or refused.
type Stage = Editing{} | Sending{} | Sent{Text string} | Refused{}

// Signal is what the form takes: an edit of each field and a submit from
// the user, the subscribers' answer to the email check, and the answer to
// the submit. JoinFailed is the submit's failure and also a signal.
type Signal = NameEdited{Text string} | EmailEdited{Text string} | NoteEdited{Text string} | Submitted{} | Checked{Taken bool} | Joined{} | JoinFailed

// Initial is the empty form.
func Initial() Form {
	Form{Name: NameField(""), Email: Field[Email, EmailWhy]{Text: "", Verdict: Unchecked}, Note: "", Stage: Editing}
}

// Step is the transition. While a submit is under way the form takes no
// edit and no submit. Else an edit of the name or the note checks that
// field and keeps the entry (Stay), so an email check under way goes on;
// an edit of the email checks it and opens a new entry (Enter), so a check
// of an older address ends and its answer is dropped by the runner. The
// check's answer settles a Checking email. A submit of a ready form starts
// the submit; of any other form it is ignored. The submit's answer
// settles the stage. An answer that no state waits for is ignored.
func Step(f Form, s Signal) Decision[Form, Never] {
	match (f.Stage, s) {
	case (Sending, NameEdited), (Sending, EmailEdited), (Sending, NoteEdited), (Sending, Submitted):
		Ignore
	case (_, NameEdited as e):
		Stay[Form]{Next: Form{..f, Name: NameField(e.Text)}}
	case (_, NoteEdited as e):
		Stay[Form]{Next: Form{..f, Note: e.Text}}
	case (_, EmailEdited as e):
		Enter[Form]{Next: Form{..f, Email: EmailField(e.Text)}}
	case (_, Checked as c):
		match f.Email.Verdict {
		case Checking[Email] as k:
			let v Verdict[Email, EmailWhy] = if c.Taken { Invalid[EmailWhy]{Why: Taken} } else { Valid[Email]{Value: k.Value} }
			Enter[Form]{Next: Form{..f, Email: Field[Email, EmailWhy]{Text: f.Email.Text, Verdict: v}}}
		case _:
			Ignore
		}
	case (_, Submitted):
		if Ready(f) {
			Enter[Form]{Next: Form{..f, Stage: Sending}}
		} else {
			Ignore
		}
	case (Sending, Joined):
		Enter[Form]{Next: Form{..f, Stage: Sent{Text: Welcome(f.Name.Text)}}}
	case (Sending, JoinFailed):
		Enter[Form]{Next: Form{..f, Stage: Refused}}
	case (_, Joined), (_, JoinFailed):
		Ignore
	}
}

// SubmitOnlyWhenAllValid: a submit starts only from a form that is not
// sending, whose name is valid or empty and whose email has passed its
// check; any other submit is ignored.
law SubmitOnlyWhenAllValid(n int, name string, e int, email string, settled bool, taken bool, stage int) {
	let f = formOf(textOf(n, name), textOf(e, email), settled, taken, stage)
	let nameOK = f.Name.Text == "" || len(f.Name.Text) >= 2
	let emailOK = settled && !taken && !malformed(f.Email.Text) && f.Email.Text != ""
	let sending = ((stage%4)+4)%4 == 1
	let d = Step(f, Submitted)
	if !sending && nameOK && emailOK {
		d == Enter[Form]{Next: Form{..f, Stage: Sending}}
	} else {
		d == Ignore
	}
}

// formOf is a form the user can reach: the fields its texts give, the
// email's check answered (taken or not) when settled, and a stage.
func formOf(name string, email string, settled bool, taken bool, stage int) Form {
	let mut f = Form{..Initial(), Name: NameField(name), Email: EmailField(email)}
	if settled {
		f = machines.Next(f, Step(f, Checked{Taken: taken}))
	}
	let stages = []Stage{Editing, Sending, Sent{Text: Welcome(name)}, Refused}
	Form{..f, Stage: stages[((stage%4)+4)%4]}
}

func malformed(text string) bool {
	let _ = ParseEmail(text) catch {
	case Unsatisfied:
		return true
	}
	false
}

// Ready reports whether f may be sent: the name is valid or left empty,
// and the email is valid (its check has answered that it is not taken).
func Ready(f Form) bool {
	let name = match f.Name.Verdict {
	case Unchecked, Valid[Name]:
		true
	case Checking[Name], Invalid[TooShort]:
		false
	}
	let email = match f.Email.Verdict {
	case Valid[Email]:
		true
	case Unchecked, Checking[Email], Invalid[EmailWhy]:
		false
	}
	name && email
}

// Welcome is the text of a taken subscription.
func Welcome(name string) string {
	let who = if name == "" { "" } else { ", " + name }
	"Welcome to the release notes\(who)! The next notes arrive with the next release."
}

// work is the work of each state: a submit under way sends the subscription;
// else a Checking email asks the subscribers. The runner starts it when
// the entry opens and interrupts it when the entry ends.
func work(f Form) Option[machines.Work[Signal, Subscribers]] {
	match (f.Stage, f.Email.Verdict) {
	case (Sending, Valid[Email] as v):
		let s = Subscription{Name: f.Name.Text, Email: v.Value, Note: f.Note}
		Some{machines.Attempt(func() Signal fails JoinFailed needs Subscribers {
			try Subscribers.Join(s)
			Joined
		}, func(joined Signal) Signal { joined }, func(failure) {
			let failed Signal = failure
			failed
		})}
	case (Sending, _):
		None
	case (_, Checking[Email] as k):
		Some{machines.Do(func() Signal needs Subscribers { Checked{Taken: Subscribers.Taken(k.Value)} })}
	case (_, _):
		None
	}
}

// Subscribing is the form as a machine: its work is the check and the submit.
type Subscribing machine[Form, Signal] { initial: Initial(), step: Step, work: work }

// Busy reports whether f waits for an answer: a check or a submit.
func Busy(f Form) bool {
	match (f.Stage, f.Email.Verdict) {
	case (Sending, _):
		true
	case (_, Checking[Email]):
		true
	case (_, _):
		false
	}
}
