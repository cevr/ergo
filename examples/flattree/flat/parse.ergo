import flattree/dense
import flattree/tree
import slices
import strconv
import strings

// reader is the tree being built and the place in its text. A container
// gathers each child's returned id and puts those ids in its pool when
// it closes.
type reader {
	t     rows,
	pos   int,
	depth int,
}

// Parse is the flat tree of the JSON text src. It fails where tree.Parse
// fails, with the same failure.
func Parse(src string) Tree fails tree.Malformed {
	let mut r = reader{t: empty(src), pos: 0, depth: 0}
	skip(&r)
	let root = try value(&r)
	skip(&r)
	if r.pos < len(src) {
		return tree.Locate(src, r.pos, "expected the end, found "+found(r))
	}
	Tree{data: r.t, root: root}
}

// FlatEqualsTree: for the samples of seed, both printed forms read flat
// are the value tree reads, with its stats.
law FlatEqualsTree(seed int) {
	for v in tree.Samples(seed) {
		for form in []string{tree.Compact(v), tree.Indent(v)} {
			let t = Parse(form) catch {
			case tree.Malformed:
				return false
			}
			let want = tree.Parse(form) catch {
			case tree.Malformed:
				return false
			}
			if !tree.Equal(ToTree(t, Root(t)), want) || tree.Text(StatsOf(t)) != tree.Text(tree.StatsOf(want)) {
				return false
			}
		}
	}
	true
}

// FailsWhereTheTreeFails: a sample's text with the byte at at replaced
// by c reads flat as it reads into a tree: the same failure at the same
// place, or the same value.
law FailsWhereTheTreeFails(seed int, at int, c byte) {
	for v in tree.Samples(seed) {
		let text = tree.Compact(v)
		let k = if at < 0 { -at % (len(text) + 1) } else { at % (len(text) + 1) }
		let mut b = strings.NewBuilder()
		b.WriteString(strings.Slice(text, 0, k))
		b.WriteByte(c)
		b.WriteString(strings.Slice(text, if k < len(text) { k + 1 } else { k }, len(text)))
		let broken = b.String()
		let want = tree.Parse(broken) catch {
		case tree.Malformed as m:
			let _ = Parse(broken) catch {
			case tree.Malformed as f:
				if f != m {
					return false
				}
				continue
			}
			return false
		}
		let t = Parse(broken) catch {
		case tree.Malformed:
			return false
		}
		if !tree.Equal(ToTree(t, Root(t)), want) {
			return false
		}
	}
	true
}

// PrintRoundTrips: a flat tree printed in either form reads back as the
// same tree.
law PrintRoundTrips(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Compact(v)) catch {
		case tree.Malformed:
			return false
		}
		let value = ToTree(t, Root(t))
		for form in []string{Compact(t, Root(t)), Indent(t, Root(t))} {
			let back = Parse(form) catch {
			case tree.Malformed:
				return false
			}
			if !tree.Equal(ToTree(back, Root(back)), value) {
				return false
			}
		}
	}
	true
}

// PointersReachTheTreesPlaces: each place of a sample, got flat by its
// pointer, prints as the place.
law PointersReachTheTreesPlaces(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Compact(v)) catch {
		case tree.Malformed:
			return false
		}
		for p in tree.Places(v) {
			let id = Get(t, p.Pointer) catch {
			case tree.BadPointer, tree.NoValue:
				return false
			}
			if Compact(t, id) != tree.Compact(p.At) {
				return false
			}
		}
	}
	true
}

// ChildrenStayInside: every item and member of a container is a value
// put before it, so its id is less than the container's, and the
// containers' runs together cover their pools once, in order.
law ChildrenStayInside(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Indent(v)) catch {
		case tree.Malformed:
			return false
		}
		let mut items = 0
		let mut members = 0
		for i in 0..Size(t) {
			let id = dense.IDAt(t.data.ids, i)
			match ViewOf(t, id) {
			case Array as a:
				items += len(a.Items)
				for x in a.Items {
					if dense.Index(x) >= i {
						return false
					}
				}
			case Object as o:
				members += len(o.Members)
				for m in o.Members {
					if dense.Index(m.Value) >= i {
						return false
					}
				}
			case Null, Bool, Number, Str:
			}
		}
		if items != dense.Items(t.data.items) || members != dense.Items(t.data.members) || dense.Index(Root(t)) != Size(t)-1 {
			return false
		}
	}
	true
}

// KeysAreInterned: two members of a document have one key id exactly
// when their keys are one text.
law KeysAreInterned(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Compact(v)) catch {
		case tree.Malformed:
			return false
		}
		let mut all = []Member{}
		for i in 0..Size(t) {
			match ViewOf(t, dense.IDAt(t.data.ids, i)) {
			case Object as o:
				for m in o.Members {
					all = all.Append(m)
				}
			case Null, Bool, Array, Number, Str:
			}
		}
		for x in all {
			for y in all {
				if (x.Key == y.Key) != (KeyText(t, x.Key) == KeyText(t, y.Key)) {
					return false
				}
			}
		}
	}
	true
}

func found(r reader) string {
	if r.pos >= len(r.t.src) {
		return "the end"
	}
	strconv.Quote(strings.Slice(r.t.src, r.pos, r.pos+1))
}

func skip(r mut reader) {
	let src = r.t.src
	for r.pos < len(src) {
		let c = src[r.pos]
		if c != ' ' && c != '\n' && c != '\t' && c != '\r' {
			return
		}
		r.pos += 1
	}
}

func value(r mut reader) dense.ID[Node] fails tree.Malformed {
	let src = r.t.src
	if r.pos >= len(src) {
		return tree.Locate(src, r.pos, "expected a value, found the end")
	}
	let c = src[r.pos]
	if c == '{' {
		try object(r)
	} else if c == '[' {
		try array(r)
	} else if c == '"' {
		try str(r)
	} else if c == 't' {
		try word(r, "true", kTrue)
	} else if c == 'f' {
		try word(r, "false", kFalse)
	} else if c == 'n' {
		try word(r, "null", kNull)
	} else if c == '-' || (c >= '0' && c <= '9') {
		try numeral(r)
	} else {
		return tree.Locate(src, r.pos, "expected a value, found "+found(*r))
	}
}

func word(r mut reader, w string, kind uint8) dense.ID[Node] fails tree.Malformed {
	let src = r.t.src
	for k in 0..len(w) {
		if r.pos >= len(src) || src[r.pos] != w[k] {
			return tree.Locate(src, r.pos, "expected \(w), found "+found(*r))
		}
		r.pos += 1
	}
	put(&r.t, cell{kind: kind, a: 0, b: 0})
}

// numeral reads a number with tree's machine and keeps its span.
func numeral(r mut reader) dense.ID[Node] fails tree.Malformed {
	let start = r.pos
	let (n, broken) = tree.Scan(strings.Slice(r.t.src, start, len(r.t.src)))
	match broken {
	case Some[string] as why:
		return tree.Locate(r.t.src, start+n, why.Value)
	case None:
		r.pos = start + n
		put(&r.t, cell{kind: kNumber, a: uint32(start), b: uint32(n)})
	}
}

// text reads a string literal: a span of the source when it has no
// escape and only ASCII, else tree's decoding, interned. It is the row
// the string has, or the first malformed byte.
func text(r mut reader) cell fails tree.Malformed {
	let src = r.t.src
	let start = r.pos + 1
	let mut i = start
	for i < len(src) {
		let c = src[i]
		if c == '"' {
			r.pos = i + 1
			return cell{kind: kSpan, a: uint32(start), b: uint32(i - start)}
		}
		if c == '\\' || c < 0x20 || c >= 0x80 {
			break
		}
		i += 1
	}
	let d = try tree.ReadString(src, r.pos)
	r.pos = d.End
	let k = intern(&r.t, d.Text)
	cell{kind: kText, a: uint32(dense.Index(k)), b: 0}
}

func str(r mut reader) dense.ID[Node] fails tree.Malformed {
	let row = try text(r)
	put(&r.t, row)
}

// key reads a member's key and is its interned id.
func key(r mut reader) dense.ID[Key] fails tree.Malformed {
	let row = try text(r)
	if row.kind == kText {
		return dense.IDOf(r.t.keys.texts, int(row.a))
	}
	let s = strings.Slice(r.t.src, int(row.a), int(row.a)+int(row.b))
	intern(&r.t, s)
}

// enter opens a container: one level deeper, at most tree.MaxDepth.
func enter(r mut reader) fails tree.Malformed {
	r.depth += 1
	if r.depth > tree.MaxDepth {
		return tree.Locate(r.t.src, r.pos, "nesting deeper than \(tree.MaxDepth)")
	}
	r.pos += 1
	skip(r)
}

func array(r mut reader) dense.ID[Node] fails tree.Malformed {
	try enter(r)
	let src = r.t.src
	// Room for a typical container's children: gathering them grows no
	// slice. (dense.Stack with marks, a scratch stack shared by every
	// container as the control has, comes with std dense.)
	let mut items = slices.WithCapacity[dense.ID[Node]](8)
	if r.pos < len(src) && src[r.pos] == ']' {
		r.pos += 1
		r.depth -= 1
		return putArray(&r.t, []dense.ID[Node]{})
	}
	for {
		let id = try value(r)
		items = items.Append(id)
		skip(r)
		if r.pos < len(src) {
			let c = src[r.pos]
			if c == ',' {
				r.pos += 1
				skip(r)
				continue
			}
			if c == ']' {
				r.pos += 1
				r.depth -= 1
				return putArray(&r.t, items)
			}
		}
		return tree.Locate(src, r.pos, "expected ',' or ']', found "+found(*r))
	}
}

func object(r mut reader) dense.ID[Node] fails tree.Malformed {
	try enter(r)
	let src = r.t.src
	// Room for a typical object's members, as array's items.
	let mut members = slices.WithCapacity[Member](8)
	if r.pos < len(src) && src[r.pos] == '}' {
		r.pos += 1
		r.depth -= 1
		return putObject(&r.t, []Member{})
	}
	for {
		if r.pos >= len(src) || src[r.pos] != '"' {
			return tree.Locate(src, r.pos, "expected a string key, found "+found(*r))
		}
		let k = try key(r)
		skip(r)
		if r.pos >= len(src) || src[r.pos] != ':' {
			return tree.Locate(src, r.pos, "expected ':', found "+found(*r))
		}
		r.pos += 1
		skip(r)
		let id = try value(r)
		members = members.Append(Member{Key: k, Value: id})
		skip(r)
		if r.pos < len(src) {
			let c = src[r.pos]
			if c == ',' {
				r.pos += 1
				skip(r)
				continue
			}
			if c == '}' {
				r.pos += 1
				r.depth -= 1
				return putObject(&r.t, members)
			}
		}
		return tree.Locate(src, r.pos, "expected ',' or '}', found "+found(*r))
	}
}
