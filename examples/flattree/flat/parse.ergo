import flattree/dense
import flattree/tree
import slices
import strconv
import strings

// reader is the tree being read and the place in its text. Parse owns
// it. A value it reads leaves its id in last; a container gathers its
// children's ids as they come and puts them in its pool when it closes.
// A problem is a row of problems, and every rule stops at the first one.
type reader {
	t        Tree,
	pos      int,
	depth    int,
	last     dense.Opt[Node],
	problems dense.Table[tree.Malformed],
}

// Parse is the flat tree of the JSON text src. It fails where tree.Parse
// fails, with the same failure: the first row of its problems.
func Parse(src string) Tree fails tree.Malformed {
	let mut r = reader{t: Empty(src), pos: 0, depth: 0, last: dense.NoID[Node](), problems: dense.New[tree.Malformed]()}
	skip(&r)
	value(&r)
	if ok(r) {
		skip(&r)
		if r.pos < len(src) {
			problem(&r, r.pos, "expected the end, found "+found(r))
		}
	}
	if !ok(r) {
		return dense.At(r.problems, dense.IDOf(r.problems, 0))
	}
	r.t
}

// FlatEqualsTree: for the samples of seed, both printed forms read flat
// are the value tree reads, with its stats.
law FlatEqualsTree(seed int) {
	for v in tree.Samples(seed) {
		for form in []string{tree.Compact(v), tree.Indent(v)} {
			let t = Parse(form) catch {
			case tree.Malformed:
				return false
			}
			let want = tree.Parse(form) catch {
			case tree.Malformed:
				return false
			}
			if !tree.Equal(ToTree(t, Root(t)), want) || tree.Text(StatsOf(t)) != tree.Text(tree.StatsOf(want)) {
				return false
			}
		}
	}
	true
}

// FailsWhereTheTreeFails: a sample's text with the byte at at replaced
// by c reads flat as it reads into a tree: the same failure at the same
// place, or the same value.
law FailsWhereTheTreeFails(seed int, at int, c byte) {
	for v in tree.Samples(seed) {
		let text = tree.Compact(v)
		let k = if at < 0 { -at % (len(text) + 1) } else { at % (len(text) + 1) }
		let mut b = strings.NewBuilder()
		b.WriteString(strings.Slice(text, 0, k))
		b.WriteByte(c)
		b.WriteString(strings.Slice(text, if k < len(text) { k + 1 } else { k }, len(text)))
		let broken = b.String()
		let want = tree.Parse(broken) catch {
		case tree.Malformed as m:
			let _ = Parse(broken) catch {
			case tree.Malformed as f:
				if f != m {
					return false
				}
				continue
			}
			return false
		}
		let t = Parse(broken) catch {
		case tree.Malformed:
			return false
		}
		if !tree.Equal(ToTree(t, Root(t)), want) {
			return false
		}
	}
	true
}

// PrintRoundTrips: a flat tree printed in either form reads back as the
// same tree.
law PrintRoundTrips(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Compact(v)) catch {
		case tree.Malformed:
			return false
		}
		let value = ToTree(t, Root(t))
		for form in []string{Compact(t, Root(t)), Indent(t, Root(t))} {
			let back = Parse(form) catch {
			case tree.Malformed:
				return false
			}
			if !tree.Equal(ToTree(back, Root(back)), value) {
				return false
			}
		}
	}
	true
}

// PointersReachTheTreesPlaces: each place of a sample, got flat by its
// pointer, prints as the place.
law PointersReachTheTreesPlaces(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Compact(v)) catch {
		case tree.Malformed:
			return false
		}
		for p in tree.Places(v) {
			let id = Get(t, p.Pointer) catch {
			case tree.BadPointer, tree.NoValue:
				return false
			}
			if Compact(t, id) != tree.Compact(p.At) {
				return false
			}
		}
	}
	true
}

// ChildrenStayInside: every item and member of a container is a value
// put before it, so its id is less than the container's, and the
// containers' runs together cover their pools once, in order.
law ChildrenStayInside(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Indent(v)) catch {
		case tree.Malformed:
			return false
		}
		let mut items = 0
		let mut members = 0
		for i in 0..Size(t) {
			let id = dense.IDAt(t.ids, i)
			match ViewOf(t, id) {
			case Array as a:
				items += len(a.Items)
				for x in a.Items {
					if dense.Index(x) >= i {
						return false
					}
				}
			case Object as o:
				members += len(o.Members)
				for m in o.Members {
					if dense.Index(m.Value) >= i {
						return false
					}
				}
			case Null, Bool, Number, Str:
			}
		}
		if items != dense.Items(t.items) || members != dense.Items(t.members) || dense.Index(Root(t)) != Size(t)-1 {
			return false
		}
	}
	true
}

// KeysAreInterned: two members of a document have one key id exactly
// when their keys are one text.
law KeysAreInterned(seed int) {
	for v in tree.Samples(seed) {
		let t = Parse(tree.Compact(v)) catch {
		case tree.Malformed:
			return false
		}
		let mut all = []Member{}
		for i in 0..Size(t) {
			match ViewOf(t, dense.IDAt(t.ids, i)) {
			case Object as o:
				for m in o.Members {
					all = all.Append(m)
				}
			case Null, Bool, Array, Number, Str:
			}
		}
		for x in all {
			for y in all {
				if (x.Key == y.Key) != (KeyText(t, x.Key) == KeyText(t, y.Key)) {
					return false
				}
			}
		}
	}
	true
}

func ok(r reader) bool { dense.Len(r.problems) == 0 }

func problem(r mut reader, at int, reason string) {
	let _ = dense.Put(&r.problems, tree.Locate(r.t.src, at, reason))
}

func found(r reader) string {
	if r.pos >= len(r.t.src) {
		return "the end"
	}
	strconv.Quote(strings.Slice(r.t.src, r.pos, r.pos+1))
}

func skip(r mut reader) {
	let src = r.t.src
	for r.pos < len(src) {
		let c = src[r.pos]
		if c != ' ' && c != '\n' && c != '\t' && c != '\r' {
			return
		}
		r.pos += 1
	}
}

// push leaves id as the value read last.
func push(r mut reader, id dense.ID[Node]) { r.last = dense.OptOf(id) }

// last is the id of the value read last; value leaves one when it reads
// one, and a caller asks only then.
func last(r reader) dense.ID[Node] {
	match dense.Unpack(r.last) {
	case Some[dense.ID[Node]] as id:
		id.Value
	case None:
		Unreachable("flat: no value was read")
	}
}

func value(r mut reader) {
	let src = r.t.src
	if r.pos >= len(src) {
		problem(r, r.pos, "expected a value, found the end")
		return
	}
	let c = src[r.pos]
	if c == '{' {
		object(r)
	} else if c == '[' {
		array(r)
	} else if c == '"' {
		str(r)
	} else if c == 't' {
		word(r, "true", kTrue)
	} else if c == 'f' {
		word(r, "false", kFalse)
	} else if c == 'n' {
		word(r, "null", kNull)
	} else if c == '-' || (c >= '0' && c <= '9') {
		numeral(r)
	} else {
		problem(r, r.pos, "expected a value, found "+found(*r))
	}
}

func word(r mut reader, w string, kind uint8) {
	let src = r.t.src
	for k in 0..len(w) {
		if r.pos >= len(src) || src[r.pos] != w[k] {
			problem(r, r.pos, "expected \(w), found "+found(*r))
			return
		}
		r.pos += 1
	}
	push(r, put(&r.t, cell{kind: kind, a: 0, b: 0}))
}

// numeral reads a number with tree's machine and keeps its span.
func numeral(r mut reader) {
	let start = r.pos
	let (n, broken) = tree.Scan(strings.Slice(r.t.src, start, len(r.t.src)))
	match broken {
	case Some[string] as why:
		problem(r, start+n, why.Value)
	case None:
		r.pos = start + n
		push(r, put(&r.t, cell{kind: kNumber, a: uint32(start), b: uint32(n)}))
	}
}

// text reads a string literal: a span of the source when it has no
// escape and only ASCII, else tree's decoding, interned. It is the row
// the string would have and whether it read one.
func text(r mut reader) Option[cell] {
	let src = r.t.src
	let start = r.pos + 1
	let mut i = start
	for i < len(src) {
		let c = src[i]
		if c == '"' {
			r.pos = i + 1
			return Some[cell]{Value: cell{kind: kSpan, a: uint32(start), b: uint32(i - start)}}
		}
		if c == '\\' || c < 0x20 || c >= 0x80 {
			break
		}
		i += 1
	}
	let d = tree.ReadString(src, r.pos) catch {
	case tree.Malformed as m:
		let _ = dense.Put(&r.problems, m)
		return None
	}
	r.pos = d.End
	let k = Intern(&r.t, d.Text)
	Some[cell]{Value: cell{kind: kText, a: uint32(dense.Index(k)), b: 0}}
}

func str(r mut reader) {
	match text(r) {
	case Some[cell] as row:
		push(r, put(&r.t, row.Value))
	case None:
	}
}

// key reads a member's key and is its interned id.
func key(r mut reader) Option[dense.ID[Key]] {
	match text(r) {
	case Some[cell] as row:
		if row.Value.kind == kText {
			return Some[dense.ID[Key]]{Value: dense.IDOf(r.t.keys.texts, int(row.Value.a))}
		}
		let s = strings.Slice(r.t.src, int(row.Value.a), int(row.Value.a)+int(row.Value.b))
		Some[dense.ID[Key]]{Value: Intern(&r.t, s)}
	case None:
		None
	}
}

// enter opens a container: one level deeper, at most tree.MaxDepth.
func enter(r mut reader) bool {
	r.depth += 1
	if r.depth > tree.MaxDepth {
		problem(r, r.pos, "nesting deeper than \(tree.MaxDepth)")
		return false
	}
	r.pos += 1
	skip(r)
	true
}

func array(r mut reader) {
	if !enter(r) {
		return
	}
	let src = r.t.src
	// Room for a typical container's children: gathering them grows no
	// slice. (dense.Stack with marks, a scratch stack shared by every
	// container as the control has, comes with std dense.)
	let mut items = slices.WithCapacity[dense.ID[Node]](8)
	if r.pos < len(src) && src[r.pos] == ']' {
		r.pos += 1
		r.depth -= 1
		push(r, putArray(&r.t, []dense.ID[Node]{}))
		return
	}
	for {
		value(r)
		if !ok(*r) {
			return
		}
		items = items.Append(last(*r))
		skip(r)
		if r.pos < len(src) {
			let c = src[r.pos]
			if c == ',' {
				r.pos += 1
				skip(r)
				continue
			}
			if c == ']' {
				r.pos += 1
				r.depth -= 1
				push(r, putArray(&r.t, items))
				return
			}
		}
		problem(r, r.pos, "expected ',' or ']', found "+found(*r))
		return
	}
}

func object(r mut reader) {
	if !enter(r) {
		return
	}
	let src = r.t.src
	// Room for a typical object's members, as array's items.
	let mut members = slices.WithCapacity[Member](8)
	if r.pos < len(src) && src[r.pos] == '}' {
		r.pos += 1
		r.depth -= 1
		push(r, putObject(&r.t, []Member{}))
		return
	}
	for {
		if r.pos >= len(src) || src[r.pos] != '"' {
			problem(r, r.pos, "expected a string key, found "+found(*r))
			return
		}
		let k = match key(r) {
		case Some[dense.ID[Key]] as k:
			k.Value
		case None:
			return
		}
		skip(r)
		if r.pos >= len(src) || src[r.pos] != ':' {
			problem(r, r.pos, "expected ':', found "+found(*r))
			return
		}
		r.pos += 1
		skip(r)
		value(r)
		if !ok(*r) {
			return
		}
		members = members.Append(Member{Key: k, Value: last(*r)})
		skip(r)
		if r.pos < len(src) {
			let c = src[r.pos]
			if c == ',' {
				r.pos += 1
				skip(r)
				continue
			}
			if c == '}' {
				r.pos += 1
				r.depth -= 1
				push(r, putObject(&r.t, members))
				return
			}
		}
		problem(r, r.pos, "expected ',' or '}', found "+found(*r))
		return
	}
}
