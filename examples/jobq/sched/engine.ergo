// Package sched runs a job queue on a virtual clock: a fixed number of
// workers take jobs in the order they became ready, each start takes a
// token from the rate limiter, and a failed try waits its backoff before
// it queues again. Time moves only from one event to the next, so a run
// of a thousand jobs over an hour of virtual time takes milliseconds, and
// a run replays exactly. It is pure, except that each try's result comes
// from the jobs.Worker contract.

import jobq/jobs
import jobq/limit
import option

// Config is a queue's shape: its workers, its retry policy and its rate,
// Burst starts at once and then one each Every.
type Config { Workers int, Policy jobs.Policy, Burst int, Every duration }

// StartsKeepTheRate: in any window from one start to another, the starts
// are at most Burst, and one more for each token that can arrive in it
// (limit.RateHolds).
law StartsKeepTheRate(c int, ns []int) {
	let s = Shape(c)
	if s.Every <= 0s {
		return true
	}
	let got = starts(Ran(c, ns))
	for i, a in got {
		for j in i..got.Len() {
			if int64(j-i+1) > int64(s.Burst)+int64(got[j]-a)/int64(s.Every)+1 {
				return false
			}
		}
	}
	true
}

// starts is the times of the Started events of es.
func starts(es []Event) []duration {
	let mut out = []duration{}
	for e in es {
		match e {
		case Started as s:
			out = out.Append(s.At)
		case Succeeded:
		case GaveUp:
		case Retrying:
		}
	}
	out
}

// Event is what happened in a run, at a time on the virtual clock.
type Event = Started{At duration, ID int, N int, Worker int} | Succeeded{At duration, ID int, N int} | Retrying{At duration, ID int, N int, Until duration} | GaveUp{At duration, ID int, N int, Why string}

// NoJobLost: every job ends exactly once, as a success or a give-up.
law NoJobLost(c int, ns []int) {
	let ends = Ends(Ran(c, ns))
	for i in 1..ns.Len()+1 {
		if count(ends, i) != 1 {
			return false
		}
	}
	ends.Len() == ns.Len()
}

// Load is the jobs of ns: each n gives a job of 0 to 500ms that fails 0
// to 3 times, and one in seven fails for good after that.
func Load(ns []int) []jobs.Job {
	let mut out = []jobs.Job{}
	for i, n in ns {
		let k = if n < 0 { -(n % 1000003) } else { n % 1000003 }
		out = out.Append(jobs.Job{ID: i + 1, Name: "job\(i + 1)", Takes: duration(int64(k%501) * int64(1ms)), Flaky: k % 4, Fatal: k%7 == 0})
	}
	out
}

// Shape is a Config of 1 to 4 workers, 1 to 4 attempts, a backoff of
// 50ms to 400ms, and a rate of a burst of 1 to 3 and one each 0 to 200ms,
// from c.
func Shape(c int) Config {
	let k = if c < 0 { -(c % 1000003) } else { c % 1000003 }
	Config{Workers: 1 + k%4, Policy: jobs.Policy{Attempts: 1 + k/4%4, Base: 50ms, Max: 400ms}, Burst: 1 + k/16%3, Every: duration(int64(k/48%5) * int64(50ms))}
}

// Ran is the events of a run of Load(ns) under Shape(c) on the script.
func Ran(c int, ns []int) []Event {
	with context { jobs.Worker: jobs.Script } { Run(Shape(c), Load(ns)) }
}

// Ends is how many terminal events (Succeeded or GaveUp) each job ID of
// es has, by ID.
func Ends(es []Event) Map[int, int] {
	let mut ends = Map[int, int]{}
	for e in es {
		match e {
		case Succeeded as s:
			ends[s.ID] = 1 + count(ends, s.ID)
		case GaveUp as g:
			ends[g.ID] = 1 + count(ends, g.ID)
		case Started:
		case Retrying:
		}
	}
	ends
}

// count is m[k], or 0.
func count(m Map[int, int], k int) int {
	match m.Get(k) {
	case option.Some[int] as v:
		v.Value
	case option.None:
		0
	}
}

// AtMostNInFlight: no more than Workers jobs run at once, and a worker
// runs one job at a time.
law AtMostNInFlight(c int, ns []int) {
	let n = InFlight(Ran(c, ns), Shape(c).Workers)
	n >= 0 && n <= Shape(c).Workers
}

// InFlight is the most jobs running at once in es, or -1 when a worker
// outside 1 to n starts a job or starts one while it runs another.
func InFlight(es []Event, n int) int {
	let mut on = Map[int, int]{}
	let mut most = 0
	for e in es {
		match e {
		case Started as s:
			if s.Worker < 1 || s.Worker > n || count(on, s.Worker) != 0 {
				return -1
			}
			on[s.Worker] = s.ID
			if on.Len() > most {
				most = on.Len()
			}
		case Succeeded as s:
			on = drop(on, s.ID)
		case GaveUp as g:
			on = drop(on, g.ID)
		case Retrying as r:
			on = drop(on, r.ID)
		}
	}
	most
}

// drop is m without the worker that runs id.
func drop(m Map[int, int], id int) Map[int, int] {
	let mut out = Map[int, int]{}
	for w, j in m {
		if j != id {
			out[w] = j
		}
	}
	out
}

// State is a job's place in a run: alive in its life machine, on a
// worker when it runs (worker 0 when not), or over.
type State = Live{P jobs.Phase, Worker int} | Over{O jobs.Outcome}

// Entry is one job of a run and its state.
type Entry { Job jobs.Job, S State }

// AtOf is the time of e.
func AtOf(e Event) duration {
	match e {
	case Started as s:
		s.At
	case Succeeded as s:
		s.At
	case Retrying as r:
		r.At
	case GaveUp as g:
		g.At
	}
}

// RetriesWait: a job's next try starts no sooner than the Until of its
// Retrying, and the times of the events never go back.
law RetriesWait(c int, ns []int) {
	let mut until = Map[int, duration]{}
	let mut last = 0s
	for e in Ran(c, ns) {
		if AtOf(e) < last {
			return false
		}
		last = AtOf(e)
		match e {
		case Retrying as r:
			until[r.ID] = r.Until
		case Started as s:
			match until.Get(s.ID) {
			case option.Some[duration] as u:
				if s.At < u.Value {
					return false
				}
			case option.None:
			}
		case Succeeded:
		case GaveUp:
		}
	}
	true
}

// busy reports whether worker w runs a job of es.
func busy(es []Entry, w int) bool {
	for e in es {
		match e.S {
		case Live as l:
			if l.Worker == w {
				return true
			}
		case Over:
		}
	}
	false
}

// free is the lowest worker of 1 to n that runs nothing, or 0.
func free(es []Entry, n int) int {
	for w in 1..n+1 {
		if !busy(es, w) {
			return w
		}
	}
	0
}

// ready is the place in es of the queued job that has waited longest at
// now (the lowest Ready, then the lowest place), or -1.
func ready(es []Entry, now duration) int {
	let mut best = -1
	let mut at = now
	for i, e in es {
		match e.S {
		case Live as l:
			match l.P {
			case jobs.Queued as q:
				if q.Ready <= now && (best < 0 || q.Ready < at) {
					best = i
					at = q.Ready
				}
			case jobs.Running:
			}
		case Over:
		}
	}
	best
}

// replaced is es with the entry at i replaced by e, in a new slice.
func replaced(es []Entry, i int, e Entry) []Entry {
	let mut out = []Entry{}
	for k, old in es {
		out = out.Append(if k == i { e } else { old })
	}
	out
}

// finish ends every try of es that ends at or before now, in the order of
// es, and is the entries after and the events.
func finish(es []Entry, now duration, p jobs.Policy) ([]Entry, []Event) needs jobs.Worker {
	let mut out = es
	let mut log = []Event{}
	for i, e in es {
		match e.S {
		case Over:
		case Live as l:
			match l.P {
			case jobs.Queued:
			case jobs.Running as r:
				if r.Ends <= now {
					let res = jobs.Worker.Do(e.Job, r.N)
					let step = jobs.FinishJob(r, now, res, p) catch {
					case jobs.TooEarly:
						continue
					}
					match step {
					case jobs.Finished as d:
						out = replaced(out, i, Entry{..e, S: Over{O: d.Output}})
						log = log.Append(ended(e.Job.ID, d.Output))
					case jobs.Retry as rt:
						out = replaced(out, i, Entry{..e, S: Live{P: rt.Next, Worker: 0}})
						log = log.Append(Retrying{At: now, ID: e.Job.ID, N: r.N, Until: rt.Next.Ready})
					}
				}
			}
		}
	}
	(out, log)
}

// ended is the event of a job's outcome.
func ended(id int, o jobs.Outcome) Event {
	match o {
	case jobs.Succeeded as s:
		Succeeded{At: s.At, ID: id, N: s.N}
	case jobs.GaveUp as g:
		GaveUp{At: g.At, ID: id, N: g.N, Why: g.Why}
	}
}

// start puts ready jobs of es on free workers at now while the bucket has
// tokens, and is the entries, the bucket and the events.
func start(es []Entry, now duration, workers int, b limit.Bucket) ([]Entry, limit.Bucket, []Event) {
	let mut out = es
	let mut bucket = b
	let mut log = []Event{}
	for {
		let w = free(out, workers)
		let i = ready(out, now)
		if w == 0 || i < 0 {
			break
		}
		let taken = match limit.Take(bucket, now) {
		case option.Some[limit.Bucket] as t:
			t.Value
		case option.None:
			break
		}
		bucket = taken
		let e = out[i]
		match e.S {
		case Live as l:
			match l.P {
			case jobs.Queued as q:
				let running = jobs.StartJob(q, now, e.Job.Takes) catch {
				case jobs.TooEarly:
					break
				}
				out = replaced(out, i, Entry{..e, S: Live{P: running, Worker: w}})
				log = log.Append(Started{At: now, ID: e.Job.ID, N: running.N, Worker: w})
			case jobs.Running:
				break
			}
		case Over:
			break
		}
	}
	(out, bucket, log)
}

// next is the time of the next event after now: the first try to end,
// the first job to become ready, or, when a job is ready and a worker is
// free but the bucket is empty, the bucket's next token. None when every
// job is over.
func next(es []Entry, now duration, workers int, b limit.Bucket) option.Option[duration] {
	let mut best option.Option[duration] = option.None
	for e in es {
		match e.S {
		case Over:
		case Live as l:
			match l.P {
			case jobs.Running as r:
				// a try of no time ends now, in the next round
				if r.Ends >= now {
					best = earlier(best, r.Ends)
				}
			case jobs.Queued as q:
				let t = if q.Ready > now { q.Ready } else if free(es, workers) > 0 { limit.NextAt(b, now) } else { now }
				if t > now {
					best = earlier(best, t)
				}
			}
		}
	}
	best
}

// earlier is the earlier of o and t.
func earlier(o option.Option[duration], t duration) option.Option[duration] {
	match o {
	case option.Some[duration] as s:
		if s.Value <= t { o } else { option.Some[duration]{Value: t} }
	case option.None:
		option.Some[duration]{Value: t}
	}
}

// Run is the events of a run of js under c, from time 0, until every job
// is over.
func Run(c Config, js []jobs.Job) []Event needs jobs.Worker {
	let mut es = []Entry{}
	for j in js {
		es = es.Append(Entry{Job: j, S: Live{P: jobs.Fresh(0s), Worker: 0}})
	}
	let workers = if c.Workers < 1 { 1 } else { c.Workers }
	let mut bucket = limit.Full(c.Burst, c.Every, 0s)
	let mut now = 0s
	let mut log = []Event{}
	for {
		let done, ends = finish(es, now, c.Policy)
		let started, b, starts = start(done, now, workers, bucket)
		es = started
		bucket = b
		for e in ends {
			log = log.Append(e)
		}
		for e in starts {
			log = log.Append(e)
		}
		match next(es, now, workers, bucket) {
		case option.Some[duration] as t:
			now = t.Value
		case option.None:
			break
		}
	}
	log
}
