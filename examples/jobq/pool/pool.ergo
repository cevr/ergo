// Package pool runs a job queue on real tasks, as a Go program would: a
// queue of jobs, Workers worker tasks that pop from it, a pacer task that
// puts a token in a queue each Every (a buffered channel of Burst tokens,
// as Go's time.Tick limiter), and a queue of reports. A worker takes a
// token before each try, sleeps the try's time on the Scheduler, asks the
// jobs.Worker for the result, and on a transient failure sleeps its
// backoff and tries again. The job's life is the same jobs.Life machine
// that sched runs.

import jobq/jobs
import jobq/sched
import queue
import slices
import task
import time

// Report is how one job ended, and on which worker.
type Report { ID int, Worker int, Out jobs.Outcome }

// token is one start the pacer allows.
type token {}

// pace puts a token in tokens each every, until it is stopped or the
// queue closes. Its first burst is already in the queue.
func pace(tokens queue.Queue[token], every duration) needs time.Scheduler {
	for {
		if every > 0s {
			time.Scheduler.Sleep(every)
		}
		tokens.Push(token) catch {
		case queue.Closed:
			return
		}
	}
}

func work(w int, js queue.Queue[jobs.Job], tokens queue.Queue[token], out queue.Queue[Report], p jobs.Policy) fails queue.Closed needs jobs.Worker | time.Scheduler {
	for j in js.Values() {
		let mut queued = jobs.Queued{N: 1, Ready: 0s}
		let mut now = 0s
		for {
			let _ = try tokens.Pop()
			let running = jobs.StartJob(queued, now, j.Takes) catch {
			case jobs.TooEarly:
				try out.Push(Report{ID: j.ID, Worker: w, Out: jobs.GaveUp{N: queued.N, At: now, Why: "the queue sent a wrong signal"}})
				break
			}
			time.Scheduler.Sleep(j.Takes)
			now = now + j.Takes
			let res = jobs.FinishJob(running, now, jobs.Worker.Do(j, running.N), p) catch {
			case jobs.TooEarly:
				try out.Push(Report{ID: j.ID, Worker: w, Out: jobs.GaveUp{N: running.N, At: now, Why: "the queue sent a wrong signal"}})
				break
			}
			match res {
			case jobs.Finished as d:
				try out.Push(Report{ID: j.ID, Worker: w, Out: d.Output})
				break
			case jobs.Retry as rt:
				queued = rt.Next
				let wait = jobs.Backoff(p, running.N)
				time.Scheduler.Sleep(wait)
				now = now + wait
			}
		}
	}
}

// crew starts workers from w to n in one owned slice and waits in reverse
// start order. Take moves each task out before Wait consumes it; an early
// failure releases the slice and drains the workers still in it.
func crew(w int, n int, js queue.Queue[jobs.Job], tokens queue.Queue[token], out queue.Queue[Report], p jobs.Policy) fails queue.Closed needs jobs.Worker | time.Scheduler {
	let mut running = []task.Task[bool, queue.Closed]{}
	for worker in w..n+1 {
		let t = task.Go() {
			try work(worker, js, tokens, out, p)
			true
		}
		running = running.Append(t)
	}
	for running.Len() > 0 {
		let last = running.Len() - 1
		let t, rest = slices.Take(running, last)
		running = rest
		let _ = try t.Wait()
	}
}

// Run runs js under c and is the report of each job, by ID.
func Run(c sched.Config, js []jobs.Job) []Report fails queue.Closed needs jobs.Worker | time.Scheduler {
	let workers = if c.Workers < 1 { 1 } else { c.Workers }
	let burst = if c.Burst < 1 { 1 } else { c.Burst }
	let q = queue.New[jobs.Job](js.Len())
	let tokens = queue.New[token](burst)
	let out = queue.New[Report](js.Len())
	for _ in 0..burst {
		try tokens.Push(token)
	}
	for j in js {
		try q.Push(j)
	}
	q.End()
	let pacer = task.Go() { pace(tokens, c.Every) }
	try crew(1, workers, q, tokens, out, c.Policy)
	pacer.Stop()
	out.End()
	let mut got = []Report{}
	for r in out.Values() {
		got = got.Append(r)
	}
	slices.SortFunc(got, func(a Report, b Report) int { a.ID - b.ID })
}
