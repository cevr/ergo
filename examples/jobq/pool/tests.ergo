// The pool's tests, on real tasks with sleeps that end at once: no job is
// lost, each report is on a worker of the pool, and each job ends as the
// virtual-clock run of sched says.

import jobq/jobs
import jobq/sched
import queue
import testing

// pooled is the reports of a pool run of sched.Load(ns) under
// sched.Shape(c) on the script.
func pooled(c int, ns []int) []Report fails queue.Closed {
	with context { jobs.Worker: jobs.Script, Scheduler: testing.NewVirtualClock(0) } { try Run(sched.Shape(c), sched.Load(ns)) }
}

// kind is the outcome o without its time.
func kind(o jobs.Outcome) string {
	match o {
	case jobs.Succeeded as s:
		"done after \(s.N)"
	case jobs.GaveUp as g:
		"gave up after \(g.N): \(g.Why)"
	}
}

test ThreeJobsTwoWorkers {
	let c = sched.Config{Workers: 2, Policy: jobs.Policy{Attempts: 3, Base: 100ms, Max: 1s}, Burst: 2, Every: 100ms}
	let js = []jobs.Job{jobs.Job{ID: 1, Name: "a", Takes: 300ms, Flaky: 0, Fatal: false}, jobs.Job{ID: 2, Name: "b", Takes: 50ms, Flaky: 1, Fatal: false}, jobs.Job{ID: 3, Name: "c", Takes: 50ms, Flaky: 5, Fatal: false}}
	let rs = try with context { jobs.Worker: jobs.Script, Scheduler: testing.NewVirtualClock(0) } { Run(c, js) }
	assert len(rs) == 3
	assert kind(rs[0].Out) == "done after 1"
	assert kind(rs[1].Out) == "done after 2"
	assert kind(rs[2].Out) == "gave up after 3: try 3 of c timed out; no tries left"
}

// Two workers drain one closed queue of two jobs. In every order of their
// steps each job runs once, on a worker of the pool, and no worker fails
// on the drained queue. The program's explored file has the explore leg
// search this test's schedules, so a race between the two workers' takes
// is a failing schedule, not a rare flake.
test TwoWorkersDrainTheQueue {
	let c = sched.Config{Workers: 2, Policy: jobs.Policy{Attempts: 1, Base: 0s, Max: 0s}, Burst: 2, Every: 0s}
	let js = []jobs.Job{jobs.Job{ID: 1, Name: "a", Takes: 0s, Flaky: 0, Fatal: false}, jobs.Job{ID: 2, Name: "b", Takes: 0s, Flaky: 0, Fatal: false}}
	let rs = try with context { jobs.Worker: jobs.Script, Scheduler: testing.NewVirtualClock(0) } { Run(c, js) }
	assert len(rs) == 2
	for i, r in rs {
		assert r.ID == i+1
		assert kind(r.Out) == "done after 1"
		assert r.Worker >= 1 && r.Worker <= 2
	}
}

test NoJobLostHolds(c int, ns []int) {
	let rs = try pooled(c, ns)
	assert len(rs) == len(ns)
	for i, r in rs {
		assert r.ID == i+1
		assert r.Worker >= 1 && r.Worker <= sched.Shape(c).Workers
	}
}

test AgreesWithTheVirtualRun(c int, ns []int) {
	let rs = try pooled(c, ns)
	let mut want = Map[int, string]{}
	for e in sched.Ran(c, ns) {
		match e {
		case sched.Succeeded as s:
			want[s.ID] = "done after \(s.N)"
		case sched.GaveUp as g:
			want[g.ID] = "gave up after \(g.N): \(g.Why)"
		case sched.Started:
		case sched.Retrying:
		}
	}
	for r in rs {
		assert want.Get(r.ID) == Some[string]{Value: kind(r.Out)}
	}
}
