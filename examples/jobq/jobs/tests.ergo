// The tests of retry: backoff worked by hand and a job's life. The laws
// run under ergo test.

import machines

let Default = Policy{Attempts: 4, Base: 100ms, Max: 300ms}

test BackoffDoublesToItsCap {
	assert Backoff(Default, 1) == 100ms
	assert Backoff(Default, 2) == 200ms
	assert Backoff(Default, 3) == 300ms
	assert Backoff(Default, 9) == 300ms
	assert Backoff(Policy{Attempts: 2, Base: 0s, Max: 1s}, 3) == 0s
}

test AFlakyJobSucceeds {
	let out, tries = Lived(Default, []Result{Transient{Reason: "a"}, Transient{Reason: "b"}, Ok}, 1s)
	assert tries == 3
	// tries at 0s, 1.1s (1s + 100ms) and 2.3s (2.1s + 200ms); done at 3.3s
	assert out == Succeeded{N: 3, At: 3300ms}
}

test StepRefusesAWrongQueue {
	assert Step(Queued{N: 1, Ready: 5s}, Start{At: 4s, Takes: 1s}) == machines.Reject
	assert Step(Running{N: 1, Ends: 5s}, Start{At: 6s, Takes: 1s}) == machines.Reject
	assert Step(Queued{N: 1, Ready: 5s}, Finish{At: 6s, R: Ok, P: Default}) == machines.Reject
	assert Step(Running{N: 1, Ends: 5s}, Finish{At: 4s, R: Ok, P: Default}) == machines.Reject
}

test ScriptsAJob {
	let j = Job{ID: 1, Name: "mail", Takes: 1s, Flaky: 1, Fatal: true}
	assert Scripted(j, 1) == Transient{Reason: "try 1 of mail timed out"}
	assert Scripted(j, 2) == Fatal{Reason: "mail is malformed"}
}

test StartAndFinishHaveNarrowContracts {
	let r Running = try StartJob(Queued{N: 1, Ready: 0s}, 1s, 2s)
	assert r == Running{N: 1, Ends: 3s}
	let res FinishOutcome = try FinishJob(r, 3s, Transient{Reason: "busy"}, Default)
	assert res == Retry{Next: Queued{N: 2, Ready: 3s + 100ms}}
	let done FinishOutcome = try FinishJob(Running{N: 4, Ends: 5s}, 5s, Ok, Default)
	assert done == Finished{Output: Succeeded{N: 4, At: 5s}}
}
