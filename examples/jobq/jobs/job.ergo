// Package jobs is what a job queue runs: a job, the result of one try of
// it, the retry policy with its backoff, and the life of one job as a
// machine. It is pure; the work itself is the contract Worker, which a
// provider keeps.

import machines

// Job is one piece of work. Takes is how long one try runs. A job of the
// demo is scripted: it fails Flaky times with a transient failure, then
// succeeds, unless Fatal, when its next try fails for good.
type Job { ID int, Name string, Takes duration, Flaky int, Fatal bool }

// Result is how one try of a job ended.
type Result = Ok{} | Transient{Reason string} | Fatal{Reason string}

// Policy is how a queue retries: at most Attempts tries of a job, and
// before try n+1 a wait of Base doubled n-1 times, never more than Max.
type Policy { Attempts int, Base duration, Max duration }

// RetriesEnd: a job that always fails for a moment is tried exactly
// Attempts times and then given up.
law RetriesEnd(p Policy) {
	let q = Small(p)
	let out, tries = Lived(q, []Result{Transient{Reason: "busy"}}, 1s)
	match out {
	case GaveUp:
		tries == q.Attempts
	case Succeeded:
		false
	}
}

// Lived is the outcome of a job whose every try ends with results[n-1]
// (the last result again after the list), started as soon as it is ready,
// each try taking cost, and the number of tries.
func Lived(p Policy, results []Result, cost duration) (Outcome, int) {
	let mut phase = Fresh(0s)
	let mut tries = 0
	for {
		match phase {
		case Queued as q:
			phase = machines.Next(phase, Step(phase, Start{At: q.Ready, Takes: cost}))
			tries = tries + 1
		case Running as r:
			let res = if len(results) == 0 { Ok } else if r.N <= len(results) { results[r.N-1] } else { results[len(results)-1] }
			let d = Step(phase, Finish{At: r.Ends, R: res, P: p})
			match d {
			case Done[Outcome] as done:
				return (done.Output, tries)
			case Enter[Phase], Stay[Phase], Emit[Phase, Outcome], Tell[Phase, Outcome]:
				phase = machines.Next(phase, d)
			case Ignore:
				return (GaveUp{N: r.N, At: r.Ends, Why: "ignored"}, tries)
			case Reject:
				return (GaveUp{N: r.N, At: r.Ends, Why: "rejected"}, tries)
			}
		}
	}
}

// FatalIsFinal: a fatal failure is never retried.
law FatalIsFinal(p Policy) {
	let out, tries = Lived(Small(p), []Result{Fatal{Reason: "bad"}}, 1s)
	match out {
	case GaveUp:
		tries == 1
	case Succeeded:
		false
	}
}

// Backoff is the wait after the failed try n (n from 1) under p:
// Base, 2 Base, 4 Base, …, capped at Max. A Base of zero or less waits
// nothing.
func Backoff(p Policy, n int) duration {
	if p.Base <= 0s {
		return 0s
	}
	let mut d = p.Base
	for _ in 1..n {
		if d >= p.Max {
			return p.Max
		}
		d = d + d
	}
	if d > p.Max { p.Max } else { d }
}

// BackoffGrows: each wait is at least the one before it.
law BackoffGrows(p Policy, n int) {
	let q = Small(p)
	let k = if n < 0 { -(n % 20) } else { n % 20 }
	Backoff(q, k+1) <= Backoff(q, k+2)
}

// Small is p with its numbers folded into a small range: 1 to 6 attempts,
// a base of 0 to 500ms and a cap of the base to 8 bases, so a law over any
// Policy stays meaningful.
func Small(p Policy) Policy {
	let a = if p.Attempts < 0 { -(p.Attempts % 6) } else { p.Attempts % 6 }
	let b = int64(p.Base) % int64(500ms)
	let base = duration(if b < 0 { -b } else { b })
	let m = int64(p.Max) % 8
	let k = if m < 0 { -m } else { m }
	Policy{Attempts: a + 1, Base: base, Max: duration(int64(base) * (k + 1))}
}

// BackoffIsCapped: no wait is longer than Max, and the first is Base
// (or Max when Base is above it).
law BackoffIsCapped(p Policy, n int) {
	let q = Small(p)
	let k = if n < 0 { -(n % 20) } else { n % 20 }
	Backoff(q, k+1) <= q.Max && Backoff(q, 1) == (if q.Base > q.Max { q.Max } else { q.Base })
}

// RetryWaitsItsBackoff: a try after a failure starts no sooner than the
// failure plus its backoff.
law RetryWaitsItsBackoff(p Policy, at int) {
	let q = Small(p)
	let ms = if at < 0 { -(at % 1000) } else { at % 1000 }
	let end = duration(int64(ms) * int64(1ms))
	let r = Running{N: 1, Ends: end}
	match Step(r, Finish{At: end, R: Transient{Reason: "busy"}, P: q}) {
	case Enter[Phase] as e:
		Step(e.Next, Start{At: end + Backoff(q, 1) - 1ns, Takes: 1s}) == Reject || Backoff(q, 1) == 0s
	case Done[Outcome]:
		q.Attempts == 1
	case Stay[Phase], Emit[Phase, Outcome], Tell[Phase, Outcome], Ignore, Reject:
		false
	}
}

// Scripted is the result of try n (from 1) of j's script.
func Scripted(j Job, n int) Result {
	if n <= j.Flaky {
		return Transient{Reason: "try \(n) of \(j.Name) timed out"}
	}
	if j.Fatal {
		return Fatal{Reason: "\(j.Name) is malformed"}
	}
	Ok
}

// Worker is the contract of the thing that does a job: one try of it.
type Worker {
	Do(j Job, n int) Result,

	// IsRepeatable: a try gives the same result each time it is asked
	// for; a worker whose result depends on hidden state cannot be
	// tested by replay.
	law IsRepeatable(j Job, n int) {
		Do(j, n) == Do(j, n)
	},
}
