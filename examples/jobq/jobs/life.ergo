import machines

// Phase is where one job is in its life: waiting in the queue until
// Ready for its try N, or running try N until Ends.
type Phase = Queued{N int, Ready duration} | Running{N int, Ends duration}

// Signal is what reaches a job: a worker starts it, or its try ends with
// a result. A Finish carries the policy, so the step knows whether to
// retry.
type Signal = Start{At duration, Takes duration} | Finish{At duration, R Result, P Policy}

// Outcome is how a job's life ended.
type Outcome = Succeeded{N int, At duration} | GaveUp{N int, At duration, Why string}

// Fresh is a job just queued at the time at, for its first try.
func Fresh(at duration) Phase { Queued{N: 1, Ready: at} }

type TooEarly {}

type FinishOutcome = Retry{Next Queued} | Finished{Output Outcome}

func StartJob(q Queued, at duration, cost duration) Running fails TooEarly {
	if at < q.Ready {
		return TooEarly
	}
	Running{N: q.N, Ends: at + cost}
}

func FinishJob(r Running, at duration, res Result, p Policy) FinishOutcome fails TooEarly {
	if at < r.Ends {
		return TooEarly
	}
	match res {
	case Ok:
		Finished{Output: Succeeded{N: r.N, At: at}}
	case Fatal as e:
		Finished{Output: GaveUp{N: r.N, At: at, Why: e.Reason}}
	case Transient as t:
		if r.N >= p.Attempts {
			Finished{Output: GaveUp{N: r.N, At: at, Why: "\(t.Reason); no tries left"}}
		} else {
			Retry{Next: Queued{N: r.N + 1, Ready: at + Backoff(p, r.N)}}
		}
	}
}

func Step(p Phase, s Signal) machines.Decision[Phase, Outcome] {
	match (p, s) {
	case (Queued as q, Start as st):
		let next = StartJob(q, st.At, st.Takes) catch {
		case TooEarly:
			return machines.Reject
		}
		machines.Enter[Phase]{Next: next}
	case (Running, Start):
		machines.Reject
	case (Queued, Finish):
		machines.Reject
	case (Running as r, Finish as f):
		let res = FinishJob(r, f.At, f.R, f.P) catch {
		case TooEarly:
			return machines.Reject
		}
		match res {
		case Finished as d:
			machines.Done[Outcome]{Output: d.Output}
		case Retry as rt:
			machines.Enter[Phase]{Next: rt.Next}
		}
	}
}

// Life is a job's life as a machine.
type Life machine[Phase, Signal] {
	initial: Fresh(0s),
	step:    Step,
}
