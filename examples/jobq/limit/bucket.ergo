// Package limit is a token-bucket rate limiter on a clock it is given:
// a bucket holds at most Burst tokens, gains one each Every, and each
// start takes one. It is pure: the time is an argument, so a virtual
// clock tests it exactly.

import option

// Bucket is a limiter's state: its shape, the tokens it holds, and the
// time it last gained one.
type Bucket { Burst int, Every duration, tokens int, since duration }

// Full is a bucket with burst tokens at the time at, gaining one each
// every. A burst below one is one, and an every of zero or less means no
// limit.
func Full(burst int, every duration, at duration) Bucket {
	let b = if burst < 1 { 1 } else { burst }
	Bucket{Burst: b, Every: every, tokens: b, since: at}
}

// RateHolds: in any window from one success to another, the successes
// are at most Burst, and one more for each token that can arrive in the
// window: one for each whole Every, and one for the window's edge.
law RateHolds(b int, e int, ns []int) {
	let burst, every = shape(b, e)
	let got = taken(burst, every, Times(ns))
	for i, a in got {
		for j in i..got.Len() {
			let window = int64(got[j]-a) / int64(every)
			if int64(j-i+1) > int64(burst)+window+1 {
				return false
			}
		}
	}
	true
}

// Times is the times of ns: a running sum of gaps of 0 to 999ms.
func Times(ns []int) []duration {
	let mut out = []duration{}
	let mut at = 0s
	for n in ns {
		let gap = if n < 0 { -(n % 1000) } else { n % 1000 }
		at = at + duration(int64(gap)*int64(1ms))
		out = out.Append(at)
	}
	out
}

// taken is the times at which a take at each time of ts succeeded, from a
// full bucket of burst tokens gaining one each every.
func taken(burst int, every duration, ts []duration) []duration {
	let mut b = Full(burst, every, 0s)
	let mut out = []duration{}
	for t in ts {
		match Take(b, t) {
		case option.Some[Bucket] as next:
			b = next.Value
			out = out.Append(t)
		case option.None:
		}
	}
	out
}

// shape is a burst of 1 to 5 and an every of 50ms to 500ms from b and e.
func shape(b int, e int) (int, duration) {
	let burst = if b < 0 { -(b % 5) } else { b % 5 }
	let every = if e < 0 { -(e % 10) } else { e % 10 }
	(burst + 1, duration(int64(every+1) * int64(50ms)))
}

// NeverOverBurst: a bucket never holds more than Burst tokens.
law NeverOverBurst(b int, e int, ns []int) {
	let burst, every = shape(b, e)
	let mut k = Full(burst, every, 0s)
	for t in Times(ns) {
		if Tokens(k, t) > burst {
			return false
		}
		match Take(k, t) {
		case option.Some[Bucket] as next:
			k = next.Value
		case option.None:
		}
	}
	true
}

// Refill is b at the time now: one more token for each whole Every since
// it last gained one, up to Burst. A time before since changes nothing.
func Refill(b Bucket, now duration) Bucket {
	if b.Every <= 0s || now <= b.since {
		return b
	}
	let gained = int64(now-b.since) / int64(b.Every)
	if gained == 0 {
		return b
	}
	let room = int64(b.Burst - b.tokens)
	if gained >= room {
		return Bucket{..b, tokens: b.Burst, since: now}
	}
	Bucket{..b, tokens: b.tokens + int(gained), since: b.since + duration(gained*int64(b.Every))}
}

// Take is b after one token is taken at now, or None when it has none.
func Take(b Bucket, now duration) option.Option[Bucket] {
	if b.Every <= 0s {
		return option.Some[Bucket]{Value: b}
	}
	let r = Refill(b, now)
	if r.tokens == 0 {
		return option.None
	}
	option.Some[Bucket]{Value: Bucket{..r, tokens: r.tokens - 1}}
}

// NextAt is the first time at or after now when b has a token.
func NextAt(b Bucket, now duration) duration {
	let r = Refill(b, now)
	if r.Every <= 0s || r.tokens > 0 {
		return now
	}
	r.since + r.Every
}

// NextAtHasAToken: at the time NextAt names, a take succeeds.
law NextAtHasAToken(b int, e int, ns []int) {
	let burst, every = shape(b, e)
	let mut k = Full(burst, every, 0s)
	for t in Times(ns) {
		match Take(k, NextAt(k, t)) {
		case option.Some[Bucket] as next:
			k = next.Value
		case option.None:
			return false
		}
	}
	true
}

// Tokens is the tokens b holds at now.
func Tokens(b Bucket, now duration) int { Refill(b, now).tokens }
