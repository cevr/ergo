// Disk's tests, over an fstest.Memory and a standard input held in
// memory. ergo test runs app.Documents.ReadIsRepeatable on a generated
// Disk, whose io.Input gives its text to every read; ReadIsRepeatableHolds
// restates it with an input that drains, as the host's does.

import fs
import fstest
import io
import jsonv/app
import sync

// drained is a standard input that gives its text to the first ReadAll
// and nothing after, as the host's does.
type drained { text string, reads sync.Ref[int] }

func ReadAll(d drained) string fails io.ReadFailed {
	let n = sync.Modify(d.reads, func(n int) (int, int) { (n, n + 1) })
	if n == 0 { d.text } else { "" }
}

func Lines(d drained) Seq[string] { (io.Input{Text: d.text}).Lines() }

// disk is a Disk over a.json, a directory dir and the standard input
// text.
func disk(text string) Disk fails fs.NotFound | fs.Denied | fs.Failed {
	let files = fstest.NewMemory()
	try files.WriteFile("a.json", "[1]")
	try files.MkdirAll("dir")
	New(files, drained{text: text, reads: sync.NewRef[int](0)})
}

// outcome is the text of Read(name), or the failure's name.
func outcome(d Disk, name string) string {
	d.Read(name) catch {
	case app.NoDocument as n:
		"no document " + n.Name
	case app.Unreadable as u:
		"unreadable " + u.Name + ": " + u.Reason
	}
}

test ReadsFilesAndStdin {
	let d = try disk("{}")
	assert outcome(d, "a.json") == "[1]" && outcome(d, "-") == "{}"
	assert outcome(d, "b.json") == "no document b.json"
	assert outcome(d, "dir") == "unreadable dir: is a directory"
}

// A copy of the Disk shares what it kept: the second read of "-", by
// another copy, still gives the text the drained input gave once.
test ReadIsRepeatableHolds(text string, name string) {
	let d = try disk(text)
	let e = d
	for n in []string{"-", "a.json", name} {
		assert outcome(d, n) == outcome(e, n)
	}
	assert outcome(d, "-") == text
}
