import json

// MaxDepth is the deepest nesting of arrays and objects Parse reads.
let MaxDepth = 1000

// Parse reads text as exactly one JSON value, with white space around it:
// std json's Decode of a Value. A text that is not JSON fails Malformed
// with the byte offset where it breaks the grammar and the rule it breaks.
func Parse(text string) json.Value fails json.Malformed {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: MaxDepth}, text) catch {
	case json.Malformed as m:
		return m
	case _:
		// Decode checks the whole text first, and a Value reads every
		// kind, so its shape cannot fail: a valid text is always a Value.
		return json.Malformed{Offset: 0, Reason: "not a JSON value"}
	}
}

// Position is a line and a column of a text, both from 1; the column
// counts bytes.
type Position { Line int, Col int }

// Locate is the position of the byte at offset in text.
func Locate(text string, offset int) Position {
	let mut line = 1
	let mut col = 1
	for i in 0..offset {
		if i >= len(text) {
			break
		}
		if text[i] == '\n' {
			line = line + 1
			col = 1
		} else {
			col = col + 1
		}
	}
	Position{Line: line, Col: col}
}
