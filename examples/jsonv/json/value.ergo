// Package json is jsonv's JSON layer over std json: Parse reads a text
// into std's json.Value, which keeps member order, repeated keys and each
// number's spelling, and two printers write a Value back, compact and
// indented, in jq's layout. It is pure: no function needs a capability.
// RFC 8259 is the grammar; jq 1.7 is the model of the printed layout.

import json

// Kind is the name of v's kind, as a schema writes it: null, boolean,
// number, string, array or object.
func Kind(v json.Value) string {
	match v {
	case json.Null:
		"null"
	case json.Boolean:
		"boolean"
	case json.Num:
		"number"
	case json.Str:
		"string"
	case json.Array:
		"array"
	case json.Object:
		"object"
	}
}

// Get is the value of the last member of o named key, as a decode into a
// record takes the last of a repeated key.
func Get(o json.Object, key string) Option[json.Value] {
	let mut found Option[json.Value] = None
	for m in o.Members {
		if m.Key == key {
			found = Some[json.Value]{Value: m.Value}
		}
	}
	found
}
