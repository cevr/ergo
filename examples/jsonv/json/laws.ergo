// The rules of the codec as laws over its two printers and its parser.
// Each law takes any Value and first makes it one that Parse can give
// (Lawful), since a generated Number may hold any text.

import strconv
import strings

// Lawful is v with each number's text made a JSON number and each string
// made valid UTF-8: the values Parse returns.
func Lawful(v Value) Value {
	match v {
	case Number as n:
		if IsNumber(n.Text) {
			return n
		}
		// The generator's text is almost never a number; make one of four
		// shapes from its length, so integers, fractions and exponents
		// all occur.
		let k = len(n.Text)
		let text = match k % 4 {
		case 0:
			strconv.Itoa(k)
		case 1:
			"-\(k).5"
		case 2:
			"\(k)e2"
		case _:
			"0.\(k)"
		}
		Number{Text: text}
	case Text as t:
		Text{V: strings.ToValidUTF8(t.V, "\ufffd")}
	case Array as a:
		let mut items = []Value{}
		for item in a.Items {
			items = items.Append(Lawful(item))
		}
		Array{Items: items}
	case Object as o:
		let mut members = []Member{}
		for m in o.Members {
			members = members.Append(Member{Key: strings.ToValidUTF8(m.Key, "\ufffd"), V: Lawful(m.V)})
		}
		Object{Members: members}
	case Null:
		v
	case Bool:
		v
	}
}

// IsNumber reports whether text is exactly one JSON number.
func IsNumber(text string) bool {
	let mut s = scanner{text: text, pos: 0, depth: 0}
	if len(text) == 0 {
		return false
	}
	let _ = numeral(&s) catch {
	case BadNumber:
		return false
	}
	s.pos == len(text)
}

// CompactRoundTrips: the compact text of a value parses back to it.
law CompactRoundTrips(v Value) {
	let w = Lawful(v)
	try Parse(Compact(w)) == w
}

// IndentRoundTrips: the indented text parses back to the value, whatever
// the indent of spaces and tabs.
law IndentRoundTrips(v Value, tabs bool) {
	let w = Lawful(v)
	let indent = if tabs { "\t" } else { "  " }
	try Parse(Indent(w, indent)) == w
}

// IndentIsIdempotent: indenting an indented text again changes nothing.
law IndentIsIdempotent(v Value) {
	let once = Indent(Lawful(v), "  ")
	Indent(try Parse(once), "  ") == once
}

// CompactIgnoresLayout: the compact text does not depend on the layout
// of the text it was parsed from.
law CompactIgnoresLayout(v Value) {
	let w = Lawful(v)
	Compact(try Parse(Indent(w, "  "))) == Compact(w)
}

// FailuresPointIntoTheText: a text that does not parse fails at an
// offset inside it or at its end.
law FailuresPointIntoTheText(text string) {
	let _ = Parse(text) catch {
	case err:
		let at = Offset(err)
		return at >= 0 && at <= len(text)
	}
	true
}
