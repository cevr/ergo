// The layer's tests: examples. The laws run under ergo test, over drawn
// trees whose strings hold quotes, backslashes, control bytes and invalid
// UTF-8. The grammar and the escapes are std json's, and its laws hold
// them; these tests hold what jsonv adds: the printers' layout, Get, the
// depth limit and the place a failure names.

import json
import strings

// failure is the text and position of the failure of Parse(text), or
// "ok".
func failure(text string) string {
	let _ = Parse(text) catch {
	case json.Malformed as err:
		let p = Locate(text, err.Offset)
		return "\(p.Line):\(p.Col): \(err.Reason)"
	}
	"ok"
}

test ParsesEveryKind {
	let v = try Parse(" {\"a\": [1, -2.5e+3, true, false, null], \"b\": \"x\\ty\", \"c\": {}} ")
	assert Compact(v) == "{\"a\":[1,-2.5e+3,true,false,null],\"b\":\"x\\ty\",\"c\":{}}"
	match v {
	case json.Object as o:
		assert Kind(o.Members[0].Value) == "array" && Kind(o.Members[2].Value) == "object"
	case _:
		assert false
	}
}

test NumbersKeepTheirText {
	let v = try Parse("[2.50, 100000000000000000001, 0, -0.0, 1E9]")
	assert Compact(v) == "[2.50,100000000000000000001,0,-0.0,1E9]"
}

test IndentIsJqLayout {
	let v = try Parse("[1,[2,{\"a\":[]}],{}]")
	assert Indent(v, "  ") == "[\n  1,\n  [\n    2,\n    {\n      \"a\": []\n    }\n  ],\n  {}\n]"
}

test QuoteEscapesAsJq {
	assert Quoted("a\"b\\c\nd\u0001\u007fé") == "\"a\\\"b\\\\c\\nd\\u0001\\u007fé\""
}

test LastKeyWins {
	let v = try Parse("{\"a\": 1, \"a\": 2}")
	match v {
	case json.Object as o:
		match Get(o, "a") {
		case Some[json.Value] as found:
			assert Compact(found.Value) == "2"
		case None:
			assert false
		}
	case _:
		assert false
	}
}

// A failure names its line and column, and std's reason names the byte
// it did not expect.
test FailuresNameTheirPlace {
	assert failure("[1,]") == "1:4: an unexpected \"]\" where a value belongs"
	assert failure("[1]\n x") == "2:2: text after the value"
}

test DepthIsLimited {
	let deep = strings.Repeat("[", MaxDepth) + strings.Repeat("]", MaxDepth)
	let _ = try Parse(deep)
	assert failure("["+deep+"]") == "1:\(MaxDepth + 1): nesting deeper than MaxDepth \(MaxDepth)"
}

// Prefixes of a valid text: every proper prefix of a compact array or
// object fails, and never past its end.
test PrefixesFail(t Tree) {
	let text = Compact(json.Array{Items: []json.Value{try Lawful(t)}})
	for n in 0..len(text) {
		let prefix = strings.Slice(text, 0, n)
		let _ = Parse(prefix) catch {
		case json.Malformed as err:
			assert err.Offset <= n
			continue
		}
		assert false
	}
}

// The printer escapes what jq escapes: a quote, a backslash, a control
// byte and DEL; invalid UTF-8 prints as U+FFFD.
test QuotedEscapes {
	assert Quoted("\"\\\u0001\u007f\xff") == "\"\\\"\\\\\\u0001\\u007f\ufffd\""
}
