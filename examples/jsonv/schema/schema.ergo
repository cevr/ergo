// Package schema is a small JSON Schema: a type, an enum and a length for
// strings, bounds for numbers, items for arrays, and properties, required
// names and a closed flag for objects. A Schema is read from a JSON value
// (FromJSON), written back to one (ToJSON), inferred from an example
// (Infer), and checked against a value (Validate), which names the path
// of every violation. It is pure.

import jsonv/json
import stdjson json

// Schema is what a value must be.
type Schema = Anything{} | IsNull{} | IsBool{} | IsString{Enum []string, MinLength int} | IsNumber{Integer bool, Min Option[float64], Max Option[float64]} | IsArray{Items Schema, MinItems int} | IsObject{Props []Prop, Required []string, Closed bool}

// Prop is one named property of an object schema.
type Prop { Name string, S Schema }

// Infer is the narrowest schema of this language that accepts v: its
// kind, every member of an object required and none other allowed, and
// the items of an array joined into one schema.
func Infer(v stdjson.Value) Schema {
	match v {
	case stdjson.Null:
		IsNull
	case stdjson.Boolean:
		IsBool
	case stdjson.Num as n:
		IsNumber{Integer: isInteger(json.Spelling(n)), Min: None, Max: None}
	case stdjson.Str:
		IsString{Enum: []string{}, MinLength: 0}
	case stdjson.Array as a:
		if len(a.Items) == 0 {
			return IsArray{Items: Anything, MinItems: 0}
		}
		let mut items = Infer(a.Items[0])
		for item in a.Items {
			items = Join(items, Infer(item))
		}
		IsArray{Items: items, MinItems: 0}
	case stdjson.Object as o:
		let mut props = []Prop{}
		let mut names = []string{}
		for m in o.Members {
			let s = Infer(m.Value)
			let at = indexOf(props, m.Key)
			if at < 0 {
				props = props.Append(Prop{Name: m.Key, S: s})
				names = names.Append(m.Key)
			} else {
				props = replaced(props, at, Prop{Name: m.Key, S: s})
			}
		}
		IsObject{Props: props, Required: names, Closed: true}
	}
}

// Join is a schema that accepts every value a or b accepts: the same
// kind joins field by field, two kinds join to Anything.
func Join(a Schema, b Schema) Schema {
	match (a, b) {
	case (IsNull, IsNull):
		a
	case (IsBool, IsBool):
		a
	case (IsString as x, IsString as y):
		let enum = if len(x.Enum) == 0 || len(y.Enum) == 0 { []string{} } else { union(x.Enum, y.Enum) }
		IsString{Enum: enum, MinLength: if x.MinLength < y.MinLength { x.MinLength } else { y.MinLength }}
	case (IsNumber as x, IsNumber as y):
		IsNumber{Integer: x.Integer && y.Integer, Min: lower(x.Min, y.Min), Max: upper(x.Max, y.Max)}
	case (IsArray as x, IsArray as y):
		IsArray{Items: Join(x.Items, y.Items), MinItems: if x.MinItems < y.MinItems { x.MinItems } else { y.MinItems }}
	case (IsObject as x, IsObject as y):
		let mut props = []Prop{}
		for p in x.Props {
			let at = indexOf(y.Props, p.Name)
			props = props.Append(if at < 0 { p } else { Prop{Name: p.Name, S: Join(p.S, y.Props[at].S)} })
		}
		for p in y.Props {
			if indexOf(x.Props, p.Name) < 0 {
				props = props.Append(p)
			}
		}
		let mut required = []string{}
		for r in x.Required {
			if has(y.Required, r) {
				required = required.Append(r)
			}
		}
		IsObject{Props: props, Required: required, Closed: x.Closed && y.Closed}
	case _:
		Anything
	}
}

// lower is the lower of two minimums, None when either has none.
func lower(a Option[float64], b Option[float64]) Option[float64] {
	match (a, b) {
	case (Some[float64] as x, Some[float64] as y):
		if x.Value < y.Value { x } else { y }
	case _:
		None
	}
}

// upper is the higher of two maximums, None when either has none.
func upper(a Option[float64], b Option[float64]) Option[float64] {
	match (a, b) {
	case (Some[float64] as x, Some[float64] as y):
		if x.Value > y.Value { x } else { y }
	case _:
		None
	}
}

func union(a []string, b []string) []string {
	let mut out = []string{}
	for x in a {
		out = out.Append(x)
	}
	for y in b {
		if !has(a, y) {
			out = out.Append(y)
		}
	}
	out
}

func has(names []string, name string) bool {
	for n in names {
		if n == name {
			return true
		}
	}
	false
}

func indexOf(props []Prop, name string) int {
	for i, p in props {
		if p.Name == name {
			return i
		}
	}
	-1
}

// replaced is props with the prop at i replaced by p, in a new slice.
func replaced(props []Prop, i int, p Prop) []Prop {
	let mut out = []Prop{}
	for j, q in props {
		out = out.Append(if j == i { p } else { q })
	}
	out
}
