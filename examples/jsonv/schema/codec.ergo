// The schema's JSON form, written by hand: Ergo derives no codec yet
// (#49; gap G-ex-d-6), so FromJSON walks the value and ToJSON builds one.

import jsonv/json
import strconv

// BadSchema is a JSON value that is not a schema. Path names the part of
// the schema document that is wrong.
type BadSchema { Path string, Reason string }

// FromJSON reads v as a schema: true or {} is Anything; an object names
// its "type" and the keywords of that type. A keyword of another type, or
// one this language does not have, is BadSchema.
func FromJSON(v json.Value) Schema fails BadSchema { try read(v, "$") }

func read(v json.Value, path string) Schema fails BadSchema {
	match v {
	case json.Bool as b:
		if b.V {
			return Anything
		}
		BadSchema{Path: path, Reason: "false accepts no value; this language has no such schema"}
	case json.Object as o:
		if len(o.Members) == 0 {
			return Anything
		}
		let kind = match o.Get("type") {
		case Some[json.Value] as t:
			match t.Value {
			case json.Text as name:
				name.V
			case _:
				return BadSchema{Path: Member(path, "type"), Reason: "want a string"}
			}
		case None:
			return BadSchema{Path: path, Reason: "want a member \"type\""}
		}
		try typed(o, kind, path)
	case _:
		BadSchema{Path: path, Reason: "want an object or true, got " + article(json.Kind(v))}
	}
}

// typed reads the keywords of the schema object o of type kind.
func typed(o json.Object, kind string, path string) Schema fails BadSchema {
	match kind {
	case "null":
		try only(o, path, []string{"type"})
		IsNull
	case "boolean":
		try only(o, path, []string{"type"})
		IsBool
	case "string":
		try only(o, path, []string{"type", "enum", "minLength"})
		IsString{Enum: try names(o, "enum", path), MinLength: try count(o, "minLength", path)}
	case "number":
		try only(o, path, []string{"type", "minimum", "maximum"})
		IsNumber{Integer: false, Min: try bound(o, "minimum", path), Max: try bound(o, "maximum", path)}
	case "integer":
		try only(o, path, []string{"type", "minimum", "maximum"})
		IsNumber{Integer: true, Min: try bound(o, "minimum", path), Max: try bound(o, "maximum", path)}
	case "array":
		try only(o, path, []string{"type", "items", "minItems"})
		let items = match o.Get("items") {
		case Some[json.Value] as i:
			try read(i.Value, Member(path, "items"))
		case None:
			Anything
		}
		IsArray{Items: items, MinItems: try count(o, "minItems", path)}
	case "object":
		try only(o, path, []string{"type", "properties", "required", "additionalProperties"})
		let closed = match o.Get("additionalProperties") {
		case Some[json.Value] as a:
			match a.Value {
			case json.Bool as b:
				!b.V
			case _:
				return BadSchema{Path: Member(path, "additionalProperties"), Reason: "want true or false"}
			}
		case None:
			false
		}
		IsObject{Props: try props(o, path), Required: try names(o, "required", path), Closed: closed}
	case _:
		BadSchema{Path: Member(path, "type"), Reason: "unknown type " + json.Quoted(kind)}
	}
}

// only fails for a member of o not in allowed.
func only(o json.Object, path string, allowed []string) fails BadSchema {
	for m in o.Members {
		if !has(allowed, m.Key) {
			return BadSchema{Path: Member(path, m.Key), Reason: "not a keyword of this type"}
		}
	}
}

func props(o json.Object, path string) []Prop fails BadSchema {
	let at = Member(path, "properties")
	match o.Get("properties") {
	case Some[json.Value] as p:
		match p.Value {
		case json.Object as members:
			let mut out = []Prop{}
			for m in members.Members {
				if indexOf(out, m.Key) >= 0 {
					return BadSchema{Path: Member(at, m.Key), Reason: "the property is named twice"}
				}
				out = out.Append(Prop{Name: m.Key, S: try read(m.V, Member(at, m.Key))})
			}
			out
		case _:
			BadSchema{Path: at, Reason: "want an object"}
		}
	case None:
		[]Prop{}
	}
}

// names is the strings of the array member key of o, or none.
func names(o json.Object, key string, path string) []string fails BadSchema {
	let at = Member(path, key)
	match o.Get(key) {
	case Some[json.Value] as v:
		match v.Value {
		case json.Array as a:
			let mut out = []string{}
			for i, item in a.Items {
				match item {
				case json.Text as t:
					out = out.Append(t.V)
				case _:
					return BadSchema{Path: "\(at)[\(i)]", Reason: "want a string"}
				}
			}
			out
		case _:
			BadSchema{Path: at, Reason: "want an array of strings"}
		}
	case None:
		[]string{}
	}
}

// count is the integer member key of o, at least 0, or 0.
func count(o json.Object, key string, path string) int fails BadSchema {
	match o.Get(key) {
	case Some[json.Value] as v:
		match v.Value {
		case json.Number as n:
			let c = strconv.Atoi(n.Text) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return BadSchema{Path: Member(path, key), Reason: "want a whole number"}
			}
			if c < 0 {
				return BadSchema{Path: Member(path, key), Reason: "want a whole number"}
			}
			c
		case _:
			BadSchema{Path: Member(path, key), Reason: "want a whole number"}
		}
	case None:
		0
	}
}

// bound is the number member key of o.
func bound(o json.Object, key string, path string) Option[float64] fails BadSchema {
	match o.Get(key) {
	case Some[json.Value] as v:
		match v.Value {
		case json.Number as n:
			Some[float64]{Value: valueOf(n.Text)}
		case _:
			BadSchema{Path: Member(path, key), Reason: "want a number"}
		}
	case None:
		None
	}
}

// ToJSON is s as a JSON value that FromJSON reads back as s. A keyword at
// its default is left out.
func ToJSON(s Schema) json.Value {
	match s {
	case Anything:
		json.Bool{V: true}
	case IsNull:
		typeOnly("null")
	case IsBool:
		typeOnly("boolean")
	case IsString as str:
		let mut ms = []json.Member{kindMember("string")}
		if len(str.Enum) > 0 {
			ms = ms.Append(json.Member{Key: "enum", V: textArray(str.Enum)})
		}
		if str.MinLength > 0 {
			ms = ms.Append(json.Member{Key: "minLength", V: json.FormatNumber(str.MinLength)})
		}
		json.Object{Members: ms}
	case IsNumber as n:
		let mut ms = []json.Member{kindMember(if n.Integer { "integer" } else { "number" })}
		match n.Min {
		case Some[float64] as min:
			ms = ms.Append(json.Member{Key: "minimum", V: json.Number{Text: formatFloat(min.Value)}})
		case None:
		}
		match n.Max {
		case Some[float64] as max:
			ms = ms.Append(json.Member{Key: "maximum", V: json.Number{Text: formatFloat(max.Value)}})
		case None:
		}
		json.Object{Members: ms}
	case IsArray as a:
		let mut ms = []json.Member{kindMember("array")}
		match a.Items {
		case Anything:
		case _:
			ms = ms.Append(json.Member{Key: "items", V: ToJSON(a.Items)})
		}
		if a.MinItems > 0 {
			ms = ms.Append(json.Member{Key: "minItems", V: json.FormatNumber(a.MinItems)})
		}
		json.Object{Members: ms}
	case IsObject as o:
		let mut ms = []json.Member{kindMember("object")}
		if len(o.Props) > 0 {
			let mut ps = []json.Member{}
			for p in o.Props {
				ps = ps.Append(json.Member{Key: p.Name, V: ToJSON(p.S)})
			}
			ms = ms.Append(json.Member{Key: "properties", V: json.Object{Members: ps}})
		}
		if len(o.Required) > 0 {
			ms = ms.Append(json.Member{Key: "required", V: textArray(o.Required)})
		}
		if o.Closed {
			ms = ms.Append(json.Member{Key: "additionalProperties", V: json.Bool{V: false}})
		}
		json.Object{Members: ms}
	}
}

func kindMember(kind string) json.Member { json.Member{Key: "type", V: json.Text{V: kind}} }

func typeOnly(kind string) json.Value { json.Object{Members: []json.Member{kindMember(kind)}} }

func textArray(xs []string) json.Value {
	let mut items = []json.Value{}
	for x in xs {
		items = items.Append(json.Text{V: x})
	}
	json.Array{Items: items}
}
