// The schema's JSON form, written by hand: Ergo derives no codec yet
// (#49; gap G-ex-d-6), so FromJSON walks the value and ToJSON builds one.

import jsonv/json
import stdjson json
import strconv

// BadSchema is a JSON value that is not a schema. Path names the part of
// the schema document that is wrong.
type BadSchema { Path string, Reason string }

// FromJSON reads v as a schema: true or {} is Anything; an object names
// its "type" and the keywords of that type. A keyword of another type, or
// one this language does not have, is BadSchema.
func FromJSON(v stdjson.Value) Schema fails BadSchema { try read(v, "$") }

func read(v stdjson.Value, path string) Schema fails BadSchema {
	match v {
	case stdjson.Boolean as b:
		if b.Value {
			return Anything
		}
		BadSchema{Path: path, Reason: "false accepts no value; this language has no such schema"}
	case stdjson.Object as o:
		if len(o.Members) == 0 {
			return Anything
		}
		let kind = match json.Get(o, "type") {
		case Some[stdjson.Value] as t:
			match t.Value {
			case stdjson.Str as name:
				name.Value
			case _:
				return BadSchema{Path: Member(path, "type"), Reason: "want a string"}
			}
		case None:
			return BadSchema{Path: path, Reason: "want a member \"type\""}
		}
		try typed(o, kind, path)
	case _:
		BadSchema{Path: path, Reason: "want an object or true, got " + article(json.Kind(v))}
	}
}

// typed reads the keywords of the schema object o of type kind.
func typed(o stdjson.Object, kind string, path string) Schema fails BadSchema {
	match kind {
	case "null":
		try only(o, path, []string{"type"})
		IsNull
	case "boolean":
		try only(o, path, []string{"type"})
		IsBool
	case "string":
		try only(o, path, []string{"type", "enum", "minLength"})
		IsString{Enum: try names(o, "enum", path), MinLength: try count(o, "minLength", path)}
	case "number":
		try only(o, path, []string{"type", "minimum", "maximum"})
		IsNumber{Integer: false, Min: try bound(o, "minimum", path), Max: try bound(o, "maximum", path)}
	case "integer":
		try only(o, path, []string{"type", "minimum", "maximum"})
		IsNumber{Integer: true, Min: try bound(o, "minimum", path), Max: try bound(o, "maximum", path)}
	case "array":
		try only(o, path, []string{"type", "items", "minItems"})
		let items = match json.Get(o, "items") {
		case Some[stdjson.Value] as i:
			try read(i.Value, Member(path, "items"))
		case None:
			Anything
		}
		IsArray{Items: items, MinItems: try count(o, "minItems", path)}
	case "object":
		try only(o, path, []string{"type", "properties", "required", "additionalProperties"})
		let closed = match json.Get(o, "additionalProperties") {
		case Some[stdjson.Value] as a:
			match a.Value {
			case stdjson.Boolean as b:
				!b.Value
			case _:
				return BadSchema{Path: Member(path, "additionalProperties"), Reason: "want true or false"}
			}
		case None:
			false
		}
		IsObject{Props: try props(o, path), Required: try names(o, "required", path), Closed: closed}
	case _:
		BadSchema{Path: Member(path, "type"), Reason: "unknown type " + json.Quoted(kind)}
	}
}

// only fails for a member of o not in allowed.
func only(o stdjson.Object, path string, allowed []string) fails BadSchema {
	for m in o.Members {
		if !has(allowed, m.Key) {
			return BadSchema{Path: Member(path, m.Key), Reason: "not a keyword of this type"}
		}
	}
}

func props(o stdjson.Object, path string) []Prop fails BadSchema {
	let at = Member(path, "properties")
	match json.Get(o, "properties") {
	case Some[stdjson.Value] as p:
		match p.Value {
		case stdjson.Object as members:
			let mut out = []Prop{}
			for m in members.Members {
				if indexOf(out, m.Key) >= 0 {
					return BadSchema{Path: Member(at, m.Key), Reason: "the property is named twice"}
				}
				out = out.Append(Prop{Name: m.Key, S: try read(m.Value, Member(at, m.Key))})
			}
			out
		case _:
			BadSchema{Path: at, Reason: "want an object"}
		}
	case None:
		[]Prop{}
	}
}

// names is the strings of the array member key of o, or none.
func names(o stdjson.Object, key string, path string) []string fails BadSchema {
	let at = Member(path, key)
	match json.Get(o, key) {
	case Some[stdjson.Value] as v:
		match v.Value {
		case stdjson.Array as a:
			let mut out = []string{}
			for i, item in a.Items {
				match item {
				case stdjson.Str as t:
					out = out.Append(t.Value)
				case _:
					return BadSchema{Path: "\(at)[\(i)]", Reason: "want a string"}
				}
			}
			out
		case _:
			BadSchema{Path: at, Reason: "want an array of strings"}
		}
	case None:
		[]string{}
	}
}

// count is the integer member key of o, at least 0, or 0.
func count(o stdjson.Object, key string, path string) int fails BadSchema {
	match json.Get(o, key) {
	case Some[stdjson.Value] as v:
		match v.Value {
		case stdjson.Num as n:
			let c = strconv.Atoi(stdjson.Wire(n)) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return BadSchema{Path: Member(path, key), Reason: "want a whole number"}
			}
			if c < 0 {
				return BadSchema{Path: Member(path, key), Reason: "want a whole number"}
			}
			c
		case _:
			BadSchema{Path: Member(path, key), Reason: "want a whole number"}
		}
	case None:
		0
	}
}

// bound is the number member key of o.
func bound(o stdjson.Object, key string, path string) Option[float64] fails BadSchema {
	match json.Get(o, key) {
	case Some[stdjson.Value] as v:
		match v.Value {
		case stdjson.Num as n:
			Some[float64]{Value: valueOf(stdjson.Wire(n))}
		case _:
			BadSchema{Path: Member(path, key), Reason: "want a number"}
		}
	case None:
		None
	}
}

// ToJSON is s as a JSON value that FromJSON reads back as s. A keyword at
// its default is left out.
func ToJSON(s Schema) stdjson.Value {
	match s {
	case Anything:
		stdjson.Boolean{Value: true}
	case IsNull:
		typeOnly("null")
	case IsBool:
		typeOnly("boolean")
	case IsString as str:
		let mut ms = []stdjson.Member{kindMember("string")}
		if len(str.Enum) > 0 {
			ms = ms.Append(stdjson.Member{Key: "enum", Value: textArray(str.Enum)})
		}
		if str.MinLength > 0 {
			ms = ms.Append(stdjson.Member{Key: "minLength", Value: stdjson.IntNumber(int64(str.MinLength))})
		}
		stdjson.Object{Members: ms}
	case IsNumber as n:
		let mut ms = []stdjson.Member{kindMember(if n.Integer { "integer" } else { "number" })}
		match n.Min {
		case Some[float64] as min:
			ms = ms.Append(stdjson.Member{Key: "minimum", Value: numberOf(min.Value)})
		case None:
		}
		match n.Max {
		case Some[float64] as max:
			ms = ms.Append(stdjson.Member{Key: "maximum", Value: numberOf(max.Value)})
		case None:
		}
		stdjson.Object{Members: ms}
	case IsArray as a:
		let mut ms = []stdjson.Member{kindMember("array")}
		match a.Items {
		case Anything:
		case _:
			ms = ms.Append(stdjson.Member{Key: "items", Value: ToJSON(a.Items)})
		}
		if a.MinItems > 0 {
			ms = ms.Append(stdjson.Member{Key: "minItems", Value: stdjson.IntNumber(int64(a.MinItems))})
		}
		stdjson.Object{Members: ms}
	case IsObject as o:
		let mut ms = []stdjson.Member{kindMember("object")}
		if len(o.Props) > 0 {
			let mut ps = []stdjson.Member{}
			for p in o.Props {
				ps = ps.Append(stdjson.Member{Key: p.Name, Value: ToJSON(p.S)})
			}
			ms = ms.Append(stdjson.Member{Key: "properties", Value: stdjson.Object{Members: ps}})
		}
		if len(o.Required) > 0 {
			ms = ms.Append(stdjson.Member{Key: "required", Value: textArray(o.Required)})
		}
		if o.Closed {
			ms = ms.Append(stdjson.Member{Key: "additionalProperties", Value: stdjson.Boolean{Value: false}})
		}
		stdjson.Object{Members: ms}
	}
}

// numberOf is f as a JSON number. A bound read from JSON is finite
// (valueOf), so ParseNum takes its text; JSON has no number for NaN or an
// infinity, and std json writes those as strings, as this does.
func numberOf(f float64) stdjson.Value {
	let text = formatFloat(f)
	let n = stdjson.ParseNum(text) catch {
	case stdjson.Malformed:
		return stdjson.Str{Value: text}
	}
	n
}

func kindMember(kind string) stdjson.Member { stdjson.Member{Key: "type", Value: stdjson.Str{Value: kind}} }

func typeOnly(kind string) stdjson.Value { stdjson.Object{Members: []stdjson.Member{kindMember(kind)}} }

func textArray(xs []string) stdjson.Value {
	let mut items = []stdjson.Value{}
	for x in xs {
		items = items.Append(stdjson.Str{Value: x})
	}
	stdjson.Array{Items: items}
}
