// Package http1 reads api.Request records from HTTP/1.1 text and writes
// api.Response records as HTTP/1.1 text. Std http's server is Go's
// net/http, which this program keeps out of its binary (gap G-ex-c-7),
// so the server is a filter over standard input and output, as a
// program under inetd or `socat TCP-LISTEN:8080,fork EXEC:deploys` is.

import deploys/api
import option
import strconv
import strings
import deploys/deploys
import io

// Garbled is a text that is not an HTTP/1.1 request. At is its byte
// offset.
type Garbled { At int, Reason string }

// ReadRequest is the request that starts at at in text, and the offset
// after it. A line ends with CRLF or LF. The body is Content-Length
// bytes; with no Content-Length the request has no body. A request
// whose body runs past the end of text fails Garbled.
func ReadRequest(text string, at int) (api.Request, int) fails Garbled {
	let first, afterFirst = try line(text, at)
	let words = strings.Split(first, " ")
	if words.Len() != 3 || words[0] == "" || !strings.HasPrefix(words[1], "/") {
		return Garbled{At: at, Reason: "not a request line"}
	}
	if words[2] != "HTTP/1.1" && words[2] != "HTTP/1.0" {
		return Garbled{At: at, Reason: "not HTTP/1.x: " + words[2]}
	}
	let mut headers = []api.Header{}
	let mut i = afterFirst
	for _ in i..text.Len()+1 {
		let h, next = try line(text, i)
		i = next
		if h == "" {
			break
		}
		match strings.Cut(h, ":") {
		case option.Some[strings.Halves] as kv:
			headers = headers.Append(api.Header{Name: kv.Value.Before, Value: strings.TrimSpace(kv.Value.After)})
		case option.None:
			return Garbled{At: i, Reason: "a header with no ':'"}
		}
	}
	let length = match api.HeaderOf(headers, "Content-Length") {
	case option.Some[string] as n:
		strconv.Atoi(n.Value) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return Garbled{At: i, Reason: "Content-Length is not a number"}
		}
	case option.None:
		0
	}
	if length < 0 || i+length > text.Len() {
		return Garbled{At: i, Reason: "the body is shorter than its Content-Length"}
	}
	let path = match strings.Cut(words[1], "?") {
	case option.Some[strings.Halves] as q:
		q.Value.Before
	case option.None:
		words[1]
	}
	(api.Request{Method: words[0], Path: path, Headers: headers, Body: strings.Slice(text, i, i+length)}, i + length)
}

// RequestRoundTrip: a request a client writes is read back as it was:
// its method, path, headers and body. Sane makes a generated request one
// that HTTP can carry.
law RequestRoundTrip(r api.Request) {
	let s = sane(r)
	let back, end = try ReadRequest(WriteRequest(s), 0)
	sameRequest(back, s) && end == WriteRequest(s).Len()
}

// sane is r made carriable: a method and a path of one token, and
// header names and values with no line end, ':' or space at either end.
func sane(r api.Request) api.Request {
	let mut headers = []api.Header{}
	for h in r.Headers {
		let name = token(h.Name)
		if !strings.EqualFold(name, "Content-Length") {
			headers = headers.Append(api.Header{Name: name, Value: strings.TrimSpace(oneLine(h.Value))})
		}
	}
	api.Request{Method: "M" + token(r.Method), Path: "/" + token(r.Path), Headers: headers, Body: r.Body}
}

// token is text with every byte that is not a letter, a digit or '-'
// removed, and "x" before it.
func token(text string) string {
	let mut out = "x"
	for i in 0..text.Len() {
		let c = text[i]
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' {
			out = out + strings.Slice(text, i, i+1)
		}
	}
	out
}

// oneLine is text with its line ends replaced by spaces.
func oneLine(text string) string { strings.ReplaceAll(strings.ReplaceAll(text, "\r", " "), "\n", " ") }

// sameRequest reports whether a and b are the same request.
func sameRequest(a api.Request, b api.Request) bool {
	if a.Method != b.Method || a.Path != b.Path || a.Body != b.Body {
		return false
	}
	let mut want = b.Headers
	if b.Body != "" {
		want = want.Append(api.Header{Name: "Content-Length", Value: "\(b.Body.Len())"})
	}
	if a.Headers.Len() != want.Len() {
		return false
	}
	for i, h in a.Headers {
		if h != want[i] {
			return false
		}
	}
	true
}

// line is the line at at without its CRLF or LF, and the offset after
// it. A line with no end fails Garbled: the text stopped inside a head.
func line(text string, at int) (string, int) fails Garbled {
	let rest = strings.Slice(text, at, text.Len())
	let end = strings.Index(rest, "\n")
	if end < 0 {
		return Garbled{At: at, Reason: "the head does not end"}
	}
	(strings.TrimSuffix(strings.Slice(rest, 0, end), "\r"), at + end + 1)
}

// WriteResponse is r as HTTP/1.1 text: the status line, the headers in
// order, Content-Length, a blank line and the body. Each line ends with
// CRLF.
func WriteResponse(r api.Response) string {
	let mut out = "HTTP/1.1 \(r.Status) " + api.Reason(r.Status) + "\r\n"
	for h in r.Headers {
		out = out + h.Name + ": " + h.Value + "\r\n"
	}
	out + "Content-Length: \(r.Body.Len())\r\n\r\n" + r.Body
}

// ContentLengthIsTheBody: a written response says the length of its body.
law ContentLengthIsTheBody(status int, body string) {
	strings.HasSuffix(WriteResponse(api.Response{Status: status, Headers: []api.Header{}, Body: body}), "Content-Length: \(body.Len())\r\n\r\n"+body)
}

// WriteRequest is r as HTTP/1.1 text, as a client sends it, with a
// Content-Length when it has a body. ReadRequest reads it back.
func WriteRequest(r api.Request) string {
	let mut out = r.Method + " " + r.Path + " HTTP/1.1\r\n"
	for h in r.Headers {
		out = out + h.Name + ": " + h.Value + "\r\n"
	}
	if r.Body != "" {
		out = out + "Content-Length: \(r.Body.Len())\r\n"
	}
	out + "\r\n" + r.Body
}

// PipelinedRequestsAreAnsweredInOrder: for any Store, n requests sent back
// to back are n responses, and the connection serves them all.
law PipelinedRequestsAreAnsweredInOrder(store deploys.Store, paths []string) {
	pipelinedHolds(store, paths)
}

// pipelinedHolds checks PipelinedRequestsAreAnsweredInOrder: GETs of
// paths, each made a path, written back to back, are answered with one
// status line each.
func pipelinedHolds(store deploys.Store, paths []string) bool {
	let mut text = ""
	for p in paths {
		text = text + WriteRequest(api.Request{Method: "GET", Path: "/" + token(p), Headers: []api.Header{}, Body: ""})
	}
	let out = io.NewRecorder()
	let served = with context { deploys.Store: store, io.Stdout: out } { Serve(text) }
	served == paths.Len() && strings.Count(out.Text(), "HTTP/1.1 ") == paths.Len()
}
