import machines

// Status is where a deploy is in its lifecycle.
type Status = Pending{} | Approved{} | Live{} | Cancelled{}

// NoWayBack: no event leads from a later status to an earlier one: the
// lifecycle only moves forward (Pending, Approved, then Live or Cancelled).
law NoWayBack(s Status, e Event) {
	match Step(s, e) {
	case Enter[Status] as n:
		Rank(n.Next) > Rank(s)
	case Stay[Status] as n:
		Rank(n.Next) == Rank(s)
	case Ignore, Reject:
		true
	}
}

// Rank is how far along s is.
func Rank(s Status) int {
	match s {
	case Pending:
		0
	case Approved:
		1
	case Live, Cancelled:
		2
	}
}

// LiveWasApproved: only an approved deploy is live.
law LiveWasApproved(s Status) {
	match Step(s, Release) {
	case Enter[Status]:
		Name(s) == "approved"
	case Stay[Status], Ignore, Reject:
		true
	}
}

// Event is what a client or an operator does to a deploy.
type Event = Approve{} | Release{} | Cancel{}

// ApproveIsIdempotent: approving twice is approving once.
law ApproveIsIdempotent(s Status) {
	let once = after(s, Approve)
	Name(after(once, Approve)) == Name(once)
}

// after is s after e: the next status, or s when e changes nothing.
func after(s Status, e Event) Status { machines.Next(s, Step(s, e)) }

// Conflict is an event that the deploy's status does not allow.
type Conflict { ID string, Status string, Event string }

// Step is the lifecycle: a pending deploy is approved or cancelled; an
// approved one is released (live) or cancelled; a second approval is
// ignored; a live or a cancelled deploy takes no event. The match names every pair, so a new
// status or event stops the build until its row is written. A deploy
// gives no output and never ends: its output is Never.
func Step(s Status, e Event) Decision[Status, Never] {
	match (s, e) {
	case (Pending, Approve):
		Enter[Status]{Next: Approved}
	case (Pending, Cancel):
		Enter[Status]{Next: Cancelled}
	case (Pending, Release):
		Reject
	case (Approved, Approve):
		Ignore
	case (Approved, Release):
		Enter[Status]{Next: Live}
	case (Approved, Cancel):
		Enter[Status]{Next: Cancelled}
	case (Live | Cancelled, Approve | Release | Cancel):
		Reject
	}
}

// Lifecycle is the lifecycle of one deploy as a machine. Its states and
// events can be listed, so ergo test decides its laws on the whole graph.
type Lifecycle machine[Status, Event] {
	initial: Pending,
	step:    Step,

	// AlwaysCancellable: in every status a deploy can reach, an operator
	// can still cancel it unless it is final.
	law AlwaysCancellable always cancellable,

	// Ends: some run of events ends a deploy; its shortest run prints as
	// a test.
	law Ends sometimes Final,
}

// cancellable reports whether s is final, or a Cancel moves it to
// Cancelled.
func cancellable(s Status) bool {
	if Final(s) {
		return true
	}
	match after(s, Cancel) {
	case Cancelled:
		true
	case Pending, Approved, Live:
		false
	}
}

// Name is the external name of s.
func Name(s Status) string {
	match s {
	case Pending:
		"pending"
	case Approved:
		"approved"
	case Live:
		"live"
	case Cancelled:
		"cancelled"
	}
}

// EventName is the external name of e, the last element of its path.
func EventName(e Event) string {
	match e {
	case Approve:
		"approve"
	case Release:
		"release"
	case Cancel:
		"cancel"
	}
}

// EventNamed is the event of an external name.
func EventNamed(name string) Option[Event] {
	match name {
	case "approve":
		Some[Event]{Value: Approve}
	case "release":
		Some[Event]{Value: Release}
	case "cancel":
		Some[Event]{Value: Cancel}
	case _:
		None
	}
}

// Final reports whether s takes no event.
func Final(s Status) bool {
	match s {
	case Live, Cancelled:
		true
	case Pending, Approved:
		false
	}
}

// FinalTakesNoEvent: a live or a cancelled deploy rejects every event.
law FinalTakesNoEvent(s Status, e Event) {
	if !Final(s) {
		return true
	}
	match Step(s, e) {
	case Reject:
		true
	case Enter[Status], Stay[Status], Ignore:
		false
	}
}
