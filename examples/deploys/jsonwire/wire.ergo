// Package jsonwire is the derived codec over JSON (types.md, Codecs): Text is a Writer that
// writes JSON text, and Reader reads a parsed Value back for
// decode[T](r). Decoding is two phases: Parse checks the whole text and
// fails Malformed (phase 1), then decode builds a T from the Value and
// fails only on its shape (phase 2), so no T is built from a text that is
// not JSON. A union value is an object whose "_tag" member names its
// variant, as Effect's Schema writes it.

import deploys/jsontext
import strconv
import strings
import sync

// Text writes the events it is given as JSON text, in the canonical form
// Encode writes: no white space, members in their order.
type Text { state sync.Ref[writing] }

// writing is the text so far and, for each open list or object, how many
// values or members it holds so far.
type writing { Out []string, Counts []int, InObject []bool }

// NewText is a Text with nothing written.
func NewText() Text { Text{state: sync.NewRef[writing](writing{Out: []string{}, Counts: []int{}, InObject: []bool{}})} }

// Written is the text written so far.
func Written(t Text) string { strings.Join(t.state.Get().Out, "") }

// put writes s, a value: after a comma when it is not the first of its
// list (an object's member has its comma before its key).
func put(t Text, s string) {
	t.state.Update(func(w writing) writing {
		let n = len(w.Counts)
		if n == 0 || w.InObject[n-1] {
			return writing{..w, Out: w.Out.Append(s)}
		}
		let comma = if w.Counts[n-1] > 0 { "," } else { "" }
		let mut counts = w.Counts
		counts[n-1] = counts[n-1] + 1
		writing{..w, Out: w.Out.Append(comma + s), Counts: counts}
	})
}

// open writes s and starts a list or an object.
func open(t Text, s string, object bool) {
	put(t, s)
	t.state.Update(func(w writing) writing {
		writing{..w, Counts: w.Counts.Append(0), InObject: w.InObject.Append(object)}
	})
}

// close ends the open list or object with s.
func close(t Text, s string) {
	t.state.Update(func(w writing) writing {
		let n = len(w.Counts)
		writing{Out: w.Out.Append(s), Counts: w.Counts[:n-1], InObject: w.InObject[:n-1]}
	})
}

func Bool(t Text, b bool)       { put(t, if b { "true" } else { "false" }) }
func Int(t Text, n int64)       { put(t, strconv.FormatInt(n, 10)) }
func Uint(t Text, n uint64)     { put(t, "\(n)") }
func Float(t Text, f float64)   { put(t, strconv.FormatFloat(f, 'g', -1)) }
func String(t Text, s string)   { put(t, jsontext.Quote(s)) }
func BeginList(t Text, n int)   { open(t, "[", false) }
func EndList(t Text)            { close(t, "]") }
func BeginObject(t Text, n int) { open(t, "{", true) }
func EndObject(t Text)          { close(t, "}") }
func Tag(t Text, name string) {
	t.Key("_tag")
	t.String(name)
}

// Key writes a member's name, after a comma when it is not the first.
func Key(t Text, k string) {
	t.state.Update(func(w writing) writing {
		let n = len(w.Counts)
		let comma = if w.Counts[n-1] > 0 { "," } else { "" }
		let mut counts = w.Counts
		counts[n-1] = counts[n-1] + 1
		writing{..w, Out: w.Out.Append(comma + jsontext.Quote(k) + ":"), Counts: counts}
	})
}

// Reader reads a Value for decode[T](r).
type Reader { state sync.Ref[reading] }

// reading is the stack of open lists and objects, the root first, and
// the path of the value last read or begun (Path).
type reading { Frames []frame, Last string }

// frame is an open list or object: its values, the key or index of
// each, the next to read, its own path and, for an object, its "_tag".
type frame { Items []jsontext.Value, Keys []string, At int, Path string, List bool, Tag Option[string] }

// NewReader reads v.
func NewReader(v jsontext.Value) Reader {
	let root = frame{Items: []jsontext.Value{v}, Keys: []string{""}, At: 0, Path: "", List: false, Tag: None}
	Reader{state: sync.NewRef[reading](reading{Frames: []frame{root}, Last: ""})}
}

// pathOf is the path of the member or element k of the value at path.
func pathOf(path string, k string, list bool) string {
	if list {
		return path + "[" + k + "]"
	}
	if path == "" { k } else { path + "." + k }
}

// take is the next value of the innermost frame, which the read passes,
// and records its path.
func take(r Reader) jsontext.Value {
	r.state.Update(func(s reading) reading {
		let n = len(s.Frames)
		let f = s.Frames[n-1]
		let mut frames = s.Frames
		frames[n-1] = frame{..f, At: f.At + 1}
		reading{Frames: frames, Last: pathOf(f.Path, f.Keys[f.At], f.List)}
	})
	let s = r.state.Get()
	let f = s.Frames[len(s.Frames)-1]
	f.Items[f.At-1]
}

// push opens the frame of a list or an object.
func push(r Reader, f frame) {
	r.state.Update(func(s reading) reading { reading{..s, Frames: s.Frames.Append(f)} })
}

func Path(r Reader) string { r.state.Get().Last }

func Bool(r Reader) bool fails WireWrongKind {
	match take(r) {
	case jsontext.Bool as b:
		b.V
	case jsontext.Null, jsontext.Number, jsontext.Str, jsontext.Arr, jsontext.Obj:
		return WireWrongKind{Path: Path(r), Want: "a boolean"}
	}
}

func Int(r Reader) int64 fails WireWrongKind {
	match take(r) {
	case jsontext.Number as n:
		strconv.ParseInt(n.Text, 10, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return WireWrongKind{Path: Path(r), Want: "an integer"}
		}
	case jsontext.Null, jsontext.Bool, jsontext.Str, jsontext.Arr, jsontext.Obj:
		return WireWrongKind{Path: Path(r), Want: "a number"}
	}
}

func Uint(r Reader) uint64 fails WireWrongKind {
	match take(r) {
	case jsontext.Number as n:
		let i = strconv.ParseInt(n.Text, 10, 64) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return WireWrongKind{Path: Path(r), Want: "an unsigned integer"}
		}
		if i < 0 {
			return WireWrongKind{Path: Path(r), Want: "an unsigned integer"}
		}
		uint64(i)
	case jsontext.Null, jsontext.Bool, jsontext.Str, jsontext.Arr, jsontext.Obj:
		return WireWrongKind{Path: Path(r), Want: "a number"}
	}
}

func Float(r Reader) float64 fails WireWrongKind {
	match take(r) {
	case jsontext.Number as n:
		strconv.ParseFloat(n.Text) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return WireWrongKind{Path: Path(r), Want: "a number"}
		}
	case jsontext.Null, jsontext.Bool, jsontext.Str, jsontext.Arr, jsontext.Obj:
		return WireWrongKind{Path: Path(r), Want: "a number"}
	}
}

func String(r Reader) string fails WireWrongKind {
	match take(r) {
	case jsontext.Str as s:
		s.V
	case jsontext.Null, jsontext.Bool, jsontext.Number, jsontext.Arr, jsontext.Obj:
		return WireWrongKind{Path: Path(r), Want: "a string"}
	}
}

func BeginList(r Reader) fails WireWrongKind {
	match take(r) {
	case jsontext.Arr as a:
		let mut keys = []string{}
		for i in 0..len(a.Items) {
			keys = keys.Append(strconv.Itoa(i))
		}
		push(r, frame{Items: a.Items, Keys: keys, At: 0, Path: Path(r), List: true, Tag: None})
	case jsontext.Null, jsontext.Bool, jsontext.Number, jsontext.Str, jsontext.Obj:
		return WireWrongKind{Path: Path(r), Want: "an array"}
	}
}

// BeginObject opens an object; its "_tag" member is a union's tag, which
// Tag gives, not a member More and Key read.
func BeginObject(r Reader) fails WireWrongKind {
	match take(r) {
	case jsontext.Obj as o:
		let mut items = []jsontext.Value{}
		let mut keys = []string{}
		let mut tag Option[string] = None
		for m in o.Fields {
			if m.Name == "_tag" {
				match m.Value {
				case jsontext.Str as s:
					tag = Some[string]{Value: s.V}
					continue
				case jsontext.Null, jsontext.Bool, jsontext.Number, jsontext.Arr, jsontext.Obj:
				}
			}
			items = items.Append(m.Value)
			keys = keys.Append(m.Name)
		}
		push(r, frame{Items: items, Keys: keys, At: 0, Path: Path(r), List: false, Tag: tag})
	case jsontext.Null, jsontext.Bool, jsontext.Number, jsontext.Str, jsontext.Arr:
		return WireWrongKind{Path: Path(r), Want: "an object"}
	}
}

func Tag(r Reader) string fails WireMissingField {
	let s = r.state.Get()
	match s.Frames[len(s.Frames)-1].Tag {
	case Some[string] as t:
		t.Value
	case None:
		WireMissingField{Path: Path(r), Field: "_tag"}
	}
}

func More(r Reader) bool {
	let s = r.state.Get()
	let f = s.Frames[len(s.Frames)-1]
	f.At < len(f.Items)
}

func Key(r Reader) string {
	let s = r.state.Get()
	let f = s.Frames[len(s.Frames)-1]
	f.Keys[f.At]
}

func Skip(r Reader) { _ = take(r) }

// End closes the innermost list or object; Path is its path again.
func End(r Reader) {
	r.state.Update(func(s reading) reading {
		let n = len(s.Frames)
		reading{Frames: s.Frames[:n-1], Last: s.Frames[n-1].Path}
	})
}
