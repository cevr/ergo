import deploys/deploys
import option
import strings

// Route is what a method and a path ask for. Wrong is a known path with
// a method it does not take; Allow lists the methods it takes.
type Route = List{} | Show{ID string} | Create{} | Act{ID string, Event deploys.Event} | Wrong{Allow string} | Nowhere{}

// WrongMethodNamesTheRight: a known path with another method is Wrong,
// and each method it allows reaches that path. The method is one of
// Methods half the time: a generated string is rarely a method.
law WrongMethodNamesTheRight(id string, method string, m int) {
	rightNamed(id, method) && rightNamed(id, Methods[(if m < 0 { -(m + 1) } else { m })%Methods.Len()]) && rightNamed("dep-1", method)
}

// Methods is the methods the API knows, and one it does not.
let Methods = []string{"GET", "POST", "PUT", "DELETE"}

// rightNamed checks WrongMethodNamesTheRight for id and method.
func rightNamed(id string, method string) bool {
	if id == "" || strings.Contains(id, "/") {
		return true
	}
	for path in []string{"/deploys", "/deploys/" + id, "/deploys/" + id + "/approve"} {
		match RouteOf(method, path) {
		case Wrong as w:
			for m in strings.Split(w.Allow, ", ") {
				match RouteOf(m, path) {
				case Wrong, Nowhere:
					return false
				case List, Show, Create, Act:
				}
			}
		case Nowhere:
			return false
		case List, Show, Create, Act:
		}
	}
	true
}

// RouteOf is the route of method and path:
//
//	GET  /deploys              List
//	POST /deploys              Create
//	GET  /deploys/{id}         Show
//	POST /deploys/{id}/{event} Act, event one of approve, release, cancel
//
// A trailing slash is not the same path, as in Go's ServeMux.
func RouteOf(method string, path string) Route {
	let parts = strings.Split(path, "/")
	if parts.Len() < 2 || parts[0] != "" || parts[1] != "deploys" {
		return Nowhere
	}
	match parts.Len() {
	case 2:
		match method {
		case "GET":
			List
		case "POST":
			Create
		case _:
			Wrong{Allow: "GET, POST"}
		}
	case 3:
		if parts[2] == "" {
			return Nowhere
		}
		if method == "GET" {
			Show{ID: parts[2]}
		} else {
			Wrong{Allow: "GET"}
		}
	case 4:
		match deploys.EventNamed(parts[3]) {
		case option.Some[deploys.Event] as e:
			if parts[2] == "" {
				return Nowhere
			}
			if method == "POST" {
				Act{ID: parts[2], Event: e.Value}
			} else {
				Wrong{Allow: "POST"}
			}
		case option.None:
			Nowhere
		}
	case _:
		Nowhere
	}
}

// UnknownPathIs404: a path outside /deploys is 404, whatever the method.
law UnknownPathIs404(method string, path string) {
	if strings.HasPrefix(path, "/deploys") {
		return true
	}
	match RouteOf(method, path) {
	case Nowhere:
		true
	case List, Show, Create, Act, Wrong:
		false
	}
}
