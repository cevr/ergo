import codec
import json
import deploys/deploys

// BadBody is a JSON body of the wrong shape: Field names where, as in
// deploys.Invalid.
type BadBody { Field string, Reason string }

// DeployBody is a deploy as its JSON body: std json derives the text
// from the record, keys lowered ({"id", "service", "status", "total",
// "units": [{"image", "replicas", "mem"}]}). Status is the status's name,
// not the derived form of the union.
type DeployBody { ID string, Service string, Status string, Total int, Units []deploys.Unit }

// ProblemBody is an error's JSON body: {"error": …}, and "field" only
// when the failure names one.
type ProblemBody { Error string, Field json.Optional[string] }

// DeployJSON is the JSON body of o.
func DeployJSON(o deploys.Deploy) DeployBody {
	DeployBody{ID: o.ID, Service: o.Service, Status: deploys.Name(o.Status), Total: o.Total, Units: o.Units}
}

// DeployText is the JSON text of o's body.
func DeployText(o deploys.Deploy) string { json.Encode(json.Codec[DeployBody]{MaxBytes: 1 << 20, MaxDepth: 32}, DeployJSON(o)) }

// ListText is the JSON text of the bodies of all, in their order.
func ListText(all []deploys.Deploy) string {
	let mut bodies = []DeployBody{}
	for o in all {
		bodies = bodies.Append(DeployJSON(o))
	}
	json.Encode(json.Codec[[]DeployBody]{MaxBytes: 1 << 20, MaxDepth: 32}, bodies)
}

// ProblemText is the JSON text of an error's body.
func ProblemText(message string, field string) string {
	let named json.Optional[string] = if field == "" { json.Absent } else { json.Present[string]{Value: field} }
	json.Encode(json.Codec[ProblemBody]{MaxBytes: 1 << 20, MaxDepth: 32}, ProblemBody{Error: message, Field: named})
}

// draftCodec reads a draft's body. Its limits refuse a body longer than
// 1 MiB or nested deeper than 32: a draft is two levels deep.
func draftCodec() json.Codec[deploys.Draft] { json.Codec[deploys.Draft]{MaxBytes: 1 << 20, MaxDepth: 32} }

// DraftOf is the draft that the JSON body text describes:
// {"service": "…", "units": [{"image": "…", "replicas": n, "mem": n}]}.
// std json checks the text (phase 1, Malformed) and decode derives the
// reading from deploys.Draft, so the body's shape cannot drift from the
// type: a member of another name is ignored, as Go's encoding/json
// ignores it, and a missing member or a value of another kind fails with
// its path.
func DraftOf(text string) deploys.Draft fails json.Malformed | BadBody {
	json.Decode(draftCodec(), text) catch {
	case json.Malformed as m:
		return m
	case codec.WireMissingField as m:
		return BadBody{Field: if m.Path == "" { m.Field } else { m.Path + "." + m.Field }, Reason: "is missing"}
	case codec.WireWrongKind as w:
		return BadBody{Field: if w.Path == "" { "body" } else { w.Path }, Reason: "is not " + w.Want}
	}
}

// DraftText is the JSON text of d, which DraftOf reads back: a client's
// body, for tests.
func DraftText(d deploys.Draft) string { json.Encode(draftCodec(), d) }
