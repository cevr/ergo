import json
import deploys/deploys
import option
import strings

// Handle answers r from the Store in the context. Each route is matched
// by name, and each failure of the body and of the domain is caught by
// name and given its status, with no case _: a new failure of the domain
// stops the build until Handle gives it a status.
//
//	400 the body is not JSON
//	404 no such path, or no such deploy
//	405 a known path with another method (Allow lists the methods)
//	409 an event the deploy's status does not allow
//	415 a body that is not application/json
//	422 JSON of the wrong shape, or a draft that breaks a rule
func Handle(r Request) Response needs deploys.Store {
	match RouteOf(r.Method, r.Path) {
	case List:
		Respond(200, ListText(deploys.Store.All()))
	case Show as s:
		let o = deploys.Store.Find(s.ID) catch {
		case deploys.NotFound as n:
			return Problem(404, "no deploy "+n.ID, "")
		}
		Respond(200, DeployText(o))
	case Create:
		let d = draftOf(r) catch {
		case Unsupported as u:
			return Problem(415, "the body is "+u.Type+", not application/json", "")
		case json.Malformed as m:
			return Problem(400, "the body is not JSON: \(m.Reason) at byte \(m.Offset)", "")
		case BadBody as b:
			return Problem(422, b.Reason, b.Field)
		}
		let o = deploys.Create(d) catch {
		case deploys.Invalid as i:
			return Problem(422, i.Reason, i.Field)
		}
		let created = Respond(201, DeployText(o))
		Response{..created, Headers: created.Headers.Append(Header{Name: "Location", Value: "/deploys/" + o.ID})}
	case Act as a:
		let o = deploys.Apply(a.ID, a.Event) catch {
		case deploys.NotFound as n:
			return Problem(404, "no deploy "+n.ID, "")
		case deploys.Conflict as c:
			return Problem(409, "deploy \(c.ID) is \(c.Status) and cannot \(c.Event)", "")
		}
		Respond(200, DeployText(o))
	case Wrong as w:
		let p = Problem(405, r.Method+" is not allowed here", "")
		Response{..p, Headers: p.Headers.Append(Header{Name: "Allow", Value: w.Allow})}
	case Nowhere:
		Problem(404, "no route "+r.Method+" "+r.Path, "")
	}
}

// CreateThenShow: for any Store, a valid draft posted is 201 with a
// Location, and a GET of the Location is 200 with the same body; an
// invalid one is 422.
law CreateThenShow(store deploys.Store, d deploys.Draft) { createThenShowHolds(store, d) }

// createThenShowHolds checks CreateThenShow.
func createThenShowHolds(store deploys.Store, d deploys.Draft) bool {
	with context { deploys.Store: store } {
		let created = Handle(Request{Method: "POST", Path: "/deploys", Headers: []Header{}, Body: DraftText(d)})
		deploys.Validate(d) catch {
		case deploys.Invalid:
			return created.Status == 422
		}
		match HeaderOf(created.Headers, "Location") {
		case option.Some[string] as at:
			let shown = Handle(Request{Method: "GET", Path: at.Value, Headers: []Header{}, Body: ""})
			created.Status == 201 && shown.Status == 200 && shown.Body == created.Body
		case option.None:
			false
		}
	}
}

// Unsupported is a body of another media type.
type Unsupported { Type string }

// draftOf is the draft r's body describes. A Content-Type header, when
// there is one, is application/json, with any parameters.
func draftOf(r Request) deploys.Draft fails Unsupported | json.Malformed | BadBody {
	match HeaderOf(r.Headers, "Content-Type") {
	case option.Some[string] as t:
		let media = strings.TrimSpace(strings.Split(t.Value, ";")[0])
		if !strings.EqualFold(media, "application/json") {
			return Unsupported{Type: media}
		}
	case option.None:
	}
	try DraftOf(r.Body)
}

// Respond is a response of status with the JSON text body.
func Respond(status int, body string) Response {
	Response{Status: status, Headers: []Header{Header{Name: "Content-Type", Value: "application/json"}}, Body: body}
}

// Problem is an error response: {"error": message}, and "field" when the
// failure names one.
func Problem(status int, message string, field string) Response {
	Respond(status, ProblemText(message, field))
}
