// The receipts of plan §20.5 that the machine alone gives (FD3a): P1, the
// requests of a typing script, as Fetch effects on the manual clock; P6
// and P7, what the state holds per candidate and what a session holds,
// in one session test; P8, the
// work of choosing an order. The counts are exact: they are the
// machine's own counters (Fetches, Checked, Comparisons) and the cache's
// SettledCount, never a time. The live-heap forms of P6 and P7 wait for
// the view on TestHost (FD5).

import domain-search/domains
import domain-search/search/cache
import domain-search/search/route
import option

// Held is how many values the state holds per candidate: the rows of a
// listed index and the listings shown.
func Held(s Search) int {
	let mut n = match s.Index {
	case Identity:
		0
	case Listed as l:
		l.Rows.Len()
	}
	for _, p in s.Pages {
		n = n + p.Len()
	}
	n
}

// prefixes types text one prefix at a time, each left to settle (its
// answers given) and then gap ms more.
func prefixes(m Sim, texts []string, gap int) Sim {
	let mut at = m
	for t in texts {
		at = Wait(Settle(Feed(at, Typed{Text: t})), gap)
	}
	at
}

// P1: four typing scripts. A settled cold query makes 2 requests and a
// burst 2 (BurstMakesOneSearch); seven prefixes each left to settle make
// 14; three backspaces and the same three keys, each settling, inside the
// minute, make none: every range is a fresh hit, and the count does not
// depend on the host.
test TypingScriptsMakeFewRequests {
	let cold = Settle(Feed(page(), Typed{Text: "foldkit"}))
	assert cold.Fetches.Len() == 2
	let settled = prefixes(page(), []string{"f", "fo", "fol", "fold", "foldk", "foldki", "foldkit"}, 250)
	assert settled.Fetches.Len() == 14
	let retyped = prefixes(settled, []string{"foldki", "foldk", "fold", "foldk", "foldki", "foldkit"}, 250)
	assert retyped.Fetches.Len() == 14 && retyped.S.Checked == 60
}

// P6 and P7: a session of one more distinct settled query than the cache
// holds holds what a session of the cache's capacity holds: the cache
// keeps its capacity of settled answers, and the state holds per
// candidate only the page it shows (Held is 60, the first page). One
// query past the capacity is the least that shows the bound: the eviction
// it makes is the one a longer session repeats. The bound is the cache's
// own (the cache laws hold it at any capacity), so the session runs on a
// cache of capacity 3, not the page's Capacity(), and makes 4 queries
// rather than 101.
test ASessionIsBounded {
	let capacity = 3
	let n = capacity + 1
	let opened = page()
	let mut m = Sim{..opened, S: Search{..opened.S, Cache: cache.New[string, []domains.Listing](Freshness(), capacity)}}
	let mut full = m
	for i in 0..n {
		m = Settle(Feed(m, Typed{Text: "q\(i)"}))
		if i == capacity-1 {
			full = m
		}
	}
	assert cache.SettledCount(full.S.Cache) == capacity && cache.SettledCount(m.S.Cache) == capacity
	assert Held(full.S) == Held(m.S) && Held(m.S) == 60
	assert m.Fetches.Len() == 2*n
}

// P8: choosing a price order makes one request, the whole catalog, and
// one sort of the index after it: at most n * ceil(log2 n) comparisons.
test ChoosingAnOrderMakesOneRequestAndOneSort {
	let acme = Settle(Feed(page(), Typed{Text: "acme"}))
	assert acme.S.Comparisons == 0
	let chosen = Feed(acme, Ordered{Order: route.PriceAscending})
	assert chosen.Fetches.Len() == 3 && fetched(chosen, 2, "acme", 0, 556) && chosen.S.Comparisons == 0
	let done = Settle(chosen)
	let n = domains.Catalog.Len()
	assert done.Fetches.Len() == 3 && done.S.Comparisons > 0 && done.S.Comparisons <= n*10
	// The index lists the available listings by price, then the taken.
	let mut last = 0.0
	let mut takenSeen = false
	for i in 0..Rows(done.S.Index) {
		match ListingAt(done.S, At(done.S.Index, i)) {
		case option.Some[domains.Listing] as l:
			match l.Value {
			case domains.Available as a:
				assert !takenSeen && a.Price >= last
				last = a.Price
			case domains.Unavailable:
				takenSeen = true
			}
		case option.None:
			assert false
		}
	}
}
