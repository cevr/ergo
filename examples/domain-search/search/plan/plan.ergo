// Package plan is domain-search' range planner (plan §20.2), a pure
// function: from what is loaded, what the window shows, the order and
// the filter to the next range of the catalog to ask the registry for.
// The ranges: the top four, the rest of the first page of 60, then pages
// of 60; or the whole catalog when the order or the filter
// needs every price. One range loads at a time.
//
// Its work does not depend on the catalog's size: it reads the rows the
// window shows and the state of their ranges, and the caller keeps the
// counts that would need a scan (Checked, InFlight). Steps counts it.

import domain-search/search/route
import option

// Range is Limit listings of the catalog from Offset.
type Range { Offset int, Limit int }

// End is the listing after the range's last.
func End(r Range) int { r.Offset + r.Limit }

// Load is what is known of a range.
type Load = NotLoaded{} | Loading{} | Loaded{} | Failed{}

// TopCount is the size of the first range; PageSize ends the second and
// is the size of the others.
func TopCount() int { 4 }

func PageSize() int { 60 }

// Count is the number of ranges a catalog of n listings has.
func Count(n int) int {
	if n <= TopCount() {
		return 1
	}
	if n <= PageSize() {
		return 2
	}
	2 + (n-PageSize()+PageSize()-1)/PageSize()
}

// RangesNeverOverlap: the ranges cut the catalog into pieces that follow
// each other from 0 to its end, and IndexOf finds each listing's piece.
law RangesNeverOverlap(n int where 1 <= n && n <= 100000) {
	let mut at = 0
	for k in 0..Count(n) {
		let r = RangeAt(n, k)
		if r.Offset != at || r.Limit < 1 || IndexOf(r.Offset) != k || IndexOf(End(r)-1) != k {
			return false
		}
		at = End(r)
	}
	at == n
}

// PlanCoversWindow: loading what the planner asks for, until it asks for
// nothing, loads every listing the window shows, one range at a time.
law PlanCoversWindow(n int where 1 <= n && n <= 20000, start int where 0 <= start && start <= 20000, count int where 1 <= count && count <= 80) {
	let wanted = rows(n, start, count)
	let mut st = fresh(n, wanted, false)
	for _ in 0..Count(n)+1 {
		match Next(st).Next {
		case option.None:
			break
		case option.Some[Range] as r:
			st = settle(st, r.Value)
		}
	}
	for i in wanted {
		match st.Ranges[IndexOf(i)] {
		case Loaded:
		case NotLoaded, Loading, Failed:
			return false
		}
	}
	true
}

// fresh is the input of a catalog of n with nothing loaded and the window
// showing wanted.
func fresh(n int, wanted []int, whole bool) Input {
	let mut ranges = []Load{}
	for _ in 0..Count(n) {
		ranges = ranges.Append(NotLoaded)
	}
	Input{Size: n, Ranges: ranges, Whole: NotLoaded, Checked: 0, InFlight: false, Wanted: wanted, NeedsWhole: whole}
}

// settle is st after r loaded: the whole catalog, or the range of r.
func settle(st Input, r Range) Input {
	if r.Offset == 0 && r.Limit == st.Size && Count(st.Size) > 1 {
		return Input{..st, Whole: Loaded, Checked: st.Size}
	}
	let mut ranges = st.Ranges
	ranges[IndexOf(r.Offset)] = Loaded
	Input{..st, Ranges: ranges, Checked: st.Checked + r.Limit}
}

// rows are the listings start to start+count-1 that a catalog of n holds.
func rows(n int, start int, count int) []int {
	let mut out = []int{}
	for i in start..start+count {
		if i >= 0 && i < n {
			out = out.Append(i)
		}
	}
	out
}

// RangeAt is range k of a catalog of n listings.
func RangeAt(n int, k int) Range {
	if k == 0 {
		return Range{Offset: 0, Limit: if n < TopCount() { n } else { TopCount() }}
	}
	if k == 1 {
		let end = if n < PageSize() { n } else { PageSize() }
		return Range{Offset: TopCount(), Limit: end - TopCount()}
	}
	let offset = (k - 1) * PageSize()
	let rest = n - offset
	Range{Offset: offset, Limit: if rest < PageSize() { rest } else { PageSize() }}
}

// StepWorkIsFlat: the planner takes the same steps for the same window
// and the same loads around it at 556, 1,000, 10,000 and 100,000
// listings: its work does not grow with the catalog.
law StepWorkIsFlat(start int where 0 <= start && start <= 400, count int where 1 <= count && count <= 80, loaded int where 0 <= loaded && loaded <= 9) {
	let sizes = []int{556, 1000, 10000, 100000}
	let mut steps = []int{}
	for n in sizes {
		let mut st = fresh(n, rows(n, start, count), false)
		for k in 0..loaded {
			st = settle(st, RangeAt(n, k))
		}
		steps = steps.Append(Next(st).Steps)
	}
	steps[0] == steps[1] && steps[1] == steps[2] && steps[2] == steps[3]
}

// IndexOf is the range that holds listing i.
func IndexOf(i int) int {
	if i < TopCount() {
		return 0
	}
	if i < PageSize() {
		return 1
	}
	1 + i/PageSize()
}

// NeedsWhole is whether the order or the filter needs every listing
// loaded before it shows any: a price order, or available only.
func NeedsWhole(order route.Order, availableOnly bool) bool {
	match order {
	case route.PriceAscending, route.PriceDescending:
		true
	case route.Relevance, route.Length, route.Alphabetical:
		availableOnly
	}
}

// PriceOrderLoadsWhole: a price order or the available filter asks for
// the whole catalog in one range; the other orders ask for the top four.
law PriceOrderLoadsWhole(order int, availableOnly bool, n int where 5 <= n && n <= 100000) {
	let o = pick(route.Orders, order)
	let whole = NeedsWhole(o, availableOnly)
	let expected = match o {
	case route.PriceAscending, route.PriceDescending:
		true
	case route.Relevance, route.Length, route.Alphabetical:
		availableOnly
	}
	let next = Next(fresh(n, rows(n, 0, 10), whole)).Next
	whole == expected && next == option.Some[Range]{Value: if whole { Range{Offset: 0, Limit: n} } else { Range{Offset: 0, Limit: 4} }}
}

func pick[T](xs []T, n int) T { xs[((n%xs.Len())+xs.Len())%xs.Len()] }

// Input is what the planner reads. Size is the catalog's size; Ranges has
// one Load per range (Count(Size)); Whole is the load of the whole
// catalog as one range; Checked is how many listings are loaded; InFlight
// is whether a load is running; Wanted are the catalog indices of the
// listings the window shows, in the order it shows them; NeedsWhole is
// NeedsWhole of the order and the filter.
type Input { Size int, Ranges []Load, Whole Load, Checked int, InFlight bool, Wanted []int, NeedsWhole bool }

// PlanEnds: scrolling a window of 30 rows down the whole catalog, at most
// 30 rows a step so that no row is skipped, loads
// it in at most ceil(n/60)+2 requests, and asks for no range twice. A
// catalog of up to 2,000 has every range shape (a short top, the rest of
// the first page, whole pages, a short last page); a step costs work in
// proportion to n/step, so a larger n adds work, not shapes.
law PlanEnds(n int where 1 <= n && n <= 2000, step int where 1 <= step && step <= 30) {
	let mut st = fresh(n, []int{}, false)
	let mut asked = 0
	let mut at = 0
	for at < n+step {
		st = Input{..st, Wanted: rows(n, at, 30)}
		for _ in 0..Count(n)+1 {
			match Next(st).Next {
			case option.None:
				break
			case option.Some[Range] as r:
				match st.Ranges[IndexOf(r.Value.Offset)] {
				case NotLoaded:
				case Loaded, Loading, Failed:
					return false
				}
				asked = asked + 1
				st = settle(st, r.Value)
			}
		}
		at = at + step
	}
	asked <= (n+59)/60+2 && st.Checked == n
}

// Planned is the next range to load, if any, and the steps the planner
// took to find it.
type Planned { Next option.Option[Range], Steps int }

// Next is the range to load next: none while a load runs or once every
// listing is loaded; the whole catalog when NeedsWhole (unless that load
// failed: a retry asks again); else the range of the first listing the
// window shows that is not loaded, unless that range failed, which waits
// for a retry.
func Next(st Input) Planned {
	if st.InFlight || st.Checked >= st.Size {
		return Planned{Next: option.None, Steps: 1}
	}
	match st.Whole {
	case Loaded, Loading:
		return Planned{Next: option.None, Steps: 1}
	case Failed:
		if st.NeedsWhole {
			return Planned{Next: option.None, Steps: 1}
		}
	case NotLoaded:
		if st.NeedsWhole {
			return Planned{Next: option.Some[Range]{Value: Range{Offset: 0, Limit: st.Size}}, Steps: 1}
		}
	}
	let mut steps = 1
	for i in st.Wanted {
		steps = steps + 1
		let k = IndexOf(i)
		match st.Ranges[k] {
		case Loaded:
		case NotLoaded:
			return Planned{Next: option.Some[Range]{Value: RangeAt(st.Size, k)}, Steps: steps}
		case Loading, Failed:
			return Planned{Next: option.None, Steps: steps}
		}
	}
	Planned{Next: option.None, Steps: steps}
}

// FirstIsFourThenFiftySix: a cold search of a catalog of more than a page
// asks for the top four, then the rest of the first page ({0,4}
// then {4,56}, fact 3 of §20.1).
law FirstIsFourThenFiftySix(n int where 61 <= n && n <= 100000, count int where 5 <= count && count <= 80) {
	let st = fresh(n, rows(n, 0, count), false)
	let first = Next(st).Next
	let want = Range{Offset: 0, Limit: 4}
	if first != (option.Some[Range]{Value: want}) {
		return false
	}
	Next(settle(st, want)).Next == option.Some[Range]{Value: Range{Offset: 4, Limit: 56}}
}
