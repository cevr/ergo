// Package loopback builds the generated clients of a registry its caller
// passes in, served in this process: NewLoopback's RPC client crosses
// Effect RPC's HTTP wire and the contract's codecs both ways
// (rpc.Loopback), and NewHub's hub client carries each Request to a Call
// on it. `ergo test` runs the domains.Registry laws against both, under
// the contexts tests.ergo binds, as against sample: the laws hold through
// each.

import rpc
import domain-search/domains
import domain-search/domains/domainsapi
import domain-search/domains/domainsrpc

// NewLoopback serves inner in process and is its RPC client. It takes the
// registry it serves and picks none: tests.ergo picks a sample, as an
// entry would pick its registry (lint with-at-entry).
func NewLoopback(inner domains.Registry) domainsrpc.Client {
	domainsrpc.NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		with context { domains.Registry: inner } {
			try domainsrpc.Handle(tag, payload)
		}
	}))
}

// NewHub is the hub client of inner: each Request is a Call with inner
// bound, so its laws hold exactly when inner's and Call's do.
func NewHub(inner domains.Registry) domainsapi.Client {
	domainsapi.NewClient(func(r domainsapi.Request) domainsapi.Outcome {
		with context { domains.Registry: inner } { domainsapi.Call(r) }
	})
}
