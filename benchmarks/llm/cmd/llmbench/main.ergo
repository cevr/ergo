// llmbench holds std llm's counted probes (wf10 L1), each with a hand Go
// twin in ../../testdata/control and a floor in ../../testdata/floor; a
// workload per kind in ../../KIND (go run ./scripts/opcount -control
// -rounds 5 benchmarks/llm/KIND).
//
//	llmbench bench KIND N
//
// KIND fold: N text deltas, in replies of 64, each reply folded by
// llm.Fold into its text. One unit is one delta: the cost of a streamed
// token from its delta to the reply's text.

import llm
import os
import strconv

let part = 64

let words = []string{"the ", "model ", "said ", "a ", "few ", "short ", "words ", "now "}

// reply is the 64 text deltas of reply r.
func reply(r int) []llm.Delta {
	let mut ds = []llm.Delta{}
	for i in 0..part {
		ds = ds.Append(llm.Text{Text: words[(r + i) & 7]})
	}
	ds
}

func bench(kind string, n int) int {
	let mut t = 0
	if kind == "fold" {
		for r in 0..n / part {
			t = t + len(llm.Fold(reply(r)).Text)
		}
	}
	t
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost() } {
		let args = os.Process.Args()
		if len(args) != 3 {
			return os.Exit{Code: 2, Message: "usage: llmbench bench KIND N"}
		}
		let n = strconv.Atoi(args[2]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "llmbench: N is not a count"}
		}
		Console.Println("\(bench(args[1], n))")
	}
}
