// loosebench holds std json's loose reader's counted probe (wf10 JL), with
// a hand Go twin in ../../testdata/control and a floor in
// ../../testdata/floor; the workload is ../../fenced (go run
// ./scripts/opcount -control -rounds 5 benchmarks/jsonloose/fenced).
//
//	loosebench bench KIND N
//
// KIND fenced: a model's reply, a sentence and a markdown fence around a
// record's JSON, read N times by json.DecodeLoose. One unit is one reply.
//
// KIND strict and decode: the record's strict JSON read N times by
// json.DecodeLoose and by json.Decode; the two counts give the cost of
// the loose reader on a strict text over the strict decoder's.

import json
import os
import strconv

type box { Label string, Count int, Tags []string, Weight float64 }

let strict = "{\"label\":\"crate\",\"count\":12,\"tags\":[\"wood\",\"heavy\"],\"weight\":30.5}"

let fenced = "Sure! Here is the record:\n```json\n" + strict + "\n```\n"

let codec = json.Codec[box]{MaxBytes: 0, MaxDepth: 0}

// bench is the sum of the counts of N reads, or -1 when a read fails.
func bench(kind string, n int) int {
	let mut sum = 0
	for _ in 0..n {
		if kind == "decode" {
			let b = json.Decode(codec, strict) catch {
			case _:
				return -1
			}
			sum = sum + b.Count
		} else {
			let text = if kind == "fenced" { fenced } else { strict }
			let r = json.DecodeLoose(codec, text) catch {
			case _:
				return -1
			}
			sum = sum + r.Value.Count
		}
	}
	sum
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost() } {
		let args = os.Process.Args()
		if len(args) != 3 {
			return os.Exit{Code: 2, Message: "usage: loosebench bench KIND N"}
		}
		let n = strconv.Atoi(args[2]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "loosebench: N is not a count"}
		}
		Console.Println("\(bench(args[1], n))")
	}
}
