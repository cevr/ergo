// indentbench is PORT-E-JSONINDENT's speed receipt: json.Indent of a list
// of N records, each with a number, a string, a list and an empty object,
// indented by two spaces (go run ./scripts/opcount -control
// benchmarks/jsonindent/indent). It prints the indented text's length and
// its FNV-1a hash, which the hand Go twin, encoding/json's Indent over
// the same text (../../testdata/control), prints too: the same output,
// byte for byte.
//
//	indentbench bench N

import json
import os
import strconv
import strings

// source is the compact text of n records.
func source(n int) string {
	let mut b = strings.NewBuilder()
	b.WriteString("[")
	for i in 0..n {
		if i > 0 {
			b.WriteString(",")
		}
		b.WriteString("{\"id\":\(i),\"name\":\"n\(i)\",\"tags\":[\"a\",\"b\\\"c\"],\"m\":{}}")
	}
	b.WriteString("]")
	b.String()
}

// fnv is the 64-bit FNV-1a hash of s.
func fnv(s string) uint64 {
	let mut h uint64 = 14695981039346656037
	for i in 0..len(s) {
		h = (h ^ uint64(s[i])) * 1099511628211
	}
	h
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost() } {
		let args = os.Process.Args()
		if len(args) != 3 || args[1] != "bench" {
			return os.Exit{Code: 2, Message: "usage: indentbench bench N"}
		}
		let n = strconv.Atoi(args[2]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "indentbench: N is not a count"}
		}
		let out = json.Indent(source(n), "", "  ") catch {
		case json.Malformed:
			return os.Exit{Code: 1, Message: "indentbench: malformed"}
		}
		Console.Println("\(len(out)) \(fnv(out))")
	}
}
