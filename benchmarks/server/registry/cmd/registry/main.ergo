// registry serves the package mirror's Api (package api) over HTTP. It
// prints the address it listens on first, so a client (scripts/
// servercount) can find it, and serves until it is stopped. This binary
// is the only place that chooses the Pins provider: memory's Table.

import flag
import http
import io
import os
import registry/api
import registry/catalog
import registry/memory

let addrFlag = flag.String("addr", "127.0.0.1:0", "the address to listen on (port 0 picks a free one)")

let set = flag.Set{
	Name:  "registry",
	Usage: "registry serves a package mirror: its catalog, its clients' pins, its status and a signed hook.",
	Flags: []flag.Flag{addrFlag},
	Args:  []flag.ArgSpec{},
}

// limits are the server's budgets, the same in control/ and floor/: a
// body is at most api.MaxBody bytes.
let limits = http.Limits{MaxBodyBytes: api.MaxBody, MaxHeaderBytes: 16384, IdleTimeout: 1m, ReadHeaderTimeout: 10s, ReadBodyTimeout: 30s}

func main() fails os.Exit needs Ambient {
	let v = with context { os.Process: os.NewHost(), io.Stdout: io.NewHost(), io.Stderr: io.NewErrors() } {
		flag.Parse(set, os.Process.Args()) catch {
		case err:
			try flag.Exit(err, flag.Usage(set))
			return
		}
	}
	let l = http.Listen(addrFlag.Get(v)) catch {
	case http.ListenFailed as f:
		return os.Exit{Code: 1, Message: "registry: cannot listen on \(f.Addr): \(f.Reason)"}
	}
	with context { io.Stdout: io.NewHost() } {
		io.Stdout.Println("listening \(l.Addr())")
	}
	with context { Scheduler: NewLiveScheduler(), catalog.Pins: memory.NewTable() } {
		http.Serve(l, limits, api.Handle) catch {
		case http.InvalidLimits:
			return os.Exit{Code: 2, Message: "registry: the server's limits are not positive"}
		}
	}
}
