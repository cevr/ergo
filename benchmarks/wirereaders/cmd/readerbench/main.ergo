// readerbench holds the counted probe of the decoders on the prelude's
// Reader interface (PORT-WIRE-READERS R1), with a hand Go twin in
// ../../testdata/control; the workloads are ../../record and ../../list
// (go run ./scripts/opcount -control -rounds 5 benchmarks/wirereaders/record).
//
//	readerbench bench KIND N
//
// KIND record: a record's JSON read N times; KIND list: a list of four
// records read N times. Each read opens the text with json.Open and
// decodes it by take, whose reader is the Reader interface, so the
// decoder that runs is the interface one (ergoDecode*), not the direct
// one json.Decode takes. One unit is one read. KIND map, mapstream and
// mapreplay read a Map of four keys N times (JSON-CURSOR-ALLOC), from a
// json.Reader, a json.Stream and a codec.Replay; the workloads are
// ../../map, ../../mapstream and ../../mapreplay. KIND omittable reads
// a record with a missing or present optional field.

import codec
import io
import json
import os
import strconv
import strings

type box { Label string, Count int, Tags []string, Weight float64 }

type crate { Count int, Extra json.Optional[int] }

func takeCrate(r Reader) crate fails wired[crate] {
	decode[crate](r)
}

func omittableSum(n int) int {
	let mut sum = 0
	for i in 0..n {
		let text = if i % 2 == 0 { "{\"count\":12}" } else { "{\"count\":12,\"extra\":3}" }
		let r = json.Open(text, 0, 0) catch {
		case _:
			return -1
		}
		let c = takeCrate(r) catch {
		case _:
			return -1
		}
		sum = sum + c.Count
		match c.Extra {
		case json.Absent:
		case json.Present[int] as x:
			sum = sum + x.Value
		}
	}
	sum
}

let one = "{\"label\":\"crate\",\"count\":12,\"tags\":[\"wood\",\"heavy\"],\"weight\":30.5}"

let four = "[" + one + "," + one + "," + one + "," + one + "]"

func takeBox(r Reader) box fails wired[box] {
	decode[box](r)
}

func takeList(r Reader) []box fails wired[[]box] {
	decode[[]box](r)
}

// A Map of four keys (JSON-CURSOR-ALLOC): its decode keeps each key, so
// each is a copy (stdlib.md json 2).
let counts = "{\"crate\":12,\"barrel\":3,\"sack\":40,\"chest\":1}"

func takeMap(r Reader) Map[string, int] fails wired[Map[string, int]] {
	decode[Map[string, int]](r)
}

// mapSum is the sum of the values of N reads of counts from the reader
// mode names (json a json.Reader, stream a json.Stream over the text in
// memory, replay a codec.Replay of its events), or -1 when one fails.
func mapSum(mode string, n int) int {
	let e = codec.NewEvents()
	let first = json.Decode(json.Codec[Map[string, int]]{MaxBytes: 0, MaxDepth: 0}, counts) catch {
	case _:
		return -1
	}
	encode(first, e)
	let events = codec.Recorded(e)
	let mut sum = 0
	for _ in 0..n {
		let m = if mode == "stream" {
			takeMap(json.NewStream(io.CutAt(counts, []int{}), 0, 0)) catch {
			case _:
				return -1
			}
		} else if mode == "replay" {
			takeMap(codec.NewReplay(events)) catch {
			case _:
				return -1
			}
		} else {
			let r = json.Open(counts, 0, 0) catch {
			case _:
				return -1
			}
			takeMap(r) catch {
			case _:
				return -1
			}
		}
		for _, v in m {
			sum = sum + v
		}
	}
	sum
}

// valueSum is the count of members of N json.Decode reads of counts as a
// json.Value: each Num keeps its own digits (stdlib.md json 2), or -1
// when one fails.
func valueSum(n int) int {
	let mut sum = 0
	for _ in 0..n {
		let v = json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, counts) catch {
		case _:
			return -1
		}
		match v {
		case json.Object as o:
			sum = sum + len(o.Members)
		case _:
		}
	}
	sum
}

// bench is the sum of the counts of N reads, or -1 when a read fails.
func bench(kind string, n int) int {
	if kind == "omittable" {
		return omittableSum(n)
	}
	if kind == "value" {
		return valueSum(n)
	}
	if kind == "map" || kind == "mapstream" || kind == "mapreplay" {
		return mapSum(strings.TrimPrefix(kind, "map"), n)
	}
	let mut sum = 0
	for _ in 0..n {
		let text = if kind == "list" { four } else { one }
		let r = json.Open(text, 0, 0) catch {
		case _:
			return -1
		}
		if kind == "list" {
			let bs = takeList(r) catch {
			case _:
				return -1
			}
			for b in bs {
				sum = sum + b.Count
			}
		} else {
			let b = takeBox(r) catch {
			case _:
				return -1
			}
			sum = sum + b.Count
		}
	}
	sum
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost() } {
		let args = os.Process.Args()
		if len(args) != 3 {
			return os.Exit{Code: 2, Message: "usage: readerbench bench KIND N"}
		}
		let n = strconv.Atoi(args[2]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "readerbench: N is not a count"}
		}
		Console.Println("\(bench(args[1], n))")
	}
}
