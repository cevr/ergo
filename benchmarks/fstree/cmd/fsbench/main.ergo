// fsbench holds std fs's tree functions' counted probe (CAP-FS2), with a
// hand Go twin in ../../testdata/control; the workload is ../../walk
// (go run ./scripts/opcount -control -rounds 5 benchmarks/fstree/walk).
//
//	fsbench bench N
//
// N files, ten to a directory, appended under tree/ in the working
// directory, then one fs.Walk of tree and one fs.RemoveAll of it; one unit
// is one file. It prints the number of paths the walk listed, so the
// twin's output is checked against it. Walk and RemoveAll are functions
// over fs.Files and fs.Writes (decision O8), so this is their cost
// against Go's filepath.WalkDir and os.RemoveAll.

import fs
import os
import strconv

// bench makes the tree, walks it, removes it and gives the walk's length.
func bench(n int) int fails fs.NotFound | fs.Denied | fs.Failed needs fs.Files | fs.Writes {
	for i in 0..n {
		let dir = "tree/d" + strconv.Itoa(i / 10)
		if i % 10 == 0 {
			try fs.Writes.MkdirAll(dir)
		}
		try fs.Writes.AppendFile(dir + "/f" + strconv.Itoa(i), "x")
	}
	let walked = try fs.Walk("tree")
	try fs.RemoveAll("tree")
	len(walked)
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost(), fs.Files: fs.NewHost(), fs.Writes: fs.NewHost() } {
		let args = os.Process.Args()
		if len(args) != 2 || args[0] != "bench" {
			return os.Exit{Code: 2, Message: "usage: fsbench bench N"}
		}
		let n = strconv.Atoi(args[1]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "fsbench: N is not a count"}
		}
		let walked = bench(n) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return os.Exit{Code: 1, Message: "fsbench: the tree failed"}
		}
		Console.Println("\(walked)")
	}
}
