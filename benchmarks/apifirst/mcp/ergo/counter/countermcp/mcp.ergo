import api
import json
import mcp
import rpc
import mcpbench/counter
import mcpbench/counter/counterapi

// Request is one call of counter.Counter: the hub's Request.
type Request = counterapi.Request

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

func textOf(v json.Value) string { json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, v) }

func untagged(v json.Value) json.Value {
	match v {
	case json.Object as o:
		let mut members = []json.Member{}
		for m in o.Members {
			if m.Key != "_tag" {
				members = members.Append(m)
			}
		}
		json.Object{Members: members}
	case json.Null, json.Boolean, json.Num, json.Str, json.Array:
		v
	}
}

// Names are the tools' names, one per operation of counter.Counter, in its order.
let Names = []string{"add", "get"}

// Description is what the tool name does: its operation's doc comment,
// or its signature (the hub's Doc).
func Description(name string) string {
	match name {
	case "add":
		counterapi.Doc(counterapi.AddOp)
	case "get":
		counterapi.Doc(counterapi.GetOp)
	case _:
		""
	}
}

// Input is the JSON schema of the tool name's arguments (the hub's
// Schema; an object schema with no properties for a name that is no
// tool's).
func Input(name string) json.Value {
	match name {
	case "add":
		counterapi.Schema(counterapi.AddOp)
	case "get":
		counterapi.Schema(counterapi.GetOp)
	case _:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	}
}

// Call is the Request that a call of the tool name with arguments asks
// for: arguments that are not the tool's fail ToolError, a name that is
// no tool's UnknownTool.
func Call(name string, arguments json.Value) Request fails mcp.ToolError | mcp.UnknownTool {
	let text = match name {
	case "add":
		rpc.Tagged("AddRequest", "{\"entry\":"+textOf(arguments)+"}")
	case "get":
		rpc.Tagged("GetRequest", textOf(arguments))
	case _:
		return mcp.UnknownTool{Name: name}
	}
	rpc.Decode[Request]("arguments of "+name, text) catch {
	case rpc.Transport as e:
		return mcp.ToolError{Message: e.Reason}
	}
}

// Arguments is the tool and the arguments that ask for r: Call reads
// them as r again.
func Arguments(r Request) (string, json.Value) {
	match r {
	case counterapi.AddRequest as x:
		("add", untagged(valueOf(rpc.Encode(x.Entry))))
	case counterapi.GetRequest as x:
		("get", untagged(valueOf(rpc.Encode(x))))
	}
}

// Show is the outcome o as a tool's answer: its value as JSON (null for
// none), or its typed failure as a ToolError whose message is the
// failure's tagged JSON.
func Show(o counterapi.Outcome) json.Value fails mcp.ToolError {
	match o {
	case counterapi.Done as done:
		match done.Reply {
		case counterapi.AddReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case counterapi.GetReply as reply:
			valueOf(rpc.Encode(reply.Value))
		}
	case counterapi.Rejected as rejected:
		match rejected.Failure {
		case counterapi.Negative as failure:
			return mcp.ToolError{Message: rpc.Tagged("Negative", rpc.Encode(failure.E))}
		case counterapi.Unknown as failure:
			return mcp.ToolError{Message: rpc.Tagged("Unknown", rpc.Encode(failure.E))}
		}
	}
}

// Answer answers r through the hub's Call on the bound counter.Counter (Show).
func Answer(r Request) json.Value fails mcp.ToolError needs counter.Counter {
	try Show(counterapi.Call(r))
}

// ReadAnswer is the outcome of r that a tool's result says: its value's
// JSON, or, when it is an error, its failure's tagged JSON. Any other
// result is not an answer to r, a defect.
func ReadAnswer(r Request, result mcp.Called) counterapi.Outcome {
	if len(result.Content) != 1 {
		Unreachable("a tool answered \(len(result.Content)) blocks, not one")
	}
	let text = result.Content[0].Text
	if !result.IsError {
		match r {
		case counterapi.AddRequest:
			let v = rpc.Decode[int]("value", text) catch {
			case rpc.Transport as e:
				Unreachable("the tool add answered a value it cannot read: " + e.Reason)
			}
			counterapi.Done{Reply: counterapi.AddReply{Value: v}}
		case counterapi.GetRequest:
			let v = rpc.Decode[int]("value", text) catch {
			case rpc.Transport as e:
				Unreachable("the tool get answered a value it cannot read: " + e.Reason)
			}
			counterapi.Done{Reply: counterapi.GetReply{Value: v}}
		}
	} else {
		match rpc.TagOf(text) {
		case "Negative":
			let e = rpc.Decode[counter.Negative]("failure", text) catch {
			case rpc.Transport as x:
				Unreachable("a tool answered a failure it cannot read: " + x.Reason)
			}
			counterapi.Rejected{Failure: counterapi.Negative{E: e}}
		case "Unknown":
			let e = rpc.Decode[counter.Unknown]("failure", text) catch {
			case rpc.Transport as x:
				Unreachable("a tool answered a failure it cannot read: " + x.Reason)
			}
			counterapi.Rejected{Failure: counterapi.Unknown{E: e}}
		case _:
			Unreachable("a tool answered an error no operation has: " + text)
		}
	}
}

func toolOver(name string, answer own func(r Request) counterapi.Outcome) mcp.Tool {
	mcp.Tool{Name: name, Description: Description(name), Input: Input(name), Call: func(arguments json.Value) json.Value fails mcp.ToolError {
		let r = Call(name, arguments) catch {
		case mcp.ToolError as e:
			return e
		case mcp.UnknownTool as e:
			return mcp.ToolError{Message: "no tool is named " + e.Name}
		}
		try Show(answer(r))
	}}
}

func toolsOver(answer own func(r Request) counterapi.Outcome) []mcp.Tool {
	let mut out = []mcp.Tool{}
	for name in Names {
		out = out.Append(toolOver(name, answer))
	}
	out
}

// Tools are the tools of the counter.Counter in force, one per operation, in its order.
func Tools() []mcp.Tool needs counter.Counter {
	let held = InForce[counter.Counter]()
	toolsOver(func(r Request) counterapi.Outcome {
		with held { counterapi.Call(r) }
	})
}

func carry(c Request, answer own func(c Request) counterapi.Outcome) counterapi.Outcome {
	let server = mcp.Server{Name: "carry", Version: "1", Tools: toolsOver(answer)}
	let (name, arguments) = Arguments(c)
	let message = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":" + rpc.Encode(name) + ",\"arguments\":" + textOf(arguments) + "}}"
	match mcp.Handle(server, message) {
	case mcp.Answered as a:
		let result = json.Decode(json.Codec[mcp.Called]{MaxBytes: 0, MaxDepth: 0}, a.Result) catch {
		case _:
			Unreachable("a tool's result is not one: " + a.Result)
		}
		ReadAnswer(c, result)
	case mcp.Refused as e:
		Unreachable("the server refused the call: " + e.Message)
	case mcp.Silent:
		Unreachable("the server did not answer the call")
	}
}

// Wire is the protocol as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, counterapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) counterapi.Outcome) counterapi.Outcome { carry(c, answer) }

// Agrees: the protocol carries every call and every outcome the call
// can have unchanged.
law Agrees(r Request, g counterapi.Given) { api.Agrees(Wire, r, counterapi.OutcomeOf(r, g)) }

// RoundTrips reports whether Call reads what Arguments writes of r as r.
func RoundTrips(r Request) bool {
	let (name, arguments) = Arguments(r)
	let back = Call(name, arguments) catch {
	case mcp.ToolError, mcp.UnknownTool:
		return false
	}
	back == r
}

// FitsSchema reports whether the arguments that ask for r fit the
// schema their tool lists.
func FitsSchema(r Request) bool {
	let (name, arguments) = Arguments(r)
	mcp.Conforms(Input(name), arguments)
}

// ArgumentsRoundTrip: Call reads what Arguments writes as the same Request.
law ArgumentsRoundTrip(r Request) { RoundTrips(r) }

// ArgumentsFitTheSchema: the arguments of every Request fit the schema
// of their tool.
law ArgumentsFitTheSchema(r Request) { FitsSchema(r) }
