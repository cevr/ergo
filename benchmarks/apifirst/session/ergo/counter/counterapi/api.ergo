import json
import rpc
import sync
import sessionbench/counter

// Request is one call of counter.Counter: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = AddRequest{Entry counter.Entry} | GetRequest{Key string}

// Op is an operation of counter.Counter: what a policy matches on.
type Op = AddOp{} | GetOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = AddReply{Value int} | GetReply{Value int}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = Negative{E counter.Negative} | Unknown{E counter.Unknown}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case AddRequest:
		AddOp
	case GetRequest:
		GetOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case AddOp:
		"add"
	case GetOp:
		"get"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case AddOp:
		"Add adds the amount of entry to its key and is the new count."
	case GetOp:
		"Get is the count of key."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case AddOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"},\"n\":{\"type\":\"integer\"}},\"required\":[\"key\",\"n\"]}")
	case GetOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"key\":{\"type\":\"string\"}},\"required\":[\"key\"]}")
	}
}

// Call answers r on the bound counter.Counter: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs counter.Counter {
	match r {
	case AddRequest as x:
		let v = counter.Counter.Add(x.Entry) catch {
		case counter.Negative as e:
			return Rejected{Failure: Negative{E: e}}
		}
		Done{Reply: AddReply{Value: v}}
	case GetRequest as x:
		let v = counter.Counter.Get(x.Key) catch {
		case counter.Unknown as e:
			return Rejected{Failure: Unknown{E: e}}
		}
		Done{Reply: GetReply{Value: v}}
	}
}

// Client provides counter.Counter by invoking typed per-operation handlers directly:
// a direct call returns its exact value or declared failure row with no Outcome boxing.
type Client { opAdd func(counter.Entry) int fails counter.Negative, opGet func(string) int fails counter.Unknown } implements counter.Counter

// NewClient is the counter.Counter that invokes inner directly per operation.
func NewClient(inner counter.Counter) Client {
	Client{
		opAdd: func(entry counter.Entry) int fails counter.Negative { try inner.Add(entry) },
		opGet: func(key string) int fails counter.Unknown { try inner.Get(key) },
	}
}

// ClientInForce is the counter.Counter that invokes the provider currently in force.
func ClientInForce() Client needs counter.Counter {
	let held = InForce[counter.Counter]()
	Client{
		opAdd: func(entry counter.Entry) int fails counter.Negative { with held { try counter.Counter.Add(entry) } },
		opGet: func(key string) int fails counter.Unknown { with held { try counter.Counter.Get(key) } },
	}
}

// Add invokes counter.Counter's Add directly.
func Add(client Client, entry counter.Entry) int fails counter.Negative {
	try client.opAdd(entry)
}

// Get invokes counter.Counter's Get directly.
func Get(client Client, key string) int fails counter.Unknown {
	try client.opGet(key)
}

// CheckedClient carries erased counter.Counter requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// AddChecked sends counter.Counter's Add over send and validates its Outcome.
func AddChecked(client CheckedClient, entry counter.Entry) int fails counter.Negative | rpc.Transport {
	match try client.send(AddRequest{Entry: entry}) {
	case Done as done:
		match done.Reply {
		case AddReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "counterapi: Add was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Negative as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "counterapi: Add was answered with a failure outside its row"}
		}
	}
}

// GetChecked sends counter.Counter's Get over send and validates its Outcome.
func GetChecked(client CheckedClient, key string) int fails counter.Unknown | rpc.Transport {
	match try client.send(GetRequest{Key: key}) {
	case Done as done:
		match done.Reply {
		case GetReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "counterapi: Get was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unknown as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "counterapi: Get was answered with a failure outside its row"}
		}
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Add int, Get int }

func inRow(op Op, f Failure) bool {
	match op {
	case AddOp:
		match f {
		case Negative:
			true
		case _:
			false
		}
	case GetOp:
		match f {
		case Unknown:
			true
		case _:
			false
		}
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case AddRequest:
		Done{Reply: AddReply{Value: g.Values.Add}}
	case GetRequest:
		Done{Reply: GetReply{Value: g.Values.Get}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opAdd: func(entry counter.Entry) int fails counter.Negative {
			sent.Update(func(rs []Request) []Request { rs.Append(AddRequest{Entry: entry}) })
			if g.Failing {
				match g.Failure {
				case Negative as err:
					return err.E
				case _:
				}
			}
			g.Values.Add
		},
		opGet: func(key string) int fails counter.Unknown {
			sent.Update(func(rs []Request) []Request { rs.Append(GetRequest{Key: key}) })
			if g.Failing {
				match g.Failure {
				case Unknown as err:
					return err.E
				case _:
				}
			}
			g.Values.Get
		},
	}
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case AddRequest as x:
		let v = AddChecked(client, x.Entry) catch {
		case counter.Negative as e:
			return Rejected{Failure: Negative{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: AddReply{Value: v}}
	case GetRequest as x:
		let v = GetChecked(client, x.Key) catch {
		case counter.Unknown as e:
			return Rejected{Failure: Unknown{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: GetReply{Value: v}}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { counter.Counter: scripted(g, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(g, sent)
	let outer = NewClient(inner)
	let got = with context { counter.Counter: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted(g, sentChecked)
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { counter.Counter: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
