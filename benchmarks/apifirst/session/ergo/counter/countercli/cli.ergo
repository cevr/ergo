// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// Policy is what a binary decides of its command line: Code, the exit
// status of a typed failure (default 1); Text, the text of a value
// without --json (default None: a basic value as its text, else its
// JSON; --json never calls it); Confirm, the question a call asks before
// it runs (default None: none; --yes answers it).
type Policy { Code func(f counterapi.Failure) int, Text func(r counterapi.Reply) Option[string], Confirm func(r Request) Option[string] }

// Defaults is the Policy of a binary that decides nothing.
func Defaults() Policy {
	Policy{Code: func(f counterapi.Failure) int { 1 }, Text: func(r counterapi.Reply) Option[string] { None }, Confirm: func(r Request) Option[string] { None }}
}

// answer is the Output of a value: its text, or its JSON with --json.
func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else {
		Output{Out: line(plain), Err: "", Code: 0}
	}
}

// line is s as a line of output: nothing for an empty s.
func line(s string) string {
	if s == "" {
		return ""
	}
	s + "\n"
}

// failed is the Output of a typed failure, from its tagged JSON: on
// standard output with --json, else its tag and JSON on standard error;
// the status the policy gives it.
func failed(asJSON bool, tagged string, status int) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: status}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: status}
	}
}

// Show is what Run prints of the outcome o under the policy p: the value
// (p's Text when it has one and there is no --json; else its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed) with p's Code.
func Show(o counterapi.Outcome, asJSON bool, p Policy) Output {
	match o {
	case counterapi.Done as done:
		if !asJSON {
			match p.Text(done.Reply) {
			case Some[string] as s:
				return Output{Out: line(s.Value), Err: "", Code: 0}
			case None:
			}
		}
		match done.Reply {
		case counterapi.AddReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case counterapi.GetReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		}
	case counterapi.Rejected as rejected:
		let status = p.Code(rejected.Failure)
		match rejected.Failure {
		case counterapi.Negative as failure:
			failed(asJSON, rpc.Tagged("Negative", rpc.Encode(failure.E)), status)
		case counterapi.Unknown as failure:
			failed(asJSON, rpc.Tagged("Unknown", rpc.Encode(failure.E)), status)
		}
	}
}

// Read is the outcome of r that the Output of Run with --json says: its
// value's JSON on standard output with status 0, or its failure's tagged
// JSON with status 1. Any other Output is not an answer to r, a defect.
func Read(r Request, out Output) counterapi.Outcome {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case counterapi.AddRequest:
			let v = rpc.Decode[int]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Add with a value it cannot read: " + t.Reason)
			}
			counterapi.Done{Reply: counterapi.AddReply{Value: v}}
		case counterapi.GetRequest:
			let v = rpc.Decode[int]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Get with a value it cannot read: " + t.Reason)
			}
			counterapi.Done{Reply: counterapi.GetReply{Value: v}}
		}
	} else if out.Code == 1 {
		match rpc.TagOf(text) {
		case "Negative":
			let e = rpc.Decode[counter.Negative]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			counterapi.Rejected{Failure: counterapi.Negative{E: e}}
		case "Unknown":
			let e = rpc.Decode[counter.Unknown]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			counterapi.Rejected{Failure: counterapi.Unknown{E: e}}
		case _:
			Unreachable("the command line answered a failure no operation has: " + text)
		}
	} else {
		Unreachable("the command line answered status \(out.Code): " + out.Err)
	}
}

// front is a command line read up to its call: the call and the global
// flags before it (--json, --yes), or the Output that ends the run first
// (the help, status 0; a usage error, status 2, which no policy changes).
type front = asked{R Request, JSON bool, Yes bool} | ended{O Output}

func frontOf(args []string) front {
	let mut asJSON = false
	let mut yes = false
	let mut globals = true
	let mut rest = []string{}
	for a in args {
		if globals && (a == "--json" || a == "-json") {
			asJSON = true
		} else if globals && (a == "--yes" || a == "-yes") {
			yes = true
		} else {
			globals = false
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return ended{O: Output{Out: h.Text, Err: "", Code: 0}}
	case err:
		return ended{O: Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}}
	}
	asked{R: r, JSON: asJSON, Yes: yes}
}

// needsYes is the end of a call whose question no one can answer here.
func needsYes(question string) Output {
	Output{Out: "", Err: question + " (no terminal to ask on: pass --yes to answer yes)\n", Code: 2}
}

// declined is the end of a call whose question was answered no.
func declined(question string) Output {
	Output{Out: "", Err: question + ": not confirmed\n", Code: 1}
}

// runOver reads args as [--json] [--yes] COMMAND ARGS..., answers the
// Request with answer and is what to print (Show) under p; a call p asks a
// question of, with no --yes, ends with status 2 (needsYes): runOver has
// no terminal (RunOnTerminal has).
func runOver[R](args []string, p Policy, answer func(r Request) counterapi.Outcome needs R) Output needs R {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				return needsYes(q.Value)
			case None:
			}
		}
		Show(answer(a.R), a.JSON, p)
	}
}

// Run reads args as [--json] [--yes] COMMAND ARGS..., answers the call
// through the hub's Call on the counter.Counter the caller binds, and is what to
// print under the policy p: the value, a typed failure with p's Code, the
// help (status 0) or a usage error (status 2). It asks nothing: a call p
// asks a question of needs --yes (status 2 without it).
func Run(args []string, p Policy) Output needs counter.Counter {
	runOver(args, p, counterapi.Call)
}

// RunOnTerminal is Run that asks p's question on the terminal (std
// prompt) when there is no --yes: a yes runs the call, a no or a cancel
// ends with status 1, and standard input that is not a terminal ends with
// status 2, as Run does.
func RunOnTerminal(args []string, p Policy) Output needs counter.Counter | term.Terminal | io.Stderr {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				let yes = prompt.Confirm(q.Value, false) catch {
				case prompt.NotInteractive:
					return needsYes(q.Value)
				case prompt.Cancelled:
					return declined(q.Value)
				case io.ReadFailed:
					return Output{Out: "", Err: q.Value + ": the answer could not be read\n", Code: 2}
				}
				if !yes {
					return declined(q.Value)
				}
			case None:
			}
		}
		Show(counterapi.Call(a.R), a.JSON, p)
	}
}

// Completion is the script that completes counter's commands in shell.
func Completion(shell api.Shell) string {
	api.Completion("counter", shell, []api.Entry{api.Entry{Name: counterapi.Name(counterapi.AddOp), Doc: counterapi.Doc(counterapi.AddOp)}, api.Entry{Name: counterapi.Name(counterapi.GetOp), Doc: counterapi.Doc(counterapi.GetOp)}})
}

// carry is c through the command line: printed with --json, read back
// by Run's own reader, answered by answer, shown under Defaults, and read
// back (Read).
func carry(c Request, answer func(c Request) counterapi.Outcome) counterapi.Outcome {
	let mut args = []string{"--json"}
	for a in Print(c) {
		args = args.Append(a)
	}
	Read(c, runOver(args, Defaults(), answer))
}

// Wire is the command line as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, counterapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) counterapi.Outcome) counterapi.Outcome { carry(c, answer) }

// Agrees: the command line carries every call and every outcome the
// call can have unchanged.
law Agrees(r Request, g counterapi.Given) { api.Agrees(Wire, r, counterapi.OutcomeOf(r, g)) }

// CodeIsThePolicy: a call's status is 0 for a value and the policy's
// Code for a typed failure.
law CodeIsThePolicy(r Request, g counterapi.Given, k int) {
	let status = 1 + ((k%125)+125)%125
	let d = Defaults()
	let p = Policy{..d, Code: func(f counterapi.Failure) int { status }}
	let o = counterapi.OutcomeOf(r, g)
	let out = runOver(Print(r), p, func(c Request) counterapi.Outcome { o })
	match o {
	case counterapi.Done:
		out.Code == 0
	case counterapi.Rejected:
		out.Code == status
	}
}

// TextIsThePolicy: without --json a value prints as the policy's Text;
// with --json every outcome prints as the wire's JSON, whatever Text says.
law TextIsThePolicy(r Request, g counterapi.Given, t string) {
	let d = Defaults()
	let p = Policy{..d, Text: func(reply counterapi.Reply) Option[string] { Some[string]{Value: t} }}
	let o = counterapi.OutcomeOf(r, g)
	let same = Show(o, true, p) == Show(o, true, d)
	match o {
	case counterapi.Done:
		same && Show(o, false, p).Out == line(t)
	case counterapi.Rejected:
		same && Show(o, false, p) == Show(o, false, d)
	}
}
