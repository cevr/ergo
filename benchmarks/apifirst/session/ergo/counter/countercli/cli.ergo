// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case counterapi.AddRequest as x:
		let mut out = []string{"add"}
		out = out.Append("-key=\(x.Entry.Key)")
		out = out.Append("-n=\(x.Entry.N)")
		out
	case counterapi.GetRequest as x:
		let mut out = []string{"get"}
		out = out.Append("--")
