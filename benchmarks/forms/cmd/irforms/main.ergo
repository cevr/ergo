// irforms holds the IR-FORMS plan's probes: one small program per Ergo
// form, each with a hand Go twin in ../../testdata/control; a workload
// per kind in ../../KIND (go run ./scripts/opcount -control -rounds 5
// benchmarks/forms/KIND).
//
//	irforms bench KIND N

import irforms/view
import os
import slices
import strconv
import sync
import ui

// ---- step: a machine's step, driven in a loop ----

type Light = Red{Ticks int} | Green{Ticks int} | Amber{Ticks int} | Off{}

type Sig = Tick{} | Trip{} | Reset{}

type Note = Changed{}

func Step(k Light, s Sig) Decision[Light, Note] {
	match k {
	case Red as r:
		match s {
		case Tick:
			if r.Ticks >= 3 {
				Emit[Light, Note]{Next: Green{Ticks: 0}, Output: Changed}
			} else {
				Enter[Light]{Next: Red{Ticks: r.Ticks + 1}}
			}
		case Trip:
			Enter[Light]{Next: Off}
		case Reset:
			Ignore
		}
	case Green as g:
		match s {
		case Tick:
			if g.Ticks >= 5 {
				Emit[Light, Note]{Next: Amber{Ticks: 0}, Output: Changed}
			} else {
				Enter[Light]{Next: Green{Ticks: g.Ticks + 1}}
			}
		case Trip:
			Enter[Light]{Next: Off}
		case Reset:
			Ignore
		}
	case Amber as a:
		match s {
		case Tick:
			if a.Ticks >= 1 {
				Emit[Light, Note]{Next: Red{Ticks: 0}, Output: Changed}
			} else {
				Enter[Light]{Next: Amber{Ticks: a.Ticks + 1}}
			}
		case Trip:
			Enter[Light]{Next: Off}
		case Reset:
			Ignore
		}
	case Off:
		match s {
		case Tick:
			Ignore
		case Trip:
			Ignore
		case Reset:
			Emit[Light, Note]{Next: Red{Ticks: 0}, Output: Changed}
		}
	}
}

func sigOf(i int) Sig {
	if i % 64 == 33 {
		Trip
	} else if i % 64 == 40 {
		Reset
	} else {
		Tick
	}
}

func first() Light { Red{Ticks: 0} }

func benchStep(n int) int {
	let mut k = first()
	let mut out = 0
	for i in 0..n {
		match Step(k, sigOf(i)) {
		case Enter[Light] as e:
			k = e.Next
		case Emit[Light, Note] as e:
			k = e.Next
			out = out + 1
		case Ignore:
			out = out + 2
		case _:
		}
	}
	out
}

// ---- opt: a small function that gives an Option, matched at once ----

func find(keys []int, k int) Option[int] {
	let i = k & 63
	if keys[i] == k {
		Some[int]{Value: i * 3}
	} else {
		None
	}
}

func benchOpt(n int) int {
	let mut keys = []int{}
	for i in 0..64 {
		keys = keys.Append(if i % 4 == 0 { 0 - 1 } else { i })
	}
	let mut sum = 0
	for i in 0..n {
		match find(keys, i & 127) {
		case Some[int] as s:
			sum = sum + s.Value
		case None:
			sum = sum + 1
		}
	}
	sum
}

// ---- fail: a typed failure through two tries and a catch ----

type Bad { At int }

func digit(c int) int fails Bad {
	if c % 8 == 7 {
		Bad{At: c}
	} else {
		c % 10
	}
}

func pair(a int, b int) int fails Bad {
	let x = try digit(a)
	let y = try digit(b)
	x * 10 + y
}

func benchFail(n int) int {
	let mut sum = 0
	for i in 0..n {
		let v = pair(i, i + 3) catch {
		case Bad as b:
			b.At % 5
		}
		sum = sum + v
	}
	sum
}

// ---- pipe: Transform, Filter and Fold of std slices, with closures ----

func benchPipe(n int) int {
	let mut xs = slices.WithCapacity[int](n)
	for i in 0..n {
		xs = xs.Append(i)
	}
	let ys = slices.Transform(xs, func(x int) int { x * 3 + 1 })
	let zs = slices.Filter(ys, func(x int) bool { x % 4 != 0 })
	slices.Fold(zs, 0, func(acc int, x int) int { acc + x % 7 })
}

// ---- update: a record update of a six-field record, in a loop ----

type Stats { A int, B int, C int, D int, E int, F int }

func bump(s Stats, x int) Stats {
	if x & 1 == 0 {
		Stats{..s, A: s.A + (x & 7)}
	} else {
		Stats{..s, E: s.E + 1, F: s.F ^ x}
	}
}

func benchUpdate(n int) int {
	let mut s = Stats{A: 0, B: 1, C: 2, D: 3, E: 0, F: 0}
	for i in 0..n {
		s = bump(s, i)
	}
	s.A + s.B + s.C + s.D + s.E + (s.F & 1023)
}

// ---- view: a match on a view call, in this package and in another ----

type Tree { Kind []int, A []int, B []int, Extra []int, W int }

type Node = Leaf{V int} | Add{L int, R int} | Neg{X int} | Mul{L int, R int} | Zero{}

func Len(t Tree) int { len(t.Kind) }

func ViewOf(t Tree, id int) Node {
	let a = t.A[id]
	let b = t.B[id]
	match t.Kind[id] {
	case 0:
		Leaf{V: a}
	case 1:
		Add{L: a, R: b}
	case 2:
		Neg{X: a}
	case 3:
		Mul{L: a, R: b}
	case _:
		Zero
	}
}

func walkLocal(t Tree, passes int) int {
	let mut sum = 0
	for _ in 0..passes {
		for i in 0..Len(t) {
			match ViewOf(t, i) {
			case Leaf as l:
				sum = sum + l.V
			case Add as a:
				sum = sum + a.L - a.R
			case Neg as g:
				sum = sum - g.X
			case Mul as m:
				sum = sum + (m.L ^ m.R)
			case Zero:
				sum = sum + 1
			}
		}
	}
	sum
}

func walkCross(t view.Tree, passes int) int {
	let mut sum = 0
	for _ in 0..passes {
		for i in 0..view.Len(t) {
			match view.ViewOf(t, i) {
			case view.Leaf as l:
				sum = sum + l.V
			case view.Add as a:
				sum = sum + a.L - a.R
			case view.Neg as g:
				sum = sum - g.X
			case view.Mul as m:
				sum = sum + (m.L ^ m.R)
			case view.Zero:
				sum = sum + 1
			}
		}
	}
	sum
}

func benchViewLocal(n int) int {
	let v = view.Build(4096)
	walkLocal(Tree{Kind: v.Kind, A: v.A, B: v.B, Extra: v.Extra, W: v.W}, n / 4096)
}

func benchViewCross(n int) int { walkCross(view.Build(4096), n / 4096) }

// ---- segpath: a path of std's ui.Seg built and read (FLAT-STD) ----

// segPath is dash-gui's chart stroke: eight columns, a MoveTo and a LineTo
// each, appended to a path of room for them.
func segPath(i int) ui.Path {
	let mut segs = slices.WithCapacity[ui.Seg](16)
	for j in 0..8 {
		let x = float64(i + j)
		segs = segs.Append(ui.MoveTo{X: x, Y: 1.0})
		segs = segs.Append(ui.LineTo{X: x, Y: x + 2.0})
	}
	ui.Path{Segs: segs}
}

// benchSegPath builds n paths and reads each segment as a painter does.
func benchSegPath(n int) int {
	let mut acc = 0
	for i in 0..n {
		let p = segPath(i & 1023)
		for s in p.Segs {
			match s {
			case ui.MoveTo as m:
				acc = acc + int(m.X)
			case ui.LineTo as l:
				acc = acc + int(l.Y)
			case _:
				acc = acc + 1
			}
		}
	}
	acc
}

// ---- ctx: an operation of a capability, bound once, called in a loop ----

type Meter {
	Add(x int) int,
}

type Plain { Scale int } implements Meter

func Add(p Plain, x int) int { x * p.Scale + 1 }

func total(n int) int needs Meter {
	let mut s = 0
	for i in 0..n {
		s = s + Meter.Add(i & 1023)
	}
	s
}

func benchCtx(n int) int {
	with context { Meter: Plain{Scale: 3} } { total(n) }
}

// ---- ref: a shared cell's Modify with a closure ----

func benchRef(n int) int {
	let cell = sync.NewRef[int](0)
	let mut sum = 0
	for i in 0..n {
		let old = sync.Modify(cell, func(v int) (int, int) { (v, v + (i & 3)) })
		sum = sum + (old & 1)
	}
	sum
}

// ---- floors: the same work written by hand in Ergo ----

func benchPipeLoops(n int) int {
	let mut xs = slices.WithCapacity[int](n)
	for i in 0..n {
		xs = xs.Append(i)
	}
	let mut ys = slices.WithCapacity[int](len(xs))
	for x in xs {
		ys = ys.Append(x * 3 + 1)
	}
	let mut zs = []int{}
	for y in ys {
		if y % 4 != 0 {
			zs = zs.Append(y)
		}
	}
	let mut acc = 0
	for z in zs {
		acc = acc + z % 7
	}
	acc
}

func benchPipeFused(n int) int {
	let mut xs = slices.WithCapacity[int](n)
	for i in 0..n {
		xs = xs.Append(i)
	}
	let mut acc = 0
	for x in xs {
		let y = x * 3 + 1
		if y % 4 != 0 {
			acc = acc + y % 7
		}
	}
	acc
}

func totalDirect(p Plain, n int) int {
	let mut s = 0
	for i in 0..n {
		s = s + p.Add(i & 1023)
	}
	s
}

func benchLoop(n int) int {
	let mut s = 0
	for i in 0..n {
		s = s + (i & 7)
	}
	s
}

func benchUpdateFields(n int) int {
	let mut a = 0
	let mut e = 0
	let mut f = 0
	for i in 0..n {
		if i & 1 == 0 {
			a = a + (i & 7)
		} else {
			e = e + 1
			f = f ^ i
		}
	}
	a + 1 + 2 + 3 + e + (f & 1023)
}

// ---- widen and rebuild: a sub-union's value into its union (UNION-FLAT) ----

type Settled = Asked{Q int} | Shown{N int}
type Quiz = Calculating{Next int} | Settled

func widenQ(s Settled) Quiz { s }

// rebuildQ is the hand rebuild that widening replaces.
func rebuildQ(s Settled) Quiz {
	match s {
	case Asked as a:
		a
	case Shown as v:
		v
	}
}

func score(q Quiz) int {
	match q {
	case Calculating as c:
		c.Next
	case Asked as a:
		a.Q
	case Shown as v:
		v.N + 1
	}
}

func settledOf(i int) Settled {
	if i % 3 == 0 {
		Asked{Q: i & 7}
	} else {
		Shown{N: i & 3}
	}
}

func benchWiden(n int) int {
	let mut s = 0
	for i in 0..n {
		s = s + score(widenQ(settledOf(i)))
	}
	s
}

func benchRebuild(n int) int {
	let mut s = 0
	for i in 0..n {
		s = s + score(rebuildQ(settledOf(i)))
	}
	s
}

func run(kind string, n int) int {
	if kind == "widen" {
		benchWiden(n)
	} else if kind == "rebuild" {
		benchRebuild(n)
	} else if kind == "pipeloops" {
		benchPipeLoops(n)
	} else if kind == "pipefused" {
		benchPipeFused(n)
	} else if kind == "ctxdirect" {
		totalDirect(Plain{Scale: 3}, n)
	} else if kind == "loop" {
		benchLoop(n)
	} else if kind == "updatefields" {
		benchUpdateFields(n)
	} else if kind == "step" {
		benchStep(n)
	} else if kind == "opt" {
		benchOpt(n)
	} else if kind == "fail" {
		benchFail(n)
	} else if kind == "pipe" {
		benchPipe(n)
	} else if kind == "update" {
		benchUpdate(n)
	} else if kind == "viewlocal" {
		benchViewLocal(n)
	} else if kind == "segpath" {
		benchSegPath(n)
	} else if kind == "viewcross" {
		benchViewCross(n)
	} else if kind == "ctx" {
		benchCtx(n)
	} else if kind == "ref" {
		benchRef(n)
	} else {
		0 - 1
	}
}

func main() fails os.Exit needs Console | Ambient {
	with context { os.Process: os.NewHost() } {
		let args = os.Process.Args()
		if len(args) != 3 {
			return os.Exit{Code: 2, Message: "usage: irforms bench KIND N"}
		}
		let n = strconv.Atoi(args[2]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return os.Exit{Code: 2, Message: "irforms: N is not a count"}
		}
		Console.Println("\(run(args[1], n))")
	}
}
