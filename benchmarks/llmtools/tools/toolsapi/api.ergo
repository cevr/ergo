import json
import rpc
import sync
import llmtools/tools

// Request is one call of tools.Search: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = FindRequest{Q tools.Query} | CountRequest{Word string}

// Op is an operation of tools.Search: what a policy matches on.
type Op = FindOp{} | CountOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = FindReply{Value []tools.Hit} | CountReply{Value int}

// Failure is a failure of an operation. No operation fails, so its one
// variant is NoFailure, which no Call answers.
type Failure = NoFailure{}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case FindRequest:
		FindOp
	case CountRequest:
		CountOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case FindOp:
		"find"
	case CountOp:
		"count"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case FindOp:
		"Find is the hits of q."
	case CountOp:
		"Count is how many documents hold the word."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case FindOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"text\",\"limit\",\"tags\"]}")
	case CountOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"word\":{\"type\":\"string\"}},\"required\":[\"word\"]}")
	}
}

// Call answers r on the bound tools.Search: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs tools.Search {
	match r {
	case FindRequest as x:
		let v = tools.Search.Find(x.Q)
		Done{Reply: FindReply{Value: v}}
	case CountRequest as x:
		let v = tools.Search.Count(x.Word)
		Done{Reply: CountReply{Value: v}}
	}
}

// Client provides tools.Search by invoking inner directly per operation: a direct
// call returns its exact value or declared failure row with no Outcome boxing.
type Client { inner tools.Search } implements tools.Search

// NewClient is the tools.Search that invokes inner directly per operation.
func NewClient(inner tools.Search) Client { Client{inner: inner} }

// Find invokes tools.Search's Find directly.
func Find(client Client, q tools.Query) []tools.Hit {
	client.inner.Find(q)
}

// Count invokes tools.Search's Count directly.
func Count(client Client, word string) int {
	client.inner.Count(word)
}

// BoundClient provides tools.Search over a held Context captured by ClientInForce.
type BoundClient { held Context[tools.Search] } implements tools.Search

// ClientInForce is the tools.Search that invokes the provider currently in force.
func ClientInForce() BoundClient needs tools.Search { BoundClient{held: InForce[tools.Search]()} }

// Find invokes tools.Search's Find on the held context.
func Find(client BoundClient, q tools.Query) []tools.Hit {
	with client.held { tools.Search.Find(q) }
}

// Count invokes tools.Search's Count on the held context.
func Count(client BoundClient, word string) int {
	with client.held { tools.Search.Count(word) }
}

// CheckedClient carries erased tools.Search requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// FindChecked sends tools.Search's Find over send and validates its Outcome.
func FindChecked(client CheckedClient, q tools.Query) []tools.Hit fails rpc.Transport {
	match try client.send(FindRequest{Q: q}) {
	case Done as done:
		match done.Reply {
		case FindReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "toolsapi: Find was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "toolsapi: Find was answered with a failure outside its row"}
	}
}

// CountChecked sends tools.Search's Count over send and validates its Outcome.
func CountChecked(client CheckedClient, word string) int fails rpc.Transport {
	match try client.send(CountRequest{Word: word}) {
	case Done as done:
		match done.Reply {
		case CountReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "toolsapi: Count was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "toolsapi: Count was answered with a failure outside its row"}
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Find []tools.Hit, Count int }

func inRow(op Op, f Failure) bool {
	match op {
	case FindOp, CountOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case FindRequest:
		Done{Reply: FindReply{Value: g.Values.Find}}
	case CountRequest:
		Done{Reply: CountReply{Value: g.Values.Count}}
	}
}

type scripted { g Given, sent sync.Ref[[]Request] } implements tools.Search

func Find(client scripted, q tools.Query) []tools.Hit {
	client.sent.Update(func(rs []Request) []Request { rs.Append(FindRequest{Q: q}) })
	client.g.Values.Find
}

func Count(client scripted, word string) int {
	client.sent.Update(func(rs []Request) []Request { rs.Append(CountRequest{Word: word}) })
	client.g.Values.Count
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case FindRequest as x:
		let v = FindChecked(client, x.Q) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: FindReply{Value: v}}
	case CountRequest as x:
		let v = CountChecked(client, x.Word) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: CountReply{Value: v}}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { tools.Search: scripted{g: g, sent: sent} } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted{g: g, sent: sent}
	let outer = NewClient(inner)
	let got = with context { tools.Search: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted{g: g, sent: sentChecked}
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { tools.Search: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
