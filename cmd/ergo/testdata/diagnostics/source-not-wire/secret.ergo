// A source whose state holds a server handle (Vault.Key, a sync.Ref): a
// client would hold the state, so replica.Source refuses it and names the
// part that has no codec.

import lease-sync/domain
import lease-sync/replica
import sync

type Vault { Owner string, Key sync.Ref[string] }
type Open {}
type Opened {}
type Denied {}

func decide(v Vault, c domain.Envelope[Open]) []Opened fails Denied { []Opened{} }

func evolve(v Vault, e Opened) Vault { v }

let source = replica.Source[Vault, Open, Opened, Denied]{Initial: Vault{Owner: "", Key: sync.NewRef("")}, Decide: decide, Evolve: evolve, Schema: "vault/1"}
