// Package property is the Ergo form of internal/selfhostcheck's
// TestSelfhostFormatLaws (TPROBE, kind property): the formatter's source
// laws (format.CheckLaws: idempotence, the tree shape and the comments
// kept, and the limit refused exactly below the size) on every examples/
// and compiler/ .ergo file of the tree, which the meter joins into
// inputs.txt. The Go family's generated grammar inputs, perturbations and
// edits have no Ergo generator yet, and its facade probes test Go
// (internal/hostsyntax), which no Ergo form runs. It is an overlay of
// scripts/buildcost's meter, laid over a scratch copy of the tree; it is no
// test of the product.

import compiler/format
import embed
import strings

// Inputs is the sources, each ended by a line of one record separator.
let Inputs = embed.File[string]("inputs.txt")

// FormatLawsHoldOnTheSources: every source the formatter formats keeps
// its laws, and most sources format (a law holds vacuously on a source
// that does not, so a run where none formats proves nothing).
test FormatLawsHoldOnTheSources {
	let mut bad = strings.NewBuilder()
	let mut formatted = 0
	let mut all = 0
	for src in strings.Split(Inputs, "\x1e\n") {
		if src == "" {
			continue
		}
		all += 1
		let _ = format.Source(src, 0) catch {
		case format.SyntaxFailure, format.OutputLimit:
			continue
		}
		formatted += 1
		let laws = format.CheckLaws(src)
		if laws != "ok\n" {
			bad.WriteString(laws + "of: " + strings.Slice(src, 0, if src.Len() < 200 { src.Len() } else { 200 }) + "\n")
		}
	}
	assert formatted*2 > all
	assert bad.String() == ""
}
