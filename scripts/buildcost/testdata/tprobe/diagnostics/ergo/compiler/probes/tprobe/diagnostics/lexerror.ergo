// Package diagnostics is the Ergo form of internal/sketch/syntax's
// TestLexicalErrorInLookahead (TPROBE, kind diagnostics): sources that end
// in a lexical error after a parser lookahead has started. For each, the
// token stream keeps its invariant (one EOF, at the end; each token's span
// in the source; no token before the end of the one before it), and the
// parse fails with S001 at the scanner's offset, or a parser's earlier
// one, with the message. It is an overlay of scripts/buildcost's meter,
// laid over a scratch copy of the tree; it is no test of the product.

import compiler/syntax

// stream is "" when the scan of src keeps the stream's invariant as the
// parser reads it (a failed scan's ILLEGAL and EOF where it stopped, as
// the Go test's scan builds them), else the first break.
func stream(src string) string {
	let s = syntax.Scan(src)
	let t = s.Toks
	let n = syntax.NumToks(t)
	let mut kinds = []uint8{}
	let mut starts = []int{}
	let mut ends = []int{}
	for i in 0..n {
		let id = syntax.TokAt(t, i)
		let k = syntax.Kind(t, id)
		let start = syntax.Start(t, id)
		kinds = kinds.Append(k)
		starts = starts.Append(start)
		ends = ends.Append(syntax.End(src, k, start))
	}
	if s.Failed {
		let mut at = s.Offset
		let mut end = s.Offset + s.Length
		if n > 0 && ends[n-1] > at {
			at = ends[n-1]
			end = ends[n-1]
		}
		kinds = kinds.Append(syntax.Illegal)
		starts = starts.Append(at)
		ends = ends.Append(end)
		kinds = kinds.Append(syntax.EOF)
		starts = starts.Append(end)
		ends = ends.Append(end)
	}
	let m = kinds.Len()
	if m == 0 || kinds[m-1] != syntax.EOF {
		return "the stream does not end with EOF"
	}
	let mut prev = 0
	for i in 0..m {
		if kinds[i] == syntax.EOF && i != m-1 {
			return "EOF at token \(i) of \(m)"
		}
		if starts[i] < prev {
			return "token \(i) starts at \(starts[i]), before the previous end \(prev)"
		}
		if ends[i] < starts[i] || ends[i] > src.Len() {
			return "token \(i) spans \(starts[i])..\(ends[i]) in a \(src.Len())-byte source"
		}
		prev = ends[i]
	}
	""
}

// outcome is what the parse of src reports: the stream's break, "parsed",
// or the failure's code, offset and, when withMessage, message.
func outcome(src string, withMessage bool) string {
	let broken = stream(src)
	if broken != "" {
		return "stream: " + broken
	}
	let p = syntax.Parse(src)
	if !p.Failed {
		return "parsed"
	}
	if withMessage {
		return "\(p.Code) \(p.Offset) " + p.Message
	}
	"\(p.Code) \(p.Offset)"
}

// The two FuzzCheck crashers: positionalElement scanned past the
// unterminated string of a header literal's body.

test MatchHeaderUnterminatedString {
	assert outcome("func A(){match A{\"", true) == "S001 17 string literal not terminated"
}

test WithHeaderUnterminatedString {
	assert outcome("func A(){with A{\"0", true) == "S001 16 string literal not terminated"
}

test WithHeaderUnterminatedRawString {
	assert outcome("func A(){with A{`0", true) == "S001 16 raw string literal not terminated"
}

test MatchHeaderUnterminatedRune {
	assert outcome("func A(){match A{'", false) == "S001 17"
}

test MatchHeaderInvalidByte {
	assert outcome("func A(){match A{\xff", false) == "S001 17"
}

// The scanner reports an open interpolation at its string's opening
// quote, behind the interpolation's tokens.

test MatchHeaderOpenInterpolation {
	assert outcome("func A(){match A{\"\\(b", true) == "S001 17 string literal not terminated"
}

test MatchHeaderNewlineInInterpolation {
	assert outcome("func A(){match A{\"\\(b\n", true) == "S001 17 newline in string"
}

test MatchHeaderUnterminatedStringAfterInterpolation {
	assert outcome("func A(){match A{\"\\(b)c", true) == "S001 17 string literal not terminated"
}

// A member's `[` right before the error may open `[]T` or `[N]T`, so the
// lexical error is the first; a member's `[` before a name is an
// operation's type parameters or a length that is not a literal.

test MemberBracketsUnterminatedString {
	assert outcome("type A{F[\"", true) == "S001 9 string literal not terminated"
}

test MemberBracketsInvalidByte {
	assert outcome("type A{Items [\xff", true) == "S001 14 invalid UTF-8 byte 0xff"
}

test MemberBracketsOpenInterpolation {
	assert outcome("type A{F[\"\\(x", true) == "S001 9 string literal not terminated"
}

test MemberBracketsClosedBeforeTheError {
	assert outcome("type A{F[T]\"", true) == "S001 9 expected \"]\" or an integer length, found \"T\""
}

test ForHeaderUnterminatedString {
	assert outcome("func A(){for \"", true) == "S001 13 string literal not terminated"
}

test ForHeaderOpenInterpolation {
	assert outcome("func A(){for x in \"\\(y", true) == "S001 18 string literal not terminated"
}

// A speculative reading that reaches the lexical error read the source
// without fault up to it; the fallback reading must not report an earlier
// error.

test ForHeaderNoBreakSpaceBeforeIn {
	assert outcome("func A(xs []int){for i, x\u00a0in xs {\n}}", true) == "S001 25 unexpected character U+00A0 '\\u00a0'"
}

test ForHeaderStrayCharacterBeforeIn {
	assert outcome("func A(xs []int){for i, x@ in xs {\n}}", true) == "S001 25 unexpected character '@'"
}

test ForHeaderUnterminatedStringAfterPatterns {
	assert outcome("func A(){for i, x \"", true) == "S001 18 string literal not terminated"
}

// `escaping func(` reads only as a type: with no repair, the fallback
// expression reading reports "a type is not a value" at the `escaping`.

test IndexTypeReadingReachesTheError {
	assert outcome("func A(){let y = f[escaping func(\"", true) == "S001 33 string literal not terminated"
}

test ContextEntryKeysUnterminatedString {
	assert outcome("func A(){with context{A, \"", true) == "S001 25 string literal not terminated"
}
