// bodies is NP4f's count of a moved std function (np4f-plan §6.1): `bodies
// KIND N` calls the std function KIND names N times and prints a checksum.
// Built once at the base (the old extern) and once at the head (the import
// go call or the Ergo body), the two binaries run the same loop, so the
// slope of their instructions between two sizes is the cost of one call of
// the old body and of the new one (README.md).

import atomic
import base64
import bits
import cmp
import config
import crc32
import filepath
import hex
import math
import os
import sha256
import slices
import strconv
import strings
import time
import utf8

func run(kind string, n int) string fails os.Exit {
	let words = []string{"plain", "é", "世界", "a\xffb", "", "🙂x", "ascii text", "\xe4\xb8"}
	let floats = []float64{0.5, -3.75, 1e10, 123456.789, -1e15, 42.0, 7.25, -0.0}
	let runes = []rune{97, 233, 19990, 128512, 55296, -1, 1114111, 1114112}
	let lines = []string{"  the quick brown fox  ", "a,b,c,d,e", "jumps over the lazy dog ", "Ünïcode, text, 世界"}
	let upper = []string{"PLAIN", "É", "世界", "A\xffB", "", "🙂X", "ASCII TEXT", "\xe4\xb8"}
	let parts = []string{"alpha", "beta", "gamma", "delta"}
	let hexes = []string{"00ff10", "DEADbeef", "abc", "zz12"}
	let paths = []string{"a/b/../c//d.txt", "/usr/local/lib/../share/./doc", "x", "../../a/b/c.go", "", "/", "a/b/", ".hidden"}
	let ints = []int{3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5, 8, 9, 7, 9, 3, 2, 3, 8, 4, 6, 2, 6, 4, 3, 3, 8, 3, 2, 7}
	let ints2 = [][]int{ints, slices.Clone(ints).Append(1)}
	let asc = slices.Ascend(ints)
	let cfloats = []float64{0.5, -129.5, 1e10, 300.25, -1e19, 42.0, 70000.75, -0.0}
	let bools = []string{"true", "x", "0", "False", "T", "no", "1", "FALSE"}
	let quoted = []string{"\"a\\tb\"", "`raw`", "'x'", "bad", "\"é\"", "\"\\u00e9\"", "\"open", "'\\n'"}
	let durs = []duration{1500ms, -3s, 1h, 7ns, -250us, 90m, 0ns, 12345678ns}
	let keys = []string{"server.port", "http.maxBodyBytes", "dbURL", "a.bC.dEF", "logLevel", "Ünïcode.keyÉtat", "x", "cache.ttlSeconds.max"}
	let flags = []string{"server.port", "http.max-body-bytes", "db-u-r-l", "a.b-c.d-e-f", "log-level", "ünïcode.key-état", "x", "cache.ttl-seconds.max"}
	let envs = []string{"APP_SERVER__PORT", "APP_HTTP__MAX_BODY_BYTES", "APP_DB_URL", "APP_A__B_C__D_E_F", "APP_LOG_LEVEL", "APP_ÜNÏCODE__KEY_ÉTAT", "APP_X", "APP_CACHE__TTL_SECONDS__MAX"}
	let mut acc = 0
	let mut f = 0.0
	match kind {
	case "bits.OnesCount":
		for i in 0..n {
			acc += bits.OnesCount(uint(i * 2654435761))
		}
	case "bits.OnesCount64":
		for i in 0..n {
			acc += bits.OnesCount64(uint64(i * 2654435761))
		}
	case "bits.LeadingZeros":
		for i in 0..n {
			acc += bits.LeadingZeros(uint(i))
		}
	case "bits.LeadingZeros64":
		for i in 0..n {
			acc += bits.LeadingZeros64(uint64(i))
		}
	case "bits.TrailingZeros":
		for i in 0..n {
			acc += bits.TrailingZeros(uint(i))
		}
	case "bits.TrailingZeros64":
		for i in 0..n {
			acc += bits.TrailingZeros64(uint64(i))
		}
	case "bits.Len":
		for i in 0..n {
			acc += bits.Len(uint(i))
		}
	case "bits.Len64":
		for i in 0..n {
			acc += bits.Len64(uint64(i))
		}
	case "bits.RotateLeft32":
		for i in 0..n {
			acc += int(bits.RotateLeft32(uint32(i), i & 31) & 0xff)
		}
	case "bits.RotateLeft64":
		for i in 0..n {
			acc += int(bits.RotateLeft64(uint64(i), i & 63) & 0xff)
		}
	case "math.Abs":
		for i in 0..n {
			f += math.Abs(floats[i & 7])
		}
	case "math.Ceil":
		for i in 0..n {
			f += math.Ceil(floats[i & 7])
		}
	case "math.Floor":
		for i in 0..n {
			f += math.Floor(floats[i & 7])
		}
	case "math.Trunc":
		for i in 0..n {
			f += math.Trunc(floats[i & 7])
		}
	case "math.Round":
		for i in 0..n {
			f += math.Round(floats[i & 7])
		}
	case "math.Sqrt":
		for i in 0..n {
			f += math.Sqrt(float64(i & 1023))
		}
	case "math.Pow":
		for i in 0..n {
			f += math.Pow(1.0001, float64(i & 63))
		}
	case "math.FMA":
		for i in 0..n {
			f += math.FMA(floats[i & 7], 0.5, 1.0)
		}
	case "math.Mod":
		for i in 0..n {
			f += math.Mod(floats[i & 7], 3.0)
		}
	case "math.Log":
		for i in 0..n {
			f += math.Log(float64((i & 1023) + 1))
		}
	case "math.Exp":
		for i in 0..n {
			f += math.Exp(floats[i & 7] / 1e15)
		}
	case "math.Inf":
		for i in 0..n {
			if math.Inf((i & 1) * 2 - 1) > 0.0 {
				acc += 1
			}
		}
	case "math.NaN":
		for i in 0..n {
			if math.NaN() != floats[i & 7] {
				acc += 1
			}
		}
	case "math.IsNaN":
		for i in 0..n {
			if math.IsNaN(floats[i & 7]) {
				acc += 1
			}
		}
	case "math.IsInf":
		for i in 0..n {
			if math.IsInf(floats[i & 7] * 1e300, (i & 1) * 2 - 1) {
				acc += 1
			}
		}
	case "utf8.RuneCount":
		for i in 0..n {
			acc += utf8.RuneCount(words[i & 7])
		}
	case "utf8.DecodeRuneInString":
		for i in 0..n {
			let d = utf8.DecodeRuneInString(words[i & 7])
			acc += int(d.Rune) + d.Size
		}
	case "utf8.AppendRune":
		for i in 0..n {
			acc += len(utf8.AppendRune([]byte{}, runes[i & 7]))
		}
	case "utf8.ValidString":
		for i in 0..n {
			if utf8.ValidString(words[i & 7]) {
				acc += 1
			}
		}
	case "utf8.ValidRune":
		for i in 0..n {
			if utf8.ValidRune(runes[i & 7]) {
				acc += 1
			}
		}
	case "utf8.RuneLen":
		for i in 0..n {
			acc += utf8.RuneLen(runes[i & 7])
		}
	case "strings.Compare":
		for i in 0..n {
			acc += strings.Compare(words[i & 7], words[(i + 3) & 7])
		}
	case "strings.Split":
		for i in 0..n {
			acc += len(strings.Split(lines[i & 3], ","))
		}
	case "strings.Join":
		for i in 0..n {
			acc += len(strings.Join(parts, words[i & 7]))
		}
	case "strings.HasPrefix":
		for i in 0..n {
			if strings.HasPrefix(lines[i & 3], words[i & 7]) {
				acc += 1
			}
		}
	case "strings.HasSuffix":
		for i in 0..n {
			if strings.HasSuffix(lines[i & 3], words[i & 7]) {
				acc += 1
			}
		}
	case "strings.TrimSpace":
		for i in 0..n {
			acc += len(strings.TrimSpace(lines[i & 3]))
		}
	case "strings.TrimPrefix":
		for i in 0..n {
			acc += len(strings.TrimPrefix(lines[i & 3], "  the"))
		}
	case "strings.TrimSuffix":
		for i in 0..n {
			acc += len(strings.TrimSuffix(lines[i & 3], "dog "))
		}
	case "strings.TrimLeft":
		for i in 0..n {
			acc += len(strings.TrimLeft(lines[i & 3], " t"))
		}
	case "strings.TrimRight":
		for i in 0..n {
			acc += len(strings.TrimRight(lines[i & 3], " g"))
		}
	case "strings.Fields":
		for i in 0..n {
			acc += len(strings.Fields(lines[i & 3]))
		}
	case "strings.Repeat":
		for i in 0..n {
			acc += len(strings.Repeat(words[i & 7], i & 3))
		}
	case "strings.ToLower":
		for i in 0..n {
			acc += len(strings.ToLower(lines[i & 3]))
		}
	case "strings.ToUpper":
		for i in 0..n {
			acc += len(strings.ToUpper(lines[i & 3]))
		}
	case "strings.Index":
		for i in 0..n {
			acc += strings.Index(lines[i & 3], words[i & 7])
		}
	case "strings.IndexByte":
		for i in 0..n {
			acc += strings.IndexByte(lines[i & 3], byte(97 + (i & 15)))
		}
	case "strings.Contains":
		for i in 0..n {
			if strings.Contains(lines[i & 3], words[i & 7]) {
				acc += 1
			}
		}
	case "strings.ReplaceAll":
		for i in 0..n {
			acc += len(strings.ReplaceAll(lines[i & 3], "o", "00"))
		}
	case "strings.LastIndex":
		for i in 0..n {
			acc += strings.LastIndex(lines[i & 3], words[i & 7])
		}
	case "strings.Count":
		for i in 0..n {
			acc += strings.Count(lines[i & 3], "o")
		}
	case "strings.SplitN":
		for i in 0..n {
			acc += len(strings.SplitN(lines[i & 3], ",", i & 3))
		}
	case "strings.EqualFold":
		for i in 0..n {
			if strings.EqualFold(words[i & 7], upper[i & 7]) {
				acc += 1
			}
		}
	case "strings.ContainsRune":
		for i in 0..n {
			if strings.ContainsRune(lines[i & 3], runes[i & 7]) {
				acc += 1
			}
		}
	case "strings.ToValidUTF8":
		for i in 0..n {
			acc += len(strings.ToValidUTF8(words[i & 7], "?"))
		}
	case "strconv.Itoa":
		for i in 0..n {
			acc += len(strconv.Itoa(i * 7919 - 500000))
		}
	case "strconv.FormatInt":
		for i in 0..n {
			acc += len(strconv.FormatInt(int64(i * 7919), 2 + (i & 31)))
		}
	case "strconv.FormatBool":
		for i in 0..n {
			acc += len(strconv.FormatBool((i & 1) == 0))
		}
	case "strconv.FormatFloat":
		for i in 0..n {
			acc += len(strconv.FormatFloat(floats[i & 7], 'g', -1))
		}
	case "strconv.Quote":
		for i in 0..n {
			acc += len(strconv.Quote(words[i & 7]))
		}
	case "hex.Encode":
		for i in 0..n {
			acc += len(hex.Encode(words[i & 7]))
		}
	case "hex.Decode":
		for i in 0..n {
			acc += len(hex.Decode(hexes[i & 3]) catch {
			case hex.Malformed as m:
				"\(m.Offset)"
			})
		}
	case "filepath.Base":
		for i in 0..n {
			acc += len(filepath.Base(paths[i & 7]))
		}
	case "filepath.Dir":
		for i in 0..n {
			acc += len(filepath.Dir(paths[i & 7]))
		}
	case "filepath.Ext":
		for i in 0..n {
			acc += len(filepath.Ext(paths[i & 7]))
		}
	case "filepath.Clean":
		for i in 0..n {
			acc += len(filepath.Clean(paths[i & 7]))
		}
	case "filepath.IsAbs":
		for i in 0..n {
			if filepath.IsAbs(paths[i & 7]) {
				acc += 1
			}
		}
	case "filepath.Split":
		for i in 0..n {
			let sp = filepath.Split(paths[i & 7])
			acc += len(sp.Dir) + len(sp.File)
		}
	case "filepath.Rel":
		for i in 0..n {
			acc += len(filepath.Rel(paths[i & 7], paths[(i + 3) & 7]) catch {
			case filepath.NotRelative:
				"x"
			})
		}
	case "filepath.Join":
		for i in 0..n {
			acc += len(filepath.Join([]string{parts[i & 3], paths[i & 7]}))
		}
	case "cmp.Compare":
		for i in 0..n {
			acc += cmp.Compare(i & 15, (i * 7) & 15)
		}
	case "cmp.CompareFloat":
		for i in 0..n {
			acc += cmp.Compare(floats[i & 7], floats[(i + 3) & 7])
		}
	case "cmp.CompareString":
		for i in 0..n {
			acc += cmp.Compare(words[i & 7], words[(i + 3) & 7])
		}
	case "cmp.Less":
		for i in 0..n {
			if cmp.Less(floats[i & 7], floats[(i + 5) & 7]) {
				acc += 1
			}
		}
	case "strings.PadLeft":
		for i in 0..n {
			acc += len(strings.PadLeft(words[i & 7], i & 15, runes[i & 7]))
		}
	case "strings.PadRight":
		for i in 0..n {
			acc += len(strings.PadRight(words[i & 7], i & 15, ' '))
		}
	case "slices.Contains":
		for i in 0..n {
			if slices.Contains(ints, i & 31) {
				acc += 1
			}
		}
	case "slices.Index":
		for i in 0..n {
			acc += slices.Index(ints, i & 31)
		}
	case "slices.Equal":
		for i in 0..n {
			if slices.Equal(ints, ints2[i & 1]) {
				acc += 1
			}
		}
	case "slices.Max":
		for i in 0..n {
			match slices.Max(ints2[i & 1]) {
			case Some[int] as v:
				acc += v.Value
			case None:
				acc += 1
			}
		}
	case "slices.Min":
		for i in 0..n {
			match slices.Min(ints2[i & 1]) {
			case Some[int] as v:
				acc += v.Value
			case None:
				acc += 1
			}
		}
	case "slices.BinarySearch":
		for i in 0..n {
			match slices.BinarySearch(asc, i & 31) {
			case Some[int] as v:
				acc += v.Value
			case None:
				acc += 1
			}
		}
	case "math.ToInt":
		for i in 0..n {
			acc += int(math.ToInt(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToInt8":
		for i in 0..n {
			acc += int(math.ToInt8(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToInt16":
		for i in 0..n {
			acc += int(math.ToInt16(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToInt32":
		for i in 0..n {
			acc += int(math.ToInt32(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToInt64":
		for i in 0..n {
			acc += int(math.ToInt64(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToUint":
		for i in 0..n {
			acc += int(math.ToUint(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToUint8":
		for i in 0..n {
			acc += int(math.ToUint8(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToUint16":
		for i in 0..n {
			acc += int(math.ToUint16(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToUint32":
		for i in 0..n {
			acc += int(math.ToUint32(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToUint64":
		for i in 0..n {
			acc += int(math.ToUint64(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "math.ToUintptr":
		for i in 0..n {
			acc += int(math.ToUintptr(cfloats[i & 7]) catch {
			case math.OutOfRange:
				0
			})
		}
	case "sha256.Sum":
		for i in 0..n {
			acc += int(sha256.Sum(words[i & 7] + lines[i & 3])[i & 31])
		}
	case "base64.Encode":
		for i in 0..n {
			let e base64.Encoding = if (i & 1) == 0 { base64.StdEncoding } else { base64.URLEncoding }
			acc += len(base64.Encode(e, words[i & 7] + lines[i & 3]))
		}
	case "crc32.Update":
		for i in 0..n {
			acc += int(crc32.Update(uint32(i), lines[i & 3] + words[i & 7]) & 1023)
		}
	case "slices.Sort":
		for i in 0..n {
			acc += slices.Sort(ints)[i & 15]
		}
	case "slices.SortDead":
		for i in 0..n {
			let mut xs = slices.Clone(ints)
			xs[0] = i & 31
			acc += slices.Sort(xs)[i & 15]
		}
	case "slices.SortFunc":
		for i in 0..n {
			acc += slices.SortFunc(ints, func(a int, b int) int { b - a })[i & 15]
		}
	case "slices.SortStableFunc":
		for i in 0..n {
			acc += slices.SortStableFunc(ints, func(a int, b int) int { (a & 3) - (b & 3) })[i & 15]
		}
	case "crc32.Checksum":
		for i in 0..n {
			acc += int(crc32.Checksum(lines[i & 3] + words[i & 7]) & 1023)
		}
	case "strconv.ParseBool":
		for i in 0..n {
			if strconv.ParseBool(bools[i & 7]) catch {
			case strconv.Malformed:
				acc += 2
				false
			} {
				acc += 1
			}
		}
	case "strconv.Unquote":
		for i in 0..n {
			acc += len(strconv.Unquote(quoted[i & 7]) catch {
			case strconv.Malformed:
				"?"
			})
		}
	case "time.Times":
		for i in 0..n {
			acc += int(int64(time.Times(durs[i & 7], i * 7919 - 500000)) & 1023)
		}
	case "time.Divide":
		for i in 0..n {
			acc += int(int64(time.Divide(durs[i & 7], (i & 15) + 1)) & 1023)
		}
	case "atomic.Add":
		let c = atomic.NewInt64(0)
		for i in 0..n {
			acc += int(c.Add(int64(i & 7)) & 1023)
		}
	case "atomic.CompareAndSwap":
		let c = atomic.NewInt64(0)
		for i in 0..n {
			if c.CompareAndSwap(int64(i & 1), int64((i + 1) & 1)) {
				acc += 1
			}
		}
	case "atomic.Load":
		let c = atomic.NewInt64(5)
		for i in 0..n {
			acc += int(c.Load()) + (i & 1)
		}
	case "atomic.Swap":
		let c = atomic.NewInt64(0)
		for i in 0..n {
			acc += int(c.Swap(int64(i & 7)))
		}
	case "atomic.NewInt64":
		for i in 0..n {
			acc += int(atomic.NewInt64(int64(i & 7)).Load())
		}
	case "atomic.BoolSwap":
		let flag = atomic.NewBool(false)
		for i in 0..n {
			if flag.Swap((i & 1) == 0) {
				acc += 1
			}
		}
	case "time.Count":
		for i in 0..n {
			acc += time.Count(durs[i & 7], durs[(i + 3) & 7] + 1ns) & 1023
		}
	case "config.FlagName":
		for i in 0..n {
			acc += len(config.FlagName(keys[i & 7]))
		}
	case "config.EnvName":
		for i in 0..n {
			acc += len(config.EnvName("APP", keys[i & 7]))
		}
	case "config.FlagKey":
		for i in 0..n {
			acc += len(config.FlagKey(flags[i & 7]))
		}
	case "config.EnvKey":
		for i in 0..n {
			acc += len(config.EnvKey("APP", envs[i & 7]))
		}
	case "strings.TrimFunc":
		for i in 0..n {
			acc += len(strings.TrimFunc(lines[i & 3], utf8.IsSpace))
		}
	case "strings.FieldsFunc":
		for i in 0..n {
			acc += len(strings.FieldsFunc(lines[i & 3], utf8.IsSpace))
		}
	case _:
		return os.Exit{Code: 2, Message: "bodies: no kind \(strconv.Quote(kind))"}
	}
	"\(acc) \(f)"
}

func main() fails os.Exit needs Console | Ambient {
	let args = os.NewHost().Args()
	if len(args) != 2 {
		return os.Exit{Code: 2, Message: "usage: bodies KIND N"}
	}
	let n = strconv.Atoi(args[1]) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return os.Exit{Code: 2, Message: "bodies: N must be a count"}
	}
	Console.Println(try run(args[0], n))
}
