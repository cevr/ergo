// bodies is NP4f's count of a moved std function (np4f-plan §6.1): `bodies
// KIND N` calls the std function KIND names N times and prints a checksum.
// Built once at the base (the old extern) and once at the head (the import
// go call or the Ergo body), the two binaries run the same loop, so the
// slope of their instructions between two sizes is the cost of one call of
// the old body and of the new one (README.md).

import bits
import math
import os
import strconv
import utf8

func run(kind string, n int) string fails os.Exit {
	let words = []string{"plain", "é", "世界", "a\xffb", "", "🙂x", "ascii text", "\xe4\xb8"}
	let floats = []float64{0.5, -3.75, 1e10, 123456.789, -1e15, 42.0, 7.25, -0.0}
	let runes = []rune{97, 233, 19990, 128512, 55296, -1, 1114111, 1114112}
	let mut acc = 0
	let mut f = 0.0
	match kind {
	case "bits.OnesCount":
		for i in 0..n {
			acc += bits.OnesCount(uint(i * 2654435761))
		}
	case "bits.OnesCount64":
		for i in 0..n {
			acc += bits.OnesCount64(uint64(i * 2654435761))
		}
	case "bits.LeadingZeros":
		for i in 0..n {
			acc += bits.LeadingZeros(uint(i))
		}
	case "bits.LeadingZeros64":
		for i in 0..n {
			acc += bits.LeadingZeros64(uint64(i))
		}
	case "bits.TrailingZeros":
		for i in 0..n {
			acc += bits.TrailingZeros(uint(i))
		}
	case "bits.TrailingZeros64":
		for i in 0..n {
			acc += bits.TrailingZeros64(uint64(i))
		}
	case "bits.Len":
		for i in 0..n {
			acc += bits.Len(uint(i))
		}
	case "bits.Len64":
		for i in 0..n {
			acc += bits.Len64(uint64(i))
		}
	case "bits.RotateLeft32":
		for i in 0..n {
			acc += int(bits.RotateLeft32(uint32(i), i & 31) & 0xff)
		}
	case "bits.RotateLeft64":
		for i in 0..n {
			acc += int(bits.RotateLeft64(uint64(i), i & 63) & 0xff)
		}
	case "math.Abs":
		for i in 0..n {
			f += math.Abs(floats[i & 7])
		}
	case "math.Ceil":
		for i in 0..n {
			f += math.Ceil(floats[i & 7])
		}
	case "math.Floor":
		for i in 0..n {
			f += math.Floor(floats[i & 7])
		}
	case "math.Trunc":
		for i in 0..n {
			f += math.Trunc(floats[i & 7])
		}
	case "math.Round":
		for i in 0..n {
			f += math.Round(floats[i & 7])
		}
	case "math.Sqrt":
		for i in 0..n {
			f += math.Sqrt(float64(i & 1023))
		}
	case "math.Pow":
		for i in 0..n {
			f += math.Pow(1.0001, float64(i & 63))
		}
	case "math.FMA":
		for i in 0..n {
			f += math.FMA(floats[i & 7], 0.5, 1.0)
		}
	case "math.Mod":
		for i in 0..n {
			f += math.Mod(floats[i & 7], 3.0)
		}
	case "math.Log":
		for i in 0..n {
			f += math.Log(float64((i & 1023) + 1))
		}
	case "math.Exp":
		for i in 0..n {
			f += math.Exp(floats[i & 7] / 1e15)
		}
	case "math.Inf":
		for i in 0..n {
			if math.Inf((i & 1) * 2 - 1) > 0.0 {
				acc += 1
			}
		}
	case "math.NaN":
		for i in 0..n {
			if math.NaN() != floats[i & 7] {
				acc += 1
			}
		}
	case "math.IsNaN":
		for i in 0..n {
			if math.IsNaN(floats[i & 7]) {
				acc += 1
			}
		}
	case "math.IsInf":
		for i in 0..n {
			if math.IsInf(floats[i & 7] * 1e300, (i & 1) * 2 - 1) {
				acc += 1
			}
		}
	case "utf8.RuneCount":
		for i in 0..n {
			acc += utf8.RuneCount(words[i & 7])
		}
	case "utf8.DecodeRuneInString":
		for i in 0..n {
			let d = utf8.DecodeRuneInString(words[i & 7])
			acc += int(d.Rune) + d.Size
		}
	case "utf8.AppendRune":
		for i in 0..n {
			acc += len(utf8.AppendRune([]byte{}, runes[i & 7]))
		}
	case "utf8.ValidString":
		for i in 0..n {
			if utf8.ValidString(words[i & 7]) {
				acc += 1
			}
		}
	case "utf8.ValidRune":
		for i in 0..n {
			if utf8.ValidRune(runes[i & 7]) {
				acc += 1
			}
		}
	case "utf8.RuneLen":
		for i in 0..n {
			acc += utf8.RuneLen(runes[i & 7])
		}
	case _:
		return os.Exit{Code: 2, Message: "bodies: no kind \(strconv.Quote(kind))"}
	}
	"\(acc) \(f)"
}

func main() fails os.Exit needs Console | Ambient {
	let args = os.NewHost().Args()
	if len(args) != 2 {
		return os.Exit{Code: 2, Message: "usage: bodies KIND N"}
	}
	let n = strconv.Atoi(args[1]) catch {
	case strconv.Malformed, strconv.OutOfRange:
		return os.Exit{Code: 2, Message: "bodies: N must be a count"}
	}
	Console.Println(try run(args[0], n))
}
