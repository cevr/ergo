#!/bin/sh
# A stand-in for bin/ergo in the runner's tests; each test copies it into its
# own directory. It accepts only the argument shapes the runner uses and logs
# every call to calls.log beside itself:
#   build SRC -o OUT     makes SRC (a shell script) the executable OUT; fails
#                        on a line BUILDFAIL;
#   fmt --check FILE...  fails on a file holding UNFORMATTED;
#   test FILE            prints the pending-command line on TESTPENDING,
#                        fails on TESTFAIL, passes otherwise.
printf '%s\n' "$*" >> "$(dirname "$0")/calls.log"
case "$1" in
test)
  [ $# -eq 2 ] || { echo "fake ergo: want test FILE, got $*" >&2; exit 64; }
  if grep -q TESTPENDING "$2"; then echo "ergo test: not available yet; lowering adds it (#196)" >&2; exit 1; fi
  if grep -q TESTFAIL "$2"; then echo "FAIL Fixture: assert failed at main.ergo:1:1: false"; echo "FAIL (1 of 1 tests)"; exit 1; fi
  echo "ok Fixture"; echo "PASS (1 tests)"
  ;;
build)
  [ $# -eq 4 ] && [ "$3" = "-o" ] || { echo "fake ergo: want build SRC -o OUT, got $*" >&2; exit 64; }
  if grep -q BUILDFAIL "$2"; then echo "fake ergo: build failed" >&2; exit 1; fi
  cp "$2" "$4" && chmod +x "$4"
  ;;
fmt)
  [ "$2" = "--check" ] || { echo "fake ergo: want fmt --check FILE..., got $*" >&2; exit 64; }
  shift 2
  [ $# -gt 0 ] || { echo "fake ergo: fmt --check with no files" >&2; exit 64; }
  for f in "$@"; do
    if grep -q UNFORMATTED "$f"; then echo "fake ergo: $f needs formatting" >&2; exit 1; fi
  done
  ;;
*)
  echo "fake ergo: unknown command $1" >&2; exit 64
  ;;
esac
