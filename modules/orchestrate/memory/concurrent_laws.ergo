import github.com/cevr/ergo/modules/orchestrate/orchestrate
import option
import pace
import testing

type orchAct =
	| OrchExec{Env orchestrate.Envelope}
	| OrchReadUnit{Key orchestrate.UnitKey}

type orchRes =
	| OrchExecOK{Seq int, Duplicate bool}
	| OrchRefused{Kind string}
	| OrchUnit{Status string, Receipts int}
	| OrchNoUnit{}

type orchStory {
	state orchestrate.State,
	seq   int,
}

func unitRes(u option.Option[orchestrate.Unit], receipts int) orchRes {
	match u {
	case option.Some[orchestrate.Unit] as found:
		OrchUnit{Status: orchestrate.UnitStatusName(found.Value.Status), Receipts: receipts}
	case option.None:
		OrchNoUnit
	}
}

func orchStoryStep(st orchStory, a orchAct) (orchStory, orchRes) {
	match a {
	case OrchExec as ex:
		let events = orchestrate.Decide(st.state, ex.Env) catch {
		case orchestrate.NotFound:
			return (st, OrchRefused{Kind: "NotFound"})
		case orchestrate.AlreadyExists:
			return (st, OrchRefused{Kind: "AlreadyExists"})
		case orchestrate.InvalidTransition:
			return (st, OrchRefused{Kind: "InvalidTransition"})
		case orchestrate.CommandReused:
			return (st, OrchRefused{Kind: "CommandReused"})
		case orchestrate.InvalidInput:
			return (st, OrchRefused{Kind: "InvalidInput"})
		case orchestrate.Unverified:
			return (st, OrchRefused{Kind: "Unverified"})
		case orchestrate.NotAcceptedHead:
			return (st, OrchRefused{Kind: "NotAcceptedHead"})
		case orchestrate.LaneHeld:
			return (st, OrchRefused{Kind: "LaneHeld"})
		case orchestrate.NotOwner:
			return (st, OrchRefused{Kind: "NotOwner"})
		case orchestrate.LandingBusy:
			return (st, OrchRefused{Kind: "LandingBusy"})
		case orchestrate.StaleHead:
			return (st, OrchRefused{Kind: "StaleHead"})
		case orchestrate.NoLease:
			return (st, OrchRefused{Kind: "NoLease"})
		}
		if events.Len() == 0 {
			return (st, OrchExecOK{Seq: st.seq, Duplicate: true})
		}
		let nextSeq = st.seq + events.Len()
		(orchStory{state: orchestrate.ApplyAll(st.state, events), seq: nextSeq}, OrchExecOK{Seq: nextSeq, Duplicate: false})
	case OrchReadUnit as r:
		(st, unitRes(orchestrate.UnitByKey(st.state, r.Key), orchestrate.ReceiptsOf(st.state, r.Key).Len()))
	}
}

func runOrchAct(store Store, a orchAct) orchRes {
	match a {
	case OrchExec as ex:
		let r = store.Execute(ex.Env) catch {
		case orchestrate.NotFound:
			return OrchRefused{Kind: "NotFound"}
		case orchestrate.AlreadyExists:
			return OrchRefused{Kind: "AlreadyExists"}
		case orchestrate.InvalidTransition:
			return OrchRefused{Kind: "InvalidTransition"}
		case orchestrate.CommandReused:
			return OrchRefused{Kind: "CommandReused"}
		case orchestrate.InvalidInput:
			return OrchRefused{Kind: "InvalidInput"}
		case orchestrate.Unverified:
			return OrchRefused{Kind: "Unverified"}
		case orchestrate.NotAcceptedHead:
			return OrchRefused{Kind: "NotAcceptedHead"}
		case orchestrate.LaneHeld:
			return OrchRefused{Kind: "LaneHeld"}
		case orchestrate.NotOwner:
			return OrchRefused{Kind: "NotOwner"}
		case orchestrate.LandingBusy:
			return OrchRefused{Kind: "LandingBusy"}
		case orchestrate.StaleHead:
			return OrchRefused{Kind: "StaleHead"}
		case orchestrate.NoLease:
			return OrchRefused{Kind: "NoLease"}
		case orchestrate.StoreFailed:
			return OrchRefused{Kind: "StoreFailed"}
		}
		OrchExecOK{Seq: r.Seq, Duplicate: r.Duplicate}
	case OrchReadUnit as rd:
		let u = store.Unit(rd.Key) catch {
		case orchestrate.StoreFailed:
			return OrchRefused{Kind: "StoreFailed"}
		}
		let rs = store.Receipts(rd.Key) catch {
		case orchestrate.StoreFailed:
			return OrchRefused{Kind: "StoreFailed"}
		}
		unitRes(u, rs.Len())
	}
}

func showOrchAct(a orchAct) string {
	match a {
	case OrchExec as ex:
		"Exec(\(string(ex.Env.ID)))"
	case OrchReadUnit as r:
		"Read(\(orchestrate.UnitKeyText(r.Key)))"
	}
}

func showOrchRes(r orchRes) string {
	match r {
	case OrchExecOK as ok:
		"OK(seq=\(ok.Seq),dup=\(ok.Duplicate))"
	case OrchRefused as ref:
		"Refused(\(ref.Kind))"
	case OrchUnit as u:
		"Unit(\(u.Status),\(u.Receipts))"
	case OrchNoUnit:
		"NoUnit"
	}
}

func concEnv(id string, cmd orchestrate.Command) orchestrate.Envelope {
	orchestrate.Envelope{ID: orchestrate.CommandID(id), Actor: "w", At: "2026-11-25T09:00:00Z", Command: cmd}
}

test OrchestrateStoreConcurrentLinearizable {
	let _ = pace.NewCounting()
	let store = New()
	let key = orchestrate.UnitKey{Repo: "repo", Run: "conc", ID: "u1"}
	let open = concEnv("open", orchestrate.OpenUnit{Key: key, Title: "Unit 1", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None})
	let green = concEnv("green", orchestrate.RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: "h", ExitCode: 0, ExitLines: "ok"})
	let red = concEnv("red", orchestrate.RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: "h", ExitCode: 1, ExitLines: "FAIL"})
	let accept1 = concEnv("accept-1", orchestrate.AcceptUnit{Unit: key, Head: "h"})
	let accept2 = concEnv("accept-2", orchestrate.AcceptUnit{Unit: key, Head: "h"})
	let plans = [][]orchAct{
		[]orchAct{OrchExec{Env: open}, OrchExec{Env: green}, OrchExec{Env: accept1}},
		[]orchAct{OrchExec{Env: red}, OrchReadUnit{Key: key}},
		[]orchAct{OrchExec{Env: accept2}, OrchReadUnit{Key: key}},
	}
	let start = orchStory{state: orchestrate.EmptyState(), seq: 0}
	testing.AgreesConcurrent(start, orchStoryStep, plans, func(a orchAct) orchRes {
		runOrchAct(store, a)
	}) catch {
	case testing.NotLinearizable[orchAct, orchRes] as nl:
		assert testing.FormatHistory(nl.History, showOrchAct, showOrchRes) == ""
	}
}
