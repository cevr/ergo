import core
import explore
import github.com/cevr/ergo/modules/orchestrate/orchestrate
import option
import sync
import testing

type omCmd = omOpenUnit{} | omReuseConflict{} | omGreen{} | omRed{} | omAccept{} | omLand{} | omImportPlan{}

type omState {
	Ops []omCmd,
}

type omObs {
	Seq           int,
	Status        string,
	Receipts      int,
	UnitCount     int,
	OpenDecisions int,
	Landings      int,
	Events        int,
	MainHead      option.Option[string],
}

type omReply =
	| omExecuted{Seq int, Duplicate bool, EvCount int}
	| omRefused{Kind string}

type OrchMemOpenErr { Why string }

type OrchMemDriveErr { Why string }

let omKey = orchestrate.UnitKey{Repo: "repo", Run: "paths", ID: "u1"}

func omEnvelope(cmd omCmd, step int) orchestrate.Envelope {
	let ts = "2026-11-25T09:00:\(10 + step)Z"
	match cmd {
	case omOpenUnit:
		orchestrate.Envelope{ID: orchestrate.CommandID("paths-open-u1"), Actor: "coord", At: ts, Command: orchestrate.OpenUnit{Key: omKey, Title: "Unit One", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None}}
	case omReuseConflict:
		orchestrate.Envelope{ID: orchestrate.CommandID("paths-open-u1"), Actor: "coord", At: ts, Command: orchestrate.OpenUnit{Key: omKey, Title: "Conflict Title", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None}}
	case omGreen:
		orchestrate.Envelope{ID: orchestrate.CommandID("paths-green-\(step)"), Actor: "w1", At: ts, Command: orchestrate.RecordReceipt{Unit: omKey, Kind: "acceptance", Command: "ergo test", Head: "h", ExitCode: 0, ExitLines: "ok"}}
	case omRed:
		orchestrate.Envelope{ID: orchestrate.CommandID("paths-red-\(step)"), Actor: "w1", At: ts, Command: orchestrate.RecordReceipt{Unit: omKey, Kind: "acceptance", Command: "ergo test", Head: "h", ExitCode: 1, ExitLines: "FAIL"}}
	case omAccept:
		orchestrate.Envelope{ID: orchestrate.CommandID("paths-accept-\(step)"), Actor: "coord", At: ts, Command: orchestrate.AcceptUnit{Unit: omKey, Head: "h"}}
	case omLand:
		orchestrate.Envelope{ID: orchestrate.CommandID("paths-land-\(step)"), Actor: "coord", At: ts, Command: orchestrate.LandUnit{Unit: omKey, Head: "h"}}
	case omImportPlan:
		let plan = "- 2026-11-26T10:00:00Z RULED (Path Rule): stay pure.\nMAIN MOVED 2026-11-26T10:01:00Z: main = aabbcc11 (Landing 1, group g1). Tips: u1\n"
		orchestrate.Envelope{ID: orchestrate.CommandID("paths-imp-1"), Actor: "coord", At: ts, Command: orchestrate.IngestPlan{Repo: "repo", Run: "paths", Text: plan}}
	}
}

func omApplyModel(st orchestrate.State, seq int, cmd omCmd, step int) (orchestrate.State, int, omReply) {
	let evts = orchestrate.Decide(st, omEnvelope(cmd, step)) catch {
	case orchestrate.NotFound:
		return (st, seq, omRefused{Kind: "not_found"})
	case orchestrate.AlreadyExists:
		return (st, seq, omRefused{Kind: "already_exists"})
	case orchestrate.InvalidTransition:
		return (st, seq, omRefused{Kind: "invalid_transition"})
	case orchestrate.CommandReused:
		return (st, seq, omRefused{Kind: "command_reused"})
	case orchestrate.InvalidInput:
		return (st, seq, omRefused{Kind: "invalid_input"})
	case orchestrate.Unverified:
		return (st, seq, omRefused{Kind: "unverified"})
	case orchestrate.NotAcceptedHead:
		return (st, seq, omRefused{Kind: "not_accepted_head"})
	case orchestrate.LaneHeld:
		return (st, seq, omRefused{Kind: "lane_held"})
	case orchestrate.NotOwner:
		return (st, seq, omRefused{Kind: "not_owner"})
	case orchestrate.LandingBusy:
		return (st, seq, omRefused{Kind: "landing_busy"})
	case orchestrate.StaleHead:
		return (st, seq, omRefused{Kind: "stale_head"})
	case orchestrate.NoLease:
		return (st, seq, omRefused{Kind: "no_lease"})
	}
	if evts.Len() == 0 {
		return (st, seq, omExecuted{Seq: seq, Duplicate: true, EvCount: 0})
	}
	let nextSeq = seq + evts.Len()
	(orchestrate.ApplyAll(st, evts), nextSeq, omExecuted{Seq: nextSeq, Duplicate: false, EvCount: evts.Len()})
}

func omFold(ops []omCmd) (orchestrate.State, int) {
	let mut st = orchestrate.EmptyState()
	let mut seq = 0
	for i, op in ops {
		let (ns, nseq, _) = omApplyModel(st, seq, op, i+1)
		st = ns
		seq = nseq
	}
	(st, seq)
}

func omObsOf(u option.Option[orchestrate.Unit], receipts int, seq int, sum orchestrate.RunOverview, evTotal int) omObs {
	let status = match u {
	case option.Some[orchestrate.Unit] as found:
		orchestrate.UnitStatusName(found.Value.Status)
	case option.None:
		"none"
	}
	omObs{
		Seq:           seq,
		Status:        status,
		Receipts:      receipts,
		UnitCount:     sum.TotalUnits,
		OpenDecisions: sum.OpenDecisions,
		Landings:      sum.RecentLandings.Len(),
		Events:        evTotal,
		MainHead:      sum.MainHead,
	}
}

func omModelObs(st orchestrate.State, seq int) omObs {
	let sum = orchestrate.QueryRunSummary(st, "repo", "paths", 5)
	let evs = orchestrate.QueryEventLog(st, orchestrate.EventLogFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "paths"}, Kind: option.None, UnitID: option.None, Actor: option.None, Ascending: false, Limit: 50, Offset: 0})
	omObsOf(orchestrate.UnitByKey(st, omKey), orchestrate.ReceiptsOf(st, omKey).Len(), seq, sum, evs.Total)
}

func omModel() explore.PathModel[omState, omCmd, omObs, omReply, core.Never] {
	explore.PathModel[omState, omCmd, omObs, omReply, core.Never]{
		Graph: explore.ConcreteGraph[omState, omCmd, explore.StepObs[omObs, omReply, core.Never]]{
			Starts:  []omState{omState{Ops: []omCmd{}}},
			Signals: []omCmd{omOpenUnit, omReuseConflict, omGreen, omRed, omAccept, omLand, omImportPlan},
			Step:    func(s omState, cmd omCmd) explore.EdgeOutcome[omState, explore.StepObs[omObs, omReply, core.Never]] {
				let (curSt, curSeq) = omFold(s.Ops)
				let (nextSt, nextSeq, reply) = omApplyModel(curSt, curSeq, cmd, s.Ops.Len()+1)
				let nextOps = match reply {
				case omExecuted as ex:
					if ex.Duplicate { s.Ops } else { s.Ops.Append(cmd) }
				case omRefused:
					s.Ops
				}
				let kind = match reply {
				case omExecuted as ex:
					if ex.Duplicate { explore.DisIgnore } else { explore.DisEmit }
				case omRefused:
					explore.DisReject
				}
				explore.Continue[omState, explore.StepObs[omObs, omReply, core.Never]]{
					Next: omState{Ops: nextOps},
					Obs:  explore.StepObs[omObs, omReply, core.Never]{
						Kind:     kind,
						State:    option.Some[omObs]{Value: omModelObs(nextSt, nextSeq)},
						Outputs:  []omReply{reply},
						Error:    option.None,
						Terminal: false,
					},
				}
			},
		},
		InitialObs: func(s omState) omObs {
			let (st, seq) = omFold(s.Ops)
			omModelObs(st, seq)
		},
		ProjectionName: option.Some[string]{Value: "orchestrate-memory-store"},
	}
}

type omSess {
	store  Store,
	step   sync.Ref[int],
	closes sync.Ref[int],
	closed sync.Ref[bool],
} implements explore.PathSession[omCmd, explore.Observed[omObs, omReply, core.Never], OrchMemDriveErr]

func omObserveLive(st Store) omObs fails OrchMemDriveErr {
	let evts = Events(st, 0) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	for i, item in evts {
		if item.Seq != i+1 {
			return OrchMemDriveErr{Why: "non-dense event sequence"}
		}
	}
	let snap = Snapshot(st) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	if orchestrate.Fold(orchestrate.EventList(evts)) != snap {
		return OrchMemDriveErr{Why: "fold mismatch with snapshot"}
	}
	let u = Unit(st, omKey) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	let rs = Receipts(st, omKey) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	let sum = RunSummary(st, "repo", "paths", 5) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	let upage = ListUnits(st, orchestrate.UnitFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "paths"}, Status: option.None, Limit: 50, Offset: 0}) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	let dpage = ListDecisions(st, orchestrate.DecisionFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "paths"}, Category: option.None, Scope: option.None, UnitID: option.None, Status: option.Some[orchestrate.DecisionStatus]{Value: orchestrate.DecisionOpen}, Limit: 50, Offset: 0}) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	let lpage = ListLandings(st, orchestrate.LandingFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "paths"}, Limit: 50, Offset: 0}) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	let epage = ListEventLog(st, orchestrate.EventLogFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "paths"}, Kind: option.None, UnitID: option.None, Actor: option.None, Ascending: false, Limit: 50, Offset: 0}) catch {
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	if upage.Total != sum.TotalUnits || dpage.Total != sum.OpenDecisions || lpage.Total != sum.RecentLandings.Len() {
		return OrchMemDriveErr{Why: "progressive disclosure query count mismatch"}
	}
	omObsOf(u, rs.Len(), evts.Len(), sum, epage.Total)
}

func Read(s omSess) explore.Observed[omObs, omReply, core.Never] fails OrchMemDriveErr {
	explore.InitialRead[omObs]{State: try omObserveLive(s.store)}
}

func omStep(s omSess, kind explore.Disposition, reply omReply) explore.Observed[omObs, omReply, core.Never] fails OrchMemDriveErr {
	let obs = try omObserveLive(s.store)
	explore.StepResult[omObs, omReply, core.Never]{Step: explore.StepObs[omObs, omReply, core.Never]{
		Kind:     kind,
		State:    option.Some[omObs]{Value: obs},
		Outputs:  []omReply{reply},
		Error:    option.None,
		Terminal: false,
	}}
}

func Apply(s omSess, cmd omCmd) explore.Observed[omObs, omReply, core.Never] fails OrchMemDriveErr {
	let n = s.step.Get() + 1
	s.step.Set(n)
	let res = Execute(s.store, omEnvelope(cmd, n)) catch {
	case orchestrate.NotFound:
		return try omStep(s, explore.DisReject, omRefused{Kind: "not_found"})
	case orchestrate.AlreadyExists:
		return try omStep(s, explore.DisReject, omRefused{Kind: "already_exists"})
	case orchestrate.InvalidTransition:
		return try omStep(s, explore.DisReject, omRefused{Kind: "invalid_transition"})
	case orchestrate.CommandReused:
		return try omStep(s, explore.DisReject, omRefused{Kind: "command_reused"})
	case orchestrate.InvalidInput:
		return try omStep(s, explore.DisReject, omRefused{Kind: "invalid_input"})
	case orchestrate.Unverified:
		return try omStep(s, explore.DisReject, omRefused{Kind: "unverified"})
	case orchestrate.NotAcceptedHead:
		return try omStep(s, explore.DisReject, omRefused{Kind: "not_accepted_head"})
	case orchestrate.LaneHeld:
		return try omStep(s, explore.DisReject, omRefused{Kind: "lane_held"})
	case orchestrate.NotOwner:
		return try omStep(s, explore.DisReject, omRefused{Kind: "not_owner"})
	case orchestrate.LandingBusy:
		return try omStep(s, explore.DisReject, omRefused{Kind: "landing_busy"})
	case orchestrate.StaleHead:
		return try omStep(s, explore.DisReject, omRefused{Kind: "stale_head"})
	case orchestrate.NoLease:
		return try omStep(s, explore.DisReject, omRefused{Kind: "no_lease"})
	case orchestrate.StoreFailed as e:
		return OrchMemDriveErr{Why: e.Reason}
	}
	let kind = if res.Duplicate { explore.DisIgnore } else { explore.DisEmit }
	try omStep(s, kind, omExecuted{Seq: res.Seq, Duplicate: res.Duplicate, EvCount: res.Events.Len()})
}

func Close(s omSess) {
	if s.closed.Get() {
		return
	}
	s.closed.Set(true)
	s.closes.Set(s.closes.Get() + 1)
}

// OrchMemoryPaths is the model-based path-testing contract for memory.Store.
type OrchMemoryPaths {
	Open(start omState) explore.PathSession[omCmd, explore.Observed[omObs, omReply, core.Never], OrchMemDriveErr] fails OrchMemOpenErr,
	Counts() (int, int),

	// PathsAgree checks every bounded orchestrate memory store path up to depth 4
	// against pure Decide/ApplyAll: idempotency, CommandReused conflicts, and the
	// verdict following the latest receipt.
	law PathsAgree() {
		let res = explore.CheckPathsWithSink(
			omModel(),
			explore.ToDepth{Depth: 4},
			explore.PathBounds{
				MaxStates: 8192,
				MaxEdges:  16384,
				MaxPaths:  8192,
				MaxSteps:  32768,
				MaxWork:   1048576,
				MaxBytes:  4194304,
			},
			func(start omState) explore.PathSession[omCmd, explore.Observed[omObs, omReply, core.Never], OrchMemDriveErr] fails OrchMemOpenErr {
				try Open(start)
			},
			testing.ActiveEvidenceSink(),
		)
		let (opened, closed) = Counts()
		assert opened > 0 && opened == closed
		assert res.Counts.Opened == res.Counts.Planned
		assert res.Counts.InitialReads == res.Counts.Opened
		assert res.Counts.CheckedSteps == res.PlanStats.Steps
		match res.Verdict {
		case explore.CampaignPassed:
			true
		case explore.CampaignRefuted, explore.CampaignIncomplete:
			false
		}
	},
}

type omPathProvider {
	opens  sync.Ref[int],
	closes sync.Ref[int],
} implements OrchMemoryPaths

func makeOrchMemPathProvider() omPathProvider {
	omPathProvider{opens: sync.NewRef(0), closes: sync.NewRef(0)}
}

func Open(p omPathProvider, _ omState) explore.PathSession[omCmd, explore.Observed[omObs, omReply, core.Never], OrchMemDriveErr] fails OrchMemOpenErr {
	p.opens.Set(p.opens.Get() + 1)
	omSess{
		store:  New(),
		step:   sync.NewRef(0),
		closes: p.closes,
		closed: sync.NewRef(false),
	}
}

func Counts(p omPathProvider) (int, int) {
	(p.opens.Get(), p.closes.Get())
}

let onOrchMemoryPaths = context { OrchMemoryPaths: makeOrchMemPathProvider() }
