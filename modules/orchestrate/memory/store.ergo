import github.com/cevr/ergo/modules/orchestrate/orchestrate
import sync

type book {
	state orchestrate.State,
	log   []orchestrate.StoredEvent,
}

type execOutcome = execOK{Result orchestrate.ExecuteResult} | execRefused{Err orchestrate.Refusal}

// Store is a pure in-memory reference provider of orchestrate.Store backed by a sync.Ref.
type Store { cell sync.Ref[book] } implements orchestrate.Store

// New returns a fresh empty in-memory orchestrate.Store.
func New() Store {
	Store{cell: sync.NewRef(book{state: orchestrate.EmptyState(), log: []orchestrate.StoredEvent{}})}
}

// Execute runs Decide, appends the resulting events, and updates State atomically under sync.Modify.
func Execute(s Store, env orchestrate.Envelope) orchestrate.ExecuteResult fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.StaleClaim | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.StoreFailed {
	let outcome = sync.Modify(s.cell, func(b book) (execOutcome, book) {
		let events = orchestrate.Decide(b.state, env) catch {
		case orchestrate.NotFound as e:
			return (execRefused{Err: e}, b)
		case orchestrate.AlreadyExists as e:
			return (execRefused{Err: e}, b)
		case orchestrate.InvalidTransition as e:
			return (execRefused{Err: e}, b)
		case orchestrate.StaleClaim as e:
			return (execRefused{Err: e}, b)
		case orchestrate.CommandReused as e:
			return (execRefused{Err: e}, b)
		case orchestrate.InvalidInput as e:
			return (execRefused{Err: e}, b)
		}
		if len(events) == 0 {
			return (execOK{Result: orchestrate.ExecuteResult{Seq: len(b.log), Events: []orchestrate.Event{}, Duplicate: true}}, b)
		}
		let mut nextLog = b.log
		for ev in events {
			nextLog = nextLog.Append(orchestrate.StoredEvent{Seq: len(nextLog) + 1, Event: ev})
		}
		let nextState = orchestrate.ApplyAll(b.state, events)
		(execOK{Result: orchestrate.ExecuteResult{Seq: len(nextLog), Events: events, Duplicate: false}}, book{state: nextState, log: nextLog})
	})
	match outcome {
	case execOK as ok:
		ok.Result
	case execRefused as r:
		match r.Err {
		case orchestrate.NotFound as e:
			e
		case orchestrate.AlreadyExists as e:
			e
		case orchestrate.InvalidTransition as e:
			e
		case orchestrate.StaleClaim as e:
			e
		case orchestrate.CommandReused as e:
			e
		case orchestrate.InvalidInput as e:
			e
		}
	}
}

// Snapshot returns the current projected State.
func Snapshot(s Store) orchestrate.State fails orchestrate.StoreFailed {
	s.cell.Get().state
}

// Events returns all stored events with Seq > fromSeq in ascending order.
func Events(s Store, fromSeq int) []orchestrate.StoredEvent fails orchestrate.StoreFailed {
	let mut out = []orchestrate.StoredEvent{}
	for item in s.cell.Get().log {
		if item.Seq > fromSeq {
			out = out.Append(item)
		}
	}
	out
}

// Unit looks up one unit by ID.
func Unit(s Store, id string) Option[orchestrate.Unit] fails orchestrate.StoreFailed {
	orchestrate.UnitByID(s.cell.Get().state, id)
}

// ListUnits returns units filtered by optional status, sorted by ID.
func ListUnits(s Store, status Option[orchestrate.UnitStatus]) []orchestrate.Unit fails orchestrate.StoreFailed {
	orchestrate.ListUnits(s.cell.Get().state, status)
}

// Receipts returns receipts for unitID, optionally filtered by round.
func Receipts(s Store, unitID string, round Option[int]) []orchestrate.Receipt fails orchestrate.StoreFailed {
	orchestrate.ReceiptsOf(s.cell.Get().state, unitID, round)
}

// Commitment looks up one commitment by ID.
func Commitment(s Store, id string) Option[orchestrate.Commitment] fails orchestrate.StoreFailed {
	orchestrate.CommitmentByID(s.cell.Get().state, id)
}

// ListCommitments returns commitments filtered by optional status and owner.
func ListCommitments(s Store, status Option[orchestrate.CommitmentStatus], owner Option[string]) []orchestrate.Commitment fails orchestrate.StoreFailed {
	orchestrate.ListCommitments(s.cell.Get().state, status, owner)
}

// ListQueue returns queue items filtered by optional status, ordered by priority then key.
func ListQueue(s Store, status Option[string]) []orchestrate.QueueItem fails orchestrate.StoreFailed {
	orchestrate.ListQueue(s.cell.Get().state, status)
}

// Question looks up one async question by monotonic ID.
func Question(s Store, id int) Option[orchestrate.Question] fails orchestrate.StoreFailed {
	orchestrate.QuestionByID(s.cell.Get().state, id)
}

// ListQuestions returns questions (all or open-only), sorted by ascending ID.
func ListQuestions(s Store, openOnly bool) []orchestrate.Question fails orchestrate.StoreFailed {
	orchestrate.ListQuestions(s.cell.Get().state, openOnly)
}

let overMemoryStore = context { orchestrate.Store: New() }

let overMemoryApi = context { orchestrate.Api: orchestrate.NewService(New()) }

// ModelSequenceAcrossAllGroups exercises all 5 v1 tool groups through Service, verifying idempotent question retries, replay equivalence, and monotonic question IDs.
law ModelSequenceAcrossAllGroups(tag int, priority int) {
	let store = New()
	let svc = orchestrate.NewService(store)
	let uid = "m-u-\(tag)"
	let cid = "m-c-\(tag)"
	let qkey = "m-k-\(tag)"
	let digest = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
	let _ = svc.UnitOpen(orchestrate.UnitOpenInput{CommandID: orchestrate.CommandID("m1-\(tag)"), Actor: "root", At: "2026-11-24T12:00:00Z", ID: uid, Title: "M", Area: "a"}) catch {
	case _:
		return false
	}
	let _ = svc.UnitClaim(orchestrate.UnitClaimInput{CommandID: orchestrate.CommandID("m2-\(tag)"), Actor: "w1", At: "2026-11-24T12:01:00Z", ID: uid, Owner: "w1", Lane: "l1", Harness: "agy"}) catch {
	case _:
		return false
	}
	let _ = svc.ReceiptRecord(orchestrate.ReceiptRecordInput{CommandID: orchestrate.CommandID("m3-\(tag)"), Actor: "w1", At: "2026-11-24T12:02:00Z", ID: "m-r-\(tag)", UnitID: uid, Round: 1, Kind: "gate", Command: "ergo test", CommitSHA: "1234", ExitCode: 0, SummaryMetrics: "ok=1", LogPath: "/tmp/m.log", LogSHA256: digest}) catch {
	case _:
		return false
	}
	let _ = svc.UnitHandBack(orchestrate.UnitHandBackInput{CommandID: orchestrate.CommandID("m4-\(tag)"), Actor: "w1", At: "2026-11-24T12:03:00Z", ID: uid, Owner: "w1", HeadSHA: "1234", Summary: "ready", RequestPath: Some[string]{Value: "/r1.md"}, FindingsPath: None}) catch {
	case _:
		return false
	}
	let _ = svc.CommitmentAdd(orchestrate.CommitmentAddInput{CommandID: orchestrate.CommandID("m5-\(tag)"), Actor: "root", At: "2026-11-24T12:04:00Z", ID: cid, Title: "C", Kind: "plan-part"}) catch {
	case _:
		return false
	}
	let _ = svc.CommitmentLanded(orchestrate.CommitmentLandedInput{CommandID: orchestrate.CommandID("m6-\(tag)"), Actor: "root", At: "2026-11-24T12:05:00Z", ID: cid, LandedSHA: "1234"}) catch {
	case _:
		return false
	}
	let _ = svc.QueueUpsert(orchestrate.QueueUpsertInput{CommandID: orchestrate.CommandID("m7-\(tag)"), Actor: "root", At: "2026-11-24T12:06:00Z", Key: qkey, Priority: priority, Title: "Q", Body: "B", Status: "open", Tags: []string{"t"}}) catch {
	case _:
		return false
	}
	let askIn = orchestrate.QuestionAskInput{CommandID: orchestrate.CommandID("m8-\(tag)"), Actor: "w1", At: "2026-11-24T12:07:00Z", ID: None, Prompt: "Proceed?", Assumption: "yes", ConcreteAction: "reply"}
	let qFirst = svc.QuestionAsk(askIn) catch {
	case _:
		return false
	}
	let qRetry = svc.QuestionAsk(askIn) catch {
	case _:
		return false
	}
	let qAns = svc.QuestionAnswer(orchestrate.QuestionAnswerInput{CommandID: orchestrate.CommandID("m9-\(tag)"), Actor: "owner", At: "2026-11-24T12:08:00Z", ID: qFirst.ID, Answer: "approved", Withdraw: false}) catch {
	case _:
		return false
	}
	let snap = store.Snapshot() catch {
	case _:
		return false
	}
	let evs = store.Events(0) catch {
	case _:
		return false
	}
	qFirst == qRetry && qFirst.ID == 1 && qAns.Status == orchestrate.QuestionAnswered && orchestrate.Fold(orchestrate.EventList(evs)) == snap
}
