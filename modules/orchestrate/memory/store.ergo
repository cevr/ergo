import github.com/cevr/ergo/modules/orchestrate/orchestrate
import json
import option
import os/host
import sync
import time

type book {
	state orchestrate.State,
	log   []orchestrate.StoredEvent,
}

type execOutcome = execOK{Result orchestrate.ExecuteResult} | execRefused{Err orchestrate.Refusal}

// Store is a pure in-memory reference provider of orchestrate.Store backed by a sync.Ref.
type Store { cell sync.Ref[book] } implements orchestrate.Store

// New returns a fresh empty in-memory orchestrate.Store.
func New() Store {
	Store{cell: sync.NewRef(book{state: orchestrate.EmptyState(), log: []orchestrate.StoredEvent{}})}
}

// Execute runs Decide, appends the resulting events, and updates State atomically under sync.Modify.
func Execute(s Store, env orchestrate.Envelope) orchestrate.ExecuteResult fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed {
	let outcome = sync.Modify(s.cell, func(b book) (execOutcome, book) {
		let events = orchestrate.Decide(b.state, env) catch {
		case orchestrate.NotFound as e:
			return (execRefused{Err: e}, b)
		case orchestrate.AlreadyExists as e:
			return (execRefused{Err: e}, b)
		case orchestrate.InvalidTransition as e:
			return (execRefused{Err: e}, b)
		case orchestrate.CommandReused as e:
			return (execRefused{Err: e}, b)
		case orchestrate.InvalidInput as e:
			return (execRefused{Err: e}, b)
		case orchestrate.Unverified as e:
			return (execRefused{Err: e}, b)
		case orchestrate.NotAcceptedHead as e:
			return (execRefused{Err: e}, b)
		}
		if events.Len() == 0 {
			return (execOK{Result: orchestrate.ExecuteResult{Seq: b.log.Len(), Events: []orchestrate.Event{}, Duplicate: true}}, b)
		}
		let mut nextLog = b.log
		for ev in events {
			nextLog = nextLog.Append(orchestrate.StoredEvent{Seq: nextLog.Len() + 1, Event: ev})
		}
		let nextState = orchestrate.ApplyAll(b.state, events)
		(execOK{Result: orchestrate.ExecuteResult{Seq: nextLog.Len(), Events: events, Duplicate: false}}, book{state: nextState, log: nextLog})
	})
	match outcome {
	case execOK as ok:
		ok.Result
	case execRefused as r:
		match r.Err {
		case orchestrate.NotFound as e:
			e
		case orchestrate.AlreadyExists as e:
			e
		case orchestrate.InvalidTransition as e:
			e
		case orchestrate.CommandReused as e:
			e
		case orchestrate.InvalidInput as e:
			e
		case orchestrate.Unverified as e:
			e
		case orchestrate.NotAcceptedHead as e:
			e
		}
	}
}

// Snapshot returns the current projected State.
func Snapshot(s Store) orchestrate.State fails orchestrate.StoreFailed {
	s.cell.Get().state
}

// Events returns all stored events with Seq > fromSeq in ascending order.
func Events(s Store, fromSeq int) []orchestrate.StoredEvent fails orchestrate.StoreFailed {
	let mut out = []orchestrate.StoredEvent{}
	for item in s.cell.Get().log {
		if item.Seq > fromSeq {
			out = out.Append(item)
		}
	}
	out
}

// Unit looks up one unit by key.
func Unit(s Store, key orchestrate.UnitKey) option.Option[orchestrate.Unit] fails orchestrate.StoreFailed {
	orchestrate.UnitByKey(s.cell.Get().state, key)
}

// Receipts returns the receipts of the unit key in recorded order.
func Receipts(s Store, key orchestrate.UnitKey) []orchestrate.Receipt fails orchestrate.StoreFailed {
	orchestrate.ReceiptsOf(s.cell.Get().state, key)
}

// Commitment looks up one commitment by ID.
func Commitment(s Store, id string) option.Option[orchestrate.Commitment] fails orchestrate.StoreFailed {
	orchestrate.CommitmentByID(s.cell.Get().state, id)
}

// ListCommitments returns commitments filtered by optional status and owner.
func ListCommitments(s Store, status option.Option[orchestrate.CommitmentStatus], owner option.Option[string]) []orchestrate.Commitment fails orchestrate.StoreFailed {
	orchestrate.ListCommitments(s.cell.Get().state, status, owner)
}

// ListQueue returns queue items filtered by optional status, ordered by priority then key.
func ListQueue(s Store, status option.Option[string]) []orchestrate.QueueItem fails orchestrate.StoreFailed {
	orchestrate.ListQueue(s.cell.Get().state, status)
}

// Question looks up one async question by monotonic ID.
func Question(s Store, id int) option.Option[orchestrate.Question] fails orchestrate.StoreFailed {
	orchestrate.QuestionByID(s.cell.Get().state, id)
}

// ListQuestions returns questions (all or open-only), sorted by ascending ID.
func ListQuestions(s Store, openOnly bool) []orchestrate.Question fails orchestrate.StoreFailed {
	orchestrate.ListQuestions(s.cell.Get().state, openOnly)
}

// RunMeta looks up run-level metadata for (repo, run).
func RunMeta(s Store, repo string, run string) option.Option[orchestrate.RunMeta] fails orchestrate.StoreFailed {
	orchestrate.RunMetaOf(s.cell.Get().state, repo, run)
}

// RunSummary computes the compact progressive-disclosure overview for (repo, run).
func RunSummary(s Store, repo string, run string, landingsLimit int) orchestrate.RunOverview fails orchestrate.StoreFailed {
	orchestrate.QueryRunSummary(s.cell.Get().state, repo, run, landingsLimit)
}

// ListUnits returns filtered and paginated compact unit summaries without receipt payloads.
func ListUnits(s Store, filter orchestrate.UnitFilter) orchestrate.UnitPage fails orchestrate.StoreFailed {
	orchestrate.QueryUnitList(s.cell.Get().state, filter)
}

// Decision looks up one structured decision by (repo, run, id).
func Decision(s Store, repo string, run string, id string) option.Option[orchestrate.Decision] fails orchestrate.StoreFailed {
	orchestrate.DecisionByKey(s.cell.Get().state, orchestrate.DecisionKey{Repo: repo, Run: run, ID: id})
}

// ListDecisions returns filtered and paginated structured decisions.
func ListDecisions(s Store, filter orchestrate.DecisionFilter) orchestrate.DecisionPage fails orchestrate.StoreFailed {
	orchestrate.QueryDecisionList(s.cell.Get().state, filter)
}

// Landing looks up one integration landing record by (repo, run, landingNumber).
func Landing(s Store, repo string, run string, landingNumber int) option.Option[orchestrate.Landing] fails orchestrate.StoreFailed {
	orchestrate.LandingByKey(s.cell.Get().state, orchestrate.LandingKey{Repo: repo, Run: run, LandingNumber: landingNumber})
}

// ListLandings returns filtered and paginated integration landing records.
func ListLandings(s Store, filter orchestrate.LandingFilter) orchestrate.LandingPage fails orchestrate.StoreFailed {
	orchestrate.QueryLandingList(s.cell.Get().state, filter)
}

// ListEventLog returns filtered, ordered, and paginated operational ledger events.
func ListEventLog(s Store, filter orchestrate.EventLogFilter) orchestrate.EventPage fails orchestrate.StoreFailed {
	orchestrate.QueryEventLog(s.cell.Get().state, filter)
}

// ListEventLogSince returns operational ledger events with ID strictly greater than filter.SinceID in ascending order.
func ListEventLogSince(s Store, filter orchestrate.EventLogSinceFilter) orchestrate.EventPage fails orchestrate.StoreFailed {
	orchestrate.QueryEventLogSince(s.cell.Get().state, filter)
}

let overMemoryStore = context { orchestrate.Store: New() }

func sampleHost() host.Static fails host.Malformed {
	try host.NewStatic(
		host.Status{
			Cores:  8,
			Load:   host.LoadAvg{One: 1.5, Five: 1.25, Fifteen: 0.75, Running: 2, Entities: 120},
			Memory: host.Memory{
				TotalBytes:     int64(17179869184),
				AvailableBytes: int64(10737418240),
				FreeBytes:      int64(4294967296),
				UsedBytes:      int64(6442450944),
			},
			Volumes: []host.Volume{
				host.Volume{
					Path:           "/",
					TotalBytes:     int64(107374182400),
					FreeBytes:      int64(53687091200),
					AvailableBytes: int64(42949672960),
					UsedBytes:      int64(53687091200),
				},
				host.Volume{
					Path:           "/workspaces",
					TotalBytes:     int64(214748364800),
					FreeBytes:      int64(107374182400),
					AvailableBytes: int64(85899345920),
					UsedBytes:      int64(107374182400),
				},
			},
		},
		[]host.Process{
			host.Process{PID: 1, PPID: 0, State: "S", Comm: "ergo", Cmdline: []string{"ergo", "serve"}, UserTicks: int64(10), SysTicks: int64(5), StartTicks: int64(1), RSSBytes: int64(4194304), VSizeBytes: int64(16777216), Threads: 1},
			host.Process{PID: 10, PPID: 1, State: "R", Comm: "ergo", Cmdline: []string{"ergo", "test"}, UserTicks: int64(100), SysTicks: int64(25), StartTicks: int64(20), RSSBytes: int64(8388608), VSizeBytes: int64(33554432), Threads: 4},
			host.Process{PID: 42, PPID: 1, State: "S", Comm: "worker (io) pool", Cmdline: []string{"worker", "--id", "42"}, UserTicks: int64(200), SysTicks: int64(50), StartTicks: int64(99), RSSBytes: int64(16777216), VSizeBytes: int64(67108864), Threads: 2},
		},
	)
}

let overMemoryApi = context fails host.Malformed {
	orchestrate.Api: orchestrate.NewServiceWithHost(New(), time.NewManual(0), try sampleHost()),
}

test ServiceHostTelemetryWiring {
	let bare = orchestrate.NewService(New(), time.NewManual(0))
	let mut bareStatusUnavail = false
	let _ = bare.HostStatus(orchestrate.HostStatusInput{Volumes: []string{}}) catch {
	case host.Unavailable:
		bareStatusUnavail = true
		orchestrate.HostStatusReport{Cores: 0, Load: host.LoadAvg{One: 0.0, Five: 0.0, Fifteen: 0.0, Running: 0, Entities: 0}, Memory: orchestrate.HostMemory{TotalBytes: 0, AvailableBytes: 0, FreeBytes: 0, UsedBytes: 0, TotalGiB: 0.0, AvailableGiB: 0.0, FreeGiB: 0.0, UsedGiB: 0.0}, Volumes: []orchestrate.HostVolume{}}
	case _:
		assert false
		return
	}
	assert bareStatusUnavail

	let mut bareProcsUnavail = false
	let _ = bare.HostProcesses(orchestrate.HostProcessesInput{Comm: json.Absent, PID: json.Absent, Limit: json.Absent}) catch {
	case host.Unavailable:
		bareProcsUnavail = true
		orchestrate.HostProcessList{Items: []orchestrate.HostProcess{}, Total: 0, Limit: 0, Truncated: false}
	case _:
		assert false
		return
	}
	assert bareProcsUnavail

	let h = sampleHost() catch {
	case host.Malformed:
		assert false
		return
	}
	let svc = orchestrate.NewServiceWithHost(New(), time.NewManual(0), h)
	let st = svc.HostStatus(orchestrate.HostStatusInput{Volumes: []string{"/", "/workspaces"}}) catch {
	case _:
		assert false
		return
	}
	assert st.Cores == 8 && st.Memory.TotalGiB == 16.0 && st.Volumes.Len() == 2 && st.Volumes[1].Path == "/workspaces"

	let ps = svc.HostProcesses(orchestrate.HostProcessesInput{Comm: json.Present[string]{Value: "ergo"}, PID: json.Absent, Limit: json.Present[int]{Value: 1}}) catch {
	case _:
		assert false
		return
	}
	assert ps.Total == 2 && ps.Items.Len() == 1 && ps.Items[0].PID == 1 && ps.Truncated
}
