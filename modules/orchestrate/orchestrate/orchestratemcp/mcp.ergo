func toolOver(name string, answer own func(r Request) orchestrateapi.Outcome) mcp.Tool {
	mcp.Tool{Name: name, Description: Description(name), Input: Input(name), Call: func(arguments json.Value) json.Value fails mcp.ToolError {
		let r = Call(name, arguments) catch {
		case mcp.ToolError as e:
			return e
		case mcp.UnknownTool as e:
			return mcp.ToolError{Message: "no tool is named " + e.Name}
		}
		try Show(answer(r))
	}}
}

func toolsOver(answer own func(r Request) orchestrateapi.Outcome) []mcp.Tool {
	let mut out = []mcp.Tool{}
	for name in Names {
		out = out.Append(toolOver(name, answer))
	}
	out
}

// Tools are the tools of the orchestrate.Api in force, one per operation, in its order.
func Tools() []mcp.Tool needs orchestrate.Api {
	let held = InForce[orchestrate.Api]()
	toolsOver(func(r Request) orchestrateapi.Outcome {
		with held { orchestrateapi.Call(r) }
	})
}

func carry(c Request, answer own func(c Request) orchestrateapi.Outcome) orchestrateapi.Outcome fails rpc.Transport {
	let server = mcp.Server{Name: "carry", Version: "1", Tools: toolsOver(answer)}
	let (name, arguments) = Arguments(c)
	let message = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":" + rpc.Encode(name) + ",\"arguments\":" + textOf(arguments) + "}}"
	match mcp.Handle(server, message) {
	case mcp.Answered as a:
		let result = json.Decode(json.Codec[mcp.Called]{MaxBytes: 0, MaxDepth: 0}, a.Result) catch {
		case _:
			return rpc.Transport{Reason: "a tool's result is not one: " + a.Result}
		}
		try ReadAnswer(c, result)
	case mcp.Refused as e:
		return rpc.Transport{Reason: "the server refused the call: " + e.Message}
	case mcp.Silent:
		return rpc.Transport{Reason: "the server did not answer the call"}
	}
}

// Wire is the protocol as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, orchestrateapi.Outcome, rpc.Transport]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) orchestrateapi.Outcome) orchestrateapi.Outcome fails rpc.Transport { try carry(c, answer) }

// Agrees: the protocol carries every call and every outcome the call
// can have unchanged.
law Agrees(r Request, g orchestrateapi.Given) { api.Agrees[Request, orchestrateapi.Outcome, rpc.Transport](Wire, r, orchestrateapi.OutcomeOf(r, g)) }

// RoundTrips reports whether Call reads what Arguments writes of r as r.
func RoundTrips(r Request) bool {
	let (name, arguments) = Arguments(r)
	let back = Call(name, arguments) catch {
	case mcp.ToolError, mcp.UnknownTool:
		return false
	}
	back == r
}

// FitsSchema reports whether the arguments that ask for r fit the
// schema their tool lists.
func FitsSchema(r Request) bool {
	let (name, arguments) = Arguments(r)
	mcp.Conforms(Input(name), arguments)
}

// ArgumentsRoundTrip: Call reads what Arguments writes as the same Request.
law ArgumentsRoundTrip(r Request) { RoundTrips(r) }

// ArgumentsFitTheSchema: the arguments of every Request fit the schema
// of their tool.
law ArgumentsFitTheSchema(r Request) { FitsSchema(r) }
