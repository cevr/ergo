	case orchestrateapi.HostProcessesRequest as x:
		("host-processes", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.HostReadinessRequest as x:
		("host-readiness", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.EventsSinceRequest as x:
		("events-since", untagged(valueOf(rpc.Encode(x.Input))))
	}
}

// Show is the outcome o as a tool's answer: its value as JSON (null for
// none), or its typed failure as a ToolError whose message is the
// failure's tagged JSON.
func Show(o orchestrateapi.Outcome) json.Value fails mcp.ToolError {
	match o {
	case orchestrateapi.Done as done:
		match done.Reply {
		case orchestrateapi.UnitOpenReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.ReceiptRecordReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitStateReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitAcceptReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitLandReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitCloseReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentAddReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentAssignReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentLandReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentDecideReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QueueUpsertReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QueueRemoveReply:
			json.Null
		case orchestrateapi.QueueListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QuestionAskReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QuestionAnswerReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QuestionListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.RunHeadSetReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.RunSummaryReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.DecisionRecordReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.DecisionListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.LandingRecordReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.LandingListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.EventRecordReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.EventLogReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.ImportPlanReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.HostStatusReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.HostProcessesReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.HostReadinessReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.EventsSinceReply as reply:
			valueOf(rpc.Encode(reply.Value))
		}
	case orchestrateapi.Rejected as rejected:
		match rejected.Failure {
		case orchestrateapi.NotFound as failure:
			return mcp.ToolError{Message: rpc.Tagged("NotFound", rpc.Encode(failure.E))}
		case orchestrateapi.AlreadyExists as failure:
			return mcp.ToolError{Message: rpc.Tagged("AlreadyExists", rpc.Encode(failure.E))}
		case orchestrateapi.InvalidTransition as failure:
			return mcp.ToolError{Message: rpc.Tagged("InvalidTransition", rpc.Encode(failure.E))}
		case orchestrateapi.CommandReused as failure:
			return mcp.ToolError{Message: rpc.Tagged("CommandReused", rpc.Encode(failure.E))}
		case orchestrateapi.InvalidInput as failure:
			return mcp.ToolError{Message: rpc.Tagged("InvalidInput", rpc.Encode(failure.E))}
		case orchestrateapi.Unverified as failure:
			return mcp.ToolError{Message: rpc.Tagged("Unverified", rpc.Encode(failure.E))}
		case orchestrateapi.NotAcceptedHead as failure:
			return mcp.ToolError{Message: rpc.Tagged("NotAcceptedHead", rpc.Encode(failure.E))}
		case orchestrateapi.StoreFailed as failure:
			return mcp.ToolError{Message: rpc.Tagged("StoreFailed", rpc.Encode(failure.E))}
		case orchestrateapi.Unavailable as failure:
			return mcp.ToolError{Message: rpc.Tagged("Unavailable", rpc.Encode(failure.E))}
		case orchestrateapi.Malformed as failure:
			return mcp.ToolError{Message: rpc.Tagged("Malformed", rpc.Encode(failure.E))}
		}
	}
}

// Answer answers r through the hub's Call on the bound orchestrate.Api (Show).
func Answer(r Request) json.Value fails mcp.ToolError needs orchestrate.Api {
	try Show(orchestrateapi.Call(r))
}

// ReadAnswer is the outcome of r that a tool's result says: its value's
// JSON, or, when it is an error, an admitted failure's tagged JSON.
// Invalid or missing replies fail Transport, outside the operation's own row.
func ReadAnswer(r Request, result mcp.Called) orchestrateapi.Outcome fails rpc.Transport {
	if result.Content.Len() != 1 {
		return rpc.Transport{Reason: "a tool answered \(result.Content.Len()) blocks, not one"}
	}
	let text = result.Content[0].Text
	if !result.IsError {
		match r {
		case orchestrateapi.UnitOpenRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitOpenReply{Value: v}}
		case orchestrateapi.ReceiptRecordRequest:
			let v = try rpc.Decode[orchestrate.Receipt]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.ReceiptRecordReply{Value: v}}
		case orchestrateapi.UnitStateRequest:
			let v = try rpc.Decode[orchestrate.UnitView]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitStateReply{Value: v}}
		case orchestrateapi.UnitAcceptRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitAcceptReply{Value: v}}
		case orchestrateapi.UnitLandRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitLandReply{Value: v}}
		case orchestrateapi.UnitCloseRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitCloseReply{Value: v}}
		case orchestrateapi.CommitmentAddRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentAddReply{Value: v}}
		case orchestrateapi.CommitmentAssignRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentAssignReply{Value: v}}
		case orchestrateapi.CommitmentLandRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentLandReply{Value: v}}
		case orchestrateapi.CommitmentDecideRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentDecideReply{Value: v}}
		case orchestrateapi.CommitmentListRequest:
			let v = try rpc.Decode[[]orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentListReply{Value: v}}
		case orchestrateapi.QueueUpsertRequest:
			let v = try rpc.Decode[orchestrate.QueueItem]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QueueUpsertReply{Value: v}}
		case orchestrateapi.QueueRemoveRequest:
			if text != "null" {
				return rpc.Transport{Reason: "the tool queue-remove answered " + text + ", not null"}
			}
			orchestrateapi.Done{Reply: orchestrateapi.QueueRemoveReply}
		case orchestrateapi.QueueListRequest:
			let v = try rpc.Decode[[]orchestrate.QueueItem]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QueueListReply{Value: v}}
		case orchestrateapi.QuestionAskRequest:
			let v = try rpc.Decode[orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionAskReply{Value: v}}
		case orchestrateapi.QuestionAnswerRequest:
			let v = try rpc.Decode[orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionAnswerReply{Value: v}}
		case orchestrateapi.QuestionListRequest:
			let v = try rpc.Decode[[]orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionListReply{Value: v}}
		case orchestrateapi.RunHeadSetRequest:
			let v = try rpc.Decode[orchestrate.RunMeta]("value", text)
