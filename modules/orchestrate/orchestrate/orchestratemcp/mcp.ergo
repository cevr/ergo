		("run-summary", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.UnitListRequest as x:
		("unit-list", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.DecisionRecordRequest as x:
		("decision-record", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.DecisionListRequest as x:
		("decision-list", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.LandingRecordRequest as x:
