import api
import json
import mcp
import rpc
import github.com/cevr/ergo/modules/orchestrate/orchestrate
import github.com/cevr/ergo/modules/orchestrate/orchestrate/orchestrateapi

// Request is one call of orchestrate.Api: the hub's Request.
type Request = orchestrateapi.Request

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

func textOf(v json.Value) string { json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, v) }

func untagged(v json.Value) json.Value {
	match v {
	case json.Object as o:
		let mut members = []json.Member{}
		for m in o.Members {
			if m.Key != "_tag" {
				members = members.Append(m)
			}
		}
		json.Object{Members: members}
	case json.Null, json.Boolean, json.Num, json.Str, json.Array:
		v
	}
}

// Names are the tools' names, one per operation of orchestrate.Api, in its order.
let Names = []string{"unit-open", "receipt-record", "unit-state", "unit-accept", "unit-land", "unit-close", "commitment-add", "commitment-assign", "commitment-land", "commitment-decide", "commitment-list", "queue-upsert", "queue-remove", "queue-list", "question-ask", "question-answer", "question-list"}

// Description is what the tool name does: its operation's doc comment,
// or its signature (the hub's Doc).
func Description(name string) string {
	match name {
	case "unit-open":
		orchestrateapi.Doc(orchestrateapi.UnitOpenOp)
	case "receipt-record":
		orchestrateapi.Doc(orchestrateapi.ReceiptRecordOp)
