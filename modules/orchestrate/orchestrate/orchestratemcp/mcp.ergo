// Input is the JSON schema of the tool name's arguments (the hub's
// Schema; an object schema with no properties for a name that is no
// tool's).
func Input(name string) json.Value {
	match name {
	case "unit-open":
		orchestrateapi.Schema(orchestrateapi.UnitOpenOp)
	case "receipt-record":
		orchestrateapi.Schema(orchestrateapi.ReceiptRecordOp)
	case "unit-state":
		orchestrateapi.Schema(orchestrateapi.UnitStateOp)
	case "unit-accept":
		orchestrateapi.Schema(orchestrateapi.UnitAcceptOp)
	case "unit-land":
		orchestrateapi.Schema(orchestrateapi.UnitLandOp)
	case "unit-close":
		orchestrateapi.Schema(orchestrateapi.UnitCloseOp)
	case "commitment-add":
		orchestrateapi.Schema(orchestrateapi.CommitmentAddOp)
	case "commitment-assign":
		orchestrateapi.Schema(orchestrateapi.CommitmentAssignOp)
	case "commitment-land":
		orchestrateapi.Schema(orchestrateapi.CommitmentLandOp)
	case "commitment-decide":
		orchestrateapi.Schema(orchestrateapi.CommitmentDecideOp)
	case "commitment-list":
		orchestrateapi.Schema(orchestrateapi.CommitmentListOp)
	case "queue-upsert":
		orchestrateapi.Schema(orchestrateapi.QueueUpsertOp)
	case "queue-remove":
		orchestrateapi.Schema(orchestrateapi.QueueRemoveOp)
	case "queue-list":
		orchestrateapi.Schema(orchestrateapi.QueueListOp)
	case "question-ask":
		orchestrateapi.Schema(orchestrateapi.QuestionAskOp)
	case "question-answer":
		orchestrateapi.Schema(orchestrateapi.QuestionAnswerOp)
	case "question-list":
		orchestrateapi.Schema(orchestrateapi.QuestionListOp)
	case _:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	}
}

// Call is the Request that a call of the tool name with arguments asks
// for: arguments that are not the tool's fail ToolError, a name that is
// no tool's UnknownTool.
func Call(name string, arguments json.Value) Request fails mcp.ToolError | mcp.UnknownTool {
	let text = match name {
	case "unit-open":
		rpc.Tagged("UnitOpenRequest", "{\"input\":"+textOf(arguments)+"}")
	case "receipt-record":
		rpc.Tagged("ReceiptRecordRequest", "{\"input\":"+textOf(arguments)+"}")
	case "unit-state":
		rpc.Tagged("UnitStateRequest", "{\"input\":"+textOf(arguments)+"}")
	case "unit-accept":
		rpc.Tagged("UnitAcceptRequest", "{\"input\":"+textOf(arguments)+"}")
	case "unit-land":
		rpc.Tagged("UnitLandRequest", "{\"input\":"+textOf(arguments)+"}")
	case "unit-close":
		rpc.Tagged("UnitCloseRequest", "{\"input\":"+textOf(arguments)+"}")
	case "commitment-add":
		rpc.Tagged("CommitmentAddRequest", "{\"input\":"+textOf(arguments)+"}")
	case "commitment-assign":
		rpc.Tagged("CommitmentAssignRequest", "{\"input\":"+textOf(arguments)+"}")
	case "commitment-land":
		rpc.Tagged("CommitmentLandRequest", "{\"input\":"+textOf(arguments)+"}")
	case "commitment-decide":
		rpc.Tagged("CommitmentDecideRequest", "{\"input\":"+textOf(arguments)+"}")
	case "commitment-list":
		rpc.Tagged("CommitmentListRequest", "{\"input\":"+textOf(arguments)+"}")
	case "queue-upsert":
		rpc.Tagged("QueueUpsertRequest", "{\"input\":"+textOf(arguments)+"}")
	case "queue-remove":
		rpc.Tagged("QueueRemoveRequest", "{\"input\":"+textOf(arguments)+"}")
	case "queue-list":
		rpc.Tagged("QueueListRequest", "{\"input\":"+textOf(arguments)+"}")
	case "question-ask":
		rpc.Tagged("QuestionAskRequest", "{\"input\":"+textOf(arguments)+"}")
	case "question-answer":
		rpc.Tagged("QuestionAnswerRequest", "{\"input\":"+textOf(arguments)+"}")
	case "question-list":
		rpc.Tagged("QuestionListRequest", "{\"input\":"+textOf(arguments)+"}")
	case _:
		return mcp.UnknownTool{Name: name}
	}
	rpc.Decode[Request]("arguments of "+name, text) catch {
	case rpc.Transport as e:
		return mcp.ToolError{Message: e.Reason}
	}
}

// Arguments is the tool and the arguments that ask for r: Call reads
// them as r again.
func Arguments(r Request) (string, json.Value) {
	match r {
	case orchestrateapi.UnitOpenRequest as x:
		("unit-open", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.ReceiptRecordRequest as x:
		("receipt-record", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.UnitStateRequest as x:
		("unit-state", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.UnitAcceptRequest as x:
		("unit-accept", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.UnitLandRequest as x:
		("unit-land", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.UnitCloseRequest as x:
		("unit-close", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.CommitmentAddRequest as x:
		("commitment-add", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.CommitmentAssignRequest as x:
		("commitment-assign", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.CommitmentLandRequest as x:
		("commitment-land", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.CommitmentDecideRequest as x:
		("commitment-decide", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.CommitmentListRequest as x:
		("commitment-list", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.QueueUpsertRequest as x:
		("queue-upsert", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.QueueRemoveRequest as x:
		("queue-remove", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.QueueListRequest as x:
		("queue-list", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.QuestionAskRequest as x:
		("question-ask", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.QuestionAnswerRequest as x:
		("question-answer", untagged(valueOf(rpc.Encode(x.Input))))
	case orchestrateapi.QuestionListRequest as x:
		("question-list", untagged(valueOf(rpc.Encode(x.Input))))
	}
}

// Show is the outcome o as a tool's answer: its value as JSON (null for
// none), or its typed failure as a ToolError whose message is the
// failure's tagged JSON.
func Show(o orchestrateapi.Outcome) json.Value fails mcp.ToolError {
	match o {
	case orchestrateapi.Done as done:
		match done.Reply {
		case orchestrateapi.UnitOpenReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.ReceiptRecordReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitStateReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitAcceptReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitLandReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.UnitCloseReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentAddReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentAssignReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentLandReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentDecideReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.CommitmentListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QueueUpsertReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QueueRemoveReply:
			json.Null
		case orchestrateapi.QueueListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QuestionAskReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QuestionAnswerReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case orchestrateapi.QuestionListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		}
	case orchestrateapi.Rejected as rejected:
		match rejected.Failure {
		case orchestrateapi.NotFound as failure:
			return mcp.ToolError{Message: rpc.Tagged("NotFound", rpc.Encode(failure.E))}
		case orchestrateapi.AlreadyExists as failure:
			return mcp.ToolError{Message: rpc.Tagged("AlreadyExists", rpc.Encode(failure.E))}
		case orchestrateapi.InvalidTransition as failure:
			return mcp.ToolError{Message: rpc.Tagged("InvalidTransition", rpc.Encode(failure.E))}
		case orchestrateapi.CommandReused as failure:
			return mcp.ToolError{Message: rpc.Tagged("CommandReused", rpc.Encode(failure.E))}
		case orchestrateapi.InvalidInput as failure:
			return mcp.ToolError{Message: rpc.Tagged("InvalidInput", rpc.Encode(failure.E))}
		case orchestrateapi.Unverified as failure:
			return mcp.ToolError{Message: rpc.Tagged("Unverified", rpc.Encode(failure.E))}
		case orchestrateapi.NotAcceptedHead as failure:
			return mcp.ToolError{Message: rpc.Tagged("NotAcceptedHead", rpc.Encode(failure.E))}
		case orchestrateapi.StoreFailed as failure:
			return mcp.ToolError{Message: rpc.Tagged("StoreFailed", rpc.Encode(failure.E))}
		}
	}
}

// Answer answers r through the hub's Call on the bound orchestrate.Api (Show).
func Answer(r Request) json.Value fails mcp.ToolError needs orchestrate.Api {
	try Show(orchestrateapi.Call(r))
}

// ReadAnswer is the outcome of r that a tool's result says: its value's
// JSON, or, when it is an error, an admitted failure's tagged JSON.
// Invalid or missing replies fail Transport, outside the operation's own row.
func ReadAnswer(r Request, result mcp.Called) orchestrateapi.Outcome fails rpc.Transport {
	if len(result.Content) != 1 {
		return rpc.Transport{Reason: "a tool answered \(len(result.Content)) blocks, not one"}
	}
	let text = result.Content[0].Text
	if !result.IsError {
		match r {
		case orchestrateapi.UnitOpenRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitOpenReply{Value: v}}
		case orchestrateapi.ReceiptRecordRequest:
			let v = try rpc.Decode[orchestrate.Receipt]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.ReceiptRecordReply{Value: v}}
		case orchestrateapi.UnitStateRequest:
			let v = try rpc.Decode[orchestrate.UnitView]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitStateReply{Value: v}}
		case orchestrateapi.UnitAcceptRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitAcceptReply{Value: v}}
		case orchestrateapi.UnitLandRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitLandReply{Value: v}}
		case orchestrateapi.UnitCloseRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitCloseReply{Value: v}}
		case orchestrateapi.CommitmentAddRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentAddReply{Value: v}}
		case orchestrateapi.CommitmentAssignRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentAssignReply{Value: v}}
		case orchestrateapi.CommitmentLandRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentLandReply{Value: v}}
		case orchestrateapi.CommitmentDecideRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentDecideReply{Value: v}}
		case orchestrateapi.CommitmentListRequest:
			let v = try rpc.Decode[[]orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentListReply{Value: v}}
		case orchestrateapi.QueueUpsertRequest:
			let v = try rpc.Decode[orchestrate.QueueItem]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QueueUpsertReply{Value: v}}
		case orchestrateapi.QueueRemoveRequest:
			if text != "null" {
				return rpc.Transport{Reason: "the tool queue-remove answered " + text + ", not null"}
			}
			orchestrateapi.Done{Reply: orchestrateapi.QueueRemoveReply}
		case orchestrateapi.QueueListRequest:
			let v = try rpc.Decode[[]orchestrate.QueueItem]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QueueListReply{Value: v}}
		case orchestrateapi.QuestionAskRequest:
			let v = try rpc.Decode[orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionAskReply{Value: v}}
		case orchestrateapi.QuestionAnswerRequest:
			let v = try rpc.Decode[orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionAnswerReply{Value: v}}
		case orchestrateapi.QuestionListRequest:
			let v = try rpc.Decode[[]orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionListReply{Value: v}}
		}
	} else {
		match r {
		case orchestrateapi.UnitOpenRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "AlreadyExists":
				let e = try rpc.Decode[orchestrate.AlreadyExists]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.AlreadyExists{E: e}}
			case "InvalidTransition":
				let e = try rpc.Decode[orchestrate.InvalidTransition]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidTransition{E: e}}
			case "CommandReused":
				let e = try rpc.Decode[orchestrate.CommandReused]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.CommandReused{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "Unverified":
				let e = try rpc.Decode[orchestrate.Unverified]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.Unverified{E: e}}
			case "NotAcceptedHead":
				let e = try rpc.Decode[orchestrate.NotAcceptedHead]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotAcceptedHead{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool unit-open answered an undeclared failure: " + text}
			}
		case orchestrateapi.ReceiptRecordRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "AlreadyExists":
				let e = try rpc.Decode[orchestrate.AlreadyExists]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.AlreadyExists{E: e}}
			case "InvalidTransition":
				let e = try rpc.Decode[orchestrate.InvalidTransition]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidTransition{E: e}}
			case "CommandReused":
				let e = try rpc.Decode[orchestrate.CommandReused]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.CommandReused{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "Unverified":
				let e = try rpc.Decode[orchestrate.Unverified]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.Unverified{E: e}}
			case "NotAcceptedHead":
				let e = try rpc.Decode[orchestrate.NotAcceptedHead]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotAcceptedHead{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool receipt-record answered an undeclared failure: " + text}
			}
		case orchestrateapi.UnitStateRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool unit-state answered an undeclared failure: " + text}
			}
		case orchestrateapi.UnitAcceptRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "AlreadyExists":
				let e = try rpc.Decode[orchestrate.AlreadyExists]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.AlreadyExists{E: e}}
			case "InvalidTransition":
				let e = try rpc.Decode[orchestrate.InvalidTransition]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidTransition{E: e}}
			case "CommandReused":
				let e = try rpc.Decode[orchestrate.CommandReused]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.CommandReused{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "Unverified":
				let e = try rpc.Decode[orchestrate.Unverified]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.Unverified{E: e}}
			case "NotAcceptedHead":
				let e = try rpc.Decode[orchestrate.NotAcceptedHead]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotAcceptedHead{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the tool unit-accept answered an undeclared failure: " + text}
			}
		case orchestrateapi.UnitLandRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
