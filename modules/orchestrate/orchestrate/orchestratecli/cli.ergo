	let f7 = flag.RequiredString("head", "input.Head (string)")
	let f8 = flag.RequiredInt("exit-code", "input.ExitCode (int)")
	let f9 = flag.RequiredString("exit-lines", "input.ExitLines (string)")
	let usage = orchestrateapi.Doc(orchestrateapi.ReceiptRecordOp)
	flag.Command[Request]{Name: "receipt-record", Usage: usage, Set: flag.Set{Name: "receipt-record", Usage: usage, Flags: []flag.Flag{f0, f1, f2, f3, f4, f5, f6, f7, f8, f9}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		orchestrateapi.ReceiptRecordRequest{Input: orchestrate.ReceiptRecordInput{CommandID: orchestrate.CommandID(f0.Get(v)), Actor: f1.Get(v), Repo: f2.Get(v), Run: f3.Get(v), ID: f4.Get(v), Kind: f5.Get(v), Command: f6.Get(v), Head: f7.Get(v), ExitCode: f8.Get(v), ExitLines: f9.Get(v)}}
	}, Commands: []flag.Command[Request]{}}
}

