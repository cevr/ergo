// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case orchestrateapi.UnitOpenRequest as x:
		let mut out = []string{"unit-open"}
		out = out.Append("-command-id=\(x.Input.CommandID)")
		out = out.Append("-actor=\(x.Input.Actor)")
		out = out.Append("-repo=\(x.Input.Repo)")
		out = out.Append("-run=\(x.Input.Run)")
		out = out.Append("-id=\(x.Input.ID)")
		out = out.Append("-title=\(x.Input.Title)")
		for e in x.Input.Requires {
			out = out.Append("-requires=\(e)")
		}
		match x.Input.Lane {
		case json.Present[string] as s:
			out = out.Append("-lane=\(s.Value)")
		case json.Absent:
		}
		match x.Input.Branch {
		case json.Present[string] as s:
			out = out.Append("-branch=\(s.Value)")
		case json.Absent:
		}
		out
	case orchestrateapi.ReceiptRecordRequest as x:
		let mut out = []string{"receipt-record"}
		out = out.Append("-command-id=\(x.Input.CommandID)")
		out = out.Append("-actor=\(x.Input.Actor)")
		out = out.Append("-repo=\(x.Input.Repo)")
		out = out.Append("-run=\(x.Input.Run)")
		out = out.Append("-id=\(x.Input.ID)")
		out = out.Append("-kind=\(x.Input.Kind)")
		out = out.Append("-command=\(x.Input.Command)")
		out = out.Append("-head=\(x.Input.Head)")
		out = out.Append("-exit-code=\(x.Input.ExitCode)")
		out = out.Append("-exit-lines=\(x.Input.ExitLines)")
		out
	case orchestrateapi.UnitStateRequest as x:
		let mut out = []string{"unit-state"}
		out = out.Append("-repo=\(x.Input.Repo)")
		out = out.Append("-run=\(x.Input.Run)")
		out = out.Append("-id=\(x.Input.ID)")
		out
	case orchestrateapi.UnitAcceptRequest as x:
		let mut out = []string{"unit-accept"}
		out = out.Append("-command-id=\(x.Input.CommandID)")
		out = out.Append("-actor=\(x.Input.Actor)")
		out = out.Append("-repo=\(x.Input.Repo)")
		out = out.Append("-run=\(x.Input.Run)")
		out = out.Append("-id=\(x.Input.ID)")
		out = out.Append("-head=\(x.Input.Head)")
		out
	case orchestrateapi.UnitLandRequest as x:
		let mut out = []string{"unit-land"}
		out = out.Append("-command-id=\(x.Input.CommandID)")
		out = out.Append("-actor=\(x.Input.Actor)")
		out = out.Append("-repo=\(x.Input.Repo)")
		out = out.Append("-run=\(x.Input.Run)")
		out = out.Append("-id=\(x.Input.ID)")
		out = out.Append("-head=\(x.Input.Head)")
		out
	case orchestrateapi.UnitCloseRequest as x:
