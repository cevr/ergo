// Request is one call of orchestrate.Api: the hub's Request.
type Request = orchestrateapi.Request

// Output is what Run prints: std api's Output (Out to standard output,
// Err to standard error, and the exit status).
type Output = api.Output

// Commands are the commands of orchestrate.Api, one per operation, in its order.
func Commands() []flag.Command[Request] {
	[]flag.Command[Request]{commandUnitOpen(), commandReceiptRecord(), commandUnitState(), commandUnitAccept(), commandUnitLand(), commandUnitClose(), commandCommitmentAdd(), commandCommitmentAssign(), commandCommitmentLand(), commandCommitmentDecide(), commandCommitmentList(), commandQueueUpsert(), commandQueueRemove(), commandQueueList(), commandQuestionAsk(), commandQuestionAnswer(), commandQuestionList()}
}

func commandUnitOpen() flag.Command[Request] {
	let f0 = flag.RequiredString("command-id", "input.CommandID (orchestrate.CommandID)")
	let f1 = flag.RequiredString("actor", "input.Actor (string)")
	let f2 = flag.RequiredString("repo", "input.Repo (string)")
	let f3 = flag.RequiredString("run", "input.Run (string)")
	let f4 = flag.RequiredString("id", "input.ID (string)")
	let f5 = flag.RequiredString("title", "input.Title (string)")
	let f6 = flag.String("requires", "", "input.Requires ([]string)").Repeated()
	let f7 = flag.OptionalString("lane", "input.Lane (json.Optional[string])")
	let f9 = flag.OptionalString("branch", "input.Branch (json.Optional[string])")
	let usage = orchestrateapi.Doc(orchestrateapi.UnitOpenOp)
	flag.Command[Request]{Name: "unit-open", Usage: usage, Set: flag.Set{Name: "unit-open", Usage: usage, Flags: []flag.Flag{f0, f1, f2, f3, f4, f5, f6, f7, f9}, Args: []flag.ArgSpec{}}, Build: func(v flag.Values) Request fails flag.Failure {
		let u8 = match f7.Get(v) {
		case Some[string] as s:
			json.Present[string]{Value: s.Value}
		case None:
			json.Absent
		}
		let u10 = match f9.Get(v) {
		case Some[string] as s:
			json.Present[string]{Value: s.Value}
		case None:
			json.Absent
		}
		orchestrateapi.UnitOpenRequest{Input: orchestrate.UnitOpenInput{CommandID: orchestrate.CommandID(f0.Get(v)), Actor: f1.Get(v), Repo: f2.Get(v), Run: f3.Get(v), ID: f4.Get(v), Title: f5.Get(v), Requires: f6.Get(v), Lane: u8, Branch: u10}}
	}, Commands: []flag.Command[Request]{}}
}

