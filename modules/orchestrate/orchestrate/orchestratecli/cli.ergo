		out
	case orchestrateapi.HostReadinessRequest as x:
		let mut out = []string{"host-readiness"}
		match x.Input.Volume {
		case json.Present[string] as s:
			out = out.Append("-volume=\(s.Value)")
		case json.Absent:
		}
		match x.Input.MaxLoad {
		case json.Present[string] as s:
			out = out.Append("-max-load=\(s.Value)")
		case json.Absent:
		}
		match x.Input.RecoveryMaxLoad {
		case json.Present[string] as s:
			out = out.Append("-recovery-max-load=\(s.Value)")
		case json.Absent:
		}
		match x.Input.MinMemGiB {
		case json.Present[string] as s:
			out = out.Append("-min-mem-gi-b=\(s.Value)")
		case json.Absent:
		}
		match x.Input.RecoveryMinMemGiB {
		case json.Present[string] as s:
			out = out.Append("-recovery-min-mem-gi-b=\(s.Value)")
		case json.Absent:
		}
		match x.Input.MaxDiskPct {
		case json.Present[string] as s:
			out = out.Append("-max-disk-pct=\(s.Value)")
		case json.Absent:
		}
		match x.Input.RecoveryMaxDiskPct {
		case json.Present[string] as s:
			out = out.Append("-recovery-max-disk-pct=\(s.Value)")
		case json.Absent:
		}
		match x.Input.PreviousState {
		case json.Present[string] as s:
			out = out.Append("-previous-state=\(s.Value)")
		case json.Absent:
		}
		out
	case orchestrateapi.EventsSinceRequest as x:
		let mut out = []string{"events-since"}
		match x.Input.Repo {
		case json.Present[string] as s:
			out = out.Append("-repo=\(s.Value)")
		case json.Absent:
		}
		match x.Input.Run {
		case json.Present[string] as s:
			out = out.Append("-run=\(s.Value)")
		case json.Absent:
		}
		match x.Input.Kind {
		case json.Present[string] as s:
			out = out.Append("-kind=\(s.Value)")
		case json.Absent:
		}
		match x.Input.UnitID {
		case json.Present[string] as s:
			out = out.Append("-unit-id=\(s.Value)")
		case json.Absent:
		}
		match x.Input.Since {
		case json.Present[int] as s:
			out = out.Append("-since=\(s.Value)")
		case json.Absent:
		}
		match x.Input.Limit {
		case json.Present[int] as s:
			out = out.Append("-limit=\(s.Value)")
		case json.Absent:
		}
		match x.Input.Source {
		case json.Present[string] as s:
			out = out.Append("-source=\(s.Value)")
		case json.Absent:
		}
		out
	}
}

// RoundTrips reports whether Parse reads what Print writes of r as r.
func RoundTrips(r Request) bool {
	let back = Parse(Print(r)) catch {
	case flag.Failure:
		return false
	}
	back == r
}

// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// Policy is what a binary decides of its command line: Code, the exit
// status of a typed failure (default 1); Text, the text of a value
// without --json (default None: a basic value as its text, else its
// JSON; --json never calls it); Confirm, the question a call asks before
// it runs (default None: none; --yes answers it).
type Policy { Code func(f orchestrateapi.Failure) int, Text func(r orchestrateapi.Reply) option.Option[string], Confirm func(r Request) option.Option[string] }

// Defaults is the Policy of a binary that decides nothing.
func Defaults() Policy {
	Policy{Code: func(f orchestrateapi.Failure) int { 1 }, Text: func(r orchestrateapi.Reply) option.Option[string] { option.None }, Confirm: func(r Request) option.Option[string] { option.None }}
}

func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else {
		Output{Out: line(plain), Err: "", Code: 0}
	}
}

func line(s string) string {
	if s == "" {
		return ""
	}
	s + "\n"
}

func failed(asJSON bool, tagged string, status int) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: status}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: status}
	}
}

// Show is what Run prints of the outcome o under the policy p: the value
// (p's Text when it has one and there is no --json; else its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed) with p's Code.
func Show(o orchestrateapi.Outcome, asJSON bool, p Policy) Output {
	match o {
	case orchestrateapi.Done as done:
		if !asJSON {
			match p.Text(done.Reply) {
			case option.Some[string] as s:
				return Output{Out: line(s.Value), Err: "", Code: 0}
			case option.None:
			}
		}
		match done.Reply {
		case orchestrateapi.UnitOpenReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.ReceiptRecordReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.UnitStateReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.UnitAcceptReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.UnitLandReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.UnitCloseReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.CommitmentAddReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.CommitmentAssignReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.CommitmentLandReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.CommitmentDecideReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.CommitmentListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.QueueUpsertReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.QueueRemoveReply:
			answer(asJSON, "", "null")
		case orchestrateapi.QueueListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.QuestionAskReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.QuestionAnswerReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.QuestionListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.RunHeadSetReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.RunSummaryReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.UnitListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.DecisionRecordReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.DecisionListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.LandingRecordReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.LandingListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.EventRecordReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.EventLogReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.ImportPlanReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.HostStatusReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.HostProcessesReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.HostReadinessReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case orchestrateapi.EventsSinceReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		}
	case orchestrateapi.Rejected as rejected:
		let status = p.Code(rejected.Failure)
		match rejected.Failure {
		case orchestrateapi.NotFound as failure:
			failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(failure.E)), status)
		case orchestrateapi.AlreadyExists as failure:
			failed(asJSON, rpc.Tagged("AlreadyExists", rpc.Encode(failure.E)), status)
		case orchestrateapi.InvalidTransition as failure:
			failed(asJSON, rpc.Tagged("InvalidTransition", rpc.Encode(failure.E)), status)
		case orchestrateapi.CommandReused as failure:
			failed(asJSON, rpc.Tagged("CommandReused", rpc.Encode(failure.E)), status)
		case orchestrateapi.InvalidInput as failure:
			failed(asJSON, rpc.Tagged("InvalidInput", rpc.Encode(failure.E)), status)
		case orchestrateapi.Unverified as failure:
			failed(asJSON, rpc.Tagged("Unverified", rpc.Encode(failure.E)), status)
		case orchestrateapi.NotAcceptedHead as failure:
			failed(asJSON, rpc.Tagged("NotAcceptedHead", rpc.Encode(failure.E)), status)
		case orchestrateapi.StoreFailed as failure:
			failed(asJSON, rpc.Tagged("StoreFailed", rpc.Encode(failure.E)), status)
		case orchestrateapi.Unavailable as failure:
			failed(asJSON, rpc.Tagged("Unavailable", rpc.Encode(failure.E)), status)
		case orchestrateapi.Malformed as failure:
			failed(asJSON, rpc.Tagged("Malformed", rpc.Encode(failure.E)), status)
		}
	}
}

// Read is the outcome of r that the Output of Run with --json and its
// default status policy says: its value's JSON on standard output with
// status 0, or an admitted failure's tagged JSON with status 1. Invalid
// or missing replies fail Transport, outside the operation's own row.
func Read(r Request, out Output) orchestrateapi.Outcome fails rpc.Transport {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case orchestrateapi.UnitOpenRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitOpenReply{Value: v}}
		case orchestrateapi.ReceiptRecordRequest:
			let v = try rpc.Decode[orchestrate.Receipt]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.ReceiptRecordReply{Value: v}}
		case orchestrateapi.UnitStateRequest:
			let v = try rpc.Decode[orchestrate.UnitView]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitStateReply{Value: v}}
		case orchestrateapi.UnitAcceptRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitAcceptReply{Value: v}}
		case orchestrateapi.UnitLandRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitLandReply{Value: v}}
		case orchestrateapi.UnitCloseRequest:
			let v = try rpc.Decode[orchestrate.Unit]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitCloseReply{Value: v}}
		case orchestrateapi.CommitmentAddRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentAddReply{Value: v}}
		case orchestrateapi.CommitmentAssignRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentAssignReply{Value: v}}
		case orchestrateapi.CommitmentLandRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentLandReply{Value: v}}
		case orchestrateapi.CommitmentDecideRequest:
			let v = try rpc.Decode[orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentDecideReply{Value: v}}
		case orchestrateapi.CommitmentListRequest:
			let v = try rpc.Decode[[]orchestrate.Commitment]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.CommitmentListReply{Value: v}}
		case orchestrateapi.QueueUpsertRequest:
			let v = try rpc.Decode[orchestrate.QueueItem]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QueueUpsertReply{Value: v}}
		case orchestrateapi.QueueRemoveRequest:
			if text != "null" {
				return rpc.Transport{Reason: "the command line answered QueueRemove with " + text + ", not null"}
			}
			orchestrateapi.Done{Reply: orchestrateapi.QueueRemoveReply}
		case orchestrateapi.QueueListRequest:
			let v = try rpc.Decode[[]orchestrate.QueueItem]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QueueListReply{Value: v}}
		case orchestrateapi.QuestionAskRequest:
			let v = try rpc.Decode[orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionAskReply{Value: v}}
		case orchestrateapi.QuestionAnswerRequest:
			let v = try rpc.Decode[orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionAnswerReply{Value: v}}
		case orchestrateapi.QuestionListRequest:
			let v = try rpc.Decode[[]orchestrate.Question]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.QuestionListReply{Value: v}}
		case orchestrateapi.RunHeadSetRequest:
			let v = try rpc.Decode[orchestrate.RunMeta]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.RunHeadSetReply{Value: v}}
		case orchestrateapi.RunSummaryRequest:
			let v = try rpc.Decode[orchestrate.RunOverview]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.RunSummaryReply{Value: v}}
		case orchestrateapi.UnitListRequest:
			let v = try rpc.Decode[orchestrate.UnitPage]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.UnitListReply{Value: v}}
		case orchestrateapi.DecisionRecordRequest:
			let v = try rpc.Decode[orchestrate.Decision]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.DecisionRecordReply{Value: v}}
		case orchestrateapi.DecisionListRequest:
			let v = try rpc.Decode[orchestrate.DecisionPage]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.DecisionListReply{Value: v}}
		case orchestrateapi.LandingRecordRequest:
			let v = try rpc.Decode[orchestrate.Landing]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.LandingRecordReply{Value: v}}
		case orchestrateapi.LandingListRequest:
			let v = try rpc.Decode[orchestrate.LandingPage]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.LandingListReply{Value: v}}
		case orchestrateapi.EventRecordRequest:
			let v = try rpc.Decode[orchestrate.LedgerEvent]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.EventRecordReply{Value: v}}
		case orchestrateapi.EventLogRequest:
			let v = try rpc.Decode[orchestrate.EventPage]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.EventLogReply{Value: v}}
		case orchestrateapi.ImportPlanRequest:
			let v = try rpc.Decode[orchestrate.ImportReport]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.ImportPlanReply{Value: v}}
		case orchestrateapi.HostStatusRequest:
			let v = try rpc.Decode[orchestrate.HostStatusReport]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.HostStatusReply{Value: v}}
		case orchestrateapi.HostProcessesRequest:
			let v = try rpc.Decode[orchestrate.HostProcessList]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.HostProcessesReply{Value: v}}
		case orchestrateapi.HostReadinessRequest:
			let v = try rpc.Decode[orchestrate.HostReadinessReport]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.HostReadinessReply{Value: v}}
		case orchestrateapi.EventsSinceRequest:
			let v = try rpc.Decode[orchestrate.EventStreamPage]("value", text)
			orchestrateapi.Done{Reply: orchestrateapi.EventsSinceReply{Value: v}}
		}
	} else if out.Code == 1 {
		match r {
		case orchestrateapi.UnitOpenRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "AlreadyExists":
				let e = try rpc.Decode[orchestrate.AlreadyExists]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.AlreadyExists{E: e}}
			case "InvalidTransition":
				let e = try rpc.Decode[orchestrate.InvalidTransition]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidTransition{E: e}}
			case "CommandReused":
				let e = try rpc.Decode[orchestrate.CommandReused]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.CommandReused{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "Unverified":
				let e = try rpc.Decode[orchestrate.Unverified]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.Unverified{E: e}}
			case "NotAcceptedHead":
				let e = try rpc.Decode[orchestrate.NotAcceptedHead]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotAcceptedHead{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered UnitOpen with an undeclared failure: " + text}
			}
		case orchestrateapi.ReceiptRecordRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "AlreadyExists":
				let e = try rpc.Decode[orchestrate.AlreadyExists]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.AlreadyExists{E: e}}
			case "InvalidTransition":
				let e = try rpc.Decode[orchestrate.InvalidTransition]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidTransition{E: e}}
			case "CommandReused":
				let e = try rpc.Decode[orchestrate.CommandReused]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.CommandReused{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "Unverified":
				let e = try rpc.Decode[orchestrate.Unverified]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.Unverified{E: e}}
			case "NotAcceptedHead":
				let e = try rpc.Decode[orchestrate.NotAcceptedHead]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotAcceptedHead{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered ReceiptRecord with an undeclared failure: " + text}
			}
		case orchestrateapi.UnitStateRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered UnitState with an undeclared failure: " + text}
			}
		case orchestrateapi.UnitAcceptRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
			case "AlreadyExists":
				let e = try rpc.Decode[orchestrate.AlreadyExists]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.AlreadyExists{E: e}}
			case "InvalidTransition":
				let e = try rpc.Decode[orchestrate.InvalidTransition]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidTransition{E: e}}
			case "CommandReused":
				let e = try rpc.Decode[orchestrate.CommandReused]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.CommandReused{E: e}}
			case "InvalidInput":
				let e = try rpc.Decode[orchestrate.InvalidInput]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.InvalidInput{E: e}}
			case "Unverified":
				let e = try rpc.Decode[orchestrate.Unverified]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.Unverified{E: e}}
			case "NotAcceptedHead":
				let e = try rpc.Decode[orchestrate.NotAcceptedHead]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotAcceptedHead{E: e}}
			case "StoreFailed":
				let e = try rpc.Decode[orchestrate.StoreFailed]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.StoreFailed{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered UnitAccept with an undeclared failure: " + text}
			}
		case orchestrateapi.UnitLandRequest:
			match rpc.TagOf(text) {
			case "NotFound":
				let e = try rpc.Decode[orchestrate.NotFound]("failure", text)
				orchestrateapi.Rejected{Failure: orchestrateapi.NotFound{E: e}}
