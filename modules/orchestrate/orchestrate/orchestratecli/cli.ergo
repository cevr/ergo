// Parse reads args as a command line of orchestrate.Api: a command and its
// flags and arguments. It builds only the command args[0] names; the
// list of every command is built only for help or an unknown command.
func Parse(args []string) Request fails flag.Failure {
	let first = if args.Len() > 0 { args[0] } else { "" }
	match first {
	case "unit-open":
		let c = commandUnitOpen()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "orchestrate unit-open"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "receipt-record":
		let c = commandReceiptRecord()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "orchestrate receipt-record"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "unit-state":
		let c = commandUnitState()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "orchestrate unit-state"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "unit-accept":
		let c = commandUnitAccept()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "orchestrate unit-accept"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "unit-land":
		let c = commandUnitLand()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "orchestrate unit-land"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "unit-close":
		let c = commandUnitClose()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "orchestrate unit-close"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "commitment-add":
		let c = commandCommitmentAdd()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "orchestrate commitment-add"}, slices.Slice(args, 1, args.Len()))
		try c.Build(v)
	case "commitment-assign":
		let c = commandCommitmentAssign()
