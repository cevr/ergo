// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { UnitOpen orchestrate.Unit, ReceiptRecord orchestrate.Receipt, UnitState orchestrate.UnitView, UnitAccept orchestrate.Unit, UnitLand orchestrate.Unit, UnitClose orchestrate.Unit, CommitmentAdd orchestrate.Commitment, CommitmentAssign orchestrate.Commitment, CommitmentLand orchestrate.Commitment, CommitmentDecide orchestrate.Commitment, CommitmentList []orchestrate.Commitment, QueueUpsert orchestrate.QueueItem, QueueList []orchestrate.QueueItem, QuestionAsk orchestrate.Question, QuestionAnswer orchestrate.Question, QuestionList []orchestrate.Question, RunHeadSet orchestrate.RunMeta, RunSummary orchestrate.RunOverview, UnitList orchestrate.UnitPage, DecisionRecord orchestrate.Decision, DecisionList orchestrate.DecisionPage, LandingRecord orchestrate.Landing, LandingList orchestrate.LandingPage, EventRecord orchestrate.LedgerEvent, EventLog orchestrate.EventPage, ImportPlan orchestrate.ImportReport }

func inRow(op Op, f Failure) bool {
	match op {
	case UnitOpenOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case ReceiptRecordOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case UnitStateOp:
		match f {
		case NotFound, InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case UnitAcceptOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case UnitLandOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case UnitCloseOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case CommitmentAddOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case CommitmentAssignOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case CommitmentLandOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case CommitmentDecideOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case CommitmentListOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case QueueUpsertOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case QueueRemoveOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case QueueListOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case QuestionAskOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case QuestionAnswerOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case QuestionListOp:
		match f {
		case StoreFailed:
			true
		case _:
			false
		}
	case RunHeadSetOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case RunSummaryOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case UnitListOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case DecisionRecordOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case DecisionListOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case LandingRecordOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case LandingListOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case EventRecordOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case EventLogOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case ImportPlanOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case UnitOpenRequest:
		Done{Reply: UnitOpenReply{Value: g.Values.UnitOpen}}
	case ReceiptRecordRequest:
		Done{Reply: ReceiptRecordReply{Value: g.Values.ReceiptRecord}}
	case UnitStateRequest:
		Done{Reply: UnitStateReply{Value: g.Values.UnitState}}
	case UnitAcceptRequest:
		Done{Reply: UnitAcceptReply{Value: g.Values.UnitAccept}}
	case UnitLandRequest:
		Done{Reply: UnitLandReply{Value: g.Values.UnitLand}}
	case UnitCloseRequest:
		Done{Reply: UnitCloseReply{Value: g.Values.UnitClose}}
	case CommitmentAddRequest:
		Done{Reply: CommitmentAddReply{Value: g.Values.CommitmentAdd}}
	case CommitmentAssignRequest:
		Done{Reply: CommitmentAssignReply{Value: g.Values.CommitmentAssign}}
	case CommitmentLandRequest:
		Done{Reply: CommitmentLandReply{Value: g.Values.CommitmentLand}}
	case CommitmentDecideRequest:
		Done{Reply: CommitmentDecideReply{Value: g.Values.CommitmentDecide}}
	case CommitmentListRequest:
		Done{Reply: CommitmentListReply{Value: g.Values.CommitmentList}}
	case QueueUpsertRequest:
		Done{Reply: QueueUpsertReply{Value: g.Values.QueueUpsert}}
	case QueueRemoveRequest:
		Done{Reply: QueueRemoveReply}
	case QueueListRequest:
		Done{Reply: QueueListReply{Value: g.Values.QueueList}}
	case QuestionAskRequest:
		Done{Reply: QuestionAskReply{Value: g.Values.QuestionAsk}}
	case QuestionAnswerRequest:
		Done{Reply: QuestionAnswerReply{Value: g.Values.QuestionAnswer}}
	case QuestionListRequest:
		Done{Reply: QuestionListReply{Value: g.Values.QuestionList}}
	case RunHeadSetRequest:
		Done{Reply: RunHeadSetReply{Value: g.Values.RunHeadSet}}
	case RunSummaryRequest:
		Done{Reply: RunSummaryReply{Value: g.Values.RunSummary}}
	case UnitListRequest:
		Done{Reply: UnitListReply{Value: g.Values.UnitList}}
	case DecisionRecordRequest:
		Done{Reply: DecisionRecordReply{Value: g.Values.DecisionRecord}}
	case DecisionListRequest:
		Done{Reply: DecisionListReply{Value: g.Values.DecisionList}}
	case LandingRecordRequest:
		Done{Reply: LandingRecordReply{Value: g.Values.LandingRecord}}
	case LandingListRequest:
		Done{Reply: LandingListReply{Value: g.Values.LandingList}}
	case EventRecordRequest:
		Done{Reply: EventRecordReply{Value: g.Values.EventRecord}}
	case EventLogRequest:
		Done{Reply: EventLogReply{Value: g.Values.EventLog}}
	case ImportPlanRequest:
		Done{Reply: ImportPlanReply{Value: g.Values.ImportPlan}}
	}
}

