// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { UnitOpen orchestrate.Unit, ReceiptRecord orchestrate.Receipt, UnitState orchestrate.UnitView, UnitAccept orchestrate.Unit, UnitLand orchestrate.Unit }

func inRow(op Op, f Failure) bool {
	match op {
	case UnitOpenOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case ReceiptRecordOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case UnitStateOp:
		match f {
		case NotFound, InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case UnitAcceptOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	case UnitLandOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, Unverified, NotAcceptedHead, StoreFailed:
			true
		}
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case UnitOpenRequest:
		Done{Reply: UnitOpenReply{Value: g.Values.UnitOpen}}
	case ReceiptRecordRequest:
		Done{Reply: ReceiptRecordReply{Value: g.Values.ReceiptRecord}}
	case UnitStateRequest:
		Done{Reply: UnitStateReply{Value: g.Values.UnitState}}
	case UnitAcceptRequest:
		Done{Reply: UnitAcceptReply{Value: g.Values.UnitAccept}}
	case UnitLandRequest:
		Done{Reply: UnitLandReply{Value: g.Values.UnitLand}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opUnitOpen: func(input orchestrate.UnitOpenInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(UnitOpenRequest{Input: input}) })
			if g.Failing {
				match g.Failure {
				case NotFound as err:
					return err.E
				case AlreadyExists as err:
					return err.E
				case InvalidTransition as err:
					return err.E
				case CommandReused as err:
					return err.E
				case InvalidInput as err:
					return err.E
				case Unverified as err:
					return err.E
				case NotAcceptedHead as err:
					return err.E
				case StoreFailed as err:
					return err.E
				}
			}
			g.Values.UnitOpen
		},
		opReceiptRecord: func(input orchestrate.ReceiptRecordInput) orchestrate.Receipt fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(ReceiptRecordRequest{Input: input}) })
			if g.Failing {
				match g.Failure {
				case NotFound as err:
					return err.E
				case AlreadyExists as err:
					return err.E
				case InvalidTransition as err:
					return err.E
				case CommandReused as err:
					return err.E
				case InvalidInput as err:
					return err.E
				case Unverified as err:
					return err.E
				case NotAcceptedHead as err:
					return err.E
				case StoreFailed as err:
					return err.E
				}
			}
			g.Values.ReceiptRecord
		},
		opUnitState: func(input orchestrate.UnitStateInput) orchestrate.UnitView fails orchestrate.NotFound | orchestrate.InvalidInput | orchestrate.StoreFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(UnitStateRequest{Input: input}) })
			if g.Failing {
				match g.Failure {
				case NotFound as err:
					return err.E
				case InvalidInput as err:
					return err.E
				case StoreFailed as err:
					return err.E
				case _:
				}
			}
			g.Values.UnitState
		},
		opUnitAccept: func(input orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(UnitAcceptRequest{Input: input}) })
			if g.Failing {
				match g.Failure {
				case NotFound as err:
					return err.E
				case AlreadyExists as err:
					return err.E
				case InvalidTransition as err:
					return err.E
				case CommandReused as err:
					return err.E
				case InvalidInput as err:
					return err.E
				case Unverified as err:
					return err.E
				case NotAcceptedHead as err:
					return err.E
				case StoreFailed as err:
					return err.E
				}
			}
			g.Values.UnitAccept
		},
		opUnitLand: func(input orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(UnitLandRequest{Input: input}) })
			if g.Failing {
				match g.Failure {
				case NotFound as err:
					return err.E
				case AlreadyExists as err:
					return err.E
				case InvalidTransition as err:
					return err.E
				case CommandReused as err:
					return err.E
				case InvalidInput as err:
					return err.E
				case Unverified as err:
					return err.E
				case NotAcceptedHead as err:
					return err.E
				case StoreFailed as err:
					return err.E
				}
			}
			g.Values.UnitLand
		},
	}
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case UnitOpenRequest as x:
		let v = UnitOpenChecked(client, x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: UnitOpenReply{Value: v}}
	case ReceiptRecordRequest as x:
		let v = ReceiptRecordChecked(client, x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: ReceiptRecordReply{Value: v}}
	case UnitStateRequest as x:
		let v = UnitStateChecked(client, x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: UnitStateReply{Value: v}}
	case UnitAcceptRequest as x:
		let v = UnitAcceptChecked(client, x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: UnitAcceptReply{Value: v}}
	case UnitLandRequest as x:
		let v = UnitLandChecked(client, x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: UnitLandReply{Value: v}}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { orchestrate.Api: scripted(g, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(g, sent)
	let outer = NewClient(inner)
	let got = with context { orchestrate.Api: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted(g, sentChecked)
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { orchestrate.Api: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
