// UnitLand invokes orchestrate.Api's UnitLand directly.
func UnitLand(client Client, input orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed {
	try client.opUnitLand(input)
}

// CheckedClient carries erased orchestrate.Api requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// UnitOpenChecked sends orchestrate.Api's UnitOpen over send and validates its Outcome.
func UnitOpenChecked(client CheckedClient, input orchestrate.UnitOpenInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed | rpc.Transport {
	match try client.send(UnitOpenRequest{Input: input}) {
	case Done as done:
		match done.Reply {
		case UnitOpenReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "orchestrateapi: UnitOpen was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NotFound as failure:
			return failure.E
		case AlreadyExists as failure:
			return failure.E
		case InvalidTransition as failure:
			return failure.E
		case CommandReused as failure:
			return failure.E
		case InvalidInput as failure:
			return failure.E
		case Unverified as failure:
			return failure.E
		case NotAcceptedHead as failure:
			return failure.E
		case StoreFailed as failure:
			return failure.E
		}
	}
}

