import json
import rpc
import scope
import sync
import github.com/cevr/ergo/modules/orchestrate/orchestrate

// Request is one call of orchestrate.Api: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = UnitOpenRequest{Input orchestrate.UnitOpenInput} | ReceiptRecordRequest{Input orchestrate.ReceiptRecordInput} | UnitStateRequest{Input orchestrate.UnitStateInput} | UnitAcceptRequest{Input orchestrate.UnitVerdictInput} | UnitLandRequest{Input orchestrate.UnitVerdictInput} | UnitCloseRequest{Input orchestrate.UnitCloseInput} | CommitmentAddRequest{Input orchestrate.CommitmentAddInput} | CommitmentAssignRequest{Input orchestrate.CommitmentAssignInput} | CommitmentLandRequest{Input orchestrate.CommitmentLandInput} | CommitmentDecideRequest{Input orchestrate.CommitmentDecideInput} | CommitmentListRequest{Input orchestrate.CommitmentListInput} | QueueUpsertRequest{Input orchestrate.QueueUpsertInput} | QueueRemoveRequest{Input orchestrate.QueueRemoveInput} | QueueListRequest{Input orchestrate.QueueListInput} | QuestionAskRequest{Input orchestrate.QuestionAskInput} | QuestionAnswerRequest{Input orchestrate.QuestionAnswerInput} | QuestionListRequest{Input orchestrate.QuestionListInput} | RunHeadSetRequest{Input orchestrate.RunHeadSetInput} | RunSummaryRequest{Input orchestrate.RunSummaryInput} | UnitListRequest{Input orchestrate.UnitListInput} | DecisionRecordRequest{Input orchestrate.DecisionRecordInput} | DecisionListRequest{Input orchestrate.DecisionListInput} | LandingRecordRequest{Input orchestrate.LandingRecordInput} | LandingListRequest{Input orchestrate.LandingListInput} | EventRecordRequest{Input orchestrate.EventRecordInput} | EventLogRequest{Input orchestrate.EventLogInput} | ImportPlanRequest{Input orchestrate.ImportPlanInput}

// Op is an operation of orchestrate.Api: what a policy matches on.
type Op = UnitOpenOp{} | ReceiptRecordOp{} | UnitStateOp{} | UnitAcceptOp{} | UnitLandOp{} | UnitCloseOp{} | CommitmentAddOp{} | CommitmentAssignOp{} | CommitmentLandOp{} | CommitmentDecideOp{} | CommitmentListOp{} | QueueUpsertOp{} | QueueRemoveOp{} | QueueListOp{} | QuestionAskOp{} | QuestionAnswerOp{} | QuestionListOp{} | RunHeadSetOp{} | RunSummaryOp{} | UnitListOp{} | DecisionRecordOp{} | DecisionListOp{} | LandingRecordOp{} | LandingListOp{} | EventRecordOp{} | EventLogOp{} | ImportPlanOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = UnitOpenReply{Value orchestrate.Unit} | ReceiptRecordReply{Value orchestrate.Receipt} | UnitStateReply{Value orchestrate.UnitView} | UnitAcceptReply{Value orchestrate.Unit} | UnitLandReply{Value orchestrate.Unit} | UnitCloseReply{Value orchestrate.Unit} | CommitmentAddReply{Value orchestrate.Commitment} | CommitmentAssignReply{Value orchestrate.Commitment} | CommitmentLandReply{Value orchestrate.Commitment} | CommitmentDecideReply{Value orchestrate.Commitment} | CommitmentListReply{Value []orchestrate.Commitment} | QueueUpsertReply{Value orchestrate.QueueItem} | QueueRemoveReply{} | QueueListReply{Value []orchestrate.QueueItem} | QuestionAskReply{Value orchestrate.Question} | QuestionAnswerReply{Value orchestrate.Question} | QuestionListReply{Value []orchestrate.Question} | RunHeadSetReply{Value orchestrate.RunMeta} | RunSummaryReply{Value orchestrate.RunOverview} | UnitListReply{Value orchestrate.UnitPage} | DecisionRecordReply{Value orchestrate.Decision} | DecisionListReply{Value orchestrate.DecisionPage} | LandingRecordReply{Value orchestrate.Landing} | LandingListReply{Value orchestrate.LandingPage} | EventRecordReply{Value orchestrate.LedgerEvent} | EventLogReply{Value orchestrate.EventPage} | ImportPlanReply{Value orchestrate.ImportReport}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = NotFound{E orchestrate.NotFound} | AlreadyExists{E orchestrate.AlreadyExists} | InvalidTransition{E orchestrate.InvalidTransition} | CommandReused{E orchestrate.CommandReused} | InvalidInput{E orchestrate.InvalidInput} | Unverified{E orchestrate.Unverified} | NotAcceptedHead{E orchestrate.NotAcceptedHead} | StoreFailed{E orchestrate.StoreFailed}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case UnitOpenRequest:
		UnitOpenOp
	case ReceiptRecordRequest:
		ReceiptRecordOp
	case UnitStateRequest:
		UnitStateOp
	case UnitAcceptRequest:
		UnitAcceptOp
	case UnitLandRequest:
		UnitLandOp
	case UnitCloseRequest:
		UnitCloseOp
	case CommitmentAddRequest:
		CommitmentAddOp
	case CommitmentAssignRequest:
		CommitmentAssignOp
	case CommitmentLandRequest:
		CommitmentLandOp
	case CommitmentDecideRequest:
		CommitmentDecideOp
	case CommitmentListRequest:
		CommitmentListOp
	case QueueUpsertRequest:
		QueueUpsertOp
	case QueueRemoveRequest:
		QueueRemoveOp
	case QueueListRequest:
		QueueListOp
	case QuestionAskRequest:
		QuestionAskOp
	case QuestionAnswerRequest:
		QuestionAnswerOp
	case QuestionListRequest:
		QuestionListOp
	case RunHeadSetRequest:
		RunHeadSetOp
	case RunSummaryRequest:
		RunSummaryOp
	case UnitListRequest:
		UnitListOp
	case DecisionRecordRequest:
		DecisionRecordOp
	case DecisionListRequest:
		DecisionListOp
	case LandingRecordRequest:
		LandingRecordOp
	case LandingListRequest:
		LandingListOp
	case EventRecordRequest:
		EventRecordOp
	case EventLogRequest:
		EventLogOp
	case ImportPlanRequest:
		ImportPlanOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case UnitOpenOp:
		"unit-open"
	case ReceiptRecordOp:
		"receipt-record"
	case UnitStateOp:
		"unit-state"
	case UnitAcceptOp:
		"unit-accept"
	case UnitLandOp:
		"unit-land"
	case UnitCloseOp:
		"unit-close"
	case CommitmentAddOp:
		"commitment-add"
	case CommitmentAssignOp:
		"commitment-assign"
	case CommitmentLandOp:
		"commitment-land"
	case CommitmentDecideOp:
		"commitment-decide"
	case CommitmentListOp:
		"commitment-list"
	case QueueUpsertOp:
		"queue-upsert"
	case QueueRemoveOp:
		"queue-remove"
	case QueueListOp:
		"queue-list"
	case QuestionAskOp:
		"question-ask"
	case QuestionAnswerOp:
		"question-answer"
	case QuestionListOp:
		"question-list"
	case RunHeadSetOp:
		"run-head-set"
	case RunSummaryOp:
		"run-summary"
	case UnitListOp:
		"unit-list"
	case DecisionRecordOp:
		"decision-record"
	case DecisionListOp:
		"decision-list"
	case LandingRecordOp:
		"landing-record"
	case LandingListOp:
		"landing-list"
	case EventRecordOp:
		"event-record"
	case EventLogOp:
		"event-log"
	case ImportPlanOp:
		"import-plan"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case UnitOpenOp:
		"UnitOpen opens a unit with the receipt kinds its verdict requires."
	case ReceiptRecordOp:
		"ReceiptRecord records one run of a check: command, head, exit code and exit lines."
	case UnitStateOp:
		"UnitState reads a unit and its receipts."
	case UnitAcceptOp:
		"UnitAccept accepts a unit at a head; refused Unverified unless every required kind's latest receipt at that head exited 0."
	case UnitLandOp:
		"UnitLand lands an accepted unit at its accepted head, whose required receipts must still be green."
	case UnitCloseOp:
		"UnitClose closes a non-terminal unit without landing."
	case CommitmentAddOp:
		"CommitmentAdd registers a new tracked commitment."
	case CommitmentAssignOp:
		"CommitmentAssign assigns an open or assigned commitment to an owner and lane."
	case CommitmentLandOp:
		"CommitmentLand marks an open or assigned commitment as landed at a commit SHA."
	case CommitmentDecideOp:
		"CommitmentDecide resolves or withdraws an open or assigned commitment with a note."
	case CommitmentListOp:
		"CommitmentList lists commitments, optionally filtered by status and owner, sorted by ID."
	case QueueUpsertOp:
		"QueueUpsert inserts or replaces a prioritized queue entry by key."
	case QueueRemoveOp:
		"QueueRemove deletes an existing queue entry by key."
	case QueueListOp:
		"QueueList lists queue entries, optionally filtered by status, ordered by priority then key."
	case QuestionAskOp:
		"QuestionAsk opens an async question with an optional explicit monotonic ID, default assumption, and concrete action."
	case QuestionAnswerOp:
		"QuestionAnswer answers or withdraws an open async question."
	case QuestionListOp:
		"QuestionList lists async questions, optionally restricting to open questions only."
	case RunHeadSetOp:
		"RunHeadSet records the latest main branch head for a repository run."
	case RunSummaryOp:
		"RunSummary returns a compact progressive-disclosure overview for a repository run."
	case UnitListOp:
		"UnitList lists compact unit summaries filtered by repo, run, and status without receipt payloads."
	case DecisionRecordOp:
		"DecisionRecord creates or updates a structured ruling, architectural decision, or owner directive."
	case DecisionListOp:
		"DecisionList lists structured decisions filtered and paginated."
	case LandingRecordOp:
		"LandingRecord creates or updates a structured integration landing record."
	case LandingListOp:
		"LandingList lists structured integration landing records filtered and paginated."
	case EventRecordOp:
		"EventRecord appends an operational event to the structured event log."
	case EventLogOp:
		"EventLog lists operational event log entries filtered, ordered, and paginated."
	case ImportPlanOp:
		"ImportPlan idempotently parses run log or fallout markdown lines into structured decisions, landings, run head, and events."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case UnitOpenOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"requires\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"lane\":{\"type\":\"string\"},\"branch\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"title\",\"requires\"]}")
	case ReceiptRecordOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"command\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"},\"exitCode\":{\"type\":\"integer\"},\"exitLines\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"kind\",\"command\",\"head\",\"exitCode\",\"exitLines\"]}")
	case UnitStateOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"repo\",\"run\",\"id\"]}")
	case UnitAcceptOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"head\"]}")
	case UnitLandOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"head\"]}")
	case UnitCloseOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\"]}")
	case CommitmentAddOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"id\",\"title\",\"kind\"]}")
	case CommitmentAssignOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"},\"lane\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"id\",\"owner\",\"lane\"]}")
	case CommitmentLandOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"landedSHA\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"id\",\"landedSHA\"]}")
	case CommitmentDecideOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"note\":{\"type\":\"string\"},\"withdraw\":{\"type\":\"boolean\"}},\"required\":[\"commandID\",\"actor\",\"id\",\"note\",\"withdraw\"]}")
	case CommitmentListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\"},\"owner\":{\"type\":\"string\"}}}")
	case QueueUpsertOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"key\":{\"type\":\"string\"},\"priority\":{\"type\":\"integer\"},\"title\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"commandID\",\"actor\",\"key\",\"priority\",\"title\",\"body\",\"status\",\"tags\"]}")
	case QueueRemoveOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"key\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"key\"]}")
	case QueueListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\"}}}")
	case QuestionAskOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"prompt\":{\"type\":\"string\"},\"assumption\":{\"type\":\"string\"},\"concreteAction\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"prompt\",\"assumption\",\"concreteAction\"]}")
	case QuestionAnswerOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"answer\":{\"type\":\"string\"},\"withdraw\":{\"type\":\"boolean\"}},\"required\":[\"commandID\",\"actor\",\"id\",\"answer\",\"withdraw\"]}")
	case QuestionListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"openOnly\":{\"type\":\"boolean\"}},\"required\":[\"openOnly\"]}")
	case RunHeadSetOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"head\"]}")
	case RunSummaryOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"landingsLimit\":{\"type\":\"integer\"}},\"required\":[\"repo\",\"run\"]}")
	case UnitListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"}}}")
	case DecisionRecordOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"},\"scope\":{\"type\":\"string\"},\"unitID\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"supersedes\":{\"type\":\"string\"},\"createdAt\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"category\",\"scope\",\"title\",\"body\"]}")
	case DecisionListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"category\":{\"type\":\"string\"},\"scope\":{\"type\":\"string\"},\"unitID\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"}}}")
	case LandingRecordOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"landingNumber\":{\"type\":\"integer\"},\"groupID\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"},\"tips\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"summary\":{\"type\":\"string\"},\"logPath\":{\"type\":\"string\"},\"landedAt\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"landingNumber\",\"groupID\",\"head\",\"tips\",\"summary\"]}")
	case LandingListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"}}}")
	case EventRecordOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"unitID\":{\"type\":\"string\"},\"summary\":{\"type\":\"string\"},\"sourceKey\":{\"type\":\"string\"},\"createdAt\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"kind\",\"summary\"]}")
	case EventLogOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"unitID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"order\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"}}}")
	case ImportPlanOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"text\"]}")
	}
}

// Call answers r on the bound orchestrate.Api: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs orchestrate.Api {
	match r {
	case UnitOpenRequest as x:
		let v = orchestrate.Api.UnitOpen(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitOpenReply{Value: v}}
	case ReceiptRecordRequest as x:
		let v = orchestrate.Api.ReceiptRecord(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: ReceiptRecordReply{Value: v}}
	case UnitStateRequest as x:
		let v = orchestrate.Api.UnitState(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitStateReply{Value: v}}
	case UnitAcceptRequest as x:
		let v = orchestrate.Api.UnitAccept(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitAcceptReply{Value: v}}
	case UnitLandRequest as x:
		let v = orchestrate.Api.UnitLand(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitLandReply{Value: v}}
	case UnitCloseRequest as x:
		let v = orchestrate.Api.UnitClose(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitCloseReply{Value: v}}
	case CommitmentAddRequest as x:
		let v = orchestrate.Api.CommitmentAdd(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
