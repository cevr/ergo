	try client.opReceiptRecord(input)
}

// UnitState invokes orchestrate.Api's UnitState directly.
func UnitState(client Client, input orchestrate.UnitStateInput) orchestrate.UnitView fails orchestrate.NotFound | orchestrate.InvalidInput | orchestrate.StoreFailed {
