func ReceiptRecordChecked(client CheckedClient, input orchestrate.ReceiptRecordInput) orchestrate.Receipt fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed | rpc.Transport {
	match try client.send(ReceiptRecordRequest{Input: input}) {
	case Done as done:
		match done.Reply {
		case ReceiptRecordReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "orchestrateapi: ReceiptRecord was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case NotFound as failure:
			return failure.E
		case AlreadyExists as failure:
			return failure.E
		case InvalidTransition as failure:
			return failure.E
		case CommandReused as failure:
			return failure.E
		case InvalidInput as failure:
			return failure.E
		case Unverified as failure:
			return failure.E
		case NotAcceptedHead as failure:
			return failure.E
		case StoreFailed as failure:
			return failure.E
		}
	}
}

// UnitStateChecked sends orchestrate.Api's UnitState over send and validates its Outcome.
func UnitStateChecked(client CheckedClient, input orchestrate.UnitStateInput) orchestrate.UnitView fails orchestrate.NotFound | orchestrate.InvalidInput | orchestrate.StoreFailed | rpc.Transport {
	match try client.send(UnitStateRequest{Input: input}) {
