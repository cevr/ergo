import json
import rpc
import sync
import github.com/cevr/ergo/modules/orchestrate/orchestrate

// Request is one call of orchestrate.Api: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = UnitOpenRequest{Input orchestrate.UnitOpenInput} | ReceiptRecordRequest{Input orchestrate.ReceiptRecordInput} | UnitStateRequest{Input orchestrate.UnitStateInput} | UnitAcceptRequest{Input orchestrate.UnitVerdictInput} | UnitLandRequest{Input orchestrate.UnitVerdictInput}

// Op is an operation of orchestrate.Api: what a policy matches on.
type Op = UnitOpenOp{} | ReceiptRecordOp{} | UnitStateOp{} | UnitAcceptOp{} | UnitLandOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = UnitOpenReply{Value orchestrate.Unit} | ReceiptRecordReply{Value orchestrate.Receipt} | UnitStateReply{Value orchestrate.UnitView} | UnitAcceptReply{Value orchestrate.Unit} | UnitLandReply{Value orchestrate.Unit}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = NotFound{E orchestrate.NotFound} | AlreadyExists{E orchestrate.AlreadyExists} | InvalidTransition{E orchestrate.InvalidTransition} | CommandReused{E orchestrate.CommandReused} | InvalidInput{E orchestrate.InvalidInput} | Unverified{E orchestrate.Unverified} | NotAcceptedHead{E orchestrate.NotAcceptedHead} | StoreFailed{E orchestrate.StoreFailed}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case UnitOpenRequest:
		UnitOpenOp
	case ReceiptRecordRequest:
		ReceiptRecordOp
	case UnitStateRequest:
		UnitStateOp
	case UnitAcceptRequest:
		UnitAcceptOp
	case UnitLandRequest:
		UnitLandOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case UnitOpenOp:
		"unit-open"
	case ReceiptRecordOp:
		"receipt-record"
	case UnitStateOp:
		"unit-state"
	case UnitAcceptOp:
		"unit-accept"
	case UnitLandOp:
		"unit-land"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case UnitOpenOp:
		"UnitOpen opens a unit with the receipt kinds its verdict requires."
	case ReceiptRecordOp:
		"ReceiptRecord records one run of a check: command, head, exit code and exit lines."
	case UnitStateOp:
		"UnitState reads a unit and its receipts."
	case UnitAcceptOp:
		"UnitAccept accepts a unit at a head; refused Unverified unless every required kind's latest receipt at that head exited 0."
	case UnitLandOp:
		"UnitLand lands an accepted unit at its accepted head, whose required receipts must still be green."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case UnitOpenOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"requires\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"lane\":{\"type\":\"string\"},\"branch\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"title\",\"requires\"]}")
	case ReceiptRecordOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"command\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"},\"exitCode\":{\"type\":\"integer\"},\"exitLines\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"kind\",\"command\",\"head\",\"exitCode\",\"exitLines\"]}")
	case UnitStateOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"repo\",\"run\",\"id\"]}")
	case UnitAcceptOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"head\"]}")
	case UnitLandOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"run\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"head\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"repo\",\"run\",\"id\",\"head\"]}")
	}
}

// Call answers r on the bound orchestrate.Api: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs orchestrate.Api {
	match r {
	case UnitOpenRequest as x:
		let v = orchestrate.Api.UnitOpen(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitOpenReply{Value: v}}
	case ReceiptRecordRequest as x:
		let v = orchestrate.Api.ReceiptRecord(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: ReceiptRecordReply{Value: v}}
	case UnitStateRequest as x:
		let v = orchestrate.Api.UnitState(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitStateReply{Value: v}}
	case UnitAcceptRequest as x:
		let v = orchestrate.Api.UnitAccept(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitAcceptReply{Value: v}}
	case UnitLandRequest as x:
		let v = orchestrate.Api.UnitLand(x.Input) catch {
		case orchestrate.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case orchestrate.AlreadyExists as e:
			return Rejected{Failure: AlreadyExists{E: e}}
		case orchestrate.InvalidTransition as e:
			return Rejected{Failure: InvalidTransition{E: e}}
		case orchestrate.CommandReused as e:
			return Rejected{Failure: CommandReused{E: e}}
		case orchestrate.InvalidInput as e:
			return Rejected{Failure: InvalidInput{E: e}}
		case orchestrate.Unverified as e:
			return Rejected{Failure: Unverified{E: e}}
		case orchestrate.NotAcceptedHead as e:
			return Rejected{Failure: NotAcceptedHead{E: e}}
		case orchestrate.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: UnitLandReply{Value: v}}
	}
}

// Client provides orchestrate.Api by invoking typed per-operation handlers directly:
// a direct call returns its exact value or declared failure row with no Outcome boxing.
type Client { opUnitOpen func(orchestrate.UnitOpenInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed, opReceiptRecord func(orchestrate.ReceiptRecordInput) orchestrate.Receipt fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed, opUnitState func(orchestrate.UnitStateInput) orchestrate.UnitView fails orchestrate.NotFound | orchestrate.InvalidInput | orchestrate.StoreFailed, opUnitAccept func(orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed, opUnitLand func(orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed } implements orchestrate.Api

// NewClient is the orchestrate.Api that invokes inner directly per operation.
func NewClient(inner orchestrate.Api) Client {
	Client{
		opUnitOpen:      func(input orchestrate.UnitOpenInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { try inner.UnitOpen(input) },
		opReceiptRecord: func(input orchestrate.ReceiptRecordInput) orchestrate.Receipt fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { try inner.ReceiptRecord(input) },
		opUnitState:     func(input orchestrate.UnitStateInput) orchestrate.UnitView fails orchestrate.NotFound | orchestrate.InvalidInput | orchestrate.StoreFailed { try inner.UnitState(input) },
		opUnitAccept:    func(input orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { try inner.UnitAccept(input) },
		opUnitLand:      func(input orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { try inner.UnitLand(input) },
	}
}

// ClientInForce is the orchestrate.Api that invokes the provider currently in force.
func ClientInForce() Client needs orchestrate.Api {
	let held = InForce[orchestrate.Api]()
	Client{
		opUnitOpen:      func(input orchestrate.UnitOpenInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { with held { try orchestrate.Api.UnitOpen(input) } },
		opReceiptRecord: func(input orchestrate.ReceiptRecordInput) orchestrate.Receipt fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { with held { try orchestrate.Api.ReceiptRecord(input) } },
		opUnitState:     func(input orchestrate.UnitStateInput) orchestrate.UnitView fails orchestrate.NotFound | orchestrate.InvalidInput | orchestrate.StoreFailed { with held { try orchestrate.Api.UnitState(input) } },
		opUnitAccept:    func(input orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { with held { try orchestrate.Api.UnitAccept(input) } },
		opUnitLand:      func(input orchestrate.UnitVerdictInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed { with held { try orchestrate.Api.UnitLand(input) } },
	}
}

// UnitOpen invokes orchestrate.Api's UnitOpen directly.
func UnitOpen(client Client, input orchestrate.UnitOpenInput) orchestrate.Unit fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed {
	try client.opUnitOpen(input)
}

