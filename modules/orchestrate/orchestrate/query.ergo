import cmp
import option
import slices

// UnitByKey looks up one unit in State by its key.
func UnitByKey(state State, key UnitKey) option.Option[Unit] {
	state.Units.Get(key)
}

// ReceiptsOf returns the receipts of the unit key, in recorded order.
func ReceiptsOf(state State, key UnitKey) []Receipt {
	let mut out = []Receipt{}
	for id in state.ReceiptOrder {
		match state.Receipts.Get(id) {
		case option.Some[Receipt] as r:
			if r.Value.Unit == key {
				out = out.Append(r.Value)
			}
		case option.None:
		}
	}
	out
}

// ReceiptCheck is what the receipts of a unit at one head say of its required kinds: those with no receipt at the head, and those whose latest receipt at the head did not exit 0.
type ReceiptCheck { Missing []string, Red []string }

// CheckReceipts reads the receipts of u at head against the kinds u requires; the latest receipt of a kind decides it.
func CheckReceipts(state State, u Unit, head string) ReceiptCheck {
	let mut latest = Map[string, int]{}
	for id in state.ReceiptOrder {
		match state.Receipts.Get(id) {
		case option.Some[Receipt] as r:
			if r.Value.Unit == u.Key && r.Value.Head == head {
				latest = latest.Put(r.Value.Kind, r.Value.ExitCode)
			}
		case option.None:
		}
	}
	let mut missing = []string{}
	let mut red = []string{}
	for kind in u.Requires {
		match latest.Get(kind) {
		case option.Some[int] as code:
			if code.Value != 0 {
				red = red.Append(kind)
			}
		case option.None:
			missing = missing.Append(kind)
		}
	}
	ReceiptCheck{Missing: missing, Red: red}
}

// Green reports whether a receipt check leaves no required kind missing or red.
func Green(c ReceiptCheck) bool {
	c.Missing.Len() == 0 && c.Red.Len() == 0
}

// CommitmentByID looks up one commitment in State by ID.
func CommitmentByID(state State, id string) option.Option[Commitment] {
	state.Commitments.Get(id)
}

// ListCommitments returns commitments filtered by optional status and owner, sorted deterministically by ID.
func ListCommitments(state State, status option.Option[CommitmentStatus], owner option.Option[string]) []Commitment {
	let mut out = []Commitment{}
	for _, c in state.Commitments {
		let statusMatch = match status {
		case option.Some[CommitmentStatus] as want:
			c.Status == want.Value
		case option.None:
			true
		}
		let ownerMatch = match owner {
		case option.Some[string] as want:
			c.Owner == option.Some[string]{Value: want.Value}
		case option.None:
			true
		}
		if statusMatch && ownerMatch {
			out = out.Append(c)
		}
	}
	slices.SortFunc(out, func(a Commitment, b Commitment) int { cmp.Compare(a.ID, b.ID) })
}

// ListQueue returns queue items filtered by optional status, ordered by ascending priority then ascending key.
func ListQueue(state State, status option.Option[string]) []QueueItem {
	let mut out = []QueueItem{}
	for _, item in state.Queue {
		let keep = match status {
		case option.Some[string] as want:
			item.Status == want.Value
		case option.None:
			true
		}
		if keep {
			out = out.Append(item)
		}
	}
	slices.SortFunc(out, func(a QueueItem, b QueueItem) int {
		if a.Priority != b.Priority {
			return cmp.Compare(a.Priority, b.Priority)
		}
		cmp.Compare(a.Key, b.Key)
	})
}

// ListQueueOrdersByPriorityThenKey verifies that ListQueue always returns items in non-decreasing (Priority, Key) order.
law ListQueueOrdersByPriorityThenKey(priorities []int) {
	let mut s = EmptyState()
	for i, p in priorities {
		let key = "k-\(priorities.Len() - i)-\(i)"
		let evs = Decide(s, Envelope{
			ID:      CommandID("lq-\(i)"),
			Actor:   "root",
			At:      "2026-11-24T06:00:00Z",
			Command: UpsertQueueItem{
				Key:      key,
				Priority: p,
				Title:    "T",
				Body:     "",
				Status:   "open",
				Tags:     []string{},
			},
		}) catch {
		case _:
			return false
		}
		s = ApplyAll(s, evs)
	}
	let items = ListQueue(s, option.None)
	if items.Len() != priorities.Len() {
		return false
	}
	for i in 1..items.Len() {
		let prev = items[i-1]
		let cur = items[i]
		if prev.Priority > cur.Priority {
			return false
		}
		if prev.Priority == cur.Priority && prev.Key > cur.Key {
			return false
		}
	}
	true
}

// QuestionByID looks up one async question in State by monotonic ID.
func QuestionByID(state State, id int) option.Option[Question] {
	state.Questions.Get(id)
}

// ListQuestions returns all questions (or only open ones when openOnly is true), sorted by ascending ID.
func ListQuestions(state State, openOnly bool) []Question {
	let mut out = []Question{}
	for _, q in state.Questions {
		if !openOnly || q.Status == QuestionOpen {
			out = out.Append(q)
		}
	}
	slices.SortFunc(out, func(a Question, b Question) int { cmp.Compare(a.ID, b.ID) })
}

// RunMetaOf looks up run-level metadata for (repo, run).
func RunMetaOf(state State, repo string, run string) option.Option[RunMeta] {
	state.RunMetas.Get(RunKey{Repo: repo, Run: run})
}

// LeaseOf looks up the landing lease recorded for (repo, run), live or expired.
func LeaseOf(state State, repo string, run string) option.Option[LandingLease] {
	state.Leases.Get(RunKey{Repo: repo, Run: run})
}

// QueryRunSummary computes the compact progressive-disclosure overview for (repo, run).
func QueryRunSummary(state State, repo string, run string, landingsLimit int) RunOverview {
	let mainHead = match RunMetaOf(state, repo, run) {
	case option.Some[RunMeta] as m:
		m.Value.MainHead
	case option.None:
		option.None
	}
	let mut openUnits = 0
	let mut acceptedUnits = 0
	let mut landedUnits = 0
	let mut closedUnits = 0
	let mut totalUnits = 0
	for _, u in state.Units {
		if u.Key.Repo == repo && u.Key.Run == run {
			totalUnits = totalUnits + 1
			match u.Status {
			case UnitOpen:
				openUnits = openUnits + 1
			case UnitAccepted:
				acceptedUnits = acceptedUnits + 1
			case UnitLanded:
				landedUnits = landedUnits + 1
			case UnitClosed:
				closedUnits = closedUnits + 1
			}
		}
	}
	let mut openDecisions = 0
	for _, d in state.Decisions {
		if d.Repo == repo && d.Run == run && d.Status == DecisionOpen {
			openDecisions = openDecisions + 1
		}
	}
	let mut openQuestions = 0
	for _, q in state.Questions {
		if q.Status == QuestionOpen {
			openQuestions = openQuestions + 1
		}
	}
	let mut openCommitments = 0
	for _, c in state.Commitments {
		match c.Status {
		case CommitOpen, CommitAssigned:
			openCommitments = openCommitments + 1
		case CommitLanded, CommitDecided, CommitWithdrawn:
		}
	}
	let recent = if landingsLimit <= 0 {
		[]LandingSummary{}
	} else {
		let page = QueryLandingList(state, LandingFilter{
			Repo:   option.Some[string]{Value: repo},
			Run:    option.Some[string]{Value: run},
			Limit:  landingsLimit,
			Offset: 0,
		})
		let mut summaries = []LandingSummary{}
		for l in page.Items {
			summaries = summaries.Append(LandingSummary{
				LandingNumber: l.LandingNumber,
				GroupID:       l.GroupID,
				Head:          l.Head,
				TipCount:      l.Tips.Len(),
				Summary:       l.Summary,
				LandedAt:      l.LandedAt,
			})
		}
		summaries
	}
	RunOverview{
		Repo:            repo,
		Run:             run,
		MainHead:        mainHead,
		OpenUnits:       openUnits,
		AcceptedUnits:   acceptedUnits,
		LandedUnits:     landedUnits,
		ClosedUnits:     closedUnits,
		TotalUnits:      totalUnits,
		OpenDecisions:   openDecisions,
		OpenQuestions:   openQuestions,
		OpenCommitments: openCommitments,
		RecentLandings:  recent,
	}
}

// QueryUnitList returns filtered and paginated compact unit summaries without receipt payloads.
func QueryUnitList(state State, filter UnitFilter) UnitPage {
	let mut counts = Map[UnitKey, int]{}
	for _, r in state.Receipts {
		let cur = match counts.Get(r.Unit) {
		case option.Some[int] as n:
			n.Value
		case option.None:
			0
		}
		counts = counts.Put(r.Unit, cur+1)
	}
	let mut matched = []UnitSummary{}
	for _, u in state.Units {
		let repoOK = matchOptEq(filter.Repo, u.Key.Repo)
		let runOK = matchOptEq(filter.Run, u.Key.Run)
		let statusOK = match filter.Status {
		case option.Some[UnitStatus] as st:
			u.Status == st.Value
		case option.None:
			true
		}
		if repoOK && runOK && statusOK {
			let rc = match counts.Get(u.Key) {
			case option.Some[int] as n:
				n.Value
			case option.None:
				0
			}
			matched = matched.Append(UnitSummary{
				Key:          u.Key,
				Title:        u.Title,
				Status:       u.Status,
				Head:         u.Head,
				Lane:         u.Lane,
				Branch:       u.Branch,
				ReceiptCount: rc,
				UpdatedAt:    u.UpdatedAt,
			})
		}
	}
	let sorted = slices.SortFunc(matched, func(a UnitSummary, b UnitSummary) int {
		if a.Key.Repo != b.Key.Repo {
			return cmp.Compare(a.Key.Repo, b.Key.Repo)
		}
		if a.Key.Run != b.Key.Run {
			return cmp.Compare(a.Key.Run, b.Key.Run)
		}
		cmp.Compare(a.Key.ID, b.Key.ID)
	})
	let (items, total, hasMore) = paginateSlice(sorted, filter.Limit, filter.Offset)
	UnitPage{Items: items, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: hasMore}
}

// DecisionByKey looks up one Decision in State by (repo, run, id).
func DecisionByKey(state State, key DecisionKey) option.Option[Decision] {
	state.Decisions.Get(key)
}

// QueryDecisionList returns filtered and paginated decisions ordered newest-first by CreatedAt then key.
func QueryDecisionList(state State, filter DecisionFilter) DecisionPage {
	let mut matched = []Decision{}
	for _, d in state.Decisions {
		let repoOK = matchOptEq(filter.Repo, d.Repo)
		let runOK = matchOptEq(filter.Run, d.Run)
		let catOK = matchOptEq(filter.Category, d.Category)
		let scopeOK = matchOptEq(filter.Scope, d.Scope)
		let unitOK = match filter.UnitID {
		case option.Some[string] as want:
			d.UnitID == (option.Some[string]{Value: want.Value})
		case option.None:
			true
		}
		let statusOK = match filter.Status {
		case option.Some[DecisionStatus] as st:
			d.Status == st.Value
		case option.None:
			true
		}
		if repoOK && runOK && catOK && scopeOK && unitOK && statusOK {
			matched = matched.Append(d)
		}
	}
	let sorted = slices.SortFunc(matched, func(a Decision, b Decision) int {
		if a.CreatedAt != b.CreatedAt {
			return cmp.Compare(b.CreatedAt, a.CreatedAt)
		}
		if a.Repo != b.Repo {
			return cmp.Compare(a.Repo, b.Repo)
		}
		if a.Run != b.Run {
			return cmp.Compare(a.Run, b.Run)
		}
		cmp.Compare(a.ID, b.ID)
	})
	let (items, total, hasMore) = paginateSlice(sorted, filter.Limit, filter.Offset)
	DecisionPage{Items: items, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: hasMore}
}

// LandingByKey looks up one Landing in State by (repo, run, landingNumber).
func LandingByKey(state State, key LandingKey) option.Option[Landing] {
	state.Landings.Get(key)
}

// QueryLandingList returns filtered and paginated landings ordered newest-first by LandingNumber.
func QueryLandingList(state State, filter LandingFilter) LandingPage {
	let mut matched = []Landing{}
	for _, l in state.Landings {
		if matchOptEq(filter.Repo, l.Repo) && matchOptEq(filter.Run, l.Run) {
			matched = matched.Append(l)
		}
	}
	let sorted = slices.SortFunc(matched, func(a Landing, b Landing) int {
		if a.LandingNumber != b.LandingNumber {
			return cmp.Compare(b.LandingNumber, a.LandingNumber)
		}
		if a.Repo != b.Repo {
			return cmp.Compare(a.Repo, b.Repo)
		}
		cmp.Compare(a.Run, b.Run)
	})
	let (items, total, hasMore) = paginateSlice(sorted, filter.Limit, filter.Offset)
	LandingPage{Items: items, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: hasMore}
}

// QueryEventLog returns filtered, ordered, and paginated operational ledger events.
func QueryEventLog(state State, filter EventLogFilter) EventPage {
	let mut matched = []LedgerEvent{}
	if filter.Ascending {
		for ev in state.EventLog {
			if eventMatchesFilter(ev, filter) {
				matched = matched.Append(ev)
			}
		}
	} else {
		let n = state.EventLog.Len()
		for i in 0..n {
			let ev = state.EventLog[n-1-i]
			if eventMatchesFilter(ev, filter) {
				matched = matched.Append(ev)
			}
		}
	}
	let (items, total, hasMore) = paginateSlice(matched, filter.Limit, filter.Offset)
	EventPage{Items: items, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: hasMore}
}

// QueryEventLogSince returns operational ledger events with ID strictly greater than filter.SinceID in ascending ID order.
func QueryEventLogSince(state State, filter EventLogSinceFilter) EventPage {
	let mut matched = []LedgerEvent{}
	for ev in state.EventLog {
		if ev.ID > filter.SinceID && eventFieldsMatch(ev, filter.Repo, filter.Run, filter.Kind, filter.UnitID, filter.Actor) {
			matched = matched.Append(ev)
		}
	}
	let (items, total, hasMore) = paginateSlice(matched, filter.Limit, 0)
	EventPage{Items: items, Total: total, Limit: filter.Limit, Offset: 0, HasMore: hasMore}
}

func eventMatchesFilter(ev LedgerEvent, filter EventLogFilter) bool {
	eventFieldsMatch(ev, filter.Repo, filter.Run, filter.Kind, filter.UnitID, filter.Actor)
}

func eventFieldsMatch(ev LedgerEvent, repo option.Option[string], run option.Option[string], kind option.Option[string], unitID option.Option[string], actor option.Option[string]) bool {
	let repoOK = matchOptEq(repo, ev.Repo)
	let runOK = matchOptEq(run, ev.Run)
	let kindOK = matchOptEq(kind, ev.Kind)
	let actorOK = matchOptEq(actor, ev.Actor)
	let unitOK = match unitID {
	case option.Some[string] as want:
		ev.UnitID == (option.Some[string]{Value: want.Value})
	case option.None:
		true
	}
	repoOK && runOK && kindOK && actorOK && unitOK
}

func matchOptEq(want option.Option[string], actual string) bool {
	match want {
	case option.Some[string] as s:
		actual == s.Value
	case option.None:
		true
	}
}

func paginateSlice[T](items []T, limit int, offset int) ([]T, int, bool) {
	let total = items.Len()
	if limit <= 0 || offset < 0 || offset >= total {
		return ([]T{}, total, false)
	}
	let end = if offset+limit < total { offset + limit } else { total }
	(slices.Slice(items, offset, end), total, end < total)
}

// UnitListPaginationAndFilterLaw verifies that QueryUnitList filters by status, reports accurate receipt counts, and paginates deterministically without full receipts.
law UnitListPaginationAndFilterLaw(tag int) {
	let mut s = EmptyState()
	let ids = []string{"u1", "u2", "u3"}
	for i, uid in ids {
		let k = UnitKey{Repo: "repo", Run: "r-\(tag)", ID: uid}
		s = lawStep(s, "o-\(i)", OpenUnit{Key: k, Title: "Unit \(i)", Requires: []string{"test"}, Lane: option.None, Branch: option.None}) catch {
		case _:
			return false
		}
		if i > 0 {
			s = lawStep(s, "rec-\(i)", RecordReceipt{Unit: k, Kind: "test", Command: "ergo test", Head: "h", ExitCode: 0, ExitLines: "ok"}) catch {
			case _:
				return false
			}
			s = lawStep(s, "acc-\(i)", AcceptUnit{Unit: k, Head: "h"}) catch {
			case _:
				return false
			}
		}
	}
	let p1 = QueryUnitList(s, UnitFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "r-\(tag)"}, Status: option.None, Limit: 2, Offset: 0})
	let p2 = QueryUnitList(s, UnitFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "r-\(tag)"}, Status: option.None, Limit: 2, Offset: 2})
	let acc = QueryUnitList(s, UnitFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "r-\(tag)"}, Status: option.Some[UnitStatus]{Value: UnitAccepted}, Limit: 10, Offset: 0})
	let sum = QueryRunSummary(s, "repo", "r-\(tag)", 5)
		p1.Total == 3 && p1.Items.Len() == 2 && p1.HasMore && p1.Items[0].ReceiptCount == 0 && p1.Items[1].ReceiptCount == 1 &&
		p2.Total == 3 && p2.Items.Len() == 1 && !p2.HasMore && p2.Items[0].Key.ID == "u3" &&
		acc.Total == 2 && acc.Items.Len() == 2 &&
		sum.TotalUnits == 3 && sum.OpenUnits == 1 && sum.AcceptedUnits == 2 && sum.LandedUnits == 0
}
