import cmp
import option
import slices

// UnitByKey looks up one unit in State by its key.
func UnitByKey(state State, key UnitKey) option.Option[Unit] {
	state.Units.Get(key)
}

// ReceiptsOf returns the receipts of the unit key, in recorded order.
func ReceiptsOf(state State, key UnitKey) []Receipt {
	let mut out = []Receipt{}
	for id in state.ReceiptOrder {
		match state.Receipts.Get(id) {
		case option.Some[Receipt] as r:
			if r.Value.Unit == key {
				out = out.Append(r.Value)
			}
		case option.None:
		}
	}
	out
}

// ReceiptCheck is what the receipts of a unit at one head say of its required kinds: those with no receipt at the head, and those whose latest receipt at the head did not exit 0.
type ReceiptCheck { Missing []string, Red []string }

// CheckReceipts reads the receipts of u at head against the kinds u requires; the latest receipt of a kind decides it.
func CheckReceipts(state State, u Unit, head string) ReceiptCheck {
	let mut latest = Map[string, int]{}
	for id in state.ReceiptOrder {
		match state.Receipts.Get(id) {
		case option.Some[Receipt] as r:
			if r.Value.Unit == u.Key && r.Value.Head == head {
				latest = latest.Put(r.Value.Kind, r.Value.ExitCode)
			}
		case option.None:
		}
	}
	let mut missing = []string{}
	let mut red = []string{}
	for kind in u.Requires {
		match latest.Get(kind) {
		case option.Some[int] as code:
			if code.Value != 0 {
				red = red.Append(kind)
			}
		case option.None:
			missing = missing.Append(kind)
		}
	}
	ReceiptCheck{Missing: missing, Red: red}
}

// Green reports whether a receipt check leaves no required kind missing or red.
func Green(c ReceiptCheck) bool {
	c.Missing.Len() == 0 && c.Red.Len() == 0
}

// CommitmentByID looks up one commitment in State by ID.
func CommitmentByID(state State, id string) option.Option[Commitment] {
	state.Commitments.Get(id)
}

// ListCommitments returns commitments filtered by optional status and owner, sorted deterministically by ID.
func ListCommitments(state State, status option.Option[CommitmentStatus], owner option.Option[string]) []Commitment {
	let mut out = []Commitment{}
	for _, c in state.Commitments {
		let statusMatch = match status {
		case option.Some[CommitmentStatus] as want:
			c.Status == want.Value
		case option.None:
			true
		}
		let ownerMatch = match owner {
		case option.Some[string] as want:
			c.Owner == option.Some[string]{Value: want.Value}
		case option.None:
			true
		}
		if statusMatch && ownerMatch {
			out = out.Append(c)
		}
	}
	slices.SortFunc(out, func(a Commitment, b Commitment) int { cmp.Compare(a.ID, b.ID) })
}

// ListQueue returns queue items filtered by optional status, ordered by ascending priority then ascending key.
func ListQueue(state State, status option.Option[string]) []QueueItem {
	let mut out = []QueueItem{}
	for _, item in state.Queue {
		let keep = match status {
		case option.Some[string] as want:
			item.Status == want.Value
		case option.None:
			true
		}
		if keep {
			out = out.Append(item)
		}
	}
	slices.SortFunc(out, func(a QueueItem, b QueueItem) int {
		if a.Priority != b.Priority {
			return cmp.Compare(a.Priority, b.Priority)
		}
		cmp.Compare(a.Key, b.Key)
	})
}

// ListQueueOrdersByPriorityThenKey verifies that ListQueue always returns items in non-decreasing (Priority, Key) order.
law ListQueueOrdersByPriorityThenKey(priorities []int) {
	let mut s = EmptyState()
	for i, p in priorities {
		let key = "k-\(priorities.Len() - i)-\(i)"
		let evs = Decide(s, Envelope{
			ID:      CommandID("lq-\(i)"),
			Actor:   "root",
			At:      "2026-11-24T06:00:00Z",
			Command: UpsertQueueItem{
				Key:      key,
				Priority: p,
				Title:    "T",
				Body:     "",
				Status:   "open",
				Tags:     []string{},
			},
		}) catch {
		case _:
			return false
		}
		s = ApplyAll(s, evs)
	}
	let items = ListQueue(s, option.None)
	if items.Len() != priorities.Len() {
		return false
	}
	for i in 1..items.Len() {
		let prev = items[i-1]
		let cur = items[i]
		if prev.Priority > cur.Priority {
			return false
		}
		if prev.Priority == cur.Priority && prev.Key > cur.Key {
			return false
		}
	}
	true
}

// QuestionByID looks up one async question in State by monotonic ID.
func QuestionByID(state State, id int) option.Option[Question] {
	state.Questions.Get(id)
}

// ListQuestions returns all questions (or only open ones when openOnly is true), sorted by ascending ID.
func ListQuestions(state State, openOnly bool) []Question {
	let mut out = []Question{}
	for _, q in state.Questions {
		if !openOnly || q.Status == QuestionOpen {
			out = out.Append(q)
		}
	}
	slices.SortFunc(out, func(a Question, b Question) int { cmp.Compare(a.ID, b.ID) })
}
