import option

// CommandID uniquely identifies one caller-submitted command for idempotency.
type CommandID string

// NotFound reports that a referenced entity does not exist.
type NotFound { Kind string, ID string }

// AlreadyExists reports that an entity with the same ID already exists.
type AlreadyExists { Kind string, ID string }

// InvalidTransition reports that an action is not valid from the entity's current status.
type InvalidTransition { Kind string, ID string, From string, Action string }

// StaleClaim reports that an operation expected a different active unit owner.
type StaleClaim { UnitID string, ExpectedOwner string, ActualOwner string }

// CommandReused reports that an existing CommandID was resubmitted with a different payload.
type CommandReused { ID CommandID }

// InvalidInput reports that a command field failed pure domain validation.
type InvalidInput { Field string, Why string }

// Refusal is the closed union of pure domain command refusals.
type Refusal = NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput

// StoreFailed reports a persistence or transaction failure outside pure domain logic.
type StoreFailed { Reason string }

// UnitOpen is a newly opened unit awaiting a claim.
type UnitOpen {}

// UnitClaimed is a unit currently owned and worked in a lane.
type UnitClaimed {}

// UnitHandedBack is a unit whose round has been handed back for review or landing.
type UnitHandedBack {}

// UnitLanded is a unit whose commits have landed (terminal).
type UnitLanded {}

// UnitClosed is a unit closed without landing (terminal).
type UnitClosed {}

// UnitStatus is the lifecycle state of a work unit.
type UnitStatus = UnitOpen | UnitClaimed | UnitHandedBack | UnitLanded | UnitClosed

// UnitStatusName is the canonical external name of a UnitStatus.
func UnitStatusName(s UnitStatus) string {
	match s {
	case UnitOpen:
		"open"
	case UnitClaimed:
		"claimed"
	case UnitHandedBack:
		"handed-back"
	case UnitLanded:
		"landed"
	case UnitClosed:
		"closed"
	}
}

// ParseUnitStatus parses a canonical external unit status name.
func ParseUnitStatus(text string) option.Option[UnitStatus] {
	match text {
	case "open":
		option.Some[UnitStatus]{Value: UnitOpen}
	case "claimed":
		option.Some[UnitStatus]{Value: UnitClaimed}
	case "handed-back":
		option.Some[UnitStatus]{Value: UnitHandedBack}
	case "landed":
		option.Some[UnitStatus]{Value: UnitLanded}
	case "closed":
		option.Some[UnitStatus]{Value: UnitClosed}
	case _:
		option.None
	}
}

// UnitStatusNameRoundTrips verifies that every UnitStatus survives formatting and parsing.
law UnitStatusNameRoundTrips(s UnitStatus) {
	ParseUnitStatus(UnitStatusName(s)) == option.Some[UnitStatus]{Value: s}
}

// Unit is the projected state of one orchestrated work unit.
type Unit {
	ID           string,
	Title        string,
	Area         string,
	Status       UnitStatus,
	Owner        option.Option[string],
	Lane         option.Option[string],
	Harness      option.Option[string],
	Round        int,
	HeadSHA      option.Option[string],
	Summary      option.Option[string],
	RequestPath  option.Option[string],
	FindingsPath option.Option[string],
	CreatedAt    string,
	UpdatedAt    string,
}

// Receipt records structured verification or execution evidence pointing to an external log file.
type Receipt {
	ID             string,
	UnitID         string,
	Round          int,
	Kind           string,
	Command        string,
	CommitSHA      string,
	ExitCode       int,
	SummaryMetrics string,
	LogPath        string,
	LogSHA256      string,
	RecordedAt     string,
	RecordedBy     string,
}

// CommitOpen is an unassigned commitment.
type CommitOpen {}

// CommitAssigned is a commitment assigned to an owner and lane.
type CommitAssigned {}

// CommitLanded is a commitment fulfilled by a landed commit (terminal).
type CommitLanded {}

// CommitDecided is a commitment closed by an explicit decision (terminal).
type CommitDecided {}

// CommitWithdrawn is a commitment withdrawn by an explicit decision (terminal).
type CommitWithdrawn {}

// CommitmentStatus is the lifecycle state of a commitment.
type CommitmentStatus = CommitOpen | CommitAssigned | CommitLanded | CommitDecided | CommitWithdrawn

// CommitmentStatusName is the canonical external name of a CommitmentStatus.
func CommitmentStatusName(s CommitmentStatus) string {
	match s {
	case CommitOpen:
		"open"
	case CommitAssigned:
		"assigned"
	case CommitLanded:
		"landed"
	case CommitDecided:
		"decided"
	case CommitWithdrawn:
		"withdrawn"
	}
}

// ParseCommitmentStatus parses a canonical external commitment status name.
func ParseCommitmentStatus(text string) option.Option[CommitmentStatus] {
	match text {
	case "open":
		option.Some[CommitmentStatus]{Value: CommitOpen}
	case "assigned":
		option.Some[CommitmentStatus]{Value: CommitAssigned}
	case "landed":
		option.Some[CommitmentStatus]{Value: CommitLanded}
	case "decided":
		option.Some[CommitmentStatus]{Value: CommitDecided}
	case "withdrawn":
		option.Some[CommitmentStatus]{Value: CommitWithdrawn}
	case _:
		option.None
	}
}

// CommitmentStatusNameRoundTrips verifies that every CommitmentStatus survives formatting and parsing.
law CommitmentStatusNameRoundTrips(s CommitmentStatus) {
	ParseCommitmentStatus(CommitmentStatusName(s)) == option.Some[CommitmentStatus]{Value: s}
}

// Commitment is the projected state of a tracked obligation.
type Commitment {
	ID           string,
	Title        string,
	Kind         string,
	Status       CommitmentStatus,
	Owner        option.Option[string],
	Lane         option.Option[string],
	LandedSHA    option.Option[string],
	DecisionNote option.Option[string],
	CreatedAt    string,
	UpdatedAt    string,
}

// QueueItem is one prioritized entry in the shared orchestrator queue.
type QueueItem {
	Key       string,
	Priority  int,
	Title     string,
	Body      string,
	Status    string,
	Tags      []string,
	UpdatedAt string,
}

// QuestionOpen is an unanswered question currently proceeding on its default assumption.
type QuestionOpen {}

// QuestionAnswered is a question resolved with an explicit answer (terminal).
type QuestionAnswered {}

// QuestionWithdrawn is a question withdrawn before being answered (terminal).
type QuestionWithdrawn {}

// QuestionStatus is the lifecycle state of an async question.
type QuestionStatus = QuestionOpen | QuestionAnswered | QuestionWithdrawn

// QuestionStatusName is the canonical external name of a QuestionStatus.
func QuestionStatusName(s QuestionStatus) string {
	match s {
	case QuestionOpen:
		"open"
	case QuestionAnswered:
		"answered"
	case QuestionWithdrawn:
		"withdrawn"
	}
}

// ParseQuestionStatus parses a canonical external question status name.
func ParseQuestionStatus(text string) option.Option[QuestionStatus] {
	match text {
	case "open":
		option.Some[QuestionStatus]{Value: QuestionOpen}
	case "answered":
		option.Some[QuestionStatus]{Value: QuestionAnswered}
	case "withdrawn":
		option.Some[QuestionStatus]{Value: QuestionWithdrawn}
	case _:
		option.None
	}
}

// QuestionStatusNameRoundTrips verifies that every QuestionStatus survives formatting and parsing.
law QuestionStatusNameRoundTrips(s QuestionStatus) {
	ParseQuestionStatus(QuestionStatusName(s)) == option.Some[QuestionStatus]{Value: s}
}

// Question is an async question with a monotonic integer ID and default assumption.
type Question {
	ID             int,
	Prompt         string,
	Assumption     string,
	ConcreteAction string,
	Status         QuestionStatus,
	Answer         option.Option[string],
	AskedBy        string,
	AskedAt        string,
	AnsweredBy     option.Option[string],
	AnsweredAt     option.Option[string],
}

// State is the complete pure projection folded from the orchestrate event log.
type State {
	Units             Map[string, Unit],
	Receipts          Map[string, Receipt],
	ReceiptOrder      []string,
	Commitments       Map[string, Commitment],
	Queue             Map[string, QueueItem],
	Questions         Map[int, Question],
	QuestionByCommand Map[CommandID, int],
	NextQuestionID    int,
	Commands          Map[CommandID, Command],
}

// EmptyState is the initial projection before any events have been applied.
func EmptyState() State {
	State{
		Units:             Map[string, Unit]{},
		Receipts:          Map[string, Receipt]{},
		ReceiptOrder:      []string{},
		Commitments:       Map[string, Commitment]{},
		Queue:             Map[string, QueueItem]{},
		Questions:         Map[int, Question]{},
		QuestionByCommand: Map[CommandID, int]{},
		NextQuestionID:    1,
		Commands:          Map[CommandID, Command]{},
	}
}
