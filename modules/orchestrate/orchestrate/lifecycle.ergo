import core
import machines

// ActAccept accepts a unit at a head whose required receipts are green.
type ActAccept {}

// ActLand lands an accepted unit at its accepted head.
type ActLand {}

// ActClose closes a non-terminal unit without landing.
type ActClose {}

// UnitAction is a lifecycle transition action on a unit.
type UnitAction = ActAccept | ActLand | ActClose

// UnitActionName is the canonical name of a UnitAction.
func UnitActionName(a UnitAction) string {
	match a {
	case ActAccept:
		"accept"
	case ActLand:
		"land"
	case ActClose:
		"close"
	}
}

// UnitFinal reports whether a unit status is terminal and admits no further transitions.
func UnitFinal(s UnitStatus) bool {
	match s {
	case UnitLanded, UnitClosed:
		true
	case UnitOpen, UnitAccepted:
		false
	}
}

// StepUnit is the pure unit lifecycle transition function; the receipt guard of accept and land is Decide's.
func StepUnit(s UnitStatus, a UnitAction) machines.Decision[UnitStatus, core.Never] {
	match (s, a) {
	case (UnitOpen, ActAccept):
		machines.Enter[UnitStatus]{Next: UnitAccepted}
	case (UnitOpen, ActClose):
		machines.Enter[UnitStatus]{Next: UnitClosed}
	case (UnitOpen, ActLand):
		machines.Reject
	case (UnitAccepted, ActAccept):
		machines.Stay[UnitStatus]{Next: UnitAccepted}
	case (UnitAccepted, ActLand):
		machines.Enter[UnitStatus]{Next: UnitLanded}
	case (UnitAccepted, ActClose):
		machines.Enter[UnitStatus]{Next: UnitClosed}
	case (UnitLanded | UnitClosed, ActAccept | ActLand | ActClose):
		machines.Reject
	}
}

// LandRequiresAccept verifies that only an accepted unit can be landed.
law LandRequiresAccept(s UnitStatus) {
	match StepUnit(s, ActLand) {
	case machines.Enter[UnitStatus]:
		s == UnitAccepted
	case machines.Stay[UnitStatus]:
		false
	case machines.Ignore, machines.Reject:
		s != UnitAccepted
	}
}

// FinalUnitTakesNoAction verifies that terminal unit statuses reject every action.
law FinalUnitTakesNoAction(s UnitStatus, a UnitAction) {
	if !UnitFinal(s) {
		return true
	}
	match StepUnit(s, a) {
	case machines.Reject:
		true
	case machines.Enter[UnitStatus], machines.Stay[UnitStatus], machines.Ignore:
		false
	}
}

func unitCanClose(s UnitStatus) bool {
	if UnitFinal(s) {
		return true
	}
	match machines.Next(s, StepUnit(s, ActClose)) {
	case UnitClosed:
		true
	case UnitOpen, UnitAccepted, UnitLanded:
		false
	}
}

func unitIsLanded(s UnitStatus) bool {
	s == UnitLanded
}

// UnitLifecycle is the formal finite-state machine of one unit's status transitions.
type UnitLifecycle machine[UnitStatus, UnitAction] {
	initial: UnitOpen,
	step:    StepUnit,

	// AlwaysClosableUnlessFinal verifies every reachable non-final unit can still be closed.
	law AlwaysClosableUnlessFinal always unitCanClose,

	// ReachableLanding verifies a unit can progress from open to landed.
	law ReachableLanding sometimes unitIsLanded,

	// ReachableTerminal verifies a unit can reach a terminal state.
	law ReachableTerminal sometimes UnitFinal,
}

// ActAnswer resolves an open question with an answer.
type ActAnswer {}

// ActWithdraw withdraws an open question without an answer.
type ActWithdraw {}

// QuestionAction is a lifecycle transition action on an async question.
type QuestionAction = ActAnswer | ActWithdraw

// QuestionFinal reports whether a question status is terminal.
func QuestionFinal(s QuestionStatus) bool {
	match s {
	case QuestionAnswered, QuestionWithdrawn:
		true
	case QuestionOpen:
		false
	}
}

// StepQuestion is the pure question lifecycle transition function.
func StepQuestion(s QuestionStatus, a QuestionAction) machines.Decision[QuestionStatus, core.Never] {
	match (s, a) {
	case (QuestionOpen, ActAnswer):
		machines.Enter[QuestionStatus]{Next: QuestionAnswered}
	case (QuestionOpen, ActWithdraw):
		machines.Enter[QuestionStatus]{Next: QuestionWithdrawn}
	case (QuestionAnswered | QuestionWithdrawn, ActAnswer | ActWithdraw):
		machines.Reject
	}
}

// FinalQuestionTakesNoAction verifies that answered or withdrawn questions reject every action.
law FinalQuestionTakesNoAction(s QuestionStatus, a QuestionAction) {
	if !QuestionFinal(s) {
		return true
	}
	match StepQuestion(s, a) {
	case machines.Reject:
		true
	case machines.Enter[QuestionStatus], machines.Stay[QuestionStatus], machines.Ignore:
		false
	}
}

func questionIsAnswered(s QuestionStatus) bool {
	s == QuestionAnswered
}

func questionIsWithdrawn(s QuestionStatus) bool {
	s == QuestionWithdrawn
}

// QuestionLifecycle is the formal finite-state machine of one question's status transitions.
type QuestionLifecycle machine[QuestionStatus, QuestionAction] {
	initial: QuestionOpen,
	step:    StepQuestion,

	// ReachableAnswered verifies an open question can be answered.
	law ReachableAnswered sometimes questionIsAnswered,

	// ReachableWithdrawn verifies an open question can be withdrawn.
	law ReachableWithdrawn sometimes questionIsWithdrawn,
}
