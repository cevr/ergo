import machines
import option
import slices
import strconv
import strings
import time

// MaxExitLinesBytes bounds Receipt.ExitLines so a receipt carries exit lines, never a log.
let MaxExitLinesBytes = 4096

// Decide validates an explicit Command Envelope against State with zero I/O and returns the events to persist.
func Decide(state State, env Envelope) []Event fails Refusal {
	match state.Commands.Get(env.ID) {
	case option.Some[Command] as prev:
		if prev.Value == env.Command {
			return []Event{}
		}
		return CommandReused{ID: env.ID}
	case option.None:
	}
	try requireText("commandId", string(env.ID))
	try requireText("actor", env.Actor)
	try requireText("at", env.At)
	let domainEvents = try decideCommands(state, env)
	slices.Concat([]Event{CommandAccepted{ID: env.ID, Actor: env.Actor, At: env.At, Command: env.Command}}, domainEvents)
}

func decideCommands(state State, env Envelope) []Event fails Refusal {
	match env.Command {
	case OpenUnit as c:
		try requireKey(c.Key)
		try requireText("title", c.Title)
		try requireKinds(c.Requires)
		try requireOptionalText("lane", c.Lane)
		try requireOptionalText("branch", c.Branch)
		if state.Units.Get(c.Key) != option.None {
			return AlreadyExists{Kind: "unit", ID: UnitKeyText(c.Key)}
		}
		match c.Lane {
		case option.Some[string] as lane:
			match LaneHolder(state, c.Key.Repo, lane.Value) {
			case option.Some[Unit] as holder:
				return LaneHeld{Lane: lane.Value, Unit: holder.Value.Key, Actor: holder.Value.Owner}
			case option.None:
			}
		case option.None:
		}
		[]Event{
			UnitOpened{Key: c.Key, Title: c.Title, Requires: slices.Clone(c.Requires), Lane: c.Lane, Branch: c.Branch, At: env.At},
			UnitOwnerChanged{Unit: c.Key, From: UnknownOwner, To: env.Actor, At: env.At},
		}
	case RecordReceipt as c:
		try requireKey(c.Unit)
		try requireText("kind", c.Kind)
		try requireText("command", c.Command)
		try requireText("head", c.Head)
		if c.ExitLines.Len() > MaxExitLinesBytes {
			return InvalidInput{Field: "exitLines", Why: "exceeds 4096 bytes; keep the exit lines, not the log"}
		}
		try requireOwner(try existingUnit(state, c.Unit), env.Actor)
		[]Event{ReceiptRecorded{
			Receipt: Receipt{
				ID:         string(env.ID),
				Unit:       c.Unit,
				Kind:       c.Kind,
				Command:    c.Command,
				Head:       c.Head,
				ExitCode:   c.ExitCode,
				ExitLines:  c.ExitLines,
				RecordedAt: env.At,
				RecordedBy: env.Actor,
			},
		}}
	case AcceptUnit as c:
		try requireKey(c.Unit)
		try requireText("head", c.Head)
		let u = try existingUnit(state, c.Unit)
		try requireOwner(u, env.Actor)
		try requireUnitAction(u, ActAccept)
		try requireGreen(state, u, c.Head)
		[]Event{UnitWasAccepted{Unit: c.Unit, Head: c.Head, At: env.At}}
	case LandUnit as c:
		try requireKey(c.Unit)
		try requireText("head", c.Head)
		let u = try existingUnit(state, c.Unit)
		try requireOwner(u, env.Actor)
		try requireUnitAction(u, ActLand)
		let _ = try heldLease(state, c.Unit.Repo, c.Unit.Run, env.Actor, try unixAt(env.At))
		let accepted = match u.Head {
		case option.Some[string] as h:
			h.Value
		case option.None:
			""
		}
		if accepted != c.Head {
			return NotAcceptedHead{Unit: c.Unit, Accepted: accepted, Head: c.Head}
		}
		try requireGreen(state, u, c.Head)
		[]Event{UnitWasLanded{Unit: c.Unit, Head: c.Head, At: env.At}}
	case CloseUnit as c:
		try requireKey(c.Unit)
		let u = try existingUnit(state, c.Unit)
		try requireOwner(u, env.Actor)
		try requireUnitAction(u, ActClose)
		[]Event{UnitWasClosed{Unit: c.Unit, At: env.At}}
	case TransferUnit as c:
		try requireKey(c.Unit)
		try requireText("to", c.To)
		if c.To == UnknownOwner {
			return InvalidInput{Field: "to", Why: "must name an actor"}
		}
		let u = try existingUnit(state, c.Unit)
		if u.Owner == UnknownOwner {
			if c.To != env.Actor {
				return InvalidInput{Field: "to", Why: "a unit of unknown owner is claimed by the caller for itself"}
			}
		} else {
			try requireOwner(u, env.Actor)
		}
		if UnitFinal(u.Status) {
			return InvalidTransition{Kind: "unit", ID: UnitKeyText(u.Key), From: UnitStatusName(u.Status), Action: "transfer"}
		}
		[]Event{UnitOwnerChanged{Unit: c.Unit, From: u.Owner, To: c.To, At: env.At}}
	case BeginLanding as c:
		try requireText("repo", c.Repo)
		try requireText("run", c.Run)
		try requireText("expectedHead", c.ExpectedHead)
		if c.LifetimeSeconds < 1 || c.LifetimeSeconds > MaxLeaseSeconds {
			return InvalidInput{Field: "lifetimeSeconds", Why: "must be 1 to \(MaxLeaseSeconds)"}
		}
		let now = try unixAt(env.At)
		let rk = RunKey{Repo: c.Repo, Run: c.Run}
		let mut out = []Event{}
		match state.Leases.Get(rk) {
		case option.Some[LandingLease] as held:
			if held.Value.Actor != env.Actor {
				if LeaseLive(held.Value, now) {
					return LandingBusy{Actor: held.Value.Actor, Since: held.Value.Since}
				}
				out = out.Append(LandingLeaseTakenOver{Repo: c.Repo, Run: c.Run, From: held.Value.Actor, FromSince: held.Value.Since, To: env.Actor, At: env.At})
			}
		case option.None:
		}
		match RunHead(state, c.Repo, c.Run) {
		case option.Some[string] as h:
			if h.Value != c.ExpectedHead {
				return StaleHead{Have: c.ExpectedHead, Want: h.Value}
			}
		case option.None:
			out = out.Append(RunHeadUpdated{Repo: c.Repo, Run: c.Run, Head: c.ExpectedHead, UpdatedAt: env.At})
		}
		let until = time.Unix(now+int64(c.LifetimeSeconds), 0).Format(time.RFC3339)
		out.Append(LandingLeaseTaken{Lease: LandingLease{Repo: c.Repo, Run: c.Run, Actor: env.Actor, BaseHead: c.ExpectedHead, Since: env.At, Until: until}})
	case EndLanding as c:
		try requireText("repo", c.Repo)
		try requireText("run", c.Run)
		try requireText("newHead", c.NewHead)
		let lease = try heldLease(state, c.Repo, c.Run, env.Actor, try unixAt(env.At))
		match RunHead(state, c.Repo, c.Run) {
		case option.Some[string] as h:
			if h.Value != lease.BaseHead {
				return StaleHead{Have: lease.BaseHead, Want: h.Value}
			}
		case option.None:
		}
		[]Event{RunHeadUpdated{Repo: c.Repo, Run: c.Run, Head: c.NewHead, UpdatedAt: env.At}, LandingLeaseEnded{Repo: c.Repo, Run: c.Run, Actor: env.Actor, At: env.At}}
	case AddCommitment as c:
		try requireText("id", c.ID)
		try requireText("title", c.Title)
		try requireText("kind", c.Kind)
		if state.Commitments.Get(c.ID) != option.None {
			return AlreadyExists{Kind: "commitment", ID: c.ID}
		}
		[]Event{CommitmentAdded{ID: c.ID, Title: c.Title, Kind: c.Kind, At: env.At}}
	case AssignCommitment as c:
		try requireText("id", c.ID)
		try requireText("owner", c.Owner)
		try requireText("lane", c.Lane)
		let cur = try existingCommitment(state, c.ID)
		try requireCommitmentMutable(cur, "assign")
		[]Event{CommitmentWasAssigned{ID: c.ID, Owner: c.Owner, Lane: c.Lane, At: env.At}}
	case LandCommitment as c:
		try requireText("id", c.ID)
		try requireText("landedSha", c.LandedSHA)
		let cur = try existingCommitment(state, c.ID)
		try requireCommitmentMutable(cur, "land")
		[]Event{CommitmentWasLanded{ID: c.ID, LandedSHA: c.LandedSHA, At: env.At}}
	case DecideCommitment as c:
		try requireText("id", c.ID)
		try requireText("note", c.Note)
		let cur = try existingCommitment(state, c.ID)
		let action = if c.Withdraw { "withdraw" } else { "decide" }
		try requireCommitmentMutable(cur, action)
		if c.Withdraw {
			return []Event{CommitmentWasWithdrawn{ID: c.ID, Note: c.Note, At: env.At}}
		}
		[]Event{CommitmentWasDecided{ID: c.ID, Note: c.Note, At: env.At}}
	case UpsertQueueItem as c:
		try requireText("key", c.Key)
		try requireText("title", c.Title)
		try requireText("status", c.Status)
		for tag in c.Tags {
			try requireText("tags", tag)
		}
		[]Event{QueueUpserted{
			Item: QueueItem{
				Key:       c.Key,
				Priority:  c.Priority,
				Title:     c.Title,
				Body:      c.Body,
				Status:    c.Status,
				Tags:      slices.Clone(c.Tags),
				UpdatedAt: env.At,
			},
		}}
	case RemoveQueueItem as c:
		try requireText("key", c.Key)
		if state.Queue.Get(c.Key) == option.None {
			return NotFound{Kind: "queue", ID: c.Key}
		}
		[]Event{QueueRemoved{Key: c.Key}}
	case AskQuestion as c:
		try requireText("prompt", c.Prompt)
		try requireText("assumption", c.Assumption)
		try requireText("concreteAction", c.ConcreteAction)
		let id = match c.ID {
		case option.Some[int] as explicit:
			if explicit.Value < state.NextQuestionID {
				return InvalidInput{Field: "id", Why: "must be monotonic (>= next question id)"}
			}
			explicit.Value
		case option.None:
			state.NextQuestionID
		}
		[]Event{QuestionAsked{
			CommandID: env.ID,
			Question:  Question{
				ID:             id,
				Prompt:         c.Prompt,
				Assumption:     c.Assumption,
				ConcreteAction: c.ConcreteAction,
				Status:         QuestionOpen,
				Answer:         option.None,
				AskedBy:        env.Actor,
				AskedAt:        env.At,
				AnsweredBy:     option.None,
				AnsweredAt:     option.None,
			},
		}}
	case AnswerQuestion as c:
		if c.ID < 1 {
			return InvalidInput{Field: "id", Why: "must be >= 1"}
		}
		let q = try existingQuestion(state, c.ID)
		let act QuestionAction = if c.Withdraw { ActWithdraw } else { ActAnswer }
		let actionName = if c.Withdraw { "withdraw" } else { "answer" }
		match StepQuestion(q.Status, act) {
		case machines.Enter[QuestionStatus]:
		case machines.Stay[QuestionStatus], machines.Ignore, machines.Reject:
			return InvalidTransition{Kind: "question", ID: strconv.Itoa(c.ID), From: QuestionStatusName(q.Status), Action: actionName}
		}
		if c.Withdraw {
			let note = if strings.TrimSpace(c.Answer) == "" { option.None } else { option.Some[string]{Value: c.Answer} }
			return []Event{QuestionWasWithdrawn{ID: c.ID, Answer: note, AnsweredBy: env.Actor, AnsweredAt: env.At}}
		}
		try requireText("answer", c.Answer)
		[]Event{QuestionWasAnswered{ID: c.ID, Answer: c.Answer, AnsweredBy: env.Actor, AnsweredAt: env.At}}
	case RecordDecision as c:
		try requireText("repo", c.Repo)
		try requireText("run", c.Run)
		try requireText("id", c.ID)
		try requireText("category", c.Category)
		try requireText("scope", c.Scope)
		try requireOptionalText("unitId", c.UnitID)
		try requireText("title", c.Title)
		try requireText("body", c.Body)
		try requireOptionalText("supersedes", c.Supersedes)
		try requireOptionalText("createdAt", c.CreatedAt)
		if c.Supersedes == (option.Some[string]{Value: c.ID}) {
			return InvalidInput{Field: "supersedes", Why: "cannot supersede self"}
		}
		let createdAt = match c.CreatedAt {
		case option.Some[string] as ts:
			ts.Value
		case option.None:
			env.At
		}
		[]Event{DecisionRecorded{
			Decision: Decision{
				ID:         c.ID,
				Repo:       c.Repo,
				Run:        c.Run,
				Category:   c.Category,
				Scope:      c.Scope,
				UnitID:     c.UnitID,
				Title:      c.Title,
				Body:       c.Body,
				Status:     c.Status,
				Supersedes: c.Supersedes,
				Actor:      env.Actor,
				CreatedAt:  createdAt,
			},
		}}
	case RecordLanding as c:
		try requireText("repo", c.Repo)
		try requireText("run", c.Run)
		if c.LandingNumber < 1 {
			return InvalidInput{Field: "landingNumber", Why: "must be >= 1"}
		}
		try requireText("groupId", c.GroupID)
		try requireText("head", c.Head)
		for tip in c.Tips {
			try requireText("tips", tip)
		}
		try requireText("summary", c.Summary)
		try requireOptionalText("logPath", c.LogPath)
		try requireOptionalText("landedAt", c.LandedAt)
		let landedAt = match c.LandedAt {
		case option.Some[string] as ts:
			ts.Value
		case option.None:
			env.At
		}
		[]Event{LandingRecorded{
			Landing: Landing{
				Repo:          c.Repo,
				Run:           c.Run,
				LandingNumber: c.LandingNumber,
				GroupID:       c.GroupID,
				Head:          c.Head,
				Tips:          slices.Clone(c.Tips),
				Summary:       c.Summary,
				LogPath:       c.LogPath,
				LandedAt:      landedAt,
			},
		}}
	case RecordLedgerEvent as c:
		try requireText("repo", c.Repo)
		try requireText("run", c.Run)
		try requireText("kind", c.Kind)
		try requireOptionalText("unitId", c.UnitID)
		try requireText("summary", c.Summary)
		try requireOptionalText("sourceKey", c.SourceKey)
		try requireOptionalText("createdAt", c.CreatedAt)
		match c.SourceKey {
		case option.Some[string] as sk:
			if state.EventLogSourceKeys.Get(EventSourceKey{Repo: c.Repo, Run: c.Run, SourceKey: sk.Value}) != option.None {
				return AlreadyExists{Kind: "event", ID: sk.Value}
			}
		case option.None:
		}
		let createdAt = match c.CreatedAt {
		case option.Some[string] as ts:
			ts.Value
		case option.None:
			env.At
		}
		[]Event{LedgerEventAppended{
			Event: LedgerEvent{
				ID:        state.NextEventID,
				Repo:      c.Repo,
				Run:       c.Run,
				Kind:      c.Kind,
				UnitID:    c.UnitID,
				Summary:   c.Summary,
				Actor:     env.Actor,
				CreatedAt: createdAt,
				SourceKey: c.SourceKey,
			},
		}}
	case IngestPlan as c:
		try requireText("repo", c.Repo)
		try requireText("run", c.Run)
		try requireText("text", c.Text)
		let parsed = ParsePlanLines(c.Repo, c.Run, env.Actor, env.At, c.Text)
		let mut out = []Event{}
		match parsed.MainHead {
		case option.Some[string] as h:
			if RunHead(state, c.Repo, c.Run) == option.None {
				out = out.Append(RunHeadUpdated{Repo: c.Repo, Run: c.Run, Head: h.Value, UpdatedAt: env.At})
			}
		case option.None:
		}
		for d in parsed.Decisions {
			out = out.Append(DecisionRecorded{Decision: d})
		}
		for l in parsed.Landings {
			out = out.Append(LandingRecorded{Landing: l})
		}
		let mut nextID = state.NextEventID
		let mut seenKeys = Map[string, bool]{}
		for ev in parsed.Events {
			match ev.SourceKey {
			case option.Some[string] as sk:
				let alreadyInState = state.EventLogSourceKeys.Get(EventSourceKey{Repo: c.Repo, Run: c.Run, SourceKey: sk.Value}) != option.None
				if !alreadyInState && seenKeys.Get(sk.Value) == option.None {
					seenKeys = seenKeys.Put(sk.Value, true)
					out = out.Append(LedgerEventAppended{Event: LedgerEvent{..ev, ID: nextID}})
					nextID = nextID + 1
				}
			case option.None:
				out = out.Append(LedgerEventAppended{Event: LedgerEvent{..ev, ID: nextID}})
				nextID = nextID + 1
			}
		}
		out
	}
}

func requireText(field string, value string) fails InvalidInput {
	if strings.TrimSpace(value) == "" {
		return InvalidInput{Field: field, Why: "must not be empty"}
	}
}

func requireOptionalText(field string, value option.Option[string]) fails InvalidInput {
	match value {
	case option.Some[string] as s:
		try requireText(field, s.Value)
	case option.None:
	}
}

func requireKey(k UnitKey) fails InvalidInput {
	try requireText("repo", k.Repo)
	try requireText("run", k.Run)
	try requireText("id", k.ID)
}

func requireKinds(kinds []string) fails InvalidInput {
	if kinds.Len() == 0 {
		return InvalidInput{Field: "requires", Why: "a unit requires at least one receipt kind"}
	}
	for i, kind in kinds {
		try requireText("requires", kind)
		if slices.Contains(kinds[0:i], kind) {
			return InvalidInput{Field: "requires", Why: "\(kind) is named twice"}
		}
	}
}

func requireGreen(state State, u Unit, head string) fails Refusal {
	let check = CheckReceipts(state, u, head)
	if !Green(check) {
		return Unverified{Unit: u.Key, Head: head, Missing: check.Missing, Red: check.Red}
	}
}

func existingUnit(state State, key UnitKey) Unit fails Refusal {
	match state.Units.Get(key) {
	case option.Some[Unit] as u:
		u.Value
	case option.None:
		NotFound{Kind: "unit", ID: UnitKeyText(key)}
	}
}

func requireUnitAction(u Unit, action UnitAction) fails Refusal {
	match StepUnit(u.Status, action) {
	case machines.Enter[UnitStatus], machines.Stay[UnitStatus]:
	case machines.Ignore, machines.Reject:
		InvalidTransition{Kind: "unit", ID: UnitKeyText(u.Key), From: UnitStatusName(u.Status), Action: UnitActionName(action)}
	}
}

func existingCommitment(state State, id string) Commitment fails Refusal {
	match state.Commitments.Get(id) {
	case option.Some[Commitment] as c:
		c.Value
	case option.None:
		NotFound{Kind: "commitment", ID: id}
	}
}

func requireCommitmentMutable(c Commitment, action string) fails Refusal {
	match c.Status {
	case CommitOpen, CommitAssigned:
	case CommitLanded, CommitDecided, CommitWithdrawn:
		InvalidTransition{Kind: "commitment", ID: c.ID, From: CommitmentStatusName(c.Status), Action: action}
	}
}

func existingQuestion(state State, id int) Question fails Refusal {
	match state.Questions.Get(id) {
	case option.Some[Question] as q:
		q.Value
	case option.None:
		NotFound{Kind: "question", ID: strconv.Itoa(id)}
	}
}

// Scope is the part of state Decide reads for env: the command's own record, the unit, commitment, queue item or question it names, a verdict's receipts at its head, event source keys, and the monotonic counters. A store loads only this before Decide.
func Scope(state State, env Envelope) State {
	let mut out = State{..EmptyState(), NextQuestionID: state.NextQuestionID, NextEventID: state.NextEventID}
	match state.Commands.Get(env.ID) {
	case option.Some[Command] as prev:
		out = State{..out, Commands: out.Commands.Put(env.ID, prev.Value)}
	case option.None:
	}
	match env.Command {
	case OpenUnit as c:
		let withUnit = scopeUnit(state, out, c.Key, option.None)
		match c.Lane {
		case option.Some[string] as lane:
			let mut units = withUnit.Units
			for k, u in state.Units {
				if holdsLane(u, c.Key.Repo, lane.Value) {
					units = units.Put(k, u)
				}
			}
			State{..withUnit, Units: units}
		case option.None:
			withUnit
		}
	case RecordReceipt as c:
		scopeUnit(state, out, c.Unit, option.None)
	case AcceptUnit as c:
		scopeUnit(state, out, c.Unit, option.Some[string]{Value: c.Head})
	case LandUnit as c:
		scopeRun(state, scopeUnit(state, out, c.Unit, option.Some[string]{Value: c.Head}), c.Unit.Repo, c.Unit.Run)
	case CloseUnit as c:
		scopeUnit(state, out, c.Unit, option.None)
	case TransferUnit as c:
		scopeUnit(state, out, c.Unit, option.None)
	case BeginLanding as c:
		scopeRun(state, out, c.Repo, c.Run)
	case EndLanding as c:
		scopeRun(state, out, c.Repo, c.Run)
	case AddCommitment as c:
		scopeCommitment(state, out, c.ID)
	case AssignCommitment as c:
		scopeCommitment(state, out, c.ID)
	case LandCommitment as c:
		scopeCommitment(state, out, c.ID)
	case DecideCommitment as c:
		scopeCommitment(state, out, c.ID)
	case UpsertQueueItem:
		out
	case RemoveQueueItem as c:
		match state.Queue.Get(c.Key) {
		case option.Some[QueueItem] as item:
			State{..out, Queue: out.Queue.Put(c.Key, item.Value)}
		case option.None:
			out
		}
	case AskQuestion:
		out
	case AnswerQuestion as c:
		match state.Questions.Get(c.ID) {
		case option.Some[Question] as q:
			State{..out, Questions: out.Questions.Put(c.ID, q.Value)}
		case option.None:
			out
		}
	case RecordDecision, RecordLanding:
		out
	case RecordLedgerEvent as c:
		match c.SourceKey {
		case option.Some[string] as sk:
			let key = EventSourceKey{Repo: c.Repo, Run: c.Run, SourceKey: sk.Value}
			match state.EventLogSourceKeys.Get(key) {
			case option.Some[int] as eid:
				State{..out, EventLogSourceKeys: out.EventLogSourceKeys.Put(key, eid.Value)}
			case option.None:
				out
			}
		case option.None:
			out
		}
	case IngestPlan as c:
		if strings.TrimSpace(c.Repo) == "" || strings.TrimSpace(c.Run) == "" || strings.TrimSpace(c.Text) == "" {
			return out
		}
		let parsed = ParsePlanLines(c.Repo, c.Run, env.Actor, env.At, c.Text)
		let mut keys = out.EventLogSourceKeys
		for ev in parsed.Events {
			match ev.SourceKey {
			case option.Some[string] as sk:
				let key = EventSourceKey{Repo: c.Repo, Run: c.Run, SourceKey: sk.Value}
				match state.EventLogSourceKeys.Get(key) {
				case option.Some[int] as eid:
					keys = keys.Put(key, eid.Value)
				case option.None:
				}
			case option.None:
			}
		}
		scopeRun(state, State{..out, EventLogSourceKeys: keys}, c.Repo, c.Run)
	}
}

func scopeRun(state State, out State, repo string, run string) State {
	let rk = RunKey{Repo: repo, Run: run}
	let mut metas = out.RunMetas
	let mut leases = out.Leases
	match state.RunMetas.Get(rk) {
	case option.Some[RunMeta] as m:
		metas = metas.Put(rk, m.Value)
	case option.None:
	}
	match state.Leases.Get(rk) {
	case option.Some[LandingLease] as l:
		leases = leases.Put(rk, l.Value)
	case option.None:
	}
	State{..out, RunMetas: metas, Leases: leases}
}

func holdsLane(u Unit, repo string, lane string) bool {
	u.Key.Repo == repo && u.Lane == option.Some[string]{Value: lane} && !UnitFinal(u.Status)
}

// LaneHolder is the live unit of repo (neither landed nor closed) that holds lane, the least by key text when legacy data holds more than one.
func LaneHolder(state State, repo string, lane string) option.Option[Unit] {
	let mut best option.Option[Unit] = option.None
	for _, u in state.Units {
		if holdsLane(u, repo, lane) {
			match best {
			case option.Some[Unit] as b:
				if UnitKeyText(u.Key) < UnitKeyText(b.Value.Key) {
					best = option.Some[Unit]{Value: u}
				}
			case option.None:
				best = option.Some[Unit]{Value: u}
			}
		}
	}
	best
}

// RunHead is the run's head, set by its first landing-begin (or plan import into an empty run) and moved only by landing-end.
func RunHead(state State, repo string, run string) option.Option[string] {
	match state.RunMetas.Get(RunKey{Repo: repo, Run: run}) {
	case option.Some[RunMeta] as m:
		m.Value.MainHead
	case option.None:
		option.None
	}
}

func requireOwner(u Unit, actor string) fails Refusal {
	if u.Owner != actor {
		return NotOwner{Unit: u.Key, Owner: u.Owner, Actor: actor}
	}
}

func unixAt(at string) int64 fails InvalidInput {
	let t = time.Parse(time.RFC3339, at) catch {
	case _:
		return InvalidInput{Field: "at", Why: "must be an RFC 3339 time"}
	}
	time.UnixSeconds(t)
}

// LeaseLive reports whether the lease is still live at the unix second now.
func LeaseLive(l LandingLease, now int64) bool {
	let until = time.Parse(time.RFC3339, l.Until) catch {
	case _:
		return false
	}
	now < time.UnixSeconds(until)
}

func heldLease(state State, repo string, run string, actor string, now int64) LandingLease fails Refusal {
	match state.Leases.Get(RunKey{Repo: repo, Run: run}) {
	case option.Some[LandingLease] as l:
		let live = LeaseLive(l.Value, now)
		if l.Value.Actor != actor && live {
			return LandingBusy{Actor: l.Value.Actor, Since: l.Value.Since}
		}
		if l.Value.Actor != actor || !live {
			return NoLease{Repo: repo, Run: run, Actor: actor}
		}
		l.Value
	case option.None:
		NoLease{Repo: repo, Run: run, Actor: actor}
	}
}

func scopeUnit(state State, out State, key UnitKey, head option.Option[string]) State {
	match state.Units.Get(key) {
	case option.Some[Unit] as u:
		let withUnit = State{..out, Units: out.Units.Put(key, u.Value)}
		match head {
		case option.Some[string] as h:
			let mut receipts = withUnit.Receipts
			let mut order = withUnit.ReceiptOrder
			for r in ReceiptsOf(state, key) {
				if r.Head == h.Value {
					receipts = receipts.Put(r.ID, r)
					order = order.Append(r.ID)
				}
			}
			State{..withUnit, Receipts: receipts, ReceiptOrder: order}
		case option.None:
			withUnit
		}
	case option.None:
		out
	}
}

func scopeCommitment(state State, out State, id string) State {
	match state.Commitments.Get(id) {
	case option.Some[Commitment] as c:
		State{..out, Commitments: out.Commitments.Put(id, c.Value)}
	case option.None:
		out
	}
}

type decided = decidedEvents{Events []Event} | decidedRefused{Refusal Refusal}

func decideOutcome(state State, env Envelope) decided {
	let evs = Decide(state, env) catch {
	case NotFound as e:
		return decidedRefused{Refusal: e}
	case AlreadyExists as e:
		return decidedRefused{Refusal: e}
	case InvalidTransition as e:
		return decidedRefused{Refusal: e}
	case CommandReused as e:
		return decidedRefused{Refusal: e}
	case InvalidInput as e:
		return decidedRefused{Refusal: e}
	case Unverified as e:
		return decidedRefused{Refusal: e}
	case NotAcceptedHead as e:
		return decidedRefused{Refusal: e}
	case LaneHeld as e:
		return decidedRefused{Refusal: e}
	case NotOwner as e:
		return decidedRefused{Refusal: e}
	case LandingBusy as e:
		return decidedRefused{Refusal: e}
	case StaleHead as e:
		return decidedRefused{Refusal: e}
	case NoLease as e:
		return decidedRefused{Refusal: e}
	}
	decidedEvents{Events: evs}
}

// DecideReadsOnlyItsScope verifies that Decide over Scope(state, env) decides every generated command as Decide over the whole state does, so a store may load only the scope.
law DecideReadsOnlyItsScope(steps []int) {
	let mut state = scopePrelude()
	for i, code in steps {
		let env = generatedEnvelope(i, code)
		let whole = decideOutcome(state, env)
		if decideOutcome(Scope(state, env), env) != whole {
			return false
		}
		match whole {
		case decidedEvents as d:
			state = ApplyAll(state, d.Events)
		case decidedRefused:
		}
		let replay = decideOutcome(Scope(state, env), env)
		if replay != decideOutcome(state, env) {
			return false
		}
	}
	true
}

func scopePrelude() State {
	let mut state = EmptyState()
	for slot in 0..3 {
		let key = UnitKey{Repo: "repo", Run: "run-\(slot % 2)", ID: "u-\(slot)"}
		state = lawStep(state, "prelude-open-\(slot)", OpenUnit{Key: key, Title: "Unit \(slot)", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None}) catch {
		case _:
			state
		}
		state = lawStep(state, "prelude-green-\(slot)", RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: "head-\(slot % 2)", ExitCode: 0, ExitLines: "ok"}) catch {
		case _:
			state
		}
	}
	state
}

func lawStep(state State, id string, cmd Command) State fails Refusal {
	ApplyAll(state, try Decide(state, Envelope{ID: CommandID(id), Actor: "law", At: "2026-11-26T00:00:00Z", Command: cmd}))
}

// AcceptNeedsGreenReceiptsAtHead verifies that a unit is accepted at a head exactly when every kind it requires has a receipt of its own at that head whose latest run exited 0, and is otherwise refused as Unverified naming the missing and red kinds.
law AcceptNeedsGreenReceiptsAtHead(tag int, exitsA []int, exitB int, sameHead bool) {
	let key = UnitKey{Repo: "repo", Run: "law", ID: "v-\(tag)"}
	let otherUnit = UnitKey{Repo: "repo", Run: "other", ID: "v-\(tag)"}
	let head = "h1"
	let gateHead = if sameHead { head } else { "h2" }
	let gateExit = ((exitB % 2) + 2) % 2
	let mut s = lawStep(EmptyState(), "open", OpenUnit{Key: key, Title: "Verdict", Requires: []string{"acceptance", "gate"}, Lane: option.None, Branch: option.None}) catch {
	case _:
		return false
	}
	s = lawStep(s, "open-other", OpenUnit{Key: otherUnit, Title: "Other", Requires: []string{"gate"}, Lane: option.None, Branch: option.None}) catch {
	case _:
		return false
	}
	s = lawStep(s, "other-gate", RecordReceipt{Unit: otherUnit, Kind: "gate", Command: "go test", Head: head, ExitCode: 0, ExitLines: "ok"}) catch {
	case _:
		return false
	}
	let mut lastA = -1
	for i, code in exitsA {
		let exit = ((code % 3) + 3) % 3
		lastA = exit
		s = lawStep(s, "a-\(i)", RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: head, ExitCode: exit, ExitLines: "exit \(exit)"}) catch {
		case _:
			return false
		}
	}
	s = lawStep(s, "gate", RecordReceipt{Unit: key, Kind: "gate", Command: "go vet", Head: gateHead, ExitCode: gateExit, ExitLines: "exit \(gateExit)"}) catch {
	case _:
		return false
	}
	let mut missing = []string{}
	let mut red = []string{}
	if lastA < 0 {
		missing = missing.Append("acceptance")
	} else if lastA != 0 {
		red = red.Append("acceptance")
	}
	if !sameHead {
		missing = missing.Append("gate")
	} else if gateExit != 0 {
		red = red.Append("gate")
	}
	let want = if missing.Len() == 0 && red.Len() == 0 {
		decidedEvents{Events: []Event{
			CommandAccepted{ID: CommandID("accept"), Actor: "law", At: "2026-11-26T00:00:00Z", Command: AcceptUnit{Unit: key, Head: head}},
			UnitWasAccepted{Unit: key, Head: head, At: "2026-11-26T00:00:00Z"},
		}}
	} else {
		decidedRefused{Refusal: Unverified{Unit: key, Head: head, Missing: missing, Red: red}}
	}
	decideOutcome(s, Envelope{ID: CommandID("accept"), Actor: "law", At: "2026-11-26T00:00:00Z", Command: AcceptUnit{Unit: key, Head: head}}) == want
}

// LandNeedsTheAcceptedHead verifies that only an accepted unit lands, only at the head it was accepted at, and only while its receipts there are still green; a landed unit takes no further verdict.
law LandNeedsTheAcceptedHead(tag int, landSame bool, laterRed bool) {
	let key = UnitKey{Repo: "repo", Run: "law", ID: "l-\(tag)"}
	let mut s = lawStep(EmptyState(), "open", OpenUnit{Key: key, Title: "Land", Requires: []string{"acceptance"}, Lane: option.Some[string]{Value: "/lanes/l"}, Branch: option.Some[string]{Value: "l"}}) catch {
	case _:
		return false
	}
	for h in []string{"h1", "h2"} {
		s = lawStep(s, "green-\(h)", RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: h, ExitCode: 0, ExitLines: "ok"}) catch {
		case _:
			return false
		}
	}
	let early = decideOutcome(s, Envelope{ID: CommandID("early"), Actor: "law", At: "2026-11-26T00:00:00Z", Command: LandUnit{Unit: key, Head: "h1"}})
	if early != (decidedRefused{Refusal: InvalidTransition{Kind: "unit", ID: UnitKeyText(key), From: "open", Action: "land"}}) {
		return false
	}
	s = lawStep(s, "accept", AcceptUnit{Unit: key, Head: "h1"}) catch {
	case _:
		return false
	}
	s = lawStep(s, "lease", BeginLanding{Repo: "repo", Run: "law", ExpectedHead: "main", LifetimeSeconds: 600}) catch {
	case _:
		return false
	}
	if laterRed {
		s = lawStep(s, "red", RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: "h1", ExitCode: 1, ExitLines: "FAIL"}) catch {
		case _:
			return false
		}
	}
	let head = if landSame { "h1" } else { "h2" }
	let landed = decideOutcome(s, Envelope{ID: CommandID("land"), Actor: "law", At: "2026-11-26T00:00:00Z", Command: LandUnit{Unit: key, Head: head}})
	if !landSame {
		return landed == decidedRefused{Refusal: NotAcceptedHead{Unit: key, Accepted: "h1", Head: "h2"}}
	}
	if laterRed {
		return landed == decidedRefused{Refusal: Unverified{Unit: key, Head: "h1", Missing: []string{}, Red: []string{"acceptance"}}}
	}
	match landed {
	case decidedEvents as d:
		let after = ApplyAll(s, d.Events)
		let again = decideOutcome(after, Envelope{ID: CommandID("accept-again"), Actor: "law", At: "2026-11-26T00:00:00Z", Command: AcceptUnit{Unit: key, Head: "h1"}})
		let unitLanded = match UnitByKey(after, key) {
		case option.Some[Unit] as u:
			u.Value.Status == UnitLanded && u.Value.Head == option.Some[string]{Value: "h1"} && u.Value.Lane == option.Some[string]{Value: "/lanes/l"}
		case option.None:
			false
		}
		unitLanded && again == decidedRefused{Refusal: InvalidTransition{Kind: "unit", ID: UnitKeyText(key), From: "landed", Action: "accept"}}
	case decidedRefused:
		false
	}
}

// IdempotentCommandID verifies that replaying an accepted CommandID with the same payload emits no events and leaves state unchanged, while reusing it with a different payload fails CommandReused.
law IdempotentCommandID(idSuffix int, title string) {
	let cmdID = CommandID("idem-\(idSuffix)")
	let key = UnitKey{Repo: "repo", Run: "run", ID: "unit-\(idSuffix)"}
	let safeTitle = if strings.TrimSpace(title) == "" { "default-title" } else { title }
	let firstEnv = Envelope{
		ID:      cmdID,
		Actor:   "worker-1",
		At:      "2026-11-24T10:00:00Z",
		Command: OpenUnit{Key: key, Title: safeTitle, Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None},
	}
	let firstEvents = Decide(EmptyState(), firstEnv) catch {
	case _:
		return false
	}
	let afterFirst = ApplyAll(EmptyState(), firstEvents)
	let replayEvents = Decide(afterFirst, firstEnv) catch {
	case _:
		return false
	}
	let afterReplay = ApplyAll(afterFirst, replayEvents)
	let conflictingEnv = Envelope{
		ID:      cmdID,
		Actor:   "worker-1",
		At:      "2026-11-24T10:01:00Z",
		Command: OpenUnit{Key: key, Title: safeTitle + "-mutated", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None},
	}
	let reused = decideOutcome(afterFirst, conflictingEnv) == decidedRefused{Refusal: CommandReused{ID: cmdID}}
	firstEvents.Len() > 0 && replayEvents.Len() == 0 && afterReplay == afterFirst && reused
}

// UnitKeysAreTriples verifies that two runs of one repository may open units of the same name, which stay two units, while reopening the same triple fails AlreadyExists.
law UnitKeysAreTriples(tag int) {
	let a = UnitKey{Repo: "repo", Run: "wf10", ID: "U-\(tag)"}
	let b = UnitKey{Repo: "repo", Run: "wf11", ID: "U-\(tag)"}
	let mut s = lawStep(EmptyState(), "a", OpenUnit{Key: a, Title: "A", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None}) catch {
	case _:
		return false
	}
	s = lawStep(s, "b", OpenUnit{Key: b, Title: "B", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None}) catch {
	case _:
		return false
	}
	s = lawStep(s, "ra", RecordReceipt{Unit: a, Kind: "acceptance", Command: "ergo test", Head: "h", ExitCode: 0, ExitLines: "ok"}) catch {
	case _:
		return false
	}
	let again = decideOutcome(s, Envelope{ID: CommandID("a2"), Actor: "law", At: "2026-11-26T00:00:00Z", Command: OpenUnit{Key: a, Title: "A", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None}})
	let bAccept = decideOutcome(s, Envelope{ID: CommandID("acc-b"), Actor: "law", At: "2026-11-26T00:00:00Z", Command: AcceptUnit{Unit: b, Head: "h"}})
	ReceiptsOf(s, a).Len() == 1 && ReceiptsOf(s, b).Len() == 0 && again == decidedRefused{Refusal: AlreadyExists{Kind: "unit", ID: UnitKeyText(a)}} && bAccept == decidedRefused{Refusal: Unverified{Unit: b, Head: "h", Missing: []string{"acceptance"}, Red: []string{}}}
}

// ReceiptRecordedReadable verifies that a recorded receipt is readable by its unit with its command, head, exit code and exit lines intact, under its command id.
law ReceiptRecordedReadable(tag int, exitCode int) {
	let key = UnitKey{Repo: "repo", Run: "run", ID: "ru-\(tag)"}
	let s1 = lawStep(EmptyState(), "open", OpenUnit{Key: key, Title: "Verify", Requires: []string{"gate"}, Lane: option.None, Branch: option.None}) catch {
	case _:
		return false
	}
	let s2 = lawStep(s1, "rec-\(tag)", RecordReceipt{Unit: key, Kind: "gate", Command: "ergo test ./...", Head: "deadbeef", ExitCode: exitCode, ExitLines: "pass=12"}) catch {
	case _:
		return false
	}
	let got = ReceiptsOf(s2, key)
	let want = Receipt{ID: "rec-\(tag)", Unit: key, Kind: "gate", Command: "ergo test ./...", Head: "deadbeef", ExitCode: exitCode, ExitLines: "pass=12", RecordedAt: "2026-11-26T00:00:00Z", RecordedBy: "law"}
	got == []Receipt{want}
}

// CommitmentLandedMonotone verifies that once a commitment lands, neither assign, land, nor decide can mutate its landed status or SHA.
law CommitmentLandedMonotone(tag int) {
	let cid = "cm-\(tag)"
	let mut s = lawStep(EmptyState(), "ca", AddCommitment{ID: cid, Title: "Ship ORCH-2", Kind: "plan-part"}) catch {
	case _:
		return false
	}
	s = lawStep(s, "cas", AssignCommitment{ID: cid, Owner: "worker", Lane: "orch-domain"}) catch {
	case _:
		return false
	}
	s = lawStep(s, "cl", LandCommitment{ID: cid, LandedSHA: "11112222"}) catch {
	case _:
		return false
	}
	let from = InvalidTransition{Kind: "commitment", ID: cid, From: "landed", Action: ""}
	let assign = decideOutcome(s, Envelope{ID: CommandID("ca2"), Actor: "root", At: "2026-11-24T03:03:00Z", Command: AssignCommitment{ID: cid, Owner: "other", Lane: "lane-2"}})
	let decide = decideOutcome(s, Envelope{ID: CommandID("cd"), Actor: "root", At: "2026-11-24T03:04:00Z", Command: DecideCommitment{ID: cid, Note: "undo", Withdraw: false}})
	let reland = decideOutcome(s, Envelope{ID: CommandID("cl2"), Actor: "root", At: "2026-11-24T03:05:00Z", Command: LandCommitment{ID: cid, LandedSHA: "99998888"}})
	let kept = match CommitmentByID(s, cid) {
	case option.Some[Commitment] as c:
		c.Value.Status == CommitLanded && c.Value.LandedSHA == option.Some[string]{Value: "11112222"}
	case option.None:
		false
	}
	assign == decidedRefused{Refusal: InvalidTransition{..from, Action: "assign"}} && decide == decidedRefused{Refusal: InvalidTransition{..from, Action: "decide"}} && reland == decidedRefused{Refusal: InvalidTransition{..from, Action: "land"}} && kept
}

// QueueUpsertRemoveRoundTrip verifies that upserting a queue item makes it listable with exact fields and removing it deletes it cleanly.
law QueueUpsertRemoveRoundTrip(tag int, priority int) {
	let key = "qk-\(tag)"
	let s1 = lawStep(EmptyState(), "qu", UpsertQueueItem{Key: key, Priority: priority, Title: "Item \(tag)", Body: "details", Status: "open", Tags: []string{"orch", "v1"}}) catch {
	case _:
		return false
	}
	let listed1 = ListQueue(s1, option.Some[string]{Value: "open"})
	let s2 = lawStep(s1, "qr", RemoveQueueItem{Key: key}) catch {
	case _:
		return false
	}
	let listed2 = ListQueue(s2, option.None)
	let second = decideOutcome(s2, Envelope{ID: CommandID("qr2"), Actor: "root", At: "2026-11-24T04:02:00Z", Command: RemoveQueueItem{Key: key}})
	listed1.Len() == 1 && listed1[0].Key == key && listed1[0].Priority == priority && listed2.Len() == 0 && second == decidedRefused{Refusal: NotFound{Kind: "queue", ID: key}}
}

// QuestionAnsweredOnce verifies that questions receive monotonic IDs and can be answered or withdrawn at most once.
law QuestionAnsweredOnce(tag int, withdraw bool) {
	let mut s = lawStep(EmptyState(), "qa1-\(tag)", AskQuestion{ID: option.None, Prompt: "Ship now?", Assumption: "wait for gate", ConcreteAction: "reply yes or no"}) catch {
	case _:
		return false
	}
	s = lawStep(s, "qa2-\(tag)", AskQuestion{ID: option.None, Prompt: "Second?", Assumption: "default", ConcreteAction: "reply"}) catch {
	case _:
		return false
	}
	s = lawStep(s, "qans-\(tag)", AnswerQuestion{ID: 1, Answer: "yes, ship", Withdraw: withdraw}) catch {
	case _:
		return false
	}
	let from = if withdraw { "withdrawn" } else { "answered" }
	let second = decideOutcome(s, Envelope{ID: CommandID("qans2-\(tag)"), Actor: "owner", At: "2026-11-24T05:03:00Z", Command: AnswerQuestion{ID: 1, Answer: "changed mind", Withdraw: false}})
	let expectedStatus QuestionStatus = if withdraw { QuestionWithdrawn } else { QuestionAnswered }
	let q1Ok = match QuestionByID(s, 1) {
	case option.Some[Question] as q:
		q.Value.Status == expectedStatus
	case option.None:
		false
	}
	let q2Ok = match QuestionByID(s, 2) {
	case option.Some[Question] as q:
		q.Value.Status == QuestionOpen
	case option.None:
		false
	}
	s.NextQuestionID == 3 && ListQuestions(s, true).Len() == 1 && q1Ok && q2Ok && second == decidedRefused{Refusal: InvalidTransition{Kind: "question", ID: "1", From: from, Action: "answer"}}
}

// DecisionSupersedesMarksTargetSuperseded verifies that recording a decision with Supersedes transitions the referenced earlier decision to DecisionSuperseded.
law DecisionSupersedesMarksTargetSuperseded(tag int) {
	let mut s = lawStep(EmptyState(), "d1-\(tag)", RecordDecision{
		Repo:       "repo",
		Run:        "run",
		ID:         "d-old",
		Category:   "ruling",
		Scope:      "run",
		UnitID:     option.None,
		Title:      "Old rule",
		Body:       "Original rule",
		Status:     DecisionOpen,
		Supersedes: option.None,
		CreatedAt:  option.None,
	}) catch {
	case _:
		return false
	}
	s = lawStep(s, "d2-\(tag)", RecordDecision{
		Repo:       "repo",
		Run:        "run",
		ID:         "d-new",
		Category:   "ruling",
		Scope:      "run",
		UnitID:     option.None,
		Title:      "New rule",
		Body:       "Updated rule",
		Status:     DecisionOpen,
		Supersedes: option.Some[string]{Value: "d-old"},
		CreatedAt:  option.None,
	}) catch {
	case _:
		return false
	}
	let oldOk = match DecisionByKey(s, DecisionKey{Repo: "repo", Run: "run", ID: "d-old"}) {
	case option.Some[Decision] as d:
		d.Value.Status == DecisionSuperseded
	case option.None:
		false
	}
	let newOk = match DecisionByKey(s, DecisionKey{Repo: "repo", Run: "run", ID: "d-new"}) {
	case option.Some[Decision] as d:
		d.Value.Status == DecisionOpen
	case option.None:
		false
	}
	let summary = QueryRunSummary(s, "repo", "run", 5)
	oldOk && newOk && summary.OpenDecisions == 1
}

// IngestPlanDeduplicatesEvents verifies that re-ingesting the same plan text under a new CommandID adds zero duplicate operational events.
law IngestPlanDeduplicatesEvents(tag int) {
	let plan = "- 2026-11-26T18:00:00Z RULED (Rule A): keep schema clean.\nMAIN MOVED 2026-11-26T18:10:00Z: main = aabbccdd (Landing 10, group g10). Tips: U-1 + U-2\n- 2026-11-26T18:11:00Z DISPATCHED (Worker) U-3: start\n"
	let s1 = lawStep(EmptyState(), "imp-1-\(tag)", IngestPlan{Repo: "repo", Run: "run", Text: plan}) catch {
	case _:
		return false
	}
	let s2 = lawStep(s1, "imp-2-\(tag)", IngestPlan{Repo: "repo", Run: "run", Text: plan}) catch {
	case _:
		return false
	}
		s1.EventLog.Len() == 3 &&
		s2.EventLog == s1.EventLog &&
		s2.NextEventID == s1.NextEventID &&
		s2.Decisions.Len() == 1 &&
		s2.Landings.Len() == 1 &&
		RunMetaOf(s2, "repo", "run") != option.None
}

func lawAt(offset int) string {
	time.Unix(int64(1795737600+offset), 0).Format(time.RFC3339)
}

func lawEnv(id string, actor string, offset int, cmd Command) Envelope {
	Envelope{ID: CommandID(id), Actor: actor, At: lawAt(offset), Command: cmd}
}

func lawApply(state State, env Envelope) State {
	match decideOutcome(state, env) {
	case decidedEvents as d:
		ApplyAll(state, d.Events)
	case decidedRefused:
		state
	}
}

func liveLaneHolders(state State) bool {
	for k, u in state.Units {
		for k2, u2 in state.Units {
			if k != k2 && u.Lane != option.None && holdsLane(u2, u.Key.Repo, lane(u)) && !UnitFinal(u.Status) {
				return false
			}
		}
	}
	true
}

func lane(u Unit) string {
	match u.Lane {
	case option.Some[string] as l:
		l.Value
	case option.None:
		""
	}
}

// LaneHeldAtMostOneLive verifies that over any sequence of opens, closes and landings by two actors at most one live unit holds a lane of a repository, and that an open on a held lane is refused LaneHeld naming the holder and its owner.
law LaneHeldAtMostOneLive(steps []int) {
	let mut s = EmptyState()
	for i, code in steps {
		let c = if code < 0 { -code } else { code }
		let actor = if c%2 == 0 { "a" } else { "b" }
		let laneName = "/lanes/\((c / 8) % 2)"
		let target = UnitKey{Repo: "repo", Run: "run", ID: "u-\((c / 16) % (i + 1))"}
		let owner = match s.Units.Get(target) {
		case option.Some[Unit] as u:
			u.Value.Owner
		case option.None:
			actor
		}
		match (c / 2) % 4 {
		case 0:
			let key = UnitKey{Repo: "repo", Run: "run", ID: "u-\(i)"}
			let env = lawEnv("open-\(i)", actor, i, OpenUnit{Key: key, Title: "U", Requires: []string{"acceptance"}, Lane: option.Some[string]{Value: laneName}, Branch: option.None})
			let got = decideOutcome(s, env)
			match LaneHolder(s, "repo", laneName) {
			case option.Some[Unit] as h:
				if got != (decidedRefused{Refusal: LaneHeld{Lane: laneName, Unit: h.Value.Key, Actor: h.Value.Owner}}) {
					return false
				}
			case option.None:
				match got {
				case decidedEvents:
				case decidedRefused:
					return false
				}
			}
			s = lawApply(s, env)
		case 1:
			s = lawApply(s, lawEnv("close-\(i)", owner, i, CloseUnit{Unit: target}))
		case 2:
			s = lawApply(s, lawEnv("rec-\(i)", owner, i, RecordReceipt{Unit: target, Kind: "acceptance", Command: "t", Head: "h", ExitCode: 0, ExitLines: "ok"}))
			s = lawApply(s, lawEnv("acc-\(i)", owner, i, AcceptUnit{Unit: target, Head: "h"}))
			let head = match RunHead(s, "repo", "run") {
			case option.Some[string] as h:
				h.Value
			case option.None:
				"h0"
			}
			s = lawApply(s, lawEnv("lb-\(i)", owner, i, BeginLanding{Repo: "repo", Run: "run", ExpectedHead: head, LifetimeSeconds: 60}))
			s = lawApply(s, lawEnv("land-\(i)", owner, i, LandUnit{Unit: target, Head: "h"}))
			s = lawApply(s, lawEnv("le-\(i)", owner, i, EndLanding{Repo: "repo", Run: "run", NewHead: head}))
		case _:
			s = lawApply(s, lawEnv("tr-\(i)", owner, i, TransferUnit{Unit: target, To: if actor == "a" { "b" } else { "a" }}))
		}
		if !liveLaneHolders(s) {
			return false
		}
	}
	true
}

func unitTarget(cmd Command) option.Option[UnitKey] {
	match cmd {
	case RecordReceipt as c:
		option.Some[UnitKey]{Value: c.Unit}
	case AcceptUnit as c:
		option.Some[UnitKey]{Value: c.Unit}
	case LandUnit as c:
		option.Some[UnitKey]{Value: c.Unit}
	case CloseUnit as c:
		option.Some[UnitKey]{Value: c.Unit}
	case TransferUnit as c:
		option.Some[UnitKey]{Value: c.Unit}
	case _:
		option.None
	}
}

// NoMutationByNonOwner verifies over generated command sequences by three actors that a receipt, accept, land, close or transfer by an actor that does not own the unit is refused NotOwner and changes no unit, while reads see every unit.
law NoMutationByNonOwner(steps []int) {
	let mut s = EmptyState()
	for i, code in steps {
		let c = if code < 0 { -code } else { code }
		let gen = generatedEnvelope(i, c)
		let env = Envelope{..gen, Actor: "actor-\((c / 66) % 3)"}
		let got = decideOutcome(s, env)
		match unitTarget(env.Command) {
		case option.Some[UnitKey] as k:
			match s.Units.Get(k.Value) {
			case option.Some[Unit] as u:
				if u.Value.Owner != env.Actor {
					if got != (decidedRefused{Refusal: NotOwner{Unit: k.Value, Owner: u.Value.Owner, Actor: env.Actor}}) {
						return false
					}
					if UnitByKey(s, k.Value) != (option.Some[Unit]{Value: u.Value}) {
						return false
					}
				}
			case option.None:
			}
		case option.None:
		}
		match got {
		case decidedEvents as d:
			s = ApplyAll(s, d.Events)
		case decidedRefused:
		}
	}
	true
}

func leaseStep(s State, actor string, view string, act int, step int, clock int, uA UnitKey, uB UnitKey) Envelope {
	let unit = if actor == "a" { uA } else { uB }
	match act {
	case 0:
		lawEnv("lb-\(step)", actor, clock, BeginLanding{Repo: "repo", Run: "run", ExpectedHead: view, LifetimeSeconds: 600})
	case 1:
		lawEnv("le-\(step)", actor, clock, EndLanding{Repo: "repo", Run: "run", NewHead: "h-\(step)-\(actor)"})
	case _:
		lawEnv("land-\(step)", actor, clock, LandUnit{Unit: unit, Head: "x"})
	}
}

func liveLeaseOf(s State, now int) option.Option[LandingLease] {
	match LeaseOf(s, "repo", "run") {
	case option.Some[LandingLease] as l:
		if LeaseLive(l.Value, int64(1795737600+now)) {
			return option.Some[LandingLease]{Value: l.Value}
		}
		option.None
	case option.None:
		option.None
	}
}

func hasTakeover(evs []Event) bool {
	for ev in evs {
		match ev {
		case LandingLeaseTakenOver:
			return true
		case _:
		}
	}
	false
}

func leasePrelude() State {
	let mut s = EmptyState()
	for actor in []string{"a", "b"} {
		let key = UnitKey{Repo: "repo", Run: "run", ID: "u-\(actor)"}
		s = lawApply(s, lawEnv("open-\(actor)", actor, 0, OpenUnit{Key: key, Title: "U", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None}))
		s = lawApply(s, lawEnv("rec-\(actor)", actor, 0, RecordReceipt{Unit: key, Kind: "acceptance", Command: "t", Head: "x", ExitCode: 0, ExitLines: "ok"}))
		s = lawApply(s, lawEnv("acc-\(actor)", actor, 0, AcceptUnit{Unit: key, Head: "x"}))
	}
	s
}

func leaseSequenceHolds(seq []int) bool {
	let uA = UnitKey{Repo: "repo", Run: "run", ID: "u-a"}
	let uB = UnitKey{Repo: "repo", Run: "run", ID: "u-b"}
	let mut s = leasePrelude()
	let mut viewA = "h0"
	let mut viewB = "h0"
	let mut clock = 1
	for step, sym in seq {
		if sym == 8 {
			clock = clock + 700
			continue
		}
		let actor = if sym%2 == 0 { "a" } else { "b" }
		let act = sym / 2
		if act == 3 {
			let seen = match RunHead(s, "repo", "run") {
			case option.Some[string] as h:
				h.Value
			case option.None:
				"h0"
			}
			if actor == "a" {
				viewA = seen
			} else {
				viewB = seen
			}
			continue
		}
		let view = if actor == "a" { viewA } else { viewB }
		let env = leaseStep(s, actor, view, act, step, clock, uA, uB)
		let before = RunHead(s, "repo", "run")
		let held = liveLeaseOf(s, clock)
		let recorded = LeaseOf(s, "repo", "run")
		let got = decideOutcome(s, env)
		let unitLive = match s.Units.Get(if actor == "a" { uA } else { uB }) {
		case option.Some[Unit] as u:
			u.Value.Status == UnitAccepted
		case option.None:
			false
		}
		match held {
		case option.Some[LandingLease] as h:
			if h.Value.Actor != actor && (act != 2 || unitLive) && got != (decidedRefused{Refusal: LandingBusy{Actor: h.Value.Actor, Since: h.Value.Since}}) {
				return false
			}
		case option.None:
		}
		let evs = match got {
		case decidedEvents as d:
			d.Events
		case decidedRefused:
			[]Event{}
		}
		let after = ApplyAll(s, evs)
		let moved = RunHead(after, "repo", "run")
		if moved != before {
			let firstHead = act == 0 && before == option.None && moved == option.Some[string]{Value: view}
			let byHolder = match held {
			case option.Some[LandingLease] as h:
				act == 1 && h.Value.Actor == actor && before == option.Some[string]{Value: h.Value.BaseHead}
			case option.None:
				false
			}
			if !firstHead && !byHolder {
				return false
			}
		}
		if act == 2 && evs.Len() > 0 {
			match held {
			case option.Some[LandingLease] as h:
				if h.Value.Actor != actor {
					return false
				}
			case option.None:
				return false
			}
		}
		if act == 0 && evs.Len() > 0 {
			match recorded {
			case option.Some[LandingLease] as r:
				if r.Value.Actor != actor && !hasTakeover(evs) {
					return false
				}
			case option.None:
			}
		}
		s = after
	}
	true
}

// LandingHeadMovesOnlyByLeaseHolder verifies, exhaustively over every interleaving of up to four steps of two actors (observe the head, begin a landing from the head last observed, end it, land an accepted unit, and a clock jump past the lease's lifetime), that the run head moves only by landing-end of the live lease's holder and only from the head the lease began at, that the one other move is the first landing-begin setting an empty run's head, that a landing step during another actor's live lease is LandingBusy, that a unit lands only inside its actor's live lease, and that taking over an expired lease is a recorded LandingLeaseTakenOver.
law LandingHeadMovesOnlyByLeaseHolder() {
	let alphabet = 9
	let mut total = 1
	for _ in 0..4 {
		total = total * alphabet
	}
	let mut count = 0
	for code in 0..total {
		let mut seq = []int{}
		let mut rest = code
		for _ in 0..4 {
			seq = seq.Append(rest % alphabet)
			rest = rest / alphabet
		}
		if !leaseSequenceHolds(seq) {
			return false
		}
		count = count + 1
	}
	count == total
}
