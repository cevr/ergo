import option

// StoredEvent is one persisted event in the global ordered log with its monotonic 1-based sequence number.
type StoredEvent { Seq int, Event Event }

// ExecuteResult is the outcome of one transactional command execution.
type ExecuteResult { Seq int, Events []Event, Duplicate bool }

// EventList extracts the raw Event sequence from a slice of StoredEvents.
func EventList(stored []StoredEvent) []Event {
	let mut out = []Event{}
	for item in stored {
		out = out.Append(item.Event)
	}
	out
}

// Store is the transactional persistence contract shared by memory and SQLite providers.
// Execute must run Decide over the command's Scope, append events, and update all projections atomically in one transaction.
type Store {
	// Execute validates and persists one Envelope atomically with all projections.
	Execute(env Envelope) ExecuteResult fails NotFound | AlreadyExists | InvalidTransition | CommandReused | InvalidInput | Unverified | NotAcceptedHead | LaneHeld | NotOwner | LandingBusy | StaleHead | NoLease | StoreFailed,

	// Snapshot returns the complete projected State read from projection storage.
	Snapshot() State fails StoreFailed,

	// Events returns all persisted events with Seq strictly greater than fromSeq in ascending Seq order.
	Events(fromSeq int) []StoredEvent fails StoreFailed,

	// Unit looks up one unit projection by key.
	Unit(key UnitKey) option.Option[Unit] fails StoreFailed,

	// Receipts returns the receipt projections of the unit key in recorded order.
	Receipts(key UnitKey) []Receipt fails StoreFailed,

	// Commitment looks up one commitment projection by ID.
	Commitment(id string) option.Option[Commitment] fails StoreFailed,

	// ListCommitments returns commitment projections optionally filtered by status and owner, sorted by ID.
	ListCommitments(status option.Option[CommitmentStatus], owner option.Option[string]) []Commitment fails StoreFailed,

	// ListQueue returns queue projections optionally filtered by status, ordered by priority then key.
	ListQueue(status option.Option[string]) []QueueItem fails StoreFailed,

	// Question looks up one async question projection by monotonic ID.
	Question(id int) option.Option[Question] fails StoreFailed,

	// ListQuestions returns question projections (all or open-only), sorted by ascending ID.
	ListQuestions(openOnly bool) []Question fails StoreFailed,

	// RunMeta looks up run-level metadata for (repo, run).
	RunMeta(repo string, run string) option.Option[RunMeta] fails StoreFailed,

	// RunSummary returns a compact progressive-disclosure overview for (repo, run).
	RunSummary(repo string, run string, landingsLimit int) RunOverview fails StoreFailed,

	// ListUnits returns filtered and paginated compact unit summaries without receipt blobs.
	ListUnits(filter UnitFilter) UnitPage fails StoreFailed,

	// Decision looks up one structured decision projection by (repo, run, id).
	Decision(repo string, run string, id string) option.Option[Decision] fails StoreFailed,

	// ListDecisions returns filtered and paginated decision records.
	ListDecisions(filter DecisionFilter) DecisionPage fails StoreFailed,

	// Landing looks up one integration landing record by (repo, run, landingNumber).
	Landing(repo string, run string, landingNumber int) option.Option[Landing] fails StoreFailed,

	// ListLandings returns filtered and paginated integration landing records.
	ListLandings(filter LandingFilter) LandingPage fails StoreFailed,

	// ListEventLog returns filtered, ordered, and paginated operational ledger events.
	ListEventLog(filter EventLogFilter) EventPage fails StoreFailed,

	// ListEventLogSince returns operational ledger events with ID strictly greater than filter.SinceID in ascending order.
	ListEventLogSince(filter EventLogSinceFilter) EventPage fails StoreFailed,

	// StoreReplayMatchesSnapshot verifies that folding all persisted events reproduces Snapshot identically and sequence numbers are dense 1..N.
	law StoreReplayMatchesSnapshot(steps []int) {
		for i, code in steps {
			let env = generatedEnvelope(i, code)
			let _ = Execute(env) catch {
			case StoreFailed:
				return true
			case _:
				ExecuteResult{Seq: 0, Events: []Event{}, Duplicate: false}
			}
		}
		let stored = Events(0) catch {
		case StoreFailed:
			return true
		}
		let snap = Snapshot() catch {
		case StoreFailed:
			return true
		}
		denseStoredEvents(stored) && Fold(EventList(stored)) == snap
	},

	// StoreIdempotentExecute verifies that resending an accepted Envelope is a duplicate no-op while reusing its CommandID with a different payload fails CommandReused.
	law StoreIdempotentExecute(tag int) {
		let cid = CommandID("store-idem-\(tag)")
		let key = UnitKey{Repo: "repo", Run: "store", ID: "store-u-\(tag)"}
		let env = Envelope{
			ID:      cid,
			Actor:   "worker",
			At:      "2026-11-24T08:00:00Z",
			Command: OpenUnit{Key: key, Title: "Title", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None},
		}
		let first = Execute(env) catch {
		case StoreFailed:
			return true
		case _:
			return false
		}
		let snap1 = Snapshot() catch {
		case StoreFailed:
			return true
		}
		let evs1 = Events(0) catch {
		case StoreFailed:
			return true
		}
		let second = Execute(env) catch {
		case StoreFailed:
			return true
		case _:
			return false
		}
		let snap2 = Snapshot() catch {
		case StoreFailed:
			return true
		}
		let evs2 = Events(0) catch {
		case StoreFailed:
			return true
		}
		let mut reused = false
		let _ = Execute(Envelope{
			ID:      cid,
			Actor:   "worker",
			At:      "2026-11-24T08:01:00Z",
			Command: OpenUnit{Key: key, Title: "Different", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None},
		}) catch {
		case CommandReused:
			reused = true
			ExecuteResult{Seq: 0, Events: []Event{}, Duplicate: false}
		case StoreFailed:
			return true
		case _:
			return false
		}
		let snap3 = Snapshot() catch {
		case StoreFailed:
			return true
		}
		!first.Duplicate && first.Events.Len() > 0 && second.Duplicate && second.Events.Len() == 0 && second.Seq == first.Seq && snap1 == snap2 && evs1 == evs2 && reused && snap3 == snap1
	},

	// StoreRefusedLeavesStateUnchanged verifies that a refused command appends no events and leaves Snapshot unchanged.
	law StoreRefusedLeavesStateUnchanged(tag int) {
		let beforeSnap = Snapshot() catch {
		case StoreFailed:
			return true
		}
		let beforeEvents = Events(0) catch {
		case StoreFailed:
			return true
		}
		let mut refused = false
		let _ = Execute(Envelope{
			ID:      CommandID("store-refuse-\(tag)"),
			Actor:   "worker",
			At:      "2026-11-24T08:10:00Z",
			Command: AcceptUnit{Unit: UnitKey{Repo: "repo", Run: "store", ID: "missing-\(tag)"}, Head: "aaa"},
		}) catch {
		case NotFound:
			refused = true
			ExecuteResult{Seq: 0, Events: []Event{}, Duplicate: false}
		case StoreFailed:
			return true
		case _:
			return false
		}
		let afterSnap = Snapshot() catch {
		case StoreFailed:
			return true
		}
		let afterEvents = Events(0) catch {
		case StoreFailed:
			return true
		}
		refused && afterSnap == beforeSnap && afterEvents == beforeEvents
	},

	// StoreQueriesMatchSnapshot verifies that every indexed Store query agrees with the pure query functions over Snapshot.
	law StoreQueriesMatchSnapshot(tag int) {
		let key = UnitKey{Repo: "repo", Run: "store", ID: "sq-u-\(tag)"}
		let cid = "sq-c-\(tag)"
		let qkey = "sq-q-\(tag)"
		let cmds = []Envelope{
			Envelope{ID: CommandID("sq1-\(tag)"), Actor: "root", At: "2026-11-24T09:00:00Z", Command: OpenUnit{Key: key, Title: "Unit", Requires: []string{"test"}, Lane: option.Some[string]{Value: "/l"}, Branch: option.Some[string]{Value: "b"}}},
			Envelope{ID: CommandID("sq2-\(tag)"), Actor: "root", At: "2026-11-24T09:01:00Z", Command: RecordReceipt{Unit: key, Kind: "test", Command: "ergo test", Head: "abc", ExitCode: 0, ExitLines: "ok"}},
			Envelope{ID: CommandID("sq3-\(tag)"), Actor: "root", At: "2026-11-24T09:02:00Z", Command: AcceptUnit{Unit: key, Head: "abc"}},
			Envelope{ID: CommandID("sq4-\(tag)"), Actor: "root", At: "2026-11-24T09:03:00Z", Command: AddCommitment{ID: cid, Title: "Commit", Kind: "plan-part"}},
			Envelope{ID: CommandID("sq5-\(tag)"), Actor: "root", At: "2026-11-24T09:04:00Z", Command: AssignCommitment{ID: cid, Owner: "w1", Lane: "l1"}},
			Envelope{ID: CommandID("sq6-\(tag)"), Actor: "root", At: "2026-11-24T09:05:00Z", Command: UpsertQueueItem{Key: qkey, Priority: 2, Title: "Q", Body: "B", Status: "open", Tags: []string{"t"}}},
			Envelope{ID: CommandID("sq7-\(tag)"), Actor: "w1", At: "2026-11-24T09:06:00Z", Command: AskQuestion{ID: option.None, Prompt: "P?", Assumption: "A", ConcreteAction: "Do X"}},
			Envelope{ID: CommandID("sq8-\(tag)"), Actor: "root", At: "2026-11-24T09:07:00Z", Command: BeginLanding{Repo: "repo", Run: "store", ExpectedHead: "head-99", LifetimeSeconds: 600}},
			Envelope{ID: CommandID("sq9-\(tag)"), Actor: "owner", At: "2026-11-24T09:08:00Z", Command: RecordDecision{Repo: "repo", Run: "store", ID: "sq-d-\(tag)", Category: "ruling", Scope: "run", UnitID: option.Some[string]{Value: key.ID}, Title: "Rule", Body: "Body", Status: DecisionOpen, Supersedes: option.None, CreatedAt: option.None}},
			Envelope{ID: CommandID("sq10-\(tag)"), Actor: "root", At: "2026-11-24T09:09:00Z", Command: RecordLanding{Repo: "repo", Run: "store", LandingNumber: 1, GroupID: "grp-1", Head: "head-99", Tips: []string{key.ID}, Summary: "Landed", LogPath: option.None, LandedAt: option.None}},
			Envelope{ID: CommandID("sq11-\(tag)"), Actor: "w1", At: "2026-11-24T09:10:00Z", Command: RecordLedgerEvent{Repo: "repo", Run: "store", Kind: "hand-back", UnitID: option.Some[string]{Value: key.ID}, Summary: "Done", SourceKey: option.Some[string]{Value: "sk-\(tag)"}, CreatedAt: option.None}},
			Envelope{ID: CommandID("sq12-\(tag)"), Actor: "w1", At: "2026-11-24T09:11:00Z", Command: RecordLedgerEvent{Repo: "repo", Run: "store", Kind: "accepted", UnitID: option.Some[string]{Value: key.ID}, Summary: "Accepted", SourceKey: option.Some[string]{Value: "sk2-\(tag)"}, CreatedAt: option.None}},
		}
		for env in cmds {
			let _ = Execute(env) catch {
			case StoreFailed:
				return true
			case _:
				return false
			}
		}
		let snap = Snapshot() catch {
		case StoreFailed:
			return true
		}
		let u = Unit(key) catch {
		case StoreFailed:
			return true
		}
		let recs = Receipts(key) catch {
		case StoreFailed:
			return true
		}
		let cm = Commitment(cid) catch {
		case StoreFailed:
			return true
		}
		let cms = ListCommitments(option.Some[CommitmentStatus]{Value: CommitAssigned}, option.Some[string]{Value: "w1"}) catch {
		case StoreFailed:
			return true
		}
		let qs = ListQueue(option.Some[string]{Value: "open"}) catch {
		case StoreFailed:
			return true
		}
		let q1 = Question(1) catch {
		case StoreFailed:
			return true
		}
		let qlist = ListQuestions(true) catch {
		case StoreFailed:
			return true
		}
		let rm = RunMeta("repo", "store") catch {
		case StoreFailed:
			return true
		}
		let rsum = RunSummary("repo", "store", 5) catch {
		case StoreFailed:
			return true
		}
		let uf = UnitFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "store"}, Status: option.Some[UnitStatus]{Value: UnitAccepted}, Limit: 10, Offset: 0}
		let upage = ListUnits(uf) catch {
		case StoreFailed:
			return true
		}
		let dec = Decision("repo", "store", "sq-d-\(tag)") catch {
		case StoreFailed:
			return true
		}
		let df = DecisionFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "store"}, Category: option.None, Scope: option.None, UnitID: option.None, Status: option.Some[DecisionStatus]{Value: DecisionOpen}, Limit: 10, Offset: 0}
		let dpage = ListDecisions(df) catch {
		case StoreFailed:
			return true
		}
		let land = Landing("repo", "store", 1) catch {
		case StoreFailed:
			return true
		}
		let lf = LandingFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "store"}, Limit: 10, Offset: 0}
		let lpage = ListLandings(lf) catch {
		case StoreFailed:
			return true
		}
		let ef = EventLogFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "store"}, Kind: option.None, UnitID: option.None, Actor: option.None, Ascending: false, Limit: 10, Offset: 0}
		let epage = ListEventLog(ef) catch {
		case StoreFailed:
			return true
		}
		let esf0 = EventLogSinceFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "store"}, Kind: option.None, UnitID: option.None, Actor: option.None, SinceID: 0, Limit: 10}
		let espage0 = ListEventLogSince(esf0) catch {
		case StoreFailed:
			return true
		}
		let cursorID = if espage0.Items.Len() > 0 { espage0.Items[0].ID } else { 0 }
		let esf1 = EventLogSinceFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "store"}, Kind: option.None, UnitID: option.None, Actor: option.None, SinceID: cursorID, Limit: 10}
		let espage1 = ListEventLogSince(esf1) catch {
		case StoreFailed:
			return true
		}
			queriesMatchSnapshot(snap, key, cid, u, recs, cm, cms, qs, q1, qlist) &&
			ledgerQueriesMatchSnapshot(snap, "repo", "store", "sq-d-\(tag)", uf, df, lf, ef, rm, rsum, upage, dec, dpage, land, lpage, epage) &&
			espage0 == QueryEventLogSince(snap, esf0) &&
			espage1 == QueryEventLogSince(snap, esf1) &&
			espage0.Items.Len() >= 2 &&
			espage1.Items.Len() == espage0.Items.Len()-1 &&
			recs.Len() == 1
	},
}

func ledgerQueriesMatchSnapshot(
	snap State,
	repo string,
	run string,
	did string,
	uf UnitFilter,
	df DecisionFilter,
	lf LandingFilter,
	ef EventLogFilter,
	rm option.Option[RunMeta],
	rsum RunOverview,
	upage UnitPage,
	dec option.Option[Decision],
	dpage DecisionPage,
	land option.Option[Landing],
	lpage LandingPage,
	epage EventPage,
) bool {
		rm == RunMetaOf(snap, repo, run) &&
		rsum == QueryRunSummary(snap, repo, run, 5) &&
		upage == QueryUnitList(snap, uf) &&
		dec == DecisionByKey(snap, DecisionKey{Repo: repo, Run: run, ID: did}) &&
		dpage == QueryDecisionList(snap, df) &&
		land == LandingByKey(snap, LandingKey{Repo: repo, Run: run, LandingNumber: 1}) &&
		lpage == QueryLandingList(snap, lf) &&
		epage == QueryEventLog(snap, ef)
}

func queriesMatchSnapshot(
	snap State,
	key UnitKey,
	cid string,
	u option.Option[Unit],
	recs []Receipt,
	cm option.Option[Commitment],
	cms []Commitment,
	qs []QueueItem,
	q1 option.Option[Question],
	qlist []Question,
) bool {
		u == UnitByKey(snap, key) &&
		recs == ReceiptsOf(snap, key) &&
		cm == CommitmentByID(snap, cid) &&
		cms == ListCommitments(snap, option.Some[CommitmentStatus]{Value: CommitAssigned}, option.Some[string]{Value: "w1"}) &&
		qs == ListQueue(snap, option.Some[string]{Value: "open"}) &&
		q1 == QuestionByID(snap, 1) &&
		qlist == ListQuestions(snap, true)
}

func denseStoredEvents(stored []StoredEvent) bool {
	for i, item in stored {
		if item.Seq != i+1 {
			return false
		}
	}
	true
}
