// CommitmentDecide executes DecideCommitment and returns the resulting Commitment.
func CommitmentDecide(s Service, req CommitmentDecideInput) Commitment fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: DecideCommitment{ID: req.ID, Note: req.Note, Withdraw: req.Withdraw},
	}
	let _ = try s.store.Execute(env)
	try mustCommitment(s.store, req.ID)
}

// CommitmentList lists commitments filtered by optional status name and owner.
func CommitmentList(s Service, req CommitmentListInput) []Commitment fails InvalidInput | StoreFailed {
	let filter = match req.Status {
	case Some[string] as raw:
		match ParseCommitmentStatus(raw.Value) {
		case Some[CommitmentStatus] as st:
			Some[CommitmentStatus]{Value: st.Value}
		case None:
			return InvalidInput{Field: "status", Why: "unknown commitment status"}
		}
	case None:
		None
	}
	try s.store.ListCommitments(filter, req.Owner)
}

// QueueUpsert executes UpsertQueueItem and returns the stored QueueItem.
func QueueUpsert(s Service, req QueueUpsertInput) QueueItem fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: UpsertQueueItem{
			Key:      req.Key,
			Priority: req.Priority,
			Title:    req.Title,
			Body:     req.Body,
			Status:   req.Status,
			Tags:     req.Tags,
		},
	}
	let _ = try s.store.Execute(env)
	let items = try s.store.ListQueue(None)
	for item in items {
		if item.Key == req.Key {
			return item
		}
	}
	StoreFailed{Reason: "queue item missing after execute"}
}

// QueueRemove executes RemoveQueueItem and returns confirmation.
func QueueRemove(s Service, req QueueRemoveInput) QueueRemovedReply fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: RemoveQueueItem{Key: req.Key},
	}
	let _ = try s.store.Execute(env)
	QueueRemovedReply{Key: req.Key, Removed: true}
}

// QueueList lists queue items filtered by optional status.
func QueueList(s Service, req QueueListInput) []QueueItem fails StoreFailed {
	try s.store.ListQueue(req.Status)
}

// QuestionAsk executes AskQuestion and returns the opened Question (including on idempotent retry).
func QuestionAsk(s Service, req QuestionAskInput) Question fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: AskQuestion{
			ID:             req.ID,
			Prompt:         req.Prompt,
			Assumption:     req.Assumption,
			ConcreteAction: req.ConcreteAction,
		},
	}
	let res = try s.store.Execute(env)
	for ev in res.Events {
		match ev {
		case QuestionAsked as qa:
			return qa.Question
		case CommandAccepted, UnitOpened, UnitWasClaimed, UnitRoundAdvanced, UnitWasHandedBack, UnitWasLanded, UnitWasClosed, ReceiptRecorded, CommitmentAdded, CommitmentWasAssigned, CommitmentWasLanded, CommitmentWasDecided, CommitmentWasWithdrawn, QueueUpserted, QueueRemoved, QuestionWasAnswered, QuestionWasWithdrawn:
		}
	}
	let snap = try s.store.Snapshot()
	match snap.QuestionByCommand.Get(req.CommandID) {
	case Some[int] as qid:
		match try s.store.Question(qid.Value) {
		case Some[Question] as q:
			q.Value
		case None:
			StoreFailed{Reason: "question missing after execute"}
		}
	case None:
		StoreFailed{Reason: "question command mapping missing after execute"}
	}
}

// QuestionAnswer executes AnswerQuestion and returns the updated Question.
func QuestionAnswer(s Service, req QuestionAnswerInput) Question fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: AnswerQuestion{ID: req.ID, Answer: req.Answer, Withdraw: req.Withdraw},
	}
	let _ = try s.store.Execute(env)
	match try s.store.Question(req.ID) {
	case Some[Question] as q:
		q.Value
	case None:
		StoreFailed{Reason: "question missing after execute"}
	}
}

// QuestionList lists async questions, optionally restricted to open ones.
func QuestionList(s Service, req QuestionListInput) []Question fails StoreFailed {
	try s.store.ListQuestions(req.OpenOnly)
}

func mustUnit(store Store, id string) Unit fails StoreFailed {
	match try store.Unit(id) {
	case Some[Unit] as u:
		u.Value
	case None:
		StoreFailed{Reason: "unit missing after execute"}
	}
}

func mustCommitment(store Store, id string) Commitment fails StoreFailed {
	match try store.Commitment(id) {
	case Some[Commitment] as c:
		c.Value
	case None:
		StoreFailed{Reason: "commitment missing after execute"}
	}
}
