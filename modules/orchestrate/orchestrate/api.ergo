// UnitOpenInput is the wire-compatible input for opening a unit.
type UnitOpenInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	Title     string,
	Area      string,
}

// UnitClaimInput is the wire-compatible input for claiming a unit.
type UnitClaimInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	Owner     string,
	Lane      string,
	Harness   string,
}

// UnitRoundInput is the wire-compatible input for advancing a unit's round.
type UnitRoundInput {
	CommandID    CommandID,
	Actor        string,
	At           string,
	ID           string,
	Owner        Option[string],
	Round        int,
	RequestPath  Option[string],
	FindingsPath Option[string],
}

// UnitHandBackInput is the wire-compatible input for handing back a claimed unit.
type UnitHandBackInput {
	CommandID    CommandID,
	Actor        string,
	At           string,
	ID           string,
	Owner        string,
	HeadSHA      string,
	Summary      string,
	RequestPath  Option[string],
	FindingsPath Option[string],
}

// UnitLandInput is the wire-compatible input for marking a handed-back unit landed.
type UnitLandInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	HeadSHA   string,
}

// UnitCloseInput is the wire-compatible input for closing a non-terminal unit.
type UnitCloseInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	Summary   Option[string],
}

// UnitGetInput is the wire-compatible input for reading one unit by ID.
type UnitGetInput { ID string }

// UnitListInput is the wire-compatible input for listing units with an optional status filter.
type UnitListInput { Status Option[string] }

// ReceiptRecordInput is the wire-compatible input for recording a verification receipt.
type ReceiptRecordInput {
	CommandID      CommandID,
	Actor          string,
	At             string,
	ID             string,
	UnitID         string,
	Round          int,
	Kind           string,
	Command        string,
	CommitSHA      string,
	ExitCode       int,
	SummaryMetrics string,
	LogPath        string,
	LogSHA256      string,
}

// ReceiptReadInput is the wire-compatible input for reading receipts of a unit.
type ReceiptReadInput { UnitID string, Round Option[int] }

// CommitmentAddInput is the wire-compatible input for adding a commitment.
type CommitmentAddInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	Title     string,
	Kind      string,
}

// CommitmentAssignInput is the wire-compatible input for assigning a commitment.
type CommitmentAssignInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	Owner     string,
	Lane      string,
}

// CommitmentLandedInput is the wire-compatible input for marking a commitment landed.
type CommitmentLandedInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	LandedSHA string,
}

// CommitmentDecideInput is the wire-compatible input for deciding or withdrawing a commitment.
type CommitmentDecideInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        string,
	Note      string,
	Withdraw  bool,
}

// CommitmentListInput is the wire-compatible input for listing commitments by optional status and owner.
type CommitmentListInput { Status Option[string], Owner Option[string] }

// QueueUpsertInput is the wire-compatible input for inserting or replacing a queue item.
type QueueUpsertInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	Key       string,
	Priority  int,
	Title     string,
	Body      string,
	Status    string,
	Tags      []string,
}

// QueueRemoveInput is the wire-compatible input for deleting a queue item by key.
type QueueRemoveInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	Key       string,
}

// QueueRemovedReply is the wire-compatible reply confirming a queue item removal.
type QueueRemovedReply { Key string, Removed bool }

// QueueListInput is the wire-compatible input for listing queue items by optional status.
type QueueListInput { Status Option[string] }

// QuestionAskInput is the wire-compatible input for opening an async question.
type QuestionAskInput {
	CommandID      CommandID,
	Actor          string,
	At             string,
	ID             Option[int],
	Prompt         string,
	Assumption     string,
	ConcreteAction string,
}

// QuestionAnswerInput is the wire-compatible input for answering or withdrawing an open question.
type QuestionAnswerInput {
	CommandID CommandID,
	Actor     string,
	At        string,
	ID        int,
	Answer    string,
	Withdraw  bool,
}

// QuestionListInput is the wire-compatible input for listing async questions.
type QuestionListInput { OpenOnly bool }

// Api is the wire-, CLI-, and MCP-projectable operation contract covering all 5 orchestrate v1 tool groups.
type Api {
	// UnitOpen opens a new work unit.
	UnitOpen(input UnitOpenInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// UnitClaim claims an open or handed-back unit for an owner, lane, and harness.
	UnitClaim(input UnitClaimInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// UnitRound advances a unit to the next round and records optional request or findings paths.
	UnitRound(input UnitRoundInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// UnitHandBack hands back a claimed unit with its commit head, summary, and artifact paths.
	UnitHandBack(input UnitHandBackInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// UnitLand marks a handed-back unit as landed.
	UnitLand(input UnitLandInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// UnitClose closes a non-terminal unit without landing.
	UnitClose(input UnitCloseInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// UnitGet returns one unit by ID.
	UnitGet(input UnitGetInput) Unit fails NotFound | InvalidInput | StoreFailed,

	// UnitList lists units filtered by optional status.
	UnitList(input UnitListInput) []Unit fails InvalidInput | StoreFailed,

	// ReceiptRecord records structured verification evidence pointing to an external log path and SHA-256 digest.
	ReceiptRecord(input ReceiptRecordInput) Receipt fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// ReceiptRead lists receipts recorded for a unit, optionally filtered by round.
	ReceiptRead(input ReceiptReadInput) []Receipt fails InvalidInput | StoreFailed,

	// CommitmentAdd registers a new commitment.
	CommitmentAdd(input CommitmentAddInput) Commitment fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// CommitmentAssign assigns an open or assigned commitment to an owner and lane.
	CommitmentAssign(input CommitmentAssignInput) Commitment fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// CommitmentLanded marks a commitment as landed at a commit SHA.
	CommitmentLanded(input CommitmentLandedInput) Commitment fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// CommitmentDecide resolves or withdraws an open or assigned commitment with a note.
	CommitmentDecide(input CommitmentDecideInput) Commitment fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// CommitmentList lists commitments filtered by optional status and owner.
	CommitmentList(input CommitmentListInput) []Commitment fails InvalidInput | StoreFailed,

	// QueueUpsert inserts or replaces a prioritized queue entry by key.
	QueueUpsert(input QueueUpsertInput) QueueItem fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// QueueRemove deletes an existing queue entry by key.
	QueueRemove(input QueueRemoveInput) QueueRemovedReply fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// QueueList lists queue items filtered by optional status, ordered by priority then key.
	QueueList(input QueueListInput) []QueueItem fails StoreFailed,

	// QuestionAsk opens a new async question with a monotonic ID and default assumption.
	QuestionAsk(input QuestionAskInput) Question fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// QuestionAnswer answers or withdraws an open async question.
	QuestionAnswer(input QuestionAnswerInput) Question fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed,

	// QuestionList lists async questions, optionally restricted to open questions.
	QuestionList(input QuestionListInput) []Question fails StoreFailed,

	// ApiUnitOpenIsIdempotent verifies that opening a unit through Api is idempotent on retry and readable via UnitGet.
	law ApiUnitOpenIsIdempotent(tag int) {
		let input = UnitOpenInput{
			CommandID: CommandID("api-open-\(tag)"),
			Actor:     "root",
			At:        "2026-11-24T11:00:00Z",
			ID:        "api-u-\(tag)",
			Title:     "Api Unit",
			Area:      "orch",
		}
		let first = UnitOpen(input) catch {
		case NotFound, AlreadyExists, InvalidTransition, StaleClaim, CommandReused, InvalidInput:
			return false
		case StoreFailed:
			return true
		}
		let again = UnitOpen(input) catch {
		case NotFound, AlreadyExists, InvalidTransition, StaleClaim, CommandReused, InvalidInput:
			return false
		case StoreFailed:
			return true
		}
		let fetched = UnitGet(UnitGetInput{ID: input.ID}) catch {
		case NotFound, InvalidInput:
			return false
		case StoreFailed:
			return true
		}
		first == again && fetched == first
	},
}

// Service implements Api over any Store provider.
type Service { store Store } implements Api

// NewService constructs an Api Service backed by store.
func NewService(store Store) Service {
	Service{store: store}
}

// UnitOpen executes OpenUnit and returns the resulting Unit projection.
func UnitOpen(s Service, req UnitOpenInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: OpenUnit{ID: req.ID, Title: req.Title, Area: req.Area},
	}
	let _ = try s.store.Execute(env)
	try mustUnit(s.store, req.ID)
}

// UnitClaim executes ClaimUnit and returns the resulting Unit projection.
func UnitClaim(s Service, req UnitClaimInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: ClaimUnit{ID: req.ID, Owner: req.Owner, Lane: req.Lane, Harness: req.Harness},
	}
	let _ = try s.store.Execute(env)
	try mustUnit(s.store, req.ID)
}

