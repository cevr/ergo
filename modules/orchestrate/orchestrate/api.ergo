}

// UnitGet looks up one Unit by ID.
func UnitGet(s Service, req UnitGetInput) Unit fails NotFound | InvalidInput | StoreFailed {
	if req.ID == "" {
		return InvalidInput{Field: "id", Why: "must not be empty"}
	}
	match try s.store.Unit(req.ID) {
	case Some[Unit] as u:
		u.Value
	case None:
		NotFound{Kind: "unit", ID: req.ID}
	}
}

// UnitList lists units filtered by optional status name.
func UnitList(s Service, req UnitListInput) []Unit fails InvalidInput | StoreFailed {
	let filter = match req.Status {
	case Some[string] as raw:
		match ParseUnitStatus(raw.Value) {
		case Some[UnitStatus] as st:
			Some[UnitStatus]{Value: st.Value}
		case None:
			return InvalidInput{Field: "status", Why: "unknown unit status"}
		}
	case None:
		None
	}
	try s.store.ListUnits(filter)
}

// ReceiptRecord executes RecordReceipt and returns the persisted Receipt.
func ReceiptRecord(s Service, req ReceiptRecordInput) Receipt fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: RecordReceipt{
			ID:             req.ID,
			UnitID:         req.UnitID,
			Round:          req.Round,
			Kind:           req.Kind,
			Command:        req.Command,
			CommitSHA:      req.CommitSHA,
			ExitCode:       req.ExitCode,
			SummaryMetrics: req.SummaryMetrics,
			LogPath:        req.LogPath,
			LogSHA256:      req.LogSHA256,
		},
	}
	let _ = try s.store.Execute(env)
	let list = try s.store.Receipts(req.UnitID, Some[int]{Value: req.Round})
	for r in list {
		if r.ID == req.ID {
			return r
		}
	}
	StoreFailed{Reason: "receipt missing after execute"}
}

// ReceiptRead reads receipts for a unit and optional round.
func ReceiptRead(s Service, req ReceiptReadInput) []Receipt fails InvalidInput | StoreFailed {
	if req.UnitID == "" {
		return InvalidInput{Field: "unitId", Why: "must not be empty"}
	}
	try s.store.Receipts(req.UnitID, req.Round)
}

// CommitmentAdd executes AddCommitment and returns the resulting Commitment.
func CommitmentAdd(s Service, req CommitmentAddInput) Commitment fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: AddCommitment{ID: req.ID, Title: req.Title, Kind: req.Kind},
	}
	let _ = try s.store.Execute(env)
	try mustCommitment(s.store, req.ID)
}

