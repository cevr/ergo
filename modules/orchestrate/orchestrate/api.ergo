func UnitRound(s Service, req UnitRoundInput) Unit fails NotFound | AlreadyExists | InvalidTransition | StaleClaim | CommandReused | InvalidInput | StoreFailed {
	let env = Envelope{
		ID:      req.CommandID,
		Actor:   req.Actor,
		At:      req.At,
		Command: AdvanceUnitRound{
			ID:           req.ID,
			Owner:        req.Owner,
			Round:        req.Round,
			RequestPath:  req.RequestPath,
			FindingsPath: req.FindingsPath,
		},
	}
	let _ = try s.store.Execute(env)
	try mustUnit(s.store, req.ID)
}

