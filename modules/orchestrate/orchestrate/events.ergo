import option
import time

// OpenUnit opens a unit with the receipt kinds its verdict requires and its lane path and branch as facts.
type OpenUnit {
	Key      UnitKey,
	Title    string,
	Requires []string,
	Lane     option.Option[string],
	Branch   option.Option[string],
}

// RecordReceipt records one run of a check for a unit: kind, command, the head it ran at, exit code and exit lines.
type RecordReceipt {
	Unit      UnitKey,
	Kind      string,
	Command   string,
	Head      string,
	ExitCode  int,
	ExitLines string,
}

// AcceptUnit is the verdict that a unit's work at Head is accepted.
type AcceptUnit { Unit UnitKey, Head string }

// LandUnit is the verdict that an accepted unit landed at Head.
type LandUnit { Unit UnitKey, Head string }

// CloseUnit closes a non-terminal unit without landing.
type CloseUnit { Unit UnitKey }

// AddCommitment registers a new tracked commitment.
type AddCommitment { ID string, Title string, Kind string }

// AssignCommitment assigns an open or assigned commitment to an owner and lane.
type AssignCommitment { ID string, Owner string, Lane string }

// LandCommitment marks a commitment as landed at a commit SHA.
type LandCommitment { ID string, LandedSHA string }

// DecideCommitment resolves or withdraws an open or assigned commitment with a note.
type DecideCommitment { ID string, Note string, Withdraw bool }

// UpsertQueueItem inserts or replaces a prioritized queue entry by key.
type UpsertQueueItem {
	Key      string,
	Priority int,
	Title    string,
	Body     string,
	Status   string,
	Tags     []string,
}

// RemoveQueueItem deletes an existing queue entry by key.
type RemoveQueueItem { Key string }

// AskQuestion opens an async question with a default assumption and concrete action.
type AskQuestion {
	ID             option.Option[int],
	Prompt         string,
	Assumption     string,
	ConcreteAction string,
}

// AnswerQuestion answers or withdraws an open async question.
type AnswerQuestion { ID int, Answer string, Withdraw bool }

// TransferUnit hands a unit to the actor To; only its owner may, or any actor once when its owner is unknown, claiming it for itself.
type TransferUnit { Unit UnitKey, To string }

// BeginLanding takes the run's landing lease for LifetimeSeconds from ExpectedHead, which must be the run head.
type BeginLanding { Repo string, Run string, ExpectedHead string, LifetimeSeconds int }

// EndLanding moves the run head to NewHead and frees the caller's live landing lease.
type EndLanding { Repo string, Run string, NewHead string }

// RecordDecision creates or updates a structured ruling, architectural decision, or owner directive.
type RecordDecision {
	Repo       string,
	Run        string,
	ID         string,
	Category   string,
	Scope      string,
	UnitID     option.Option[string],
	Title      string,
	Body       string,
	Status     DecisionStatus,
	Supersedes option.Option[string],
	CreatedAt  option.Option[string],
}

// RecordLanding creates or updates a structured integration landing record.
type RecordLanding {
	Repo          string,
	Run           string,
	LandingNumber int,
	GroupID       string,
	Head          string,
	Tips          []string,
	Summary       string,
	LogPath       option.Option[string],
	LandedAt      option.Option[string],
}

// RecordLedgerEvent appends an operational event to the structured event log.
type RecordLedgerEvent {
	Repo      string,
	Run       string,
	Kind      string,
	UnitID    option.Option[string],
	Summary   string,
	SourceKey option.Option[string],
	CreatedAt option.Option[string],
}

// IngestPlan parses run log or fallout markdown text and idempotently upserts decisions, landings, run head, and events.
type IngestPlan { Repo string, Run string, Text string }

// Command is the closed union of all pure orchestrate state-changing commands.
type Command = OpenUnit | RecordReceipt | AcceptUnit | LandUnit | CloseUnit | AddCommitment | AssignCommitment | LandCommitment | DecideCommitment | UpsertQueueItem | RemoveQueueItem | AskQuestion | AnswerQuestion | TransferUnit | BeginLanding | EndLanding | RecordDecision | RecordLanding | RecordLedgerEvent | IngestPlan

// Envelope carries a Command together with all explicit caller context required for zero-I/O decisions.
type Envelope { ID CommandID, Actor string, At string, Command Command }

// CommandAccepted records that a CommandID was accepted with a specific Command payload.
type CommandAccepted { ID CommandID, Actor string, At string, Command Command }

// UnitOpened records that a unit was opened.
type UnitOpened {
	Key      UnitKey,
	Title    string,
	Requires []string,
	Lane     option.Option[string],
	Branch   option.Option[string],
	At       string,
}

// ReceiptRecorded records one receipt.
type ReceiptRecorded { Receipt Receipt }

// UnitWasAccepted records that a unit was accepted at a head.
type UnitWasAccepted { Unit UnitKey, Head string, At string }

// UnitWasLanded records that an accepted unit landed at its head.
type UnitWasLanded { Unit UnitKey, Head string, At string }

// UnitWasClosed records that a unit closed without landing.
type UnitWasClosed { Unit UnitKey, At string }

// CommitmentAdded records that a new commitment was registered.
type CommitmentAdded { ID string, Title string, Kind string, At string }

// CommitmentWasAssigned records that a commitment was assigned.
type CommitmentWasAssigned { ID string, Owner string, Lane string, At string }

// CommitmentWasLanded records that a commitment landed at a commit SHA.
type CommitmentWasLanded { ID string, LandedSHA string, At string }

// CommitmentWasDecided records that a commitment was closed by an explicit decision.
type CommitmentWasDecided { ID string, Note string, At string }

// CommitmentWasWithdrawn records that a commitment was withdrawn.
type CommitmentWasWithdrawn { ID string, Note string, At string }

// QueueUpserted records an inserted or updated queue entry.
type QueueUpserted { Item QueueItem }

// QueueRemoved records deletion of a queue entry.
type QueueRemoved { Key string }

// QuestionAsked records a newly opened async question and the CommandID that created it.
type QuestionAsked { CommandID CommandID, Question Question }

// QuestionWasAnswered records an answer to an open question.
type QuestionWasAnswered { ID int, Answer string, AnsweredBy string, AnsweredAt string }

// QuestionWasWithdrawn records withdrawal of an open question.
type QuestionWasWithdrawn { ID int, Answer option.Option[string], AnsweredBy string, AnsweredAt string }

// RunHeadUpdated records an update to a run's main branch head.
type RunHeadUpdated { Repo string, Run string, Head string, UpdatedAt string }

// UnitOwnerChanged records that a unit's owner moved From one actor To another; opening a unit records it From the unknown owner.
type UnitOwnerChanged { Unit UnitKey, From string, To string, At string }

// LandingLeaseTaken records that Lease's actor took or renewed the run's landing lease.
type LandingLeaseTaken { Lease LandingLease }

// LandingLeaseTakenOver records that To took over the expired landing lease From held since FromSince.
type LandingLeaseTakenOver { Repo string, Run string, From string, FromSince string, To string, At string }

// LandingLeaseEnded records that Actor freed the run's landing lease.
type LandingLeaseEnded { Repo string, Run string, Actor string, At string }

// DecisionRecorded records a created or updated structured decision.
type DecisionRecorded { Decision Decision }

// LandingRecorded records a created or updated integration landing record.
type LandingRecorded { Landing Landing }

// LedgerEventAppended records an appended entry in the operational event log.
type LedgerEventAppended { Event LedgerEvent }

// Event is the closed union of all immutable domain events persisted by orchestrate.
type Event = CommandAccepted | UnitOpened | ReceiptRecorded | UnitWasAccepted | UnitWasLanded | UnitWasClosed | CommitmentAdded | CommitmentWasAssigned | CommitmentWasLanded | CommitmentWasDecided | CommitmentWasWithdrawn | QueueUpserted | QueueRemoved | QuestionAsked | QuestionWasAnswered | QuestionWasWithdrawn | RunHeadUpdated | UnitOwnerChanged | LandingLeaseTaken | LandingLeaseTakenOver | LandingLeaseEnded | DecisionRecorded | LandingRecorded | LedgerEventAppended

// Apply evolves State purely by one Event.
func Apply(state State, ev Event) State {
	match ev {
	case CommandAccepted as e:
		State{..state, Commands: state.Commands.Put(e.ID, e.Command)}
	case UnitOpened as e:
		let u = Unit{
			Key:       e.Key,
			Owner:     UnknownOwner,
			Title:     e.Title,
			Requires:  e.Requires,
			Lane:      e.Lane,
			Branch:    e.Branch,
			Status:    UnitOpen,
			Head:      option.None,
			CreatedAt: e.At,
			UpdatedAt: e.At,
		}
		State{..state, Units: state.Units.Put(e.Key, u)}
	case ReceiptRecorded as e:
		let r = e.Receipt
		let order = match state.Receipts.Get(r.ID) {
		case option.Some[Receipt]:
			state.ReceiptOrder
		case option.None:
			state.ReceiptOrder.Append(r.ID)
		}
		State{..state, Receipts: state.Receipts.Put(r.ID, r), ReceiptOrder: order}
	case UnitWasAccepted as e:
		moveUnit(state, e.Unit, UnitAccepted, option.Some[string]{Value: e.Head}, e.At)
	case UnitWasLanded as e:
		moveUnit(state, e.Unit, UnitLanded, option.Some[string]{Value: e.Head}, e.At)
	case UnitWasClosed as e:
		match state.Units.Get(e.Unit) {
		case option.Some[Unit] as cur:
			moveUnit(state, e.Unit, UnitClosed, cur.Value.Head, e.At)
		case option.None:
			state
		}
	case CommitmentAdded as e:
		let c = Commitment{
			ID:           e.ID,
			Title:        e.Title,
			Kind:         e.Kind,
			Status:       CommitOpen,
			Owner:        option.None,
			Lane:         option.None,
			LandedSHA:    option.None,
			DecisionNote: option.None,
			CreatedAt:    e.At,
			UpdatedAt:    e.At,
		}
		State{..state, Commitments: state.Commitments.Put(e.ID, c)}
	case CommitmentWasAssigned as e:
		match state.Commitments.Get(e.ID) {
		case option.Some[Commitment] as cur:
			let next = Commitment{
				..cur.Value,
				Status:    CommitAssigned,
				Owner:     option.Some[string]{Value: e.Owner},
				Lane:      option.Some[string]{Value: e.Lane},
				UpdatedAt: e.At,
			}
			State{..state, Commitments: state.Commitments.Put(e.ID, next)}
		case option.None:
			state
		}
	case CommitmentWasLanded as e:
		match state.Commitments.Get(e.ID) {
		case option.Some[Commitment] as cur:
			let next = Commitment{
				..cur.Value,
				Status:    CommitLanded,
				LandedSHA: option.Some[string]{Value: e.LandedSHA},
				UpdatedAt: e.At,
			}
			State{..state, Commitments: state.Commitments.Put(e.ID, next)}
		case option.None:
			state
		}
	case CommitmentWasDecided as e:
		match state.Commitments.Get(e.ID) {
		case option.Some[Commitment] as cur:
			let next = Commitment{
				..cur.Value,
				Status:       CommitDecided,
				DecisionNote: option.Some[string]{Value: e.Note},
				UpdatedAt:    e.At,
			}
			State{..state, Commitments: state.Commitments.Put(e.ID, next)}
		case option.None:
			state
		}
	case CommitmentWasWithdrawn as e:
		match state.Commitments.Get(e.ID) {
		case option.Some[Commitment] as cur:
			let next = Commitment{
				..cur.Value,
				Status:       CommitWithdrawn,
				DecisionNote: option.Some[string]{Value: e.Note},
				UpdatedAt:    e.At,
			}
			State{..state, Commitments: state.Commitments.Put(e.ID, next)}
		case option.None:
			state
		}
	case QueueUpserted as e:
		State{..state, Queue: state.Queue.Put(e.Item.Key, e.Item)}
	case QueueRemoved as e:
		State{..state, Queue: state.Queue.Delete(e.Key)}
	case QuestionAsked as e:
		let q = e.Question
		let nextID = if q.ID >= state.NextQuestionID { q.ID + 1 } else { state.NextQuestionID }
		State{
			..state,
			Questions:         state.Questions.Put(q.ID, q),
			QuestionByCommand: state.QuestionByCommand.Put(e.CommandID, q.ID),
			NextQuestionID:    nextID,
		}
	case QuestionWasAnswered as e:
		match state.Questions.Get(e.ID) {
		case option.Some[Question] as cur:
			let next = Question{
				..cur.Value,
				Status:     QuestionAnswered,
				Answer:     option.Some[string]{Value: e.Answer},
				AnsweredBy: option.Some[string]{Value: e.AnsweredBy},
				AnsweredAt: option.Some[string]{Value: e.AnsweredAt},
			}
			State{..state, Questions: state.Questions.Put(e.ID, next)}
		case option.None:
			state
		}
	case QuestionWasWithdrawn as e:
		match state.Questions.Get(e.ID) {
		case option.Some[Question] as cur:
			let next = Question{
				..cur.Value,
				Status:     QuestionWithdrawn,
				Answer:     e.Answer,
				AnsweredBy: option.Some[string]{Value: e.AnsweredBy},
				AnsweredAt: option.Some[string]{Value: e.AnsweredAt},
			}
			State{..state, Questions: state.Questions.Put(e.ID, next)}
		case option.None:
			state
		}
	case RunHeadUpdated as e:
		let rk = RunKey{Repo: e.Repo, Run: e.Run}
		let rm = RunMeta{Repo: e.Repo, Run: e.Run, MainHead: option.Some[string]{Value: e.Head}, UpdatedAt: e.UpdatedAt}
		State{..state, RunMetas: state.RunMetas.Put(rk, rm)}
	case UnitOwnerChanged as e:
		match state.Units.Get(e.Unit) {
		case option.Some[Unit] as cur:
			State{..state, Units: state.Units.Put(e.Unit, Unit{..cur.Value, Owner: e.To, UpdatedAt: e.At})}
		case option.None:
			state
		}
	case LandingLeaseTaken as e:
		State{..state, Leases: state.Leases.Put(RunKey{Repo: e.Lease.Repo, Run: e.Lease.Run}, e.Lease)}
	case LandingLeaseTakenOver:
		state
	case LandingLeaseEnded as e:
		State{..state, Leases: state.Leases.Delete(RunKey{Repo: e.Repo, Run: e.Run})}
	case DecisionRecorded as e:
		applyDecision(state, e.Decision)
	case LandingRecorded as e:
		let lk = LandingKey{Repo: e.Landing.Repo, Run: e.Landing.Run, LandingNumber: e.Landing.LandingNumber}
		State{..state, Landings: state.Landings.Put(lk, e.Landing)}
	case LedgerEventAppended as e:
		let entry = e.Event
		let nextID = if entry.ID >= state.NextEventID { entry.ID + 1 } else { state.NextEventID }
		let nextKeys = match entry.SourceKey {
		case option.Some[string] as sk:
			state.EventLogSourceKeys.Put(EventSourceKey{Repo: entry.Repo, Run: entry.Run, SourceKey: sk.Value}, entry.ID)
		case option.None:
			state.EventLogSourceKeys
		}
		State{..state, EventLog: state.EventLog.Append(entry), EventLogSourceKeys: nextKeys, NextEventID: nextID}
	}
}

func applyDecision(state State, d Decision) State {
	let key = DecisionKey{Repo: d.Repo, Run: d.Run, ID: d.ID}
	let (createdAt, prevSuperseded) = match state.Decisions.Get(key) {
	case option.Some[Decision] as cur:
		(cur.Value.CreatedAt, cur.Value.Status == DecisionSuperseded)
	case option.None:
		(d.CreatedAt, false)
	}
	let mut childSuperseded = false
	for _, existing in state.Decisions {
		if existing.Repo == d.Repo && existing.Run == d.Run && existing.Supersedes == (option.Some[string]{Value: d.ID}) {
			childSuperseded = true
			break
		}
	}
	let status = if prevSuperseded || childSuperseded { DecisionSuperseded } else { d.Status }
	let mut nextDecisions = state.Decisions.Put(key, Decision{..d, CreatedAt: createdAt, Status: status})
	match d.Supersedes {
	case option.Some[string] as target:
		let tkey = DecisionKey{Repo: d.Repo, Run: d.Run, ID: target.Value}
		match nextDecisions.Get(tkey) {
		case option.Some[Decision] as old:
			nextDecisions = nextDecisions.Put(tkey, Decision{..old.Value, Status: DecisionSuperseded})
		case option.None:
		}
	case option.None:
	}
	State{..state, Decisions: nextDecisions}
}

func moveUnit(state State, key UnitKey, status UnitStatus, head option.Option[string], at string) State {
	match state.Units.Get(key) {
	case option.Some[Unit] as cur:
		State{..state, Units: state.Units.Put(key, Unit{..cur.Value, Status: status, Head: head, UpdatedAt: at})}
	case option.None:
		state
	}
}

// ApplyAll folds a slice of events onto an existing State in order.
func ApplyAll(state State, events []Event) State {
	let mut cur = state
	for ev in events {
		cur = Apply(cur, ev)
	}
	cur
}

// Fold reconstructs State from scratch by applying all events in order.
func Fold(events []Event) State {
	ApplyAll(EmptyState(), events)
}

// ReplayMatchesIncremental verifies that folding all emitted events from scratch produces the exact same State as applying them incrementally across generated command sequences.
law ReplayMatchesIncremental(steps []int) {
	let mut incremental = EmptyState()
	let mut all = []Event{}
	for i, code in steps {
		let env = generatedEnvelope(i, code)
		let evs = Decide(incremental, env) catch {
		case _:
			[]Event{}
		}
		for ev in evs {
			incremental = Apply(incremental, ev)
			all = all.Append(ev)
		}
	}
	Fold(all) == incremental
}

func generatedEnvelope(index int, code int) Envelope {
	let kind = ((code % 22) + 22) % 22
	let slot = (((code / 22) % 3) + 3) % 3
	let id = CommandID("gen-\(index)")
	let at = time.Format(time.Unix(int64(1795478400+index*30), 0), time.RFC3339)
	let runName = "run-\(slot % 2)"
	let key = UnitKey{Repo: "repo", Run: runName, ID: "u-\(slot)"}
	let head = "head-\(((code/60)%2 + 2) % 2)"
	let commitID = "c-\(slot)"
	let queueKey = "q-\(slot)"
	let cmd Command = match kind {
	case 0:
		OpenUnit{Key: key, Title: "Unit \(slot)", Requires: []string{"acceptance"}, Lane: option.Some[string]{Value: "/lanes/\(slot)"}, Branch: option.None}
	case 1:
		RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: head, ExitCode: 0, ExitLines: "ok"}
	case 2:
		RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: head, ExitCode: 1, ExitLines: "FAIL"}
	case 3:
		AcceptUnit{Unit: key, Head: head}
	case 4:
		LandUnit{Unit: key, Head: head}
	case 5:
		CloseUnit{Unit: key}
	case 6:
		AddCommitment{ID: commitID, Title: "Commit \(slot)", Kind: "plan-part"}
	case 7:
		AssignCommitment{ID: commitID, Owner: "owner-\(slot)", Lane: "lane-\(slot)"}
	case 8:
		LandCommitment{ID: commitID, LandedSHA: "1234abcd"}
	case 9:
		DecideCommitment{ID: commitID, Note: "decided", Withdraw: slot == 2}
	case 10:
		UpsertQueueItem{Key: queueKey, Priority: slot, Title: "Queue \(slot)", Body: "body", Status: "open", Tags: []string{"t1"}}
	case 11:
		RemoveQueueItem{Key: queueKey}
	case 12:
		AskQuestion{ID: option.None, Prompt: "Question \(index)?", Assumption: "default", ConcreteAction: "reply yes"}
	case 13:
		AnswerQuestion{ID: slot + 1, Answer: "yes", Withdraw: slot == 2}
	case 14:
		BeginLanding{Repo: "repo", Run: runName, ExpectedHead: head, LifetimeSeconds: 60}
	case 15:
		let sup = if slot == 2 { option.Some[string]{Value: "dec-0"} } else { option.None }
		RecordDecision{Repo: "repo", Run: runName, ID: "dec-\(slot)", Category: "ruling", Scope: "run", UnitID: option.Some[string]{Value: "u-\(slot)"}, Title: "Decision \(slot)", Body: "Body \(slot)", Status: DecisionOpen, Supersedes: sup, CreatedAt: option.None}
	case 16:
		RecordLanding{Repo: "repo", Run: runName, LandingNumber: slot + 1, GroupID: "grp-\(slot)", Head: head, Tips: []string{"tip-\(slot)"}, Summary: "Landing \(slot + 1)", LogPath: option.Some[string]{Value: "/logs/g\(slot).log"}, LandedAt: option.None}
	case 17:
		RecordLedgerEvent{Repo: "repo", Run: runName, Kind: "dispatched", UnitID: option.Some[string]{Value: "u-\(slot)"}, Summary: "Dispatched \(slot)", SourceKey: option.None, CreatedAt: option.None}
	case 18:
		let text = "- 2026-11-26T10:00:0\(slot)Z RULED (Rule \(slot)): keep invariant.\nMAIN MOVED 2026-11-26T10:01:0\(slot)Z: main = abcdef\(slot)0 (Landing \(slot + 1), group grp-\(slot)). Tips: U-\(slot)\n- 2026-11-26T10:02:0\(slot)Z DISPATCHED (Worker) U-\(slot): start\n"
		IngestPlan{Repo: "repo", Run: runName, Text: text}
	case 19:
		OpenUnit{Key: key, Title: "Unit \(slot)", Requires: []string{"acceptance", "gate"}, Lane: option.None, Branch: option.Some[string]{Value: "b-\(slot)"}}
	case 20:
		EndLanding{Repo: "repo", Run: runName, NewHead: "head-\(index % 2)"}
	case _:
		TransferUnit{Unit: key, To: "actor-\((slot + 1) % 3)"}
	}
	Envelope{ID: id, Actor: "actor-\(slot)", At: at, Command: cmd}
}
