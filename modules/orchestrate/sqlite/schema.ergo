import github.com/cevr/ergo/modules/orchestrate/orchestrate
import hex
import json
import option
import sha256
import sql
import strconv

// CurrentSchemaVersion is the SQLite schema version written and accepted by this package.
let CurrentSchemaVersion = 4

func initSchema() fails orchestrate.StoreFailed needs sql.Tx {
	let uvRows = try queryTx("PRAGMA user_version", []sql.Value{})
	let mut uv = 0
	if uvRows.Len() > 0 {
		uv = try intAt(uvRows[0], 0, "user_version")
		if uv > CurrentSchemaVersion {
			return orchestrate.StoreFailed{Reason: "incompatible sqlite user_version \(uv) > \(CurrentSchemaVersion)"}
		}
	}
	if uv != CurrentSchemaVersion {
		let _ = try execTx(
			"CREATE TABLE IF NOT EXISTS schema_meta (id INTEGER PRIMARY KEY CHECK (id = 1), schema_version INTEGER NOT NULL, next_question_id INTEGER NOT NULL DEFAULT 1, next_event_id INTEGER NOT NULL DEFAULT 1)",
			[]sql.Value{},
		)
	}
	let metaRows = try queryTx("SELECT schema_version FROM schema_meta WHERE id = 1", []sql.Value{})
	if metaRows.Len() > 0 {
		let ver = try intAt(metaRows[0], 0, "schema_version")
		if ver > CurrentSchemaVersion || ver < 1 {
			return orchestrate.StoreFailed{Reason: "incompatible schema_version \(ver) != \(CurrentSchemaVersion)"}
		}
		if ver == CurrentSchemaVersion && uv == CurrentSchemaVersion {
			return
		}
		if ver < CurrentSchemaVersion {
			try migrateSchemaTx(ver)
			return
		}
	} else {
		let _ = try execTx(
			"INSERT INTO schema_meta (id, schema_version, next_question_id, next_event_id) VALUES (1, ?, 1, 1)",
			[]sql.Value{sql.Int{N: int64(CurrentSchemaVersion)}},
		)
	}
	try createTablesTx()
}

func migrateSchemaTx(fromVer int) fails orchestrate.StoreFailed needs sql.Tx {
	if !(try hasColumnTx("schema_meta", "next_event_id")) {
		let _ = try execTx("ALTER TABLE schema_meta ADD COLUMN next_event_id INTEGER NOT NULL DEFAULT 1", []sql.Value{})
	}
	if fromVer == 1 && (try hasTableTx("units")) && !(try hasColumnTx("units", "repo")) {
		let _ = try execTx("ALTER TABLE units RENAME TO units_v1", []sql.Value{})
		let hasReceipts = try hasTableTx("receipts")
		if hasReceipts {
			let _ = try execTx("ALTER TABLE receipts RENAME TO receipts_v1", []sql.Value{})
		}
		try createTablesTx()
		let _ = try execTx(
				"INSERT INTO units (repo, run, id, title, requires_json, lane, branch, status, head, created_at, updated_at) "+
				"SELECT 'default', 'default', id, title, '[\"acceptance\"]', lane, NULL, "+
				"CASE status WHEN 'accepted' THEN 'accepted' WHEN 'landed' THEN 'landed' WHEN 'closed' THEN 'closed' ELSE 'open' END, "+
				"head_sha, created_at, updated_at FROM units_v1",
			[]sql.Value{},
		)
		if hasReceipts {
			let _ = try execTx(
					"INSERT INTO receipts (id, seq_order, repo, run, unit_id, kind, command, head, exit_code, exit_lines, recorded_at, recorded_by) "+
					"SELECT id, seq_order, 'default', 'default', unit_id, kind, command, commit_sha, exit_code, substr(summary_metrics, 1, 4096), recorded_at, recorded_by FROM receipts_v1",
				[]sql.Value{},
			)
			let _ = try execTx("DROP TABLE receipts_v1", []sql.Value{})
		}
		let _ = try execTx("DROP TABLE units_v1", []sql.Value{})
	} else {
		try createTablesTx()
	}
	for col in []string{"lease_actor", "lease_base_head", "lease_since", "lease_until"} {
		if !(try hasColumnTx("run_meta", col)) {
			let _ = try execTx("ALTER TABLE run_meta ADD COLUMN "+col+" TEXT", []sql.Value{})
		}
	}
	if !(try hasColumnTx("units", "owner")) {
		let _ = try execTx("ALTER TABLE units ADD COLUMN owner TEXT NOT NULL DEFAULT 'unknown'", []sql.Value{})
		try migrateOwnersTx()
	}
	let _ = try execTx(
		"UPDATE schema_meta SET schema_version = ? WHERE id = 1",
		[]sql.Value{sql.Int{N: int64(CurrentSchemaVersion)}},
	)
}

func migrateOwnersTx() fails orchestrate.StoreFailed needs sql.Tx {
	let mut actor = orchestrate.UnknownOwner
	let mut changes = []orchestrate.Event{}
	for stored in try queryEventsTx(0) {
		match stored.Event {
		case orchestrate.CommandAccepted as e:
			actor = e.Actor
		case orchestrate.UnitOpened as e:
			if actor != orchestrate.UnknownOwner {
				changes = changes.Append(orchestrate.UnitOwnerChanged{Unit: e.Key, From: orchestrate.UnknownOwner, To: actor, At: e.At})
			}
		case _:
		}
	}
	let mut seq = try lastSeqTx()
	for ev in changes {
		seq = seq + 1
		let _ = try execTx(
			"INSERT INTO events (seq, command_id, payload_digest, event_json) VALUES (?, 'schema-v4-owner', '', ?)",
			[]sql.Value{sql.Int{N: int64(seq)}, sql.Text{S: encodeEvent(ev)}},
		)
		try applyEventSQL(ev, seq)
	}
}

func hasTableTx(table string) bool fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		"SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ? LIMIT 1",
		[]sql.Value{sql.Text{S: table}},
	)
	rows.Len() > 0
}

func hasColumnTx(table string, col string) bool fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx("PRAGMA table_info("+table+")", []sql.Value{})
	for row in rows {
		if (try textAt(row, 1, "name")) == col {
			return true
		}
	}
	false
}

func createTablesTx() fails orchestrate.StoreFailed needs sql.Tx {
	let ddl = "CREATE TABLE IF NOT EXISTS commands (command_id TEXT PRIMARY KEY, actor TEXT NOT NULL, at TEXT NOT NULL, payload_json TEXT NOT NULL, payload_digest TEXT NOT NULL);" +
		"CREATE TABLE IF NOT EXISTS events (seq INTEGER PRIMARY KEY, command_id TEXT NOT NULL, payload_digest TEXT NOT NULL, event_json TEXT NOT NULL);" +
		"CREATE INDEX IF NOT EXISTS idx_events_command_id ON events (command_id);" +
		"CREATE TABLE IF NOT EXISTS units (repo TEXT NOT NULL, run TEXT NOT NULL, id TEXT NOT NULL, title TEXT NOT NULL, requires_json TEXT NOT NULL, lane TEXT, branch TEXT, status TEXT NOT NULL, head TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, owner TEXT NOT NULL DEFAULT 'unknown', PRIMARY KEY (repo, run, id));" +
		"CREATE INDEX IF NOT EXISTS idx_units_repo_run_status ON units (repo, run, status, id);" +
		"CREATE TABLE IF NOT EXISTS receipts (id TEXT PRIMARY KEY, seq_order INTEGER NOT NULL, repo TEXT NOT NULL, run TEXT NOT NULL, unit_id TEXT NOT NULL, kind TEXT NOT NULL, command TEXT NOT NULL, head TEXT NOT NULL, exit_code INTEGER NOT NULL, exit_lines TEXT NOT NULL, recorded_at TEXT NOT NULL, recorded_by TEXT NOT NULL, FOREIGN KEY (repo, run, unit_id) REFERENCES units (repo, run, id));" +
		"CREATE INDEX IF NOT EXISTS idx_receipts_unit_head ON receipts (repo, run, unit_id, head, seq_order);" +
		"CREATE TABLE IF NOT EXISTS commitments (id TEXT PRIMARY KEY, title TEXT NOT NULL, kind TEXT NOT NULL, status TEXT NOT NULL, owner TEXT, lane TEXT, landed_sha TEXT, decision_note TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL);" +
		"CREATE INDEX IF NOT EXISTS idx_commitments_status_owner ON commitments (status, owner, id);" +
		"CREATE TABLE IF NOT EXISTS queue (key TEXT PRIMARY KEY, priority INTEGER NOT NULL, title TEXT NOT NULL, body TEXT NOT NULL, status TEXT NOT NULL, tags_json TEXT NOT NULL, updated_at TEXT NOT NULL);" +
		"CREATE INDEX IF NOT EXISTS idx_queue_order ON queue (status, priority, key);" +
		"CREATE TABLE IF NOT EXISTS questions (id INTEGER PRIMARY KEY, command_id TEXT NOT NULL UNIQUE, prompt TEXT NOT NULL, assumption TEXT NOT NULL, concrete_action TEXT NOT NULL, status TEXT NOT NULL, answer TEXT, asked_by TEXT NOT NULL, asked_at TEXT NOT NULL, answered_by TEXT, answered_at TEXT);" +
		"CREATE INDEX IF NOT EXISTS idx_questions_status ON questions (status, id);" +
		"CREATE TABLE IF NOT EXISTS run_meta (repo TEXT NOT NULL, run TEXT NOT NULL, main_head TEXT, updated_at TEXT NOT NULL, lease_actor TEXT, lease_base_head TEXT, lease_since TEXT, lease_until TEXT, PRIMARY KEY (repo, run));" +
		"CREATE TABLE IF NOT EXISTS decisions (repo TEXT NOT NULL, run TEXT NOT NULL, id TEXT NOT NULL, category TEXT NOT NULL, scope TEXT NOT NULL, unit_id TEXT, title TEXT NOT NULL, body TEXT NOT NULL, status TEXT NOT NULL, supersedes TEXT, actor TEXT NOT NULL, created_at TEXT NOT NULL, PRIMARY KEY (repo, run, id));" +
		"CREATE INDEX IF NOT EXISTS idx_decisions_filter ON decisions (repo, run, status, category, created_at DESC, id);" +
		"CREATE TABLE IF NOT EXISTS landings (repo TEXT NOT NULL, run TEXT NOT NULL, landing_number INTEGER NOT NULL, group_id TEXT NOT NULL, head TEXT NOT NULL, tips_json TEXT NOT NULL, summary TEXT NOT NULL, log_path TEXT, landed_at TEXT NOT NULL, PRIMARY KEY (repo, run, landing_number));" +
		"CREATE INDEX IF NOT EXISTS idx_landings_recent ON landings (repo, run, landing_number DESC);" +
		"CREATE TABLE IF NOT EXISTS event_log (id INTEGER PRIMARY KEY, repo TEXT NOT NULL, run TEXT NOT NULL, kind TEXT NOT NULL, unit_id TEXT, summary TEXT NOT NULL, actor TEXT NOT NULL, created_at TEXT NOT NULL, source_key TEXT);" +
		"CREATE INDEX IF NOT EXISTS idx_event_log_filter ON event_log (repo, run, kind, unit_id, id DESC);" +
		"CREATE UNIQUE INDEX IF NOT EXISTS idx_event_log_source_key ON event_log (repo, run, source_key) WHERE source_key IS NOT NULL;" +
		"PRAGMA user_version = " + strconv.Itoa(CurrentSchemaVersion)
	let _ = try execTx(ddl, []sql.Value{})
}

func execTx(stmt string, args []sql.Value) sql.Result fails orchestrate.StoreFailed needs sql.Tx {
	sql.Tx.Exec(stmt, args) catch {
	case sql.Unique as e:
		return orchestrate.StoreFailed{Reason: "sql unique: " + e.Constraint}
	case sql.Serialization as e:
		return orchestrate.StoreFailed{Reason: "sql serialization: " + e.Message}
	case sql.Deadlock as e:
		return orchestrate.StoreFailed{Reason: "sql deadlock: " + e.Message}
	case sql.Timeout as e:
		return orchestrate.StoreFailed{Reason: "sql timeout: " + e.Message}
	case sql.Closed as e:
		return orchestrate.StoreFailed{Reason: "sql closed: " + e.Message}
	case sql.Other as e:
		return orchestrate.StoreFailed{Reason: "sql other (" + e.Code + "): " + e.Message}
	}
}

func queryTx(stmt string, args []sql.Value) []sql.Row fails orchestrate.StoreFailed needs sql.Tx {
	sql.Tx.Query(stmt, args) catch {
	case sql.Unique as e:
		return orchestrate.StoreFailed{Reason: "sql unique: " + e.Constraint}
	case sql.Serialization as e:
		return orchestrate.StoreFailed{Reason: "sql serialization: " + e.Message}
	case sql.Deadlock as e:
		return orchestrate.StoreFailed{Reason: "sql deadlock: " + e.Message}
	case sql.Timeout as e:
		return orchestrate.StoreFailed{Reason: "sql timeout: " + e.Message}
	case sql.Closed as e:
		return orchestrate.StoreFailed{Reason: "sql closed: " + e.Message}
	case sql.Other as e:
		return orchestrate.StoreFailed{Reason: "sql other (" + e.Code + "): " + e.Message}
	}
}

func optTextVal(v option.Option[string]) sql.Value {
	match v {
	case option.Some[string] as s:
		sql.Text{S: s.Value}
	case option.None:
		sql.Null
	}
}

func textAt(row sql.Row, index int, col string) string fails orchestrate.StoreFailed {
	if index < 0 || index >= row.Values.Len() {
		return orchestrate.StoreFailed{Reason: "missing column " + col}
	}
	match row.Values[index] {
	case sql.Text as t:
		t.S
	case _:
		orchestrate.StoreFailed{Reason: "expected TEXT for " + col}
	}
}

func optTextAt(row sql.Row, index int, col string) option.Option[string] fails orchestrate.StoreFailed {
	if index < 0 || index >= row.Values.Len() {
		return orchestrate.StoreFailed{Reason: "missing column " + col}
	}
	match row.Values[index] {
	case sql.Null:
		option.None
	case sql.Text as t:
		option.Some[string]{Value: t.S}
	case _:
		orchestrate.StoreFailed{Reason: "expected nullable TEXT for " + col}
	}
}

func intAt(row sql.Row, index int, col string) int fails orchestrate.StoreFailed {
	if index < 0 || index >= row.Values.Len() {
		return orchestrate.StoreFailed{Reason: "missing column " + col}
	}
	match row.Values[index] {
	case sql.Int as n:
		int(n.N)
	case _:
		orchestrate.StoreFailed{Reason: "expected INTEGER for " + col}
	}
}

func encodeCommand(cmd orchestrate.Command) string {
	json.Encode(json.Codec[orchestrate.Command]{MaxBytes: 0, MaxDepth: 0}, cmd)
}

func decodeCommand(text string) orchestrate.Command fails orchestrate.StoreFailed {
	json.Decode(json.Codec[orchestrate.Command]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		return orchestrate.StoreFailed{Reason: "corrupt command payload json"}
	}
}

func commandDigest(payloadJSON string) string {
	hex.Encode(sha256.Sum(payloadJSON))
}

func encodeEvent(ev orchestrate.Event) string {
	json.Encode(json.Codec[orchestrate.Event]{MaxBytes: 0, MaxDepth: 0}, ev)
}

func decodeEvent(text string) orchestrate.Event fails orchestrate.StoreFailed {
	json.Decode(json.Codec[orchestrate.Event]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		return orchestrate.StoreFailed{Reason: "corrupt event payload json"}
	}
}

func encodeTags(tags []string) string {
	json.Encode(json.Codec[[]string]{MaxBytes: 0, MaxDepth: 0}, tags)
}

func decodeTags(text string) []string fails orchestrate.StoreFailed {
	json.Decode(json.Codec[[]string]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		return orchestrate.StoreFailed{Reason: "corrupt queue tags json"}
	}
}
