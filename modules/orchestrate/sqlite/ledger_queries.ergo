import github.com/cevr/ergo/modules/orchestrate/orchestrate
import option
import sql
import strings

func appendCond(conds []string, args []sql.Value, opt option.Option[string], clause string) ([]string, []sql.Value) {
	match opt {
	case option.Some[string] as v:
		(conds.Append(clause), args.Append(sql.Text{S: v.Value}))
	case option.None:
		(conds, args)
	}
}

func buildWhere(conds []string) string {
	if conds.Len() == 0 {
		return ""
	}
	" WHERE " + strings.Join(conds, " AND ")
}

func queryCountTx(sqlText string, args []sql.Value) int fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(sqlText, args)
	if rows.Len() == 0 {
		return 0
	}
	try intAt(rows[0], 0, "count")
}

func queryRunMetaTx(repo string, run string) option.Option[orchestrate.RunMeta] fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		"SELECT repo, run, main_head, updated_at FROM run_meta WHERE repo = ? AND run = ?",
		[]sql.Value{sql.Text{S: repo}, sql.Text{S: run}},
	)
	if rows.Len() == 0 {
		return option.None
	}
	option.Some[orchestrate.RunMeta]{Value: try scanRunMeta(rows[0])}
}

func queryRunSummaryTx(repo string, run string, landingsLimit int) orchestrate.RunOverview fails orchestrate.StoreFailed needs sql.Tx {
	let mainHead = match try queryRunMetaTx(repo, run) {
	case option.Some[orchestrate.RunMeta] as m:
		m.Value.MainHead
	case option.None:
		option.None
	}
	let mut openUnits = 0
	let mut acceptedUnits = 0
	let mut landedUnits = 0
	let mut closedUnits = 0
	let mut totalUnits = 0
	let unitCounts = try queryTx(
		"SELECT status, COUNT(*) FROM units WHERE repo = ? AND run = ? GROUP BY status",
		[]sql.Value{sql.Text{S: repo}, sql.Text{S: run}},
	)
	for row in unitCounts {
		let st = try textAt(row, 0, "status")
		let cnt = try intAt(row, 1, "count")
		totalUnits = totalUnits + cnt
		match st {
		case "open":
			openUnits = openUnits + cnt
		case "accepted":
			acceptedUnits = acceptedUnits + cnt
		case "landed":
			landedUnits = landedUnits + cnt
		case "closed":
			closedUnits = closedUnits + cnt
		case _:
		}
	}
	let openDecisions = try queryCountTx(
		"SELECT COUNT(*) FROM decisions WHERE repo = ? AND run = ? AND status = 'open'",
		[]sql.Value{sql.Text{S: repo}, sql.Text{S: run}},
	)
	let openQuestions = try queryCountTx(
		"SELECT COUNT(*) FROM questions WHERE status = 'open'",
		[]sql.Value{},
	)
	let openCommitments = try queryCountTx(
		"SELECT COUNT(*) FROM commitments WHERE status IN ('open', 'assigned')",
		[]sql.Value{},
	)
	let mut recent = []orchestrate.LandingSummary{}
	if landingsLimit > 0 {
		let lRows = try queryTx(
			"SELECT landing_number, group_id, head, tips_json, summary, landed_at FROM landings WHERE repo = ? AND run = ? ORDER BY landing_number DESC LIMIT ?",
			[]sql.Value{sql.Text{S: repo}, sql.Text{S: run}, sql.Int{N: int64(landingsLimit)}},
		)
		for row in lRows {
			let tips = try decodeTags(try textAt(row, 3, "tips_json"))
			recent = recent.Append(orchestrate.LandingSummary{
				LandingNumber: try intAt(row, 0, "landing_number"),
				GroupID:       try textAt(row, 1, "group_id"),
				Head:          try textAt(row, 2, "head"),
				TipCount:      tips.Len(),
				Summary:       try textAt(row, 4, "summary"),
				LandedAt:      try textAt(row, 5, "landed_at"),
			})
		}
	}
	orchestrate.RunOverview{
		Repo:            repo,
		Run:             run,
		MainHead:        mainHead,
		OpenUnits:       openUnits,
		AcceptedUnits:   acceptedUnits,
		LandedUnits:     landedUnits,
		ClosedUnits:     closedUnits,
		TotalUnits:      totalUnits,
		OpenDecisions:   openDecisions,
		OpenQuestions:   openQuestions,
		OpenCommitments: openCommitments,
		RecentLandings:  recent,
	}
}

func queryUnitsTx(filter orchestrate.UnitFilter) orchestrate.UnitPage fails orchestrate.StoreFailed needs sql.Tx {
	let mut conds = []string{}
	let mut args = []sql.Value{}
	let (c1, a1) = appendCond(conds, args, filter.Repo, "u.repo = ?")
	let (c2, a2) = appendCond(c1, a1, filter.Run, "u.run = ?")
	conds = c2
	args = a2
	match filter.Status {
	case option.Some[orchestrate.UnitStatus] as st:
		conds = conds.Append("u.status = ?")
		args = args.Append(sql.Text{S: orchestrate.UnitStatusName(st.Value)})
	case option.None:
	}
	let where = buildWhere(conds)
	let total = try queryCountTx("SELECT COUNT(*) FROM units u"+where, args)
	if filter.Limit <= 0 || filter.Offset < 0 || filter.Offset >= total {
		return orchestrate.UnitPage{Items: []orchestrate.UnitSummary{}, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: false}
	}
	let queryArgs = args.Append(sql.Int{N: int64(filter.Limit)}).Append(sql.Int{N: int64(filter.Offset)})
	let rows = try queryTx(
			"SELECT u.repo, u.run, u.id, u.title, u.lane, u.branch, u.status, u.head, u.updated_at, "+
			"(SELECT COUNT(*) FROM receipts r WHERE r.repo = u.repo AND r.run = u.run AND r.unit_id = u.id) "+
			"FROM units u"+where+" ORDER BY u.repo ASC, u.run ASC, u.id ASC LIMIT ? OFFSET ?",
		queryArgs,
	)
	let mut items = []orchestrate.UnitSummary{}
	for row in rows {
		items = items.Append(try scanUnitSummary(row))
	}
	let hasMore = (filter.Offset + items.Len()) < total
	orchestrate.UnitPage{Items: items, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: hasMore}
}

func queryDecisionTx(repo string, run string, id string) option.Option[orchestrate.Decision] fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		"SELECT id, repo, run, category, scope, unit_id, title, body, status, supersedes, actor, created_at FROM decisions WHERE repo = ? AND run = ? AND id = ?",
