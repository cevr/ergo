func queryDecisionsTx(filter orchestrate.DecisionFilter) orchestrate.DecisionPage fails orchestrate.StoreFailed needs sql.Tx {
	let mut conds = []string{}
	let mut args = []sql.Value{}
	let (c1, a1) = appendCond(conds, args, filter.Repo, "repo = ?")
	let (c2, a2) = appendCond(c1, a1, filter.Run, "run = ?")
	let (c3, a3) = appendCond(c2, a2, filter.Category, "category = ?")
	let (c4, a4) = appendCond(c3, a3, filter.Scope, "scope = ?")
	let (c5, a5) = appendCond(c4, a4, filter.UnitID, "unit_id = ?")
	conds = c5
	args = a5
	match filter.Status {
	case option.Some[orchestrate.DecisionStatus] as st:
		conds = conds.Append("status = ?")
		args = args.Append(sql.Text{S: orchestrate.DecisionStatusName(st.Value)})
	case option.None:
	}
	let where = buildWhere(conds)
	let total = try queryCountTx("SELECT COUNT(*) FROM decisions"+where, args)
	if filter.Limit <= 0 || filter.Offset < 0 || filter.Offset >= total {
		return orchestrate.DecisionPage{Items: []orchestrate.Decision{}, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: false}
	}
	let queryArgs = args.Append(sql.Int{N: int64(filter.Limit)}).Append(sql.Int{N: int64(filter.Offset)})
	let rows = try queryTx(
			"SELECT id, repo, run, category, scope, unit_id, title, body, status, supersedes, actor, created_at FROM decisions"+
			where+" ORDER BY created_at DESC, repo ASC, run ASC, id ASC LIMIT ? OFFSET ?",
		queryArgs,
	)
	let mut items = []orchestrate.Decision{}
	for row in rows {
		items = items.Append(try scanDecision(row))
	}
	let hasMore = (filter.Offset + items.Len()) < total
	orchestrate.DecisionPage{Items: items, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: hasMore}
}

