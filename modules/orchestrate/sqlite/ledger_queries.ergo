func appendEventLogConds(
	conds []string,
	args []sql.Value,
	repo option.Option[string],
	run option.Option[string],
	kind option.Option[string],
	unitID option.Option[string],
	actor option.Option[string],
) ([]string, []sql.Value) {
	let (c1, a1) = appendCond(conds, args, repo, "repo = ?")
	let (c2, a2) = appendCond(c1, a1, run, "run = ?")
	let (c3, a3) = appendCond(c2, a2, kind, "kind = ?")
	let (c4, a4) = appendCond(c3, a3, unitID, "unit_id = ?")
	appendCond(c4, a4, actor, "actor = ?")
}

func queryEventLogTx(filter orchestrate.EventLogFilter) orchestrate.EventPage fails orchestrate.StoreFailed needs sql.Tx {
	let (conds, args) = appendEventLogConds([]string{}, []sql.Value{}, filter.Repo, filter.Run, filter.Kind, filter.UnitID, filter.Actor)
	let where = buildWhere(conds)
	let total = try queryCountTx("SELECT COUNT(*) FROM event_log"+where, args)
	if filter.Limit <= 0 || filter.Offset < 0 || filter.Offset >= total {
		return orchestrate.EventPage{Items: []orchestrate.LedgerEvent{}, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: false}
	}
	let orderClause = if filter.Ascending { " ORDER BY id ASC" } else { " ORDER BY id DESC" }
	let queryArgs = args.Append(sql.Int{N: int64(filter.Limit)}).Append(sql.Int{N: int64(filter.Offset)})
	let rows = try queryTx(
			"SELECT id, repo, run, kind, unit_id, summary, actor, created_at, source_key FROM event_log"+
			where+orderClause+" LIMIT ? OFFSET ?",
		queryArgs,
	)
	let mut items = []orchestrate.LedgerEvent{}
	for row in rows {
		items = items.Append(try scanLedgerEvent(row))
	}
	let hasMore = (filter.Offset + items.Len()) < total
	orchestrate.EventPage{Items: items, Total: total, Limit: filter.Limit, Offset: filter.Offset, HasMore: hasMore}
}

func queryEventLogSinceTx(filter orchestrate.EventLogSinceFilter) orchestrate.EventPage fails orchestrate.StoreFailed needs sql.Tx {
	let (conds, args) = appendEventLogConds(
		[]string{"id > ?"},
		[]sql.Value{sql.Int{N: int64(filter.SinceID)}},
		filter.Repo,
		filter.Run,
		filter.Kind,
		filter.UnitID,
		filter.Actor,
	)
	let where = buildWhere(conds)
	let total = try queryCountTx("SELECT COUNT(*) FROM event_log"+where, args)
	if filter.Limit <= 0 || total == 0 {
		return orchestrate.EventPage{Items: []orchestrate.LedgerEvent{}, Total: total, Limit: filter.Limit, Offset: 0, HasMore: false}
	}
	let queryArgs = args.Append(sql.Int{N: int64(filter.Limit)})
	let rows = try queryTx(
			"SELECT id, repo, run, kind, unit_id, summary, actor, created_at, source_key FROM event_log"+
			where+" ORDER BY id ASC LIMIT ?",
		queryArgs,
	)
	let mut items = []orchestrate.LedgerEvent{}
	for row in rows {
		items = items.Append(try scanLedgerEvent(row))
	}
	let hasMore = items.Len() < total
	orchestrate.EventPage{Items: items, Total: total, Limit: filter.Limit, Offset: 0, HasMore: hasMore}
}

func scanRunMeta(row sql.Row) orchestrate.RunMeta fails orchestrate.StoreFailed {
	orchestrate.RunMeta{
		Repo:      try textAt(row, 0, "repo"),
		Run:       try textAt(row, 1, "run"),
		MainHead:  try optTextAt(row, 2, "main_head"),
		UpdatedAt: try textAt(row, 3, "updated_at"),
	}
}

func scanUnitSummary(row sql.Row) orchestrate.UnitSummary fails orchestrate.StoreFailed {
	let statusText = try textAt(row, 6, "status")
	let status = match orchestrate.ParseUnitStatus(statusText) {
	case option.Some[orchestrate.UnitStatus] as st:
		st.Value
	case option.None:
		return orchestrate.StoreFailed{Reason: "invalid stored unit status: " + statusText}
	}
	orchestrate.UnitSummary{
		Key:          orchestrate.UnitKey{Repo: try textAt(row, 0, "repo"), Run: try textAt(row, 1, "run"), ID: try textAt(row, 2, "id")},
		Title:        try textAt(row, 3, "title"),
		Lane:         try optTextAt(row, 4, "lane"),
		Branch:       try optTextAt(row, 5, "branch"),
		Status:       status,
		Head:         try optTextAt(row, 7, "head"),
		UpdatedAt:    try textAt(row, 8, "updated_at"),
		ReceiptCount: try intAt(row, 9, "receipt_count"),
	}
}

func scanDecision(row sql.Row) orchestrate.Decision fails orchestrate.StoreFailed {
	let statusText = try textAt(row, 8, "status")
	let status = match orchestrate.ParseDecisionStatus(statusText) {
	case option.Some[orchestrate.DecisionStatus] as st:
		st.Value
	case option.None:
		return orchestrate.StoreFailed{Reason: "invalid stored decision status: " + statusText}
	}
	orchestrate.Decision{
		ID:         try textAt(row, 0, "id"),
		Repo:       try textAt(row, 1, "repo"),
		Run:        try textAt(row, 2, "run"),
		Category:   try textAt(row, 3, "category"),
		Scope:      try textAt(row, 4, "scope"),
		UnitID:     try optTextAt(row, 5, "unit_id"),
		Title:      try textAt(row, 6, "title"),
		Body:       try textAt(row, 7, "body"),
		Status:     status,
		Supersedes: try optTextAt(row, 9, "supersedes"),
		Actor:      try textAt(row, 10, "actor"),
		CreatedAt:  try textAt(row, 11, "created_at"),
	}
}

func scanLanding(row sql.Row) orchestrate.Landing fails orchestrate.StoreFailed {
	orchestrate.Landing{
		Repo:          try textAt(row, 0, "repo"),
		Run:           try textAt(row, 1, "run"),
		LandingNumber: try intAt(row, 2, "landing_number"),
		GroupID:       try textAt(row, 3, "group_id"),
		Head:          try textAt(row, 4, "head"),
		Tips:          try decodeTags(try textAt(row, 5, "tips_json")),
		Summary:       try textAt(row, 6, "summary"),
		LogPath:       try optTextAt(row, 7, "log_path"),
		LandedAt:      try textAt(row, 8, "landed_at"),
	}
}

func scanLedgerEvent(row sql.Row) orchestrate.LedgerEvent fails orchestrate.StoreFailed {
	orchestrate.LedgerEvent{
		ID:        try intAt(row, 0, "id"),
		Repo:      try textAt(row, 1, "repo"),
		Run:       try textAt(row, 2, "run"),
		Kind:      try textAt(row, 3, "kind"),
		UnitID:    try optTextAt(row, 4, "unit_id"),
		Summary:   try textAt(row, 5, "summary"),
		Actor:     try textAt(row, 6, "actor"),
		CreatedAt: try textAt(row, 7, "created_at"),
		SourceKey: try optTextAt(row, 8, "source_key"),
	}
}
