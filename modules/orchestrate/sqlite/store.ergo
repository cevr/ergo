import github.com/cevr/ergo/modules/orchestrate/orchestrate
import github.com/cevr/ergo/modules/sqlite/sqlite
import go os
import option
import sql
import sync

// Store is a transactional SQLite provider of orchestrate.Store writing events,
// projections, and receipts atomically inside one BEGIN IMMEDIATE transaction.
type Store { db option.Option[sqlite.DB], err string } implements orchestrate.Store

// WALStore is a file-backed WAL SQLite provider of orchestrate.Store used to run
// Store contract laws natively over real WAL files on disk.
type WALStore { db option.Option[sqlite.DB], err string } implements orchestrate.Store

// Open opens or initializes a file-backed WAL SQLite orchestrate Store at path,
// enforcing CurrentSchemaVersion before accepting any writes.
func Open(path string) Store fails orchestrate.StoreFailed needs go.Foreign {
	let db = sqlite.Open(path) catch {
	case sql.Unique as e:
		return orchestrate.StoreFailed{Reason: "open unique: " + e.Constraint}
	case sql.Serialization as e:
		return orchestrate.StoreFailed{Reason: "open busy: " + e.Message}
	case sql.Deadlock as e:
		return orchestrate.StoreFailed{Reason: "open deadlock: " + e.Message}
	case sql.Timeout as e:
		return orchestrate.StoreFailed{Reason: "open timeout: " + e.Message}
	case sql.Closed as e:
		return orchestrate.StoreFailed{Reason: "open closed: " + e.Message}
	case sql.Other as e:
		return orchestrate.StoreFailed{Reason: "open failed: " + e.Message}
	}
	try initStore(db)
}

// OpenMemory opens a private in-memory SQLite orchestrate Store.
func OpenMemory() Store fails orchestrate.StoreFailed needs go.Foreign {
	try Open(":memory:")
}

// NewStore opens a fresh in-memory SQLite Store for native contract-law runs.
func NewStore() Store needs go.Foreign {
	OpenMemory() catch {
	case orchestrate.StoreFailed as e:
		Store{db: option.None, err: e.Reason}
	}
}

// NewWALStore opens a fresh file-backed WAL SQLite Store for native contract-law runs.
func NewWALStore() WALStore needs go.Foreign {
	let st = openLawFileWAL() catch {
	case orchestrate.StoreFailed as e:
		Store{db: option.None, err: e.Reason}
	}
	WALStore{db: st.db, err: st.err}
}

// Close closes the underlying SQLite connection pool.
func Close(s Store) fails orchestrate.StoreFailed needs go.Foreign {
	let db = try openDB(s.db, s.err)
	db.Close() catch {
	case sql.Closed as e:
		return orchestrate.StoreFailed{Reason: "close closed: " + e.Message}
	case sql.Other as e:
		return orchestrate.StoreFailed{Reason: "close failed: " + e.Message}
	}
}

func openDB(opt option.Option[sqlite.DB], err string) sqlite.DB fails orchestrate.StoreFailed {
	match opt {
	case option.Some[sqlite.DB] as d:
		d.Value
	case option.None:
		orchestrate.StoreFailed{Reason: err}
	}
}

func initStore(db sqlite.DB) Store fails orchestrate.StoreFailed needs go.Foreign {
	let _ = with context { sql.DB: db } {
		sqlite.WriteTransaction() {
			try initSchema()
			true
		}
	} catch {
	case orchestrate.StoreFailed as e:
		closeIgnoring(db)
		return e
	case sql.Unique as e:
		closeIgnoring(db)
		return orchestrate.StoreFailed{Reason: "init unique: " + e.Constraint}
	case sql.Serialization as e:
		closeIgnoring(db)
		return orchestrate.StoreFailed{Reason: "init busy: " + e.Message}
	case sql.Deadlock as e:
		closeIgnoring(db)
		return orchestrate.StoreFailed{Reason: "init deadlock: " + e.Message}
	case sql.Timeout as e:
		closeIgnoring(db)
		return orchestrate.StoreFailed{Reason: "init timeout: " + e.Message}
	case sql.Closed as e:
		closeIgnoring(db)
		return orchestrate.StoreFailed{Reason: "init closed: " + e.Message}
	case sql.Other as e:
		closeIgnoring(db)
		return orchestrate.StoreFailed{Reason: "init failed: " + e.Message}
	}
	Store{db: option.Some[sqlite.DB]{Value: db}, err: ""}
}

func closeIgnoring(db sqlite.DB) needs go.Foreign {
	db.Close() catch {
	case sql.Closed, sql.Other:
	}
}

func executeOn(opt option.Option[sqlite.DB], err string, env orchestrate.Envelope) orchestrate.ExecuteResult fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed needs go.Foreign {
	let db = try openDB(opt, err)
	with context { sql.DB: db } {
		sqlite.WriteTransaction() {
			try executeTx(env)
		}
	} catch {
	case orchestrate.NotFound as e:
		return e
	case orchestrate.AlreadyExists as e:
		return e
	case orchestrate.InvalidTransition as e:
		return e
	case orchestrate.Unverified as e:
		return e
	case orchestrate.NotAcceptedHead as e:
		return e
	case orchestrate.CommandReused as e:
		return e
	case orchestrate.InvalidInput as e:
		return e
	case orchestrate.StoreFailed as e:
		return e
	case sql.Unique as e:
		return orchestrate.StoreFailed{Reason: "tx unique: " + e.Constraint}
	case sql.Serialization as e:
		return orchestrate.StoreFailed{Reason: "tx busy: " + e.Message}
	case sql.Deadlock as e:
		return orchestrate.StoreFailed{Reason: "tx deadlock: " + e.Message}
	case sql.Timeout as e:
		return orchestrate.StoreFailed{Reason: "tx timeout: " + e.Message}
	case sql.Closed as e:
		return orchestrate.StoreFailed{Reason: "tx closed: " + e.Message}
	case sql.Other as e:
		return orchestrate.StoreFailed{Reason: "tx failed: " + e.Message}
	}
}

// Execute runs pure orchestrate.Decide and persists all emitted events and projection
// rows atomically inside one BEGIN IMMEDIATE SQLite transaction.
func Execute(s Store, env orchestrate.Envelope) orchestrate.ExecuteResult fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed needs go.Foreign {
	try executeOn(s.db, s.err, env)
}

// Execute runs pure orchestrate.Decide and persists all emitted events and projection
// rows atomically inside one BEGIN IMMEDIATE SQLite WAL transaction.
func Execute(w WALStore, env orchestrate.Envelope) orchestrate.ExecuteResult fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed needs go.Foreign {
	try executeOn(w.db, w.err, env)
}

func executeTx(env orchestrate.Envelope) orchestrate.ExecuteResult fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead | orchestrate.StoreFailed needs sql.Tx {
	let payloadJSON = encodeCommand(env.Command)
	let digest = commandDigest(payloadJSON)
	let seenRows = try queryTx(
		"SELECT payload_digest, payload_json FROM commands WHERE command_id = ?",
		[]sql.Value{sql.Text{S: string(env.ID)}},
	)
	if seenRows.Len() > 0 {
		let storedDigest = try textAt(seenRows[0], 0, "payload_digest")
		let storedJSON = try textAt(seenRows[0], 1, "payload_json")
		if storedDigest == digest && storedJSON == payloadJSON {
			let curSeq = try lastSeqTx()
			return orchestrate.ExecuteResult{Seq: curSeq, Events: []orchestrate.Event{}, Duplicate: true}
		}
		return orchestrate.CommandReused{ID: env.ID}
	}
	let state = try loadScopeTx(env)
	let events = try decideForTx(state, env)
	let mut seq = try lastSeqTx()
	for ev in events {
		seq = seq + 1
		let _ = try execTx(
			"INSERT INTO events (seq, command_id, payload_digest, event_json) VALUES (?, ?, ?, ?)",
			[]sql.Value{
				sql.Int{N: int64(seq)},
				sql.Text{S: string(env.ID)},
				sql.Text{S: digest},
				sql.Text{S: encodeEvent(ev)},
			},
		)
		try applyEventSQL(ev, seq)
	}
	orchestrate.ExecuteResult{Seq: seq, Events: events, Duplicate: events.Len() == 0}
}

func decideForTx(state orchestrate.State, env orchestrate.Envelope) []orchestrate.Event fails orchestrate.NotFound | orchestrate.AlreadyExists | orchestrate.InvalidTransition | orchestrate.CommandReused | orchestrate.InvalidInput | orchestrate.Unverified | orchestrate.NotAcceptedHead {
	orchestrate.Decide(state, env) catch {
	case orchestrate.NotFound as e:
		return e
	case orchestrate.AlreadyExists as e:
		return e
	case orchestrate.InvalidTransition as e:
		return e
	case orchestrate.Unverified as e:
		return e
	case orchestrate.NotAcceptedHead as e:
		return e
	case orchestrate.CommandReused as e:
		return e
	case orchestrate.InvalidInput as e:
		return e
	}
}

func lastSeqTx() int fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx("SELECT COALESCE(MAX(seq), 0) FROM events", []sql.Value{})
	if rows.Len() == 0 {
		return 0
	}
	try intAt(rows[0], 0, "seq")
}

func readOn[T](opt option.Option[sqlite.DB], err string, body func() T fails orchestrate.StoreFailed needs sql.Tx) T fails orchestrate.StoreFailed needs go.Foreign {
	let db = try openDB(opt, err)
	with context { sql.DB: sqlite.ReadOnly(db) } {
		sql.Transaction() {
			try body()
		}
	} catch {
	case orchestrate.StoreFailed as e:
		return e
	case sql.Unique as e:
		return orchestrate.StoreFailed{Reason: "read unique: " + e.Constraint}
	case sql.Serialization as e:
		return orchestrate.StoreFailed{Reason: "read busy: " + e.Message}
	case sql.Deadlock as e:
		return orchestrate.StoreFailed{Reason: "read deadlock: " + e.Message}
	case sql.Timeout as e:
		return orchestrate.StoreFailed{Reason: "read timeout: " + e.Message}
	case sql.Closed as e:
		return orchestrate.StoreFailed{Reason: "read closed: " + e.Message}
	case sql.Other as e:
		return orchestrate.StoreFailed{Reason: "read failed: " + e.Message}
	}
}

// Snapshot reads the complete projected State from the SQLite projection tables in one read transaction.
func Snapshot(s Store) orchestrate.State fails orchestrate.StoreFailed needs go.Foreign {
	try readOn(s.db, s.err, func() orchestrate.State fails orchestrate.StoreFailed needs sql.Tx { try loadStateTx() })
}

// Snapshot reads the complete projected State from the WAL SQLite projection tables in one read transaction.
func Snapshot(w WALStore) orchestrate.State fails orchestrate.StoreFailed needs go.Foreign {
	try readOn(w.db, w.err, func() orchestrate.State fails orchestrate.StoreFailed needs sql.Tx { try loadStateTx() })
}

// Events reads all persisted events with Seq > fromSeq in ascending order.
func Events(s Store, fromSeq int) []orchestrate.StoredEvent fails orchestrate.StoreFailed needs go.Foreign {
	try readOn(s.db, s.err, func() []orchestrate.StoredEvent fails orchestrate.StoreFailed needs sql.Tx { try queryEventsTx(fromSeq) })
}

// Events reads all persisted WAL events with Seq > fromSeq in ascending order.
func Events(w WALStore, fromSeq int) []orchestrate.StoredEvent fails orchestrate.StoreFailed needs go.Foreign {
	try readOn(w.db, w.err, func() []orchestrate.StoredEvent fails orchestrate.StoreFailed needs sql.Tx { try queryEventsTx(fromSeq) })
}

