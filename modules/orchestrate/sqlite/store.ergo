let prevLawDB = sync.NewRef[option.Option[Store]](option.None)

let lawWALDir = sync.NewRef("")

func cleanFile(dir string, name string) needs go.Foreign {
	let root = os.OpenRoot(dir) catch {
	case go.Error:
		return
	}
	root.Remove(name) catch {
	case go.Error:
	}
	root.Close() catch {
	case go.Error:
	}
}

func freshWALDir() string fails orchestrate.StoreFailed needs go.Foreign {
	let existing = lawWALDir.Get()
	if existing != "" {
		return existing
	}
	let dir = os.MkdirTemp("", "orch-sqlite-wal-*") catch {
	case go.Error as e:
		return orchestrate.StoreFailed{Reason: "mkdirtemp: " + e.Text}
	}
	lawWALDir.Set(dir)
	dir
}

func resetStoreData(st Store) Store fails orchestrate.StoreFailed needs go.Foreign {
	let db = try openDB(st.db, st.err)
	let _ = with context { sql.DB: db } {
		sqlite.WriteTransaction() {
			let stmts = []string{
				"DELETE FROM receipts",
				"DELETE FROM units",
				"DELETE FROM commitments",
				"DELETE FROM queue",
				"DELETE FROM questions",
				"DELETE FROM run_meta",
				"DELETE FROM decisions",
				"DELETE FROM landings",
				"DELETE FROM event_log",
				"DELETE FROM events",
				"DELETE FROM commands",
				"UPDATE schema_meta SET next_question_id = 1, next_event_id = 1 WHERE id = 1",
			}
			for stmt in stmts {
				let _ = try execTx(stmt, []sql.Value{})
			}
			true
		}
	} catch {
	case orchestrate.StoreFailed as e:
		return e
	case sql.Unique as e:
		return orchestrate.StoreFailed{Reason: "reset unique: " + e.Constraint}
	case sql.Serialization as e:
		return orchestrate.StoreFailed{Reason: "reset busy: " + e.Message}
	case sql.Deadlock as e:
		return orchestrate.StoreFailed{Reason: "reset deadlock: " + e.Message}
	case sql.Timeout as e:
		return orchestrate.StoreFailed{Reason: "reset timeout: " + e.Message}
	case sql.Closed as e:
		return orchestrate.StoreFailed{Reason: "reset closed: " + e.Message}
	case sql.Other as e:
		return orchestrate.StoreFailed{Reason: "reset failed: " + e.Message}
	}
	st
}

func openLawFileWAL() Store fails orchestrate.StoreFailed needs go.Foreign {
	match prevLawDB.Get() {
	case option.Some[Store] as existing:
		return try resetStoreData(existing.Value)
	case option.None:
	}
	let dir = try freshWALDir()
	cleanFile(dir, "law.db")
	cleanFile(dir, "law.db-wal")
	cleanFile(dir, "law.db-shm")
	let st = try Open(dir + "/law.db")
	prevLawDB.Set(option.Some[Store]{Value: st})
	st
}
