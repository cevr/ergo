import github.com/cevr/ergo/modules/orchestrate/orchestrate
import option
import sql

func applyEventSQL(ev orchestrate.Event, seq int) fails orchestrate.StoreFailed needs sql.Tx {
	match ev {
	case orchestrate.CommandAccepted as e:
		let payloadJSON = encodeCommand(e.Command)
		let digest = commandDigest(payloadJSON)
		let _ = try execTx(
			"INSERT INTO commands (command_id, actor, at, payload_json, payload_digest) VALUES (?, ?, ?, ?, ?)",
			[]sql.Value{
				sql.Text{S: string(e.ID)},
				sql.Text{S: e.Actor},
				sql.Text{S: e.At},
				sql.Text{S: payloadJSON},
				sql.Text{S: digest},
			},
		)
	case orchestrate.UnitOpened as e:
		let _ = try execTx(
			"INSERT INTO units (repo, run, id, title, requires_json, lane, branch, status, head, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, 'open', NULL, ?, ?)",
			[]sql.Value{
				sql.Text{S: e.Key.Repo},
				sql.Text{S: e.Key.Run},
				sql.Text{S: e.Key.ID},
				sql.Text{S: e.Title},
				sql.Text{S: encodeTags(e.Requires)},
				optTextVal(e.Lane),
				optTextVal(e.Branch),
				sql.Text{S: e.At},
				sql.Text{S: e.At},
			},
		)
	case orchestrate.ReceiptRecorded as e:
		let r = e.Receipt
		let _ = try execTx(
			"INSERT INTO receipts (id, seq_order, repo, run, unit_id, kind, command, head, exit_code, exit_lines, recorded_at, recorded_by) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
			[]sql.Value{
				sql.Text{S: r.ID},
				sql.Int{N: int64(seq)},
				sql.Text{S: r.Unit.Repo},
				sql.Text{S: r.Unit.Run},
				sql.Text{S: r.Unit.ID},
				sql.Text{S: r.Kind},
				sql.Text{S: r.Command},
				sql.Text{S: r.Head},
				sql.Int{N: int64(r.ExitCode)},
				sql.Text{S: r.ExitLines},
				sql.Text{S: r.RecordedAt},
				sql.Text{S: r.RecordedBy},
			},
		)
	case orchestrate.UnitWasAccepted as e:
		try setUnitStatusTx(e.Unit, "accepted", sql.Text{S: e.Head}, e.At)
	case orchestrate.UnitWasLanded as e:
		try setUnitStatusTx(e.Unit, "landed", sql.Text{S: e.Head}, e.At)
	case orchestrate.UnitWasClosed as e:
		let _ = try execTx(
			"UPDATE units SET status = 'closed', updated_at = ? WHERE repo = ? AND run = ? AND id = ?",
			[]sql.Value{sql.Text{S: e.At}, sql.Text{S: e.Unit.Repo}, sql.Text{S: e.Unit.Run}, sql.Text{S: e.Unit.ID}},
		)
	case orchestrate.CommitmentAdded as e:
		let _ = try execTx(
			"INSERT INTO commitments (id, title, kind, status, owner, lane, landed_sha, decision_note, created_at, updated_at) VALUES (?, ?, ?, 'open', NULL, NULL, NULL, NULL, ?, ?)",
			[]sql.Value{
				sql.Text{S: e.ID},
				sql.Text{S: e.Title},
				sql.Text{S: e.Kind},
				sql.Text{S: e.At},
				sql.Text{S: e.At},
			},
		)
	case orchestrate.CommitmentWasAssigned as e:
		let _ = try execTx(
			"UPDATE commitments SET status = 'assigned', owner = ?, lane = ?, updated_at = ? WHERE id = ?",
			[]sql.Value{
				sql.Text{S: e.Owner},
				sql.Text{S: e.Lane},
				sql.Text{S: e.At},
				sql.Text{S: e.ID},
			},
		)
	case orchestrate.CommitmentWasLanded as e:
		let _ = try execTx(
			"UPDATE commitments SET status = 'landed', landed_sha = ?, updated_at = ? WHERE id = ?",
			[]sql.Value{
				sql.Text{S: e.LandedSHA},
				sql.Text{S: e.At},
				sql.Text{S: e.ID},
			},
		)
	case orchestrate.CommitmentWasDecided as e:
		let _ = try execTx(
			"UPDATE commitments SET status = 'decided', decision_note = ?, updated_at = ? WHERE id = ?",
			[]sql.Value{
				sql.Text{S: e.Note},
				sql.Text{S: e.At},
				sql.Text{S: e.ID},
			},
		)
	case orchestrate.CommitmentWasWithdrawn as e:
		let _ = try execTx(
			"UPDATE commitments SET status = 'withdrawn', decision_note = ?, updated_at = ? WHERE id = ?",
			[]sql.Value{
				sql.Text{S: e.Note},
				sql.Text{S: e.At},
				sql.Text{S: e.ID},
			},
		)
	case orchestrate.QueueUpserted as e:
		let item = e.Item
		let _ = try execTx(
			"INSERT INTO queue (key, priority, title, body, status, tags_json, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?) ON CONFLICT(key) DO UPDATE SET priority = excluded.priority, title = excluded.title, body = excluded.body, status = excluded.status, tags_json = excluded.tags_json, updated_at = excluded.updated_at",
			[]sql.Value{
				sql.Text{S: item.Key},
				sql.Int{N: int64(item.Priority)},
				sql.Text{S: item.Title},
				sql.Text{S: item.Body},
				sql.Text{S: item.Status},
				sql.Text{S: encodeTags(item.Tags)},
				sql.Text{S: item.UpdatedAt},
			},
		)
	case orchestrate.QueueRemoved as e:
		let _ = try execTx("DELETE FROM queue WHERE key = ?", []sql.Value{sql.Text{S: e.Key}})
	case orchestrate.QuestionAsked as e:
		let q = e.Question
		let _ = try execTx(
			"INSERT INTO questions (id, command_id, prompt, assumption, concrete_action, status, answer, asked_by, asked_at, answered_by, answered_at) VALUES (?, ?, ?, ?, ?, 'open', NULL, ?, ?, NULL, NULL)",
			[]sql.Value{
				sql.Int{N: int64(q.ID)},
				sql.Text{S: string(e.CommandID)},
				sql.Text{S: q.Prompt},
				sql.Text{S: q.Assumption},
				sql.Text{S: q.ConcreteAction},
				sql.Text{S: q.AskedBy},
				sql.Text{S: q.AskedAt},
			},
		)
		let _ = try execTx(
			"UPDATE schema_meta SET next_question_id = CASE WHEN next_question_id <= ? THEN ? ELSE next_question_id END WHERE id = 1",
			[]sql.Value{
				sql.Int{N: int64(q.ID)},
				sql.Int{N: int64(q.ID + 1)},
			},
		)
	case orchestrate.QuestionWasAnswered as e:
		let _ = try execTx(
			"UPDATE questions SET status = 'answered', answer = ?, answered_by = ?, answered_at = ? WHERE id = ?",
			[]sql.Value{
				sql.Text{S: e.Answer},
				sql.Text{S: e.AnsweredBy},
				sql.Text{S: e.AnsweredAt},
				sql.Int{N: int64(e.ID)},
			},
		)
	case orchestrate.QuestionWasWithdrawn as e:
		let _ = try execTx(
			"UPDATE questions SET status = 'withdrawn', answer = ?, answered_by = ?, answered_at = ? WHERE id = ?",
			[]sql.Value{
				optTextVal(e.Answer),
				sql.Text{S: e.AnsweredBy},
				sql.Text{S: e.AnsweredAt},
				sql.Int{N: int64(e.ID)},
			},
		)
	case orchestrate.RunHeadUpdated as e:
		let _ = try execTx(
			"INSERT INTO run_meta (repo, run, main_head, updated_at) VALUES (?, ?, ?, ?) ON CONFLICT(repo, run) DO UPDATE SET main_head = excluded.main_head, updated_at = excluded.updated_at",
			[]sql.Value{
				sql.Text{S: e.Repo},
				sql.Text{S: e.Run},
				sql.Text{S: e.Head},
				sql.Text{S: e.UpdatedAt},
			},
		)
	case orchestrate.UnitOwnerChanged as e:
		let _ = try execTx(
			"UPDATE units SET owner = ?, updated_at = ? WHERE repo = ? AND run = ? AND id = ?",
			[]sql.Value{sql.Text{S: e.To}, sql.Text{S: e.At}, sql.Text{S: e.Unit.Repo}, sql.Text{S: e.Unit.Run}, sql.Text{S: e.Unit.ID}},
		)
	case orchestrate.LandingLeaseTaken as e:
		let l = e.Lease
		let _ = try execTx(
			"UPDATE run_meta SET lease_actor = ?, lease_base_head = ?, lease_since = ?, lease_until = ? WHERE repo = ? AND run = ?",
			[]sql.Value{sql.Text{S: l.Actor}, sql.Text{S: l.BaseHead}, sql.Text{S: l.Since}, sql.Text{S: l.Until}, sql.Text{S: l.Repo}, sql.Text{S: l.Run}},
		)
	case orchestrate.LandingLeaseTakenOver:
	case orchestrate.LandingLeaseEnded as e:
		let _ = try execTx("UPDATE run_meta SET lease_actor = NULL, lease_base_head = NULL, lease_since = NULL, lease_until = NULL WHERE repo = ? AND run = ?", []sql.Value{sql.Text{S: e.Repo}, sql.Text{S: e.Run}})
	case orchestrate.DecisionRecorded as e:
		let d = e.Decision
		let childRows = try queryTx(
			"SELECT 1 FROM decisions WHERE repo = ? AND run = ? AND supersedes = ? LIMIT 1",
			[]sql.Value{sql.Text{S: d.Repo}, sql.Text{S: d.Run}, sql.Text{S: d.ID}},
		)
		let effectiveStatus = if childRows.Len() > 0 { "superseded" } else { orchestrate.DecisionStatusName(d.Status) }
		let _ = try execTx(
			"INSERT INTO decisions (repo, run, id, category, scope, unit_id, title, body, status, supersedes, actor, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(repo, run, id) DO UPDATE SET category = excluded.category, scope = excluded.scope, unit_id = excluded.unit_id, title = excluded.title, body = excluded.body, status = CASE WHEN decisions.status = 'superseded' THEN 'superseded' ELSE excluded.status END, supersedes = excluded.supersedes, actor = excluded.actor",
			[]sql.Value{
				sql.Text{S: d.Repo},
				sql.Text{S: d.Run},
				sql.Text{S: d.ID},
				sql.Text{S: d.Category},
				sql.Text{S: d.Scope},
				optTextVal(d.UnitID),
				sql.Text{S: d.Title},
				sql.Text{S: d.Body},
				sql.Text{S: effectiveStatus},
				optTextVal(d.Supersedes),
				sql.Text{S: d.Actor},
				sql.Text{S: d.CreatedAt},
			},
		)
		match d.Supersedes {
		case option.Some[string] as target:
			let _ = try execTx(
				"UPDATE decisions SET status = 'superseded' WHERE repo = ? AND run = ? AND id = ?",
				[]sql.Value{sql.Text{S: d.Repo}, sql.Text{S: d.Run}, sql.Text{S: target.Value}},
			)
		case option.None:
		}
	case orchestrate.LandingRecorded as e:
		let l = e.Landing
		let _ = try execTx(
			"INSERT INTO landings (repo, run, landing_number, group_id, head, tips_json, summary, log_path, landed_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(repo, run, landing_number) DO UPDATE SET group_id = excluded.group_id, head = excluded.head, tips_json = excluded.tips_json, summary = excluded.summary, log_path = excluded.log_path, landed_at = excluded.landed_at",
			[]sql.Value{
				sql.Text{S: l.Repo},
				sql.Text{S: l.Run},
				sql.Int{N: int64(l.LandingNumber)},
				sql.Text{S: l.GroupID},
				sql.Text{S: l.Head},
				sql.Text{S: encodeTags(l.Tips)},
				sql.Text{S: l.Summary},
				optTextVal(l.LogPath),
				sql.Text{S: l.LandedAt},
			},
		)
	case orchestrate.LedgerEventAppended as e:
		let entry = e.Event
		let _ = try execTx(
			"INSERT INTO event_log (id, repo, run, kind, unit_id, summary, actor, created_at, source_key) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
			[]sql.Value{
				sql.Int{N: int64(entry.ID)},
				sql.Text{S: entry.Repo},
				sql.Text{S: entry.Run},
				sql.Text{S: entry.Kind},
				optTextVal(entry.UnitID),
				sql.Text{S: entry.Summary},
				sql.Text{S: entry.Actor},
				sql.Text{S: entry.CreatedAt},
				optTextVal(entry.SourceKey),
			},
		)
		let _ = try execTx(
			"UPDATE schema_meta SET next_event_id = CASE WHEN next_event_id <= ? THEN ? ELSE next_event_id END WHERE id = 1",
			[]sql.Value{
				sql.Int{N: int64(entry.ID)},
				sql.Int{N: int64(entry.ID + 1)},
			},
		)
	}
}

func setUnitStatusTx(key orchestrate.UnitKey, status string, head sql.Value, at string) fails orchestrate.StoreFailed needs sql.Tx {
	let _ = try execTx(
		"UPDATE units SET status = ?, head = ?, updated_at = ? WHERE repo = ? AND run = ? AND id = ?",
		[]sql.Value{sql.Text{S: status}, head, sql.Text{S: at}, sql.Text{S: key.Repo}, sql.Text{S: key.Run}, sql.Text{S: key.ID}},
	)
}

let unitColumns = "SELECT repo, run, id, title, requires_json, lane, branch, status, head, created_at, updated_at, owner FROM units"

let receiptColumns = "SELECT id, repo, run, unit_id, kind, command, head, exit_code, exit_lines, recorded_at, recorded_by FROM receipts"

func loadStateTx() orchestrate.State fails orchestrate.StoreFailed needs sql.Tx {
	let mut units = Map[orchestrate.UnitKey, orchestrate.Unit]{}
	for row in try queryTx(unitColumns+" ORDER BY repo, run, id", []sql.Value{}) {
		let u = try scanUnit(row)
		units = units.Put(u.Key, u)
	}
	let mut receipts = Map[string, orchestrate.Receipt]{}
	let mut receiptOrder = []string{}
	for row in try queryTx(receiptColumns+" ORDER BY seq_order ASC", []sql.Value{}) {
		let r = try scanReceipt(row)
		receipts = receipts.Put(r.ID, r)
		receiptOrder = receiptOrder.Append(r.ID)
	}
	let mut commitments = Map[string, orchestrate.Commitment]{}
	for c in try queryCommitmentsTx(option.None, option.None) {
		commitments = commitments.Put(c.ID, c)
	}
	let mut queue = Map[string, orchestrate.QueueItem]{}
	for item in try queryQueueTx(option.None) {
		queue = queue.Put(item.Key, item)
	}
	let mut questions = Map[int, orchestrate.Question]{}
	let mut questionByCommand = Map[orchestrate.CommandID, int]{}
	let qRows = try queryTx(
		"SELECT id, command_id, prompt, assumption, concrete_action, status, answer, asked_by, asked_at, answered_by, answered_at FROM questions ORDER BY id ASC",
		[]sql.Value{},
	)
	for row in qRows {
		let q = try scanQuestionWithCmd(row)
		let cmdID = orchestrate.CommandID(try textAt(row, 1, "command_id"))
		questions = questions.Put(q.ID, q)
		questionByCommand = questionByCommand.Put(cmdID, q.ID)
	}
	let mut runMetas = Map[orchestrate.RunKey, orchestrate.RunMeta]{}
	for row in try queryTx("SELECT repo, run, main_head, updated_at FROM run_meta", []sql.Value{}) {
		let m = try scanRunMeta(row)
		runMetas = runMetas.Put(orchestrate.RunKey{Repo: m.Repo, Run: m.Run}, m)
	}
	let mut decisions = Map[orchestrate.DecisionKey, orchestrate.Decision]{}
	for row in try queryTx("SELECT id, repo, run, category, scope, unit_id, title, body, status, supersedes, actor, created_at FROM decisions", []sql.Value{}) {
		let d = try scanDecision(row)
		decisions = decisions.Put(orchestrate.DecisionKey{Repo: d.Repo, Run: d.Run, ID: d.ID}, d)
	}
	let mut landings = Map[orchestrate.LandingKey, orchestrate.Landing]{}
	for row in try queryTx("SELECT repo, run, landing_number, group_id, head, tips_json, summary, log_path, landed_at FROM landings", []sql.Value{}) {
		let l = try scanLanding(row)
		landings = landings.Put(orchestrate.LandingKey{Repo: l.Repo, Run: l.Run, LandingNumber: l.LandingNumber}, l)
	}
	let mut eventLog = []orchestrate.LedgerEvent{}
	let mut eventSourceKeys = Map[orchestrate.EventSourceKey, int]{}
	for row in try queryTx("SELECT id, repo, run, kind, unit_id, summary, actor, created_at, source_key FROM event_log ORDER BY id ASC", []sql.Value{}) {
		let ev = try scanLedgerEvent(row)
		eventLog = eventLog.Append(ev)
		match ev.SourceKey {
		case option.Some[string] as sk:
			eventSourceKeys = eventSourceKeys.Put(orchestrate.EventSourceKey{Repo: ev.Repo, Run: ev.Run, SourceKey: sk.Value}, ev.ID)
		case option.None:
		}
	}
	let mut commands = Map[orchestrate.CommandID, orchestrate.Command]{}
	let cmdRows = try queryTx("SELECT command_id, payload_json FROM commands", []sql.Value{})
	for row in cmdRows {
		let id = orchestrate.CommandID(try textAt(row, 0, "command_id"))
		let payload = try textAt(row, 1, "payload_json")
		commands = commands.Put(id, try decodeCommand(payload))
	}
	orchestrate.State{
		Units:              units,
		Receipts:           receipts,
		ReceiptOrder:       receiptOrder,
		Commitments:        commitments,
		Queue:              queue,
		Questions:          questions,
		QuestionByCommand:  questionByCommand,
		NextQuestionID:     try nextQuestionIDTx(),
		RunMetas:           runMetas,
		Leases:             try queryLeasesTx(option.None),
		Decisions:          decisions,
		Landings:           landings,
		EventLog:           eventLog,
		EventLogSourceKeys: eventSourceKeys,
		NextEventID:        try nextEventIDTx(),
		Commands:           commands,
	}
}

func nextQuestionIDTx() int fails orchestrate.StoreFailed needs sql.Tx {
	let metaRows = try queryTx("SELECT next_question_id FROM schema_meta WHERE id = 1", []sql.Value{})
	if metaRows.Len() == 0 {
		return 1
	}
	try intAt(metaRows[0], 0, "next_question_id")
}

func nextEventIDTx() int fails orchestrate.StoreFailed needs sql.Tx {
	let metaRows = try queryTx("SELECT next_event_id FROM schema_meta WHERE id = 1", []sql.Value{})
	if metaRows.Len() == 0 {
		return 1
	}
	try intAt(metaRows[0], 0, "next_event_id")
}

func loadScopeTx(env orchestrate.Envelope) orchestrate.State fails orchestrate.StoreFailed needs sql.Tx {
	let out = orchestrate.State{..orchestrate.EmptyState(), NextQuestionID: try nextQuestionIDTx(), NextEventID: try nextEventIDTx()}
	match env.Command {
	case orchestrate.OpenUnit as c:
		let withUnit = try scopeUnitTx(out, c.Key, option.None)
		match c.Lane {
		case option.Some[string] as lane:
			let mut units = withUnit.Units
			for row in try queryTx(unitColumns+" WHERE repo = ? AND lane = ? AND status IN ('open', 'accepted')", []sql.Value{sql.Text{S: c.Key.Repo}, sql.Text{S: lane.Value}}) {
				let u = try scanUnit(row)
				units = units.Put(u.Key, u)
			}
			orchestrate.State{..withUnit, Units: units}
		case option.None:
			withUnit
		}
	case orchestrate.RecordReceipt as c:
		try scopeUnitTx(out, c.Unit, option.None)
	case orchestrate.AcceptUnit as c:
		try scopeUnitTx(out, c.Unit, option.Some[string]{Value: c.Head})
	case orchestrate.LandUnit as c:
		try scopeRunTx(try scopeUnitTx(out, c.Unit, option.Some[string]{Value: c.Head}), c.Unit.Repo, c.Unit.Run)
	case orchestrate.CloseUnit as c:
		try scopeUnitTx(out, c.Unit, option.None)
	case orchestrate.TransferUnit as c:
		try scopeUnitTx(out, c.Unit, option.None)
	case orchestrate.BeginLanding as c:
		try scopeRunTx(out, c.Repo, c.Run)
	case orchestrate.EndLanding as c:
		try scopeRunTx(out, c.Repo, c.Run)
	case orchestrate.AddCommitment as c:
		try scopeCommitmentTx(out, c.ID)
	case orchestrate.AssignCommitment as c:
		try scopeCommitmentTx(out, c.ID)
	case orchestrate.LandCommitment as c:
		try scopeCommitmentTx(out, c.ID)
	case orchestrate.DecideCommitment as c:
		try scopeCommitmentTx(out, c.ID)
	case orchestrate.UpsertQueueItem:
		out
	case orchestrate.RemoveQueueItem as c:
		let rows = try queryTx("SELECT key, priority, title, body, status, tags_json, updated_at FROM queue WHERE key = ?", []sql.Value{sql.Text{S: c.Key}})
		if rows.Len() == 0 {
			return out
		}
		orchestrate.State{..out, Queue: out.Queue.Put(c.Key, try scanQueueItem(rows[0]))}
	case orchestrate.AskQuestion:
		out
	case orchestrate.AnswerQuestion as c:
		match try queryQuestionTx(c.ID) {
		case option.Some[orchestrate.Question] as q:
			orchestrate.State{..out, Questions: out.Questions.Put(c.ID, q.Value)}
		case option.None:
			out
		}
	case orchestrate.RecordDecision, orchestrate.RecordLanding:
		out
	case orchestrate.RecordLedgerEvent as c:
		match c.SourceKey {
		case option.Some[string] as sk:
			let rows = try queryTx(
				"SELECT id FROM event_log WHERE repo = ? AND run = ? AND source_key = ?",
				[]sql.Value{sql.Text{S: c.Repo}, sql.Text{S: c.Run}, sql.Text{S: sk.Value}},
			)
			if rows.Len() == 0 {
				return out
			}
			let eid = try intAt(rows[0], 0, "id")
			orchestrate.State{..out, EventLogSourceKeys: out.EventLogSourceKeys.Put(orchestrate.EventSourceKey{Repo: c.Repo, Run: c.Run, SourceKey: sk.Value}, eid)}
		case option.None:
			out
		}
	case orchestrate.IngestPlan as c:
		let rows = try queryTx(
			"SELECT source_key, id FROM event_log WHERE repo = ? AND run = ? AND source_key IS NOT NULL",
			[]sql.Value{sql.Text{S: c.Repo}, sql.Text{S: c.Run}},
		)
		let mut keys = out.EventLogSourceKeys
		for row in rows {
			let sk = try textAt(row, 0, "source_key")
			let eid = try intAt(row, 1, "id")
			keys = keys.Put(orchestrate.EventSourceKey{Repo: c.Repo, Run: c.Run, SourceKey: sk}, eid)
		}
		try scopeRunTx(orchestrate.State{..out, EventLogSourceKeys: keys}, c.Repo, c.Run)
	}
}

func scopeRunTx(out orchestrate.State, repo string, run string) orchestrate.State fails orchestrate.StoreFailed needs sql.Tx {
	let rk = orchestrate.RunKey{Repo: repo, Run: run}
	let metas = match try queryRunMetaTx(repo, run) {
	case option.Some[orchestrate.RunMeta] as m:
		out.RunMetas.Put(rk, m.Value)
	case option.None:
		out.RunMetas
	}
	orchestrate.State{..out, RunMetas: metas, Leases: try queryLeasesTx(option.Some[orchestrate.RunKey]{Value: rk})}
}

func queryLeasesTx(only option.Option[orchestrate.RunKey]) Map[orchestrate.RunKey, orchestrate.LandingLease] fails orchestrate.StoreFailed needs sql.Tx {
	let cols = "SELECT repo, run, lease_actor, lease_base_head, lease_since, lease_until FROM run_meta WHERE lease_actor IS NOT NULL"
	let rows = match only {
	case option.Some[orchestrate.RunKey] as k:
		try queryTx(cols+" AND repo = ? AND run = ?", []sql.Value{sql.Text{S: k.Value.Repo}, sql.Text{S: k.Value.Run}})
	case option.None:
		try queryTx(cols, []sql.Value{})
	}
	let mut out = Map[orchestrate.RunKey, orchestrate.LandingLease]{}
	for row in rows {
		let l = orchestrate.LandingLease{
			Repo:     try textAt(row, 0, "repo"),
			Run:      try textAt(row, 1, "run"),
			Actor:    try textAt(row, 2, "actor"),
			BaseHead: try textAt(row, 3, "base_head"),
			Since:    try textAt(row, 4, "since"),
			Until:    try textAt(row, 5, "until"),
		}
		out = out.Put(orchestrate.RunKey{Repo: l.Repo, Run: l.Run}, l)
	}
	out
}

func scopeUnitTx(out orchestrate.State, key orchestrate.UnitKey, head option.Option[string]) orchestrate.State fails orchestrate.StoreFailed needs sql.Tx {
	match try queryUnitTx(key) {
	case option.Some[orchestrate.Unit] as u:
		let withUnit = orchestrate.State{..out, Units: out.Units.Put(key, u.Value)}
		match head {
		case option.Some[string] as h:
			let mut receipts = withUnit.Receipts
			let mut order = withUnit.ReceiptOrder
			for r in try queryReceiptsTx(key, option.Some[string]{Value: h.Value}) {
				receipts = receipts.Put(r.ID, r)
				order = order.Append(r.ID)
			}
			orchestrate.State{..withUnit, Receipts: receipts, ReceiptOrder: order}
		case option.None:
			withUnit
		}
	case option.None:
		out
	}
}

func scopeCommitmentTx(out orchestrate.State, id string) orchestrate.State fails orchestrate.StoreFailed needs sql.Tx {
	match try queryCommitmentTx(id) {
	case option.Some[orchestrate.Commitment] as c:
		orchestrate.State{..out, Commitments: out.Commitments.Put(id, c.Value)}
	case option.None:
		out
	}
}

func queryEventsTx(fromSeq int) []orchestrate.StoredEvent fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		"SELECT seq, event_json FROM events WHERE seq > ? ORDER BY seq ASC",
		[]sql.Value{sql.Int{N: int64(fromSeq)}},
	)
	let mut out = []orchestrate.StoredEvent{}
	for row in rows {
		let seq = try intAt(row, 0, "seq")
		let ev = try decodeEvent(try textAt(row, 1, "event_json"))
		out = out.Append(orchestrate.StoredEvent{Seq: seq, Event: ev})
	}
	out
}

func queryUnitTx(key orchestrate.UnitKey) option.Option[orchestrate.Unit] fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		unitColumns+" WHERE repo = ? AND run = ? AND id = ?",
		[]sql.Value{sql.Text{S: key.Repo}, sql.Text{S: key.Run}, sql.Text{S: key.ID}},
	)
	if rows.Len() == 0 {
		return option.None
	}
	option.Some[orchestrate.Unit]{Value: try scanUnit(rows[0])}
}

func queryReceiptsTx(key orchestrate.UnitKey, head option.Option[string]) []orchestrate.Receipt fails orchestrate.StoreFailed needs sql.Tx {
	let rows = match head {
	case option.Some[string] as h:
		try queryTx(
			receiptColumns+" WHERE repo = ? AND run = ? AND unit_id = ? AND head = ? ORDER BY seq_order ASC",
			[]sql.Value{sql.Text{S: key.Repo}, sql.Text{S: key.Run}, sql.Text{S: key.ID}, sql.Text{S: h.Value}},
		)
	case option.None:
		try queryTx(
			receiptColumns+" WHERE repo = ? AND run = ? AND unit_id = ? ORDER BY seq_order ASC",
			[]sql.Value{sql.Text{S: key.Repo}, sql.Text{S: key.Run}, sql.Text{S: key.ID}},
		)
	}
	let mut out = []orchestrate.Receipt{}
	for row in rows {
		out = out.Append(try scanReceipt(row))
	}
	out
}

func queryCommitmentTx(id string) option.Option[orchestrate.Commitment] fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		"SELECT id, title, kind, status, owner, lane, landed_sha, decision_note, created_at, updated_at FROM commitments WHERE id = ?",
		[]sql.Value{sql.Text{S: id}},
	)
	if rows.Len() == 0 {
		return option.None
	}
	option.Some[orchestrate.Commitment]{Value: try scanCommitment(rows[0])}
}

func queryCommitmentsTx(status option.Option[orchestrate.CommitmentStatus], owner option.Option[string]) []orchestrate.Commitment fails orchestrate.StoreFailed needs sql.Tx {
	let rows = match (status, owner) {
	case (option.Some[orchestrate.CommitmentStatus] as st, option.Some[string] as ow):
		try queryTx(
			"SELECT id, title, kind, status, owner, lane, landed_sha, decision_note, created_at, updated_at FROM commitments WHERE status = ? AND owner = ? ORDER BY id ASC",
			[]sql.Value{sql.Text{S: orchestrate.CommitmentStatusName(st.Value)}, sql.Text{S: ow.Value}},
		)
	case (option.Some[orchestrate.CommitmentStatus] as st, option.None):
		try queryTx(
			"SELECT id, title, kind, status, owner, lane, landed_sha, decision_note, created_at, updated_at FROM commitments WHERE status = ? ORDER BY id ASC",
			[]sql.Value{sql.Text{S: orchestrate.CommitmentStatusName(st.Value)}},
		)
	case (option.None, option.Some[string] as ow):
		try queryTx(
			"SELECT id, title, kind, status, owner, lane, landed_sha, decision_note, created_at, updated_at FROM commitments WHERE owner = ? ORDER BY id ASC",
			[]sql.Value{sql.Text{S: ow.Value}},
		)
	case (option.None, option.None):
		try queryTx(
			"SELECT id, title, kind, status, owner, lane, landed_sha, decision_note, created_at, updated_at FROM commitments ORDER BY id ASC",
			[]sql.Value{},
		)
	}
	let mut out = []orchestrate.Commitment{}
	for row in rows {
		out = out.Append(try scanCommitment(row))
	}
	out
}

func queryQueueTx(status option.Option[string]) []orchestrate.QueueItem fails orchestrate.StoreFailed needs sql.Tx {
	let rows = match status {
	case option.Some[string] as st:
		try queryTx(
			"SELECT key, priority, title, body, status, tags_json, updated_at FROM queue WHERE status = ? ORDER BY priority ASC, key ASC",
			[]sql.Value{sql.Text{S: st.Value}},
		)
	case option.None:
		try queryTx(
			"SELECT key, priority, title, body, status, tags_json, updated_at FROM queue ORDER BY priority ASC, key ASC",
			[]sql.Value{},
		)
	}
	let mut out = []orchestrate.QueueItem{}
	for row in rows {
		out = out.Append(try scanQueueItem(row))
	}
	out
}

func queryQuestionTx(id int) option.Option[orchestrate.Question] fails orchestrate.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		"SELECT id, prompt, assumption, concrete_action, status, answer, asked_by, asked_at, answered_by, answered_at FROM questions WHERE id = ?",
		[]sql.Value{sql.Int{N: int64(id)}},
	)
	if rows.Len() == 0 {
		return option.None
	}
	option.Some[orchestrate.Question]{Value: try scanQuestion(rows[0])}
}

func queryQuestionsTx(openOnly bool) []orchestrate.Question fails orchestrate.StoreFailed needs sql.Tx {
	let rows = if openOnly {
		try queryTx(
			"SELECT id, prompt, assumption, concrete_action, status, answer, asked_by, asked_at, answered_by, answered_at FROM questions WHERE status = 'open' ORDER BY id ASC",
			[]sql.Value{},
		)
	} else {
		try queryTx(
			"SELECT id, prompt, assumption, concrete_action, status, answer, asked_by, asked_at, answered_by, answered_at FROM questions ORDER BY id ASC",
			[]sql.Value{},
		)
	}
	let mut out = []orchestrate.Question{}
	for row in rows {
		out = out.Append(try scanQuestion(row))
	}
	out
}

func scanUnit(row sql.Row) orchestrate.Unit fails orchestrate.StoreFailed {
	let statusText = try textAt(row, 7, "status")
	let status = match orchestrate.ParseUnitStatus(statusText) {
	case option.Some[orchestrate.UnitStatus] as st:
		st.Value
	case option.None:
		return orchestrate.StoreFailed{Reason: "invalid stored unit status: " + statusText}
	}
	orchestrate.Unit{
		Key:       orchestrate.UnitKey{Repo: try textAt(row, 0, "repo"), Run: try textAt(row, 1, "run"), ID: try textAt(row, 2, "id")},
		Owner:     try textAt(row, 11, "owner"),
		Title:     try textAt(row, 3, "title"),
		Requires:  try decodeTags(try textAt(row, 4, "requires_json")),
		Lane:      try optTextAt(row, 5, "lane"),
		Branch:    try optTextAt(row, 6, "branch"),
		Status:    status,
		Head:      try optTextAt(row, 8, "head"),
		CreatedAt: try textAt(row, 9, "created_at"),
		UpdatedAt: try textAt(row, 10, "updated_at"),
	}
}

func scanReceipt(row sql.Row) orchestrate.Receipt fails orchestrate.StoreFailed {
	orchestrate.Receipt{
		ID:         try textAt(row, 0, "id"),
		Unit:       orchestrate.UnitKey{Repo: try textAt(row, 1, "repo"), Run: try textAt(row, 2, "run"), ID: try textAt(row, 3, "unit_id")},
		Kind:       try textAt(row, 4, "kind"),
		Command:    try textAt(row, 5, "command"),
		Head:       try textAt(row, 6, "head"),
		ExitCode:   try intAt(row, 7, "exit_code"),
		ExitLines:  try textAt(row, 8, "exit_lines"),
		RecordedAt: try textAt(row, 9, "recorded_at"),
		RecordedBy: try textAt(row, 10, "recorded_by"),
	}
}

