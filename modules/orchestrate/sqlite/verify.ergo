import github.com/cevr/ergo/modules/orchestrate/memory
import github.com/cevr/ergo/modules/orchestrate/orchestrate
import github.com/cevr/ergo/modules/sqlite/sqlite
import option
import sql
import strconv
import strings
import sync
import task
import time

type probeFailure {}

// PersistenceChecks defines the SQLite agreement, version-fence, rollback-atomicity,
// and concurrent multi-writer laws verified natively against live SQLite databases.
type PersistenceChecks {
	// CheckAgreesWithMemory runs a generated sequence of valid, invalid, duplicate, and conflicting commands against both memory.Store and a WAL sqlite.Store, checking full agreement at every step and after reopen.
	CheckAgreesWithMemory(steps []int) bool,

	// CheckVersionFence verifies that opening a database whose schema_version or user_version exceeds CurrentSchemaVersion fails StoreFailed without mutating existing rows.
	CheckVersionFence(futureBump int) bool,

	// CheckRollbackAtomicity verifies that a mid-transaction failure after inserting into events and projection tables rolls back completely across reopen.
	CheckRollbackAtomicity(tag int) bool,

	// CheckConcurrentMultiWriter runs two concurrent WAL writer tasks on separate sqlite.Store connections and verifies zero SQLITE_BUSY failures, zero lost writes, and Fold(events) == Snapshot after reopen.
	CheckConcurrentMultiWriter(tag int) bool,

	// CheckMigrationV2ToV3 creates a v2 SQLite DB populated with existing units, receipts, commitments, queue, questions, commands, and events, opens it under v3, and verifies zero data loss and working v3 queries/writes.
	CheckMigrationV2ToV3() bool,

	// CheckMigrationV1ToV3 creates a v1 SQLite DB populated with existing v1 units, receipts, commitments, queue, and questions, opens it under v3, and verifies non-destructive upgrade to v3.
	CheckMigrationV1ToV3() bool,

	// SqliteAgreesWithMemory verifies byte-identical state, events, queries, and refusals between memory.Store and WAL sqlite.Store including across reopen.
	law SqliteAgreesWithMemory(steps []int) {
		CheckAgreesWithMemory(steps)
	},

	// SchemaVersionFenceRefusesFutureVersion verifies that future schema versions are refused cleanly on Open.
	law SchemaVersionFenceRefusesFutureVersion() {
		CheckVersionFence(1) && CheckVersionFence(2)
	},

	// RollbackAtomicityPreservesConsistency verifies that mid-transaction failures leave zero partial events or projection rows after reopen.
	law RollbackAtomicityPreservesConsistency() {
		CheckRollbackAtomicity(0)
	},

	// ConcurrentMultiWriterWAL verifies concurrent writers on a shared WAL file lose zero writes and keep Fold(events) == Snapshot.
	law ConcurrentMultiWriterWAL() {
		CheckConcurrentMultiWriter(0) && CheckConcurrentMultiWriter(1) && CheckConcurrentMultiWriter(2)
	},

	// MigrationV2ToV3PreservesExistingData verifies that opening a populated v2 SQLite database under the current schema upgrades cleanly, keeps every existing row intact, gives each unit the actor of its opening command as owner (else the unknown owner), and lets exactly one actor claim a unit of unknown owner.
	law MigrationV2ToV3PreservesExistingData() {
		CheckMigrationV2ToV3()
	},

	// MigrationV1ToV3PreservesExistingData verifies that opening a populated v1 SQLite database under v3 upgrades cleanly and keeps existing rows intact.
	law MigrationV1ToV3PreservesExistingData() {
		CheckMigrationV1ToV3()
	},
}

type livePersistence {} implements PersistenceChecks

let verifyCounter = sync.NewRef(0)

func nextVerifyDBPath(prefix string) (string, string) fails orchestrate.StoreFailed needs go.Foreign {
	let dir = try freshWALDir()
	let n = sync.Modify(verifyCounter, func(cur int) (int, int) { (cur + 1, cur + 1) })
	let name = prefix + "-" + strconv.Itoa(n) + ".db"
	cleanFile(dir, name)
	cleanFile(dir, name+"-wal")
	cleanFile(dir, name+"-shm")
	(dir, name)
}

func cleanupVerifyDB(dir string, name string) needs go.Foreign {
	cleanFile(dir, name)
	cleanFile(dir, name+"-wal")
	cleanFile(dir, name+"-shm")
}

func execOutcomeTag(st orchestrate.Store, env orchestrate.Envelope) string {
	let res = st.Execute(env) catch {
	case orchestrate.NotFound as e:
		return "NotFound:" + e.Kind + ":" + e.ID
	case orchestrate.AlreadyExists as e:
		return "AlreadyExists:" + e.Kind + ":" + e.ID
	case orchestrate.InvalidTransition as e:
		return "InvalidTransition:" + e.Kind + ":" + e.ID + ":" + e.From + ":" + e.Action
	case orchestrate.Unverified as e:
		return "Unverified:" + orchestrate.UnitKeyText(e.Unit) + ":" + e.Head + ":" + strings.Join(e.Missing, ",") + ":" + strings.Join(e.Red, ",")
	case orchestrate.NotAcceptedHead as e:
		return "NotAcceptedHead:" + orchestrate.UnitKeyText(e.Unit) + ":" + e.Accepted + ":" + e.Head
	case orchestrate.LaneHeld as e:
		return "LaneHeld:" + e.Lane + ":" + orchestrate.UnitKeyText(e.Unit) + ":" + e.Actor
	case orchestrate.NotOwner as e:
		return "NotOwner:" + orchestrate.UnitKeyText(e.Unit) + ":" + e.Owner + ":" + e.Actor
	case orchestrate.LandingBusy as e:
		return "LandingBusy:" + e.Actor + ":" + e.Since
	case orchestrate.StaleHead as e:
		return "StaleHead:" + e.Have + ":" + e.Want
	case orchestrate.NoLease as e:
		return "NoLease:" + e.Repo + ":" + e.Run + ":" + e.Actor
	case orchestrate.CommandReused as e:
		return "CommandReused:" + string(e.ID)
	case orchestrate.InvalidInput as e:
		return "InvalidInput:" + e.Field
	case orchestrate.StoreFailed as e:
		return "StoreFailed:" + e.Reason
	}
	let dup = if res.Duplicate { "dup" } else { "new" }
	"OK:" + dup + ":" + strconv.Itoa(res.Seq) + ":" + strconv.Itoa(res.Events.Len())
}

let agreeKey = orchestrate.UnitKey{Repo: "repo", Run: "agree", ID: "u-0"}

func storesAgree(mem orchestrate.Store, sq orchestrate.Store) bool {
	let memSnap = mem.Snapshot() catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqSnap = sq.Snapshot() catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memEvs = mem.Events(0) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqEvs = sq.Events(0) catch {
	case orchestrate.StoreFailed:
		return false
	}
	if memSnap != sqSnap || memEvs != sqEvs || orchestrate.Fold(orchestrate.EventList(sqEvs)) != sqSnap {
		return false
	}
	let memUnit = mem.Unit(agreeKey) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqUnit = sq.Unit(agreeKey) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memRecs = mem.Receipts(agreeKey) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqRecs = sq.Receipts(agreeKey) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memCommits = mem.ListCommitments(option.None, option.None) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqCommits = sq.ListCommitments(option.None, option.None) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memQueue = mem.ListQueue(option.None) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqQueue = sq.ListQueue(option.None) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memQs = mem.ListQuestions(false) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqQs = sq.ListQuestions(false) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memOpenQs = mem.ListQuestions(true) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqOpenQs = sq.ListQuestions(true) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memRM = mem.RunMeta("repo", "agree") catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqRM = sq.RunMeta("repo", "agree") catch {
	case orchestrate.StoreFailed:
		return false
	}
	let memSum = mem.RunSummary("repo", "agree", 5) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqSum = sq.RunSummary("repo", "agree", 5) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let uf = orchestrate.UnitFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "agree"}, Status: option.None, Limit: 2, Offset: 0}
	let memUnits = mem.ListUnits(uf) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqUnits = sq.ListUnits(uf) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let df = orchestrate.DecisionFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "agree"}, Category: option.None, Scope: option.None, UnitID: option.None, Status: option.None, Limit: 10, Offset: 0}
	let memDecs = mem.ListDecisions(df) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqDecs = sq.ListDecisions(df) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let lf = orchestrate.LandingFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "agree"}, Limit: 10, Offset: 0}
	let memLands = mem.ListLandings(lf) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqLands = sq.ListLandings(lf) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let ef = orchestrate.EventLogFilter{Repo: option.Some[string]{Value: "repo"}, Run: option.Some[string]{Value: "agree"}, Kind: option.None, UnitID: option.None, Actor: option.None, Ascending: false, Limit: 10, Offset: 0}
	let memEvLog = mem.ListEventLog(ef) catch {
	case orchestrate.StoreFailed:
		return false
	}
	let sqEvLog = sq.ListEventLog(ef) catch {
	case orchestrate.StoreFailed:
		return false
	}
		memUnit == sqUnit &&
		memRecs == sqRecs &&
		memCommits == sqCommits &&
		memQueue == sqQueue &&
		memQs == sqQs &&
		memOpenQs == sqOpenQs &&
		memRM == sqRM &&
		memSum == sqSum &&
		memUnits == sqUnits &&
		memDecs == sqDecs &&
		memLands == sqLands &&
		memEvLog == sqEvLog
}

func makeStepEnvelope(index int, code int, prevAccepted option.Option[orchestrate.Envelope]) orchestrate.Envelope {
	let mode = ((code % 24) + 24) % 24
	match prevAccepted {
	case option.Some[orchestrate.Envelope] as prev:
		if mode == 22 {
			return prev.Value
		}
		if mode == 23 {
			return orchestrate.Envelope{
				ID:      prev.Value.ID,
				Actor:   "conflict-actor",
				At:      "2026-11-24T23:59:59Z",
				Command: orchestrate.OpenUnit{Key: orchestrate.UnitKey{Repo: "repo", Run: "agree", ID: "conflict-unit-\(index)"}, Title: "Conflicting", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None},
			}
		}
	case option.None:
	}
	let kind = ((code % 21) + 21) % 21
	let slot = (((code / 21) % 3) + 3) % 3
	let id = orchestrate.CommandID("agree-\(index)")
	let at = time.Unix(int64(1795482000+index*20), 0).Format(time.RFC3339)
	let key = orchestrate.UnitKey{Repo: "repo", Run: "agree", ID: "u-\(slot)"}
	let head = "h-\(((code/63)%2 + 2) % 2)"
	let commitID = "c-\(slot)"
	let queueKey = "q-\(slot)"
	let cmd orchestrate.Command = match kind {
	case 0:
		orchestrate.OpenUnit{Key: key, Title: "Unit \(slot)", Requires: []string{"acceptance"}, Lane: option.Some[string]{Value: "/lanes/\(slot)"}, Branch: option.Some[string]{Value: "b-\(slot)"}}
	case 1:
		orchestrate.RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: head, ExitCode: 0, ExitLines: "ok"}
	case 2:
		orchestrate.RecordReceipt{Unit: key, Kind: "acceptance", Command: "ergo test", Head: head, ExitCode: slot, ExitLines: "exit \(slot)"}
	case 3:
		orchestrate.AcceptUnit{Unit: key, Head: head}
	case 4:
		orchestrate.LandUnit{Unit: key, Head: head}
	case 5:
		orchestrate.CloseUnit{Unit: key}
	case 6:
		orchestrate.OpenUnit{Key: key, Title: "Unit \(slot)", Requires: []string{"acceptance", "gate"}, Lane: option.None, Branch: option.None}
	case 7:
		orchestrate.AddCommitment{ID: commitID, Title: "Commit \(slot)", Kind: "plan-part"}
	case 8:
		orchestrate.AssignCommitment{ID: commitID, Owner: "owner-\(slot)", Lane: "lane-\(slot)"}
	case 9:
		orchestrate.LandCommitment{ID: commitID, LandedSHA: "1234abcd"}
	case 10:
		orchestrate.DecideCommitment{ID: commitID, Note: "decided", Withdraw: slot == 2}
	case 11:
		orchestrate.UpsertQueueItem{Key: queueKey, Priority: slot, Title: "Queue \(slot)", Body: "body", Status: "open", Tags: []string{"t1", "t2"}}
	case 12:
		orchestrate.RemoveQueueItem{Key: queueKey}
	case 13:
		orchestrate.AskQuestion{ID: option.None, Prompt: "Question \(index)?", Assumption: "default", ConcreteAction: "reply yes"}
	case 14:
		orchestrate.AnswerQuestion{ID: slot + 1, Answer: "yes", Withdraw: slot == 2}
	case 15:
		match slot {
		case 0:
			orchestrate.BeginLanding{Repo: "repo", Run: "agree", ExpectedHead: head, LifetimeSeconds: 60}
		case 1:
			orchestrate.EndLanding{Repo: "repo", Run: "agree", NewHead: head}
		case _:
			orchestrate.TransferUnit{Unit: key, To: "actor-0"}
		}
	case 16:
		let sup = if slot == 2 { option.Some[string]{Value: "dec-0"} } else { option.None }
		orchestrate.RecordDecision{Repo: "repo", Run: "agree", ID: "dec-\(slot)", Category: "ruling", Scope: "run", UnitID: option.Some[string]{Value: "u-\(slot)"}, Title: "Decision \(slot)", Body: "Body \(slot)", Status: orchestrate.DecisionOpen, Supersedes: sup, CreatedAt: option.None}
	case 17:
		orchestrate.RecordLanding{Repo: "repo", Run: "agree", LandingNumber: slot + 1, GroupID: "grp-\(slot)", Head: "deadbeef\(slot)", Tips: []string{"tip-\(slot)"}, Summary: "Landing \(slot + 1)", LogPath: option.Some[string]{Value: "/logs/g\(slot).log"}, LandedAt: option.None}
	case 18:
		orchestrate.RecordLedgerEvent{Repo: "repo", Run: "agree", Kind: "hand-back", UnitID: option.Some[string]{Value: "u-\(slot)"}, Summary: "Hand back \(index)", SourceKey: option.Some[string]{Value: "sk-\(slot)"}, CreatedAt: option.None}
	case 19:
		let planText = "- 2026-11-26T10:00:0\(slot)Z RULED (Rule \(slot)): keep clean.\nMAIN MOVED 2026-11-26T10:01:0\(slot)Z: main = 1234ab\(slot)0 (Landing \(slot + 10), group g\(slot)). Tips: U-\(slot)\n- 2026-11-26T10:02:0\(slot)Z DISPATCHED (Worker) U-\(slot): run\n"
		orchestrate.IngestPlan{Repo: "repo", Run: "agree", Text: planText}
	case _:
		orchestrate.RecordReceipt{Unit: key, Kind: "gate", Command: "go vet", Head: head, ExitCode: 0, ExitLines: "ok"}
	}
	let actor = if kind == 15 || kind == 4 { "actor-0" } else { "actor-\(slot)" }
	orchestrate.Envelope{ID: id, Actor: actor, At: at, Command: cmd}
}

let agreeCachedStore = sync.NewRef[option.Option[Store]](option.None)

func CheckAgreesWithMemory(_ livePersistence, steps []int) bool needs go.Foreign {
	let dir = freshWALDir() catch {
	case orchestrate.StoreFailed:
		return false
	}
	let name = "agree.db"
	let path = dir + "/" + name
	let mem = memory.New()
	let cached = sync.Modify(agreeCachedStore, func(cur option.Option[Store]) (option.Option[Store], option.Option[Store]) {
		(cur, option.None)
	})
	let sq = match cached {
	case option.Some[Store] as existing:
		resetStoreData(existing.Value) catch {
		case orchestrate.StoreFailed:
			existing.Value.Close() catch {
			case orchestrate.StoreFailed:
			}
			cleanupVerifyDB(dir, name)
			return false
		}
	case option.None:
		let opened = Open(path) catch {
		case orchestrate.StoreFailed:
			cleanupVerifyDB(dir, name)
			return false
		}
		resetStoreData(opened) catch {
		case orchestrate.StoreFailed:
			opened.Close() catch {
			case orchestrate.StoreFailed:
			}
			cleanupVerifyDB(dir, name)
			return false
		}
	}
	let mut prevAccepted option.Option[orchestrate.Envelope] = option.None
	let mut ok = true
	let limit = if steps.Len() > 16 { 16 } else { steps.Len() }
	for i in 0..limit {
		let env = makeStepEnvelope(i, steps[i], prevAccepted)
		let memTag = execOutcomeTag(mem, env)
		let sqTag = execOutcomeTag(sq, env)
		if memTag != sqTag || !storesAgree(mem, sq) {
			ok = false
			break
		}
		if memTag.Len() >= 6 && memTag[0:6] == "OK:new" {
			prevAccepted = option.Some[orchestrate.Envelope]{Value: env}
		}
	}
	sq.Close() catch {
	case orchestrate.StoreFailed:
		ok = false
	}
	if ok {
		let reopened = Open(path) catch {
		case orchestrate.StoreFailed:
			cleanupVerifyDB(dir, name)
			return false
		}
		ok = storesAgree(mem, reopened)
		if ok {
			let kept = sync.Modify(agreeCachedStore, func(cur option.Option[Store]) (bool, option.Option[Store]) {
				match cur {
				case option.None:
					(true, option.Some[Store]{Value: reopened})
				case option.Some[Store]:
					(false, cur)
				}
			})
			if !kept {
				reopened.Close() catch {
				case orchestrate.StoreFailed:
				}
			}
		} else {
			reopened.Close() catch {
			case orchestrate.StoreFailed:
				ok = false
			}
		}
	}
	ok
}

func CheckVersionFence(_ livePersistence, futureBump int) bool needs go.Foreign {
	let bump = 1 + ((futureBump%5)+5)%5
	let futureVer = CurrentSchemaVersion + bump
	let (dir, name) = nextVerifyDBPath("fence") catch {
	case orchestrate.StoreFailed:
		return false
	}
	let path = dir + "/" + name
	let st = Open(path) catch {
	case orchestrate.StoreFailed:
		cleanupVerifyDB(dir, name)
		return false
	}
	let _ = st.Execute(orchestrate.Envelope{
		ID:      orchestrate.CommandID("fence-open"),
		Actor:   "root",
		At:      "2026-11-24T10:00:00Z",
		Command: orchestrate.OpenUnit{Key: orchestrate.UnitKey{Repo: "repo", Run: "fence", ID: "u-fence"}, Title: "Keep", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None},
	}) catch {
	case _:
		st.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let bumpUserVersionOnly = futureBump%2 == 0
	let dbHandle = openDB(st.db, st.err) catch {
	case orchestrate.StoreFailed:
		st.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let _ = with context { sql.DB: dbHandle } {
		sqlite.WriteTransaction() {
			if bumpUserVersionOnly {
				let _ = try execTx("PRAGMA user_version = "+strconv.Itoa(futureVer), []sql.Value{})
			} else {
				let _ = try execTx("UPDATE schema_meta SET schema_version = ? WHERE id = 1", []sql.Value{sql.Int{N: int64(futureVer)}})
			}
			true
		}
	} catch {
	case _:
		st.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	st.Close() catch {
	case orchestrate.StoreFailed:
	}
	let mut refused = false
	let opened = Open(path) catch {
	case orchestrate.StoreFailed:
		refused = true
		Store{db: option.None, err: "refused"}
	}
	if !refused {
		opened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let raw = sqlite.Open(path) catch {
	case _:
		cleanupVerifyDB(dir, name)
		return false
	}
	let keptVer = with context { sql.DB: raw } {
		sql.Transaction() {
			if bumpUserVersionOnly {
				let rows = try queryTx("PRAGMA user_version", []sql.Value{})
				if rows.Len() == 0 {
					0
				} else {
					try intAt(rows[0], 0, "user_version")
				}
			} else {
				let rows = try queryTx("SELECT schema_version FROM schema_meta WHERE id = 1", []sql.Value{})
				if rows.Len() == 0 {
					0
				} else {
					try intAt(rows[0], 0, "schema_version")
				}
			}
		}
	} catch {
	case _:
		closeIgnoring(raw)
		cleanupVerifyDB(dir, name)
		return false
	}
	closeIgnoring(raw)
	cleanupVerifyDB(dir, name)
	refused && keptVer == futureVer
}

func CheckRollbackAtomicity(_ livePersistence, tag int) bool needs go.Foreign {
	let (dir, name) = nextVerifyDBPath("rollback") catch {
	case orchestrate.StoreFailed:
		return false
	}
	let path = dir + "/" + name
	let st = Open(path) catch {
	case orchestrate.StoreFailed:
		cleanupVerifyDB(dir, name)
		return false
	}
	let baseEnv = orchestrate.Envelope{
		ID:      orchestrate.CommandID("rb-base-\(tag)"),
		Actor:   "root",
		At:      "2026-11-24T11:00:00Z",
		Command: orchestrate.OpenUnit{Key: orchestrate.UnitKey{Repo: "repo", Run: "rollback", ID: "rb-u-1"}, Title: "Committed", Requires: []string{"acceptance"}, Lane: option.None, Branch: option.None},
	}
	let _ = st.Execute(baseEnv) catch {
	case _:
		st.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let beforeSnap = st.Snapshot() catch {
	case orchestrate.StoreFailed:
		st.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let beforeEvs = st.Events(0) catch {
	case orchestrate.StoreFailed:
		st.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let rbDB = openDB(st.db, st.err) catch {
	case orchestrate.StoreFailed:
		st.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let mut aborted = false
	let _ = with context { sql.DB: rbDB } {
		sqlite.WriteTransaction() {
			let _ = try execTx(
				"INSERT INTO events (seq, command_id, payload_digest, event_json) VALUES (?, ?, ?, ?)",
				[]sql.Value{sql.Int{N: 99}, sql.Text{S: "aborted-cmd"}, sql.Text{S: "deadbeef"}, sql.Text{S: "{}"}},
			)
			let _ = try execTx(
				"INSERT INTO units (repo, run, id, title, requires_json, lane, branch, status, head, created_at, updated_at) VALUES ('repo', 'rollback', 'ghost', 'Ghost', '[\"acceptance\"]', NULL, NULL, 'open', NULL, '2026-11-24T11:01:00Z', '2026-11-24T11:01:00Z')",
				[]sql.Value{},
			)
			try failMidTx()
			true
		}
	} catch {
	case probeFailure:
		aborted = true
		false
	case _:
		false
	}
	st.Close() catch {
	case orchestrate.StoreFailed:
	}
	let reopened = Open(path) catch {
	case orchestrate.StoreFailed:
		cleanupVerifyDB(dir, name)
		return false
	}
	let afterSnap = reopened.Snapshot() catch {
	case orchestrate.StoreFailed:
		reopened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let afterEvs = reopened.Events(0) catch {
	case orchestrate.StoreFailed:
		reopened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let ghost = reopened.Unit(orchestrate.UnitKey{Repo: "repo", Run: "rollback", ID: "ghost"}) catch {
	case orchestrate.StoreFailed:
		reopened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	reopened.Close() catch {
	case orchestrate.StoreFailed:
	}
	cleanupVerifyDB(dir, name)
	aborted && afterSnap == beforeSnap && afterEvs == beforeEvs && ghost == option.None && orchestrate.Fold(orchestrate.EventList(afterEvs)) == afterSnap
}

func failMidTx() fails probeFailure {
	probeFailure
}

func CheckConcurrentMultiWriter(_ livePersistence, tag int) bool needs go.Foreign {
	let emptyRes = orchestrate.ExecuteResult{Seq: 0, Events: []orchestrate.Event{}, Duplicate: false}
	let (dir, name) = nextVerifyDBPath("concurrent") catch {
	case orchestrate.StoreFailed:
		return false
	}
	let path = dir + "/" + name
	let s1 = Open(path) catch {
	case orchestrate.StoreFailed:
		cleanupVerifyDB(dir, name)
		return false
	}
	let s2 = Open(path) catch {
	case orchestrate.StoreFailed:
		s1.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let t1 = task.Go() {
		let mut ok1 = true
		for i in 0..4 {
			let uid = "cw-a-\(tag)-\(i)"
			let _ = s1.Execute(orchestrate.Envelope{
				ID:      orchestrate.CommandID("cwa-u-\(tag)-\(i)"),
				Actor:   "w1",
				At:      "2026-11-24T12:00:\(i)Z",
				Command: orchestrate.OpenUnit{Key: orchestrate.UnitKey{Repo: "repo", Run: "wal", ID: uid}, Title: "A \(i)", Requires: []string{"gate"}, Lane: option.None, Branch: option.None},
			}) catch {
			case _:
				ok1 = false
				emptyRes
			}
			let _ = s1.Execute(orchestrate.Envelope{
				ID:      orchestrate.CommandID("cwa-r-\(tag)-\(i)"),
				Actor:   "w1",
				At:      "2026-11-24T12:01:\(i)Z",
				Command: orchestrate.RecordReceipt{
					Unit:      orchestrate.UnitKey{Repo: "repo", Run: "wal", ID: uid},
					Kind:      "gate",
					Command:   "ergo test",
					Head:      "aaaa1111",
					ExitCode:  0,
					ExitLines: "ok",
				},
			}) catch {
			case _:
				ok1 = false
				emptyRes
			}
		}
		ok1
	}
	let t2 = task.Go() {
		let mut ok2 = true
		for i in 0..4 {
			let uid = "cw-b-\(tag)-\(i)"
			let _ = s2.Execute(orchestrate.Envelope{
				ID:      orchestrate.CommandID("cwb-u-\(tag)-\(i)"),
				Actor:   "w2",
				At:      "2026-11-24T12:02:\(i)Z",
				Command: orchestrate.OpenUnit{Key: orchestrate.UnitKey{Repo: "repo", Run: "wal", ID: uid}, Title: "B \(i)", Requires: []string{"gate"}, Lane: option.None, Branch: option.None},
			}) catch {
			case _:
				ok2 = false
				emptyRes
			}
			let _ = s2.Execute(orchestrate.Envelope{
				ID:      orchestrate.CommandID("cwb-q-\(tag)-\(i)"),
				Actor:   "w2",
				At:      "2026-11-24T12:03:\(i)Z",
				Command: orchestrate.UpsertQueueItem{
					Key:      "cw-q-\(tag)-\(i)",
					Priority: i,
					Title:    "Q \(i)",
					Body:     "concurrent",
					Status:   "open",
					Tags:     []string{"wal"},
				},
			}) catch {
			case _:
				ok2 = false
				emptyRes
			}
		}
		ok2
	}
	let r1 = t1.Wait()
	let r2 = t2.Wait()
	s1.Close() catch {
	case orchestrate.StoreFailed:
	}
	s2.Close() catch {
	case orchestrate.StoreFailed:
	}
	let reopened = Open(path) catch {
	case orchestrate.StoreFailed:
		cleanupVerifyDB(dir, name)
		return false
	}
	let units = reopened.Snapshot() catch {
	case orchestrate.StoreFailed:
		reopened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let queue = reopened.ListQueue(option.None) catch {
	case orchestrate.StoreFailed:
		reopened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let evs = reopened.Events(0) catch {
	case orchestrate.StoreFailed:
		reopened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	let snap = reopened.Snapshot() catch {
	case orchestrate.StoreFailed:
		reopened.Close() catch {
		case orchestrate.StoreFailed:
		}
		cleanupVerifyDB(dir, name)
		return false
	}
	reopened.Close() catch {
	case orchestrate.StoreFailed:
	}
	cleanupVerifyDB(dir, name)
	let mut dense = true
	for i, ev in evs {
		if ev.Seq != i+1 {
			dense = false
		}
	}
	r1 && r2 && units.Units.Len() == 8 && queue.Len() == 4 && snap.Receipts.Len() == 4 && evs.Len() == 40 && dense && orchestrate.Fold(orchestrate.EventList(evs)) == snap
}
