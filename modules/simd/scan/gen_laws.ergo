import gen

// ScanKernelsAlgebraicAgreement cross-checks algebraic relationships between
// IndexByte, IndexAny2, IndexOutside, CountByte, and IndexNeedsEscape over
// generated byte slices covering both vector-loop and tail lengths.
law ScanKernelsAlgebraicAgreement() {
	let cfg = gen.Config{Seed: uint64(1), Cases: 50, Shrinks: 0, MaxDraws: 512, MaxRejected: 10}
	let outcome = gen.Check(cfg, func() bool fails gen.Rejected needs gen.Draws {
		let n = gen.IntIn(0, 96)
		let mut buf = []byte{}
		for _ in 0..n {
			buf = buf.Append(byte(gen.IntIn(32, 126)))
		}
		let a = byte(gen.IntIn(32, 126))
		let b = byte(gen.IntIn(32, 126))
		let ia = IndexByte(buf, a)
		let ib = IndexByte(buf, b)
		let iab = IndexAny2(buf, a, b)
		let ca = CountByte(buf, a)
		if (ca == 0) != (ia == -1) {
			return false
		}
		let wantAny = if ia < 0 {
			ib
		} else if ib < 0 {
			ia
		} else if ia < ib {
			ia
		} else {
			ib
		}
		if iab != wantAny {
			return false
		}
		let outSelf = IndexOutside(buf, a, a)
		if (outSelf == -1) != (ca == buf.Len()) {
			return false
		}
		let escPlain = IndexNeedsEscape(buf, false)
		let escHtml = IndexNeedsEscape(buf, true)
		if escPlain >= 0 && (escHtml < 0 || escHtml > escPlain) {
			return false
		}
		true
	})
	match outcome {
	case gen.Held:
		true
	case gen.Refuted, gen.GaveUp:
		false
	}
}
