import github.com/cevr/ergo/modules/atlas/handle
import github.com/cevr/ergo/modules/atlas/memory
import github.com/cevr/ergo/modules/atlas/subagent
import github.com/cevr/ergo/modules/sqlite/sqlite
import go os
import option
import sql
import sync

// Store is a transactional SQLite provider of memory.Store executing Decide -> Commit -> Act in one BEGIN IMMEDIATE transaction.
type Store {
	db  option.Option[sqlite.DB],
	err string,
} implements memory.Store

// WALStore is a file-backed WAL SQLite provider of memory.Store used to run contract laws over real WAL files.
type WALStore {
	db  option.Option[sqlite.DB],
	err string,
} implements memory.Store

func mapSQLOpenErr(prefix string, err sql.Failure) memory.StoreFailed {
	memory.StoreFailed{Reason: prefix + " " + sqlErrMsg(err)}
}

// Open opens or initializes a file-backed WAL SQLite Atlas Store at path enforcing CurrentSchemaVersion.
func Open(path string) Store fails memory.StoreFailed needs go.Foreign {
	let db = sqlite.Open(path) catch {
	case sql.Unique as e:
		return mapSQLOpenErr("open", e)
	case sql.Serialization as e:
		return mapSQLOpenErr("open", e)
	case sql.Deadlock as e:
		return mapSQLOpenErr("open", e)
	case sql.Timeout as e:
		return mapSQLOpenErr("open", e)
	case sql.Closed as e:
		return mapSQLOpenErr("open", e)
	case sql.Other as e:
		return mapSQLOpenErr("open", e)
	}
	try initStore(db)
}

// OpenMemory opens a private in-memory SQLite Atlas Store.
func OpenMemory() Store fails memory.StoreFailed needs go.Foreign {
	try Open(":memory:")
}

// NewStore opens an in-memory SQLite Store for native contract-law runs.
func NewStore() Store needs go.Foreign {
	OpenMemory() catch {
	case memory.StoreFailed as e:
		Store{db: option.None, err: e.Reason}
	}
}

// NewWALStore opens a fresh file-backed WAL SQLite Store for native contract-law runs.
func NewWALStore() WALStore needs go.Foreign {
	let st = openLawFileWAL() catch {
	case memory.StoreFailed as e:
		Store{db: option.None, err: e.Reason}
	}
	WALStore{db: st.db, err: st.err}
}

// Close closes the underlying SQLite connection pool of Store.
func Close(s Store) fails memory.StoreFailed needs go.Foreign {
	let db = try openDB(s.db, s.err)
	db.Close() catch {
	case sql.Closed as e:
		return mapSQLOpenErr("close", e)
	case sql.Other as e:
		return mapSQLOpenErr("close", e)
	}
}

// CloseWAL closes the underlying SQLite connection pool of WALStore.
func CloseWAL(w WALStore) fails memory.StoreFailed needs go.Foreign {
	let db = try openDB(w.db, w.err)
	db.Close() catch {
	case sql.Closed as e:
		return mapSQLOpenErr("close", e)
	case sql.Other as e:
		return mapSQLOpenErr("close", e)
	}
}

func openDB(opt option.Option[sqlite.DB], err string) sqlite.DB fails memory.StoreFailed {
	match opt {
	case option.Some[sqlite.DB] as d:
		d.Value
	case option.None:
		memory.StoreFailed{Reason: err}
	}
}

func closeIgnoring(db sqlite.DB) needs go.Foreign {
	db.Close() catch {
	case sql.Closed, sql.Other:
	}
}

func initStore(db sqlite.DB) Store fails memory.StoreFailed needs go.Foreign {
	let _ = with context { sql.DB: db } {
		sqlite.WriteTransaction() {
			try initSchema()
			true
		}
	} catch {
	case memory.StoreFailed as e:
		closeIgnoring(db)
		return e
	case sql.Unique as e:
		closeIgnoring(db)
		return mapSQLOpenErr("init", e)
	case sql.Serialization as e:
		closeIgnoring(db)
		return mapSQLOpenErr("init", e)
	case sql.Deadlock as e:
		closeIgnoring(db)
		return mapSQLOpenErr("init", e)
	case sql.Timeout as e:
		closeIgnoring(db)
		return mapSQLOpenErr("init", e)
	case sql.Closed as e:
		closeIgnoring(db)
		return mapSQLOpenErr("init", e)
	case sql.Other as e:
		closeIgnoring(db)
		return mapSQLOpenErr("init", e)
	}
	Store{db: option.Some[sqlite.DB]{Value: db}, err: ""}
}

func decideForTx(state memory.State, env memory.Envelope) []memory.Event fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr {
	memory.Decide(state, env) catch {
	case memory.NotFound as e:
		return e
	case memory.AlreadyExists as e:
		return e
	case memory.InvalidTransition as e:
		return e
	case memory.CommandReused as e:
		return e
	case memory.InvalidInput as e:
		return e
	case memory.LeaseFenced as e:
		return e
	case memory.ThreadDomainErr as e:
		return e
	case memory.SubagentDomainErr as e:
		return e
	case memory.HandleDomainErr as e:
		return e
	case memory.LimitDomainErr as e:
		return e
	case memory.RequestDomainErr as e:
		return e
	case memory.CutoverDomainErr as e:
		return e
	}
}

func lastSeqTx() int fails memory.StoreFailed needs sql.Tx {
	let rows = try queryTx("SELECT COALESCE(MAX(seq), 0) FROM events", []sql.Value{})
	if rows.Len() == 0 {
		return 0
	}
	try intAt(rows[0], 0)
}

func executeTx(env memory.Envelope) memory.ExecuteResult fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed needs sql.Tx {
	let payloadJSON = encodeWire(env.Command)
	let digest = commandDigest(payloadJSON)
	let seenRows = try queryTx(
		"SELECT payload_digest, payload_json FROM commands WHERE command_id = ?",
		[]sql.Value{sql.Text{S: string(env.ID)}},
	)
	if seenRows.Len() > 0 {
		let storedDigest = try textAt(seenRows[0], 0)
		let storedJSON = try textAt(seenRows[0], 1)
		if storedDigest == digest && storedJSON == payloadJSON {
			let curSeq = try lastSeqTx()
			return memory.ExecuteResult{Seq: curSeq, Events: []memory.Event{}, Duplicate: true}
		}
		return memory.CommandReused{ID: env.ID}
	}
	let state = try loadScopeTx(env)
	let events = try decideForTx(state, env)
	let mut seq = try lastSeqTx()
	for _, ev in events {
		seq = seq + 1
		let _ = try execTx(
			"INSERT INTO events (seq, command_id, payload_digest, event_json) VALUES (?, ?, ?, ?)",
			[]sql.Value{
				sql.Int{N: int64(seq)},
				sql.Text{S: string(env.ID)},
				sql.Text{S: digest},
				sql.Text{S: encodeWire(ev)},
			},
		)
		try applyEventSQL(ev, seq)
	}
	memory.ExecuteResult{Seq: seq, Events: events, Duplicate: events.Len() == 0}
}

func executeOn(opt option.Option[sqlite.DB], err string, env memory.Envelope) memory.ExecuteResult fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed needs go.Foreign {
	let db = try openDB(opt, err)
	with context { sql.DB: db } {
		sqlite.WriteTransaction() {
			try executeTx(env)
		}
	} catch {
	case memory.NotFound as e:
		return e
	case memory.AlreadyExists as e:
		return e
	case memory.InvalidTransition as e:
		return e
	case memory.CommandReused as e:
		return e
	case memory.InvalidInput as e:
		return e
	case memory.LeaseFenced as e:
		return e
	case memory.ThreadDomainErr as e:
		return e
	case memory.SubagentDomainErr as e:
		return e
	case memory.HandleDomainErr as e:
		return e
	case memory.LimitDomainErr as e:
		return e
	case memory.RequestDomainErr as e:
		return e
	case memory.CutoverDomainErr as e:
		return e
	case memory.StoreFailed as e:
		return e
	case sql.Unique as e:
		return mapSQLOpenErr("tx", e)
	case sql.Serialization as e:
		return mapSQLOpenErr("tx", e)
	case sql.Deadlock as e:
		return mapSQLOpenErr("tx", e)
	case sql.Timeout as e:
		return mapSQLOpenErr("tx", e)
	case sql.Closed as e:
		return mapSQLOpenErr("tx", e)
	case sql.Other as e:
		return mapSQLOpenErr("tx", e)
	}
}

func readOn[T](opt option.Option[sqlite.DB], err string, body func() T fails memory.StoreFailed needs sql.Tx) T fails memory.StoreFailed needs go.Foreign {
	let db = try openDB(opt, err)
	with context { sql.DB: sqlite.ReadOnly(db) } {
		sql.Transaction() {
			try body()
		}
	} catch {
	case memory.StoreFailed as e:
		return e
	case sql.Unique as e:
		return mapSQLOpenErr("read", e)
	case sql.Serialization as e:
		return mapSQLOpenErr("read", e)
	case sql.Deadlock as e:
		return mapSQLOpenErr("read", e)
	case sql.Timeout as e:
		return mapSQLOpenErr("read", e)
	case sql.Closed as e:
		return mapSQLOpenErr("read", e)
	case sql.Other as e:
		return mapSQLOpenErr("read", e)
	}
}

// Execute validates and commits one Envelope atomically on Store inside BEGIN IMMEDIATE.
func Execute(s Store, env memory.Envelope) memory.ExecuteResult fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed needs go.Foreign {
	try executeOn(s.db, s.err, env)
}

// Execute validates and commits one Envelope atomically on WALStore inside BEGIN IMMEDIATE.
func Execute(w WALStore, env memory.Envelope) memory.ExecuteResult fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed needs go.Foreign {
	try executeOn(w.db, w.err, env)
}

// Snapshot reads the complete projected State from Store in one deferred read transaction.
func Snapshot(s Store) memory.State fails memory.StoreFailed needs go.Foreign {
	try readOn(s.db, s.err, func() memory.State fails memory.StoreFailed needs sql.Tx { try loadStateTx() })
}

// Snapshot reads the complete projected State from WALStore in one deferred read transaction.
func Snapshot(w WALStore) memory.State fails memory.StoreFailed needs go.Foreign {
	try readOn(w.db, w.err, func() memory.State fails memory.StoreFailed needs sql.Tx { try loadStateTx() })
}

// Events reads all persisted StoredEvents with Seq > fromSeq from Store.
func Events(s Store, fromSeq int) []memory.StoredEvent fails memory.StoreFailed needs go.Foreign {
	try readOn(s.db, s.err, func() []memory.StoredEvent fails memory.StoreFailed needs sql.Tx { try queryEventsTx(fromSeq) })
}

// Events reads all persisted StoredEvents with Seq > fromSeq from WALStore.
func Events(w WALStore, fromSeq int) []memory.StoredEvent fails memory.StoreFailed needs go.Foreign {
	try readOn(w.db, w.err, func() []memory.StoredEvent fails memory.StoreFailed needs sql.Tx { try queryEventsTx(fromSeq) })
}

