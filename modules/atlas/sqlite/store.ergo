let lawWALDir = sync.NewRef("")
let prevLawDB = sync.NewRef[option.Option[Store]](option.None)

func cleanFile(dir string, name string) needs go.Foreign {
	let root = os.OpenRoot(dir) catch {
	case go.Error:
		return
	}
	root.Remove(name) catch {
	case go.Error:
	}
	root.Close() catch {
	case go.Error:
	}
}

func freshWALDir() string fails memory.StoreFailed needs go.Foreign {
	let existing = lawWALDir.Get()
	if existing != "" {
		return existing
	}
	let dir = os.MkdirTemp("", "atlas-sqlite-wal-*") catch {
	case go.Error as e:
		return memory.StoreFailed{Reason: "mkdirtemp: " + e.Text}
	}
	lawWALDir.Set(dir)
	dir
}

func resetStoreData(st Store) Store fails memory.StoreFailed needs go.Foreign {
	let db = try openDB(st.db, st.err)
	let _ = with context { sql.DB: db } {
		sqlite.WriteTransaction() {
			let stmts = []string{
				"DELETE FROM leases",
				"DELETE FROM kernel_root_usage",
				"DELETE FROM kernel_journals",
				"DELETE FROM kernel_snapshots",
				"DELETE FROM limit_states",
				"DELETE FROM pool_pushes",
				"DELETE FROM pool_resets",
				"DELETE FROM pool_accounts",
				"DELETE FROM requests",
				"DELETE FROM questions",
				"DELETE FROM holds",
				"DELETE FROM wakes",
				"DELETE FROM handles",
				"DELETE FROM subagent_nodes",
				"DELETE FROM subagent_trees",
				"DELETE FROM prompt_queue",
				"DELETE FROM thread_edges",
				"DELETE FROM threads",
				"DELETE FROM events",
				"DELETE FROM commands",
			}
			for _, stmt in stmts {
				let _ = try execTx(stmt, []sql.Value{})
			}
			true
		}
	} catch {
	case memory.StoreFailed as e:
		return e
	case sql.Unique as e:
		return mapSQLOpenErr("reset", e)
	case sql.Serialization as e:
		return mapSQLOpenErr("reset", e)
	case sql.Deadlock as e:
		return mapSQLOpenErr("reset", e)
	case sql.Timeout as e:
		return mapSQLOpenErr("reset", e)
	case sql.Closed as e:
		return mapSQLOpenErr("reset", e)
	case sql.Other as e:
		return mapSQLOpenErr("reset", e)
	}
	st
}

func openLawFileWAL() Store fails memory.StoreFailed needs go.Foreign {
	match prevLawDB.Get() {
	case option.Some[Store] as existing:
		return try resetStoreData(existing.Value)
	case option.None:
	}
	let dir = try freshWALDir()
	cleanFile(dir, "law.db")
	cleanFile(dir, "law.db-wal")
	cleanFile(dir, "law.db-shm")
	let st = try Open(dir + "/law.db")
	prevLawDB.Set(option.Some[Store]{Value: st})
	st
}
