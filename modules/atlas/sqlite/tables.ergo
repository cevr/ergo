// CurrentSchemaVersion returns the supported Atlas SQLite schema version.
func CurrentSchemaVersion() int {
	1
}

func commandDigest(payloadJSON string) string {
	hex.Encode(sha256.Sum(payloadJSON))
}

func encodeWire[T wire](v T) string needs wired[T] {
	let c = json.Codec[T]{MaxBytes: 0, MaxDepth: 0}
	json.Encode(c, v)
}

func decodeCommand(text string) memory.Command fails memory.StoreFailed {
	json.Decode(json.Codec[memory.Command]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case json.Malformed as e:
		return memory.StoreFailed{Reason: "decode command: \(e.Reason)"}
	case WireMissingField as e:
		return memory.StoreFailed{Reason: "decode command: missing \(e.Field)"}
	case WireUnknownTag as e:
		return memory.StoreFailed{Reason: "decode command: tag \(e.Tag)"}
	case WireWrongKind as e:
		return memory.StoreFailed{Reason: "decode command: want \(e.Want)"}
	}
}

