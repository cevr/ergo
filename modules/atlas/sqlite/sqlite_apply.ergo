	}
}

func upsertQuestionSQL(q memory.AsyncQuestion, r turn.RequestState, seq int) fails memory.StoreFailed needs sql.Tx {
	let _ = try execTx(
		"INSERT OR REPLACE INTO questions (question_id, seq_order, thread_id, handle_id, status, question_json) VALUES (?, COALESCE((SELECT seq_order FROM questions WHERE question_id = ?), ?), ?, ?, ?, ?)",
		[]sql.Value{
			sql.Text{S: string(q.ID)},
			sql.Text{S: string(q.ID)},
			sql.Int{N: int64(seq)},
			sql.Text{S: string(q.ThreadID)},
			sql.Text{S: string(q.HandleID)},
			sql.Text{S: memory.QuestionStatusName(q.Status)},
			sql.Text{S: encodeWire(q)},
		},
	)
	let _ = try execTx(
		"INSERT OR REPLACE INTO requests (request_id, seq_order, status, request_json) VALUES (?, COALESCE((SELECT seq_order FROM requests WHERE request_id = ?), ?), ?, ?)",
		[]sql.Value{
			sql.Text{S: string(r.ID)},
			sql.Text{S: string(r.ID)},
			sql.Int{N: int64(seq)},
			sql.Text{S: requestStatusName(r.Status)},
			sql.Text{S: encodeWire(r)},
		},
	)
}

