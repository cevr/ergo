import sql

func upsertThreadSQL(t thread.Thread, seq int) fails memory.StoreFailed needs sql.Tx {
	let parentVal = match t.ParentThreadID {
	case option.Some[handle.ThreadID] as p:
		sql.Text{S: string(p.Value)}
	case option.None:
		sql.Null
	}
	let _ = try execTx(
		"INSERT OR REPLACE INTO threads (thread_id, seq_order, parent_thread_id, archived, mode, driver, in_turn, thread_json) VALUES (?, COALESCE((SELECT seq_order FROM threads WHERE thread_id = ?), ?), ?, ?, ?, ?, ?, ?)",
		[]sql.Value{
			sql.Text{S: string(t.ID)},
			sql.Text{S: string(t.ID)},
			sql.Int{N: int64(seq)},
			parentVal,
			boolIntVal(t.Archived),
			sql.Text{S: adapter.ExecutionPathName(t.Mode)},
			sql.Text{S: adapter.DriverName(t.Driver)},
			boolIntVal(thread.IsThreadInTurn(t)),
			sql.Text{S: encodeWire(t)},
		},
	)
	let _ = try execTx("DELETE FROM prompt_queue WHERE thread_id = ?", []sql.Value{sql.Text{S: string(t.ID)}})
	for pos, p in t.PromptQueue {
		let _ = try execTx(
			"INSERT INTO prompt_queue (thread_id, pos, prompt_id, body, requested_mode, prompt_json) VALUES (?, ?, ?, ?, ?, ?)",
			[]sql.Value{
				sql.Text{S: string(t.ID)},
				sql.Int{N: int64(pos)},
				sql.Text{S: p.ID},
				sql.Text{S: p.Body},
				sql.Text{S: adapter.PermissionModeName(p.RequestedMode)},
				sql.Text{S: encodeWire(p)},
			},
		)
	}
}

func upsertEdgeSQL(e memory.BranchEdge, seq int) fails memory.StoreFailed needs sql.Tx {
	let _ = try execTx(
		"INSERT OR REPLACE INTO thread_edges (parent_thread_id, child_thread_id, kind, label, created_at_ms, seq_order) VALUES (?, ?, ?, ?, ?, COALESCE((SELECT seq_order FROM thread_edges WHERE parent_thread_id = ? AND child_thread_id = ?), ?))",
		[]sql.Value{
			sql.Text{S: string(e.ParentThreadID)},
			sql.Text{S: string(e.ChildThreadID)},
			sql.Text{S: memory.BranchKindName(e.Kind)},
			sql.Text{S: e.Label},
			sql.Int{N: e.CreatedAtMs},
			sql.Text{S: string(e.ParentThreadID)},
			sql.Text{S: string(e.ChildThreadID)},
			sql.Int{N: int64(seq)},
		},
	)
}

func nodeStateName(st subagent.NodeState) string {
	match st {
	case subagent.NodeIdle:
		"idle"
	case subagent.NodeRunning:
		"running"
	case subagent.NodeParked:
		"parked"
	case subagent.NodeDone:
		"done"
	}
}

func upsertSubagentTreeSQL(snap memory.SubagentTreeSnapshot, seq int) fails memory.StoreFailed needs sql.Tx {
	let _ = try execTx(
		"INSERT OR REPLACE INTO subagent_trees (root_id, seq_order, budget_used, out_of_subtree_violation, bounds_json, order_json) VALUES (?, COALESCE((SELECT seq_order FROM subagent_trees WHERE root_id = ?), ?), ?, ?, ?, ?)",
		[]sql.Value{
			sql.Text{S: string(snap.RootID)},
			sql.Text{S: string(snap.RootID)},
			sql.Int{N: int64(seq)},
			sql.Int{N: int64(snap.BudgetUsed)},
			boolIntVal(snap.OutOfSubtreeViolation),
			sql.Text{S: encodeWire(snap.Bounds)},
			sql.Text{S: encodeWire(snap.Order)},
		},
	)
	let _ = try execTx("DELETE FROM subagent_nodes WHERE root_id = ?", []sql.Value{sql.Text{S: string(snap.RootID)}})
	for _, n in snap.Nodes {
		let parentVal = match n.ParentThreadID {
		case option.Some[handle.ThreadID] as p:
			sql.Text{S: string(p.Value)}
		case option.None:
			sql.Null
		}
		let _ = try execTx(
			"INSERT INTO subagent_nodes (root_id, thread_id, parent_thread_id, depth, state, hand_back_count, node_json) VALUES (?, ?, ?, ?, ?, ?, ?)",
			[]sql.Value{
				sql.Text{S: string(snap.RootID)},
				sql.Text{S: string(n.ThreadID)},
				parentVal,
				sql.Int{N: int64(n.Depth)},
				sql.Text{S: nodeStateName(n.State)},
				sql.Int{N: int64(n.HandBackCount)},
				sql.Text{S: encodeWire(n)},
			},
		)
	}
}

func upsertHandleSQL(h handle.WakeHandle, wakeCount int, seq int) fails memory.StoreFailed needs sql.Tx {
	let _ = try execTx(
		"INSERT OR REPLACE INTO handles (handle_id, seq_order, kind, deliverer, disposition, session_id, server_id, location, epoch, wake_emitted, wake_letter_count, handle_json) VALUES (?, COALESCE((SELECT seq_order FROM handles WHERE handle_id = ?), ?), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
		[]sql.Value{
			sql.Text{S: string(h.ID)},
			sql.Text{S: string(h.ID)},
			sql.Int{N: int64(seq)},
			sql.Text{S: handle.HandleKindName(h.Kind)},
			sql.Text{S: handle.DelivererName(h.Deliverer)},
			sql.Text{S: handle.DispositionName(h.Disposition)},
			sql.Text{S: string(h.Session)},
			sql.Text{S: h.Owner.ServerID},
			sql.Text{S: h.Owner.Location},
			sql.Int{N: int64(h.Owner.Epoch)},
			boolIntVal(h.WakeEmitted),
			sql.Int{N: int64(wakeCount)},
			sql.Text{S: encodeWire(h)},
		},
	)
}

func settleHandleSQL(id handle.HandleID, disp handle.Disposition, emitWake bool) fails memory.StoreFailed needs sql.Tx {
	let rows = try queryTx(
		"SELECT wake_letter_count, handle_json FROM handles WHERE handle_id = ?",
		[]sql.Value{sql.Text{S: string(id)}},
	)
	if rows.Len() == 0 {
		return
	}
	let count = try intAt(rows[0], 0)
	let h = try decodeWakeHandle(try textAt(rows[0], 1))
	if !handle.IsOpen(h.Disposition) {
		return
	}
	let shouldEmit = emitWake && count == 0 && handle.EmitsRegistryWake(disp) && h.Deliverer == handle.DelivererRegistry
	let nextCount = if shouldEmit { 1 } else { count }
	let nextHandle = handle.WakeHandle{
		..h,
		Disposition: disp,
		WakeEmitted: h.WakeEmitted || shouldEmit,
	}
	let _ = try execTx(
		"UPDATE handles SET disposition = ?, wake_emitted = ?, wake_letter_count = ?, handle_json = ? WHERE handle_id = ?",
		[]sql.Value{
			sql.Text{S: handle.DispositionName(disp)},
			boolIntVal(nextHandle.WakeEmitted),
			sql.Int{N: int64(nextCount)},
			sql.Text{S: encodeWire(nextHandle)},
			sql.Text{S: string(id)},
		},
	)
}

func upsertWakeSQL(w reconcile.WakeRecord, seq int) fails memory.StoreFailed needs sql.Tx {
	let _ = try execTx(
		"INSERT OR REPLACE INTO wakes (delivery_id, seq_order, handle_id, delivered, payload_summary) VALUES (?, COALESCE((SELECT seq_order FROM wakes WHERE delivery_id = ?), ?), ?, ?, ?)",
		[]sql.Value{
			sql.Text{S: w.DeliveryID},
			sql.Text{S: w.DeliveryID},
			sql.Int{N: int64(seq)},
			sql.Text{S: string(w.HandleID)},
			boolIntVal(w.Delivered),
			sql.Text{S: w.PayloadSummary},
		},
	)
}

