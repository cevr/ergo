// Request is one call of api.Api: the hub's Request.
type Request = apiapi.Request

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

func textOf(v json.Value) string { json.Encode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, v) }

func untagged(v json.Value) json.Value {
	match v {
	case json.Object as o:
		let mut members = []json.Member{}
		for m in o.Members {
			if m.Key != "_tag" {
				members = members.Append(m)
			}
		}
		json.Object{Members: members}
	case json.Null, json.Boolean, json.Num, json.Str, json.Array:
		v
	}
}

// Names are the tools' names, one per operation of api.Api, in its order.
let Names = []string{"thread-create", "thread-get", "thread-list", "thread-archive", "driver-switch", "prompt-enqueue", "prompt-dequeue", "turn-start", "turn-step", "subagent-tree-init", "subagent-spawn", "subagent-control-handle", "subagent-settle-handle", "subagent-hand-back", "subagent-tree-get", "handle-open", "handle-settle", "handle-list", "owner-calls-retire", "question-ask", "question-answer", "question-withdraw", "question-list", "pool-account-upsert", "pool-hold-open", "pool-hold-transition", "pool-view", "kernel-snapshot-save", "kernel-cut-record", "kernel-view", "lease-acquire", "boot-reconcile", "boot-status", "host-capacity-get", "wellness-report-get", "mcp-token-mint", "mcp-token-revoke", "mcp-token-list"}

