// Show is the outcome o as a tool's answer: its value as JSON (null for
// none), or its typed failure as a ToolError whose message is the
// failure's tagged JSON.
func Show(o apiapi.Outcome) json.Value fails mcp.ToolError {
	match o {
	case apiapi.Done as done:
		match done.Reply {
		case apiapi.ThreadCreateReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.ThreadGetReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.ThreadListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.ThreadArchiveReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.DriverSwitchReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.PromptEnqueueReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.PromptDequeueReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.TurnStartReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.TurnStepReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.SubagentTreeInitReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.SubagentSpawnReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.SubagentControlHandleReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.SubagentSettleHandleReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.SubagentHandBackReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.SubagentTreeGetReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.HandleOpenReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.HandleSettleReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.HandleListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.OwnerCallsRetireReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.QuestionAskReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.QuestionAnswerReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.QuestionWithdrawReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.QuestionListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.PoolAccountUpsertReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.PoolHoldOpenReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.PoolHoldTransitionReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.PoolViewReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.KernelSnapshotSaveReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.KernelCutRecordReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.KernelViewReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.LeaseAcquireReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.BootReconcileReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.BootStatusReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.HostCapacityGetReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.WellnessReportGetReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.McpTokenMintReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.McpTokenRevokeReply as reply:
			valueOf(rpc.Encode(reply.Value))
		case apiapi.McpTokenListReply as reply:
			valueOf(rpc.Encode(reply.Value))
		}
	case apiapi.Rejected as rejected:
		match rejected.Failure {
		case apiapi.NotFound as failure:
			return mcp.ToolError{Message: rpc.Tagged("NotFound", rpc.Encode(failure.E))}
		case apiapi.AlreadyExists as failure:
			return mcp.ToolError{Message: rpc.Tagged("AlreadyExists", rpc.Encode(failure.E))}
		case apiapi.InvalidTransition as failure:
			return mcp.ToolError{Message: rpc.Tagged("InvalidTransition", rpc.Encode(failure.E))}
		case apiapi.CommandReused as failure:
			return mcp.ToolError{Message: rpc.Tagged("CommandReused", rpc.Encode(failure.E))}
		case apiapi.InvalidInput as failure:
			return mcp.ToolError{Message: rpc.Tagged("InvalidInput", rpc.Encode(failure.E))}
		case apiapi.LeaseFenced as failure:
			return mcp.ToolError{Message: rpc.Tagged("LeaseFenced", rpc.Encode(failure.E))}
		case apiapi.ThreadDomainErr as failure:
			return mcp.ToolError{Message: rpc.Tagged("ThreadDomainErr", rpc.Encode(failure.E))}
		case apiapi.SubagentDomainErr as failure:
			return mcp.ToolError{Message: rpc.Tagged("SubagentDomainErr", rpc.Encode(failure.E))}
		case apiapi.HandleDomainErr as failure:
			return mcp.ToolError{Message: rpc.Tagged("HandleDomainErr", rpc.Encode(failure.E))}
		case apiapi.LimitDomainErr as failure:
			return mcp.ToolError{Message: rpc.Tagged("LimitDomainErr", rpc.Encode(failure.E))}
		case apiapi.RequestDomainErr as failure:
			return mcp.ToolError{Message: rpc.Tagged("RequestDomainErr", rpc.Encode(failure.E))}
		case apiapi.CutoverDomainErr as failure:
			return mcp.ToolError{Message: rpc.Tagged("CutoverDomainErr", rpc.Encode(failure.E))}
		case apiapi.StoreFailed as failure:
			return mcp.ToolError{Message: rpc.Tagged("StoreFailed", rpc.Encode(failure.E))}
		case apiapi.HostCapacityFailed as failure:
			return mcp.ToolError{Message: rpc.Tagged("HostCapacityFailed", rpc.Encode(failure.E))}
		case apiapi.McpAuthDenied as failure:
			return mcp.ToolError{Message: rpc.Tagged("McpAuthDenied", rpc.Encode(failure.E))}
		}
	}
}

// Answer answers r through the hub's Call on the bound api.Api (Show).
func Answer(r Request) json.Value fails mcp.ToolError needs api.Api {
	try Show(apiapi.Call(r))
}

// ReadAnswer is the outcome of r that a tool's result says: its value's
// JSON, or, when it is an error, an admitted failure's tagged JSON.
// Invalid or missing replies fail Transport, outside the operation's own row.
func ReadAnswer(r Request, result mcp.Called) apiapi.Outcome fails rpc.Transport {
	if result.Content.Len() != 1 {
		return rpc.Transport{Reason: "a tool answered \(result.Content.Len()) blocks, not one"}
	}
	let text = result.Content[0].Text
	if !result.IsError {
		match r {
		case apiapi.ThreadCreateRequest:
