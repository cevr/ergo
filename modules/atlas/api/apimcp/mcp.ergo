// Call is the Request that a call of the tool name with arguments asks
// for: arguments that are not the tool's fail ToolError, a name that is
// no tool's UnknownTool.
func Call(name string, arguments json.Value) Request fails mcp.ToolError | mcp.UnknownTool {
	let text = match name {
	case "thread-create":
		rpc.Tagged("ThreadCreateRequest", "{\"input\":"+textOf(arguments)+"}")
	case "thread-get":
		rpc.Tagged("ThreadGetRequest", "{\"input\":"+textOf(arguments)+"}")
	case "thread-list":
		rpc.Tagged("ThreadListRequest", "{\"input\":"+textOf(arguments)+"}")
	case "thread-archive":
		rpc.Tagged("ThreadArchiveRequest", "{\"input\":"+textOf(arguments)+"}")
	case "driver-switch":
		rpc.Tagged("DriverSwitchRequest", "{\"input\":"+textOf(arguments)+"}")
	case "prompt-enqueue":
		rpc.Tagged("PromptEnqueueRequest", "{\"input\":"+textOf(arguments)+"}")
	case "prompt-dequeue":
		rpc.Tagged("PromptDequeueRequest", "{\"input\":"+textOf(arguments)+"}")
	case "turn-start":
		rpc.Tagged("TurnStartRequest", "{\"input\":"+textOf(arguments)+"}")
	case "turn-step":
		rpc.Tagged("TurnStepRequest", "{\"input\":"+textOf(arguments)+"}")
	case "subagent-tree-init":
		rpc.Tagged("SubagentTreeInitRequest", "{\"input\":"+textOf(arguments)+"}")
	case "subagent-spawn":
		rpc.Tagged("SubagentSpawnRequest", "{\"input\":"+textOf(arguments)+"}")
	case "subagent-control-handle":
		rpc.Tagged("SubagentControlHandleRequest", "{\"input\":"+textOf(arguments)+"}")
	case "subagent-settle-handle":
		rpc.Tagged("SubagentSettleHandleRequest", "{\"input\":"+textOf(arguments)+"}")
	case "subagent-hand-back":
		rpc.Tagged("SubagentHandBackRequest", "{\"input\":"+textOf(arguments)+"}")
	case "subagent-tree-get":
		rpc.Tagged("SubagentTreeGetRequest", "{\"input\":"+textOf(arguments)+"}")
	case "handle-open":
		rpc.Tagged("HandleOpenRequest", "{\"input\":"+textOf(arguments)+"}")
	case "handle-settle":
		rpc.Tagged("HandleSettleRequest", "{\"input\":"+textOf(arguments)+"}")
	case "handle-list":
		rpc.Tagged("HandleListRequest", "{\"input\":"+textOf(arguments)+"}")
	case "owner-calls-retire":
		rpc.Tagged("OwnerCallsRetireRequest", "{\"input\":"+textOf(arguments)+"}")
	case "question-ask":
		rpc.Tagged("QuestionAskRequest", "{\"input\":"+textOf(arguments)+"}")
	case "question-answer":
		rpc.Tagged("QuestionAnswerRequest", "{\"input\":"+textOf(arguments)+"}")
	case "question-withdraw":
		rpc.Tagged("QuestionWithdrawRequest", "{\"input\":"+textOf(arguments)+"}")
	case "question-list":
		rpc.Tagged("QuestionListRequest", "{\"input\":"+textOf(arguments)+"}")
	case "pool-account-upsert":
		rpc.Tagged("PoolAccountUpsertRequest", "{\"input\":"+textOf(arguments)+"}")
	case "pool-hold-open":
		rpc.Tagged("PoolHoldOpenRequest", "{\"input\":"+textOf(arguments)+"}")
	case "pool-hold-transition":
		rpc.Tagged("PoolHoldTransitionRequest", "{\"input\":"+textOf(arguments)+"}")
	case "pool-view":
		rpc.Tagged("PoolViewRequest", "{\"input\":"+textOf(arguments)+"}")
	case "kernel-snapshot-save":
		rpc.Tagged("KernelSnapshotSaveRequest", "{\"input\":"+textOf(arguments)+"}")
	case "kernel-cut-record":
		rpc.Tagged("KernelCutRecordRequest", "{\"input\":"+textOf(arguments)+"}")
	case "kernel-view":
		rpc.Tagged("KernelViewRequest", "{\"input\":"+textOf(arguments)+"}")
	case "lease-acquire":
		rpc.Tagged("LeaseAcquireRequest", "{\"input\":"+textOf(arguments)+"}")
	case "boot-reconcile":
		rpc.Tagged("BootReconcileRequest", "{\"input\":"+textOf(arguments)+"}")
	case "boot-status":
		rpc.Tagged("BootStatusRequest", "{\"input\":"+textOf(arguments)+"}")
	case "host-capacity-get":
		rpc.Tagged("HostCapacityGetRequest", "{\"input\":"+textOf(arguments)+"}")
	case "wellness-report-get":
		rpc.Tagged("WellnessReportGetRequest", "{\"input\":"+textOf(arguments)+"}")
	case "mcp-token-mint":
		rpc.Tagged("McpTokenMintRequest", "{\"input\":"+textOf(arguments)+"}")
	case "mcp-token-revoke":
		rpc.Tagged("McpTokenRevokeRequest", "{\"input\":"+textOf(arguments)+"}")
	case "mcp-token-list":
		rpc.Tagged("McpTokenListRequest", "{\"input\":"+textOf(arguments)+"}")
	case _:
		return mcp.UnknownTool{Name: name}
	}
	rpc.Decode[Request]("arguments of "+name, text) catch {
	case rpc.Transport as e:
		return mcp.ToolError{Message: e.Reason}
	}
}

