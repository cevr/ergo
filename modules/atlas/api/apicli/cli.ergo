// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case apiapi.ThreadCreateRequest as x:
		let mut out = []string{"thread-create"}
		out = out.Append("-command-id=\(x.Input.CommandID)")
		out = out.Append("-actor=\(x.Input.Actor)")
		out = out.Append("-at-ms=\(x.Input.AtMs)")
		out = out.Append("-thread-id=\(x.Input.ThreadID)")
		out = out.Append("-driver=\(x.Input.Driver)")
		out = out.Append("-permission-mode=\(x.Input.PermissionMode)")
		out = out.Append("-instance=\(x.Input.Instance)")
		out = out.Append("-config-dir=\(x.Input.ConfigDir)")
		out = out.Append("-model=\(x.Input.Model)")
		out = out.Append("-agy-direct-supported=\(x.Input.AgyDirectSupported)")
		match x.Input.ParentThreadID {
		case json.Present[string] as s:
			out = out.Append("-parent-thread-id=\(s.Value)")
		case json.Absent:
		}
		match x.Input.EdgeLabel {
		case json.Present[string] as s:
			out = out.Append("-edge-label=\(s.Value)")
		case json.Absent:
		}
		match x.Input.SharedHome {
		case json.Present[string] as s:
			out = out.Append("-shared-home=\(s.Value)")
		case json.Absent:
		}
		match x.Input.LinkOriginKind {
		case json.Present[string] as s:
			out = out.Append("-link-origin-kind=\(s.Value)")
		case json.Absent:
		}
		match x.Input.LinkOriginTarget {
		case json.Present[string] as s:
			out = out.Append("-link-origin-target=\(s.Value)")
		case json.Absent:
		}
		out
	case apiapi.ThreadGetRequest as x:
		let mut out = []string{"thread-get"}
		out = out.Append("-thread-id=\(x.Input.ThreadID)")
		out
	case apiapi.ThreadListRequest as x:
		let mut out = []string{"thread-list"}
		out = out.Append("-include-archived=\(x.Input.IncludeArchived)")
		match x.Input.Limit {
		case json.Present[int] as s:
			out = out.Append("-limit=\(s.Value)")
		case json.Absent:
		}
		match x.Input.Offset {
		case json.Present[int] as s:
			out = out.Append("-offset=\(s.Value)")
		case json.Absent:
		}
		out
	case apiapi.ThreadArchiveRequest as x:
