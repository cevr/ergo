// RoundTrips reports whether Parse reads what Print writes of r as r.
func RoundTrips(r Request) bool {
	let back = Parse(Print(r)) catch {
	case flag.Failure:
		return false
	}
	back == r
}

// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// Policy is what a binary decides of its command line: Code, the exit
// status of a typed failure (default 1); Text, the text of a value
// without --json (default None: a basic value as its text, else its
// JSON; --json never calls it); Confirm, the question a call asks before
// it runs (default None: none; --yes answers it).
type Policy { Code func(f apiapi.Failure) int, Text func(r apiapi.Reply) option.Option[string], Confirm func(r Request) option.Option[string] }

// Defaults is the Policy of a binary that decides nothing.
func Defaults() Policy {
	Policy{Code: func(f apiapi.Failure) int { 1 }, Text: func(r apiapi.Reply) option.Option[string] { option.None }, Confirm: func(r Request) option.Option[string] { option.None }}
}

func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else {
		Output{Out: line(plain), Err: "", Code: 0}
	}
}

func line(s string) string {
	if s == "" {
		return ""
	}
	s + "\n"
}

func failed(asJSON bool, tagged string, status int) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: status}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: status}
	}
}

// Show is what Run prints of the outcome o under the policy p: the value
// (p's Text when it has one and there is no --json; else its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed) with p's Code.
func Show(o apiapi.Outcome, asJSON bool, p Policy) Output {
	match o {
	case apiapi.Done as done:
		if !asJSON {
			match p.Text(done.Reply) {
			case option.Some[string] as s:
				return Output{Out: line(s.Value), Err: "", Code: 0}
			case option.None:
			}
		}
		match done.Reply {
		case apiapi.ThreadCreateReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.ThreadGetReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.ThreadListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.ThreadArchiveReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.DriverSwitchReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.PromptEnqueueReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.PromptDequeueReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.TurnStartReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.TurnStepReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.SubagentTreeInitReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.SubagentSpawnReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.SubagentControlHandleReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.SubagentSettleHandleReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.SubagentHandBackReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.SubagentTreeGetReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.HandleOpenReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.HandleSettleReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.HandleListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.OwnerCallsRetireReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.QuestionAskReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.QuestionAnswerReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.QuestionWithdrawReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.QuestionListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.PoolAccountUpsertReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.PoolHoldOpenReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.PoolHoldTransitionReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.PoolViewReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.KernelSnapshotSaveReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.KernelCutRecordReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.KernelViewReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.LeaseAcquireReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.BootReconcileReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.BootStatusReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.HostCapacityGetReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.WellnessReportGetReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.McpTokenMintReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.McpTokenRevokeReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case apiapi.McpTokenListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		}
	case apiapi.Rejected as rejected:
		let status = p.Code(rejected.Failure)
		match rejected.Failure {
		case apiapi.NotFound as failure:
			failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(failure.E)), status)
		case apiapi.AlreadyExists as failure:
			failed(asJSON, rpc.Tagged("AlreadyExists", rpc.Encode(failure.E)), status)
		case apiapi.InvalidTransition as failure:
			failed(asJSON, rpc.Tagged("InvalidTransition", rpc.Encode(failure.E)), status)
		case apiapi.CommandReused as failure:
			failed(asJSON, rpc.Tagged("CommandReused", rpc.Encode(failure.E)), status)
		case apiapi.InvalidInput as failure:
			failed(asJSON, rpc.Tagged("InvalidInput", rpc.Encode(failure.E)), status)
		case apiapi.LeaseFenced as failure:
			failed(asJSON, rpc.Tagged("LeaseFenced", rpc.Encode(failure.E)), status)
		case apiapi.ThreadDomainErr as failure:
			failed(asJSON, rpc.Tagged("ThreadDomainErr", rpc.Encode(failure.E)), status)
		case apiapi.SubagentDomainErr as failure:
			failed(asJSON, rpc.Tagged("SubagentDomainErr", rpc.Encode(failure.E)), status)
		case apiapi.HandleDomainErr as failure:
			failed(asJSON, rpc.Tagged("HandleDomainErr", rpc.Encode(failure.E)), status)
		case apiapi.LimitDomainErr as failure:
			failed(asJSON, rpc.Tagged("LimitDomainErr", rpc.Encode(failure.E)), status)
		case apiapi.RequestDomainErr as failure:
			failed(asJSON, rpc.Tagged("RequestDomainErr", rpc.Encode(failure.E)), status)
		case apiapi.CutoverDomainErr as failure:
			failed(asJSON, rpc.Tagged("CutoverDomainErr", rpc.Encode(failure.E)), status)
		case apiapi.StoreFailed as failure:
			failed(asJSON, rpc.Tagged("StoreFailed", rpc.Encode(failure.E)), status)
		case apiapi.HostCapacityFailed as failure:
			failed(asJSON, rpc.Tagged("HostCapacityFailed", rpc.Encode(failure.E)), status)
		case apiapi.McpAuthDenied as failure:
			failed(asJSON, rpc.Tagged("McpAuthDenied", rpc.Encode(failure.E)), status)
		}
	}
}

// Read is the outcome of r that the Output of Run with --json and its
// default status policy says: its value's JSON on standard output with
// status 0, or an admitted failure's tagged JSON with status 1. Invalid
// or missing replies fail Transport, outside the operation's own row.
func Read(r Request, out Output) apiapi.Outcome fails rpc.Transport {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case apiapi.ThreadCreateRequest:
			let v = try rpc.Decode[api.ThreadSnapshot]("value", text)
			apiapi.Done{Reply: apiapi.ThreadCreateReply{Value: v}}
