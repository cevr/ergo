		case apiapi.McpTokenRevokeRequest:
			match rpc.TagOf(text) {
			case "InvalidInput":
				let e = try rpc.Decode[memory.InvalidInput]("failure", text)
				apiapi.Rejected{Failure: apiapi.InvalidInput{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered McpTokenRevoke with an undeclared failure: " + text}
			}
		case apiapi.McpTokenListRequest:
			match rpc.TagOf(text) {
			case "InvalidInput":
				let e = try rpc.Decode[memory.InvalidInput]("failure", text)
				apiapi.Rejected{Failure: apiapi.InvalidInput{E: e}}
			case _:
				return rpc.Transport{Reason: "the command line answered McpTokenList with an undeclared failure: " + text}
			}
		}
	} else {
		return rpc.Transport{Reason: "the command line answered status \(out.Code): " + out.Err}
	}
}

type front = asked{R Request, JSON bool, Yes bool} | ended{O Output}

func frontOf(args []string) front {
	let mut asJSON = false
	let mut yes = false
	let mut globals = true
	let mut rest = []string{}
	for a in args {
		if globals && (a == "--json" || a == "-json") {
			asJSON = true
		} else if globals && (a == "--yes" || a == "-yes") {
			yes = true
		} else {
			globals = false
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return ended{O: Output{Out: h.Text, Err: "", Code: 0}}
	case err:
		return ended{O: Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}}
	}
	asked{R: r, JSON: asJSON, Yes: yes}
}

func needsYes(question string) Output {
	Output{Out: "", Err: question + " (no terminal to ask on: pass --yes to answer yes)\n", Code: 2}
}

func declined(question string) Output {
	Output{Out: "", Err: question + ": not confirmed\n", Code: 1}
}

func runOver[R](args []string, p Policy, answer func(r Request) apiapi.Outcome needs R) Output needs R {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case option.Some[string] as q:
				return needsYes(q.Value)
			case option.None:
			}
		}
		Show(answer(a.R), a.JSON, p)
	}
}

// Run reads args as [--json] [--yes] COMMAND ARGS..., answers the call
// through the hub's Call on the api.Api the caller binds, and is what to
// print under the policy p: the value, a typed failure with p's Code, the
// help (status 0) or a usage error (status 2). It asks nothing: a call p
// asks a question of needs --yes (status 2 without it).
func Run(args []string, p Policy) Output needs api.Api {
	runOver(args, p, apiapi.Call)
}

// RunOnTerminal is Run that asks p's question on the terminal (std
// prompt) when there is no --yes: a yes runs the call, a no or a cancel
// ends with status 1, and standard input that is not a terminal ends with
// status 2, as Run does.
func RunOnTerminal(args []string, p Policy) Output needs api.Api | term.Terminal | io.Stderr {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case option.Some[string] as q:
				let yes = prompt.Confirm(q.Value, false) catch {
				case prompt.NotInteractive:
					return needsYes(q.Value)
				case prompt.Cancelled:
					return declined(q.Value)
				case io.ReadFailed:
					return Output{Out: "", Err: q.Value + ": the answer could not be read\n", Code: 2}
				}
				if !yes {
					return declined(q.Value)
				}
			case option.None:
			}
		}
		Show(apiapi.Call(a.R), a.JSON, p)
	}
}

// Completion is the script that completes api's commands in shell.
func Completion(shell ergoapi.Shell) string {
	ergoapi.Completion("api", shell, []ergoapi.Entry{ergoapi.Entry{Name: apiapi.Name(apiapi.ThreadCreateOp), Doc: apiapi.Doc(apiapi.ThreadCreateOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.ThreadGetOp), Doc: apiapi.Doc(apiapi.ThreadGetOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.ThreadListOp), Doc: apiapi.Doc(apiapi.ThreadListOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.ThreadArchiveOp), Doc: apiapi.Doc(apiapi.ThreadArchiveOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.DriverSwitchOp), Doc: apiapi.Doc(apiapi.DriverSwitchOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.PromptEnqueueOp), Doc: apiapi.Doc(apiapi.PromptEnqueueOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.PromptDequeueOp), Doc: apiapi.Doc(apiapi.PromptDequeueOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.TurnStartOp), Doc: apiapi.Doc(apiapi.TurnStartOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.TurnStepOp), Doc: apiapi.Doc(apiapi.TurnStepOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.SubagentTreeInitOp), Doc: apiapi.Doc(apiapi.SubagentTreeInitOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.SubagentSpawnOp), Doc: apiapi.Doc(apiapi.SubagentSpawnOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.SubagentControlHandleOp), Doc: apiapi.Doc(apiapi.SubagentControlHandleOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.SubagentSettleHandleOp), Doc: apiapi.Doc(apiapi.SubagentSettleHandleOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.SubagentHandBackOp), Doc: apiapi.Doc(apiapi.SubagentHandBackOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.SubagentTreeGetOp), Doc: apiapi.Doc(apiapi.SubagentTreeGetOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.HandleOpenOp), Doc: apiapi.Doc(apiapi.HandleOpenOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.HandleSettleOp), Doc: apiapi.Doc(apiapi.HandleSettleOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.HandleListOp), Doc: apiapi.Doc(apiapi.HandleListOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.OwnerCallsRetireOp), Doc: apiapi.Doc(apiapi.OwnerCallsRetireOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.QuestionAskOp), Doc: apiapi.Doc(apiapi.QuestionAskOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.QuestionAnswerOp), Doc: apiapi.Doc(apiapi.QuestionAnswerOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.QuestionWithdrawOp), Doc: apiapi.Doc(apiapi.QuestionWithdrawOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.QuestionListOp), Doc: apiapi.Doc(apiapi.QuestionListOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.PoolAccountUpsertOp), Doc: apiapi.Doc(apiapi.PoolAccountUpsertOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.PoolHoldOpenOp), Doc: apiapi.Doc(apiapi.PoolHoldOpenOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.PoolHoldTransitionOp), Doc: apiapi.Doc(apiapi.PoolHoldTransitionOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.PoolViewOp), Doc: apiapi.Doc(apiapi.PoolViewOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.KernelSnapshotSaveOp), Doc: apiapi.Doc(apiapi.KernelSnapshotSaveOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.KernelCutRecordOp), Doc: apiapi.Doc(apiapi.KernelCutRecordOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.KernelViewOp), Doc: apiapi.Doc(apiapi.KernelViewOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.LeaseAcquireOp), Doc: apiapi.Doc(apiapi.LeaseAcquireOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.BootReconcileOp), Doc: apiapi.Doc(apiapi.BootReconcileOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.BootStatusOp), Doc: apiapi.Doc(apiapi.BootStatusOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.HostCapacityGetOp), Doc: apiapi.Doc(apiapi.HostCapacityGetOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.WellnessReportGetOp), Doc: apiapi.Doc(apiapi.WellnessReportGetOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.McpTokenMintOp), Doc: apiapi.Doc(apiapi.McpTokenMintOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.McpTokenRevokeOp), Doc: apiapi.Doc(apiapi.McpTokenRevokeOp)}, ergoapi.Entry{Name: apiapi.Name(apiapi.McpTokenListOp), Doc: apiapi.Doc(apiapi.McpTokenListOp)}})
}

// Wire is the command line as a transport of the hub's calls.
type Wire {} implements ergoapi.Transport[Request, apiapi.Outcome, rpc.Transport]

// Carry prints c with --json, runs it against answer using the default
// status policy, and reads back the reply. Delivery can fail separately
// from answer's outcome.
func Carry(w Wire, c Request, answer own func(c Request) apiapi.Outcome) apiapi.Outcome fails rpc.Transport {
	let mut args = []string{"--json"}
	for a in Print(c) {
		args = args.Append(a)
	}
	try Read(c, runOver(args, Defaults(), answer))
}

// Agrees: the command line carries every call and every outcome the
// call can have unchanged.
law Agrees(r Request, g apiapi.Given) { ergoapi.Agrees[Request, apiapi.Outcome, rpc.Transport](Wire, r, apiapi.OutcomeOf(r, g)) }

// CodeIsThePolicy: a call's status is 0 for a value and the policy's
// Code for a typed failure.
law CodeIsThePolicy(r Request, g apiapi.Given, k int) {
	let status = 1 + ((k%125)+125)%125
	let d = Defaults()
	let p = Policy{..d, Code: func(f apiapi.Failure) int { status }}
	let o = apiapi.OutcomeOf(r, g)
	let out = runOver(Print(r), p, func(c Request) apiapi.Outcome { o })
	match o {
	case apiapi.Done:
		out.Code == 0
	case apiapi.Rejected:
		out.Code == status
	}
}

// TextIsThePolicy: without --json a value prints as the policy's Text;
// with --json every outcome prints as the wire's JSON, whatever Text says.
law TextIsThePolicy(r Request, g apiapi.Given, t string) {
	let d = Defaults()
	let p = Policy{..d, Text: func(reply apiapi.Reply) option.Option[string] { option.Some[string]{Value: t} }}
	let o = apiapi.OutcomeOf(r, g)
	let same = Show(o, true, p) == Show(o, true, d)
	match o {
	case apiapi.Done:
		same && Show(o, false, p).Out == line(t)
	case apiapi.Rejected:
		same && Show(o, false, p) == Show(o, false, d)
	}
}
