// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case ThreadCreateRequest:
		Done{Reply: ThreadCreateReply{Value: g.Values.ThreadCreate}}
	case ThreadGetRequest:
		Done{Reply: ThreadGetReply{Value: g.Values.ThreadGet}}
	case ThreadListRequest:
		Done{Reply: ThreadListReply{Value: g.Values.ThreadList}}
	case ThreadArchiveRequest:
		Done{Reply: ThreadArchiveReply{Value: g.Values.ThreadArchive}}
	case DriverSwitchRequest:
		Done{Reply: DriverSwitchReply{Value: g.Values.DriverSwitch}}
	case PromptEnqueueRequest:
		Done{Reply: PromptEnqueueReply{Value: g.Values.PromptEnqueue}}
	case PromptDequeueRequest:
		Done{Reply: PromptDequeueReply{Value: g.Values.PromptDequeue}}
	case TurnStartRequest:
		Done{Reply: TurnStartReply{Value: g.Values.TurnStart}}
	case TurnStepRequest:
		Done{Reply: TurnStepReply{Value: g.Values.TurnStep}}
	case SubagentTreeInitRequest:
		Done{Reply: SubagentTreeInitReply{Value: g.Values.SubagentTreeInit}}
	case SubagentSpawnRequest:
		Done{Reply: SubagentSpawnReply{Value: g.Values.SubagentSpawn}}
	case SubagentControlHandleRequest:
		Done{Reply: SubagentControlHandleReply{Value: g.Values.SubagentControlHandle}}
	case SubagentSettleHandleRequest:
		Done{Reply: SubagentSettleHandleReply{Value: g.Values.SubagentSettleHandle}}
	case SubagentHandBackRequest:
		Done{Reply: SubagentHandBackReply{Value: g.Values.SubagentHandBack}}
	case SubagentTreeGetRequest:
		Done{Reply: SubagentTreeGetReply{Value: g.Values.SubagentTreeGet}}
	case HandleOpenRequest:
		Done{Reply: HandleOpenReply{Value: g.Values.HandleOpen}}
	case HandleSettleRequest:
		Done{Reply: HandleSettleReply{Value: g.Values.HandleSettle}}
	case HandleListRequest:
		Done{Reply: HandleListReply{Value: g.Values.HandleList}}
	case OwnerCallsRetireRequest:
		Done{Reply: OwnerCallsRetireReply{Value: g.Values.OwnerCallsRetire}}
	case QuestionAskRequest:
		Done{Reply: QuestionAskReply{Value: g.Values.QuestionAsk}}
	case QuestionAnswerRequest:
		Done{Reply: QuestionAnswerReply{Value: g.Values.QuestionAnswer}}
	case QuestionWithdrawRequest:
		Done{Reply: QuestionWithdrawReply{Value: g.Values.QuestionWithdraw}}
	case QuestionListRequest:
		Done{Reply: QuestionListReply{Value: g.Values.QuestionList}}
	case PoolAccountUpsertRequest:
		Done{Reply: PoolAccountUpsertReply{Value: g.Values.PoolAccountUpsert}}
	case PoolHoldOpenRequest:
		Done{Reply: PoolHoldOpenReply{Value: g.Values.PoolHoldOpen}}
	case PoolHoldTransitionRequest:
		Done{Reply: PoolHoldTransitionReply{Value: g.Values.PoolHoldTransition}}
	case PoolViewRequest:
		Done{Reply: PoolViewReply{Value: g.Values.PoolView}}
	case KernelSnapshotSaveRequest:
		Done{Reply: KernelSnapshotSaveReply{Value: g.Values.KernelSnapshotSave}}
	case KernelCutRecordRequest:
		Done{Reply: KernelCutRecordReply{Value: g.Values.KernelCutRecord}}
	case KernelViewRequest:
		Done{Reply: KernelViewReply{Value: g.Values.KernelView}}
	case LeaseAcquireRequest:
		Done{Reply: LeaseAcquireReply{Value: g.Values.LeaseAcquire}}
	case BootReconcileRequest:
		Done{Reply: BootReconcileReply{Value: g.Values.BootReconcile}}
	case BootStatusRequest:
		Done{Reply: BootStatusReply{Value: g.Values.BootStatus}}
	case HostCapacityGetRequest:
		Done{Reply: HostCapacityGetReply{Value: g.Values.HostCapacityGet}}
	case WellnessReportGetRequest:
		Done{Reply: WellnessReportGetReply{Value: g.Values.WellnessReportGet}}
	case McpTokenMintRequest:
		Done{Reply: McpTokenMintReply{Value: g.Values.McpTokenMint}}
	case McpTokenRevokeRequest:
		Done{Reply: McpTokenRevokeReply{Value: g.Values.McpTokenRevoke}}
	case McpTokenListRequest:
		Done{Reply: McpTokenListReply{Value: g.Values.McpTokenList}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opThreadCreate: func(input api.ThreadCreateInput) api.ThreadSnapshot fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(ThreadCreateRequest{Input: input}) })
			if g.Failing {
				match g.Failure {
				case NotFound as err:
					return err.E
				case AlreadyExists as err:
					return err.E
				case InvalidTransition as err:
					return err.E
				case CommandReused as err:
					return err.E
				case InvalidInput as err:
					return err.E
				case LeaseFenced as err:
					return err.E
				case ThreadDomainErr as err:
					return err.E
				case SubagentDomainErr as err:
					return err.E
				case HandleDomainErr as err:
					return err.E
				case LimitDomainErr as err:
					return err.E
				case RequestDomainErr as err:
					return err.E
				case CutoverDomainErr as err:
					return err.E
				case StoreFailed as err:
					return err.E
