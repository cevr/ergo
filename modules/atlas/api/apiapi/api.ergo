// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { ThreadCreate api.ThreadSnapshot, ThreadGet api.ThreadSnapshot, ThreadList api.ThreadListOutput, ThreadArchive api.ThreadSnapshot, DriverSwitch api.ThreadSnapshot, PromptEnqueue api.ThreadSnapshot, PromptDequeue api.ThreadSnapshot, TurnStart api.ThreadSnapshot, TurnStep api.ThreadSnapshot, SubagentTreeInit api.SubagentTreeOutput, SubagentSpawn api.SubagentTreeOutput, SubagentControlHandle api.SubagentTreeOutput, SubagentSettleHandle api.SubagentTreeOutput, SubagentHandBack api.SubagentTreeOutput, SubagentTreeGet api.SubagentTreeOutput, HandleOpen api.HandleEntryView, HandleSettle api.HandleEntryView, HandleList api.HandleViewOutput, OwnerCallsRetire api.RetiredCallsOutput, QuestionAsk api.AsyncQuestionView, QuestionAnswer api.AsyncQuestionView, QuestionWithdraw api.AsyncQuestionView, QuestionList api.AsyncQuestionListOutput, PoolAccountUpsert api.PoolViewOutput, PoolHoldOpen api.PoolViewOutput, PoolHoldTransition api.PoolViewOutput, PoolView api.PoolViewOutput, KernelSnapshotSave api.KernelViewOutput, KernelCutRecord api.KernelViewOutput, KernelView api.KernelViewOutput, LeaseAcquire api.BootLeaseOutput, BootReconcile api.BootLeaseOutput, BootStatus api.BootLeaseOutput, HostCapacityGet api.HostCapacityReport, WellnessReportGet api.WellnessReport, McpTokenMint api.MintedToken, McpTokenRevoke api.McpTokenRevokeOutput, McpTokenList api.McpTokenListOutput }

func inRow(op Op, f Failure) bool {
	match op {
	case ThreadCreateOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case ThreadGetOp:
		match f {
		case NotFound, InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case ThreadListOp:
		match f {
		case InvalidInput, StoreFailed:
			true
		case _:
			false
		}
	case ThreadArchiveOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case DriverSwitchOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case PromptEnqueueOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case PromptDequeueOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case TurnStartOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case TurnStepOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case SubagentTreeInitOp:
		match f {
		case NotFound, AlreadyExists, InvalidTransition, CommandReused, InvalidInput, LeaseFenced, ThreadDomainErr, SubagentDomainErr, HandleDomainErr, LimitDomainErr, RequestDomainErr, CutoverDomainErr, StoreFailed:
			true
		case _:
			false
		}
	case SubagentSpawnOp:
		match f {
