// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case ThreadCreateOp:
		"ThreadCreate initializes and persists a new Atlas thread and optional parent branch edge."
	case ThreadGetOp:
		"ThreadGet reads a projected thread together with its connected branch edges and FIFO prompt queue."
	case ThreadListOp:
		"ThreadList lists persisted threads ordered by creation sequence with optional pagination."
	case ThreadArchiveOp:
		"ThreadArchive archives an idle thread, releases its live session, and revokes its /mcp bearer tokens."
	case DriverSwitchOp:
		"DriverSwitch switches a thread between Meta and Direct drivers when no turn is active."
	case PromptEnqueueOp:
		"PromptEnqueue appends a follow-up prompt to a thread's FIFO prompt queue."
	case PromptDequeueOp:
		"PromptDequeue pops the head follow-up prompt from an idle thread's prompt queue."
	case TurnStartOp:
		"TurnStart allocates or reuses a live session, starts one turn, and touches current-generation /mcp tokens."
	case TurnStepOp:
		"TurnStep advances the active turn on a thread through TurnAction transitions."
	case SubagentTreeInitOp:
		"SubagentTreeInit initializes a bounded recursive subagent tree rooted at RootID."
	case SubagentSpawnOp:
		"SubagentSpawn spawns a bounded child node beneath ParentID in RootID's tree."
	case SubagentControlHandleOp:
		"SubagentControlHandle opens an unsettled subagent handle strictly within CallerID's subtree."
	case SubagentSettleHandleOp:
		"SubagentSettleHandle settles a tracked subagent handle on NodeID and unparks NodeID when clear."
	case SubagentHandBackOp:
		"SubagentHandBack finalizes hand-back for an unblocked subagent child node."
	case SubagentTreeGetOp:
		"SubagentTreeGet reads one projected bounded subagent tree by RootID."
	case HandleOpenOp:
		"HandleOpen registers a new DELIVERS wake handle with optional subagent tree correlation."
	case HandleSettleOp:
		"HandleSettle settles an open DELIVERS handle once to a terminal disposition."
	case HandleListOp:
		"HandleList queries matching DELIVERS handles, wake records, and pool holds."
	case OwnerCallsRetireOp:
		"OwnerCallsRetire retires all open KindCall handles owned by a dead server incarnation as DispLost."
	case QuestionAskOp:
		"QuestionAsk persists an ask_user_async question correlated with a KindQuestion handle."
	case QuestionAnswerOp:
		"QuestionAnswer records a single immutable answer on an open ask_user_async question."
	case QuestionWithdrawOp:
		"QuestionWithdraw silently withdraws an open ask_user_async question and cancels its handle."
	case QuestionListOp:
		"QuestionList queries persisted ask_user_async entries by optional ThreadID and Status."
	case PoolAccountUpsertOp:
		"PoolAccountUpsert creates or updates quota window utilization and health state for an account slot."
	case PoolHoldOpenOp:
		"PoolHoldOpen creates a waiting quota pool hold keyed by HoldKey with HoldWakeDeliveryID."
	case PoolHoldTransitionOp:
		"PoolHoldTransition wakes or cancels an existing waiting quota pool hold."
	case PoolViewOp:
		"PoolView queries durable quota pool accounts and active/due holds at NowMs."
	case KernelSnapshotSaveOp:
		"KernelSnapshotSave saves a bounded serialized kernel binding snapshot for one session."
	case KernelCutRecordOp:
		"KernelCutRecord records one cut.calls / cut.maps audit journal and updates hourly root accounting."
	case KernelViewOp:
		"KernelView queries persisted kernel snapshot, cut journals, root usages, limits, and requests."
	case LeaseAcquireOp:
		"LeaseAcquire acquires or CAS-advances a fenced server ownership lease."
	case BootReconcileOp:
		"BootReconcile executes deterministic startup reconciliation across handles, wakes, turns, requests, and subagents."
	case BootStatusOp:
		"BootStatus inspects active server lease status, open volatile owners, and pending boot reconciliation scope."
	case HostCapacityGetOp:
		"HostCapacityGet returns non-blocking CPU, load, memory, and volume capacity metrics from HostCapacity."
	case WellnessReportGetOp:
		"WellnessReportGet evaluates non-spawning store consistency, handle/pool health, and host capacity headroom."
	case McpTokenMintOp:
		"McpTokenMint mints or rotates a SHA-256-hashed per-thread /mcp bearer credential."
	case McpTokenRevokeOp:
		"McpTokenRevoke revokes all active /mcp bearer tokens for ThreadID or SessionID."
	case McpTokenListOp:
		"McpTokenList lists redacted /mcp bearer token summaries for ThreadID without exposing digests or secrets."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case ThreadCreateOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"threadID\":{\"type\":\"string\"},\"driver\":{\"type\":\"string\"},\"permissionMode\":{\"type\":\"string\"},\"instance\":{\"type\":\"string\"},\"configDir\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"},\"agyDirectSupported\":{\"type\":\"boolean\"},\"parentThreadID\":{\"type\":\"string\"},\"edgeLabel\":{\"type\":\"string\"},\"sharedHome\":{\"type\":\"string\"},\"linkOriginKind\":{\"type\":\"string\"},\"linkOriginTarget\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"threadID\",\"driver\",\"permissionMode\",\"instance\",\"configDir\",\"model\",\"agyDirectSupported\"]}")
	case ThreadGetOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"threadID\":{\"type\":\"string\"}},\"required\":[\"threadID\"]}")
	case ThreadListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"includeArchived\":{\"type\":\"boolean\"},\"limit\":{\"type\":\"integer\"},\"offset\":{\"type\":\"integer\"}},\"required\":[\"includeArchived\"]}")
	case ThreadArchiveOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"threadID\":{\"type\":\"string\"},\"archiveReason\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"threadID\"]}")
	case DriverSwitchOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"threadID\":{\"type\":\"string\"},\"nextDriver\":{\"type\":\"string\"},\"permissionMode\":{\"type\":\"string\"},\"instance\":{\"type\":\"string\"},\"configDir\":{\"type\":\"string\"},\"agyDirectSupported\":{\"type\":\"boolean\"},\"sharedHome\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"threadID\",\"nextDriver\",\"permissionMode\",\"instance\",\"configDir\",\"agyDirectSupported\"]}")
	case PromptEnqueueOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"threadID\":{\"type\":\"string\"},\"promptID\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"requestedMode\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"threadID\",\"promptID\",\"body\",\"requestedMode\"]}")
	case PromptDequeueOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"threadID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"threadID\"]}")
	case TurnStartOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"threadID\":{\"type\":\"string\"},\"turnID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"threadID\",\"turnID\"]}")
	case TurnStepOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"threadID\":{\"type\":\"string\"},\"action\":{\"type\":\"string\"},\"failureClass\":{\"type\":\"string\"},\"failureDetail\":{\"type\":\"string\"},\"resetAtMs\":{\"type\":\"integer\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"threadID\",\"action\"]}")
	case SubagentTreeInitOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"rootID\":{\"type\":\"string\"},\"maxDepth\":{\"type\":\"integer\"},\"maxFanOut\":{\"type\":\"integer\"},\"maxBudget\":{\"type\":\"integer\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"rootID\",\"maxDepth\",\"maxFanOut\",\"maxBudget\"]}")
	case SubagentSpawnOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"rootID\":{\"type\":\"string\"},\"parentID\":{\"type\":\"string\"},\"childID\":{\"type\":\"string\"},\"role\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"rootID\",\"parentID\",\"childID\",\"role\"]}")
	case SubagentControlHandleOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"rootID\":{\"type\":\"string\"},\"callerID\":{\"type\":\"string\"},\"targetID\":{\"type\":\"string\"},\"handleID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"rootID\",\"callerID\",\"targetID\",\"handleID\"]}")
	case SubagentSettleHandleOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"rootID\":{\"type\":\"string\"},\"nodeID\":{\"type\":\"string\"},\"handleID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"rootID\",\"nodeID\",\"handleID\"]}")
	case SubagentHandBackOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"rootID\":{\"type\":\"string\"},\"nodeID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"rootID\",\"nodeID\"]}")
	case SubagentTreeGetOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"rootID\":{\"type\":\"string\"}},\"required\":[\"rootID\"]}")
	case HandleOpenOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"handleID\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"ownerServer\":{\"type\":\"string\"},\"ownerLocation\":{\"type\":\"string\"},\"ownerEpoch\":{\"type\":\"integer\"},\"sessionID\":{\"type\":\"string\"},\"summary\":{\"type\":\"string\"},\"subagentRoot\":{\"type\":\"string\"},\"nodeID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"handleID\",\"kind\",\"ownerServer\",\"ownerLocation\",\"ownerEpoch\",\"sessionID\",\"summary\"]}")
	case HandleSettleOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"handleID\":{\"type\":\"string\"},\"disposition\":{\"type\":\"string\"},\"summary\":{\"type\":\"string\"},\"subagentRoot\":{\"type\":\"string\"},\"nodeID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"handleID\",\"disposition\",\"summary\"]}")
	case HandleListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"sessionID\":{\"type\":\"string\"},\"ownerServer\":{\"type\":\"string\"},\"ownerLocation\":{\"type\":\"string\"},\"ownerEpoch\":{\"type\":\"integer\"},\"openOnly\":{\"type\":\"boolean\"}},\"required\":[\"openOnly\"]}")
	case OwnerCallsRetireOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"ownerServer\":{\"type\":\"string\"},\"ownerLocation\":{\"type\":\"string\"},\"ownerEpoch\":{\"type\":\"integer\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"ownerServer\",\"ownerLocation\",\"ownerEpoch\"]}")
	case QuestionAskOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"questionID\":{\"type\":\"string\"},\"threadID\":{\"type\":\"string\"},\"handleID\":{\"type\":\"string\"},\"ownerServer\":{\"type\":\"string\"},\"ownerLocation\":{\"type\":\"string\"},\"ownerEpoch\":{\"type\":\"integer\"},\"sessionID\":{\"type\":\"string\"},\"header\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"assumption\":{\"type\":\"string\"},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"targetRole\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"questionID\",\"threadID\",\"handleID\",\"ownerServer\",\"ownerLocation\",\"ownerEpoch\",\"sessionID\",\"header\",\"prompt\",\"assumption\",\"options\",\"targetRole\"]}")
	case QuestionAnswerOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"questionID\":{\"type\":\"string\"},\"answer\":{\"type\":\"string\"},\"responder\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"questionID\",\"answer\",\"responder\"]}")
	case QuestionWithdrawOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"commandID\":{\"type\":\"string\"},\"actor\":{\"type\":\"string\"},\"atMs\":{\"type\":\"integer\"},\"questionID\":{\"type\":\"string\"}},\"required\":[\"commandID\",\"actor\",\"atMs\",\"questionID\"]}")
	case QuestionListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"threadID\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}")
	case PoolAccountUpsertOp:
