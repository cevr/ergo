import json
import rpc
import scope
import sync
import github.com/cevr/ergo/modules/atlas/api
import github.com/cevr/ergo/modules/atlas/memory

// Request is one call of api.Api: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = ThreadCreateRequest{Input api.ThreadCreateInput} | ThreadGetRequest{Input api.ThreadTargetInput} | ThreadListRequest{Input api.ThreadListInput} | ThreadArchiveRequest{Input api.ThreadArchiveInput} | DriverSwitchRequest{Input api.DriverSwitchInput} | PromptEnqueueRequest{Input api.PromptEnqueueInput} | PromptDequeueRequest{Input api.PromptDequeueInput} | TurnStartRequest{Input api.TurnStartInput} | TurnStepRequest{Input api.TurnStepInput} | SubagentTreeInitRequest{Input api.SubagentTreeInitInput} | SubagentSpawnRequest{Input api.SubagentSpawnInput} | SubagentControlHandleRequest{Input api.SubagentControlHandleInput} | SubagentSettleHandleRequest{Input api.SubagentSettleHandleInput} | SubagentHandBackRequest{Input api.SubagentHandBackInput} | SubagentTreeGetRequest{Input api.SubagentTreeGetInput} | HandleOpenRequest{Input api.HandleOpenInput} | HandleSettleRequest{Input api.HandleSettleInput} | HandleListRequest{Input api.HandleListInput} | OwnerCallsRetireRequest{Input api.OwnerCallsRetireInput} | QuestionAskRequest{Input api.QuestionAskInput} | QuestionAnswerRequest{Input api.QuestionAnswerInput} | QuestionWithdrawRequest{Input api.QuestionWithdrawInput} | QuestionListRequest{Input api.QuestionListInput} | PoolAccountUpsertRequest{Input api.PoolAccountUpsertInput} | PoolHoldOpenRequest{Input api.PoolHoldOpenInput} | PoolHoldTransitionRequest{Input api.PoolHoldTransitionInput} | PoolViewRequest{Input api.PoolViewInput} | KernelSnapshotSaveRequest{Input api.KernelSnapshotSaveInput} | KernelCutRecordRequest{Input api.KernelCutRecordInput} | KernelViewRequest{Input api.KernelViewInput} | LeaseAcquireRequest{Input api.LeaseAcquireInput} | BootReconcileRequest{Input api.BootReconcileInput} | BootStatusRequest{Input api.BootStatusInput} | HostCapacityGetRequest{Input api.HostCapacityInput} | WellnessReportGetRequest{Input api.WellnessReportInput} | McpTokenMintRequest{Input api.McpTokenMintInput} | McpTokenRevokeRequest{Input api.McpTokenRevokeInput} | McpTokenListRequest{Input api.McpTokenListInput}

// Op is an operation of api.Api: what a policy matches on.
type Op = ThreadCreateOp{} | ThreadGetOp{} | ThreadListOp{} | ThreadArchiveOp{} | DriverSwitchOp{} | PromptEnqueueOp{} | PromptDequeueOp{} | TurnStartOp{} | TurnStepOp{} | SubagentTreeInitOp{} | SubagentSpawnOp{} | SubagentControlHandleOp{} | SubagentSettleHandleOp{} | SubagentHandBackOp{} | SubagentTreeGetOp{} | HandleOpenOp{} | HandleSettleOp{} | HandleListOp{} | OwnerCallsRetireOp{} | QuestionAskOp{} | QuestionAnswerOp{} | QuestionWithdrawOp{} | QuestionListOp{} | PoolAccountUpsertOp{} | PoolHoldOpenOp{} | PoolHoldTransitionOp{} | PoolViewOp{} | KernelSnapshotSaveOp{} | KernelCutRecordOp{} | KernelViewOp{} | LeaseAcquireOp{} | BootReconcileOp{} | BootStatusOp{} | HostCapacityGetOp{} | WellnessReportGetOp{} | McpTokenMintOp{} | McpTokenRevokeOp{} | McpTokenListOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = ThreadCreateReply{Value api.ThreadSnapshot} | ThreadGetReply{Value api.ThreadSnapshot} | ThreadListReply{Value api.ThreadListOutput} | ThreadArchiveReply{Value api.ThreadSnapshot} | DriverSwitchReply{Value api.ThreadSnapshot} | PromptEnqueueReply{Value api.ThreadSnapshot} | PromptDequeueReply{Value api.ThreadSnapshot} | TurnStartReply{Value api.ThreadSnapshot} | TurnStepReply{Value api.ThreadSnapshot} | SubagentTreeInitReply{Value api.SubagentTreeOutput} | SubagentSpawnReply{Value api.SubagentTreeOutput} | SubagentControlHandleReply{Value api.SubagentTreeOutput} | SubagentSettleHandleReply{Value api.SubagentTreeOutput} | SubagentHandBackReply{Value api.SubagentTreeOutput} | SubagentTreeGetReply{Value api.SubagentTreeOutput} | HandleOpenReply{Value api.HandleEntryView} | HandleSettleReply{Value api.HandleEntryView} | HandleListReply{Value api.HandleViewOutput} | OwnerCallsRetireReply{Value api.RetiredCallsOutput} | QuestionAskReply{Value api.AsyncQuestionView} | QuestionAnswerReply{Value api.AsyncQuestionView} | QuestionWithdrawReply{Value api.AsyncQuestionView} | QuestionListReply{Value api.AsyncQuestionListOutput} | PoolAccountUpsertReply{Value api.PoolViewOutput} | PoolHoldOpenReply{Value api.PoolViewOutput} | PoolHoldTransitionReply{Value api.PoolViewOutput} | PoolViewReply{Value api.PoolViewOutput} | KernelSnapshotSaveReply{Value api.KernelViewOutput} | KernelCutRecordReply{Value api.KernelViewOutput} | KernelViewReply{Value api.KernelViewOutput} | LeaseAcquireReply{Value api.BootLeaseOutput} | BootReconcileReply{Value api.BootLeaseOutput} | BootStatusReply{Value api.BootLeaseOutput} | HostCapacityGetReply{Value api.HostCapacityReport} | WellnessReportGetReply{Value api.WellnessReport} | McpTokenMintReply{Value api.MintedToken} | McpTokenRevokeReply{Value api.McpTokenRevokeOutput} | McpTokenListReply{Value api.McpTokenListOutput}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = NotFound{E memory.NotFound} | AlreadyExists{E memory.AlreadyExists} | InvalidTransition{E memory.InvalidTransition} | CommandReused{E memory.CommandReused} | InvalidInput{E memory.InvalidInput} | LeaseFenced{E memory.LeaseFenced} | ThreadDomainErr{E memory.ThreadDomainErr} | SubagentDomainErr{E memory.SubagentDomainErr} | HandleDomainErr{E memory.HandleDomainErr} | LimitDomainErr{E memory.LimitDomainErr} | RequestDomainErr{E memory.RequestDomainErr} | CutoverDomainErr{E memory.CutoverDomainErr} | StoreFailed{E memory.StoreFailed} | HostCapacityFailed{E api.HostCapacityFailed} | McpAuthDenied{E api.McpAuthDenied}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case ThreadCreateRequest:
		ThreadCreateOp
	case ThreadGetRequest:
		ThreadGetOp
	case ThreadListRequest:
		ThreadListOp
	case ThreadArchiveRequest:
		ThreadArchiveOp
	case DriverSwitchRequest:
		DriverSwitchOp
	case PromptEnqueueRequest:
		PromptEnqueueOp
	case PromptDequeueRequest:
		PromptDequeueOp
	case TurnStartRequest:
		TurnStartOp
	case TurnStepRequest:
		TurnStepOp
	case SubagentTreeInitRequest:
		SubagentTreeInitOp
	case SubagentSpawnRequest:
		SubagentSpawnOp
	case SubagentControlHandleRequest:
		SubagentControlHandleOp
	case SubagentSettleHandleRequest:
		SubagentSettleHandleOp
	case SubagentHandBackRequest:
		SubagentHandBackOp
	case SubagentTreeGetRequest:
		SubagentTreeGetOp
	case HandleOpenRequest:
		HandleOpenOp
	case HandleSettleRequest:
		HandleSettleOp
	case HandleListRequest:
		HandleListOp
	case OwnerCallsRetireRequest:
		OwnerCallsRetireOp
	case QuestionAskRequest:
		QuestionAskOp
	case QuestionAnswerRequest:
		QuestionAnswerOp
	case QuestionWithdrawRequest:
		QuestionWithdrawOp
	case QuestionListRequest:
		QuestionListOp
	case PoolAccountUpsertRequest:
		PoolAccountUpsertOp
	case PoolHoldOpenRequest:
		PoolHoldOpenOp
	case PoolHoldTransitionRequest:
		PoolHoldTransitionOp
	case PoolViewRequest:
		PoolViewOp
	case KernelSnapshotSaveRequest:
		KernelSnapshotSaveOp
	case KernelCutRecordRequest:
		KernelCutRecordOp
	case KernelViewRequest:
		KernelViewOp
	case LeaseAcquireRequest:
		LeaseAcquireOp
	case BootReconcileRequest:
		BootReconcileOp
	case BootStatusRequest:
		BootStatusOp
	case HostCapacityGetRequest:
		HostCapacityGetOp
	case WellnessReportGetRequest:
		WellnessReportGetOp
	case McpTokenMintRequest:
		McpTokenMintOp
	case McpTokenRevokeRequest:
		McpTokenRevokeOp
	case McpTokenListRequest:
		McpTokenListOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case ThreadCreateOp:
		"thread-create"
	case ThreadGetOp:
		"thread-get"
	case ThreadListOp:
		"thread-list"
	case ThreadArchiveOp:
		"thread-archive"
	case DriverSwitchOp:
		"driver-switch"
	case PromptEnqueueOp:
		"prompt-enqueue"
	case PromptDequeueOp:
		"prompt-dequeue"
	case TurnStartOp:
		"turn-start"
	case TurnStepOp:
		"turn-step"
	case SubagentTreeInitOp:
		"subagent-tree-init"
	case SubagentSpawnOp:
		"subagent-spawn"
	case SubagentControlHandleOp:
		"subagent-control-handle"
	case SubagentSettleHandleOp:
		"subagent-settle-handle"
	case SubagentHandBackOp:
		"subagent-hand-back"
	case SubagentTreeGetOp:
		"subagent-tree-get"
	case HandleOpenOp:
		"handle-open"
	case HandleSettleOp:
		"handle-settle"
	case HandleListOp:
		"handle-list"
	case OwnerCallsRetireOp:
		"owner-calls-retire"
	case QuestionAskOp:
		"question-ask"
	case QuestionAnswerOp:
		"question-answer"
	case QuestionWithdrawOp:
		"question-withdraw"
	case QuestionListOp:
		"question-list"
	case PoolAccountUpsertOp:
		"pool-account-upsert"
	case PoolHoldOpenOp:
		"pool-hold-open"
	case PoolHoldTransitionOp:
		"pool-hold-transition"
	case PoolViewOp:
		"pool-view"
	case KernelSnapshotSaveOp:
		"kernel-snapshot-save"
	case KernelCutRecordOp:
		"kernel-cut-record"
	case KernelViewOp:
		"kernel-view"
	case LeaseAcquireOp:
		"lease-acquire"
	case BootReconcileOp:
		"boot-reconcile"
	case BootStatusOp:
