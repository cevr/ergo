// FormatAgentRole returns the canonical lowercase name of r.
func FormatAgentRole(r subagent.AgentRole) string {
	match r {
	case subagent.RoleRoot:
		"root"
	case subagent.RolePlanner:
		"planner"
	case subagent.RoleImplementor:
		"implementor"
	case subagent.RoleVerifier:
		"verifier"
	case subagent.RoleReviewer:
		"reviewer"
	case subagent.RoleWorker:
		"worker"
	}
}

// ParseAgentRole parses a canonical external subagent role name.
func ParseAgentRole(raw string) option.Option[subagent.AgentRole] {
	match raw {
	case "root":
		option.Some[subagent.AgentRole]{Value: subagent.RoleRoot}
	case "planner":
		option.Some[subagent.AgentRole]{Value: subagent.RolePlanner}
	case "implementor":
		option.Some[subagent.AgentRole]{Value: subagent.RoleImplementor}
	case "verifier":
		option.Some[subagent.AgentRole]{Value: subagent.RoleVerifier}
	case "reviewer":
		option.Some[subagent.AgentRole]{Value: subagent.RoleReviewer}
	case "worker":
		option.Some[subagent.AgentRole]{Value: subagent.RoleWorker}
	case _:
		option.None
	}
}

// AgentRoleNameRoundTrips verifies every AgentRole round-trips via its string name.
law AgentRoleNameRoundTrips(r subagent.AgentRole) {
	ParseAgentRole(FormatAgentRole(r)) == option.Some[subagent.AgentRole]{Value: r}
}

// FormatLinkOrigin formats a thread.LinkOrigin into a canonical label.
func FormatLinkOrigin(o thread.LinkOrigin) string {
	match o {
	case thread.OriginLocal:
		"local"
	case thread.OriginMcpScoped as m:
		"mcp:" + string(m.BoundThread)
	case thread.OriginRemotePeer as p:
		"peer:" + p.PeerID
	case thread.OriginSubagentChild as c:
		"subagent:" + string(c.ParentID)
	}
}

// FormatTurnPhase returns the canonical lowercase phase name of p.
func FormatTurnPhase(p turn.TurnPhase) string {
	match p {
	case turn.PhaseQueued:
		"queued"
	case turn.PhaseUnsure:
		"unsure"
	case turn.PhaseDispatched:
		"dispatched"
	case turn.PhaseConfirmed:
		"confirmed"
	case turn.PhaseEnded:
		"ended"
	}
}

// FormatTurnOutcome returns a concise wire label for o.
func FormatTurnOutcome(o turn.TurnOutcome) string {
	match o {
	case turn.OutcomeCompleted:
		"completed"
	case turn.OutcomeCancelled:
		"cancelled"
	case turn.OutcomeLost:
		"lost"
	case turn.OutcomeFailed as f:
		"failed:" + f.Detail
	}
}

// FormatNodeState returns the canonical lowercase name of s.
func FormatNodeState(s subagent.NodeState) string {
	match s {
	case subagent.NodeIdle:
		"idle"
	case subagent.NodeRunning:
		"running"
	case subagent.NodeParked:
		"parked"
	case subagent.NodeDone:
		"done"
	}
}

// FormatCutoverPhase returns the canonical lowercase name of p.
func FormatCutoverPhase(p cutover.CutoverPhase) string {
	match p {
	case cutover.CutoverOld:
		"old"
	case cutover.CutoverQuiesce:
		"quiesce"
	case cutover.CutoverTransfer:
		"transfer"
	case cutover.CutoverCommitted:
		"committed"
	case cutover.CutoverDone:
		"done"
	}
}

// FormatLeaseOwner returns the canonical lowercase name of o.
func FormatLeaseOwner(o cutover.LeaseOwner) string {
	match o {
	case cutover.OwnerNone:
		"none"
	case cutover.OwnerOld:
		"old"
	case cutover.OwnerNew:
		"new"
	case cutover.OwnerBoth:
		"both"
	}
}

// ParseDisposition parses a canonical terminal handle Disposition name.
func ParseDisposition(raw string) option.Option[handle.Disposition] {
	match raw {
	case "succeeded":
		option.Some[handle.Disposition]{Value: handle.DispSucceeded}
	case "failed":
		option.Some[handle.Disposition]{Value: handle.DispFailed}
	case "lost":
		option.Some[handle.Disposition]{Value: handle.DispLost}
	case "declined":
		option.Some[handle.Disposition]{Value: handle.DispDeclined}
	case "cancelled":
		option.Some[handle.Disposition]{Value: handle.DispCancelled}
	case "handed":
		option.Some[handle.Disposition]{Value: handle.DispHanded}
	case _:
		option.None
	}
}
