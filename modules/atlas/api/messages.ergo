	Actor     string,
	AtMs      int64,
	ThreadID  string,
	TurnID    string,
}

// TurnStepInput advances the active turn on ThreadID using a typed lifecycle action.
type TurnStepInput {
	CommandID     string,
	Actor         string,
	AtMs          int64,
	ThreadID      string,
	Action        string,
	FailureClass  json.Optional[string],
	FailureDetail json.Optional[string],
	ResetAtMs     json.Optional[int],
}

// QueuedPromptView summarizes one queued FIFO follow-up prompt on a ThreadSnapshot.
type QueuedPromptView {
	PromptID      string,
	Body          string,
	RequestedMode string,
}

// BranchEdgeView summarizes one directed parent-child thread relationship.
type BranchEdgeView {
	ParentThreadID string,
	ChildThreadID  string,
	Kind           string,
	Label          string,
	CreatedAtMs    int64,
}

// ThreadSnapshot projects a durable thread together with its session, turn, edges, and queue.
type ThreadSnapshot {
	ThreadID        string,
	ParentThreadID  json.Optional[string],
	Driver          string,
	Path            string,
	PermissionMode  string,
	Model           string,
	LinkOrigin      string,
	Archived        bool,
	ActiveSessionID json.Optional[string],
	SessionGen      int,
	ActiveTurnID    json.Optional[string],
	ActiveTurnPhase json.Optional[string],
	LastTurnOutcome json.Optional[string],
	QueuedPrompts   []QueuedPromptView,
	Edges           []BranchEdgeView,
	TurnsStarted    int,
	TurnsCompleted  int,
	ModeSwitchCount int,
}

// ThreadSummary summarizes one listed thread row.
type ThreadSummary {
	ThreadID       string,
	Driver         string,
	Path           string,
	Archived       bool,
	InTurn         bool,
	QueuedCount    int,
	TurnsStarted   int,
	TurnsCompleted int,
}

// ThreadListOutput returns paginated ThreadSummary rows.
type ThreadListOutput {
