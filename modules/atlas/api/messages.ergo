}

// ThreadListInput filters and paginates threads.
type ThreadListInput {
	IncludeArchived bool,
	Limit           json.Optional[int],
	Offset          json.Optional[int],
}

// ThreadCreateInput creates a persisted Atlas thread and optional parent branch edge.
type ThreadCreateInput {
