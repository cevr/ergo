	Actor              string,
	AtMs               int64,
	ThreadID           string,
	Driver             string,
	PermissionMode     string,
	Instance           string,
	ConfigDir          string,
	Model              string,
	AgyDirectSupported bool,
	ParentThreadID     json.Optional[string],
	EdgeLabel          json.Optional[string],
	SharedHome         json.Optional[string],
	LinkOriginKind     json.Optional[string],
	LinkOriginTarget   json.Optional[string],
}

// ThreadArchiveInput archives an idle thread and revokes its /mcp bearer tokens.
type ThreadArchiveInput {
