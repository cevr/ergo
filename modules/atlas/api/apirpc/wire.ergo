func exactMemorySubagentDomainErr(v memory.SubagentDomainErr) fails rpc.Unrepresentable {
	exactSubagentSubagentRefusal(v.SubagentErr) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("subagentErr", u)
	}
}

func exactSubagentSubagentRefusal(v subagent.SubagentRefusal) fails rpc.Unrepresentable {
	match v {
	case subagent.ParentNodeNotFound:
	case subagent.NodeNotFound:
	case subagent.DuplicateSubagentID:
	case subagent.MaxDepthExceeded as x:
		exactInt(x.Depth) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("depth", u)
		}
		exactInt(x.Limit) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("limit", u)
		}
	case subagent.MaxFanOutExceeded as x:
		exactInt(x.FanOut) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("fanOut", u)
		}
		exactInt(x.Limit) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("limit", u)
		}
	case subagent.BudgetExhausted as x:
		exactInt(x.Used) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("used", u)
		}
		exactInt(x.Limit) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("limit", u)
		}
	case subagent.OutsideSubtreeScope:
	case subagent.OpenHandlesBlockHandBack as x:
		exactInt(x.Count) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("count", u)
		}
	case subagent.ActiveChildBlocksHandBack:
	case subagent.InvalidSubagentState:
	}
}

func exactMemoryLimitDomainErr(v memory.LimitDomainErr) fails rpc.Unrepresentable {
	exactTurnLimitRefusal(v.LimitErr) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("limitErr", u)
	}
}

func exactTurnLimitRefusal(v turn.LimitRefusal) fails rpc.Unrepresentable {
	match v {
	case turn.ResetTimestampInvalid as x:
		exactInt64(x.ResetAtMs) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("resetAtMs", u)
		}
	case turn.ResetOverdueBeyond24h as x:
		exactInt64(x.ResetAtMs) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("resetAtMs", u)
		}
		exactInt64(x.NowMs) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("nowMs", u)
		}
	case turn.ThreadArchivedRefusal:
	case turn.SessionExpiredRefusal:
	case turn.PendingRequestBlocking:
	case turn.DuplicateLimitKey:
	case turn.ResetNotReachedYet as x:
		exactInt64(x.ResetAtMs) catch {
		case rpc.Unrepresentable as u:
