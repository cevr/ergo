// Request is one call of api.Api: the hub's Request, a variant per
// operation whose fields are the operation's parameters, so its payload is
// the variant's JSON. Each variant is named here too.
type Request = apiapi.Request

type ThreadCreateRequest = apiapi.ThreadCreateRequest

type ThreadGetRequest = apiapi.ThreadGetRequest

