func exactSliceApiBranchEdgeView(v []api.BranchEdgeView) fails rpc.Unrepresentable {
	for i, x in v {
		exactApiBranchEdgeView(x) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("\(i)", u)
		}
	}
}

