func exactApiThreadCreateInput(v api.ThreadCreateInput) fails rpc.Unrepresentable {
	exactInt64(v.AtMs) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("atMs", u)
	}
}

func exactInt64(v int64) fails rpc.Unrepresentable {
	try rpc.Exact("", int64(v))
}

func exactApiThreadListInput(v api.ThreadListInput) fails rpc.Unrepresentable {
	exactJsonOptionalInt(v.Limit) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("limit", u)
	}
	exactJsonOptionalInt(v.Offset) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("offset", u)
	}
}

func exactJsonOptionalInt(v json.Optional[int]) fails rpc.Unrepresentable {
	match v {
	case json.Absent:
	case json.Present[int] as x:
		exactInt(x.Value) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("value", u)
		}
	}
}

func exactInt(v int) fails rpc.Unrepresentable {
	try rpc.Exact("", int64(v))
}

