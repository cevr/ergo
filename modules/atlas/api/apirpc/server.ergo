			}
			rpc.Encode(v)
		case apiapi.TurnStartReply as reply:
			let v = reply.Value
			exactApiThreadSnapshot(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.TurnStepReply as reply:
			let v = reply.Value
			exactApiThreadSnapshot(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.SubagentTreeInitReply as reply:
			let v = reply.Value
			exactApiSubagentTreeOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.SubagentSpawnReply as reply:
			let v = reply.Value
			exactApiSubagentTreeOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.SubagentControlHandleReply as reply:
			let v = reply.Value
			exactApiSubagentTreeOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.SubagentSettleHandleReply as reply:
			let v = reply.Value
			exactApiSubagentTreeOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.SubagentHandBackReply as reply:
			let v = reply.Value
			exactApiSubagentTreeOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.SubagentTreeGetReply as reply:
			let v = reply.Value
			exactApiSubagentTreeOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.HandleOpenReply as reply:
			let v = reply.Value
			rpc.Encode(v)
		case apiapi.HandleSettleReply as reply:
			let v = reply.Value
			rpc.Encode(v)
		case apiapi.HandleListReply as reply:
			let v = reply.Value
			exactApiHandleViewOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.OwnerCallsRetireReply as reply:
			let v = reply.Value
			rpc.Encode(v)
		case apiapi.QuestionAskReply as reply:
			let v = reply.Value
			exactApiAsyncQuestionView(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.QuestionAnswerReply as reply:
			let v = reply.Value
			exactApiAsyncQuestionView(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
