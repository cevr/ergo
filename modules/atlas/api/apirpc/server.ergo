		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case PoolHoldTransitionRequest as r:
		exactPoolHoldTransitionRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case PoolViewRequest as r:
		exactPoolViewRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case KernelSnapshotSaveRequest as r:
		exactKernelSnapshotSaveRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
