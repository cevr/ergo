import ergoapi api
import rpc
import github.com/cevr/ergo/modules/atlas/api
import github.com/cevr/ergo/modules/atlas/api/apiapi

// Handle runs one call of api.Api on the provider the caller binds,
// through the hub's Call: tag names the operation and payload is its
// Request's JSON. Its value is the result's JSON; a typed failure is
// Failed with the failure's tagged JSON. A request the contract does not
// hold and an int the wire cannot carry are defects, which the server
// answers as Die.
func Handle(tag string, payload string) string fails rpc.Failed needs api.Api {
	try handle(tag, payload, apiapi.Call)
}

func handle[R](tag string, payload string, answer func(r Request) apiapi.Outcome needs R) string fails rpc.Failed needs R {
	let req = rpc.Decode[Request]("request", rpc.Tagged(tag+"Request", payload)) catch {
	case rpc.Transport as t:
		return rpc.Die[string]("RpcError", t.Reason)
	}
	match req {
	case ThreadCreateRequest as r:
		exactThreadCreateRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case ThreadListRequest as r:
		exactThreadListRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case ThreadArchiveRequest as r:
		exactThreadArchiveRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case DriverSwitchRequest as r:
		exactDriverSwitchRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case PromptEnqueueRequest as r:
		exactPromptEnqueueRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case PromptDequeueRequest as r:
		exactPromptDequeueRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case TurnStartRequest as r:
		exactTurnStartRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case TurnStepRequest as r:
		exactTurnStepRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case SubagentTreeInitRequest as r:
		exactSubagentTreeInitRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case SubagentSpawnRequest as r:
		exactSubagentSpawnRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case SubagentControlHandleRequest as r:
		exactSubagentControlHandleRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case SubagentSettleHandleRequest as r:
		exactSubagentSettleHandleRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case SubagentHandBackRequest as r:
		exactSubagentHandBackRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case HandleOpenRequest as r:
		exactHandleOpenRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case HandleSettleRequest as r:
		exactHandleSettleRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case HandleListRequest as r:
		exactHandleListRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case OwnerCallsRetireRequest as r:
		exactOwnerCallsRetireRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case QuestionAskRequest as r:
		exactQuestionAskRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case QuestionAnswerRequest as r:
		exactQuestionAnswerRequest(r) catch {
		case rpc.Unrepresentable as u:
