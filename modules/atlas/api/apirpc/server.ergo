			}
			rpc.Encode(v)
		case apiapi.HostCapacityGetReply as reply:
			let v = reply.Value
			exactApiHostCapacityReport(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.WellnessReportGetReply as reply:
			let v = reply.Value
			exactApiWellnessReport(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.McpTokenMintReply as reply:
			let v = reply.Value
			exactApiMintedToken(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.McpTokenRevokeReply as reply:
			let v = reply.Value
			exactApiMcpTokenRevokeOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		case apiapi.McpTokenListReply as reply:
			let v = reply.Value
			exactApiMcpTokenListOutput(v) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			rpc.Encode(v)
		}
	case apiapi.Rejected as rejected:
		match rejected.Failure {
		case apiapi.NotFound as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("NotFound", rpc.Encode(e))}
		case apiapi.AlreadyExists as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("AlreadyExists", rpc.Encode(e))}
		case apiapi.InvalidTransition as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("InvalidTransition", rpc.Encode(e))}
		case apiapi.CommandReused as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("CommandReused", rpc.Encode(e))}
		case apiapi.InvalidInput as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("InvalidInput", rpc.Encode(e))}
		case apiapi.LeaseFenced as failure:
			let e = failure.E
			exactMemoryLeaseFenced(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("LeaseFenced", rpc.Encode(e))}
		case apiapi.ThreadDomainErr as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("ThreadDomainErr", rpc.Encode(e))}
		case apiapi.SubagentDomainErr as failure:
			let e = failure.E
			exactMemorySubagentDomainErr(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("SubagentDomainErr", rpc.Encode(e))}
		case apiapi.HandleDomainErr as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("HandleDomainErr", rpc.Encode(e))}
		case apiapi.LimitDomainErr as failure:
			let e = failure.E
			exactMemoryLimitDomainErr(e) catch {
			case rpc.Unrepresentable as u:
				return rpc.Refuse[string](u)
			}
			return rpc.Failed{Text: rpc.Tagged("LimitDomainErr", rpc.Encode(e))}
		case apiapi.RequestDomainErr as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("RequestDomainErr", rpc.Encode(e))}
		case apiapi.CutoverDomainErr as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("CutoverDomainErr", rpc.Encode(e))}
		case apiapi.StoreFailed as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("StoreFailed", rpc.Encode(e))}
		case apiapi.HostCapacityFailed as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("HostCapacityFailed", rpc.Encode(e))}
		case apiapi.McpAuthDenied as failure:
			let e = failure.E
			return rpc.Failed{Text: rpc.Tagged("McpAuthDenied", rpc.Encode(e))}
		}
	}
}

func carry(c Request, answer own func(c Request) apiapi.Outcome) apiapi.Outcome {
	let client = NewClient(rpc.Loopback(func(tag string, payload string) string fails rpc.Failed {
		try handle(tag, payload, answer)
	}))
	with context { api.Api: client } { apiapi.Call(c) }
}

// Wire is Effect RPC as a transport of the hub's calls.
type Wire {} implements ergoapi.Transport[Request, apiapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) apiapi.Outcome) apiapi.Outcome { carry(c, answer) }

// Fits reports whether r and o hold only ints the wire carries exactly
// (an int beyond 2^53-1 is Unrepresentable, a defect on either side).
func Fits(r Request, o apiapi.Outcome) bool {
	match r {
	case apiapi.ThreadCreateRequest as x:
		exactThreadCreateRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.ThreadListRequest as x:
		exactThreadListRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.ThreadArchiveRequest as x:
		exactThreadArchiveRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.DriverSwitchRequest as x:
		exactDriverSwitchRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.PromptEnqueueRequest as x:
		exactPromptEnqueueRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.PromptDequeueRequest as x:
		exactPromptDequeueRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.TurnStartRequest as x:
		exactTurnStartRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.TurnStepRequest as x:
		exactTurnStepRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.SubagentTreeInitRequest as x:
		exactSubagentTreeInitRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.SubagentSpawnRequest as x:
		exactSubagentSpawnRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.SubagentControlHandleRequest as x:
		exactSubagentControlHandleRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.SubagentSettleHandleRequest as x:
		exactSubagentSettleHandleRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.SubagentHandBackRequest as x:
		exactSubagentHandBackRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.HandleOpenRequest as x:
		exactHandleOpenRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.HandleSettleRequest as x:
		exactHandleSettleRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.HandleListRequest as x:
		exactHandleListRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.OwnerCallsRetireRequest as x:
		exactOwnerCallsRetireRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.QuestionAskRequest as x:
		exactQuestionAskRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.QuestionAnswerRequest as x:
		exactQuestionAnswerRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.QuestionWithdrawRequest as x:
		exactQuestionWithdrawRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.PoolAccountUpsertRequest as x:
		exactPoolAccountUpsertRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.PoolHoldOpenRequest as x:
		exactPoolHoldOpenRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.PoolHoldTransitionRequest as x:
		exactPoolHoldTransitionRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.PoolViewRequest as x:
		exactPoolViewRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.KernelSnapshotSaveRequest as x:
		exactKernelSnapshotSaveRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.KernelCutRecordRequest as x:
		exactKernelCutRecordRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.LeaseAcquireRequest as x:
		exactLeaseAcquireRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.BootReconcileRequest as x:
		exactBootReconcileRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.BootStatusRequest as x:
		exactBootStatusRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.WellnessReportGetRequest as x:
		exactWellnessReportGetRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case apiapi.McpTokenMintRequest as x:
		exactMcpTokenMintRequest(x) catch {
		case rpc.Unrepresentable:
			return false
		}
	case _:
	}
	match o {
	case apiapi.Done as done:
		match done.Reply {
		case apiapi.ThreadCreateReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.ThreadGetReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.ThreadListReply as reply:
			exactApiThreadListOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.ThreadArchiveReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.DriverSwitchReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.PromptEnqueueReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.PromptDequeueReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.TurnStartReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.TurnStepReply as reply:
			exactApiThreadSnapshot(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.SubagentTreeInitReply as reply:
			exactApiSubagentTreeOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.SubagentSpawnReply as reply:
			exactApiSubagentTreeOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.SubagentControlHandleReply as reply:
			exactApiSubagentTreeOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.SubagentSettleHandleReply as reply:
			exactApiSubagentTreeOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.SubagentHandBackReply as reply:
			exactApiSubagentTreeOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.SubagentTreeGetReply as reply:
			exactApiSubagentTreeOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.HandleOpenReply:
		case apiapi.HandleSettleReply:
		case apiapi.HandleListReply as reply:
			exactApiHandleViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.OwnerCallsRetireReply:
		case apiapi.QuestionAskReply as reply:
			exactApiAsyncQuestionView(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.QuestionAnswerReply as reply:
			exactApiAsyncQuestionView(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.QuestionWithdrawReply as reply:
			exactApiAsyncQuestionView(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.QuestionListReply as reply:
			exactApiAsyncQuestionListOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.PoolAccountUpsertReply as reply:
			exactApiPoolViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.PoolHoldOpenReply as reply:
			exactApiPoolViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.PoolHoldTransitionReply as reply:
			exactApiPoolViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.PoolViewReply as reply:
			exactApiPoolViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.KernelSnapshotSaveReply as reply:
			exactApiKernelViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.KernelCutRecordReply as reply:
			exactApiKernelViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.KernelViewReply as reply:
			exactApiKernelViewOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.LeaseAcquireReply as reply:
			exactApiBootLeaseOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.BootReconcileReply as reply:
			exactApiBootLeaseOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.BootStatusReply as reply:
			exactApiBootLeaseOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.HostCapacityGetReply as reply:
			exactApiHostCapacityReport(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.WellnessReportGetReply as reply:
			exactApiWellnessReport(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.McpTokenMintReply as reply:
			exactApiMintedToken(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.McpTokenRevokeReply as reply:
			exactApiMcpTokenRevokeOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.McpTokenListReply as reply:
			exactApiMcpTokenListOutput(reply.Value) catch {
			case rpc.Unrepresentable:
				return false
			}
		}
	case apiapi.Rejected as rejected:
		match rejected.Failure {
		case apiapi.NotFound:
		case apiapi.AlreadyExists:
		case apiapi.InvalidTransition:
		case apiapi.CommandReused:
		case apiapi.InvalidInput:
		case apiapi.LeaseFenced as failure:
			exactMemoryLeaseFenced(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.ThreadDomainErr:
		case apiapi.SubagentDomainErr as failure:
			exactMemorySubagentDomainErr(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.HandleDomainErr:
		case apiapi.LimitDomainErr as failure:
			exactMemoryLimitDomainErr(failure.E) catch {
			case rpc.Unrepresentable:
				return false
			}
		case apiapi.RequestDomainErr:
		case apiapi.CutoverDomainErr:
		case apiapi.StoreFailed:
		case apiapi.HostCapacityFailed:
		case apiapi.McpAuthDenied:
		}
	}
	true
}

// Agrees: the wire carries every call and every outcome the call can
// have unchanged, when they hold only ints it carries exactly (Fits).
law Agrees(r Request, g apiapi.Given) {
	let o = apiapi.OutcomeOf(r, g)
	!Fits(r, o) || ergoapi.Agrees(Wire, r, o)
}
