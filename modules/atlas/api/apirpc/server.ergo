		}
	case BootReconcileRequest as r:
		exactBootReconcileRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case BootStatusRequest as r:
		exactBootStatusRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case WellnessReportGetRequest as r:
		exactWellnessReportGetRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case McpTokenMintRequest as r:
		exactMcpTokenMintRequest(r) catch {
		case rpc.Unrepresentable as u:
			return rpc.Refuse[string](u)
		}
	case _:
	}
	match answer(req) {
	case apiapi.Done as done:
		match done.Reply {
		case apiapi.ThreadCreateReply as reply:
			let v = reply.Value
			exactApiThreadSnapshot(v) catch {
			case rpc.Unrepresentable as u:
