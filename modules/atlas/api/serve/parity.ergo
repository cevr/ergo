func runOutcomeJSON(svc api.Service, req apiapi.Request) string {
	let out = with context { api.Api: svc } { apiapi.Call(req) }
	json.Encode(json.Codec[apiapi.Outcome]{MaxBytes: 0, MaxDepth: 0}, out)
}

