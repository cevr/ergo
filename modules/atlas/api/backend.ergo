// SubagentTreeInit initializes a bounded recursive subagent tree rooted at RootID.
func SubagentTreeInit(s Service, input SubagentTreeInitInput) SubagentTreeOutput fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let root = handle.ThreadID(try requireText("rootID", input.RootID))
	if input.MaxDepth <= 0 || input.MaxFanOut <= 0 || input.MaxBudget <= 0 {
		return memory.InvalidInput{Field: "bounds", Reason: "maxDepth, maxFanOut, and maxBudget must be positive"}
	}
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let bounds = subagent.TreeBounds{MaxDepth: input.MaxDepth, MaxFanOut: input.MaxFanOut, MaxBudget: input.MaxBudget}
	let _ = try execStore(s, meta, memory.CmdInitSubagentTree{RootID: root, Bounds: bounds})
	try mustSubagentTreeOutput(s.store, root)
}

