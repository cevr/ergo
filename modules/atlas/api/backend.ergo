// ThreadList lists persisted threads ordered by creation sequence with optional pagination.
func ThreadList(s Service, input ThreadListInput) ThreadListOutput fails memory.InvalidInput | memory.StoreFailed {
	let offset = match input.Offset {
	case json.Present[int] as o:
		if o.Value < 0 {
			return memory.InvalidInput{Field: "offset", Reason: "must be non-negative"}
		}
		o.Value
	case json.Absent:
		0
	}
	let limit = match input.Limit {
	case json.Present[int] as l:
		if l.Value <= 0 {
			return memory.InvalidInput{Field: "limit", Reason: "must be positive"}
		}
		l.Value
	case json.Absent:
		0
	}
	let snap = try s.store.Snapshot()
	let mut matched = []ThreadSummary{}
	for _, tid in snap.ThreadOrder {
		match snap.Threads.Get(tid) {
		case option.Some[thread.Thread] as tv:
			let t = tv.Value
			if !input.IncludeArchived && t.Archived {
				continue
			}
			matched = matched.Append(ThreadSummary{
				ThreadID:       string(t.ID),
				Driver:         adapter.DriverName(t.Driver),
				Path:           adapter.ExecutionPathName(t.Mode),
				Archived:       t.Archived,
				InTurn:         thread.IsThreadInTurn(t),
				QueuedCount:    t.PromptQueue.Len(),
				TurnsStarted:   t.TurnsStarted,
				TurnsCompleted: t.TurnsCompleted,
			})
		case option.None:
		}
	}
	let total = matched.Len()
	let mut paged = []ThreadSummary{}
	for i, item in matched {
		if i < offset {
			continue
		}
		if limit > 0 && paged.Len() >= limit {
			break
		}
		paged = paged.Append(item)
	}
	ThreadListOutput{Threads: paged, Total: total}
}

