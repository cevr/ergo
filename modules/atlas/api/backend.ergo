// PoolHoldTransition wakes or cancels an existing waiting quota pool hold.
func PoolHoldTransition(s Service, input PoolHoldTransitionInput) PoolViewOutput fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let hk = try requireText("holdKey", input.HoldKey)
	let actRaw = try requireText("action", input.Action)
	let act memory.HoldTransition = match actRaw {
	case "wake":
		memory.HoldActionWake
	case "cancel":
		memory.HoldActionCancel
	case _:
		return memory.InvalidInput{Field: "action", Reason: "must be wake or cancel"}
	}
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdTransitionHold{HoldKey: hk, Action: act})
	projectPoolView(try s.store.GetPoolView(input.AtMs))
}

// PoolView queries durable quota pool accounts and active/due holds at NowMs.
func PoolView(s Service, input PoolViewInput) PoolViewOutput fails memory.InvalidInput | memory.StoreFailed {
	if input.NowMs < int64(0) {
		return memory.InvalidInput{Field: "nowMs", Reason: "must be non-negative"}
	}
	projectPoolView(try s.store.GetPoolView(input.NowMs))
}

// KernelSnapshotSave saves a bounded serialized kernel binding snapshot for one session.
func KernelSnapshotSave(s Service, input KernelSnapshotSaveInput) KernelViewOutput fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let sid = handle.SessionID(try requireText("sessionID", input.SessionID))
	let tid = handle.ThreadID(try requireText("threadID", input.ThreadID))
	let root = handle.ThreadID(try requireText("rootThreadID", input.RootThreadID))
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdSaveKernelSnapshot{
		SessionID:     sid,
		ThreadID:      tid,
		RootThreadID:  root,
		BindingsJSON:  input.BindingsJSON,
		SnapshotBytes: input.SnapshotBytes,
		LostNotice:    input.LostNotice,
	})
	projectKernelView(try s.store.GetKernelView(sid))
}

// KernelCutRecord records one cut.calls / cut.maps audit journal and updates hourly root accounting.
func KernelCutRecord(s Service, input KernelCutRecordInput) KernelViewOutput fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let cid = try requireText("cutID", input.CutID)
	let sid = handle.SessionID(try requireText("sessionID", input.SessionID))
	let tid = handle.ThreadID(try requireText("threadID", input.ThreadID))
	let root = handle.ThreadID(try requireText("rootThreadID", input.RootThreadID))
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdRecordKernelCut{
		CutID:        cid,
		SessionID:    sid,
		ThreadID:     tid,
		RootThreadID: root,
		CallsJSON:    input.CallsJSON,
		MapsJSON:     input.MapsJSON,
		StartedAtMs:  input.StartedAtMs,
		EndedAtMs:    input.EndedAtMs,
		Reason:       input.Reason,
	})
	projectKernelView(try s.store.GetKernelView(sid))
}

// KernelView queries persisted kernel snapshot, cut journals, root usages, limits, and requests.
func KernelView(s Service, input KernelViewInput) KernelViewOutput fails memory.InvalidInput | memory.StoreFailed {
	let sid = handle.SessionID(strings.TrimSpace(input.SessionID))
	projectKernelView(try s.store.GetKernelView(sid))
}

// LeaseAcquire acquires or CAS-advances a fenced server ownership lease.
func LeaseAcquire(s Service, input LeaseAcquireInput) BootLeaseOutput fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let lid = try requireText("leaseID", input.LeaseID)
	let owner = try parseOwner(input.OwnerServer, input.OwnerLocation, input.OwnerEpoch)
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdAcquireLease{
		LeaseID:       lid,
		Owner:         owner,
		ExpectedEpoch: input.ExpectedEpoch,
	})
	let blv = try s.store.GetLeaseAndBoot(memory.BootQuery{
		RootID:                     option.None,
		BootingOwner:               owner,
		LiveForeignOwners:          []handle.OwnerID{},
		PendingRequestsSurviveBoot: true,
		LeaseID:                    lid,
	})
	projectBootLeaseView(blv, 0, 0, 0, 0)
}

// BootReconcile executes deterministic startup reconciliation across handles, wakes, turns, requests, and subagents.
func BootReconcile(s Service, input BootReconcileInput) BootLeaseOutput fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let lid = try requireText("leaseID", input.LeaseID)
	let booting = try parseOwner(input.BootingServer, input.BootingLocation, input.BootingEpoch)
	let rootID = match try parseOptionalText("rootID", input.RootID) {
	case option.Some[string] as r:
		option.Some[handle.ThreadID]{Value: handle.ThreadID(r.Value)}
	case option.None:
		option.None
	}
	let query = memory.BootQuery{
		RootID:                     rootID,
		BootingOwner:               booting,
		LiveForeignOwners:          []handle.OwnerID{},
		PendingRequestsSurviveBoot: input.PendingRequestsSurviveBoot,
		LeaseID:                    lid,
	}
	let pre = try s.store.GetLeaseAndBoot(query)
	let plan = reconcile.BootReconcile(pre.BootSnapshot)
	let (retired, wakes, turns, expired) = countReconcileEffects(plan)
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdApplyBootReconcile{
		RootID:                     rootID,
		BootingOwner:               booting,
		LiveForeignOwners:          []handle.OwnerID{},
		PendingRequestsSurviveBoot: input.PendingRequestsSurviveBoot,
	})
	let post = try s.store.GetLeaseAndBoot(query)
	projectBootLeaseView(post, retired, wakes, turns, expired)
}

// BootStatus inspects active server lease status, open volatile owners, and pending boot reconciliation scope.
func BootStatus(s Service, input BootStatusInput) BootLeaseOutput fails memory.InvalidInput | memory.StoreFailed {
	let lid = try requireText("leaseID", input.LeaseID)
	let booting = try parseOwner(input.BootingServer, input.BootingLocation, input.BootingEpoch)
	let blv = try s.store.GetLeaseAndBoot(memory.BootQuery{
		RootID:                     option.None,
		BootingOwner:               booting,
		LiveForeignOwners:          []handle.OwnerID{},
		PendingRequestsSurviveBoot: input.PendingRequestsSurviveBoot,
		LeaseID:                    lid,
	})
	let plan = reconcile.BootReconcile(blv.BootSnapshot)
	let (retired, wakes, turns, expired) = countReconcileEffects(plan)
	projectBootLeaseView(blv, retired, wakes, turns, expired)
}

// HostCapacityGet returns non-blocking CPU, load, memory, and volume capacity metrics from HostCapacity.
func HostCapacityGet(s Service, input HostCapacityInput) HostCapacityReport fails memory.InvalidInput | HostCapacityFailed {
	for _, v in input.Volumes {
		if strings.TrimSpace(v) == "" {
			return memory.InvalidInput{Field: "volumes", Reason: "volume paths must not be blank"}
		}
	}
	try s.cap.Measure(input.Volumes)
}

// WellnessReportGet evaluates non-spawning store consistency, handle/pool health, and host capacity headroom.
func WellnessReportGet(s Service, input WellnessReportInput) WellnessReport fails memory.InvalidInput {
	if input.NowMs < int64(0) {
		return memory.InvalidInput{Field: "nowMs", Reason: "must be non-negative"}
	}
	let maxLoad = try parseFloatOptional("maxLoadPerCore", input.MaxLoadPerCore, s.policy.MaxLoadPerCore)
	let minMem = try parseFloatOptional("minMemAvailGiB", input.MinMemAvailGiB, s.policy.MinMemAvailGiB)
	let maxDisk = try parseFloatOptional("maxDiskUsedPct", input.MaxDiskUsedPct, s.policy.MaxDiskUsedPct)
	let vols = if input.Volumes.Len() > 0 { input.Volumes } else { s.policy.Volumes }
	let policy = WellnessPolicy{
		..s.policy,
		MaxLoadPerCore:       maxLoad,
		MinMemAvailGiB:       minMem,
		MaxDiskUsedPct:       maxDisk,
		Volumes:              vols,
		LiveOwnersConfigured: input.LiveOwnersConfigured,
		LiveOwners:           input.LiveOwners,
	}
	EvaluateWellness(s.store, s.cap, policy, input.NowMs)
}

// McpTokenMint mints or rotates a SHA-256-hashed per-thread /mcp bearer credential.
func McpTokenMint(s Service, input McpTokenMintInput) MintedToken fails memory.NotFound | memory.InvalidInput | memory.StoreFailed | McpAuthDenied {
	let tokID = try requireText("tokenID", input.TokenID)
	let tid = handle.ThreadID(try requireText("threadID", input.ThreadID))
	let _ = try mustThreadSnapshot(s.store, tid)
	let audRaw = try requireText("audienceKind", input.AudienceKind)
	let aud TokenAudience = match audRaw {
	case "thread":
		AudienceThread
	case "outside":
		let cid = try requireText("clientID", optStringOr(input.ClientID, ""))
		AudienceOutside{ClientID: cid}
	case _:
		return memory.InvalidInput{Field: "audienceKind", Reason: "must be thread or outside"}
	}
	let spec = MintTokenSpec{
		TokenID:        tokID,
		ThreadID:       tid,
		SessionID:      handle.SessionID(strings.TrimSpace(input.SessionID)),
		Gen:            input.Gen,
		Audience:       aud,
		Scopes:         input.Scopes,
		RevokePrevious: input.RotateExisting,
	}
	try MintThreadToken(s.auth, spec, input.NowMs)
}

// McpTokenRevoke revokes all active /mcp bearer tokens for ThreadID or SessionID.
func McpTokenRevoke(s Service, input McpTokenRevokeInput) McpTokenRevokeOutput fails memory.InvalidInput {
	let tid = try parseOptionalText("threadID", input.ThreadID)
	let sid = try parseOptionalText("sessionID", input.SessionID)
	if tid == option.None && sid == option.None {
		return memory.InvalidInput{Field: "threadID", Reason: "provide threadID and/or sessionID"}
	}
	let mut revoked = 0
	match tid {
	case option.Some[string] as t:
		revoked = revoked + RevokeThreadTokens(s.auth, handle.ThreadID(t.Value))
	case option.None:
	}
	match sid {
	case option.Some[string] as sess:
		revoked = revoked + RevokeSessionTokens(s.auth, handle.SessionID(sess.Value))
	case option.None:
	}
	McpTokenRevokeOutput{RevokedCount: revoked}
}

// McpTokenList lists redacted /mcp bearer token summaries for ThreadID without exposing digests or secrets.
func McpTokenList(s Service, input McpTokenListInput) McpTokenListOutput fails memory.InvalidInput {
	let tid = handle.ThreadID(try requireText("threadID", input.ThreadID))
	let all = ListThreadTokenViews(s.auth, tid)
	let mut out = []McpTokenInfo{}
	for _, item in all {
		if input.IncludeRevoked || !item.Revoked {
			out = out.Append(item)
		}
	}
	McpTokenListOutput{Tokens: out}
}

test ServiceHandlesPoolKernelAndBootReconcile {
	let svc = try newDefaultMemoryService()
	let th = try svc.ThreadCreate(ThreadCreateInput{
		CommandID:          "s-th-1",
		Actor:              "root",
		AtMs:               int64(500),
		ThreadID:           "s-th-1",
		Driver:             "claude-meta",
		PermissionMode:     "ask",
		Instance:           "inst-1",
		ConfigDir:          "/tmp/cfg",
		Model:              "sonnet",
		AgyDirectSupported: false,
		ParentThreadID:     json.Absent,
		EdgeLabel:          json.Absent,
		SharedHome:         json.Absent,
		LinkOriginKind:     json.Absent,
		LinkOriginTarget:   json.Absent,
	})
	assert th.ThreadID == "s-th-1"
	let listed = try svc.ThreadList(ThreadListInput{IncludeArchived: false, Limit: json.Absent, Offset: json.Absent})
	assert listed.Total == 1

	let opened = try svc.HandleOpen(HandleOpenInput{
		CommandID:     "s-ho-1",
		Actor:         "srv",
		AtMs:          int64(510),
		HandleID:      "h-call-1",
		Kind:          "call",
		OwnerServer:   "srv-a",
		OwnerLocation: "us1",
		OwnerEpoch:    1,
		SessionID:     "sess-1",
		Summary:       "rpc call",
		SubagentRoot:  json.Absent,
		NodeID:        json.Absent,
	})
	assert opened.Disposition == "open"

	let settled = try svc.HandleSettle(HandleSettleInput{
		CommandID:    "s-hs-1",
		Actor:        "srv",
		AtMs:         int64(520),
		HandleID:     "h-call-1",
		Disposition:  "succeeded",
		Summary:      "done",
		SubagentRoot: json.Absent,
		NodeID:       json.Absent,
	})
	assert settled.Disposition == "succeeded"

	let _ = try svc.HandleOpen(HandleOpenInput{
		CommandID:     "s-ho-2",
		Actor:         "srv",
		AtMs:          int64(530),
		HandleID:      "h-call-2",
		Kind:          "call",
		OwnerServer:   "srv-dead",
		OwnerLocation: "us1",
		OwnerEpoch:    1,
		SessionID:     "sess-1",
		Summary:       "orphaned call",
		SubagentRoot:  json.Absent,
		NodeID:        json.Absent,
	})
	let retired = try svc.OwnerCallsRetire(OwnerCallsRetireInput{
		CommandID:     "s-ret-1",
		Actor:         "reconcile",
		AtMs:          int64(540),
		OwnerServer:   "srv-dead",
		OwnerLocation: "us1",
		OwnerEpoch:    1,
	})
	assert retired.RemainingOpenOwners.Len() == 0

	let _ = try svc.PoolHoldOpen(PoolHoldOpenInput{
		CommandID:      "s-ph-1",
		Actor:          "pool",
		AtMs:           int64(550),
		HoldKey:        "hk-1",
		ThreadID:       "s-th-1",
		AccountID:      "acct-a",
		RetryAtMs:      int64(600),
		ParentNotified: false,
	})
	let pvDue = try svc.PoolView(PoolViewInput{NowMs: int64(600)})
	assert pvDue.DueHolds.Len() == 1
	let pvWoken = try svc.PoolHoldTransition(PoolHoldTransitionInput{
		CommandID: "s-ph-2",
		Actor:     "pool",
		AtMs:      int64(605),
		HoldKey:   "hk-1",
		Action:    "wake",
	})
	assert pvWoken.DueHolds.Len() == 0

	let kv = try svc.KernelCutRecord(KernelCutRecordInput{
		CommandID:    "s-kc-1",
		Actor:        "kernel",
		AtMs:         int64(610),
		CutID:        "cut-1",
		SessionID:    "sess-1",
		ThreadID:     "s-th-1",
		RootThreadID: "s-th-1",
		CallsJSON:    "[]",
		MapsJSON:     "{}",
		StartedAtMs:  int64(605),
		EndedAtMs:    int64(610),
		Reason:       "cell",
	})
	assert kv.JournalCount == 1

	let boot = try svc.BootReconcile(BootReconcileInput{
		CommandID:                  "s-br-1",
		Actor:                      "boot",
		AtMs:                       int64(620),
		LeaseID:                    "lease-boot",
		RootID:                     json.Absent,
		BootingServer:              "srv-new",
		BootingLocation:            "us1",
		BootingEpoch:               2,
		PendingRequestsSurviveBoot: true,
	})
	assert boot.OpenOwners.Len() == 0
}
