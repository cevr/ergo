// HandleList queries matching DELIVERS handles, wake records, and pool holds.
func HandleList(s Service, input HandleListInput) HandleViewOutput fails memory.InvalidInput | memory.StoreFailed {
	let sess = match try parseOptionalText("sessionID", input.SessionID) {
	case option.Some[string] as sid:
		option.Some[handle.SessionID]{Value: handle.SessionID(sid.Value)}
	case option.None:
		option.None
	}
	let hasAnyOwner = input.OwnerServer != json.Absent || input.OwnerLocation != json.Absent || input.OwnerEpoch != json.Absent
	let owner = if hasAnyOwner {
		let srv = optStringOr(input.OwnerServer, "")
		let loc = optStringOr(input.OwnerLocation, "")
		let epoch = match input.OwnerEpoch {
		case json.Present[int] as e:
			e.Value
		case json.Absent:
			return memory.InvalidInput{Field: "ownerEpoch", Reason: "must accompany ownerServer and ownerLocation"}
		}
		option.Some[handle.OwnerID]{Value: try parseOwner(srv, loc, epoch)}
	} else {
		option.None
	}
	let hv = try s.store.GetHandleView(memory.HandleFilter{Session: sess, Owner: owner, OpenOnly: input.OpenOnly})
	projectHandleView(hv)
}

// OwnerCallsRetire retires all open KindCall handles owned by a dead server incarnation as DispLost.
func OwnerCallsRetire(s Service, input OwnerCallsRetireInput) RetiredCallsOutput fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let owner = try parseOwner(input.OwnerServer, input.OwnerLocation, input.OwnerEpoch)
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdRetireOwnerCalls{DeadOwner: owner})
	let snap = try s.store.Snapshot()
	let mut rem = []string{}
	for _, o in memory.QueryOpenOwners(snap) {
		rem = rem.Append(handle.OwnerText(o))
	}
	RetiredCallsOutput{Owner: handle.OwnerText(owner), RemainingOpenOwners: rem}
}

func mustQuestionView(store memory.Store, qid turn.RequestID) AsyncQuestionView fails memory.NotFound | memory.StoreFailed {
	let qs = try store.GetQuestions(memory.QuestionFilter{ThreadID: option.None, Status: option.None})
	for _, q in qs {
		if q.ID == qid {
			return projectQuestion(q)
		}
	}
	memory.NotFound{Entity: "question", Target: string(qid)}
}

