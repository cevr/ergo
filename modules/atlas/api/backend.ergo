func findHandleEntry(hv memory.HandleView, hid string) option.Option[HandleEntryView] {
	for _, h in hv.Handles {
		if string(h.ID) == hid {
			return option.Some[HandleEntryView]{Value: projectHandleEntry(h)}
		}
	}
	option.None
}

// HandleOpen registers a new DELIVERS wake handle with optional subagent tree correlation.
func HandleOpen(s Service, input HandleOpenInput) HandleEntryView fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let hid = handle.HandleID(try requireText("handleID", input.HandleID))
	let kind = try parseHandleKindField(input.Kind)
	let owner = try parseOwner(input.OwnerServer, input.OwnerLocation, input.OwnerEpoch)
	let sess = handle.SessionID(try requireText("sessionID", input.SessionID))
	let subRoot = match try parseOptionalText("subagentRoot", input.SubagentRoot) {
	case option.Some[string] as r:
		option.Some[handle.ThreadID]{Value: handle.ThreadID(r.Value)}
	case option.None:
		option.None
	}
	let nodeID = match try parseOptionalText("nodeID", input.NodeID) {
	case option.Some[string] as n:
		option.Some[handle.ThreadID]{Value: handle.ThreadID(n.Value)}
	case option.None:
		option.None
	}
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdOpenHandle{
		Spec:         handle.OpenHandleSpec{ID: hid, Kind: kind, Owner: owner, Session: sess, Summary: input.Summary},
		SubagentRoot: subRoot,
		NodeID:       nodeID,
	})
	let hv = try s.store.GetHandleView(memory.HandleFilter{Session: option.None, Owner: option.None, OpenOnly: false})
	match findHandleEntry(hv, string(hid)) {
	case option.Some[HandleEntryView] as entry:
		entry.Value
	case option.None:
		memory.NotFound{Entity: "handle", Target: string(hid)}
	}
}

