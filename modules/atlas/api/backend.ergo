import github.com/cevr/ergo/modules/atlas/adapter
import github.com/cevr/ergo/modules/atlas/handle
import github.com/cevr/ergo/modules/atlas/memory
import github.com/cevr/ergo/modules/atlas/reconcile
import github.com/cevr/ergo/modules/atlas/session
import github.com/cevr/ergo/modules/atlas/subagent
import github.com/cevr/ergo/modules/atlas/thread
import github.com/cevr/ergo/modules/atlas/turn
import json
import option
import rand
import strconv
import strings

type cmdMeta {
	id    string,
	actor string,
	atMs  int64,
}

// Service implements atlas.Api backed generically by any memory.Store, HostCapacity, and McpAuthStore.
type Service {
	store  memory.Store,
	cap    HostCapacity,
	auth   McpAuthStore,
	policy WellnessPolicy,
} implements Api

// NewService constructs an Api Service backed by store, cap, and auth with DefaultWellnessPolicy.
func NewService(store memory.Store, cap HostCapacity, auth McpAuthStore) Service {
	Service{
		store:  store,
		cap:    cap,
		auth:   auth,
		policy: DefaultWellnessPolicy(),
	}
}

// NewServiceWithPolicy constructs an Api Service with an explicit WellnessPolicy.
func NewServiceWithPolicy(store memory.Store, cap HostCapacity, auth McpAuthStore, policy WellnessPolicy) Service {
	Service{
		store:  store,
		cap:    cap,
		auth:   auth,
		policy: policy,
	}
}

// StoreOf returns the backing memory.Store used by s.
func StoreOf(s Service) memory.Store {
	s.store
}

// AuthOf returns the McpAuthStore used by s.
func AuthOf(s Service) McpAuthStore {
	s.auth
}

// HostCapacityOf returns the HostCapacity provider used by s.
func HostCapacityOf(s Service) HostCapacity {
	s.cap
}

func newDefaultMemoryService() Service fails HostCapacityFailed {
	let cap = try NewStaticHostCapacity(HealthyHostStatus([]string{"/", "/workspaces"}))
	NewService(memory.New(), cap, NewMcpAuthStore(rand.NewSeededSecure(uint64(17))))
}

let overMemoryApi = context fails HostCapacityFailed {
	Api: try newDefaultMemoryService(),
}

func requireText(field string, value string) string fails memory.InvalidInput {
	let trimmed = strings.TrimSpace(value)
	if trimmed == "" {
		return memory.InvalidInput{Field: field, Reason: "must not be empty"}
	}
	trimmed
}

func optToOption[T](v json.Optional[T]) option.Option[T] {
	match v {
	case json.Present[T] as p:
		option.Some[T]{Value: p.Value}
	case json.Absent:
		option.None
	}
}

func optionToJson[T](v option.Option[T]) json.Optional[T] {
	match v {
	case option.Some[T] as some:
		json.Present[T]{Value: some.Value}
	case option.None:
		json.Absent
	}
}

func parseOptionalText(field string, v json.Optional[string]) option.Option[string] fails memory.InvalidInput {
	match v {
	case json.Present[string] as p:
		option.Some[string]{Value: try requireText(field, p.Value)}
	case json.Absent:
		option.None
	}
}

func optStringOr(v json.Optional[string], fallback string) string {
	match v {
	case json.Present[string] as p:
		if strings.TrimSpace(p.Value) != "" { p.Value } else { fallback }
	case json.Absent:
		fallback
	}
}

func parseFloatOptional(field string, v json.Optional[string], fallback float64) float64 fails memory.InvalidInput {
	match v {
	case json.Present[string] as p:
		let trimmed = strings.TrimSpace(p.Value)
		if trimmed == "" {
			return memory.InvalidInput{Field: field, Reason: "must not be blank"}
		}
		strconv.ParseFloat(trimmed) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return memory.InvalidInput{Field: field, Reason: "must be a finite decimal number"}
		}
	case json.Absent:
		fallback
	}
}

func parseOwner(srv string, loc string, epoch int) handle.OwnerID fails memory.InvalidInput {
	let s = try requireText("ownerServer", srv)
	let l = try requireText("ownerLocation", loc)
	if epoch < 0 {
		return memory.InvalidInput{Field: "ownerEpoch", Reason: "must be non-negative"}
	}
	handle.OwnerID{ServerID: s, Location: l, Epoch: epoch}
}

func parseDriver(field string, raw string) adapter.DriverKind fails memory.InvalidInput {
	let text = try requireText(field, raw)
	match adapter.ParseDriverKind(text) {
	case option.Some[adapter.DriverKind] as d:
		d.Value
	case option.None:
		memory.InvalidInput{Field: field, Reason: "unknown driver '\(text)'"}
	}
}

func parsePermission(field string, raw string) adapter.PermissionMode fails memory.InvalidInput {
	let text = try requireText(field, raw)
	match adapter.ParsePermissionMode(text) {
	case option.Some[adapter.PermissionMode] as m:
		m.Value
	case option.None:
		memory.InvalidInput{Field: field, Reason: "unknown permission mode '\(text)'"}
	}
}

func parseLinkOrigin(kindOpt json.Optional[string], targetOpt json.Optional[string]) thread.LinkOrigin fails memory.InvalidInput {
	let kind = match optToOption[string](kindOpt) {
	case option.Some[string] as k:
		strings.TrimSpace(k.Value)
	case option.None:
		return thread.OriginLocal
	}
	match kind {
	case "", "local":
		thread.OriginLocal
	case "mcp":
		let t = try requireText("linkOriginTarget", optStringOr(targetOpt, ""))
		thread.OriginMcpScoped{BoundThread: handle.ThreadID(t)}
	case "peer":
		let p = try requireText("linkOriginTarget", optStringOr(targetOpt, ""))
		thread.OriginRemotePeer{PeerID: p}
	case "subagent":
		let p = try requireText("linkOriginTarget", optStringOr(targetOpt, ""))
		thread.OriginSubagentChild{ParentID: handle.ThreadID(p)}
	case _:
		memory.InvalidInput{Field: "linkOriginKind", Reason: "must be local, mcp, peer, or subagent"}
	}
}

func parseFailureClass(clsOpt json.Optional[string], resetOpt json.Optional[int]) turn.FailureClass fails memory.InvalidInput {
	let cls = optStringOr(clsOpt, "unknown")
	match cls {
	case "usage_limit":
		let reset = match resetOpt {
		case json.Present[int] as r:
			int64(r.Value)
		case json.Absent:
			int64(0)
		}
		turn.FailureUsageLimit{ResetAtMs: reset}
	case "provider":
		turn.FailureProvider
	case "transport":
		turn.FailureTransport
	case "permission":
		turn.FailurePermission
	case "validation":
		turn.FailureValidation
	case "unknown":
		turn.FailureUnknown
	case _:
		memory.InvalidInput{Field: "failureClass", Reason: "unknown failure class '\(cls)'"}
	}
}

func parseLifecycleTurnAction(raw string) option.Option[turn.TurnAction] {
	match raw {
	case "dispatch":
		option.Some[turn.TurnAction]{Value: turn.ActionDispatch}
	case "dispatch-lost":
		option.Some[turn.TurnAction]{Value: turn.ActionDispatchLost}
	case "resolve-sent":
		option.Some[turn.TurnAction]{Value: turn.ActionResolveSent}
	case "resolve-unsent":
		option.Some[turn.TurnAction]{Value: turn.ActionResolveUnsent}
	case "delta":
		option.Some[turn.TurnAction]{Value: turn.ActionReceiveDelta}
	case "request-write":
		option.Some[turn.TurnAction]{Value: turn.ActionRequestWriteApproval}
	case "grant-write":
		option.Some[turn.TurnAction]{Value: turn.ActionGrantWriteApproval}
	case "execute-write":
		option.Some[turn.TurnAction]{Value: turn.ActionExecuteWrite}
	case "steer":
		option.Some[turn.TurnAction]{Value: turn.ActionSendSteer}
	case "request-stop":
		option.Some[turn.TurnAction]{Value: turn.ActionRequestStop}
	case "send-cancel":
		option.Some[turn.TurnAction]{Value: turn.ActionSendCancel}
	case "start-bookkeeping":
		option.Some[turn.TurnAction]{Value: turn.ActionStartBookkeeping}
	case "finish-bookkeeping":
		option.Some[turn.TurnAction]{Value: turn.ActionFinishBookkeeping}
	case _:
		option.None
	}
}

func parseTurnAction(input TurnStepInput) turn.TurnAction fails memory.InvalidInput {
	let act = try requireText("action", input.Action)
	match parseLifecycleTurnAction(act) {
	case option.Some[turn.TurnAction] as simple:
		return simple.Value
	case option.None:
	}
	match act {
	case "retry-transient":
		turn.ActionRetryTransient{Class: try parseFailureClass(input.FailureClass, input.ResetAtMs)}
	case "finish-completed":
		turn.ActionFinishTurn{Outcome: turn.OutcomeCompleted}
	case "finish-cancelled":
		turn.ActionFinishTurn{Outcome: turn.OutcomeCancelled}
	case "finish-lost":
		turn.ActionFinishTurn{Outcome: turn.OutcomeLost}
	case "finish-failed":
		let fc = try parseFailureClass(input.FailureClass, input.ResetAtMs)
		turn.ActionFinishTurn{Outcome: turn.OutcomeFailed{Class: fc, Detail: optStringOr(input.FailureDetail, "turn failed")}}
	case "fail-before-dispatch":
		let fc = try parseFailureClass(input.FailureClass, input.ResetAtMs)
		turn.ActionFailBeforeDispatch{Class: fc, Detail: optStringOr(input.FailureDetail, "failed before dispatch")}
	case _:
		memory.InvalidInput{Field: "action", Reason: "unknown turn action '\(act)'"}
	}
}

func parseAgentRoleField(field string, raw string) subagent.AgentRole fails memory.InvalidInput {
	let text = try requireText(field, raw)
	match ParseAgentRole(text) {
	case option.Some[subagent.AgentRole] as r:
		r.Value
	case option.None:
		memory.InvalidInput{Field: field, Reason: "unknown subagent role '\(text)'"}
	}
}

func parseHandleKindField(raw string) handle.HandleKind fails memory.InvalidInput {
	let text = try requireText("kind", raw)
	match handle.ParseHandleKind(text) {
	case option.Some[handle.HandleKind] as k:
		k.Value
	case option.None:
		memory.InvalidInput{Field: "kind", Reason: "unknown handle kind '\(text)'"}
	}
}

func parseDispositionField(raw string) handle.Disposition fails memory.InvalidInput {
	let text = try requireText("disposition", raw)
	match ParseDisposition(text) {
	case option.Some[handle.Disposition] as d:
		d.Value
	case option.None:
		memory.InvalidInput{Field: "disposition", Reason: "must be succeeded, failed, lost, declined, cancelled, or handed"}
	}
}

func parseResponderField(raw string) turn.Responder fails memory.InvalidInput {
	let text = try requireText("responder", raw)
	match text {
	case "primary":
		turn.ResponderPrimary
	case "secondary":
		turn.ResponderSecondary
	case "timeout":
		turn.ResponderTimeout
	case _:
		memory.InvalidInput{Field: "responder", Reason: "must be primary, secondary, or timeout"}
	}
}

func formatResponder(r turn.Responder) string {
	match r {
	case turn.ResponderPrimary:
		"primary"
	case turn.ResponderSecondary:
		"secondary"
	case turn.ResponderTimeout:
		"timeout"
	}
}

func execStore(s Service, meta cmdMeta, cmd memory.Command) memory.ExecuteResult fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let cid = try requireText("commandID", meta.id)
	let actor = try requireText("actor", meta.actor)
	let env = memory.Envelope{
		ID:         memory.CommandID(cid),
		Actor:      actor,
		AtMs:       meta.atMs,
		LeaseFence: option.None,
		Command:    cmd,
	}
	try s.store.Execute(env)
}

func projectThreadSessionInfo(t thread.Thread) (json.Optional[string], int) {
	match t.ActiveSession {
	case option.Some[session.SessionRecord] as sess:
		(json.Present[string]{Value: string(sess.Value.ID)}, sess.Value.Gen)
	case option.None:
		(json.Absent, 0)
	}
}

func projectThreadTurnInfo(t thread.Thread) (json.Optional[string], json.Optional[string]) {
	match t.ActiveTurn {
	case option.Some[turn.TurnState] as at:
		(json.Present[string]{Value: string(at.Value.ID)}, json.Present[string]{Value: FormatTurnPhase(at.Value.Phase)})
	case option.None:
		(json.Absent, json.Absent)
	}
}

func projectThreadView(tv memory.ThreadView) ThreadSnapshot {
	let t = tv.Thread
	let mut parent json.Optional[string] = json.Absent
	match t.ParentThreadID {
	case option.Some[handle.ThreadID] as p:
		parent = json.Present[string]{Value: string(p.Value)}
	case option.None:
	}
	let (sessID, sessGen) = projectThreadSessionInfo(t)
	let (turnID, turnPhase) = projectThreadTurnInfo(t)
	let mut outcome json.Optional[string] = json.Absent
	match t.LastTurnOutcome {
	case option.Some[turn.TurnOutcome] as o:
		outcome = json.Present[string]{Value: FormatTurnOutcome(o.Value)}
	case option.None:
	}
	let mut prompts = []QueuedPromptView{}
	for _, qp in t.PromptQueue {
		prompts = prompts.Append(QueuedPromptView{
			PromptID:      qp.ID,
			Body:          qp.Body,
			RequestedMode: adapter.PermissionModeName(qp.RequestedMode),
		})
	}
	let mut edges = []BranchEdgeView{}
	for _, e in tv.Edges {
		edges = edges.Append(BranchEdgeView{
			ParentThreadID: string(e.ParentThreadID),
			ChildThreadID:  string(e.ChildThreadID),
			Kind:           memory.BranchKindName(e.Kind),
			Label:          e.Label,
			CreatedAtMs:    e.CreatedAtMs,
		})
	}
	ThreadSnapshot{
		ThreadID:        string(t.ID),
		ParentThreadID:  parent,
		Driver:          adapter.DriverName(t.Driver),
		Path:            adapter.ExecutionPathName(t.Mode),
		PermissionMode:  adapter.PermissionModeName(t.PermissionMode),
		Model:           string(t.Model),
		LinkOrigin:      FormatLinkOrigin(t.LinkOrigin),
		Archived:        t.Archived,
		ActiveSessionID: sessID,
		SessionGen:      sessGen,
		ActiveTurnID:    turnID,
		ActiveTurnPhase: turnPhase,
		LastTurnOutcome: outcome,
		QueuedPrompts:   prompts,
		Edges:           edges,
		TurnsStarted:    t.TurnsStarted,
		TurnsCompleted:  t.TurnsCompleted,
		ModeSwitchCount: t.ModeSwitchCount,
	}
}

func mustThreadSnapshot(store memory.Store, tid handle.ThreadID) ThreadSnapshot fails memory.NotFound | memory.StoreFailed {
	let opt = try store.GetThreadView(tid)
	match opt {
	case option.Some[memory.ThreadView] as tv:
		projectThreadView(tv.Value)
	case option.None:
		memory.NotFound{Entity: "thread", Target: string(tid)}
	}
}

func projectSubagentNode(n subagent.SubagentNode) SubagentNodeView {
	let mut parent json.Optional[string] = json.Absent
	match n.ParentThreadID {
	case option.Some[handle.ThreadID] as p:
		parent = json.Present[string]{Value: string(p.Value)}
	case option.None:
	}
	let mut handles = []string{}
	for _, h in n.OpenHandles {
		handles = handles.Append(string(h))
	}
	let mut children = []string{}
	for _, c in n.Children {
		children = children.Append(string(c))
	}
	SubagentNodeView{
		ThreadID:       string(n.ThreadID),
		ParentThreadID: parent,
		Role:           FormatAgentRole(n.Role),
		Depth:          n.Depth,
		State:          FormatNodeState(n.State),
		OpenHandles:    handles,
		Children:       children,
		HandBackCount:  n.HandBackCount,
	}
}

func mustSubagentTreeOutput(store memory.Store, rootID handle.ThreadID) SubagentTreeOutput fails memory.NotFound | memory.StoreFailed {
	let opt = try store.GetSubagentTree(rootID)
	let tree = match opt {
	case option.Some[subagent.Tree] as t:
		t.Value
	case option.None:
		return memory.NotFound{Entity: "subagent_tree", Target: string(rootID)}
	}
	let mut nodes = []SubagentNodeView{}
	for _, id in tree.Order {
		match tree.Nodes.Get(id) {
		case option.Some[subagent.SubagentNode] as n:
			nodes = nodes.Append(projectSubagentNode(n.Value))
		case option.None:
		}
	}
	SubagentTreeOutput{
		RootID:     string(tree.RootID),
		MaxDepth:   tree.Bounds.MaxDepth,
		MaxFanOut:  tree.Bounds.MaxFanOut,
		MaxBudget:  tree.Bounds.MaxBudget,
		BudgetUsed: tree.BudgetUsed,
		Nodes:      nodes,
	}
}

func projectHandleEntry(h handle.WakeHandle) HandleEntryView {
	HandleEntryView{
		HandleID:    string(h.ID),
		Kind:        handle.HandleKindName(h.Kind),
		Owner:       handle.OwnerText(h.Owner),
		SessionID:   string(h.Session),
		Deliverer:   handle.DelivererName(h.Deliverer),
		Disposition: handle.DispositionName(h.Disposition),
		Summary:     h.Summary,
		WakeEmitted: h.WakeEmitted,
	}
}

func projectPoolHold(ph memory.PoolHold) PoolHoldView {
	PoolHoldView{
		HoldKey:        ph.HoldKey,
		ThreadID:       string(ph.ThreadID),
		AccountID:      string(ph.AccountID),
		RetryAtMs:      ph.RetryAtMs,
		DeliveryID:     ph.DeliveryID,
		Status:         memory.HoldStatusName(ph.Status),
		ParentNotified: ph.ParentNotified,
	}
}

func projectHandleView(hv memory.HandleView) HandleViewOutput {
	let mut handles = []HandleEntryView{}
	for _, h in hv.Handles {
		handles = handles.Append(projectHandleEntry(h))
	}
	let mut wakes = []WakeEntryView{}
	for _, w in hv.Wakes {
		wakes = wakes.Append(WakeEntryView{
			DeliveryID: w.DeliveryID,
			HandleID:   string(w.HandleID),
			Delivered:  w.Delivered,
			Payload:    w.PayloadSummary,
		})
	}
	let mut holds = []PoolHoldView{}
	for _, ph in hv.Holds {
		holds = holds.Append(projectPoolHold(ph))
	}
	HandleViewOutput{Handles: handles, Wakes: wakes, Holds: holds}
}

func projectQuestion(q memory.AsyncQuestion) AsyncQuestionView {
	let mut answeredBy json.Optional[string] = json.Absent
	match q.AnsweredBy {
	case option.Some[turn.Responder] as r:
		answeredBy = json.Present[string]{Value: formatResponder(r.Value)}
	case option.None:
	}
	AsyncQuestionView{
		QuestionID:  string(q.ID),
		ThreadID:    string(q.ThreadID),
		HandleID:    string(q.HandleID),
		Header:      q.Header,
		Prompt:      q.Prompt,
		Assumption:  q.Assumption,
		Options:     q.Options,
		TargetRole:  FormatAgentRole(q.TargetRole),
		Status:      memory.QuestionStatusName(q.Status),
		Answer:      optionToJson[string](q.Answer),
		AnsweredBy:  answeredBy,
		AskedAtMs:   q.AskedAtMs,
		UpdatedAtMs: q.UpdatedAtMs,
	}
}

func projectPoolView(pv memory.PoolView) PoolViewOutput {
	let mut accts = []PoolAccountView{}
	for _, a in pv.Accounts {
		accts = accts.Append(PoolAccountView{
			AccountID:       string(a.ID),
			Provider:        a.Provider,
			Priority:        a.Priority,
			Healthy:         a.Healthy,
			Window5hUsedPct: a.Window5hUsedPct,
			Window5hResetMs: a.Window5hResetMs,
			Window7dUsedPct: a.Window7dUsedPct,
			Window7dResetMs: a.Window7dResetMs,
			InflightStarts:  a.InflightStarts,
			LimitedUntilMs:  a.LimitedUntilMs,
		})
	}
	let mut due = []PoolHoldView{}
	for _, d in pv.DueHolds {
		due = due.Append(projectPoolHold(d))
	}
	let mut all = []PoolHoldView{}
	for _, h in pv.AllHolds {
		all = all.Append(projectPoolHold(h))
	}
	PoolViewOutput{Accounts: accts, DueHolds: due, AllHolds: all}
}

func projectKernelView(kv memory.KernelView) KernelViewOutput {
	let mut snap json.Optional[KernelSnapshotSummary] = json.Absent
	match kv.Snapshot {
	case option.Some[memory.KernelSnapshot] as k:
		let sv = k.Value
		snap = json.Present[KernelSnapshotSummary]{Value: KernelSnapshotSummary{
			SessionID:     string(sv.SessionID),
			ThreadID:      string(sv.ThreadID),
			RootThreadID:  string(sv.RootThreadID),
			SnapshotSeq:   sv.SnapshotSeq,
			SnapshotBytes: sv.SnapshotBytes,
			LostNotice:    sv.LostNotice,
			UpdatedAtMs:   sv.UpdatedAtMs,
		}}
	case option.None:
	}
	let mut usages = []KernelRootUsageView{}
	for _, u in kv.RootUsages {
		usages = usages.Append(KernelRootUsageView{
			RootThreadID: string(u.RootThreadID),
			ActiveCellMs: u.ActiveCellMs,
			Flagged:      u.Flagged,
		})
	}
	KernelViewOutput{
		Snapshot:     snap,
		JournalCount: kv.Journals.Len(),
		RootUsages:   usages,
		LimitCount:   kv.Limits.Len(),
		RequestCount: kv.Requests.Len(),
	}
}

func projectBootLeaseView(blv memory.BootLeaseView, retired int, wakes int, turns int, expired int) BootLeaseOutput {
	let mut activeLease json.Optional[LeaseSummary] = json.Absent
	match blv.ActiveLease {
	case option.Some[memory.LeaseRecord] as lr:
		let l = lr.Value
		activeLease = json.Present[LeaseSummary]{Value: LeaseSummary{
			LeaseID:         l.LeaseID,
			Owner:           handle.OwnerText(l.Owner),
			Epoch:           l.Epoch,
			FencingToken:    l.FencingToken,
			Phase:           FormatCutoverPhase(l.Phase),
			ActiveOwner:     FormatLeaseOwner(l.ActiveOwner),
			CommitPersisted: l.CommitPersisted,
		}}
	case option.None:
	}
	let mut owners = []string{}
	for _, o in blv.OpenOwners {
		owners = owners.Append(handle.OwnerText(o))
	}
	BootLeaseOutput{
		ActiveLease:     activeLease,
		OpenOwners:      owners,
		RetiredCalls:    retired,
		RequeuedWakes:   wakes,
		TerminatedTurns: turns,
		ExpiredRequests: expired,
	}
}

func countReconcileEffects(plan reconcile.ReconcilePlan) (int, int, int, int) {
	let mut termTurns = 0
	for _, tp in plan.TurnPlans {
		match tp {
		case reconcile.PlanSettleUnsureTurnLost:
			termTurns = termTurns + 1
		case reconcile.PlanKeepQueuedTurn, reconcile.PlanKeepEndedTurn:
		}
	}
	let mut expReqs = 0
	for _, rq in plan.ReconciledRequests {
		match rq.Status {
		case turn.RequestExpired:
			expReqs = expReqs + 1
		case turn.RequestQueued, turn.RequestDispatched, turn.RequestAnswered, turn.RequestDelivered:
		}
	}
	(plan.LostCallIDs.Len(), plan.DeliveredWakeIDs.Len(), termTurns, expReqs)
}

// ThreadCreate initializes and persists a new Atlas thread and optional parent branch edge.
func ThreadCreate(s Service, input ThreadCreateInput) ThreadSnapshot fails memory.NotFound | memory.AlreadyExists | memory.InvalidTransition | memory.CommandReused | memory.InvalidInput | memory.LeaseFenced | memory.ThreadDomainErr | memory.SubagentDomainErr | memory.HandleDomainErr | memory.LimitDomainErr | memory.RequestDomainErr | memory.CutoverDomainErr | memory.StoreFailed {
	let tid = handle.ThreadID(try requireText("threadID", input.ThreadID))
	let parentOpt = try parseOptionalText("parentThreadID", input.ParentThreadID)
	let parentID = match parentOpt {
	case option.Some[string] as p:
		option.Some[handle.ThreadID]{Value: handle.ThreadID(p.Value)}
	case option.None:
		option.None
	}
	let sharedHome = try parseOptionalText("sharedHome", input.SharedHome)
	let driver = try parseDriver("driver", input.Driver)
	let perm = try parsePermission("permissionMode", input.PermissionMode)
	let inst = adapter.InstanceID(try requireText("instance", input.Instance))
	let cfg = try requireText("configDir", input.ConfigDir)
	let model = adapter.ModelID(try requireText("model", input.Model))
	let origin = try parseLinkOrigin(input.LinkOriginKind, input.LinkOriginTarget)
	let spec = thread.ThreadSpec{
		ID:                 tid,
		ParentThreadID:     parentID,
		Driver:             driver,
		AgyDirectSupported: input.AgyDirectSupported,
		RequestedMode:      perm,
		Instance:           inst,
		ConfigDir:          cfg,
		SharedHome:         sharedHome,
		Model:              model,
		LinkOrigin:         origin,
	}
	let meta = cmdMeta{id: input.CommandID, actor: input.Actor, atMs: input.AtMs}
	let _ = try execStore(s, meta, memory.CmdCreateThread{Spec: spec, EdgeLabel: optStringOr(input.EdgeLabel, "branch")})
	try mustThreadSnapshot(s.store, tid)
}

