// QuestionList queries persisted ask_user_async entries by optional ThreadID and Status.
func QuestionList(s Service, input QuestionListInput) AsyncQuestionListOutput fails memory.InvalidInput | memory.StoreFailed {
	let tid = match try parseOptionalText("threadID", input.ThreadID) {
	case option.Some[string] as t:
		option.Some[handle.ThreadID]{Value: handle.ThreadID(t.Value)}
	case option.None:
		option.None
	}
	let st = match try parseOptionalText("status", input.Status) {
	case option.Some[string] as raw:
		match memory.ParseQuestionStatus(raw.Value) {
		case option.Some[memory.QuestionStatus] as parsed:
			option.Some[memory.QuestionStatus]{Value: parsed.Value}
		case option.None:
			return memory.InvalidInput{Field: "status", Reason: "must be open, answered, or withdrawn"}
		}
	case option.None:
		option.None
	}
	let qs = try s.store.GetQuestions(memory.QuestionFilter{ThreadID: tid, Status: st})
	let mut views = []AsyncQuestionView{}
	for _, q in qs {
		views = views.Append(projectQuestion(q))
	}
	AsyncQuestionListOutput{Questions: views}
}

