func specByName(name string) option.Option[llm.ToolSpec] {
	if name == "read" {
		return option.Some[llm.ToolSpec]{Value: readToolSpec()}
	}
	if name == "edit" {
		return option.Some[llm.ToolSpec]{Value: editToolSpec()}
	}
	if name == "shell" {
		return option.Some[llm.ToolSpec]{Value: shellToolSpec()}
	}
	if name == "search" {
		return option.Some[llm.ToolSpec]{Value: searchToolSpec()}
	}
	if name == "handles" {
		return option.Some[llm.ToolSpec]{Value: handlesToolSpec()}
	}
	if name == "kernel" {
		return option.Some[llm.ToolSpec]{Value: kernelToolSpec()}
	}
	if name == "subagent" {
		return option.Some[llm.ToolSpec]{Value: subagentToolSpec()}
	}
	if name == "ask_user_async" {
		return option.Some[llm.ToolSpec]{Value: askUserAsyncToolSpec()}
	}
	if name == "job" {
		return option.Some[llm.ToolSpec]{Value: jobToolSpec()}
	}
	option.None
}

// ToolSpecsForRole returns visible tool schemas for role (filtering removed blocking question).
func ToolSpecsForRole(role subagent.AgentRole) []llm.ToolSpec {
	let names = questions.FilterVisibleTools(role, CoreToolNames())
	let mut out = []llm.ToolSpec{}
	for name in names {
		match specByName(name) {
		case option.Some[llm.ToolSpec] as spec:
			out = out.Append(spec.Value)
		case option.None:
		}
	}
	out
}

func jsonValueCodec() json.Codec[json.Value] {
	json.Codec[json.Value]{MaxBytes: 1048576, MaxDepth: 32}
}

func decodeRawJSONValue(raw string) option.Option[json.Value] {
	let val = json.Decode(jsonValueCodec(), raw) catch {
	case _:
		return option.None
	}
	option.Some[json.Value]{Value: val}
}

func decodeJSONObject(tool string, rawJSON string) Map[string, json.Value] fails ToolError {
	let trimmed = strings.TrimSpace(rawJSON)
	if trimmed == "" {
		return Map[string, json.Value]{}
	}
	let v = match decodeRawJSONValue(trimmed) {
	case option.Some[json.Value] as some:
		some.Value
	case option.None:
		return BadToolArgs{Tool: tool, Field: "", Reason: "invalid JSON arguments"}
	}
	match v {
	case json.Object as obj:
		let mut out = Map[string, json.Value]{}
		for mem in obj.Members {
			out[mem.Key] = mem.Value
		}
		out
	case json.Null, json.Boolean, json.Num, json.Str, json.Array:
		BadToolArgs{Tool: tool, Field: "", Reason: "tool arguments must decode to a JSON object"}
	}
}

func optStringField(m Map[string, json.Value], tool string, key string, def string) string fails ToolError {
	match m.Get(key) {
	case option.None:
		def
	case option.Some[json.Value] as v:
		match v.Value {
		case json.Str as s:
			s.Value
		case json.Null:
			def
		case json.Boolean, json.Num, json.Array, json.Object:
			BadToolArgs{Tool: tool, Field: key, Reason: "expected string"}
		}
	}
}

func reqStringField(m Map[string, json.Value], tool string, key string) string fails ToolError {
	let val = try optStringField(m, tool, key, "")
	if strings.TrimSpace(val) == "" {
		return BadToolArgs{Tool: tool, Field: key, Reason: "missing required non-empty string field"}
	}
	val
}

func optBoolField(m Map[string, json.Value], tool string, key string, def bool) bool fails ToolError {
	match m.Get(key) {
	case option.None:
		def
	case option.Some[json.Value] as v:
		match v.Value {
		case json.Boolean as b:
			b.Value
		case json.Null:
			def
		case json.Str, json.Num, json.Array, json.Object:
			BadToolArgs{Tool: tool, Field: key, Reason: "expected boolean"}
		}
	}
}

func optIntField(m Map[string, json.Value], tool string, key string, def int) int fails ToolError {
	match m.Get(key) {
	case option.None:
		def
	case option.Some[json.Value] as v:
		match v.Value {
		case json.Num as n:
			let encoded = json.Encode(jsonValueCodec(), n)
			strconv.Atoi(encoded) catch {
			case strconv.Malformed:
				return BadToolArgs{Tool: tool, Field: key, Reason: "expected integer, got \(encoded)"}
			case strconv.OutOfRange:
				return BadToolArgs{Tool: tool, Field: key, Reason: "integer out of range: \(encoded)"}
			}
		case json.Null:
			def
		case json.Str, json.Boolean, json.Array, json.Object:
			BadToolArgs{Tool: tool, Field: key, Reason: "expected integer"}
		}
	}
}

func optStringListField(m Map[string, json.Value], tool string, key string) []string fails ToolError {
	match m.Get(key) {
	case option.None:
		[]string{}
	case option.Some[json.Value] as v:
		match v.Value {
		case json.Array as arr:
			let mut out = []string{}
			for item in arr.Items {
				match item {
				case json.Str as s:
					out = out.Append(s.Value)
				case json.Null, json.Boolean, json.Num, json.Array, json.Object:
					return BadToolArgs{Tool: tool, Field: key, Reason: "expected string array"}
				}
			}
			out
		case json.Null:
			[]string{}
		case json.Str, json.Boolean, json.Num, json.Object:
			BadToolArgs{Tool: tool, Field: key, Reason: "expected array of strings"}
		}
	}
}

func parseReadArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedRead{Args: ReadArgs{
		Path:   try reqStringField(m, "read", "path"),
		Offset: try optIntField(m, "read", "offset", 1),
		Limit:  try optIntField(m, "read", "limit", 200),
	}}
}

func parseEditArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedEdit{Args: EditArgs{
		Path:       try reqStringField(m, "edit", "path"),
		OldString:  try optStringField(m, "edit", "old_string", ""),
		NewString:  try optStringField(m, "edit", "new_string", ""),
		ReplaceAll: try optBoolField(m, "edit", "replace_all", false),
		Create:     try optBoolField(m, "edit", "create", false),
	}}
}

func parseShellArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedShell{Args: ShellArgs{
		Command:    try reqStringField(m, "shell", "command"),
		Cwd:        try optStringField(m, "shell", "cwd", ""),
		Background: try optBoolField(m, "shell", "background", false),
	}}
}

func parseSearchArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedSearch{Args: SearchArgs{
		Pattern:    try reqStringField(m, "search", "pattern"),
		Root:       try optStringField(m, "search", "root", "."),
		Glob:       try optStringField(m, "search", "glob", ""),
		MaxResults: try optIntField(m, "search", "max_results", 50),
	}}
}

func parseHandlesArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedHandles{Args: HandlesArgs{
		Action:  try reqStringField(m, "handles", "action"),
		ID:      try optStringField(m, "handles", "id", ""),
		Session: try optStringField(m, "handles", "session", ""),
	}}
}

func parseKernelArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedKernel{Args: KernelArgs{
		Action:       try reqStringField(m, "kernel", "action"),
		CellID:       try optStringField(m, "kernel", "cell_id", "cell-1"),
		Code:         try optStringField(m, "kernel", "code", ""),
		ComputeMs:    try optIntField(m, "kernel", "compute_ms", kernel.DefaultComputeMs()),
		WaitMs:       try optIntField(m, "kernel", "wait_ms", kernel.DefaultWaitMs()),
		AskMs:        try optIntField(m, "kernel", "ask_ms", kernel.DefaultAskMs()),
		BindingsJSON: try optStringField(m, "kernel", "bindings_json", "{}"),
		LostBindings: try optStringListField(m, "kernel", "lost_bindings"),
	}}
}

func parseSubagentArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedSubagent{Args: SubagentArgs{
		Action:   try reqStringField(m, "subagent", "action"),
		ParentID: try optStringField(m, "subagent", "parent_id", ""),
		ChildID:  try optStringField(m, "subagent", "child_id", ""),
		Role:     try optStringField(m, "subagent", "role", "worker"),
		HandleID: try optStringField(m, "subagent", "handle_id", ""),
	}}
}

func parseAskUserAsyncArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	let prompt = match m.Get("prompt") {
	case option.Some[json.Value]:
		try reqStringField(m, "ask_user_async", "prompt")
	case option.None:
		try reqStringField(m, "ask_user_async", "question")
	}
	ParsedAskUserAsync{Args: AskUserAsyncArgs{
		ID:         try optStringField(m, "ask_user_async", "id", ""),
		Header:     try optStringField(m, "ask_user_async", "header", "Question"),
		Prompt:     prompt,
		Assumption: try reqStringField(m, "ask_user_async", "assumption"),
		Options:    try optStringListField(m, "ask_user_async", "options"),
	}}
}

func parseJobArgs(m Map[string, json.Value]) ParsedToolCall fails ToolError {
	ParsedJob{Args: JobArgs{
		Action:  try reqStringField(m, "job", "action"),
		ID:      try optStringField(m, "job", "id", ""),
		Command: try optStringField(m, "job", "command", ""),
		Cwd:     try optStringField(m, "job", "cwd", ""),
	}}
}

func dispatchParseByName(name string, m Map[string, json.Value]) ParsedToolCall fails ToolError {
	if name == "read" {
		return try parseReadArgs(m)
	}
	if name == "edit" {
		return try parseEditArgs(m)
	}
	if name == "shell" {
		return try parseShellArgs(m)
	}
	if name == "search" {
		return try parseSearchArgs(m)
	}
	if name == "handles" {
		return try parseHandlesArgs(m)
	}
	if name == "kernel" {
		return try parseKernelArgs(m)
	}
	if name == "subagent" {
		return try parseSubagentArgs(m)
	}
	if name == "ask_user_async" {
		return try parseAskUserAsyncArgs(m)
	}
	if name == "job" {
		return try parseJobArgs(m)
	}
	UnknownToolError{Name: name}
}

// ParseToolCall decodes name and rawJSON into a typed ParsedToolCall, rejecting blocking question for all roles.
func ParseToolCall(role subagent.AgentRole, name string, rawJSON string) ParsedToolCall fails ToolError {
	questions.RequireAsyncOnly(role, name) catch {
	case questions.BlockingQuestionForbidden as f:
		return BlockingQuestionError{Cause: f}
	}
	let m = try decodeJSONObject(name, rawJSON)
	try dispatchParseByName(name, m)
}

// IsReadOnly reports whether call is side-effect-free and eligible for parallel read batching.
func IsReadOnly(call ParsedToolCall) bool {
	match call {
	case ParsedRead, ParsedSearch:
		true
	case ParsedHandles as h:
		h.Args.Action == "list" || h.Args.Action == "get"
	case ParsedSubagent as s:
		s.Args.Action == "list"
	case ParsedJob as j:
		j.Args.Action == "status" || j.Args.Action == "list"
	case ParsedEdit, ParsedShell, ParsedKernel, ParsedAskUserAsync:
		false
	}
}

// IsReadOnlyCall classifies a raw tool name/JSON pair as parallel-safe read-only vs barrier-ordered mutating.
func IsReadOnlyCall(role subagent.AgentRole, name string, rawJSON string) bool {
	let parsed = ParseToolCall(role, name, rawJSON) catch {
	case ToolError:
		return false
	}
	IsReadOnly(parsed)
}

// SchemasFilterQuestionLaw verifies ToolSpecsForRole exposes all 9 surgical tools except blocking question across every role.
law SchemasFilterQuestionLaw() {
	for role in questions.AllAgentRoles() {
		let specs = ToolSpecsForRole(role)
		let mut sawAsync = false
		let mut sawBlocking = false
		for s in specs {
			if s.Name == "ask_user_async" {
				sawAsync = true
			}
			if s.Name == "question" {
				sawBlocking = true
			}
		}
		if !sawAsync || sawBlocking {
			return false
		}
	}
	true
}
