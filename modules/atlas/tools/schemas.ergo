import github.com/cevr/ergo/modules/atlas/guard
import github.com/cevr/ergo/modules/atlas/handles
import github.com/cevr/ergo/modules/atlas/kernel
import github.com/cevr/ergo/modules/atlas/questions
import github.com/cevr/ergo/modules/atlas/subagent
import json
import jsonschema
import llm
import option
import strconv
import strings

// UnknownToolError indicates the model invoked an unrecognized tool identifier.
type UnknownToolError {
	Name string,
}

// BadToolArgs indicates missing, mistyped, or invalid arguments to a tool call.
type BadToolArgs {
	Tool   string,
	Field  string,
	Reason string,
}

// BlockingQuestionError wraps questions.BlockingQuestionForbidden when blocking question is invoked.
type BlockingQuestionError {
	Cause questions.BlockingQuestionForbidden,
}

// GuardBlockedError wraps a non-bypassable shell/workspace safety refusal from atlas/guard.
type GuardBlockedError {
	Cause guard.GuardError,
}

// ApprovalDeniedError indicates a mutating tool required approval under PermissionMode and was denied.
type ApprovalDeniedError {
	Tool   string,
	Reason string,
}

// ToolIoError indicates an underlying filesystem or command runner failure.
type ToolIoError {
	Tool   string,
	Reason string,
}

// ToolKernelError wraps a kernel engine refusal or execution error.
type ToolKernelError {
	Cause kernel.KernelError,
}

// ToolSubagentError wraps a subagent tree boundary or settlement refusal.
type ToolSubagentError {
	Cause subagent.SubagentRefusal,
}

// ToolHandleError wraps a handle registry error.
type ToolHandleError {
	Cause handles.HandleServiceError,
}

// ToolQuestionError wraps an async question validation/book error.
type ToolQuestionError {
	Cause questions.QuestionError,
}

// ToolError is the exhaustive failure union for all surgical tool parsing, gating, and execution.
type ToolError = UnknownToolError | BadToolArgs | BlockingQuestionError | GuardBlockedError | ApprovalDeniedError | ToolIoError | ToolKernelError | ToolSubagentError | ToolHandleError | ToolQuestionError

// ReadArgs holds parsed arguments for the surgical read tool.
type ReadArgs {
	Path   string,
	Offset int,
	Limit  int,
}

// EditArgs holds parsed arguments for the surgical edit tool.
type EditArgs {
	Path       string,
	OldString  string,
	NewString  string,
	ReplaceAll bool,
	Create     bool,
}

// ShellArgs holds parsed arguments for the guard-gated shell tool.
type ShellArgs {
	Command    string,
	Cwd        string,
	Background bool,
}

// SearchArgs holds parsed arguments for workspace search across files.
type SearchArgs {
	Pattern    string,
	Root       string,
	Glob       string,
	MaxResults int,
}

// HandlesArgs holds parsed arguments for querying or cancelling DELIVERS handles.
type HandlesArgs {
	Action  string,
	ID      string,
	Session string,
}

// KernelArgs holds parsed arguments for persistent kernel cell evaluation and management.
type KernelArgs {
	Action       string,
	CellID       string,
	Code         string,
	ComputeMs    int,
	WaitMs       int,
	AskMs        int,
	BindingsJSON string,
	LostBindings []string,
}

// SubagentArgs holds parsed arguments for subtree inspection, spawning, handle tracking, and hand-back.
type SubagentArgs {
	Action   string,
	ParentID string,
	ChildID  string,
	Role     string,
	HandleID string,
}

// AskUserAsyncArgs holds parsed arguments for ask_user_async (never blocking).
type AskUserAsyncArgs {
	ID         string,
	Header     string,
	Prompt     string,
	Assumption string,
	Options    []string,
}

// JobArgs holds parsed arguments for durable background jobs routed via DelivererWakes.
type JobArgs {
	Action  string,
	ID      string,
	Command string,
	Cwd     string,
}

// ParsedRead carries parsed read arguments.
type ParsedRead {
	Args ReadArgs,
}

// ParsedEdit carries parsed edit arguments.
type ParsedEdit {
	Args EditArgs,
}

// ParsedShell carries parsed shell arguments.
type ParsedShell {
	Args ShellArgs,
}

// ParsedSearch carries parsed search arguments.
type ParsedSearch {
	Args SearchArgs,
}

// ParsedHandles carries parsed handles arguments.
type ParsedHandles {
	Args HandlesArgs,
}

// ParsedKernel carries parsed kernel arguments.
type ParsedKernel {
	Args KernelArgs,
}

// ParsedSubagent carries parsed subagent arguments.
type ParsedSubagent {
	Args SubagentArgs,
}

// ParsedAskUserAsync carries parsed ask_user_async arguments.
type ParsedAskUserAsync {
	Args AskUserAsyncArgs,
}

// ParsedJob carries parsed job arguments.
type ParsedJob {
	Args JobArgs,
}

// ParsedToolCall is the typed discriminated union over all 9 surgical core tools.
type ParsedToolCall = ParsedRead | ParsedEdit | ParsedShell | ParsedSearch | ParsedHandles | ParsedKernel | ParsedSubagent | ParsedAskUserAsync | ParsedJob

// CoreToolNames returns the 9 surgical core tool names (explicitly excluding blocking question).
func CoreToolNames() []string {
	[]string{"read", "edit", "shell", "search", "handles", "kernel", "subagent", "ask_user_async", "job"}
}

func makeToolSpec(name string, desc string, props []jsonschema.Prop, required []string) llm.ToolSpec {
	llm.ToolSpec{
		Name:        name,
		Description: desc,
		Input:       jsonschema.Encode(jsonschema.Object(props, required)),
	}
}

func readToolSpec() llm.ToolSpec {
	makeToolSpec("read", "Read lines of a workspace file (read-only; batches in parallel)", []jsonschema.Prop{
		jsonschema.Prop{Key: "path", Schema: jsonschema.String()},
		jsonschema.Prop{Key: "offset", Schema: jsonschema.Integer()},
		jsonschema.Prop{Key: "limit", Schema: jsonschema.Integer()},
	}, []string{"path"})
}

