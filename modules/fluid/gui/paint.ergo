import ergo.dev/fluid/look
import ergo.dev/fluid/token
import strconv
import strings
import ergo.dev/fluid/web

// Tint is a colour resolved for one scheme: a shade, a blend of two (color-mix), or clear.
// Nothing in it names a token: each token was looked up in the theme for the scheme.
type Tint = Clear{} | Solid{S token.Shade} | Blend{A Tint, Percent float64, Into Tint, Space token.Space}

// Corner is a resolved corner radius: pixels, a pill (as round as the box allows) or half the
// box (a circle).
type Corner = Px{N int} | Pill{} | Half{}

// Lift is a resolved box shadow: none, a focus ring, or a surface's layers.
type Lift = Flat{} | Ring{Px int, Color Tint} | Layers{Of []token.Shadow}

// Paint is everything a GUI host paints for a box, complete: no field is optional, nothing is
// inherited, and the theme and scheme are already applied. Fill is clear and Ink and Edge are
// the page's ink unless the style sets them (the web's body colour; border-color's
// currentcolor); widths and radii are 0, Lift is Flat and Opacity 100 (per cent).
type Paint { Fill Tint, Ink Tint, Edge Tint, Top int, Right int, Bottom int, Left int, TL Corner, TR Corner, BR Corner, BL Corner, Lift Lift, Opacity int }

// TintOf is token r in theme t for a scheme.
func TintOf(t token.Theme, r token.Ref, dark bool) Tint {
	let s = match t.Color(r) {
	case token.Pair as p:
		if dark { p.Dark } else { p.Light }
	case token.Fixed as x:
		x.V
	}
	match s {
	case token.Mix as m:
		Blend{A: TintOf(t, m.A, dark), Percent: m.Percent, Into: match m.Toward {
		case token.Clear:
			Clear
		case token.Into as i:
			TintOf(t, i.B, dark)
		}, Space: m.Space}
	case token.Rgba, token.Oklch:
		Solid{S: s}
	}
}

// Of is the paint of style s in theme t for a scheme: each paint declaration of s, over the
// defaults.
func Of(s look.Style, t token.Theme, dark bool) Paint {
	let ink = TintOf(t, token.Ink, dark)
	let mut p = Paint{Fill: Clear, Ink: ink, Edge: ink, Top: 0, Right: 0, Bottom: 0, Left: 0, TL: Px{N: 0}, TR: Px{N: 0}, BR: Px{N: 0}, BL: Px{N: 0}, Lift: Flat, Opacity: 100}
	let mut edgeSet = false
	for d in look.Decls(s) {
		match d {
		case look.Fill as x:
			p.Fill = TintOf(t, x.V, dark)
		case look.Ink as x:
			p.Ink = TintOf(t, x.V, dark)
		case look.EdgeColor as x:
			p.Edge = TintOf(t, x.V, dark)
			edgeSet = true
		case look.EdgeTop as x:
			p.Top = x.Px
		case look.EdgeRight as x:
			p.Right = x.Px
		case look.EdgeBottom as x:
			p.Bottom = x.Px
		case look.EdgeLeft as x:
			p.Left = x.Px
		case look.RoundTL as x:
			p.TL = cornerOf(x.V)
		case look.RoundTR as x:
			p.TR = cornerOf(x.V)
		case look.RoundBR as x:
			p.BR = cornerOf(x.V)
		case look.RoundBL as x:
			p.BL = cornerOf(x.V)
		case look.Shadow as x:
			p.Lift = match x.V {
			case look.Ring as r:
				Ring{Px: r.Px, Color: TintOf(t, r.Color, dark)}
			case look.Surface as l:
				Layers{Of: token.Shadows(l.L)}
			}
		case look.Opacity as x:
			p.Opacity = x.Pct
		case _:
		}
	}
	if !edgeSet {
		p.Edge = p.Ink
	}
	p
}

// In is the paint of look l in state st: its rest style with the state's overlay laid over it
// (the last applied wins), the same style the web's atoms print for that state.
func In(l look.Look, st look.State, t token.Theme, dark bool) Paint {
	Of(look.Merge(l.Rest, look.Overlay(l, st)), t, dark)
}

// cornerOf is a corner's radius, read from the token's CSS length.
func cornerOf(c look.Corner) Corner {
	let text = match c {
	case look.Outer as o:
		token.Px(o.R)
	case look.Inner as i:
		token.Inner(i.R)
	case look.Circle:
		"50%"
	}
	if text == "50%" {
		return Half
	}
	if !strings.HasSuffix(text, "px") || strings.HasPrefix(text, "calc(") {
		return Pill
	}
	let n = strconv.Atoi(strings.Slice(text, 0, len(text)-2)) catch {
	case _:
		return Pill
	}
	Px{N: n}
}

// Decl is one painted property and its CSS value.
type Decl { Prop string, Value string }

// Declarations is a paint as the CSS properties it stands for: what HostsResolveAlike compares
// with the sheet.
func Declarations(p Paint) []Decl {
	[]Decl{
		Decl{Prop: "background-color", Value: TintCSS(p.Fill)},
		Decl{Prop: "color", Value: TintCSS(p.Ink)},
		Decl{Prop: "border-color", Value: TintCSS(p.Edge)},
		Decl{Prop: "border-top-width", Value: "\(p.Top)px"},
		Decl{Prop: "border-right-width", Value: "\(p.Right)px"},
		Decl{Prop: "border-bottom-width", Value: "\(p.Bottom)px"},
		Decl{Prop: "border-left-width", Value: "\(p.Left)px"},
		Decl{Prop: "border-top-left-radius", Value: cornerCSS(p.TL)},
		Decl{Prop: "border-top-right-radius", Value: cornerCSS(p.TR)},
		Decl{Prop: "border-bottom-right-radius", Value: cornerCSS(p.BR)},
		Decl{Prop: "border-bottom-left-radius", Value: cornerCSS(p.BL)},
		Decl{Prop: "box-shadow", Value: liftCSS(p.Lift)},
		Decl{Prop: "opacity", Value: "\(p.Opacity)%"},
	}
}

// HostsResolveAlike: for every look of the module, every state and both schemes, the
// declarations a CSS reference resolves from the web's sheet for the look's class list are the
// declarations of the paint the GUI gets (In). The reference is the oracle: it applies the
// sheet's rules in sheet order to a class list in a state (the group's state is the box's, as
// the GUI projector passes it down), the last rule for a property wins, and each var(--f-…)
// becomes the scheme's half of the token's light-dark(); a property no rule sets has its value
// after the reset (transparent, the body's ink, currentcolor, 0, none, 100%).
law HostsResolveAlike(i int, st look.State, dark bool) {
	let looks = web.Looks()
	let l = looks[((i%len(looks))+len(looks))%len(looks)]
	let sheet = web.Sheet(token.Default, looks)
	let vars = rootVars(sheet)
	let got = cssResolve(rules(sheet), strings.Split(web.Classes(l), " "), statePseudo(st))
	let mut ok = true
	for d in Declarations(In(l, st, token.Default, dark)) {
		let css = match got.Get(d.Prop) {
		case Some as v:
			v.Value
		case None:
			reset(d.Prop, got)
		}
		ok = ok && substitute(css, vars, dark) == d.Value
	}
	ok
}

// cssRule is a rule of the sheet: a class, the state it holds in ("" at rest), and one
// declaration. (the reference's)
type cssRule { Class string, State string, Prop string, Value string }

// rules is the sheet's rules in order, past the reset and the tokens; media rules (a wide
// viewport, which the GUI's paint does not take yet) are skipped.
func rules(sheet string) []cssRule {
	let mut out = []cssRule{}
	let mut rest = strings.Slice(sheet, strings.Index(sheet, ":root{"), len(sheet))
	rest = strings.Slice(rest, strings.Index(rest, "}")+1, len(rest))
	for len(rest) > 0 {
		if strings.HasPrefix(rest, "@media") {
			rest = strings.Slice(rest, strings.Index(rest, "}}")+2, len(rest))
			continue
		}
		let open = strings.Index(rest, "{")
		let close = strings.Index(rest, "}")
		let sel = strings.Slice(rest, 0, open)
		let body = strings.Slice(rest, open+1, close)
		let colon = strings.Index(body, ":")
		let group = strings.HasPrefix(sel, ":where(.fg")
		let class = if group { strings.Slice(sel, strings.Index(sel, ") .")+3, len(sel)) } else { strings.Slice(sel, 1, if strings.Index(sel, ":") < 0 { len(sel) } else { strings.Index(sel, ":") }) }
		let state = if group { strings.Slice(sel, 10, strings.Index(sel, ")")) } else if strings.Index(sel, ":where(") < 0 { "" } else { strings.Slice(sel, strings.Index(sel, ":where(")+7, len(sel)-1) }
		out = out.Append(cssRule{Class: class, State: state, Prop: strings.Slice(body, 0, colon), Value: strings.Slice(body, colon+1, len(body))})
		rest = strings.Slice(rest, close+1, len(rest))
	}
	out
}

// cssResolve is the declarations rules give a box of classes in state (a pseudo-class, "" at rest).
func cssResolve(rs []cssRule, classes []string, state string) Map[string, string] {
	let mut out = Map[string, string]{}
	for r in rs {
		if (r.State == "" || r.State == state) && slicesHas(classes, r.Class) {
			out[r.Prop] = r.Value
		}
	}
	out
}

func slicesHas(xs []string, x string) bool {
	for y in xs {
		if y == x {
			return true
		}
	}
	false
}

// rootVars is the tokens' custom properties: name to value.
func rootVars(sheet string) Map[string, string] {
	let from = strings.Index(sheet, ":root{") + 6
	let body = strings.Slice(sheet, from, from+strings.Index(strings.Slice(sheet, from, len(sheet)), "}"))
	let mut out = Map[string, string]{}
	for d in strings.Split(body, ";") {
		let colon = strings.Index(d, ":")
		if colon > 0 {
			out[strings.Slice(d, 0, colon)] = strings.Slice(d, colon+1, len(d))
		}
	}
	out
}

// substitute is v with each var(--f-…) replaced by the scheme's value of the token.
func substitute(v string, vars Map[string, string], dark bool) string {
	let at = strings.Index(v, "var(")
	if at < 0 {
		return v
	}
	let end = at + strings.Index(strings.Slice(v, at, len(v)), ")")
	let name = strings.Slice(v, at+4, end)
	let value = match vars.Get(name) {
	case Some as x:
		scheme(x.Value, dark)
	case None:
		"?" + name
	}
	strings.Slice(v, 0, at) + substitute(value, vars, dark) + substitute(strings.Slice(v, end+1, len(v)), vars, dark)
}

// scheme is a light-dark(a, b) value's half for the scheme, or the value itself.
func scheme(v string, dark bool) string {
	if !strings.HasPrefix(v, "light-dark(") {
		return v
	}
	let inner = strings.Slice(v, 11, len(v)-1)
	let mut depth = 0
	for i in 0..len(inner) {
		let c = inner[i]
		if c == '(' {
			depth = depth + 1
		} else if c == ')' {
			depth = depth - 1
		} else if c == ',' && depth == 0 {
			return if dark { strings.Slice(inner, i+2, len(inner)) } else { strings.Slice(inner, 0, i) }
		}
	}
	v
}

// reset is a property's value when no rule sets it.
func reset(prop string, set Map[string, string]) string {
	match prop {
	case "background-color":
		"transparent"
	case "color":
		"var(--f-ink)"
	case "border-color":
		match set.Get("color") {
		case Some as c:
			c.Value
		case None:
			"var(--f-ink)"
		}
	case "box-shadow":
		"none"
	case "opacity":
		"100%"
	case _:
		"0px"
	}
}

// statePseudo is a state's pseudo-class as the sheet prints it.
func statePseudo(s look.State) string {
	match s {
	case look.Rest:
		""
	case look.Hover:
		":hover"
	case look.FocusWithin:
		":focus-within"
	case look.FocusVisible:
		":focus-visible"
	case look.Active:
		":active"
	case look.Disabled:
		":disabled"
	}
}

// TintCSS is a tint as a CSS colour.
func TintCSS(t Tint) string {
	match t {
	case Clear:
		"transparent"
	case Solid as s:
		token.Print(s.S)
	case Blend as b:
		let space = match b.Space {
		case token.Oklab:
			"oklab"
		case token.Srgb:
			"srgb"
		}
		"color-mix(in \(space), \(TintCSS(b.A)) \(strconv.FormatFloat(b.Percent, 'f', -1))%, \(TintCSS(b.Into)))"
	}
}

func cornerCSS(c Corner) string {
	match c {
	case Px as p:
		"\(p.N)px"
	case Pill:
		"calc(infinity * 1px)"
	case Half:
		"50%"
	}
}

func liftCSS(l Lift) string {
	match l {
	case Flat:
		"none"
	case Ring as r:
		"0 0 0 \(r.Px)px \(TintCSS(r.Color))"
	case Layers as ls:
		if len(ls.Of) == 0 {
			return "none"
		}
		let mut b = strings.NewBuilder()
		for i in 0..len(ls.Of) {
			let s = ls.Of[i]
			if i > 0 {
				b.WriteString(", ")
			}
			b.WriteString("0 \(s.Y)px \(s.Blur)px \(s.Spread)px \(token.Print(token.Rgba{V: s.Color}))")
		}
		b.String()
	}
}
