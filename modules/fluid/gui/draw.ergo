// Package gui is the window's side of the library: Draw writes a part tree on a std ui frame,
// and Paint resolves a look's style, in a state and a scheme, to the complete paint a GUI host
// draws (spec §2.2, §4.1). Draw projects what ui has today: structure, text, presses, fields and
// keys. Box looks wait for ui.Paint (UG1), glyphs for path fills (UG6), layers for ui.Layer (UG4)
// and the roles past ui's for UG2; until then a glyph draws nothing and a role ui lacks draws as
// a generic box (a11y.UIRole says which).

import ergo.dev/fluid/a11y
import ergo.dev/fluid/part
import ui

// Draw writes n on f. A press is a ui Semantic node that sends its signal (none while disabled);
// a box that states something a reader is told is a Semantic node too, else a plain Box; a
// box's keyboard map is an OnKey over its bindings (ui answers a key with the first map a pass
// wrote: focus scopes come with UG3); while a modal layer is shown, the branches beside it are
// not drawn (as they are inert on the web).
func Draw[E](f *ui.Frame[E], n part.Node[E]) {
	match n {
	case part.Box as b:
		if b.Sem.Hidden {
			return
		}
		if len(b.Keys) > 0 {
			let keys = b.Keys
			ui.OnKey(f, func(k ui.KeyPress) Option[E] { Bound[E](keys, k) })
		}
		if states(b.Sem) {
			ui.Semantic(f, accessOf(b.Sem, b.Sem.Role, false), None, ui.Plain()) {
				drawKids[E](f, b.Kids)
			}
		} else {
			ui.Box(f, ui.Plain()) {
				drawKids[E](f, b.Kids)
			}
		}
	case part.Text as t:
		if t.Value != "" {
			ui.Text(f, t.Value)
		}
	case part.Glyph:
	case part.Press as p:
		if p.Sem.Hidden {
			return
		}
		let off = disabled(p.Sem.States)
		let on = if off { None } else { p.On }
		let enabled = match on {
		case Some:
			true
		case None:
			false
		}
		let role = match p.Sem.Role {
		case part.Generic:
			part.Button
		case _:
			p.Sem.Role
		}
		ui.Semantic(f, accessOf(p.Sem, role, !enabled), on, ui.Plain()) {
			drawKids[E](f, p.Kids)
		}
	case part.Field as x:
		if x.Sem.Hidden {
			return
		}
		let on = x.On
		ui.Semantic(f, ui.Access{..accessOf(x.Sem, part.TextBox, false), Value: Some[string]{Value: x.Value}}, None, ui.Plain()) {
			ui.Input(f, x.Value, x.Hint, func(text string) E { on(text) })
		}
	case part.Scale as s:
		if s.Sem.Hidden {
			return
		}
		ui.Semantic(f, accessOf(s.Sem, part.Slider, false), None, ui.Plain()) {}
	case part.Layer as l:
		drawKids[E](f, l.Kids)
	case part.Keyed as k:
		ui.Zone(f, ui.TextKey{Value: k.Key}, ui.Plain()) {
			Draw[E](f, k.Node)
		}
	case part.Live as l:
		if l.Assertive {
			ui.Semantic(f, accessOf(part.Plain(), part.Alert, false), None, ui.Plain()) {
				ui.Text(f, l.Text)
			}
		} else {
			ui.Announce(f, l.Text)
		}
	case part.Host as h:
		h.Gui(f)
	}
}

// drawKids draws kids; while one branch shows a modal layer, only the branches that hold one.
func drawKids[E](f *ui.Frame[E], kids []part.Node[E]) {
	let shown = part.Shown[E](kids)
	for i in 0..len(kids) {
		if shown[i] {
			Draw[E](f, kids[i])
		}
	}
}

// Bound is the signal bindings send for key k: the first binding of its name, if any.
func Bound[E](bindings []part.Binding[E], k ui.KeyPress) Option[E] {
	for b in bindings {
		if b.Key == k.Name {
			return Some[E]{Value: b.On}
		}
	}
	None
}

// states reports whether a box states something ui can tell a reader: a role ui carries other
// than generic, a name, or a state.
func states(s part.Sem) bool {
	let generic = match s.Role {
	case part.Generic:
		true
	case _:
		false
	}
	!generic || s.Name != "" || len(s.States) > 0
}

func disabled(ss []part.State) bool {
	for s in ss {
		match s {
		case part.Disabled:
			return true
		case _:
		}
	}
	false
}

// accessOf is a node's semantics as ui.Access: its role (generic for a role ui lacks), name and
// the states ui carries; off adds Disabled.
func accessOf(s part.Sem, role part.Role, off bool) ui.Access {
	let mut a = ui.Access{Role: ui.Generic, Name: s.Name, Disabled: off, Description: "", Checked: None, Value: None, Selected: None, Expanded: None, Pressed: None, Invalid: false, Busy: false, HasPopup: false, Level: None}
	match a11y.UIRole(role) {
	case Some as r:
		a.Role = r.Value
	case None:
	}
	match role {
	case part.Heading as h:
		a.Level = Some[int]{Value: h.Level}
	case _:
	}
	for st in s.States {
		match st {
		case part.Disabled:
			a.Disabled = true
		case part.Busy:
			a.Busy = true
		case part.Invalid:
			a.Invalid = true
		case part.Checked as c:
			match c.Value {
			case part.On:
				a.Checked = Some[bool]{Value: true}
			case part.Off:
				a.Checked = Some[bool]{Value: false}
			case part.Mixed:
			}
		case part.Selected as x:
			a.Selected = Some[bool]{Value: x.Yes}
		case part.Expanded as x:
			a.Expanded = Some[bool]{Value: x.Yes}
		case part.Pressed as x:
			a.Pressed = Some[bool]{Value: x.Yes}
		case part.Current, part.Modal, part.MultiSelectable, part.Value:
		}
	}
	for r in s.Rels {
		match r {
		case part.HasPopup:
			a.HasPopup = true
		case _:
		}
	}
	a
}
