import ergo.dev/fluid/a11y
import ergo.dev/fluid/part
import html
import ui

// frameOf is a frame after one pass that draws n. (the laws' helper)
func frameOf(n part.Node[int]) ui.Frame[int] {
	let mut f = ui.NewFrame[int]()
	let _ = ui.Render(&f, func(fr mut ui.Frame[int], t part.Node[int]) { Draw(fr, t) }, n)
	f
}

// presses is the ids of the frame's presses (Semantic nodes that are buttons), in tree order.
// (the laws' helper)
func presses(f mut ui.Frame[int], id ui.Id[int]) []ui.Id[int] {
	let mut out = []ui.Id[int]{}
	for k in ui.Kids(f, id) {
		match ui.NodeOf(f, k) {
		case Some as n:
			match n.Value {
			case ui.SemanticNode as s:
				match s.Access.Role {
				case ui.Button:
					out = out.Append(k)
				case _:
				}
			case _:
			}
		case None:
		}
		for x in presses(f, k) {
			out = out.Append(x)
		}
	}
	out
}

// PressSendsItsSignal: pressing the i-th button of the window sends the i-th press's signal, and
// nothing for a press that sends none or is stated disabled; a key the keyed box binds sends its
// binding's signal (the first of that name), and a key it does not bind sends nothing.
law PressSendsItsSignal(sends []int, keys []int) {
	let mut row = []part.Node[int]{}
	let mut want = []Option[int]{}
	for i in 0..len(sends) {
		let v = sends[i]
		let none = v%3 == 0
		let off = v%5 == 0
		let on Option[int] = if none { None } else { Some[int]{Value: v} }
		row = row.Append(part.Press{Sem: part.Sem{..part.Of(part.Button), Name: "p\(i)", States: if off { []part.State{part.Disabled} } else { []part.State{} }}, Skin: part.Control{Root: part.Bare(), Plate: part.Bare(), Content: part.Bare()}, On: on, Kids: []part.Node[int]{}})
		want = want.Append(if off { None } else { on })
	}
	let names = []string{"ArrowLeft", "ArrowRight", "Home", "End", "Enter"}
	let mut bindings = []part.Binding[int]{}
	for i in 0..len(keys) {
		bindings = bindings.Append(part.Binding[int]{Key: names[((keys[i]%5)+5)%5], On: keys[i]})
	}
	let tree part.Node[int] = part.Box{Sem: part.Of(part.Toolbar), Skin: part.Bare(), Inline: false, Keys: bindings, Kids: row}
	let mut f = frameOf(tree)
	let ids = presses(&f, ui.Root(&f))
	let mut ok = len(ids) == len(sends)
	for i in 0..len(ids) {
		ok = ok && i < len(want) && ui.Handle(&f, ui.Press[int]{Id: ids[i]}).Signal == want[i]
	}
	for n in names {
		let mut first Option[int] = None
		for b in bindings {
			if b.Key == n && first == None {
				first = Some[int]{Value: b.On}
			}
		}
		ok = ok && ui.Handle(&f, ui.KeyDown{Press: ui.KeyPress{Name: n, Mods: ui.Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}).Signal == first
	}
	ok && ui.Handle(&f, ui.KeyDown{Press: ui.KeyPress{Name: "x", Mods: ui.Mods{Shift: false, Ctrl: false, Alt: false, Meta: false}}}).Signal == None
}

// AccessOfGuiIsAccessOfPart: the access tree std ui holds after drawing a part tree is the
// tree's own (a11y.Of), as far as ui carries it (a11y.Narrow), for trees drawn from a seed
// over the roles ui carries: every node kind but Scale (UG2), names, states (those ui lacks are
// narrowed away), keyboard maps, hidden and modal branches, keyed nodes, host leaves and live
// regions. A failing seed prints both trees (Case).
law AccessOfGuiIsAccessOfPart(seed []int) {
	let (gui, want) = Case(seed)
	gui == want
}

// Case is what a seed of AccessOfGuiIsAccessOfPart draws: the print of the frame's access tree
// and of the narrowed part tree's.
func Case(seed []int) (string, string) {
	let mut g = Gen{xs: seed, at: 0}
	let tree = drawNode(&g, 0)
	let mut f = frameOf(tree)
	(a11y.Print(a11y.OfUI(&f)), a11y.Print(a11y.Narrow(a11y.Of(tree))))
}

// Gen draws from a seed. (the property's helper)
type Gen { xs []int, at int }

func draw(g mut Gen, n int) int {
	let v = if len(g.xs) == 0 { g.at * 7919 } else { g.xs[g.at%len(g.xs)] + g.at*7919 }
	g.at = g.at + 1
	((v % n) + n) % n
}

func pick[T](g mut Gen, xs []T) T { xs[draw(g, len(xs))] }

let words = []string{"a", "b c", "<x>", "&amp", "it's", "é", ""}

// carriedRoles is every part role ui carries.
func carriedRoles() []part.Role {
	let mut out = []part.Role{}
	for r in a11y.Roles() {
		match a11y.UIRole(r) {
		case Some:
			out = out.Append(r)
		case None:
		}
	}
	out
}

let pressRoles = []part.Role{part.Button, part.Tab, part.MenuItem, part.Switch, part.Checkbox, part.Link, part.Generic}

let allStates = []part.State{part.Disabled, part.Busy, part.Invalid, part.Checked{Value: part.On}, part.Checked{Value: part.Mixed}, part.Selected{Yes: true}, part.Expanded{Yes: false}, part.Pressed{Yes: true}, part.Current{Kind: "page"}}

func drawStates(g mut Gen) []part.State {
	let mut out = []part.State{}
	for _ in 0..draw(g, 3) {
		let s = pick(g, allStates)
		let mut seen = false
		for x in out {
			seen = seen || a11y.StateName(x) == a11y.StateName(s)
		}
		if !seen {
			out = out.Append(s)
		}
	}
	out
}

func drawSem(g mut Gen, role part.Role) part.Sem {
	part.Sem{
		Role:   role,
		Name:   if draw(g, 3) == 0 { pick(g, words) } else { "" },
		Key:    if draw(g, 3) == 0 { part.Join(part.Root("k"), "\(g.at)") } else { "" },
		States: drawStates(g),
		Rels:   if draw(g, 4) == 0 { []part.Rel{part.Controls{Key: "k1"}} } else { []part.Rel{} },
		Reach:  pick(g, []part.Reach{part.Out, part.Native, part.Stop, part.Roving{Here: true}}),
		Focus:  false,
		Hidden: draw(g, 8) == 0,
	}
}

func genKids(g mut Gen, depth int) []part.Node[int] {
	let mut out = []part.Node[int]{}
	for _ in 0..draw(g, if depth >= 3 { 1 } else { 4 }) {
		out = out.Append(drawNode(g, depth+1))
	}
	out
}

// drawNode is a node of the tree a seed draws.
func drawNode(g mut Gen, depth int) part.Node[int] {
	match draw(g, if depth >= 3 { 4 } else { 12 }) {
	case 0:
		part.Text{Value: pick(g, words), Skin: part.Bare()}
	case 1:
		part.Glyph{Paths: "<path d=\"M5 12h14\"></path>", Stroked: true, Skin: part.Bare()}
	case 2:
		part.Live{Text: pick(g, words), Assertive: draw(g, 2) == 0}
	case 3:
		let w = pick(g, words)
		part.Host{Web: "<b>" + html.Escape(w) + "</b>", Gui: func(f mut ui.Frame[int]) { ui.Text(f, w) }}
	case 4:
		part.Box{Sem: part.Plain(), Skin: part.Bare(), Inline: draw(g, 2) == 0, Keys: []part.Binding[int]{}, Kids: genKids(g, depth)}
	case 5, 6:
		let keys = if draw(g, 3) == 0 { []part.Binding[int]{part.Binding[int]{Key: "ArrowRight", On: 1}} } else { []part.Binding[int]{} }
		part.Box{Sem: drawSem(g, pick(g, carriedRoles())), Skin: part.Bare(), Inline: false, Keys: keys, Kids: genKids(g, depth)}
	case 7:
		let on Option[int] = if draw(g, 3) == 0 { None } else { Some[int]{Value: draw(g, 4)} }
		part.Press{Sem: drawSem(g, pick(g, pressRoles)), Skin: part.Control{Root: part.Bare(), Plate: part.Bare(), Content: part.Bare()}, On: on, Kids: genKids(g, depth)}
	case 8:
		part.Field{Sem: drawSem(g, part.Generic), Skin: part.Bare(), Name: "f", Value: pick(g, words), Hint: pick(g, words), Lines: draw(g, 3), On: func(s string) int { len(s) }}
	case 9:
		part.Layer{Z: draw(g, 3), Modal: draw(g, 3) == 0, Dismiss: None, Kids: genKids(g, depth)}
	case 10:
		part.Keyed{Key: "k\(g.at)", Node: drawNode(g, depth+1)}
	case _:
		part.Box{Sem: part.Of(part.Heading{Level: 1 + draw(g, 6)}), Skin: part.Bare(), Inline: false, Keys: []part.Binding[int]{}, Kids: genKids(g, depth)}
	}
}
