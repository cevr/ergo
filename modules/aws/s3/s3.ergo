		SSECustomerAlgorithm:    aws.TextIn(h, "x-amz-server-side-encryption-customer-algorithm"),
		SSECustomerKeyMD5:       aws.TextIn(h, "x-amz-server-side-encryption-customer-key-MD5"),
		SSEKMSKeyId:             aws.TextIn(h, "x-amz-server-side-encryption-aws-kms-key-id"),
		SSEKMSEncryptionContext: aws.TextIn(h, "x-amz-server-side-encryption-context"),
		BucketKeyEnabled:        try aws.BoolIn(h, "x-amz-server-side-encryption-bucket-key-enabled"),
		Size:                    try aws.IntIn(h, "x-amz-object-size"),
		RequestCharged:          aws.TextIn(h, "x-amz-request-charged").Map(requestChargedOf),
	}
}

func putObjectFailed(status int, body string) PutObjectOutput fails EncryptionTypeMismatch | InvalidRequest | InvalidWriteOffset | TooManyParts | aws.Failed | aws.Malformed {
	let e = try aws.ErrorOf(status, body)
	match e.Code {
	case "EncryptionTypeMismatch":
		return encryptionTypeMismatch(e)
	case "InvalidRequest":
		return invalidRequest(e)
	case "InvalidWriteOffset":
		return invalidWriteOffset(e)
	case "TooManyParts":
		return tooManyParts(e)
	case _:
		aws.Failed{Status: e.Status, Code: e.Code, Message: e.Message}
	}
}

// DeleteObject sends r: DELETE /{Bucket}/{Key+}.
func DeleteObject(a Api, r DeleteObjectRequest) DeleteObjectOutput fails aws.Failed | aws.Malformed | http.RequestFailed {
	let mut q = []http.Field{}
	q = q.Append(http.Field{Name: "x-id", Value: "DeleteObject"})
	let mut h = []http.Field{}
	h = aws.PutText(h, "x-amz-mfa", r.MFA)
	q = aws.PutText(q, "versionId", r.VersionId)
	h = aws.PutBy(h, "x-amz-request-payer", r.RequestPayer, requestPayerWire)
	h = aws.PutBool(h, "x-amz-bypass-governance-retention", r.BypassGovernanceRetention)
	h = aws.PutText(h, "x-amz-expected-bucket-owner", r.ExpectedBucketOwner)
	h = aws.PutText(h, "If-Match", r.IfMatch)
	h = aws.PutTime(h, "x-amz-if-match-last-modified-time", r.IfMatchLastModifiedTime, aws.HTTPDate)
	h = aws.PutInt(h, "x-amz-if-match-size", r.IfMatchSize)
	let req = http.Request{Method: "DELETE", Path: "/" + r.Bucket + "/" + r.Key, RawPath: "/" + aws.Label(r.Bucket, false) + "/" + aws.Label(r.Key, true), Query: q, Header: h, Body: http.Buffered{Text: ""}}
	let resp = try a.net.Send(a.signer.Sign(req))
	if resp.Status < 200 || resp.Status > 299 {
		return try deleteObjectFailed(resp.Status, resp.Body)
	}
	try deleteObjectOutput(resp.Header)
}

func deleteObjectOutput(h []http.Field) DeleteObjectOutput fails aws.Malformed {
	DeleteObjectOutput{
		DeleteMarker:   try aws.BoolIn(h, "x-amz-delete-marker"),
		VersionId:      aws.TextIn(h, "x-amz-version-id"),
		RequestCharged: aws.TextIn(h, "x-amz-request-charged").Map(requestChargedOf),
	}
}

func deleteObjectFailed(status int, body string) DeleteObjectOutput fails aws.Failed | aws.Malformed {
	let e = try aws.ErrorOf(status, body)
	aws.Failed{Status: e.Status, Code: e.Code, Message: e.Message}
}

