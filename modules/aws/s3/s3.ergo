func putObjectFailed(status int, body string) PutObjectOutput fails EncryptionTypeMismatch | InvalidRequest | InvalidWriteOffset | TooManyParts | aws.Failed | aws.Malformed {
	let e = try aws.ErrorOf(status, body)
	if e.Code == "EncryptionTypeMismatch" {
		return encryptionTypeMismatch(e)
	}
	if e.Code == "InvalidRequest" {
		return invalidRequest(e)
	}
	if e.Code == "InvalidWriteOffset" {
		return invalidWriteOffset(e)
	}
	if e.Code == "TooManyParts" {
		return tooManyParts(e)
	}
	aws.Failed{Status: e.Status, Code: e.Code, Message: e.Message}
}

