func putObjectOutput(h []http.Field) PutObjectOutput fails aws.Malformed {
	PutObjectOutput{
		Expiration:              aws.TextIn(h, "x-amz-expiration"),
		ETag:                    aws.TextIn(h, "ETag"),
		ChecksumCRC32:           aws.TextIn(h, "x-amz-checksum-crc32"),
		ChecksumCRC32C:          aws.TextIn(h, "x-amz-checksum-crc32c"),
		ChecksumCRC64NVME:       aws.TextIn(h, "x-amz-checksum-crc64nvme"),
		ChecksumSHA1:            aws.TextIn(h, "x-amz-checksum-sha1"),
		ChecksumSHA256:          aws.TextIn(h, "x-amz-checksum-sha256"),
		ChecksumSHA512:          aws.TextIn(h, "x-amz-checksum-sha512"),
		ChecksumMD5:             aws.TextIn(h, "x-amz-checksum-md5"),
		ChecksumXXHASH64:        aws.TextIn(h, "x-amz-checksum-xxhash64"),
		ChecksumXXHASH3:         aws.TextIn(h, "x-amz-checksum-xxhash3"),
		ChecksumXXHASH128:       aws.TextIn(h, "x-amz-checksum-xxhash128"),
		ChecksumType:            checksumTypeIn(aws.TextIn(h, "x-amz-checksum-type")),
		ServerSideEncryption:    serverSideEncryptionIn(aws.TextIn(h, "x-amz-server-side-encryption")),
		VersionId:               aws.TextIn(h, "x-amz-version-id"),
		SSECustomerAlgorithm:    aws.TextIn(h, "x-amz-server-side-encryption-customer-algorithm"),
		SSECustomerKeyMD5:       aws.TextIn(h, "x-amz-server-side-encryption-customer-key-MD5"),
		SSEKMSKeyId:             aws.TextIn(h, "x-amz-server-side-encryption-aws-kms-key-id"),
		SSEKMSEncryptionContext: aws.TextIn(h, "x-amz-server-side-encryption-context"),
		BucketKeyEnabled:        try aws.BoolIn(h, "x-amz-server-side-encryption-bucket-key-enabled"),
		Size:                    try aws.IntIn(h, "x-amz-object-size"),
		RequestCharged:          requestChargedIn(aws.TextIn(h, "x-amz-request-charged")),
