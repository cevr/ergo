	InvalidObjectState{
		Status:       e.Status,
		Message:      e.Message,
		StorageClass: e.Fields.Get("StorageClass").Map(storageClassOf),
		AccessTier:   e.Fields.Get("AccessTier").Map(intelligentTieringAccessTierOf),
	}
}

