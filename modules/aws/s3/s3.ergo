func DeleteObject(a Api, r DeleteObjectRequest) DeleteObjectOutput fails aws.Failed | aws.Malformed | http.RequestFailed {
	let mut q = []http.Field{}
	q = q.Append(http.Field{Name: "x-id", Value: "DeleteObject"})
	let mut h = []http.Field{}
	match r.MFA {
	case option.Some as v:
		h = h.Append(http.Field{Name: "x-amz-mfa", Value: v.Value})
	case option.None:
	}
	match r.VersionId {
	case option.Some as v:
		q = q.Append(http.Field{Name: "versionId", Value: v.Value})
	case option.None:
	}
	match r.RequestPayer {
	case option.Some as v:
		h = h.Append(http.Field{Name: "x-amz-request-payer", Value: requestPayerWire(v.Value)})
	case option.None:
	}
	match r.BypassGovernanceRetention {
	case option.Some as v:
		h = h.Append(http.Field{Name: "x-amz-bypass-governance-retention", Value: aws.BoolText(v.Value)})
	case option.None:
	}
	match r.ExpectedBucketOwner {
	case option.Some as v:
		h = h.Append(http.Field{Name: "x-amz-expected-bucket-owner", Value: v.Value})
	case option.None:
	}
	match r.IfMatch {
	case option.Some as v:
		h = h.Append(http.Field{Name: "If-Match", Value: v.Value})
	case option.None:
	}
	match r.IfMatchLastModifiedTime {
	case option.Some as v:
		h = h.Append(http.Field{Name: "x-amz-if-match-last-modified-time", Value: aws.TimeText(v.Value, aws.HTTPDate)})
	case option.None:
	}
	match r.IfMatchSize {
	case option.Some as v:
		h = h.Append(http.Field{Name: "x-amz-if-match-size", Value: aws.IntText(v.Value)})
	case option.None:
	}
	let req = http.Request{Method: "DELETE", Path: "/" + r.Bucket + "/" + r.Key, RawPath: "/" + aws.Label(r.Bucket, false) + "/" + aws.Label(r.Key, true), Query: q, Header: h, Body: http.Buffered{Text: ""}}
	let resp = try a.net.Send(a.signer.Sign(req))
	if resp.Status < 200 || resp.Status > 299 {
		return try deleteObjectFailed(resp.Status, resp.Body)
	}
	try deleteObjectOutput(resp.Header)
}

func deleteObjectOutput(h []http.Field) DeleteObjectOutput fails aws.Malformed {
	DeleteObjectOutput{
		DeleteMarker:   try aws.BoolIn(h, "x-amz-delete-marker"),
		VersionId:      aws.TextIn(h, "x-amz-version-id"),
		RequestCharged: requestChargedIn(aws.TextIn(h, "x-amz-request-charged")),
	}
