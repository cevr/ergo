// Package aws is the protocol runtime the generated AWS clients call: the
// signer contract, the failures every operation shares, the reader of an
// S3 error body and the encoding rules of Smithy's HTTP bindings (wf10
// GEN-EMIT). It is written by hand and kept small: what a client of one
// service needs lives in that client, generated from its model
// (modules/clientgen). SigV4 is AWS-CORE's provider of Signer.

import http
import maps
import option
import slices
import strconv
import strings
import time
import url
import xml

// Signer adds what is computed from a request just before it is sent (a
// SigV4 signature, AWS-CORE). A static key is not a signer's: it is an
// http.Credential the Net holds (std http ForOrigin), so a generated
// client builds its requests with none and no wrapper, log or recording
// of the requests it hands on sees one.
type Signer {
	Sign(r http.Request) http.Request,

	// SignKeepsTheRequest: a signer only adds: the method, the paths, the
	// query and the body are the request's, and every header it had is
	// kept, in order, before the ones the signer adds. A service checks
	// the signature over what was built; AWS-CORE states SigV4's
	// signatures over AWS's test vectors.
	law SignKeepsTheRequest(method string, path string, query []http.Field, header []http.Field, body string) {
		let r = http.Request{Method: method, Path: path, RawPath: path, Query: query, Header: header, Body: http.Buffered{Text: body}}
		let s = Sign(r)
		s.Method == r.Method && s.Path == r.Path && s.RawPath == r.RawPath && s.Query == r.Query && s.Body == r.Body && s.Header.Len() >= r.Header.Len() && s.Header[0:r.Header.Len()] == r.Header
	},
}

// Unsigned sends a request as it was built: for tests, a local endpoint,
// and a public bucket.
type Unsigned {} implements Signer

func Sign(_ Unsigned, r http.Request) http.Request { r }

// Failed is an answer the operation's model names no error for: its
// status, the service's error code and message.
type Failed { Status int, Code string, Message string }

// Malformed is an answer the client cannot read: a header that is not of
// its member's type, or an error body that is not XML.
type Malformed { Reason string }

// ErrorBody is an S3 error answer: its status, its code and message, and
// the text of every other element under <Error>, by name.
type ErrorBody { Status int, Code string, Message string, Fields Map[string, string] }

// ErrorOf reads an S3 error answer. S3 writes <Error><Code>…</Code>
// <Message>…</Message>…</Error> with no wrapper (the restXml protocol's
// noErrorWrapping); an answer with no body (a HEAD) gets its status's
// name as its code, as AWS's SDKs read it (404 NotFound).
func ErrorOf(status int, body string) ErrorBody fails Malformed {
	if strings.TrimSpace(body) == "" {
		return ErrorBody{Status: status, Code: statusName(status), Message: "", Fields: Map[string, string]{}}
	}
	let mut p = xml.NewParser(body, 16)
	let mut code = ""
	let mut message = ""
	let mut fields = Map[string, string]{}
	let mut depth = 0
	let mut name = ""
	let mut text = ""
	for {
		let t = p.Next() catch {
		case xml.Malformed as m:
			return Malformed{Reason: "an error body that is not XML: \(m.Reason)"}
		}
		match t {
		case xml.StartElement as s:
			depth = depth + 1
			name = s.Name
			text = ""
		case xml.CharData as c:
			text = text + c.Text
		case xml.EndElement:
			if depth == 2 {
				if name == "Code" {
					code = text
				} else if name == "Message" {
					message = text
				} else {
					fields[name] = text
				}
			}
			depth = depth - 1
			text = ""
		case xml.EndDocument:
			return ErrorBody{Status: status, Code: code, Message: message, Fields: fields}
		case xml.Comment, xml.ProcInst:
		}
	}
}

func statusName(status int) string {
	if status == 301 {
		return "MovedPermanently"
	}
	if status == 304 {
		return "NotModified"
	}
	if status == 400 {
		return "BadRequest"
	}
	if status == 403 {
		return "Forbidden"
	}
	if status == 404 {
		return "NotFound"
	}
	if status == 412 {
		return "PreconditionFailed"
	}
	"Status\(status)"
}

// Format is how a timestamp member is written: Smithy's timestampFormat,
// with http-date the default of a header and date-time of a query.
type HTTPDate {}
type DateTime {}
type EpochSeconds {}
type Format = HTTPDate | DateTime | EpochSeconds

let httpDate = time.Custom{Text: "Mon, 02 Jan 2006 15:04:05 GMT"}

// TimeText is t written in f.
func TimeText(t time.Time, f Format) string {
	match f {
	case HTTPDate:
		time.Format(t, httpDate)
	case DateTime:
		time.Format(t, time.RFC3339)
	case EpochSeconds:
		strconv.FormatInt(time.UnixSeconds(t), 10)
	}
}

// IntText and BoolText are the wire text of a number and a flag.
func IntText(n int) string { strconv.Itoa(n) }

func BoolText(b bool) string { strconv.FormatBool(b) }

// TextIn is the first value of the header name, or None.
func TextIn(h []http.Field, name string) option.Option[string] { http.Header(h, name) }

// IntIn reads the header name as a number.
func IntIn(h []http.Field, name string) option.Option[int] fails Malformed {
	match http.Header(h, name) {
	case option.Some{v}:
		let n = strconv.Atoi(v) catch {
		case _:
			return Malformed{Reason: "header \(name) is not a number: \(v)"}
		}
		option.Some{n}
	case option.None:
		option.None
	}
}

// BoolIn reads the header name as a flag.
func BoolIn(h []http.Field, name string) option.Option[bool] fails Malformed {
	match http.Header(h, name) {
	case option.Some{v}:
		let b = strconv.ParseBool(v) catch {
		case _:
			return Malformed{Reason: "header \(name) is not a flag: \(v)"}
		}
		option.Some{b}
	case option.None:
		option.None
	}
}

// TimeIn reads the header name as a timestamp written in f.
func TimeIn(h []http.Field, name string, f Format) option.Option[time.Time] fails Malformed {
	match http.Header(h, name) {
	case option.Some{v}:
		option.Some[time.Time]{try timeOf(v, f, name)}
	case option.None:
		option.None
	}
}

func timeOf(s string, f Format, name string) time.Time fails Malformed {
	match f {
	case HTTPDate:
		time.Parse(httpDate, s) catch {
		case _:
			return Malformed{Reason: "header \(name) is not an HTTP date: \(s)"}
		}
	case DateTime:
		time.Parse(time.RFC3339, s) catch {
		case _:
			return Malformed{Reason: "header \(name) is not a date-time: \(s)"}
		}
	case EpochSeconds:
		let n = strconv.ParseInt(s, 10, 64) catch {
		case _:
			return Malformed{Reason: "header \(name) is not epoch seconds: \(s)"}
		}
		time.Unix(n, 0)
	}
}

// Prefixed is every header whose name starts with prefix (ignoring
// case), by the rest of its name in lower case: httpPrefixHeaders.
func Prefixed(h []http.Field, prefix string) Map[string, string] {
	let low = strings.ToLower(prefix)
	let mut out = Map[string, string]{}
	for f in h {
		let name = strings.ToLower(f.Name)
		if strings.HasPrefix(name, low) {
			out[strings.TrimPrefix(name, low)] = f.Value
		}
	}
	out
}

// PutBy appends field name formatted with text when v is present.
func PutBy[T](h []http.Field, name string, v option.Option[T], text func(T) string) []http.Field {
	let mut out = h
	match v {
	case option.Some{x}:
		out = out.Append(http.Field{Name: name, Value: text(x)})
	case option.None:
	}
	out
}

// PutText appends field name with v's text when v is present.
func PutText(h []http.Field, name string, v option.Option[string]) []http.Field {
	let mut out = h
	match v {
	case option.Some{x}:
		out = out.Append(http.Field{Name: name, Value: x})
	case option.None:
	}
	out
}

// PutInt appends field name with v's decimal text when v is present.
func PutInt(h []http.Field, name string, v option.Option[int]) []http.Field {
	PutBy(h, name, v, IntText)
}

// PutBool appends field name with v's flag text when v is present.
func PutBool(h []http.Field, name string, v option.Option[bool]) []http.Field {
	PutBy(h, name, v, BoolText)
}

// PutTime appends field name with v formatted in f when v is present.
func PutTime(h []http.Field, name string, v option.Option[time.Time], f Format) []http.Field {
	let mut out = h
	match v {
	case option.Some{t}:
		out = out.Append(http.Field{Name: name, Value: TimeText(t, f)})
	case option.None:
	}
	out
}

// PutPrefixed adds a header prefix+name for each entry of m, in the
// order of the names.
func PutPrefixed(h []http.Field, prefix string, m Map[string, string]) []http.Field {
	let mut out = h
	for k in slices.Sorted(maps.Keys(m)) {
		match m.Get(k) {
		case option.Some{v}:
			out = out.Append(http.Field{Name: prefix + k, Value: v})
		case option.None:
		}
	}
	out
}

// SameOutcome reports whether two runs of call yield equal success values
// (by sameOut) or equal failures (by sameErr).
func SameOutcome[T, E, R](call func() T fails E needs R, sameOut func(T, T) bool, sameErr func(E, E) bool) bool needs R {
	let first = call() catch {
	case e:
		let _ = call() catch {
		case again:
			return sameErr(again, e)
		}
		return false
	}
	let second = call() catch {
	case _:
		return false
	}
	sameOut(second, first)
}

// PutRoundTrips: PutText, PutInt, PutBool, PutTime and PutBy keep prior
// fields in order, append nothing on None, and round-trip through *In.
law PutRoundTrips(n int, b bool, s string, rawSec int64, present bool) {
	let base = []http.Field{http.Field{Name: "X-Keep", Value: "1"}}
	let tv option.Option[string] = if present { option.Some{s} } else { option.None }
	let iv option.Option[int] = if present { option.Some{n} } else { option.None }
	let bv option.Option[bool] = if present { option.Some{b} } else { option.None }
	let sec = (rawSec%2000000000 + 2000000000) % 2000000000
	let tm = time.Unix(sec, 0)
	let dtv option.Option[time.Time] = if present { option.Some{tm} } else { option.None }
	let ht = PutText(base, "X-Text", tv)
	let hi = PutInt(base, "X-Int", iv)
	let hb = PutBool(base, "X-Bool", bv)
	let hd = PutTime(base, "X-HttpDate", dtv, HTTPDate)
	let hr = PutTime(base, "X-DateTime", dtv, DateTime)
	let he = PutTime(base, "X-Epoch", dtv, EpochSeconds)
	let hp = PutBy(base, "X-By", tv, func(x string) string { "v:" + x })
	let wantLen = if present { 2 } else { 1 }
	let wantBy option.Option[string] = if present { option.Some{"v:" + s} } else { option.None }
	let ok = ht.Len() == wantLen &&
		hi.Len() == wantLen &&
		hb.Len() == wantLen &&
		hd.Len() == wantLen &&
		hr.Len() == wantLen &&
		he.Len() == wantLen &&
		hp.Len() == wantLen &&
		TextIn(ht, "X-Keep") == option.Some{"1"} &&
		TextIn(ht, "X-Text") == tv &&
		TextIn(hp, "X-By") == wantBy &&
		try IntIn(hi, "X-Int") == iv &&
		try BoolIn(hb, "X-Bool") == bv &&
		try TimeIn(hd, "X-HttpDate", HTTPDate) == dtv &&
		try TimeIn(hr, "X-DateTime", DateTime) == dtv &&
		try TimeIn(he, "X-Epoch", EpochSeconds) == dtv
	ok
}

// SameOutcomeChecksEquality: SameOutcome returns true only when two runs
// both succeed with equal values or both fail with equal failures.
law SameOutcomeChecksEquality(a int, b int, failFirst bool, failSecond bool) {
	let mut step = 0
	let got = SameOutcome(
		func() int {
			step = step + 1
			if step == 1 {
				if failFirst {
					return Malformed{Reason: "e-\(a)"}
				}
				a
			} else {
				if failSecond {
					return Malformed{Reason: "e-\(b)"}
				}
				b
			}
		},
		func(x, y) { x == y },
		func(x, y) { x == y },
	)
	let want = failFirst == failSecond && a == b
	got == want
}

// Label is a path label's escaped text: each segment escaped as Go's
// url.PathEscape does, and with greedy (`{Key+}`) each "/" kept as a
// separator. SigV4's canonical URI escapes more (AWS-CORE's rule); the
// server decodes both to the same key.
func Label(s string, greedy bool) string {
	if !greedy {
		return url.PathEscape(s)
	}
	let mut parts = []string{}
	for seg in strings.Split(s, "/") {
		parts = parts.Append(url.PathEscape(seg))
	}
	strings.Join(parts, "/")
}

// LabelDecodes: a greedy label's text, split at "/" and each part
// unescaped, is the value again, and a plain label holds no "/".
law LabelDecodes(s string) {
	let mut back = []string{}
	for seg in strings.Split(Label(s, true), "/") {
		back = back.Append(url.PathUnescape(seg) catch {
		case _:
			return false
		})
	}
	strings.Join(back, "/") == s && !strings.Contains(Label(s, false), "/")
}
