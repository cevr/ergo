// How a credential travels. A static key (an API key, a bearer token) is
// an http.Credential the Net holds (std http's ForOrigin, as config's
// LoadSecret gives it): the Api never sees it and no request it builds
// carries it, so a recording of the requests the Api hands to its Net
// (CASSETTE's Record) holds no key. A Signer stays for what a key cannot
// be: a header computed from each request (SigV4, AWS-CORE).
//
// Seen is a test signer: it marks each request it was given and keeps
// it, so the laws below can read what the Api built and check that every
// request the net gets went through the signer.

import github.com/cevr/ergo/modules/aws/aws
import github.com/cevr/ergo/modules/aws/s3
import config
import http
import strings
import sync

type Seen { seen sync.Ref[[]http.Request] } implements aws.Signer

// NewSeen is a signer that has seen no request.
func NewSeen() Seen { Seen{seen: sync.NewRef[[]http.Request]([]http.Request{})} }

func Sign(s Seen, r http.Request) http.Request {
	s.seen.Update(func(rs []http.Request) []http.Request { rs.Append(r) })
	http.Request{..r, Header: r.Header.Append(http.Field{Name: "X-Signed", Value: "1"})}
}

// Requests is every request s was given, in order.
func Requests(s Seen) []http.Request { s.seen.Get() }

// textOf is every byte of a request: its line, query, headers and body.
func textOf(r http.Request) string {
	let mut s = r.Method + " " + r.Path + " " + r.RawPath
	for f in r.Query.Concat(r.Header) {
		s = s + "\n" + f.Name + ": " + f.Value
	}
	match r.Body {
	case http.Buffered as b:
		s + "\n\n" + b.Text
	case http.BodyTooLarge, http.BodyReadFailed:
		s
	}
}

let keys = []string{"k", "a/b c", "dir/x%2F+y/", "", "über/ünder"}

func keyOf(n int) string { keys[(n%len(keys)+len(keys))%len(keys)] }

// call sends one drawn operation through api, its outcome dropped.
func call(api s3.Api, n int, key string) {
	let op = (n/8%4 + 4) % 4
	if op == 0 {
		let _ = api.HeadObject(s3.NewHeadObjectRequest("bk", key)) catch {
		case _:
			return
		}
	} else if op == 1 {
		let _ = api.GetObject(s3.NewGetObjectRequest("bk", key), func(part string) fails http.SinkFailed {}) catch {
		case _:
			return
		}
	} else if op == 2 {
		let _ = api.PutObject(s3.PutObjectRequest{..s3.NewPutObjectRequest("bk", key), Body: "payload", Metadata: Map[string, string]{"Note": "n"}}) catch {
		case _:
			return
		}
	} else {
		let _ = api.DeleteObject(s3.NewDeleteObjectRequest("bk", key)) catch {
		case _:
			return
		}
	}
}

let origin = "http://s3.test"

// KeyOnlyInTheNet: a key bound to the Net as an http.Credential reaches
// the server on every request and is in none of the requests the Api
// builds or its signer hands on, the requests a recording of the Api's
// traffic holds; and each request the server gets went through the
// signer once.
law KeyOnlyInTheNet(secret string, steps []int) {
	let key = "Bearer k3y-" + secret + "-AKIA"
	let c = http.ForOrigin(origin, "Authorization", config.NewRedacted(key)) catch {
	case http.InvalidClient:
		return false
	}
	let got = sync.NewRef[[]http.Request]([]http.Request{})
	let serve = Handler(NewMemory())
	let net = http.InMemoryAt(origin, []http.Credential{c}, func(r http.Request) http.Response needs http.Streaming {
		got.Update(func(rs []http.Request) []http.Request { rs.Append(r) })
		serve(r)
	}) catch {
	case http.InvalidClient:
		return false
	}
	let signer = NewSeen()
	for i, n in steps {
		if i < 6 {
			call(s3.New(net, signer), n, keyOf(n))
		}
	}
	for r in signer.Requests() {
		if strings.Contains(textOf(r), key) {
			return false
		}
	}
	for r in got.Get() {
		if !holds(r, "Authorization", key) || !holds(r, "X-Signed", "1") {
			return false
		}
	}
	len(got.Get()) == len(signer.Requests())
}

// SlashesStayInThePath: a key's "/" is sent as a path separator, each
// segment escaped once (S3's {Key+}): the escaped path has one "/" more
// than the key, and decodes to it. SigV4 (AWS-CORE) signs that path as
// sent, and S3's consoles list a key's segments as folders.
law SlashesStayInThePath(n int) {
	let key = keyOf(n)
	let signer = NewSeen()
	let api = s3.New(http.InMemory(Handler(NewMemory())), signer)
	call(api, n, key)
	let r = signer.Requests()[0]
	strings.Count(r.RawPath, "/") == 2+strings.Count(key, "/") && r.Path == "/bk/"+key
}

func holds(r http.Request, name string, value string) bool {
	match http.Header(r.Header, name) {
	case Some as v:
		v.Value == value
	case None:
		false
	}
}
