// Prune reduces a model to named operations and the shapes they reach, so
// ergo commits only the slice of a provider's model that its infra needs
// (owner, 2026-11-20: people run the generator on what they want; ergo
// holds only what its own drivers use).

import json

// Prune is m with only the operations keep names and the shapes they
// reach: input, output and errors, member targets, list and map members,
// union variants, transitively. A service that reaches a kept operation
// (directly or through its resources) stays, its operations trimmed to the
// kept ones and its resources dropped; its errors stay, with their
// shapes. Shapes keep their traits as written and the order of m, so a
// slice diffs cleanly when the model is synced again. An id of keep that
// is not an operation of m fails Unknown.
//
// drop names trait ids to leave out of the slice (test data or a derived
// form nothing generated reads, such as smithy.rules#endpointTests); with
// none, every trait is kept as written. A dropped id appears nowhere in
// the result: not on a shape, not on a member. It does not reach into an
// Unsupported shape's text, which keeps what it held.
func Prune(m Model, keep []string, drop []string) Model fails Unknown {
	let cut = try pruned(m, keep)
	if len(drop) == 0 {
		return cut
	}
	let mut out = []Shape{}
	for s in cut.Shapes {
		out = out.Append(stripped(s, drop))
	}
	Model{Version: cut.Version, Metadata: cut.Metadata, Shapes: out}
}

// stripped is s without the traits drop names, on the shape and on each
// member.
func stripped(s Shape, drop []string) Shape {
	let k = match s.Kind {
	case Enum as e:
		Enum{Members: strippedMembers(e.Members, drop)}
	case IntEnum as e:
		IntEnum{Members: strippedMembers(e.Members, drop)}
	case Structure as e:
		Structure{Members: strippedMembers(e.Members, drop)}
	case Union as e:
		Union{Members: strippedMembers(e.Members, drop)}
	case List as l:
		List{Member: strippedMember(l.Member, drop)}
	case Mapping as mm:
		Mapping{Key: strippedMember(mm.Key, drop), Value: strippedMember(mm.Value, drop)}
	case Simple, Operation, Service, Resource, Unsupported:
		s.Kind
	}
	Shape{Id: s.Id, Kind: k, Traits: strippedTraits(s.Traits, drop), Keys: s.Keys}
}

func strippedMembers(ms []Member, drop []string) []Member {
	let mut out = []Member{}
	for m in ms {
		out = out.Append(strippedMember(m, drop))
	}
	out
}

func strippedMember(m Member, drop []string) Member {
	Member{Name: m.Name, Target: m.Target, Traits: strippedTraits(m.Traits, drop)}
}

func strippedTraits(ts []Trait, drop []string) []Trait {
	let mut out = []Trait{}
	for t in ts {
		if !has(drop, traitId(t)) {
			out = out.Append(t)
		}
	}
	out
}

func traitId(t Trait) string {
	match t {
	case Known as k:
		k.Id
	case Refused as r:
		r.Id
	}
}

// Provenance is where a slice came from: the source's address (with its
// commit or tag), the sha256 of the source text, the operations kept, the
// trait ids dropped, and a note (where to fetch what was dropped, if a law
// needs it). WithProvenance writes it into the slice's metadata, under
// "clientgen.provenance", so the slice carries it.
type Provenance { Source string, Sha256 string, Kept []string, Dropped []string, Note string }

func WithProvenance(m Model, p Provenance) Model {
	let entry = json.Member{Key: "clientgen.provenance", Value: jobj([]json.Member{
		json.Member{Key: "source", Value: jstr(p.Source)},
		json.Member{Key: "sha256", Value: jstr(p.Sha256)},
		json.Member{Key: "kept", Value: strs(p.Kept)},
		json.Member{Key: "dropped", Value: strs(p.Dropped)},
		json.Member{Key: "note", Value: jstr(p.Note)},
	})}
	let mut ms = []json.Member{}
	match m.Metadata {
	case json.Object as o:
		for x in o.Members {
			if x.Key != "clientgen.provenance" {
				ms = ms.Append(x)
			}
		}
	case json.Null, json.Boolean, json.Num, json.Str, json.Array:
	}
	Model{Version: m.Version, Metadata: jobj(ms.Append(entry)), Shapes: m.Shapes}
}

func strs(xs []string) json.Value {
	let mut items = []json.Value{}
	for x in xs {
		items = items.Append(jstr(x))
	}
	let v json.Value = json.Array{Items: items}
	v
}

// pruned is Prune with no trait dropped.
func pruned(m Model, keep []string) Model fails Unknown {
	let index = indexOf(m)
	for k in keep {
		match index.Get(k) {
		case Some[int] as i:
			match m.Shapes[i.Value].Kind {
			case Operation:
			case Simple, Enum, IntEnum, List, Mapping, Structure, Union, Service, Resource, Unsupported:
				return Unknown{Id: k}
			}
		case None:
			return Unknown{Id: k}
		}
	}
	// The services that reach a kept operation, with the kept operations
	// each reaches; their errors join the roots.
	let mut roots = keep
	let mut services = Map[string, []string]{}
	for s in m.Shapes {
		match s.Kind {
		case Service as v:
			let ops = opsUnder(m, index, v.Operations, v.Resources)
			let mut kept = []string{}
			for op in ops {
				if has(keep, op) {
					kept = kept.Append(op)
				}
			}
			if len(kept) > 0 {
				services[s.Id] = kept
				roots = roots.Concat(v.Errors)
			}
		case Simple, Enum, IntEnum, List, Mapping, Structure, Union, Operation, Resource, Unsupported:
		}
	}
	let reached = reach(m, index, roots)
	let mut out = []Shape{}
	for s in m.Shapes {
		match s.Kind {
		case Service as v:
			match services.Get(s.Id) {
			case Some[[]string] as kept:
				out = out.Append(Shape{Id: s.Id, Kind: Service{Version: v.Version, Operations: kept.Value, Resources: []string{}, Errors: v.Errors, Rename: v.Rename}, Traits: s.Traits, Keys: s.Keys})
			case None:
			}
		case Simple, Enum, IntEnum, List, Mapping, Structure, Union, Operation, Resource, Unsupported:
			if isIn(reached, s.Id) {
				out = out.Append(s)
			}
		}
	}
	Model{Version: m.Version, Metadata: m.Metadata, Shapes: out}
}

// indexOf is each shape id's place in m.Shapes.
func indexOf(m Model) Map[string, int] {
	let mut index = Map[string, int]{}
	for i, s in m.Shapes {
		index[s.Id] = i
	}
	index
}

// opsUnder is every operation a service or resource lists, directly or
// through its resources (lifecycle, operations and collection operations).
func opsUnder(m Model, index Map[string, int], ops []string, resources []string) []string {
	let mut out = ops
	let mut seen = Map[string, bool]{}
	let mut work = resources
	for len(work) > 0 {
		let r = work[len(work)-1]
		work = work[:len(work)-1]
		if isIn(seen, r) {
			continue
		}
		seen[r] = true
		match index.Get(r) {
		case Some[int] as i:
			match m.Shapes[i.Value].Kind {
			case Resource as v:
				for l in v.Lifecycle {
					out = out.Append(l.Target)
				}
				out = out.Concat(v.Operations).Concat(v.CollectionOperations)
				work = work.Concat(v.Resources)
			case Simple, Enum, IntEnum, List, Mapping, Structure, Union, Operation, Service, Unsupported:
			}
		case None:
		}
	}
	out
}

// reach is the set of ids reachable from roots through the references of
// shapes (refsOf). Ids the model does not declare (Smithy's prelude,
// `smithy.api#String`) are reached but hold nothing.
func reach(m Model, index Map[string, int], roots []string) Map[string, bool] {
	let mut seen = Map[string, bool]{}
	let mut work = roots
	for len(work) > 0 {
		let id = work[len(work)-1]
		work = work[:len(work)-1]
		if isIn(seen, id) {
			continue
		}
		seen[id] = true
		match index.Get(id) {
		case Some[int] as i:
			work = work.Concat(refsOf(m.Shapes[i.Value].Kind))
		case None:
		}
	}
	seen
}

// refsOf is every shape id a kind names, except a service's or
// resource's (Prune trims those).
func refsOf(k Kind) []string {
	match k {
	case Operation as o:
		let mut out = o.Errors
		match o.Input {
		case Some[string] as t:
			out = out.Append(t.Value)
		case None:
		}
		match o.Output {
		case Some[string] as t:
			out = out.Append(t.Value)
		case None:
		}
		out
	case Simple, Enum, IntEnum, List, Mapping, Structure, Union, Service, Resource, Unsupported:
		let mut out = []string{}
		for mem in membersOf(k) {
			out = out.Append(mem.Target)
		}
		out
	}
}

// closure is the shapes of m reachable from id, in m's order: the law's
// reference, a fixed point over named (each kind's references spelled out
// by hand), sharing nothing with Prune's reach, refsOf or membersOf.
func closure(m Model, id string) []Shape {
	let mut reached = Map[string, bool]{}
	reached[id] = true
	let mut changed = true
	for changed {
		changed = false
		for s in m.Shapes {
			if isIn(reached, s.Id) {
				for t in named(s.Kind) {
					if !isIn(reached, t) {
						reached[t] = true
						changed = true
					}
				}
			}
		}
	}
	let mut out = []Shape{}
	for s in m.Shapes {
		if isIn(reached, s.Id) {
			out = out.Append(s)
		}
	}
	out
}

// named is every shape id k names, by the Smithy JSON AST's rules: an
// operation's input, output and errors; the members of an aggregate; a
// list's member; a map's key and value. A service's and resource's names
// are left out, as Prune trims them.
func named(k Kind) []string {
	match k {
	case Operation as o:
		let mut out = []string{}
		match o.Input {
		case Some[string] as t:
			out = out.Append(t.Value)
		case None:
		}
		match o.Output {
		case Some[string] as t:
			out = out.Append(t.Value)
		case None:
		}
		out.Concat(o.Errors)
	case Structure as s:
		targetsOf(s.Members)
	case Union as u:
		targetsOf(u.Members)
	case Enum as e:
		targetsOf(e.Members)
	case IntEnum as e:
		targetsOf(e.Members)
	case List as l:
		[]string{l.Member.Target}
	case Mapping as mm:
		[]string{mm.Key.Target, mm.Value.Target}
	case Simple, Service, Resource, Unsupported:
		[]string{}
	}
}

func targetsOf(ms []Member) []string {
	let mut out = []string{}
	for m in ms {
		out = out.Append(m.Target)
	}
	out
}

// PruneKeepsClosure: on a drawn model (references in every position: an
// operation's input, output and errors, structure and union members, list
// and map members, a service over every operation), each kept operation
// reaches the same shapes, traits and all, in the pruned model as in the
// whole one, and the pruned model holds no shape outside those closures
// and the trimmed service's errors.
law PruneKeepsClosure(kinds []int, refs []int, keepBits []int, dropDocs bool, dropUnread bool) {
	let m = drawnModel(kinds, refs, true)
	let mut drop = []string{}
	if dropDocs {
		drop = drop.Append("smithy.api#documentation")
	}
	if dropUnread {
		drop = drop.Append("x.test#unread")
	}
	let mut keep = []string{}
	let mut k = 0
	for s in m.Shapes {
		match s.Kind {
		case Operation:
			if k < len(keepBits) && keepBits[k]%2 != 0 {
				keep = keep.Append(s.Id)
			}
			k = k + 1
		case Simple, Enum, IntEnum, List, Mapping, Structure, Union, Service, Resource, Unsupported:
		}
	}
	let p = Prune(m, keep, drop) catch {
	case Unknown:
		return false
	}
	let mut allowed = Map[string, bool]{}
	for op in keep {
		let mut want = []Shape{}
		for s in closure(m, op) {
			want = want.Append(stripped(s, drop))
			allowed[s.Id] = true
		}
		if closure(p, op) != want {
			return false
		}
	}
	if len(keep) > 0 {
		allowed["t#E0"] = true
	}
	for s in p.Shapes {
		for t in s.Traits {
			if has(drop, traitId(t)) {
				return false
			}
		}
		for mem in membersOf(s.Kind) {
			for t in mem.Traits {
				if has(drop, traitId(t)) {
					return false
				}
			}
		}
	}
	let back = Read(Write(p)) catch {
	case _:
		return false
	}
	if back != p {
		return false
	}
	for s in p.Shapes {
		match s.Kind {
		case Service as v:
			if len(keep) == 0 || v.Operations != keep {
				return false
			}
		case Simple, Enum, IntEnum, List, Mapping, Structure, Union, Operation, Resource, Unsupported:
			if !isIn(allowed, s.Id) {
				return false
			}
		}
	}
	true
}

// drawnModel is a model of at most 12 shapes `t#S<i>` (string, structure,
// list, map, union or operation by kinds[i]) whose references are drawn
// from refs, an error shape `t#E0` and a service `t#Svc` over every
// operation with that error. With noisy, shapes also carry a known and a
// refused trait and an unread key.
func drawnModel(kinds []int, refs []int, noisy bool) Model {
	let n = if len(kinds) > 12 { 12 } else { len(kinds) }
	let mut shapes = []Shape{}
	let mut ops = []string{}
	for i in 0..n {
		let id = "t#S\(i)"
		let mt = if noisy { []Trait{Known{Id: "smithy.api#documentation", Value: jstr("member of \(i)")}, Refused{Id: "x.test#unread", Value: jstr("m"), Why: "a trait the reader does not read yet"}} } else { []Trait{} }
		let c = ((kinds[i] % 6) + 6) % 6
		let mut kind Kind = Simple{Of: StringType}
		if c == 1 {
			kind = Structure{Members: []Member{Member{Name: "a", Target: refAt(refs, i*3+0, n), Traits: mt}, Member{Name: "b", Target: refAt(refs, i*3+1, n), Traits: mt}}}
		} else if c == 2 {
			kind = List{Member: Member{Name: "member", Target: refAt(refs, i*3+0, n), Traits: mt}}
		} else if c == 3 {
			kind = Mapping{Key: Member{Name: "key", Target: "smithy.api#String", Traits: mt}, Value: Member{Name: "value", Target: refAt(refs, i*3+0, n), Traits: mt}}
		} else if c == 4 {
			kind = Union{Members: []Member{Member{Name: "x", Target: refAt(refs, i*3+0, n), Traits: mt}}}
		} else if c == 5 {
			kind = Operation{Input: Some[string]{Value: refAt(refs, i*3+0, n)}, Output: Some[string]{Value: refAt(refs, i*3+1, n)}, Errors: []string{refAt(refs, i*3+2, n)}}
			ops = ops.Append(id)
		}
		let mut traits = []Trait{}
		let mut keys = []Unread{}
		if noisy {
			traits = []Trait{Known{Id: "smithy.api#documentation", Value: jstr("doc \(i)")}, Refused{Id: "x.test#unread", Value: jstr("v"), Why: "a trait the reader does not read yet"}}
			keys = []Unread{Unread{Key: "mixins", Value: targets([]string{"t#S0"})}}
		}
		shapes = shapes.Append(Shape{Id: id, Kind: kind, Traits: traits, Keys: keys})
	}
	shapes = shapes.Append(Shape{Id: "t#E0", Kind: Structure{Members: []Member{}}, Traits: []Trait{Known{Id: "smithy.api#error", Value: jstr("client")}}, Keys: []Unread{}})
	shapes = shapes.Append(Shape{Id: "t#Svc", Kind: Service{Version: "1", Operations: ops, Resources: []string{}, Errors: []string{"t#E0"}, Rename: jobj([]json.Member{})}, Traits: []Trait{}, Keys: []Unread{}})
	Model{Version: "2.0", Metadata: jobj([]json.Member{}), Shapes: shapes}
}

// isIn is whether m holds k.
func isIn(m Map[string, bool], k string) bool {
	match m.Get(k) {
	case Some[bool]:
		true
	case None:
		false
	}
}

// refAt is the k-th drawn reference: the shape t#S<r mod n> for refs' k-th
// entry (cycled), or t#S0 when nothing is drawn.
func refAt(refs []int, k int, n int) string {
	let r = if len(refs) == 0 { 0 } else { refs[k%len(refs)] }
	"t#S\(((r % n) + n) % n)"
}
