// Writing a plan's text. Every std and runtime name is written qualified
// through its import (owner q298, design A), from the names below.

import github.com/cevr/ergo/modules/clientgen/smithy
import json
import strconv
import strings

let optionName = "option.Option"
let someName = "option.Some"
let noneName = "option.None"

// Emit is the client package p names, for the operations it keeps in m:
// one file, or the first refusal.
func Emit(m smithy.Model, p Provider) []File fails Refused {
	let plan = try PlanOf(m, p)
	for op in plan.Ops {
		for f in op.Out {
			match f.Where {
			case AtPayload:
			case AtLabel, AtQuery, AtHeader, AtPrefix, AtBody:
				if f.Required {
					return Refused{Operation: op.Name, Reason: "a required output member \(f.Name): the emitter writes output members as optional"}
				}
			}
		}
	}
	let mut b = []string{}
	b = b.Append("// Code generated by clientgen emit; DO NOT EDIT.")
	b = b.Append("// Model " + provenance(m) + ".")
	b = b.Append("")
	b = b.Concat(comment("Package \(p.Package) is a client of \(p.Service): \(plan.Doc)", ""))
	b = b.Append("")
	b = b.Append("import " + p.Runtime)
	b = b.Append("import http")
	if usesOption(plan, p.RuntimeName) {
		b = b.Append("import option")
	}
	if usesTime(plan) {
		b = b.Append("import time")
	}
	b = b.Append("")
	b = b.Concat(service(plan, p))
	b = b.Concat(api(plan, p))
	for op in plan.Ops {
		b = b.Concat(records(op, p))
	}
	for f in plan.Failures {
		b = b.Concat(failure(f, p.RuntimeName))
	}
	for e in plan.Enums {
		b = b.Concat(enum(e, enumEncoded(plan, e.Name), enumDecoded(plan, e.Name)))
	}
	[]File{File{Path: p.Package + ".ergo", Text: strings.Join(b, "\n")}}
}

func usesOption(plan Plan, rt string) bool {
	for op in plan.Ops {
		for f in op.In {
			if strings.HasPrefix(ty(f, rt), optionName+"[") {
				return true
			}
		}
		for f in kept(op.Out) {
			if strings.HasPrefix(ty(f, rt), optionName+"[") {
				return true
			}
		}
	}
	for f in plan.Failures {
		if f.Fields.Len() > 0 {
			return true
		}
	}
	false
}

func usesTime(plan Plan) bool {
	for op in plan.Ops {
		for f in op.In {
			match f.Ty {
			case TTime:
				return true
			case TString, TInt, TBool, TEnum, TMap, TBlob:
			}
		}
		for f in kept(op.Out) {
			match f.Ty {
			case TTime:
				return true
			case TString, TInt, TBool, TEnum, TMap, TBlob:
			}
		}
	}
	for fail in plan.Failures {
		for f in fail.Fields {
			match f.Ty {
			case TTime:
				return true
			case TString, TInt, TBool, TEnum, TMap, TBlob:
			}
		}
	}
	false
}

func enumEncoded(plan Plan, name string) bool {
	for op in plan.Ops {
		for f in op.In {
			match f.Where {
			case AtQuery, AtHeader:
				match f.Ty {
				case TEnum{en}:
					if en == name {
						return true
					}
				case TString, TInt, TBool, TTime, TMap, TBlob:
				}
			case AtLabel, AtPrefix, AtPayload, AtBody:
			}
		}
	}
	false
}

func enumDecoded(plan Plan, name string) bool {
	for op in plan.Ops {
		for f in kept(op.Out) {
			match f.Where {
			case AtHeader:
				match f.Ty {
				case TEnum{en}:
					if en == name {
						return true
					}
				case TString, TInt, TBool, TTime, TMap, TBlob:
				}
			case AtLabel, AtQuery, AtPrefix, AtPayload, AtBody:
			}
		}
	}
	for fail in plan.Failures {
		for f in fail.Fields {
			match f.Ty {
			case TEnum{en}:
				if en == name {
					return true
				}
			case TString, TInt, TBool, TTime, TMap, TBlob:
			}
		}
	}
	false
}

func provenance(m smithy.Model) string {
	let p = member(m.Metadata, "clientgen.provenance")
	"\(textOf(member(p, "source"))) sha256 \(textOf(member(p, "sha256")))"
}

// comment is text as // lines of at most 76 columns after indent.
func comment(text string, indent string) []string {
	let mut out = []string{}
	let mut line = ""
	for w in strings.Fields(text) {
		if line.Len() > 0 && line.Len()+1+w.Len() > 74 {
			out = out.Append(indent + "// " + line)
			line = w
		} else if line.Len() == 0 {
			line = w
		} else {
			line = line + " " + w
		}
	}
	if line.Len() > 0 {
		out = out.Append(indent + "// " + line)
	}
	out
}

func lowerFirst(s string) string {
	if s.Len() == 0 { s } else { strings.ToLower(strings.Slice(s, 0, 1)) + strings.Slice(s, 1, s.Len()) }
}

func quote(s string) string { strconv.Quote(s) }

// ty is f's Ergo type: Option of the scalar unless the member is
// required, a label, a payload or a map.
func ty(f Field, rt string) string {
	let base = scalar(f.Ty)
	match f.Ty {
	case TMap, TBlob:
		return base
	case TString, TInt, TBool, TTime, TEnum:
	}
	match f.Where {
	case AtLabel, AtPayload:
		base
	case AtQuery, AtHeader, AtPrefix, AtBody:
		if f.Required { base } else { optionName + "[" + base + "]" }
	}
}

func scalar(t Ty) string {
	match t {
	case TString:
		"string"
	case TInt:
		"int"
	case TBool:
		"bool"
	case TTime:
		"time.Time"
	case TEnum{name}:
		name
	case TMap:
		"Map[string, string]"
	case TBlob:
		"string"
	}
}

// streamed is whether op's output has a streaming payload, read to a sink.
func streamed(op Op) bool {
	for f in op.Out {
		match f.Where {
		case AtPayload:
			return true
		case AtLabel, AtQuery, AtHeader, AtPrefix, AtBody:
		}
	}
	false
}

func row(op Op, p Provider) string {
	let mut parts = []string{}
	for e in op.Errors {
		parts = parts.Append(local(e))
	}
	parts = parts.Append(p.RuntimeName + ".Failed").Append(p.RuntimeName + ".Malformed").Append("http.RequestFailed")
	if streamed(op) {
		parts = parts.Append("http.SinkFailed")
	}
	strings.Join(parts, " | ")
}

let sinkParam = "put func(part string) fails http.SinkFailed"

func signature(op Op, p Provider) string {
	let sink = if streamed(op) { ", " + sinkParam } else { "" }
	"\(op.Name)(r \(op.Input)\(sink)) \(op.Output) fails \(row(op, p))"
}

// lawParams are the required input members a law draws (labels and
// required scalars), as Ergo parameters and as New's arguments.
func required(op Op) []Field {
	let mut out = []Field{}
	for f in op.In {
		match f.Where {
		case AtLabel:
			out = out.Append(f)
		case AtQuery, AtHeader, AtPrefix, AtPayload, AtBody:
			if f.Required {
				out = out.Append(f)
			}
		}
	}
	out
}

func service(plan Plan, p Provider) []string {
	let rt = p.RuntimeName
	let mut b = comment("\(p.Service) is the service's operations. Api sends them over an http.Net; a memory provider (another package) answers them for tests. The laws come from each operation's HTTP method: a GET or HEAD is repeatable, a PUT or DELETE idempotent (RFC 9110 9.2).", "")
	b = b.Append("type \(p.Service) {")
	for op in plan.Ops {
		b = b.Concat(comment(op.Doc, "\t"))
		b = b.Append("\t" + signature(op, p) + ",")
	}
	for op in plan.Ops {
		b = b.Concat(lawOf(op, rt))
	}
	b.Append("}").Append("")
}

func lawOf(op Op, rt string) []string {
	let name = if op.Method == "GET" || op.Method == "HEAD" { op.Name + "IsRepeatable" } else if op.Method == "PUT" || op.Method == "DELETE" { op.Name + "IsIdempotent" } else { "" }
	if name == "" {
		return []string{}
	}
	let mut params = []string{}
	let mut args = []string{}
	for f in required(op) {
		params = params.Append(lowerFirst(f.Name) + " " + scalar(f.Ty))
		args = args.Append(lowerFirst(f.Name))
	}
	let sink = if streamed(op) { ", func(part string) {}" } else { "" }
	let call = "\(op.Name)(r\(sink))"
	let what = if op.Method == "GET" || op.Method == "HEAD" { "two calls give one outcome" } else { "a second call gives the first call's outcome" }
	[]string{
		"",
		"\t// \(name): \(what): the same output, or the same failure.",
		"\tlaw \(name)(\(strings.Join(params, ", "))) {",
		"\t\tlet r = New\(op.Input)(\(strings.Join(args, ", ")))",
		"\t\t\(rt).SameOutcome(func() \(op.Output) { try \(call) }, func(a, b) { a == b }, func(a, b) { a == b })",
		"\t},",
	}
}

func api(plan Plan, p Provider) []string {
	let rt = p.RuntimeName
	let mut b = comment("Api is \(p.Service) over net: each request is built with no credential. A static key is the net's (an http.Credential), and a signature computed from the request is the signer's, added just before the request is sent.", "")
	b = b.Append("type Api { net http.Net, signer \(rt).Signer } implements \(p.Service)").Append("")
	b = b.Append("// New is the client that sends over net and signs with signer.")
	b = b.Append("func New(net http.Net, signer \(rt).Signer) Api { Api{net: net, signer: signer} }").Append("")
	for op in plan.Ops {
		b = b.Concat(call(op, p))
	}
	b
}

func call(op Op, p Provider) []string {
	let rt = p.RuntimeName
	let low = lowerFirst(op.Name)
	let sink = if streamed(op) { ", " + sinkParam } else { "" }
	let mut b = comment("\(op.Name) sends r: \(op.Method) \(pathText(op)).", "")
	b = b.Append("func \(op.Name)(a Api, r \(op.Input)\(sink)) \(op.Output) fails \(row(op, p)) {")
	b = b.Append("\tlet mut q = []http.Field{}")
	for l in op.Query {
		b = b.Append("\tq = q.Append(http.Field{Name: \(quote(l.Name)), Value: \(quote(l.Value))})")
	}
	b = b.Append("\tlet mut h = []http.Field{}")
	let mut body = quote("")
	for f in op.In {
		match f.Where {
		case AtQuery{name}:
			b = b.Append(put("q", name, f, false, rt))
		case AtHeader{name}:
			b = b.Append(put("h", name, f, true, rt))
		case AtPrefix{prefix}:
			b = b.Append("\th = \(rt).PutPrefixed(h, \(quote(prefix)), r.\(f.Name))")
		case AtPayload:
			body = "r." + f.Name
		case AtLabel, AtBody:
		}
	}
	let (path, raw) = paths(op, rt)
	b = b.Append("\tlet req = http.Request{Method: \(quote(op.Method)), Path: \(path), RawPath: \(raw), Query: q, Header: h, Body: http.Buffered{Text: \(body)}}")
	if streamed(op) {
		b = b.Concat([]string{
			"\tlet resp = a.net.SendInto(a.signer.Sign(req), http.AnySuccess, put) catch {",
			"\tcase http.StatusRefused as s:",
			"\t\treturn try \(low)Failed(s.Status, s.Prefix)",
			"\tcase http.RequestFailed as e:",
			"\t\treturn e",
			"\tcase http.SinkFailed as e:",
			"\t\treturn e",
			"\t}",
		})
	} else {
		b = b.Concat([]string{
			"\tlet resp = try a.net.Send(a.signer.Sign(req))",
			"\tif resp.Status < 200 || resp.Status > 299 {",
			"\t\treturn try \(low)Failed(resp.Status, resp.Body)",
			"\t}",
		})
	}
	b = b.Append("\ttry \(low)Output(resp.Header)").Append("}").Append("")
	b.Concat(output(op, p)).Concat(failed(op, p))
}

func pathText(op Op) string {
	let mut s = ""
	for seg in op.Path {
		match seg {
		case SegText{t}:
			s = s + t
		case SegLabel as l:
			s = s + "{" + l.Member + (if l.Greedy { "+" } else { "" }) + "}"
		}
	}
	s
}

// paths are the expressions of the request's decoded and escaped paths.
func paths(op Op, rt string) (string, string) {
	let mut path = []string{}
	let mut raw = []string{}
	for seg in op.Path {
		match seg {
		case SegText{t}:
			path = path.Append(quote(t))
			raw = raw.Append(quote(t))
		case SegLabel as l:
			path = path.Append("r." + l.Member)
			raw = raw.Append("\(rt).Label(r.\(l.Member), \(l.Greedy))")
		}
	}
	(strings.Join(path, " + "), strings.Join(raw, " + "))
}

// put is the statement that adds f to list (q or h) when it is set.
func put(list string, name string, f Field, header bool, rt string) string {
	if f.Required {
		return "\t\(list) = \(list).Append(http.Field{Name: \(quote(name)), Value: \(text(f.Ty, "r."+f.Name, header, rt))})"
	}
	let v = "r." + f.Name
	let k = quote(name)
	match f.Ty {
	case TString:
		"\t\(list) = \(rt).PutText(\(list), \(k), \(v))"
	case TInt:
		"\t\(list) = \(rt).PutInt(\(list), \(k), \(v))"
	case TBool:
		"\t\(list) = \(rt).PutBool(\(list), \(k), \(v))"
	case TTime{fmt}:
		"\t\(list) = \(rt).PutTime(\(list), \(k), \(v), \(format(fmt, header, rt)))"
	case TEnum{en}:
		"\t\(list) = \(rt).PutBy(\(list), \(k), \(v), \(lowerFirst(en))Wire)"
	case TBlob, TMap:
		"\t\(list) = \(list).Append(http.Field{Name: \(k), Value: \(v)})"
	}
}

func format(f string, header bool, rt string) string {
	if f == "http-date" {
		return rt + ".HTTPDate"
	}
	if f == "date-time" {
		return rt + ".DateTime"
	}
	if f == "epoch-seconds" {
		return rt + ".EpochSeconds"
	}
	if header { rt + ".HTTPDate" } else { rt + ".DateTime" }
}

// text is the wire text of x, of type t.
func text(t Ty, x string, header bool, rt string) string {
	match t {
	case TString, TBlob:
		x
	case TInt:
		"\(rt).IntText(\(x))"
	case TBool:
		"\(rt).BoolText(\(x))"
	case TTime{fmt}:
		"\(rt).TimeText(\(x), \(format(fmt, header, rt)))"
	case TEnum{name}:
		"\(lowerFirst(name))Wire(\(x))"
	case TMap:
		x
	}
}

// read is the expression that reads output member f from the headers h.
func read(f Field, rt string) string {
	match f.Where {
	case AtHeader{name}:
		match f.Ty {
		case TString, TBlob, TMap:
			"\(rt).TextIn(h, \(quote(name)))"
		case TInt:
			"try \(rt).IntIn(h, \(quote(name)))"
		case TBool:
			"try \(rt).BoolIn(h, \(quote(name)))"
		case TTime{fmt}:
			"try \(rt).TimeIn(h, \(quote(name)), \(format(fmt, true, rt)))"
		case TEnum{en}:
			"\(rt).TextIn(h, \(quote(name))).Map(\(lowerFirst(en))Of)"
		}
	case AtPrefix{prefix}:
		"\(rt).Prefixed(h, \(quote(prefix)))"
	case AtLabel, AtQuery, AtPayload, AtBody:
		noneName
	}
}

// kept is the output members the output record holds: all but a payload
// read to the sink.
func kept(fs []Field) []Field {
	let mut out = []Field{}
	for f in fs {
		match f.Where {
		case AtPayload:
		case AtLabel, AtQuery, AtHeader, AtPrefix, AtBody:
			out = out.Append(f)
		}
	}
	out
}

func output(op Op, p Provider) []string {
	let rt = p.RuntimeName
	let mut keys = []string{}
	let mut values = []string{}
	for f in kept(op.Out) {
		keys = keys.Append(f.Name)
		values = values.Append(read(f, rt))
	}
	let mut b = []string{"func \(lowerFirst(op.Name))Output(h []http.Field) \(op.Output) fails \(rt).Malformed {"}
	b = b.Concat(literal(op.Output, keys, values, "\t"))
	b.Append("}").Append("")
}

// literal is a keyed record literal, one field a line, its values aligned
// as ergo fmt aligns them.
func literal(name string, keys []string, values []string, indent string) []string {
	if keys.Len() == 0 {
		return []string{indent + name + "{}"}
	}
	let mut b = []string{indent + name + "{"}
	b = b.Concat(aligned(keys, values, indent+"\t", ":", ","))
	b.Append(indent + "}")
}

// aligned is key+sep and value lines, the values in one column.
func aligned(keys []string, values []string, indent string, sep string, end string) []string {
	let mut width = 0
	for k in keys {
		if k.Len() > width {
			width = k.Len()
		}
	}
	let mut out = []string{}
	for i, k in keys {
		out = out.Append(indent + k + sep + strings.Repeat(" ", width-k.Len()+1) + values[i] + end)
	}
	out
}

func failed(op Op, p Provider) []string {
	let rt = p.RuntimeName
	let mut row = []string{}
	for e in op.Errors {
		row = row.Append(local(e))
	}
	row = row.Append(rt + ".Failed").Append(rt + ".Malformed")
	let mut b = []string{"func \(lowerFirst(op.Name))Failed(status int, body string) \(op.Output) fails \(strings.Join(row, " | ")) {", "\tlet e = try \(rt).ErrorOf(status, body)"}
	let fallback = "\(rt).Failed{Status: e.Status, Code: e.Code, Message: e.Message}"
	if op.Errors.Len() == 0 {
		return b.Append("\t" + fallback).Append("}").Append("")
	}
	b = b.Append("\tmatch e.Code {")
	for e in op.Errors {
		let n = local(e)
		b = b.Append("\tcase \(quote(n)):").Append("\t\treturn \(lowerFirst(n))(e)")
	}
	b.Append("\tcase _:").Append("\t\t" + fallback).Append("\t}").Append("}").Append("")
}

func records(op Op, p Provider) []string {
	let rt = p.RuntimeName
	let mut b = comment("\(op.Input) is what \(op.Name) sends. New\(op.Input) makes one with every optional member None.", "")
	b = b.Concat(record(op.Input, op.In, rt))
	let req = required(op)
	let mut params = []string{}
	for f in req {
		params = params.Append(lowerFirst(f.Name) + " " + scalar(f.Ty))
	}
	b = b.Append("func New\(op.Input)(\(strings.Join(params, ", "))) \(op.Input) {")
	let mut keys = []string{}
	let mut values = []string{}
	for f in op.In {
		keys = keys.Append(f.Name)
		values = values.Append(initial(f, req))
	}
	b = b.Concat(literal(op.Input, keys, values, "\t")).Append("}").Append("")
	b = b.Concat(comment("\(op.Output) is what \(op.Name) reads from the answer's headers"+(if streamed(op) { "; its body goes to the call's sink." } else { "." })+" New\(op.Output) makes one with every member None, for a provider of \(p.Service).", ""))
	let keptOut = kept(op.Out)
	b = b.Concat(record(op.Output, keptOut, rt))
	if keptOut.Len() == 0 {
		return b.Append("func New\(op.Output)() \(op.Output) { \(op.Output){} }").Append("")
	}
	let mut outKeys = []string{}
	let mut outValues = []string{}
	for f in keptOut {
		outKeys = outKeys.Append(f.Name)
		outValues = outValues.Append(initial(f, []Field{}))
	}
	b.Append("func New\(op.Output)() \(op.Output) {").Concat(literal(op.Output, outKeys, outValues, "\t")).Append("}").Append("")
}

func initial(f Field, req []Field) string {
	for r in req {
		if r.Name == f.Name {
			return lowerFirst(f.Name)
		}
	}
	match f.Ty {
	case TMap:
		"Map[string, string]{}"
	case TBlob:
		quote("")
	case TString, TInt, TBool, TTime, TEnum:
		noneName
	}
}

func record(name string, fs []Field, rt string) []string {
	if fs.Len() == 0 {
		return []string{"type \(name) {}", ""}
	}
	let mut keys = []string{}
	let mut values = []string{}
	for f in fs {
		keys = keys.Append(f.Name)
		values = values.Append(ty(f, rt))
	}
	[]string{"type \(name) {"}.Concat(aligned(keys, values, "\t", "", ",")).Append("}").Append("")
}

func failure(f Failure, rt string) []string {
	let mut b = comment(f.Name+" is the service's error "+quote(f.Name)+(if f.Doc == "" { "." } else { ": " + f.Doc }), "")
	let low = lowerFirst(f.Name)
	if f.Fields.Len() == 0 {
		b = b.Append("type \(f.Name) { Status int, Message string }").Append("")
		return b.Append("func \(low)(e \(rt).ErrorBody) \(f.Name) { \(f.Name){Status: e.Status, Message: e.Message} }").Append("")
	}
	let mut keys = []string{"Status", "Message"}
	let mut values = []string{"int", "string"}
	for x in f.Fields {
		keys = keys.Append(x.Name)
		values = values.Append(optionName + "[" + scalar(x.Ty) + "]")
	}
	b = b.Append("type \(f.Name) {").Concat(aligned(keys, values, "\t", "", ",")).Append("}").Append("")
	// Its reader, from the error body's fields.
	let mut vs = []string{"e.Status", "e.Message"}
	for x in f.Fields {
		match x.Ty {
		case TEnum{en}:
			vs = vs.Append("e.Fields.Get(\(quote(x.Name))).Map(\(lowerFirst(en))Of)")
		case TString, TInt, TBool, TTime, TMap, TBlob:
			vs = vs.Append("e.Fields.Get(\(quote(x.Name)))")
		}
	}
	b = b.Append("func \(low)(e \(rt).ErrorBody) \(f.Name) {")
	b = b.Concat(literal(f.Name, keys, vs, "\t"))
	b.Append("}").Append("")
}

func enum(e Enum, wire bool, of bool) []string {
	let low = lowerFirst(e.Name)
	let mut variants = []string{}
	for v in e.Values {
		variants = variants.Append(v.Variant + "{}")
	}
	let other = e.Name + "Other"
	variants = variants.Append("\(other){Value string}")
	let mut b = comment(e.Name+(if e.Doc == "" { " is a value the service names." } else { ": " + e.Doc })+" \(other) holds a value this model does not name.", "")
	b = b.Append("type \(e.Name) = \(strings.Join(variants, " | "))").Append("")
	if wire {
		b = b.Append("func \(low)Wire(v \(e.Name)) string {").Append("\tmatch v {")
		for v in e.Values {
			b = b.Append("\tcase \(v.Variant):").Append("\t\t\(quote(v.Wire))")
		}
		b = b.Append("\tcase \(other){o}:").Append("\t\to").Append("\t}").Append("}").Append("")
	}
	if of {
		b = b.Append("func \(low)Of(s string) \(e.Name) {").Append("\tmatch s {")
		for v in e.Values {
			b = b.Append("\tcase \(quote(v.Wire)):").Append("\t\t\(v.Variant)")
		}
		b = b.Append("\tcase _:").Append("\t\t\(other){Value: s}").Append("\t}").Append("}").Append("")
	}
	b
}

let drawnProvider = Provider{Package: "t", Runtime: "rt", RuntimeName: "rt", Service: "T", Operations: []string{"t#Op"}}

// EmitIsDeterministic: a drawn model emits the same files twice.
law EmitIsDeterministic(ins []int, outs []int) {
	let m = drawnModel(ins, outs)
	let first = Emit(m, drawnProvider) catch {
	case Refused as r:
		let again = Emit(m, drawnProvider) catch {
		case Refused as r2:
			return r2 == r
		}
		return again.Len() < 0
	}
	try Emit(m, drawnProvider) == first
}

// ListObjectsIsRefused: an operation whose output is read from an XML
// body (S3's ListObjectsV2: Contents, CommonPrefixes) is refused by its id
// and nothing is written, until the XML wire rules (G4).
test ListObjectsIsRefused {
	let m = drawnModel([]int{0}, []int{})
	let mut shapes = []smithy.Shape{}
	for x in m.Shapes {
		if x.Id == "t#Op" {
			shapes = shapes.Append(smithy.Shape{..x, Id: "com.amazonaws.s3#ListObjectsV2"})
		} else if x.Id == "t#Out" {
			shapes = shapes.Append(smithy.Shape{..x, Kind: smithy.Structure{Members: []smithy.Member{smithy.Member{Name: "Contents", Target: "smithy.api#String", Traits: []smithy.Trait{}}}}})
		} else {
			shapes = shapes.Append(x)
		}
	}
	let p = Provider{..drawnProvider, Operations: []string{"com.amazonaws.s3#ListObjectsV2"}}
	let files = Emit(smithy.Model{..m, Shapes: shapes}, p) catch {
	case Refused as r:
		assert r.Operation == "com.amazonaws.s3#ListObjectsV2"
		assert strings.Contains(r.Reason, "Contents is in the XML body")
		return
	}
	assert files.Len() < 0
}

// RequiredIsPlain: a required input member that is not a label (here a
// header) is written as its type, not an Option, and New takes it.
test RequiredIsPlain {
	let m = drawnModel([]int{2}, []int{})
	let mut shapes = []smithy.Shape{}
	for x in m.Shapes {
		if x.Id == "t#In" {
			let mut ms = []smithy.Member{}
			match x.Kind {
			case smithy.Structure as st:
				for mem in st.Members {
					ms = ms.Append(smithy.Member{..mem, Traits: mem.Traits.Append(trait("smithy.api#required", json.Object{Members: []json.Member{}}))})
				}
			case smithy.Simple, smithy.Enum, smithy.IntEnum, smithy.List, smithy.Mapping, smithy.Union, smithy.Operation, smithy.Service, smithy.Resource, smithy.Unsupported:
			}
			shapes = shapes.Append(smithy.Shape{..x, Kind: smithy.Structure{Members: ms}})
		} else {
			shapes = shapes.Append(x)
		}
	}
	let files = try Emit(smithy.Model{..m, Shapes: shapes}, drawnProvider)
	assert strings.Contains(files[0].Text, "type In {\n\tM0 string,\n}")
	assert strings.Contains(files[0].Text, "func NewIn(m0 string) In {")
}

// CleanEmissionShapes: emitted code uses symmetric Put* helpers, SameOutcome
// in laws, inline union enums with match-based Wire/Of only where needed, and
// Option.Map for enum decoding.
test CleanEmissionShapes {
	let unit = smithy.Member{Name: "FAST", Target: "smithy.api#Unit", Traits: []smithy.Trait{trait("smithy.api#enumValue", json.Str{Value: "FAST"})}}
	let tierIn = smithy.Shape{Id: "t#TierIn", Kind: smithy.Enum{Members: []smithy.Member{unit}}, Traits: []smithy.Trait{}, Keys: []smithy.Unread{}}
	let tierOut = smithy.Shape{Id: "t#TierOut", Kind: smithy.Enum{Members: []smithy.Member{unit}}, Traits: []smithy.Trait{}, Keys: []smithy.Unread{}}
	let intShape = smithy.Shape{Id: "smithy.api#Integer", Kind: smithy.Simple{Of: smithy.IntegerType}, Traits: []smithy.Trait{}, Keys: []smithy.Unread{}}
	let boolShape = smithy.Shape{Id: "smithy.api#Boolean", Kind: smithy.Simple{Of: smithy.BooleanType}, Traits: []smithy.Trait{}, Keys: []smithy.Unread{}}
	let timeShape = smithy.Shape{Id: "smithy.api#Timestamp", Kind: smithy.Simple{Of: smithy.TimestampType}, Traits: []smithy.Trait{}, Keys: []smithy.Unread{}}
	let inShape = smithy.Shape{
		Id:     "t#In",
		Traits: []smithy.Trait{},
		Keys:   []smithy.Unread{},
		Kind:   smithy.Structure{Members: []smithy.Member{
			smithy.Member{Name: "S", Target: "smithy.api#String", Traits: []smithy.Trait{trait("smithy.api#httpQuery", json.Str{Value: "s"})}},
			smithy.Member{Name: "N", Target: "smithy.api#Integer", Traits: []smithy.Trait{trait("smithy.api#httpHeader", json.Str{Value: "x-n"})}},
			smithy.Member{Name: "B", Target: "smithy.api#Boolean", Traits: []smithy.Trait{trait("smithy.api#httpHeader", json.Str{Value: "x-b"})}},
			smithy.Member{Name: "T", Target: "smithy.api#Timestamp", Traits: []smithy.Trait{trait("smithy.api#httpHeader", json.Str{Value: "x-t"})}},
			smithy.Member{Name: "Tier", Target: "t#TierIn", Traits: []smithy.Trait{trait("smithy.api#httpHeader", json.Str{Value: "x-tier"})}},
		}},
	}
	let outShape = smithy.Shape{
		Id:     "t#Out",
		Traits: []smithy.Trait{},
		Keys:   []smithy.Unread{},
		Kind:   smithy.Structure{Members: []smithy.Member{
			smithy.Member{Name: "Tier", Target: "t#TierOut", Traits: []smithy.Trait{trait("smithy.api#httpHeader", json.Str{Value: "x-tier-out"})}},
		}},
	}
	let base = drawnModel([]int{}, []int{})
	let mut shapes = []smithy.Shape{intShape, boolShape, timeShape, tierIn, tierOut, inShape, outShape}
	for x in base.Shapes {
		if x.Id != "t#In" && x.Id != "t#Out" {
			shapes = shapes.Append(x)
		}
	}
	let files = try Emit(smithy.Model{..base, Shapes: shapes}, drawnProvider)
	let code = files[0].Text
	assert strings.Contains(code, "\tq = rt.PutText(q, \"s\", r.S)\n")
	assert strings.Contains(code, "\th = rt.PutInt(h, \"x-n\", r.N)\n")
	assert strings.Contains(code, "\th = rt.PutBool(h, \"x-b\", r.B)\n")
	assert strings.Contains(code, "\th = rt.PutTime(h, \"x-t\", r.T, rt.HTTPDate)\n")
	assert strings.Contains(code, "\th = rt.PutBy(h, \"x-tier\", r.Tier, tierInWire)\n")
	assert strings.Contains(code, "rt.TextIn(h, \"x-tier-out\").Map(tierOutOf)")
	assert strings.Contains(code, "\t\trt.SameOutcome(func() Out { try Op(r) }, func(a, b) { a == b }, func(a, b) { a == b })\n")
	assert strings.Contains(code, "type TierIn = TierInFast{} | TierInOther{Value string}\n")
	assert strings.Contains(code, "func tierInWire(v TierIn) string {\n")
	assert !strings.Contains(code, "func tierInOf(")
	assert !strings.Contains(code, "func tierInIn(")
	assert strings.Contains(code, "func tierOutOf(s string) TierOut {\n")
	assert !strings.Contains(code, "func tierOutWire(")
	assert !strings.Contains(code, "func tierOutIn(")
}
