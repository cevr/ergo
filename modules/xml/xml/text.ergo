import strconv
import strings
import utf8

// Text is XML being written: the prelude's Writer events, so encode(v, t)
// writes any value, and the private parts the events are made of. Its one
// provider is text, so an encode on a Text a let binds by a cell of text
// calls text's functions directly, and the build joins constant bytes by
// the law RawJoins, which ergo test proves.
type Text {
	Null(),
	// Number writes a number's spelling as it is.
	Number(text string),
	Bool(b bool),
	Int(n int64),
	Uint(n uint64),
	Float(f float64),
	String(s string),
	BeginList(n int),
	EndList(),
	BeginObject(n int),
	Tag(name string),
	Key(k string),
	EndObject(),
	// Written is the text written so far.
	Written() string,

	// raw appends text as it is.
	raw(s string),
	// open writes the start tag of a value's element, and close the end
	// tag of the innermost element still open.
	open(name string),
	close(),
	// enter starts a value: in a list, its item element.
	enter(),
	// finish is the text written, and gives the buffer back (Encode
	// only: nothing may use the Text after).
	finish(hint int) string,

	law RawJoins(a string, b string) { raw(a); raw(b) } == { raw(a + b) },
}

// text is Text's provider. stack[0:depth] are the elements open,
// innermost last. The stack keeps its length past its top, so a
// document's writing allocates it once, or again only past eight deep.
type text { out []byte, stack []element, depth int }

// element is an element open: its name, and whether it holds a list,
// whose values each take an item element. An object or a list is the
// content of the innermost element open when it begins, so that element
// says whether a value written next is a list's.
type element { name string, list bool }

extern go append func appendString(out []byte, s string) []byte

extern go append func appendByte[T](out []T, b T) []T

func raw(t *text, s string) { t.out = appendString(t.out, s) }

// push opens an element named name, whose start tag was written.
func push(t *text, name string) {
	if t.depth < len(t.stack) {
		t.stack[t.depth] = element{name: name, list: false}
	} else {
		t.stack = t.stack.Append(element{name: name, list: false})
	}
	t.depth = t.depth + 1
}

// nest starts an object (list false) or a list, the innermost element's
// content.
func nest(t *text, list bool) {
	if t.depth > 0 {
		t.stack[t.depth-1].list = list
	}
}

// open writes <name>, or <_ key="name"> for a name that is not an XML
// name. A key with a character XML cannot hold is read back with U+FFFD
// in its place, so its form is chosen by that key, and the text a value
// read back writes is the text it was read from (ReadBackIsStable).
func open(t *text, name string) {
	if Name(name) {
		t.raw("<")
		t.raw(name)
		t.raw(">")
		t.push(name)
		return
	}
	let s = held(name)
	if Name(s) {
		t.raw("<")
		t.raw(s)
		t.raw(">")
		t.push(s)
	} else {
		t.raw("<_ key=\"")
		t.escape(name, true)
		t.raw("\">")
		t.push("_")
	}
}

func close(t *text) {
	if t.depth == 0 {
		return
	}
	t.depth = t.depth - 1
	t.raw("</")
	t.raw(t.stack[t.depth].name)
	t.raw(">")
}

func enter(t *text) {
	if t.depth > 0 && t.stack[t.depth-1].list {
		t.raw("<item>")
		t.push("item")
	}
}

func Null(t *text) {
	t.enter()
	t.raw("<null/>")
	t.close()
}

func Number(t *text, text string) {
	t.enter()
	t.escape(text, false)
	t.close()
}

func Bool(t *text, b bool) {
	t.enter()
	if b {
		t.raw("true")
	} else {
		t.raw("false")
	}
	t.close()
}

func Int(t *text, n int64) {
	t.enter()
	if n < 0 {
		t.raw("-")
		// -n as a uint64: 0 - uint64(n) wraps to it, also for the least
		// int64, whose negation an int64 cannot hold.
		t.digits(0 - uint64(n))
	} else {
		t.digits(uint64(n))
	}
	t.close()
}

func Uint(t *text, n uint64) {
	t.enter()
	t.digits(n)
	t.close()
}

// digits writes n's decimal digits. (It and escape write to t.out
// themselves: a function given t.out and returning it would be given a
// copy, since t still holds the buffer.)
func digits(t *text, n uint64) {
	let mut p uint64 = 1
	for n/p >= 10 {
		p = p * 10
	}
	for p > 0 {
		t.out = appendByte(t.out, byte(n/p%10)+'0')
		p = p / 10
	}
}

// escape writes s as character data: &, < and > as entities, a carriage
// return as &#xD; (a reader turns a line end into a line feed), and a
// character XML cannot hold as U+FFFD. In an attribute value (attr) it
// also writes ", a tab and a line feed as character references, which a
// reader keeps.
func escape(t *text, s string, attr bool) {
	let mut from = 0
	let mut i = 0
	for i < len(s) {
		let c = s[i]
		if c >= 0x20 && c < 0x80 && c != '&' && c != '<' && c != '>' && (c != '"' || !attr) {
			i = i + 1
			continue
		}
		let mut size = 1
		let mut rep = ""
		if c < 0x80 {
			if c == '&' {
				rep = "&amp;"
			} else if c == '<' {
				rep = "&lt;"
			} else if c == '>' {
				rep = "&gt;"
			} else if c == '\r' {
				rep = "&#xD;"
			} else if attr && c == '"' {
				rep = "&quot;"
			} else if attr && c == '\t' {
				rep = "&#x9;"
			} else if attr && c == '\n' {
				rep = "&#xA;"
			} else if c < 0x20 && c != '\t' && c != '\n' {
				rep = "\uFFFD"
			}
		} else {
			let d = utf8.DecodeRuneInString(strings.Slice(s, i, len(s)))
			size = d.Size
			if d.Size <= 1 || !charRune(d.Rune) {
				rep = "\uFFFD"
			}
		}
		if rep != "" {
			t.out = appendString(t.out, strings.Slice(s, from, i))
			t.out = appendString(t.out, rep)
			from = i + size
		}
		i = i + size
	}
	t.out = appendString(t.out, strings.Slice(s, from, len(s)))
}

// Float writes f's shortest spelling that reads back as f (Go's 'g', -1).
// (It allocates the spelling: std strconv has no append form, and Go's
// strconv.AppendFloat, called from a module, copies the buffer it is
// given: std-nopriv inbox, 2026-11-13.)
func Float(t *text, f float64) {
	t.enter()
	t.raw(strconv.FormatFloat(f, 'g', -1))
	t.close()
}

func String(t *text, s string) {
	t.enter()
	t.escape(s, false)
	t.close()
}

func BeginList(t *text, n int) {
	t.enter()
	t.nest(true)
}

func EndList(t *text) {
	t.close()
}

func BeginObject(t *text, n int) {
	t.enter()
	t.nest(false)
}

func EndObject(t *text) {
	t.close()
}

// Tag writes a union's variant as the first child, <_tag>Name</_tag>.
func Tag(t *text, name string) {
	t.raw("<_tag>")
	t.escape(name, false)
	t.raw("</_tag>")
}

func Key(t *text, k string) { t.open(k) }

func Written(t *text) string { strings.FromBytes(t.out) }

func finish(t *text, hint int) string {
	let s = strings.FromBytes(t.out)
	t.out = strings.Give(t.out, hint)
	s
}

// Encode is v's XML: the element c.Root (root when it is empty) holding
// v's form. It is well formed for every v (OutputIsWellFormed): a
// character XML cannot hold is written as U+FFFD, as encoding/xml writes
// it. (Its Text's buffer is borrowed from std strings with T's size hint,
// as std json's Encode borrows its own.)
func Encode[T wire](c Codec[T], v T) string {
	let hint = strings.Hint[text, T]()
	let t Text = text{out: strings.Borrow(hint), stack: emptyStack(), depth: 0}
	t.open(rootOf(c.Root))
	encode(v, t)
	t.finish(hint)
}

// emptyStack is a stack eight elements deep, the one allocation it
// takes for most documents.
func emptyStack() []element {
	let e = element{name: "", list: false}
	[]element{e, e, e, e, e, e, e, e}
}

func rootOf(name string) string { if name == "" { "root" } else { name } }
