import strconv
import strings
import sync

// reader gives a checked document's values back in the order decode[T]
// asks for them: a provider of the prelude's Reader that reads the text
// itself, once Check has found it well formed, so it builds no token. A
// value is the content of an element whose start tag was taken (the
// root's by Decode, a field's or an item's by More); each read takes the
// value through its end tag. White space between elements, comments and
// processing instructions hold no value and are passed over.
//
// It holds its place in a sync.Ref, as std codec's Replay does: a cell
// cannot be passed as the prelude's Reader, so decode[T] cannot read
// from a provider a let binds by a cell (std-nopriv inbox, 2026-11-13).
type reader { text string, c sync.Ref[cursor] }

// cursor is a reader's place: at is the next byte of the value being
// read. closed says that value's element was <name/>, so its content is
// empty and its end tag already passed; tag is where the start tag More
// took last begins, for Key.
type cursor { at int, closed bool, tag int }

// readerOf is a reader of the checked text whose root element starts at
// the first start tag.
func readerOf(text string) reader {
	let r = reader{text: text, c: sync.NewRef[cursor](cursor{at: 0, closed: false, tag: 0})}
	let k = blank(text, 0)
	r.c.Set(taken(text, k))
	r
}

// blank is the first offset at or after i that is not white space, a
// comment or a processing instruction.
func blank(text string, i int) int {
	let mut j = i
	for j < len(text) {
		let c = text[j]
		if space(c) {
			j = j + 1
		} else if c == '<' && j+1 < len(text) && text[j+1] == '?' {
			j = find(text, j, "?>") + 2
		} else if strings.HasPrefix(strings.Slice(text, j, len(text)), "<!--") {
			j = find(text, j, "-->") + 3
		} else {
			return j
		}
	}
	j
}

// markupEnd is the offset after the comment, CDATA section or processing
// instruction at i.
func markupEnd(text string, i int) int {
	let rest = strings.Slice(text, i, len(text))
	if strings.HasPrefix(rest, "<![CDATA[") {
		find(text, i+9, "]]>") + 3
	} else if strings.HasPrefix(rest, "<!--") {
		find(text, i+4, "-->") + 3
	} else {
		find(text, i+2, "?>") + 2
	}
}

// startsElement reports a start tag at i.
func startsElement(text string, i int) bool {
	i+1 < len(text) && text[i] == '<' && text[i+1] != '/' && text[i+1] != '!' && text[i+1] != '?'
}

// startsEnd reports an end tag at i.
func startsEnd(text string, i int) bool { i+1 < len(text) && text[i] == '<' && text[i+1] == '/' }

// taken is the cursor after the start tag at i: past its '>' (a quoted
// attribute value may hold one), closed when it ends in "/>".
func taken(text string, i int) cursor {
	let mut j = i + 1
	let mut quote byte = 0
	for j < len(text) {
		let c = text[j]
		if quote != 0 {
			if c == quote {
				quote = 0
			}
		} else if c == '"' || c == '\'' {
			quote = c
		} else if c == '>' {
			return cursor{at: j + 1, closed: text[j-1] == '/', tag: i}
		}
		j = j + 1
	}
	cursor{at: j, closed: false, tag: i}
}

// past is the offset after the end tag at i.
func past(text string, i int) int { find(text, i, ">") + 1 }

// value is the text of the value at c, and the cursor after its end tag;
// false when an element starts in it.
func value(text string, c cursor) (string, cursor, bool) {
	if c.closed {
		return ("", cursor{at: c.at, closed: false, tag: c.tag}, true)
	}
	let mut s = ""
	let mut parts = 0
	let mut i = c.at
	for i < len(text) {
		let mut part = ""
		if startsEnd(text, i) {
			return (s, cursor{at: past(text, i), closed: false, tag: c.tag}, true)
		} else if strings.HasPrefix(strings.Slice(text, i, len(text)), "<![CDATA[") {
			let end = find(text, i+9, "]]>")
			part = strings.Slice(text, i+9, end)
			i = end + 3
		} else if text[i] == '<' && i+1 < len(text) && (text[i+1] == '?' || text[i+1] == '!') {
			i = markupEnd(text, i)
			continue
		} else if text[i] == '<' {
			return (s, c, false)
		} else {
			let mut end = find(text, i, "<")
			if end < 0 {
				end = len(text)
			}
			part = unescape(text, i, end) catch {
			case Malformed:
				""
			}
			i = end
		}
		if parts == 0 {
			s = part
		} else {
			s = s + part
		}
		parts = parts + 1
	}
	(s, cursor{at: i, closed: false, tag: c.tag}, true)
}

// read is the text of the value at c, the reader's place, which it takes,
// or the failure of a value of the kind want that holds an element.
func read(r reader, c cursor, want string) string fails WireWrongKind {
	let s, next, ok = value(r.text, c)
	if !ok {
		return WireWrongKind{Path: Path(r), Want: want}
	}
	r.c.Set(next)
	s
}

// wrong is the failure of a value of the kind want at c, the reader's
// place before it read the value's text.
func wrong(r reader, c cursor, want string) WireWrongKind {
	r.c.Set(c)
	WireWrongKind{Path: Path(r), Want: want}
}

// Path is where the reader is: the names of the open elements from the
// root, each with its index among its parent's elements,
// "/catalog[0]/products[1]/item[2]". It reads the text again up to the
// reader's place, only for a failure's text.
func Path(r reader) string {
	let at = r.c.Get().at
	let mut p = NewParser(r.text, 0)
	let mut names = []string{}
	let mut counts = []int{0}
	for {
		p.scan() catch {
		case Malformed:
			break
		}
		if p.kind == endDocument || p.start >= at {
			break
		}
		if p.kind == startElement {
			let last = len(counts) - 1
			counts[last] = counts[last] + 1
			names = names.Append(p.name + "[" + strconv.Itoa(counts[last]-1) + "]")
			counts = counts.Append(0)
		} else if p.kind == endElement {
			names = names[0 : len(names)-1]
			counts = counts[0 : len(counts)-1]
		}
	}
	"/" + strings.Join(names, "/")
}

// nameAtTag is the name of the start tag at i.
func nameAtTag(text string, i int) string { strings.Slice(text, i+1, nameAt(text, i+1)) }

func TakeNull(r reader) bool {
	let c = r.c.Get()
	if c.closed {
		return false
	}
	let k = blank(r.text, c.at)
	if !startsElement(r.text, k) || nameAtTag(r.text, k) != "null" {
		return false
	}
	let n = taken(r.text, k)
	let mut end = n.at
	if !n.closed {
		if !startsEnd(r.text, n.at) {
			return false
		}
		end = past(r.text, n.at)
	}
	let close = blank(r.text, end)
	if !startsEnd(r.text, close) {
		return false
	}
	r.c.Set(cursor{at: past(r.text, close), closed: false, tag: c.tag})
	true
}

func Peek(r reader) WireKind {
	let c = r.c.Get()
	if c.closed {
		return WireString
	}
	let k = blank(r.text, c.at)
	if k >= len(r.text) {
		WireEnd
	} else if startsElement(r.text, k) {
		if nameAtTag(r.text, k) == "null" { WireNull } else { WireObject }
	} else {
		WireString
	}
}

func String(r reader) string fails WireWrongKind { try read(r, r.c.Get(), "string") }

func Number(r reader) string fails WireWrongKind { strings.TrimSpace(try read(r, r.c.Get(), "number")) }

func Bool(r reader) bool fails WireWrongKind {
	let c = r.c.Get()
	match strings.TrimSpace(try read(r, c, "bool")) {
	case "true":
		true
	case "false":
		false
	case _:
		return wrong(r, c, "bool")
	}
}

func Int(r reader) int64 fails WireWrongKind {
	let c = r.c.Get()
	let s = try read(r, c, "int")
	strconv.ParseInt(strings.TrimSpace(s), 10, 64) catch {
	case _:
		return wrong(r, c, "int")
	}
}

func Uint(r reader) uint64 fails WireWrongKind {
	let c = r.c.Get()
	let s = try read(r, c, "uint")
	let digits = strings.TrimSpace(s)
	if digits == "" {
		return wrong(r, c, "uint")
	}
	let mut n uint64 = 0
	for i in 0..len(digits) {
		let d = digits[i]
		if d < '0' || d > '9' {
			return wrong(r, c, "uint")
		}
		let v = uint64(d - '0')
		// n * 10 + v past the largest uint64 (18446744073709551615).
		if n > 1844674407370955161 || n == 1844674407370955161 && v > 5 {
			return wrong(r, c, "uint")
		}
		n = n*10 + v
	}
	n
}

func Float(r reader) float64 fails WireWrongKind {
	let c = r.c.Get()
	let s = try read(r, c, "float")
	strconv.ParseFloat(strings.TrimSpace(s)) catch {
	case _:
		return wrong(r, c, "float")
	}
}

// begin opens an object or a list: its content is elements, not text.
func begin(r reader, want string) fails WireWrongKind {
	let c = r.c.Get()
	if c.closed {
		return
	}
	let k = blank(r.text, c.at)
	if k < len(r.text) && r.text[k] != '<' || strings.HasPrefix(strings.Slice(r.text, k, len(r.text)), "<![CDATA[") {
		return WireWrongKind{Path: Path(r), Want: want}
	}
}

func BeginList(r reader) fails WireWrongKind { try begin(r, "list") }

func BeginObject(r reader) fails WireWrongKind { try begin(r, "object") }

func Tag(r reader) string fails WireMissingField {
	let c = r.c.Get()
	if !c.closed {
		let k = blank(r.text, c.at)
		if startsElement(r.text, k) && nameAtTag(r.text, k) == "_tag" {
			let name, next, _ = value(r.text, taken(r.text, k))
			r.c.Set(cursor{at: next.at, closed: false, tag: c.tag})
			return strings.TrimSpace(name)
		}
	}
	WireMissingField{Path: Path(r), Field: "_tag"}
}

// More takes the next value's start tag, when there is one before the
// end of the object or list.
func More(r reader) bool {
	let c = r.c.Get()
	if c.closed {
		return false
	}
	let k = blank(r.text, c.at)
	if startsElement(r.text, k) {
		r.c.Set(taken(r.text, k))
		return true
	}
	r.c.Set(cursor{at: k, closed: false, tag: c.tag})
	false
}

// Key is the name of the element More took: a field's key, or the key
// attribute of a <_> element.
func Key(r reader) string {
	let i = r.c.Get().tag
	let name = nameAtTag(r.text, i)
	if name != "_" {
		return name
	}
	let mut p = NewParser(strings.Slice(r.text, i, len(r.text)), 0)
	match p.Next() catch {
	case Malformed:
		return name
	} {
	case StartElement as s:
		for a in s.Attrs {
			if a.Name == "key" {
				return a.Value
			}
		}
		name
	case _:
		name
	}
}

// Skip takes the rest of the value whose start tag was taken, through its
// end tag.
func Skip(r reader) {
	let c = r.c.Get()
	if c.closed {
		r.c.Set(cursor{at: c.at, closed: false, tag: c.tag})
		return
	}
	let mut i = c.at
	let mut depth = 1
	for i < len(r.text) {
		if startsEnd(r.text, i) {
			i = past(r.text, i)
			depth = depth - 1
			if depth == 0 {
				break
			}
		} else if r.text[i] == '<' && i+1 < len(r.text) && (r.text[i+1] == '?' || r.text[i+1] == '!') {
			i = markupEnd(r.text, i)
		} else if r.text[i] == '<' {
			let n = taken(r.text, i)
			i = n.at
			if !n.closed {
				depth = depth + 1
			}
		} else {
			let next = find(r.text, i, "<")
			i = if next < 0 { len(r.text) } else { next }
		}
	}
	r.c.Set(cursor{at: i, closed: false, tag: c.tag})
}

// End takes the rest of the object or list, through its end tag.
func End(r reader) { Skip(r) }
