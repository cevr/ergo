import option
import sync

type memState {
	targets Map[string, string],
	locks   Map[string, string],
	events  []OpEvent,
	fault   FaultEdge,
}

// MemoryLockOps is an in-memory, fault-injectable provider of LockOps that
// records every storage operation in chronological order.
type MemoryLockOps {
	state sync.Ref[memState],
} implements LockOps

// NewMemory creates a MemoryLockOps pre-populated with initial committed target files.
func NewMemory(initial Map[string, string]) MemoryLockOps {
	MemoryLockOps{
		state: sync.NewRef(memState{
			targets: initial,
			locks:   Map[string, string]{},
			events:  []OpEvent{},
			fault:   EdgeNone,
		}),
	}
}

// NewMemoryWithFault creates a MemoryLockOps that injects a failure on fault.
func NewMemoryWithFault(initial Map[string, string], fault FaultEdge) MemoryLockOps {
	MemoryLockOps{
		state: sync.NewRef(memState{
			targets: initial,
			locks:   Map[string, string]{},
			events:  []OpEvent{},
			fault:   fault,
		}),
	}
}

// SetFault configures the next injected FaultEdge on m.
func SetFault(m MemoryLockOps, fault FaultEdge) {
	let st = m.state.Get()
	m.state.Set(memState{targets: st.targets, locks: st.locks, events: st.events, fault: fault})
}

// Events returns the chronological durability/storage event log recorded by m.
func Events(m MemoryLockOps) []OpEvent {
	m.state.Get().events
}

// CreateExclusive creates lockPath exclusively in m, failing LockHeld if already present.
func CreateExclusive(m MemoryLockOps, lockPath string) fails LockHeld | PathInvalid {
	let st = m.state.Get()
	match st.fault {
	case EdgeCreate:
		return PathInvalid{Path: lockPath, Reason: "injected create fault"}
	case _:
	}
	if st.locks.Get(lockPath) != option.None {
		return LockHeld{Path: lockPath}
	}
	m.state.Set(memState{
		targets: st.targets,
		locks:   st.locks.Put(lockPath, ""),
		events:  st.events.Append(OpCreate),
		fault:   st.fault,
	})
}

// WriteLock writes staged bytes into lockPath in m.
func WriteLock(m MemoryLockOps, lockPath string, data string) fails NotHeld | PathInvalid {
	let st = m.state.Get()
	match st.fault {
	case EdgeWrite:
		return PathInvalid{Path: lockPath, Reason: "injected write fault"}
	case _:
	}
	if st.locks.Get(lockPath) == option.None {
		return NotHeld{Path: lockPath}
	}
	m.state.Set(memState{
		targets: st.targets,
		locks:   st.locks.Put(lockPath, data),
		events:  st.events.Append(OpWrite),
		fault:   st.fault,
	})
}

// SyncFile records an fsync of lockPath in m or injects SyncFailed.
func SyncFile(m MemoryLockOps, lockPath string) fails SyncFailed {
	let st = m.state.Get()
	match st.fault {
	case EdgeSyncFile:
		return SyncFailed{Path: lockPath, Reason: "injected sync fault"}
	case _:
	}
	if st.locks.Get(lockPath) == option.None {
		return SyncFailed{Path: lockPath, Reason: "lock missing during sync"}
	}
	m.state.Set(memState{
		targets: st.targets,
		locks:   st.locks,
		events:  st.events.Append(OpSyncFile),
		fault:   st.fault,
	})
}

// RenamePublish atomically replaces targetPath with lockPath's staged bytes in m.
func RenamePublish(m MemoryLockOps, lockPath string, targetPath string) fails PublishFailed {
	let st = m.state.Get()
	match st.fault {
	case EdgeRename:
		return PublishFailed{Path: targetPath, Reason: "injected rename fault"}
	case _:
	}
	match st.locks.Get(lockPath) {
	case option.Some[string] as staged:
		m.state.Set(memState{
			targets: st.targets.Put(targetPath, staged.Value),
			locks:   st.locks.Delete(lockPath),
			events:  st.events.Append(OpRename),
			fault:   st.fault,
		})
	case option.None:
		return PublishFailed{Path: targetPath, Reason: "lock missing on rename"}
	}
}

// RemoveLock removes lockPath from m, failing NotHeld if absent.
func RemoveLock(m MemoryLockOps, lockPath string) fails NotHeld {
	let st = m.state.Get()
	if st.locks.Get(lockPath) == option.None {
		return NotHeld{Path: lockPath}
	}
	m.state.Set(memState{
		targets: st.targets,
		locks:   st.locks.Delete(lockPath),
		events:  st.events.Append(OpRemove),
		fault:   st.fault,
	})
}

// SyncDir records a parent directory fsync in m or injects DirSyncUncertain.
func SyncDir(m MemoryLockOps, dirPath string) fails DirSyncUncertain {
	let st = m.state.Get()
	match st.fault {
	case EdgeSyncDir:
		return DirSyncUncertain{Path: dirPath, Reason: "injected dir sync fault"}
	case _:
	}
	m.state.Set(memState{
		targets: st.targets,
		locks:   st.locks,
		events:  st.events.Append(OpSyncDir),
		fault:   st.fault,
	})
}

// ReadTarget returns the currently committed bytes at targetPath in m.
func ReadTarget(m MemoryLockOps, targetPath string) option.Option[string] {
	m.state.Get().targets.Get(targetPath)
}

// LockExists reports whether lockPath currently exists in m.
func LockExists(m MemoryLockOps, lockPath string) bool {
	m.state.Get().locks.Get(lockPath) != option.None
}
