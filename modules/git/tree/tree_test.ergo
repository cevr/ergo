func openRepoDiskODB(fmt oid.Format, objectsDir string, host fs.Host) pack.DiskODB fails pack.Corrupt | pack.MismatchedPair | pack.IOFailed {
	let odb = with context { fs.Files: host } {
		try pack.Open(fmt, objectsDir, []string{}, delta.DefaultLimits())
	}
	pack.NewDiskODB(odb, host)
}

let onOracleSha1 = context fails pack.Corrupt | pack.MismatchedPair | pack.IOFailed needs TestAmbient {
	exec.Runner:      exec.NewTestHost().InheritEnv(exec.PathOf(os.NewTestHost().Environ())),
	fs.Files:         fs.NewTestHost(),
	fs.Writes:        fs.NewTestHost(),
	os.Process:       os.NewTestHost(),
	oracle.Symlinks:  oracle.NewHostSymlinks(fs.NewTestHost()),
	pack.ObjectStore: try openRepoDiskODB(oid.Sha1, filepath.Join([]string{fstest.TestFolder(), "repo", ".git", "objects"}), fs.NewTestHost()),
}

