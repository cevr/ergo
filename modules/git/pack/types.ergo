// Package pack implements a pure-Ergo unified Git object database (G-PACK)
// over loose objects, validated pack/index pairs, alternates, and dynamic
// pack catalog refresh on miss for both SHA-1 and SHA-256 repositories.

import slices
import sync
import github.com/cevr/ergo/modules/git/delta
import github.com/cevr/ergo/modules/git/oid
import github.com/cevr/ergo/modules/git/packidx

// Error is the closed failure union for unified Git object database reads,
// stats, pack validation, catalog refreshes, and installations.
type Error =
	| Missing{OID oid.OID}
	| Corrupt{OID oid.OID, Why string}
	| MismatchedPair{IdxPath string, PackPath string, Expected string, Got string}
	| Collision{OID oid.OID, Digest string}
	| LimitExceeded{MaxBytes int}
	| DepthExceeded{MaxDepth int}
	| IOFailed{Op string, Detail string}

// Object is a verified canonical Git object materialized from either a loose
// file or a validated packfile.
type Object {
	Kind oid.Kind,
	OID  oid.OID,
	Size int,
	Data []byte,
}

// Header is the verified kind and uncompressed byte size of a Git object.
type Header {
	Kind oid.Kind,
	Size int,
}

// PackPair pairs a verified pack index with its matching validated packfile.
type PackPair {
	IdxPath  string,
	PackPath string,
	Index    packidx.Index,
	PackData []byte,
	PackSum  oid.OID,
}

type packCatalog {
	packs []PackPair,
}

// ODB is a unified Git object database handle covering primary loose objects,
// validated pack/index pairs across primary and alternate object directories,
// alternate loose objects, and automatic pack catalog refresh on lookup miss.
type ODB {
	Format     oid.Format,
	ObjectsDir string,
	Alternates []string,
	Limits     delta.ChainLimits,
	catalog    sync.Ref[packCatalog],
}

// ObjectStore is the capability seam for unified Git object storage, carrying
// the shared laws held identically by MemoryODB and DiskODB.
type ObjectStore {
	Read(id oid.OID, maxBytes int) Object fails Missing | Corrupt | MismatchedPair | Collision | LimitExceeded | DepthExceeded | IOFailed,
	Stat(id oid.OID, maxBytes int) Header fails Missing | Corrupt | MismatchedPair | Collision | LimitExceeded | DepthExceeded | IOFailed,
	Contains(id oid.OID) bool,
	Install(kind oid.Kind, data []byte) oid.OID fails Collision | IOFailed,

	// ReadAfterInstall: installing an object and reading it back yields the
	// exact canonical kind, size, OID, and payload bytes, and Contains is true.
	law ReadAfterInstall(s string) {
		let payload = s.Bytes()
		let id = Install(oid.Blob, payload) catch {
		case Collision, IOFailed:
			return false
		}
		let obj = Read(id, len(payload)+256) catch {
		case Missing, Corrupt, MismatchedPair, Collision, LimitExceeded, DepthExceeded, IOFailed:
			return false
		}
			Contains(id) &&
			oid.Equal(obj.OID, id) &&
			oid.KindName(obj.Kind) == "blob" &&
			obj.Size == len(payload) &&
			slices.Equal(obj.Data, payload)
	},

	// StatMatchesRead: Stat returns the exact Kind and Size reported by Read
	// for every installed object.
	law StatMatchesRead(s string) {
		let payload = s.Bytes()
		let id = Install(oid.Blob, payload) catch {
		case Collision, IOFailed:
			return false
		}
		let obj = Read(id, len(payload)+256) catch {
		case Missing, Corrupt, MismatchedPair, Collision, LimitExceeded, DepthExceeded, IOFailed:
			return false
		}
		let hdr = Stat(id, len(payload)+256) catch {
		case Missing, Corrupt, MismatchedPair, Collision, LimitExceeded, DepthExceeded, IOFailed:
			return false
		}
		oid.KindName(hdr.Kind) == oid.KindName(obj.Kind) && hdr.Size == obj.Size
	},

	// MissingIsAbsent: an OID not contained in the store fails Missing on both
	// Read and Stat.
	law MissingIsAbsent(s string) {
		let probe1 = oid.HashObject(oid.Sha1, oid.Blob, ("pack-absent-probe-" + s).Bytes()) catch {
		case oid.Collision:
			return true
		}
		let probe2 = oid.HashObject(oid.Sha256, oid.Blob, ("pack-absent-probe-" + s).Bytes()) catch {
		case oid.Collision:
			return true
		}
		for probe in []oid.OID{probe1, probe2} {
			if !Contains(probe) {
				let mut readMissing = false
				let _ = Read(probe, 4096) catch {
				case Missing:
					readMissing = true
					Object{Kind: oid.Blob, OID: probe, Size: 0, Data: []byte{}}
				case Corrupt, MismatchedPair, Collision, LimitExceeded, DepthExceeded, IOFailed:
					Object{Kind: oid.Blob, OID: probe, Size: 0, Data: []byte{}}
				}
				if !readMissing {
					return false
				}
				let mut statMissing = false
				let _ = Stat(probe, 4096) catch {
				case Missing:
					statMissing = true
					Header{Kind: oid.Blob, Size: 0}
				case Corrupt, MismatchedPair, Collision, LimitExceeded, DepthExceeded, IOFailed:
					Header{Kind: oid.Blob, Size: 0}
				}
				if !statMissing {
					return false
				}
			}
		}
		true
	},
}
