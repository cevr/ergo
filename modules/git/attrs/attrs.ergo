import filepath
import fs
import option
import strings
import github.com/cevr/ergo/modules/git/oid
import github.com/cevr/ergo/modules/git/pack
import github.com/cevr/ergo/modules/git/tree

func parseOctalDigits(bs []byte, start int) (byte, int) {
	let mut val = 0
	let mut pos = start
	let mut count = 0
	for pos < bs.Len() && count < 3 && bs[pos] >= byte('0') && bs[pos] <= byte('7') {
		val = val*8 + int(bs[pos]-byte('0'))
		pos = pos + 1
		count = count + 1
	}
	(byte(val & 0xff), pos)
}

func parseQuotedPattern(bs []byte, start int) (string, int, bool) {
	let n = bs.Len()
	let mut pos = start + 1
	let mut out = []byte{}
	for pos < n {
		let c = bs[pos]
		if c == byte('"') {
			return (out.Text(), pos + 1, true)
		}
		if c == byte('\\') && pos+1 < n {
			let nxt = bs[pos+1]
			if nxt == byte('n') {
				out = out.Append(byte('\n'))
				pos = pos + 2
			} else if nxt == byte('t') {
				out = out.Append(byte('\t'))
				pos = pos + 2
			} else if nxt == byte('r') {
				out = out.Append(byte('\r'))
				pos = pos + 2
			} else if nxt == byte('"') || nxt == byte('\\') {
				out = out.Append(nxt)
				pos = pos + 2
			} else if nxt >= byte('0') && nxt <= byte('7') {
				let (octByte, nextPos) = parseOctalDigits(bs, pos+1)
				out = out.Append(octByte)
				pos = nextPos
			} else {
				out = out.Append(nxt)
				pos = pos + 2
			}
			continue
		}
		out = out.Append(c)
		pos = pos + 1
	}
	("", start, false)
}

func parsePatternToken(line string) (string, string, bool) {
	let bs = line.Bytes()
	let n = bs.Len()
	let mut pos = 0
	for pos < n && (bs[pos] == byte(' ') || bs[pos] == byte('\t')) {
		pos = pos + 1
	}
	if pos >= n || bs[pos] == byte('#') {
		return ("", "", false)
	}
	if bs[pos] == byte('"') {
		let (pat, nextPos, ok) = parseQuotedPattern(bs, pos)
		if !ok || pat == "" {
			return ("", "", false)
		}
		return (pat, bs[nextPos:].Text(), true)
	}
	let mut out = []byte{}
	for pos < n && bs[pos] != byte(' ') && bs[pos] != byte('\t') {
		if bs[pos] == byte('\\') && pos+1 < n && bs[pos+1] == byte(' ') {
			out = out.Append(byte(' '))
			pos = pos + 2
			continue
		}
		out = out.Append(bs[pos])
		pos = pos + 1
	}
	if out.Len() == 0 {
		return ("", "", false)
	}
	(out.Text(), bs[pos:].Text(), true)
}

func parseAttrToken(tok string) option.Option[AttrAssignment] {
	if tok == "" {
		return option.None
	}
	if strings.HasPrefix(tok, "!") {
		let name = tok[1:]
		if name == "" {
			return option.None
		}
		return option.Some[AttrAssignment]{Value: AttrAssignment{Name: name, State: AttrUnspecified}}
	}
	if strings.HasPrefix(tok, "-") {
		let name = tok[1:]
		if name == "" {
			return option.None
		}
		return option.Some[AttrAssignment]{Value: AttrAssignment{Name: name, State: AttrUnset}}
	}
	let eq = strings.Index(tok, "=")
	if eq >= 0 {
		let name = tok[:eq]
		let val = tok[eq+1:]
		if name == "" {
			return option.None
		}
		return option.Some[AttrAssignment]{Value: AttrAssignment{Name: name, State: AttrValue{Val: val}}}
	}
	option.Some[AttrAssignment]{Value: AttrAssignment{Name: tok, State: AttrSet}}
}

// ParseAttributes parses a `.gitattributes` or `.git/info/attributes` file
// rooted at baseDir (empty string for repo root / info/attributes) into
// ordered AttrRules, supporting comments, C-quoted patterns, unanchored/anchored
// globs, `[attr]` macros, and all four Git attribute states.
func ParseAttributes(baseDir string, content string) []AttrRule {
	let cleanBase = if baseDir == "" || baseDir == "." { "" } else { strings.TrimSuffix(baseDir, "/") }
	let mut rules = []AttrRule{}
	for rawLine in strings.Split(content, "\n") {
		let line = strings.TrimSuffix(rawLine, "\r")
		let (rawPat, rest, ok) = parsePatternToken(line)
		if !ok {
			continue
		}
		let mut assigns = []AttrAssignment{}
		for tok in strings.Fields(rest) {
			match parseAttrToken(tok) {
			case option.Some[AttrAssignment] as a:
				assigns = assigns.Append(a.Value)
			case option.None:
			}
		}
		if assigns.Len() == 0 {
			continue
		}
		if strings.HasPrefix(rawPat, "[attr]") {
			let macroName = strings.TrimPrefix(rawPat, "[attr]")
			if macroName != "" && cleanBase == "" {
				rules = rules.Append(AttrRule{
					BaseDir:     "",
					Pattern:     "",
					Anchored:    false,
					Assignments: assigns,
					IsMacro:     true,
					MacroName:   macroName,
				})
			}
			continue
		}
		if strings.HasPrefix(rawPat, "!") || strings.HasSuffix(rawPat, "/") {
			continue
		}
		let mut pat = rawPat
		if strings.HasPrefix(pat, "\\!") || strings.HasPrefix(pat, "\\#") {
			pat = pat[1:]
		}
		let mut anchored = false
		if strings.HasPrefix(pat, "/") {
			anchored = true
			pat = pat[1:]
		} else if strings.Contains(pat, "/") {
			anchored = true
		}
		if pat == "" {
			continue
		}
		rules = rules.Append(AttrRule{
			BaseDir:     cleanBase,
			Pattern:     pat,
			Anchored:    anchored,
			Assignments: assigns,
			IsMacro:     false,
			MacroName:   "",
		})
	}
	rules
}

func matchCharClass(pb []byte, pStart int, ch byte) (bool, int) {
	let n = pb.Len()
	let mut i = pStart + 1
	if i >= n {
		return (false, pStart)
	}
	let mut negate = false
	if pb[i] == byte('!') || pb[i] == byte('^') {
		negate = true
		i = i + 1
	}
	let mut matched = false
	let mut first = true
	for i < n {
		if !first && pb[i] == byte(']') {
			let ok = if negate { !matched } else { matched }
			return (ok, i + 1)
		}
		first = false
		let lo = pb[i]
		if i+2 < n && pb[i+1] == byte('-') && pb[i+2] != byte(']') {
			let hi = pb[i+2]
			if ch >= lo && ch <= hi {
				matched = true
			}
			i = i + 3
		} else {
			if ch == lo {
				matched = true
			}
			i = i + 1
		}
	}
	(false, pStart)
}

func globMatchBytes(pb []byte, pi int, sb []byte, si int) bool {
	let pn = pb.Len()
	let sn = sb.Len()
	if pi == pn {
		return si == sn
	}
	if pi+2 < pn && pb[pi] == byte('*') && pb[pi+1] == byte('*') && pb[pi+2] == byte('/') {
		if globMatchBytes(pb, pi+3, sb, si) {
			return true
		}
		let mut k = si
		for k < sn {
			if sb[k] == byte('/') {
				if globMatchBytes(pb, pi+3, sb, k+1) {
					return true
				}
			}
			k = k + 1
		}
		return false
	}
	if pi+1 < pn && pb[pi] == byte('*') && pb[pi+1] == byte('*') && pi+2 == pn {
		return true
	}
	if pb[pi] == byte('*') {
		if globMatchBytes(pb, pi+1, sb, si) {
			return true
		}
		let mut k = si
		for k < sn && sb[k] != byte('/') {
			k = k + 1
			if globMatchBytes(pb, pi+1, sb, k) {
				return true
			}
		}
		return false
	}
	if si >= sn {
		return false
	}
	if pb[pi] == byte('?') {
		if sb[si] == byte('/') {
			return false
		}
		return globMatchBytes(pb, pi+1, sb, si+1)
	}
	if pb[pi] == byte('[') {
		if sb[si] == byte('/') {
			return false
		}
		let (ok, nextPi) = matchCharClass(pb, pi, sb[si])
		if nextPi > pi {
			if !ok {
				return false
			}
			return globMatchBytes(pb, nextPi, sb, si+1)
		}
	}
	if pb[pi] == byte('\\') && pi+1 < pn {
		if sb[si] != pb[pi+1] {
			return false
		}
		return globMatchBytes(pb, pi+2, sb, si+1)
	}
	if pb[pi] != sb[si] {
		return false
	}
	globMatchBytes(pb, pi+1, sb, si+1)
}

func ruleMatchesPath(rule AttrRule, relPath string) bool {
	if rule.IsMacro {
		return false
	}
	let mut sub = relPath
	if rule.BaseDir != "" {
		let prefix = rule.BaseDir + "/"
		if !strings.HasPrefix(relPath, prefix) {
			return false
		}
		sub = strings.TrimPrefix(relPath, prefix)
	}
	if rule.Anchored {
		globMatchBytes(rule.Pattern.Bytes(), 0, sub.Bytes(), 0)
	} else {
		globMatchBytes(rule.Pattern.Bytes(), 0, filepath.Base(sub).Bytes(), 0)
	}
}

func defaultMacros() Map[string, []AttrAssignment] {
	let binMacro = []AttrAssignment{
		AttrAssignment{Name: "diff", State: AttrUnset},
		AttrAssignment{Name: "merge", State: AttrUnset},
		AttrAssignment{Name: "text", State: AttrUnset},
	}
	Map[string, []AttrAssignment]{}.Put("binary", binMacro)
}

func invertMacroState(st AttrState) AttrState {
	match st {
	case AttrSet:
		AttrUnset
	case AttrUnset:
		AttrSet
	case AttrValue:
		AttrUnset
	case AttrUnspecified:
		AttrUnspecified
	}
}

func setAttrState(attrs Map[string, AttrState], name string, state AttrState) Map[string, AttrState] {
	let overwrite = true
	if !overwrite && attrs.Get(name) != option.None {
		return attrs
	}
	attrs.Put(name, state)
}

func applyAssignmentRec(attrs Map[string, AttrState], macros Map[string, []AttrAssignment], assign AttrAssignment, depth int) Map[string, AttrState] {
	let mut cur = setAttrState(attrs, assign.Name, assign.State)
	if depth >= 8 {
		return cur
	}
	match macros.Get(assign.Name) {
	case option.None:
		cur
	case option.Some[[]AttrAssignment] as body:
		match assign.State {
		case AttrSet:
			for sub in body.Value {
				cur = applyAssignmentRec(cur, macros, sub, depth+1)
			}
			cur
		case AttrUnset:
			for sub in body.Value {
				cur = applyAssignmentRec(cur, macros, AttrAssignment{Name: sub.Name, State: invertMacroState(sub.State)}, depth+1)
			}
			cur
		case AttrUnspecified:
			for sub in body.Value {
				cur = applyAssignmentRec(cur, macros, AttrAssignment{Name: sub.Name, State: AttrUnspecified}, depth+1)
			}
			cur
		case AttrValue:
			cur
		}
	}
}

// ResolveAttrs evaluates ordered AttrRules (lowest to highest precedence:
// shallow-to-deep `.gitattributes`, followed by `.git/info/attributes`) for
// relPath, expanding built-in and custom `[attr]` macros.
func ResolveAttrs(rules []AttrRule, relPath string) Map[string, AttrState] {
	let mut macros = defaultMacros()
	let mut attrs = Map[string, AttrState]{}
	for rule in rules {
		if rule.IsMacro {
			macros = macros.Put(rule.MacroName, rule.Assignments)
			continue
		}
		if ruleMatchesPath(rule, relPath) {
			for assign in rule.Assignments {
				attrs = applyAssignmentRec(attrs, macros, assign, 0)
			}
		}
	}
	let mut cleaned = Map[string, AttrState]{}
	for k, v in attrs {
		match v {
		case AttrUnspecified:
		case AttrSet, AttrUnset, AttrValue:
			cleaned = cleaned.Put(k, v)
		}
	}
	cleaned
}

func isExternalDriverAuthorized(name string, policy DriverPolicy) bool {
	if !policy.AllowExternalDrivers {
		return false
	}
	for allowed in policy.AllowedDrivers {
		if allowed == name {
			return true
		}
	}
	false
}

// ResolveMergeDriver selects the merge driver from resolved attributes under
// policy. Built-in drivers (`text`, `binary`, `union`) are always permitted;
// external named drivers fail strictly with UntrustedDriver unless explicitly
// authorized in policy.
func ResolveMergeDriver(attrs Map[string, AttrState], policy DriverPolicy) MergeDriver fails UntrustedDriver {
	match attrs.Get("merge") {
	case option.None:
		DriverText
	case option.Some[AttrState] as st:
		match st.Value {
		case AttrSet, AttrUnspecified:
			DriverText
		case AttrUnset:
			DriverBinary
		case AttrValue as v:
			if v.Val == "text" {
				DriverText
			} else if v.Val == "binary" {
				DriverBinary
			} else if v.Val == "union" {
				DriverUnion
			} else {
				if !isExternalDriverAuthorized(v.Val, policy) {
					return UntrustedDriver{Name: v.Val}
				}
				DriverExternal{Name: v.Val}
			}
		}
	}
}

func parentDirsForPath(relPath string) []string {
	let mut dirs = []string{""}
	let parts = strings.Split(relPath, "/")
	if parts.Len() <= 1 {
		return dirs
	}
	let mut acc = ""
	for i in 0..(parts.Len() - 1) {
		acc = if acc == "" { parts[i] } else { acc + "/" + parts[i] }
		dirs = dirs.Append(acc)
	}
	dirs
}

// LoadWorktreeAttrs loads `.gitattributes` files from repository root down to
// relPath's parent directory plus `<gitDir>/info/attributes` (highest
// precedence) and resolves all attributes for relPath.
func LoadWorktreeAttrs(gitDir string, worktreeDir string, relPath string) Map[string, AttrState] fails IOFailed needs fs.Files {
	let mut allRules = []AttrRule{}
	for dir in parentDirsForPath(relPath) {
		let attrPath = if dir == "" {
			filepath.Join([]string{worktreeDir, ".gitattributes"})
		} else {
			filepath.Join([]string{worktreeDir, dir, ".gitattributes"})
		}
		let content = fs.Files.ReadFile(attrPath) catch {
		case fs.NotFound:
			""
		case fs.Denied as e:
			return IOFailed{Op: "read-gitattributes", Detail: e.Path}
		case fs.Failed as e:
			return IOFailed{Op: "read-gitattributes", Detail: e.Reason}
		}
		if content != "" {
			for r in ParseAttributes(dir, content) {
				allRules = allRules.Append(r)
			}
		}
	}
	let infoPath = filepath.Join([]string{gitDir, "info", "attributes"})
	let infoContent = fs.Files.ReadFile(infoPath) catch {
	case fs.NotFound:
		""
	case fs.Denied as e:
		return IOFailed{Op: "read-info-attributes", Detail: e.Path}
	case fs.Failed as e:
		return IOFailed{Op: "read-info-attributes", Detail: e.Reason}
	}
	if infoContent != "" {
		for r in ParseAttributes("", infoContent) {
			allRules = allRules.Append(r)
		}
	}
	ResolveAttrs(allRules, relPath)
}

// LoadTreeAttrs loads `.gitattributes` blobs from rootTree along relPath's
// directory prefixes (shallow to deep), appends infoAttributes (highest
// precedence), and resolves all attributes for relPath.
func LoadTreeAttrs(format oid.Format, rootTree option.Option[oid.OID], infoAttributes string, relPath string, maxBytes int) Map[string, AttrState] needs pack.ObjectStore {
	let mut allRules = []AttrRule{}
	match rootTree {
	case option.None:
	case option.Some[oid.OID] as rt:
		for dir in parentDirsForPath(relPath) {
			let attrRel = if dir == "" { ".gitattributes" } else { dir + "/.gitattributes" }
			let entryOpt = tree.LookupPath(format, rt.Value, attrRel, maxBytes) catch {
			case tree.CorruptTree, tree.InvalidEntryName, tree.UnsortedTree, tree.DuplicateEntry, tree.WrongKind, tree.DepthExceeded, tree.MissingObject, tree.StoreError:
				option.None
			}
			match entryOpt {
			case option.Some[tree.Entry] as e:
				if !tree.IsTree(e.Value.Mode) && !tree.IsGitlink(e.Value.Mode) {
					let objOpt = pack.ObjectStore.Read(e.Value.OID, maxBytes) catch {
					case pack.Missing, pack.Corrupt, pack.MismatchedPair, pack.Collision, pack.LimitExceeded, pack.DepthExceeded, pack.IOFailed:
						pack.Object{Kind: oid.Blob, OID: e.Value.OID, Size: 0, Data: []byte{}}
					}
					if objOpt.Data.Len() > 0 {
						for r in ParseAttributes(dir, objOpt.Data.Text()) {
							allRules = allRules.Append(r)
						}
					}
				}
			case option.None:
			}
		}
	}
	if infoAttributes != "" {
		for r in ParseAttributes("", infoAttributes) {
			allRules = allRules.Append(r)
		}
	}
	ResolveAttrs(allRules, relPath)
}

// MemoryAttrs is a pure in-memory provider of AttrReader.
type MemoryAttrs {} implements AttrReader

// NewMemoryAttrs returns a MemoryAttrs provider.
func NewMemoryAttrs() MemoryAttrs {
	MemoryAttrs
}

// Eval implements AttrReader.Eval on MemoryAttrs.
func Eval(_ MemoryAttrs, rules []AttrRule, relPath string) Map[string, AttrState] {
	ResolveAttrs(rules, relPath)
}

// ResolveDriver implements AttrReader.ResolveDriver on MemoryAttrs.
func ResolveDriver(_ MemoryAttrs, attrs Map[string, AttrState], policy DriverPolicy) MergeDriver fails UntrustedDriver {
	try ResolveMergeDriver(attrs, policy)
}

// RepoAttrs is a repository-backed provider of AttrReader carrying base rules.
type RepoAttrs {
	baseRules []AttrRule,
} implements AttrReader

// NewRepoAttrs creates a RepoAttrs provider initialized with baseRules.
func NewRepoAttrs(baseRules []AttrRule) RepoAttrs {
	RepoAttrs{baseRules: baseRules}
}

// Eval implements AttrReader.Eval on RepoAttrs.
func Eval(_ RepoAttrs, rules []AttrRule, relPath string) Map[string, AttrState] {
	ResolveAttrs(rules, relPath)
}

// ResolveDriver implements AttrReader.ResolveDriver on RepoAttrs.
func ResolveDriver(_ RepoAttrs, attrs Map[string, AttrState], policy DriverPolicy) MergeDriver fails UntrustedDriver {
	try ResolveMergeDriver(attrs, policy)
}
