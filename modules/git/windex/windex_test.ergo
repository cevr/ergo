import exec
import filepath
import fs
import fstest
import option
import os
import slices
import strings
import github.com/cevr/ergo/modules/git/index
import github.com/cevr/ergo/modules/git/locks
import github.com/cevr/ergo/modules/git/loose
import github.com/cevr/ergo/modules/git/oid
import github.com/cevr/ergo/modules/git/oracle
import github.com/cevr/ergo/modules/git/root

let onDefaultWriterSha1 = context {
	IndexWriter: NewDefaultIndexWriter(oid.Sha1),
}

let onDefaultWriterSha256 = context {
	IndexWriter: NewDefaultIndexWriter(oid.Sha256),
}

type testFail {
	reason string,
}

func runGitOk(dir string, args []string, stdin string, pathEnv Map[string, string], step int) string fails testFail | exec.NotFound | exec.Denied | exec.Failed needs exec.Runner {
	let base = oracle.GitCommand(dir, args, pathEnv, oracle.StepEpoch(step))
	let cmd = if stdin == "" { base } else { exec.WithStdin(base, stdin) }
	let res = try exec.Runner.Run(cmd)
	if res.Status != 0 {
		return testFail{reason: "git failed: " + res.Stderr}
	}
	res.Stdout
}

func makeIndexEntry(path string, mode uint32, id oid.OID, size int, stage int, skipWT bool, intentAdd bool) index.Entry {
	index.Entry{
		CTimeSec:     uint32(0),
		CTimeNsec:    uint32(0),
		MTimeSec:     uint32(0),
		MTimeNsec:    uint32(0),
		Dev:          uint32(0),
		Ino:          uint32(0),
		Mode:         mode,
		UID:          uint32(0),
		GID:          uint32(0),
		FileSize:     uint32(size),
		OID:          id,
		Stage:        stage,
		AssumeValid:  false,
		Extended:     skipWT || intentAdd,
		SkipWorktree: skipWT,
		IntentToAdd:  intentAdd,
		Path:         path,
	}
}

func verifyFormatWriteIndex(cwd string, oFmt oracle.OidFormat, fmt oid.Format, pathEnv Map[string, string], host fs.Host) fails testFail | InvalidPath | DuplicateEntry | InvalidStage | InvalidMode | UnmergedIndex | Collision | LockFailed | ObjectFailed | loose.Collision | loose.IOFailed | root.NotARepository | root.BadGitDirFile | root.BadCommonDir | root.UnsupportedVersion | root.UnsupportedExtension | root.UntrustedPath | root.PathEscape | root.AlternateCycle | root.AlternateDepthExceeded | root.ConfigSyntax | root.ConfigBadValue | root.IncludeCycle | root.IncludeDepthExceeded | root.IncludeRefused | oracle.Missing | oracle.Corrupt | oracle.Ambiguous | oracle.InvalidRef | oracle.Conflict | oracle.CommandFailed | exec.NotFound | exec.Denied | exec.Failed | fs.NotFound | fs.Denied | fs.Failed needs exec.Runner | fs.Files | fs.Writes | oracle.Symlinks | locks.LockOps {
	let label = oracle.FormatName(oFmt)
	let repoDir = try oracle.InitRepo(filepath.Join([]string{cwd, "windex-" + label}), oracle.RepoSpec{Format: oFmt, Layout: oracle.Normal, DefaultBranch: "main"}, pathEnv, oracle.BaseEpoch)
	let layout = try root.Discover(repoDir, root.DiscoverOptions{CeilingDirs: []string{cwd}, Trust: root.ConfinedTrust(cwd)})
	let looseStore = loose.FromLayout(layout)
	let diskLoose = loose.NewDiskStore(looseStore, host)

	let f1 = "a-file content\n"
	let f2 = "nested inside a/inner.txt\n"
	let f3 = "#!/bin/sh\necho hi\n"
	let f4 = "a0 content\n"
	let symTarget = "a-file"

	try fs.Writes.WriteFile(filepath.Join([]string{repoDir, "a-file"}), f1)
	try fs.Writes.MkdirAll(filepath.Join([]string{repoDir, "a"}))
	try fs.Writes.WriteFile(filepath.Join([]string{repoDir, "a", "inner.txt"}), f2)
	try fs.Writes.WriteFileMode(filepath.Join([]string{repoDir, "run.sh"}), f3, fs.SharedDir())
	try fs.Writes.WriteFile(filepath.Join([]string{repoDir, "a0"}), f4)
	try oracle.Symlinks.CreateSymlink(symTarget, filepath.Join([]string{repoDir, "link"}))

	let id1 = try loose.InstallObject(looseStore, oid.Blob, f1.Bytes())
	let id2 = try loose.InstallObject(looseStore, oid.Blob, f2.Bytes())
	let id3 = try loose.InstallObject(looseStore, oid.Blob, f3.Bytes())
	let id4 = try loose.InstallObject(looseStore, oid.Blob, f4.Bytes())
	let idSym = try loose.InstallObject(looseStore, oid.Blob, symTarget.Bytes())

	let entries = []index.Entry{
		makeIndexEntry("a0", index.ModeRegular, id4, f4.Len(), 0, false, false),
		makeIndexEntry("a/inner.txt", index.ModeRegular, id2, f2.Len(), 0, false, false),
		makeIndexEntry("a-file", index.ModeRegular, id1, f1.Len(), 0, false, false),
		makeIndexEntry("run.sh", index.ModeExecutable, id3, f3.Len(), 0, false, false),
		makeIndexEntry("link", index.ModeSymlink, idSym, symTarget.Len(), 0, false, false),
	}

	let indexPath = filepath.Join([]string{layout.GitDir, "index"})
	try WriteIndex(fmt, indexPath, entries, locks.Durable)

	let lsFiles = try runGitOk(repoDir, []string{"ls-files", "-s", "-z"}, "", pathEnv, 1)
	let recs = strings.Split(strings.TrimSuffix(lsFiles, "\x00"), "\x00")
	if recs.Len() != 5 {
		return testFail{reason: "git ls-files -s expected 5 entries, got \(recs.Len())"}
	}
	if !strings.Contains(lsFiles, "100644 "+oid.Hex(id1)+" 0\ta-file\x00") ||
		!strings.Contains(lsFiles, "100755 "+oid.Hex(id3)+" 0\trun.sh\x00") ||
		!strings.Contains(lsFiles, "120000 "+oid.Hex(idSym)+" 0\tlink\x00") {
		return testFail{reason: "git ls-files -s mismatch: " + lsFiles}
	}

	let gitTreeHex = strings.TrimSpace(try runGitOk(repoDir, []string{"write-tree"}, "", pathEnv, 2))
	let ergoTreeOid = with context { loose.Objects: diskLoose } {
		try WriteTree(fmt, entries)
	}
	if oid.Hex(ergoTreeOid) != gitTreeHex {
		return testFail{reason: "WriteTree OID mismatch: got \(oid.Hex(ergoTreeOid)), want \(gitTreeHex)"}
	}

	let _ = try runGitOk(repoDir, []string{"fsck", "--strict", "--full"}, "", pathEnv, 3)

	let statusOut = try runGitOk(repoDir, []string{"status", "--porcelain=v1", "-z"}, "", pathEnv, 4)
	if !strings.Contains(statusOut, "A  a-file\x00") || !strings.Contains(statusOut, "A  a/inner.txt\x00") || !strings.Contains(statusOut, "A  run.sh\x00") {
		return testFail{reason: "git status did not recognize written index entries: " + statusOut}
	}

	let indexBeforeSnap = (try fs.Files.ReadFile(indexPath)).Bytes()
	let extraId = try loose.InstallObject(looseStore, oid.Blob, "snapshot-only\n".Bytes())
	let snapTreeOid = with context { loose.Objects: diskLoose } {
		try BuildSnapshotTree(fmt, entries, []index.Entry{makeIndexEntry("snap.txt", index.ModeRegular, extraId, 14, 0, false, false)}, []string{"a0"})
	}
	if oid.Equal(snapTreeOid, ergoTreeOid) {
		return testFail{reason: "snapshot tree should differ from base index tree"}
	}
	let indexAfterSnap = (try fs.Files.ReadFile(indexPath)).Bytes()
	if !slices.Equal(indexBeforeSnap, indexAfterSnap) {
		return testFail{reason: "BuildSnapshotTree mutated on-disk .git/index"}
	}

	let unmerged = []index.Entry{makeIndexEntry("bad.txt", index.ModeRegular, id1, f1.Len(), 2, false, false)}
	let mut sawUnmerged = false
	let _ = with context { loose.Objects: diskLoose } {
		WriteTree(fmt, unmerged) catch {
		case UnmergedIndex as e:
			sawUnmerged = e.Path == "bad.txt"
			id1
		case InvalidPath, DuplicateEntry, InvalidStage, InvalidMode, Collision, ObjectFailed:
			id1
		}
	}
	if !sawUnmerged {
		return testFail{reason: "WriteTree failed to reject unmerged stage 2 entry"}
	}

	let v3Entries = []index.Entry{
		makeIndexEntry("a-file", index.ModeRegular, id1, f1.Len(), 0, true, false),
		makeIndexEntry("a0", index.ModeRegular, id4, f4.Len(), 0, false, true),
	}
	try WriteIndex(fmt, indexPath, v3Entries, locks.Durable)
	let v3Ls = try runGitOk(repoDir, []string{"ls-files", "-v", "-z"}, "", pathEnv, 5)
	if !strings.Contains(v3Ls, "S a-file\x00") {
		return testFail{reason: "C git did not recognize v3 SkipWorktree flag: " + v3Ls}
	}

	let memLocks = locks.NewMemoryWithFault(Map[string, string]{"idx": "original-bytes"}, locks.EdgeWrite)
	let mut sawLockFail = false
	with context { locks.LockOps: memLocks } {
		WriteIndex(fmt, "idx", entries, locks.Durable) catch {
		case LockFailed:
			sawLockFail = true
		case InvalidPath, DuplicateEntry, InvalidStage, InvalidMode, Collision:
		}
	}
	let wantOrig = option.Some[string]{Value: "original-bytes"}
	if !sawLockFail || memLocks.ReadTarget("idx") != wantOrig || memLocks.LockExists("idx.lock") {
		return testFail{reason: "failed WriteIndex mutated target or leaked lock"}
	}
}

type hostBox {
	Get() fs.Host,

	// HostReadable: test host can read current directory.
	law HostReadable() {
		let h = Get()
		let _ = fs.ReadDir(h, ".") catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		true
	},
}

type hostWrap { host fs.Host } implements hostBox

func Get(w hostWrap) fs.Host { w.host }

type hostFSLockOps {
	host fs.Host,
} implements locks.LockOps

func CreateExclusive(l hostFSLockOps, lockPath string) fails locks.LockHeld | locks.PathInvalid {
	let exists = fs.Lstat(l.host, lockPath) catch {
	case fs.NotFound:
		fs.Info{Name: "", Size: 0, Dir: false, Perm: 0}
	case fs.Denied as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Path}
	case fs.Failed as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Reason}
	}
	if exists.Name != "" {
		return locks.LockHeld{Path: lockPath}
	}
	fs.WriteFile(l.host, lockPath, "") catch {
	case fs.NotFound as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Path}
	case fs.Denied as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Path}
	case fs.Failed as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Reason}
	}
}

func WriteLock(l hostFSLockOps, lockPath string, data string) fails locks.NotHeld | locks.PathInvalid {
	let _ = fs.Lstat(l.host, lockPath) catch {
	case fs.NotFound:
		return locks.NotHeld{Path: lockPath}
	case fs.Denied as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Path}
	case fs.Failed as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Reason}
	}
	fs.WriteFile(l.host, lockPath, data) catch {
	case fs.NotFound:
		return locks.NotHeld{Path: lockPath}
	case fs.Denied as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Path}
	case fs.Failed as e:
		return locks.PathInvalid{Path: lockPath, Reason: e.Reason}
	}
}

func SyncFile(_ hostFSLockOps, _ string) fails locks.SyncFailed {
}

func RenamePublish(l hostFSLockOps, lockPath string, targetPath string) fails locks.PublishFailed {
	fs.Rename(l.host, lockPath, targetPath) catch {
	case fs.NotFound as e:
		return locks.PublishFailed{Path: targetPath, Reason: e.Path}
	case fs.Denied as e:
		return locks.PublishFailed{Path: targetPath, Reason: e.Path}
	case fs.Failed as e:
		return locks.PublishFailed{Path: targetPath, Reason: e.Reason}
	case fs.CrossDevice as e:
		return locks.PublishFailed{Path: targetPath, Reason: e.To}
	}
}

func RemoveLock(l hostFSLockOps, lockPath string) fails locks.NotHeld {
	fs.Remove(l.host, lockPath) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return locks.NotHeld{Path: lockPath}
	}
}

func SyncDir(_ hostFSLockOps, _ string) fails locks.DirSyncUncertain {
}

func ReadTarget(l hostFSLockOps, targetPath string) option.Option[string] {
	let data = fs.ReadFile(l.host, targetPath) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return option.None
	}
	option.Some[string]{Value: data}
}

func LockExists(l hostFSLockOps, lockPath string) bool {
	let _ = fs.Lstat(l.host, lockPath) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	true
}

let onOracleWithHost = context needs fstest.TestAmbient {
	exec.Runner:     exec.NewTestHost().InheritEnv(exec.PathOf(os.NewTestHost().Environ())),
	fs.Files:        fs.NewTestHost(),
	fs.Writes:       fs.NewTestHost(),
	os.Process:      os.NewTestHost(),
	oracle.Symlinks: oracle.NewHostSymlinks(fs.NewTestHost()),
	locks.LockOps:   hostFSLockOps{host: fs.NewTestHost()},
	hostBox:         hostWrap{host: fs.NewTestHost()},
}

test WriteIndexAndWriteTreeMatchGit {
	with onOracleWithHost {
		let pathEnv = exec.PathOf(os.Process.Environ())
		let cwd = try os.Process.Getwd()
		let host = hostBox.Get()
		try verifyFormatWriteIndex(cwd, oracle.Sha1, oid.Sha1, pathEnv, host)
		try verifyFormatWriteIndex(cwd, oracle.Sha256, oid.Sha256, pathEnv, host)
	}
}
