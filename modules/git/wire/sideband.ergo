import option
import slices
import strings

// EncodeSidebandFrame wraps a SidebandFrame with its 1-byte channel prefix
// (`1` = pack, `2` = progress, `3` = error) into a pkt-line Data packet.
func EncodeSidebandFrame(frame SidebandFrame) Packet fails PacketTooLarge {
	let (ch, body) = match frame {
	case BandPack as p:
		(byte(1), p.Data)
	case BandProgress as m:
		(byte(2), m.Message.Bytes())
	case BandError as e:
		(byte(3), e.Message.Bytes())
	}
	if body.Len() > MaxSidebandPayload {
		return PacketTooLarge{Size: body.Len() + 1, Max: MaxPktPayload}
	}
	let mut payload = slices.WithCapacity[byte](body.Len() + 1)
	payload = payload.Append(ch)
	payload = slices.AppendAll(payload, body)
	Data{Payload: payload}
}

// EncodeSidebandPack splits packBytes into one or more sideband-64k channel-1
// Data packets each carrying at most MaxSidebandPayload bytes.
func EncodeSidebandPack(packBytes []byte) []Packet {
	let mut out = []Packet{}
	let total = packBytes.Len()
	let mut pos = 0
	for pos < total {
		let rem = total - pos
		let chunkLen = if rem > MaxSidebandPayload { MaxSidebandPayload } else { rem }
		let mut payload = slices.WithCapacity[byte](chunkLen + 1)
		payload = payload.Append(byte(1))
		for i in 0..chunkLen {
			payload = payload.Append(packBytes[pos+i])
		}
		out = out.Append(Data{Payload: payload})
		pos = pos + chunkLen
	}
	out
}

// DecodeSidebandFrame decodes one pkt-line Data packet as a sideband-64k frame,
// returning option.None for control packets (Flush/Delim/ResponseEnd) and
// rejecting empty payloads or channels outside 1..3 with InvalidSidebandChannel.
func DecodeSidebandFrame(pkt Packet) option.Option[SidebandFrame] fails InvalidSidebandChannel {
	match pkt {
	case Flush, Delim, ResponseEnd:
		option.None
	case Data as d:
		if d.Payload.Len() == 0 {
			return InvalidSidebandChannel{Channel: byte(0)}
		}
		let ch = d.Payload[0]
		let body = d.Payload[1:]
		if ch == byte(1) {
			return option.Some[SidebandFrame]{Value: BandPack{Data: body}}
		}
		if ch == byte(2) {
			return option.Some[SidebandFrame]{Value: BandProgress{Message: body.Text()}}
		}
		if ch == byte(3) {
			return option.Some[SidebandFrame]{Value: BandError{Message: body.Text()}}
		}
		return InvalidSidebandChannel{Channel: ch}
	}
}

// DemuxSideband demultiplexes a sequence of sideband-64k packets into
// concatenated pack bytes and progress messages, failing closed immediately
// with RemoteError whenever channel 3 (BandError) is encountered.
func DemuxSideband(pkts []Packet) SidebandResult fails InvalidSidebandChannel | RemoteError {
	let mut packOut = []byte{}
	let mut progress = []string{}
	for pkt in pkts {
		match try DecodeSidebandFrame(pkt) {
		case option.None:
		case option.Some[SidebandFrame] as f:
			match f.Value {
			case BandPack as p:
				packOut = slices.AppendAll(packOut, p.Data)
			case BandProgress as m:
				progress = progress.Append(m.Message)
			case BandError as e:
				return RemoteError{Message: strings.TrimRight(e.Message, "\r\n")}
			}
		}
	}
	SidebandResult{
		PackData: packOut,
		Progress: progress,
	}
}
