import slices

// MemoryIndex is an in-memory provider of IndexReader maintaining staged
// entries in canonical (Path, Stage) order without overwriting distinct stages
// of the same path.
type MemoryIndex {
	entries []Entry,
} implements IndexReader

// NewMemoryIndex builds a MemoryIndex from raw entries, sorting by (Path, Stage)
// and deduplicating identical (Path, Stage) pairs while preserving distinct stages.
func NewMemoryIndex(raw []Entry) MemoryIndex {
	let sorted = slices.SortFunc(raw, compareEntries)
	let mut dedup = slices.WithCapacity[Entry](len(sorted))
	for e in sorted {
		if len(dedup) == 0 || comparePathStage(dedup[len(dedup)-1].Path, dedup[len(dedup)-1].Stage, e.Path, e.Stage) != 0 {
			dedup = dedup.Append(e)
		}
	}
	MemoryIndex{entries: dedup}
}

// Entries implements IndexReader.Entries on MemoryIndex.
func Entries(m MemoryIndex) []Entry {
	m.entries
}

// Lookup implements IndexReader.Lookup on MemoryIndex.
func Lookup(m MemoryIndex, path string, stage int) Option[Entry] {
	let mut lo = 0
	let mut hi = len(m.entries)
	for _ in 0..64 {
		if lo >= hi {
			break
		}
		let mid = lo + (hi-lo)/2
		let cmp = comparePathStage(m.entries[mid].Path, m.entries[mid].Stage, path, stage)
		if cmp == 0 {
			return Some[Entry]{Value: m.entries[mid]}
		}
		if cmp < 0 {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	None
}

// LookupAllStages implements IndexReader.LookupAllStages on MemoryIndex.
func LookupAllStages(m MemoryIndex, path string) []Entry {
	let mut out = []Entry{}
	for e in m.entries {
		if e.Path == path {
			out = out.Append(e)
		}
	}
	out
}
