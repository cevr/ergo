import strings

// splitNul splits raw on NUL bytes, dropping the final trailing empty segment
// when raw ends with a NUL terminator.
func splitNul(raw string) []string {
	if raw == "" {
		return []string{}
	}
	let parts = strings.Split(raw, "\x00")
	if strings.HasSuffix(raw, "\x00") {
		return parts[:len(parts)-1]
	}
	parts
}

// ParseLsTreeZ parses NUL-delimited `git ls-tree -r -z --full-tree` output
// (`<mode> SP <kind> SP <oid> TAB <path> NUL`) into typed TreeEntry records.
func ParseLsTreeZ(raw string) []TreeEntry {
	let records = splitNul(raw)
	let mut out = []TreeEntry{}
	for rec in records {
		if rec == "" {
			continue
		}
		let tab = strings.IndexByte(rec, '\t')
		if tab <= 0 {
			continue
		}
		let meta = rec[:tab]
		let path = rec[tab+1:]
		let sp1 = strings.IndexByte(meta, ' ')
		if sp1 <= 0 {
			continue
		}
		let mode = meta[:sp1]
		let rest = meta[sp1+1:]
		let sp2 = strings.IndexByte(rest, ' ')
		if sp2 <= 0 {
			continue
		}
		let kind = rest[:sp2]
		let oid = rest[sp2+1:]
		out = out.Append(TreeEntry{Mode: mode, Kind: kind, Oid: oid, Path: path})
	}
	out
}

// ParseStatusZ parses `git status --porcelain=v1 -z` output into typed
// StatusEntry records, handling NUL-delimited rename/copy source paths.
func ParseStatusZ(raw string) []StatusEntry {
	let records = splitNul(raw)
	let mut out = []StatusEntry{}
	let mut i = 0
	for i < len(records) {
		let rec = records[i]
		if len(rec) < 4 {
			i = i + 1
			continue
		}
		let idx = rec[:1]
		let wrk = rec[1:2]
		let path = rec[3:]
		let mut orig = ""
		if (idx == "R" || idx == "C" || wrk == "R" || wrk == "C") && i+1 < len(records) {
			orig = records[i+1]
			i = i + 2
		} else {
			i = i + 1
		}
		out = out.Append(StatusEntry{IndexCode: idx, WorkCode: wrk, Path: path, OrigPath: orig})
	}
	out
}

// ParseForEachRefZ parses NUL-delimited triples emitted by
// `git for-each-ref --format=%(refname)%00%(objectname)%00%(symref)%00`.
func ParseForEachRefZ(raw string) []RefEntry {
	let fields = splitNul(raw)
	let mut out = []RefEntry{}
	let mut i = 0
	for i+2 < len(fields) {
		out = out.Append(RefEntry{
			Name:   fields[i],
			Oid:    fields[i+1],
			Target: fields[i+2],
		})
		i = i + 3
	}
	out
}

// ParseReflogZ parses NUL-delimited triples emitted by
// `git reflog show --format=%H%x00%gd%x00%gs%x00`.
func ParseReflogZ(raw string) []ReflogEntry {
	let fields = splitNul(raw)
	let mut out = []ReflogEntry{}
	let mut i = 0
	for i+2 < len(fields) {
		out = out.Append(ReflogEntry{
			Oid:      fields[i],
			Selector: fields[i+1],
			Subject:  fields[i+2],
		})
		i = i + 3
	}
	out
}

// ParseCommitMetaZ parses NUL-delimited HEAD commit metadata emitted by
// `git show -s --format=%an%x00%ae%x00%at%x00%cn%x00%ce%x00%ct%x00 HEAD`.
func ParseCommitMetaZ(raw string) (string, string, int64, string, string, int64) {
	let fields = splitNul(raw)
	if len(fields) < 6 {
		return ("", "", int64(0), "", "", int64(0))
	}
	(
		fields[0],
		fields[1],
		parseInt64(fields[2]),
		fields[3],
		fields[4],
		parseInt64(fields[5]),
	)
}

func parseInt64(s string) int64 {
	let trimmed = strings.TrimSpace(s)
	if trimmed == "" {
		return int64(0)
	}
	let mut neg = false
	let mut start = 0
	if trimmed[0] == byte('-') {
		neg = true
		start = 1
	}
	let mut acc = int64(0)
	for i in start..len(trimmed) {
		let ch = trimmed[i]
		if ch < byte('0') || ch > byte('9') {
			return int64(0)
		}
		acc = acc*int64(10) + int64(ch-byte('0'))
	}
	if neg {
		return -acc
	}
	acc
}
