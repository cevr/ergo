import exec
import strconv
import strings

// BaseEpoch is the fixed UTC epoch (2023-11-14T22:13:20Z) used as step 0 for
// deterministic C Git author and committer timestamps.
let BaseEpoch int64 = int64(1700000000)

// StepSeconds is the deterministic timestamp stride between consecutive steps.
let StepSeconds int64 = int64(60)

// OracleAuthorName is the fixed author identity set in HermeticEnv.
let OracleAuthorName = "Oracle Author"

// OracleAuthorEmail is the fixed author email set in HermeticEnv.
let OracleAuthorEmail = "oracle@example.test"

// OracleCommitterName is the fixed committer identity set in HermeticEnv.
let OracleCommitterName = "Oracle Committer"

// OracleCommitterEmail is the fixed committer email set in HermeticEnv.
let OracleCommitterEmail = "oracle@example.test"

// StepEpoch returns the deterministic UTC timestamp for zero-based step index.
func StepEpoch(stepIndex int) int64 {
	BaseEpoch + int64(stepIndex+1)*StepSeconds
}

func isolateGitConfig(base Map[string, string]) Map[string, string] {
	let mut env = exec.PathOf(base)
	env["GIT_CONFIG_NOSYSTEM"] = "1"
	env["GIT_CONFIG_GLOBAL"] = "/dev/null"
	env["GIT_CONFIG_SYSTEM"] = "/dev/null"
	env["GIT_ATTR_NOSYSTEM"] = "1"
	env["GIT_TERMINAL_PROMPT"] = "0"
	env["LC_ALL"] = "C"
	env["TZ"] = "UTC"
	env["GIT_CONFIG_COUNT"] = "7"
	env["GIT_CONFIG_KEY_0"] = "core.hooksPath"
	env["GIT_CONFIG_VALUE_0"] = "/dev/null"
	env["GIT_CONFIG_KEY_1"] = "init.defaultBranch"
	env["GIT_CONFIG_VALUE_1"] = "main"
	env["GIT_CONFIG_KEY_2"] = "core.attributesFile"
	env["GIT_CONFIG_VALUE_2"] = "/dev/null"
	env["GIT_CONFIG_KEY_3"] = "core.excludesFile"
	env["GIT_CONFIG_VALUE_3"] = "/dev/null"
	env["GIT_CONFIG_KEY_4"] = "core.autocrlf"
	env["GIT_CONFIG_VALUE_4"] = "false"
	env["GIT_CONFIG_KEY_5"] = "core.quotepath"
	env["GIT_CONFIG_VALUE_5"] = "false"
	env["GIT_CONFIG_KEY_6"] = "advice.detachedHead"
	env["GIT_CONFIG_VALUE_6"] = "false"
	env
}

// HermeticEnv builds the exact minimal environment passed to C Git: only PATH
// is taken from pathEnv, all user/system config and attributes are disabled,
// locale/timezone are pinned to C/UTC, author/committer identities and fixed
// timestamps are set explicitly, and core overrides disable hooks, autocrlf,
// quotepath, external attributes, and external excludes.
func HermeticEnv(pathEnv Map[string, string], epoch int64) Map[string, string] {
	let mut env = isolateGitConfig(pathEnv)
	env["GIT_AUTHOR_NAME"] = OracleAuthorName
	env["GIT_AUTHOR_EMAIL"] = OracleAuthorEmail
	env["GIT_COMMITTER_NAME"] = OracleCommitterName
	env["GIT_COMMITTER_EMAIL"] = OracleCommitterEmail
	let date = strconv.FormatInt(epoch, 10) + " +0000"
	env["GIT_AUTHOR_DATE"] = date
	env["GIT_COMMITTER_DATE"] = date
	env
}

// GitCommand builds an exec.Command running C Git in dir under HermeticEnv.
func GitCommand(dir string, args []string, pathEnv Map[string, string], epoch int64) exec.Command {
	exec.Command{
		Name:  "git",
		Args:  args,
		Env:   HermeticEnv(pathEnv, epoch),
		Dir:   dir,
		Stdin: "",
		Grace: 0s,
	}
}

// ClassifyGitFailure maps a non-zero C Git exit status and diagnostic text
// into the closed OracleError union so callers compare typed error classes.
func ClassifyGitFailure(op string, target string, status int, stderr string) OracleError {
	let lower = strings.ToLower(stderr)
	if strings.Contains(lower, "ambiguous") {
		return Ambiguous{Target: target}
	}
	if strings.Contains(lower, "corrupt") || strings.Contains(lower, "bad object") || strings.Contains(lower, "invalid object") {
		return Corrupt{Target: target}
	}
	if strings.Contains(lower, "not a valid ref") || strings.Contains(lower, "invalid reference") || strings.Contains(lower, "is not a valid branch name") {
		return InvalidRef{Ref: target}
	}
	if strings.Contains(lower, "conflict") || strings.Contains(lower, "automatic merge failed") {
		return Conflict{Path: target}
	}
	if strings.Contains(lower, "needed a single revision") || strings.Contains(lower, "not a valid object name") || strings.Contains(lower, "unknown revision") || strings.Contains(lower, "does not exist") || strings.Contains(lower, "pathspec") {
		return Missing{Target: target}
	}
	CommandFailed{Op: op, Status: status}
}
