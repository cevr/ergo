import exec
import filepath
import fs
import fstest
import option
import os
import strings
import github.com/cevr/ergo/modules/git/delta
import github.com/cevr/ergo/modules/git/locks
import github.com/cevr/ergo/modules/git/oid
import github.com/cevr/ergo/modules/git/oracle
import github.com/cevr/ergo/modules/git/pack
import github.com/cevr/ergo/modules/git/refs
import github.com/cevr/ergo/modules/git/root

let onMemorySha1 = context {
	RefWriter: NewMemoryRefWriter(oid.Sha1),
}

let onMemorySha256 = context {
	RefWriter: NewMemoryRefWriter(oid.Sha256),
}

let onDiskSha1 = context fails pack.Corrupt | pack.MismatchedPair | pack.IOFailed needs fstest.TestAmbient {
	RefWriter: try makeLawDiskRefWriter(filepath.Join([]string{fstest.TestFolder(), "law-disk-wref"}), fs.NewTestHost()),
}

func makeLawDiskRefWriter(gitDir string, host fs.Host) DiskRefWriter fails pack.Corrupt | pack.MismatchedPair | pack.IOFailed {
	let objDir = filepath.Join([]string{gitDir, "objects"})
	fs.MkdirAll(host, filepath.Join([]string{gitDir, "refs", "heads"})) catch {
	case fs.Denied, fs.Failed:
	}
	fs.MkdirAll(host, objDir) catch {
	case fs.Denied, fs.Failed:
	}
	let odb = with context { fs.Files: host } {
		try pack.Open(oid.Sha1, objDir, []string{}, delta.DefaultLimits())
	}
	NewDiskRefWriter(refs.NewStore(oid.Sha1, gitDir, gitDir), pack.NewDiskODB(odb, host), host)
}

type testFail {
	reason string,
}

func runGitOk(dir string, args []string, stdin string, pathEnv Map[string, string], step int) string fails testFail | exec.NotFound | exec.Denied | exec.Failed needs exec.Runner {
	let base = oracle.GitCommand(dir, args, pathEnv, oracle.StepEpoch(step))
	let cmd = if stdin == "" { base } else { exec.WithStdin(base, stdin) }
	let res = try exec.Runner.Run(cmd)
	if res.Status != 0 {
		return testFail{reason: "git failed: " + res.Stderr}
	}
	res.Stdout
}

func verifyFormatWRef(cwd string, oFmt oracle.OidFormat, fmt oid.Format, pathEnv Map[string, string], host fs.Host) fails testFail | InvalidRefName | PathEscape | StaleExpected | ObjectMissing | DirectoryFileConflict | LockHeld | LockFailed | IOFailed | pack.Corrupt | pack.MismatchedPair | pack.IOFailed | oid.BadHex | oid.WrongLength | oid.Collision | root.NotARepository | root.BadGitDirFile | root.BadCommonDir | root.UnsupportedVersion | root.UnsupportedExtension | root.UntrustedPath | root.PathEscape | root.AlternateCycle | root.AlternateDepthExceeded | root.ConfigSyntax | root.ConfigBadValue | root.IncludeCycle | root.IncludeDepthExceeded | root.IncludeRefused | oracle.Missing | oracle.Corrupt | oracle.Ambiguous | oracle.InvalidRef | oracle.Conflict | oracle.CommandFailed | exec.NotFound | exec.Denied | exec.Failed | fs.NotFound | fs.Denied | fs.Failed needs exec.Runner | fs.Files | fs.Writes | locks.LockOps {
	let label = oracle.FormatName(oFmt)
	let repoDir = try oracle.InitRepo(filepath.Join([]string{cwd, "wref-" + label}), oracle.RepoSpec{Format: oFmt, Layout: oracle.Normal, DefaultBranch: "main"}, pathEnv, oracle.BaseEpoch)

	try fs.Writes.WriteFile(filepath.Join([]string{repoDir, "a.txt"}), "v1\n")
	let _ = try runGitOk(repoDir, []string{"add", "a.txt"}, "", pathEnv, 1)
	let _ = try runGitOk(repoDir, []string{"commit", "-q", "-m", "commit 1"}, "", pathEnv, 2)
	let c1Hex = strings.TrimSpace(try runGitOk(repoDir, []string{"rev-parse", "HEAD"}, "", pathEnv, 3))

	try fs.Writes.WriteFile(filepath.Join([]string{repoDir, "a.txt"}), "v2\n")
	let _ = try runGitOk(repoDir, []string{"add", "a.txt"}, "", pathEnv, 4)
	let _ = try runGitOk(repoDir, []string{"commit", "-q", "-m", "commit 2"}, "", pathEnv, 5)
	let c2Hex = strings.TrimSpace(try runGitOk(repoDir, []string{"rev-parse", "HEAD"}, "", pathEnv, 6))

	let c1 = try oid.ParseHex(fmt, c1Hex)
	let c2 = try oid.ParseHex(fmt, c2Hex)
	let missingId = try oid.HashObject(fmt, oid.Commit, "not-written-to-odb".Bytes())

	let layout = try root.Discover(repoDir, root.DiscoverOptions{CeilingDirs: []string{cwd}, Trust: root.ConfinedTrust(cwd)})
	let refStore = refs.FromLayout(layout)
	let odb = try pack.FromLayout(layout)
	let diskOdb = pack.NewDiskODB(odb, host)

	let ident = ReflogIdentity{Name: "Oracle Author", Email: "oracle@example.com", Epoch: int64(1700000100), Offset: "+0000"}

	with context { pack.ObjectStore: diskOdb } {
		try UpdateRef(refStore, "refs/heads/feature", c1, option.None, option.Some[ReflogSpec]{Value: ReflogSpec{Ident: ident, Message: "branch: created feature"}}, locks.Durable)
		let got1 = strings.TrimSpace(try runGitOk(repoDir, []string{"rev-parse", "refs/heads/feature"}, "", pathEnv, 7))
		if got1 != c1Hex {
			return testFail{reason: "git rev-parse mismatch after create: got \(got1), want \(c1Hex)"}
		}

		let mut sawDupCreate = false
		UpdateRef(refStore, "refs/heads/feature", c2, option.None, option.None, locks.Durable) catch {
		case StaleExpected:
			sawDupCreate = true
		case InvalidRefName, PathEscape, ObjectMissing, DirectoryFileConflict, LockHeld, LockFailed, IOFailed:
		}
		if !sawDupCreate {
			return testFail{reason: "create-only UpdateRef should fail StaleExpected when ref exists"}
		}

		let mut sawStale = false
		UpdateRef(refStore, "refs/heads/feature", c2, option.Some[oid.OID]{Value: c2}, option.None, locks.Durable) catch {
		case StaleExpected:
			sawStale = true
		case InvalidRefName, PathEscape, ObjectMissing, DirectoryFileConflict, LockHeld, LockFailed, IOFailed:
		}
		if !sawStale {
			return testFail{reason: "CAS UpdateRef did not reject stale expected OID"}
		}
		if locks.LockOps.LockExists(filepath.Join([]string{layout.CommonDir, "refs", "heads", "feature.lock"})) {
			return testFail{reason: "stale CAS left .lock behind"}
		}

		let mut sawMissing = false
		UpdateRef(refStore, "refs/heads/broken", missingId, option.None, option.None, locks.Durable) catch {
		case ObjectMissing as e:
			sawMissing = oid.Equal(e.OID, missingId)
		case InvalidRefName, PathEscape, StaleExpected, DirectoryFileConflict, LockHeld, LockFailed, IOFailed:
		}
		if !sawMissing {
			return testFail{reason: "UpdateRef allowed pointing ref to missing OID"}
		}

		let mut sawDF = false
		UpdateRef(refStore, "refs/heads/feature/child", c1, option.None, option.None, locks.Durable) catch {
		case DirectoryFileConflict:
			sawDF = true
		case InvalidRefName, PathEscape, StaleExpected, ObjectMissing, LockHeld, LockFailed, IOFailed:
		}
		if !sawDF {
			return testFail{reason: "UpdateRef did not reject D/F conflict refs/heads/feature/child"}
		}

		try UpdateRef(refStore, "refs/heads/feature", c2, option.Some[oid.OID]{Value: c1}, option.Some[ReflogSpec]{Value: ReflogSpec{Ident: ident, Message: "fast-forward to c2"}}, locks.Durable)
		let got2 = strings.TrimSpace(try runGitOk(repoDir, []string{"rev-parse", "refs/heads/feature"}, "", pathEnv, 8))
		if got2 != c2Hex {
			return testFail{reason: "git rev-parse mismatch after CAS update"}
		}
		let reflogOut = try runGitOk(repoDir, []string{"reflog", "show", "refs/heads/feature"}, "", pathEnv, 9)
		if !strings.Contains(reflogOut, "fast-forward to c2") || !strings.Contains(reflogOut, "branch: created feature") {
			return testFail{reason: "git reflog missing appended entries: " + reflogOut}
		}

		try UpdateSymbolicRef(refStore, "HEAD", "refs/heads/feature", option.None, locks.Durable)
		let symOut = strings.TrimSpace(try runGitOk(repoDir, []string{"symbolic-ref", "HEAD"}, "", pathEnv, 10))
		if symOut != "refs/heads/feature" {
			return testFail{reason: "git symbolic-ref HEAD mismatch: " + symOut}
		}
		try UpdateSymbolicRef(refStore, "HEAD", "refs/heads/main", option.None, locks.Durable)

		let mut sawBatchAbort = false
		let _ = PrepareBatch(refStore, []BatchOp{
			BatchOp{RefName: "refs/heads/batch-ok", Kind: SetDirect{NewOID: c1, Expected: option.None}, Log: option.None},
			BatchOp{RefName: "refs/heads/feature", Kind: SetDirect{NewOID: c1, Expected: option.Some[oid.OID]{Value: c1}}, Log: option.None},
		}, locks.Durable) catch {
		case StaleExpected:
			sawBatchAbort = true
			PreparedBatch{format: fmt, commonDir: layout.CommonDir, gitDir: layout.GitDir, mode: locks.Durable, entries: []preparedEntry{}, deletes: []string{}}
		case InvalidRefName, PathEscape, ObjectMissing, DirectoryFileConflict, LockHeld, LockFailed, IOFailed:
			PreparedBatch{format: fmt, commonDir: layout.CommonDir, gitDir: layout.GitDir, mode: locks.Durable, entries: []preparedEntry{}, deletes: []string{}}
		}
		if !sawBatchAbort {
			return testFail{reason: "PrepareBatch did not fail StaleExpected on second op"}
		}
		if locks.LockOps.LockExists(filepath.Join([]string{layout.CommonDir, "refs", "heads", "batch-ok.lock"})) {
			return testFail{reason: "PrepareBatch leaked first op lock on failure"}
		}
		let batchStillAbsent = try readCurrentDirectOID(refStore, "refs/heads/batch-ok")
		if batchStillAbsent != option.None {
			return testFail{reason: "PrepareBatch mutated first ref despite second op failing"}
		}

		let _ = try runGitOk(repoDir, []string{"pack-refs", "--all"}, "", pathEnv, 11)
		try DeleteRef(refStore, "refs/heads/feature", c2, locks.Durable)
		let afterDel = try readCurrentDirectOID(refStore, "refs/heads/feature")
		if afterDel != option.None {
			return testFail{reason: "DeleteRef failed to remove packed ref refs/heads/feature"}
		}
		let _ = try runGitOk(repoDir, []string{"fsck", "--strict"}, "", pathEnv, 12)
	}
}

type hostBox {
	Get() fs.Host,

	// HostReadable: test host can read current directory.
	law HostReadable() {
		let h = Get()
		let _ = fs.ReadDir(h, ".") catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			return false
		}
		true
	},
}

type hostWrap { host fs.Host } implements hostBox

func Get(w hostWrap) fs.Host { w.host }

let onOracleWithHost = context needs fstest.TestAmbient {
	exec.Runner:   exec.NewTestHost().InheritEnv(exec.PathOf(os.NewTestHost().Environ())),
	fs.Files:      fs.NewTestHost(),
	fs.Writes:     fs.NewTestHost(),
	os.Process:    os.NewTestHost(),
	locks.LockOps: NewFSLockOps(fs.NewTestHost()),
	hostBox:       hostWrap{host: fs.NewTestHost()},
}

test CASRefUpdatesAndReflogMatchGit {
	with onOracleWithHost {
		let pathEnv = exec.PathOf(os.Process.Environ())
		let cwd = try os.Process.Getwd()
		let host = hostBox.Get()
		try verifyFormatWRef(cwd, oracle.Sha1, oid.Sha1, pathEnv, host)
		try verifyFormatWRef(cwd, oracle.Sha256, oid.Sha256, pathEnv, host)
	}
}
