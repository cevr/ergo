import filepath
import strings

func stripUnescapedTrailingSpaces(line string) string {
	let bs = line.Bytes()
	let mut end = len(bs)
	for end > 0 && bs[end-1] == byte(' ') {
		if end >= 2 && bs[end-2] == byte('\\') {
			break
		}
		end = end - 1
	}
	let mut out = []byte{}
	let mut i = 0
	for i < end {
		if bs[i] == byte('\\') && i+1 < end && bs[i+1] == byte(' ') {
			out = out.Append(byte(' '))
			i = i + 2
			continue
		}
		out = out.Append(bs[i])
		i = i + 1
	}
	out.Text()
}

// ParseGitignore parses lines of a `.gitignore` or `.git/info/exclude` file
// rooted at baseDir (empty string for repository root) into ordered IgnoreRules.
func ParseGitignore(baseDir string, content string) []IgnoreRule {
	let mut rules = []IgnoreRule{}
	let cleanBase = if baseDir == "" || baseDir == "." { "" } else { strings.TrimSuffix(baseDir, "/") }
	for rawLine in strings.Split(content, "\n") {
		let noCr = strings.TrimSuffix(rawLine, "\r")
		if noCr == "" {
			continue
		}
		let trimmed = stripUnescapedTrailingSpaces(noCr)
		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
			continue
		}
		let mut pat = trimmed
		let mut negated = false
		if strings.HasPrefix(pat, "!") {
			negated = true
			pat = pat[1:]
		}
		if strings.HasPrefix(pat, "\\#") || strings.HasPrefix(pat, "\\!") {
			pat = pat[1:]
		}
		let mut dirOnly = false
		if strings.HasSuffix(pat, "/") {
			dirOnly = true
			pat = strings.TrimSuffix(pat, "/")
		}
		if pat == "" {
			continue
		}
		let mut anchored = false
		if strings.HasPrefix(pat, "/") {
			anchored = true
			pat = pat[1:]
		} else if strings.Contains(pat, "/") {
			anchored = true
		}
		if pat == "" {
			continue
		}
		rules = rules.Append(IgnoreRule{
			BaseDir:  cleanBase,
			Pattern:  pat,
			Negated:  negated,
			DirOnly:  dirOnly,
			Anchored: anchored,
		})
	}
	rules
}

func matchCharClass(pb []byte, pStart int, ch byte) (bool, int) {
	let n = len(pb)
	let mut i = pStart + 1
	if i >= n {
		return (false, pStart)
	}
	let mut negate = false
	if pb[i] == byte('!') || pb[i] == byte('^') {
		negate = true
		i = i + 1
	}
	let mut matched = false
	let mut first = true
	for i < n {
		if !first && pb[i] == byte(']') {
			let ok = if negate { !matched } else { matched }
			return (ok, i + 1)
		}
		first = false
		let lo = pb[i]
		if i+2 < n && pb[i+1] == byte('-') && pb[i+2] != byte(']') {
			let hi = pb[i+2]
			if ch >= lo && ch <= hi {
				matched = true
			}
			i = i + 3
		} else {
			if ch == lo {
				matched = true
			}
			i = i + 1
		}
	}
	(false, pStart)
}

func globMatchBytes(pb []byte, pi int, sb []byte, si int) bool {
	let pn = len(pb)
	let sn = len(sb)
	if pi == pn {
		return si == sn
	}
	if pi+2 < pn && pb[pi] == byte('*') && pb[pi+1] == byte('*') && pb[pi+2] == byte('/') {
		if globMatchBytes(pb, pi+3, sb, si) {
			return true
		}
		let mut k = si
		for k < sn {
			if sb[k] == byte('/') {
				if globMatchBytes(pb, pi+3, sb, k+1) {
					return true
				}
			}
			k = k + 1
		}
		return false
	}
	if pi+1 < pn && pb[pi] == byte('*') && pb[pi+1] == byte('*') && pi+2 == pn {
		return true
	}
	if pb[pi] == byte('*') {
		if globMatchBytes(pb, pi+1, sb, si) {
			return true
		}
		let mut k = si
		for k < sn && sb[k] != byte('/') {
			k = k + 1
			if globMatchBytes(pb, pi+1, sb, k) {
				return true
			}
		}
		return false
	}
	if si >= sn {
		return false
	}
	if pb[pi] == byte('?') {
		if sb[si] == byte('/') {
			return false
		}
		return globMatchBytes(pb, pi+1, sb, si+1)
	}
	if pb[pi] == byte('[') {
		if sb[si] == byte('/') {
			return false
		}
		let (ok, nextPi) = matchCharClass(pb, pi, sb[si])
		if nextPi > pi {
			if !ok {
				return false
			}
			return globMatchBytes(pb, nextPi, sb, si+1)
		}
	}
	if pb[pi] == byte('\\') && pi+1 < pn {
		if sb[si] != pb[pi+1] {
			return false
		}
		return globMatchBytes(pb, pi+2, sb, si+1)
	}
	if pb[pi] != sb[si] {
		return false
	}
	globMatchBytes(pb, pi+1, sb, si+1)
}

func globMatch(pattern string, text string) bool {
	globMatchBytes(pattern.Bytes(), 0, text.Bytes(), 0)
}

func ruleMatchesPath(rule IgnoreRule, relPath string, isDir bool) bool {
	if rule.DirOnly && !isDir {
		return false
	}
	let mut sub = relPath
	if rule.BaseDir != "" {
		let prefix = rule.BaseDir + "/"
		if !strings.HasPrefix(relPath, prefix) {
			return false
		}
		sub = strings.TrimPrefix(relPath, prefix)
	}
	if rule.Anchored {
		globMatch(rule.Pattern, sub)
	} else {
		globMatch(rule.Pattern, filepath.Base(sub))
	}
}

// MatchIgnored evaluates ordered IgnoreRules (lowest to highest precedence)
// against relPath and reports whether relPath is ignored (last match wins).
func MatchIgnored(rules []IgnoreRule, relPath string, isDir bool) bool {
	let mut ignored = false
	for rule in rules {
		if ruleMatchesPath(rule, relPath, isDir) {
			if rule.Negated {
				ignored = false
			} else {
				ignored = true
			}
		}
	}
	ignored
}
