// The engine: a run in one mode, the Engine that provides a Kind in it,
// and the sweep. A program (or infra's CLI) runs a stack so:
//
//	let pass = infra.NewPass(infra.Applying)
//	let dirs = infra.Engine[DirProps, Dir]{Kind: "dir", Driver: driver, State: state, Pass: pass}
//	try infra.Begin(pass, lock, "runner", []infra.Sweeper{dirs})
//	try with context { infra.Kind[DirProps, Dir]: dirs } { Stack() }
//	try infra.Finish(pass, lock, "runner", []infra.Sweeper{dirs})
//
// A failure between Begin and Finish leaves the lock held, as a crash
// does: the rows say what was in flight, and the next run, once an
// operator broke the lock, takes them up (models/infra, CrashThenResume).

import sync

// Mode is what a run does: Planning records the steps and calls no host
// (a driver's Attrs gives the values); Refreshing is a plan that also
// reads each live object the stack ensures and records the drift (a
// driver's Read: it writes nothing); Applying runs the row's protocol.
type Mode = Planning{} | Refreshing{} | Applying{}

// Change is a step's: create an object, update its props, resume a row
// a crashed run left (creating or deleting) with these props, or delete
// an object the stack no longer wants. A refreshing plan adds Drifted (the
// object is not what its row says) and Gone (it is not there): it only
// reports them; an apply does not repair drift.
type Change = Create{} | Update{} | Resume{} | Delete{} | Drifted{} | Gone{}

// Step is one change a run made (Applying) or would make (Planning), in
// order.
type Step { Kind string, ID string, Change Change }

// Pass is one plan or apply of a stack: its mode, the steps so far, each
// object the stack ensured (by kind and id), and the next place in the
// order of creation. Its values are copies of one run.
type Pass {
	mode  Mode,
	steps sync.Ref[[]Step],
	seen  sync.Ref[Map[string, bool]],
	seq   sync.Ref[int],
}

// NewPass is a run in mode with no step.
func NewPass(mode Mode) Pass {
	Pass{mode: mode, steps: sync.NewRef([]Step{}), seen: sync.NewRef(Map[string, bool]{}), seq: sync.NewRef(1)}
}

// Steps is the steps of r so far.
func Steps(r Pass) []Step { r.steps.Get() }

// Engine provides the kind Kind of objects to a stack in run's mode,
// through its driver and its state store. It provides Kind[P, A] and
// Sweeper.
type Engine[P comparable, A comparable] {
	Kind   string,
	Driver Driver[P, A],
	State  State[P],
	Pass   Pass,
} implements Sweeper, Kind[P, A]

// keyOf names an object across kinds.
func keyOf(kind string, id string) string { kind + "/" + id }

// note adds a step to r.
func note(r Pass, s Step) { r.steps.Update(func(steps []Step) []Step { steps.Append(s) }) }

// ChangeOf is the change an Ensure of p makes to the object whose row is
// prior: none (None) when the row is live with p.
func ChangeOf[P comparable](prior Option[Row[P]], p P) Option[Change] {
	match prior {
	case None:
		Some[Change]{Value: Create}
	case Some[Row[P]] as r:
		if r.Value.Props != p {
			return Some[Change]{Value: Update}
		}
		match r.Value.Status {
		case Live:
			None
		case Creating, Deleting:
			Some[Change]{Value: Resume}
		}
	}
}

// Ensure is the object id with p, through the row's protocol when e's
// run applies: write the row creating (with p), call the driver's Apply,
// write the row live. A plan records the step and gives the driver's
// Attrs; so does an apply of an object whose row is live with p.
func Ensure[P comparable, A comparable](e Engine[P, A], id string, p P) A fails Failed {
	e.Pass.seen.Update(func(m Map[string, bool]) Map[string, bool] { m.Put(keyOf(e.Kind, id), true) })
	let prior = e.State.Get(id)
	let change = match ChangeOf(prior, p) {
	case None:
		match e.Pass.mode {
		case Refreshing:
			try refresh(e, id, p)
		case Planning, Applying:
		}
		return e.Driver.Attrs(id, p)
	case Some[Change] as c:
		c.Value
	}
	note(e.Pass, Step{Kind: e.Kind, ID: id, Change: change})
	match e.Pass.mode {
	case Refreshing:
		return e.Driver.Attrs(id, p)
	case Planning:
		return e.Driver.Attrs(id, p)
	case Applying:
	}
	let seq = match prior {
	case Some[Row[P]] as r:
		r.Value.Seq
	case None:
		sync.Modify(e.Pass.seq, func(n int) (int, int) { (n, n + 1) })
	}
	try e.State.Put(Row[P]{ID: id, Status: Creating, Props: p, Seq: seq})
	let a = try e.Driver.Apply(id, p)
	try e.State.Put(Row[P]{ID: id, Status: Live, Props: p, Seq: seq})
	a
}

// refresh records the drift of the object id, whose row is live with p:
// Gone when the driver reads nothing, Drifted when what it reads is not
// what Apply gave. It writes nothing.
func refresh[P comparable, A comparable](e Engine[P, A], id string, p P) fails Failed {
	match try e.Driver.Read(id) {
	case None:
		note(e.Pass, Step{Kind: e.Kind, ID: id, Change: Gone})
	case Some[A] as a:
		if a.Value != e.Driver.Attrs(id, p) {
			note(e.Pass, Step{Kind: e.Kind, ID: id, Change: Drifted})
		}
	}
}

// Leftover is a row the sweep deletes: its kind, its id and its place.
type Leftover { Kind string, ID string, Seq int }

// Listed is a row as infra's state command shows it, whatever its kind's
// props.
type Listed { Kind string, ID string, Status Status, Seq int }

// Sweeper is an engine as the sweep sees it, whatever its kind's types.
type Sweeper {
	// Leftovers is the rows of its kind whose object the run did not
	// ensure.
	Leftovers() []Leftover,
	// Sweep deletes the object id: in a plan it records the step.
	Sweep(id string) fails Failed,
	// Newest is the greatest Seq of its rows, 0 for none.
	Newest() int,
	// Rows is every row of its kind, in the store's order.
	Rows() []Listed,

	// NewestBoundsLeftovers: no leftover row is newer than Newest.
	law NewestBoundsLeftovers() {
		let newest = Newest()
		for l in Leftovers() {
			if l.Seq > newest {
				return false
			}
		}
		true
	},
}

func Leftovers[P comparable, A comparable](e Engine[P, A]) []Leftover {
	let seen = e.Pass.seen.Get()
	let mut out = []Leftover{}
	for r in e.State.List() {
		if seen.Get(keyOf(e.Kind, r.ID)) == None {
			out = out.Append(Leftover{Kind: e.Kind, ID: r.ID, Seq: r.Seq})
		}
	}
	out
}

// Sweep deletes the object id when e's run applies: write the row
// deleting, call the driver's Delete, remove the row.
func Sweep[P comparable, A comparable](e Engine[P, A], id string) fails Failed {
	let row = match e.State.Get(id) {
	case None:
		return
	case Some[Row[P]] as r:
		r.Value
	}
	note(e.Pass, Step{Kind: e.Kind, ID: id, Change: Delete})
	match e.Pass.mode {
	case Planning, Refreshing:
		return
	case Applying:
	}
	try e.State.Put(Row[P]{..row, Status: Deleting})
	try e.Driver.Delete(id)
	try e.State.Remove(id)
}

func Newest[P comparable, A comparable](e Engine[P, A]) int {
	let mut n = 0
	for r in e.State.List() {
		if r.Seq > n {
			n = r.Seq
		}
	}
	n
}

func Rows[P comparable, A comparable](e Engine[P, A]) []Listed {
	let mut out = []Listed{}
	for r in e.State.List() {
		out = out.Append(Listed{Kind: e.Kind, ID: r.ID, Status: r.Status, Seq: r.Seq})
	}
	out
}

// Begin starts run over the engines: an apply takes the lock for holder
// (it fails Held while another holds it), and the order of creation goes
// on after the newest row.
func Begin(pass Pass, lock Lock, holder string, engines []Sweeper) fails Held {
	match pass.mode {
	case Applying:
		try lock.Acquire(holder)
	case Planning, Refreshing:
	}
	let mut newest = 0
	for e in engines {
		if e.Newest() > newest {
			newest = e.Newest()
		}
	}
	pass.seq.Set(newest + 1)
}

// Finish ends run: the sweep deletes every object of the engines that the
// stack did not ensure, the newest first, and an apply then releases the
// lock. A failure leaves the lock held.
func Finish(pass Pass, lock Lock, holder string, engines []Sweeper) fails Failed {
	let mut left = []Owned{}
	for i, e in engines {
		for l in e.Leftovers() {
			left = insertNewestFirst(left, Owned{Engine: i, Row: l})
		}
	}
	for o in left {
		try engines[o.Engine].Sweep(o.Row.ID)
	}
	match pass.mode {
	case Applying:
		lock.Release(holder)
	case Planning, Refreshing:
	}
}

// Destroy deletes every object of the engines, the newest first: a run
// whose stack ensures nothing.
func Destroy(pass Pass, lock Lock, holder string, engines []Sweeper) fails Held | Failed {
	try Begin(pass, lock, holder, engines)
	try Finish(pass, lock, holder, engines)
}

// Owned is a leftover row and the index of its engine.
type Owned { Engine int, Row Leftover }

// insertNewestFirst is xs with o in place, xs being ordered by Seq from the
// greatest.
func insertNewestFirst(xs []Owned, o Owned) []Owned {
	let mut out = []Owned{}
	let mut placed = false
	for x in xs {
		if !placed && o.Row.Seq > x.Row.Seq {
			out = out.Append(o)
			placed = true
		}
		out = out.Append(x)
	}
	if !placed {
		out = out.Append(o)
	}
	out
}
