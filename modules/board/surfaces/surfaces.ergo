// CliPolicy returns the board CLI exit-code policy: 3 for Unauthenticated,
// 1 for every other domain refusal (and 2 for usage errors, enforced by boardcli.Run).
func CliPolicy() boardcli.Policy {
	boardcli.Policy{
		..boardcli.Defaults(),
		Code: func(f boardapi.Failure) int {
			match f {
			case boardapi.Unauthenticated:
				3
			case _:
				1
			}
		},
	}
}

// CheckToolDescriptions verifies that every tool description in names ends
// with board.DataNotice (spec section 5.1).
func CheckToolDescriptions(names []string, desc func(name string) string) []string {
	let mut bad = []string{}
	for name in names {
		let d = strings.TrimSpace(desc(name))
		if !strings.HasSuffix(d, board.DataNotice) {
			bad = bad.Append("\(name): missing mandatory data notice")
		}
	}
	bad
}

func scanSchemaProperties(tool string, path string, v json.Value, bad []string) []string {
	let mut out = bad
	match v {
	case json.Object as o:
		for m in o.Members {
			if m.Key == "properties" {
				match m.Value {
				case json.Object as props:
					for p in props.Members {
						let keyLower = strings.ToLower(p.Key)
						if keyLower == "as" || keyLower == "profile" {
							out = out.Append("\(tool): forbidden input property \(path)\(p.Key)")
						}
						out = scanSchemaProperties(tool, "\(path)\(p.Key).", p.Value, out)
					}
				case _:
				}
			} else {
				out = scanSchemaProperties(tool, path, m.Value, out)
			}
		}
	case json.Array as a:
		for elem in a.Items {
			out = scanSchemaProperties(tool, path, elem, out)
		}
	case _:
	}
	out
}

// CheckSchemaForbidsAsAndProfile recursively inspects a tool's JSON schema and
// reports any property named "as" or "profile" at any depth.
func CheckSchemaForbidsAsAndProfile(name string, schema json.Value) []string {
	scanSchemaProperties(name, "", schema, []string{})
}

func surfaceAdmins() []board.Principal {
	[]board.Principal{
		board.Principal{ID: "google:admin", Kind: board.Person, Handle: "admin", Email: "admin@example.com", Name: "Admin", Role: board.Admin, State: board.Active},
		board.Principal{ID: "google:alice", Kind: board.Person, Handle: "alice", Email: "alice@example.com", Name: "Alice", Role: board.Member, State: board.Active},
		board.Principal{ID: "google:bob", Kind: board.Person, Handle: "bob", Email: "bob@example.com", Name: "Bob", Role: board.Member, State: board.Active},
	}
}

