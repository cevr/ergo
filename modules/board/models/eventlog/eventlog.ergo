// The package eventlog is the design model of the board's event log, its
// cursors and wait (spec.md, Event log and cursor; machines.md, M3): a
// client that loops "wait after my cursor, keep the cursor it returns"
// misses no matching event and gets none twice, whatever is appended
// between two waits, between the scan and the subscription, or at a
// timeout.
//
// Scope: one log of at most MaxN events, each matching the client's filter
// or not; one client. The log is Log (true: the event matches); an event's
// sequence number is its index plus one.
//
// A wait is three server actions, so an append can fall between any two:
//   - Scan: read the events after the client's cursor up to the head. A
//     match is delivered at once (the answer that was already there). With
//     none, the server notes the head it scanned to (ScanHead).
//   - Register: subscribe from ScanHead, not from the head at this moment.
//   - Notify: evaluate the next event after the subscription's position;
//     a match is delivered and ends the wait, anything else moves the
//     position.
//   - Timeout: the wait ends with the position the subscription reached,
//     never the head.
//
// Phase: 0 idle, 1 scanned with no match, 2 subscribed.
type Act = Append{M bool} | Scan{} | Register{} | Notify{} | Timeout{}

type World {
	Log       []bool,
	Cursor    int,
	Phase     int,
	ScanHead  int,
	From      int,
	Delivered []int,
	Back      bool,
	TimedOut  bool,
}

let MaxN = 4

let NoMutant = 0
let SubscribeAtNewestMutant = 1
let TimeoutAtHeadMutant = 2
let DeliverAgainMutant = 3

func first() World {
	World{Log: []bool{}, Cursor: 0, Phase: 0, ScanHead: 0, From: 0, Delivered: []int{}, Back: false, TimedOut: false}
}

func head(w World) int {
	let mut n = 0
	for _ in w.Log {
		n = n + 1
	}
	n
}

func firstMatch(w World, from int, to int) int {
	for i, m in w.Log {
		let seq = i + 1
		if seq > from && seq <= to && m {
			return seq
		}
	}
	0
}

func moveCursor(s World, to int) World {
	let mut w = s
	if to < w.Cursor {
		w.Back = true
	}
	w.Cursor = to
	w
}

func step(s World, act Act, mutant int) Decision[World, string] {
	let mut w = s
	match act {
	case Append as a:
		if head(w) >= MaxN {
			return Ignore
		}
		w.Log = w.Log.Append(a.M)
		return Enter{w}
	case Scan:
		if w.Phase != 0 {
			return Ignore
		}
		let h = head(w)
		let mut from = w.Cursor
		if mutant == DeliverAgainMutant && from > 0 {
			from = from - 1
		}
		let hit = firstMatch(w, from, h)
		if hit > 0 {
			w.Delivered = w.Delivered.Append(hit)
			return Enter{moveCursor(w, hit)}
		}
		w.Phase = 1
		w.ScanHead = h
		return Enter{w}
	case Register:
		if w.Phase != 1 {
			return Ignore
		}
		w.Phase = 2
		w.From = w.ScanHead
		if mutant == SubscribeAtNewestMutant {
			w.From = head(w)
		}
		return Enter{w}
	case Notify:
		if w.Phase != 2 || w.From >= head(w) {
			return Ignore
		}
		let seq = w.From + 1
		if w.Log[seq-1] {
			w.Delivered = w.Delivered.Append(seq)
			w.Phase = 0
			return Enter{moveCursor(w, seq)}
		}
		w.From = seq
		return Enter{w}
	case Timeout:
		if w.Phase != 2 {
			return Ignore
		}
		w.Phase = 0
		w.TimedOut = true
		if mutant == TimeoutAtHeadMutant {
			return Enter{moveCursor(w, head(w))}
		}
		return Enter{moveCursor(w, w.From)}
	}
}

func nothingMissedNothingTwice(w World) bool {
	let mut want = []int{}
	for i, m in w.Log {
		if m && i+1 <= w.Cursor {
			want = want.Append(i + 1)
		}
	}
	let mut n = 0
	for _ in want {
		n = n + 1
	}
	let mut got = 0
	for i, d in w.Delivered {
		got = got + 1
		if i >= n || want[i] != d {
			return false
		}
	}
	got == n
}

func cursorInLog(w World) bool {
	w.Cursor <= head(w) && !w.Back
}

func missedOrTwice(w World) bool { !nothingMissedNothingTwice(w) }

func gotTwo(w World) bool {
	let mut n = 0
	for _ in w.Delivered {
		n = n + 1
	}
	n >= 2
}
func timedOutBehindHead(w World) bool { w.TimedOut && w.Phase == 0 && w.Cursor < head(w) }
func answeredBeforeWait(w World) bool {
	let mut n = 0
	for _ in w.Delivered {
		n = n + 1
	}
	n == 1 && !w.TimedOut && w.From == 0
}

func design(s World, a Act) Decision[World, string]            { return step(s, a, NoMutant) }
func subscribeAtNewest(s World, a Act) Decision[World, string] { return step(s, a, SubscribeAtNewestMutant) }
func timeoutAtHead(s World, a Act) Decision[World, string]     { return step(s, a, TimeoutAtHeadMutant) }
func deliverAgain(s World, a Act) Decision[World, string]      { return step(s, a, DeliverAgainMutant) }

type Design machine[World, Act] {
	initial: first(),
	step:    design,

	law NothingMissedNothingTwice always nothingMissedNothingTwice,
	law CursorInLog always cursorInLog,

	law DeliversTwo sometimes gotTwo,
	law TimesOutBehindHead sometimes timedOutBehindHead,
	law AnswerBeforeWaitCounts sometimes answeredBeforeWait,
}

type SubscribeAtNewest machine[World, Act] {
	initial: first(),
	step:    subscribeAtNewest,
	law Breaks sometimes missedOrTwice,
}

type TimeoutAtHead machine[World, Act] {
	initial: first(),
	step:    timeoutAtHead,
	law Breaks sometimes missedOrTwice,
}

type DeliverAgain machine[World, Act] {
	initial: first(),
	step:    deliverAgain,
	law Breaks sometimes missedOrTwice,
}
