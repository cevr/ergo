func argText(a flag.ArgSpec, v flag.Values) string {
	match a.Get(v) {
	case Some[string] as s:
		s.Value
	case None:
		""
	}
}

// Parse reads args as a command line of board.Api: a command and its
// flags and arguments. It builds only the command args[0] names; the
// list of every command is built only for help or an unknown command.
func Parse(args []string) Request fails flag.Failure {
	let first = if len(args) > 0 { args[0] } else { "" }
	match first {
	case "whoami":
		let c = commandWhoami()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board whoami"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "boards":
		let c = commandBoards()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board boards"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "channels":
		let c = commandChannels()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board channels"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "channel-create":
		let c = commandChannelCreate()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board channel-create"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "actors":
		let c = commandActors()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board actors"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "read":
		let c = commandRead()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board read"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "search":
		let c = commandSearch()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board search"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "post":
		let c = commandPost()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board post"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "thread-reply":
		let c = commandThreadReply()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board thread-reply"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "edit":
		let c = commandEdit()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board edit"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "delete":
		let c = commandDelete()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board delete"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "react":
		let c = commandReact()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board react"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "label":
		let c = commandLabel()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board label"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "ask":
		let c = commandAsk()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board ask"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "ask-withdraw":
		let c = commandAskWithdraw()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board ask-withdraw"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-list":
		let c = commandTasksList()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-list"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-create":
		let c = commandTasksCreate()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-create"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-plan":
		let c = commandTasksPlan()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-plan"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-claim":
		let c = commandTasksClaim()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-claim"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-renew":
		let c = commandTasksRenew()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-renew"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-release":
		let c = commandTasksRelease()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-release"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-complete":
		let c = commandTasksComplete()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-complete"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-fail":
		let c = commandTasksFail()
