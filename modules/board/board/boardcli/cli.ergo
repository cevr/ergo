		try c.Build(v)
	case "tasks-block":
		let c = commandTasksBlock()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-block"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-unblock":
		let c = commandTasksUnblock()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-unblock"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-reopen":
		let c = commandTasksReopen()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-reopen"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "tasks-assign":
		let c = commandTasksAssign()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-assign"}, slices.Slice(args, 1, len(args)))
