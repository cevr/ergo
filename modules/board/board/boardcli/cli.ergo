// Read is the outcome of r that the Output of Run with --json and its
// default status policy says: its value's JSON on standard output with
// status 0, or an admitted failure's tagged JSON with status 1. Invalid
// or missing replies fail Transport, outside the operation's own row.
func Read(r Request, out Output) boardapi.Outcome fails rpc.Transport {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case boardapi.WhoamiRequest:
			let v = try rpc.Decode[board.WhoamiReply]("value", text)
			boardapi.Done{Reply: boardapi.WhoamiReply{Value: v}}
		case boardapi.BoardsRequest:
			let v = try rpc.Decode[[]board.BoardSummary]("value", text)
			boardapi.Done{Reply: boardapi.BoardsReply{Value: v}}
		case boardapi.ChannelsRequest:
			let v = try rpc.Decode[[]board.ChannelSummary]("value", text)
