		out = out.Append("-pool=\(x.Input.Pool)")
		out
	case boardapi.TasksNeedsRequest as x:
		let mut out = []string{"tasks-needs"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
