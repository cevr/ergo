// RoundTrips reports whether Parse reads what Print writes of r as r.
func RoundTrips(r Request) bool {
	let back = Parse(Print(r)) catch {
	case flag.Failure:
		return false
	}
	back == r
}

// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// Policy is what a binary decides of its command line: Code, the exit
// status of a typed failure (default 1); Text, the text of a value
// without --json (default None: a basic value as its text, else its
// JSON; --json never calls it); Confirm, the question a call asks before
// it runs (default None: none; --yes answers it).
type Policy { Code func(f boardapi.Failure) int, Text func(r boardapi.Reply) Option[string], Confirm func(r Request) Option[string] }

// Defaults is the Policy of a binary that decides nothing.
func Defaults() Policy {
	Policy{Code: func(f boardapi.Failure) int { 1 }, Text: func(r boardapi.Reply) Option[string] { None }, Confirm: func(r Request) Option[string] { None }}
}

func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else {
		Output{Out: line(plain), Err: "", Code: 0}
	}
}

func line(s string) string {
	if s == "" {
		return ""
	}
	s + "\n"
}

func failed(asJSON bool, tagged string, status int) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: status}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: status}
	}
}

// Show is what Run prints of the outcome o under the policy p: the value
// (p's Text when it has one and there is no --json; else its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed) with p's Code.
func Show(o boardapi.Outcome, asJSON bool, p Policy) Output {
	match o {
	case boardapi.Done as done:
		if !asJSON {
			match p.Text(done.Reply) {
			case Some[string] as s:
				return Output{Out: line(s.Value), Err: "", Code: 0}
			case None:
			}
		}
		match done.Reply {
		case boardapi.WhoamiReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.BoardsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.ChannelsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.ChannelCreateReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.ActorsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.ReadReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.SearchReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.PostReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.ThreadReplyReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.EditReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.DeleteReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.ReactReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.LabelReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.AskReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.AskWithdrawReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksCreateReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksPlanReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksClaimReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksRenewReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksReleaseReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksCompleteReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksFailReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksBlockReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksUnblockReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksReopenReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksAssignReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksNeedsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TasksCancelReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.GrantsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.GrantExplainReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.GrantCreateReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.GrantRevokeReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.BoardCreateReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.BoardRenameReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.BoardArchiveReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case boardapi.TrustUpdateReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		}
	case boardapi.Rejected as rejected:
		let status = p.Code(rejected.Failure)
		match rejected.Failure {
		case boardapi.Unauthenticated as failure:
			failed(asJSON, rpc.Tagged("Unauthenticated", rpc.Encode(failure.E)), status)
		case boardapi.Gone as failure:
			failed(asJSON, rpc.Tagged("Gone", rpc.Encode(failure.E)), status)
		case boardapi.BoardNotFound as failure:
			failed(asJSON, rpc.Tagged("BoardNotFound", rpc.Encode(failure.E)), status)
		case boardapi.StoreFailed as failure:
			failed(asJSON, rpc.Tagged("StoreFailed", rpc.Encode(failure.E)), status)
		case boardapi.Forbidden as failure:
			failed(asJSON, rpc.Tagged("Forbidden", rpc.Encode(failure.E)), status)
		case boardapi.Invalid as failure:
			failed(asJSON, rpc.Tagged("Invalid", rpc.Encode(failure.E)), status)
		case boardapi.ChannelExists as failure:
			failed(asJSON, rpc.Tagged("ChannelExists", rpc.Encode(failure.E)), status)
		case boardapi.ChannelGranted as failure:
			failed(asJSON, rpc.Tagged("ChannelGranted", rpc.Encode(failure.E)), status)
		case boardapi.BoardArchived as failure:
			failed(asJSON, rpc.Tagged("BoardArchived", rpc.Encode(failure.E)), status)
		case boardapi.NotFound as failure:
			failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(failure.E)), status)
		case boardapi.TooLarge as failure:
			failed(asJSON, rpc.Tagged("TooLarge", rpc.Encode(failure.E)), status)
		case boardapi.SecretDetected as failure:
			failed(asJSON, rpc.Tagged("SecretDetected", rpc.Encode(failure.E)), status)
		case boardapi.IdempotencyConflict as failure:
			failed(asJSON, rpc.Tagged("IdempotencyConflict", rpc.Encode(failure.E)), status)
		case boardapi.ReservedLabel as failure:
			failed(asJSON, rpc.Tagged("ReservedLabel", rpc.Encode(failure.E)), status)
		case boardapi.NewerMessage as failure:
			failed(asJSON, rpc.Tagged("NewerMessage", rpc.Encode(failure.E)), status)
		case boardapi.NotAuthor as failure:
			failed(asJSON, rpc.Tagged("NotAuthor", rpc.Encode(failure.E)), status)
		case boardapi.RevisionConflict as failure:
			failed(asJSON, rpc.Tagged("RevisionConflict", rpc.Encode(failure.E)), status)
		case boardapi.LabelConflict as failure:
			failed(asJSON, rpc.Tagged("LabelConflict", rpc.Encode(failure.E)), status)
		case boardapi.NotAsker as failure:
			failed(asJSON, rpc.Tagged("NotAsker", rpc.Encode(failure.E)), status)
		case boardapi.AskClosed as failure:
			failed(asJSON, rpc.Tagged("AskClosed", rpc.Encode(failure.E)), status)
		case boardapi.AlreadyTask as failure:
			failed(asJSON, rpc.Tagged("AlreadyTask", rpc.Encode(failure.E)), status)
		case boardapi.InvalidNeeds as failure:
			failed(asJSON, rpc.Tagged("InvalidNeeds", rpc.Encode(failure.E)), status)
		case boardapi.TaskOwnerUntrusted as failure:
			failed(asJSON, rpc.Tagged("TaskOwnerUntrusted", rpc.Encode(failure.E)), status)
		case boardapi.PlanTooLarge as failure:
			failed(asJSON, rpc.Tagged("PlanTooLarge", rpc.Encode(failure.E)), status)
		case boardapi.TaskClaimedRefusal as failure:
			failed(asJSON, rpc.Tagged("TaskClaimedRefusal", rpc.Encode(failure.E)), status)
		case boardapi.TaskAssignedRefusal as failure:
			failed(asJSON, rpc.Tagged("TaskAssignedRefusal", rpc.Encode(failure.E)), status)
		case boardapi.TaskWaitingRefusal as failure:
			failed(asJSON, rpc.Tagged("TaskWaitingRefusal", rpc.Encode(failure.E)), status)
		case boardapi.TaskBlockedRefusal as failure:
			failed(asJSON, rpc.Tagged("TaskBlockedRefusal", rpc.Encode(failure.E)), status)
		case boardapi.TaskFinished as failure:
			failed(asJSON, rpc.Tagged("TaskFinished", rpc.Encode(failure.E)), status)
		case boardapi.NothingReady as failure:
			failed(asJSON, rpc.Tagged("NothingReady", rpc.Encode(failure.E)), status)
		case boardapi.ClaimLost as failure:
			failed(asJSON, rpc.Tagged("ClaimLost", rpc.Encode(failure.E)), status)
		case boardapi.TaskNotOwned as failure:
