type front = asked{R Request, JSON bool, Yes bool} | ended{O Output}

func frontOf(args []string) front {
	let mut asJSON = false
	let mut yes = false
	let mut globals = true
	let mut rest = []string{}
	for a in args {
		if globals && (a == "--json" || a == "-json") {
			asJSON = true
		} else if globals && (a == "--yes" || a == "-yes") {
			yes = true
		} else {
			globals = false
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return ended{O: Output{Out: h.Text, Err: "", Code: 0}}
	case err:
		return ended{O: Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}}
	}
	asked{R: r, JSON: asJSON, Yes: yes}
}

func needsYes(question string) Output {
	Output{Out: "", Err: question + " (no terminal to ask on: pass --yes to answer yes)\n", Code: 2}
}

func declined(question string) Output {
	Output{Out: "", Err: question + ": not confirmed\n", Code: 1}
}

func runOver[R](args []string, p Policy, answer func(r Request) boardapi.Outcome needs R) Output needs R {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				return needsYes(q.Value)
			case None:
			}
		}
		Show(answer(a.R), a.JSON, p)
	}
}

// Run reads args as [--json] [--yes] COMMAND ARGS..., answers the call
// through the hub's Call on the board.Api the caller binds, and is what to
// print under the policy p: the value, a typed failure with p's Code, the
// help (status 0) or a usage error (status 2). It asks nothing: a call p
// asks a question of needs --yes (status 2 without it).
func Run(args []string, p Policy) Output needs board.Api {
	runOver(args, p, boardapi.Call)
}

// RunOnTerminal is Run that asks p's question on the terminal (std
// prompt) when there is no --yes: a yes runs the call, a no or a cancel
// ends with status 1, and standard input that is not a terminal ends with
// status 2, as Run does.
func RunOnTerminal(args []string, p Policy) Output needs board.Api | term.Terminal | io.Stderr {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				let yes = prompt.Confirm(q.Value, false) catch {
				case prompt.NotInteractive:
					return needsYes(q.Value)
				case prompt.Cancelled:
					return declined(q.Value)
				case io.ReadFailed:
					return Output{Out: "", Err: q.Value + ": the answer could not be read\n", Code: 2}
				}
				if !yes {
					return declined(q.Value)
				}
			case None:
			}
		}
		Show(boardapi.Call(a.R), a.JSON, p)
	}
}

// Completion is the script that completes board's commands in shell.
func Completion(shell api.Shell) string {
	api.Completion("board", shell, []api.Entry{api.Entry{Name: boardapi.Name(boardapi.WhoamiOp), Doc: boardapi.Doc(boardapi.WhoamiOp)}, api.Entry{Name: boardapi.Name(boardapi.BoardsOp), Doc: boardapi.Doc(boardapi.BoardsOp)}, api.Entry{Name: boardapi.Name(boardapi.ChannelsOp), Doc: boardapi.Doc(boardapi.ChannelsOp)}, api.Entry{Name: boardapi.Name(boardapi.ChannelCreateOp), Doc: boardapi.Doc(boardapi.ChannelCreateOp)}, api.Entry{Name: boardapi.Name(boardapi.ActorsOp), Doc: boardapi.Doc(boardapi.ActorsOp)}, api.Entry{Name: boardapi.Name(boardapi.ReadOp), Doc: boardapi.Doc(boardapi.ReadOp)}, api.Entry{Name: boardapi.Name(boardapi.SearchOp), Doc: boardapi.Doc(boardapi.SearchOp)}, api.Entry{Name: boardapi.Name(boardapi.PostOp), Doc: boardapi.Doc(boardapi.PostOp)}, api.Entry{Name: boardapi.Name(boardapi.ThreadReplyOp), Doc: boardapi.Doc(boardapi.ThreadReplyOp)}, api.Entry{Name: boardapi.Name(boardapi.EditOp), Doc: boardapi.Doc(boardapi.EditOp)}, api.Entry{Name: boardapi.Name(boardapi.DeleteOp), Doc: boardapi.Doc(boardapi.DeleteOp)}, api.Entry{Name: boardapi.Name(boardapi.ReactOp), Doc: boardapi.Doc(boardapi.ReactOp)}, api.Entry{Name: boardapi.Name(boardapi.LabelOp), Doc: boardapi.Doc(boardapi.LabelOp)}, api.Entry{Name: boardapi.Name(boardapi.AskOp), Doc: boardapi.Doc(boardapi.AskOp)}, api.Entry{Name: boardapi.Name(boardapi.AskWithdrawOp), Doc: boardapi.Doc(boardapi.AskWithdrawOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksListOp), Doc: boardapi.Doc(boardapi.TasksListOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksCreateOp), Doc: boardapi.Doc(boardapi.TasksCreateOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksPlanOp), Doc: boardapi.Doc(boardapi.TasksPlanOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksClaimOp), Doc: boardapi.Doc(boardapi.TasksClaimOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksRenewOp), Doc: boardapi.Doc(boardapi.TasksRenewOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksReleaseOp), Doc: boardapi.Doc(boardapi.TasksReleaseOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksCompleteOp), Doc: boardapi.Doc(boardapi.TasksCompleteOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksFailOp), Doc: boardapi.Doc(boardapi.TasksFailOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksBlockOp), Doc: boardapi.Doc(boardapi.TasksBlockOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksUnblockOp), Doc: boardapi.Doc(boardapi.TasksUnblockOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksReopenOp), Doc: boardapi.Doc(boardapi.TasksReopenOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksAssignOp), Doc: boardapi.Doc(boardapi.TasksAssignOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksNeedsOp), Doc: boardapi.Doc(boardapi.TasksNeedsOp)}, api.Entry{Name: boardapi.Name(boardapi.TasksCancelOp), Doc: boardapi.Doc(boardapi.TasksCancelOp)}, api.Entry{Name: boardapi.Name(boardapi.GrantsOp), Doc: boardapi.Doc(boardapi.GrantsOp)}, api.Entry{Name: boardapi.Name(boardapi.GrantExplainOp), Doc: boardapi.Doc(boardapi.GrantExplainOp)}, api.Entry{Name: boardapi.Name(boardapi.GrantCreateOp), Doc: boardapi.Doc(boardapi.GrantCreateOp)}, api.Entry{Name: boardapi.Name(boardapi.GrantRevokeOp), Doc: boardapi.Doc(boardapi.GrantRevokeOp)}, api.Entry{Name: boardapi.Name(boardapi.BoardCreateOp), Doc: boardapi.Doc(boardapi.BoardCreateOp)}, api.Entry{Name: boardapi.Name(boardapi.BoardRenameOp), Doc: boardapi.Doc(boardapi.BoardRenameOp)}, api.Entry{Name: boardapi.Name(boardapi.BoardArchiveOp), Doc: boardapi.Doc(boardapi.BoardArchiveOp)}, api.Entry{Name: boardapi.Name(boardapi.TrustUpdateOp), Doc: boardapi.Doc(boardapi.TrustUpdateOp)}})
}

// Wire is the command line as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, boardapi.Outcome, rpc.Transport]

// Carry prints c with --json, runs it against answer using the default
// status policy, and reads back the reply. Delivery can fail separately
// from answer's outcome.
func Carry(w Wire, c Request, answer own func(c Request) boardapi.Outcome) boardapi.Outcome fails rpc.Transport {
	let mut args = []string{"--json"}
	for a in Print(c) {
		args = args.Append(a)
	}
	try Read(c, runOver(args, Defaults(), answer))
}

// Agrees: the command line carries every call and every outcome the
// call can have unchanged.
law Agrees(r Request, g boardapi.Given) { api.Agrees[Request, boardapi.Outcome, rpc.Transport](Wire, r, boardapi.OutcomeOf(r, g)) }

// CodeIsThePolicy: a call's status is 0 for a value and the policy's
// Code for a typed failure.
law CodeIsThePolicy(r Request, g boardapi.Given, k int) {
	let status = 1 + ((k%125)+125)%125
	let d = Defaults()
	let p = Policy{..d, Code: func(f boardapi.Failure) int { status }}
	let o = boardapi.OutcomeOf(r, g)
	let out = runOver(Print(r), p, func(c Request) boardapi.Outcome { o })
	match o {
	case boardapi.Done:
		out.Code == 0
	case boardapi.Rejected:
		out.Code == status
	}
}

// TextIsThePolicy: without --json a value prints as the policy's Text;
// with --json every outcome prints as the wire's JSON, whatever Text says.
law TextIsThePolicy(r Request, g boardapi.Given, t string) {
	let d = Defaults()
	let p = Policy{..d, Text: func(reply boardapi.Reply) Option[string] { Some[string]{Value: t} }}
	let o = boardapi.OutcomeOf(r, g)
	let same = Show(o, true, p) == Show(o, true, d)
	match o {
	case boardapi.Done:
		same && Show(o, false, p).Out == line(t)
	case boardapi.Rejected:
		same && Show(o, false, p) == Show(o, false, d)
	}
}
