// Commands are the commands of board.Api, one per operation, in its order.
func Commands() []flag.Command[Request] {
	[]flag.Command[Request]{commandWhoami(), commandBoards(), commandChannels(), commandChannelCreate(), commandActors(), commandRead(), commandSearch(), commandPost(), commandThreadReply(), commandEdit(), commandDelete(), commandReact(), commandLabel(), commandAsk(), commandAskWithdraw(), commandTasksList(), commandTasksCreate(), commandTasksPlan(), commandTasksClaim(), commandTasksRenew(), commandTasksRelease(), commandTasksComplete(), commandTasksFail(), commandTasksBlock(), commandTasksUnblock(), commandTasksReopen(), commandTasksAssign(), commandTasksNeeds(), commandTasksCancel(), commandGrants(), commandGrantExplain(), commandGrantCreate(), commandGrantRevoke(), commandBoardCreate(), commandBoardRename(), commandBoardArchive(), commandTrustUpdate()}
}

