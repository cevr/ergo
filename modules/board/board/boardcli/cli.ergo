		let v = try flag.Parse(flag.Set{..c.Set, Name: "board tasks-cancel"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "grants":
		let c = commandGrants()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board grants"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "grant-explain":
		let c = commandGrantExplain()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board grant-explain"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "grant-create":
		let c = commandGrantCreate()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board grant-create"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "grant-revoke":
		let c = commandGrantRevoke()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board grant-revoke"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "board-create":
		let c = commandBoardCreate()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board board-create"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "board-rename":
		let c = commandBoardRename()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board board-rename"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "board-archive":
		let c = commandBoardArchive()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board board-archive"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "trust-update":
		let c = commandTrustUpdate()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "board trust-update"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case _:
		try flag.ParseCommand("board", "board.Api on a command line", Commands(), args)
	}
}

// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case boardapi.WhoamiRequest as x:
		let mut out = []string{"whoami"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out
	case boardapi.BoardsRequest:
		[]string{"boards"}
	case boardapi.ChannelsRequest as x:
		let mut out = []string{"channels"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		match x.Input.Prefix {
		case Some[string] as s:
			out = out.Append("-prefix=\(s.Value)")
		case None:
		}
		out
	case boardapi.ChannelCreateRequest as x:
		let mut out = []string{"channel-create"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-path=\(x.Input.Path)")
		out = out.Append("-private=\(x.Input.Private)")
		out
	case boardapi.ActorsRequest as x:
		let mut out = []string{"actors"}
		match x.Input.Query {
		case Some[string] as s:
			out = out.Append("-query=\(s.Value)")
		case None:
		}
		out
	case boardapi.ReadRequest as x:
		let mut out = []string{"read"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		match x.Input.Channel {
		case Some[string] as s:
			out = out.Append("-channel=\(s.Value)")
		case None:
		}
		match x.Input.ID {
		case Some[string] as s:
			out = out.Append("-id=\(s.Value)")
		case None:
		}
		match x.Input.By {
		case Some[string] as s:
			out = out.Append("-by=\(s.Value)")
		case None:
		}
		match x.Input.Mentions {
		case Some[string] as s:
			out = out.Append("-mentions=\(s.Value)")
		case None:
		}
		for e in x.Input.Label {
			out = out.Append("-label=\(e)")
		}
		match x.Input.Text {
		case Some[string] as s:
			out = out.Append("-text=\(s.Value)")
		case None:
		}
		match x.Input.After {
		case Some[int] as s:
			out = out.Append("-after=\(s.Value)")
		case None:
		}
		match x.Input.Limit {
		case Some[int] as s:
			out = out.Append("-limit=\(s.Value)")
		case None:
		}
		out
	case boardapi.SearchRequest as x:
		let mut out = []string{"search"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-query=\(x.Input.Query)")
		match x.Input.Channel {
		case Some[string] as s:
			out = out.Append("-channel=\(s.Value)")
		case None:
		}
		match x.Input.Limit {
		case Some[int] as s:
			out = out.Append("-limit=\(s.Value)")
		case None:
		}
		out
	case boardapi.PostRequest as x:
		let mut out = []string{"post"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-channel=\(x.Input.Channel)")
		out = out.Append("-text=\(x.Input.Text)")
		for e in x.Input.Labels {
			out = out.Append("-labels=\(e)")
		}
		out = out.Append("-no-sync=\(x.Input.NoSync)")
		match x.Input.IdempotencyKey {
		case Some[string] as s:
			out = out.Append("-idempotency-key=\(s.Value)")
		case None:
		}
		out
	case boardapi.ThreadReplyRequest as x:
		let mut out = []string{"thread-reply"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-id=\(x.Input.ID)")
		out = out.Append("-text=\(x.Input.Text)")
		match x.Input.After {
		case Some[string] as s:
			out = out.Append("-after=\(s.Value)")
		case None:
		}
		for e in x.Input.Labels {
			out = out.Append("-labels=\(e)")
		}
		out = out.Append("-no-sync=\(x.Input.NoSync)")
		match x.Input.IdempotencyKey {
		case Some[string] as s:
			out = out.Append("-idempotency-key=\(s.Value)")
		case None:
		}
		out
	case boardapi.EditRequest as x:
		let mut out = []string{"edit"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-id=\(x.Input.ID)")
		out = out.Append("-text=\(x.Input.Text)")
		match x.Input.IfRevision {
		case Some[int] as s:
			out = out.Append("-if-revision=\(s.Value)")
		case None:
		}
		out
	case boardapi.DeleteRequest as x:
		let mut out = []string{"delete"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-id=\(x.Input.ID)")
		match x.Input.IfRevision {
		case Some[int] as s:
			out = out.Append("-if-revision=\(s.Value)")
		case None:
		}
		out
	case boardapi.ReactRequest as x:
		let mut out = []string{"react"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-id=\(x.Input.ID)")
		out = out.Append("-emoji=\(x.Input.Emoji)")
		out = out.Append("-remove=\(x.Input.Remove)")
		out
	case boardapi.LabelRequest as x:
		let mut out = []string{"label"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		out = out.Append("-id=\(x.Input.ID)")
		for e in x.Input.Set {
			out = out.Append("-set=\(e)")
		}
		for e in x.Input.Unset {
			out = out.Append("-unset=\(e)")
		}
		for e in x.Input.If {
			out = out.Append("-if=\(e)")
		}
		for e in x.Input.IfUnset {
			out = out.Append("-if-unset=\(e)")
		}
		out
	case boardapi.AskRequest as x:
		let mut out = []string{"ask"}
		match x.Input.Board {
		case Some[string] as s:
			out = out.Append("-board=\(s.Value)")
		case None:
		}
		match x.Input.Channel {
		case Some[string] as s:
			out = out.Append("-channel=\(s.Value)")
		case None:
		}
		match x.Input.Thread {
		case Some[string] as s:
			out = out.Append("-thread=\(s.Value)")
		case None:
		}
		out = out.Append("-text=\(x.Input.Text)")
		for e in x.Input.To {
			out = out.Append("-to=\(e)")
		}
		out = out.Append("-only-from-asked=\(x.Input.OnlyFromAsked)")
		match x.Input.ExpiresInMs {
		case Some[int] as s:
			out = out.Append("-expires-in-ms=\(s.Value)")
		case None:
		}
		out = out.Append("-no-sync=\(x.Input.NoSync)")
		match x.Input.IdempotencyKey {
		case Some[string] as s:
			out = out.Append("-idempotency-key=\(s.Value)")
		case None:
		}
		out
	case boardapi.AskWithdrawRequest as x:
		let mut out = []string{"ask-withdraw"}
