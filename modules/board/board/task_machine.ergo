import machines
import option

// TaskWorker identifies one of two worker profiles racing on tasks in M1/M2.
type TaskWorker = WorkerA{} | WorkerB{}

// TaskSlot identifies one of the two tasks in the product Task machine (T1 needs T0).
type TaskSlot = Slot0{} | Slot1{}

// TaskAct is an action driving the product Task state machine on real
// board.Decide and board.Apply.
type TaskAct =
	| TaskClaimRead{W TaskWorker, T TaskSlot}
	| TaskClaimWrite{W TaskWorker, T TaskSlot}
	| TaskRenewAct{W TaskWorker, T TaskSlot}
	| TaskCompleteAct{W TaskWorker, T TaskSlot}
	| TaskFailAct{W TaskWorker, T TaskSlot}
	| TaskReleaseAct{W TaskWorker, T TaskSlot}
	| TaskBlockAct{W TaskWorker, T TaskSlot}
	| TaskExpireAct{T TaskSlot}
	| TaskUnblockAct{T TaskSlot}
	| TaskCancelAct{T TaskSlot}
	| TaskReopenAct{T TaskSlot}

// TaskWorld pairs the real domain State with race/fence ghosts for M1 and M2.
type TaskWorld {
	Board State,
	Saw   []bool,
	Tok   []int,
	Wins  []int,
	Done  []int,
	Stale bool,
	Lost  bool,
}

let taskMachineMaxEpoch = 2
let taskClaimNow = 100
let taskExpireNow = 100 + MaxLeaseMs + 1

func taskWorkerIdx(w TaskWorker) int {
	match w {
	case WorkerA:
		0
	case WorkerB:
		1
	}
}

func taskSlotIdx(t TaskSlot) int {
	match t {
	case Slot0:
		0
	case Slot1:
		1
	}
}

func taskSlotID(t TaskSlot) MessageID {
	match t {
	case Slot0:
		"msg_1"
	case Slot1:
		"msg_2"
	}
}

func taskOwnerPrincipal() Principal {
	Principal{ID: "google:owner", Kind: Person, Handle: "owner", Email: "owner@example.com", Name: "Owner", Role: Admin, State: Active}
}

func taskOwnerCaller() Caller {
	Caller{Principal: "google:owner", Profile: "", Role: Admin, Kind: Person, Email: "owner@example.com", Narrowed: false, NarrowedCan: Map[string, []Permission]{}, NarrowedProfile: "", NarrowedBoards: []string{}}
}

func taskWorkerCaller(w TaskWorker) Caller {
	let prof = match w {
	case WorkerA:
		"a"
	case WorkerB:
		"b"
	}
	Caller{Principal: "google:owner", Profile: prof, Role: Admin, Kind: Person, Email: "owner@example.com", Narrowed: false, NarrowedCan: Map[string, []Permission]{}, NarrowedProfile: "", NarrowedBoards: []string{}}
}

func taskApplyDecide(s State, cmd Command, now Timestamp) (State, []Event, bool) {
	let evts = Decide(s, cmd, now) catch {
	case _:
		return (s, []Event{}, false)
	}
	let mut cur = s
	for e in evts {
		match e.Payload {
		case ProfileSeen:
		case _:
			cur = Apply(cur, Event{..e, Seq: 0})
		}
	}
	(cur, evts, true)
}

func taskOfSlot(s State, idx int) TaskRecord {
	let id = if idx == 0 { "msg_1" } else { "msg_2" }
	match s.Tasks.Get(id) {
	case option.Some[TaskRecord] as tr:
		tr.Value
	case option.None:
		TaskRecord{ID: "", Board: "", Channel: "", State: TaskWaiting, Owner: "", OwnerPrincipal: "", For: "", Needs: []MessageID{}, HasClaim: false, Claim: emptyClaim(), Epoch: 0, HoldKind: "", HoldReason: "", Result: "", Reason: "", CreatedAt: 0, ReadyAt: 0}
	}
}

func taskInitial() TaskWorld {
	let owner = taskOwnerPrincipal()
	let s0 = InitialState([]Principal{owner}, taskClaimNow)
	let plan = CreatePlan{
		Caller:  taskOwnerCaller(),
		Board:   DefaultBoard,
		Channel: "dev",
		Tasks:   []PlanTaskSpec{
			PlanTaskSpec{Key: "t0", Text: "step 0", Labels: Map[string, string]{}, Needs: []string{}, For: "", NoSync: false},
			PlanTaskSpec{Key: "t1", Text: "step 1", Labels: Map[string, string]{}, Needs: []string{"t0"}, For: "", NoSync: false},
		},
		IdempotencyKey: "",
	}
	let (s1, _, _) = taskApplyDecide(s0, plan, taskClaimNow)
	TaskWorld{
		Board: s1,
		Saw:   []bool{false, false, false, false},
		Tok:   []int{0, 0, 0, 0},
		Wins:  []int{0, 0},
		Done:  []int{0, 0},
		Stale: false,
		Lost:  false,
	}
}

func taskStepSettle(s TaskWorld, w TaskWorker, t TaskSlot, kind int) machines.Decision[TaskWorld, string] {
	let mut out = s
	let wi = taskWorkerIdx(w)
	let ti = taskSlotIdx(t)
	let k = wi*2 + ti
	let tok = out.Tok[k]
	if tok == 0 {
		return machines.Ignore
	}
	let before = taskOfSlot(out.Board, ti)
	let id = taskSlotID(t)
	let caller = taskWorkerCaller(w)
	let cmd = match kind {
	case 0:
		RenewTask{Caller: caller, Board: DefaultBoard, ID: id, Token: tok, LeaseMs: MaxLeaseMs}
	case 1:
		CompleteTask{Caller: caller, Board: DefaultBoard, ID: id, Token: tok, Result: "ok"}
	case 2:
		FailTask{Caller: caller, Board: DefaultBoard, ID: id, Token: tok, Reason: "err"}
	case 3:
		ReleaseTask{Caller: caller, Board: DefaultBoard, ID: id, Token: tok}
	case _:
		BlockTask{Caller: caller, Board: DefaultBoard, ID: id, Kind: "needs_human", Reason: "hold", Token: tok}
	}
	let (nextBoard, _, ok) = taskApplyDecide(out.Board, cmd, taskClaimNow)
	if !ok {
		out.Tok[k] = 0
		out.Lost = true
		return machines.Enter{out}
	}
	if before.State != TaskClaimed || tok != before.Epoch {
		out.Stale = true
	}
	out.Board = nextBoard
	if kind == 0 {
		return machines.Enter{out}
	}
	out.Tok[k] = 0
	if kind == 1 {
		out.Done[ti] = out.Done[ti] + 1
		if ti == 0 && taskOfSlot(nextBoard, 1).State == TaskReady {
			out.Wins[1] = 0
		}
		return machines.Enter{out}
	}
	if kind == 3 {
		out.Wins[ti] = 0
	}
	machines.Enter{out}
}

func taskStep(s TaskWorld, act TaskAct) machines.Decision[TaskWorld, string] {
	let mut w = s
	match act {
	case TaskClaimRead as a:
		let ti = taskSlotIdx(a.T)
		let k = taskWorkerIdx(a.W)*2 + ti
		if taskOfSlot(w.Board, ti).State != TaskReady || w.Saw[k] {
			return machines.Ignore
		}
		w.Saw[k] = true
		return machines.Enter{w}
	case TaskClaimWrite as a:
		let ti = taskSlotIdx(a.T)
		let k = taskWorkerIdx(a.W)*2 + ti
		if !w.Saw[k] {
			return machines.Ignore
		}
		let before = taskOfSlot(w.Board, ti)
		if before.Epoch >= taskMachineMaxEpoch {
			return machines.Ignore
		}
		w.Saw[k] = false
		let (nextBoard, _, ok) = taskApplyDecide(w.Board, ClaimTask{
			Caller:  taskWorkerCaller(a.W),
			Board:   DefaultBoard,
			ID:      taskSlotID(a.T),
			LeaseMs: MaxLeaseMs,
		}, taskClaimNow)
		if !ok {
			return machines.Enter{w}
		}
		w.Board = nextBoard
		let after = taskOfSlot(nextBoard, ti)
		w.Tok[k] = after.Epoch
		w.Wins[ti] = w.Wins[ti] + 1
		return machines.Enter{w}
	case TaskRenewAct as a:
		taskStepSettle(w, a.W, a.T, 0)
	case TaskCompleteAct as a:
		taskStepSettle(w, a.W, a.T, 1)
	case TaskFailAct as a:
		taskStepSettle(w, a.W, a.T, 2)
	case TaskReleaseAct as a:
		taskStepSettle(w, a.W, a.T, 3)
	case TaskBlockAct as a:
		taskStepSettle(w, a.W, a.T, 4)
	case TaskExpireAct as a:
		let ti = taskSlotIdx(a.T)
		if taskOfSlot(w.Board, ti).State != TaskClaimed {
			return machines.Ignore
		}
		let (nextBoard, _, ok) = taskApplyDecide(w.Board, ExpireTask{Board: DefaultBoard, ID: taskSlotID(a.T)}, taskExpireNow)
		if !ok {
			return machines.Ignore
		}
		let fixed = match nextBoard.Tasks.Get(taskSlotID(a.T)) {
		case option.Some[TaskRecord] as tr:
			State{..nextBoard, Tasks: nextBoard.Tasks.Put(taskSlotID(a.T), TaskRecord{..tr.Value, ReadyAt: taskClaimNow})}
		case option.None:
			nextBoard
		}
		w.Board = fixed
		w.Wins[ti] = 0
		return machines.Enter{w}
	case TaskUnblockAct as a:
		let ti = taskSlotIdx(a.T)
		let (nextBoard, _, ok) = taskApplyDecide(w.Board, UnblockTask{Caller: taskOwnerCaller(), Board: DefaultBoard, ID: taskSlotID(a.T)}, taskClaimNow)
		if !ok {
			return machines.Ignore
		}
		w.Board = nextBoard
		w.Wins[ti] = 0
		return machines.Enter{w}
	case TaskCancelAct as a:
		let (nextBoard, _, ok) = taskApplyDecide(w.Board, CancelTask{Caller: taskOwnerCaller(), Board: DefaultBoard, ID: taskSlotID(a.T), Reason: "cancel"}, taskClaimNow)
		if !ok {
			return machines.Ignore
		}
		w.Board = nextBoard
		return machines.Enter{w}
	case TaskReopenAct as a:
		let ti = taskSlotIdx(a.T)
		let (nextBoard, _, ok) = taskApplyDecide(w.Board, ReopenTask{Caller: taskOwnerCaller(), Board: DefaultBoard, ID: taskSlotID(a.T)}, taskClaimNow)
		if !ok {
			return machines.Ignore
		}
		w.Board = nextBoard
		w.Wins[ti] = 0
		return machines.Enter{w}
	}
}

func taskOneHolder(w TaskWorld) bool {
	for ti in 0..2 {
		let tr = taskOfSlot(w.Board, ti)
		if (tr.State == TaskClaimed) != (tr.HasClaim && tr.Claim.Holder != "") {
			return false
		}
	}
	true
}

func taskOneWinner(w TaskWorld) bool {
	w.Wins[0] <= 1 && w.Wins[1] <= 1
}

func taskClaimLostChangesNothing(w TaskWorld) bool { !w.Stale }

func taskCompletedOnce(w TaskWorld) bool {
	for ti in 0..2 {
		if w.Done[ti] > 1 {
			return false
		}
		if w.Done[ti] == 1 && taskOfSlot(w.Board, ti).State != TaskCompleted {
			return false
		}
	}
	true
}

func taskPrerequisiteFirst(w TaskWorld) bool {
	let s0 = taskOfSlot(w.Board, 0).State
	let s1 = taskOfSlot(w.Board, 1).State
	if s1 == TaskReady || s1 == TaskClaimed || s1 == TaskCompleted {
		return s0 == TaskCompleted
	}
	true
}

func taskBothDone(w TaskWorld) bool {
	taskOfSlot(w.Board, 0).State == TaskCompleted && taskOfSlot(w.Board, 1).State == TaskCompleted
}

func taskReclaimed(w TaskWorld) bool {
	let t0 = taskOfSlot(w.Board, 0)
	t0.Epoch >= 2 && t0.State == TaskClaimed
}

func taskLostSeen(w TaskWorld) bool { w.Lost }

func taskHeldForAPerson(w TaskWorld) bool { taskOfSlot(w.Board, 1).State == TaskBlocked }

func taskWaitsOnFailed(w TaskWorld) bool {
	taskOfSlot(w.Board, 0).State == TaskFailed && taskOfSlot(w.Board, 1).State == TaskWaiting
}

// Task proves M1 and M2 directly on the product's Decide and Apply step:
// OneHolder, OneWinner, ClaimLostChangesNothing, CompletedOnce, and
// PrerequisiteFirst, together with five non-vacuity witnesses.
type Task machine[TaskWorld, TaskAct] {
	initial: taskInitial(),
	step:    taskStep,

	law OneHolder always taskOneHolder,
	law OneWinner always taskOneWinner,
	law ClaimLostChangesNothing always taskClaimLostChangesNothing,
	law CompletedOnce always taskCompletedOnce,
	law PrerequisiteFirst always taskPrerequisiteFirst,

	law BothComplete sometimes taskBothDone,
	law Reclaims sometimes taskReclaimed,
	law RefusesALostClaim sometimes taskLostSeen,
	law HoldsForAPerson sometimes taskHeldForAPerson,
	law KeepsWaitingOnAFailure sometimes taskWaitsOnFailed,
}
