			boardapi.Done{Reply: boardapi.GrantsReply{Value: v}}
		case boardapi.GrantExplainRequest:
			let v = try rpc.Decode[board.GrantExplainReply]("value", text)
			boardapi.Done{Reply: boardapi.GrantExplainReply{Value: v}}
		case boardapi.GrantCreateRequest:
			let v = try rpc.Decode[board.Grant]("value", text)
			boardapi.Done{Reply: boardapi.GrantCreateReply{Value: v}}
		case boardapi.GrantRevokeRequest:
