		case boardapi.TasksFailRequest:
			let v = try rpc.Decode[board.TaskStateReply]("value", text)
			boardapi.Done{Reply: boardapi.TasksFailReply{Value: v}}
		case boardapi.TasksBlockRequest:
			let v = try rpc.Decode[board.TaskStateReply]("value", text)
			boardapi.Done{Reply: boardapi.TasksBlockReply{Value: v}}
		case boardapi.TasksUnblockRequest:
			let v = try rpc.Decode[board.TaskStateReply]("value", text)
			boardapi.Done{Reply: boardapi.TasksUnblockReply{Value: v}}
		case boardapi.TasksReopenRequest:
