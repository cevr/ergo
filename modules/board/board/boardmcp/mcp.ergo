// Call is the Request that a call of the tool name with arguments asks
// for: arguments that are not the tool's fail ToolError, a name that is
// no tool's UnknownTool.
func Call(name string, arguments json.Value) Request fails mcp.ToolError | mcp.UnknownTool {
	let text = match name {
	case "whoami":
		rpc.Tagged("WhoamiRequest", "{\"input\":"+textOf(arguments)+"}")
	case "boards":
		rpc.Tagged("BoardsRequest", textOf(arguments))
	case "channels":
		rpc.Tagged("ChannelsRequest", "{\"input\":"+textOf(arguments)+"}")
	case "channel-create":
		rpc.Tagged("ChannelCreateRequest", "{\"input\":"+textOf(arguments)+"}")
	case "actors":
		rpc.Tagged("ActorsRequest", "{\"input\":"+textOf(arguments)+"}")
	case "read":
		rpc.Tagged("ReadRequest", "{\"input\":"+textOf(arguments)+"}")
	case "search":
		rpc.Tagged("SearchRequest", "{\"input\":"+textOf(arguments)+"}")
	case "post":
		rpc.Tagged("PostRequest", "{\"input\":"+textOf(arguments)+"}")
	case "thread-reply":
		rpc.Tagged("ThreadReplyRequest", "{\"input\":"+textOf(arguments)+"}")
	case "edit":
		rpc.Tagged("EditRequest", "{\"input\":"+textOf(arguments)+"}")
	case "delete":
		rpc.Tagged("DeleteRequest", "{\"input\":"+textOf(arguments)+"}")
	case "react":
		rpc.Tagged("ReactRequest", "{\"input\":"+textOf(arguments)+"}")
	case "label":
		rpc.Tagged("LabelRequest", "{\"input\":"+textOf(arguments)+"}")
	case "ask":
		rpc.Tagged("AskRequest", "{\"input\":"+textOf(arguments)+"}")
	case "ask-withdraw":
		rpc.Tagged("AskWithdrawRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-list":
		rpc.Tagged("TasksListRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-create":
		rpc.Tagged("TasksCreateRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-plan":
		rpc.Tagged("TasksPlanRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-claim":
		rpc.Tagged("TasksClaimRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-renew":
		rpc.Tagged("TasksRenewRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-release":
		rpc.Tagged("TasksReleaseRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-complete":
		rpc.Tagged("TasksCompleteRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-fail":
		rpc.Tagged("TasksFailRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-block":
		rpc.Tagged("TasksBlockRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-unblock":
		rpc.Tagged("TasksUnblockRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-reopen":
		rpc.Tagged("TasksReopenRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-assign":
		rpc.Tagged("TasksAssignRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-needs":
		rpc.Tagged("TasksNeedsRequest", "{\"input\":"+textOf(arguments)+"}")
	case "tasks-cancel":
		rpc.Tagged("TasksCancelRequest", "{\"input\":"+textOf(arguments)+"}")
	case "grants":
		rpc.Tagged("GrantsRequest", "{\"input\":"+textOf(arguments)+"}")
	case "grant-explain":
		rpc.Tagged("GrantExplainRequest", "{\"input\":"+textOf(arguments)+"}")
	case "grant-create":
		rpc.Tagged("GrantCreateRequest", "{\"input\":"+textOf(arguments)+"}")
	case "grant-revoke":
		rpc.Tagged("GrantRevokeRequest", "{\"input\":"+textOf(arguments)+"}")
	case "board-create":
		rpc.Tagged("BoardCreateRequest", "{\"input\":"+textOf(arguments)+"}")
	case "board-rename":
		rpc.Tagged("BoardRenameRequest", "{\"input\":"+textOf(arguments)+"}")
	case "board-archive":
		rpc.Tagged("BoardArchiveRequest", "{\"input\":"+textOf(arguments)+"}")
	case "trust-update":
		rpc.Tagged("TrustUpdateRequest", "{\"input\":"+textOf(arguments)+"}")
	case _:
		return mcp.UnknownTool{Name: name}
	}
	rpc.Decode[Request]("arguments of "+name, text) catch {
	case rpc.Transport as e:
		return mcp.ToolError{Message: e.Reason}
	}
}

// Arguments is the tool and the arguments that ask for r: Call reads
// them as r again.
func Arguments(r Request) (string, json.Value) {
	match r {
	case boardapi.WhoamiRequest as x:
		("whoami", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.BoardsRequest:
		("boards", json.Object{Members: []json.Member{}})
	case boardapi.ChannelsRequest as x:
		("channels", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.ChannelCreateRequest as x:
		("channel-create", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.ActorsRequest as x:
		("actors", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.ReadRequest as x:
		("read", untagged(valueOf(rpc.Encode(x.Input))))
