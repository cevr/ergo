			return mcp.ToolError{Message: rpc.Tagged("BoardNameTaken", rpc.Encode(failure.E))}
		}
	}
}

// Answer answers r through the hub's Call on the bound board.Api (Show).
func Answer(r Request) json.Value fails mcp.ToolError needs board.Api {
	try Show(boardapi.Call(r))
}

// ReadAnswer is the outcome of r that a tool's result says: its value's
// JSON, or, when it is an error, an admitted failure's tagged JSON.
// Invalid or missing replies fail Transport, outside the operation's own row.
func ReadAnswer(r Request, result mcp.Called) boardapi.Outcome fails rpc.Transport {
	if len(result.Content) != 1 {
		return rpc.Transport{Reason: "a tool answered \(len(result.Content)) blocks, not one"}
	}
	let text = result.Content[0].Text
	if !result.IsError {
		match r {
		case boardapi.WhoamiRequest:
			let v = try rpc.Decode[board.WhoamiReply]("value", text)
			boardapi.Done{Reply: boardapi.WhoamiReply{Value: v}}
		case boardapi.BoardsRequest:
			let v = try rpc.Decode[[]board.BoardSummary]("value", text)
			boardapi.Done{Reply: boardapi.BoardsReply{Value: v}}
		case boardapi.ChannelsRequest:
			let v = try rpc.Decode[[]board.ChannelSummary]("value", text)
			boardapi.Done{Reply: boardapi.ChannelsReply{Value: v}}
		case boardapi.ChannelCreateRequest:
			let v = try rpc.Decode[board.ChannelCreatedReply]("value", text)
			boardapi.Done{Reply: boardapi.ChannelCreateReply{Value: v}}
		case boardapi.ActorsRequest:
			let v = try rpc.Decode[[]board.ActorSummary]("value", text)
			boardapi.Done{Reply: boardapi.ActorsReply{Value: v}}
		case boardapi.ReadRequest:
			let v = try rpc.Decode[board.ReadReply]("value", text)
			boardapi.Done{Reply: boardapi.ReadReply{Value: v}}
		case boardapi.SearchRequest:
			let v = try rpc.Decode[board.SearchReply]("value", text)
			boardapi.Done{Reply: boardapi.SearchReply{Value: v}}
		case boardapi.PostRequest:
			let v = try rpc.Decode[board.PostReply]("value", text)
			boardapi.Done{Reply: boardapi.PostReply{Value: v}}
		case boardapi.ThreadReplyRequest:
			let v = try rpc.Decode[board.PostReply]("value", text)
			boardapi.Done{Reply: boardapi.ThreadReplyReply{Value: v}}
		case boardapi.EditRequest:
			let v = try rpc.Decode[board.RevisionReply]("value", text)
			boardapi.Done{Reply: boardapi.EditReply{Value: v}}
		case boardapi.DeleteRequest:
			let v = try rpc.Decode[board.RevisionReply]("value", text)
			boardapi.Done{Reply: boardapi.DeleteReply{Value: v}}
		case boardapi.ReactRequest:
			let v = try rpc.Decode[board.ReactReply]("value", text)
			boardapi.Done{Reply: boardapi.ReactReply{Value: v}}
		case boardapi.LabelRequest:
			let v = try rpc.Decode[board.LabelReply]("value", text)
			boardapi.Done{Reply: boardapi.LabelReply{Value: v}}
		case boardapi.AskRequest:
			let v = try rpc.Decode[board.AskReply]("value", text)
			boardapi.Done{Reply: boardapi.AskReply{Value: v}}
		case boardapi.AskWithdrawRequest:
