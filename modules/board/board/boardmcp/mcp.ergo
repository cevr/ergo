			boardapi.Done{Reply: boardapi.BoardArchiveReply{Value: v}}
		case boardapi.TrustUpdateRequest:
			let v = try rpc.Decode[board.TrustSet]("value", text)
			boardapi.Done{Reply: boardapi.TrustUpdateReply{Value: v}}
		}
	} else {
		match r {
		case boardapi.WhoamiRequest:
			match rpc.TagOf(text) {
			case "Unauthenticated":
				let e = try rpc.Decode[board.Unauthenticated]("failure", text)
				boardapi.Rejected{Failure: boardapi.Unauthenticated{E: e}}
			case "Gone":
				let e = try rpc.Decode[board.Gone]("failure", text)
				boardapi.Rejected{Failure: boardapi.Gone{E: e}}
			case "BoardNotFound":
