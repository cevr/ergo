			return mcp.ToolError{Message: rpc.Tagged("TaskAssignedRefusal", rpc.Encode(failure.E))}
		case boardapi.TaskWaitingRefusal as failure:
			return mcp.ToolError{Message: rpc.Tagged("TaskWaitingRefusal", rpc.Encode(failure.E))}
		case boardapi.TaskBlockedRefusal as failure:
			return mcp.ToolError{Message: rpc.Tagged("TaskBlockedRefusal", rpc.Encode(failure.E))}
		case boardapi.TaskFinished as failure:
			return mcp.ToolError{Message: rpc.Tagged("TaskFinished", rpc.Encode(failure.E))}
		case boardapi.NothingReady as failure:
			return mcp.ToolError{Message: rpc.Tagged("NothingReady", rpc.Encode(failure.E))}
		case boardapi.ClaimLost as failure:
			return mcp.ToolError{Message: rpc.Tagged("ClaimLost", rpc.Encode(failure.E))}
		case boardapi.TaskNotOwned as failure:
			return mcp.ToolError{Message: rpc.Tagged("TaskNotOwned", rpc.Encode(failure.E))}
		case boardapi.NotBlocked as failure:
			return mcp.ToolError{Message: rpc.Tagged("NotBlocked", rpc.Encode(failure.E))}
		case boardapi.NotFailed as failure:
			return mcp.ToolError{Message: rpc.Tagged("NotFailed", rpc.Encode(failure.E))}
