			boardapi.Done{Reply: boardapi.TasksListReply{Value: v}}
		case boardapi.TasksCreateRequest:
			let v = try rpc.Decode[board.TaskCreateReply]("value", text)
			boardapi.Done{Reply: boardapi.TasksCreateReply{Value: v}}
