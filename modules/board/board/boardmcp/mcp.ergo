		("post", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.ThreadReplyRequest as x:
		("thread-reply", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.EditRequest as x:
		("edit", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.DeleteRequest as x:
		("delete", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.ReactRequest as x:
		("react", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.LabelRequest as x:
		("label", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.AskRequest as x:
		("ask", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.AskWithdrawRequest as x:
		("ask-withdraw", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksListRequest as x:
		("tasks-list", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksCreateRequest as x:
		("tasks-create", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksPlanRequest as x:
		("tasks-plan", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksClaimRequest as x:
		("tasks-claim", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksRenewRequest as x:
		("tasks-renew", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksReleaseRequest as x:
		("tasks-release", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksCompleteRequest as x:
		("tasks-complete", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksFailRequest as x:
		("tasks-fail", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksBlockRequest as x:
		("tasks-block", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksUnblockRequest as x:
		("tasks-unblock", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksReopenRequest as x:
		("tasks-reopen", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksAssignRequest as x:
		("tasks-assign", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksNeedsRequest as x:
		("tasks-needs", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.TasksCancelRequest as x:
		("tasks-cancel", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.GrantsRequest as x:
		("grants", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.GrantExplainRequest as x:
		("grant-explain", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.GrantCreateRequest as x:
		("grant-create", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.GrantRevokeRequest as x:
		("grant-revoke", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.BoardCreateRequest as x:
		("board-create", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.BoardRenameRequest as x:
		("board-rename", untagged(valueOf(rpc.Encode(x.Input))))
	case boardapi.BoardArchiveRequest as x:
