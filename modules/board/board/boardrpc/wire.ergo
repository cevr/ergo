func exactBoardReadInput(v board.ReadInput) fails rpc.Unrepresentable {
	exactOptionInt(v.After) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("after", u)
	}
	exactOptionInt(v.Limit) catch {
	case rpc.Unrepresentable as u:
		return rpc.Under("limit", u)
	}
}

func exactOptionInt(v Option[int]) fails rpc.Unrepresentable {
	match v {
	case Some[int] as x:
		exactInt(x.Value) catch {
		case rpc.Unrepresentable as u:
			return rpc.Under("value", u)
		}
	case None:
	}
}

func exactInt(v int) fails rpc.Unrepresentable {
	try rpc.Exact("", int64(v))
}

func exactBoardSearchInput(v board.SearchInput) fails rpc.Unrepresentable {
