import rpc
import github.com/cevr/ergo/modules/board/board
import github.com/cevr/ergo/modules/board/board/boardapi

// Request is one call of board.Api: the hub's Request, a variant per
// operation whose fields are the operation's parameters, so its payload is
// the variant's JSON. Each variant is named here too.
type Request = boardapi.Request

type WhoamiRequest = boardapi.WhoamiRequest

type BoardsRequest = boardapi.BoardsRequest

