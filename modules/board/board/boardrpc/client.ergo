import rpc
import github.com/cevr/ergo/modules/board/board
import github.com/cevr/ergo/modules/board/board/boardapi

// Client is board.Api over the wire: each operation is one call to the
// server its Conn names. <Op>Checked fails the wire's failures as typed
// failures: rpc.Unrepresentable for an int the wire cannot carry (an
// operation that carries one), rpc.Transport for a lost server, a refused
// call or an answer that is not the contract's. <Op> provides the
// operation type, whose row cannot name them, so there they are defects.
type Client { conn rpc.Conn } implements board.Api

// NewClient is the board.Api that conn serves.
func NewClient(conn rpc.Conn) Client { Client{conn: conn} }

// WhoamiChecked calls board.Api's Whoami on the server; the wire's failures are
// typed failures.
func WhoamiChecked(client Client, input board.WhoamiInput) board.WhoamiReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed | rpc.Transport {
	let p = boardapi.WhoamiRequest{Input: input}
	let text = try rpc.Call(client.conn, "Whoami", rpc.Encode(p)) catch {
	case rpc.Failed as f:
		match rpc.TagOf(f.Text) {
		case "Unauthenticated":
			let e = try rpc.Decode[board.Unauthenticated]("failure", f.Text)
			return e
		case "Gone":
			let e = try rpc.Decode[board.Gone]("failure", f.Text)
			return e
		case "BoardNotFound":
			let e = try rpc.Decode[board.BoardNotFound]("failure", f.Text)
			return e
		case "StoreFailed":
			let e = try rpc.Decode[board.StoreFailed]("failure", f.Text)
			return e
		case _:
			return rpc.Transport{Reason: "Whoami failed with a failure the contract does not name: \(f.Text)"}
		}
	case rpc.Unrepresentable as u:
		return rpc.Transport{Reason: "Whoami: the server refused the int \(u.Value) at \(u.Path), which the contract does not carry"}
	}
	let v = try rpc.Decode[board.WhoamiReply]("value", text)
	v
}

// Whoami calls board.Api's Whoami on the server, as WhoamiChecked does; an int the
// wire cannot carry and a failure of the wire are defects.
func Whoami(client Client, input board.WhoamiInput) board.WhoamiReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed {
	try WhoamiChecked(client, input) catch {
	case rpc.Transport as t:
		return rpc.Lost[board.WhoamiReply](t)
	}
}

