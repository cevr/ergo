// Boards calls board.Api's Boards on the server, as BoardsChecked does; an int the
// wire cannot carry and a failure of the wire are defects.
func Boards(client Client) []board.BoardSummary fails board.Unauthenticated | board.Gone | board.StoreFailed {
	try BoardsChecked(client) catch {
	case rpc.Unrepresentable as u:
		return rpc.Refuse[[]board.BoardSummary](u)
	case rpc.Transport as t:
		return rpc.Lost[[]board.BoardSummary](t)
