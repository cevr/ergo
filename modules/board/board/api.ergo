// BoardCreate creates a new board in the workspace.
func BoardCreate(s Handler, input BoardCreateInput) BoardSummary fails Unauthenticated | Forbidden | Invalid | Gone | BoardNameTaken | StoreFailed {
	let (evts, _) = execCmd(s, CreateBoard{Caller: s.caller, Name: input.Name}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case BoardNameTaken as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "name", Why: "board create refused"}
	}
	for e in evts {
		match e.Payload {
		case BoardCreated as p:
			return BoardSummary{ID: p.Board.ID, Name: p.Board.Name, Archived: p.Board.Archived, Head: p.Board.Head}
		case _:
		}
	}
	BoardSummary{ID: "", Name: input.Name, Archived: false, Head: 0}
}

// BoardRename renames an existing board.
func BoardRename(s Handler, input BoardRenameInput) BoardSummary fails Unauthenticated | Forbidden | Invalid | Gone | BoardNameTaken | BoardNotFound | BoardArchived | StoreFailed {
	let _ = execCmd(s, RenameBoard{Caller: s.caller, Board: input.Board, NewName: input.NewName}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case BoardNameTaken as e:
		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "newName", Why: "board rename refused"}
	}
	let snap = try s.store.Snapshot()
	match snap.Boards.Get(input.NewName) {
	case option.Some[BoardRecord] as b:
		BoardSummary{ID: b.Value.ID, Name: b.Value.Name, Archived: b.Value.Archived, Head: b.Value.Head}
	case option.None:
		BoardSummary{ID: "", Name: input.NewName, Archived: false, Head: 0}
	}
}

