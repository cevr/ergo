// Grants lists all grants on a board for callers holding manage at *.
func Grants(s Handler, input GrantsInput) []Grant fails Unauthenticated | Forbidden | Gone | BoardNotFound | StoreFailed {
	let snap = try s.store.Snapshot()
	try checkSessionActive(snap, s.caller)
	let bName = ResolveBoard(optStr(input.Board))
	match snap.Boards.Get(bName) {
	case option.Some[BoardRecord]:
	case option.None:
		return BoardNotFound
	}
	let gs = boardGrantsOf(snap, bName)
	if !Can(gs, s.caller, "*", PermManage) {
		return Forbidden{Permission: "manage", Channel: "*"}
	}
	gs
}

func decidingGrantID(gs []Grant, c Caller, channel string) GrantID {
	let mut bestPSpec = -1
	let mut bestCSpec = -1
	let mut winner = ""
	for g in gs {
		let pSpec = bestPrincipalMatch(g.Principals, c)
		if pSpec < 0 {
			continue
		}
		for r in g.Rules {
			let cSpec = PatternSpecificity(r.Pattern, channel)
			if cSpec < 0 {
				continue
			}
			if cSpec > bestCSpec || (cSpec == bestCSpec && pSpec >= bestPSpec) {
				bestCSpec = cSpec
				bestPSpec = pSpec
				winner = g.ID
			}
		}
	}
	winner
}

// GrantExplain explains which grant decides effective permissions on a channel.
func GrantExplain(s Handler, input GrantExplainInput) GrantExplainReply fails Unauthenticated | Forbidden | NotFound | Invalid | Gone | BoardNotFound | StoreFailed {
	let snap = try s.store.Snapshot()
	try checkSessionActive(snap, s.caller)
	let bName = ResolveBoard(optStr(input.Board))
	match snap.Boards.Get(bName) {
	case option.Some[BoardRecord]:
	case option.None:
		return BoardNotFound
	}
	if !ValidChannelPath(input.Channel) {
		return Invalid{Field: "channel", Why: "invalid channel path"}
	}
	let gs = boardGrantsOf(snap, bName)
	let targetArg = optStr(input.Principal)
	let subject = if targetArg == "" || targetArg == s.caller.Principal {
		s.caller
	} else {
		if !Can(gs, s.caller, "*", PermManage) {
			return Forbidden{Permission: "manage", Channel: "*"}
		}
		match snap.Principals.Get(targetArg) {
		case option.Some[Principal] as p:
			Caller{
				Principal:       p.Value.ID,
				Profile:         "",
				Role:            p.Value.Role,
				Kind:            p.Value.Kind,
				Email:           p.Value.Email,
				Narrowed:        false,
				NarrowedCan:     Map[string, []Permission]{},
				NarrowedProfile: "",
				NarrowedBoards:  []string{},
			}
		case option.None:
			return NotFound{What: targetArg}
		}
	}
	let ps = EffectivePermissions(gs, subject, input.Channel)
	let mut names = []string{}
	for p in ps {
		names = names.Append(PermissionName(p))
	}
	GrantExplainReply{Board: bName, Channel: input.Channel, Decides: decidingGrantID(gs, subject, input.Channel), Can: names}
}

// GrantCreate creates a new grant on a board.
func GrantCreate(s Handler, input GrantCreateInput) Grant fails Unauthenticated | Forbidden | Invalid | Gone | BoardNotFound | BoardArchived | StoreFailed {
	let bName = ResolveBoard(optStr(input.Board))
	let (evts, _) = execCmd(s, CreateGrant{
		Caller: s.caller,
		Board:  bName,
		Grant:  Grant{ID: "", Principals: input.Principals, Rules: input.Rules, CreatedBy: ActorOf(s.caller), CreatedAt: nowMs(s), Revision: 1},
	}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "rules", Why: "grant create refused"}
	}
	for e in evts {
		match e.Payload {
		case GrantCreated as p:
			return p.Grant
		case _:
		}
	}
	Grant{ID: "", Principals: input.Principals, Rules: input.Rules, CreatedBy: ActorOf(s.caller), CreatedAt: nowMs(s), Revision: 1}
}

