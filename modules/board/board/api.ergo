		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "token", Why: "complete refused"}
	}
	let mut readied = []MessageID{}
	for e in evts {
