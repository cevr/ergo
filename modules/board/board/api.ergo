func taskMatchesStateFilter(st TaskState, filter string) bool {
	if filter == "" || filter == "open" {
		return st == TaskWaiting || st == TaskReady || st == TaskClaimed || st == TaskBlocked
	}
	if filter == "all" {
		return true
	}
	taskStateString(st) == filter
}

// TasksList lists readable tasks matching optional filters with trusted: false.
func TasksList(s Handler, input TasksListInput) TasksListReply fails Unauthenticated | Invalid | Gone | BoardNotFound | StoreFailed {
	let snap = try s.store.Snapshot()
	try checkSessionActive(snap, s.caller)
	let bName = ResolveBoard(optStr(input.Board))
	match snap.Boards.Get(bName) {
	case option.Some[BoardRecord]:
	case option.None:
		return BoardNotFound
	}
	let gs = boardGrantsOf(snap, bName)
	let chF = optStr(input.Channel)
	let stF = optStr(input.State)
	let byF = optStr(input.By)
	let forF = optStr(input.For)
	let rawLimit = optInt(input.Limit, 100)
	let limit = if rawLimit <= 0 { 100 } else if rawLimit > 500 { 500 } else { rawLimit }
	let mut out = []TaskView{}
	for tid in slices.Sorted(maps.Keys(snap.Tasks)) {
		if out.Len() >= limit {
			break
		}
		match snap.Tasks.Get(tid) {
		case option.Some[TaskRecord] as tr:
			let t = tr.Value
			if t.Board != bName || !Can(gs, s.caller, t.Channel, PermRead) {
				continue
			}
			if chF != "" && !channelMatchesPrefix(t.Channel, chF) {
				continue
			}
			if !taskMatchesStateFilter(t.State, stF) {
				continue
			}
			if byF != "" {
				let wantBy = resolveActorFilter(snap, s.caller, byF)
				if t.Owner != wantBy && t.OwnerPrincipal != wantBy {
					continue
				}
			}
			if forF != "" && t.For != resolveActorFilter(snap, s.caller, forF) {
				continue
			}
			if input.Label.Len() > 0 {
				let lbs = match snap.Messages.Get(t.ID) {
				case option.Some[Message] as m:
					m.Value.Labels
				case option.None:
					Map[string, string]{}
				}
				if !matchesAllLabels(lbs, input.Label) {
					continue
				}
			}
			out = out.Append(taskViewOf(snap, t, false))
		case option.None:
		}
	}
	TasksListReply{Board: bName, Cursor: boardHeadOf(snap, bName), Tasks: out}
}

// TasksCreate creates a new task or attaches task state to an existing thread.
func TasksCreate(s Handler, input TasksCreateInput) TaskCreateReply fails Unauthenticated | Forbidden | NotFound | Invalid | Gone | TooLarge | SecretDetected | IdempotencyConflict | ReservedLabel | AlreadyTask | InvalidNeeds | TaskOwnerUntrusted | BoardNotFound | BoardArchived | StoreFailed {
	let bName = ResolveBoard(optStr(input.Board))
	let idem = optStr(input.IdempotencyKey)
	let labels = try parseLabelPairs(input.Labels, "labels")
	let (evts, _) = execCmd(s, CreateTask{
		Caller:         s.caller,
		Board:          bName,
		Channel:        optStr(input.Channel),
		Thread:         optStr(input.ID),
		Text:           optStr(input.Text),
		Labels:         labels,
		Needs:          input.Needs,
		For:            optStr(input.For),
		Claim:          input.Claim,
		LeaseMs:        optInt(input.LeaseMs, MaxLeaseMs),
		NoSync:         input.NoSync,
		IdempotencyKey: idem,
	}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case NotFound as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case TooLarge as e:
		return e
	case SecretDetected as e:
		return e
	case IdempotencyConflict as e:
		return e
	case ReservedLabel as e:
		return e
	case AlreadyTask as e:
		return e
	case InvalidNeeds as e:
		return e
	case TaskOwnerUntrusted as e:
		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "text", Why: "task create refused"}
	}
	let mut tid = optStr(input.ID)
	for e in evts {
		match e.Payload {
		case TaskCreated as p:
			tid = p.Task.ID
		case _:
		}
	}
	let snap = try s.store.Snapshot()
	if tid == "" && idem != "" {
		match snap.Idempotency.Get(IdempotencyKey{Actor: ActorOf(s.caller), Key: idem}) {
		case option.Some[IdempotencyEntry] as ie:
			tid = ie.Value.ResultMessageID
		case option.None:
		}
	}
	match snap.Tasks.Get(tid) {
	case option.Some[TaskRecord] as tr:
		let tok = if tr.Value.HasClaim { tr.Value.Claim.Epoch } else { 0 }
		let lu = if tr.Value.HasClaim { tr.Value.Claim.LeaseUntil } else { 0 }
		TaskCreateReply{ID: tr.Value.ID, State: taskStateString(tr.Value.State), Token: tok, LeaseUntil: lu}
	case option.None:
		TaskCreateReply{ID: tid, State: "ready", Token: 0, LeaseUntil: 0}
	}
}

// TasksPlan atomically creates a prerequisite DAG of up to 15 tasks.
func TasksPlan(s Handler, input TasksPlanInput) TasksPlanReply fails Unauthenticated | Forbidden | NotFound | Invalid | Gone | TooLarge | SecretDetected | IdempotencyConflict | ReservedLabel | InvalidNeeds | PlanTooLarge | BoardNotFound | BoardArchived | StoreFailed {
	let bName = ResolveBoard(optStr(input.Board))
	let (evts, head) = execCmd(s, CreatePlan{
		Caller:         s.caller,
		Board:          bName,
		Channel:        input.Channel,
		Tasks:          input.Tasks,
		IdempotencyKey: optStr(input.IdempotencyKey),
	}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case NotFound as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case TooLarge as e:
		return e
	case SecretDetected as e:
		return e
	case IdempotencyConflict as e:
		return e
	case ReservedLabel as e:
		return e
	case InvalidNeeds as e:
		return e
	case PlanTooLarge as e:
		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "tasks", Why: "plan creation refused"}
	}
	let mut created = []TaskRecord{}
	for e in evts {
		match e.Payload {
		case TaskCreated as p:
			created = created.Append(p.Task)
		case _:
		}
	}
	let mut summaries = []PlannedTaskSummary{}
	for i, tr in created {
		let k = if i < input.Tasks.Len() && input.Tasks[i].Key != "" { input.Tasks[i].Key } else { tr.ID }
		summaries = summaries.Append(PlannedTaskSummary{Key: k, ID: tr.ID, State: taskStateString(tr.State)})
	}
	TasksPlanReply{Board: bName, Cursor: head, Tasks: summaries}
}

func pickReadyTaskID(snap State, bName string, caller Caller, readyCh string, labels []string) MessageID fails NothingReady | NotFound {
	let gs = boardGrantsOf(snap, bName)
	if !Can(gs, caller, strings.TrimSuffix(readyCh, "/"), PermRead) {
		return NotFound{What: readyCh}
	}
	let actor = ActorOf(caller)
	let mut found = false
	let mut bestID = ""
	let mut bestReadyAt = 0
	for tid in slices.Sorted(maps.Keys(snap.Tasks)) {
		match snap.Tasks.Get(tid) {
		case option.Some[TaskRecord] as tr:
			let t = tr.Value
			if t.Board != bName || t.State != TaskReady || !channelMatchesPrefix(t.Channel, readyCh) {
				continue
			}
			if !Can(gs, caller, t.Channel, PermPost) {
				continue
			}
			if t.For != "" && t.For != actor {
				continue
			}
			if !TrustedOwner(snap, caller, t.Owner) {
				continue
			}
			if labels.Len() > 0 {
				let lbs = match snap.Messages.Get(t.ID) {
				case option.Some[Message] as m:
					m.Value.Labels
				case option.None:
					Map[string, string]{}
				}
				if !matchesAllLabels(lbs, labels) {
					continue
				}
			}
			if !found || t.ReadyAt < bestReadyAt || (t.ReadyAt == bestReadyAt && t.ID < bestID) {
				found = true
				bestID = t.ID
				bestReadyAt = t.ReadyAt
			}
		case option.None:
		}
	}
	if !found {
		return NothingReady
	}
	bestID
}

// TasksClaim claims a task by ID or from a channel queue and returns trusted: true.
func TasksClaim(s Handler, input TasksClaimInput) TaskClaimReply fails Unauthenticated | Forbidden | NotFound | Invalid | Gone | TaskClaimedRefusal | TaskAssignedRefusal | TaskWaitingRefusal | TaskBlockedRefusal | TaskFinished | TaskOwnerUntrusted | NothingReady | BoardNotFound | BoardArchived | StoreFailed {
	let bName = ResolveBoard(optStr(input.Board))
	let idArg = optStr(input.ID)
	let readyArg = optStr(input.Ready)
	let targetID = if idArg != "" {
		idArg
	} else if readyArg != "" {
		let snap = try s.store.Snapshot()
		try checkSessionActive(snap, s.caller)
		match snap.Boards.Get(bName) {
		case option.Some[BoardRecord]:
		case option.None:
			return BoardNotFound
		}
		try pickReadyTaskID(snap, bName, s.caller, readyArg, input.Label)
	} else {
		return Invalid{Field: "id", Why: "provide id or ready channel"}
	}
	let _ = execCmd(s, ClaimTask{
		Caller:  s.caller,
		Board:   bName,
		ID:      targetID,
		LeaseMs: optInt(input.LeaseMs, MaxLeaseMs),
	}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case NotFound as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case TaskClaimedRefusal as e:
		return e
	case TaskAssignedRefusal as e:
		return e
	case TaskWaitingRefusal as e:
		return e
	case TaskBlockedRefusal as e:
		return e
	case TaskFinished as e:
		return e
	case TaskOwnerUntrusted as e:
		return e
	case NothingReady as e:
		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "id", Why: "claim refused"}
	}
	let after = try s.store.Snapshot()
	match after.Tasks.Get(targetID) {
	case option.Some[TaskRecord] as tr:
		TaskClaimReply{
			Task:       taskViewOf(after, tr.Value, true),
			Token:      tr.Value.Claim.Epoch,
			LeaseUntil: tr.Value.Claim.LeaseUntil,
		}
	case option.None:
		return NotFound{What: targetID}
	}
}

// TasksRenew extends an active claim's lease under its fencing token.
func TasksRenew(s Handler, input TasksRenewInput) TaskRenewReply fails Unauthenticated | Forbidden | NotFound | Invalid | Gone | ClaimLost | BoardNotFound | BoardArchived | StoreFailed {
	let bName = ResolveBoard(optStr(input.Board))
	let (evts, _) = execCmd(s, RenewTask{
		Caller:  s.caller,
		Board:   bName,
		ID:      input.ID,
		Token:   input.Token,
		LeaseMs: optInt(input.LeaseMs, MaxLeaseMs),
	}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case NotFound as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case ClaimLost as e:
		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "token", Why: "renew refused"}
	}
	for e in evts {
		match e.Payload {
		case TaskRenewed as p:
			return TaskRenewReply{ID: p.ID, LeaseUntil: p.LeaseUntil}
		case _:
		}
	}
	TaskRenewReply{ID: input.ID, LeaseUntil: 0}
}

