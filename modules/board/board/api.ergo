// Ask opens a question in a channel or existing thread.
func Ask(s Handler, input AskInput) AskReply fails Unauthenticated | Forbidden | NotFound | Invalid | Gone | TooLarge | SecretDetected | IdempotencyConflict | BoardNotFound | BoardArchived | StoreFailed {
	let bName = ResolveBoard(optStr(input.Board))
	let now = nowMs(s)
	let expIn = optInt(input.ExpiresInMs, 0)
	let expiresAt = if expIn > 0 { now + expIn } else { 0 }
	let idem = optStr(input.IdempotencyKey)
	let (evts, head) = execCmd(s, OpenAsk{
		Caller:         s.caller,
		Board:          bName,
		Channel:        optStr(input.Channel),
		Thread:         optStr(input.Thread),
		Text:           input.Text,
		To:             input.To,
		OnlyFromAsked:  input.OnlyFromAsked,
		ExpiresAt:      expiresAt,
		IdempotencyKey: idem,
	}) catch {
	case Unauthenticated as e:
		return e
	case Forbidden as e:
		return e
	case NotFound as e:
		return e
	case Invalid as e:
		return e
	case Gone as e:
		return e
	case TooLarge as e:
		return e
	case SecretDetected as e:
		return e
	case IdempotencyConflict as e:
		return e
	case BoardNotFound as e:
		return e
	case BoardArchived as e:
		return e
	case StoreFailed as e:
		return e
	case _:
		return Invalid{Field: "text", Why: "ask refused"}
	}
	let snap = try s.store.Snapshot()
	let pr = postReplyFromEvents(snap, bName, evts, head, s.caller, idem)
	let stateStr = match snap.Asks.Get(pr.ID) {
	case option.Some[AskRecord] as a:
		askStateString(a.Value.State)
	case option.None:
		"open"
	}
	AskReply{
		ID:         pr.ID,
		Board:      bName,
		Cursor:     pr.Cursor,
		State:      stateStr,
		Mentioned:  pr.Mentioned,
		Unresolved: pr.Unresolved,
	}
}

