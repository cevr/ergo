		case board.TooLarge as e:
			return Rejected{Failure: TooLarge{E: e}}
		case board.SecretDetected as e:
			return Rejected{Failure: SecretDetected{E: e}}
		case board.IdempotencyConflict as e:
			return Rejected{Failure: IdempotencyConflict{E: e}}
		case board.ReservedLabel as e:
			return Rejected{Failure: ReservedLabel{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: PostReply{Value: v}}
	case ThreadReplyRequest as x:
		let v = ThreadReplyChecked(client, x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Forbidden as e:
			return Rejected{Failure: Forbidden{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case board.BoardArchived as e:
			return Rejected{Failure: BoardArchived{E: e}}
		case board.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case board.TooLarge as e:
			return Rejected{Failure: TooLarge{E: e}}
		case board.SecretDetected as e:
			return Rejected{Failure: SecretDetected{E: e}}
		case board.IdempotencyConflict as e:
			return Rejected{Failure: IdempotencyConflict{E: e}}
		case board.ReservedLabel as e:
			return Rejected{Failure: ReservedLabel{E: e}}
		case board.NewerMessage as e:
			return Rejected{Failure: NewerMessage{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: ThreadReplyReply{Value: v}}
	case EditRequest as x:
