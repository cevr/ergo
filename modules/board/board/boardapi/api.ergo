			return failure.E
		case Invalid as failure:
			return failure.E
		case BoardArchived as failure:
			return failure.E
		case BoardNameTaken as failure:
			return failure.E
		case _:
			Unreachable("boardapi: BoardRename was answered with a failure outside its row")
		}
	}
}

// BoardArchive sends board.Api's BoardArchive and answers its Outcome.
func BoardArchive(client Client, input board.BoardArchiveInput) board.BoardSummary fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed | board.Forbidden | board.Invalid | board.BoardArchived {
	match client.send(BoardArchiveRequest{Input: input}) {
	case Done as done:
		match done.Reply {
		case BoardArchiveReply as reply:
			reply.Value
		case _:
			Unreachable("boardapi: BoardArchive was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unauthenticated as failure:
			return failure.E
		case Gone as failure:
			return failure.E
		case BoardNotFound as failure:
			return failure.E
		case StoreFailed as failure:
			return failure.E
		case Forbidden as failure:
			return failure.E
		case Invalid as failure:
			return failure.E
		case BoardArchived as failure:
			return failure.E
		case _:
			Unreachable("boardapi: BoardArchive was answered with a failure outside its row")
		}
	}
}

// TrustUpdate sends board.Api's TrustUpdate and answers its Outcome.
func TrustUpdate(client Client, input board.TrustUpdateInput) board.TrustSet fails board.Unauthenticated | board.Gone | board.StoreFailed | board.Forbidden | board.Invalid {
	match client.send(TrustUpdateRequest{Input: input}) {
	case Done as done:
		match done.Reply {
		case TrustUpdateReply as reply:
			reply.Value
		case _:
			Unreachable("boardapi: TrustUpdate was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unauthenticated as failure:
			return failure.E
		case Gone as failure:
			return failure.E
		case StoreFailed as failure:
			return failure.E
		case Forbidden as failure:
			return failure.E
		case Invalid as failure:
			return failure.E
		case _:
			Unreachable("boardapi: TrustUpdate was answered with a failure outside its row")
		}
	}
}

// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Whoami board.WhoamiReply, Boards []board.BoardSummary, Channels []board.ChannelSummary, ChannelCreate board.ChannelCreatedReply, Actors []board.ActorSummary, Read board.ReadReply, Search board.SearchReply, Post board.PostReply, ThreadReply board.PostReply, Edit board.RevisionReply, Delete board.RevisionReply, React board.ReactReply, Label board.LabelReply, Ask board.AskReply, AskWithdraw board.AskStateReply, TasksList board.TasksListReply, TasksCreate board.TaskCreateReply, TasksPlan board.TasksPlanReply, TasksClaim board.TaskClaimReply, TasksRenew board.TaskRenewReply, TasksRelease board.TaskStateReply, TasksComplete board.TaskCompleteReply, TasksFail board.TaskStateReply, TasksBlock board.TaskStateReply, TasksUnblock board.TaskStateReply, TasksReopen board.TaskStateReply, TasksAssign board.TaskAssignReply, TasksNeeds board.TaskNeedsReply, TasksCancel board.TaskStateReply, Grants []board.Grant, GrantExplain board.GrantExplainReply, GrantCreate board.Grant, GrantRevoke board.GrantRevokedReply, BoardCreate board.BoardSummary, BoardRename board.BoardSummary, BoardArchive board.BoardSummary, TrustUpdate board.TrustSet }

func inRow(op Op, f Failure) bool {
	match op {
	case WhoamiOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed:
			true
		case _:
			false
		}
	case BoardsOp:
		match f {
		case Unauthenticated, Gone, StoreFailed:
			true
		case _:
			false
		}
	case ChannelsOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed:
			true
		case _:
			false
		}
	case ChannelCreateOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, ChannelExists, ChannelGranted, BoardArchived:
			true
		case _:
			false
		}
	case ActorsOp:
		match f {
		case Unauthenticated, Gone, StoreFailed:
			true
		case _:
			false
		}
	case ReadOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Invalid, NotFound:
			true
		case _:
			false
		}
	case SearchOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Invalid:
			true
		case _:
			false
		}
	case PostOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, IdempotencyConflict, ReservedLabel:
			true
		case _:
			false
		}
	case ThreadReplyOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, IdempotencyConflict, ReservedLabel, NewerMessage:
			true
		case _:
			false
		}
	case EditOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, NotAuthor, RevisionConflict:
			true
		case _:
			false
		}
	case DeleteOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, NotAuthor, RevisionConflict:
			true
		case _:
			false
		}
	case ReactOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound:
			true
		case _:
			false
		}
	case LabelOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, ReservedLabel, LabelConflict:
			true
		case _:
			false
		}
	case AskOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, IdempotencyConflict:
			true
		case _:
			false
		}
	case AskWithdrawOp:
