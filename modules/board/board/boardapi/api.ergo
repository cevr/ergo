// Call answers r on the bound board.Api: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs board.Api {
	match r {
	case WhoamiRequest as x:
		let v = board.Api.Whoami(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: WhoamiReply{Value: v}}
	case BoardsRequest:
		let v = board.Api.Boards() catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: BoardsReply{Value: v}}
	case ChannelsRequest as x:
		let v = board.Api.Channels(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: ChannelsReply{Value: v}}
	case ChannelCreateRequest as x:
		let v = board.Api.ChannelCreate(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Forbidden as e:
			return Rejected{Failure: Forbidden{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case board.ChannelExists as e:
			return Rejected{Failure: ChannelExists{E: e}}
		case board.ChannelGranted as e:
			return Rejected{Failure: ChannelGranted{E: e}}
		case board.BoardArchived as e:
			return Rejected{Failure: BoardArchived{E: e}}
		}
		Done{Reply: ChannelCreateReply{Value: v}}
	case ActorsRequest as x:
		let v = board.Api.Actors(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		}
		Done{Reply: ActorsReply{Value: v}}
	case ReadRequest as x:
		let v = board.Api.Read(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case board.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		}
		Done{Reply: ReadReply{Value: v}}
	case SearchRequest as x:
		let v = board.Api.Search(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		}
		Done{Reply: SearchReply{Value: v}}
	case PostRequest as x:
		let v = board.Api.Post(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
