		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TaskOwnerUntrusted, TaskClaimedRefusal, TaskAssignedRefusal, TaskWaitingRefusal, TaskBlockedRefusal, TaskFinished, NothingReady:
			true
		case _:
			false
		}
	case TasksRenewOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, ClaimLost:
			true
		case _:
			false
		}
	case TasksReleaseOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, ClaimLost:
			true
		case _:
			false
		}
	case TasksCompleteOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, ClaimLost:
			true
		case _:
			false
		}
	case TasksFailOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, ClaimLost:
			true
		case _:
			false
		}
	case TasksBlockOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, TaskFinished, ClaimLost, TaskNotOwned:
			true
		case _:
			false
		}
	case TasksUnblockOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TaskNotOwned, NotBlocked:
			true
		case _:
			false
		}
	case TasksReopenOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TaskNotOwned, NotFailed:
			true
		case _:
			false
		}
	case TasksAssignOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TaskFinished, TaskNotOwned:
			true
		case _:
			false
		}
	case TasksNeedsOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, InvalidNeeds, TaskClaimedRefusal, TaskFinished, TaskNotOwned:
			true
		case _:
			false
		}
	case TasksCancelOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound, TooLarge, SecretDetected, TaskFinished, TaskNotOwned:
			true
		case _:
			false
		}
	case GrantsOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden:
			true
		case _:
			false
		}
	case GrantExplainOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, NotFound:
			true
		case _:
			false
		}
	case GrantCreateOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived:
			true
		case _:
			false
		}
	case GrantRevokeOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, NotFound:
			true
		case _:
			false
		}
	case BoardCreateOp:
		match f {
		case Unauthenticated, Gone, StoreFailed, Forbidden, Invalid, BoardNameTaken:
			true
		case _:
			false
		}
	case BoardRenameOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived, BoardNameTaken:
			true
		case _:
			false
		}
	case BoardArchiveOp:
		match f {
		case Unauthenticated, Gone, BoardNotFound, StoreFailed, Forbidden, Invalid, BoardArchived:
			true
		case _:
			false
		}
	case TrustUpdateOp:
		match f {
		case Unauthenticated, Gone, StoreFailed, Forbidden, Invalid:
			true
		case _:
			false
		}
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case WhoamiRequest:
		Done{Reply: WhoamiReply{Value: g.Values.Whoami}}
	case BoardsRequest:
		Done{Reply: BoardsReply{Value: g.Values.Boards}}
	case ChannelsRequest:
		Done{Reply: ChannelsReply{Value: g.Values.Channels}}
	case ChannelCreateRequest:
		Done{Reply: ChannelCreateReply{Value: g.Values.ChannelCreate}}
	case ActorsRequest:
		Done{Reply: ActorsReply{Value: g.Values.Actors}}
	case ReadRequest:
		Done{Reply: ReadReply{Value: g.Values.Read}}
	case SearchRequest:
		Done{Reply: SearchReply{Value: g.Values.Search}}
	case PostRequest:
		Done{Reply: PostReply{Value: g.Values.Post}}
	case ThreadReplyRequest:
		Done{Reply: ThreadReplyReply{Value: g.Values.ThreadReply}}
	case EditRequest:
		Done{Reply: EditReply{Value: g.Values.Edit}}
	case DeleteRequest:
		Done{Reply: DeleteReply{Value: g.Values.Delete}}
	case ReactRequest:
		Done{Reply: ReactReply{Value: g.Values.React}}
	case LabelRequest:
		Done{Reply: LabelReply{Value: g.Values.Label}}
	case AskRequest:
		Done{Reply: AskReply{Value: g.Values.Ask}}
	case AskWithdrawRequest:
		Done{Reply: AskWithdrawReply{Value: g.Values.AskWithdraw}}
	case TasksListRequest:
		Done{Reply: TasksListReply{Value: g.Values.TasksList}}
	case TasksCreateRequest:
		Done{Reply: TasksCreateReply{Value: g.Values.TasksCreate}}
	case TasksPlanRequest:
		Done{Reply: TasksPlanReply{Value: g.Values.TasksPlan}}
	case TasksClaimRequest:
		Done{Reply: TasksClaimReply{Value: g.Values.TasksClaim}}
	case TasksRenewRequest:
		Done{Reply: TasksRenewReply{Value: g.Values.TasksRenew}}
	case TasksReleaseRequest:
		Done{Reply: TasksReleaseReply{Value: g.Values.TasksRelease}}
	case TasksCompleteRequest:
		Done{Reply: TasksCompleteReply{Value: g.Values.TasksComplete}}
	case TasksFailRequest:
		Done{Reply: TasksFailReply{Value: g.Values.TasksFail}}
	case TasksBlockRequest:
		Done{Reply: TasksBlockReply{Value: g.Values.TasksBlock}}
	case TasksUnblockRequest:
		Done{Reply: TasksUnblockReply{Value: g.Values.TasksUnblock}}
	case TasksReopenRequest:
		Done{Reply: TasksReopenReply{Value: g.Values.TasksReopen}}
	case TasksAssignRequest:
		Done{Reply: TasksAssignReply{Value: g.Values.TasksAssign}}
	case TasksNeedsRequest:
		Done{Reply: TasksNeedsReply{Value: g.Values.TasksNeeds}}
	case TasksCancelRequest:
		Done{Reply: TasksCancelReply{Value: g.Values.TasksCancel}}
	case GrantsRequest:
		Done{Reply: GrantsReply{Value: g.Values.Grants}}
	case GrantExplainRequest:
		Done{Reply: GrantExplainReply{Value: g.Values.GrantExplain}}
	case GrantCreateRequest:
		Done{Reply: GrantCreateReply{Value: g.Values.GrantCreate}}
	case GrantRevokeRequest:
		Done{Reply: GrantRevokeReply{Value: g.Values.GrantRevoke}}
	case BoardCreateRequest:
		Done{Reply: BoardCreateReply{Value: g.Values.BoardCreate}}
	case BoardRenameRequest:
		Done{Reply: BoardRenameReply{Value: g.Values.BoardRename}}
	case BoardArchiveRequest:
		Done{Reply: BoardArchiveReply{Value: g.Values.BoardArchive}}
	case TrustUpdateRequest:
		Done{Reply: TrustUpdateReply{Value: g.Values.TrustUpdate}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opWhoami: func(input board.WhoamiInput) board.WhoamiReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(WhoamiRequest{Input: input}) })
			if g.Failing {
				match g.Failure {
				case Unauthenticated as err:
					return err.E
				case Gone as err:
					return err.E
				case BoardNotFound as err:
					return err.E
				case StoreFailed as err:
					return err.E
				case _:
				}
			}
			g.Values.Whoami
		},
		opBoards: func() []board.BoardSummary fails board.Unauthenticated | board.Gone | board.StoreFailed {
