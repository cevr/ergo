// ClientInForce is the board.Api that invokes the provider currently in force.
func ClientInForce() Client needs board.Api {
	let held = scope.InForce[board.Api]()
	Client{
		opWhoami:        func(input board.WhoamiInput) board.WhoamiReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed { with held { try board.Api.Whoami(input) } },
		opBoards:        func() []board.BoardSummary fails board.Unauthenticated | board.Gone | board.StoreFailed { with held { try board.Api.Boards() } },
		opChannels:      func(input board.ChannelsInput) []board.ChannelSummary fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed { with held { try board.Api.Channels(input) } },
		opChannelCreate: func(input board.ChannelCreateInput) board.ChannelCreatedReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed | board.Forbidden | board.Invalid | board.ChannelExists | board.ChannelGranted | board.BoardArchived { with held { try board.Api.ChannelCreate(input) } },
		opActors:        func(input board.ActorsInput) []board.ActorSummary fails board.Unauthenticated | board.Gone | board.StoreFailed { with held { try board.Api.Actors(input) } },
