// Client provides board.Api over send, any way to carry a Request to a
// Call and its Outcome back. An Outcome that is not the operation's (the
// value of another, a failure outside its row) is a defect.
type Client { send func(r Request) Outcome } implements board.Api

// NewClient is the board.Api that send answers.
func NewClient(send own func(r Request) Outcome) Client { Client{send: send} }

// Whoami sends board.Api's Whoami and answers its Outcome.
func Whoami(client Client, input board.WhoamiInput) board.WhoamiReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed {
	match client.send(WhoamiRequest{Input: input}) {
	case Done as done:
		match done.Reply {
		case WhoamiReply as reply:
			reply.Value
		case _:
			Unreachable("boardapi: Whoami was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unauthenticated as failure:
			return failure.E
		case Gone as failure:
			return failure.E
		case BoardNotFound as failure:
			return failure.E
		case StoreFailed as failure:
			return failure.E
		case _:
			Unreachable("boardapi: Whoami was answered with a failure outside its row")
		}
	}
}

