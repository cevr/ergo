		case board.TaskFinished as e:
			return Rejected{Failure: TaskFinished{E: e}}
		case board.TaskNotOwned as e:
			return Rejected{Failure: TaskNotOwned{E: e}}
		}
		Done{Reply: TasksCancelReply{Value: v}}
	case GrantsRequest as x:
		let v = board.Api.Grants(x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
