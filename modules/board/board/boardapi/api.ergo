func ChannelCreateChecked(client CheckedClient, input board.ChannelCreateInput) board.ChannelCreatedReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed | board.Forbidden | board.Invalid | board.ChannelExists | board.ChannelGranted | board.BoardArchived | rpc.Transport {
