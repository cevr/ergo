// CheckedClient carries erased board.Api requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// WhoamiChecked sends board.Api's Whoami over send and validates its Outcome.
func WhoamiChecked(client CheckedClient, input board.WhoamiInput) board.WhoamiReply fails board.Unauthenticated | board.Gone | board.BoardNotFound | board.StoreFailed | rpc.Transport {
	match try client.send(WhoamiRequest{Input: input}) {
	case Done as done:
		match done.Reply {
		case WhoamiReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "boardapi: Whoami was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unauthenticated as failure:
			return failure.E
		case Gone as failure:
			return failure.E
		case BoardNotFound as failure:
			return failure.E
		case StoreFailed as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "boardapi: Whoami was answered with a failure outside its row"}
		}
	}
}

// BoardsChecked sends board.Api's Boards over send and validates its Outcome.
func BoardsChecked(client CheckedClient) []board.BoardSummary fails board.Unauthenticated | board.Gone | board.StoreFailed | rpc.Transport {
	match try client.send(BoardsRequest) {
	case Done as done:
		match done.Reply {
		case BoardsReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "boardapi: Boards was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unauthenticated as failure:
			return failure.E
		case Gone as failure:
			return failure.E
		case StoreFailed as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "boardapi: Boards was answered with a failure outside its row"}
		}
	}
}

