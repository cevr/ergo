		case board.BoardArchived as e:
			return Rejected{Failure: BoardArchived{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: GrantCreateReply{Value: v}}
	case GrantRevokeRequest as x:
		let v = GrantRevokeChecked(client, x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Forbidden as e:
			return Rejected{Failure: Forbidden{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case board.BoardArchived as e:
			return Rejected{Failure: BoardArchived{E: e}}
		case board.NotFound as e:
			return Rejected{Failure: NotFound{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: GrantRevokeReply{Value: v}}
	case BoardCreateRequest as x:
		let v = BoardCreateChecked(client, x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Forbidden as e:
			return Rejected{Failure: Forbidden{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case board.BoardNameTaken as e:
			return Rejected{Failure: BoardNameTaken{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: BoardCreateReply{Value: v}}
	case BoardRenameRequest as x:
		let v = BoardRenameChecked(client, x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Forbidden as e:
			return Rejected{Failure: Forbidden{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case board.BoardArchived as e:
			return Rejected{Failure: BoardArchived{E: e}}
		case board.BoardNameTaken as e:
			return Rejected{Failure: BoardNameTaken{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: BoardRenameReply{Value: v}}
	case BoardArchiveRequest as x:
		let v = BoardArchiveChecked(client, x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.BoardNotFound as e:
			return Rejected{Failure: BoardNotFound{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Forbidden as e:
			return Rejected{Failure: Forbidden{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case board.BoardArchived as e:
			return Rejected{Failure: BoardArchived{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: BoardArchiveReply{Value: v}}
	case TrustUpdateRequest as x:
		let v = TrustUpdateChecked(client, x.Input) catch {
		case board.Unauthenticated as e:
			return Rejected{Failure: Unauthenticated{E: e}}
		case board.Gone as e:
			return Rejected{Failure: Gone{E: e}}
		case board.StoreFailed as e:
			return Rejected{Failure: StoreFailed{E: e}}
		case board.Forbidden as e:
			return Rejected{Failure: Forbidden{E: e}}
		case board.Invalid as e:
			return Rejected{Failure: Invalid{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: TrustUpdateReply{Value: v}}
	}
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { board.Api: scripted(g, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a direct Client and a CheckedClient over Call both
// answer each call as the provider Call is bound to does.
law ClientIsCall(r Request, g Given) {
	let want = OutcomeOf(r, g)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(g, sent)
	let outer = NewClient(inner)
	let got = with context { board.Api: outer } { Call(r) }
	let sentChecked = sync.NewRef[[]Request]([]Request{})
	let innerChecked = scripted(g, sentChecked)
	let checked = NewCheckedClient(func(q Request) Outcome fails rpc.Transport {
		with context { board.Api: innerChecked } { Call(q) }
	})
	let gotChecked = callChecked(checked, r) catch {
	case rpc.Transport:
		return false
	}
	got == want && sent.Get() == []Request{r} && gotChecked == want && sentChecked.Get() == []Request{r}
}
