import github.com/cevr/ergo/modules/board/board
import json
import maps
import option
import slices
import sql

func decodePayload(raw string) board.EventPayload fails board.StoreFailed {
	json.Decode(json.Codec[board.EventPayload]{MaxBytes: 0, MaxDepth: 0}, raw) catch {
	case _:
		return board.StoreFailed{Reason: "malformed event payload"}
	}
}

func decodeStrings(raw string) []string fails board.StoreFailed {
	json.Decode(json.Codec[[]string]{MaxBytes: 0, MaxDepth: 0}, raw) catch {
	case _:
		return board.StoreFailed{Reason: "malformed string list"}
	}
}

func decodePrincipal(raw string) board.Principal fails board.StoreFailed {
	json.Decode(json.Codec[board.Principal]{MaxBytes: 0, MaxDepth: 0}, raw) catch {
	case _:
		return board.StoreFailed{Reason: "malformed principal"}
	}
}

