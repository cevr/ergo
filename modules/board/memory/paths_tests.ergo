import explore
import github.com/cevr/ergo/modules/board/board
import strings
import sync
import testing

type bmCmd = bmPostAlpha{} | bmPostBeta{} | bmStaleCommit{} | bmDeleteFirst{}

type bmState {
	Ops []bmCmd,
}

type bmObs {
	Head       int,
	AlphaHits  int,
	BetaHits   int,
	ActiveMsg1 bool,
}

type bmReply =
	| bmCommitted{Head int}
	| bmStale{Expected int, Actual int}
	| bmRefused{Kind string}

type BoardMemOpenErr { Why string }

type BoardMemDriveErr { Why string }

func bmAdminCaller() board.Caller {
	board.Caller{
		Principal:       "google:admin",
		Profile:         "",
		Role:            board.Admin,
		Kind:            board.Person,
		Email:           "admin@example.com",
		Narrowed:        false,
		NarrowedCan:     Map[string, []board.Permission]{},
		NarrowedProfile: "",
		NarrowedBoards:  []string{},
	}
}

func bmAdminPrincipal() board.Principal {
	board.Principal{
		ID:     "google:admin",
		Kind:   board.Person,
		Handle: "admin",
		Email:  "admin@example.com",
		Name:   "Admin",
		Role:   board.Admin,
		State:  board.Active,
	}
}

func bmAlphaQuery() board.SearchQuery {
	board.SearchQuery{Board: board.DefaultBoard, Channel: "dev", Query: "alpha", Caller: bmAdminCaller(), Limit: 20}
}

func bmBetaQuery() board.SearchQuery {
	board.SearchQuery{Board: board.DefaultBoard, Channel: "dev", Query: "beta", Caller: bmAdminCaller(), Limit: 20}
}

func bmCmdToBoard(cmd bmCmd, step int) board.Command {
	match cmd {
	case bmPostAlpha:
		board.PostMessage{
			Caller:         bmAdminCaller(),
			Board:          board.DefaultBoard,
			Channel:        "dev",
			Text:           "alpha roadmap \(step) " + "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
			Labels:         Map[string, string]{},
			NoSync:         false,
			From:           "",
			IdempotencyKey: "",
		}
	case bmPostBeta:
		board.PostMessage{
			Caller:         bmAdminCaller(),
			Board:          board.DefaultBoard,
			Channel:        "dev",
			Text:           "beta release \(step)",
			Labels:         Map[string, string]{},
			NoSync:         false,
			From:           "",
			IdempotencyKey: "",
		}
	case bmStaleCommit:
		board.PostMessage{
			Caller:         bmAdminCaller(),
			Board:          board.DefaultBoard,
			Channel:        "dev",
			Text:           "stale attempt \(step)",
			Labels:         Map[string, string]{},
			NoSync:         false,
			From:           "",
			IdempotencyKey: "",
		}
	case bmDeleteFirst:
		board.DeleteMessage{
			Caller:     bmAdminCaller(),
			Board:      board.DefaultBoard,
			ID:         "msg_1",
			IfRevision: 0,
		}
	}
}

func bmCountSearch(st board.State, q board.SearchQuery) int {
	let gs = match st.Grants.Get(board.DefaultBoard) {
	case Some[[]board.Grant] as xs:
		xs.Value
	case None:
		[]board.Grant{}
	}
	let mut n = 0
	for _, m in st.Messages {
		if board.MatchesSearchQuery(gs, m, q) {
			n = n + 1
		}
	}
	n
}

func bmMsg1Active(st board.State) bool {
	match st.Messages.Get("msg_1") {
	case Some[board.Message] as m:
		!m.Value.Deleted
	case None:
		false
	}
}

func bmApplyModel(st board.State, head int, cmd bmCmd, step int) (board.State, int, bmReply) {
	let now = board.Timestamp(1000 + step*10)
	match cmd {
	case bmStaleCommit:
		(st, head, bmStale{Expected: head + 3, Actual: head})
	case bmPostAlpha, bmPostBeta, bmDeleteFirst:
		let evts = board.Decide(st, bmCmdToBoard(cmd, step), now) catch {
		case board.NotFound:
			return (st, head, bmRefused{Kind: "not_found"})
		case _:
			return (st, head, bmRefused{Kind: "refused"})
		}
		let mut nextSt = st
		let mut nextHead = head
		for e in evts {
			nextHead = nextHead + 1
			let stamped = board.Event{..e, Seq: nextHead, Board: board.DefaultBoard}
			nextSt = board.Apply(nextSt, stamped)
		}
		(nextSt, nextHead, bmCommitted{Head: nextHead})
	}
}

func bmFold(ops []bmCmd) (board.State, int) {
	let mut st = board.InitialState([]board.Principal{bmAdminPrincipal()}, 0)
	let mut head = 0
	for i, op in ops {
		let (ns, nh, _) = bmApplyModel(st, head, op, i+1)
		st = ns
		head = nh
	}
	(st, head)
}

func bmObsOf(st board.State, head int) bmObs {
	bmObs{
		Head:       head,
		AlphaHits:  bmCountSearch(st, bmAlphaQuery()),
		BetaHits:   bmCountSearch(st, bmBetaQuery()),
		ActiveMsg1: bmMsg1Active(st),
	}
}

func bmModel() explore.PathModel[bmState, bmCmd, bmObs, bmReply, Never] {
	explore.PathModel[bmState, bmCmd, bmObs, bmReply, Never]{
		Graph: explore.ConcreteGraph[bmState, bmCmd, explore.StepObs[bmObs, bmReply, Never]]{
			Starts:  []bmState{bmState{Ops: []bmCmd{}}},
			Signals: []bmCmd{bmPostAlpha, bmPostBeta, bmStaleCommit, bmDeleteFirst},
			Step:    func(s bmState, cmd bmCmd) explore.EdgeOutcome[bmState, explore.StepObs[bmObs, bmReply, Never]] {
				let (curSt, curHead) = bmFold(s.Ops)
				let step = len(s.Ops) + 1
				let (nextSt, nextHead, reply) = bmApplyModel(curSt, curHead, cmd, step)
				let nextOps = match reply {
				case bmCommitted:
					s.Ops.Append(cmd)
				case bmStale, bmRefused:
					s.Ops
				}
				let kind = match reply {
				case bmCommitted:
					explore.DisEmit
				case bmStale, bmRefused:
					explore.DisReject
				}
				explore.Continue[bmState, explore.StepObs[bmObs, bmReply, Never]]{
					Next: bmState{Ops: nextOps},
					Obs:  explore.StepObs[bmObs, bmReply, Never]{
						Kind:     kind,
						State:    Some[bmObs]{Value: bmObsOf(nextSt, nextHead)},
						Outputs:  []bmReply{reply},
						Error:    None,
						Terminal: false,
					},
				}
			},
		},
		InitialObs: func(s bmState) bmObs {
			let (st, head) = bmFold(s.Ops)
			bmObsOf(st, head)
		},
		ProjectionName: Some[string]{Value: "board-memory-store"},
	}
}

type bmSess {
	store  Store,
	step   sync.Ref[int],
	closes sync.Ref[int],
	closed sync.Ref[bool],
} implements explore.PathSession[bmCmd, explore.Observed[bmObs, bmReply, Never], BoardMemDriveErr]

func bmObserveLive(st Store) bmObs fails BoardMemDriveErr {
	let evts = ReadEvents(st, board.DefaultBoard, 0) catch {
	case board.StoreFailed as e:
		return BoardMemDriveErr{Why: e.Reason}
	}
	for i, e in evts {
		if e.Seq != i+1 {
			return BoardMemDriveErr{Why: "non-dense event sequence"}
		}
	}
	let snap = Snapshot(st) catch {
	case board.StoreFailed as e:
		return BoardMemDriveErr{Why: e.Reason}
	}
	let alpha = Search(st, bmAlphaQuery()) catch {
	case board.StoreFailed as e:
		return BoardMemDriveErr{Why: e.Reason}
	}
	for hit in alpha {
		if len(strings.Bytes(hit.Snippet)) != 120 {
			return BoardMemDriveErr{Why: "expected 120-byte truncated snippet"}
		}
	}
	if len(alpha) > 1 {
		let one = Search(st, board.SearchQuery{..bmAlphaQuery(), Limit: 1}) catch {
		case board.StoreFailed as e:
			return BoardMemDriveErr{Why: e.Reason}
		}
		if len(one) != 1 {
			return BoardMemDriveErr{Why: "search Limit=1 returned \(len(one)) hits"}
		}
	}
	let beta = Search(st, bmBetaQuery()) catch {
	case board.StoreFailed as e:
		return BoardMemDriveErr{Why: e.Reason}
	}
	let liveMsg1 = match snap.Messages.Get("msg_1") {
	case Some[board.Message] as m:
		!m.Value.Deleted
	case None:
		false
	}
	bmObs{
		Head:       len(evts),
		AlphaHits:  len(alpha),
		BetaHits:   len(beta),
		ActiveMsg1: liveMsg1,
	}
}

func Read(s bmSess) explore.Observed[bmObs, bmReply, Never] fails BoardMemDriveErr {
	explore.InitialRead[bmObs]{State: try bmObserveLive(s.store)}
}

func Apply(s bmSess, cmd bmCmd) explore.Observed[bmObs, bmReply, Never] fails BoardMemDriveErr {
	let n = s.step.Get() + 1
	s.step.Set(n)
	let now = board.Timestamp(1000 + n*10)
	match cmd {
	case bmStaleCommit:
		let evts = ReadEvents(s.store, board.DefaultBoard, 0) catch {
		case board.StoreFailed as e:
			return BoardMemDriveErr{Why: e.Reason}
		}
		let head = len(evts)
		let snap = Snapshot(s.store) catch {
		case board.StoreFailed as e:
			return BoardMemDriveErr{Why: e.Reason}
		}
		let planned = board.Decide(snap, bmCmdToBoard(cmd, n), now) catch {
		case _:
			return BoardMemDriveErr{Why: "decide for stale commit failed"}
		}
		let mut reply bmReply = bmRefused{Kind: "unexpected"}
		let mut sawStale = false
		let _ = Commit(s.store, board.DefaultBoard, head+3, planned) catch {
		case board.StalePosition as sp:
			reply = bmStale{Expected: sp.Expected, Actual: sp.Actual}
			sawStale = true
			0
		case board.StoreFailed as e:
			return BoardMemDriveErr{Why: e.Reason}
		}
		if !sawStale {
			return BoardMemDriveErr{Why: "stale commit unexpectedly succeeded"}
		}
		let obs = try bmObserveLive(s.store)
		explore.StepResult[bmObs, bmReply, Never]{Step: explore.StepObs[bmObs, bmReply, Never]{
			Kind:     explore.DisReject,
			State:    Some[bmObs]{Value: obs},
			Outputs:  []bmReply{reply},
			Error:    None,
			Terminal: false,
		}}
	case bmPostAlpha, bmPostBeta, bmDeleteFirst:
		let snap = Snapshot(s.store) catch {
		case board.StoreFailed as e:
			return BoardMemDriveErr{Why: e.Reason}
		}
		let curEvts = ReadEvents(s.store, board.DefaultBoard, 0) catch {
		case board.StoreFailed as e:
			return BoardMemDriveErr{Why: e.Reason}
		}
		let decided = board.Decide(snap, bmCmdToBoard(cmd, n), now) catch {
		case board.NotFound:
			let obs = try bmObserveLive(s.store)
			return explore.StepResult[bmObs, bmReply, Never]{Step: explore.StepObs[bmObs, bmReply, Never]{
				Kind:     explore.DisReject,
				State:    Some[bmObs]{Value: obs},
				Outputs:  []bmReply{bmRefused{Kind: "not_found"}},
				Error:    None,
				Terminal: false,
			}}
		case _:
			let obs = try bmObserveLive(s.store)
			return explore.StepResult[bmObs, bmReply, Never]{Step: explore.StepObs[bmObs, bmReply, Never]{
				Kind:     explore.DisReject,
				State:    Some[bmObs]{Value: obs},
				Outputs:  []bmReply{bmRefused{Kind: "refused"}},
				Error:    None,
				Terminal: false,
			}}
		}
		let newHead = Commit(s.store, board.DefaultBoard, len(curEvts), decided) catch {
		case board.StalePosition as sp:
			return BoardMemDriveErr{Why: "unexpected stale: \(sp.Expected) vs \(sp.Actual)"}
		case board.StoreFailed as e:
			return BoardMemDriveErr{Why: e.Reason}
		}
		let obs = try bmObserveLive(s.store)
		explore.StepResult[bmObs, bmReply, Never]{Step: explore.StepObs[bmObs, bmReply, Never]{
			Kind:     explore.DisEmit,
			State:    Some[bmObs]{Value: obs},
			Outputs:  []bmReply{bmCommitted{Head: newHead}},
			Error:    None,
			Terminal: false,
		}}
	}
}

func Close(s bmSess) {
	if s.closed.Get() {
		return
	}
	s.closed.Set(true)
	s.closes.Set(s.closes.Get() + 1)
}

// BoardMemoryPaths is the model-based path-testing contract for memory.Store.
type BoardMemoryPaths {
	Open(start bmState) explore.PathSession[bmCmd, explore.Observed[bmObs, bmReply, Never], BoardMemDriveErr] fails BoardMemOpenErr,
	Counts() (int, int),

	// PathsAgree checks every bounded board memory store path up to depth 3
	// against the pure board fold, verifying dense cursors, search index
	// consistency, typed stale-position rejections, and full session cleanup.
	law PathsAgree() {
		let res = explore.CheckPathsWithSink(
			bmModel(),
			explore.ToDepth{Depth: 3},
			explore.PathBounds{
				MaxStates: 256,
				MaxEdges:  1024,
				MaxPaths:  256,
				MaxSteps:  1024,
				MaxWork:   65536,
				MaxBytes:  262144,
			},
			func(start bmState) explore.PathSession[bmCmd, explore.Observed[bmObs, bmReply, Never], BoardMemDriveErr] fails BoardMemOpenErr {
				try Open(start)
			},
			testing.ActiveEvidenceSink(),
		)
		let (opened, closed) = Counts()
		assert opened > 0 && opened == closed
		assert res.Counts.Opened == res.Counts.Planned
		assert res.Counts.InitialReads == res.Counts.Opened
		assert res.Counts.CheckedSteps == res.PlanStats.Steps
		match res.Verdict {
		case explore.CampaignPassed:
			true
		case explore.CampaignRefuted, explore.CampaignIncomplete:
			false
		}
	},
}

type bmPathProvider {
	opens  sync.Ref[int],
	closes sync.Ref[int],
} implements BoardMemoryPaths

func makeBoardMemPathProvider() bmPathProvider {
	bmPathProvider{opens: sync.NewRef(0), closes: sync.NewRef(0)}
}

func Open(p bmPathProvider, _ bmState) explore.PathSession[bmCmd, explore.Observed[bmObs, bmReply, Never], BoardMemDriveErr] fails BoardMemOpenErr {
	p.opens.Set(p.opens.Get() + 1)
	bmSess{
		store:  NewStore(),
		step:   sync.NewRef(0),
		closes: p.closes,
		closed: sync.NewRef(false),
	}
}

func Counts(p bmPathProvider) (int, int) {
	(p.opens.Get(), p.closes.Get())
}

let onBoardMemoryPaths = context { BoardMemoryPaths: makeBoardMemPathProvider() }
