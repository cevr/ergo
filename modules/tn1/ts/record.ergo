// FromSource: the feature record of a TypeScript file, by the record's
// rules (modules/tn1/record.ergo) stated over tokens:
//
//   - A line's kind: Code when it holds a byte outside comments that is
//     not a space; else Blank with no comment byte; else DocComment when a
//     /** comment on it is followed by a token that is not ), ] or }
//     (TypeScript attaches it to what follows); else Directive when a
//     comment on it is a tool's (directives); else CommentOnly.
//   - Depth: the braces open at the line's first byte (a template's ${
//     counts), as the brace before it is closed.
//   - Starts: function (function, =>), type (class, interface, enum, and
//     type before a name), branch (if, switch), loop (for, while, do),
//     handler (catch, or a call of a name catchX), return, call (a name
//     before "(" that is not a control word, nor a declared name: one
//     after function, or one whose list a { or a : follows), assignment (const, let,
//     var, an assignment operator), test (a call of test, it or describe).
//   - Code words: the words of the bytes outside comments and literals,
//     with every name an import binds blanked (Effect, Layer and Schema
//     would fill the sketch on most lines), and each start's neutral word.
//   - Nodes: the module; each top-level statement (Statements) as a
//     function, a type, a test or the module's own; each catch block.

import ergo.dev/tn1
import option
import slices
import strings

// directives are the openings of a tool's directive comment, read after
// its // or /* and any JSDoc gutter: effect-oxlint's list
// (src/rules/_comment-directives.ts: suppressions, type-check and Effect
// switches, references, bundler annotations, pragmas, formatter and
// coverage ignores, a licence, nosemgrep, a source map URL; LANDMINES
// 4.4), and the openings only TN1 reads (an eslint configuration
// comment, biome-ignore, ergo-lint-, traits-ignore). The vector
// src/directives.ts.txt holds them. A comment that only names one later
// in its prose is prose.
let directives = []string{
	"oxlint-disable", "oxlint-enable", "eslint-disable", "eslint-enable", "eslint ",
	"@effect-diagnostics", "@ts-expect-error", "@ts-ignore", "@ts-nocheck", "@ts-check",
	"/ <reference", "/<reference", "/ <amd-module", "/ <amd-dependency",
	"#__PURE__", "@__PURE__", "#__NO_SIDE_EFFECTS__", "@__NO_SIDE_EFFECTS__", "#__KEY__", "@__KEY__",
	"#__INLINE__", "@__INLINE__", "#__NOINLINE__", "@__NOINLINE__", "@vite-ignore", "@jsx",
	"prettier-ignore", "oxfmt-ignore", "c8 ignore", "v8 ignore", "istanbul ignore",
	"!", "@license", "SPDX-License-Identifier:", "nosemgrep", "# sourceMappingURL=", "@ sourceMappingURL=", "#sourceMappingURL=", "@sourceMappingURL=",
	"# sourceURL=", "@ sourceURL=", "#sourceURL=", "@sourceURL=", "webpack", "turbopackIgnore",
	"biome-ignore", "ergo-lint-", "traits-ignore",
}

// control reports a word before "(" that is not a call.
func control(s string) bool {
	match s {
	case "if", "for", "while", "switch", "catch", "function", "return", "typeof", "void", "delete", "await", "yield", "in", "of", "instanceof", "as", "satisfies", "keyof":
		true
	case _:
		false
	}
}

// assign reports an assignment operator.
func assign(s string) bool {
	match s {
	case "=", "+=", "-=", "*=", "/=", "%=", "**=", "<<=", ">>=", ">>>=", "&=", "|=", "^=", "&&=", "||=", "??=":
		true
	case _:
		false
	}
}

// neutral are the start bits' words, in StartNames' order; "" for a
// start with no word.
let neutral = []string{"function", "type", "branch", "loop", "handler", "return", "", "", "test"}

// directive reports whether a comment token's text is a tool's: a
// shebang, or a comment whose body opens with one of directives.
func directive(text string) bool {
	if strings.HasPrefix(text, "#!") {
		return true
	}
	let body = strings.TrimLeft(strings.Slice(text, lo(2, text.Len()), text.Len()), "*\n\r\t ")
	for d in directives {
		if strings.HasPrefix(body, d) {
			return true
		}
	}
	false
}

// lineStarts is the offset of each line's first byte.
func lineStarts(src string) []int {
	let mut out = []int{0}
	for i in 0..src.Len() {
		if src[i] == '\n' && i+1 < src.Len() {
			out = out.Append(i + 1)
		}
	}
	if src.Len() == 0 {
		return []int{}
	}
	out
}

// lineFrom is lineOf(starts, p) for a p on line l or after it: a walk
// forward from l, which costs the lines passed, so a pass over tokens in
// order costs the file's lines once.
func lineFrom(starts []int, l int, p int) int {
	let mut k = l
	for k+1 < starts.Len() && starts[k+1] <= p {
		k += 1
	}
	k
}

// lineOf is the 0-based line of offset p.
func lineOf(starts []int, p int) int {
	let mut lo = 0
	let mut hi = starts.Len() - 1
	for lo < hi {
		let mid = (lo + hi + 1) / 2
		if starts[mid] <= p {
			lo = mid
		} else {
			hi = mid - 1
		}
	}
	lo
}

// imported is the names the file's import statements bind, and the
// tokens that are in an import clause.
type Imports { Names Map[string, bool], Clause []bool }

// binds reports whether an import binds name.
func binds(imp Imports, name string) bool {
	match imp.Names.Get(name) {
	case option.Some:
		true
	case option.None:
		false
	}
}

func imports(code []Token) Imports {
	let mut names = Map[string, bool]{}
	let mut clause = []bool{}
	for _ in code {
		clause = clause.Append(false)
	}
	let mut i = 0
	for i < code.Len() {
		if code[i].Text == "import" && code[i].Depth == 0 && isIdent(code[i]) && (i == 0 || code[i-1].Text != ".") {
			let mut j = i + 1
			for j < code.Len() && code[j].Text != "from" && code[j].Text != ";" && code[j].Text != "=" && !(j > i+1 && code[j].NewLine && !isPunctOrWord(code[j-1])) {
				if isIdent(code[j]) {
					clause[j] = true
					let after = if j+1 < code.Len() { code[j+1].Text } else { "" }
					if code[j].Text != "type" && code[j].Text != "as" && after != "as" {
						names[code[j].Text] = true
					}
				}
				j += 1
			}
			if j < code.Len() && code[j].Text == "=" && j > i+1 {
				names[code[j-1].Text] = true
			}
			i = j
		}
		i += 1
	}
	Imports{Names: names, Clause: clause}
}

// Scanned is what the record's lines and nodes read of a source: its
// line starts, its tokens, its code tokens and its imports. It is made
// once per file.
type Scanned { Starts []int, Toks []Token, Code []Token, Imp Imports }

func scanOf(src string) Scanned {
	let toks = Scan(src)
	let code = Code(src, toks)
	Scanned{Starts: lineStarts(src), Toks: toks, Code: code, Imp: imports(code)}
}

// FromSource is the record of TypeScript source src.
func FromSource(src string) tn1.Features {
	let s = scanOf(src)
	tn1.Features{Version: 2, Language: "ts", Lines: linesOf(src, s), Nodes: nodes(src, s.Starts, s.Code, s.Imp), Packages: []tn1.PackageItem{}, Files: []tn1.FileItem{}}
}

// Linted is what a lint run reads of a source: the record's lines (the
// network reads no node) and each line's comment span, from one scan.
type Linted { Lines []tn1.Line, Spans []Span }

// ForLint is the lines and comment spans of TypeScript source src: the
// lines FromSource has, without its nodes, and CommentSpans, without a
// second scan.
func ForLint(src string) Linted {
	let s = scanOf(src)
	Linted{Lines: linesOf(src, s), Spans: spansOf(src, s.Starts, s.Toks)}
}

// linesOf is the record's lines of src.
func linesOf(src string, s Scanned) []tn1.Line {
	let starts = s.Starts
	let n = starts.Len()
	let toks = s.Toks
	let code = s.Code
	let imp = s.Imp

	// Per byte: in a comment, in a literal, blanked as an imported name.
	let mut kind = strings.Bytes(strings.Repeat("c", src.Len()))
	for t in toks {
		let mut mark = byte('c')
		match t.Kind {
		case LineComment, BlockComment:
			mark = '/'
		case Literal:
			mark = '"'
		case Ident, Punct:
		}
		if mark != 'c' {
			for p in t.From..t.To {
				kind[p] = mark
			}
		}
	}
	for j in 0..code.Len() {
		let t = code[j]
		if isIdent(t) && (imp.Clause[j] || binds(imp, t.Text)) {
			for p in t.From..t.To {
				kind[p] = '"'
			}
		}
	}

	// Doc and directive comments, by line; depth at each line's first
	// token.
	let mut doc = []bool{}
	let mut dir = []bool{}
	let mut depth = []int{}
	let mut deep = []bool{}
	let mut startBits = []int{}
	for _ in 0..n {
		doc = doc.Append(false)
		dir = dir.Append(false)
		depth = depth.Append(0)
		deep = deep.Append(false)
		startBits = startBits.Append(0)
	}
	// Tokens come in order, so their lines are found by walking forward.
	let mut at = 0
	for ti in 0..toks.Len() {
		let t = toks[ti]
		let first = lineFrom(starts, at, t.From)
		at = first
		let last = lineFrom(starts, first, lo(t.To, src.Len())-if t.To > t.From { 1 } else { 0 })
		for l in first..last+1 {
			if !deep[l] {
				deep[l] = true
				depth[l] = t.Depth
			}
		}
		if IsComment(t) {
			let text = strings.Slice(src, t.From, t.To)
			let isDoc = strings.HasPrefix(text, "/**") && text != "/**/" && attached(toks, ti)
			let isDir = directive(text)
			for l in first..last+1 {
				doc[l] = doc[l] || isDoc
				dir[l] = dir[l] || isDir
			}
		}
	}

	// Starts.
	at = 0
	for j in 0..code.Len() {
		let t = code[j]
		let next = if j+1 < code.Len() { code[j+1].Text } else { "" }
		let prev = if j > 0 { code[j-1].Text } else { "" }
		let w = t.Text
		let mut bits = 0
		if isIdent(t) {
			if w == "function" {
				bits = 1
			} else if w == "class" || w == "interface" || w == "enum" || w == "type" && j+1 < code.Len() && isIdent(code[j+1]) && prev != "." {
				bits = 2
			} else if w == "if" || w == "switch" {
				bits = 4
			} else if w == "for" || w == "while" || w == "do" {
				bits = 8
			} else if w == "return" {
				bits = 32
			} else if w == "const" || w == "let" || w == "var" {
				bits = 128
			}
			if w == "catch" || strings.HasPrefix(w, "catch") && w.Len() > 5 && w[5] >= 'A' && w[5] <= 'Z' && next == "(" {
				bits = bits | 16
			}
			if next == "(" && !control(w) && prev != "function" && !signature(code, j+1) {
				bits = bits | 64
				if (w == "test" || w == "it" || w == "describe") && prev != "." {
					bits = bits | 256
				}
			}
		} else if w == "=>" {
			bits = 1
		} else if assign(w) {
			bits = 128
		}
		if bits != 0 {
			at = lineFrom(starts, at, t.From)
			startBits[at] = startBits[at] | bits
		}
	}

	let mut lines = slices.WithCapacity[tn1.Line](n)
	for l in 0..n {
		let from = starts[l]
		// A line ends before its newline, the file's last line too: its
		// newline is no code byte (a file's closing comment, such as a
		// source map URL, was Code).
		let to = if l+1 < n { starts[l+1] - 1 } else if strings.HasSuffix(src, "\n") { src.Len() - 1 } else { src.Len() }
		let mut comment = strings.NewBuilder()
		let mut hasCode = false
		for p in from..to {
			let c = src[p]
			if kind[p] == '/' {
				if c != '\r' {
					comment.WriteByte(c)
				}
			} else if c != ' ' && c != '\t' && c != '\r' {
				hasCode = true
			}
		}
		let text = trimBlank(comment.String())
		let mut k tn1.LineKind = tn1.CommentOnly
		if hasCode {
			k = tn1.Code
		} else if comment.Len() == 0 {
			k = tn1.Blank
		} else if doc[l] {
			k = tn1.DocComment
		} else if dir[l] {
			k = tn1.Directive
		}
		let mut codeWords = codeSketch(src, kind, from, to)
		for b in 0..9 {
			if (startBits[l]>>b)&1 == 1 && neutral[b] != "" {
				codeWords = codeWords | tn1.WordBit(neutral[b])
			}
		}
		lines = lines.Append(tn1.Line{
			Kind:         k,
			Depth:        depth[l],
			Starts:       startBits[l],
			CommentWords: tn1.SketchOf(text),
			CodeWords:    codeWords,
			CommentText:  text,
		})
	}
	lines
}

// CommentSpans is, for each line of src, the bytes of the comments on
// it, from the first comment byte on the line to the last; From == To at
// the line's start when it has none. A finding of a local network points
// at its line's span.
func CommentSpans(src string) []Span { spansOf(src, lineStarts(src), Scan(src)) }

func spansOf(src string, starts []int, toks []Token) []Span {
	let mut out = []Span{}
	let mut seen = []bool{}
	for s in starts {
		out = out.Append(Span{From: s, To: s})
		seen = seen.Append(false)
	}
	let mut at = 0
	for t in toks {
		if !IsComment(t) {
			continue
		}
		let first = lineFrom(starts, at, t.From)
		at = first
		let last = lineFrom(starts, first, lo(t.To, src.Len())-if t.To > t.From { 1 } else { 0 })
		for l in first..last+1 {
			let from = starts[l]
			let to = if l+1 < starts.Len() { starts[l+1] - 1 } else { src.Len() }
			if !seen[l] {
				seen[l] = true
				out[l].From = if t.From > from { t.From } else { from }
			}
			let mut b = if t.To < to { t.To } else { to }
			if b > out[l].From && src[b-1] == '\r' {
				b -= 1
			}
			out[l].To = b
		}
	}
	out
}

// codeSketch is tn1.SketchOf of src[from:to] with every byte outside
// code (kind not c: a comment, a literal, an imported name) read as a
// space, without making that text.
func codeSketch(src string, kind []byte, from int, to int) uint64 {
	let mut sk = uint64(0)
	let mut start = -1
	let mut prev = byte(' ')
	for p in from..to+1 {
		let c = if p < to && kind[p] == 'c' { src[p] } else { byte(' ') }
		let isLetter = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
		let end = !isLetter || start >= 0 && c <= 'Z' && prev >= 'a'
		if end && start >= 0 {
			if p-start >= 3 {
				let mut h = uint32(2166136261)
				for k in start..p {
					let b = src[k]
					let low = if b >= 'A' && b <= 'Z' { b + 32 } else { b }
					h = (h ^ uint32(low)) * 16777619
				}
				sk = sk | uint64(1)<<uint64(h%64)
			}
			start = -1
		}
		if isLetter && start < 0 {
			start = p
		}
		prev = c
	}
	sk
}

// trimBlank is s without the spaces and tabs at either end.
func trimBlank(s string) string {
	let mut a = 0
	let mut b = s.Len()
	for a < b && (s[a] == ' ' || s[a] == '\t') {
		a += 1
	}
	for b > a && (s[b-1] == ' ' || s[b-1] == '\t') {
		b -= 1
	}
	strings.Slice(s, a, b)
}

// signature reports whether the parenthesised list at code[open] is a
// declaration's (a function's or a method's), not a call's: a { or a :
// follows it.
func signature(code []Token, open int) bool {
	let close = closing(code, open, code.Len())
	close+1 < code.Len() && (code[close+1].Text == "{" || code[close+1].Text == ":") && isPunctOrWord(code[close+1])
}

// attached reports whether the token after the comment toks[i] (comments
// skipped) exists and is not ), ] or }.
func attached(toks []Token, i int) bool {
	for j in i+1..toks.Len() {
		if !IsComment(toks[j]) {
			let x = toks[j].Text
			return !(isPunctOrWord(toks[j]) && (x == ")" || x == "]" || x == "}"))
		}
	}
	false
}
