// TN1, version 2: a small ternary network over the feature record. Every
// value is an integer, so a result has the same bits on every host and in
// every engine.
//
// The weights file (text, so a diff of it reads; # starts a comment line,
// empty lines are skipped):
//
//	tn1 2 D F K H
//	words stop              optional: the comment's word planes leave out
//	                        StopWords (words.ergo), read from CommentText
//	embed
//	<256 rows of D trits, one per byte value>
//	conv BIAS               F times, each followed by
//	<K rows of D trits>
//	hidden BIAS             H times, each followed by
//	<4 rows of N trits: the lines i-1, i, i+1, i+2>
//	out SCALE BIAS
//	<1 row of H trits>
//	skip SCALE
//	<1 row of N trits>
//
// A trit is -, 0 or +. Sizes: 1 <= D <= 16, 0 <= F <= 48, 1 <= K <= 12,
// 1 <= H <= 96; an integer is 16-bit. N = F + Planes is the width of a
// line's features (Features in run.ergo).

import hex
import sha256
import strconv
import strings

// Version is the input version these weights read: the feature record.
let Version = 2

// Planes is the number of a line's features that do not come from the
// conv filters: 5 kinds, 4 depth steps, 9 starts, two 64-bit sketches.
let Planes = 146

// Budget is the most packed bytes a network may have.
let Budget = 16384

// Net is a network as its weights file states it. The conv filters are
// kept folded with the embedding: table[(f*K + k)*256 + b] is filter f's
// sum at tap k over byte b.
type Net {
	D          int,
	F          int,
	K          int,
	H          int,
	table      []int,
	convBias   []int,
	hidden     []int,
	hiddenBias []int,
	out        []int,
	outScale   int,
	outBias    int,
	skip       []int,
	skipScale  int,
	stop       bool,
	packed     string,
}

// Inputs is N, the width of a line's features.
func Inputs(n Net) int { n.F + Planes }

// Packed is the canonical bytes of the weights: every trit in file order,
// five to a byte (base 3, the first trit the lowest digit, -1 written as
// 2), then the integers (the version, D, F, K, H, the conv biases, the
// hidden biases, the out scale and bias, the skip scale, and 1 when the
// file reads `words stop`) as two bytes each, little-endian. Its length is
// what Budget counts; a file without `words stop` packs as before it.
func Packed(n Net) string { n.packed }

// ID is the hexadecimal SHA-256 of the packed bytes: the model's name in
// a finding and in a vector.
func ID(n Net) string { hex.Encode(sha256.Sum(n.packed)) }

// cursor walks the weights file's lines that are not comments.
type cursor { rows []string, lines []int, at int }

func next(c mut cursor) string fails Malformed {
	if c.at >= len(c.rows) {
		return Malformed{Line: 0, Reason: "the weights file ends early"}
	}
	c.at += 1
	c.rows[c.at-1]
}

func here(c cursor) int {
	if c.at == 0 {
		return 1
	}
	c.lines[c.at-1]
}

// head reads a line of word and ints integers.
func head(c mut cursor, word string, ints int) []int fails Malformed {
	let row = try next(c)
	let fs = strings.Fields(row)
	if len(fs) != ints+1 || fs[0] != word {
		return Malformed{Line: here(*c), Reason: "want \(strconv.Quote(word)) and \(ints) integers"}
	}
	let mut out = []int{}
	for i in 1..len(fs) {
		let v = strconv.Atoi(fs[i]) catch {
		case strconv.Malformed, strconv.OutOfRange:
			return Malformed{Line: here(*c), Reason: "\(strconv.Quote(fs[i])) is not an integer"}
		}
		if v < -32768 || v > 32767 {
			return Malformed{Line: here(*c), Reason: "\(v) is not a 16-bit integer"}
		}
		out = out.Append(v)
	}
	out
}

// row appends a row of want trits to into.
func row(c mut cursor, want int, into []int) []int fails Malformed {
	let text = try next(c)
	if len(text) != want {
		return Malformed{Line: here(*c), Reason: "a row of \(len(text)) trits, want \(want)"}
	}
	let mut out = into
	for i in 0..len(text) {
		match text[i] {
		case '-':
			out = out.Append(-1)
		case '0':
			out = out.Append(0)
		case '+':
			out = out.Append(1)
		case _:
			return Malformed{Line: here(*c), Reason: "trit \(strconv.Quote(strings.Slice(text, i, i+1))), want -, 0 or +"}
		}
	}
	out
}

// ParseNet reads a weights file.
func ParseNet(text string) Net fails Malformed {
	let mut c = cursor{rows: []string{}, lines: []int{}, at: 0}
	let all = strings.Split(text, "\n")
	for i in 0..len(all) {
		let t = strings.TrimSpace(all[i])
		if t != "" && !strings.HasPrefix(t, "#") {
			c.rows = c.rows.Append(t)
			c.lines = c.lines.Append(i + 1)
		}
	}
	let dims = try head(&c, "tn1", 5)
	if dims[0] != Version {
		return Malformed{Line: here(c), Reason: "input version \(dims[0]), want \(Version)"}
	}
	let d = dims[1]
	let f = dims[2]
	let k = dims[3]
	let h = dims[4]
	if d < 1 || d > 16 || f < 0 || f > 48 || k < 1 || k > 12 || h < 1 || h > 96 {
		return Malformed{Line: here(c), Reason: "shape D=\(d) F=\(f) K=\(k) H=\(h) is outside D<=16 F<=48 K<=12 H<=96"}
	}
	let n = f + Planes
	let mut ints = []int{Version, d, f, k, h}
	let stop = c.at < len(c.rows) && c.rows[c.at] == "words stop"
	if stop {
		let _ = try next(&c)
	}
	let _ = try head(&c, "embed", 0)
	let mut trits = []int{}
	for _ in 0..256 {
		trits = try row(&c, d, trits)
	}
	let mut convBias = []int{}
	for _ in 0..f {
		convBias = convBias.Append((try head(&c, "conv", 1))[0])
		for _ in 0..k {
			trits = try row(&c, d, trits)
		}
	}
	let mut hiddenBias = []int{}
	for _ in 0..h {
		hiddenBias = hiddenBias.Append((try head(&c, "hidden", 1))[0])
		for _ in 0..4 {
			trits = try row(&c, n, trits)
		}
	}
	let o = try head(&c, "out", 2)
	trits = try row(&c, h, trits)
	let s = try head(&c, "skip", 1)
	trits = try row(&c, n, trits)
	if c.at != len(c.rows) {
		return Malformed{Line: c.lines[c.at], Reason: "\(len(c.rows) - c.at) lines after the last row"}
	}
	for b in convBias {
		ints = ints.Append(b)
	}
	for b in hiddenBias {
		ints = ints.Append(b)
	}
	ints = ints.Append(o[0])
	ints = ints.Append(o[1])
	ints = ints.Append(s[0])
	if stop {
		ints = ints.Append(1)
	}
	let packed = pack(trits, ints)
	if len(packed) > Budget {
		return Malformed{Line: 0, Reason: "\(len(packed)) packed bytes, over the budget of \(Budget)"}
	}
	let convAt = 256 * d
	let hiddenAt = convAt + f*k*d
	let outAt = hiddenAt + h*4*n
	let skipAt = outAt + h
	let mut table = []int{}
	for fi in 0..f {
		for ki in 0..k {
			for b in 0..256 {
				let mut sum = 0
				for di in 0..d {
					sum += trits[convAt+(fi*k+ki)*d+di] * trits[b*d+di]
				}
				table = table.Append(sum)
			}
		}
	}
	Net{
		D:          d,
		F:          f,
		K:          k,
		H:          h,
		table:      table,
		convBias:   convBias,
		hidden:     trits[hiddenAt:outAt],
		hiddenBias: hiddenBias,
		out:        trits[outAt:skipAt],
		outScale:   o[0],
		outBias:    o[1],
		skip:       trits[skipAt : skipAt+n],
		skipScale:  s[0],
		stop:       stop,
		packed:     packed,
	}
}

// pack is the trits five to a byte, then each integer as two bytes.
func pack(trits []int, ints []int) string {
	let mut b = strings.NewBuilder()
	let mut i = 0
	for i < len(trits) {
		let mut v = 0
		let mut m = 1
		let mut j = i
		for j < i+5 && j < len(trits) {
			let mut t = trits[j]
			if t < 0 {
				t = 2
			}
			v += t * m
			m *= 3
			j += 1
		}
		b.WriteByte(byte(v))
		i += 5
	}
	for v in ints {
		b.WriteByte(byte(v & 255))
		b.WriteByte(byte((v >> 8) & 255))
	}
	b.String()
}
