// The table form's laws (ROUTE-QUERY): a site of three routes, the front
// page, a post by its slug, and a search whose state is its query (the
// text, an optional limit, an order), given as a route table.

import html
import http
import json
import strconv
import ui

type lawFront {}
type lawPost { Slug string }
type lawSearch { Q string, Limit json.Optional[int], Desc bool }
type lawPlace = lawFront | lawPost | lawSearch

// lawTable is the laws' route table.
let lawTable = []Row{
	Row{Variant: "lawFront", Pattern: "/"},
	Row{Variant: "lawPost", Pattern: "/posts/:slug"},
	Row{Variant: "lawSearch", Pattern: "/search?q&limit&desc"},
}

// lawTableMap is the route map of lawTable.
type lawTableMap {} implements Routes[lawPlace]

func Href(_ lawTableMap, r lawPlace) ui.URL { HrefOf(lawTable, r) }

func Parse(_ lawTableMap, u ui.URL) Option[lawPlace] { ParseOf[lawPlace](lawTable, u) }

// lawPlaceText is what the laws' loader loads: the route, spelled out.
func lawPlaceText(r lawPlace) string fails lawGone {
	match r {
	case lawFront:
		"front"
	case lawPost as p:
		"post " + p.Slug
	case lawSearch as s:
		let limit = match s.Limit {
		case json.Present[int] as n:
			strconv.Itoa(n.Value)
		case json.Absent:
			"none"
		}
		"search " + s.Q + " limit " + limit + " desc " + strconv.FormatBool(s.Desc)
	}
}

func lawTableSite() Site[lawPlace, string, lawGone] {
	Site[lawPlace, string, lawGone]{
		Routes: lawTableMap,
		Load:   lawPlaceText,
		View:   func(p string) html.Node { html.P([]html.Child{html.Text(p)}) },
		Status: func(f) Reply {
			match f {
			case lawGone as g:
				Reply{Status: 410, Page: html.P([]html.Child{html.Text("gone " + strconv.Itoa(g.N))})}
			}
		},
		NotFound: func(path string) html.Node { html.P([]html.Child{html.Text("no page at " + path)}) },
		Assets:   []Asset{},
	}
}

// lawServed is whether GET of the link r prints, its path and its query
// as a browser sends them, is r's page with status 200.
func lawServed(r lawPlace) bool {
	let u = ui.ParseURL(ui.Href(HrefOf(lawTable, r)))
	let req = http.Request{..Request("GET", u.Path), Query: http.ParseQuery(u.Query)}
	let res = Fetch(lawTableSite(), req)
	let want = lawPlaceText(r) catch {
	case _:
		return false
	}
	res.Status == 200 && res.Body == html.Render(html.P([]html.Child{html.Text(want)}))
}

// TableRouteIsServed: GET of the link a table route prints is that
// route's page, so a route's query state reaches its loader, and a slug
// that holds a '/', a '?', a '#' or an escape stays one segment.
law TableRouteIsServed(r lawPlace, slug string) {
	lawServed(r) && lawServed(lawPost{Slug: slug + "/?#%41"})
}

// QueryIsTyped: a query value is read as its field's type, so a limit
// that is not an integer is no place of the search, nor is a limit given
// twice (no first or last wins); an absent limit is json.Absent, and a
// key the pattern does not list is not read.
law QueryIsTyped(q string, n int, junk string) {
	let base = "/search?q=" + ui.Escape(q)
	let wrong = ParseOf[lawPlace](lawTable, ui.ParseURL(base+"&desc=true&limit=x"+ui.Escape(junk)))
	let absent = ParseOf[lawPlace](lawTable, ui.ParseURL(base+"&desc=true&page="+strconv.Itoa(n)))
	let given = ParseOf[lawPlace](lawTable, ui.ParseURL(base+"&desc=false&limit="+strconv.Itoa(n)))
	let twice = ParseOf[lawPlace](lawTable, ui.ParseURL(base+"&desc=true&limit="+strconv.Itoa(n)+"&limit="+strconv.Itoa(n)))
	wrong == None && twice == None && absent == Some[lawPlace]{Value: lawSearch{Q: q, Limit: json.Absent, Desc: true}} && given == Some[lawPlace]{Value: lawSearch{Q: q, Limit: json.Present[int]{Value: n}, Desc: false}}
}
