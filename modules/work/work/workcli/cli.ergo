		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.SyncRequest as x:
		let mut out = []string{"sync"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.EnvRequest as x:
		let mut out = []string{"env"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.MergeFileRequest as x:
		let mut out = []string{"merge-file"}
		match x.O.Path {
		case Some[string] as s:
			out = out.Append("-path=\(s.Value)")
		case None:
		}
		out = out.Append("--")
		out = out.Append("\(x.Class)")
		out = out.Append("\(x.Base)")
		out = out.Append("\(x.Ours)")
		out = out.Append("\(x.Theirs)")
		out
	case workapi.MergeFoldersRequest as x:
		let mut out = []string{"merge-folders"}
		out = out.Append("--")
		out = out.Append("\(x.Base)")
		out = out.Append("\(x.Ours)")
		out = out.Append("\(x.Theirs)")
		out = out.Append("\(x.Out)")
		out
	case workapi.DeriveRequest as x:
		let mut out = []string{"derive"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.DepsRequest as x:
		let mut out = []string{"deps"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.TrustRequest:
		[]string{"trust"}
	case workapi.DoctorRequest as x:
		let mut out = []string{"doctor"}
		out = out.Append("-rift=\(x.O.Rift)")
		match x.O.Registry {
		case Some[string] as s:
			out = out.Append("-registry=\(s.Value)")
		case None:
		}
		out
	case workapi.PluginTestRequest as x:
		let mut out = []string{"plugin-test"}
		match x.O.Files {
		case Some[string] as s:
			out = out.Append("-files=\(s.Value)")
		case None:
		}
		match x.O.Max {
		case Some[int] as s:
			out = out.Append("-max=\(s.Value)")
		case None:
		}
		match x.O.Seed {
		case Some[int] as s:
			out = out.Append("-seed=\(s.Value)")
		case None:
		}
		out = out.Append("--")
		out = out.Append("\(x.Command)")
		out
	case workapi.RefreshRequest:
		[]string{"refresh"}
	case workapi.BasesRequest:
		[]string{"bases"}
	case workapi.ShellInitRequest:
		[]string{"shell-init"}
	case workapi.ImportRiftRequest as x:
		let mut out = []string{"import-rift"}
		match x.O.File {
		case Some[string] as s:
			out = out.Append("-file=\(s.Value)")
		case None:
		}
		out
	}
}

// RoundTrips reports whether Parse reads what Print writes of r as r.
func RoundTrips(r Request) bool {
	let back = Parse(Print(r)) catch {
	case flag.Failure:
		return false
	}
	back == r
}

// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// answer is the Output of a value: its text, or its JSON with --json.
func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else if plain == "" {
		Output{Out: "", Err: "", Code: 0}
	} else {
		Output{Out: plain + "\n", Err: "", Code: 0}
	}
}

// failed is the Output of a typed failure, from its tagged JSON: on
// standard output with --json, else its tag and JSON on standard error;
// status 1.
func failed(asJSON bool, tagged string) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: 1}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: 1}
	}
}

// Show is what Run prints of the outcome o: the value (its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed).
func Show(o workapi.Outcome, asJSON bool) Output {
	match o {
	case workapi.Done as done:
		match done.Reply {
		case workapi.InitReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.NewReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.AdoptReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.AdoptRiftReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.ListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.RmReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.GcReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DuReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.ReadyReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.SyncReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.EnvReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.MergeFileReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.MergeFoldersReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DeriveReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DepsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.TrustReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DoctorReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.PluginTestReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.RefreshReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.BasesReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.ShellInitReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.ImportRiftReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		}
	case workapi.Rejected as rejected:
		match rejected.Failure {
		case workapi.BadConfig as failure:
			failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(failure.E)))
		case workapi.Unkept as failure:
			failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(failure.E)))
		case workapi.Denied as failure:
			failed(asJSON, rpc.Tagged("Denied", rpc.Encode(failure.E)))
		case workapi.Failed as failure:
			failed(asJSON, rpc.Tagged("Failed", rpc.Encode(failure.E)))
		case workapi.HookFailed as failure:
			failed(asJSON, rpc.Tagged("HookFailed", rpc.Encode(failure.E)))
		case workapi.NoBase as failure:
			failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(failure.E)))
		case workapi.BadName as failure:
			failed(asJSON, rpc.Tagged("BadName", rpc.Encode(failure.E)))
		case workapi.NameTaken as failure:
			failed(asJSON, rpc.Tagged("NameTaken", rpc.Encode(failure.E)))
		case workapi.NoWorkspace as failure:
			failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(failure.E)))
		case workapi.NoRevision as failure:
			failed(asJSON, rpc.Tagged("NoRevision", rpc.Encode(failure.E)))
		case workapi.Diverged as failure:
			failed(asJSON, rpc.Tagged("Diverged", rpc.Encode(failure.E)))
		case workapi.CopyRefused as failure:
			failed(asJSON, rpc.Tagged("CopyRefused", rpc.Encode(failure.E)))
		case workapi.NotSameVolume as failure:
			failed(asJSON, rpc.Tagged("NotSameVolume", rpc.Encode(failure.E)))
		case workapi.Unsupported as failure:
			failed(asJSON, rpc.Tagged("Unsupported", rpc.Encode(failure.E)))
		case workapi.Exists as failure:
			failed(asJSON, rpc.Tagged("Exists", rpc.Encode(failure.E)))
		case workapi.Missing as failure:
			failed(asJSON, rpc.Tagged("Missing", rpc.Encode(failure.E)))
		case workapi.NoSpace as failure:
			failed(asJSON, rpc.Tagged("NoSpace", rpc.Encode(failure.E)))
		case workapi.CloneFailed as failure:
			failed(asJSON, rpc.Tagged("CloneFailed", rpc.Encode(failure.E)))
		case workapi.VcsFailed as failure:
			failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(failure.E)))
		case workapi.Locked as failure:
			failed(asJSON, rpc.Tagged("Locked", rpc.Encode(failure.E)))
		case workapi.Busy as failure:
			failed(asJSON, rpc.Tagged("Busy", rpc.Encode(failure.E)))
		case workapi.RiftUnread as failure:
			failed(asJSON, rpc.Tagged("RiftUnread", rpc.Encode(failure.E)))
		case workapi.NotHeld as failure:
			failed(asJSON, rpc.Tagged("NotHeld", rpc.Encode(failure.E)))
		case workapi.IdMismatch as failure:
			failed(asJSON, rpc.Tagged("IdMismatch", rpc.Encode(failure.E)))
		case workapi.HasDescendants as failure:
			failed(asJSON, rpc.Tagged("HasDescendants", rpc.Encode(failure.E)))
		case workapi.BadAge as failure:
			failed(asJSON, rpc.Tagged("BadAge", rpc.Encode(failure.E)))
		case workapi.NotHere as failure:
			failed(asJSON, rpc.Tagged("NotHere", rpc.Encode(failure.E)))
		case workapi.Detached as failure:
			failed(asJSON, rpc.Tagged("Detached", rpc.Encode(failure.E)))
		case workapi.NotFastForward as failure:
			failed(asJSON, rpc.Tagged("NotFastForward", rpc.Encode(failure.E)))
		case workapi.Moved as failure:
			failed(asJSON, rpc.Tagged("Moved", rpc.Encode(failure.E)))
		case workapi.Dirty as failure:
			failed(asJSON, rpc.Tagged("Dirty", rpc.Encode(failure.E)))
		case workapi.Conflicted as failure:
			failed(asJSON, rpc.Tagged("Conflicted", rpc.Encode(failure.E)))
		case workapi.BadClass as failure:
			failed(asJSON, rpc.Tagged("BadClass", rpc.Encode(failure.E)))
		case workapi.MergeConflict as failure:
			failed(asJSON, rpc.Tagged("MergeConflict", rpc.Encode(failure.E)))
		case workapi.NotFound as failure:
			failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(failure.E)))
		case workapi.Untrusted as failure:
			failed(asJSON, rpc.Tagged("Untrusted", rpc.Encode(failure.E)))
		case workapi.DeriveFailed as failure:
			failed(asJSON, rpc.Tagged("DeriveFailed", rpc.Encode(failure.E)))
		case workapi.DepsFailed as failure:
			failed(asJSON, rpc.Tagged("DepsFailed", rpc.Encode(failure.E)))
		case workapi.PluginRefused as failure:
			failed(asJSON, rpc.Tagged("PluginRefused", rpc.Encode(failure.E)))
		}
	}
}

// Read is the outcome of r that the Output of Run with --json says: its
// value's JSON on standard output with status 0, or its failure's tagged
// JSON with status 1. Any other Output is not an answer to r, a defect.
func Read(r Request, out Output) workapi.Outcome {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case workapi.InitRequest:
			let v = rpc.Decode[string]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Init with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.InitReply{Value: v}}
		case workapi.NewRequest:
			let v = rpc.Decode[work.Created]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered New with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.NewReply{Value: v}}
		case workapi.AdoptRequest:
			let v = rpc.Decode[work.Workspace]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Adopt with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.AdoptReply{Value: v}}
		case workapi.AdoptRiftRequest:
			let v = rpc.Decode[work.RiftAdopted]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered AdoptRift with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.AdoptRiftReply{Value: v}}
		case workapi.ListRequest:
			let v = rpc.Decode[[]work.Workspace]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered List with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.ListReply{Value: v}}
		case workapi.RmRequest:
			let v = rpc.Decode[[]work.Removed]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Rm with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.RmReply{Value: v}}
		case workapi.GcRequest:
			let v = rpc.Decode[work.Collected]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Gc with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.GcReply{Value: v}}
		case workapi.DuRequest:
			let v = rpc.Decode[[]work.Space]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Du with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.DuReply{Value: v}}
		case workapi.ReadyRequest:
			let v = rpc.Decode[work.Handed]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Ready with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.ReadyReply{Value: v}}
		case workapi.SyncRequest:
			let v = rpc.Decode[work.Synced]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Sync with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.SyncReply{Value: v}}
		case workapi.EnvRequest:
			let v = rpc.Decode[string]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Env with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.EnvReply{Value: v}}
		case workapi.MergeFileRequest:
			let v = rpc.Decode[work.FileMerged]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered MergeFile with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.MergeFileReply{Value: v}}
		case workapi.MergeFoldersRequest:
			let v = rpc.Decode[work.TreeMerged]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered MergeFolders with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.MergeFoldersReply{Value: v}}
		case workapi.DeriveRequest:
			let v = rpc.Decode[work.Derived]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Derive with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.DeriveReply{Value: v}}
		case workapi.DepsRequest:
			let v = rpc.Decode[work.DepsDone]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Deps with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.DepsReply{Value: v}}
		case workapi.TrustRequest:
			let v = rpc.Decode[work.Trusted]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Trust with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.TrustReply{Value: v}}
		case workapi.DoctorRequest:
			let v = rpc.Decode[work.Report]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Doctor with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.DoctorReply{Value: v}}
		case workapi.PluginTestRequest:
			let v = rpc.Decode[work.PluginAdmitted]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered PluginTest with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.PluginTestReply{Value: v}}
		case workapi.RefreshRequest:
			let v = rpc.Decode[int]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Refresh with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.RefreshReply{Value: v}}
		case workapi.BasesRequest:
			let v = rpc.Decode[[]string]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Bases with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.BasesReply{Value: v}}
		case workapi.ShellInitRequest:
			let v = rpc.Decode[string]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered ShellInit with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.ShellInitReply{Value: v}}
		case workapi.ImportRiftRequest:
			let v = rpc.Decode[string]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered ImportRift with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.ImportRiftReply{Value: v}}
		}
	} else if out.Code == 1 {
		match rpc.TagOf(text) {
		case "BadConfig":
			let e = rpc.Decode[work.BadConfig]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.BadConfig{E: e}}
		case "Unkept":
			let e = rpc.Decode[work.Unkept]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Unkept{E: e}}
		case "Denied":
			let e = rpc.Decode[fs.Denied]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Denied{E: e}}
		case "Failed":
			let e = rpc.Decode[fs.Failed]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Failed{E: e}}
		case "HookFailed":
			let e = rpc.Decode[work.HookFailed]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.HookFailed{E: e}}
		case "NoBase":
			let e = rpc.Decode[work.NoBase]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NoBase{E: e}}
		case "BadName":
			let e = rpc.Decode[work.BadName]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.BadName{E: e}}
		case "NameTaken":
			let e = rpc.Decode[work.NameTaken]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NameTaken{E: e}}
		case "NoWorkspace":
			let e = rpc.Decode[work.NoWorkspace]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NoWorkspace{E: e}}
		case "NoRevision":
			let e = rpc.Decode[work.NoRevision]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NoRevision{E: e}}
		case "Diverged":
			let e = rpc.Decode[work.Diverged]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Diverged{E: e}}
		case "CopyRefused":
			let e = rpc.Decode[work.CopyRefused]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.CopyRefused{E: e}}
		case "NotSameVolume":
			let e = rpc.Decode[work.NotSameVolume]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NotSameVolume{E: e}}
		case "Unsupported":
			let e = rpc.Decode[work.Unsupported]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Unsupported{E: e}}
		case "Exists":
			let e = rpc.Decode[work.Exists]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Exists{E: e}}
		case "Missing":
			let e = rpc.Decode[work.Missing]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Missing{E: e}}
		case "NoSpace":
			let e = rpc.Decode[work.NoSpace]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NoSpace{E: e}}
		case "CloneFailed":
			let e = rpc.Decode[work.CloneFailed]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.CloneFailed{E: e}}
		case "VcsFailed":
			let e = rpc.Decode[work.VcsFailed]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.VcsFailed{E: e}}
		case "Locked":
			let e = rpc.Decode[work.Locked]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
