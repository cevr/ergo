		case Some[string] as s:
			out = out.Append("-token=\(s.Value)")
		case None:
		}
		out = out.Append("--")
		out = out.Append("\(x.Name)")
		out
	case workapi.AdoptRequest as x:
		let mut out = []string{"adopt"}
		match x.O.Name {
		case Some[string] as s:
