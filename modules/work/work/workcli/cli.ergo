		case "IdMismatch":
			let e = rpc.Decode[work.IdMismatch]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.IdMismatch{E: e}}
		case "HasDescendants":
			let e = rpc.Decode[work.HasDescendants]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.HasDescendants{E: e}}
		case "BadAge":
			let e = rpc.Decode[work.BadAge]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.BadAge{E: e}}
		case "NotHere":
			let e = rpc.Decode[work.NotHere]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NotHere{E: e}}
		case "Detached":
			let e = rpc.Decode[work.Detached]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Detached{E: e}}
		case "NotFastForward":
			let e = rpc.Decode[work.NotFastForward]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NotFastForward{E: e}}
		case "Moved":
			let e = rpc.Decode[work.Moved]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Moved{E: e}}
		case "Dirty":
			let e = rpc.Decode[work.Dirty]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Dirty{E: e}}
		case "Conflicted":
			let e = rpc.Decode[work.Conflicted]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Conflicted{E: e}}
		case "BadClass":
			let e = rpc.Decode[work.BadClass]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.BadClass{E: e}}
		case "MergeConflict":
			let e = rpc.Decode[work.MergeConflict]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.MergeConflict{E: e}}
		case "NotFound":
			let e = rpc.Decode[fs.NotFound]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.NotFound{E: e}}
		case "Untrusted":
			let e = rpc.Decode[work.Untrusted]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.Untrusted{E: e}}
		case "DeriveFailed":
			let e = rpc.Decode[work.DeriveFailed]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.DeriveFailed{E: e}}
		case "DepsFailed":
			let e = rpc.Decode[work.DepsFailed]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.DepsFailed{E: e}}
		case "PluginRefused":
			let e = rpc.Decode[work.PluginRefused]("failure", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered a failure it cannot read: " + t.Reason)
			}
			workapi.Rejected{Failure: workapi.PluginRefused{E: e}}
		case _:
			Unreachable("the command line answered a failure no operation has: " + text)
		}
	} else {
		Unreachable("the command line answered status \(out.Code): " + out.Err)
	}
}

// runOver reads args as [--json] COMMAND ARGS..., answers the Request with
// answer and is what to print (Show), or the help (status 0) or a usage
// error (status 2) of the command line.
func runOver[R](args []string, answer func(r Request) workapi.Outcome needs R) Output needs R {
	let asJSON = len(args) > 0 && (args[0] == "--json" || args[0] == "-json")
	let mut rest = []string{}
	for i, a in args {
		if i > 0 || !asJSON {
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return Output{Out: h.Text, Err: "", Code: 0}
	case err:
		return Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}
	}
	Show(answer(r), asJSON)
}

// Run reads args as [--json] COMMAND ARGS..., answers the call through
// the hub's Call on the work.Api the caller binds, and is what to print:
// the value (its text when it is a basic value, else its JSON; its JSON
// with --json), or a typed failure (failed), or the help (status 0) or a
// usage error (status 2) of the command line.
func Run(args []string) Output needs work.Api {
	runOver(args, workapi.Call)
}

// carry is c through the command line: printed with --json, read back
// by Run's own reader, answered by answer, shown, and read back (Read).
func carry(c Request, answer func(c Request) workapi.Outcome) workapi.Outcome {
	let mut args = []string{"--json"}
	for a in Print(c) {
		args = args.Append(a)
	}
	Read(c, runOver(args, answer))
}

// Wire is the command line as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, workapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) workapi.Outcome) workapi.Outcome { carry(c, answer) }

// Agrees: the command line carries every call and every outcome the
// call can have unchanged.
law Agrees(r Request, g workapi.Given) { api.Agrees(Wire, r, workapi.OutcomeOf(r, g)) }
