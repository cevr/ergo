// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case workapi.InitRequest:
		[]string{"init"}
	case workapi.NewRequest as x:
		let mut out = []string{"new"}
		out = out.Append("-copy=\(x.O.Copy)")
		match x.O.From {
		case Some[string] as s:
			out = out.Append("-from=\(s.Value)")
		case None:
		}
		match x.O.Branch {
		case Some[string] as s:
			out = out.Append("-branch=\(s.Value)")
		case None:
		}
		match x.O.On {
		case Some[string] as s:
			out = out.Append("-on=\(s.Value)")
		case None:
		}
