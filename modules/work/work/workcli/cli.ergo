func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else if plain == "" {
		Output{Out: "", Err: "", Code: 0}
	} else {
		Output{Out: plain + "\n", Err: "", Code: 0}
	}
}

// failed is the Output of a typed failure, from its tagged JSON: on
// standard output with --json, else its tag and JSON on standard error;
// status 1.
func failed(asJSON bool, tagged string) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: 1}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: 1}
	}
}

// Run reads args as [--json] COMMAND ARGS..., calls the operation on
// the work.Api the caller binds, and is what to print: the value (its
// text when it is a basic value, else its JSON; its JSON with --json), or
// a typed failure (failed), or the help (status 0) or a usage error
// (status 2) of the command line.
func Run(args []string) Output needs work.Api {
	let asJSON = len(args) > 0 && (args[0] == "--json" || args[0] == "-json")
	let mut rest = []string{}
	for i, a in args {
		if i > 0 || !asJSON {
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return Output{Out: h.Text, Err: "", Code: 0}
	case err:
		return Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}
	}
	match r {
	case InitRequest:
		let v = work.Api.Init() catch {
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case fs.Denied as e:
			return failed(asJSON, rpc.Tagged("Denied", rpc.Encode(e)))
		case fs.Failed as e:
			return failed(asJSON, rpc.Tagged("Failed", rpc.Encode(e)))
		}
		answer(asJSON, "\(v)", rpc.Encode(v))
	case NewRequest as x:
		let v = work.Api.New(x.Name, x.O) catch {
		case work.HookFailed as e:
			return failed(asJSON, rpc.Tagged("HookFailed", rpc.Encode(e)))
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.BadName as e:
			return failed(asJSON, rpc.Tagged("BadName", rpc.Encode(e)))
		case work.NameTaken as e:
			return failed(asJSON, rpc.Tagged("NameTaken", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.NoRevision as e:
			return failed(asJSON, rpc.Tagged("NoRevision", rpc.Encode(e)))
		case work.Diverged as e:
			return failed(asJSON, rpc.Tagged("Diverged", rpc.Encode(e)))
		case work.CopyRefused as e:
			return failed(asJSON, rpc.Tagged("CopyRefused", rpc.Encode(e)))
		case work.NotSameVolume as e:
			return failed(asJSON, rpc.Tagged("NotSameVolume", rpc.Encode(e)))
		case work.Unsupported as e:
			return failed(asJSON, rpc.Tagged("Unsupported", rpc.Encode(e)))
		case work.Exists as e:
			return failed(asJSON, rpc.Tagged("Exists", rpc.Encode(e)))
		case work.Missing as e:
			return failed(asJSON, rpc.Tagged("Missing", rpc.Encode(e)))
		case work.NoSpace as e:
			return failed(asJSON, rpc.Tagged("NoSpace", rpc.Encode(e)))
		case work.CloneFailed as e:
			return failed(asJSON, rpc.Tagged("CloneFailed", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		case work.Busy as e:
			return failed(asJSON, rpc.Tagged("Busy", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case AdoptRequest as x:
		let v = work.Api.Adopt(x.Dir, x.O) catch {
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.BadName as e:
			return failed(asJSON, rpc.Tagged("BadName", rpc.Encode(e)))
		case work.NameTaken as e:
			return failed(asJSON, rpc.Tagged("NameTaken", rpc.Encode(e)))
		case work.Missing as e:
			return failed(asJSON, rpc.Tagged("Missing", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case AdoptRiftRequest as x:
		let v = work.Api.AdoptRift(x.O) catch {
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		case work.RiftUnread as e:
			return failed(asJSON, rpc.Tagged("RiftUnread", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case ListRequest:
		let v = work.Api.List() catch {
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case RmRequest as x:
		let v = work.Api.Rm(x.Name, x.O) catch {
		case work.HookFailed as e:
			return failed(asJSON, rpc.Tagged("HookFailed", rpc.Encode(e)))
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.Exists as e:
			return failed(asJSON, rpc.Tagged("Exists", rpc.Encode(e)))
		case work.Missing as e:
			return failed(asJSON, rpc.Tagged("Missing", rpc.Encode(e)))
		case work.CloneFailed as e:
			return failed(asJSON, rpc.Tagged("CloneFailed", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		case work.Busy as e:
			return failed(asJSON, rpc.Tagged("Busy", rpc.Encode(e)))
		case work.NotHeld as e:
			return failed(asJSON, rpc.Tagged("NotHeld", rpc.Encode(e)))
		case work.IdMismatch as e:
			return failed(asJSON, rpc.Tagged("IdMismatch", rpc.Encode(e)))
		case work.HasDescendants as e:
			return failed(asJSON, rpc.Tagged("HasDescendants", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case GcRequest as x:
		let v = work.Api.Gc(x.O) catch {
		case work.HookFailed as e:
			return failed(asJSON, rpc.Tagged("HookFailed", rpc.Encode(e)))
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.Exists as e:
			return failed(asJSON, rpc.Tagged("Exists", rpc.Encode(e)))
		case work.Missing as e:
			return failed(asJSON, rpc.Tagged("Missing", rpc.Encode(e)))
		case work.CloneFailed as e:
			return failed(asJSON, rpc.Tagged("CloneFailed", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		case work.BadAge as e:
			return failed(asJSON, rpc.Tagged("BadAge", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case DuRequest:
		let v = work.Api.Du() catch {
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.Unsupported as e:
			return failed(asJSON, rpc.Tagged("Unsupported", rpc.Encode(e)))
		case work.Missing as e:
			return failed(asJSON, rpc.Tagged("Missing", rpc.Encode(e)))
		case work.CloneFailed as e:
			return failed(asJSON, rpc.Tagged("CloneFailed", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case ReadyRequest as x:
		let v = work.Api.Ready(x.O) catch {
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		case work.Busy as e:
			return failed(asJSON, rpc.Tagged("Busy", rpc.Encode(e)))
		case work.NotHere as e:
			return failed(asJSON, rpc.Tagged("NotHere", rpc.Encode(e)))
		case work.Detached as e:
			return failed(asJSON, rpc.Tagged("Detached", rpc.Encode(e)))
		case work.NotFastForward as e:
			return failed(asJSON, rpc.Tagged("NotFastForward", rpc.Encode(e)))
		case work.Moved as e:
			return failed(asJSON, rpc.Tagged("Moved", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case SyncRequest as x:
		let v = work.Api.Sync(x.O) catch {
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		case work.Busy as e:
			return failed(asJSON, rpc.Tagged("Busy", rpc.Encode(e)))
		case work.NotHere as e:
			return failed(asJSON, rpc.Tagged("NotHere", rpc.Encode(e)))
		case work.Detached as e:
			return failed(asJSON, rpc.Tagged("Detached", rpc.Encode(e)))
		case work.Dirty as e:
			return failed(asJSON, rpc.Tagged("Dirty", rpc.Encode(e)))
		case work.Conflicted as e:
			return failed(asJSON, rpc.Tagged("Conflicted", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case EnvRequest as x:
		let v = work.Api.Env(x.O) catch {
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.NotHere as e:
			return failed(asJSON, rpc.Tagged("NotHere", rpc.Encode(e)))
		}
		answer(asJSON, "\(v)", rpc.Encode(v))
	case MergeFileRequest as x:
		let v = work.Api.MergeFile(x.Class, x.Base, x.Ours, x.Theirs, x.O) catch {
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case fs.Denied as e:
			return failed(asJSON, rpc.Tagged("Denied", rpc.Encode(e)))
		case fs.Failed as e:
			return failed(asJSON, rpc.Tagged("Failed", rpc.Encode(e)))
		case work.BadClass as e:
			return failed(asJSON, rpc.Tagged("BadClass", rpc.Encode(e)))
		case work.MergeConflict as e:
			return failed(asJSON, rpc.Tagged("MergeConflict", rpc.Encode(e)))
		case fs.NotFound as e:
			return failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case DeriveRequest as x:
		let v = work.Api.Derive(x.O) catch {
		case work.Untrusted as e:
			return failed(asJSON, rpc.Tagged("Untrusted", rpc.Encode(e)))
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.NotHere as e:
			return failed(asJSON, rpc.Tagged("NotHere", rpc.Encode(e)))
		case work.DeriveFailed as e:
			return failed(asJSON, rpc.Tagged("DeriveFailed", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case DepsRequest as x:
		let v = work.Api.Deps(x.O) catch {
		case work.Untrusted as e:
			return failed(asJSON, rpc.Tagged("Untrusted", rpc.Encode(e)))
		case work.DepsFailed as e:
			return failed(asJSON, rpc.Tagged("DepsFailed", rpc.Encode(e)))
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.NoWorkspace as e:
			return failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(e)))
		case work.Locked as e:
			return failed(asJSON, rpc.Tagged("Locked", rpc.Encode(e)))
		case work.NotHere as e:
			return failed(asJSON, rpc.Tagged("NotHere", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case TrustRequest:
		let v = work.Api.Trust() catch {
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case fs.Denied as e:
			return failed(asJSON, rpc.Tagged("Denied", rpc.Encode(e)))
		case fs.Failed as e:
			return failed(asJSON, rpc.Tagged("Failed", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case fs.NotFound as e:
			return failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case DoctorRequest as x:
		let v = work.Api.Doctor(x.O) catch {
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		case work.RiftUnread as e:
			return failed(asJSON, rpc.Tagged("RiftUnread", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case RefreshRequest:
		let v = work.Api.Refresh() catch {
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		case work.NoBase as e:
			return failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(e)))
		case work.VcsFailed as e:
			return failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(e)))
		}
		answer(asJSON, "\(v)", rpc.Encode(v))
	case BasesRequest:
		let v = work.Api.Bases() catch {
		case work.Unkept as e:
			return failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(e)))
		}
		let encoded = rpc.Encode(v)
		answer(asJSON, encoded, encoded)
	case ShellInitRequest:
		let v = work.Api.ShellInit()
		answer(asJSON, "\(v)", rpc.Encode(v))
	case ImportRiftRequest as x:
		let v = work.Api.ImportRift(x.O) catch {
		case work.BadConfig as e:
			return failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(e)))
		case fs.Denied as e:
			return failed(asJSON, rpc.Tagged("Denied", rpc.Encode(e)))
		case fs.Failed as e:
			return failed(asJSON, rpc.Tagged("Failed", rpc.Encode(e)))
		case fs.NotFound as e:
			return failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(e)))
		}
		answer(asJSON, "\(v)", rpc.Encode(v))
	}
}
