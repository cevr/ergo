// front is a command line read up to its call: the call and the global
// flags before it (--json, --yes), or the Output that ends the run first
// (the help, status 0; a usage error, status 2, which no policy changes).
type front = asked{R Request, JSON bool, Yes bool} | ended{O Output}

func frontOf(args []string) front {
	let mut asJSON = false
	let mut yes = false
	let mut globals = true
	let mut rest = []string{}
	for a in args {
		if globals && (a == "--json" || a == "-json") {
			asJSON = true
		} else if globals && (a == "--yes" || a == "-yes") {
			yes = true
		} else {
			globals = false
			rest = rest.Append(a)
		}
	}
	let r = Parse(rest) catch {
	case flag.Help as h:
		return ended{O: Output{Out: h.Text, Err: "", Code: 0}}
	case err:
		return ended{O: Output{Out: "", Err: flag.Describe(err) + "\n", Code: 2}}
	}
	asked{R: r, JSON: asJSON, Yes: yes}
}

// needsYes is the end of a call whose question no one can answer here.
func needsYes(question string) Output {
	Output{Out: "", Err: question + " (no terminal to ask on: pass --yes to answer yes)\n", Code: 2}
}

// declined is the end of a call whose question was answered no.
func declined(question string) Output {
	Output{Out: "", Err: question + ": not confirmed\n", Code: 1}
}

// runOver reads args as [--json] [--yes] COMMAND ARGS..., answers the
// Request with answer and is what to print (Show) under p; a call p asks a
// question of, with no --yes, ends with status 2 (needsYes): runOver has
// no terminal (RunOnTerminal has).
func runOver[R](args []string, p Policy, answer func(r Request) workapi.Outcome needs R) Output needs R {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				return needsYes(q.Value)
			case None:
			}
		}
		Show(answer(a.R), a.JSON, p)
	}
}

// Run reads args as [--json] [--yes] COMMAND ARGS..., answers the call
// through the hub's Call on the work.Api the caller binds, and is what to
// print under the policy p: the value, a typed failure with p's Code, the
// help (status 0) or a usage error (status 2). It asks nothing: a call p
// asks a question of needs --yes (status 2 without it).
func Run(args []string, p Policy) Output needs work.Api {
	runOver(args, p, workapi.Call)
}

// RunOnTerminal is Run that asks p's question on the terminal (std
// prompt) when there is no --yes: a yes runs the call, a no or a cancel
// ends with status 1, and standard input that is not a terminal ends with
// status 2, as Run does.
func RunOnTerminal(args []string, p Policy) Output needs work.Api | term.Terminal | io.Stderr {
	match frontOf(args) {
	case ended as e:
		e.O
	case asked as a:
		if !a.Yes {
			match p.Confirm(a.R) {
			case Some[string] as q:
				let yes = prompt.Confirm(q.Value, false) catch {
				case prompt.NotInteractive:
					return needsYes(q.Value)
				case prompt.Cancelled:
					return declined(q.Value)
				case io.ReadFailed:
					return Output{Out: "", Err: q.Value + ": the answer could not be read\n", Code: 2}
				}
				if !yes {
					return declined(q.Value)
				}
			case None:
			}
		}
		Show(workapi.Call(a.R), a.JSON, p)
	}
}

// Completion is the script that completes work's commands in shell.
func Completion(shell api.Shell) string {
	api.Completion("work", shell, []api.Entry{api.Entry{Name: workapi.Name(workapi.InitOp), Doc: workapi.Doc(workapi.InitOp)}, api.Entry{Name: workapi.Name(workapi.NewOp), Doc: workapi.Doc(workapi.NewOp)}, api.Entry{Name: workapi.Name(workapi.AdoptOp), Doc: workapi.Doc(workapi.AdoptOp)}, api.Entry{Name: workapi.Name(workapi.AdoptRiftOp), Doc: workapi.Doc(workapi.AdoptRiftOp)}, api.Entry{Name: workapi.Name(workapi.ListOp), Doc: workapi.Doc(workapi.ListOp)}, api.Entry{Name: workapi.Name(workapi.RmOp), Doc: workapi.Doc(workapi.RmOp)}, api.Entry{Name: workapi.Name(workapi.GcOp), Doc: workapi.Doc(workapi.GcOp)}, api.Entry{Name: workapi.Name(workapi.PinOp), Doc: workapi.Doc(workapi.PinOp)}, api.Entry{Name: workapi.Name(workapi.UnpinOp), Doc: workapi.Doc(workapi.UnpinOp)}, api.Entry{Name: workapi.Name(workapi.DuOp), Doc: workapi.Doc(workapi.DuOp)}, api.Entry{Name: workapi.Name(workapi.ReadyOp), Doc: workapi.Doc(workapi.ReadyOp)}, api.Entry{Name: workapi.Name(workapi.RecordOp), Doc: workapi.Doc(workapi.RecordOp)}, api.Entry{Name: workapi.Name(workapi.SyncOp), Doc: workapi.Doc(workapi.SyncOp)}, api.Entry{Name: workapi.Name(workapi.EnvOp), Doc: workapi.Doc(workapi.EnvOp)}, api.Entry{Name: workapi.Name(workapi.MergeFileOp), Doc: workapi.Doc(workapi.MergeFileOp)}, api.Entry{Name: workapi.Name(workapi.MergeFoldersOp), Doc: workapi.Doc(workapi.MergeFoldersOp)}, api.Entry{Name: workapi.Name(workapi.DeriveOp), Doc: workapi.Doc(workapi.DeriveOp)}, api.Entry{Name: workapi.Name(workapi.DepsOp), Doc: workapi.Doc(workapi.DepsOp)}, api.Entry{Name: workapi.Name(workapi.TrustOp), Doc: workapi.Doc(workapi.TrustOp)}, api.Entry{Name: workapi.Name(workapi.DoctorOp), Doc: workapi.Doc(workapi.DoctorOp)}, api.Entry{Name: workapi.Name(workapi.PluginTestOp), Doc: workapi.Doc(workapi.PluginTestOp)}, api.Entry{Name: workapi.Name(workapi.RefreshOp), Doc: workapi.Doc(workapi.RefreshOp)}, api.Entry{Name: workapi.Name(workapi.CloneOp), Doc: workapi.Doc(workapi.CloneOp)}, api.Entry{Name: workapi.Name(workapi.BasesOp), Doc: workapi.Doc(workapi.BasesOp)}, api.Entry{Name: workapi.Name(workapi.ForgetBaseOp), Doc: workapi.Doc(workapi.ForgetBaseOp)}, api.Entry{Name: workapi.Name(workapi.PruneBasesOp), Doc: workapi.Doc(workapi.PruneBasesOp)}, api.Entry{Name: workapi.Name(workapi.ShellInitOp), Doc: workapi.Doc(workapi.ShellInitOp)}, api.Entry{Name: workapi.Name(workapi.ImportRiftOp), Doc: workapi.Doc(workapi.ImportRiftOp)}})
}

// carry is c through the command line: printed with --json, read back
// by Run's own reader, answered by answer, shown under Defaults, and read
// back (Read).
func carry(c Request, answer func(c Request) workapi.Outcome) workapi.Outcome {
	let mut args = []string{"--json"}
	for a in Print(c) {
		args = args.Append(a)
	}
	Read(c, runOver(args, Defaults(), answer))
}

// Wire is the command line as a transport of the hub's calls.
type Wire {} implements api.Transport[Request, workapi.Outcome]

// Carry is carry.
func Carry(w Wire, c Request, answer own func(c Request) workapi.Outcome) workapi.Outcome { carry(c, answer) }

// Agrees: the command line carries every call and every outcome the
// call can have unchanged.
law Agrees(r Request, g workapi.Given) { api.Agrees(Wire, r, workapi.OutcomeOf(r, g)) }

// CodeIsThePolicy: a call's status is 0 for a value and the policy's
// Code for a typed failure.
law CodeIsThePolicy(r Request, g workapi.Given, k int) {
	let status = 1 + ((k%125)+125)%125
	let d = Defaults()
	let p = Policy{..d, Code: func(f workapi.Failure) int { status }}
	let o = workapi.OutcomeOf(r, g)
	let out = runOver(Print(r), p, func(c Request) workapi.Outcome { o })
	match o {
	case workapi.Done:
		out.Code == 0
	case workapi.Rejected:
		out.Code == status
	}
}

// TextIsThePolicy: without --json a value prints as the policy's Text;
// with --json every outcome prints as the wire's JSON, whatever Text says.
law TextIsThePolicy(r Request, g workapi.Given, t string) {
	let d = Defaults()
	let p = Policy{..d, Text: func(reply workapi.Reply) Option[string] { Some[string]{Value: t} }}
	let o = workapi.OutcomeOf(r, g)
	let same = Show(o, true, p) == Show(o, true, d)
	match o {
	case workapi.Done:
		same && Show(o, false, p).Out == line(t)
	case workapi.Rejected:
		same && Show(o, false, p) == Show(o, false, d)
	}
}
