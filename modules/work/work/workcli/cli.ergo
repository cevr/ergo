		let v = try flag.Parse(flag.Set{..c.Set, Name: "work merge-folders"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "derive":
		let c = commandDerive()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work derive"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "deps":
		let c = commandDeps()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work deps"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "trust":
		let c = commandTrust()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work trust"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "doctor":
		let c = commandDoctor()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work doctor"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "plugin-test":
		let c = commandPluginTest()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work plugin-test"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "refresh":
		let c = commandRefresh()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work refresh"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "clone":
		let c = commandClone()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work clone"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "bases":
		let c = commandBases()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work bases"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "forget-base":
		let c = commandForgetBase()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work forget-base"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "prune-bases":
		let c = commandPruneBases()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work prune-bases"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "shell-init":
		let c = commandShellInit()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work shell-init"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case "import-rift":
		let c = commandImportRift()
		let v = try flag.Parse(flag.Set{..c.Set, Name: "work import-rift"}, slices.Slice(args, 1, len(args)))
		try c.Build(v)
	case _:
		try flag.ParseCommand("work", "work.Api on a command line", Commands(), args)
	}
}

// Print is a command line that Parse reads as r again: the command,
// each flag as -name=value, then "--" and the positional arguments.
func Print(r Request) []string {
	match r {
	case workapi.InitRequest:
		[]string{"init"}
	case workapi.NewRequest as x:
		let mut out = []string{"new"}
		out = out.Append("-copy=\(x.O.Copy)")
		match x.O.From {
		case Some[string] as s:
			out = out.Append("-from=\(s.Value)")
		case None:
		}
		match x.O.Branch {
		case Some[string] as s:
			out = out.Append("-branch=\(s.Value)")
		case None:
		}
		match x.O.On {
		case Some[string] as s:
			out = out.Append("-on=\(s.Value)")
		case None:
		}
		match x.O.Token {
		case Some[string] as s:
			out = out.Append("-token=\(s.Value)")
		case None:
		}
		out = out.Append("--")
		out = out.Append("\(x.Name)")
		out
	case workapi.AdoptRequest as x:
		let mut out = []string{"adopt"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out = out.Append("--")
		out = out.Append("\(x.Dir)")
		out
	case workapi.AdoptRiftRequest as x:
		let mut out = []string{"adopt-rift"}
		match x.O.Registry {
		case Some[string] as s:
			out = out.Append("-registry=\(s.Value)")
		case None:
		}
		out
	case workapi.ListRequest:
		[]string{"list"}
	case workapi.RmRequest as x:
		let mut out = []string{"rm"}
		out = out.Append("-abandon=\(x.O.Abandon)")
		match x.O.Expect {
		case Some[string] as s:
			out = out.Append("-expect=\(s.Value)")
		case None:
		}
		out = out.Append("-tree=\(x.O.Tree)")
		out = out.Append("--")
		out = out.Append("\(x.Name)")
		out
	case workapi.GcRequest as x:
		let mut out = []string{"gc"}
		match x.O.Older {
		case Some[string] as s:
			out = out.Append("-older=\(s.Value)")
		case None:
		}
		match x.O.Id {
		case Some[string] as s:
			out = out.Append("-id=\(s.Value)")
		case None:
		}
		match x.O.Idle {
		case Some[string] as s:
			out = out.Append("-idle=\(s.Value)")
		case None:
		}
		out = out.Append("-archive=\(x.O.Archive)")
		out
	case workapi.PinRequest as x:
		let mut out = []string{"pin"}
		out = out.Append("--")
		out = out.Append("\(x.Name)")
		out
	case workapi.UnpinRequest as x:
		let mut out = []string{"unpin"}
		out = out.Append("--")
		out = out.Append("\(x.Name)")
		out
	case workapi.DuRequest:
		[]string{"du"}
	case workapi.ReadyRequest as x:
		let mut out = []string{"ready"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		match x.O.Request {
		case Some[string] as s:
			out = out.Append("-request=\(s.Value)")
		case None:
		}
		out
	case workapi.RecordRequest as x:
		let mut out = []string{"record"}
		out = out.Append("--")
		out = out.Append("\(x.Tip)")
		out
	case workapi.SyncRequest as x:
		let mut out = []string{"sync"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.EnvRequest as x:
		let mut out = []string{"env"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.MergeFileRequest as x:
		let mut out = []string{"merge-file"}
		match x.O.Path {
		case Some[string] as s:
			out = out.Append("-path=\(s.Value)")
		case None:
		}
		out = out.Append("--")
		out = out.Append("\(x.Class)")
		out = out.Append("\(x.Base)")
		out = out.Append("\(x.Ours)")
		out = out.Append("\(x.Theirs)")
		out
	case workapi.MergeFoldersRequest as x:
		let mut out = []string{"merge-folders"}
		out = out.Append("--")
		out = out.Append("\(x.Base)")
		out = out.Append("\(x.Ours)")
		out = out.Append("\(x.Theirs)")
		out = out.Append("\(x.Out)")
		out
	case workapi.DeriveRequest as x:
		let mut out = []string{"derive"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.DepsRequest as x:
		let mut out = []string{"deps"}
		match x.O.Name {
		case Some[string] as s:
			out = out.Append("-name=\(s.Value)")
		case None:
		}
		out
	case workapi.TrustRequest:
		[]string{"trust"}
	case workapi.DoctorRequest as x:
		let mut out = []string{"doctor"}
		out = out.Append("-rift=\(x.O.Rift)")
		match x.O.Registry {
		case Some[string] as s:
			out = out.Append("-registry=\(s.Value)")
		case None:
		}
		out = out.Append("-unguard=\(x.O.Unguard)")
		out = out.Append("-fix=\(x.O.Fix)")
		out = out.Append("-here=\(x.O.Here)")
		out = out.Append("-repair=\(x.O.Repair)")
		out
	case workapi.PluginTestRequest as x:
		let mut out = []string{"plugin-test"}
		match x.O.Files {
		case Some[string] as s:
			out = out.Append("-files=\(s.Value)")
		case None:
		}
		match x.O.Max {
		case Some[int] as s:
			out = out.Append("-max=\(s.Value)")
		case None:
		}
		match x.O.Seed {
		case Some[int] as s:
			out = out.Append("-seed=\(s.Value)")
		case None:
		}
		out = out.Append("--")
		out = out.Append("\(x.Command)")
		out
	case workapi.RefreshRequest:
		[]string{"refresh"}
	case workapi.CloneRequest as x:
		let mut out = []string{"clone"}
		for e in x.O.LeaveOut {
			out = out.Append("-leave-out=\(e)")
		}
		out = out.Append("--")
		out = out.Append("\(x.Src)")
		out = out.Append("\(x.Dst)")
		out
	case workapi.BasesRequest:
		[]string{"bases"}
	case workapi.ForgetBaseRequest as x:
		let mut out = []string{"forget-base"}
		out = out.Append("--")
		out = out.Append("\(x.Base)")
		out
	case workapi.PruneBasesRequest:
		[]string{"prune-bases"}
	case workapi.ShellInitRequest:
		[]string{"shell-init"}
	case workapi.ImportRiftRequest as x:
		let mut out = []string{"import-rift"}
		match x.O.File {
		case Some[string] as s:
			out = out.Append("-file=\(s.Value)")
		case None:
		}
		out
	}
}

// RoundTrips reports whether Parse reads what Print writes of r as r.
func RoundTrips(r Request) bool {
	let back = Parse(Print(r)) catch {
	case flag.Failure:
		return false
	}
	back == r
}

// ArgsRoundTrip: Parse reads what Print writes as the same Request.
law ArgsRoundTrip(r Request) { RoundTrips(r) }

// Policy is what a binary decides of its command line: Code, the exit
// status of a typed failure (default 1); Text, the text of a value
// without --json (default None: a basic value as its text, else its
// JSON; --json never calls it); Confirm, the question a call asks before
// it runs (default None: none; --yes answers it).
type Policy { Code func(f workapi.Failure) int, Text func(r workapi.Reply) Option[string], Confirm func(r Request) Option[string] }

// Defaults is the Policy of a binary that decides nothing.
func Defaults() Policy {
	Policy{Code: func(f workapi.Failure) int { 1 }, Text: func(r workapi.Reply) Option[string] { None }, Confirm: func(r Request) Option[string] { None }}
}

// answer is the Output of a value: its text, or its JSON with --json.
func answer(asJSON bool, plain string, encoded string) Output {
	if asJSON {
		Output{Out: encoded + "\n", Err: "", Code: 0}
	} else {
		Output{Out: line(plain), Err: "", Code: 0}
	}
}

// line is s as a line of output: nothing for an empty s.
func line(s string) string {
	if s == "" {
		return ""
	}
	s + "\n"
}

// failed is the Output of a typed failure, from its tagged JSON: on
// standard output with --json, else its tag and JSON on standard error;
// the status the policy gives it.
func failed(asJSON bool, tagged string, status int) Output {
	if asJSON {
		Output{Out: tagged + "\n", Err: "", Code: status}
	} else {
		Output{Out: "", Err: rpc.TagOf(tagged) + ": " + tagged + "\n", Code: status}
	}
}

// Show is what Run prints of the outcome o under the policy p: the value
// (p's Text when it has one and there is no --json; else its text when it
// is a basic value, else its JSON; its JSON with --json), or a typed
// failure (failed) with p's Code.
func Show(o workapi.Outcome, asJSON bool, p Policy) Output {
	match o {
	case workapi.Done as done:
		if !asJSON {
			match p.Text(done.Reply) {
			case Some[string] as s:
				return Output{Out: line(s.Value), Err: "", Code: 0}
			case None:
			}
		}
		match done.Reply {
		case workapi.InitReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.NewReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.AdoptReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.AdoptRiftReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.ListReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.RmReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.GcReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.PinReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.UnpinReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DuReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.ReadyReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.RecordReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.SyncReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.EnvReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.MergeFileReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.MergeFoldersReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DeriveReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DepsReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.TrustReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.DoctorReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.PluginTestReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.RefreshReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.CloneReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.BasesReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.ForgetBaseReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.PruneBasesReply as reply:
			let v = reply.Value
			let encoded = rpc.Encode(v)
			answer(asJSON, encoded, encoded)
		case workapi.ShellInitReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		case workapi.ImportRiftReply as reply:
			let v = reply.Value
			answer(asJSON, "\(v)", rpc.Encode(v))
		}
	case workapi.Rejected as rejected:
		let status = p.Code(rejected.Failure)
		match rejected.Failure {
		case workapi.BadConfig as failure:
			failed(asJSON, rpc.Tagged("BadConfig", rpc.Encode(failure.E)), status)
		case workapi.Unkept as failure:
			failed(asJSON, rpc.Tagged("Unkept", rpc.Encode(failure.E)), status)
		case workapi.Denied as failure:
			failed(asJSON, rpc.Tagged("Denied", rpc.Encode(failure.E)), status)
		case workapi.Failed as failure:
			failed(asJSON, rpc.Tagged("Failed", rpc.Encode(failure.E)), status)
		case workapi.HookFailed as failure:
			failed(asJSON, rpc.Tagged("HookFailed", rpc.Encode(failure.E)), status)
		case workapi.NoBase as failure:
			failed(asJSON, rpc.Tagged("NoBase", rpc.Encode(failure.E)), status)
		case workapi.BadName as failure:
			failed(asJSON, rpc.Tagged("BadName", rpc.Encode(failure.E)), status)
		case workapi.NameTaken as failure:
			failed(asJSON, rpc.Tagged("NameTaken", rpc.Encode(failure.E)), status)
		case workapi.NoWorkspace as failure:
			failed(asJSON, rpc.Tagged("NoWorkspace", rpc.Encode(failure.E)), status)
		case workapi.NoRevision as failure:
			failed(asJSON, rpc.Tagged("NoRevision", rpc.Encode(failure.E)), status)
		case workapi.Diverged as failure:
			failed(asJSON, rpc.Tagged("Diverged", rpc.Encode(failure.E)), status)
		case workapi.CopyRefused as failure:
			failed(asJSON, rpc.Tagged("CopyRefused", rpc.Encode(failure.E)), status)
		case workapi.NotSameVolume as failure:
			failed(asJSON, rpc.Tagged("NotSameVolume", rpc.Encode(failure.E)), status)
		case workapi.Unsupported as failure:
			failed(asJSON, rpc.Tagged("Unsupported", rpc.Encode(failure.E)), status)
		case workapi.Exists as failure:
			failed(asJSON, rpc.Tagged("Exists", rpc.Encode(failure.E)), status)
		case workapi.Missing as failure:
			failed(asJSON, rpc.Tagged("Missing", rpc.Encode(failure.E)), status)
		case workapi.NoSpace as failure:
			failed(asJSON, rpc.Tagged("NoSpace", rpc.Encode(failure.E)), status)
		case workapi.CloneFailed as failure:
			failed(asJSON, rpc.Tagged("CloneFailed", rpc.Encode(failure.E)), status)
		case workapi.VcsFailed as failure:
			failed(asJSON, rpc.Tagged("VcsFailed", rpc.Encode(failure.E)), status)
		case workapi.Locked as failure:
			failed(asJSON, rpc.Tagged("Locked", rpc.Encode(failure.E)), status)
		case workapi.Busy as failure:
			failed(asJSON, rpc.Tagged("Busy", rpc.Encode(failure.E)), status)
		case workapi.RiftUnread as failure:
			failed(asJSON, rpc.Tagged("RiftUnread", rpc.Encode(failure.E)), status)
		case workapi.NotHeld as failure:
			failed(asJSON, rpc.Tagged("NotHeld", rpc.Encode(failure.E)), status)
		case workapi.IdMismatch as failure:
			failed(asJSON, rpc.Tagged("IdMismatch", rpc.Encode(failure.E)), status)
		case workapi.HasDescendants as failure:
			failed(asJSON, rpc.Tagged("HasDescendants", rpc.Encode(failure.E)), status)
		case workapi.BadAge as failure:
			failed(asJSON, rpc.Tagged("BadAge", rpc.Encode(failure.E)), status)
		case workapi.NotHere as failure:
			failed(asJSON, rpc.Tagged("NotHere", rpc.Encode(failure.E)), status)
		case workapi.Detached as failure:
			failed(asJSON, rpc.Tagged("Detached", rpc.Encode(failure.E)), status)
		case workapi.NotFastForward as failure:
			failed(asJSON, rpc.Tagged("NotFastForward", rpc.Encode(failure.E)), status)
		case workapi.Moved as failure:
			failed(asJSON, rpc.Tagged("Moved", rpc.Encode(failure.E)), status)
		case workapi.BadRequest as failure:
			failed(asJSON, rpc.Tagged("BadRequest", rpc.Encode(failure.E)), status)
		case workapi.NoRecord as failure:
			failed(asJSON, rpc.Tagged("NoRecord", rpc.Encode(failure.E)), status)
		case workapi.BadRecord as failure:
			failed(asJSON, rpc.Tagged("BadRecord", rpc.Encode(failure.E)), status)
		case workapi.Dirty as failure:
			failed(asJSON, rpc.Tagged("Dirty", rpc.Encode(failure.E)), status)
		case workapi.Conflicted as failure:
			failed(asJSON, rpc.Tagged("Conflicted", rpc.Encode(failure.E)), status)
		case workapi.BadClass as failure:
			failed(asJSON, rpc.Tagged("BadClass", rpc.Encode(failure.E)), status)
		case workapi.MergeConflict as failure:
			failed(asJSON, rpc.Tagged("MergeConflict", rpc.Encode(failure.E)), status)
		case workapi.NotFound as failure:
			failed(asJSON, rpc.Tagged("NotFound", rpc.Encode(failure.E)), status)
		case workapi.Untrusted as failure:
			failed(asJSON, rpc.Tagged("Untrusted", rpc.Encode(failure.E)), status)
		case workapi.DeriveFailed as failure:
			failed(asJSON, rpc.Tagged("DeriveFailed", rpc.Encode(failure.E)), status)
		case workapi.DepsFailed as failure:
			failed(asJSON, rpc.Tagged("DepsFailed", rpc.Encode(failure.E)), status)
		case workapi.PluginRefused as failure:
			failed(asJSON, rpc.Tagged("PluginRefused", rpc.Encode(failure.E)), status)
		}
	}
}

// Read is the outcome of r that the Output of Run with --json says: its
// value's JSON on standard output with status 0, or its failure's tagged
// JSON with status 1. Any other Output is not an answer to r, a defect.
func Read(r Request, out Output) workapi.Outcome {
	let text = strings.TrimSuffix(out.Out, "\n")
	if out.Code == 0 {
		match r {
		case workapi.InitRequest:
			let v = rpc.Decode[string]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Init with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.InitReply{Value: v}}
		case workapi.NewRequest:
			let v = rpc.Decode[work.Created]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered New with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.NewReply{Value: v}}
		case workapi.AdoptRequest:
			let v = rpc.Decode[work.Workspace]("value", text) catch {
			case rpc.Transport as t:
				Unreachable("the command line answered Adopt with a value it cannot read: " + t.Reason)
			}
			workapi.Done{Reply: workapi.AdoptReply{Value: v}}
		case workapi.AdoptRiftRequest:
			let v = rpc.Decode[work.RiftAdopted]("value", text) catch {
			case rpc.Transport as t:
