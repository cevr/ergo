import fs
import filepath
import slices
import strings

// HookFailed is a hook command that did not end with status 0: the hook,
// the command, its status and what it wrote on stderr.
type HookFailed { Hook string, Command string, Status int, Stderr string }

// Setting is one environment entry a hook runs with.
type Setting { Key string, Value string }

// Hooks runs the commands of work.toml's [hooks]: each by sh, in a folder,
// with the environment Rift gives its hooks under work's names
// (WORK_SOURCE, WORK_DESTINATION, WORK_ID, WORK_PARENT_ID). The binary
// chooses the provider; memory's records every run.
type Hooks {
	// Run runs one command of hook in dir.
	Run(hook string, command string, dir string, env []Setting) fails HookFailed,

	// ExitIsAFailure: a command that exits with a status other than 0 is
	// HookFailed, naming the hook, the command and the status.
	law ExitIsAFailure(hook string, n int) {
		let status = (n%125+125)%125 + 1
		let command = "exit \(status)"
		Run(hook, command, ".", []Setting{}) catch {
		case HookFailed as f:
			return f.Hook == hook && f.Command == command && f.Status == status
		}
		false
	},
}

// Lock is the registry's locks, each named by a key. The key "" is the
// mutation lock: a step that changes the registry, or renames a
// workspace's folder, holds it, and nothing else does (no copy, no hook,
// no install). A workspace's id is the lock of its reservation: new holds
// it while it copies, so gc collects a reservation only when its maker is
// gone. A holder that dies holds nothing (the host's file lock).
type Lock {
	// Hold takes the lock of key, or is false when another holder keeps
	// it: for the provider's wait for the mutation lock, at once for
	// another key. A second Hold of a held key is false too, as two opens
	// of one locked file are.
	Hold(key string) bool fails Unkept,
	// Release gives the lock of key back.
	Release(key string),
	// Held reports whether this holder holds the lock of key.
	Held(key string) bool,

	// HoldExcludes: a held lock is held, refuses a second hold, and is
	// free again after its release.
	law HoldExcludes(key string) {
		let first = Hold(key) catch {
		case Unkept:
			return true
		}
		let second = Hold(key) catch {
		case Unkept:
			return false
		}
		let during = Held(key)
		Release(key)
		let after = Held(key)
		let again = Hold(key) catch {
		case Unkept:
			return false
		}
		Release(key)
		first && !second && during && !after && again
	},
}

// Locked is a registry whose mutation lock another work held for all of
// the wait: nothing was changed, and the command can run again.
type Locked { Path string }

// HooksRan is the hooks of a step, all run: Count commands, each ended
// with status 0 (0 when work.toml has none).
type HooksRan { Count int }

// Untrusted is a work.toml whose commands work trust has not allowed:
// the tool runs none of them. Digest is what work trust would allow.
type Untrusted { Digest string, Commands []string }

// Hooked is what the hooks of a step did.
type Hooked = HooksRan | Untrusted | HookFailed

// TrustFile is where work trust keeps the allowed digest of a base: in
// the base's storage, never in its tree.
func TrustFile(home string) string { filepath.Join([]string{home, ".trusted"}) }

// trusted reports whether c's commands may run: it runs none, or its
// digest is the one work trust (or init) allowed.
func trusted(t Tool, c Config) bool {
	if Commands(c).Len() == 0 {
		return true
	}
	let text = t.files.ReadFile(TrustFile(t.home)) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	strings.TrimSpace(text) == Digest(c)
}

func untrusted(c Config) Untrusted { Untrusted{Digest: Digest(c), Commands: Commands(c)} }

// hookEnv is the environment of a hook of the workspace at path, cloned
// from source.
func hookEnv(source string, path string, id string, parentId string) []Setting {
	[]Setting{Setting{Key: "WORK_SOURCE", Value: source}, Setting{Key: "WORK_DESTINATION", Value: path}, Setting{Key: "WORK_ID", Value: id}, Setting{Key: "WORK_PARENT_ID", Value: parentId}}
}

// runHook runs the commands of the hook name in dir, in order, the first
// failure stopping it; an untrusted config runs nothing and says so when
// it has a command for this hook. It never runs while the lock is held:
// each caller releases before it.
func runHook(t Tool, c Config, name string, dir string, env []Setting) Hooked {
	let list = HookList(c.Hooks, name)
	if list.Len() == 0 {
		return HooksRan{Count: 0}
	}
	if !trusted(t, c) {
		let v Hooked = untrusted(c)
		return v
	}
	let mut n = 0
	for command in list {
		t.hooks.Run(name, command, dir, env) catch {
		case HookFailed as f:
			let v Hooked = f
			return v
		}
		n = n + 1
	}
	HooksRan{Count: n}
}

// Trusted is what work trust allowed: the digest and the commands.
type Trusted { Digest string, Commands []string }

// Trust allows the commands of the base's work.toml: it keeps their
// digest in the base's storage. A changed command asks again.
func Trust(t Tool) Trusted fails NoBase | BadConfig | Unkept | fs.NotFound | fs.Denied | fs.Failed {
	try initialized(t)
	let c = try config(t)
	try t.writes.WriteFile(TrustFile(t.home), Digest(c)+"\n")
	Trusted{Digest: Digest(c), Commands: Commands(c)}
}

// put keeps w in the registry under the lock; a live w first frees its
// name from a trashed record (freeName).
func put(t Tool, w Workspace) fails Unkept | Locked {
	try hold(t)
	let live = match w.State {
	case Trashed:
		false
	case Creating, Active, Landing, Landed, Abandoned:
		true
	}
	if live {
		freeName(t, w.Name) catch {
		case Unkept as e:
			t.lock.Release("")
			return e
		}
	}
	t.registry.Put(w) catch {
	case Unkept as e:
		t.lock.Release("")
		return e
	}
	t.lock.Release("")
}

// drop forgets name in the registry under the lock.
func drop(t Tool, name string) fails Unkept | Locked {
	try hold(t)
	t.registry.Drop(name) catch {
	case Unkept as e:
		t.lock.Release("")
		return e
	}
	t.lock.Release("")
}

// hold takes the mutation lock and finishes what a process that died in
// a removal left: every mutation does, so no intent outlives the next.
func hold(t Tool) fails Unkept | Locked {
	if !try t.lock.Hold("") {
		return Locked{Path: RegistryFile(t.home)}
	}
	finish(t) catch {
	case Unkept as e:
		t.lock.Release("")
		return e
	}
}

// finish rolls each intent forward, under the lock: the folder moves to
// the trash if it has not, and the record says it is there. Then it
// settles each reservation whose maker is gone (settle).
func finish(t Tool) fails Unkept {
	for w in try t.registry.All() {
		if w.Moving == "" {
			match w.State {
			case Creating:
				try settle(t, w)
			case Active, Landing, Landed, Abandoned, Trashed:
			}
			continue
		}
		if t.copier.Has(w.Moving) && t.copier.Has(w.Path) {
			// Another folder holds the trash's place: dropping the intent
			// would leave the workspace with no record.
			return Unkept{Reason: "\(w.Path) is taken: the move of \(w.Moving) to the trash did not end"}
		}
		if t.copier.Has(w.Moving) {
			t.copier.Move(w.Moving, w.Path) catch {
			case Missing:
			case Exists:
				return Unkept{Reason: "\(w.Path) is taken: the move of \(w.Moving) to the trash did not end"}
			case CloneFailed as e:
				return Unkept{Reason: "\(w.Moving): the move to the trash did not end: \(e.Reason)"}
			}
		}
		try t.registry.Put(Workspace{..w, Moving: ""})
	}
}

// settle finishes or rolls back w, a reservation, under the lock, when
// its maker is gone: only the kernel's lock of the reservation decides
// that (makerGone; no pid, no time), so a live maker's reservation, this
// process's own included, is never touched. A placed clone becomes
// Active only when it carries its id and its checkout has the expected
// branch and push guard. An older Work wrote the same marker before the
// branch setup: keep an incomplete checkout intact for doctor to name.
// With no folder at its path, its staging folder (whole
// or cut short) is renamed to its tomb (TombOf) and the record kept:
// settled deletes the tomb for good with the lock free, never by the
// trash, and only then drops the record (buried). A record with neither
// folder is dropped here. So no staging folder or tomb outlives its
// record, and no delete holds the registry's lock. A folder at the path with no marker, or another's, was written
// by an older work (it cloned in place) or is not the record's: gc and
// doctor keep their rules for it. A record with no id (no lock) is gc's.
// It costs one lock attempt per such reservation, and nothing per other
// record.
func settle(t Tool, w Workspace) fails Unkept {
	if w.Id == "" || !try makerGone(t, w) {
		return
	}
	if t.copier.Has(w.Path) {
		if markerOf(t, w.Path) == w.Id && recoveryProblem(t, w) == "" {
			t.registry.Put(activation(t, w, now(t))) catch {
			case Unkept as e:
				unreserved(t, w)
				return e
			}
		}
		unreserved(t, w)
		return
	}
	let staging = StagingOf(t.home, w.Id)
	// The staging folder becomes the reservation's tomb, one rename
	// under the lock; settled deletes the tomb with the lock free, and
	// drops the record after. A rename that fails leaves the record for
	// the next command. That never fails this command.
	if t.copier.Has(staging) {
		t.copier.Move(staging, TombOf(t.home, w.Id)) catch {
		case Missing, Exists, CloneFailed:
		}
		unreserved(t, w)
		return
	}
	if t.copier.Has(TombOf(t.home, w.Id)) {
		unreserved(t, w)
		return
	}
	t.registry.Drop(w.Name) catch {
	case Unkept as e:
		unreserved(t, w)
		return e
	}
	unreserved(t, w)
}

// branchProblem verifies the exact local ref and the branch checked out,
// not equality with the starting commit: the checkout can hold new work.
func branchProblem(t Tool, w Workspace) string {
	let why = "expected branch \(w.Branch) to have a local ref and be checked out"
	let branch = t.vcs.Branch(w.Path) catch {
	case VcsFailed as e:
		return "\(why); \(e.Reason)"
	}
	if w.Branch == "" || branch != w.Branch {
		return "\(why); found " + (if branch == "" { "detached HEAD or unreadable branch" } else { branch })
	}
	let ref = t.vcs.Ref(w.Path, "refs/heads/"+w.Branch) catch {
	case VcsFailed as e:
		return "\(why); \(e.Reason)"
	}
	let head = t.vcs.Head(w.Path) catch {
	case VcsFailed as e:
		return "\(why); \(e.Reason)"
	}
	if ref == "" || head != ref { why } else { "" }
}

func recoveryProblem(t Tool, w Workspace) string {
	let why = branchProblem(t, w)
	if why != "" {
		return why
	}
	if allowsRemotePush(t) {
		return ""
	}
	let guarded = t.vcs.PushesGuarded(w.Path) catch {
	case VcsFailed as e:
		return "cannot verify the push guard: \(e.Reason)"
	}
	if !guarded { "the push guard does not cover every remote" } else { "" }
}

// settled settles the reservations whose maker is gone before a command
// that changes the registry decides anything: it takes the lock (and
// gives it back) only when a reservation is there, so a command finds a
// name a killed new held free, and its folder deleted or activated. A
// mismatch is kept for doctor to report. A registry that does not read
// is the command's to report.
func settled(t Tool) fails Unkept | Locked {
	let all = t.registry.All() catch {
	case Unkept:
		return
	}
	let any = slices.IndexFunc(all, func(w Workspace) bool { StateName(w.State) == "creating" }) >= 0
	if !any {
		return
	}
	try hold(t)
	t.lock.Release("")
	let mut gone = []Workspace{}
	for w in all {
		if StateName(w.State) == "creating" && buried(t, w) {
			gone = gone.Append(w)
		}
	}
	dropped(t, gone)
}

// buried deletes the tomb of w, a reservation settle rolled back, with
// the registry's lock free, so a big copy's delete never makes another
// command wait on the lock: true when the tomb is gone. It then holds
// the reservation's lock, which dropped gives back: meanwhile another
// process's settle takes this process for the live maker and leaves the
// record, and a cut in the delete gives the lock back to the next
// command, which deletes again. A delete that fails leaves the tomb and
// the record for the next command.
func buried(t Tool, w Workspace) bool {
	let tomb = TombOf(t.home, w.Id)
	if w.Id == "" || !t.copier.Has(tomb) {
		return false
	}
	let gone = makerGone(t, w) catch {
	case Unkept:
		return false
	}
	if !gone {
		return false
	}
	clonerNamed(t, w.Cloner).Discard(tomb) catch {
	case Missing:
	case CloneFailed:
		unreserved(t, w)
		return false
	}
	true
}

// dropped drops, in one hold, the records of the reservations whose
// tombs buried deleted, each only while it is still the same
// reservation, and gives their locks back. A lock another command holds,
// or a registry that does not write, leaves the records for the next
// command, whose settle drops them (no staging folder, no tomb).
func dropped(t Tool, gone []Workspace) {
	if gone.Len() == 0 {
		return
	}
	let mut held = true
	hold(t) catch {
	case Unkept, Locked:
		held = false
	}
	if held {
		let still = t.registry.All() catch {
		case Unkept:
			[]Workspace{}
		}
		for w in gone {
			if slices.IndexFunc(still, func(r Workspace) bool { r.Name == w.Name && r.Id == w.Id && StateName(r.State) == "creating" }) >= 0 {
				t.registry.Drop(w.Name) catch {
				case Unkept:
				}
			}
		}
		t.lock.Release("")
	}
	for w in gone {
		unreserved(t, w)
	}
}
