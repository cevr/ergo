		opDoctor: func(o work.DoctorOptions) work.Report fails work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.VcsFailed | work.RiftUnread {
			sent.Update(func(rs []Request) []Request { rs.Append(DoctorRequest{O: o}) })
