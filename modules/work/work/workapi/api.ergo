// CheckedClient carries erased work.Api requests over send and validates each
// Outcome against the requested operation, failing rpc.Transport on a
// sibling reply or a failure outside the operation's row.
type CheckedClient { send func(r Request) Outcome fails rpc.Transport }

// NewCheckedClient is the CheckedClient that send answers.
func NewCheckedClient(send own func(r Request) Outcome fails rpc.Transport) CheckedClient { CheckedClient{send: send} }

// VersionChecked sends work.Api's Version over send and validates its Outcome.
func VersionChecked(client CheckedClient) string fails rpc.Transport {
	match try client.send(VersionRequest) {
	case Done as done:
		match done.Reply {
		case VersionReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "workapi: Version was answered with the value of another operation"}
		}
	case Rejected:
		return rpc.Transport{Reason: "workapi: Version was answered with a failure outside its row"}
	}
}

// InitChecked sends work.Api's Init over send and validates its Outcome.
func InitChecked(client CheckedClient) string fails work.Unkept | work.BadConfig | fs.Denied | fs.Failed | rpc.Transport {
	match try client.send(InitRequest) {
	case Done as done:
		match done.Reply {
		case InitReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "workapi: Init was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unkept as failure:
			return failure.E
		case BadConfig as failure:
			return failure.E
		case Denied as failure:
			return failure.E
		case Failed as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "workapi: Init was answered with a failure outside its row"}
		}
	}
}

// NewChecked sends work.Api's New over send and validates its Outcome.
func NewChecked(client CheckedClient, name string, o work.NewOptions) work.Created fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.BadName | work.NameTaken | work.NoWorkspace | work.NoRevision | work.Diverged | work.CopyRefused | work.NotSameVolume | work.Unsupported | work.Exists | work.NoSpace | work.VcsFailed | work.Busy | rpc.Transport {
	match try client.send(NewRequest{Name: name, O: o}) {
	case Done as done:
		match done.Reply {
		case NewReply as reply:
			reply.Value
		case _:
			return rpc.Transport{Reason: "workapi: New was answered with the value of another operation"}
		}
	case Rejected as rejected:
		match rejected.Failure {
		case HookFailed as failure:
			return failure.E
		case Missing as failure:
			return failure.E
		case CloneFailed as failure:
			return failure.E
		case Unkept as failure:
			return failure.E
		case Locked as failure:
			return failure.E
		case BadConfig as failure:
			return failure.E
		case NoBase as failure:
			return failure.E
		case BadName as failure:
			return failure.E
		case NameTaken as failure:
			return failure.E
		case NoWorkspace as failure:
			return failure.E
		case NoRevision as failure:
			return failure.E
		case Diverged as failure:
			return failure.E
		case CopyRefused as failure:
			return failure.E
		case NotSameVolume as failure:
			return failure.E
		case Unsupported as failure:
			return failure.E
		case Exists as failure:
			return failure.E
		case NoSpace as failure:
			return failure.E
		case VcsFailed as failure:
			return failure.E
		case Busy as failure:
			return failure.E
		case _:
			return rpc.Transport{Reason: "workapi: New was answered with a failure outside its row"}
		}
	}
}

