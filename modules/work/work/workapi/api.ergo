import fs
import json
import rpc
import sync
import github.com/cevr/ergo/modules/work/work

// Request is one call of work.Api: a variant per operation, whose fields
// are the operation's parameters. It is the request every transport carries.
type Request = VersionRequest{} | InitRequest{} | NewRequest{Name string, O work.NewOptions} | AdoptRequest{Dir string, O work.AdoptOptions} | AdoptRiftRequest{O work.RiftOptions} | ListRequest{O work.ListOptions} | RmRequest{Name string, O work.RmOptions} | GcRequest{O work.GcOptions} | PinRequest{Name string} | UnpinRequest{Name string} | DuRequest{} | ReadyRequest{O work.ReadyOptions} | RecordRequest{Tip string} | SyncRequest{O work.SyncOptions} | EnvRequest{O work.EnvOptions} | MergeFileRequest{Class string, Base string, Ours string, Theirs string, O work.MergeFileOptions} | MergeFoldersRequest{Base string, Ours string, Theirs string, Out string} | DeriveRequest{O work.DeriveOptions} | DepsRequest{O work.DepsOptions} | TrustRequest{} | DoctorRequest{O work.DoctorOptions} | PluginTestRequest{Command string, O work.PluginTestOptions} | RefreshRequest{} | CloneRequest{Src string, Dst string, O work.CloneOptions} | BasesRequest{} | ForgetBaseRequest{Base string} | PruneBasesRequest{} | ShellInitRequest{} | ImportRiftRequest{O work.ImportRiftOptions}

// Op is an operation of work.Api: what a policy matches on.
type Op = VersionOp{} | InitOp{} | NewOp{} | AdoptOp{} | AdoptRiftOp{} | ListOp{} | RmOp{} | GcOp{} | PinOp{} | UnpinOp{} | DuOp{} | ReadyOp{} | RecordOp{} | SyncOp{} | EnvOp{} | MergeFileOp{} | MergeFoldersOp{} | DeriveOp{} | DepsOp{} | TrustOp{} | DoctorOp{} | PluginTestOp{} | RefreshOp{} | CloneOp{} | BasesOp{} | ForgetBaseOp{} | PruneBasesOp{} | ShellInitOp{} | ImportRiftOp{}

// Reply is the value of an operation: a variant per operation.
type Reply = VersionReply{Value string} | InitReply{Value string} | NewReply{Value work.Created} | AdoptReply{Value work.Workspace} | AdoptRiftReply{Value work.RiftAdopted} | ListReply{Value []work.Listed} | RmReply{Value []work.Removed} | GcReply{Value work.Collected} | PinReply{Value work.Workspace} | UnpinReply{Value work.Workspace} | DuReply{Value []work.Space} | ReadyReply{Value work.Handed} | RecordReply{Value work.LaneRecord} | SyncReply{Value work.Synced} | EnvReply{Value string} | MergeFileReply{Value work.FileMerged} | MergeFoldersReply{Value work.TreeMerged} | DeriveReply{Value work.Derived} | DepsReply{Value work.DepsDone} | TrustReply{Value work.Trusted} | DoctorReply{Value work.Report} | PluginTestReply{Value work.PluginAdmitted} | RefreshReply{Value int} | CloneReply{Value work.TreeCloned} | BasesReply{Value []string} | ForgetBaseReply{Value []string} | PruneBasesReply{Value []string} | ShellInitReply{Value string} | ImportRiftReply{Value string}

// Failure is a failure of an operation: a variant per failure type of
// any row, named like the type (its JSON tag).
type Failure = Unkept{E work.Unkept} | BadConfig{E work.BadConfig} | Denied{E fs.Denied} | Failed{E fs.Failed} | HookFailed{E work.HookFailed} | Missing{E work.Missing} | CloneFailed{E work.CloneFailed} | Locked{E work.Locked} | NoBase{E work.NoBase} | BadName{E work.BadName} | NameTaken{E work.NameTaken} | NoWorkspace{E work.NoWorkspace} | NoRevision{E work.NoRevision} | Diverged{E work.Diverged} | CopyRefused{E work.CopyRefused} | NotSameVolume{E work.NotSameVolume} | Unsupported{E work.Unsupported} | Exists{E work.Exists} | NoSpace{E work.NoSpace} | VcsFailed{E work.VcsFailed} | Busy{E work.Busy} | RiftUnread{E work.RiftUnread} | NotHeld{E work.NotHeld} | IdMismatch{E work.IdMismatch} | HasDescendants{E work.HasDescendants} | BadAge{E work.BadAge} | BadRequest{E work.BadRequest} | GcFailed{E work.GcFailed} | NotHere{E work.NotHere} | Detached{E work.Detached} | NotFastForward{E work.NotFastForward} | Moved{E work.Moved} | NoRecord{E work.NoRecord} | BadRecord{E work.BadRecord} | Dirty{E work.Dirty} | Conflicted{E work.Conflicted} | BadClass{E work.BadClass} | MergeConflict{E work.MergeConflict} | NotFound{E fs.NotFound} | Untrusted{E work.Untrusted} | DeriveFailed{E work.DeriveFailed} | DepsFailed{E work.DepsFailed} | PluginRefused{E work.PluginRefused}

// Outcome is what one call ends in: its operation's value or one of
// its failures.
type Outcome = Done{Reply Reply} | Rejected{Failure Failure}

// OpOf is the operation r calls.
func OpOf(r Request) Op {
	match r {
	case VersionRequest:
		VersionOp
	case InitRequest:
		InitOp
	case NewRequest:
		NewOp
	case AdoptRequest:
		AdoptOp
	case AdoptRiftRequest:
		AdoptRiftOp
	case ListRequest:
		ListOp
	case RmRequest:
		RmOp
	case GcRequest:
		GcOp
	case PinRequest:
		PinOp
	case UnpinRequest:
		UnpinOp
	case DuRequest:
		DuOp
	case ReadyRequest:
		ReadyOp
	case RecordRequest:
		RecordOp
	case SyncRequest:
		SyncOp
	case EnvRequest:
		EnvOp
	case MergeFileRequest:
		MergeFileOp
	case MergeFoldersRequest:
		MergeFoldersOp
	case DeriveRequest:
		DeriveOp
	case DepsRequest:
		DepsOp
	case TrustRequest:
		TrustOp
	case DoctorRequest:
		DoctorOp
	case PluginTestRequest:
		PluginTestOp
	case RefreshRequest:
		RefreshOp
	case CloneRequest:
		CloneOp
	case BasesRequest:
		BasesOp
	case ForgetBaseRequest:
		ForgetBaseOp
	case PruneBasesRequest:
		PruneBasesOp
	case ShellInitRequest:
		ShellInitOp
	case ImportRiftRequest:
		ImportRiftOp
	}
}

// Name is op's name on every transport: the operation's, in kebab case.
func Name(op Op) string {
	match op {
	case VersionOp:
		"version"
	case InitOp:
		"init"
	case NewOp:
		"new"
	case AdoptOp:
		"adopt"
	case AdoptRiftOp:
		"adopt-rift"
	case ListOp:
		"list"
	case RmOp:
		"rm"
	case GcOp:
		"gc"
	case PinOp:
		"pin"
	case UnpinOp:
		"unpin"
	case DuOp:
		"du"
	case ReadyOp:
		"ready"
	case RecordOp:
		"record"
	case SyncOp:
		"sync"
	case EnvOp:
		"env"
	case MergeFileOp:
		"merge-file"
	case MergeFoldersOp:
		"merge-folders"
	case DeriveOp:
		"derive"
	case DepsOp:
		"deps"
	case TrustOp:
		"trust"
	case DoctorOp:
		"doctor"
	case PluginTestOp:
		"plugin-test"
	case RefreshOp:
		"refresh"
	case CloneOp:
		"clone"
	case BasesOp:
		"bases"
	case ForgetBaseOp:
		"forget-base"
	case PruneBasesOp:
		"prune-bases"
	case ShellInitOp:
		"shell-init"
	case ImportRiftOp:
		"import-rift"
	}
}

// Doc is what op does: its doc comment, or its signature.
func Doc(op Op) string {
	match op {
	case VersionOp:
		"Version prints this executable's build commit and date."
	case InitOp:
		"Init registers the base: it writes a starter work.toml when the base has none, the registry, the trust of the work.toml's commands (the user who inits allows them), refreshes the base's Git index, and adds the base to the user's list of bases. A second init changes nothing."
	case NewOp:
		"New clones the base into a new workspace named name and prints its folder."
	case AdoptOp:
		"Adopt registers an existing clone (a Rift, a Git clone) as a workspace; it moves no file."
	case AdoptRiftOp:
		"AdoptRift registers each Rift copy of the base (Rift's registry, read only) as a workspace, a copy made on a copy with that one as its parent; it moves no file, and a second run adopts nothing."
	case ListOp:
		"List is every workspace of the base; with -status, each active one's commits against its parent's default branch, whether it has a change and its last commit (LaneStatus), by read-only Git calls."
	case RmOp:
		"Rm moves a workspace to the trash."
	case GcOp:
		"Gc deletes the trash of this base (never another's) and the workspaces whose clone never ended, and names each; -idle removes the idle workspaces whose work is held first, and reports the rest. -dry lists eligible paths without deleting them (not with -idle or -archive)."
	case PinOp:
		"Pin keeps a workspace from gc -idle: a pinned one is never removed as idle. It is the workspace pinned."
	case UnpinOp:
		"Unpin lets gc -idle take the workspace again."
	case DuOp:
		"Du is the bytes each live workspace takes, exclusive and shared."
	case ReadyOp:
		"Ready snapshots the workspace and hands its branch (fast-forward only) and the snapshot to the parent's repository; it changes no file of the parent and never pushes to origin. With -request FILE, the record ready writes (work record) takes the request's digest and its work-record block."
	case RecordOp:
		"Record is the lane record ready wrote for the commit tip (HEAD too), read in the workspace the working folder is in, else the base."
	case SyncOp:
		"Sync merges the parent's branch into the workspace's (Git's merge) and records the parent's commit as its base; it is that commit."
	case EnvOp:
		"Env is the shell lines of work.toml's env for the workspace, for eval \"$(ergo work env)\"."
	case MergeFileOp:
		"MergeFile is a Git merge driver (merge.<name>.driver = work merge-file -path %P CLASS %O %A %B): it merges the files ours and theirs against base by the units of the class (rows, measured, lines, derived, json; auto takes the class of -path from work.toml's [[class]] lines and the lock presets) and writes the merge into ours. A conflict fails, so the driver ends with status 1 and Git keeps the file conflicted."
	case MergeFoldersOp:
		"MergeFolders merges the files under ours and theirs against those under base (three folders, each a tree) into the folder out, each path by its class as merge-file auto takes it, a [language.NAME]'s files with one start of its plugin for all their sides and one for the merges cut again; then, when nothing conflicts, makes the derived files again there."
	case DeriveOp:
		"Derive makes the derived files again (each derived class line's command, a lock by its package manager) in the workspace, or the base, after a merge."
	case DepsOp:
		"Deps installs the workspace's packages ([deps] of work.toml) when its lock file changed since its last install, and starts no process when it did not."
	case TrustOp:
		"Trust allows the commands work.toml runs (its hooks and install): until then no hook and no install runs."
	case DoctorOp:
		"Doctor reports on the base: the clone providers, the file system, whether a purge is one call, a stale index, the trust; with -rift, the base's Rift copies no workspace holds yet; the checkouts whose merge drivers are missing (with -here, only the one it runs in), which -fix registers."
	case PluginTestOp:
		"PluginTest runs the laws of the language contracts against a plugin (a command, or the [language.NAME] it names) on the base's files, and refuses it with the law it broke."
	case RefreshOp:
		"Refresh refreshes the stat data of the base's Git index, so that a clone starts fresh; it is the number of stale entries it had."
	case CloneOp:
		"Clone clones the folder src to dst, which must be absent with its parent there, as new clones a workspace but with no base, registry, lock, hook or record: every entry not left out, links as links, nothing written in src or outside dst. A plain copy where no Cloner can share blocks is an answer (cloner copy), measured for room before it writes; a failure leaves no dst."
	case BasesOp:
		"Bases is every base init registered on this host whose folder is there."
	case ForgetBaseOp:
		"ForgetBase drops base from the list of bases; its folder and its workspaces stay. It is the bases still registered."
	case PruneBasesOp:
		"PruneBases forgets every base whose folder is gone; it is the bases it forgot."
	case ShellInitOp:
		"ShellInit is a shell function for eval \"$(work shell-init)\": work new changes to the new workspace."
	case ImportRiftOp:
		"ImportRift is the work.toml of a .rift.toml (Rift's hooks); it writes nothing."
	}
}

func valueOf(text string) json.Value {
	json.Decode(json.Codec[json.Value]{MaxBytes: 0, MaxDepth: 0}, text) catch {
	case _:
		json.Null
	}
}

// Schema is the JSON schema of op's arguments: an object whose keys are
// its parameters' JSON keys, or the fields of its one record parameter.
func Schema(op Op) json.Value {
	match op {
	case VersionOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case InitOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case NewOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"o\":{\"type\":\"object\",\"properties\":{\"copy\":{\"type\":\"boolean\"},\"from\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"branch\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"on\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"token\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"copy\",\"from\",\"branch\",\"on\",\"token\"]}},\"required\":[\"name\",\"o\"]}")
	case AdoptOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"dir\":{\"type\":\"string\"},\"o\":{\"type\":\"object\",\"properties\":{\"name\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"name\"]}},\"required\":[\"dir\",\"o\"]}")
	case AdoptRiftOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"registry\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"registry\"]}")
	case ListOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"boolean\"}},\"required\":[\"status\"]}")
	case RmOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"o\":{\"type\":\"object\",\"properties\":{\"abandon\":{\"type\":\"boolean\"},\"expect\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"tree\":{\"type\":\"boolean\"}},\"required\":[\"abandon\",\"expect\",\"tree\"]}},\"required\":[\"name\",\"o\"]}")
	case GcOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"older\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"id\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"idle\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"archive\":{\"type\":\"boolean\"},\"dry\":{\"type\":\"boolean\"}},\"required\":[\"older\",\"id\",\"idle\",\"archive\",\"dry\"]}")
	case PinOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]}")
	case UnpinOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]}")
	case DuOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case ReadyOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"request\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"name\",\"request\"]}")
	case RecordOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"tip\":{\"type\":\"string\"}},\"required\":[\"tip\"]}")
	case SyncOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"name\"]}")
	case EnvOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"name\"]}")
	case MergeFileOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"class\":{\"type\":\"string\"},\"base\":{\"type\":\"string\"},\"ours\":{\"type\":\"string\"},\"theirs\":{\"type\":\"string\"},\"o\":{\"type\":\"object\",\"properties\":{\"path\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"path\"]}},\"required\":[\"class\",\"base\",\"ours\",\"theirs\",\"o\"]}")
	case MergeFoldersOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"base\":{\"type\":\"string\"},\"ours\":{\"type\":\"string\"},\"theirs\":{\"type\":\"string\"},\"out\":{\"type\":\"string\"}},\"required\":[\"base\",\"ours\",\"theirs\",\"out\"]}")
	case DeriveOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"name\"]}")
	case DepsOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"name\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"name\"]}")
	case TrustOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case DoctorOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"rift\":{\"type\":\"boolean\"},\"registry\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"unguard\":{\"type\":\"boolean\"},\"fix\":{\"type\":\"boolean\"},\"here\":{\"type\":\"boolean\"},\"repair\":{\"type\":\"boolean\"}},\"required\":[\"rift\",\"registry\",\"unguard\",\"fix\",\"here\",\"repair\"]}")
	case PluginTestOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"o\":{\"type\":\"object\",\"properties\":{\"files\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"max\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]},\"seed\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"integer\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"files\",\"max\",\"seed\"]}},\"required\":[\"command\",\"o\"]}")
	case RefreshOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case CloneOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"src\":{\"type\":\"string\"},\"dst\":{\"type\":\"string\"},\"o\":{\"type\":\"object\",\"properties\":{\"leaveOut\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"leaveOut\"]}},\"required\":[\"src\",\"dst\",\"o\"]}")
	case BasesOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case ForgetBaseOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"base\":{\"type\":\"string\"}},\"required\":[\"base\"]}")
	case PruneBasesOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case ShellInitOp:
		valueOf("{\"type\":\"object\",\"properties\":{}}")
	case ImportRiftOp:
		valueOf("{\"type\":\"object\",\"properties\":{\"file\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"Some\"},\"value\":{\"type\":\"string\"}},\"required\":[\"_tag\",\"value\"]},{\"type\":\"object\",\"properties\":{\"_tag\":{\"const\":\"None\"}},\"required\":[\"_tag\"]}]}},\"required\":[\"file\"]}")
	}
}

// Call answers r on the bound work.Api: the operation's value as its
// Reply, or its typed failure as its Failure. It fails nothing.
func Call(r Request) Outcome needs work.Api {
	match r {
	case VersionRequest:
		let v = work.Api.Version()
		Done{Reply: VersionReply{Value: v}}
	case InitRequest:
		let v = work.Api.Init() catch {
		case work.Unkept as e:
			return Rejected{Failure: Unkept{E: e}}
		case work.BadConfig as e:
			return Rejected{Failure: BadConfig{E: e}}
		case fs.Denied as e:
			return Rejected{Failure: Denied{E: e}}
		case fs.Failed as e:
			return Rejected{Failure: Failed{E: e}}
		}
		Done{Reply: InitReply{Value: v}}
	case NewRequest as x:
		let v = work.Api.New(x.Name, x.O) catch {
		case work.HookFailed as e:
			return Rejected{Failure: HookFailed{E: e}}
		case work.Missing as e:
			return Rejected{Failure: Missing{E: e}}
		case work.CloneFailed as e:
			return Rejected{Failure: CloneFailed{E: e}}
		case work.Unkept as e:
			return Rejected{Failure: Unkept{E: e}}
		case work.Locked as e:
			return Rejected{Failure: Locked{E: e}}
		case work.BadConfig as e:
			return Rejected{Failure: BadConfig{E: e}}
		case work.NoBase as e:
			return Rejected{Failure: NoBase{E: e}}
		case work.BadName as e:
			return Rejected{Failure: BadName{E: e}}
		case work.NameTaken as e:
			return Rejected{Failure: NameTaken{E: e}}
		case work.NoWorkspace as e:
			return Rejected{Failure: NoWorkspace{E: e}}
		case work.NoRevision as e:
			return Rejected{Failure: NoRevision{E: e}}
		case work.Diverged as e:
			return Rejected{Failure: Diverged{E: e}}
		case work.CopyRefused as e:
			return Rejected{Failure: CopyRefused{E: e}}
		case work.NotSameVolume as e:
			return Rejected{Failure: NotSameVolume{E: e}}
		case work.Unsupported as e:
			return Rejected{Failure: Unsupported{E: e}}
