	}
}

// ClientInForce is the work.Api that invokes the provider currently in force.
func ClientInForce() Client needs work.Api {
	let held = InForce[work.Api]()
	Client{
		opVersion:      func() string { with held { work.Api.Version() } },
		opInit:         func() string fails work.Unkept | work.BadConfig | fs.Denied | fs.Failed { with held { try work.Api.Init() } },
		opNew:          func(name string, o work.NewOptions) work.Created fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.BadName | work.NameTaken | work.NoWorkspace | work.NoRevision | work.Diverged | work.CopyRefused | work.NotSameVolume | work.Unsupported | work.Exists | work.NoSpace | work.VcsFailed | work.Busy { with held { try work.Api.New(name, o) } },
