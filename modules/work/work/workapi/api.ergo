				match g.Failure {
				case HookFailed as err:
					return err.E
				case Missing as err:
					return err.E
				case CloneFailed as err:
					return err.E
				case Unkept as err:
					return err.E
				case Locked as err:
					return err.E
				case BadConfig as err:
					return err.E
				case NoBase as err:
					return err.E
				case BadName as err:
					return err.E
				case NameTaken as err:
					return err.E
				case NoWorkspace as err:
					return err.E
				case NoRevision as err:
					return err.E
				case Diverged as err:
					return err.E
				case CopyRefused as err:
					return err.E
				case NotSameVolume as err:
					return err.E
				case Unsupported as err:
					return err.E
				case Exists as err:
