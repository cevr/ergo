// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Init string, New work.Created, Adopt work.Workspace, AdoptRift work.RiftAdopted, List []work.Workspace, Rm []work.Removed, Gc work.Collected, Pin work.Workspace, Unpin work.Workspace, Du []work.Space, Ready work.Handed, Sync work.Synced, Env string, MergeFile work.FileMerged, MergeFolders work.TreeMerged, Derive work.Derived, Deps work.DepsDone, Trust work.Trusted, Doctor work.Report, PluginTest work.PluginAdmitted, Refresh int, Bases []string, ForgetBase []string, PruneBases []string, ShellInit string, ImportRift string }

// inRow reports whether f is a failure of op's row.
func inRow(op Op, f Failure) bool {
	match op {
	case InitOp:
		match f {
		case BadConfig, Unkept, Denied, Failed:
			true
		case _:
			false
		}
	case NewOp:
		match f {
		case HookFailed, BadConfig, Unkept, NoBase, BadName, NameTaken, NoWorkspace, NoRevision, Diverged, CopyRefused, NotSameVolume, Unsupported, Exists, Missing, NoSpace, CloneFailed, VcsFailed, Locked, Busy:
			true
		case _:
			false
		}
	case AdoptOp:
		match f {
		case Unkept, NoBase, BadName, NameTaken, Missing, VcsFailed, Locked:
			true
		case _:
			false
		}
	case AdoptRiftOp:
		match f {
		case Unkept, NoBase, VcsFailed, Locked, RiftUnread:
			true
		case _:
			false
		}
	case ListOp:
		match f {
		case Unkept, NoBase:
			true
		case _:
			false
		}
	case RmOp:
		match f {
		case HookFailed, BadConfig, Unkept, NoBase, NoWorkspace, Exists, Missing, CloneFailed, VcsFailed, Locked, Busy, NotHeld, IdMismatch, HasDescendants:
			true
		case _:
			false
		}
	case GcOp:
		match f {
		case HookFailed, BadConfig, Unkept, NoBase, NoWorkspace, Exists, Missing, CloneFailed, VcsFailed, Locked, BadAge:
			true
		case _:
			false
		}
	case PinOp:
		match f {
		case Unkept, NoBase, NoWorkspace, Locked:
			true
		case _:
			false
		}
	case UnpinOp:
		match f {
		case Unkept, NoBase, NoWorkspace, Locked:
			true
		case _:
			false
		}
	case DuOp:
		match f {
		case Unkept, NoBase, Unsupported, Missing, CloneFailed:
			true
		case _:
			false
		}
	case ReadyOp:
		match f {
		case Unkept, NoBase, NoWorkspace, VcsFailed, Locked, Busy, NotHere, Detached, NotFastForward, Moved:
			true
		case _:
			false
		}
	case SyncOp:
		match f {
		case BadConfig, Unkept, NoBase, NoWorkspace, VcsFailed, Locked, Busy, NotHere, Detached, Dirty, Conflicted:
			true
		case _:
			false
		}
	case EnvOp:
		match f {
		case BadConfig, Unkept, NoBase, NoWorkspace, NotHere:
			true
		case _:
			false
		}
	case MergeFileOp:
		match f {
		case BadConfig, Denied, Failed, BadClass, MergeConflict, NotFound:
			true
		case _:
			false
		}
	case MergeFoldersOp:
		match f {
		case Untrusted, BadConfig, Denied, Failed, NotFound, DeriveFailed:
			true
		case _:
			false
		}
	case DeriveOp:
		match f {
		case Untrusted, BadConfig, Unkept, NoBase, NoWorkspace, NotHere, DeriveFailed:
			true
		case _:
			false
		}
	case DepsOp:
		match f {
		case Untrusted, DepsFailed, BadConfig, Unkept, NoBase, NoWorkspace, Locked, NotHere:
			true
		case _:
			false
		}
	case TrustOp:
		match f {
		case BadConfig, Unkept, Denied, Failed, NoBase, NotFound:
			true
		case _:
			false
		}
	case DoctorOp:
		match f {
		case BadConfig, Unkept, NoBase, VcsFailed, RiftUnread:
			true
		case _:
			false
		}
	case PluginTestOp:
		match f {
		case Untrusted, BadConfig, NoBase, VcsFailed, PluginRefused:
			true
		case _:
			false
		}
	case RefreshOp:
		match f {
		case Unkept, NoBase, VcsFailed:
			true
		case _:
			false
		}
	case BasesOp:
		match f {
		case Unkept:
			true
		case _:
			false
		}
	case ForgetBaseOp:
		match f {
		case Unkept, Denied, Failed:
			true
		case _:
			false
		}
	case PruneBasesOp:
		match f {
		case Unkept, Denied, Failed:
			true
		case _:
			false
		}
	case ImportRiftOp:
		match f {
		case BadConfig, Denied, Failed, NotFound:
			true
		case _:
			false
		}
	case ShellInitOp:
		false
	}
}

// answerOf is the Outcome of r's operation: f when failing and f is in
// its row, else its value from v.
func answerOf(r Request, v Values, f Failure, failing bool) Outcome {
	if failing && inRow(OpOf(r), f) {
		return Rejected{Failure: f}
	}
	match r {
	case InitRequest:
		Done{Reply: InitReply{Value: v.Init}}
	case NewRequest:
		Done{Reply: NewReply{Value: v.New}}
	case AdoptRequest:
		Done{Reply: AdoptReply{Value: v.Adopt}}
	case AdoptRiftRequest:
		Done{Reply: AdoptRiftReply{Value: v.AdoptRift}}
	case ListRequest:
		Done{Reply: ListReply{Value: v.List}}
	case RmRequest:
		Done{Reply: RmReply{Value: v.Rm}}
	case GcRequest:
		Done{Reply: GcReply{Value: v.Gc}}
	case PinRequest:
		Done{Reply: PinReply{Value: v.Pin}}
	case UnpinRequest:
		Done{Reply: UnpinReply{Value: v.Unpin}}
	case DuRequest:
		Done{Reply: DuReply{Value: v.Du}}
	case ReadyRequest:
		Done{Reply: ReadyReply{Value: v.Ready}}
	case SyncRequest:
		Done{Reply: SyncReply{Value: v.Sync}}
	case EnvRequest:
		Done{Reply: EnvReply{Value: v.Env}}
	case MergeFileRequest:
		Done{Reply: MergeFileReply{Value: v.MergeFile}}
	case MergeFoldersRequest:
		Done{Reply: MergeFoldersReply{Value: v.MergeFolders}}
	case DeriveRequest:
		Done{Reply: DeriveReply{Value: v.Derive}}
	case DepsRequest:
		Done{Reply: DepsReply{Value: v.Deps}}
	case TrustRequest:
		Done{Reply: TrustReply{Value: v.Trust}}
	case DoctorRequest:
		Done{Reply: DoctorReply{Value: v.Doctor}}
	case PluginTestRequest:
		Done{Reply: PluginTestReply{Value: v.PluginTest}}
	case RefreshRequest:
		Done{Reply: RefreshReply{Value: v.Refresh}}
	case BasesRequest:
		Done{Reply: BasesReply{Value: v.Bases}}
	case ForgetBaseRequest:
		Done{Reply: ForgetBaseReply{Value: v.ForgetBase}}
	case PruneBasesRequest:
		Done{Reply: PruneBasesReply{Value: v.PruneBases}}
	case ShellInitRequest:
		Done{Reply: ShellInitReply{Value: v.ShellInit}}
	case ImportRiftRequest:
		Done{Reply: ImportRiftReply{Value: v.ImportRift}}
	}
}

// scripted is a work.Api that keeps each Request it is sent and answers
// want.
func scripted(want Outcome, sent sync.Ref[[]Request]) Client {
	NewClient(func(q Request) Outcome {
		sent.Update(func(rs []Request) []Request { rs.Append(q) })
		want
	})
}

// CallIsTheOperation: Call(r) calls r's operation once, with r's
// arguments, and answers its value or failure as r's own Outcome.
law CallIsTheOperation(r Request, v Values, f Failure, failing bool) {
	let want = answerOf(r, v, f, failing)
	let sent = sync.NewRef[[]Request]([]Request{})
	let got = with context { work.Api: scripted(want, sent) } { Call(r) }
	got == want && sent.Get() == []Request{r}
}

// ClientIsCall: a Client whose send is Call answers each call as the
// provider Call is bound to does.
law ClientIsCall(r Request, v Values, f Failure, failing bool) {
	let want = answerOf(r, v, f, failing)
	let sent = sync.NewRef[[]Request]([]Request{})
	let inner = scripted(want, sent)
	let outer = NewClient(func(q Request) Outcome {
		with context { work.Api: inner } { Call(q) }
	})
	let got = with context { work.Api: outer } { Call(r) }
	got == want && sent.Get() == []Request{r}
}
