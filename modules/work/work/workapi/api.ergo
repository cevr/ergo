// Values holds a value of each operation's value type, so a law can
// answer any operation.
type Values { Version string, Init string, New work.Created, Adopt work.Workspace, AdoptRift work.RiftAdopted, List []work.Listed, Rm []work.Removed, Gc work.Collected, Pin work.Workspace, Unpin work.Workspace, Du []work.Space, Ready work.Handed, Record work.LaneRecord, Sync work.Synced, Env string, MergeFile work.FileMerged, MergeFolders work.TreeMerged, Derive work.Derived, Deps work.DepsDone, Trust work.Trusted, Doctor work.Report, PluginTest work.PluginAdmitted, Refresh int, Clone work.TreeCloned, Bases []string, ForgetBase []string, PruneBases []string, ShellInit string, ImportRift string }

func inRow(op Op, f Failure) bool {
	match op {
	case InitOp:
		match f {
		case Unkept, BadConfig, Denied, Failed:
			true
		case _:
			false
		}
	case NewOp:
		match f {
		case HookFailed, Missing, CloneFailed, Unkept, Locked, BadConfig, NoBase, BadName, NameTaken, NoWorkspace, NoRevision, Diverged, CopyRefused, NotSameVolume, Unsupported, Exists, NoSpace, VcsFailed, Busy:
			true
		case _:
			false
		}
	case AdoptOp:
		match f {
		case Missing, Unkept, Locked, NoBase, BadName, NameTaken, VcsFailed:
			true
		case _:
			false
		}
	case AdoptRiftOp:
		match f {
		case Unkept, Locked, NoBase, VcsFailed, RiftUnread:
			true
		case _:
			false
		}
	case ListOp:
		match f {
		case Unkept, NoBase:
			true
		case _:
			false
		}
	case RmOp:
		match f {
		case HookFailed, Missing, CloneFailed, Unkept, Locked, BadConfig, NoBase, NoWorkspace, Exists, VcsFailed, Busy, NotHeld, IdMismatch, HasDescendants:
			true
		case _:
			false
		}
	case GcOp:
		match f {
		case HookFailed, Missing, CloneFailed, Unkept, Locked, BadConfig, NoBase, NoWorkspace, Exists, VcsFailed, BadAge, BadRequest, GcFailed:
			true
		case _:
			false
		}
	case PinOp:
		match f {
		case Unkept, Locked, NoBase, NoWorkspace:
			true
		case _:
			false
		}
	case UnpinOp:
		match f {
		case Unkept, Locked, NoBase, NoWorkspace:
			true
		case _:
			false
		}
	case DuOp:
		match f {
		case Missing, CloneFailed, Unkept, NoBase, Unsupported:
			true
		case _:
			false
		}
	case ReadyOp:
		match f {
		case Unkept, Locked, NoBase, NoWorkspace, VcsFailed, Busy, BadRequest, NotHere, Detached, NotFastForward, Moved:
			true
		case _:
			false
		}
	case RecordOp:
		match f {
		case Unkept, NoBase, NoRevision, VcsFailed, NoRecord, BadRecord:
			true
		case _:
			false
		}
	case SyncOp:
		match f {
		case Unkept, Locked, BadConfig, NoBase, NoWorkspace, VcsFailed, Busy, NotHere, Detached, Dirty, Conflicted:
			true
		case _:
			false
		}
	case EnvOp:
		match f {
		case Unkept, BadConfig, NoBase, NoWorkspace, NotHere:
			true
		case _:
			false
		}
	case MergeFileOp:
		match f {
		case BadConfig, Denied, Failed, BadClass, MergeConflict, NotFound:
			true
		case _:
			false
		}
	case MergeFoldersOp:
		match f {
		case Untrusted, BadConfig, Denied, Failed, NotFound, DeriveFailed:
			true
		case _:
			false
		}
	case DeriveOp:
		match f {
		case Untrusted, Unkept, BadConfig, NoBase, NoWorkspace, NotHere, DeriveFailed:
			true
		case _:
			false
		}
	case DepsOp:
		match f {
		case Untrusted, DepsFailed, Unkept, Locked, BadConfig, NoBase, NoWorkspace, NotHere:
			true
		case _:
			false
		}
	case TrustOp:
		match f {
		case Unkept, BadConfig, Denied, Failed, NoBase, NotFound:
			true
		case _:
			false
		}
	case DoctorOp:
		match f {
		case Unkept, Locked, BadConfig, NoBase, VcsFailed, RiftUnread:
			true
		case _:
			false
		}
	case PluginTestOp:
		match f {
		case Untrusted, BadConfig, NoBase, VcsFailed, PluginRefused:
			true
		case _:
			false
		}
	case RefreshOp:
		match f {
		case Unkept, NoBase, VcsFailed:
			true
		case _:
			false
		}
	case CloneOp:
		match f {
		case Missing, CloneFailed, BadConfig, Unsupported, Exists, NoSpace:
			true
		case _:
			false
		}
	case BasesOp:
		match f {
		case Unkept:
			true
		case _:
			false
		}
	case ForgetBaseOp:
		match f {
		case Unkept, Denied, Failed:
			true
		case _:
			false
		}
	case PruneBasesOp:
		match f {
		case Unkept, Denied, Failed:
			true
		case _:
			false
		}
	case ImportRiftOp:
		match f {
		case BadConfig, Denied, Failed, NotFound:
			true
		case _:
			false
		}
	case VersionOp, ShellInitOp:
		false
	}
}

// Given is what a law gives a call: a value of each operation's value
// type, a failure, and whether the call fails with it.
type Given { Values Values, Failure Failure, Failing bool }

// OutcomeOf is the Outcome g gives r: its failure when g fails and the
// failure is in the row of r's operation, else the operation's value
// from g. It is always an Outcome r's operation can have.
func OutcomeOf(r Request, g Given) Outcome {
	if g.Failing && inRow(OpOf(r), g.Failure) {
		return Rejected{Failure: g.Failure}
	}
	match r {
	case VersionRequest:
		Done{Reply: VersionReply{Value: g.Values.Version}}
	case InitRequest:
		Done{Reply: InitReply{Value: g.Values.Init}}
	case NewRequest:
		Done{Reply: NewReply{Value: g.Values.New}}
	case AdoptRequest:
		Done{Reply: AdoptReply{Value: g.Values.Adopt}}
	case AdoptRiftRequest:
		Done{Reply: AdoptRiftReply{Value: g.Values.AdoptRift}}
	case ListRequest:
		Done{Reply: ListReply{Value: g.Values.List}}
	case RmRequest:
		Done{Reply: RmReply{Value: g.Values.Rm}}
	case GcRequest:
		Done{Reply: GcReply{Value: g.Values.Gc}}
	case PinRequest:
		Done{Reply: PinReply{Value: g.Values.Pin}}
	case UnpinRequest:
		Done{Reply: UnpinReply{Value: g.Values.Unpin}}
	case DuRequest:
		Done{Reply: DuReply{Value: g.Values.Du}}
	case ReadyRequest:
		Done{Reply: ReadyReply{Value: g.Values.Ready}}
	case RecordRequest:
		Done{Reply: RecordReply{Value: g.Values.Record}}
	case SyncRequest:
		Done{Reply: SyncReply{Value: g.Values.Sync}}
	case EnvRequest:
		Done{Reply: EnvReply{Value: g.Values.Env}}
	case MergeFileRequest:
		Done{Reply: MergeFileReply{Value: g.Values.MergeFile}}
	case MergeFoldersRequest:
		Done{Reply: MergeFoldersReply{Value: g.Values.MergeFolders}}
	case DeriveRequest:
		Done{Reply: DeriveReply{Value: g.Values.Derive}}
	case DepsRequest:
		Done{Reply: DepsReply{Value: g.Values.Deps}}
	case TrustRequest:
		Done{Reply: TrustReply{Value: g.Values.Trust}}
	case DoctorRequest:
		Done{Reply: DoctorReply{Value: g.Values.Doctor}}
	case PluginTestRequest:
		Done{Reply: PluginTestReply{Value: g.Values.PluginTest}}
	case RefreshRequest:
		Done{Reply: RefreshReply{Value: g.Values.Refresh}}
	case CloneRequest:
		Done{Reply: CloneReply{Value: g.Values.Clone}}
	case BasesRequest:
		Done{Reply: BasesReply{Value: g.Values.Bases}}
	case ForgetBaseRequest:
		Done{Reply: ForgetBaseReply{Value: g.Values.ForgetBase}}
	case PruneBasesRequest:
		Done{Reply: PruneBasesReply{Value: g.Values.PruneBases}}
	case ShellInitRequest:
		Done{Reply: ShellInitReply{Value: g.Values.ShellInit}}
	case ImportRiftRequest:
		Done{Reply: ImportRiftReply{Value: g.Values.ImportRift}}
	}
}

func scripted(g Given, sent sync.Ref[[]Request]) Client {
	Client{
		opVersion: func() string {
			sent.Update(func(rs []Request) []Request { rs.Append(VersionRequest) })
			g.Values.Version
		},
		opInit: func() string fails work.Unkept | work.BadConfig | fs.Denied | fs.Failed {
			sent.Update(func(rs []Request) []Request { rs.Append(InitRequest) })
			if g.Failing {
				match g.Failure {
				case Unkept as err:
					return err.E
				case BadConfig as err:
					return err.E
				case Denied as err:
					return err.E
				case Failed as err:
					return err.E
				case _:
				}
			}
			g.Values.Init
		},
		opNew: func(name string, o work.NewOptions) work.Created fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.BadName | work.NameTaken | work.NoWorkspace | work.NoRevision | work.Diverged | work.CopyRefused | work.NotSameVolume | work.Unsupported | work.Exists | work.NoSpace | work.VcsFailed | work.Busy {
			sent.Update(func(rs []Request) []Request { rs.Append(NewRequest{Name: name, O: o}) })
