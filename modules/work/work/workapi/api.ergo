		opPluginTest: func(command string, o work.PluginTestOptions) work.PluginAdmitted fails work.Untrusted | work.BadConfig | work.NoBase | work.VcsFailed | work.PluginRefused {
			sent.Update(func(rs []Request) []Request { rs.Append(PluginTestRequest{Command: command, O: o}) })
			if g.Failing {
				match g.Failure {
				case Untrusted as err:
