				case VcsFailed as err:
					return err.E
				case PluginRefused as err:
					return err.E
				case _:
				}
			}
			g.Values.PluginTest
		},
		opRefresh: func() int fails work.Unkept | work.NoBase | work.VcsFailed {
			sent.Update(func(rs []Request) []Request { rs.Append(RefreshRequest) })
			if g.Failing {
				match g.Failure {
				case Unkept as err:
					return err.E
				case NoBase as err:
					return err.E
				case VcsFailed as err:
					return err.E
				case _:
				}
			}
			g.Values.Refresh
		},
		opClone: func(src string, dst string, o work.CloneOptions) work.TreeCloned fails work.Missing | work.CloneFailed | work.BadConfig | work.Unsupported | work.Exists | work.NoSpace {
			sent.Update(func(rs []Request) []Request { rs.Append(CloneRequest{Src: src, Dst: dst, O: o}) })
			if g.Failing {
				match g.Failure {
				case Missing as err:
					return err.E
				case CloneFailed as err:
					return err.E
				case BadConfig as err:
					return err.E
				case Unsupported as err:
					return err.E
				case Exists as err:
					return err.E
				case NoSpace as err:
					return err.E
				case _:
				}
			}
			g.Values.Clone
		},
		opBases: func() []string fails work.Unkept {
			sent.Update(func(rs []Request) []Request { rs.Append(BasesRequest) })
			if g.Failing {
				match g.Failure {
				case Unkept as err:
					return err.E
				case _:
				}
			}
			g.Values.Bases
		},
		opForgetBase: func(base string) []string fails work.Unkept | fs.Denied | fs.Failed {
			sent.Update(func(rs []Request) []Request { rs.Append(ForgetBaseRequest{Base: base}) })
			if g.Failing {
				match g.Failure {
				case Unkept as err:
					return err.E
				case Denied as err:
					return err.E
				case Failed as err:
					return err.E
				case _:
				}
			}
			g.Values.ForgetBase
		},
		opPruneBases: func() []string fails work.Unkept | fs.Denied | fs.Failed {
			sent.Update(func(rs []Request) []Request { rs.Append(PruneBasesRequest) })
			if g.Failing {
				match g.Failure {
				case Unkept as err:
					return err.E
				case Denied as err:
					return err.E
				case Failed as err:
					return err.E
				case _:
				}
			}
			g.Values.PruneBases
		},
		opShellInit: func() string {
			sent.Update(func(rs []Request) []Request { rs.Append(ShellInitRequest) })
			g.Values.ShellInit
		},
		opImportRift: func(o work.ImportRiftOptions) string fails work.BadConfig | fs.Denied | fs.Failed | fs.NotFound {
			sent.Update(func(rs []Request) []Request { rs.Append(ImportRiftRequest{O: o}) })
			if g.Failing {
				match g.Failure {
				case BadConfig as err:
					return err.E
				case Denied as err:
					return err.E
				case Failed as err:
					return err.E
				case NotFound as err:
					return err.E
				case _:
				}
			}
			g.Values.ImportRift
		},
	}
}

func callChecked(client CheckedClient, r Request) Outcome fails rpc.Transport {
	match r {
	case VersionRequest:
		let v = VersionChecked(client) catch {
		case rpc.Transport as t:
			return t
		}
		Done{Reply: VersionReply{Value: v}}
	case InitRequest:
		let v = InitChecked(client) catch {
		case work.Unkept as e:
			return Rejected{Failure: Unkept{E: e}}
		case work.BadConfig as e:
			return Rejected{Failure: BadConfig{E: e}}
		case fs.Denied as e:
			return Rejected{Failure: Denied{E: e}}
		case fs.Failed as e:
			return Rejected{Failure: Failed{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: InitReply{Value: v}}
	case NewRequest as x:
		let v = NewChecked(client, x.Name, x.O) catch {
		case work.HookFailed as e:
			return Rejected{Failure: HookFailed{E: e}}
		case work.Missing as e:
			return Rejected{Failure: Missing{E: e}}
		case work.CloneFailed as e:
			return Rejected{Failure: CloneFailed{E: e}}
		case work.Unkept as e:
			return Rejected{Failure: Unkept{E: e}}
		case work.Locked as e:
			return Rejected{Failure: Locked{E: e}}
		case work.BadConfig as e:
			return Rejected{Failure: BadConfig{E: e}}
		case work.NoBase as e:
			return Rejected{Failure: NoBase{E: e}}
		case work.BadName as e:
			return Rejected{Failure: BadName{E: e}}
		case work.NameTaken as e:
			return Rejected{Failure: NameTaken{E: e}}
		case work.NoWorkspace as e:
			return Rejected{Failure: NoWorkspace{E: e}}
		case work.NoRevision as e:
			return Rejected{Failure: NoRevision{E: e}}
		case work.Diverged as e:
			return Rejected{Failure: Diverged{E: e}}
		case work.CopyRefused as e:
			return Rejected{Failure: CopyRefused{E: e}}
		case work.NotSameVolume as e:
			return Rejected{Failure: NotSameVolume{E: e}}
		case work.Unsupported as e:
			return Rejected{Failure: Unsupported{E: e}}
		case work.Exists as e:
			return Rejected{Failure: Exists{E: e}}
		case work.NoSpace as e:
			return Rejected{Failure: NoSpace{E: e}}
		case work.VcsFailed as e:
			return Rejected{Failure: VcsFailed{E: e}}
		case work.Busy as e:
			return Rejected{Failure: Busy{E: e}}
		case rpc.Transport as t:
			return t
		}
		Done{Reply: NewReply{Value: v}}
	case AdoptRequest as x:
		let v = AdoptChecked(client, x.Dir, x.O) catch {
		case work.Missing as e:
			return Rejected{Failure: Missing{E: e}}
		case work.Unkept as e:
			return Rejected{Failure: Unkept{E: e}}
		case work.Locked as e:
			return Rejected{Failure: Locked{E: e}}
		case work.NoBase as e:
			return Rejected{Failure: NoBase{E: e}}
		case work.BadName as e:
			return Rejected{Failure: BadName{E: e}}
		case work.NameTaken as e:
			return Rejected{Failure: NameTaken{E: e}}
		case work.VcsFailed as e:
			return Rejected{Failure: VcsFailed{E: e}}
