		opList:         func(o work.ListOptions) []work.Listed fails work.Unkept | work.NoBase { with held { try work.Api.List(o) } },
		opRm:           func(name string, o work.RmOptions) []work.Removed fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.Exists | work.VcsFailed | work.Busy | work.NotHeld | work.IdMismatch | work.HasDescendants { with held { try work.Api.Rm(name, o) } },
		opGc:           func(o work.GcOptions) work.Collected fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.Exists | work.VcsFailed | work.BadAge | work.BadRequest | work.GcFailed { with held { try work.Api.Gc(o) } },
		opPin:          func(name string) work.Workspace fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace { with held { try work.Api.Pin(name) } },
		opUnpin:        func(name string) work.Workspace fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace { with held { try work.Api.Unpin(name) } },
		opDu:           func() []work.Space fails work.Missing | work.CloneFailed | work.Unkept | work.NoBase | work.Unsupported { with held { try work.Api.Du() } },
		opReady:        func(o work.ReadyOptions) work.Handed fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace | work.VcsFailed | work.Busy | work.BadRequest | work.NotHere | work.Detached | work.NotFastForward | work.Moved { with held { try work.Api.Ready(o) } },
		opRecord:       func(tip string) work.LaneRecord fails work.Unkept | work.NoBase | work.NoRevision | work.VcsFailed | work.NoRecord | work.BadRecord { with held { try work.Api.Record(tip) } },
		opSync:         func(o work.SyncOptions) work.Synced fails work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.VcsFailed | work.Busy | work.NotHere | work.Detached | work.Dirty | work.Conflicted { with held { try work.Api.Sync(o) } },
		opEnv:          func(o work.EnvOptions) string fails work.Unkept | work.BadConfig | work.NoBase | work.NoWorkspace | work.NotHere { with held { try work.Api.Env(o) } },
		opMergeFile:    func(class string, base string, ours string, theirs string, o work.MergeFileOptions) work.FileMerged fails work.BadConfig | fs.Denied | fs.Failed | work.BadClass | work.MergeConflict | fs.NotFound { with held { try work.Api.MergeFile(class, base, ours, theirs, o) } },
		opMergeFolders: func(base string, ours string, theirs string, out string) work.TreeMerged fails work.Untrusted | work.BadConfig | fs.Denied | fs.Failed | fs.NotFound | work.DeriveFailed { with held { try work.Api.MergeFolders(base, ours, theirs, out) } },
		opDerive:       func(o work.DeriveOptions) work.Derived fails work.Untrusted | work.Unkept | work.BadConfig | work.NoBase | work.NoWorkspace | work.NotHere | work.DeriveFailed { with held { try work.Api.Derive(o) } },
		opDeps:         func(o work.DepsOptions) work.DepsDone fails work.Untrusted | work.DepsFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.NotHere { with held { try work.Api.Deps(o) } },
		opTrust:        func() work.Trusted fails work.Unkept | work.BadConfig | fs.Denied | fs.Failed | work.NoBase | fs.NotFound { with held { try work.Api.Trust() } },
