// Client provides work.Api over send, any way to carry a Request to a
// Call and its Outcome back. An Outcome that is not the operation's (the
// value of another, a failure outside its row) is a defect.
type Client { send func(r Request) Outcome } implements work.Api

// NewClient is the work.Api that send answers.
func NewClient(send own func(r Request) Outcome) Client { Client{send: send} }

// Init sends work.Api's Init and answers its Outcome.
func Init(client Client) string fails work.BadConfig | work.Unkept | fs.Denied | fs.Failed {
	match client.send(InitRequest) {
	case Done as done:
		match done.Reply {
		case InitReply as reply:
			reply.Value
		case _:
			Unreachable("workapi: Init was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case BadConfig as failure:
			return failure.E
		case Unkept as failure:
			return failure.E
		case Denied as failure:
			return failure.E
		case Failed as failure:
			return failure.E
		case _:
			Unreachable("workapi: Init was answered with a failure outside its row")
		}
	}
}

// New sends work.Api's New and answers its Outcome.
func New(client Client, name string, o work.NewOptions) work.Created fails work.HookFailed | work.BadConfig | work.Unkept | work.NoBase | work.BadName | work.NameTaken | work.NoWorkspace | work.NoRevision | work.Diverged | work.CopyRefused | work.NotSameVolume | work.Unsupported | work.Exists | work.Missing | work.NoSpace | work.CloneFailed | work.VcsFailed | work.Locked | work.Busy {
	match client.send(NewRequest{Name: name, O: o}) {
	case Done as done:
		match done.Reply {
		case NewReply as reply:
			reply.Value
		case _:
			Unreachable("workapi: New was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case HookFailed as failure:
			return failure.E
		case BadConfig as failure:
			return failure.E
		case Unkept as failure:
			return failure.E
		case NoBase as failure:
			return failure.E
		case BadName as failure:
			return failure.E
		case NameTaken as failure:
			return failure.E
		case NoWorkspace as failure:
			return failure.E
		case NoRevision as failure:
			return failure.E
		case Diverged as failure:
			return failure.E
		case CopyRefused as failure:
			return failure.E
		case NotSameVolume as failure:
			return failure.E
		case Unsupported as failure:
			return failure.E
		case Exists as failure:
			return failure.E
		case Missing as failure:
			return failure.E
		case NoSpace as failure:
			return failure.E
		case CloneFailed as failure:
			return failure.E
		case VcsFailed as failure:
			return failure.E
		case Locked as failure:
			return failure.E
		case Busy as failure:
			return failure.E
		case _:
			Unreachable("workapi: New was answered with a failure outside its row")
		}
	}
}

