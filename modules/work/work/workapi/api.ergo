		match done.Reply {
		case DuReply as reply:
			reply.Value
		case _:
			Unreachable("workapi: Du was answered with the value of another operation")
		}
	case Rejected as rejected:
		match rejected.Failure {
		case Unkept as failure:
			return failure.E
		case NoBase as failure:
			return failure.E
		case Unsupported as failure:
			return failure.E
		case Missing as failure:
			return failure.E
		case CloneFailed as failure:
			return failure.E
		case _:
			Unreachable("workapi: Du was answered with a failure outside its row")
		}
	}
}

