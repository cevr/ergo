// Client provides work.Api by invoking typed per-operation handlers directly:
// a direct call returns its exact value or declared failure row with no Outcome boxing.
type Client { opVersion func() string, opInit func() string fails work.Unkept | work.BadConfig | fs.Denied | fs.Failed, opNew func(string, work.NewOptions) work.Created fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.BadName | work.NameTaken | work.NoWorkspace | work.NoRevision | work.Diverged | work.CopyRefused | work.NotSameVolume | work.Unsupported | work.Exists | work.NoSpace | work.VcsFailed | work.Busy, opAdopt func(string, work.AdoptOptions) work.Workspace fails work.Missing | work.Unkept | work.Locked | work.NoBase | work.BadName | work.NameTaken | work.VcsFailed, opAdoptRift func(work.RiftOptions) work.RiftAdopted fails work.Unkept | work.Locked | work.NoBase | work.VcsFailed | work.RiftUnread, opList func(work.ListOptions) []work.Listed fails work.Unkept | work.NoBase, opRm func(string, work.RmOptions) []work.Removed fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.Exists | work.VcsFailed | work.Busy | work.NotHeld | work.IdMismatch | work.HasDescendants, opGc func(work.GcOptions) work.Collected fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.Exists | work.VcsFailed | work.BadAge | work.BadRequest | work.GcFailed, opPin func(string) work.Workspace fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace, opUnpin func(string) work.Workspace fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace, opDu func() []work.Space fails work.Missing | work.CloneFailed | work.Unkept | work.NoBase | work.Unsupported, opReady func(work.ReadyOptions) work.Handed fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace | work.VcsFailed | work.Busy | work.BadRequest | work.NotHere | work.Detached | work.NotFastForward | work.Moved, opRecord func(string) work.LaneRecord fails work.Unkept | work.NoBase | work.NoRevision | work.VcsFailed | work.NoRecord | work.BadRecord, opSync func(work.SyncOptions) work.Synced fails work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.VcsFailed | work.Busy | work.NotHere | work.Detached | work.Dirty | work.Conflicted, opEnv func(work.EnvOptions) string fails work.Unkept | work.BadConfig | work.NoBase | work.NoWorkspace | work.NotHere, opMergeFile func(string, string, string, string, work.MergeFileOptions) work.FileMerged fails work.BadConfig | fs.Denied | fs.Failed | work.BadClass | work.MergeConflict | fs.NotFound, opMergeFolders func(string, string, string, string) work.TreeMerged fails work.Untrusted | work.BadConfig | fs.Denied | fs.Failed | fs.NotFound | work.DeriveFailed, opDerive func(work.DeriveOptions) work.Derived fails work.Untrusted | work.Unkept | work.BadConfig | work.NoBase | work.NoWorkspace | work.NotHere | work.DeriveFailed, opDeps func(work.DepsOptions) work.DepsDone fails work.Untrusted | work.DepsFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.NotHere, opTrust func() work.Trusted fails work.Unkept | work.BadConfig | fs.Denied | fs.Failed | work.NoBase | fs.NotFound, opDoctor func(work.DoctorOptions) work.Report fails work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.VcsFailed | work.RiftUnread, opPluginTest func(string, work.PluginTestOptions) work.PluginAdmitted fails work.Untrusted | work.BadConfig | work.NoBase | work.VcsFailed | work.PluginRefused, opRefresh func() int fails work.Unkept | work.NoBase | work.VcsFailed, opClone func(string, string, work.CloneOptions) work.TreeCloned fails work.Missing | work.CloneFailed | work.BadConfig | work.Unsupported | work.Exists | work.NoSpace, opBases func() []string fails work.Unkept, opForgetBase func(string) []string fails work.Unkept | fs.Denied | fs.Failed, opPruneBases func() []string fails work.Unkept | fs.Denied | fs.Failed, opShellInit func() string, opImportRift func(work.ImportRiftOptions) string fails work.BadConfig | fs.Denied | fs.Failed | fs.NotFound } implements work.Api

// NewClient is the work.Api that invokes inner directly per operation.
func NewClient(inner work.Api) Client {
	Client{
		opVersion:      func() string { inner.Version() },
		opInit:         func() string fails work.Unkept | work.BadConfig | fs.Denied | fs.Failed { try inner.Init() },
		opNew:          func(name string, o work.NewOptions) work.Created fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.BadName | work.NameTaken | work.NoWorkspace | work.NoRevision | work.Diverged | work.CopyRefused | work.NotSameVolume | work.Unsupported | work.Exists | work.NoSpace | work.VcsFailed | work.Busy { try inner.New(name, o) },
		opAdopt:        func(dir string, o work.AdoptOptions) work.Workspace fails work.Missing | work.Unkept | work.Locked | work.NoBase | work.BadName | work.NameTaken | work.VcsFailed { try inner.Adopt(dir, o) },
		opAdoptRift:    func(o work.RiftOptions) work.RiftAdopted fails work.Unkept | work.Locked | work.NoBase | work.VcsFailed | work.RiftUnread { try inner.AdoptRift(o) },
		opList:         func(o work.ListOptions) []work.Listed fails work.Unkept | work.NoBase { try inner.List(o) },
		opRm:           func(name string, o work.RmOptions) []work.Removed fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.Exists | work.VcsFailed | work.Busy | work.NotHeld | work.IdMismatch | work.HasDescendants { try inner.Rm(name, o) },
		opGc:           func(o work.GcOptions) work.Collected fails work.HookFailed | work.Missing | work.CloneFailed | work.Unkept | work.Locked | work.BadConfig | work.NoBase | work.NoWorkspace | work.Exists | work.VcsFailed | work.BadAge | work.BadRequest | work.GcFailed { try inner.Gc(o) },
		opPin:          func(name string) work.Workspace fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace { try inner.Pin(name) },
		opUnpin:        func(name string) work.Workspace fails work.Unkept | work.Locked | work.NoBase | work.NoWorkspace { try inner.Unpin(name) },
		opDu:           func() []work.Space fails work.Missing | work.CloneFailed | work.Unkept | work.NoBase | work.Unsupported { try inner.Du() },
