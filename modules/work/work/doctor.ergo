import exec
import filepath
import fs
import json
import slices
import strings
import toml

// Report is what work doctor finds about a base: its storage, the
// Cloners tried in order and the one that made the last workspace, the
// file system and mount options of the base, whether a purge of a btrfs
// workspace is one call (the mount allows a user's subvolume delete),
// how many tracked files the base's Git index holds a stale stat of (each
// is read again by the next Git command in the base and in every clone),
// whether work.toml's commands are allowed, and what to do.
type Report {
	Base         string,
	Storage      string,
	Cloners      []string,
	LastCloner   string,
	FileSystem   string,
	PurgeOneCall bool,
	StaleIndex   int,
	Trusted      bool,
	Notes        []string,
	Rift         []string,
}

// DoctorOptions are doctor's flags: -rift lists the base's Rift copies
// that no workspace holds (in the registry -registry names, else
// Rift's own); -unguard drops the push guard an older adopt or
// adopt-rift wrote into an adopted workspace's remotes.
type DoctorOptions { Rift bool, Registry Option[string], Unguard bool }

// mountOf is the file system type and options of the mount that holds
// path, from /proc/mounts (the longest mount point that is a prefix); on
// a host with no such file (macOS), from mount(8)'s list (mountedOf);
// ("", "") when neither answers.
func mountOf(t Tool, path string) (string, string) {
	let text = t.files.ReadFile("/proc/mounts") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		let r = t.runner.Run(exec.New("mount", []string{})) catch {
		case exec.NotFound, exec.Denied, exec.Failed:
			return ("", "")
		}
		return if r.Status == 0 { mountedOf(r.Stdout, path) } else { ("", "") }
	}
	let abs = filepath.Clean(path)
	let mut best = ""
	let mut kind = ""
	let mut opts = ""
	for line in strings.Split(text, "\n") {
		let f = strings.Fields(line)
		if len(f) < 4 {
			continue
		}
		let at = f[1]
		let under = abs == at || at == "/" || strings.HasPrefix(abs, at+"/")
		if under && len(at) >= len(best) {
			best = at
			kind = f[2]
			opts = f[3]
		}
	}
	(kind, opts)
}

// mountedOf is the type and options of the mount that holds path in the
// list BSD's and macOS's mount(8) prints, a line a mount:
// "DEVICE on POINT (TYPE, OPTION, ...)", the point possibly with spaces;
// the options are given comma-separated, as /proc/mounts gives them.
func mountedOf(text string, path string) (string, string) {
	let abs = filepath.Clean(path)
	let mut best = ""
	let mut kind = ""
	let mut opts = ""
	for line in strings.Split(text, "\n") {
		let on = strings.Index(line, " on ")
		let paren = strings.LastIndex(line, " (")
		if on < 0 || paren < on+4 || !strings.HasSuffix(line, ")") {
			continue
		}
		let at = line[on+4 : paren]
		let parts = strings.Split(line[paren+2:len(line)-1], ", ")
		let under = abs == at || at == "/" || strings.HasPrefix(abs, at+"/")
		if under && len(at) >= len(best) {
			best = at
			kind = parts[0]
			opts = strings.Join(parts[1:], ",")
		}
	}
	(kind, opts)
}

// MacMountsNameAPFS: the smallest repro of the doctor that named no file
// system on a Mac (it read only /proc/mounts): mount(8)'s list, with a
// volume whose point has a space, gives the mount that holds the path.
test MacMountsNameAPFS {
	let list = "/dev/disk3s1s1 on / (apfs, sealed, local, read-only, journaled)\n/dev/disk3s5 on /System/Volumes/Data (apfs, local, journaled, nobrowse, protect, root data)\nmap auto_home on /System/Volumes/Data/home (autofs, automounted, nobrowse)\n/dev/disk5s1 on /Volumes/My Disk (msdos, local, nodev, nosuid, noowners)\n"
	assert mountedOf(list, "/System/Volumes/Data/Users/c/Developer") == ("apfs", "local,journaled,nobrowse,protect,root data")
	assert mountedOf(list, "/Volumes/My Disk/x") == ("msdos", "local,nodev,nosuid,noowners")
	assert mountedOf(list, "/opt/x") == ("apfs", "sealed,local,read-only,journaled")
}

// Doctor reports on the base.
func Doctor(t Tool, o DoctorOptions) Report fails NoBase | BadConfig | Unkept | VcsFailed | RiftUnread {
	try initialized(t)
	let c = try config(t)
	let mut names = []string{}
	for cl in t.cloners {
		names = names.Append(cl.Name())
	}
	names = names.Append(t.copier.Name())
	let mut last = ""
	for w in try t.registry.All() {
		if w.Cloner != "" && w.Cloner != "adopted" {
			last = w.Cloner
		}
	}
	let (kind, opts) = mountOf(t, t.base)
	let oneCall = kind == "btrfs" && strings.Contains(","+opts+",", ",user_subvol_rm_allowed,")
	let stale = try t.vcs.StatDirty(t.base)
	let ok = trusted(t, c)
	let mut notes = []string{}
	if kind == "btrfs" && !oneCall {
		notes = notes.Append("a purge deletes each file: mount \(kind) with user_subvol_rm_allowed to make it one call")
	}
	if kind == "btrfs" && last != "" && last != "btrfs" {
		notes = notes.Append("the base is not a btrfs subvolume, so each new clones file by file (\(last)): make it a subvolume to clone it in one call")
	}
	if stale > 0 {
		notes = notes.Append("\(stale) tracked files have a stale stat in the index: run work refresh")
	}
	if !ok {
		notes = notes.Append("work.toml runs commands work trust has not allowed: run work trust")
	}
	// adopt and adopt-rift write nothing into a copy now; an older one
	// gave each adopted copy's remotes the push guard, which stopped the
	// owner's own pushes (the Mac's fork). -unguard drops it from adopted
	// workspaces only: a workspace new made keeps its guard.
	let mut guarded = []string{}
	for w in try t.registry.All() {
		if w.Cloner == "adopted" && w.State == Active && len(try t.vcs.Guarded(w.Path)) > 0 {
			if o.Unguard {
				try t.vcs.Unguard(w.Path)
			}
			guarded = guarded.Append(w.Path)
		}
	}
	if len(guarded) > 0 {
		notes = notes.Append(if o.Unguard { "dropped the push guard of \(len(guarded)) adopted workspaces" } else { "\(len(guarded)) adopted workspaces carry the push guard an older adopt wrote: run work doctor -unguard" })
	}
	let rift = if o.Rift { try RiftLeft(t, RiftOptions{Registry: o.Registry}) } else { []string{} }
	if len(rift) > 0 {
		notes = notes.Append("\(len(rift)) Rift copies of the base are no workspace: run work adopt-rift")
	}
	Report{Base: t.base, Storage: t.home, Cloners: names, LastCloner: last, FileSystem: kind, PurgeOneCall: oneCall, StaleIndex: stale, Trusted: ok, Notes: notes, Rift: rift}
}

// Refresh refreshes the stat data of the base's Git index (git
// update-index --refresh), so that a clone starts with a fresh index; it
// is the number of tracked files that had a stale stat.
func Refresh(t Tool) int fails NoBase | Unkept | VcsFailed {
	try initialized(t)
	let stale = try t.vcs.StatDirty(t.base)
	try t.vcs.Refresh(t.base)
	stale
}

// BasesFile is the list of the bases init registered, one a line, in
// the user's data folder.
func BasesFile(data string) string { filepath.Join([]string{data, "bases"}) }

// Bases is every base init registered on this host whose folder is
// there: one whose folder is gone (a test's scratch, a repository moved
// or removed) is not listed, so no caller walks into it (the Mac's
// WK-BASES); prune-bases forgets it.
func Bases(t Tool) []string fails Unkept { slices.Filter(try registered(t), func(b string) bool { exists(t, b) }) }

// ForgetBase drops base from the list (its folder, its storage and its
// workspaces stay); it is the bases still registered.
func ForgetBase(t Tool, base string) []string fails Unkept | fs.Denied | fs.Failed {
	let gone = filepath.Clean(base)
	let left = slices.Filter(try registered(t), func(b string) bool { filepath.Clean(b) != gone })
	try rewriteBases(t, left)
	left
}

// PruneBases forgets every registered base whose folder is gone; it is
// the bases it forgot.
func PruneBases(t Tool) []string fails Unkept | fs.Denied | fs.Failed {
	let all = try registered(t)
	let gone = slices.Filter(all, func(b string) bool { !exists(t, b) })
	if len(gone) > 0 {
		try rewriteBases(t, slices.Filter(all, func(b string) bool { exists(t, b) }))
	}
	gone
}

// rewriteBases writes the list whole, by a rename, so a reader sees the
// old list or the new one.
func rewriteBases(t Tool, bases []string) fails fs.Denied | fs.Failed {
	let file = BasesFile(t.data)
	let text = if len(bases) == 0 { "" } else { strings.Join(bases, "\n") + "\n" }
	t.writes.WriteFile(file+".tmp", text) catch {
	case fs.NotFound:
		return fs.Failed{Path: file, Reason: "the data folder is not there"}
	case fs.Denied as d:
		return d
	case fs.Failed as f:
		return f
	}
	t.writes.Rename(file+".tmp", file) catch {
	case fs.NotFound:
		return fs.Failed{Path: file, Reason: "the data folder is not there"}
	case fs.Denied as d:
		return d
	case fs.Failed as f:
		return f
	}
}

// registered is every line of the list, once each, in order.
func registered(t Tool) []string fails Unkept {
	let text = t.files.ReadFile(BasesFile(t.data)) catch {
	case fs.NotFound:
		return []string{}
	case fs.Denied, fs.Failed:
		return Unkept{Reason: "\(BasesFile(t.data)) does not read"}
	}
	let mut out = []string{}
	for line in strings.Split(text, "\n") {
		if line != "" && !strings.Contains(strings.Join(out, "\n")+"\n", line+"\n") {
			out = out.Append(line)
		}
	}
	out
}

// ShellLines is what work shell-init prints, for eval "$(work
// shell-init)": a shell function work that runs the binary and, after a
// new that succeeded, changes to the new workspace's folder.
let ShellLines = "work() {\n\tif [ \"$1\" = new ]; then\n\t\tout=$(command work --json \"$@\") || { printf '%s\\n' \"$out\"; return 1; }\n\t\tprintf '%s\\n' \"$out\"\n\t\tcd \"$(printf '%s\\n' \"$out\" | sed -n 's/.*\"path\":\"\\([^\"]*\\)\".*/\\1/p')\" || return\n\telse\n\t\tcommand work \"$@\"\n\tfi\n}"

// ShellInit is the shell lines of ShellLines.
func ShellInit(t Tool) string { ShellLines }

// ImportRiftOptions name the .rift.toml to read (-file; the base's when
// absent).
type ImportRiftOptions { File Option[string] }

type riftHook { Run json.Optional[string] "run" }

type riftHooks {
	Precreate  json.Optional[riftHook] "precreate",
	Postcreate json.Optional[riftHook] "postcreate",
	Preremove  json.Optional[riftHook] "preremove",
	Postremove json.Optional[riftHook] "postremove",
}

type riftFile { Hooks json.Optional[riftHooks] "hooks" }

func riftRun(h json.Optional[riftHook]) []string {
	match h {
	case json.Present[riftHook] as p:
		match p.Value.Run {
		case json.Present[string] as r:
			[]string{r.Value}
		case json.Absent:
			[]string{}
		}
	case json.Absent:
		[]string{}
	}
}

// ImportRift is the work.toml of a Rift configuration (.rift.toml: its
// four hooks, each a `run` command): the hooks as they are, and Rift's
// default copy (leave_out = ["rift-filtered"]) named so a reader sees
// what work's default changes. It writes nothing.
func ImportRift(t Tool, o ImportRiftOptions) string fails BadConfig | fs.NotFound | fs.Denied | fs.Failed {
	let file = match o.File {
	case Some[string] as f:
		f.Value
	case None:
		filepath.Join([]string{t.base, ".rift.toml"})
	}
	let text = try t.files.ReadFile(file)
	let r = toml.Decode(json.Codec[riftFile]{MaxBytes: 1 << 20, MaxDepth: 32}, text) catch {
	case toml.Malformed as m:
		return BadConfig{Line: m.Line, Why: m.Reason}
	case _:
		return BadConfig{Line: 0, Why: "a value of .rift.toml has the wrong type"}
	}
	let mut lines = []string{"# work.toml imported from \(filepath.Base(file)) (work import-rift).", "[work]", "# Rift's default copy leaves these folders out; work's copies everything.", "# Delete this line to clone installed packages and build output too.", "leave_out = [\"rift-filtered\"]"}
	match r.Hooks {
	case json.Present[riftHooks] as h:
		lines = lines.Append("")
		lines = lines.Append("[hooks]")
		lines = hookLine(lines, "precreate", riftRun(h.Value.Precreate))
		lines = hookLine(lines, "postcreate", riftRun(h.Value.Postcreate))
		lines = hookLine(lines, "preremove", riftRun(h.Value.Preremove))
		lines = hookLine(lines, "postremove", riftRun(h.Value.Postremove))
	case json.Absent:
	}
	strings.Join(lines, "\n")
}

func hookLine(lines []string, name string, commands []string) []string {
	if len(commands) == 0 {
		return lines
	}
	let mut quoted = []string{}
	for c in commands {
		quoted = quoted.Append(tomlString(c))
	}
	lines.Append(name + " = [" + strings.Join(quoted, ", ") + "]")
}

// tomlString is s as a TOML basic string.
func tomlString(s string) string {
	"\"" + strings.ReplaceAll(strings.ReplaceAll(strings.ReplaceAll(strings.ReplaceAll(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n"), "\t", "\\t") + "\""
}
