// The work.Cloner laws on the host, in a folder of each case's own
// (TestAmbient). The laws draw their paths, so on most of them a clone is
// Missing or Unsupported and they hold by their failure cases; the test
// below reflinks a real tree.

import exec
import fstest
import strings
import github.com/cevr/ergo/modules/work/system
import github.com/cevr/ergo/modules/work/work

let onHost = context needs fstest.TestAmbient { work.Cloner: New(system.TestTrees()), exec.Runner: system.TestRunner() }

// ReflinksARealTree: on a file system with shared extents (btrfs, XFS),
// a reflink of a planted tree is that tree, and on btrfs, whose du counts
// shared extents, it holds no block of its own; on any other file system
// the clone is Unsupported, never a copy.
test ReflinksARealTree {
	with onHost {
		let kind = system.FileSystem()
		let here = kind == "btrfs" || kind == "xfs"
		let got = system.HostClone(false, kind == "btrfs")
		if here {
			assert got == ""
		} else {
			assert strings.HasPrefix(got, "unsupported:")
		}
	}
}
