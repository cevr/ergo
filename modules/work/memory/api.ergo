import fs
import fstest
import github.com/cevr/ergo/modules/work/classes
import github.com/cevr/ergo/modules/work/work
import time

// Workspaces is work.Api over a fresh memory world (a base committed and
// initialized, one sharing Cloner): the value the Api's laws run on.
type Workspaces { tool work.Tool } implements work.Api

// NewWorkspaces is the Api of a fresh memory world.
func NewWorkspaces() Workspaces { Workspaces{tool: world(true).tool} }

func Init(w Workspaces) string fails work.BadConfig | work.Unkept | fs.Denied | fs.Failed { try w.tool.Init() }

func New(w Workspaces, name string, o work.NewOptions) work.Created fails work.NoBase | work.BadConfig | work.BadName | work.NameTaken | work.NoWorkspace | work.NoRevision | work.Diverged | work.CopyRefused | work.NotSameVolume | work.Unsupported | work.Exists | work.Missing | work.NoSpace | work.CloneFailed | work.Unkept | work.VcsFailed | work.HookFailed | work.Locked | work.Busy {
	try w.tool.New(name, o)
}

func AdoptRift(w Workspaces, o work.RiftOptions) work.RiftAdopted fails work.NoBase | work.RiftUnread | work.Unkept | work.VcsFailed | work.Locked { try w.tool.AdoptRift(o) }

func Adopt(w Workspaces, dir string, o work.AdoptOptions) work.Workspace fails work.NoBase | work.BadName | work.NameTaken | work.Missing | work.Unkept | work.VcsFailed | work.Locked {
	try w.tool.Adopt(dir, o)
}

func List(w Workspaces) []work.Workspace fails work.NoBase | work.Unkept { try w.tool.List() }

func Rm(w Workspaces, name string, o work.RmOptions) []work.Removed fails work.NoBase | work.BadConfig | work.NoWorkspace | work.NotHeld | work.Busy | work.Exists | work.Missing | work.CloneFailed | work.Unkept | work.VcsFailed | work.HookFailed | work.Locked | work.IdMismatch | work.HasDescendants {
	try w.tool.Rm(name, o)
}

func Gc(w Workspaces, o work.GcOptions) work.Collected fails work.NoBase | work.BadConfig | work.BadAge | work.NoWorkspace | work.Exists | work.Missing | work.CloneFailed | work.Unkept | work.VcsFailed | work.HookFailed | work.Locked { try w.tool.Gc(o) }

func Du(w Workspaces) []work.Space fails work.NoBase | work.Unsupported | work.Missing | work.CloneFailed | work.Unkept { try w.tool.Du() }

func Ready(w Workspaces, o work.ReadyOptions) work.Handed fails work.NoBase | work.NotHere | work.NoWorkspace | work.Busy | work.Detached | work.NotFastForward | work.Moved | work.Unkept | work.VcsFailed | work.Locked | work.BadRequest {
	try w.tool.Ready(o)
}

func Record(w Workspaces, tip string) work.LaneRecord fails work.NoBase | work.NoRevision | work.NoRecord | work.BadRecord | work.Unkept | work.VcsFailed {
	try w.tool.Record(tip)
}

func Sync(w Workspaces, o work.SyncOptions) work.Synced fails work.NoBase | work.BadConfig | work.NotHere | work.NoWorkspace | work.Busy | work.Detached | work.Dirty | work.Conflicted | work.Unkept | work.VcsFailed | work.Locked {
	try w.tool.Sync(o)
}

func Env(w Workspaces, o work.EnvOptions) string fails work.NoBase | work.NotHere | work.NoWorkspace | work.BadConfig | work.Unkept { try w.tool.Env(o) }

func MergeFile(w Workspaces, class string, base string, ours string, theirs string, o work.MergeFileOptions) work.FileMerged fails work.BadClass | work.BadConfig | work.MergeConflict | fs.NotFound | fs.Denied | fs.Failed {
	try w.tool.MergeFile(class, base, ours, theirs, o)
}

func Derive(w Workspaces, o work.DeriveOptions) work.Derived fails work.NoBase | work.NotHere | work.NoWorkspace | work.BadConfig | work.Unkept | work.Untrusted | work.DeriveFailed { try w.tool.Derive(o) }

func Deps(w Workspaces, o work.DepsOptions) work.DepsDone fails work.NoBase | work.NotHere | work.NoWorkspace | work.BadConfig | work.Unkept | work.Untrusted | work.DepsFailed | work.Locked { try w.tool.Deps(o) }

func Trust(w Workspaces) work.Trusted fails work.NoBase | work.BadConfig | work.Unkept | fs.NotFound | fs.Denied | fs.Failed { try w.tool.Trust() }

func Pin(w Workspaces, name string) work.Workspace fails work.NoBase | work.NoWorkspace | work.Unkept | work.Locked { try w.tool.Pin(name) }

func Unpin(w Workspaces, name string) work.Workspace fails work.NoBase | work.NoWorkspace | work.Unkept | work.Locked { try w.tool.Unpin(name) }

func Doctor(w Workspaces, o work.DoctorOptions) work.Report fails work.NoBase | work.BadConfig | work.Unkept | work.VcsFailed | work.RiftUnread | work.Locked { try w.tool.Doctor(o) }

func PluginTest(w Workspaces, command string, o work.PluginTestOptions) work.PluginAdmitted fails work.NoBase | work.BadConfig | work.Untrusted | work.VcsFailed | work.PluginRefused { try w.tool.PluginTest(command, o) }

func MergeFolders(w Workspaces, base string, ours string, theirs string, out string) work.TreeMerged fails work.BadConfig | work.Untrusted | work.DeriveFailed | fs.NotFound | fs.Denied | fs.Failed {
	try w.tool.MergeFolders(base, ours, theirs, out)
}

func Refresh(w Workspaces) int fails work.NoBase | work.Unkept | work.VcsFailed { try w.tool.Refresh() }

func Bases(w Workspaces) []string fails work.Unkept { try w.tool.Bases() }

func ForgetBase(w Workspaces, base string) []string fails work.Unkept | fs.Denied | fs.Failed { try w.tool.ForgetBase(base) }

func PruneBases(w Workspaces) []string fails work.Unkept | fs.Denied | fs.Failed { try w.tool.PruneBases() }

func ShellInit(w Workspaces) string { w.tool.ShellInit() }

func ImportRift(w Workspaces, o work.ImportRiftOptions) string fails work.BadConfig | fs.NotFound | fs.Denied | fs.Failed { try w.tool.ImportRift(o) }

// Providers is the memory providers over the trees of c, the registry r,
// the Vcs v and the disk: a free lock, hooks that record (and fail the
// command failing) and a runner that counts.
func Providers(c Cloner, sharing []work.Cloner, r work.Registry, v Vcs, disk fstest.Memory, clock time.Clock, failing string) work.Providers {
	let lock = NewLock()
	work.Providers{Cloners: sharing, Copier: Beside(c, false), Registry: r, Lock: lock, Hooks: Recording(lock, failing), Vcs: v, Files: disk, Writes: disk, Runner: NewRunner(), Clock: clock}
}

// MergeFileWritesTheMerge: merge-file leaves in ours the merge of
// classes.Merge, and answers clean exactly when that merge is; a side
// that does not read as the class leaves the merge by lines and fails.
law MergeFileWritesTheMerge(base string, ours string, theirs string, rows bool) {
	let disk = fstest.NewMemory()
	let written = put(disk, "/m/o", base) && put(disk, "/m/a", ours) && put(disk, "/m/b", theirs)
	let tool = work.NewTool("/base", "/.work/base", "/data", Providers(NewCloner(), []work.Cloner{}, NewRegistry(), NewVcs(), disk, time.NewManual(0), ""), "/")
	let class = if rows { "rows" } else { "lines" }
	let c = if rows { classes.Rows } else { classes.Lines }
	let merged = classes.Merge(c, base, ours, theirs) catch {
	case classes.Unreadable:
		classes.Merged{Text: classes.Text(classes.MergeText(base, ours, theirs)), Conflicts: []string{"unreadable"}, Regenerate: false}
	}
	let clean = len(merged.Conflicts) == 0
	let mut failed = false
	let mut named = true
	tool.MergeFile(class, "/m/o", "/m/a", "/m/b", work.MergeFileOptions{Path: Some[string]{Value: "f"}}) catch {
	case work.MergeConflict as m:
		failed = true
		named = m.Path == "f"
	case work.BadClass, work.BadConfig, fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	let got = disk.ReadFile("/m/a") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	written && named && failed == !clean && got == merged.Text
}

func put(disk fstest.Memory, path string, text string) bool {
	disk.MkdirAll("/m") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	disk.WriteFile(path, text) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	true
}
