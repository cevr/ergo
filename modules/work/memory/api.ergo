import strings
import slices
import maps
import fs
import fstest
import github.com/cevr/ergo/modules/work/classes
import github.com/cevr/ergo/modules/work/work
import github.com/cevr/ergo/modules/work/work/workapi
import time

// overTool runs work.Api's laws on the Tool itself, over a fresh memory
// world each case (a base committed and initialized, one sharing Cloner).
let overTool = context { work.Api: world(true).tool }

// overClient runs them through the request wire: a workapi.Client whose
// send is Call, bound to a fresh memory world's Tool.
let overClient = context { work.Api: clientOf(world(true).tool) }

// clientOf is the Client that sends each request to tool.
func clientOf(tool work.Tool) workapi.Client {
	workapi.NewClient(tool)
}

// Providers is the memory providers over the trees of c, the registry r,
// the Vcs v and the disk: a free lock, hooks that record (and fail the
// command failing) and a runner that counts.
func Providers(c Cloner, sharing []work.Cloner, r work.Registry, v Vcs, disk fstest.Memory, clock time.Clock, failing string) work.Providers {
	let lock = NewLock()
	work.Providers{Cloners: sharing, Copier: Beside(c, false), Registry: r, Lock: lock, Hooks: Recording(lock, failing), Vcs: v, Files: MarkedOver(disk, c), Writes: MarkedOver(disk, c), Runner: NewRunner(), Clock: clock}
}

// MergeFileWritesTheMerge: merge-file leaves in ours the merge of
// classes.Merge, and answers clean exactly when that merge is; a side
// that does not read as the class leaves the merge by lines and fails.
law MergeFileWritesTheMerge(base string, ours string, theirs string, rows bool) {
	let disk = fstest.NewMemory()
	let written = put(disk, "/m/o", base) && put(disk, "/m/a", ours) && put(disk, "/m/b", theirs)
	let tool = work.NewTool("/base", "/.work/base", "/data", Providers(NewCloner(), []work.Cloner{}, NewRegistry(), NewVcs(), disk, time.NewManual(0), ""), "/")
	let class = if rows { "rows" } else { "lines" }
	let c = if rows { classes.Rows } else { classes.Lines }
	let merged = classes.Merge(c, base, ours, theirs) catch {
	case classes.Unreadable:
		classes.Merged{Text: classes.Text(classes.MergeText(base, ours, theirs)), Conflicts: []string{"unreadable"}, Regenerate: false}
	}
	let clean = len(merged.Conflicts) == 0
	let mut failed = false
	let mut named = true
	tool.MergeFile(class, "/m/o", "/m/a", "/m/b", work.MergeFileOptions{Path: Some[string]{Value: "f"}}) catch {
	case work.MergeConflict as m:
		failed = true
		named = m.Path == "f"
	case work.BadClass, work.BadConfig, fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	let got = disk.ReadFile("/m/a") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	written && named && failed == !clean && got == merged.Text
}

func put(disk fstest.Memory, path string, text string) bool {
	disk.MkdirAll("/m") catch {
	case fs.Denied, fs.Failed:
		return false
	}
	disk.WriteFile(path, text) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	true
}

// MergeFileReportsWhatItCannotMerge: merge-file, as Git's driver runs it
// (class auto), never answers clean with a side's change lost, on a lock
// its preset makes derived (bun.lock) or a measured file (a [[class]]
// line with the command that measures it). A clean answer holds every
// entry either side added or changed against base, with that side's
// value, where the other side left it or agrees. A merge that would need
// making again is a conflict whose why names the command; a derived file
// is then ours, byte for byte, so the package manager still reads it.
// The entries: base, ours and theirs (keys taken 0 to 5, so the sides
// add, remove and change the same keys).
law MergeFileReportsWhatItCannotMerge(base Map[int, int], ours Map[int, int], theirs Map[int, int], measured bool) {
	let b = sixKeys(base)
	let a = sixKeys(ours)
	let o = sixKeys(theirs)
	let disk = fstest.NewMemory()
	let config = "[[class]]\nmatch = \"times.json\"\nkind = \"measured\"\nby = \"gate -measure\"\n"
	let written = put(disk, "/m/o", entriesText(b)) && put(disk, "/m/a", entriesText(a)) && put(disk, "/m/b", entriesText(o)) && putIn(disk, "/base", "work.toml", config) && putIn(disk, "/base", "bun.lock", "{}\n")
	let tool = work.NewTool("/base", "/.work/base", "/data", Providers(NewCloner(), []work.Cloner{}, NewRegistry(), NewVcs(), disk, time.NewManual(0), ""), "/")
	let path = if measured { "times.json" } else { "bun.lock" }
	let mut why = ""
	let mut conflicted = false
	tool.MergeFile("auto", "/m/o", "/m/a", "/m/b", work.MergeFileOptions{Path: Some[string]{Value: path}}) catch {
	case work.MergeConflict as m:
		conflicted = true
		why = m.Why
	case work.BadClass, work.BadConfig, fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	let got = disk.ReadFile("/m/a") catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	if !written {
		return false
	}
	if conflicted {
		let command = if measured { "gate -measure" } else { "bun install --lockfile-only" }
		return strings.Contains(why, command) && (measured || got == entriesText(a))
	}
	keepsEveryChange(b, a, o, got) && keepsEveryChange(b, o, a, got)
}

// sixKeys is m with each key taken to 0 to 5 (the last write of a key
// wins, in key order).
func sixKeys(m Map[int, int]) Map[int, int] {
	let mut out = Map[int, int]{}
	for k in slices.Sorted(maps.Keys(m)) {
		out[((k%6)+6)%6] = maps.GetOr(m, k, 0)
	}
	out
}

// entriesText is a lock-like JSON object of the entries, key by key.
func entriesText(m Map[int, int]) string {
	let mut rows = []string{}
	for key in 0..6 {
		match m.Get(key) {
		case Some[int] as v:
			rows = rows.Append("    \"k\(key)\": \(v.Value)")
		case None:
		}
	}
	let inner = if len(rows) == 0 { "{}" } else { "{\n" + strings.Join(rows, ",\n") + "\n  }" }
	"{\n  \"pkg\": " + inner + "\n}\n"
}

// keepsEveryChange reports whether got holds each entry side added or
// changed against base where other left that key as base has it or
// agrees with side.
func keepsEveryChange(base Map[int, int], side Map[int, int], other Map[int, int], got string) bool {
	for key in 0..6 {
		match side.Get(key) {
		case Some[int] as v:
			let changed = base.Get(key) != Some[int]{Value: v.Value}
			let free = other.Get(key) == base.Get(key) || other.Get(key) == Some[int]{Value: v.Value}
			let entry = "\"k\(key)\": \(v.Value)"
			if changed && free && !strings.Contains(got, entry+",\n") && !strings.Contains(got, entry+"\n") {
				return false
			}
		case None:
		}
	}
	true
}

// putIn writes text to name in the folder dir of disk.
func putIn(disk fstest.Memory, dir string, name string, text string) bool {
	disk.MkdirAll(dir) catch {
	case fs.Denied, fs.Failed:
		return false
	}
	disk.WriteFile(dir+"/"+name, text) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	true
}
