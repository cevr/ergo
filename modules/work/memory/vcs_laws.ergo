// The file-level laws of a Vcs on checkouts the laws plant, and the
// parity of ergo work's verbs with lane-rift.sh's on the memory model.

import github.com/cevr/ergo/modules/work/work
import strings

// SnapshotIsTheFiles: a snapshot read back is the working files: a
// committed file with an uncommitted change, an untracked file, and not
// an ignored one.
law SnapshotIsTheFiles(files Map[string, string], changed string, added string) {
	let v = VcsOver(NewCloner())
	Repo(v, "r", "main", tracked(files), "c1")
	let edited = Write(v.trees, "r", "a.txt", changed) && Write(v.trees, "r", "new/untracked.txt", added) && Write(v.trees, "r", "out/build", "ignored\n")
	let tree = Snapshot(v, "r") catch {
	case work.VcsFailed:
		return false
	}
	let got = Read(v, "r", tree) catch {
	case work.VcsFailed:
		return false
	}
	let want = Working(Files(v.trees, "r"))
	edited && got == want && got.Get("a.txt") == Some[string]{Value: changed} && got.Get("new/untracked.txt") == Some[string]{Value: added} && got.Get("out/build") == None
}

// tracked is files without the paths the law writes itself, with a
// .gitignore that ignores out/.
func tracked(files Map[string, string]) Map[string, string] {
	let mut out = Map[string, string]{".gitignore": "out\n"}
	for path, text in files {
		let own = path == "" || path == "a.txt" || strings.HasPrefix(path, ".git") || strings.HasPrefix(path, "out") || strings.HasPrefix(path, "new")
		if !own {
			out[path] = text
		}
	}
	out
}

// Verb is one step of ParityWithLaneRift on both sides: a committed
// change, a hand-back (lane-rift.sh push; ergo work ready), a commit on
// the base's main, and a merge of main (git fetch and merge; ergo work
// sync).
type Verb = Change{} | Hand{} | Advance{} | Follow{}

// ParityWithLaneRift: a lane made as lane-rift.sh create makes it (a
// clone and a branch at the base's head) and a workspace ergo work new
// makes, driven by the same verbs, leave the base's two branches at the
// same files, each at its side's head after a hand-back, and agree on
// which verbs succeed.
law ParityWithLaneRift(verbs []Verb) {
	let w = world(true)
	let lane = "/w/lane"
	let start = Head(w.vcs, theBase) catch {
	case work.VcsFailed:
		return false
	}
	w.trees.Clone(theBase, lane) catch {
	case _:
		return false
	}
	Start(w.vcs, lane, "lane", start) catch {
	case work.VcsFailed:
		return false
	}
	let path = w.tool.New("work", fresh(false)) catch {
	case _:
		return false
	}
	let mut n = 0
	for verb in verbs {
		n = n + 1
		match verb {
		case Change:
			let both = Write(w.trees, lane, "f.txt", "\(n)\n") && Commit(w.vcs, lane, "l\(n)") && Write(w.trees, path, "f.txt", "\(n)\n") && Commit(w.vcs, path, "w\(n)")
			if !both {
				return false
			}
		case Hand:
			let mut pushed = true
			Push(w.vcs, lane, theBase, []work.Pushed{work.Pushed{From: "HEAD", To: "refs/heads/lane", Force: false}}) catch {
			case work.NotFastForward, work.VcsFailed:
				pushed = false
			}
			let mut handed = true
			let _ = w.tool.Ready(work.ReadyOptions{Name: Some[string]{Value: "work"}}) catch {
			case _:
				handed = false
				work.Handed{Name: "", Branch: "", Commit: "", Snapshot: "", Parent: ""}
			}
			if pushed != handed || !atHead(w, lane, "lane") || !atHead(w, path, "work") {
				return false
			}
		case Advance:
			let _ = Write(w.trees, theBase, "main.ergo", "// main \(n)\n") && Commit(w.vcs, theBase, "b\(n)")
		case Follow:
			let mut merged = true
			let _ = Merge(w.vcs, lane, theBase, "main") catch {
			case work.Conflicted, work.VcsFailed:
				merged = false
				""
			}
			let mut synced = true
			let _ = w.tool.Sync(work.SyncOptions{Name: Some[string]{Value: "work"}}) catch {
			case _:
				synced = false
				""
			}
			if merged != synced {
				return false
			}
		}
		if !sameBranches(w, "lane", "work") {
			return false
		}
	}
	true
}

// atHead reports whether the base's branch is the head of the checkout at
// root, once the branch was handed back.
func atHead(w World, root string, branch string) bool {
	let held = Ref(w.vcs, theBase, "refs/heads/"+branch) catch {
	case work.VcsFailed:
		return false
	}
	let head = Head(w.vcs, root) catch {
	case work.VcsFailed:
		return false
	}
	held == "" || held == head
}

// sameBranches reports whether the base's two branches are both absent,
// or both hold the same files.
func sameBranches(w World, one string, two string) bool {
	let a = Ref(w.vcs, theBase, "refs/heads/"+one) catch {
	case work.VcsFailed:
		return false
	}
	let b = Ref(w.vcs, theBase, "refs/heads/"+two) catch {
	case work.VcsFailed:
		return false
	}
	if a == "" || b == "" {
		return a == b
	}
	let x = treeOf(w.vcs, theBase, a) catch {
	case work.VcsFailed:
		return false
	}
	let y = treeOf(w.vcs, theBase, b) catch {
	case work.VcsFailed:
		return false
	}
	x == y
}
