// The model property of work.Tool: random command sequences against the
// memory providers, held to a reference written apart from the Tool (a
// list of names, states, parents, kept flags and ages).

import fs
import fstest
import github.com/cevr/ergo/modules/work/work
import maps
import slices
import strings
import time

// Op is one step of a sequence: a command, an edit, a land or a commit in
// a workspace, a commit in the base, a crash between the registry's
// record and the clone, or time passing. Each picks its names from three
// by Name (and On).
type Op =
	| NewOp{Name int, Copy bool}
	| OnOp{Name int, On int}
	| RmOp{Name int, Abandon bool}
	| EditOp{Name int}
	| LandOp{Name int}
	| ReadyOp{Name int}
	| SyncOp{Name int}
	| BaseOp{}
	| CrashOp{Name int}
	| GcOp{Older int}
	| WaitOp{Seconds int}

// Expected is the reference's record of one name. Kept is whether its
// work is in its parent; Sure is false after a step whose effect on that
// the reference does not decide (a stack's clone of a changed parent, a
// sync), and then rm's outcome is the Tool's to tell.
type Expected { Name string, State string, Parent string, Kept bool, Sure bool, Since int64, Path string }

// pick is one of three names, so sequences reuse them.
func pick(n int) string { []string{"a", "b", "wf/c"}[((n%3)+3)%3] }

// small is n within 0 to limit-1.
func small(n int, limit int) int { ((n % limit) + limit) % limit }

// let theBase is the base the property clones; otherBase is a second
// base on the same disk, with a workspace in its trash.
let theBase = "/w/base"
let otherBase = "/w/other"

// World is a Tool over memory providers and the handles the driver uses.
type World { tool work.Tool, trees Cloner, vcs Vcs, registry Registry, clock time.Manual, disk fstest.Memory, hooks Hooks, lock Lock, runner Runner }

// world is a fresh World: the base committed as c0, initialized; the
// sharing Cloner refuses every clone when sharing is false.
func world(sharing bool) World { worldWith(sharing, Map[string, string]{}, "", "") }

// worldWith is a fresh World whose base also holds the files tree (each
// committed), installed packages (node_modules, untracked and not
// ignored, with nested folders) and ignored build output (dist), with
// config as its work.toml ("" for none) and hooks that fail the command
// failing. A work.toml is allowed (work trust) at init.
func worldWith(sharing bool, tree Map[string, string], config string, failing string) World {
	let trees = NewCloner()
	let vcs = VcsOver(trees)
	let mut files = Map[string, string]{"main.ergo": "func main() {}\n", ".gitignore": "dist\nnode_modules\n"}
	for path, text in tree {
		let own = path == "" || strings.HasPrefix(path, ".git") || strings.HasPrefix(path, "dist") || strings.HasPrefix(path, "node_modules") || strings.HasSuffix(path, "/") || strings.Contains(path, "//") || path == "main.ergo"
		if !own {
			files[path] = text
		}
	}
	Repo(vcs, theBase, "main", files, "c0")
	let _ = Write(trees, theBase, "node_modules/left-pad/index.js", "module.exports = 1\n") && Write(trees, theBase, "node_modules/.bin/left-pad", "#!/bin/sh\n") && Write(trees, theBase, "dist/out.js", "built\n")
	let cloner = if sharing { trees } else { Refusing(trees) }
	let registry = NewRegistry()
	let disk = fstest.NewMemory()
	disk.MkdirAll(theBase) catch {
	case fs.Denied, fs.Failed:
		Unreachable("a folder of a memory disk")
	}
	if config != "" {
		disk.WriteFile(theBase+"/"+work.ConfigFile, config) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			Unreachable("a file of a memory disk")
		}
	}
	let clock = time.NewManual(1000)
	let lock = NewLock()
	let hooks = Recording(lock, failing)
	let runner = NewRunner()
	let p = work.Providers{Cloners: []work.Cloner{cloner}, Copier: Beside(trees, false), Registry: registry, Lock: lock, Hooks: hooks, Vcs: vcs, Files: disk, Writes: disk, Runner: runner, Clock: clock}
	let tool = work.NewTool(theBase, work.Home(theBase, ""), "/data", p, "/")
	let _ = tool.Init() catch {
	case work.BadConfig, work.Unkept, fs.Denied, fs.Failed:
		Unreachable("init of a memory base")
		""
	}
	World{tool: tool, trees: trees, vcs: vcs, registry: registry, clock: clock, disk: disk, hooks: hooks, lock: lock, runner: runner}
}

// fresh are new's options with only the copy flag.
func fresh(copy bool) work.NewOptions { work.NewOptions{Copy: copy, From: None, Branch: None, On: None} }

// ToolAgreesWithTheReference: after every step, List names the records
// the reference holds, in its order, states and parents; every live
// workspace's tree is at its path, and a deleted one's is gone; a
// workspace ready handed is held by its parent's branch; a sync records
// the commit it merged as the base. A second base's trash is never
// touched.
law ToolAgreesWithTheReference(ops []Op, sharing bool, tree Map[string, string]) {
	let w = worldWith(sharing, tree, "", "")
	Repo(w.vcs, "/w/.work/other/.work-trash/x.1", "x", Map[string, string]{"f": "other"}, "o1")
	let mut want = []Expected{}
	let mut gone = []string{}
	let mut commits = 0
	for op in ops {
		let at = w.clock.Now().UnixSeconds()
		match op {
		case NewOp as o:
			let name = pick(o.Name)
			let made = w.tool.New(name, fresh(o.Copy)) catch {
			case _:
				nothing()
			}
			if made.Path != "" && !carries(w, made.Path) {
				return false
			}
			if !named(want, name) && (sharing || o.Copy) {
				want = want.Append(Expected{Name: name, State: "active", Parent: theBase, Kept: true, Sure: true, Since: at, Path: work.Home(theBase, "") + "/" + work.FolderOf(name)})
			}
		case OnOp as o:
			let name = pick(o.Name)
			let on = pick(o.On)
			let made = (w.tool.New(name, work.NewOptions{Copy: true, From: None, Branch: None, On: Some[string]{Value: on}}) catch {
			case _:
				nothing()
			}).Path
			match find(want, on) {
			case Some[Expected] as parent:
				let can = !named(want, name) && parent.Value.State == "active"
				if made != "" && !can {
					return false
				}
				if made != "" {
					want = want.Append(Expected{Name: name, State: "active", Parent: parent.Value.Path, Kept: false, Sure: false, Since: at, Path: made})
				}
			case None:
				if made != "" {
					return false
				}
			}
		case RmOp as o:
			let name = pick(o.Name)
			let out = w.tool.Rm(name, work.RmOptions{Abandon: o.Abandon}) catch {
			case _:
				work.Workspace{Name: "", Id: "", Path: "", Parent: "", Branch: "", Cloner: "", State: work.Active, Since: 0, Base: "", Latest: "", Deps: ""}
			}
			want = removed(want, name, o.Abandon, at, out.Name == name)
		case EditOp as o:
			let name = pick(o.Name)
			match find(want, name) {
			case Some[Expected] as e:
				if e.Value.State == "active" && Write(w.trees, e.Value.Path, "edit.ergo", "// edit \(at)\n") {
					want = replaced(want, Expected{..e.Value, Kept: false, Sure: true})
				}
			case None:
			}
		case LandOp as o:
			let name = pick(o.Name)
			match find(want, name) {
			case Some[Expected] as e:
				if e.Value.State == "active" {
					commits = commits + 1
					let landed = Commit(w.vcs, e.Value.Path, "c\(commits)") && Land(w.vcs, e.Value.Path, e.Value.Parent)
					want = replaced(want, Expected{..e.Value, Kept: landed, Sure: landed})
				}
			case None:
			}
		case ReadyOp as o:
			let name = pick(o.Name)
			let handed = w.tool.Ready(work.ReadyOptions{Name: Some[string]{Value: name}}) catch {
			case _:
				work.Handed{Name: "", Branch: "", Commit: "", Snapshot: "", Parent: ""}
			}
			match find(want, name) {
			case Some[Expected] as e:
				if e.Value.State == "active" && parentLive(want, e.Value) {
					if handed.Name != name || !handedHeld(w, e.Value, handed) {
						return false
					}
					want = replaced(want, Expected{..e.Value, Kept: true, Sure: true})
				} else if handed.Name != "" {
					return false
				}
			case None:
				if handed.Name != "" {
					return false
				}
			}
		case SyncOp as o:
			let name = pick(o.Name)
			let theirs = (w.tool.Sync(work.SyncOptions{Name: Some[string]{Value: name}}) catch {
			case _:
				work.Synced{Commit: "", Deps: work.NoDeps}
			}).Commit
			if theirs != "" {
				if !synced(w, name, theirs) {
					return false
				}
				match find(want, name) {
				case Some[Expected] as e:
					want = replaced(want, Expected{..e.Value, Sure: false})
				case None:
					return false
				}
			}
		case BaseOp:
			commits = commits + 1
			let _ = Write(w.trees, theBase, "main.ergo", "// base \(commits)\n") && Commit(w.vcs, theBase, "c\(commits)")
		case CrashOp as o:
			let name = pick(o.Name)
			if !named(want, name) {
				let path = work.Home(theBase, "") + "/" + work.FolderOf(name)
				w.registry.Put(work.Workspace{Name: name, Path: path, Parent: theBase, Branch: "", Cloner: "", State: work.Creating, Since: at, Base: "", Latest: "", Deps: "", Id: ""}) catch {
				case work.Unkept:
				}
				Plant(w.trees, path, Map[string, string]{"half": "a clone cut short"})
				want = want.Append(Expected{Name: name, State: "creating", Parent: theBase, Kept: false, Sure: true, Since: at, Path: path})
			}
		case GcOp as o:
			let older = small(o.Older, 7200)
			let _ = w.tool.Gc(work.GcOptions{Older: Some[string]{Value: "\(older)s"}}) catch {
			case _:
				[]string{}
			}
			let (kept, dropped) = collected(want, int64(older), at)
			want = kept
			gone = slices.Concat(gone, dropped)
		case WaitOp as o:
			w.clock.Advance(time.Times(1s, small(o.Seconds, 5000)))
		}
		if !agrees(w, want, gone) {
			return false
		}
	}
	w.trees.Has("/w/.work/other/.work-trash/x.1")
}

// StackRecordsItsParent: a workspace made -on another records that
// workspace's folder as its parent, on any tree (the model property
// reaches a stack only now and then; this law always does).
law StackRecordsItsParent(tree Map[string, string]) {
	let w = worldWith(true, tree, "", "")
	let a = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let _ = w.tool.New("b", work.NewOptions{Copy: false, From: None, Branch: None, On: Some[string]{Value: "a"}}) catch {
	case _:
		return false
	}
	let all = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	slices.IndexFunc(all, func(r work.Workspace) bool { r.Name == "b" && r.Parent == a.Path }) >= 0
}

// nothing is the answer of a new that failed.
func nothing() work.Created { work.Created{Name: "", Id: "", Path: "", Branch: "", Deps: work.NoDeps, Hooks: work.HooksRan{Count: 0}} }

// carries reports whether the clone at path holds the base's installed
// packages and ignored build output: a clone copies everything.
func carries(w World, path string) bool {
	let files = Files(w.trees, path)
	files.Get("node_modules/left-pad/index.js") != None && files.Get("node_modules/.bin/left-pad") != None && files.Get("dist/out.js") != None
}

// handedHeld reports whether the parent's branch holds the workspace's
// head, as ready said, and the parent keeps the snapshot it named.
func handedHeld(w World, e Expected, h work.Handed) bool {
	let head = w.vcs.Head(e.Path) catch {
	case work.VcsFailed:
		return false
	}
	let snapshot = w.vcs.Ref(e.Parent, work.SnapshotRef(e.Name)) catch {
	case work.VcsFailed:
		return false
	}
	h.Commit == head && h.Parent == e.Parent && snapshot != "" && maps.GetOr(w.vcs.store.Get().commits, snapshot, Node{Tree: "", Parents: []string{}}).Tree == h.Snapshot
}

// synced reports whether a sync of name that merged theirs left it
// recorded as the workspace's base, and its head contains it.
func synced(w World, name string, theirs string) bool {
	let all = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	for r in all {
		if r.Name == name {
			let head = w.vcs.Head(r.Path) catch {
			case work.VcsFailed:
				return false
			}
			return r.Base == theirs && reaches(w.vcs.store.Get(), head, theirs)
		}
	}
	false
}

// agrees reports whether the Tool's list and trees are the reference's.
func agrees(w World, want []Expected, gone []string) bool {
	let got = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	if len(got) != len(want) {
		return false
	}
	for i, g in got {
		let e = want[i]
		if g.Name != e.Name || work.StateName(g.State) != e.State || g.Parent != e.Parent {
			return false
		}
		if !w.trees.Has(g.Path) {
			return false
		}
		if e.State != "trashed" && g.Path != e.Path {
			return false
		}
	}
	for path in gone {
		// A deleted path a later workspace took again is that one's.
		let retaken = slices.IndexFunc(want, func(e Expected) bool { e.Path == path }) >= 0
		if !retaken && w.trees.Has(path) {
			return false
		}
	}
	true
}

// removed is the reference after rm of name at the second at: a creating
// workspace, or an active one whose work is kept or that is abandoned,
// goes to the trash; any other stays. Where the reference is not sure of
// the kept flag, trashed (the Tool's answer) decides.
func removed(want []Expected, name string, abandon bool, at int64, trashed bool) []Expected {
	match find(want, name) {
	case Some[Expected] as e:
		let keptNow = if e.Value.Sure && parentLive(want, e.Value) { e.Value.Kept } else { trashed }
		let goes = e.Value.State == "creating" || (e.Value.State == "active" && (keptNow || abandon))
		if goes {
			return replaced(want, Expected{..e.Value, State: "trashed", Since: at, Path: work.TrashOf(e.Value.Path, at)})
		}
		want
	case None:
		want
	}
}

// collected is the reference after gc at the second at with the age
// older: the records that stay, and the paths deleted.
func collected(want []Expected, older int64, at int64) ([]Expected, []string) {
	let stale = if older > 3600 { older } else { 3600 }
	let mut kept = []Expected{}
	let mut dropped = []string{}
	for e in want {
		let age = at - e.Since
		if (e.State == "trashed" && age >= older) || (e.State == "creating" && age >= stale) {
			dropped = dropped.Append(e.Path)
		} else {
			kept = kept.Append(e)
		}
	}
	(kept, dropped)
}

// parentLive reports whether e's parent is the base or a workspace the
// reference holds at that path and has not trashed.
func parentLive(want []Expected, e Expected) bool {
	e.Parent == theBase || slices.IndexFunc(want, func(p Expected) bool { p.Path == e.Parent && p.State != "trashed" }) >= 0
}

func named(want []Expected, name string) bool { find(want, name) != None }

func find(want []Expected, name string) Option[Expected] {
	for e in want {
		if e.Name == name {
			return Some[Expected]{Value: e}
		}
	}
	None
}

func replaced(want []Expected, e Expected) []Expected {
	let mut out = []Expected{}
	for x in want {
		if x.Name == e.Name {
			out = out.Append(e)
		} else {
			out = out.Append(x)
		}
	}
	out
}
