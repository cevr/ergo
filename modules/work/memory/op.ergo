// The model property of work.Tool: random command sequences against the
// memory providers, held to a reference written apart from the Tool (a
// list of names, states, parents, kept flags and ages).

import fs
import fstest
import github.com/cevr/ergo/modules/work/classes
import github.com/cevr/ergo/modules/work/work
import github.com/cevr/ergo/modules/work/work/workapi
import maps
import slices
import strings
import time

// Op is one step of a sequence: a command, an edit, a land or a commit in
// a workspace, a commit in the base, a crash between the registry's
// record and the clone, or time passing. Each picks its names from three
// by Name (and On). A gc with a positive Idle is a gc -idle.
type Op =
	| NewOp{Name int, Copy bool}
	| OnOp{Name int, On int}
	| RmOp{Name int, Abandon bool}
	| EditOp{Name int}
	| LandOp{Name int}
	| ReadyOp{Name int}
	| SyncOp{Name int}
	| BaseOp{}
	| CrashOp{Name int}
	| GcOp{Older int, Idle int}
	| WaitOp{Seconds int}

// Expected is the reference's record of one name. Kept is whether its
// work is in its parent; Sure is false after a step whose effect on that
// the reference does not decide (a stack's clone of a changed parent, a
// sync), and then rm's outcome is the Tool's to tell.
type Expected { Name string, State string, Parent string, Kept bool, Sure bool, Since int64, Path string }

// pick is one of three names, so sequences reuse them.
func pick(n int) string { []string{"a", "b", "wf/c"}[((n%3)+3)%3] }

// small is n within 0 to limit-1.
func small(n int, limit int) int { ((n % limit) + limit) % limit }

// let theBase is the base the property clones; otherBase is a second
// base on the same disk, with a workspace in its trash.
let theBase = "/w/base"
// World is a Tool over memory providers and the handles the driver uses.
type World { tool work.Tool, trees Cloner, vcs Vcs, registry work.Registry, clock time.Manual, disk fstest.Memory, hooks Hooks, lock Lock, runner Runner }

// viaHub is the hub client of inner (workapi.Client): each Request is a
// Call with inner bound, so the Api's laws hold for it exactly when they
// hold for inner and Call answers as inner does.
func viaHub(inner work.Api) workapi.Client {
	workapi.NewClient(func(r workapi.Request) workapi.Outcome {
		with context { work.Api: inner } { workapi.Call(r) }
	})
}

// world is a fresh World: the base committed as c0, initialized; the
// sharing Cloner refuses every clone when sharing is false.
func world(sharing bool) World { worldWith(sharing, Map[string, string]{}, "", "") }

// RemovingIsIdempotent: rm -expect of a workspace's id trashes it; the
// retry answers AlreadyRemoved, and so does a retry after gc purged it
// (its tomb), and the retries change no record.
law RemovingIsIdempotent(name int) {
	let w = world(true)
	let n = pick(name)
	let a = w.tool.New(n, fresh(false)) catch {
	case _:
		return false
	}
	let first = w.tool.Rm(n, expecting(some(a.Id))) catch {
	case _:
		return false
	}
	let again = []work.Removed{work.Removed{Name: n, Id: a.Id, Trash: "", Already: true}}
	let second = w.tool.Rm(n, expecting(some(a.Id))) catch {
	case _:
		return false
	}
	let listed = w.tool.List() catch {
	case _:
		return false
	}
	let _ = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: some(a.Id), Archive: false}) catch {
	case _:
		return false
	}
	let third = w.tool.Rm(n, expecting(some(a.Id))) catch {
	case _:
		return false
	}
	let purged = w.tool.List() catch {
	case _:
		return false
	}
	len(first) == 1 && first[0].Id == a.Id && !first[0].Already && second == again && third == again && len(listed) == 1 && len(purged) == 0
}

// expecting are rm's options with the expected id and -abandon.
func expecting(id Option[string]) work.RmOptions { work.RmOptions{Abandon: true, Expect: id, Tree: false} }

// RemovingSparesTheReplacement: after the workspace at a name was removed
// and purged (the name is taken until gc) and a new one took the name,
// rm -expect of the first id answers already and leaves the new one.
law RemovingSparesTheReplacement() {
	let w = world(true)
	let first = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let _ = w.tool.Rm("a", expecting(None)) catch {
	case _:
		return false
	}
	let _ = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let second = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let answer = w.tool.Rm("a", expecting(some(first.Id))) catch {
	case _:
		return false
	}
	answer == []work.Removed{work.Removed{Name: "a", Id: first.Id, Trash: "", Already: true}} && w.trees.Has(second.Path) && second.Id != first.Id
}

// ReservingWithATokenTwiceIsOnce: a second new with the token of the
// first, under any name, answers the workspace the first made and makes
// no second record.
law ReservingWithATokenTwiceIsOnce(token string, again int) {
	if token == "" {
		return true
	}
	let w = world(true)
	let o = work.NewOptions{..fresh(false), Token: some(token)}
	let first = w.tool.New("a", o) catch {
	case _:
		return false
	}
	let second = w.tool.New(pick(again), o) catch {
	case _:
		return false
	}
	let after = w.tool.List() catch {
	case _:
		return false
	}
	second.Id == first.Id && second.Path == first.Path && second.Name == "a" && len(after) == 1
}

// PurgingTouchesOneEntry: gc -id purges that entry only: its record goes
// (its tomb stays), and every other record and tree stays.
law PurgingTouchesOneEntry() {
	let w = world(true)
	let a = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let _ = w.tool.New("b", fresh(false)) catch {
	case _:
		return false
	}
	let _ = w.tool.Rm("a", expecting(None)) catch {
	case _:
		return false
	}
	let gone = w.tool.Rm("b", expecting(None)) catch {
	case _:
		return false
	}
	let before = w.tool.List() catch {
	case _:
		return false
	}
	let purged = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: some(a.Id), Archive: false}) catch {
	case _:
		return false
	}
	let after = w.tool.List() catch {
	case _:
		return false
	}
	let tombs = w.registry.Tombs() catch {
	case work.Unkept:
		return false
	}
	purged.Purged == []string{"a"} && after == slices.Filter(before, func(x work.Workspace) bool { x.Name != "a" }) && w.trees.Has(gone[0].Trash) && slices.IndexFunc(tombs, func(t work.Tomb) bool { t.Id == a.Id }) >= 0
}

// ClaimReadsTheParentAgain: a new -on x that looked at x and read its
// branch, and then lost x to an rm (and, when replaced, to a gc and a new
// x at the same folder), claims nothing: its claim under the lock is
// NoWorkspace, and no reservation names the x it looked at (rift#56).
law ClaimReadsTheParentAgain(replaced bool) {
	let w = world(true)
	let x = w.tool.New("x", fresh(false)) catch {
	case _:
		return false
	}
	let o = on("x")
	let looked = match (w.tool.Look("y", o) catch {
	case _:
		return false
	}) {
	case work.Making as m:
		m
	case work.Created:
		return false
	}
	let begun = w.tool.Begin(looked, o) catch {
	case _:
		return false
	}
	let _ = w.tool.Rm("x", expecting(None)) catch {
	case _:
		return false
	}
	if replaced {
		let _ = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: None, Archive: false}) catch {
		case _:
			return false
		}
		let again = w.tool.New("x", fresh(false)) catch {
		case _:
			return false
		}
		if again.Path != x.Path || again.Id == x.Id {
			return false
		}
	}
	let _ = w.tool.Claim(begun, o.On) catch {
	case work.NoWorkspace as n:
		let all = w.tool.List() catch {
		case _:
			return false
		}
		return n.Name == "x" && slices.IndexFunc(all, func(r work.Workspace) bool { r.Name == "y" }) < 0
	case _:
		return false
	}
	false
}

// ParityWithLaneRift: a lane made as lane-rift.sh create makes it (a
// clone and a branch at the base's head) and a workspace ergo work new
// makes, driven by the same verbs, leave the base's two branches at the
// same files, each at its side's head after a hand-back, and agree on
// which verbs succeed.
law ParityWithLaneRift(verbs []Verb) {
	let w = world(true)
	let lane = "/w/lane"
	let start = Head(w.vcs, theBase) catch {
	case work.VcsFailed:
		return false
	}
	w.trees.Clone(theBase, lane) catch {
	case _:
		return false
	}
	w.vcs.Start(lane, "lane", start) catch {
	case work.VcsFailed:
		return false
	}
	let made = w.tool.New("work", fresh(false)) catch {
	case _:
		return false
	}
	let path = made.Path
	let mut n = 0
	for verb in verbs {
		n = n + 1
		match verb {
		case Change:
			let both = Write(w.trees, lane, "f.txt", "\(n)\n") && Commit(w.vcs, lane, "l\(n)") && Write(w.trees, path, "f.txt", "\(n)\n") && Commit(w.vcs, path, "w\(n)")
			if !both {
				return false
			}
		case Hand:
			let mut pushed = true
			Push(w.vcs, lane, theBase, []work.Pushed{work.Pushed{From: "HEAD", To: "refs/heads/lane", Force: false}}) catch {
			case work.NotFastForward, work.VcsFailed:
				pushed = false
			}
			let mut handed = true
			let _ = w.tool.Ready(work.ReadyOptions{Name: Some[string]{Value: "work"}, Request: None}) catch {
			case _:
				handed = false
				work.Handed{Name: "", Branch: "", Commit: "", Snapshot: "", Parent: ""}
			}
			if pushed != handed || !atHead(w, lane, "lane") || !atHead(w, path, "work") {
				return false
			}
		case Advance:
			let _ = Write(w.trees, theBase, "main.ergo", "// main \(n)\n") && Commit(w.vcs, theBase, "b\(n)")
		case Follow:
			let mut merged = true
			let _ = Merge(w.vcs, lane, theBase, "main") catch {
			case work.Conflicted, work.VcsFailed:
				merged = false
				""
			}
			let mut synced = true
			let _ = w.tool.Sync(work.SyncOptions{Name: Some[string]{Value: "work"}}) catch {
			case _:
				synced = false
				work.Synced{Commit: "", Deps: work.NoDeps}
			}
			if merged != synced {
				return false
			}
		}
		if !sameBranches(w, "lane", "work") {
			return false
		}
	}
	true
}

// Verb is one step of ParityWithLaneRift on both sides: a committed
// change, a hand-back (lane-rift.sh push; ergo work ready), a commit on
// the base's main, and a merge of main (git fetch and merge; ergo work
// sync).
type Verb = Change{} | Hand{} | Advance{} | Follow{}

// atHead reports whether the base's branch is the head of the checkout at
// root, once the branch was handed back.
func atHead(w World, root string, branch string) bool {
	let held = Ref(w.vcs, theBase, "refs/heads/"+branch) catch {
	case work.VcsFailed:
		return false
	}
	let head = Head(w.vcs, root) catch {
	case work.VcsFailed:
		return false
	}
	held == "" || held == head
}

// sameBranches reports whether the base's two branches are both absent,
// or both hold the same files.
func sameBranches(w World, one string, two string) bool {
	let a = Ref(w.vcs, theBase, "refs/heads/"+one) catch {
	case work.VcsFailed:
		return false
	}
	let b = Ref(w.vcs, theBase, "refs/heads/"+two) catch {
	case work.VcsFailed:
		return false
	}
	if a == "" || b == "" {
		return a == b
	}
	let x = treeOf(w.vcs, theBase, a) catch {
	case work.VcsFailed:
		return false
	}
	let y = treeOf(w.vcs, theBase, b) catch {
	case work.VcsFailed:
		return false
	}
	x == y
}

// worldWith is a fresh World whose base also holds the files tree (each
// committed), installed packages (node_modules, untracked and not
// ignored, with nested folders) and ignored build output (dist), with
// config as its work.toml ("" for none) and hooks that fail the command
// failing. A work.toml is allowed (work trust) at init.
func worldWith(sharing bool, tree Map[string, string], config string, failing string) World { worldOn(NewRegistry(), sharing, tree, config, failing) }

// worldOn is worldWith over the registry r (empty).
func worldOn(r work.Registry, sharing bool, tree Map[string, string], config string, failing string) World {
	let trees = NewCloner()
	let vcs = VcsOver(trees)
	let mut files = Map[string, string]{"main.ergo": "func main() {}\n", ".gitignore": "dist\nnode_modules\n"}
	for path, text in tree {
		let own = path == "" || strings.HasPrefix(path, ".git") || strings.HasPrefix(path, "dist") || strings.HasPrefix(path, "node_modules") || strings.HasSuffix(path, "/") || strings.Contains(path, "//") || path == "main.ergo"
		if !own {
			files[path] = text
		}
	}
	Repo(vcs, theBase, "main", files, "c0")
	let _ = Write(trees, theBase, "node_modules/left-pad/index.js", "module.exports = 1\n") && Write(trees, theBase, "node_modules/.bin/left-pad", "#!/bin/sh\n") && Write(trees, theBase, "dist/out.js", "built\n")
	let cloner = if sharing { trees } else { Refusing(trees) }
	let registry = r
	let disk = fstest.NewMemory()
	disk.MkdirAll(theBase) catch {
	case fs.Denied, fs.Failed:
		Unreachable("a folder of a memory disk")
	}
	if config != "" {
		disk.WriteFile(theBase+"/"+work.ConfigFile, config) catch {
		case fs.NotFound, fs.Denied, fs.Failed:
			Unreachable("a file of a memory disk")
		}
	}
	let clock = time.NewManual(1000)
	let lock = NewLock()
	let hooks = Recording(lock, failing)
	let runner = NewRunner()
	let p = work.Providers{Cloners: []work.Cloner{cloner}, Copier: Beside(trees, false), Registry: registry, Lock: lock, Hooks: hooks, Vcs: vcs, Files: disk, Writes: disk, Runner: runner, Clock: clock}
	let tool = work.NewTool(theBase, work.Home(theBase, ""), "/data", p, "/")
	let _ = tool.Init() catch {
	case work.BadConfig, work.Unkept, fs.Denied, fs.Failed:
		Unreachable("init of a memory base")
		""
	}
	World{tool: tool, trees: trees, vcs: vcs, registry: registry, clock: clock, disk: disk, hooks: hooks, lock: lock, runner: runner}
}

// fresh are new's options with only the copy flag.
func fresh(copy bool) work.NewOptions { work.NewOptions{Copy: copy, From: None, Branch: None, On: None, Token: None} }

// ToolAgreesWithTheReference: after every step, List names the records
// the reference holds, in its order, states and parents; every live
// workspace's tree is at its path, and a deleted one's is gone; a
// workspace ready handed is held by its parent's branch; a sync records
// the commit it merged as the base. A second base's trash is never
// touched.
law ToolAgreesWithTheReference(ops []Op, sharing bool, tree Map[string, string]) {
	let w = worldWith(sharing, tree, "", "")
	Repo(w.vcs, "/w/.work/other/.work-trash/x.1", "x", Map[string, string]{"f": "other"}, "o1")
	let mut want = []Expected{}
	let mut gone = []string{}
	let mut commits = 0
	for op in ops {
		let at = w.clock.Now().UnixSeconds()
		match op {
		case NewOp as o:
			let name = pick(o.Name)
			let made = w.tool.New(name, fresh(o.Copy)) catch {
			case _:
				nothing()
			}
			if made.Path != "" && !carries(w, made.Path) {
				return false
			}
			if !holds(want, name) {
				let e = Expected{Name: name, State: "active", Parent: theBase, Kept: true, Sure: true, Since: at, Path: work.Home(theBase, "") + "/" + work.FolderOf(name)}
				want = freed(want, name, if sharing || o.Copy { Some[Expected]{Value: e} } else { None })
			}
		case OnOp as o:
			let name = pick(o.Name)
			let on = pick(o.On)
			let made = (w.tool.New(name, work.NewOptions{Copy: true, From: None, Branch: None, On: Some[string]{Value: on}, Token: None}) catch {
			case _:
				nothing()
			}).Path
			match find(want, on) {
			case Some[Expected] as parent:
				let can = !holds(want, name) && parent.Value.State == "active"
				if made != "" && !can {
					return false
				}
				if can {
					let e = Expected{Name: name, State: "active", Parent: parent.Value.Path, Kept: false, Sure: false, Since: at, Path: made}
					want = freed(want, name, if made != "" { Some[Expected]{Value: e} } else { None })
				}
			case None:
				if made != "" {
					return false
				}
			}
		case RmOp as o:
			let name = pick(o.Name)
			let out = w.tool.Rm(name, work.RmOptions{Abandon: o.Abandon, Expect: None, Tree: false}) catch {
			case _:
				[]work.Removed{}
			}
			want = removed(want, name, o.Abandon, at, len(out) == 1 && out[0].Name == name, if len(out) == 1 { out[0].Id } else { "" })
		case EditOp as o:
			let name = pick(o.Name)
			match find(want, name) {
			case Some[Expected] as e:
				if e.Value.State == "active" && Write(w.trees, e.Value.Path, "edit.ergo", "// edit \(at)\n") {
					want = replaced(want, Expected{..e.Value, Kept: false, Sure: true})
				}
			case None:
			}
		case LandOp as o:
			let name = pick(o.Name)
			match find(want, name) {
			case Some[Expected] as e:
				if e.Value.State == "active" {
					commits = commits + 1
					let landed = Commit(w.vcs, e.Value.Path, "c\(commits)") && Land(w.vcs, e.Value.Path, e.Value.Parent)
					want = replaced(want, Expected{..e.Value, Kept: landed, Sure: landed})
				}
			case None:
			}
		case ReadyOp as o:
			let name = pick(o.Name)
			let handed = w.tool.Ready(work.ReadyOptions{Name: Some[string]{Value: name}, Request: None}) catch {
			case _:
				work.Handed{Name: "", Branch: "", Commit: "", Snapshot: "", Parent: ""}
			}
			match find(want, name) {
			case Some[Expected] as e:
				if e.Value.State == "active" && parentLive(want, e.Value) {
					if handed.Name != name || !handedHeld(w, e.Value, handed) {
						return false
					}
					want = replaced(want, Expected{..e.Value, Kept: true, Sure: true, Since: at})
				} else if handed.Name != "" {
					return false
				}
			case None:
				if handed.Name != "" {
					return false
				}
			}
		case SyncOp as o:
			let name = pick(o.Name)
			let theirs = (w.tool.Sync(work.SyncOptions{Name: Some[string]{Value: name}}) catch {
			case _:
				work.Synced{Commit: "", Deps: work.NoDeps}
			}).Commit
			if theirs != "" {
				if !synced(w, name, theirs) {
					return false
				}
				match find(want, name) {
				case Some[Expected] as e:
					want = replaced(want, Expected{..e.Value, Sure: false, Since: at})
				case None:
					return false
				}
			}
		case BaseOp:
			commits = commits + 1
			let _ = Write(w.trees, theBase, "main.ergo", "// base \(commits)\n") && Commit(w.vcs, theBase, "c\(commits)")
		case CrashOp as o:
			let name = pick(o.Name)
			if !named(want, name) {
				let path = work.Home(theBase, "") + "/" + work.FolderOf(name)
				w.registry.Put(work.Workspace{Name: name, Path: path, Parent: theBase, Branch: "", Cloner: "", State: work.Creating, Since: at, Base: "", Latest: "", Deps: "", Id: "crash-" + name, Token: "", Moving: "", Pinned: false, Until: 0}) catch {
				case work.Unkept:
				}
				Plant(w.trees, path, Map[string, string]{"half": "a clone cut short"})
				want = want.Append(Expected{Name: name, State: "creating", Parent: theBase, Kept: false, Sure: true, Since: at, Path: path})
			}
		case GcOp as o:
			let older = small(o.Older, 7200)
			let idle = if o.Idle > 0 { Some[string]{Value: "\(small(o.Idle, 7200))s"} } else { None }
			let out = w.tool.Gc(work.GcOptions{Older: Some[string]{Value: "\(older)s"}, Idle: idle, Id: None, Archive: false}) catch {
			case _:
				work.Collected{Purged: []string{}, Idle: []work.Idle{}}
			}
			if o.Idle > 0 {
				let found = idled(want, int64(small(o.Idle, 7200)), at)
				let mut reported = []string{}
				for i in out.Idle {
					reported = reported.Append(i.Name)
				}
				if reported != found {
					return false
				}
				for name in found {
					let i = slices.IndexFunc(out.Idle, func(i work.Idle) bool { i.Name == name && i.Removed })
					want = removed(want, name, false, at, i >= 0, if i >= 0 { out.Idle[i].Id } else { "" })
				}
			}
			let (kept, dropped) = collected(want, int64(older), at)
			want = kept
			gone = slices.Concat(gone, dropped)
		case WaitOp as o:
			w.clock.Advance(time.Times(1s, small(o.Seconds, 5000)))
		}
		if !agrees(w, want, gone) {
			return false
		}
	}
	w.trees.Has("/w/.work/other/.work-trash/x.1")
}

// UseKeepsAWorkspace: a ready (or a sync) is a use, so gc -idle after it
// leaves that workspace and removes one made at the same time and unused
// (the model property reaches a ready followed by an idle gc only now and
// then; this law always does).
law UseKeepsAWorkspace(sync bool) {
	let w = world(true)
	for name in []string{"a", "b"} {
		let _ = w.tool.New(name, fresh(false)) catch {
		case _:
			return false
		}
	}
	w.clock.Advance(time.Times(1s, 7200))
	if sync {
		let _ = w.tool.Sync(work.SyncOptions{Name: Some[string]{Value: "a"}}) catch {
		case _:
			return false
		}
	} else {
		let _ = w.tool.Ready(work.ReadyOptions{Name: Some[string]{Value: "a"}, Request: None}) catch {
		case _:
			return false
		}
	}
	let out = w.tool.Gc(work.GcOptions{Older: None, Idle: Some[string]{Value: "1h"}, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	len(out.Idle) == 1 && out.Idle[0].Name == "b" && out.Idle[0].Removed
}

// ArchiveKeepsTheWork: gc -idle -archive removes an idle workspace whose
// work its parent does not hold (b, made on a, with a file of its own)
// and its parent after it, and the base, not the parent that goes too,
// keeps b's work at ArchiveRef: the ref resolves there, and its tree is
// b's files as they were; a branch only b had (side) and a stash entry of
// b's are kept beside it, each at its commit. Without -archive both stay.
law ArchiveKeepsTheWork(text string, archive bool, side bool, stash bool) {
	let w = world(true)
	let _ = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let b = w.tool.New("b", work.NewOptions{Copy: false, From: None, Branch: None, On: Some[string]{Value: "a"}, Token: None}) catch {
	case _:
		return false
	}
	let sideCommit = if side { SideCommit(w.vcs, b.Path, "side", "side.txt", text) } else { "" }
	if stash && !(Write(w.trees, b.Path, "stashed.txt", text) && Stash(w.vcs, b.Path)) {
		return false
	}
	let stashCommit = if stash { maps.GetOr(Files(w.trees, b.Path), ".git/refs/stash/0", "") } else { "" }
	let _ = Write(w.trees, b.Path, "draft.txt", text)
	let files = Working(Files(w.trees, b.Path))
	w.clock.Advance(time.Times(1s, 7200))
	let out = w.tool.Gc(work.GcOptions{Older: None, Idle: Some[string]{Value: "1h"}, Id: None, Archive: archive}) catch {
	case _:
		return false
	}
	let gone = !w.trees.Has(b.Path)
	if !archive {
		return !gone && len(out.Idle) == 2 && out.Idle[0].Name == "b" && out.Idle[0].Why == "NotHeld" && out.Idle[0].Archived == ""
	}
	let ref = work.ArchiveRef("b", b.Id)
	let commit = w.vcs.Resolve(theBase, ref) catch {
	case _:
		return false
	}
	let tree = treeOf(w.vcs, theBase, commit) catch {
	case _:
		return false
	}
	let prefix = work.ArchivePrefix("b", b.Id)
	let keeps = func(to string, c string) bool {
		c == "" || (w.vcs.Resolve(theBase, to) catch {
		case _:
			""
		}) == c
	}
	gone && out.Idle[0].Archived == ref && out.Idle[0].Removed && tree == files && keeps(prefix+"/heads/side", sideCommit) && keeps(prefix+"/stash/0", stashCommit)
}

// IdleKeepsAStaleBranch: a clean idle workspace whose side branch only
// a remote-tracking ref holds (pushed, then deleted on the remote: the
// ref is stale) is not held for gc -idle (the verifier's M2): without
// -archive it stays NotHeld; with -archive it goes and the base keeps the
// branch, still there after the trash is purged. A branch on the
// remote's default branch (its HEAD, onDefault) is held, and it goes.
law IdleKeepsAStaleBranch(text string, archive bool, onDefault bool) {
	let w = world(true)
	let a = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let c = SideCommit(w.vcs, a.Path, "side", "side.txt", text)
	let ref = if onDefault { ".git/refs/remotes/origin/HEAD" } else { ".git/refs/remotes/origin/side" }
	if c == "" || !Write(w.trees, a.Path, ref, c) {
		return false
	}
	w.clock.Advance(time.Times(1s, 7200))
	let out = w.tool.Gc(work.GcOptions{Older: None, Idle: Some[string]{Value: "1h"}, Id: None, Archive: archive}) catch {
	case _:
		return false
	}
	if len(out.Idle) != 1 {
		return false
	}
	let gone = !w.trees.Has(a.Path)
	if onDefault {
		return gone && out.Idle[0].Removed && out.Idle[0].Archived == ""
	}
	if !archive {
		return !gone && out.Idle[0].Why == "NotHeld"
	}
	w.clock.Advance(time.Times(1s, 2*int(work.IdleTrash)))
	let purged = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let kept = w.vcs.Resolve(theBase, work.ArchivePrefix("a", a.Id)+"/heads/side") catch {
	case _:
		""
	}
	gone && out.Idle[0].Removed && len(purged.Purged) == 1 && kept == c
}

// RmKeepsEveryBranch: rm of a clean workspace whose head its parent
// holds refuses (NotHeld) while a branch only it has (kind 0) or a stash
// entry (kind 1) would go with it; a branch a remote-tracking ref holds
// is on the remote already (kind 2), and the workspace goes.
law RmKeepsEveryBranch(kind int, text string) {
	let w = world(true)
	let a = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let k = small(kind, 3)
	if k == 1 {
		if !(Write(w.trees, a.Path, "stashed.txt", text) && Stash(w.vcs, a.Path)) {
			return false
		}
	} else {
		let c = SideCommit(w.vcs, a.Path, "side", "side.txt", text)
		if c == "" || (k == 2 && !Write(w.trees, a.Path, ".git/refs/remotes/origin/side", c)) {
			return false
		}
	}
	let mut refused = false
	let _ = w.tool.Rm("a", work.RmOptions{Abandon: false, Expect: None, Tree: false}) catch {
	case work.NotHeld:
		refused = true
		[]work.Removed{}
	case _:
		return false
	}
	refused == (k != 2)
}

// PinKeepsAWorkspace: gc -idle never takes a pinned workspace (it reports
// it Pinned) and takes it again once unpinned; another idle one goes.
law PinKeepsAWorkspace(unpin bool) {
	let w = world(true)
	for name in []string{"a", "b"} {
		let _ = w.tool.New(name, fresh(false)) catch {
		case _:
			return false
		}
	}
	let pinned = w.tool.Pin("a") catch {
	case _:
		return false
	}
	if unpin {
		let _ = w.tool.Unpin("a") catch {
		case _:
			return false
		}
	}
	w.clock.Advance(time.Times(1s, 7200))
	let out = w.tool.Gc(work.GcOptions{Older: None, Idle: Some[string]{Value: "1h"}, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let a = slices.IndexFunc(out.Idle, func(i work.Idle) bool { i.Name == "a" && i.Removed == unpin && (unpin || i.Why == "Pinned") }) >= 0
	let b = slices.IndexFunc(out.Idle, func(i work.Idle) bool { i.Name == "b" && i.Removed }) >= 0
	pinned.Pinned && a && b
}

// InUseKeepsAWorkspace: gc -idle does not take a workspace the host says
// is in use (a file changed in the window, a process in it), and reports
// why; one it says nothing of goes.
law InUseKeepsAWorkspace(why string) {
	let w = world(true)
	let a = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	w.runner.Use(a.Path, why)
	w.clock.Advance(time.Times(1s, 7200))
	let out = w.tool.Gc(work.GcOptions{Older: None, Idle: Some[string]{Value: "1h"}, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let used = strings.TrimSpace(why)
	len(out.Idle) == 1 && out.Idle[0].Removed == (used == "") && (used == "" || (out.Idle[0].Why == "InUse" && out.Idle[0].Detail == used))
}

// IdleTrashWaitsADay: the trash of a workspace gc -idle removed is not
// purged by that gc nor by any gc within IdleTrash seconds; after them,
// gc purges it.
law IdleTrashWaitsADay(wait int) {
	let w = world(true)
	let _ = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	w.clock.Advance(time.Times(1s, 7200))
	let first = w.tool.Gc(work.GcOptions{Older: None, Idle: Some[string]{Value: "1h"}, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let s = small(wait, 2*work.IdleTrash)
	w.clock.Advance(time.Times(1s, s))
	let later = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	len(first.Idle) == 1 && first.Idle[0].Removed && len(first.Purged) == 0 && (len(later.Purged) == 1) == (s >= work.IdleTrash)
}

// NoTrashDeletesForGood: in a base whose work.toml says trash = false,
// rm -expect ID (or gc -idle, when viaGc) of a workspace whose work its
// parent holds deletes it for good at once: its folder and its trash
// folder are gone, rm names no trash, and no record of its id is left.
// One with a commit only it has is still refused (NotHeld) and stays.
// The delete takes that one id: a workspace trashed before the key was
// set keeps its record and its trash folder after rm (a gc purges it
// anyway, as any gc purges the trash).
law NoTrashDeletesForGood(viaGc bool, unsaved bool) {
	let w = world(true)
	let mut made = []work.Created{}
	for name in []string{"a", "b"} {
		let n = w.tool.New(name, fresh(false)) catch {
		case _:
			return false
		}
		made = made.Append(n)
	}
	let a = made[0]
	let b = made[1]
	let _ = w.tool.Rm("b", work.RmOptions{Abandon: false, Expect: Some[string]{Value: b.Id}, Tree: false}) catch {
	case _:
		return false
	}
	w.disk.WriteFile(theBase+"/"+work.ConfigFile, "[work]\ntrash = false\n") catch {
	case _:
		return false
	}
	if unsaved && SideCommit(w.vcs, a.Path, "side", "side.txt", "only here") == "" {
		return false
	}
	let mut removed = false
	let mut trash = "unread"
	if viaGc {
		w.clock.Advance(time.Times(1s, 7200))
		let out = w.tool.Gc(work.GcOptions{Older: None, Idle: Some[string]{Value: "1h"}, Id: None, Archive: false}) catch {
		case _:
			return false
		}
		let i = slices.IndexFunc(out.Idle, func(x work.Idle) bool { x.Name == "a" })
		if i < 0 || (!out.Idle[i].Removed && out.Idle[i].Why != "NotHeld") {
			return false
		}
		removed = out.Idle[i].Removed
		trash = ""
	} else {
		let out = w.tool.Rm("a", work.RmOptions{Abandon: false, Expect: Some[string]{Value: a.Id}, Tree: false}) catch {
		case work.NotHeld:
			[]work.Removed{}
		case _:
			return false
		}
		removed = len(out) == 1
		if removed {
			trash = out[0].Trash
		}
	}
	let at = w.clock.Now().UnixSeconds()
	let all = w.tool.List() catch {
	case _:
		return false
	}
	// gc purges every trash old enough, b's too: b is the rm path's check.
	let kept = viaGc || slices.IndexFunc(all, func(r work.Workspace) bool { r.Id == b.Id && work.InTrash(r.Path) && w.trees.Has(r.Path) }) >= 0
	if unsaved {
		return !removed && kept && w.trees.Has(a.Path)
	}
	let left = slices.IndexFunc(all, func(r work.Workspace) bool { r.Id == a.Id }) >= 0
	removed && trash == "" && kept && !left && !w.trees.Has(a.Path) && !w.trees.Has(work.TrashOf(a.Path, at, a.Id))
}

// StackRecordsItsParent: a workspace made -on another records that
// workspace's folder as its parent, on any tree (the model property
// reaches a stack only now and then; this law always does).
law StackRecordsItsParent(tree Map[string, string]) {
	let w = worldWith(true, tree, "", "")
	let a = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let _ = w.tool.New("b", work.NewOptions{Copy: false, From: None, Branch: None, On: Some[string]{Value: "a"}, Token: None}) catch {
	case _:
		return false
	}
	let all = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	slices.IndexFunc(all, func(r work.Workspace) bool { r.Name == "b" && r.Parent == a.Path }) >= 0
}

// MadeCloneOutlivesItsMaker: a new that dies between its clone and its
// activation (a `work new` killed by its caller) leaves a reservation
// whose clone is whole and marked, which an agent may already work in;
// gc, run by another process however old it asks, activates it and keeps
// its folder and what was written there, never deletes it (2026-11-17: gc
// deleted such a workspace with two commits). The folder of a reservation
// cut off before its marker, which nobody was handed, is still collected
// (CrashOp in the model).
law MadeCloneOutlivesItsMaker(text string) {
	let w = worldWith(true, Map[string, string]{"bun.lock": "lock \(len(text))\n"}, "[deps]\nlock = \"bun.lock\"\ninstall = \"bun install\"\n", "")
	let maker = Sharing(w.lock, 2)
	let t = toolOf(w, maker, []work.Cloner{w.trees})
	let reserved = t.Reserve("a", fresh(false)) catch {
	case _:
		return false
	}
	let made = match reserved {
	case work.Making as m:
		t.Fill(m) catch {
		case _:
			return false
		}
	case work.Created:
		return false
	}
	Die(maker)
	let _ = Write(w.trees, made.Path, "draft.txt", text)
	let _ = toolOf(w, Sharing(w.lock, 99), []work.Cloner{w.trees}).Gc(work.GcOptions{Older: Some[string]{Value: "0s"}, Idle: None, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let all = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	let kept = Files(w.trees, made.Path).Get("draft.txt") == Some[string]{Value: text}
	kept && slices.IndexFunc(all, func(r work.Workspace) bool { r.Name == "a" && r.Id == made.Id && work.StateName(r.State) == "active" }) >= 0 && w.lock.Holds() == 0
}

// ActivatedCloneIsRecordedAsMade: the record gc writes for a clone whose
// maker died after its marker names what Activate's would: the cloner
// that made it (so gc and rm discard it by that cloner, a btrfs
// snapshot as one) and the digest of the lock it carries (so deps does
// not reinstall what the clone already holds: work deps finds it
// unchanged and starts nothing), as a workspace made in full beside it
// has.
law ActivatedCloneIsRecordedAsMade(lock string) {
	let w = worldWith(true, Map[string, string]{}, "[deps]\nlock = \"bun.lock\"\ninstall = \"bun install\"\n", "")
	let maker = Sharing(w.lock, 2)
	let t = toolOf(w, maker, []work.Cloner{w.trees})
	let reserved = t.Reserve("a", fresh(false)) catch {
	case _:
		return false
	}
	let made = match reserved {
	case work.Making as m:
		t.Fill(m) catch {
		case _:
			return false
		}
	case work.Created:
		return false
	}
	Die(maker)
	// The lock the clone carries, as one cloned with the base's would.
	w.disk.WriteFile(made.Path+"/bun.lock", lock) catch {
	case fs.NotFound, fs.Denied, fs.Failed:
		return false
	}
	let _ = w.tool.New("b", fresh(false)) catch {
	case _:
		return false
	}
	let _ = toolOf(w, Sharing(w.lock, 99), []work.Cloner{w.trees}).Gc(work.GcOptions{Older: Some[string]{Value: "0s"}, Idle: None, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let all = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	let a = slices.IndexFunc(all, func(r work.Workspace) bool { r.Name == "a" && work.StateName(r.State) == "active" })
	let b = slices.IndexFunc(all, func(r work.Workspace) bool { r.Name == "b" })
	let runs = len(w.runner.Ran())
	let deps = w.tool.Deps(work.DepsOptions{Name: Some[string]{Value: "a"}}) catch {
	case _:
		return false
	}
	let unchanged = match deps {
	case work.Unchanged:
		true
	case work.Installed, work.NoDeps:
		false
	}
	a >= 0 && b >= 0 && all[a].Cloner != "" && all[a].Cloner == all[b].Cloner && unchanged && len(w.runner.Ran()) == runs
}

// nothing is the answer of a new that failed.
func nothing() work.Created { work.Created{Name: "", Id: "", Path: "", Branch: "", Deps: work.NoDeps, Hooks: work.HooksRan{Count: 0}} }

// carries reports whether the clone at path holds the base's installed
// packages and ignored build output: a clone copies everything.
func carries(w World, path string) bool {
	let files = Files(w.trees, path)
	files.Get("node_modules/left-pad/index.js") != None && files.Get("node_modules/.bin/left-pad") != None && files.Get("dist/out.js") != None
}

// handedHeld reports whether the parent's branch holds the workspace's
// head, as ready said, and the parent keeps the snapshot it named.
func handedHeld(w World, e Expected, h work.Handed) bool {
	let head = w.vcs.Head(e.Path) catch {
	case work.VcsFailed:
		return false
	}
	let snapshot = w.vcs.Ref(e.Parent, work.SnapshotRef(e.Name)) catch {
	case work.VcsFailed:
		return false
	}
	h.Commit == head && h.Parent == e.Parent && snapshot != "" && maps.GetOr(w.vcs.store.Get().commits, snapshot, Node{Tree: "", Parents: []string{}}).Tree == h.Snapshot
}

// synced reports whether a sync of name that merged theirs left it
// recorded as the workspace's base, and its head contains it.
func synced(w World, name string, theirs string) bool {
	let all = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	for r in all {
		if r.Name == name {
			let head = w.vcs.Head(r.Path) catch {
			case work.VcsFailed:
				return false
			}
			return r.Base == theirs && reaches(w.vcs.store.Get(), head, theirs)
		}
	}
	false
}

// agrees reports whether the Tool's list and trees are the reference's:
// the records in order, and the trashed ones whose name a new took again
// (work.TrashedName; the reference's name~) by their folders.
func agrees(w World, want []Expected, gone []string) bool {
	let all = w.tool.List() catch {
	case work.NoBase, work.Unkept:
		return false
	}
	let got = slices.Filter(all, func(g work.Workspace) bool { !strings.Contains(g.Name, "~") })
	let wanted = slices.Filter(want, func(e Expected) bool { !strings.HasSuffix(e.Name, "~") })
	let freedGot = freedOf(all)
	let freedWant = freedIn(want)
	if len(got) != len(wanted) || freedGot != freedWant || len(all) != len(want) {
		return false
	}
	for i, g in got {
		let e = wanted[i]
		if g.Name != e.Name || work.StateName(g.State) != e.State || g.Parent != e.Parent {
			return false
		}
		if !w.trees.Has(g.Path) {
			return false
		}
		if e.State != "trashed" && g.Path != e.Path {
			return false
		}
	}
	for path in gone {
		// A deleted path a later workspace took again is that one's.
		let retaken = slices.IndexFunc(want, func(e Expected) bool { e.Path == path }) >= 0
		if !retaken && w.trees.Has(path) {
			return false
		}
	}
	true
}

// removed is the reference after rm of name at the second at: a leaf (no
// live workspace is made on it) that is creating, or active with its work
// kept or abandoned, goes to the trash; any other stays. Where the
// reference is not sure of the kept flag, trashed (the Tool's answer)
// decides.
func removed(want []Expected, name string, abandon bool, at int64, trashed bool, id string) []Expected {
	match find(want, name) {
	case Some[Expected] as e:
		if slices.IndexFunc(want, func(c Expected) bool { c.Parent == e.Value.Path && c.State != "trashed" }) >= 0 {
			return want
		}
		let keptNow = if e.Value.Sure && parentLive(want, e.Value) { e.Value.Kept } else { trashed }
		let goes = e.Value.State == "creating" || (e.Value.State == "active" && (keptNow || abandon))
		if goes {
			return replaced(want, Expected{..e.Value, State: "trashed", Since: at, Path: work.TrashOf(e.Value.Path, at, id)})
		}
		want
	case None:
		want
	}
}

// idled is the names gc -idle at the second at finds: each active one
// no new, ready or sync touched for idle seconds, the last made first.
func idled(want []Expected, idle int64, at int64) []string {
	let mut out = []string{}
	for i in 0..len(want) {
		let e = want[len(want)-1-i]
		if e.State == "active" && at-e.Since >= idle {
			out = out.Append(e.Name)
		}
	}
	out
}

// collected is the reference after gc at the second at with the age
// older: the records that stay, and the paths deleted. A reservation's
// maker is gone (the crash), so gc collects it at any age.
func collected(want []Expected, older int64, at int64) ([]Expected, []string) {
	let mut kept = []Expected{}
	let mut dropped = []string{}
	for e in want {
		let age = at - e.Since
		if (e.State == "trashed" && age >= older) || e.State == "creating" {
			dropped = dropped.Append(e.Path)
		} else {
			kept = kept.Append(e)
		}
	}
	(kept, dropped)
}

// parentLive reports whether e's parent is the base or a workspace the
// reference holds at that path and has not trashed.
func parentLive(want []Expected, e Expected) bool {
	e.Parent == theBase || slices.IndexFunc(want, func(p Expected) bool { p.Path == e.Parent && p.State != "trashed" }) >= 0
}

func named(want []Expected, name string) bool { find(want, name) != None }

// holds reports whether a record of name that is not trashed holds it.
func holds(want []Expected, name string) bool {
	match find(want, name) {
	case Some[Expected] as e:
		e.Value.State != "trashed"
	case None:
		false
	}
}

// freed is the reference after a new of name reserved it: a trashed
// record of name is renamed name~ (work.TrashedName) to the end, and the
// new record made, when it was, comes after it.
func freed(want []Expected, name string, made Option[Expected]) []Expected {
	let mut out = []Expected{}
	let mut tail = []Expected{}
	for x in want {
		if x.Name == name && x.State == "trashed" {
			tail = tail.Append(Expected{..x, Name: name + "~"})
		} else {
			out = out.Append(x)
		}
	}
	match made {
	case Some[Expected] as e:
		tail = tail.Append(e.Value)
	case None:
	}
	slices.Concat(out, tail)
}

func find(want []Expected, name string) Option[Expected] {
	for e in want {
		if e.Name == name {
			return Some[Expected]{Value: e}
		}
	}
	None
}

func replaced(want []Expected, e Expected) []Expected {
	let mut out = []Expected{}
	for x in want {
		if x.Name == e.Name {
			out = out.Append(e)
		} else {
			out = out.Append(x)
		}
	}
	out
}

// InitExcludesAnUntrackedConfig: init keeps a work.toml the base does
// not track out of its status (and so of every clone's) by the base's
// own .git/info/exclude; a committed one it leaves to Git.
law InitExcludesAnUntrackedConfig(committed bool) {
	let tree = if committed { Map[string, string]{work.ConfigFile: "[work]\n"} } else { Map[string, string]{} }
	let w = worldWith(true, tree, "", "")
	let exclude = maps.GetOr(Files(w.trees, theBase), ".git/info/exclude", "")
	strings.Contains(exclude, "/"+work.ConfigFile+"\n") != committed
}

// RmThenNewTakesTheName: a trashed workspace does not hold its name: new
// of the name rm just trashed succeeds with a fresh id, before any gc;
// the trash stays listed under TrashedName with its id, and gc purges it
// and leaves the new one.
law RmThenNewTakesTheName(name int) {
	let w = world(true)
	let n = pick(name)
	let first = w.tool.New(n, fresh(false)) catch {
	case _:
		return false
	}
	let _ = w.tool.Rm(n, work.RmOptions{Abandon: false, Expect: None, Tree: false}) catch {
	case _:
		return false
	}
	let second = w.tool.New(n, fresh(false)) catch {
	case _:
		return false
	}
	let listed = w.tool.List() catch {
	case _:
		return false
	}
	let trash = slices.IndexFunc(listed, func(r work.Workspace) bool { r.Name == work.TrashedName(n, first.Id) && r.Id == first.Id && work.StateName(r.State) == "trashed" }) >= 0
	let out = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let after = w.tool.List() catch {
	case _:
		return false
	}
	second.Id != first.Id && trash && out.Purged == []string{work.TrashedName(n, first.Id)} && len(after) == 1 && after[0].Id == second.Id
}

// freedOf is each trashed record of the Tool's whose name a new took
// again, as its old name, a tilde and its folder, sorted.
func freedOf(all []work.Workspace) []string {
	let mut out = []string{}
	for g in all {
		if strings.Contains(g.Name, "~") && work.StateName(g.State) == "trashed" {
			out = out.Append(strings.Split(g.Name, "~")[0] + "~" + g.Path)
		}
	}
	slices.Sort(out)
}

// freedIn is freedOf of the reference.
func freedIn(want []Expected) []string {
	let mut out = []string{}
	for e in want {
		if strings.HasSuffix(e.Name, "~") {
			out = out.Append(e.Name + e.Path)
		}
	}
	slices.Sort(out)
}

// RemovedAgainInOneSecond: new, rm, new, rm of one name in the same
// second each trash their own folder: every rm succeeds, every trash is
// listed with its id, and gc purges them all (the Mac's T3).
law RemovedAgainInOneSecond(name int, times int) {
	let w = world(true)
	let n = pick(name)
	let k = 2 + small(times, 3)
	let mut ids = []string{}
	for _ in 0..k {
		let made = w.tool.New(n, fresh(false)) catch {
		case _:
			return false
		}
		let out = w.tool.Rm(n, work.RmOptions{Abandon: false, Expect: None, Tree: false}) catch {
		case _:
			return false
		}
		if len(out) != 1 || out[0].Id != made.Id || out[0].Already {
			return false
		}
		ids = ids.Append(made.Id)
	}
	let listed = w.tool.List() catch {
	case _:
		return false
	}
	let mut trashes = []string{}
	for r in listed {
		if work.StateName(r.State) != "trashed" || r.Moving != "" || !w.trees.Has(r.Path) || slices.Contains(trashes, r.Path) {
			return false
		}
		trashes = trashes.Append(r.Path)
	}
	let out = w.tool.Gc(work.GcOptions{Older: None, Idle: None, Id: None, Archive: false}) catch {
	case _:
		return false
	}
	let after = w.tool.List() catch {
	case _:
		return false
	}
	len(listed) == k && len(trashes) == k && len(out.Purged) == k && len(after) == 0
}

// CloneLeavesTheRiftMarker: new of a base that holds Rift's marker
// (.rift, the copy's id) clones every other file, and no workspace holds
// the marker, made on the base or on another workspace (WK-MARKER).
law CloneLeavesTheRiftMarker(id string, on bool) {
	let w = world(true)
	if !Write(w.trees, theBase, work.RiftMarker, id+"\n") || !Write(w.trees, theBase, "kept.txt", id) {
		return false
	}
	let a = w.tool.New("a", fresh(false)) catch {
	case _:
		return false
	}
	let made = if on {
		(w.tool.New("b", work.NewOptions{Copy: false, From: None, Branch: None, On: Some[string]{Value: "a"}, Token: None}) catch {
		case _:
			return false
		}).Path
	} else {
		a.Path
	}
	let files = Files(w.trees, made)
	files.Get(work.RiftMarker) == None && files.Get("kept.txt") == Some[string]{Value: id} && Files(w.trees, theBase).Get(work.RiftMarker) != None
}

// BasesAreTheLiveOnes: of the bases init registered, bases lists those
// whose folder is there, in order; prune-bases forgets exactly the gone
// ones and leaves the list the live ones; forget-base drops one base, gone
// or live, and nothing else (the Mac's WK-BASES: a scratch base a test
// registered and deleted sent a caller into a missing folder).
law BasesAreTheLiveOnes(live []bool, forget int) {
	let w = world(true)
	let mut lines = []string{theBase}
	let mut want = []string{theBase}
	let mut gone = []string{}
	for i, here in live {
		let b = "/elsewhere/b\(i)"
		lines = lines.Append(b)
		if here {
			w.disk.MkdirAll(b) catch {
			case _:
				return false
			}
			want = want.Append(b)
		} else {
			gone = gone.Append(b)
		}
	}
	w.disk.WriteFile(work.BasesFile("/data"), strings.Join(lines, "\n")+"\n") catch {
	case _:
		return false
	}
	let listed = w.tool.Bases() catch {
	case _:
		return false
	}
	let k = small(forget, len(lines))
	let left = w.tool.ForgetBase(lines[k]) catch {
	case _:
		return false
	}
	let wantLeft = slices.Filter(lines, func(b string) bool { b != lines[k] })
	let pruned = w.tool.PruneBases() catch {
	case _:
		return false
	}
	let after = w.tool.Bases() catch {
	case _:
		return false
	}
	let liveLeft = slices.Filter(want, func(b string) bool { b != lines[k] })
	// The list itself no longer names a gone base: the next walker of the
	// file (journal.BaseHolding, an older work) does not meet one either.
	let file = w.disk.ReadFile(work.BasesFile("/data")) catch {
	case _:
		return false
	}
	let kept = if len(liveLeft) == 0 { "" } else { strings.Join(liveLeft, "\n") + "\n" }
	listed == want && left == wantLeft && pruned == slices.Filter(gone, func(b string) bool { b != lines[k] }) && after == liveLeft && file == kept
}

// AdoptLeavesPushesToTheOwner: adopt writes no push guard into the copy
// it takes (its pushes are its owner's: the Mac's fork); a copy an older
// adopt guarded is noted by doctor and, with -unguard, loses that guard
// and no push URL of the owner's; a workspace new made keeps its guard
// either way.
law AdoptLeavesPushesToTheOwner(own bool) {
	let w = world(true)
	let made = w.tool.New("n", fresh(false)) catch {
	case _:
		return false
	}
	Repo(w.vcs, "/w/fresh", "main", Map[string, string]{"a.txt": "a\n"}, "c7")
	Repo(w.vcs, "/w/old", "main", Map[string, string]{"a.txt": "a\n"}, "c8")
	let mine = if own { "https://example.invalid/fork.git" } else { Guard }
	let _ = Write(w.trees, "/w/old", ".git/config/remote.origin.pushurl", mine)
	let before = Files(w.trees, "/w/fresh")
	let _ = w.tool.Adopt("/w/fresh", work.AdoptOptions{Name: None}) catch {
	case _:
		return false
	}
	let _ = w.tool.Adopt("/w/old", work.AdoptOptions{Name: None}) catch {
	case _:
		return false
	}
	let o = work.DoctorOptions{Rift: false, Registry: None, Unguard: false, Fix: false}
	let noted = w.tool.Doctor(o) catch {
	case _:
		return false
	}
	let note = slices.Contains(noted.Notes, "1 adopted workspaces carry the push guard an older adopt wrote: run work doctor -unguard")
	let still = Files(w.trees, "/w/old").Get(".git/config/remote.origin.pushurl") == Some[string]{Value: mine}
	let fixed = w.tool.Doctor(work.DoctorOptions{..o, Unguard: true}) catch {
	case _:
		return false
	}
	let left = Files(w.trees, "/w/old").Get(".git/config/remote.origin.pushurl")
	let newKept = Files(w.trees, made.Path).Get(".git/config/remote.origin.pushurl") == Some[string]{Value: Guard}
	let fixedNote = slices.Contains(fixed.Notes, "dropped the push guard of 1 adopted workspaces")
	Files(w.trees, "/w/fresh") == before && still && newKept && note == !own && fixedNote == !own && left == (if own { Some[string]{Value: mine} } else { None })
}

// ledgerPath and ledgerLine are the mutant ledger of the merge laws and
// the attributes line that gives it the rows driver, as this
// repository's .gitattributes does.
let ledgerPath = "a/testdata/mutants.json"
let ledgerLine = "**/testdata/mutants.json merge=ergo-rows\n"

// ledger is a mutant ledger whose rows are named by names, each row's
// `to` the value of the same index in tos.
func ledger(names []string, tos []string) string {
	let mut rows = []string{}
	for i, n in names {
		rows = rows.Append("    {\"name\":\"\(n)\",\"from\":\"x\",\"to\":\"\(tos[i])\"}")
	}
	"{\n  \"about\": \"t\",\n  \"mutants\": [\n" + strings.Join(rows, ",\n") + "\n  ]\n}\n"
}

// unregistered drops work's merge drivers from the configuration of the
// checkout at root, as a base made before work wrote them has none.
func unregistered(w World, root string) {
	for kv in work.DriverSettings() {
		let _ = Unlink(w.trees, root, ".git/config/"+kv[0])
	}
	let _ = Unlink(w.trees, root, ".git/config/"+work.DriversKey)
}

// NewWorkspaceMergesByClass: in a base whose .gitattributes gives its
// ledger the rows driver and whose Git config names no driver (a base
// made before work wrote them), a workspace new makes, or a copy adopt
// took and doctor -fix fixed, merges the base's branch that edits one
// row into its own edit of another row and its new row with Git's merge
// (Sync), clean, to merge-file's answer (classes.Merge by rows), and its
// config has rerere.enabled. Without the fix the adopted copy's merge
// conflicts, as the model's merge of a file both sides changed does.
law NewWorkspaceMergesByClass(rows int, mine int, theirs int, adopt bool) {
	let k = 2 + small(rows, 4)
	let mut names = []string{}
	let mut tos = []string{}
	for i in 0..k {
		names = names.Append("r\(i)")
		tos = tos.Append("y")
	}
	let i = small(mine, k)
	let j = (i + 1 + small(theirs, k-1)) % k
	let base = ledger(names, tos)
	let mut oursTos = slices.Clone(tos)
	oursTos[i] = "ours"
	let ours = ledger(names.Append("m"), oursTos.Append("y"))
	let mut theirsTos = slices.Clone(tos)
	theirsTos[j] = "theirs"
	let other = ledger(names, theirsTos)
	let w = worldWith(true, Map[string, string]{ledgerPath: base}, "", "")
	unregistered(w, theBase)
	if !attributed(w, theBase) || !Commit(w.vcs, theBase, "c1") {
		return false
	}
	let root = if adopt {
		"/w/copy"
	} else {
		(w.tool.New("ws", fresh(false)) catch {
		case _:
			return false
		}).Path
	}
	if adopt {
		// A copy work did not make (as Rift made them): the base's files
		// and Git folder, with no driver configured.
		w.trees.Clone(theBase, root) catch {
		case _:
			return false
		}
		if !attributed(w, root) {
			return false
		}
		let _ = w.tool.Adopt(root, work.AdoptOptions{Name: None}) catch {
		case _:
			return false
		}
	}
	let side = SideCommit(w.vcs, theBase, "side", ledgerPath, other)
	if side == "" || !Write(w.trees, root, ledgerPath, ours) || !Commit(w.vcs, root, "c-ours") {
		return false
	}
	if adopt {
		// The model's merge of a file both sides changed, with no driver,
		// is a conflict: the one doctor -fix ends.
		let before = w.vcs.Merge(root, theBase, "side") catch {
		case work.Conflicted:
			"conflicted"
		case work.VcsFailed:
			return false
		}
		if before != "conflicted" {
			return false
		}
		let _ = w.tool.Doctor(work.DoctorOptions{Rift: false, Registry: None, Unguard: false, Fix: true}) catch {
		case _:
			return false
		}
	}
	let _ = w.vcs.Merge(root, theBase, "side") catch {
	case _:
		return false
	}
	let want = classes.Merge(classes.Rows, base, ours, other) catch {
	case classes.Unreadable:
		return false
	}
	let files = Files(w.trees, root)
	len(want.Conflicts) == 0 && files.Get(ledgerPath) == Some[string]{Value: want.Text} && files.Get(".git/config/rerere.enabled") == Some[string]{Value: "true"}
}

// attributed gives the checkout at root the ledger's attributes line, in
// its tree and on the disk (one file on a host; the memory providers
// keep Git's trees and the files work reads apart).
func attributed(w World, root string) bool {
	if !Write(w.trees, root, ".gitattributes", ledgerLine) {
		return false
	}
	w.disk.MkdirAll(root) catch {
	case _:
		return false
	}
	w.disk.WriteFile(root+"/.gitattributes", ledgerLine) catch {
	case _:
		return false
	}
	true
}

// DoctorSeesAnUnregisteredDriver: doctor names an adopted copy whose
// attributes give a file a driver its Git config lacks, and a merge line
// of the base that takes no file; with -fix the copy's drivers are
// registered and a second doctor is quiet about it; the base, which init
// registered, is never named.
law DoctorSeesAnUnregisteredDriver(fix bool, gone bool) {
	let w = worldWith(true, Map[string, string]{ledgerPath: ledger([]string{"r0"}, []string{"y"})}, "", "")
	if !attributed(w, theBase) || !Commit(w.vcs, theBase, "c1") {
		return false
	}
	let copy = "/w/copy"
	w.trees.Clone(theBase, copy) catch {
	case _:
		return false
	}
	unregistered(w, copy)
	if !attributed(w, copy) {
		return false
	}
	if gone {
		w.disk.WriteFile(theBase+"/.gitattributes", ledgerLine+"gone/ledger.json merge=ergo-rows\n") catch {
		case _:
			return false
		}
	}
	let _ = w.tool.Adopt(copy, work.AdoptOptions{Name: None}) catch {
	case _:
		return false
	}
	let o = work.DoctorOptions{Rift: false, Registry: None, Unguard: false, Fix: fix}
	let first = w.tool.Doctor(o) catch {
	case _:
		return false
	}
	let second = w.tool.Doctor(work.DoctorOptions{..o, Fix: false}) catch {
	case _:
		return false
	}
	let lacks = copy + ": its attributes name merge drivers its Git config lacks (ergo-rows), so Git merges those files as text: run work doctor -fix"
	let named = slices.Contains(first.Notes, lacks)
	let fixedNote = slices.Contains(first.Notes, "registered the merge drivers of \(copy)")
	let registered = (w.vcs.Setting(copy, "merge.ergo-rows.driver") catch {
	case work.VcsFailed:
		return false
	}) != ""
	let baseNamed = slices.IndexFunc(first.Notes, func(n string) bool { strings.HasPrefix(n, theBase+":") }) >= 0
	let goneNamed = slices.Contains(first.Notes, "the merge line gone/ledger.json takes no file of the base")
	let ledgerNamed = slices.IndexFunc(first.Notes, func(n string) bool { strings.Contains(n, "**/testdata") }) >= 0
	named == !fix && fixedNote == fix && registered == fix && slices.Contains(second.Notes, lacks) == !fix && !baseNamed && goneNamed == gone && !ledgerNamed
}
