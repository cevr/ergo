// The work.Lock law on the host, in a folder of each case's own
// (TestAmbient): each hold takes a kernel file lock (fs.LockFile) on a
// file in the folder.

import fs
import github.com/cevr/ergo/modules/work/work

let onHost = context needs TestAmbient { work.Lock: NewLock(fs.NewTestHost(), ".", 0s) }
