import github.com/cevr/ergo/modules/work/memory
import github.com/cevr/ergo/modules/work/work
import strings

// TornWriteIsDropped: a line a crash cut short (any prefix of a put with
// no newline) is not a record, and the records before it stay.
law TornWriteIsDropped(kept work.Workspace, torn work.Workspace, cut int) {
	let line = PutLine(torn)
	let n = ((cut % line.Len()) + line.Len()) % line.Len()
	let text = PutLine(kept) + strings.Slice(line, 0, n)
	let records = Replay(text) catch {
	case work.Unkept:
		return false
	}
	records == []work.Workspace{kept}
}

// ReplayIsTheMemoryRegistry: the journal's records after any puts and
// drops are the memory registry's.
law ReplayIsTheMemoryRegistry(puts []work.Workspace, drops []int) {
	let r = NewRegistry()
	let mut want = []work.Workspace{}
	for i, w in puts {
		r.Put(w) catch {
		case work.Unkept:
			return false
		}
		want = memory.Kept(want, w)
		if i < drops.Len() && drops[i]%2 == 0 && want.Len() > 0 {
			let name = want[((drops[i]%want.Len())+want.Len())%want.Len()].Name
			r.Drop(name) catch {
			case work.Unkept:
				return false
			}
			want = memory.Dropped(want, name)
		}
	}
	let got = r.All() catch {
	case work.Unkept:
		return false
	}
	got == want
}
