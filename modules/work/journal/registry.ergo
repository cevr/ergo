// Package journal is a work.Registry kept in a plain-text journal. The
// first line of a versioned journal names its format and the Work build
// that wrote it. Each record is a word and tab-separated fields (a tab
// in a quoted field is \t, so a literal tab only separates):
//
//	format	1	"work COMMIT built DATE"
//	put	"name"	"path"	"parent"	"branch"	"cloner"	active	1763164800	"base"	"latest"	"id"	"deps"	"token"	"moving"	-	0
//	drop	"name"
//	tomb	"name"	1763164800	"id"
//	buried	"id"	1763164800
//
// A put of seven fields (before the base and the latest snapshot were
// recorded) reads with both empty; one of nine (before the id and the
// install's digest) reads with those empty; one of eleven (before the
// token and the intent) reads with those empty. A tomb forgets the record
// of its name and keeps its id; a buried line is a tomb Compact kept.
//
// A reader checks the format before replaying any row. No header means
// a legacy journal, still readable. Under the registry lock, its first
// mutation atomically replaces it with the header, its complete rows,
// and the mutation. A normal write is one append of one line; readers
// ignore a torn suffix and writers remove it before adding a record.
// Compact atomically replaces the file with a header, records and recent
// tombs. Readers see the old file or the new one.
//
// Go control: an append-only text log replayed at each read (a
// write-ahead log with a checkpoint by rewrite).

import fs
import fstest
import github.com/cevr/ergo/modules/work/memory
import github.com/cevr/ergo/modules/work/work
import strconv
import strings

// Registry is the journal at path.
type Registry { files fs.Files, writes fs.Writes, path string, writer string } implements work.Registry

// Open is the registry of the journal at path. The file is read at each
// All, so a second process's records are seen.
func Open(files fs.Files, writes fs.Writes, path string, writer string) Registry {
	Registry{files: files, writes: writes, path: path, writer: writer}
}

// NewRegistry is a registry over an empty memory disk: the laws' value.
func NewRegistry() Registry {
	let disk = fstest.NewMemory()
	Open(disk, disk, "/registry", "work journal test build")
}

func Put(r Registry, w work.Workspace) fails work.Unkept { try appendLine(r, PutLine(w)) }

func Drop(r Registry, name string) fails work.Unkept { try appendLine(r, "drop\t"+strconv.Quote(name)+"\n") }

func All(r Registry) []work.Workspace fails work.Unkept {
	let (records, _) = try read(r)
	records
}

func Bury(r Registry, name string, at int64) fails work.Unkept {
	let text = try load(r)
	let versioned = try checkFormat(text)
	let (records, _) = try replayRows(text, versioned)
	for w in records {
		if w.Name == name {
			try appendChecked(r, text, versioned, "tomb\t"+strconv.Quote(name)+"\t"+strconv.FormatInt(at, 10)+"\t"+strconv.Quote(w.Id)+"\n")
			return
		}
	}
}

func Tombs(r Registry) []work.Tomb fails work.Unkept {
	let (_, tombs) = try read(r)
	tombs
}

func Compact(r Registry, since int64) fails work.Unkept {
	let (records, tombs) = try read(r)
	let mut text = formatLine(r.writer)
	for w in records {
		text = text + PutLine(w)
	}
	for t in memory.Recent(tombs, since) {
		text = text + TombLine(t)
	}
	try replace(r, text)
}

func replace(r Registry, text string) fails work.Unkept {
	r.writes.WriteFile(r.path, text) catch {
	case fs.NotFound:
		return work.Unkept{Reason: "\(r.path): its folder is not there; run work init"}
	case fs.Denied:
		return work.Unkept{Reason: "\(r.path): permission denied"}
	case fs.Failed as f:
		return work.Unkept{Reason: "\(r.path): \(f.Reason)"}
	}
}

// read is the records and tombs of the journal.
func read(r Registry) ([]work.Workspace, []work.Tomb) fails work.Unkept {
	try ReplayAll(try load(r))
}

func load(r Registry) string fails work.Unkept {
	r.files.ReadFile(r.path) catch {
	case fs.NotFound:
		""
	case fs.Denied:
		return work.Unkept{Reason: "\(r.path): permission denied"}
	case fs.Failed as f:
		return work.Unkept{Reason: "\(r.path): \(f.Reason)"}
	}
}

// TombLine is the line of a compacted tomb: its id and time, with no
// record to forget.
func TombLine(t work.Tomb) string { "buried\t" + strconv.Quote(t.Id) + "\t" + strconv.FormatInt(t.Since, 10) + "\n" }

func appendLine(r Registry, line string) fails work.Unkept {
	let text = try load(r)
	let versioned = try checkFormat(text)
	if !versioned {
		let _ = try replayRows(text, false)
	}
	try appendChecked(r, text, versioned, line)
}

func appendChecked(r Registry, text string, versioned bool, line string) fails work.Unkept {
	if !versioned || !strings.HasSuffix(text, "\n") {
		let complete = strings.Slice(text, 0, strings.LastIndex(text, "\n")+1)
		try replace(r, (if versioned { "" } else { formatLine(r.writer) }) + complete + line)
		return
	}
	r.writes.AppendFile(r.path, line) catch {
	case fs.NotFound:
		return work.Unkept{Reason: "\(r.path): its folder is not there; run work init"}
	case fs.Denied:
		return work.Unkept{Reason: "\(r.path): permission denied"}
	case fs.Failed as f:
		return work.Unkept{Reason: "\(r.path): \(f.Reason)"}
	}
}

// RegistryFormat is the protocol epoch (row layout and recovery rules).
// A writer changes it when the earlier recovery rules cannot safely use
// its journal, even if each individual workspace row has the same shape.
let RegistryFormat = "1"

func formatLine(writer string) string { "format\t"+RegistryFormat+"\t"+strconv.Quote(writer)+"\n" }

func checkFormat(text string) bool fails work.Unkept {
	let end = strings.IndexByte(text, '\n')
	let first = if end < 0 { text } else { strings.Slice(text, 0, end) }
	if first != "format" && !strings.HasPrefix(first, "format\t") {
		return false
	}
	let fields = strings.Split(first, "\t")
	if end < 0 || len(fields) != 3 || fields[1] == "" {
		return bad(0, "incomplete format header; preserve the registry and recover it from a backup")
	}
	let writer = try field(0, fields[2])
	if fields[1] != RegistryFormat {
		return work.Unkept{Reason: "registry format \(fields[1]) was written by \(writer); use Work from that build or a newer build that supports registry format \(fields[1]); do not edit the header"}
	}
	true
}

// PutLine is the journal line of a put of w.
func PutLine(w work.Workspace) string {
	let fields = []string{"put", strconv.Quote(w.Name), strconv.Quote(w.Path), strconv.Quote(w.Parent), strconv.Quote(w.Branch), strconv.Quote(w.Cloner), work.StateName(w.State), strconv.FormatInt(w.Since, 10), strconv.Quote(w.Base), strconv.Quote(w.Latest), strconv.Quote(w.Id), strconv.Quote(w.Deps), strconv.Quote(w.Token), strconv.Quote(w.Moving), if w.Pinned { "pinned" } else { "-" }, strconv.FormatInt(w.Until, 10)}
	strings.Join(fields, "\t") + "\n"
}

// Replay is the records of a journal's text: each whole line in order,
// the text after the last newline (a write a crash cut short) dropped.
func Replay(text string) []work.Workspace fails work.Unkept {
	let (records, _) = try ReplayAll(text)
	records
}

// ReplayAll is the records and the tombs of a journal's text.
func ReplayAll(text string) ([]work.Workspace, []work.Tomb) fails work.Unkept {
	try replayRows(text, try checkFormat(text))
}

func replayRows(text string, versioned bool) ([]work.Workspace, []work.Tomb) fails work.Unkept {
	let mut records = []work.Workspace{}
	let mut tombs = []work.Tomb{}
	let lines = strings.Split(text, "\n")
	for i, line in lines {
		if i == len(lines)-1 || line == "" || (i == 0 && versioned) {
			continue
		}
		let fields = strings.Split(line, "\t")
		match fields[0] {
		case "tomb":
			if len(fields) != 4 {
				return bad(i, "a tomb has 3 fields")
			}
			let since = strconv.ParseInt(fields[2], 10, 64) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return bad(i, "the time \(fields[2]) is not a number")
			}
			records = memory.Dropped(records, try field(i, fields[1]))
			tombs = tombs.Append(work.Tomb{Id: try field(i, fields[3]), Since: since})
		case "buried":
			if len(fields) != 3 {
				return bad(i, "a buried id has 2 fields")
			}
			let since = strconv.ParseInt(fields[2], 10, 64) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return bad(i, "the time \(fields[2]) is not a number")
			}
			tombs = tombs.Append(work.Tomb{Id: try field(i, fields[1]), Since: since})
		case "put":
			if len(fields) != 8 && len(fields) != 10 && len(fields) != 12 && len(fields) != 14 && len(fields) != 16 {
				return bad(i, "a put has 7, 9, 11, 13 or 15 fields")
			}
			let state = match work.StateNamed(fields[6]) {
			case Some[work.State] as s:
				s.Value
			case None:
				return bad(i, "no state \(fields[6])")
			}
			let since = strconv.ParseInt(fields[7], 10, 64) catch {
			case strconv.Malformed, strconv.OutOfRange:
				return bad(i, "the time \(fields[7]) is not a number")
			}
			let mut w = work.Workspace{Name: try field(i, fields[1]), Path: try field(i, fields[2]), Parent: try field(i, fields[3]), Branch: try field(i, fields[4]), Cloner: try field(i, fields[5]), State: state, Since: since, Base: "", Latest: "", Id: "", Deps: "", Token: "", Moving: "", Pinned: false, Until: 0}
			if len(fields) >= 10 {
				w = work.Workspace{..w, Base: try field(i, fields[8]), Latest: try field(i, fields[9])}
			}
			if len(fields) >= 12 {
				w = work.Workspace{..w, Id: try field(i, fields[10]), Deps: try field(i, fields[11])}
			}
			if len(fields) >= 14 {
				w = work.Workspace{..w, Token: try field(i, fields[12]), Moving: try field(i, fields[13])}
			}
			if len(fields) == 16 {
				if fields[14] != "pinned" && fields[14] != "-" {
					return bad(i, "the pin \(fields[14]) is not pinned or -")
				}
				let until = strconv.ParseInt(fields[15], 10, 64) catch {
				case strconv.Malformed, strconv.OutOfRange:
					return bad(i, "the time \(fields[15]) is not a number")
				}
				w = work.Workspace{..w, Pinned: fields[14] == "pinned", Until: until}
			}
			records = memory.Kept(records, w)
		case "drop":
			if len(fields) != 2 {
				return bad(i, "a drop has 1 field")
			}
			records = memory.Dropped(records, try field(i, fields[1]))
		case _:
			return bad(i, "unknown word \(fields[0])")
		}
	}
	(records, tombs)
}

func field(i int, text string) string fails work.Unkept {
	strconv.Unquote(text) catch {
	case strconv.Malformed:
		return bad(i, "\(text) is not a quoted field")
	}
}

func bad(i int, why string) work.Unkept { work.Unkept{Reason: "registry line \(i + 1): \(why)"} }

// RegistryFormatFencesEveryOperation checks the version before replaying
// rows, and refuses every mutation without changing an unsupported file.
test RegistryFormatFencesEveryOperation {
	let r = NewRegistry()
	let writer = "work future-commit built tomorrow"
	let text = "format\t99\t"+strconv.Quote(writer)+"\nnot-a-known-record\n"
	try r.writes.WriteFile(r.path, text)
	let row = work.Workspace{Name: "one", Path: "/one", Parent: "/base", Branch: "one", Cloner: "", State: work.Active, Since: 1, Base: "", Latest: "", Id: "id-one", Deps: "", Token: "", Moving: "", Pinned: false, Until: 0}
	let diagnostic = func(reason string) bool {
		strings.Contains(reason, "format 99") && strings.Contains(reason, writer) && strings.Contains(reason, "use Work") && !strings.Contains(reason, "not-a-known-record")
	}
	let list = func() bool {
		let _ = r.All() catch { case work.Unkept as e: return diagnostic(e.Reason) }
		false
	}
	let tombs = func() bool {
		let _ = r.Tombs() catch { case work.Unkept as e: return diagnostic(e.Reason) }
		false
	}
	assert list() && tombs()
	let put = func() bool {
		r.Put(row) catch { case work.Unkept as e: return diagnostic(e.Reason) }
		false
	}
	let drop = func() bool {
		r.Drop(row.Name) catch { case work.Unkept as e: return diagnostic(e.Reason) }
		false
	}
	let bury = func() bool {
		r.Bury(row.Name, 5) catch { case work.Unkept as e: return diagnostic(e.Reason) }
		false
	}
	let compact = func() bool {
		r.Compact(0) catch { case work.Unkept as e: return diagnostic(e.Reason) }
		false
	}
	assert put() && drop() && bury() && compact()
	assert try r.files.ReadFile(r.path) == text
}

// RegistryUpgradeKeepsCompleteRecords checks the exact first-write
// boundary. A legacy read writes nothing, a first write discards a torn
// suffix, and compaction keeps both the version fence and live data.
law RegistryUpgradeKeepsCompleteRecords(a work.Workspace, b work.Workspace) {
	let r = NewRegistry()
	let kept = work.Workspace{..a, Name: "kept", Id: "id-kept"}
	let tomb = work.Tomb{Id: "id-removed", Since: 10}
	let legacy = PutLine(kept) + TombLine(tomb) + "drop\t\"interrupted"
	try r.writes.WriteFile(r.path, legacy)
	if (try r.All()) != []work.Workspace{kept} || (try r.files.ReadFile(r.path)) != legacy {
		return false
	}
	let added = work.Workspace{..b, Name: "added", Id: "id-added"}
	try r.Put(added)
	let upgraded = try r.files.ReadFile(r.path)
	let stamp = "format\t1\t\"work journal test build\"\n"
	if !strings.HasPrefix(upgraded, stamp) || strings.Contains(upgraded, "interrupted") || (try r.All()) != []work.Workspace{kept, added} || (try r.Tombs()) != []work.Tomb{tomb} {
		return false
	}
	try r.writes.AppendFile(r.path, "put\t\"interrupted again")
	try r.Drop(added.Name)
	if (try r.All()) != []work.Workspace{kept} {
		return false
	}
	try r.Compact(0)
	strings.HasPrefix(try r.files.ReadFile(r.path), stamp) && (try r.All()) == []work.Workspace{kept} && (try r.Tombs()) == []work.Tomb{tomb}
}
