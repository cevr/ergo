// The work.Cloner laws on the host, in a folder of each case's own
// (TestAmbient). The laws draw their paths, so on most of them a clone is
// Missing or Unsupported and they hold by their failure cases; the test
// below clones a real tree with cp -c.

import exec
import strings
import github.com/cevr/ergo/modules/work/system
import github.com/cevr/ergo/modules/work/work

let onHost = context needs TestAmbient { work.Cloner: New(exec.NewTestHost()), exec.Runner: exec.NewTestHost() }

// ClonesARealTree: on APFS (macOS), cp -c of a planted tree is that
// tree (APFS does not count shared blocks, so Usage is not read); on any
// other file system the clone is Unsupported, never a copy.
test ClonesARealTree {
	with onHost {
		let here = system.FileSystem() == "apfs"
		let got = system.HostClone(false, false)
		if here {
			assert got == ""
		} else {
			assert strings.HasPrefix(got, "unsupported:")
		}
	}
}
