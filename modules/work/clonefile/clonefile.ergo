// Package clonefile is a work.Cloner by clonefile(2) on APFS, through
// macOS cp -c, which clones each file. Off macOS (a cp with no -c) and
// off APFS it is Unsupported. APFS does not report the blocks a tree
// shares, so Usage is Unsupported.
//
// Go control: Rift's clonefile path on darwin.

import exec
import github.com/cevr/ergo/modules/work/system
import github.com/cevr/ergo/modules/work/work

// Cloner clones through cp -c.
type Cloner { trees system.Trees } implements work.Cloner

// New is the Cloner over a Runner.
func New(run exec.Runner) Cloner { Cloner{trees: system.New(run)} }

// unsupported are the errors of a cp with no -c, and of clonefile off
// APFS.
let unsupported = []string{"invalid option", "illegal option", "unrecognized option", "operation not supported", "not supported"}

func Name(_ Cloner) string { "clonefile" }

func Shares(_ Cloner) bool { true }

// KeepsInodes: each file of the clone is a new inode.
func KeepsInodes(_ Cloner) bool { false }

func Clone(c Cloner, from string, to string) fails work.NotSameVolume | work.Unsupported | work.Exists | work.Missing | work.NoSpace | work.CloneFailed {
	try system.Prepare(c.trees, "clonefile", from, to)
	try OnAPFS(system.FileSystemOf(c.trees, from), from)
	let r = try system.Run(c.trees, "clonefile", "cp", []string{"-c", "-pPR", from, to})
	if r.Status != 0 {
		system.Leave(c.trees, to)
		try system.Failure("clonefile", from, to, r.Stderr, unsupported)
	}
}

// OnAPFS refuses a clone from a folder on a file system fs that is not
// APFS: there macOS cp -c copies each file and exits 0 (clonefile(2)
// fails, cp falls back), so the clone would be a silent full copy (the
// Mac's U1, on HFS+).
func OnAPFS(fs string, from string) fails work.Unsupported {
	if fs != "apfs" {
		return work.Unsupported{Cloner: "clonefile", Why: "\(from) is on \(if fs == "" { "a file system work cannot name" } else { fs }), not APFS: cp -c would copy each file"}
	}
}

// HFSIsNotCloned: the smallest repro of U1, the decision on HFS+ (the
// Mac's hdiutil probe runs the whole new).
test HFSIsNotCloned {
	let mut why = ""
	OnAPFS("hfs", "/Volumes/h/base") catch {
	case work.Unsupported as u:
		why = u.Why
	}
	assert why == "/Volumes/h/base is on hfs, not APFS: cp -c would copy each file"
	OnAPFS("apfs", "/Users/c/base") catch {
	case work.Unsupported:
		assert false
	}
}

func Has(c Cloner, root string) bool { system.Has(c.trees, root) }

func Move(c Cloner, from string, to string) fails work.Exists | work.Missing | work.CloneFailed { try system.Move(c.trees, "clonefile", from, to) }

func Discard(c Cloner, root string) fails work.Missing | work.CloneFailed { try system.Discard(c.trees, "clonefile", root) }

func Usage(_ Cloner, root string) work.Usage fails work.Unsupported | work.Missing | work.CloneFailed {
	work.Unsupported{Cloner: "clonefile", Why: "APFS does not report the blocks a tree shares"}
}
